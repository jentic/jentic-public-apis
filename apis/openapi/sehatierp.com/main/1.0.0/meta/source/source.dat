{
  "openapi": "3.0.0",
  "info": {
    "title": "Sehati CRM API",
    "description": "API for CRM Management System",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/asepindrak/sehati-crm-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://apitestcrm.sehatierp.com/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/customers/careplus-transactions": {
      "post": {
        "summary": "Get all transactions with various filters",
        "description": "Returns a list of customers matching the filters, along with their transaction history and items. At least one filter (phone, trxNo, customerName, startDate, or endDate) is required.",
        "tags": [
          "Customer"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "description": "The phone number of the customer to search for.",
                    "example": "08123270117"
                  },
                  "customerName": {
                    "type": "string",
                    "description": "The name of the customer to search for.",
                    "example": "Abdul Haris"
                  },
                  "trxNo": {
                    "type": "string",
                    "description": "The transaction number to search for.",
                    "example": "INV011130226004"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Start date for filtering transactions (YYYY-MM-DD).",
                    "example": "2026-01-01"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "description": "End date for filtering transactions (YYYY-MM-DD).",
                    "example": "2026-03-31"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of customers and their transactions from POS",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CustomerWithTransactions"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Missing required fields or invalid format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token missing or invalid"
          },
          "500": {
            "description": "Internal Server Error - Failed to fetch from POS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CustomerWithTransactions": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer"
          },
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "totalTransaction": {
            "type": "integer"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "trxNo": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionItem"
            }
          }
        }
      },
      "TransactionItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "qty": {
            "type": "integer"
          },
          "price": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "product": {
            "$ref": "#/components/schemas/Product",
            "nullable": true
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "At least one filter (phone, trxNo, customerName, startDate, or endDate) is required"
          }
        }
      }
    }
  }
}
