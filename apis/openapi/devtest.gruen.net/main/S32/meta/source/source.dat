            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "statusCode": {
            "type": "integer",
            "example": 200
          }
        }
      },
      "ResponseBadRequest": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "fail"
            ],
            "example": "fail"
          },
          "statusCode": {
            "type": "integer",
            "example": 400
          }
        }
      },
      "ResponseNotFound": {
