          },
          "SURNAME": {
            "type": "string",
            "description": "Nachname"
          },
          "NAME_3": {
            "type": "string"
          },
          "STREET_OR_POSTOFFICEBOX": {
            "type": "string",
            "description": "Straße oder Postfach"
          },
          "COUNTRY_ABBREVIATION": {
            "type": "string",
            "description": "Landeskennzeichen"
          },
          "POSTCODE": {
            "type": "string",
            "description": "Postleitzahl"
          },
          "CITY": {
            "type": "string",
            "description": "Ort"
          },
          "SHORTNAME": {
            "type": "string",
            "description": "Kurzname"
          },
          "COUNTRYNAME": {
            "type": "string",
            "description": "Land"
          }
        },
        "required": [
          "GUID",
          "ADRESSNR",
          "DS_NR",
          "COMPANY1",
          "COMPANY2",
          "FORM_OF_ADDRESS",
          "TITLE_ACADEMIC",
          "TITEL_NAM",
          "FORENAME",
          "SURNAME",
          "NAME_3",
          "STREET_OR_POSTOFFICEBOX",
          "COUNTRY_ABBREVIATION",
          "POSTCODE",
