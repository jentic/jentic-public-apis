      "Health_Unhealthy": {
        "type": "object",
        "properties": {
          "healthStatus": {
            "type": "string",
            "description": "health status",
            "enum": [
              "available",
              "unavailable"
            ],
            "example": "unavailable"
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "description": "reason",
            "example": "Database connection failed"
          },
          "version": {
            "type": "string",
            "description": "eVEWA version",
            "example": "eVEWA 4.0 S30"
          },
          "phpVersion": {
            "type": "string",
            "description": "php version",
            "example": "8.1.17"
          },
          "customer": {
            "type": "string",
            "description": "customer name"
          },
          "customerNumber": {
            "type": "string",
            "description": "customer number",
            "example": 14624
          }
        },
        "required": [
          "healthStatus",
          "version",
          "phpVersion",
          "customer",
          "customerNumber"
        ]
      },
