      "Vewa_VewaBookEkz": {
        "type": "object",
        "properties": {
          "includeList": {
            "type": "array",
            "nullable": true,
            "description": "list of MGL_1_AZR.GUIDs to include",
            "example": [
              "1a26f4df-8f16-11f0-97f5-b496915c5999",
              "19ff75be-8f16-11f0-97f5-b496915c5999",
              "66b696fb-784d-11f0-97f5-b496915c5999"
            ],
            "items": {
              "type": "string"
            }
          },
          "excludeList": {
            "type": "array",
            "nullable": true,
            "description": "list of MGL_1_AZR.GUIDs to exclude",
            "example": [
              "1a26f4df-8f16-11f0-97f5-b496915c5999",
              "19ff75be-8f16-11f0-97f5-b496915c5999",
              "66b696fb-784d-11f0-97f5-b496915c5999"
            ],
            "items": {
              "type": "string"
            }
          },
          "xpoFilter": {
            "type": "string",
            "nullable": true,
            "description": "DevExpress filter-expression",
            "example": "[OrderDate] Between (#1/1/2023#, #12/31/2023#)"
          },
          "sqlFilter": {
            "type": "string",
            "nullable": true,
            "description": "SQL filter",
            "example": "MGL_N_BO.GSA_LFDNR = 1"
          }
        },
        "required": []
      },
      "Vewa_VewaReportBilanz": {
        "type": "object",
        "properties": {
          "includeList": {
            "type": "array",
            "nullable": true,
            "description": "list of FIBU_BZKOPF.GSA_LFDNRs to include",
            "example": [
              "1",
              "2",
              "3"
            ],
            "items": {
              "type": "string"
            }
          },
          "excludeList": {
            "type": "array",
            "nullable": true,
            "description": "list of FIBU_BZKOPF.GSA_LFDNRs to exclude",
            "example": [
              "1",
              "2",
              "3"
            ],
            "items": {
              "type": "string"
            }
          },
          "xpoFilter": {
            "type": "string",
            "nullable": true,
            "description": "DevExpress filter-expression",
            "example": "[OrderDate] Between (#1/1/2023#, #12/31/2023#)"
          },
          "sqlFilter": {
            "type": "string",
            "nullable": true,
            "description": "SQL filter",
            "example": "FIBU_BZKOPF.GSA_LFDNR = 1"
          },
          "guid": {
            "type": "string",
            "description": "report guid",
            "example": "83c62535-d848-11ec-9974-b496915c5999"
          },
          "idealScope": {
            "type": "boolean",
            "nullable": true,
            "description": "include scope \"Ideeller Bereich\" to report data",
            "example": true
          },
          "otherBusinessConcerns": {
            "type": "boolean",
            "nullable": true,
            "description": "include scope \"Sonstige Geschäftsbetriebe\" to report data",
            "example": true
          },
          "assetManagement": {
            "type": "boolean",
            "nullable": true,
            "description": "include scope \"Vermögensverwaltung\" to report data",
            "example": true
          },
          "economicBusinessConcerns": {
            "type": "boolean",
            "nullable": true,
            "description": "include scope \"Wirtschaftlicher Geschäftsbetrieb\" to report data",
            "example": true
          },
          "purposeConcerns": {
            "type": "boolean",
            "nullable": true,
            "description": "include scope \"Zweckbetrieb\" to report data",
            "example": true
          },
          "dateFrom": {
            "type": "string",
            "description": "start date of range to report data",
            "example": "2021-12-31T00:00:00"
          },
          "dateTill": {
            "type": "string",
            "description": "end date of range to report data",
            "example": "2021-12-31T00:00:00"
          }
        },
        "required": [
          "guid",
          "dateFrom",
          "dateTill"
        ]
      },
      "Vewa_VewaBookingEinnahmen": {
        "type": "object",
        "properties": {
          "buchen": {
            "type": "string",
            "description": "buchen (1) oder speichern (0)",
            "example": "1"
          },
          "art": {
            "type": "string",
            "description": "kind of booking (art)",
            "example": "Einnahmen"
          },
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "amount of booking (Betrag)",
            "example": "109,99"
          },
          "receiptNumber": {
            "type": "string",
            "description": "number of receipt (Belegnr.)",
            "example": "001"
          },
          "receiptDate": {
            "type": "string",
            "description": "date of receipt (Belegdat.)",
            "example": "2025-09-05T00:00:00"
          },
          "receiptFile": {
            "type": "string",
            "description": "GUID of receipt file as string (ZEV_FILES)",
            "example": "f2acae98-84e9-11f0-97f5-b496915c5999"
          },
          "bookingDate": {
            "type": "string",
            "description": "date of booking (Buchdat.)",
            "example": "2025-09-05T00:00:00"
          },
          "btext1": {
            "type": "string",
            "description": "booking-text (Buchtxt.)",
            "example": "Zahlungseingang zu Rechnung xyz"
          },
          "geldkonto": {
            "type": "string",
            "description": "geldkonto",
