mple":100}}],"x-required-plan":"api_pro","responses":{"200":{"description":"Inspect delivery history","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"application/json":{"schema":{"type":"object","required":["data","meta"],"properties":{"data":{"type":"object","properties":{"events":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"event_type":{"type":"string"},"event_id":{"type":"string"},"status":{"type":"string"},"attempts":{"type":"integer"},"last_attempt_at":{"type":"string"},"next_retry_at":{"description":"null in the example: the value is absent or not published."},"last_status_code":{"type":"integer"},"last_error":{"description":"null in the example: the value is absent or not published."},"created_at":{"type":"string"},"delivered_at":{"type":"string"}},"required":["id","event_type","event_id","status","attempts","last_attempt_at","next_retry_at","last_status_code","last_error","created_at","delivered_at"]}}},"required":["events"]},"meta":{"allOf":[{"$ref":"#/components/schemas/Meta"},{"type":"object","properties":{"timestamp":{"type":"string"},"request_id":{"type":"string"},"count":{"type":"integer"}},"required":["timestamp","request_id","count"]}]}}},"example":{"data":{"events":[{"id":"uuid","event_type":"purchase.detected","event_id":"9f0c…e2a1","status":"delivered","attempts":1,"last_attempt_at":"2026-04-19T14:00:01Z","next_retry_at":null,"last_status_code":200,"last_error":null,"created_at":"2026-04-19T14:00:00Z","delivered_at":"2026-04-19T14:00:01Z"}]},"meta":{"timestamp":"2026-04-19T14:00:00.000Z","request_id":"…","count":1}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}}},"components":{"securitySchemes":{"apiKey":{"type":"apiKey","in":"header","name":"x-api-key","description":"API key prefixed with cs_live_. Create one in Settings → API."}},"schemas":{"ErrorEnvelope":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","request_id"],"properties":{"code":{"type":"string","description":"Branch on this: it is stable. The message is for people and may change."},"message":{"type":"string"},"request_id":{"type":"string","format":"uuid"}}}}},"Meta":{"type":"object","required":["timestamp","request_id"],"properties":{"timestamp":{"type":"string","format":"date-time"},"request_id":{"type":"string","format":"uuid"}},"additionalProperties":true}},"headers":{"X-Request-Id":{"description":"Identifies this call; quote it if you contact support.","schema":{"type":"string","format":"uuid"}},"X-RateLimit-Limit":{"description":"Requests allowed per minute on your plan.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Requests left in the current minute.","schema":{"type":"integer"}},"X-RateLimit-Reset":{"description":"Unix time (seconds) when the minute window resets.","schema":{"type":"integer"}},"X-Quota-Limit":{"description":"Requests allowed per month on your plan, or \"unlimited\".","schema":{"type":"string"}},"X-Quota-Remaining":{"description":"Requests left this month, or \"unlimited\".","schema":{"type":"string"}},"X-Quota-Reset":{"description":"Unix time (seconds) when the monthly quota resets.","schema":{"type":"integer"}},"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"responses":{"BadRequest":{"description":"A request value is not valid. The error message names it.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"invalid_filter":{"summary":"invalid_filter","value":{"error":{"code":"invalid_filter","message":"A filter value we do not recognise: an unknown or unavailable ?token=, an unknown entity_type, a malformed since/until, an unknown company on /signals, a bad cursor, or a bad status on /webhooks/events. The message lists the valid values.","request_id":"00000000-0000-4000-8000-000000000000"}}},"bad_query":{"summary":"bad_query","value":{"error":{"code":"bad_query","message":"A /signals or /export/signals parameter is not valid; the message names which ones.","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_format":{"summary":"invalid_format","value":{"error":{"code":"invalid_format","message":"format must be csv or json on /export (csv or jsonl on /export/signals).","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_request":{"summary":"invalid_request","value":{"error":{"code":"invalid_request","message":"The request body is missing or malformed: send a JSON object with url and events on POST /webhooks, and a valid subscription_id on /webhooks/events.","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_url":{"summary":"invalid_url","value":{"error":{"code":"invalid_url","message":"The webhook url is not acceptable: it must be https, public, and at most 2,048 characters.","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_event_type":{"summary":"invalid_event_type","value":{"error":{"code":"invalid_event_type","message":"An event type in events is not one we publish; the message lists the valid ones.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"Unauthorized":{"description":"No API key, a key that is not in the right format, or a key we do not recognise (revoked or mistyped). Pass a valid key in the x-api-key header; the WWW-Authenticate response header names it.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"WWW-Authenticate":{"description":"How to authenticate: an API key in the x-api-key header.","schema":{"type":"string","example":"ApiKey realm=\"CorpStacking API\", header=\"x-api-key\""}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"missing_api_key":{"summary":"missing_api_key","value":{"error":{"code":"missing_api_key","message":"No x-api-key header was sent. Keys are not accepted in the query string.","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_api_key":{"summary":"invalid_api_key","value":{"error":{"code":"invalid_api_key","message":"The key is not recognised (revoked, mistyped, or never issued). This is a 401, not a 403: a 403 means the key is valid but your plan does not include the call. Every 401 carries a WWW-Authenticate header naming the x-api-key header.","request_id":"00000000-0000-4000-8000-000000000000"}}},"invalid_api_key_format":{"summary":"invalid_api_key_format","value":{"error":{"code":"invalid_api_key_format","message":"The key must start with cs_live_.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"TierRequired":{"description":"The call needs Pro+ (the signals stream, premium webhook events).","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"tier_required":{"summary":"tier_required","value":{"error":{"code":"tier_required","message":"The signals stream and the premium webhook events (newswire and ETF milestones) need Pro+.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"Forbidden":{"description":"The key is valid, but your plan does not include this endpoint or asset.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"plan_required":{"summary":"plan_required","value":{"error":{"code":"plan_required","message":"This call needs a plan that includes API access, or, for the bulk exports, data export.","request_id":"00000000-0000-4000-8000-000000000000"}}},"treasuries_plus_required":{"summary":"treasuries_plus_required","value":{"error":{"code":"treasuries_plus_required","message":"Ethereum / Solana / XRP need Pro+ (Treasuries+).","request_id":"00000000-0000-4000-8000-000000000000"}}},"webhook_access_required":{"summary":"webhook_access_required","value":{"error":{"code":"webhook_access_required","message":"Webhook subscriptions need the API Pro plan or higher.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"NotFound":{"description":"No such endpoint, company, signal or subscription.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"not_found":{"summary":"not_found","value":{"error":{"code":"not_found","message":"No such endpoint, company, signal or subscription (a value that cannot be a slug or id is also a 404).","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"MethodNotAllowed":{"description":"The endpoint does not support that HTTP method. The Allow header lists the ones it does.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Allow":{"description":"The methods the endpoint supports.","schema":{"type":"string","example":"GET, OPTIONS"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"method_not_allowed":{"summary":"method_not_allowed","value":{"error":{"code":"method_not_allowed","message":"The endpoint does not support that HTTP method; the Allow header lists the ones it does.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"Conflict":{"description":"The account already has the maximum number of webhook subscriptions.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"subscription_limit_reached":{"summary":"subscription_limit_reached","value":{"error":{"code":"subscription_limit_reached","message":"You already have the maximum number of webhook subscriptions (10); delete one first.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"PayloadTooLarge":{"description":"The request body is larger than 16 KB.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"payload_too_large":{"summary":"payload_too_large","value":{"error":{"code":"payload_too_large","message":"The request body is over 16 KB.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"RateLimited":{"description":"Rate limit or monthly quota exceeded. Retry-After is the number of seconds to wait.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Retry-After":{"$ref":"#/components/headers/Retry-After"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"rate_limit_exceeded":{"summary":"rate_limit_exceeded","value":{"error":{"code":"rate_limit_exceeded","message":"Too many requests this minute; wait for the number of seconds in Retry-After.","request_id":"00000000-0000-4000-8000-000000000000"}}},"stream_limit_exceeded":{"summary":"stream_limit_exceeded","value":{"error":{"code":"stream_limit_exceeded","message":"Too many signals streams are open at once for your key (Pro+ 2, API Pro 5, Team 10, Enterprise 25); close one, or wait the number of seconds in Retry-After.","request_id":"00000000-0000-4000-8000-000000000000"}}},"quota_exceeded":{"summary":"quota_exceeded","value":{"error":{"code":"quota_exceeded","message":"The monthly quota is used up; Retry-After is the time until it resets (the 1st, UTC).","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"InternalError":{"description":"Something went wrong on our side. A failed data read is always an error, never an empty result. Quote the request_id if it persists.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"internal_error":{"summary":"internal_error","value":{"error":{"code":"internal_error","message":"Something went wrong on our side, or a data read failed. Nothing is ever answered as an empty result on a failure. Retry; quote the request_id if it persists.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}},"Unavailable":{"description":"Creating a webhook subscription is temporarily unavailable. Retry shortly.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"examples":{"internal_error":{"summary":"internal_error","value":{"error":{"code":"internal_error","message":"Creating a webhook subscription is temporarily unavailable; retry shortly.","request_id":"00000000-0000-4000-8000-000000000000"}}}}}}}}}}