.","schema":{"type":"string","example":"strategy-buys-13927-btc-2026-04-13"}}],"x-required-plan":"pro","responses":{"200":{"description":"Single signal detail","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"application/json":{"schema":{"type":"object","required":["data","meta"],"properties":{"data":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"token_id":{"type":"string"},"company_id":{"type":"string"},"signal_type":{"type":"string"},"source_type":{"type":"string"},"source_url":{"type":"string"},"source_ref":{"type":"string"},"headline":{"type":"string"},"summary":{"type":"string"},"occurred_at":{"type":"string"},"ingested_at":{"type":"string"},"confidence":{"type":"number"},"payload":{"type":"object","properties":{}},"tier":{"type":"string"},"canonical_signal_id":{"description":"null in the example: the value is absent or not published."}},"required":["id","slug","token_id","company_id","signal_type","source_type","source_url","source_ref","headline","summary","occurred_at","ingested_at","confidence","payload","tier","canonical_signal_id"]},"meta":{"allOf":[{"$ref":"#/components/schemas/Meta"},{"type":"object","properties":{"timestamp":{"type":"string"},"request_id":{"type":"string"}},"required":["timestamp","request_id"]}]}}},"example":{"data":{"id":"uuid","slug":"strategy-buys-13927-btc-2026-04-13","token_id":"bitcoin","company_id":"uuid","signal_type":"purchase","source_type":"sec_filing","source_url":"https://www.sec.gov/Archives/edgar/...","source_ref":"0000950170-26-000123","headline":"Strategy adds 13,927 BTC","summary":"Strategy disclosed a purchase of 13,927 BTC for about $1.0B.","occurred_at":"2026-04-13T00:00:00Z","ingested_at":"2026-04-13T13:42:00Z","confidence":0.98,"payload":{},"tier":"free","canonical_signal_id":null},"meta":{"timestamp":"2026-04-19T14:00:00.000Z","request_id":"…"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}},"/signals/stream":{"get":{"summary":"Live signals stream (Server-Sent Events)","description":"A long-lived stream of newly published signals, one event per signal, for dashboards and bots that want to react without polling. Pro+ only: other plans get 402 tier_required. Each event has id (the signal id), event (signal.<type>, for example signal.purchase) and data (the signal as JSON, the same fields as /signals). A comment line (: ping) arrives every 25 seconds to keep proxies from closing an idle connection. Each key may hold a limited number of streams open at once (Pro+ 2, API Pro 5, Team 10, Enterprise 25); one more is a 429 stream_limit_exceeded with a Retry-After header, and a client that stops reading is dropped after about 75 seconds. The server ends every stream after 4 minutes 30 seconds with a final event: stream.end line; reconnect and send the last id you saw in the Last-Event-ID header to resume where you left off, so nothing published in between is lost. Duplicate stories from several sources are sent once.","operationId":"get_signals_stream","tags":["signals"],"parameters":[{"name":"Last-Event-ID","in":"header","required":false,"description":"The id of the last event you received (a signal id). On reconnect the stream resumes after that signal.","schema":{"type":"string","example":"00000000-0000-4000-8000-000000000001"}}],"x-required-plan":"pro_plus","responses":{"200":{"description":"Live signals stream (Server-Sent Events)","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"text/event-stream":{"schema":{"type":"string","description":"Server-Sent Events: id, event (signal.<type>) and data (JSON) fields, with a \": ping\" comment every 25 seconds."},"example":": connected 2026-04-19T14:00:00.000Z\n\nid: 00000000-0000-4000-8000-000000000001\nevent: signal.purchase\ndata: {\"id\":\"00000000-0000-4000-8000-000000000001\",\"slug\":\"strategy-buys-13927-btc-2026-04-13\",\"signal_type\":\"purchase\",\"source_type\":\"sec_filing\",\"token_id\":\"bitcoin\",\"headline\":\"Strategy adds 13,927 BTC\",\"summary\":\"Strategy disclosed a purchase of 13,927 BTC for about $1.0B.\",\"occurred_at\":\"2026-04-13T00:00:00Z\",\"ingested_at\":\"2026-04-13T13:42:00Z\",\"confidence\":0.98,\"payload\":{},\"tier\":\"free\"}\n\n: ping"}}},"401":{"$ref":"#/components/responses/Unauthorized"},"402":{"$ref":"#/components/responses/TierRequired"},"403":{"$ref":"#/components/responses/Forbidden"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}},"/export/signals":{"get":{"summary":"Bulk signals export","description":"Bulk download of the signals feed as CSV or newline-delimited JSON (JSONL). Same content rules as /signals — Pro+ keys also get the premium signals. Returns a raw file download, not the { data, meta } wrapper. Caps at 10,000 rows per call; narrow with since/until for larger pulls.","operationId":"get_export_signals","tags":["export"],"parameters":[{"name":"format","in":"query","required":false,"description":"Download format. Default csv.","schema":{"type":"string","enum":["csv","jsonl"],"example":"csv"}},{"name":"token","in":"query","required":false,"description":"Filter to one token, or all (the default).","schema":{"type":"string","enum":["bitcoin","ethereum","solana","ripple","all"],"example":"bitcoin"}},{"name":"type","in":"query","required":false,"description":"Filter to one signal type, or all (the default).","schema":{"type":"string","example":"purchase"}},{"name":"since","in":"query","required":false,"description":"Only include signals on or after this time (ISO 8601 date-time).","schema":{"type":"string","example":"2026-01-01T00:00:00Z"}},{"name":"until","in":"query","required":false,"description":"Only include signals before this time (ISO 8601 date-time).","schema":{"type":"string","example":"2026-02-01T00:00:00Z"}},{"name":"limit","in":"query","required":false,"description":"Max rows. Default 1,000, max 10,000.","schema":{"type":"integer","example":10000}}],"x-required-plan":"pro","responses":{"200":{"description":"Bulk signals export","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"text/csv":{"schema":{"type":"string"},"example":"id,slug,token_id,company_id,signal_type,source_type,source_url,source_ref,headline,summary,occurred_at,ingested_at,confidence,tier\nuuid,strategy-buys-13927-btc-2026-04-13,bitcoin,uuid,purchase,sec_filing,https://www.sec.gov/...,0000950170-26-000123,\"Strategy adds 13,927 BTC\",\"Strategy disclosed a purchase…\",2026-04-13T00:00:00Z,2026-04-13T13:42:00Z,0.98,free"},"application/x-ndjson":{"schema":{"type":"string","description":"One JSON object per line."}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}},"/webhooks":{"post":{"summary":"Create a webhook subscription","description":"Subscribe an HTTPS endpoint to one or more event types. The JSON body takes url, events and description; anything else in it is ignored (a body over 16 KB is a 413). The response includes the signing secret exactly once — store it now; later requests only return a masked preview. You can have up to 10 subscriptions per account. Subscribing to a premium signal event (newswire or ETF milestone) requires Pro+ or higher. Deliveries are never redirected: a response that is a redirect counts as a failed delivery.","operationId":"post_webhooks","tags":["webhooks"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url","events"],"properties":{"url":{"type":"string","format":"uri","maxLength":2048,"description":"Your HTTPS endpoint. Public addresses only (no private, loopback or link-local hosts), at most 2,048 characters. Redirects are not followed on delivery.","example":"https://your-app.example/corpstacking-webhook"},"events":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["purchase.detected","holding.updated","price.threshold","signal.purchase.created","signal.sale.created","signal.new_adopter.created","signal.capital_raise.created","signal.exec_change.created","signal.wire_news.created","signal.etf_milestone.created"]},"description":"Array of event types to subscribe to (a JSON array of strings; duplicates are dropped). See the full list below.","example":["purchase.detected"]},"description":{"type":"string","maxLength":280,"description":"Optional label (up to 280 characters).","example":"prod pipeline"}},"additionalProperties":true}}}},"x-required-plan":"api_pro","responses":{"200":{"description":"Create a webhook subscription","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"application/json":{"schema":{"type":"object","required":["data","meta"],"properties":{"data":{"type":"object","properties":{"subscription":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"events":{"type":"array","items":{"type":"string"}},"description":{"type":"string"},"active":{"type":"boolean"},"created_at":{"type":"string"},"secret":{"type":"string"},"secret_notice":{"type":"string"}},"required":["id","url","events","description","active","created_at","secret","secret_notice"]}},"required":["subscription"]},"meta":{"allOf":[{"$ref":"#/components/schemas/Meta"},{"type":"object","properties":{"timestamp":{"type":"string"},"request_id":{"type":"string"}},"required":["timestamp","request_id"]}]}}},"example":{"data":{"subscription":{"id":"uuid","url":"https://your-app.example/corpstacking-webhook","events":["purchase.detected","holding.updated"],"description":"prod pipeline","active":true,"created_at":"2026-04-19T14:00:00Z","secret":"whsec_cs_…","secret_notice":"Store this secret now — it will not be shown again."}},"meta":{"timestamp":"2026-04-19T14:00:00.000Z","request_id":"…"}}}}},"400":{"$ref":"#/