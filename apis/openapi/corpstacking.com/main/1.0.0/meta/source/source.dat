onents/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}},"/usage":{"get":{"summary":"Your current rate limit + quota","description":"Live limits for the calling API key — how many requests you can make each minute and each month, how many you have left in each window, and when each window resets. Reset times are Unix timestamps (seconds). A plan with no monthly limit (Enterprise) reports requests_per_month and quota.remaining as null, and its X-Quota-Limit and X-Quota-Remaining headers say unlimited.","operationId":"get_usage","tags":["usage"],"x-required-plan":"pro","responses":{"200":{"description":"Your current rate limit + quota","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"application/json":{"schema":{"type":"object","required":["data","meta"],"properties":{"data":{"type":"object","properties":{"plan":{"type":"string"},"rate_limit":{"type":"object","properties":{"requests_per_minute":{"type":"integer"},"remaining":{"type":"integer"},"resets_at":{"type":"integer"}},"required":["requests_per_minute","remaining","resets_at"]},"quota":{"type":"object","properties":{"requests_per_month":{"type":"integer"},"remaining":{"type":"integer"},"resets_at":{"type":"integer"}},"required":["requests_per_month","remaining","resets_at"]}},"required":["plan","rate_limit","quota"]},"meta":{"allOf":[{"$ref":"#/components/schemas/Meta"},{"type":"object","properties":{"timestamp":{"type":"string"},"request_id":{"type":"string"}},"required":["timestamp","request_id"]}]}}},"example":{"data":{"plan":"pro_plus","rate_limit":{"requests_per_minute":300,"remaining":297,"resets_at":1745078460},"quota":{"requests_per_month":10000,"remaining":9588,"resets_at":1746057600}},"meta":{"timestamp":"2026-04-19T14:00:00.000Z","request_id":"…"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"405":{"$ref":"#/components/responses/MethodNotAllowed"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"}}}},"/signals":{"get":{"summary":"Treasury signals feed","description":"Reverse-chronological feed of treasury news and events: detected purchases and sales, newly disclosed adopters, capital raises, and executive changes. Pro+ also unlocks premium signals — live newswire coverage, ETF milestones, and large on-chain movements. Paginated by cursor: follow next_cursor while has_more is true, passing it back unchanged (it is opaque; rows that share a timestamp are never skipped). An unknown company, a malformed cursor, or a bad since/until is a 400.","operationId":"get_signals","tags":["signals"],"parameters":[{"name":"token","in":"query","required":false,"description":"Filter to one token, or all (the default).","schema":{"type":"string","enum":["bitcoin","ethereum","solana","ripple","all"],"example":"bitcoin"}},{"name":"type","in":"query","required":false,"description":"Filter to one signal type, or all (the default).","schema":{"type":"string","enum":["purchase","sale","new_adopter","capital_raise","exec_change","earnings_release","wire_news","etf_milestone","onchain_movement","sedar_filing","commentary","all"],"example":"purchase"}},{"name":"company","in":"query","required":false,"description":"Filter to a single entity by its treasury slug.","schema":{"type":"string","example":"microstrategy"}},{"name":"since","in":"query","required":false,"description":"Only include signals on or after this time (ISO 8601 date-time, with or without an offset).","schema":{"type":"string","example":"2026-01-01T00:00:00Z"}},{"name":"until","in":"query","required":false,"description":"Only include signals before this time (ISO 8601 date-time).","schema":{"type":"string","example":"2026-02-01T00:00:00Z"}},{"name":"min_confidence","in":"query","required":false,"description":"Only include signals at or above this confidence score (0 to 1).","schema":{"type":"string","example":"0.7"}},{"name":"cursor","in":"query","required":false,"description":"Pagination cursor. Pass the next_cursor from the previous page, unchanged, to fetch the next one.","schema":{"type":"string","example":"2026-04-13T00:00:00Z~00000000-0000-4000-8000-000000000001"}},{"name":"limit","in":"query","required":false,"description":"Page size. Default 20, max 100.","schema":{"type":"integer","example":50}}],"x-required-plan":"pro","responses":{"200":{"description":"Treasury signals feed","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/X-RateLimit-Reset"},"X-Quota-Limit":{"$ref":"#/components/headers/X-Quota-Limit"},"X-Quota-Remaining":{"$ref":"#/components/headers/X-Quota-Remaining"},"X-Quota-Reset":{"$ref":"#/components/headers/X-Quota-Reset"}},"content":{"application/json":{"schema":{"type":"object","required":["data","meta"],"properties":{"data":{"type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"token_id":{"type":"string"},"company_id":{"type":"string"},"signal_type":{"type":"string"},"source_type":{"type":"string"},"source_url":{"type":"string"},"source_ref":{"type":"string"},"headline":{"type":"string"},"summary":{"type":"string"},"occurr