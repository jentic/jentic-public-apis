{
  "openapi": "3.0.3",
  "info": {
    "title": "TeleAnalytics API",
    "version": "1.0.0",
    "description": "Public, token-authenticated endpoints for search, messages, word frequency, profile summary, quota, and voucher redemption.\n\nTry it out:\n1. Get your API key from the Telegram bot (@teleanalytics_bot) via the Settings \u2192 API menu.\n2. Click Authorize in Swagger UI and enter your API Key.\n3. The base URL for all requests is https://api.teleanalyticsapi.app.\n\nCost: 1 credit per request (Search, Messages, Wordfreq, Profile Summary). Quota and Redeem endpoints do not consume credits.\n\nSuccess semantics for search: success is true if an entity (user/peer with id) is identified even if groups are empty, or groups are found.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/aires-234/TeleAnalytics/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.teleanalyticsapi.app",
      "description": "Production API"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/aires-234/TeleAnalytics/1.0.0"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search by @username or numeric user ID",
        "description": "Consumes 1 credit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Telegram @username or numeric user ID. The service may try both with and without '@'."
          }
        ],
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "examples": {
                  "userWithGroups": {
                    "summary": "Entity with groups",
                    "value": {
                      "success": true,
                      "user": {
                        "id": 6654137551,
                        "username": "pappa"
                      },
                      "groups": [
                        {
                          "id": 1905521765,
                          "title": "DEXTools Community",
                          "username": "DEXToolsCommunity",
                          "chat": {
                            "id": 1905521765,
                            "title": "DEXTools Community",
                            "username": "DEXToolsCommunity",
                            "isPrivate": false
                          }
                        }
                      ],
                      "remaining_requests": 42
                    }
                  },
                  "entityOnly": {
                    "summary": "Entity resolved, no groups",
                    "value": {
                      "success": true,
                      "user": {
                        "id": 123456789,
                        "username": "someone"
                      },
                      "groups": [],
                      "remaining_requests": 41
                    }
                  },
                  "noInfo": {
                    "summary": "No information found",
                    "value": {
                      "success": false,
                      "user": {},
                      "groups": [],
                      "remaining_requests": 40,
                      "message": "Insufficient information found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Search by @username or numeric user ID (JSON body)",
        "description": "Consumes 1 credit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Telegram @username or numeric user ID"
                  },
                  "query": {
                    "type": "string",
                    "description": "Alternative field for the same value; q takes precedence."
                  }
                },
                "required": [
                  "q"
                ],
                "additionalProperties": false
              },
              "example": {
                "q": "@username"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "examples": {
                  "noInfo": {
                    "summary": "No information found",
                    "value": {
                      "success": false,
                      "user": {},
                      "groups": [],
                      "remaining_requests": 40,
                      "message": "Insufficient information found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "Fetch paginated messages for a user",
        "description": "Consumes 1 credit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "@username or numeric user ID (one of q or user_id is required)"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric user ID (one of q or user_id is required)"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "raw"
              ],
              "default": "simple"
            },
            "description": "simple (normalized) or raw provider payload"
          },
          {
            "name": "max_text",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 300,
              "minimum": 50,
              "maximum": 2000
            },
            "description": "Max chars for text in simple format"
          }
        ],
        "responses": {
          "200": {
            "description": "Messages page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesResponse"
                },
                "examples": {
                  "sample": {
                    "summary": "Sample with items",
                    "value": {
                      "success": true,
                      "user_id": 6654137551,
                      "page": 1,
                      "page_size": 3,
                      "format": "simple",
                      "items": [
                        {
                          "date": "2025-03-05T23:48:19Z",
                          "message_id": 274941,
                          "reply_to_message_id": 53,
                          "text": "Hi someone took over our projects dextools profile...",
                          "group": {
                            "id": 1905521765,
                            "title": "DEXTools Community",
                            "username": "DEXToolsCommunity",
                            "is_private": false
                          }
                        }
                      ],
                      "remaining_requests": 29
                    }
                  },
                  "noInfo": {
                    "summary": "No information found",
                    "value": {
                      "success": false,
                      "user_id": 6654137551,
                      "page": 1,
                      "page_size": 20,
                      "format": "simple",
                      "items": [],
                      "remaining_requests": 28,
                      "message": "Insufficient information found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wordfreq": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Compute top word frequencies from recent messages",
        "description": "Consumes 1 credit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "@username or numeric user ID (one of q or user_id is required)"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric user ID (one of q or user_id is required)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 200,
              "maximum": 500,
              "minimum": 1
            }
          },
          {
            "name": "pages",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5,
              "maximum": 20,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Word frequency list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordfreqResponse"
                },
                "examples": {
                  "sample": {
                    "summary": "Sample with words",
                    "value": {
                      "success": true,
                      "user_id": 6654137551,
                      "count": 27,
                      "words": [
                        {
                          "word": "big",
                          "count": 2
                        },
                        {
                          "word": "dextools",
                          "count": 1
                        }
                      ],
                      "remaining_requests": 28
                    }
                  },
                  "noInfo": {
                    "summary": "No information found",
                    "value": {
                      "success": false,
                      "user_id": 6654137551,
                      "count": 0,
                      "words": [],
                      "remaining_requests": 27,
                      "message": "Insufficient information found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile/summary": {
      "get": {
        "tags": [
          "AI"
        ],
        "summary": "Generate an AI-powered behavioral profile",
        "description": "Consumes 1 credit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "@username or numeric user ID (one of q or user_id is required)"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric user ID (one of q or user_id is required)"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile summary response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSummaryResponse"
                },
                "examples": {
                  "sample": {
                    "summary": "Sample profile summary",
                    "value": {
                      "success": true,
                      "user_id": 6654137551,
                      "summary": "User Profile: 6654137551...",
                      "remaining_requests": 27,
                      "error": null
                    }
                  },
                  "noInfo": {
                    "summary": "No information found",
                    "value": {
                      "success": true,
                      "user_id": 6654137551,
                      "summary": null,
                      "remaining_requests": 26,
                      "error": null,
                      "message": "Insufficient information found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quota": {
      "get": {
        "tags": [
          "Access"
        ],
        "summary": "Get remaining request quota",
        "description": "Free endpoint \u2014 does not consume credits.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Quota information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaResponse"
                },
                "example": {
                  "success": true,
                  "user_id": 7958155942,
                  "remaining_requests": 30,
                  "grant": "voucher:100"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/redeem": {
      "post": {
        "tags": [
          "Access"
        ],
        "summary": "Redeem a voucher code for additional requests",
        "description": "Free endpoint \u2014 does not consume credits.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRequest"
              },
              "example": {
                "code": "ABCDEF1234"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voucher redeemed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemResponse"
                },
                "example": {
                  "success": true,
                  "user_id": 7958155942,
                  "code": "ABCDEF1234",
                  "added_requests": 50,
                  "remaining_requests": 89
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "chat": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "username": {
                "type": "string",
                "nullable": true
              },
              "isPrivate": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Group"
            }
          },
          "remaining_requests": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "Present when no information was found or additional context is needed."
          }
        },
        "required": [
          "success",
          "user",
          "groups",
          "remaining_requests"
        ]
      },
      "MessageItemSimple": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "message_id": {
            "type": "integer"
          },
          "reply_to_message_id": {
            "type": "integer",
            "nullable": true
          },
          "text": {
            "type": "string"
          },
          "group": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "username": {
                "type": "string",
                "nullable": true
              },
              "is_private": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "date",
          "message_id",
          "text",
          "group"
        ]
      },
      "MessagesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "format": {
            "type": "string",
            "enum": [
              "simple",
              "raw"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageItemSimple"
            }
          },
          "remaining_requests": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "Present when no information was found or additional context is needed."
          }
        },
        "required": [
          "success",
          "user_id",
          "page",
          "page_size",
          "format",
          "items",
          "remaining_requests"
        ]
      },
      "WordCount": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "word",
          "count"
        ]
      },
      "WordfreqResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WordCount"
            }
          },
          "remaining_requests": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "Present when no information was found or additional context is needed."
          }
        },
        "required": [
          "success",
          "user_id",
          "count",
          "words",
          "remaining_requests"
        ]
      },
      "ProfileSummaryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer"
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "remaining_requests": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "Present when no information was found or additional context is needed."
          }
        },
        "required": [
          "success",
          "user_id",
          "summary",
          "remaining_requests",
          "error"
        ]
      },
      "QuotaResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer"
          },
          "remaining_requests": {
            "type": "integer"
          },
          "grant": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "success",
          "user_id",
          "remaining_requests"
        ]
      },
      "RedeemRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "RedeemResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "added_requests": {
            "type": "integer"
          },
          "remaining_requests": {
            "type": "integer"
          }
        },
        "required": [
          "success",
          "user_id",
          "code",
          "added_requests",
          "remaining_requests"
        ]
      }
    }
  }
}