  "components": {
    "schemas": {
      "MembershipTierPricing": {
        "required": [
          "price",
          "limit",
          "perFilialLimit",
          "active",
          "recommended"
        ],
        "properties": {
          "price": {
            "type": "number",
            "format": "float"
          },
          "limit": {
            "type": "integer"
          },
          "perFilialLimit": {
            "type": "integer"
