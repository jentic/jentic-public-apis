      "CreatePromotionInput": {
        "required": [
          "name",
          "startDate",
          "endDate",
          "backgroundImageBase64"
        ],
        "properties": {
          "customFields": {
            "description": "Optional. Up to 3 custom fields shown on the promotion card. Each item: name (required), value (optional), type (optional, one of: string, title, startDate, endDate, remainingUsages).",
            "type": "array",
            "items": {
              "properties": {
                "name": {
                  "description": "Label of the field",
                  "type": "string",
                  "example": "Valid until"
                },
                "value": {
                  "description": "Static value (for type string/title) or leave empty for auto-filled types (startDate, endDate, remainingUsages)",
                  "type": "string",
                  "example": ""
                },
                "type": {
                  "description": "One of: string, title, startDate, endDate, remainingUsages",
                  "type": "string",
                  "enum": [
                    "string",
                    "title",
                    "startDate",
                    "endDate",
                    "remainingUsages"
                  ]
                }
              },
              "type": "object"
            },
            "maxItems": 3,
            "example": [
              {
                "name": "Valid until",
                "value": "",
                "type": "endDate"
              },
              {
                "name": "Uses left",
                "value": "",
                "type": "remainingUsages"
              }
            ]
          },
          "templates": {
            "title": "Template IDs to attach the promotion to.",
            "description": "Optional. Array of existing template IDs to attach the promotion to. Use empty array if none.",
            "type": "array",
            "items": {
              "description": "Template ID",
              "type": "integer"
            },
            "example": []
          },
          "pushes": {
            "description": "Optional. Schedule push notifications at promotion start and/or end. Object with optional \"start\" and \"end\" keys; each has enabled (bool), plannedDate (ISO 8601 datetime when to send), text (notification message).",
            "properties": {
              "start": {
                "description": "Push when promotion starts",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "example": true
                  },
                  "plannedDate": {
                    "description": "ISO 8601 datetime",
                    "type": "string",
                    "example": "2025-03-01T10:00:00+00:00"
                  },
                  "text": {
                    "description": "Push message text",
                    "type": "string",
                    "example": "Your promotion has started!"
                  }
                },
                "type": "object"
              },
              "end": {
                "description": "Push when promotion ends",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "example": true
                  },
                  "plannedDate": {
                    "type": "string",
                    "example": "2025-03-31T23:59:59+00:00"
                  },
                  "text": {
                    "type": "string",
                    "example": "Last day of the promotion!"
                  }
                },
                "type": "object"
              }
            },
            "type": "object",
            "example": {
              "start": {
                "enabled": true,
                "plannedDate": "2025-03-01T10:00:00+00:00",
                "text": "Your promotion has started!"
              },
              "end": {
                "enabled": true,
                "plannedDate": "2025-03-31T23:59:59+00:00",
                "text": "Last day of the promotion!"
              }
            }
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "nullable": true
          },
          "maxUsages": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "maxGlobalRedemptions": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "backgroundImageBase64": {
            "title": "Base64-encoded PNG for background image. Use 'none' to remove existing image.",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object"
      },
      "EditPromotionInput": {
        "description": "All fields are optional. Only sent fields are updated.",
        "properties": {
          "customFields": {
            "description": "Up to 3 custom fields on the promotion card. Each item: name (required), value (optional), type (optional). Type one of: string, title, startDate, endDate, remainingUsages.",
