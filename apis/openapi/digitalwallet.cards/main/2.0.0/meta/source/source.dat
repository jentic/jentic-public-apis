            "enum": [
              0,
              1,
              2
            ]
          },
          "threshold": {
            "type": "integer",
            "default": 0
          },
          "value": {
            "type": "number",
            "format": "float"
          },
          "valueLimit": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "usageLimit": {
            "type": "integer",
            "nullable": true
          }
        },
