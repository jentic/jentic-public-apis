            "type": "array",
            "items": {
              "description": "Template ID",
              "type": "integer"
            },
            "example": []
          },
          "pushes": {
            "description": "Push notifications at promotion start/end. Optional keys: start, end. Each: enabled (bool), plannedDate (ISO 8601), text (message).",
            "properties": {
              "start": {
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "plannedDate": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "end": {
                "properties": {
