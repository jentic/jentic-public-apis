      "Check": {
        "required": [
          "amount",
          "currency",
          "selections"
        ],
        "properties": {
          "amount": {
            "description": "Total amount of the check in cents.",
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "description": "Currency in ISO 4217 3-letter code.",
            "type": "string",
            "nullable": true
          },
          "selections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Selection"
            }
          }
        },
        "type": "object"
      },
      "TransactionResultOutput": {
        "properties": {
          "installationId": {
            "description": "Id of the app installation",
            "type": "integer",
            "nullable": true
          },
          "templateId": {
            "description": "Id of the card template",
            "type": "integer",
            "nullable": true
          },
          "companyId": {
            "description": "Id of the merchant company",
            "type": "integer",
            "nullable": true
          },
          "isSuccess": {
            "type": "boolean",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
