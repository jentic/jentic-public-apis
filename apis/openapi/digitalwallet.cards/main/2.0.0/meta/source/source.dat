            "type": "integer",
            "nullable": true
          },
          "serialNumber": {
            "type": "string",
            "nullable": true
          },
          "checkAmount": {
            "description": "Total amount of the check in cents",
            "type": "integer",
            "nullable": true
          },
          "accrualAmount": {
            "description": "Amount in cents to accrue",
            "type": "integer",
            "nullable": true
          },
          "accruedValue": {
            "description": "Actually accrued amount in cents. May be 0 in specific cases",
            "type": "integer",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "reversedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "type": "object"
      },
      "StatsByPeriodOutput": {
        "required": [
          "date",
          "value"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "format": "float"
          }
        },
        "type": "object"
      },
      "Selection": {
        "required": [
          "quantity",
          "totalPrice"
        ],
        "properties": {
          "id": {
            "description": "Inventory item unique ID. Need to work an accrual rule with specific SKU.",
            "type": "string",
            "nullable": true
          },
          "groupId": {
            "description": "Group ID of inventory item. Need to work an accrual rule with specific SKU group.",
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "description": "Inventory item display name.",
            "type": "string",
            "nullable": true
          },
          "price": {
            "description": "Inventory item price in cents.",
            "type": "integer",
            "nullable": true
          },
          "quantity": {
            "description": "Quantity of items. Should be positive.",
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "nullable": true
          },
          "totalPrice": {
            "description": "Total price of the selection.",
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "type": "object"
      }
    },
    "parameters": {
      "page": {
        "name": "page",
        "in": "query",
        "description": "Page number",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "itemsPerPage": {
        "name": "itemsPerPage",
        "in": "query",
        "description": "Items per page",
        "schema": {
          "type": "integer",
          "default": 30,
          "maximum": 1000,
          "minimum": 1
        }
      },
      "startDate": {
        "name": "startDate",
        "in": "query",
        "description": "Start date (format Y-m-d)",
        "schema": {
          "type": "string",
          "format": "date",
          "default": null
        }
      },
      "endDate": {
        "name": "endDate",
        "in": "query",
        "description": "End date (format Y-m-d)",
        "schema": {
          "type": "string",
          "format": "date",
          "default": null
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
