                    "type": "string",
                    "enum": [
                      "Male",
                      "Female"
                    ]
                  },
                  "medium": {
                    "type": "string",
                    "enum": [
                      "English",
                      "Sinhala"
                    ]
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  },
                  "retypePassword": {
                    "type": "string"
                  },
                  "streamId": {
                    "type": "string"
                  },
                  "subject01Id": {
                    "type": "string"
                  },
                  "subject02Id": {
                    "type": "string"
                  },
                  "subject03Id": {
                    "type": "string"
                  },
                  "deviceId": {
                    "type": "string"
                  },
                  "macAddress": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered successfully",
