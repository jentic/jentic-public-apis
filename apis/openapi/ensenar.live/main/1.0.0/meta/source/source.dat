{
  "openapi": "3.0.3",
  "info": {
    "title": "Ensenar Backend API",
    "description": "Comprehensive API documentation for the Ensenar educational platform backend.\nEnsenar is an A/L (Advanced Level) education platform connecting students with teachers,\nfeaturing quizzes, lecture materials, discussions, payments, study tracking, and more.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Ensenar Dev Team"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ensenar/ensenar-backend-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://ensenar.live/api",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Server health check"
    },
    {
      "name": "Auth",
      "description": "Authentication & Registration"
    },
    {
      "name": "Password Reset",
      "description": "Password reset via OTP"
    },
    {
      "name": "Users (Legacy)",
      "description": "Legacy mock user CRUD"
    },
    {
      "name": "Admin - User Management",
      "description": "Admin endpoints for managing students, teachers, and admins"
    },
    {
      "name": "Admin - Streams & Subjects",
      "description": "Admin endpoints for A/L stream and subject management"
    },
    {
      "name": "Student Profile",
      "description": "Student profile management"
    },
    {
      "name": "Student Quiz",
      "description": "Student quiz operations (enroll, attempt, submit)"
    },
    {
      "name": "Student Study Timer",
      "description": "Study session tracking"
    },
    {
      "name": "Student Distraction",
      "description": "Distraction tracking during study"
    },
    {
      "name": "Student Past Paper",
      "description": "Past paper practice timer"
    },
    {
      "name": "Student Academic Performance",
      "description": "Manual academic performance logging"
    },
    {
      "name": "Student Sleep",
      "description": "Sleep tracking"
    },
    {
      "name": "Student ML Prediction",
      "description": "Machine learning predictions and recommendations"
    },
    {
      "name": "Student Device Stats",
      "description": "Mobile device stats (notifications & app usage)"
    },
    {
      "name": "Teacher Profile",
      "description": "Teacher profile management"
    },
    {
      "name": "Teacher Quiz",
      "description": "Teacher quiz creation and management"
    },
    {
      "name": "Teacher Finance",
      "description": "Teacher bank details and revenue"
    },
    {
      "name": "Lecture Materials",
      "description": "Lecture material upload and management"
    },
    {
      "name": "Discussions",
      "description": "Student discussion forums and messaging"
    },
    {
      "name": "Complaints",
      "description": "Complaint management for students, teachers, and admins"
    },
    {
      "name": "Payments",
      "description": "PayHere payment integration"
    },
    {
      "name": "Agent",
      "description": "Desktop/mobile agent device registration and usage"
    },
    {
      "name": "Rating",
      "description": "Quiz and teacher rating"
    },
    {
      "name": "Admin Profile",
      "description": "Admin profile management"
    },
    {
      "name": "Admin Finance",
      "description": "Admin finance and payout operations"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from /auth/login"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Something went wrong"
          }
        }
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Stream": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Physical Science"
          },
          "code": {
            "type": "string",
            "example": "PHYS"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Subject": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Combined Mathematics"
          },
          "code": {
            "type": "string",
            "example": "CMATH"
          },
          "description": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobileNumber": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "minimum": 15,
            "maximum": 25
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female"
            ]
          },
          "medium": {
            "type": "string",
            "enum": [
              "English",
              "Sinhala"
            ]
          },
          "stream": {
            "type": "string"
          },
          "subject01": {
            "type": "string"
          },
          "subject02": {
            "type": "string"
          },
          "subject03": {
            "type": "string"
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "example": "STUDENT"
          },
          "status": {
            "type": "string",
            "enum": [
              "Blocked",
              "Unblocked"
            ]
          },
          "isEmailVerified": {
            "type": "boolean"
          },
          "isChatRestricted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Teacher": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobileNumber": {
            "type": "string"
          },
          "institute": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "example": "TEACHER"
          },
          "status": {
            "type": "string",
            "enum": [
              "Approved",
              "Not Approved",
              "Rejected",
              "Blocked",
              "Unblocked"
            ]
          },
          "isEmailVerified": {
            "type": "boolean"
          },
          "averageRating": {
            "type": "number"
          },
          "ratingCount": {
            "type": "integer"
          },
          "bankDetails": {
            "type": "object",
            "properties": {
              "bankName": {
                "type": "string"
              },
              "branchName": {
                "type": "string"
              },
              "accountNumber": {
                "type": "string"
              },
              "accountHolderName": {
                "type": "string"
              },
              "accountType": {
                "type": "string"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "ADMIN"
          },
          "authorizationLevel": {
            "type": "string",
            "enum": [
              "Super Admin",
              "Admin",
              "Moderator"
            ]
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Blocked",
              "Unblocked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Quiz": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "topicId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtopicId": {
            "type": "string"
          },
          "subtopicName": {
            "type": "string"
          },
          "subtopicDescription": {
            "type": "string"
          },
          "quizType": {
            "type": "string",
            "enum": [
              "MCQ",
              "ESSAY",
              "FULL_PAPER"
            ]
          },
          "isPaid": {
            "type": "boolean"
          },
          "amount": {
            "type": "number"
          },
          "transactionFee": {
            "type": "number"
          },
          "totalAmount": {
            "type": "number"
          },
          "meetingDate": {
            "type": "string",
            "format": "date-time"
          },
          "onlineMeetingId": {
            "type": "string"
          },
          "onlineMeetingJoinUrl": {
            "type": "string"
          },
          "isMeetingStarted": {
            "type": "boolean"
          },
          "isMeetingEnded": {
            "type": "boolean"
          },
          "mcqQuestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MCQQuestion"
            }
          },
          "numberOfQuestions": {
            "type": "integer"
          },
          "numberOfAnswersPerQuestion": {
            "type": "integer"
          },
          "essayDocumentUrl": {
            "type": "string"
          },
          "answerSheetUrl": {
            "type": "string"
          },
          "hasMCQ": {
            "type": "boolean"
          },
          "hasEssay": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ]
          },
          "enrolledStudents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "studentId": {
                  "type": "string"
                },
                "studentName": {
                  "type": "string"
                },
                "enrolledAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "paymentStatus": {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "COMPLETED",
                    "FAILED"
                  ]
                }
              }
            }
          },
          "averageRating": {
            "type": "number"
          },
          "ratingCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MCQQuestion": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "answerText": {
                  "type": "string"
                },
                "isCorrect": {
                  "type": "boolean"
                }
              }
            }
          },
          "questionNumber": {
            "type": "integer"
          }
        }
      },
      "QuizAttempt": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "studentId": {
            "type": "string"
          },
          "quizId": {
            "type": "string"
          },
          "attemptNumber": {
            "type": "integer"
          },
          "attemptStatus": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "SUBMITTED",
              "GRADED",
              "EXPIRED"
            ]
          },
          "mcqAnswers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string"
                },
                "questionNumber": {
                  "type": "integer"
                },
                "selectedAnswer": {
                  "type": "string"
                },
                "isCorrect": {
                  "type": "boolean"
                }
              }
            }
          },
          "mcqScore": {
            "type": "number"
          },
          "mcqTotalQuestions": {
            "type": "integer"
          },
          "mcqCorrectAnswers": {
            "type": "integer"
          },
          "essayDocumentUrl": {
            "type": "string"
          },
          "essayScore": {
            "type": "number"
          },
          "essayFeedback": {
            "type": "string"
          },
          "totalScore": {
            "type": "number"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "gradedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Discussion": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED",
              "RESOLVED"
            ]
          },
          "participantCount": {
            "type": "integer"
          },
          "messageCount": {
            "type": "integer"
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DiscussionMessage": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "discussionId": {
            "type": "string"
          },
          "senderId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "audioUrl": {
            "type": "string"
          },
          "replyTo": {
            "type": "string"
          },
          "isEdited": {
            "type": "boolean"
          },
          "isDeleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Complaint": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "complaintType": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "SYSTEM"
            ]
          },
          "studentId": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "RESOLVED",
              "REJECTED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "adminResponse": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "senderId": {
                  "type": "string"
                },
                "senderType": {
                  "type": "string",
                  "enum": [
                    "STUDENT",
                    "TEACHER",
                    "ADMIN"
                  ]
                },
                "senderName": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "sentAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "isRead": {
                  "type": "boolean"
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "studentId": {
            "type": "string"
          },
          "quizId": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "example": "LKR"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUCCESS",
              "FAILED",
              "CANCELLED"
            ]
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LectureMaterial": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "topicId": {
            "type": "string"
          },
          "subtopicId": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string"
                },
                "originalName": {
                  "type": "string"
                },
                "fileUrl": {
                  "type": "string"
