    "/teacher/quizzes/mcq": {
      "post": {
        "tags": [
          "Teacher Quiz"
        ],
        "summary": "Create MCQ quiz",
        "operationId": "createMCQQuiz",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "topicId",
                  "subtopicId",
                  "meetingDate",
                  "mcqQuestions",
                  "numberOfAnswersPerQuestion"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "topicId": {
                    "type": "string"
                  },
                  "subtopicId": {
                    "type": "string"
                  },
                  "meetingDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "isPaid": {
                    "type": "boolean"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "onlineMeetingId": {
                    "type": "string"
                  },
                  "onlineMeetingJoinUrl": {
                    "type": "string"
                  },
                  "numberOfAnswersPerQuestion": {
                    "type": "integer"
                  },
                  "mcqQuestions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "question",
                        "answers",
                        "questionNumber"
                      ],
                      "properties": {
                        "question": {
                          "type": "string"
                        },
                        "questionNumber": {
                          "type": "integer"
                        },
                        "answers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "answerText": {
                                "type": "string"
                              },
                              "isCorrect": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "MCQ quiz created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "quiz": {
                          "$ref": "#/components/schemas/Quiz"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
