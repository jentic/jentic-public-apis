    "/student/device-stats": {
      "post": {
        "tags": [
          "Student Device Stats"
        ],
        "summary": "Save mobile device stats",
        "operationId": "saveDeviceStats",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "notificationEnabled"
                ],
                "properties": {
                  "notificationEnabled": {
                    "type": "boolean"
                  },
                  "notificationCategory": {
                    "type": "string",
                    "enum": [
                      "Always turned off",
                      "Sometimes turned off",
                      "Usually kept on",
                      "Always kept on",
                      "Unknown"
                    ]
                  },
                  "notificationOnPercent": {
                    "type": "number"
                  },
                  "appUsage": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "appName": {
                          "type": "string"
                        },
                        "packageName": {
                          "type": "string"
                        },
                        "timeMs": {
                          "type": "number"
                        },
                        "category": {
                          "type": "string",
                          "enum": [
                            "educational",
                            "social",
                            "other"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stats saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                }
              }
            }
          }
        }
