      "get": {
        "tags": [
          "Email"
        ],
        "summary": "Get email transactions stats for a given period",
        "description": "Get email transactions stats for a given period",
        "operationId": "getTransactionalEmailStats",
        "parameters": [
          {
            "name": "emailId",
            "in": "path",
            "description": "Id of the email to get transactions from",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
