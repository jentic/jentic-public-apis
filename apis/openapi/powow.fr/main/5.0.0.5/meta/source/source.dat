      "put": {
        "tags": [
          "List",
          "Custom field"
        ],
        "summary": "Edit a new Custom Field into an existing list",
        "description": "Edit a new Custom Field into an existing list",
        "operationId": "editCustomFieldByUser",
        "parameters": [
          {
            "name": "listId",
            "in": "path",
            "required": true,
            "schema": {
              "description": "Id of the list to which the field belongs",
              "type": "integer",
              "format": "int64",
              "example": "64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "description": "Field name (unique among list fields; used for personalization)",
                    "type": "string",
                    "example": "Firstname"
                  },
                  "type": {
                    "description": "Field type (for form rendering)",
                    "type": "string",
                    "default": "single line",
                    "enum": [
                      "single line",
                      "paragraph text",
                      "radio",
                      "drop down",
                      "checkboxes",
                      "hidden field",
                      "json"
                    ]
                  },
                  "default": {
                    "description": "Default value if parameter is not pass when creating subscriber",
                    "type": "string",
                    "example": "John"
                  },
                  "method": {
                    "description": "Method to use to validate value",
                    "type": "string",
                    "default": "disabled",
                    "enum": [
                      "disabled",
                      "numbers",
                      "letters",
                      "numbers and letters",
                      "email address",
                      "url",
                      "datetime",
                      "date",
                      "time",
                      "custom",
                      "enum",
                      "phone number"
                    ]
                  },
                  "rule": {
                    "description": "Regex for custom value validation",
                    "type": "string",
                    "example": "^[a-z\\-_\\+]+@iroquois\\.fr$"
                  },
                  "description": {
                    "description": "Description of the field (displayed to subscriber if the fild is not hidden)",
                    "type": "string"
                  },
                  "options": {
                    "description": "Options available for a multi-choices type field (radio buttons, checkboxes, dropdown)",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/FieldOptions"
                    }
                  },
                  "visibility": {
                    "description": "Who can display the field",
                    "type": "string",
                    "default": "public",
                    "enum": [
                      "owner only",
                      "user only",
                      "public"
                    ]
                  },
                  "segmentable": {
                    "description": "Wether the field can be used for segmentation or not",
                    "type": "boolean",
                    "example": true
                  },
                  "required": {
                    "description": "Wether the field is required for subscription or not",
                    "type": "boolean",
                    "example": true
                  },
                  "unique": {
                    "description": "Wether the field value shall appear only once among all subscribers or not",
                    "type": "boolean",
                    "example": true
                  },
                  "global": {
                    "description": "Wether the field shall be automatically added on user's new lists or not",
                    "type": "boolean",
                    "example": true
                  },
                  "shared": {
                    "description": "Wether the field can be accessed by duplicated or used on other lists by sharers or not",
                    "type": "boolean",
                    "example": true
                  },
                  "model": {
                    "description": "Predefined model on which the field is defined (if so); use defined validation and can be used for automatic personalization; only one field of each type can be defined on a list for Address and Identity",
                    "type": "string",
                    "default": "None",
                    "enum": [
                      "None",
                      "Phone number",
                      "Email address",
                      "URL",
                      "Address - Country",
                      "Address - State",
                      "Address - City",
                      "Address - Postal code",
                      "Address - Street",
                      "Address - Additional 1",
                      "Address - Additional 2",
                      "Address - Additional 3",
                      "Identity - Civility",
                      "Identity - Firstname",
                      "Identity - Lastname",
                      "Identity - Birthname",
                      "Identity - Birthday"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Custom field created",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "customFieldId": {
                      "type": "integer",
                      "example": ""
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Data not found",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "List id : 512 is not valid"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
