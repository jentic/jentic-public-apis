                    "description": "Language of the sms",
                    "type": "string",
                    "enum": [
                      "en",
                      "fr",
                      "it",
                      "es",
                      "de",
                      "pt",
                      "pl",
                      "zh"
                    ],
                    "example": "fr"
                  },
