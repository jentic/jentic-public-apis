      "post": {
        "tags": [
          "List"
        ],
        "summary": "Import subscribers in a list",
        "description": "Import subscribers in a list",
        "operationId": "importSubscribersByUser",
        "parameters": [
          {
            "name": "listId",
            "in": "path",
            "description": "Id of the list",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "fields",
                  "importType"
                ],
                "properties": {
                  "fields": {
                    "description": "Fields of the list (id can be emailAddress, emailOptinDate, emailSubscriptionIp, phoneNumber, phoneOptinDate, phoneSubscriptionIp or custom field id)",
                    "type": "array",
                    "items": {
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "1"
                        },
                        "index": {
                          "type": "integer",
                          "format": "int64",
                          "example": "1"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "importType": {
                    "description": "Type of import",
                    "type": "string",
                    "enum": [
                      "copy",
                      "file"
                    ],
                    "example": "copy"
                  },
                  "importData": {
                    "description": "Data to import (Required if importType is copy)",
                    "type": "string",
                    "example": ""
                  },
                  "filename": {
                    "description": "Name of the file to import (Required if importType is file)",
                    "type": "string",
                    "example": "test.csv"
                  },
                  "duplicatesStrategy": {
                    "description": "Strategy to apply for duplicates (can be updateOldSubscriber or createNewSubscriber, default on updateOldSubscriber)",
                    "type": "string",
                    "enum": [
                      "updateOldSubscriber",
                      "createNewSubscriber"
                    ],
                    "example": "updateOldSubscriber"
                  },
                  "enclosure": {
                    "description": "Enclosure of the data to import",
                    "type": "string",
                    "example": ""
                  },
                  "separator": {
                    "description": "Separator of the data to import",
                    "type": "string",
                    "example": ";"
                  },
                  "ignoreFirstLine": {
                    "description": "Ignore first line of the data to import",
                    "type": "boolean",
                    "example": "true"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported data successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "Message": {
                      "type": "string",
                      "example": "Import #1 completed"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid field / Data not found / Error",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "List id : 0 is not valid"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "List #1 not found"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Email address field need to be specify only once"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "Message": {
                      "type": "string",
                      "example": "Unauthorized action, please contact administrator"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "You are not allowed to import subscribers."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ]
      }
