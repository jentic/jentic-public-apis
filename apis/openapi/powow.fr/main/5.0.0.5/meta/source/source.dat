    "/user/lists/{listId}/exports": {
      "post": {
        "tags": [
          "List"
        ],
        "summary": "Export subscribers and related data",
        "description": "Export subscribers, blacklists, unsubscribers, bounces or segments from a list in CSV, JSON or XML format. User context.",
        "operationId": "exportSubscribersAsUser",
        "parameters": [
          {
            "name": "listId",
            "in": "path",
            "description": "List identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 42
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "exportTypes"
                ],
                "properties": {
                  "exportTypes": {
                    "description": "Types of data to export",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "subscribers",
                        "blacklistEmails",
                        "blacklistPhones",
                        "unsubscribers",
                        "softBounces",
                        "hardBounces",
                        "segments",
                        "all"
                      ]
                    },
                    "example": [
                      "subscribers",
                      "unsubscribers"
                    ]
                  },
                  "exportFields": {
                    "description": "Standard subscriber fields to export",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "subscriberId",
                        "emailAddress",
                        "phoneNumber",
                        "phoneAreaCode",
                        "phoneNetworkCode",
                        "emailBounceType",
                        "phoneBounceType",
                        "emailSubscriptionStatus",
                        "phoneSubscriptionStatus",
                        "emailSubscriptionDate",
                        "phoneSubscriptionDate",
                        "subscriptionIp",
                        "emailOptinDate",
                        "phoneOptinDate",
                        "emailUnsubscriptionDate",
                        "unsubscriptionIp",
                        "unsubscriptionReason",
                        "phoneUnsubscriptionDate"
                      ]
                    },
                    "example": [
                      "emailAddress",
                      "emailSubscriptionStatus"
                    ]
                  },
                  "exportCustomFields": {
                    "description": "Custom field IDs to export",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      12,
                      18
                    ]
                  },
                  "exportSegments": {
                    "description": "Segment IDs to export",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      3,
                      7
                    ]
                  },
                  "fileFormat": {
                    "description": "Export file format",
                    "type": "string",
                    "default": "csv",
                    "enum": [
                      "csv",
                      "json",
                      "xml"
                    ],
                    "example": "csv"
                  },
                  "multipleFiles": {
                    "description": "Generate one file per export type or a combined file",
                    "type": "boolean",
                    "default": true,
                    "example": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Export successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "string",
                      "example": "https://app.example.com/data/exports/xxxx/export_12_42_subscribers_20240101123000.csv"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "https://app.example.com/data/exports/xxxx/export_12_42_subscribers_20240101123000.csv",
                        "https://app.example.com/data/exports/xxxx/export_12_42_unsubscribers_20240101123001.csv"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing parameters",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Missing field: exportTypes"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Export type : invalidType"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Export fields : emailFoo"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "File format : pdf"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Missing field: exportFields or exportCustomFields"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
