        ],
        "summary": "Import blacklists",
        "description": "Import blacklists",
        "operationId": "importBlacklistsByUser",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "fields",
                  "importType"
                ],
                "properties": {
                  "fields": {
                    "description": "Fields of the list (id can be emailAddress or phoneNumber)",
                    "type": "array",
                    "items": {
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "emailAddress"
                        },
                        "index": {
                          "type": "integer",
                          "format": "int64",
                          "example": "1"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "importType": {
                    "description": "Type of import",
                    "type": "string",
                    "enum": [
                      "copy",
                      "file"
                    ],
                    "example": "copy"
                  },
                  "importData": {
                    "description": "Data to import (Required if importType is copy)",
                    "type": "string",
                    "example": ""
                  },
                  "userId": {
                    "description": "Id of the user to import blacklists (Required if listId is not specified)",
                    "type": "integer",
                    "example": 1
                  },
                  "listId": {
                    "description": "Id of the list to import blacklists (Required if userId is not specified)",
                    "type": "integer",
                    "example": 1
                  },
                  "filename": {
                    "description": "File name (Required if importType is file)",
                    "type": "string"
                  },
                  "isHashed": {
                    "description": "Is the file hashed in SHA256",
                    "type": "boolean",
                    "example": true
                  },
                  "separator": {
                    "description": "Separator of the file",
                    "type": "string",
                    "example": ";"
                  },
                  "enclosure": {
                    "description": "Enclosure of the file",
                    "type": "string",
                    "example": ""
                  },
                  "ignoreFirstLine": {
                    "description": "Ignore first line of the file",
                    "type": "boolean",
                    "example": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported blacklists successfully"
          },
          "400": {
            "description": "Error / Invalid Field / Missing Field / Data not found",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
