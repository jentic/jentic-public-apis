    "/user/sms-campaigns/{campaignId}/stats": {
      "get": {
        "tags": [
          "Sms campaign"
        ],
        "summary": "Get sms campaign statistics",
        "description": "Get sms campaign statistics",
        "operationId": "getSmsCampaignStats",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "description": "Id of the sms campaign to get",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          },
          {
            "name": "segmentId",
            "in": "query",
            "description": "Id of the segment to filter statistics",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          },
          {
            "name": "statistics",
            "in": "query",
            "description": "Statistics options to retrieve",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "delivered",
                  "failed",
                  "recipients",
                  "sent",
                  "pendingOnSmsCenter",
                  "bounces",
                  "clicks",
                  "unsubscriptions",
                  "totalClicksByLink",
                  "totalClicksByDatetime",
                  "totalUniqueClicksByDatetime",
                  "totalUnsubscriptionsByDatetime"
                ]
              },
              "example": [
                "delivered",
                "failed",
                "recipients",
                "sent",
                "pendingOnSmsCenter",
                "bounces",
                "clicks",
                "unsubscriptions",
                "totalClicksByLink",
                "totalClicksByDatetime",
                "totalUniqueClicksByDatetime",
                "totalUnsubscriptionsByDatetime"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sms campaign statistics successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "sent": {
                        "description": "Number of sms sent",
                        "type": "integer"
                      },
                      "sentPercentage": {
                        "description": "Percentage of sms sent",
                        "type": "number",
                        "format": "float"
                      },
                      "recipientsDelivered": {
                        "description": "Number of recipients delivered",
                        "type": "integer"
                      },
                      "recipientsDeliveredPercentage": {
                        "description": "Percentage of recipients delivered",
                        "type": "number",
                        "format": "float"
                      },
                      "delivered": {
                        "description": "Number of sms delivered",
                        "type": "integer"
                      },
                      "deliveredPercentage": {
                        "description": "Percentage of sms delivered",
                        "type": "number",
                        "format": "float"
                      },
                      "recipients": {
                        "description": "Number of recipients",
                        "type": "integer"
                      },
                      "recipientsPercentage": {
                        "description": "Percentage of recipients",
                        "type": "number",
                        "format": "float"
                      },
                      "pendingOnSmsCenter": {
                        "description": "Number of sms pending on sms center",
                        "type": "integer"
                      },
                      "recipientsPendingOnSmsCenter": {
                        "description": "Number of recipients pending on sms center",
                        "type": "integer"
                      },
                      "pendingOnSmsCenterPercentage": {
                        "description": "Percentage of sms pending on sms center",
                        "type": "number",
                        "format": "float"
                      },
                      "recipientsPendingOnSmsCenterPercentage": {
                        "description": "Percentage of recipients pending on sms center",
                        "type": "number",
                        "format": "float"
                      },
                      "recipientsSoftBounces": {
                        "description": "Number of recipients soft bounces",
                        "type": "integer"
                      },
                      "recipientsSoftBouncesPercentage": {
                        "description": "Percentage of recipients soft bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "softBounces": {
                        "description": "Number of sms soft bounces",
                        "type": "integer"
                      },
                      "softBouncesPercentage": {
                        "description": "Percentage of sms soft bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "recipientsHardBounces": {
                        "description": "Number of recipients hard bounces",
                        "type": "integer"
                      },
                      "recipientsHardBouncesPercentage": {
                        "description": "Percentage of recipients hard bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "hardBounces": {
                        "description": "Number of sms hard bounces",
                        "type": "integer"
                      },
                      "hardBouncesPercentage": {
                        "description": "Percentage of sms hard bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "failed": {
                        "description": "Number of failed sms",
                        "type": "integer"
                      },
                      "recipientsFailed": {
                        "description": "Number of recipients failed",
                        "type": "integer"
                      },
                      "failedPercentage": {
                        "description": "Percentage of failed sms",
                        "type": "number",
                        "format": "float"
                      },
                      "recipientsFailedPercentage": {
                        "description": "Percentage of recipients failed",
                        "type": "integer"
                      },
                      "clicks": {
                        "description": "Number of clicks",
                        "type": "integer"
                      },
                      "clicksPercentage": {
                        "description": "Percentage of clicks",
                        "type": "number",
                        "format": "float"
                      },
                      "uniqueClicks": {
                        "description": "Number of unique clicks",
                        "type": "integer"
                      },
                      "uniqueClicksPercentage": {
                        "description": "Percentage of unique clicks",
                        "type": "number",
                        "format": "float"
                      },
                      "unsubscriptions": {
                        "description": "Number of unsubscriptions",
                        "type": "integer"
                      },
                      "unsubscriptionsPercentage": {
