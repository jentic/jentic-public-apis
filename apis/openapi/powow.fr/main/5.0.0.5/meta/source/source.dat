      "post": {
        "tags": [
          "Email campaign"
        ],
        "summary": "Export email campaign statistics",
        "description": "Export email campaign statistics",
        "operationId": "exportEmailCampaignStats",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "description": "Id of the email campaign to export campaign statistics",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "exportMode": {
                    "description": "Export mode (default is subscribers)",
                    "type": "string",
                    "enum": [
                      "subscribers",
                      "campaignStatistics"
                    ]
                  },
                  "responseFormat": {
                    "description": "Response format (default is json)",
                    "type": "string",
                    "enum": [
                      "json",
                      "csv"
                    ],
                    "example": "json"
                  },
                  "exportFields": {
                    "description": "Fields to export (Only for exportMode = subscribers, emailAddress and subscriberId is required at least)",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "subscriberId",
                        "emailAddress",
                        "phoneNumber",
                        "phoneAreaCode",
                        "phoneNetworkCode",
                        "emailBounceType",
                        "phoneBounceType",
                        "emailSubscriptionStatus",
                        "phoneSubscriptionStatus",
                        "emailSubscriptionDate",
                        "phoneSubscriptionDate",
                        "subscriptionIp",
                        "emailOptinDate",
                        "phoneOptinDate",
                        "emailUnsubscriptionDate",
                        "unsubscriptionIp",
                        "unsubscriptionReason",
                        "phoneUnsubscriptionDate",
                        "queueDate",
                        "sendDate",
                        "smtpReply",
                        "bounceCategory",
                        "openers",
                        "nonOpeners",
                        "clickers",
                        "nonClickers"
                      ]
                    }
                  },
                  "exportCustomFields": {
                    "description": "Custom fields ids to export (Only for exportMode = subscribers)",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64",
                      "example": "1"
                    }
                  },
                  "exportLinks": {
                    "description": "Links to export (Only for exportMode = subscribers, required if exportFields contains clickers)",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "https://iroquois.fr"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign statistics exported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "description": "Url of the file containing the export (If responseFormat = csv and exportMode = campaignStatistics)",
                      "properties": {
                        "file": {
                          "type": "string",
                          "example": "https://"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "description": "Campaign statistics (If responseFormat = json and exportMode = campaignStatistics)",
                      "properties": {
                        "sendDate": {
                          "type": "string",
                          "example": "2025-01-01 10:00:00"
                        },
                        "listName": {
                          "type": "string",
                          "example": "My list"
                        },
                        "subject": {
                          "type": "string",
                          "example": "My subject"
                        },
                        "sent": {
                          "type": "integer",
                          "example": "132661"
                        },
                        "sentPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "100"
                        },
                        "delivered": {
                          "type": "integer",
                          "example": "132292"
                        },
                        "deliveredPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "99.72"
                        },
                        "softBounces": {
                          "type": "integer",
                          "example": "366"
                        },
                        "softBouncesPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0.28"
                        },
                        "hardBounces": {
                          "type": "integer",
                          "example": "0"
                        },
