                          "example": "Custom Field could not be created"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "Custom Field has been created but cannot be used"
                        }
                      },
                      "type": "object"
                    },
                    {
