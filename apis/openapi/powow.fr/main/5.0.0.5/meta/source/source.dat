    "/user/transactions-sms/{smsId}/send": {
      "put": {
        "tags": [
          "Sms transaction"
        ],
        "summary": "Sends a transactional sms after updating it. Use of a template available",
        "description": "Updates and sends a transactional sms. Use of a template available",
        "operationId": "updateAndSendSmsTransac",
        "parameters": [
          {
            "name": "smsId",
            "in": "path",
            "description": "Id of the sms to be used by the transaction",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "mobilePhoneNumber"
                ],
                "properties": {
                  "mobilePhoneNumber": {
                    "description": "Target for the transactional sms",
                    "type": "string",
                    "example": "+33699999999"
                  },
                  "language": {
                    "description": "Language of the sms",
                    "type": "string",
                    "enum": [
                      "en",
                      "fr",
                      "it",
                      "es",
                      "de",
                      "pt",
                      "pl",
                      "zh"
                    ],
                    "example": "fr"
                  },
                  "templateId": {
                    "description": "Template to be used to created sms. Can be set to 0 or not appear at all",
                    "type": "integer",
                    "example": 1
                  },
                  "smsName": {
                    "description": "If template is provided, then the template value is used !",
                    "type": "string",
                    "example": "Regional sms for December"
                  },
                  "fromName": {
                    "description": "From name of sms",
                    "type": "string",
                    "example": "Iroquois"
                  },
                  "content": {
                    "description": "If template is provided, then the template value is used !",
                    "type": "string",
                    "example": "Happy December %Subscriber%:%Name% !"
                  },
                  "customData": {
                    "description": "Custom data passed to replace the customfields of the sms",
                    "type": "object",
                    "example": {
                      "Name": "John"
                    }
                  },
                  "marketingPressureId": {
                    "description": "Marketing pressure to be used. If value is set to 0, no pressure will be applied. If field is empty the most restrictive pressure accessible by the account will be used",
                    "type": "integer",
                    "example": 1
                  },
                  "timeToSend": {
                    "description": "Time at which the transactional sms will be sent",
                    "type": "string",
                    "example": "2025-08-02 09:30:00"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transactional sms registered with success inside queue table",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "Message": {
                      "type": "string",
                      "example": "Transactional sms registered #15268"
                    }
                  },
                  "type": "object"
                }
