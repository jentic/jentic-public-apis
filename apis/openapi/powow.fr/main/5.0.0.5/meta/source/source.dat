              "schema": {
                "required": [
                  "recipientEmail"
                ],
                "properties": {
                  "recipientEmail": {
                    "description": "Receipt of transactional email",
                    "type": "string",
                    "example": "recipent@iroquois.fr"
                  },
                  "marketingPressureId": {
                    "description": "Marketing pressure to be used. If value is set to 0, no pressure will be applied. If field is empty the most restrictive pressure accessible by the account will be used",
                    "type": "integer",
                    "example": 1
                  },
                  "attachments": {
                    "description": "File to be uploaded as an attachment",
                    "type": "string",
                    "format": "binary"
                  },
                  "customData": {
                    "description": "Custom data passed to replace the customfields of the email",
                    "type": "object",
                    "example": {
                      "ville": "Annecy"
                    }
                  },
                  "timeToSend": {
                    "description": "Time to send the email, if no time is provided, the email will be sent right after his reception by our services",
                    "type": "string",
                    "example": "2025-08-02 09:30:00"
                  },
                  "priority": {
                    "description": "Priority of the email ",
                    "type": "integer",
