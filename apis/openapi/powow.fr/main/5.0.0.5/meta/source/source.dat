        ]
      },
      "post": {
        "tags": [
          "List"
        ],
        "summary": "Create a list",
        "description": "Create a subscription or rejection list.",
        "operationId": "createListAsUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "name"
                ],
                "properties": {
                  "userId": {
                    "description": "Defines the owner of the list.",
                    "type": "integer",
                    "example": 12
                  },
                  "description": {
                    "description": "Optional description of the list.",
                    "type": "string",
                    "example": "Main newsletter subscription list"
                  },
                  "hidden": {
                    "description": "If true, the list is hidden from the subscriber area.",
                    "type": "boolean",
                    "example": false
                  },
                  "favorite": {
                    "description": "If true, the list is displayed first in the lists view.",
                    "type": "boolean",
                    "example": true
                  },
                  "type": {
                    "description": "Type of the list.",
                    "type": "string",
                    "enum": [
                      "subscription",
                      "rejection"
                    ],
                    "example": "subscription"
                  },
                  "encryption": {
                    "description": "Encryption algorithm used to store subscriber identifiers.",
                    "type": "string",
                    "enum": [
                      "md5",
                      "sha1",
                      "sha256"
                    ],
                    "example": "sha256"
                  },
                  "deletionDelay": {
                    "description": "Delay in days before data deletion (between 29 and 1095).",
                    "type": "integer",
                    "example": 365
                  },
                  "optinMode": {
                    "description": "Opt-in mode (only for subscription lists).",
                    "type": "string",
                    "enum": [
                      "single",
                      "double"
                    ],
                    "example": "double"
                  },
                  "allowDuplicate": {
                    "description": "Allow duplicate subscriptions (subscription lists only).",
                    "type": "boolean",
                    "example": false
                  },
                  "optinConfirmationEmailId": {
                    "description": "Required when optinMode is 'double'. Email used to confirm subscription.",
                    "type": "integer",
                    "example": 145
                  },
                  "optinSubscribeToListId": {
                    "description": "List ID to subscribe the user to after opt-in confirmation.",
                    "type": "integer",
                    "example": 42
                  },
                  "optinUnsubscribeFromListId": {
                    "description": "List ID to unsubscribe the user from after opt-in confirmation.",
                    "type": "integer",
                    "example": 21
                  },
                  "optinConfirmUrl": {
                    "description": "Redirect URL after successful opt-in confirmation.",
                    "type": "string",
                    "example": "https://example.com/confirmed"
                  },
                  "optinPendingUrl": {
                    "description": "Redirect URL when opt-in is pending.",
                    "type": "string",
