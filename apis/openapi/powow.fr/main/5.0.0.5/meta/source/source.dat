    "/user/email-campaigns/{campaignId}/stats": {
      "get": {
        "tags": [
          "Email campaign"
        ],
        "summary": "Get email campaign statistics",
        "description": "Get email campaign statistics",
        "operationId": "getEmailCampaignStats",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "description": "Id of the email campaign to get statistics from",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          },
          {
            "name": "segmentId",
            "in": "query",
            "description": "Segment id used to filter statistics",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          },
          {
            "name": "statistics",
            "in": "query",
            "description": "Statistics options to retrieve",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "delivered",
                  "failed",
                  "recipients",
                  "sent",
                  "bounces",
                  "browserViews",
                  "clicks",
                  "complaints",
                  "forwards",
                  "opens",
                  "unsubscriptions",
                  "allByDomain",
                  "totalClicksByLink",
                  "totalClicksByDatetime",
                  "totalOpensByDatetime",
                  "totalOpensByDay",
                  "totalOpensByDevice",
                  "totalOpensByGeoIPLocation",
                  "totalOpensByHour",
                  "totalUniqueClicksByDatetime",
                  "totalUniqueOpensByDatetime",
                  "totalUnsubscriptionsByDatetime",
                  "totalUnsubscriptionsByReason",
                  "totalUnsubscriptionsBySubscriber",
                  "totalBouncesByReason"
                ]
              },
              "example": [
                "delivered",
                "failed",
                "recipients",
                "sent",
                "bounces",
                "browserViews",
                "clicks",
                "complaints",
                "forwards",
                "opens",
                "unsubscriptions",
                "allByDomain",
                "totalClicksByLink",
                "totalClicksByDatetime",
                "totalOpensByDatetime",
                "totalOpensByDay",
                "totalOpensByDevice",
                "totalOpensByGeoIPLocation",
                "totalOpensByHour",
                "totalUniqueClicksByDatetime",
                "totalUniqueOpensByDatetime",
                "totalUnsubscriptionsByDatetime",
                "totalUnsubscriptionsByReason",
                "totalUnsubscriptionsBySubscriber",
                "totalBouncesByReason"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email campaign statistics found successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "sent": {
                        "description": "Number of emails sent",
                        "type": "integer"
                      },
                      "sentPercentage": {
                        "description": "Percentage of emails sent",
                        "type": "number",
                        "format": "float"
                      },
                      "delivered": {
                        "description": "Number of emails delivered",
                        "type": "integer"
                      },
                      "deliveredPercentage": {
                        "description": "Percentage of emails delivered",
                        "type": "number",
                        "format": "float"
                      },
                      "recipients": {
                        "description": "Number of recipients",
                        "type": "integer"
                      },
                      "recipientsPercentage": {
                        "description": "Percentage of recipients",
                        "type": "number",
                        "format": "float"
                      },
                      "softBounces": {
                        "description": "Number of soft bounces",
                        "type": "integer"
                      },
                      "softBouncesPercentage": {
                        "description": "Percentage of soft bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "hardBounces": {
                        "description": "Number of hard bounces",
                        "type": "integer"
                      },
                      "hardBouncesPercentage": {
                        "description": "Percentage of hard bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "failed": {
                        "description": "Number of failed emails",
                        "type": "integer"
                      },
                      "failedPercentage": {
                        "description": "Percentage of failed emails",
                        "type": "number",
                        "format": "float"
                      },
                      "uniqueOpens": {
                        "description": "Number of unique opens",
                        "type": "integer"
                      },
                      "uniqueOpensPercentage": {
                        "description": "Percentage of unique opens",
                        "type": "number",
                        "format": "float"
                      },
                      "opens": {
                        "description": "Number of opens",
                        "type": "integer"
                      },
                      "opensPercentage": {
                        "description": "Percentage of opens",
                        "type": "number",
                        "format": "float"
                      },
                      "uniqueClicks": {
                        "description": "Number of unique clicks",
                        "type": "integer"
