      "post": {
        "tags": [
          "Sms campaign"
        ],
        "summary": "Export sms campaign statistics",
        "description": "Export sms campaign statistics",
        "operationId": "exportSmsCampaignStats",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "description": "Id of the sms campaign to export campaign statistics",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "exportMode": {
                    "description": "Export mode (default is subscribers)",
                    "type": "string",
                    "enum": [
                      "subscribers",
                      "campaignStatistics"
                    ],
                    "example": "subscribers"
                  },
                  "responseFormat": {
                    "description": "Response format (default is json)",
                    "type": "string",
                    "enum": [
                      "json",
                      "csv"
                    ],
                    "example": "json"
                  },
                  "exportFields": {
                    "description": "Fields to export (Only when exportMode is set to subscribers, phoneNumber and subscriberId is required at least)",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "subscriberId",
                        "emailAddress",
                        "phoneNumber",
                        "phoneAreaCode",
                        "phoneNetworkCode",
                        "emailBounceType",
                        "phoneBounceType",
                        "emailSubscriptionStatus",
                        "phoneSubscriptionStatus",
                        "emailSubscriptionDate",
                        "phoneSubscriptionDate",
                        "subscriptionIp",
                        "emailOptinDate",
                        "phoneOptinDate",
                        "emailUnsubscriptionDate",
                        "unsubscriptionIp",
                        "unsubscriptionReason",
                        "phoneUnsubscriptionDate",
                        "queueDate",
                        "sendDate",
                        "smtpReply",
                        "bounceCategory",
                        "openers",
                        "nonOpeners",
                        "clickers",
                        "nonClickers"
                      ]
                    }
                  },
                  "exportCustomFields": {
                    "description": "Custom fields ids to export (Only when exportMode is set to subscribers)",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64",
                      "example": "1"
                    }
                  },
                  "exportLinks": {
                    "description": "Links to export (Only when exportMode is set to subscribers, required if exportFields contains clickers)",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "https://iroquois.fr"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign statistics successfully exported",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "description": "Url of the file containing the export (If responseFormat = csv and exportMode = campaignStatistics)",
                      "properties": {
                        "file": {
                          "type": "string",
                          "example": "https://"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "description": "Campaign statistics (If responseFormat = json and exportMode = campaignStatistics)",
                      "properties": {
                        "sendDate": {
                          "type": "string",
                          "example": "2025-01-01 10:00:00"
                        },
                        "listName": {
                          "type": "string",
                          "example": "My list"
                        },
                        "fromName": {
                          "type": "string",
                          "example": "My sender"
                        },
                        "recipientsDelivered": {
                          "type": "integer",
                          "example": "101"
                        },
                        "delivered": {
                          "type": "integer",
                          "example": "202"
                        },
                        "recipientsSoftBounces": {
                          "type": "integer",
                          "example": "6"
                        },
                        "recipientsSoftBouncesPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "5.04"
                        },
                        "softBounces": {
                          "type": "integer",
                          "example": "12"
                        },
                        "softBouncesPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "5.31"
                        },
                        "recipientsHardBounces": {
                          "type": "integer",
                          "example": "0"
                        },
                        "recipientsHardBouncesPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0"
                        },
                        "hardBounces": {
                          "type": "integer",
                          "example": "0"
                        },
                        "hardBouncesPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0"
                        },
                        "clicks": {
                          "type": "integer",
                          "example": "0"
                        },
                        "clicksPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0"
                        },
                        "uniqueClicks": {
                          "type": "integer",
                          "example": "0"
                        },
                        "uniqueClicksPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0"
                        },
                        "unsubscriptions": {
                          "type": "integer",
                          "example": "1"
                        },
                        "unsubscriptionsPercentage": {
                          "type": "number",
                          "format": "float",
                          "example": "0.99"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "description": "Url of the file containing the export (If responseFormat = csv and exportMode = subscribers)",
                      "properties": {
                        "file": {
                          "type": "string",
                          "example": "https://"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "description": "Campaign subscribers statistics (If responseFormat = json and exportMode = subscribers)",
                      "type": "array",
                      "items": {
                        "properties": {
                          "SubscriberId": {
                            "type": "integer",
                            "example": "1"
                          },
                          "EmailAddress": {
                            "type": "string",
                            "example": "test@iroquois.fr"
                          },
                          "MobilePhoneNumber": {
                            "type": "string",
                            "example": "+336123456789"
                          },
                          "MobileCountryCode": {
                            "type": "string",
                            "example": ""
                          },
                          "MobileNetworkCode": {
                            "type": "string",
                            "example": ""
                          },
                          "BounceType": {
                            "type": "string",
                            "example": "Not Bounced"
                          },
                          "SmsBounceType": {
                            "type": "string",
                            "example": "Not Bounced"
                          },
                          "SubscriptionStatus": {
                            "type": "string",
                            "example": "Subscribed"
                          },
                          "SmsSubscriptionStatus": {
                            "type": "string",
                            "example": "Subscribed"
                          },
                          "SubscriptionDate": {
                            "type": "string",
                            "example": "2025-01-01 07:00:00"
                          },
                          "SmsSubscriptionDate": {
                            "type": "string",
                            "example": "2025-01-01 07:00:00"
                          },
                          "UnsubscriptionIP": {
                            "type": "string",
                            "example": ""
                          },
                          "UnsubscriptionReason": {
                            "type": "string",
                            "example": ""
                          },
                          "TotalAnswers": {
                            "type": "integer",
                            "example": "1"
                          },
                          "Opens": {
                            "type": "array",
                            "items": {
                              "properties": {
                                "text": {
                                  "type": "string",
                                  "example": "My answer"
                                },
                                "openDate": {
                                  "type": "string",
                                  "example": "2025-01-01 10:00:00"
                                }
                              },
                              "type": "object"
                            }
                          },
                          "LastAnswerDatetime": {
                            "type": "string",
                            "example": "2025-01-01 10:00:00"
                          }
                        },
                        "type": "object"
                      }
                    }
                  ]
                }
              }
            }
