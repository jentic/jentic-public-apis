      "post": {
        "tags": [
          "Sms campaign"
        ],
        "summary": "Create a sms campaign",
        "description": "Create a sms campaign",
        "operationId": "createSmsCampaign",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "name",
                  "content",
                  "listId"
                ],
                "properties": {
                  "name": {
                    "description": "Name of the sms campaign",
                    "type": "string",
                    "example": "My sms campaign"
                  },
                  "content": {
                    "description": "Content of the sms campaign",
                    "type": "string",
                    "example": "My sms content"
                  },
                  "listId": {
                    "description": "Id of the list to which the sms campaign is sent",
                    "type": "integer",
                    "format": "int64",
                    "example": "1"
                  },
                  "segmentIds": {
                    "description": "Array of segment ids to use",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64",
                      "example": [
                        1,
                        2,
                        3
                      ]
                    }
                  },
                  "tagIds": {
                    "description": "Array of tag ids to add to the sms campaign",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64",
                      "example": [
                        1,
                        2,
                        3
                      ]
                    }
                  },
                  "rejectionListId": {
                    "description": "Id of the rejection list to use (Need exclude list permission)",
                    "type": "integer",
                    "format": "int64",
                    "example": "1"
                  },
                  "pressureId": {
                    "description": "Id of the marketing pressure with which the sms campaign is sent",
                    "type": "integer",
                    "format": "int64",
                    "example": "1"
                  },
                  "senderName": {
                    "description": "Sender name of the sms campaign",
                    "type": "string",
                    "example": "My Sender Name"
                  },
                  "language": {
                    "description": "Language of the sms",
                    "type": "string",
                    "enum": [
                      "en",
                      "fr",
                      "it",
                      "es",
                      "de",
                      "pt",
                      "pl",
                      "zh"
                    ],
                    "example": "fr"
                  },
                  "shortLink": {
                    "description": "Indicates if links of the sms campaign should be shortened",
                    "type": "boolean",
                    "example": true
                  },
                  "allowDuplicate": {
                    "description": "Indicates if the sms campaign should allow duplicate recipients",
                    "type": "boolean",
                    "example": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sms campaign created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "Message": {
                      "type": "string",
                      "example": "Sms campaign #1 has been created for user #1"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid field / Company not found / Missing field / Error",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "List id : 0 is not valid"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "List #1 not found"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "The field name is missing"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "10 messages limit exceeded, please shorten your content"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "Message": {
                      "type": "string",
                      "example": "Unauthorized action, please contact administrator"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "You are not allowed to create sms campaign."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ]
      }
