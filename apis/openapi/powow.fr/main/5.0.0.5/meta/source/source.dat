    "/user/transactions-sms/send": {
      "post": {
        "tags": [
          "Sms transaction"
        ],
        "summary": "Sends a transactional sms after creates it. Use of a template is available",
        "description": "Creates and sends a transactional sms. Use of a template is available.",
        "operationId": "createAndSendSmsTransac",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "mobilePhoneNumber",
                  "language",
                  "smsName",
                  "fromName",
                  "content"
                ],
                "properties": {
                  "mobilePhoneNumber": {
                    "description": "Recipient of the transactional sms",
                    "type": "string",
                    "example": "+33699999999"
                  },
