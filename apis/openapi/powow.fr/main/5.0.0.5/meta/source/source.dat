      "post": {
        "tags": [
          "Marketing pressure"
        ],
        "summary": "Create a marketing pressure",
        "description": "Create a marketing pressure",
        "operationId": "createMarketingPressureForUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "name",
                  "description",
                  "state",
                  "type",
                  "target",
                  "mode",
                  "sendingLimit",
                  "periodType",
                  "periodValue"
                ],
                "properties": {
                  "name": {
                    "description": "Name of the pressure",
                    "type": "string",
                    "example": "Marketing Pressure Name"
                  },
                  "description": {
                    "description": "Description of the pressure",
                    "type": "string",
                    "example": "Detailed description of the pressure"
                  },
                  "state": {
                    "description": "State of the pressure. Not case sensitive",
                    "type": "string",
                    "enum": [
                      "enabled",
                      "disabled"
                    ],
                    "example": "disabled"
                  },
                  "type": {
                    "description": "Type selected for the pressure. Not case sensitive",
                    "type": "string",
                    "enum": [
                      "email",
                      "sms"
                    ],
                    "example": "email"
                  },
                  "target": {
                    "description": "Definition of the target. Not case sensitive. Not case sensitive",
                    "type": "string",
                    "enum": [
                      "all",
                      "campaigns",
                      "transactional"
                    ],
                    "example": "all "
                  },
                  "mode": {
                    "description": "Mode of sending. Not case sensitive",
                    "type": "string",
                    "enum": [
                      "all",
                      "specific"
                    ],
                    "example": "specific"
                  },
                  "tagId": {
                    "description": "ID of the selected tag for the campaign",
                    "type": "integer",
                    "format": "int64",
                    "example": 1
                  },
                  "sendingLimit": {
                    "description": "Limit for the pressure",
                    "type": "integer",
                    "format": "int64",
                    "example": 25
                  },
                  "periodType": {
                    "description": "Time type selection. Not case sensitive",
                    "type": "string",
                    "enum": [
                      "days",
                      "weeks",
                      "months"
                    ],
                    "example": "days"
