    "/user/transactions-emails/send": {
      "post": {
        "tags": [
          "Email transaction"
        ],
        "summary": "Creates and send a transactional email",
        "description": "Creates and send a transactional email",
        "operationId": "createAndSendTransactionalEmail",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "recipientEmail",
                  "templateId",
                  "emailName",
                  "fromName",
                  "fromEmail",
                  "subject",
                  "language",
                  "preHeader",
                  "htmlContent",
                  "replyToName"
                ],
                "properties": {
                  "recipientEmail": {
                    "description": "Recipient of the transactional email",
                    "type": "string",
                    "example": "recipent@iroquois.fr"
                  },
                  "templateId": {
                    "description": "Template id that will be used to extract data to create email.",
                    "type": "string",
                    "example": "1"
                  },
                  "marketingPressureId": {
                    "description": "Marketing pressure to be used. If value is set to 0, no pressure will be applied. If field is empty the most restrictive pressure accessible by the account will be used",
                    "type": "integer",
                    "example": 1
                  },
                  "emailName": {
                    "description": "Must be provided if no template is given !",
                    "type": "string",
                    "example": "Test email"
                  },
                  "fromName": {
                    "description": "Name of the sender",
                    "type": "string",
                    "example": "SalesAccount"
                  },
                  "fromEmail": {
                    "description": "SenderEmail",
                    "type": "string",
                    "example": "sales@iroquois.fr"
                  },
                  "replyToName": {
                    "description": "Name of the replyAddress",
                    "type": "string",
                    "example": "Sales Support Team"
                  },
                  "replyToEmail": {
                    "description": "Reply to email, if no email is passed, fromEmail will be used",
                    "type": "string",
                    "example": "support-team@iroquois.fr"
                  },
                  "subject": {
                    "description": "Must be provided if no template is given !",
                    "type": "string",
                    "example": "New sales terms for 2025"
                  },
                  "language": {
                    "description": "Language of the email",
                    "type": "string",
                    "enum": [
                      "en",
                      "fr",
                      "it",
                      "es",
                      "de",
                      "pt",
                      "pl",
                      "zh"
                    ],
                    "example": "fr"
