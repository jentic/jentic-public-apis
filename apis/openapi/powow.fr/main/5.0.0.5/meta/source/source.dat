                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "Error": {
                          "type": "string",
                          "example": "The field importData is missing"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
