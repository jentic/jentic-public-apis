    "/user/transactions-sms/{smsId}/stats": {
      "get": {
        "tags": [
          "Sms"
        ],
        "summary": "Get sms transactions stats for a given period",
        "description": "Get sms transactions stats for a given period",
        "operationId": "getTransactionalSmsStats",
        "parameters": [
          {
            "name": "smsId",
            "in": "path",
            "description": "Id of the sms to get transactions from",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": "1"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "Date from which statistics will start",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-10-01 00:00"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "Date at which statistics will end",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-10-31 23:59"
            }
          },
          {
            "name": "statistics",
            "in": "query",
            "description": "Statistics to retrieve",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "totalUnsubscriptionsByDatetime",
                  "totalClicksByDatetime"
                ]
              },
              "example": [
                "totalUnsubscriptionsByDatetime",
                "totalClicksByDatetime"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email transactions statistics found successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "recipients": {
                        "description": "Number of recipients",
                        "type": "integer"
                      },
                      "sent": {
                        "description": "Number of sms sent",
                        "type": "integer"
                      },
                      "pending": {
                        "description": "Number of sms pending",
                        "type": "integer"
                      },
                      "pendingPercentage": {
                        "description": "Percentage of sms pending",
                        "type": "number",
                        "format": "float"
                      },
                      "delivered": {
                        "description": "Number of sms delivered",
                        "type": "integer"
                      },
                      "deliveredPercentage": {
                        "description": "Percentage of sms delivered",
                        "type": "number",
                        "format": "float"
                      },
                      "clicks": {
                        "description": "Number of clicks",
                        "type": "integer"
                      },
                      "uniqueClicks": {
                        "description": "Number of unique clicks",
                        "type": "integer"
                      },
                      "uniqueClicksPercentage": {
                        "description": "Percentage of unique clicks",
                        "type": "number",
                        "format": "float"
                      },
                      "unsubscriptions": {
                        "description": "Number of unsubscriptions",
                        "type": "integer"
                      },
                      "unsubscriptionsPercentage": {
                        "description": "Percentage of unsubscriptions",
                        "type": "number",
                        "format": "float"
                      },
                      "softBounces": {
                        "description": "Number of soft bounces",
                        "type": "integer"
                      },
                      "softBouncesPercentage": {
                        "description": "Percentage of soft bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "hardBounces": {
                        "description": "Number of hard bounces",
                        "type": "integer"
                      },
                      "hardBouncesPercentage": {
                        "description": "Percentage of hard bounces",
                        "type": "number",
                        "format": "float"
                      },
                      "unknownBounces": {
                        "description": "Number of unknown bounces",
                        "type": "integer"
                      },
                      "totalClicksByLink": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/LinkStats"
                        }
                      },
                      "totalClicksByDatetime": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "2025-01-01 10:00:00": {
                              "description": "Number of clicks at this datetime",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "totalUniqueClicksByDatetime": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "2025-01-01 10:00:00": {
                              "description": "Number of unique clicks at this datetime",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "totalUnsubscriptionsByDatetime": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "2025-01-01 10:00:00": {
                              "description": "Number of unsubscriptions at this datetime",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      }
                    },
                    "type": "object"
                  }
                },
                "example": {
                  "recipients": 12,
                  "sent": 12,
                  "pending": 2,
                  "pendingPercentage": 16.67,
                  "delivered": 1,
                  "deliveredPercentage": 8.33,
                  "clicks": 6,
                  "uniqueClicks": 2,
                  "uniqueClicksPercentage": 200,
                  "hardBounces": 2,
                  "hardBouncesPercentage": 16.67,
                  "softBounces": 6,
                  "softBouncesPercentage": 50,
                  "unknownBounces": 0,
                  "unsubscriptions": 1,
                  "unsubscriptionsPercentage": 100,
                  "totalClicksByLink": [
                    {
                      "linkUrl": "http://lolol.com",
                      "linkTitle": "",
                      "totalClicks": 1,
                      "totalClicksPercentage": 16.67
