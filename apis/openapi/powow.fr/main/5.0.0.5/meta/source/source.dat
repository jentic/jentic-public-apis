                  },
                  "optoutScope": {
                    "description": "Scope of the opt-out action.",
                    "type": "string",
                    "enum": [
                      "this list",
                      "list",
                      "company",
                      "user",
                      "account"
                    ],
                    "example": "company"
                  },
                  "optoutSubscribeToListId": {
                    "description": "List ID to subscribe the user to after opt-out.",
                    "type": "integer",
                    "example": 50
                  },
                  "optoutUnsubscribeFromListId": {
                    "description": "List ID to unsubscribe the user from after opt-out.",
                    "type": "integer",
                    "example": 10
                  },
                  "optoutConfirmUrl": {
                    "description": "Redirect URL after opt-out confirmation.",
                    "type": "string",
                    "example": "https://example.com/unsubscribed"
                  }
                },
                "type": "object"
              }
            }
          }
