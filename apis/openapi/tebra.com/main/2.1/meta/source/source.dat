  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "CustomerKey",
        "description": "Kareo Customer API Key. Authenticate using your CustomerKey along with User and Password credentials in the request header."
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic authentication using Kareo username and password."
      }
    },
    "schemas": {
      "RequestHeader": {
        "type": "object",
        "description": "Authentication header required for all API requests",
        "required": ["User", "Password", "CustomerKey"],
        "properties": {
          "User": {
            "type": "string",
            "description": "Kareo account username/email"
          },
          "Password": {
            "type": "string",
            "description": "Kareo account password"
          },
          "CustomerKey": {
            "type": "string",
            "description": "Unique customer API key provided by Kareo"
          },
          "ClientVersion": {
            "type": "string",
            "description": "Client application version string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "isError": {
            "type": "boolean",
            "description": "Indicates whether an error occurred"
          },
          "errorMessage": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "stackTrace": {
            "type": "string",
            "description": "Technical error details (only in non-production environments)"
          }
        }
      },
      "SecurityResponse": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "Whether the user is authenticated"
          },
          "authorized": {
            "type": "boolean",
            "description": "Whether the user is authorized for the requested operation"
          },
          "customerKeyValid": {
            "type": "boolean",
            "description": "Whether the customer key is valid"
          },
          "securityResultSuccess": {
            "type": "boolean",
            "description": "Overall security check result"
          },
          "customerId": {
            "type": "integer",
            "description": "The authenticated customer ID"
          }
        }
      },
      "PracticeIdentifier": {
        "type": "object",
        "description": "Practice identification",
        "properties": {
          "practiceId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal practice ID"
          },
          "practiceName": {
            "type": "string",
            "description": "Practice name"
          },
          "practiceExternalId": {
            "type": "string",
            "description": "External practice identifier"
          }
        }
      },
      "ProviderIdentifier": {
        "type": "object",
        "description": "Provider identification",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal provider ID"
          },
          "providerExternalId": {
            "type": "string",
            "description": "External provider identifier"
          },
          "providerFullName": {
            "type": "string",
            "description": "Provider full name"
          },
          "providerNPI": {
            "type": "string",
            "description": "Provider NPI number"
          }
        }
      },
      "ServiceLocationIdentifier": {
        "type": "object",
        "description": "Service location identification",
        "properties": {
          "serviceLocationId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal service location ID"
          },
          "serviceLocationName": {
            "type": "string",
            "description": "Service location name"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string",
            "description": "Street address line 1"
          },
          "addressLine2": {
            "type": "string",
            "description": "Street address line 2"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation"
          },
          "zipCode": {
            "type": "string",
            "description": "ZIP/postal code"
          },
          "country": {
            "type": "string",
            "description": "Country"
          }
        }
      },
      "PatientAlert": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Alert message text"
          },
          "showWhenDisplayingPatientDetails": {
            "type": "boolean"
          },
          "showWhenSchedulingAppointments": {
            "type": "boolean"
          },
          "showWhenEnteringEncounters": {
            "type": "boolean"
          },
