              }
            }
          }
        }
      }
    },
    "/encounters": {
      "post": {
        "operationId": "createEncounter",
        "summary": "Create an encounter",
        "description": "Create a new clinical encounter record for a patient visit, including diagnoses, procedures, and service line items.",
        "tags": ["Encounters"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEncounterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Encounter created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateEncounterResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid encounter data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/encounters/{encounterId}": {
      "get": {
        "operationId": "getEncounterDetails",
        "summary": "Get encounter details",
        "description": "Retrieve detailed information for a specific encounter including diagnoses, procedures, and service lines.",
        "tags": ["Encounters"],
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "description": "The unique encounter identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Encounter details retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetEncounterDetailsResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
