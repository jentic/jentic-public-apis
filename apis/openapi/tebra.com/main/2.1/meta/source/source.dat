{
  "openapi": "3.0.3",
  "info": {
    "title": "Kareo (Tebra) Practice Management API",
    "description": "REST API for Kareo (now Tebra) practice management platform. Provides access to patients, appointments, encounters, charges, payments, providers, practices, documents, service locations, procedure codes, and transactions for healthcare practice management and billing.",
    "version": "2.1",
    "contact": {
      "name": "Tebra (Kareo) Support",
      "url": "https://www.tebra.com"
    },
    "x-jentic-source-url": "https://apidocs.kareo.com/"
  },
  "servers": [
    {
      "url": "https://webservice.kareo.com/services/soap/2.1",
      "description": "Kareo Production API Server"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Patients",
      "description": "Patient management - create, read, update, and search patients"
    },
    {
      "name": "Appointments",
      "description": "Appointment scheduling - create, read, update, delete, and search appointments"
    },
    {
      "name": "Providers",
      "description": "Provider/doctor information retrieval"
    },
    {
      "name": "Practices",
      "description": "Practice information retrieval"
    },
    {
      "name": "Encounters",
      "description": "Clinical encounter management"
    },
    {
      "name": "Charges",
      "description": "Charge and billing information"
    },
    {
      "name": "Payments",
      "description": "Payment management - create and retrieve payments"
    },
    {
      "name": "Transactions",
      "description": "Transaction history retrieval"
    },
    {
      "name": "Documents",
      "description": "Document management - create and delete documents"
    },
    {
      "name": "ServiceLocations",
      "description": "Service location information"
    },
    {
      "name": "ProcedureCodes",
      "description": "Procedure code lookup"
    },
    {
      "name": "AppointmentReasons",
      "description": "Appointment reason management"
    },
    {
      "name": "ExternalVendors",
      "description": "External vendor registration and retrieval"
    },
    {
      "name": "PatientCases",
      "description": "Patient case management"
    },
    {
      "name": "Throttles",
      "description": "API throttle information"
    },
    {
      "name": "Authentication",
      "description": "Authentication and customer identification"
    }
  ],
  "paths": {
    "/patients": {
      "get": {
        "operationId": "getPatients",
        "summary": "Search patients",
        "description": "Retrieve a filtered list of patients based on search criteria. Supports filtering by name, date of birth, practice, and other patient attributes.",
        "tags": ["Patients"],
        "parameters": [
          {
            "name": "PracticeName",
            "in": "query",
            "description": "Filter by practice name",
            "schema": { "type": "string" }
          },
          {
            "name": "FirstName",
            "in": "query",
            "description": "Filter by patient first name",
            "schema": { "type": "string" }
          },
          {
            "name": "LastName",
            "in": "query",
            "description": "Filter by patient last name",
            "schema": { "type": "string" }
          },
          {
            "name": "DateOfBirth",
            "in": "query",
            "description": "Filter by date of birth (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "PatientExternalID",
            "in": "query",
            "description": "Filter by external patient ID",
            "schema": { "type": "string" }
          },
          {
            "name": "CreatedDate",
            "in": "query",
            "description": "Filter by created date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "ModifiedDate",
            "in": "query",
            "description": "Filter by last modified date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of patients matching the filter criteria",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPatientsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid filter parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPatient",
        "summary": "Create a new patient",
        "description": "Create a new patient record including demographics, contact information, insurance cases, employer, and guarantor information.",
        "tags": ["Patients"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePatientRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patient created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModifyPatientResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid patient data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/patients/all": {
      "get": {
        "operationId": "getAllPatients",
        "summary": "Get all patients",
        "description": "Retrieve all patients across all practices accessible by the authenticated user. Use with caution as this may return a large dataset.",
        "tags": ["Patients"],
        "parameters": [
          {
            "name": "PracticeName",
            "in": "query",
            "description": "Filter by practice name",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete list of patients",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPatientsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/patients/{patientId}": {
      "get": {
        "operationId": "getPatient",
        "summary": "Get a specific patient",
        "description": "Retrieve detailed information for a single patient by their patient ID, including demographics, contact info, insurance, and case details.",
        "tags": ["Patients"],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "description": "The unique patient identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Patient details retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetPatientResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid patient ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Patient not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePatient",
        "summary": "Update a patient",
        "description": "Update an existing patient record. All mutable fields can be updated including demographics, contact information, insurance, employer, and guarantor details.",
        "tags": ["Patients"],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "description": "The unique patient identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePatientRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patient updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModifyPatientResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid patient data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Patient not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/patients/{patientId}/externalId": {
      "put": {
        "operationId": "updatePatientExternalId",
        "summary": "Update patient external ID",
        "description": "Update the external vendor ID mapping for a patient, allowing integration with external systems.",
        "tags": ["Patients"],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "description": "The unique patient identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePatientExternalIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "External ID updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModifyPatientResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/patients/{patientId}/cases/primary": {
      "put": {
        "operationId": "updatePrimaryPatientCase",
        "summary": "Update primary patient case",
        "description": "Update the primary insurance case for a patient, including insurance policy and authorization details.",
        "tags": ["PatientCases"],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "description": "The unique patient identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePrimaryPatientCaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Primary patient case updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpdatePatientCaseResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/appointments": {
      "get": {
        "operationId": "getAppointments",
        "summary": "Search appointments",
        "description": "Retrieve a filtered list of appointments. Supports filtering by practice, provider, patient, date range, and status.",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "PracticeName",
            "in": "query",
            "description": "Filter by practice name",
            "schema": { "type": "string" }
          },
          {
            "name": "ProviderFullName",
            "in": "query",
            "description": "Filter by provider full name",
            "schema": { "type": "string" }
          },
          {
            "name": "PatientFullName",
            "in": "query",
            "description": "Filter by patient full name",
            "schema": { "type": "string" }
          },
          {
            "name": "StartDate",
            "in": "query",
            "description": "Filter by start date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "EndDate",
            "in": "query",
            "description": "Filter by end date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "AppointmentStatus",
            "in": "query",
            "description": "Filter by appointment status",
            "schema": {
              "type": "string",
              "enum": ["Scheduled", "Confirmed", "CheckedIn", "CheckedOut", "Cancelled", "Rescheduled", "NoShow"]
            }
          },
          {
            "name": "ServiceLocationName",
            "in": "query",
            "description": "Filter by service location name",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of appointments matching filters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetAppointmentsResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid filter parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAppointment",
        "summary": "Create a new appointment",
        "description": "Schedule a new appointment for a patient with a provider at a specific service location.",
        "tags": ["Appointments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Appointment created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppointmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid appointment data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/appointments/{appointmentId}": {
      "get": {
        "operationId": "getAppointment",
        "summary": "Get a specific appointment",
        "description": "Retrieve detailed information for a specific appointment by its ID.",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "appointmentId",
            "in": "path",
            "required": true,
            "description": "The unique appointment identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Appointment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetAppointmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Appointment not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateAppointment",
        "summary": "Update an appointment",
        "description": "Update an existing appointment including time, status, provider, location, and notes.",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "appointmentId",
            "in": "path",
            "required": true,
            "description": "The unique appointment identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAppointmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Appointment updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppointmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Appointment not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAppointment",
        "summary": "Delete an appointment",
        "description": "Delete/cancel an appointment by its ID.",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "appointmentId",
            "in": "path",
            "required": true,
            "description": "The unique appointment identifier",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Appointment deleted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteAppointmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Appointment not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/appointmentReasons": {
      "get": {
        "operationId": "getAppointmentReasons",
        "summary": "Get appointment reasons",
        "description": "Retrieve a list of available appointment reasons configured for the practice.",
        "tags": ["AppointmentReasons"],
        "parameters": [
          {
            "name": "PracticeName",
            "in": "query",
