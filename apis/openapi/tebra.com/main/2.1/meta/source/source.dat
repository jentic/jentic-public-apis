              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAppointmentReason",
        "summary": "Create an appointment reason",
        "description": "Create a new appointment reason for the practice.",
        "tags": ["AppointmentReasons"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentReasonRequest"
