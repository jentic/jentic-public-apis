},"required":["amount","wei","symbol","bps"],"description":"The site fee this trade pays"},"priceImpactPct":{"type":"number","description":"How far this trade moves the price, in per cent"},"bestPrice":{"type":"object","properties":{"compared":{"type":"integer","description":"How many pools were priced for this trade"},"chosen":{"type":"string","description":"The pool it goes through, e.g. \"Uniswap V3 0.3% via USDT\""},"default":{"type":["string","null"],"description":"The pool Market Mayhem's site would use, or null when it had none"},"savedPct":{"type":["number","null"],"description":"How much more this trade gets than through the default pool, in per cent; null when the default could not quote"},"alternatives":{"type":"array","items":{"type":"object","properties":{"pool":{"type":"string"},"label":{"type":"string"},"receive":{"type":"string"}},"required":["pool","label","receive"]},"description":"Up to 3 other pools priced, best first"}},"required":["compared","chosen","default","savedPct","alternatives"],"description":"For a token launched elsewhere: the pool that pays most for THIS trade, chosen among every pool it trades in"},"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"The wallet it was built for"},"referrer":{"anyOf":[{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"bps":{"type":"integer","description":"Its cut, in basis points of the trade"}},"required":["address","bps"]},{"type":"null"}],"description":"Who is paid the referral cut, and how much, or null"},"referrerNote":{"type":"string","description":"Why your key's wallet was not used as referrer, when it was not"},"requires":{"type":"array","items":{"type":"object","properties":{"step":{"type":"string","description":"e.g. \"approve-permit2\", \"approve-router\", \"approve-factory\""},"explain":{"type":"string"},"tx":{"type":"object","properties":{"chainId":{"type":"integer","description":"56 BSC mainnet, 9