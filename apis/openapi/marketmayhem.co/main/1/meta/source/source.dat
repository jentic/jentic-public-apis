PLOYED","CANNOT_BUILD"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"referrer":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"}},"required":["referrer"]}}}}}},"/build/bind":{"post":{"summary":"The one-time on-chain referral binding (optional: a first trade through a link also binds).","parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{},"additionalProperties":true}}}},"default":{"description":"An error. Codes this endpoint can return: ALREADY_BOUND, SELF_REFERRAL, REFERRER_NOT_REGISTERED, NOT_DEPLOYED.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","description":"Stable: act on this"},"message":{"type":"string"},"fix":{"type":"string"},"field":{"type":"string"},"detail":{}},"required":["code","message"]}},"required":["error"]}}}}},"x-error-codes":["ALREADY_BOUND","SELF_REFERRAL","REFERRER_NOT_REGISTERED","NOT_DEPLOYED"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"referrer":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"}},"required":["wallet","referrer"]}}}}}},"/cashback/{address}":{"get":{"summary":"A wallet's cashback in $MAYHEM: its rate, this week so far, weeks to claim, claimed and pending.","parameters":[{"name":"address","in":"path","required":true,"description":"The wallet","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"contract":{"anyOf":[{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},{"type":"null"}],"description":"MayhemCashback, or null before it is deployed"},"rateBps":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"This wallet's rate, in basis points of the site fee"},"referee":{"type":["boolean","null"],"description":"Bound to a referrer: the higher rate"},"thisWeek":{"anyOf":[{"type":"object","properties":{},"additionalProperties":true},{"type":"null"}],"description":"The running week, estimated in BNB before the weekly $MAYHEM buy"},"claimable":{"type":"array","items":{"type":"object","properties":{"week":{"type":"integer"},"amount":{"type":"string","pattern":"^\\d+$","description":"$MAYHEM, in wei"},"mayhem":{"type":"number","description":"The same in whole $MAYHEM"},"expiresAt":{"type":"string","description":"Unclaimed weeks fold back 90 days after posting"},"proof":{"type":"array","items":{"type":"string"}}},"required":["week","amount","mayhem","expiresAt","proof"]},"description":"Posted weeks to claim with POST /build/cashback/claim"},"claimed":{"type":"array","items":{"type":"object","properties":{"week":{"type":"integer"},"mayhem":{"type":"number"}},"required":["week","mayhem"]}},"pending":{"type":"array","items":{"type":"object","properties":{"week":{"type":"integer"},"bnb":{"type":"number"},"stage":{"type":"string","enum":["buying","posting"]}},"required":["week","bnb","stage"]},"description":"Earned, not claimable yet: its $MAYHEM is being bought, then posted"}},"required":["wallet","contract","rateBps","referee","thisWeek","claimable","claimed","pending"]}}}},"default":{"description":"An error. Codes this endpoint can return: INVALID_ADDRESS.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","description":"Stable: act on this"},"message":{"type":"string"},"fix":{"type":"string"},"field":{"type":"string"},"detail":{}},"required":["code","message"]}},"required":["error"]}}}}},"x-error-codes":["INVALID_ADDRESS"]}},"/build/cashback/claim":{"post":{"summary":"One transaction claiming every posted week of cashback. The wallet itself must send it.","parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"weeks":{"type":"array","items":{"type":"object","properties":{"week":{"type":"integer"},"amount":{"type":"string","pattern":"^\\d+$","description":"$MAYHEM, in wei"},"mayhem":{"type":"number","description":"The same in whole $MAYHEM"},"expiresAt":{"type":"string","description":"Unclaimed weeks fold back 90 days after posting"}},"required":["week","amount","mayhem","expiresAt"]}},"tx":{"anyOf":[{"type":"object","properties":{"chainId":{"type":"integer","description":"56 BSC mainnet, 97 BSC testnet"},"to":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"data":{"type":"string","pattern":"^0x[0-9a-fA-F]*$","description":"The call data: send it exactly as it is"},"value":{"type":"string","pattern":"^\\d+$","description":"BNB to send with it, in wei"},"gas":{"type":"string","pattern":"^\\d+$","description":"The simulated gas plus a margin. Absent while a step in `requires` is still needed."}},"required":["chainId","to","data","value"],"description":"An unsigned transaction: sign it with the wallet and send it."},{"type":"null"}],"description":"One transaction for every claimable week; null when there is nothing to claim"},"simulation":{"type":"object","properties":{"ran":{"type":"boolean","description":"Whether it was simulated: not while a step in `requires` is still needed"},"ok":{"type":"boolean","description":"It would succeed if sent now. Present when it ran"}},"required":["ran"],"additionalProperties":true,"description":"The simulation against the chain, from the wallet"},"explain":{"type":"string"}},"required":["wallet","weeks","tx","explain"]}}}},"default":{"description":"An error. Codes this endpoint can return: INVALID_ADDRESS, SIMULATION_FAILED, NOT_DEPLOYED.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","description":"Stable: act on this"},"message":{"type":"string"},"fix":{"type":"string"},"field":{"type":"string"},"detail":{}},"required":["code","message"]}},"required":["error"]}}}}},"x-error-codes":["INVALID_ADDRESS","SIMULATION_FAILED","NOT_DEPLOYED"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"}},"required":["wallet"]}}}}}},"/build/twap":{"post":{"summary":"An unsigned, simulated TWAP order: buy or sell over time, in slices, never past your limit.","parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"requires":{"type":"array","items":{"type":"object","properties":{"step":{"type":"string","description":"e.g. \"approve-permit2\", \"approve-router\", \"approve-factory\""},"explain":{"type":"string"},"tx":{"type":"object","properties":{"chainId":{"type":"integer","description":"56 BSC mainnet, 97 BSC testnet"},"to":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"data":{"type":"string","pattern":"^0x[0-9a-fA-F]*$","description":"The call data: send it exactly as it is"},"value":{"type":"string","pattern":"^\\d+$","description":"BNB to send with it, in wei"},"gas":{"type":"string","pattern":"^\\d+$","description":"The simulated gas plus a margin. Absent while a step in `requires` is still needed."}},"required":["chainId","to","data","value"],"description":"An unsigned transaction: sign it with the wallet and send it."}},"required":["step","explain","tx"]},"description":"One-time steps to send and wait for first, in order. Empty when the wallet is ready."},"tx":{"type":"object","properties":{"chainId":{"type":"integer","description":"56 BSC mainnet, 97 BSC testnet"},"to":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"data":{"type":"string","pattern":"^0x[0-9a-fA-F]*$","description":"The call data: send it exactly as it is"},"value":{"type":"string","pattern":"^\\d+$","description":"BNB to send with it, in wei"},"gas":{"type":"string","pattern":"^\\d+$","description":"The simulated gas plus a margin. Absent while a step in `requires` is still needed."}},"required":["chainId","to","data","value"],"description":"An unsigned transaction: sign it with the wallet and send it."},"simulation":{"type":"object","properties":{"ran":{"type":"boolean","description":"Whether it was simulated: not while a step in `requires` is still needed"},"ok":{"type":"boolean","description":"It would succeed if sent now. Present when it ran"}},"required":["ran"],"additionalProperties":true,"description":"The simulation against the chain, from the wallet"},"explain":{"type":"string","description":"One sentence to read before signing"},"next":{"type":"string","description":"What to do after sending it"},"expectedOut":{"type":"string","pattern":"^\\d+$","description":"build/fill: what the fill gets at the quote"},"minOut":{"type":"string","pattern":"^\\d+$","description":"build/fill: the least it accepts"},"order":{"type":"object","properties":{"side":{"type":"string","enum":["buy","sell"]},"token":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"slices":{"type":"integer"},"random":{"type":"boolean"},"durationMinutes":{"type":"number"},"start":{"type":"integer","description":"unix seconds"},"end":{"type":"integer"},"limitPct":{"type":"number"},"limit":{"type":"string","pattern":"^\\d+$","description":"the vault's limit: least out per 1e18 in, net of the site fee"},"startPrice":{"type":"string","pattern":"^\\d+$","description":"one slice's live quote on the same basis: seeds the per-slice brake (audit T2b)"},"recipient":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"}},"required":["side","token","slices","random","durationMinutes","start","end","limitPct","limit","startPrice","recipient"]},"costs":{"type":"object","properties":{"spend":{"type":"object","properties":{"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"A decimal amount in whole units, as a string: \"0.05\""},"wei":{"type":"string","pattern":"^\\d+$","description":"The same amount in the smallest unit, an integer as a string"},"symbol":{"type":"string"}},"required":["amount","wei","symbol"]},"serviceFee":{"anyOf":[{"type":"object","properties":{"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"A decimal amount in whole units, as a string: \"0.05\""},"wei":{"type":"string","pattern":"^\\d+$","description":"The same amount in the smallest unit, an integer as a string"}},"required":["amount","wei"]},{"type":"null"}],"description":"0.25%: off what it spends on a buy, off the proceeds on a sale"},"gasPrepaid":{"type":"object","properties":{"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"A decimal amount in whole units, as a string: \"0.05\""},"wei":{"type":"string","pattern":"^\\d+$","description":"The same amount in the smallest unit, an integer as a string"}},"required":["amount","wei"],"description":"BNB for the keeper's slices, sent with the order; what is unused comes back on cancel"},"sendValue":{"type":"object","properties":{"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"A decimal amount in whole units, as a string: \"0.05\""},"wei":{"type":"string","pattern":"^\\d+$","description":"The same amount in the smallest unit, an integer as a string"}},"required":["amount","wei"],"description":"BNB sent with the transaction"},"receiveAboutNow":{"anyOf":[{"type":"object","properties":{"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"A decimal amount in whole units, as a string: \"0.05\""},"wei":{"type":"string","pattern":"^\\d+$","description":"The same amount in the smallest unit, an integer as a string"}},"required":["amount","wei"]},{"type":"null"}],"description":"at today's price, before slices move it"}},"required":["spend","serviceFee","gasPrepaid","sendValue","receiveAboutNow"]}},"required":["wallet","requires","tx","simulation","explain","order","costs"],"description":"Unsigned transactions: send `requires` in order, then `tx`."}}}},"default":{"description":"An error. Codes this endpoint can return: TOOL_UNSUPPORTED_POOL, HONEYPOT, NO_ROUTE, INVALID_SIDE, INVALID_AMOUNT, INVALID_SCHEDULE, INVALID_LIMIT, SLICE_CROSSES_LIMIT, POOL_TOO_THIN, AMOUNT_TOO_SMALL, INSUFFICIENT_BALANCE, SIMULATION_FAILED, NOT_DEPLOYED, CHAIN_UNREACHABLE.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","description":"Stable: act on this"},"message":{"type":"string"},"fix":{"type":"string"},"field":{"type":"string"},"detail":{}},"required":["code","message"]}},"required":["error"]}}}}},"x-error-codes":["TOOL_UNSUPPORTED_POOL","HONEYPOT","NO_ROUTE","INVALID_SIDE","INVALID_AMOUNT","INVALID_SCHEDULE","INVALID_LIMIT","SLICE_CROSSES_LIMIT","POOL_TOO_THIN","AMOUNT_TOO_SMALL","INSUFFICIENT_BALANCE","SIMULATION_FAILED","NOT_DEPLOYED","CHAIN_UNREACHABLE"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"token":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A Market Mayhem launch"},"side":{"type":"string","enum":["buy","sell"]},"amount":{"type":"string","pattern":"^\\d+(\\.\\d+)?$","description":"What the order spends: BNB (or the pair currency) on a buy, the token on a sale"},"durationMinutes":{"type":"number","description":"10 to 43,200 (30 days)"},"slices":{"type":"integer","description":"2–500, at least 30 s apart. Default: one every 15 minutes"},"limitPct":{"type":"number","description":"Never more than this % worse than now; slices past it wait. 1–25, default 5"},"random":{"type":"boolean","description":"Slices at random times inside their slots, sizes ±50%"},"recipient":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"Who receives what it buys or the proceeds. Default: the wallet"},"payWith":{"type":"string","enum":["bnb","wbnb"],"description":"On a BNB-paired buy: native BNB (default) or WBNB"}},"required":["wallet","token","side","amount","durationMinutes"]}}}}}},"/build/twap/cancel":{"post":{"summary":"Cancel a TWAP order: what it has not spent and the unused gas go back to the owner.","parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"requires":{"type":"array","items":{"type":"object","properties":{"step":{"type":"string","description":"e.g. \"approve-permit2\", \"approve-router\", \"approve-factory\""},"explain":{"type":"string"},"tx":{"type":"object","properties":{"chainId":{"type":"integer","description":"56 BSC mainnet, 97 BSC testnet"},"to":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","description":"A 0x address"},"data":{"type":"string","pattern":"^0x[0-9a-fA-F]*$","description":"The call data: send it exactly as it is"},"value":{"type":"string","pattern":"^\\d+$","description":"BNB to send with it, in wei"},"gas":{"type":"string","pattern":"^\\d+$","description":"The simulated gas plus a margin. Absent while a step in `requires` is still needed."}},"required":["chainId","to","data","value"],"description":"An unsigned transaction: sign it with the wallet and send it."}},"required":["step","explain","tx"]},"description":"One-time steps to send and wait for first, in order. Empty when the wallet is ready."},"tx":{"type":"objec