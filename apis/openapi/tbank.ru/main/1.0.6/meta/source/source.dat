{
  "openapi": "3.0.3",
  "info": {
    "version": "1.0.6",
    "title": "Payments Blocks API",
    "description": "API для блокировок и разблокировок платежей клиентов.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/polsha-828/t-bank-staja/1.0.6"
  },
  "servers": [
    {
      "url": "https://www.tbank.ru/payments-blocks/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/clients/{clientId}/blocks": {
      "post": {
        "summary": "Создать блокировку клиента",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientBlockRequest"
              },
              "examples": {
                "fraud": {
                  "summary": "Подозрение на мошенничество",
                  "value": {
                    "type": "TEMP",
                    "reasons": [
                      "FRAUD_SUSPECT"
                    ]
                  }
                },
                "verify": {
                  "summary": "Проверка реквизитов",
                  "value": {
                    "type": "TEMP",
                    "reasons": [
                      "INCORRECT_DETAILS"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос"
          },
          "401": {
            "description": "Неавторизован"
          },
          "404": {
            "description": "Клиент не найден"
          },
          "409": {
            "description": "Активная блокировка уже существует"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      },
      "get": {
        "summary": "Список блокировок клиента",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "RELEASED"
              ]
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isFraud",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Block"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неавторизован"
          },
          "404": {
            "description": "Клиент не найден"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/clients/{clientId}/blocks/active": {
      "get": {
        "summary": "Активные блокировки",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blocked": {
                      "type": "boolean"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Block"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неавторизован"
          },
          "404": {
            "description": "Клиент не найден"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/clients/{clientId}/blocks/{blockId}/release": {
      "post": {
        "summary": "Снять блокировку",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "blockId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Снята",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизован"
          },
          "404": {
            "description": "Клиент или блокировка не найдены"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    },
    "/clients/{clientId}/fraud-status": {
      "get": {
        "summary": "Проверка на мошенничество",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FraudStatus"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизован"
          },
          "404": {
            "description": "Клиент не найден"
          },
          "500": {
            "description": "Внутренняя ошибка сервера"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateClientBlockRequest": {
        "type": "object",
        "required": [
          "type",
          "reasons"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TEMP",
              "PERM"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Block": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "TEMP",
              "PERM"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isFraud": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RELEASED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "FraudStatus": {
        "type": "object",
        "properties": {
          "suspicious": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
