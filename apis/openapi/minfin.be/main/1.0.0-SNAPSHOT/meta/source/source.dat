{
  "openapi": "3.0.0",
  "info": {
    "title": "Bulk API",
    "version": "1.0.0-SNAPSHOT",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/jchapelle/bulk-api/1.0.0-SNAPSHOT"
  },
  "tags": [
    {
      "name": "Bulk"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "$ref": "../../common/v1/common-v1.yaml#/paths/~1health"
    },
    "/bulks/submit": {
      "post": {
        "operationId": "submitBulk",
        "tags": [
          "Bulk"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "validation-v1.yaml#/components/responses/SubmissionResult"
          },
          "400": {
            "$ref": "../../problem/v1/problem-v1.yaml#/components/responses/InputValidationProblemResponse"
          },
          "default": {
            "$ref": "../../problem/v1/problem-v1.yaml#/components/responses/ProblemResponse"
          }
        }
      }
    },
    "/bulks/{bulkId}/validations/last": {
      "get": {
        "operationId": "getLastValidationDetails",
        "parameters": [
          {
            "$ref": "#/components/parameters/BulkId"
          }
        ],
        "tags": [
          "Bulk"
        ],
        "responses": {
          "200": {
            "$ref": "validation-v1.yaml#/components/responses/Validation"
          },
          "default": {
            "$ref": "../../problem/v1/problem-v1.yaml#/components/responses/ProblemResponse"
          }
        }
      }
    },
    "/bulks/{bulkId}/validations/last/feedback": {
      "get": {
        "operationId": "downloadLastValidationFeedback",
        "tags": [
          "Bulk"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BulkId"
          }
        ],
        "responses": {
          "200": {
            "description": "Download of InputValidationProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../problem/v1/problem-v1.yaml#/components/schemas/InputValidationProblem"
                }
              }
            }
          },
          "default": {
            "$ref": "../../problem/v1/problem-v1.yaml#/components/responses/ProblemResponse"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "schema": {
          "type": "string",
          "enum": [
            "fr",
            "nl",
            "de"
          ]
        }
      },
      "BulkId": {
        "in": "path",
        "required": true,
        "name": "bulkId",
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "servers": [
    {
      "url": "https://server.minfin.be/external/api/bulks/v1"
    }
  ]
}
