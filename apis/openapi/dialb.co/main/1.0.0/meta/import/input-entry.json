{
  "openapi": "3.0.3",
  "info": {
    "title": "Dialb API",
    "version": "1.0.0",
    "description": "The Dialb REST API powers the Zapier integration and allows third-party apps to manage contacts, webhooks, short links, and cards.",
    "contact": {
      "name": "Dialb Support",
      "url": "https://app.dialb.co"
    },
    "x-jentic-source-url": "https://dialb.co/openapi.json"
  },
  "servers": [
    {
      "url": "https://app.dialb.co/api/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "summary": "Get authenticated user",
        "description": "Returns the name and email of the account associated with the API key. Used to verify credentials.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Authenticated user info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/subscribe": {
      "post": {
        "summary": "Subscribe to a webhook event",
        "description": "Registers a callback URL to receive payloads when the specified event occurs.",
        "tags": [
          "Webhooks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "event"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "The callback URL Dialb will POST to",
                    "example": "https://hooks.zapier.com/hooks/catch/…"
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "new_contact",
                      "contact_status_changed",
                      "new_short_link",
                      "new_qr_scan",
                      "new_member"
                    ],
                    "example": "new_contact"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/webhooks/unsubscribe/{id}": {
      "delete": {
        "summary": "Unsubscribe a webhook",
        "description": "Deletes the webhook subscription. Dialb will stop sending events to the callback URL.",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Webhook ID returned by the subscribe endpoint"
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook deleted"
          },
          "404": {
            "description": "Webhook not found"
          }
        }
      }
    },
    "/contacts/recent": {
      "get": {
        "summary": "List recent contacts",
        "description": "Returns the 10 most recently created contacts for the authenticated account. Used by Zapier to provide sample data.",
        "tags": [
          "Contacts"
        ],
        "responses": {
          "200": {
            "description": "Array of contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts/search": {
      "get": {
        "summary": "Find contact by email",
        "description": "Searches for a contact within the authenticated account by email address. Returns an array with zero or one result.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "jane@example.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching contact (empty array if not found)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts": {
      "post": {
        "summary": "Create a contact",
        "description": "Creates a new contact associated with a specific card (member).",
        "tags": [
          "Contacts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "member_id",
                  "name"
                ],
                "properties": {
                  "member_id": {
                    "type": "integer",
                    "description": "ID of the card this contact belongs to"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created contact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{id}": {
      "put": {
        "summary": "Update a contact",
        "description": "Updates one or more fields of an existing contact. Only the fields you provide will be changed.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "new",
                      "contacted",
                      "qualified",
                      "closed"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated contact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{id}/tags": {
      "post": {
        "summary": "Tag a contact",
        "description": "Applies one or more tags to an existing contact without removing existing tags.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tag_ids"
                ],
                "properties": {
                  "tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      1,
                      3
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated contact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          }
        }
      }
    },
    "/short-links/recent": {
      "get": {
        "summary": "List recent short links",
        "description": "Returns the 10 most recently created short links for the authenticated account.",
        "tags": [
          "Short Links"
        ],
        "responses": {
          "200": {
            "description": "Array of short links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShortLink"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/short-links/search": {
      "get": {
        "summary": "Find short link",
        "description": "Searches for a short link by its original URL or short code.",
        "tags": [
          "Short Links"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Full original URL or short code"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching short link (empty array if not found)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShortLink"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/short-links": {
      "post": {
        "summary": "Create a short link",
        "description": "Creates a new short link and returns the shortened URL.",
        "tags": [
          "Short Links"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "original_url",
                  "domain"
                ],
                "properties": {
                  "original_url": {
                    "type": "string",
                    "example": "https://example.com/page"
                  },
                  "title": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string",
                    "example": "dlb.to"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created short link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortLink"
                }
              }
            }
          }
        }
      }
    },
    "/members/recent": {
      "get": {
        "summary": "List recent cards",
        "description": "Returns the 10 most recently created digital cards (members) for the authenticated account.",
        "tags": [
          "Cards"
        ],
        "responses": {
          "200": {
            "description": "Array of cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Member"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/members/search": {
      "get": {
        "summary": "Find card by slug",
        "description": "Searches for a digital card by its slug.",
        "tags": [
          "Cards"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "jane-smith"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching card (empty array if not found)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Member"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qr-scans/recent": {
      "get": {
        "summary": "List recent QR scans",
        "description": "Returns the 10 most recent unique QR code scans for the authenticated account.",
        "tags": [
          "QR Scans"
        ],
        "responses": {
          "200": {
            "description": "Array of QR scans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QRScan"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 42
          },
          "full_name": {
            "type": "string",
            "example": "Jane Smith"
          },
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1 555-000-0000"
          },
          "job_title": {
            "type": "string",
            "example": "Product Manager"
          },
          "note": {
            "type": "string",
            "example": ""
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "qualified",
              "closed"
            ],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 7
          },
          "event": {
            "type": "string",
            "example": "new_contact"
          },
          "url": {
            "type": "string",
            "example": "https://hooks.zapier.com/hooks/catch/…"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShortLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 5
          },
          "title": {
            "type": "string",
            "example": "Product Page"
          },
          "original_url": {
            "type": "string",
            "example": "https://example.com/product"
          },
          "short_url": {
            "type": "string",
            "example": "https://dlb.to/xYz123"
          },
          "clicks": {
            "type": "integer",
            "example": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Jane Smith"
          },
          "slug": {
            "type": "string",
            "example": "jane-smith"
          },
          "position": {
            "type": "string",
            "example": "Product Manager"
          },
          "company": {
            "type": "string",
            "example": "Acme Corp"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QRScan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 11
          },
          "member_id": {
            "type": "integer",
            "example": 3
          },
          "device_type": {
            "type": "string",
            "example": "mobile"
          },
          "country": {
            "type": "string",
            "example": "US"
          },
          "scanned_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Invalid API key."
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}