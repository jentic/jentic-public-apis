{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Control de Acceso - Gimnasio",
    "description": "API para validar el acceso de usuarios al gimnasio mediante RUT.\n\nEsta API permite a los sistemas de control de acceso (puertas, torniquetes, etc.) \nvalidar si un usuario tiene una membresía activa y puede ingresar al gimnasio.\n\n## Autenticación\nTodas las peticiones requieren un token API estático en el header `X-API-Token`.\n\n## Flujo de Validación\n1. El sistema de la puerta lee el RUT del usuario (tarjeta, QR, teclado, etc.)\n2. Envía el RUT al endpoint de validación\n3. La API verifica:\n   - Que el usuario exista en el sistema\n   - Que tenga una membresía activa\n   - Que la membresía no esté expirada\n4. Retorna `access: true` o `access: false`\n5. Registra el intento en la base de datos\n",
    "version": "1.0.0",
    "contact": {
      "name": "Soporte Técnico",
      "email": "soporte@rhinhub.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/rhinlab/api-de-control-de-acceso-gimnasio/1.0.0"
  },
  "servers": [
    {
      "url": "https://access.lonvia.cl/api",
      "description": "Servidor de Producción"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/access/check": {
      "post": {
        "summary": "Validar acceso de usuario",
        "description": "Valida si un usuario tiene acceso permitido al gimnasio basándose en su RUT.\n\nEl sistema verifica:\n- Existencia del usuario en la base de datos\n- Membresía activa (status = 'active')\n- Fecha de expiración válida (no expirada)\n- Opcionalmente, validación por sede específica\n\nTodos los intentos de acceso (exitosos o fallidos) se registran en la base de datos.\n",
        "tags": [
          "Control de Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rut"
                ],
                "properties": {
                  "rut": {
                    "type": "string",
                    "description": "RUT del usuario en cualquier formato.\nSe aceptan formatos con o sin puntos y guión.\n",
                    "example": "16.937.044-3",
                    "pattern": "^[0-9]{1,2}\\.?[0-9]{3}\\.?[0-9]{3}-?[0-9kK]$"
                  },
                  "branch_id": {
                    "type": "integer",
                    "description": "ID de la sede (opcional).\nSi se especifica, solo se validará membresía para esa sede específica.\n",
                    "example": 1,
                    "nullable": true
                  }
                }
              },
              "examples": {
                "con_formato": {
                  "summary": "RUT con formato estándar",
                  "value": {
                    "rut": "16.937.044-3"
                  }
                },
                "sin_puntos": {
                  "summary": "RUT sin puntos",
                  "value": {
                    "rut": "16937044-3"
                  }
                },
                "sin_formato": {
                  "summary": "RUT sin formato",
                  "value": {
                    "rut": "169370443"
                  }
                },
                "con_sede": {
                  "summary": "Validación por sede específica",
                  "value": {
                    "rut": "16.937.044-3",
                    "branch_id": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AccessGranted"
                    },
                    {
                      "$ref": "#/components/schemas/AccessDenied"
                    }
                  ]
                },
                "examples": {
                  "acceso_permitido": {
                    "summary": "Acceso Permitido",
                    "value": {
                      "access": true,
                      "message": "Acceso permitido",
                      "user": {
                        "name": "Juan Pérez",
                        "membership_expires": "2025-12-31T00:00:00.000000Z"
                      }
                    }
                  },
                  "sin_membresia": {
                    "summary": "Sin Membresía Activa",
                    "value": {
                      "access": false,
                      "message": "Sin membresía activa"
                    }
                  },
                  "usuario_no_encontrado": {
                    "summary": "Usuario No Encontrado",
                    "value": {
                      "access": false,
                      "message": "Usuario no encontrado"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "access": false,
                  "message": "Token inválido"
                }
              }
            }
          },
          "422": {
            "description": "Datos de validación incorrectos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "The rut field is required.",
                  "errors": {
                    "rut": [
                      "The rut field is required."
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "access": false,
                  "message": "Error al verificar acceso"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Token",
        "description": "Token API estático para autenticación.\n\n**Token de producción:** `gym-access-2024-secret-token`\n\nEste token debe incluirse en todas las peticiones en el header `X-API-Token`.\n"
      }
    },
    "schemas": {
      "AccessGranted": {
        "type": "object",
        "properties": {
          "access": {
            "type": "boolean",
            "example": true,
            "description": "Indica si el acceso está permitido"
          },
          "message": {
            "type": "string",
            "example": "Acceso permitido",
            "description": "Mensaje descriptivo del resultado"
          },
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Juan Pérez",
                "description": "Nombre completo del usuario"
              },
              "membership_expires": {
                "type": "string",
                "format": "date-time",
                "example": "2025-12-31T00:00:00.000000Z",
                "nullable": true,
                "description": "Fecha de expiración de la membresía (null si es ilimitada)"
              }
            }
          }
        }
      },
      "AccessDenied": {
        "type": "object",
        "properties": {
          "access": {
            "type": "boolean",
            "example": false,
            "description": "Indica que el acceso está denegado"
          },
          "message": {
            "type": "string",
            "example": "Sin membresía activa",
            "description": "Razón por la cual se denegó el acceso",
            "enum": [
              "Usuario no encontrado",
              "Sin membresía activa"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "access": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Token inválido"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "The rut field is required."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Control de Acceso",
      "description": "Endpoints para validación de acceso al gimnasio"
    }
  ]
}
