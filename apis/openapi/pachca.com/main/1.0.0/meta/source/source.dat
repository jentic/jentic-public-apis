        scope: bots:write
  /bots/{id}/recreate_token:
    post:
      operationId: BotOperations_recreateBotToken
      description: >-
        Bot token rotation


        Generates a new `access_token` for the bot and immediately invalidates the previous one. Use it when a token is
        compromised or for scheduled secret rotation in `CI`.


        The bot's main token is reissued — the one without a name, or the oldest one if there is none. An additional
        token is reissued by [Reissue bot token](POST /bots/{id}/tokens/{token_id}/reissue).


        The new token is returned in the response only once — save it right away. Its permissions are the same: the
        scopes are carried over from the previous token.


        Rotation is available to the bot's creator, and a workspace administrator if the bot's settings grant
        administrators edit access. The owner of a chat the bot belongs to cannot rotate the token, even when the rest
        of the bot's settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotCreateResponse'
                description: Response wrapper with data
              example:
                data:
                  id: 1738816
                  name: Tasks bot
                  nickname: tasks_bot
                  avatar_url: null
                  creator_id: 12
                  created_at: '2025-05-15T14:30:00.000Z'
                  authorized_users_count: 3
                  last_used_at: '2025-05-20T09:15:00.000Z'
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
                    kind: simple
                    unfurl_domains: []
                    last_request_at: '2025-05-20T09:15:00.000Z'
                  oauth_client_enabled: true
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  promo:
                    description: Collects a summary of tasks and sends it to the chat
                    published: true
                    promo_images: []
                  permissions:
                    update_oauth_client: true
                    recreate_token: true
                    destroy: true
                  access_token: bm90X2FfcmVhbF90b2tlbg
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:write
  /bots/{id}/rotate_client_secret:
    post:
      operationId: BotOperations_rotateBotClientSecret
      description: >-
        Client secret rotation


        Issues a new `client_secret` for authorization on behalf of an employee. The previous secret stops working at
        once, so prepare the bot for the replacement first. Authorizations already granted and tokens already received
        keep working.


        The new secret comes in `client_secret` once. The method works only for a bot with authorization enabled and a
        server-side client (`confidential: true`), otherwise it responds `400`.


        Rotation is available to the bot's creator, and to a workspace administrator if the bot's settings give
        administrators edit access.
      parameters:
