                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Messages
      x-requirements:
        scope: pins:write
  /messages/{id}/reactions:
    post:
      operationId: ReactionOperations_addReaction
      description: >-
        Add reaction


        Adds an emoji reaction to a message on behalf of the token owner.


        The `code` field carries the emoji character itself: text notations such as `+1` or `:+1:` are not accepted by
        the method. If the user has already added the same reaction, it will not be duplicated. To remove a reaction,
        use the [Delete reaction](DELETE /messages/{id}/reactions) method.


        If there is a thread under the message, the employee who reacted is subscribed to it as well and starts
        receiving the new messages of the thread.


        A message the token cannot see responds `404` with the `not_found` code, as a nonexistent one does.


        **Reaction limits:**


        - Each user can add no more than **20 unique** reactions to a message

        - A message can have no more than **30 unique** reactions

        - The total number of reactions on a message cannot exceed **1000**
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 7231942
          example: 7231942
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Reaction'
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Reactions
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ReactionRequest'
      x-requirements:
        scope: reactions:write
    delete:
      operationId: ReactionOperations_removeReaction
      description: >-
        Delete reaction


        Removes your own reaction from a message.


        Someone else's reaction and a reaction that does not exist respond `404`. Removing a reaction does not cancel
        the thread subscription, if it appeared together with the reaction.
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 7231942
          example: 7231942
        - name: code
          in: query
          required: true
          description: >-
            Emoji character of the reaction. The character itself: text forms such as `+1` or `:+1:` are rejected as an
            unknown emoji.
          schema:
            type: string
            example: 👍
          example: 👍
          explode: false
        - name: name
          in: query
          required: false
          description: Text name of the emoji (used for custom emoji)
          schema:
            type: string
            example: ':+1:'
          example: ':+1:'
          explode: false
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Reactions
      x-requirements:
        scope: reactions:write
    get:
      operationId: ReactionOperations_listReactions
      description: |-
        List reactions

        All reactions on a message and who left them: each record carries a `user_id` and the character itself.

        For a deleted message the list is empty — reactions disappear along with the text and the files.
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 194275
          example: 194275
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Reaction'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Reactions
      x-paginated: true
      x-requirements:
        scope: reactions:read
  /messages/{id}/read_member_ids:
    get:
      operationId: ReadMemberOperations_listReadMembers
      description: >-
        List users who read the message


        Which of the chat members have read the feed up to this message. A flat array of IDs is returned.


        The caller themselves and the author of the message will never be in the list — only the other members are
        counted. For a message in a thread these are the members of the thread, not of the parent chat.


        The method does not return names. They are fetched with the [Employee info](GET /users/{id}) method for each ID.
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 194275
          example: 194275
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 300
            example: 300
            default: 300
          example: 300
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      type: integer
                      format: int32
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Read members
      x-paginated: true
      x-requirements:
        scope: messages:read
  /messages/{id}/thread:
    post:
      operationId: ThreadOperations_createThread
      description: >-
        New thread


        Creates a thread under a message — a place to discuss what has been said without cluttering the chat feed. A
        thread is a separate access: an employee can be invited into it without opening the chat itself to them, and
        they will see only the thread and the parent message. If a topic rather than a message needs discussing, start a
        thread with the [New unattached thread](POST /threads) method.


        A new thread immediately includes the employee who created it, the author of the message, everyone who added
        reactions to the message, and the chat members who turned on thread notifications. Anyone mentioned in the
        parent message — by name or by tag — is added by a background job right after creation, so the first response
        may not list them yet. Blanket mentions such as `@all` bring nobody into the thread, and a mentioned employee
        who is not in the chat itself is not picked up either.


        An empty thread holds no talk yet: send the first message into it right away with the [New message](POST
        /messages) method, `entity_type: "thread"` and the thread's `id` from the response. A thread has no name, and it
        cannot be deleted either through the API or in the app.


        If a thread has already been created for the message, the response will return information about the previously
        created thread. But to simply read a thread, the method is not needed: the ID of an existing thread arrives in
        the `thread` field of the message itself. A thread cannot be created under a message that itself lies in a
        thread: there are no nested threads in Pachca, and the method responds `400` with the `thread_message` code.
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 154332686
          example: 154332686
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Thread'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Threads
      x-requirements:
        scope: threads:create
  /oauth/revoke:
    post:
      operationId: OAuthFlowOperations_revokeToken
      description: >-
        Revoke token


        Revokes an employee's token issued to the bot, following the OAuth 2.0 standard ([RFC
        7009](https://datatracker.ietf.org/doc/html/rfc7009)). This is how the bot turns access off by itself, for
        example when the employee disables the integration in your service. `token` can carry either the employee's
        token or its refresh token: both stop working.


        The body is sent as `application/x-www-form-urlencoded`. A server-side application authenticates with the client
        secret: with the `client_id` and `client_secret` fields or with the `Authorization: Basic` header. An
        application without a secret can revoke only the token itself: it passes the token both in the body and in the
        `Authorization: Bearer` header.


        A `200` response with an empty object comes even when the token has already been revoked or is not found. The
        method does not revoke another bot's token and responds `403` with the `unauthorized_client` code. The
        revocation is recorded in the [audit event log](/guides/audit-events) with the `oauth_token_revoked` type. How
        an employee revokes access themselves is covered in [Consent and revocation](/guides/oauth/consent).
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
      tags:
        - OAuth
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OAuthRevokeRequest'
            example:
              token: pato_bm90X2FfcmVhbF90b2tlbg
              client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
              client_secret: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
      x-oauth-flow: true
  /oauth/token:
    post:
      operationId: OAuthFlowOperations_exchangeToken
      description: >-
        Exchange code for token


        The second step of authorization on behalf of an employee: the code from the redirect address is exchanged for
        that employee's token. The code is valid for 10 minutes and can be exchanged once. How to get the code and check
        whose token arrived is covered in [Getting a token](/guides/oauth/flow).


        The body is sent as `application/x-www-form-urlencoded`, as OAuth 2.0 requires. A server-side application
        authenticates with the client secret: with the `client_id` and `client_secret` fields or with the
        `Authorization: Basic` header. An application without a secret passes `client_id` and `code_verifier` — the PKCE
        verifier the `code_challenge` of the authorization link was made from.


        The token does not expire: there is no `expires_in` in the response, and the token works until the employee
        revokes access. If the employee has already authorized the bot before, their existing token comes back. Whose
        token it is, [Token info](GET /oauth/token/info) shows.


        Errors come in the OAuth format: `invalid_grant` — the code has expired, has already been used, was issued for a
        different `redirect_uri`, or the `code_verifier` does not match, and `invalid_client` — a wrong `client_id` or
        `client_secret`. The exchange has its own [limit](/api/limits): when it is exceeded, the method responds `429`
        with the `rate_limit` code in the regular API error format.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthToken'
              example:
                access_token: pato_bm90X2FfcmVhbF90b2tlbg
                token_type: Bearer
                refresh_token: cmVmcmVzaF9ub3RfcmVhbA
                scope: chats:read messages:read tasks:read tasks:create
                created_at: 1790242260
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '429':
          description: Client error
          headers:
            Retry-After:
              required: true
              schema:
                type: integer
                format: int32
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - OAuth
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OAuthTokenRequest'
            example:
              grant_type: authorization_code
              code: ZmFrZV9hdXRoX2NvZGU
              redirect_uri: https://bot.example.com/oauth/callback
              client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
              client_secret: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
              code_verifier: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
      x-oauth-authorize-url: https://app.pachca.com/apps/authorize
      x-oauth-flow: true
      x-requirements:
        auth: false
  /oauth/token/info:
    get:
      operationId: OAuthOperations_getTokenInfo
      description: >-
        Token info


        Information about the token the request itself was made with: its scopes, its owner, and the dates it was
        created and last used. The token itself comes back masked — only the first 8 and the last 4 characters are
        visible.


        The method requires no scope and answers any valid token, personal or bot. That makes it convenient for checking
        a token before work: a live one answers `200`, a revoked or expired one `401`, and the list of scopes
        immediately shows which methods are available to this token.


        Whose token it is can be seen from `user_id`. The owner's full profile is returned by [Own profile](GET
        /profile).
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/AccessTokenInfo'
                description: Response wrapper with data
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - OAuth
      x-requirements:
        scope: null
  /profile:
    get:
      operationId: ProfileOperations_getProfile
      description: >-
        Own profile


        The profile of the token owner. For a bot token this is the bot's own profile.


        The time zone from here is needed by anyone who turns human deadlines into dates: "by 15:00" and "by Friday" are
        counted in the employee's time zone, not in UTC. An empty value means the workspace time zone.


        Someone else's profile is returned by [Employee info](GET /users/{id}).


        Your own avatar is set by [Upload own avatar](PUT /profile/avatar) and removed by [Delete own avatar](DELETE
        /profile/avatar).
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/User'
                description: Response wrapper with data
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Profile
      x-requirements:
        scope: profile:read
  /profile/avatar:
    put:
      operationId: ProfileAvatarOperations_updateProfileAvatar
      description: >-
        Upload own avatar


        Sets or replaces the avatar of the token owner. The file is sent in `multipart/form-data` format, and the
        response contains only a link to the new image.


        `jpg`, `jpeg`, `png`, and `gif` are accepted, and an animated `gif` must be no larger than 2 MB. The image is
        scaled down to 1024 by 1024 pixels, and an opaque `png` is stored as `jpg`.


        Another employee's avatar is set by [Upload employee avatar](PUT /users/{user_id}/avatar), and that is available
        only to the workspace owner and an administrator.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/AvatarData'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Profile
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                image:
                  type: string
                  format: binary
                  description: Avatar image file
              required:
                - image
      x-requirements:
        scope: profile_avatar:write
    delete:
      operationId: ProfileAvatarOperations_deleteProfileAvatar
      description: >-
        Delete own avatar


        Removes the avatar of the token owner; the interface then shows initials. If there was no avatar, the response
        is still `204`.
      parameters: []
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Profile
      x-requirements:
        scope: profile_avatar:write
  /profile/status:
    get:
      operationId: ProfileOperations_getStatus
      description: >-
        Own status


        The status of the token owner: the emoji, the title, the expiry, and away mode.


        If no status is set, the method returns `200` and `null` in the response body — with no wrapper object. A status
        whose `expires_at` has passed may still be returned for a short time until it is cleared, so check `expires_at`
        on the client side.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/UserStatus'
                description: Response wrapper with data
                nullable: true
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Profile
      x-requirements:
        scope: profile_status:read
    put:
      operationId: ProfileOperations_updateStatus
      description: >-
        New own status


        Sets a status for the token owner: an emoji, a caption, and, if needed, an expiry. It is available to a bot as
        well — the status will be visible on the bot.


        Away mode is turned on by this same method, with the `is_away` flag. `away_message` holds the text shown in the
        profile and to anyone trying to write to them or mention them. When the `expires_at` moment passes, the whole
        status is cleared, the mode and that text along with it.


        Only the fields you pass are overwritten. To extend the current status it is enough to send `expires_at` alone.


        An expiry that an employee names in words — "until three", "until the end of the day" — is exactly `expires_at`,
        not a part of the caption. It is counted in the employee's time zone, and the zone arrives in [Own profile](GET
        /profile).


        The emoji and the caption are required only when there is no status yet. The emoji must be exactly one, with no
        text around it, and the caption no longer than 50 characters.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/UserStatus'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Profile
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StatusUpdateRequest'
      x-requirements:
        scope: profile_status:write
    delete:
      operationId: ProfileOperations_deleteStatus
      description: >-
        Delete own status


        Removes the status from the token owner, along with away mode and its text. If there was no status, the response
        is still `204`, so a repeated call is safe.
      parameters: []
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Profile
      x-requirements:
        scope: profile_status:write
  /search/chats:
    get:
      operationId: SearchOperations_searchChats
      description: >-
        Search chats


        Searches for conversations and channels by name, forgiving typos. It also finds the public chats of the
        workspace the caller has not joined, and of the private ones only those they belong to.


        Direct messages are not searched by default. Pass `personal=true` and the search will go by the name of the
        other party rather than by the chat name.


        The method searches names, not content. To find where something was discussed or agreed, use [Search
        messages](GET /search/messages).


        A query that is too heavy may not finish in time: then the method responds `504` with the `timeout` code, and
        the query is worth narrowing.
      parameters:
        - name: query
          in: query
          required: false
          description: Search query text. A query longer than 500 characters is cut off.
          schema:
            type: string
            example: Development
          example: Development
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of results to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 100
            example: 10
            default: 100
          example: 10
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
        - name: order
          in: query
          required: false
          description: Sort direction
          schema:
            $ref: '#/components/schemas/SortOrder'
            example: desc
          example: desc
          explode: false
        - name: created_from
          in: query
          required: false
          description: Filter by creation date (from)
          schema:
            type: string
            format: date-time
            example: '2025-01-01T00:00:00.000Z'
          example: '2025-01-01T00:00:00.000Z'
          explode: false
        - name: created_to
          in: query
          required: false
          description: Filter by creation date (to)
          schema:
            type: string
            format: date-time
            example: '2025-02-01T00:00:00.000Z'
          example: '2025-02-01T00:00:00.000Z'
          explode: false
        - name: active
          in: query
          required: false
          description: Filter by chat activity
          schema:
            type: boolean
            example: true
          example: true
          explode: false
        - name: chat_subtype
          in: query
          required: false
          description: Filter by chat type
          schema:
            $ref: '#/components/schemas/ChatSubtype'
            example: discussion
          example: discussion
          explode: false
        - name: personal
          in: query
          required: false
          description: Filter by direct chats
          schema:
            type: boolean
            example: false
          example: false
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Chat'
                  meta:
                    $ref: '#/components/schemas/SearchPaginationMeta'
                description: Search results response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '504':
          description: Server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Search
      x-paginated: true
      x-requirements:
        scope: search:chats
  /search/messages:
    get:
      operationId: SearchOperations_searchMessages
      description: >-
        Search messages


        Searches by message text and by the names of attachments, but only in the chats the token owner belongs to. A
        public channel they have not joined does not make it into the search, even though its feed can be read. Thread
        messages are included in the results.


        The words of the query are matched by their forms and by part of a word, and typos are not corrected. A query
        wrapped entirely in quotation marks is searched as an exact phrase, and matching on part of a word does not
        apply to it. Straight quotes `"…"` and typographic ones `«…»`, `“…”`, `„…“` both work.


        By default messages come from newest to oldest. `sort=relevance` switches the results to how well they match the
        query, where recent messages are still valued higher.


        A query that is too heavy may not finish in time: then the method responds `504` with the `timeout` code, and
        the query is worth narrowing.
      parameters:
        - name: query
          in: query
          required: false
          description: >-
            Search query text. Without it, messages are picked by the filters alone. A query longer than 500 characters
            is cut off.
          schema:
            type: string
            example: t-shirts
          example: t-shirts
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of results to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 200
            example: 10
            default: 200
          example: 10
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
        - name: order
          in: query
          required: false
          description: Sort direction
          schema:
            $ref: '#/components/schemas/SortOrder'
            example: desc
          example: desc
          explode: false
        - name: sort
          in: query
          required: false
          description: Sort results by
          schema:
            allOf:
              - $ref: '#/components/schemas/MessageSearchSort'
            default: created_at
          example: created_at
          explode: false
        - name: created_from
          in: query
          required: false
          description: Filter by creation date (from)
          schema:
            type: string
            format: date-time
            example: '2025-01-01T00:00:00.000Z'
          example: '2025-01-01T00:00:00.000Z'
          explode: false
        - name: created_to
          in: query
          required: false
          description: Filter by creation date (to)
          schema:
            type: string
            format: date-time
            example: '2025-02-01T00:00:00.000Z'
          example: '2025-02-01T00:00:00.000Z'
          explode: false
        - name: chat_ids
          in: query
          required: false
          description: Filter by chat IDs
          schema:
            type: array
            items:
              type: integer
              format: int32
            x-query-array: brackets
            example:
              - 198
              - 334
          x-query-array: brackets
          example:
            - 198
            - 334
          explode: false
        - name: user_ids
          in: query
          required: false
          description: Filter by message author IDs
          schema:
            type: array
            items:
              type: integer
              format: int32
            x-query-array: brackets
            example:
              - 12
              - 185
          x-query-array: brackets
          example:
            - 12
            - 185
          explode: false
        - name: active
          in: query
          required: false
          description: Filter by chat activity
          schema:
            type: boolean
            example: true
          example: true
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Message'
                  meta:
                    $ref: '#/components/schemas/SearchPaginationMeta'
                description: Search results response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '504':
          description: Server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Search
      x-paginated: true
      x-requirements:
        scope: search:messages
  /search/users:
    get:
      operationId: SearchOperations_searchUsers
      description: >-
        Search employees


        Searches for employees by first and last name, nickname, position, and department. Typos are forgiven only in
        the first and last name; the other fields need an exact word.


        The method searches by email only for those who can see personal data in the workspace. It does not search by
        phone at all — for that there is [List employees](GET /users) with the `query` parameter.


        Deleted employees are never found; suspended ones only when a text query is given, and they stand below the rest
        in the results. Of the bots, only public ones are found.


        A query that is too heavy may not finish in time: then the method responds `504` with the `timeout` code, and
        the query is worth narrowing.
      parameters:
        - name: query
          in: query
          required: false
          description: Search query text. A query longer than 500 characters is cut off.
          schema:
            type: string
            example: Oleg
          example: Oleg
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of results to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 200
            example: 10
            default: 200
          example: 10
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
        - name: sort
          in: query
          required: false
          description: Sort results by
          schema:
            $ref: '#/components/schemas/SearchSortOrder'
            example: by_score
          example: by_score
          explode: false
        - name: order
          in: query
          required: false
          description: Sort direction
          schema:
