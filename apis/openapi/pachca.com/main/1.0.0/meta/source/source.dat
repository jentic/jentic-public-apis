    delete:
      operationId: MessageOperations_unpinMessage
      description: >-
        Unpin message


        Removes the pin from a message. If the message was not pinned, the response is still `204`, so a repeated call
        is safe.
      parameters:
        - name: id
          in: path
          required: true
          description: Message ID
          schema:
            type: integer
            format: int32
            example: 194275
          example: 194275
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
