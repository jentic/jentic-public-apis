  /views/open:
    post:
      operationId: FormOperations_openView
      description: >-
        Open view


        Shows a user a modal window with a form in response to their action. The method is called with a bot token:
        button click events reach bots only, and the window is opened on behalf of the bot.


        There is only one way to open the window — by the `trigger_id` from the button click event. One `trigger_id`
        opens one window and lives for 3 seconds. For a bot with a webhook they count from the moment Pachca delivered
        the click, and for a bot that reads [Event history](GET /webhooks/events), from the moment the click was written
        to the log. That is why the window is opened first of all, and everything else for the event is done afterwards.


        The filled-in form comes back as a `view_submit` event: to the outgoing webhook, and if no address is set, to
        the event history. A webhook is answered in the response to it, and Pachca waits 3 seconds for that. An event
        from the history is closed with [Respond to a form submission](POST /views/{view_id}/submit_response), and there
        are 5 seconds for that. Miss the window and the user sees a submission error.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '410':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Views
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OpenViewRequest'
      x-requirements:
        scope: views:write
        roles:
          - bot
  /views/{view_id}/submit_response:
    post:
      operationId: FormOperations_submitViewResponse
      description: >-
        Respond to a form submission


        Closes the form for the employee or shows them errors under the fields. The method is needed by a bot that has
        no outgoing webhook address set: such a bot has nowhere to answer the webhook, and it receives the `view_submit`
        event through the [Event history](GET /webhooks/events) method. If the webhook address is set, answer the
        webhook directly — that is simpler and does not require polling the history.


        The `view_id` and `submit_id` identifiers arrive in the event payload. You must respond within 5 seconds of the
        form submission, otherwise the employee sees a submission error and the field values are kept for another
        attempt.


        A body without the `errors` field closes the form as successfully submitted; with the `errors` field it shows
        the error text under each named field.


        The response is accepted once. A repeated call with the same `view_id` and `submit_id` pair, as well as a late
        one, receives `410` with the `submit_expired` code.
      parameters:
        - name: view_id
          in: path
          required: true
          description: View ID
          schema:
            type: string
            example: 01KAJZ2XDSS2S3DSW9EXJZ0TBV
          example: 01KAJZ2XDSS2S3DSW9EXJZ0TBV
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SubmitViewResponseResult'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '410':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '503':
          description: Service unavailable.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Views
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SubmitViewResponseRequest'
      x-requirements:
        scope: views:write
        roles:
          - bot
  /webhooks/events:
    get:
      operationId: BotOperations_getWebhookEvents
      description: >-
        Event history


        The bot's event history: the same thing that goes to the outgoing webhook, but fetched with a request. The
        method is needed when webhooks cannot be received at your own address — the handler is not reachable from the
        internet, is not always up, or is being written right now.


        The history is kept only when the "Save event history" option is enabled in the "Outgoing webhook" tab of the
        bot settings. The webhook address does not have to be specified at all, and if it is specified, the event both
        goes to it and lands in the history.


        The method works only with a bot token: a personal token has no history of its own. Events are returned from
        newest to oldest, and an event identifier is a string, not a number.


        The history does not clear itself: delete the events you have read with the [Delete history event](DELETE
        /webhooks/events/{id}) method, otherwise they come again on a repeat request.
      parameters:
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/WebhookEvent'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-paginated: true
      x-requirements:
        scope: webhooks:events:read
        roles:
          - bot
  /webhooks/events/{id}:
    delete:
      operationId: BotOperations_deleteWebhookEvent
      description: >-
        Delete history event


        Removes an event from the bot's event history. When working through the history, delete an event right after
        processing it: the history does not clear itself, and everything left in it comes again on a repeat request.


        The method works only with the token of the bot the event belongs to.
      parameters:
        - name: id
          in: path
          required: true
          description: Event ID
          schema:
            type: string
            example: 01KAJZ2XDSS2S3DSW9EXJZ0TBV
          example: 01KAJZ2XDSS2S3DSW9EXJZ0TBV
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: webhooks:events:delete
        roles:
          - bot
security:
  - BearerAuth: []
components:
  schemas:
    AccessTokenInfo:
      type: object
      required:
        - id
        - token
        - name
        - user_id
        - scopes
        - created_at
        - revoked_at
        - expires_in
        - last_used_at
        - authorized_at
      properties:
        id:
          type: integer
          format: int64
          description: Token ID
          example: 4827
        token:
          type: string
          description: Masked token (first 8 and last 4 characters visible)
          example: cH5kR9mN...x7Qp
        name:
          type: string
          nullable: true
          description: >-
            Token name. For a CLI sign-in it is the device name, for a token of an external application the application
            name. `null` when there is no name, for example for a token an employee gave a bot on the consent screen.
          example: My API Token
        user_id:
          type: integer
          format: int64
          description: Token owner ID
          example: 12
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/OAuthScope'
          description: List of token scopes
          example:
            - messages:read
            - chats:read
        created_at:
          type: string
          format: date-time
          description: Token creation date
          example: '2025-01-15T10:30:00.000Z'
        revoked_at:
          type: string
          format: date-time
          nullable: true
          description: 'Token revocation date. Always `null`: the method returns 401 for a revoked token.'
          example: null
        expires_in:
          type: integer
          format: int32
          nullable: true
          description: >-
            Token lifetime in seconds. For a CLI sign-in and for a token of an external application an employee granted
            access to, it is `3600`: the token lives for an hour and is renewed with the refresh token, which the CLI
            does by itself. For other tokens it is `null`: they do not expire.
          example: null
        last_used_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Token last used date. `null` until the token has been used at least once. Updated at most once a minute, so
            it may lag behind.
          example: '2025-02-24T14:20:00.000Z'
        authorized_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Date of the CLI sign-in or of granting access to an external application. It stays the same when the token
            is renewed. `null` for other tokens.
          example: null
      description: Access token
    AddMembersRequest:
      type: object
      required:
        - member_ids
      properties:
        member_ids:
          type: array
          items:
            type: integer
            format: int32
          minItems: 1
          description: Array of user IDs who will become members
          example:
            - 186
            - 187
        silent:
          type: boolean
          description: >-
            With `true`, no system message about the addition appears in the chat, and the added employees get no
            invitation email. The message exists only in a private group chat, the email in group chats and channels for
            those who have not turned such emails off. In a thread the parameter changes nothing.
          example: true
          default: false
      description: Request to add members to a chat
    AddTagsRequest:
      type: object
      required:
        - group_tag_ids
      properties:
        group_tag_ids:
          type: array
          items:
            type: integer
            format: int32
          minItems: 1
          description: Array of tag IDs to be added as members
          example:
            - 86
            - 18
      description: Request to add tags to a chat
    ApiError:
      type: object
      required:
        - errors
      properties:
        errors:
          type: array
          items:
            $ref: '#/components/schemas/ApiErrorItem'
          description: Array of errors
      description: API error (used for 400, 402, 403, 404, 409, 410, 422, 429, 503, 504)
      x-error: true
    ApiErrorItem:
      type: object
      required:
        - key
        - value
        - message
        - code
        - payload
      properties:
        key:
          type: string
          description: Error field key. `system` if the error does not relate to a specific field.
          example: field.name
        value:
          anyOf:
            - type: string
            - type: number
            - type: boolean
            - type: array
              items: {}
            - type: object
              additionalProperties: {}
          nullable: true
          description: >-
            The value that caused the error, as it was passed or as it is stored: usually a string, a number or an
            array, for example the bots' `id` for the `bot_add_denied` code, and sometimes a boolean or an object.
            `null` if the error does not relate to a specific value.
          example: invalid_value
        message:
          type: string
          description: Error message
          example: Field cannot be empty
        code:
          allOf:
            - $ref: '#/components/schemas/ValidationErrorCode'
          description: Error code
          example: blank
        payload:
          type: object
          additionalProperties: {}
          nullable: true
          description: >-
            Additional error data. Content depends on the error code: `{id: number}` — for custom property errors
            (property ID), `{record: {type: string, id: number}, query: string}` — for authorization errors, `{draft_id:
            number}` — when a draft already exists in this chat, `{limit: number, remaining: number, reset_at: string}`
            — when the daily limit of invitation emails is used up (`reset_at` is when a slot frees up in the window).
            In most cases `null`.
          example: null
      description: Detailed error information
    AuditDetailsBot:
      type: object
      required:
        - bot_id
        - actor_id
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
      description: >-
        For: bot_deleted, and also bot_token_recreated, bot_token_created, bot_token_updated, bot_token_reissued in
        records made before October 7, 2026
    AuditDetailsBotOAuthClient:
      type: object
      required:
        - bot_id
        - actor_id
        - client_id
        - changes
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
        client_id:
          type: string
          description: Bot OAuth client ID
        changes:
          type: object
          additionalProperties: {}
          description: >-
            Changed client settings. The key is the setting name (confidential, redirect_uris, scopes), the value is an
            object with previous and new fields.
      description: 'For: bot_oauth_client_updated'
    AuditDetailsBotOAuthClientDisabled:
      type: object
      required:
        - bot_id
        - actor_id
        - client_id
        - deleted_access_tokens_count
        - deleted_access_grants_count
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
        client_id:
          type: string
          description: Bot OAuth client ID
        deleted_access_tokens_count:
          type: integer
          format: int32
          description: Number of employee tokens revoked
        deleted_access_grants_count:
          type: integer
          format: int32
          description: Number of unused authorization codes revoked
      description: 'For: bot_oauth_client_disabled'
    AuditDetailsBotOAuthClientSecretRotated:
      type: object
      required:
        - bot_id
        - actor_id
        - client_id
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
        client_id:
          type: string
          description: Bot OAuth client ID
      description: 'For: bot_oauth_client_secret_rotated, bot_oauth_client_secret_issued'
    AuditDetailsBotScopes:
      type: object
      required:
        - bot_id
        - actor_id
        - added_scopes
        - removed_scopes
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
        added_scopes:
          type: array
          items:
            type: string
          description: Scopes added to the bot token
        removed_scopes:
          type: array
          items:
            type: string
          description: Scopes revoked from the bot token
      description: 'For: bot_scopes_updated'
    AuditDetailsBotTokenUpdated:
      type: object
      required:
        - token_kind
        - token_name
        - resource_owner_id
        - current_scopes
        - actor_id
      properties:
        token_kind:
          type: string
          description: 'Token kind: `bot`'
        token_name:
          type: string
          nullable: true
          description: Token name after the change. `null` if there is no name.
        resource_owner_id:
          type: integer
          format: int32
          description: ID of the token owner — the bot
        current_scopes:
          type: array
          items:
            type: string
          description: Token scopes after the change
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
      description: 'For: bot_token_updated'
    AuditDetailsBotWebhookSettings:
      type: object
      required:
        - bot_id
        - actor_id
        - changes
      properties:
        bot_id:
          type: integer
          format: int32
          description: Bot ID
        actor_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the user who performed the action. `null` if the action was performed without an initiator.
        changes:
          type: object
          additionalProperties: {}
          description: >-
            Changed webhook settings. The key is the setting name (outgoing_url, ignore_self_messages,
            events_history_enabled), the value is an object with previous and new fields.
      description: 'For: bot_webhook_settings_updated'
    AuditDetailsChatId:
      type: object
      required:
        - chat_id
      properties:
        chat_id:
          type: integer
          format: int32
          description: Chat ID
      description: 'For: tag_removed_from_chat'
    AuditDetailsChatPermission:
      type: object
      required:
        - public_access
      properties:
        public_access:
          type: boolean
          description: Public access
      description: 'For: chat_permission_changed'
    AuditDetailsChatRenamed:
      type: object
      required:
        - old_name
        - new_name
      properties:
        old_name:
          type: string
          description: Previous chat name
        new_name:
          type: string
          description: New chat name
      description: 'For: chat_renamed'
    AuditDetailsDeviceAuthorizationApproved:
      type: object
      required:
        - client_id
        - scopes
      properties:
        client_id:
          type: string
          description: ID of the OAuth client that was allowed to sign in
        scopes:
          type: array
          items:
            type: string
          description: Scopes the employee agreed to
        device_name:
          type: string
          nullable: true
          description: Name of the device the sign-in is made from. `null` if the app did not pass it.
      description: 'For: oauth_device_authorization_approved'
    AuditDetailsDeviceAuthorizationDenied:
      type: object
      required:
        - client_id
        - scopes
      properties:
        client_id:
          type: string
          description: ID of the OAuth client that was denied the sign-in
        scopes:
          type: array
          items:
            type: string
          description: Scopes the client requested
        device_name:
          type: string
          nullable: true
          description: Name of the device the sign-in was made from. `null` if the app did not pass it.
      description: 'For: oauth_device_authorization_denied'
    AuditDetailsDlp:
      type: object
      required:
        - dlp_rule_id
        - dlp_rule_name
        - message_id
        - chat_id
        - user_id
        - action_message
        - conditions_matched
      properties:
        dlp_rule_id:
          type: integer
          format: int32
          description: DLP rule ID
        dlp_rule_name:
          type: string
          description: DLP rule name
        message_id:
          type: integer
          format: int32
          description: Message ID
        chat_id:
          type: integer
          format: int32
          description: Chat ID
        user_id:
          type: integer
          format: int32
          description: User ID
        action_message:
          type: string
          nullable: true
          description: Action description. `null` if the rule action has no text set.
        conditions_matched:
          type: boolean
          description: Rule conditions check result (true — conditions matched)
      description: 'For: dlp_violation_detected'
    AuditDetailsEmpty:
      type: object
      description: >-
        Empty details. For: user_login (except a QR code sign-in), user_logout, user_2fa_fail, user_2fa_success,
        user_2fa_disabled, user_created, user_deleted, chat_created, message_created, message_updated, message_deleted,
        reaction_created, reaction_deleted, thread_created, audit_events_accessed, company_chats_accessed,
        company_bots_accessed, exchange_disabled.
    AuditDetailsInitiator:
      type: object
      required:
        - initiator_id
      properties:
        initiator_id:
          type: integer
          format: int32
          description: Action initiator ID
      description: 'For: user_added_to_tag, user_removed_from_tag, user_chat_leave'
    AuditDetailsInviter:
      type: object
      required:
        - inviter_id
      properties:
        inviter_id:
          type: integer
          format: int32
          description: Inviter ID
      description: 'For: user_chat_join'
    AuditDetailsKms:
      type: object
      required:
        - chat_id
        - message_id
        - reason
      properties:
        chat_id:
          type: integer
          format: int32
          description: Chat ID
        message_id:
          type: integer
          format: int32
          description: Message ID
        reason:
          type: string
          description: Operation reason
      description: 'For: kms_encrypt, kms_decrypt'
    AuditDetailsLoginGrantApproved:
      type: object
      required:
        - login_grant_id
        - device
      properties:
        login_grant_id:
          type: string
          description: ID of the QR code sign-in request, shared by all events of one sign-in
        device:
          allOf:
            - $ref: '#/components/schemas/AuditLoginGrantDevice'
          description: Device the sign-in was made on
      description: 'For: login_grant_approved'
    AuditDetailsLoginGrantCreated:
      type: object
      required:
        - login_grant_id
      properties:
        login_grant_id:
          type: string
          description: ID of the QR code sign-in request, shared by all events of one sign-in
      description: 'For: login_grant_created'
    AuditDetailsLoginGrantDenied:
      type: object
      required:
        - login_grant_id
        - device
        - reason
      properties:
        login_grant_id:
          type: string
          description: ID of the QR code sign-in request, shared by all events of one sign-in
        device:
          allOf:
            - $ref: '#/components/schemas/AuditLoginGrantDevice'
          description: Device the sign-in was made on
        reason:
          allOf:
            - $ref: '#/components/schemas/AuditLoginGrantDenyReason'
          description: Rejection reason
      description: 'For: login_grant_denied'
    AuditDetailsOAuthAuthorizationGranted:
      type: object
      required:
        - client_id
        - scopes
      properties:
        client_id:
          type: string
          description: ID of the OAuth client that was granted access
        scopes:
          type: array
          items:
            type: string
          description: Scopes the access was granted for
      description: 'For: oauth_authorization_granted'
    AuditDetailsOAuthAuthorizationRevoked:
      type: object
      required:
        - client_id
        - revoked_tokens_count
      properties:
        client_id:
          type: string
          description: ID of the OAuth client whose access was revoked
        revoked_tokens_count:
          type: integer
          format: int32
          description: Number of revoked tokens
        user_id:
          type: integer
          format: int32
          description: ID of the employee whose access was revoked. Present when the access was revoked by an administrator.
      description: 'For: oauth_authorization_revoked'
    AuditDetailsRoleChanged:
      type: object
      required:
        - new_company_role
        - previous_company_role
        - initiator_id
      properties:
        new_company_role:
          type: string
          description: New role
        previous_company_role:
          type: string
          description: Previous role
        initiator_id:
          type: integer
          format: int32
          description: Initiator ID
      description: 'For: user_role_changed'
    AuditDetailsSearch:
      type: object
      required:
        - search_type
        - query_present
        - cursor_present
        - limit
        - filters
      properties:
        search_type:
          type: string
          description: Search type
        query_present:
          type: boolean
          description: Whether a search query was specified
        cursor_present:
          type: boolean
          description: Whether a cursor was used
        limit:
          type: integer
          format: int32
          description: Number of returned results
        filters:
          type: object
          additionalProperties: {}
          description: >-
            Applied filters. Possible keys depend on the search type: order, sort, created_from, created_to,
            company_roles (users), active, chat_subtype, personal (chats), chat_ids, user_ids (messages).
      description: 'For: search_users_api, search_chats_api, search_messages_api'
    AuditDetailsTagChat:
      type: object
      required:
        - chat_id
        - tag_name
      properties:
        chat_id:
          type: integer
          format: int32
          description: Chat ID
        tag_name:
          type: string
          description: Tag name
      description: 'For: tag_added_to_chat'
    AuditDetailsTagName:
      type: object
      required:
        - name
      properties:
        name:
          type: string
          description: Tag name
      description: 'For: tag_created, tag_deleted'
    AuditDetailsToken:
      type: object
      required:
        - token_kind
        - token_name
        - resource_owner_id
        - scopes
      properties:
        token_kind:
          type: string
          description: >-
            Token kind: `personal` — a personal token, `cli` — a CLI sign-in, `bot` — a bot token, `oauth` — a token an
            employee granted to a bot on the consent screen, `client` — a token of an external app an employee granted
            access to
        token_name:
          type: string
          nullable: true
          description: Token name, for a CLI sign-in — the device name. `null` if there is no name.
        resource_owner_id:
          type: integer
          format: int32
          description: 'ID of the token owner: an employee, or the bot itself for a bot token'
        scopes:
          type: array
          items:
            type: string
          description: Token scopes
        bot_id:
          type: integer
          format: int32
          description: Bot ID. Present for bot tokens and for tokens an employee granted to a bot.
      description: >-
        For: access_token_created, access_token_updated, access_token_destroy, bot_token_created, bot_token_reissued,
        bot_token_recreated, bot_token_deleted, oauth_token_revoked
    AuditDetailsTokenScopes:
      type: object
      required:
        - scopes
      properties:
        scopes:
          type: array
          items:
            type: string
          description: Token scopes
      description: 'For: access_token_created, access_token_updated, access_token_destroy in records made before October 7, 2026'
    AuditDetailsUserLoginQr:
      type: object
      required:
        - method
        - login_grant_id
      properties:
        method:
          type: string
          description: 'Sign-in method: `qr` — a QR code sign-in'
        login_grant_id:
          type: string
          description: ID of the QR code sign-in request, shared by all events of one sign-in
      description: 'For: user_login with a QR code sign-in'
    AuditDetailsUserUpdated:
      type: object
      required:
        - changed_attrs
      properties:
        changed_attrs:
          type: array
          items:
            type: string
          description: List of changed fields
        context:
          type: string
          description: >-
            How the change was made. The `sso_login` value means the profile was updated automatically during SSO
            sign-in. The field is absent when the profile was changed the regular way.
      description: 'For: user_updated'
    AuditDetailsVideoCallFinished:
      type: object
      required:
        - chat_id
        - started_message_id
        - duration
        - max_members_count
      properties:
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where the video call took place
        started_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the call start message. `null` if there is no such message.
        duration:
          type: integer
          format: int32
          nullable: true
          description: Call duration in seconds. `null` if the call ended without ever starting.
        max_members_count:
          type: integer
          format: int32
          description: Maximum number of simultaneous participants during the call
      description: 'For: video_call_finished'
    AuditDetailsVideoCallRecording:
      type: object
      required:
        - chat_id
        - started_message_id
        - recording_id
        - file_id
        - duration
        - size
      properties:
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where the video call took place
        started_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the call start message. `null` if there is no such message.
        recording_id:
          type: integer
          format: int32
          description: Recording ID
        file_id:
          type: integer
          format: int32
          description: Recording file ID
        duration:
          type: integer
          format: int32
          description: Recording duration in seconds
        size:
          type: integer
          format: int64
          description: Recording file size in bytes
      description: 'For: video_call_recording_ready'
    AuditDetailsVideoCallStarted:
      type: object
      required:
        - chat_id
        - started_message_id
      properties:
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where the video call takes place
        started_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the call start message. `null` if there is no such message.
      description: 'For: video_call_started'
    AuditEvent:
      type: object
      required:
        - id
        - created_at
        - event_key
        - entity_id
        - entity_type
        - actor_id
        - actor_type
        - details
        - ip_address
        - user_agent
      properties:
        id:
          type: string
          description: Unique event ID
          example: a1b2c3d4-5e6f-7g8h-9i10-j11k12l13m14
        created_at:
          type: string
          format: date-time
          description: Event creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-05-15T14:30:00.000Z'
        event_key:
          allOf:
            - $ref: '#/components/schemas/AuditEventKey'
          description: Event type key
          example: user_login
        entity_id:
          type: string
          description: Affected entity ID
          example: '98765'
        entity_type:
          type: string
          description: Affected entity type
          example: User
        actor_id:
          type: string
          description: ID of the user who performed the action
          example: '98765'
        actor_type:
          type: string
          description: Actor type
          example: User
        details:
          allOf:
            - $ref: '#/components/schemas/AuditEventDetailsUnion'
          description: >-
            Additional event details. Structure depends on the event_key value — see event_key field value descriptions.
            For events without details, an empty object is returned.
        ip_address:
          type: string
          nullable: true
          description: IP address from which the action was performed. `null` for events recorded without a user request.
          example: 192.168.1.100
        user_agent:
          type: string
          nullable: true
          description: Client user agent, truncated to 255 characters. `null` for events recorded without a user request.
          example: Pachca/3.60.0 (build:15; iOS 18.5.0) Alamofire/5.0.0
      description: Audit event
    AuditEventDetailsUnion:
      anyOf:
        - $ref: '#/components/schemas/AuditDetailsEmpty'
        - $ref: '#/components/schemas/AuditDetailsUserUpdated'
        - $ref: '#/components/schemas/AuditDetailsRoleChanged'
        - $ref: '#/components/schemas/AuditDetailsTagName'
        - $ref: '#/components/schemas/AuditDetailsInitiator'
        - $ref: '#/components/schemas/AuditDetailsInviter'
        - $ref: '#/components/schemas/AuditDetailsChatRenamed'
        - $ref: '#/components/schemas/AuditDetailsChatPermission'
        - $ref: '#/components/schemas/AuditDetailsTagChat'
        - $ref: '#/components/schemas/AuditDetailsChatId'
        - $ref: '#/components/schemas/AuditDetailsTokenScopes'
        - $ref: '#/components/schemas/AuditDetailsKms'
        - $ref: '#/components/schemas/AuditDetailsDlp'
        - $ref: '#/components/schemas/AuditDetailsSearch'
        - $ref: '#/components/schemas/AuditDetailsBot'
        - $ref: '#/components/schemas/AuditDetailsBotScopes'
        - $ref: '#/components/schemas/AuditDetailsBotWebhookSettings'
        - $ref: '#/components/schemas/AuditDetailsBotOAuthClient'
        - $ref: '#/components/schemas/AuditDetailsOAuthAuthorizationGranted'
        - $ref: '#/components/schemas/AuditDetailsOAuthAuthorizationRevoked'
        - $ref: '#/components/schemas/AuditDetailsDeviceAuthorizationApproved'
        - $ref: '#/components/schemas/AuditDetailsDeviceAuthorizationDenied'
        - $ref: '#/components/schemas/AuditDetailsVideoCallStarted'
        - $ref: '#/components/schemas/AuditDetailsVideoCallFinished'
        - $ref: '#/components/schemas/AuditDetailsVideoCallRecording'
        - $ref: '#/components/schemas/AuditDetailsBotOAuthClientSecretRotated'
        - $ref: '#/components/schemas/AuditDetailsBotOAuthClientDisabled'
        - $ref: '#/components/schemas/AuditDetailsToken'
        - $ref: '#/components/schemas/AuditDetailsBotTokenUpdated'
        - $ref: '#/components/schemas/AuditDetailsUserLoginQr'
        - $ref: '#/components/schemas/AuditDetailsLoginGrantCreated'
        - $ref: '#/components/schemas/AuditDetailsLoginGrantApproved'
        - $ref: '#/components/schemas/AuditDetailsLoginGrantDenied'
      description: Additional audit event details. Structure depends on the event_key value.
    AuditEventKey:
      type: string
      enum:
        - user_login
        - user_logout
        - user_2fa_fail
        - user_2fa_success
        - user_2fa_disabled
        - login_grant_created
        - login_grant_approved
        - login_grant_denied
        - user_created
        - user_deleted
        - user_role_changed
        - user_updated
        - tag_created
        - tag_deleted
        - user_added_to_tag
        - user_removed_from_tag
        - chat_created
        - chat_renamed
        - chat_permission_changed
        - user_chat_join
        - user_chat_leave
        - tag_added_to_chat
        - tag_removed_from_chat
        - message_updated
        - message_deleted
        - message_created
        - reaction_created
        - reaction_deleted
        - thread_created
        - access_token_created
        - access_token_updated
        - access_token_destroy
        - kms_encrypt
        - kms_decrypt
        - audit_events_accessed
        - company_chats_accessed
        - company_bots_accessed
        - dlp_violation_detected
        - search_users_api
        - search_chats_api
        - search_messages_api
        - bot_scopes_updated
        - bot_webhook_settings_updated
        - bot_token_recreated
        - bot_deleted
        - bot_oauth_client_updated
        - bot_oauth_client_disabled
        - bot_oauth_client_secret_rotated
        - bot_oauth_client_secret_issued
        - bot_token_created
        - bot_token_updated
        - bot_token_reissued
        - bot_token_deleted
        - oauth_authorization_granted
        - oauth_authorization_revoked
        - oauth_token_revoked
        - oauth_device_authorization_approved
        - oauth_device_authorization_denied
        - video_call_started
        - video_call_finished
        - video_call_recording_ready
        - exchange_disabled
      description: Audit event type
      x-enum-descriptions:
        user_login: User logged in successfully
        user_logout: User logged out
        user_2fa_fail: Failed two-factor authentication attempt
        user_2fa_success: Successful two-factor authentication
        user_2fa_disabled: Two-factor authentication disabled for the employee
        login_grant_created: QR code issued for signing in to the mobile app
        login_grant_approved: Employee confirmed a QR code sign-in
        login_grant_denied: QR code sign-in rejected
        user_created: New user account created
        user_deleted: User account deleted
        user_role_changed: User role changed
        user_updated: User data updated
        tag_created: New tag created
        tag_deleted: Tag deleted
        user_added_to_tag: User added to tag
        user_removed_from_tag: User removed from tag
        chat_created: New chat created
        chat_renamed: Chat renamed
        chat_permission_changed: Chat access permissions changed
        user_chat_join: User joined the chat
        user_chat_leave: User left the chat
        tag_added_to_chat: Tag added to chat
        tag_removed_from_chat: Tag removed from chat
        message_updated: Message edited
        message_deleted: Message deleted
        message_created: Message created
        reaction_created: Reaction added
        reaction_deleted: Reaction removed
        thread_created: Thread created
        access_token_created: New access token created
        access_token_updated: Access token updated
        access_token_destroy: Access token deleted
        kms_encrypt: Data encrypted
        kms_decrypt: Data decrypted
        audit_events_accessed: Audit logs accessed
        company_chats_accessed: Workspace-wide chat list accessed
        company_bots_accessed: Workspace-wide bot list accessed
        dlp_violation_detected: DLP rule violation detected
        search_users_api: Employee search via API
        search_chats_api: Chat search via API
        search_messages_api: Message search via API
        bot_scopes_updated: Bot token scopes changed
        bot_webhook_settings_updated: Bot outgoing webhook settings changed
        bot_token_recreated: Bot token recreated (rotation)
        bot_deleted: Bot deleted
        bot_oauth_client_updated: Bot OAuth client settings changed
        bot_oauth_client_disabled: Authorization on behalf of an employee disabled for the bot
        bot_oauth_client_secret_rotated: Bot OAuth client secret rotated
        bot_oauth_client_secret_issued: Bot OAuth client secret issued
        bot_token_created: Bot token issued
        bot_token_updated: Bot token name or scopes changed
        bot_token_reissued: Additional bot token reissued
        bot_token_deleted: Bot token deleted
        oauth_authorization_granted: User granted an OAuth client access to their data
        oauth_authorization_revoked: An OAuth client's access to user data was revoked
        oauth_token_revoked: An OAuth client revoked a token issued to it
        oauth_device_authorization_approved: Employee confirmed an app sign-in from a device
        oauth_device_authorization_denied: Employee rejected an app sign-in from a device
        video_call_started: Video call started
        video_call_finished: Video call finished
        video_call_recording_ready: Video call recording ready
        exchange_disabled: Exchange integration disabled
    AuditLoginGrantDenyReason:
      type: string
      enum:
        - denied
        - verification_failed
      description: Reason a QR code sign-in was rejected
      x-enum-descriptions:
        denied: The employee rejected the sign-in
        verification_failed: The employee entered digits other than the ones the device showed
    AuditLoginGrantDevice:
      type: object
      required:
        - name
        - platform
      properties:
        name:
          type: string
          maxLength: 255
          description: Device name
        platform:
          allOf:
            - $ref: '#/components/schemas/AuditLoginGrantDevicePlatform'
          description: App platform
        os_version:
          type: string
          maxLength: 255
          description: Operating system version. Present if the app sent it.
        app_version:
          type: string
          maxLength: 255
          description: Pachca app version. Present if the app sent it.
      description: Device in a QR code sign-in. The app itself sends its data, and the server checks only their format.
    AuditLoginGrantDevicePlatform:
      type: string
      enum:
        - iOS
        - Android
        - Rustore
        - Appgallery
      description: Platform of the mobile app a QR code sign-in is made in
      x-enum-descriptions:
        iOS: iOS app
        Android: Android app
        Rustore: Android app from RuStore
        Appgallery: Android app from AppGallery
    AvatarData:
      type: object
      required:
        - image_url
      properties:
        image_url:
          type: string
          description: Avatar URL
          example: https://files.example.com/uploads/0001/0001/image.jpg
      description: Avatar data
    BotAccessToken:
      type: object
      required:
        - id
        - token
        - name
        - user_id
        - scopes
        - created_at
        - revoked_at
        - expires_in
        - last_used_at
        - authorized_at
      properties:
        id:
          type: integer
          format: int64
          description: Token ID
          example: 4827
        token:
          type: string
          description: >-
            Masked token (the first 8 and the last 4 characters are visible). The full value is returned once: when the
            token is issued and when it is reissued.
          example: cH5kR9mN...x7Qp
        name:
          type: string
          nullable: true
          description: Token name. `null` for a token issued without a name.
          example: Notification server
        user_id:
          type: integer
          format: int64
          description: ID of the bot the token belongs to
          example: 1738816
        scopes:
          type: array
          items:
            type: string
          description: Token scopes
          example:
            - messages:create
            - chats:read
        created_at:
          type: string
          format: date-time
          description: Token issue date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-01-15T10:30:00.000Z'
        revoked_at:
          type: string
          format: date-time
          nullable: true
          description: 'Token revocation date. Always `null`: revoked tokens are not returned.'
          example: null
        expires_in:
          type: integer
          format: int32
          nullable: true
          description: 'Token lifetime in seconds. `null` for bot tokens: they do not expire.'
          example: null
        last_used_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Token last used date. `null` until the token has been used at least once. Updated at most once a minute, so
            it may lag behind.
          example: '2025-02-24T14:20:00.000Z'
        authorized_at:
          type: string
          format: date-time
          nullable: true
          description: Authorization date. `null` for bot tokens.
          example: null
      description: Bot token
    BotCanEdit:
      type: string
      enum:
        - admin
        - chat_owners
      description: Role allowed to edit the bot settings
      x-enum-descriptions:
        admin: Company administrators
        chat_owners: Owners of the chats the bot is added to
    BotCreateRequest:
      type: object
      required:
        - webhook
      properties:
        empty:
          type: boolean
          description: >-
            Create an empty bot: without a token and without an incoming webhook. Without this field the bot is created
            with an incoming webhook in its own format, and its token comes in `access_token`.
          example: false
          default: false
        webhook:
          type: object
          properties:
            name:
              type: string
              maxLength: 255
              description: Bot name
              example: Tasks bot
            nickname:
              type: string
              maxLength: 255
              description: Bot nickname. Must end with `_bot`.
              example: tasks_bot
            outgoing_url:
              type: string
              description: Outgoing webhook URL
              example: https://example.com/tasks/new
            events:
              type: array
              items:
                $ref: '#/components/schemas/BotEventName'
              description: Events the bot is subscribed to
              example:
                - message_new
            trigger_on:
              allOf:
                - $ref: '#/components/schemas/BotTriggerOn'
              description: Outgoing webhook trigger condition
              example: commands
              default: commands
            commands:
              type: array
              items:
                type: string
              description: >-
                Bot commands (trigger words) it reacts to when trigger_on = commands. The combined length of the
                comma-joined commands must not exceed 255 characters.
              example:
                - /task
                - /help
            scopes:
              type: array
              items:
                type: string
              description: >-
                Bot token scopes (permissions). If omitted, the bot receives the default set. Not every scope is
                available to a bot: some are allowed only for user roles, and attempting to assign such a scope returns
                `400`. The service values `bot` and `all` cannot be assigned.
              example:
                - messages:create
            template:
              type: string
              description: Template for formatting the incoming webhook
              example: Order from {{ client }} for {{ amount }} ₽
            template_engine:
              allOf:
                - $ref: '#/components/schemas/BotTemplateEngine'
              description: >-
                Template engine used to process the incoming webhook template. Without this field a bot gets `liquid`,
                and an empty bot (`empty: true`) gets `mustache`.
              example: liquid
            challenge_key:
              type: string
              description: Verification field name for incoming webhook verification
              example: challenge
            link_preview_enabled:
              type: boolean
              description: Show link previews in incoming webhook messages
              example: true
              default: true
            ignore_self_messages:
              type: boolean
              description: Skip events about the bot's own messages and reactions
              example: false
              default: false
            events_history_enabled:
              type: boolean
              description: Save the bot's event history for later retrieval via the event history method
              example: false
              default: false
            who_can_add:
              allOf:
                - $ref: '#/components/schemas/BotWhoCanAdd'
              description: Who can add the bot to chats
              example: creator
              default: creator
            can_edit:
              type: array
              items:
                $ref: '#/components/schemas/BotCanEdit'
              description: >-
                Roles allowed to edit the bot settings in addition to the creator. The creator can always edit. An empty
                array means only the creator can edit.
              example:
                - admin
            single_chat:
              type: boolean
              description: >-
                Restricts the bot to a single group chat. `true` — the bot can be added to one discussion or channel
                only, `false` — to multiple. Personal chats and threads don't count toward this limit.
              example: false
              default: false
            kind:
              allOf:
                - $ref: '#/components/schemas/BotWebhookKind'
              description: >-
                Incoming webhook source. Without `empty` it defaults to `simple`, and an empty bot gets an incoming
                webhook only through this field.
              example: simple
            unfurl_domains:
              type: array
              items:
                type: string
              maxItems: 5
              description: Domains whose links the bot unfurls, up to 5. They work together with the `message_link_shared` event.
              example:
                - example.com
          required:
            - name
          description: Webhook parameters object of the bot to create
        oauth_client:
          allOf:
            - $ref: '#/components/schemas/BotOAuthClientRequest'
          description: Enable authorization on behalf of an employee right at creation
        promo:
          allOf:
            - $ref: '#/components/schemas/BotPromoRequest'
          description: 'The bot''s catalog page. Set only together with `oauth_client`: without authorization the bot has no page.'
      description: Bot creation request
    BotCreateResponse:
      type: object
      required:
        - id
        - name
        - nickname
        - avatar_url
        - creator_id
        - created_at
        - authorized_users_count
        - last_used_at
        - webhook
        - oauth_client_enabled
        - oauth_client
        - promo
        - permissions
      properties:
        id:
          type: integer
          format: int32
          description: Bot ID (same as the bot's `user_id`)
          example: 1738816
        name:
          type: string
          description: Bot name
          example: Tasks bot
        nickname:
          type: string
          description: Bot nickname
          example: tasks_bot
        avatar_url:
          type: string
          nullable: true
          description: Bot avatar URL. `null` if no avatar is set.
          example: https://files.example.com/uploads/0001/0001/image.jpg
        creator_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the employee who created the bot. `null` if the creator is not recorded.
          example: 12
        created_at:
          type: string
          format: date-time
          description: Bot creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-05-15T14:30:00.000Z'
        authorized_users_count:
          type: integer
          format: int32
          description: How many employees have authorized the bot
          example: 3
        last_used_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Date and time the bot last worked (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format: a request to the
            incoming webhook or an API call with any of the bot's tokens, including employee tokens. `null` if there has
            been none. Token use is recorded at most once a minute.
          example: '2025-05-15T14:30:00.000Z'
        webhook:
          allOf:
            - $ref: '#/components/schemas/BotWebhook'
          description: Webhook parameters object
        oauth_client_enabled:
          type: boolean
          description: Whether authorization on behalf of an employee is enabled for the bot
          example: true
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClient'
          nullable: true
          description: >-
            Authorization on behalf of an employee. It can come even for a bot with authorization disabled, so check
            `oauth_client_enabled` to see whether it is enabled. A bot without tokens may get `null`.
        promo:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotPromo'
          nullable: true
          description: The bot's catalog page. `null` if authorization is disabled for the bot.
        permissions:
          allOf:
            - $ref: '#/components/schemas/BotPermissions'
          description: What you can do with this bot
        client_secret:
          type: string
          description: >-
            Client secret. Returned once: when a server-side client is enabled, when the client switches to server-side,
            and when the secret is rotated.
          example: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
        access_token:
          type: string
          description: >-
            Bot access token. Returned when the bot is created and when the token is rotated. Not returned if the bot is
            created with `empty: true`.
          example: bm90X2FfcmVhbF90b2tlbg
      description: Created bot parameters
    BotEventName:
      type: string
      enum:
        - message_new
        - message_update
        - message_delete
        - reaction_new
        - reaction_delete
        - button_click
        - message_link_shared
        - chat_member_add
        - chat_member_remove
        - company_member_invite
        - company_member_confirm
        - company_member_suspend
        - company_member_activate
        - company_member_delete
        - company_member_update
        - video_call_started
        - video_call_finished
        - video_call_recording_ready
      description: Bot outgoing webhook event
      x-enum-descriptions:
        message_new: New message
        message_update: Message edited
        message_delete: Message deleted
        reaction_new: Reaction added
        reaction_delete: Reaction removed
        button_click: Button clicked
        message_link_shared: A link was shared in a message (for unfurl)
        chat_member_add: Member added to chat
        chat_member_remove: Member removed from chat
        company_member_invite: Employee invited to the company
        company_member_confirm: Employee confirmed the invitation
        company_member_suspend: Employee suspended
        company_member_activate: Employee activated
        company_member_delete: Employee removed from the company
        company_member_update: Employee data changed
        video_call_started: Video call started
        video_call_finished: Video call finished
        video_call_recording_ready: Video call recording ready
    BotOAuthClient:
      type: object
      required:
        - client_id
        - client_secret_preview
        - confidential
        - redirect_uris
        - scopes
      properties:
        client_id:
          type: string
          description: Client ID for the authorization link
          example: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
        client_secret_preview:
          type: string
          description: >-
            Masked client secret. The full value comes in `client_secret` once: when a server-side client is enabled and
            when the secret is rotated.
          example: cH5kR9mN...x7Qp
        confidential:
          type: boolean
          description: >-
            Where the secret is stored: `true` — a server-side application, `false` — an application without a secret
            that exchanges the code with PKCE
          example: true
        redirect_uris:
          type: array
          items:
            type: string
          description: Redirect URIs after consent
          example:
            - https://example.com/oauth/callback
        scopes:
          type: array
          items:
            type: string
          description: Scopes the bot requests from an employee on the consent screen
          example:
            - messages:read
            - messages:create
      description: Authorization on behalf of an employee
    BotOAuthClientRequest:
      type: object
      properties:
        confidential:
          type: boolean
          description: >-
            Where the secret is stored: `true` — a server-side application stores `client_secret` and exchanges the code
            on its side, `false` — an application without a secret (browser, mobile, CLI) exchanges the code with PKCE.
            If omitted, the value does not change, and a new client gets `true`.
          example: true
        redirect_uris:
          type: array
          items:
            type: string
          description: >-
            Redirect URIs after consent. HTTPS is required, except for addresses on the same computer (`localhost`,
            `127.0.0.1`, `[::1]`). The address in the authorization link must exactly match one from the list, except
            that the port is not compared for addresses on the same computer. Pass at least one address when enabling.
            The list is replaced as a whole.
          example:
            - https://example.com/oauth/callback
          x-replaces-set: true
        scopes:
          type: array
          items:
            type: string
          description: >-
            Scopes the bot requests from an employee on the consent screen. Only scopes that can be granted to the bot
            itself are available. If omitted when enabling, all bot scopes are requested. The list is replaced as a
            whole.
          example:
            - messages:read
            - messages:create
          x-replaces-set: true
      description: Settings of authorization on behalf of an employee
    BotPermissions:
      type: object
      required:
        - update_oauth_client
        - recreate_token
        - destroy
      properties:
        update_oauth_client:
          type: boolean
          description: Change authorization on behalf of an employee, the catalog page and the bot name
          example: true
        recreate_token:
          type: boolean
          description: Issue, change and delete the bot's tokens and rotate the client secret
          example: true
        destroy:
          type: boolean
          description: Delete the bot
          example: true
      description: What the current user can do with the bot
    BotPromo:
      type: object
      required:
        - description
        - published
        - promo_images
      properties:
        description:
          type: string
          nullable: true
          description: Bot description. `null` if not set.
          example: Collects a summary of Jira tasks and sends it to the chat
        published:
          type: boolean
          description: Whether the bot is published in the catalog
          example: true
        promo_images:
          type: array
          items:
            $ref: '#/components/schemas/BotPromoImage'
          description: Screenshots for the bot's page
      description: The bot's catalog page
    BotPromoImage:
      type: object
      required:
        - key
        - url
      properties:
        key:
          type: string
          description: Image key
          example: attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/screenshot.png
        url:
          type: string
          description: Image URL
          example: https://files.example.com/attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/screenshot.png
      description: Screenshot for the bot's catalog page
    BotPromoRequest:
      type: object
      properties:
        description:
          type: string
          description: 'Description: what the bot does and why to connect it. A bot cannot be published without a description.'
          example: Collects a summary of Jira tasks and sends it to the chat
        published:
          type: boolean
          description: >-
            Publish the bot to the catalog: it appears as a card on the "Overview" tab. Publishing requires a
            description.
          example: true
        promo_images:
          type: array
          items:
            type: string
          maxItems: 5
          description: >-
            Screenshots for the bot's page, up to 5: keys of uploaded images (`key` from [Get signature, key and other
            parameters](POST /uploads)). The list is replaced as a whole, the order is kept.
          example:
            - attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/screenshot.png
          x-replaces-set: true
      description: The bot's catalog page
    BotResponse:
      type: object
      required:
        - id
        - name
        - nickname
        - avatar_url
        - creator_id
        - created_at
        - authorized_users_count
        - last_used_at
        - webhook
        - oauth_client_enabled
        - oauth_client
        - promo
        - permissions
      properties:
        id:
          type: integer
          format: int32
          description: Bot ID (same as the bot's `user_id`)
          example: 1738816
        name:
          type: string
          description: Bot name
          example: Tasks bot
        nickname:
          type: string
          description: Bot nickname
          example: tasks_bot
        avatar_url:
          type: string
          nullable: true
          description: Bot avatar URL. `null` if no avatar is set.
          example: https://files.example.com/uploads/0001/0001/image.jpg
        creator_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the employee who created the bot. `null` if the creator is not recorded.
          example: 12
        created_at:
          type: string
          format: date-time
          description: Bot creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-05-15T14:30:00.000Z'
        authorized_users_count:
          type: integer
          format: int32
          description: How many employees have authorized the bot
          example: 3
        last_used_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Date and time the bot last worked (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format: a request to the
            incoming webhook or an API call with any of the bot's tokens, including employee tokens. `null` if there has
            been none. Token use is recorded at most once a minute.
          example: '2025-05-15T14:30:00.000Z'
        webhook:
          allOf:
            - $ref: '#/components/schemas/BotWebhook'
          description: Webhook parameters object
        oauth_client_enabled:
          type: boolean
          description: Whether authorization on behalf of an employee is enabled for the bot
          example: true
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClient'
          nullable: true
          description: >-
            Authorization on behalf of an employee. It can come even for a bot with authorization disabled, so check
            `oauth_client_enabled` to see whether it is enabled. A bot without tokens may get `null`.
        promo:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotPromo'
          nullable: true
          description: The bot's catalog page. `null` if authorization is disabled for the bot.
        permissions:
          allOf:
            - $ref: '#/components/schemas/BotPermissions'
          description: What you can do with this bot
        client_secret:
          type: string
          description: >-
            Client secret. Returned once: when a server-side client is enabled, when the client switches to server-side,
            and when the secret is rotated.
          example: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
      description: Bot parameters
    BotScopeCatalog:
      type: object
      required:
        - scopes
        - groups
        - presets
      properties:
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/BotScopeCatalogItem'
          description: Scopes available to the bot
        groups:
          type: array
          items:
            $ref: '#/components/schemas/BotScopeCatalogGroup'
          description: Scope categories
        presets:
          type: array
          items:
            $ref: '#/components/schemas/BotScopeCatalogPreset'
          description: Ready-made scope sets
      description: Catalog of scopes that can be granted to the bot
    BotScopeCatalogGroup:
      type: object
      required:
        - id
        - title
        - description
      properties:
        id:
          type: string
          description: Category ID
          example: messages
        title:
          type: string
          description: Category name
          example: Messages
        description:
          type: string
          description: Category description
          example: Working with messages
      description: Scope category
    BotScopeCatalogItem:
      type: object
      required:
        - id
        - title
        - group
        - preset
      properties:
        id:
          type: string
          description: Scope
          example: messages:create
        title:
          type: string
          description: Scope description
          example: Send messages
        group:
          type: string
          description: Scope category, `id` from `groups`
          example: messages
        preset:
          type: array
          items:
            type: string
          description: Sets that include the scope, `id` from `presets`
          example:
            - admin
      description: Scope in the bot scope catalog
    BotScopeCatalogPreset:
      type: object
      required:
        - id
        - title
      properties:
        id:
          type: string
          description: 'Set ID: `read-only` or `admin`'
          example: read-only
        title:
          type: string
          description: Set name
          example: Read only
      description: Ready-made scope set
    BotSelfResponse:
      type: object
      required:
        - id
        - oauth_client
        - webhook
      properties:
        id:
          type: integer
          format: int32
          description: Bot ID (same as the bot's `user_id`)
          example: 1738816
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClient'
          nullable: true
          description: >-
            Authorization on behalf of an employee. It can come even for a bot with authorization disabled. A bot
            without tokens may get `null`.
        webhook:
          allOf:
            - $ref: '#/components/schemas/BotSelfWebhook'
          description: Webhook parameters object
      description: Bot parameters in the responses of the bot's own methods
    BotSelfTokenResponse:
      type: object
      required:
        - id
        - oauth_client
        - webhook
        - access_token
      properties:
        id:
          type: integer
          format: int32
          description: Bot ID (same as the bot's `user_id`)
          example: 1738816
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClient'
          nullable: true
          description: >-
            Authorization on behalf of an employee. It can come even for a bot with authorization disabled. A bot
            without tokens may get `null`.
        webhook:
          allOf:
            - $ref: '#/components/schemas/BotSelfWebhook'
          description: Webhook parameters object
        access_token:
          type: string
          description: New bot token. Returned once.
          example: bm90X2FfcmVhbF90b2tlbg
      description: Bot parameters with a new token
    BotSelfWebhook:
      type: object
      required:
        - name
        - nickname
        - outgoing_url
        - events
        - trigger_on
        - commands
        - scopes
        - template
        - template_engine
        - challenge_key
        - link_preview_enabled
        - ignore_self_messages
        - events_history_enabled
        - single_chat
        - can_edit
        - who_can_add
      properties:
        name:
          type: string
          maxLength: 255
          description: Bot name
          example: Tasks bot
        nickname:
          type: string
          maxLength: 255
          description: Bot nickname
          example: tasks_bot
        outgoing_url:
          type: string
          nullable: true
          description: Outgoing webhook URL. `null` if the bot has no outgoing webhook configured.
          example: https://example.com/tasks/new
        events:
          type: array
          items:
            $ref: '#/components/schemas/BotEventName'
          description: Events the bot is subscribed to
          example:
            - message_new
        trigger_on:
          allOf:
            - $ref: '#/components/schemas/BotTriggerOn'
          description: Outgoing webhook trigger condition
          example: commands
        commands:
          type: array
          items:
            type: string
          description: Bot commands (trigger words)
          example:
            - /task
        scopes:
          type: array
          items:
            type: string
          description: >-
            Bot token scopes (permissions). The default set is broader than what can be assigned explicitly, so values
            that cannot be set explicitly may appear here.
          example:
            - messages:create
        template:
          type: string
          nullable: true
          description: Template for formatting the incoming webhook. `null` if not set.
          example: Order from {{ client }} for {{ amount }} ₽
        template_engine:
          allOf:
            - $ref: '#/components/schemas/BotTemplateEngine'
          description: Template engine used to process the incoming webhook template
          example: liquid
        challenge_key:
          type: string
          nullable: true
          description: Verification field name for incoming webhook verification. `null` if not set.
          example: challenge
        link_preview_enabled:
          type: boolean
          description: Show link previews in incoming webhook messages
          example: true
        ignore_self_messages:
          type: boolean
          description: Skip events about the bot's own messages and reactions
          example: false
        events_history_enabled:
          type: boolean
          description: Save the bot's event history for later retrieval via the event history method
          example: false
        single_chat:
          type: boolean
          description: >-
            Restricts the bot to a single group chat. `true` — the bot can be added to one discussion or channel only,
            `false` — to multiple. Personal chats and threads don't count toward this limit
          example: false
        can_edit:
          type: array
          items:
            $ref: '#/components/schemas/BotCanEdit'
          description: >-
            Roles allowed to edit the bot settings in addition to the creator. The creator can always edit. An empty
            array means only the creator can edit.
          example:
            - admin
        who_can_add:
          allOf:
            - $ref: '#/components/schemas/BotWhoCanAdd'
          description: Who can add the bot to chats
          example: creator
      description: Bot webhook parameters in the responses of the bot's own methods
    BotTemplateEngine:
      type: string
      enum:
        - liquid
        - mustache
      description: Template engine for formatting incoming webhooks
      x-enum-descriptions:
        liquid: Liquid — conditions, loops, and filters
        mustache: Mustache — simple substitution without logic
    BotTokenCreateRequest:
      type: object
      required:
        - name
      properties:
        name:
          type: string
          maxLength: 255
          description: 'Token name: tokens are told apart by it in the list'
          example: Notification server
        scopes:
          type: array
          items:
            type: string
          description: >-
            Token scopes. Only scopes that can be granted to a bot are available. If omitted, the token is issued
            without scopes.
          example:
            - messages:create
            - chats:read
      description: Bot token issue request
    BotTokenUpdateRequest:
      type: object
      properties:
        name:
          type: string
          maxLength: 255
          description: New token name
          example: Notification server
        scopes:
          type: array
          items:
            type: string
          description: >-
            New token scopes. The list is replaced as a whole and takes effect immediately, there is no need to reissue
            the token.
          example:
            - messages:create
            - chats:read
          x-replaces-set: true
      description: Bot token update request
    BotTriggerOn:
      type: string
      enum:
        - commands
        - all_messages
        - unfurl
      description: Outgoing webhook trigger condition
      x-enum-descriptions:
        commands: Only on commands (trigger words) from commands
        all_messages: On all messages in chats where the bot is present
        unfurl: On link unfurling (link previews)
    BotUpdateRequest:
      type: object
      properties:
        webhook:
          type: object
          properties:
            name:
              type: string
              maxLength: 255
              description: Bot name
              example: Tasks bot
            nickname:
              type: string
              maxLength: 255
              description: Bot nickname. Must end with `_bot`.
              example: tasks_bot
            outgoing_url:
              type: string
              description: Outgoing webhook URL
              example: https://example.com/tasks/new
            events:
              type: array
              items:
                $ref: '#/components/schemas/BotEventName'
              description: Events the bot is subscribed to. The list is replaced as a whole.
              example:
                - message_new
              x-replaces-set: true
            trigger_on:
              allOf:
                - $ref: '#/components/schemas/BotTriggerOn'
              description: Outgoing webhook trigger condition
              example: commands
            commands:
              type: array
              items:
                type: string
              description: >-
                Bot commands (trigger words) it reacts to when trigger_on = commands. The combined length of the
                comma-joined commands must not exceed 255 characters.
              example:
                - /task
                - /help
              x-replaces-set: true
            scopes:
              type: array
              items:
                type: string
              description: >-
                Bot token scopes (permissions). If omitted, the bot receives the default set. Not every scope is
                available to a bot: some are allowed only for user roles, and attempting to assign such a scope returns
                `400`. The service values `bot` and `all` cannot be assigned.
              example:
                - messages:create
              x-replaces-set: true
            template:
              type: string
              description: Template for formatting the incoming webhook
              example: Order from {{ client }} for {{ amount }} ₽
            template_engine:
              allOf:
                - $ref: '#/components/schemas/BotTemplateEngine'
              description: Template engine used to process the incoming webhook template
              example: liquid
            challenge_key:
              type: string
              description: Verification field name for incoming webhook verification
              example: challenge
            link_preview_enabled:
              type: boolean
              description: Show link previews in incoming webhook messages
              example: true
            ignore_self_messages:
              type: boolean
              description: Skip events about the bot's own messages and reactions
              example: false
            events_history_enabled:
              type: boolean
              description: Save the bot's event history for later retrieval via the event history method
              example: false
            who_can_add:
              allOf:
                - $ref: '#/components/schemas/BotWhoCanAdd'
              description: Who can add the bot to chats
              example: creator
            can_edit:
              type: array
              items:
                $ref: '#/components/schemas/BotCanEdit'
              description: >-
                Roles allowed to edit the bot settings in addition to the creator. The creator can always edit. An empty
                array means only the creator can edit. The list is replaced as a whole.
              example:
                - admin
              x-replaces-set: true
            single_chat:
              type: boolean
              description: >-
                Restricts the bot to a single group chat. `true` — the bot can be added to one discussion or channel
                only, `false` — to multiple. Personal chats and threads don't count toward this limit
              example: false
            kind:
              allOf:
                - $ref: '#/components/schemas/BotWebhookKind'
              description: Incoming webhook source. If the bot had no incoming webhook, it is enabled.
              example: simple
            unfurl_domains:
              type: array
              items:
                type: string
              maxItems: 5
              description: >-
                Domains whose links the bot unfurls, up to 5. They work together with the `message_link_shared` event.
                The list is replaced as a whole.
              example:
                - example.com
              x-replaces-set: true
          description: Webhook parameters object of the bot to update
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClientRequest'
          nullable: true
          description: >-
            Settings of authorization on behalf of an employee. If authorization is disabled, the object enables it, and
            `null` disables it: authorizations granted by employees are revoked, the catalog page is deleted, and the
            bot's own tokens keep working.
        promo:
          allOf:
            - $ref: '#/components/schemas/BotPromoRequest'
          description: The bot's catalog page. Available only while authorization is enabled for the bot.
      description: Bot update request
    BotWebhook:
      type: object
      required:
        - name
        - nickname
        - outgoing_url
        - events
        - trigger_on
        - commands
        - scopes
        - template
        - template_engine
        - challenge_key
        - link_preview_enabled
        - ignore_self_messages
        - events_history_enabled
        - single_chat
        - can_edit
        - who_can_add
        - kind
        - unfurl_domains
        - last_request_at
      properties:
        name:
          type: string
          maxLength: 255
          description: Bot name
          example: Tasks bot
        nickname:
          type: string
          maxLength: 255
          description: Bot nickname
          example: tasks_bot
        outgoing_url:
          type: string
          nullable: true
          description: Outgoing webhook URL. `null` if the bot has no outgoing webhook configured.
          example: https://example.com/tasks/new
        events:
          type: array
          items:
            $ref: '#/components/schemas/BotEventName'
          description: Events the bot is subscribed to
          example:
            - message_new
        trigger_on:
          allOf:
            - $ref: '#/components/schemas/BotTriggerOn'
          description: Outgoing webhook trigger condition
          example: commands
        commands:
          type: array
          items:
            type: string
          description: Bot commands (trigger words)
          example:
            - /task
        scopes:
          type: array
          items:
            type: string
          description: >-
            Bot token scopes (permissions). The default set is broader than what can be assigned explicitly, so values
            that cannot be set explicitly may appear here.
          example:
            - messages:create
        template:
          type: string
          nullable: true
          description: Template for formatting the incoming webhook. `null` if not set.
          example: Order from {{ client }} for {{ amount }} ₽
        template_engine:
          allOf:
            - $ref: '#/components/schemas/BotTemplateEngine'
          description: Template engine used to process the incoming webhook template
          example: liquid
        challenge_key:
          type: string
          nullable: true
          description: Verification field name for incoming webhook verification. `null` if not set.
          example: challenge
        link_preview_enabled:
          type: boolean
          description: Show link previews in incoming webhook messages
          example: true
        ignore_self_messages:
          type: boolean
          description: Skip events about the bot's own messages and reactions
          example: false
        events_history_enabled:
          type: boolean
          description: Save the bot's event history for later retrieval via the event history method
          example: false
        single_chat:
          type: boolean
          description: >-
            Restricts the bot to a single group chat. `true` — the bot can be added to one discussion or channel only,
            `false` — to multiple. Personal chats and threads don't count toward this limit
          example: false
        can_edit:
          type: array
          items:
            $ref: '#/components/schemas/BotCanEdit'
          description: >-
            Roles allowed to edit the bot settings in addition to the creator. The creator can always edit. An empty
            array means only the creator can edit.
          example:
            - admin
        who_can_add:
          allOf:
            - $ref: '#/components/schemas/BotWhoCanAdd'
          description: Who can add the bot to chats
          example: creator
        kind:
          allOf:
            - $ref: '#/components/schemas/BotWebhookKind'
          nullable: true
          description: Incoming webhook source. `null` if the bot's incoming webhook is disabled.
          example: simple
        unfurl_domains:
          type: array
          items:
            type: string
          description: Domains whose links the bot unfurls
          example:
            - example.com
        last_request_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Date and time of the last request to the bot's incoming webhook (ISO-8601, UTC+0) in
            YYYY-MM-DDThh:mm:ss.sssZ format. `null` if there have been no requests.
          example: '2025-05-15T14:30:00.000Z'
        url:
          type: string
          nullable: true
          description: >-
            Incoming webhook address. `null` if the bot's incoming webhook is off. Comes only in the [Bot info](GET
            /bots/{id}) method.
          example: https://api.pachca.com/webhooks/01JAXK7R3B5Y8Q2W4E6T9V1N3M
        secret_token:
          type: string
          description: >-
            Signing secret of the outgoing webhook: the `Pachca-Signature` header is signed with it. Comes only in the
            [Bot info](GET /bots/{id}) method.
          example: pachca_wh_3pX9vQ2mL7rT5yW8kN4bH6jF1dS0aZcVxE2uI9oP7qR3tY5wK8nM4gB6hJ1lD0fA
        last_request_body:
          type: string
          nullable: true
          description: >-
            Body of the last request to the bot's incoming webhook. A body longer than 128 KB is cut off and ends with
            `...[truncated]`. `null` if there have been no requests. Comes only in the [Bot info](GET /bots/{id})
            method.
          example: '{"client": "Acme Corp", "amount": 15000}'
      description: Bot webhook parameters
    BotWebhookKind:
      type: string
      enum:
        - simple
        - gitlab
        - grafana
      description: Incoming webhook source of the bot
      x-enum-descriptions:
        simple: 'Custom format: the message is built from the request body with the bot''s template'
        gitlab: 'GitLab: Pachca parses the request and builds the message itself'
        grafana: 'Grafana: Pachca parses the request and builds the message itself'
    BotWebhookSelfUpdateRequest:
      type: object
      required:
        - webhook
      properties:
        webhook:
          type: object
          properties:
            outgoing_url:
              type: string
              description: Outgoing webhook URL. An empty string disables the webhook.
              example: https://example.com/tasks/new
          required:
            - outgoing_url
          description: Webhook parameters object
      description: Bot webhook self-registration request
    BotWhoCanAdd:
      type: string
      enum:
        - creator
        - creator_admin
        - creator_admin_user
        - anyone
      description: Who can add the bot to chats
      x-enum-descriptions:
        creator: Only the bot creator
        creator_admin: The creator and company administrators
        creator_admin_user: The creator, administrators, and company members
        anyone: 'Public bot: any employee except guests and multi-guests can add it'
    Button:
      type: object
      required:
        - text
      properties:
        text:
          type: string
          maxLength: 255
          description: Text displayed on the button
          example: Learn more
        url:
          type: string
          maxLength: 1024
          description: URL that will be opened when the button is clicked. A button must have exactly one of `url` and `data`.
          example: https://example.com/details
        data:
          type: string
          maxLength: 255
          description: >-
            Data that will be sent in the outgoing webhook when the button is clicked. A button must have exactly one of
            `url` and `data`.
          example: awesome
      description: Button
    ButtonRowItem:
      type: array
      items:
        $ref: '#/components/schemas/Button'
      minItems: 1
      maxItems: 8
      description: Button row
    ButtonWebhookPayload:
      type: object
      required:
        - type
        - event
        - message_id
        - trigger_id
        - data
        - user_id
        - chat_id
        - webhook_timestamp
      properties:
        type:
          type: string
          enum:
            - button
          description: Object type
          example: button
          x-enum-descriptions:
            button: Always button for buttons
        event:
          type: string
          enum:
            - click
          description: Event type
          example: click
          x-enum-descriptions:
            click: Button click
        message_id:
          type: integer
          format: int32
          description: ID of the message the button belongs to
          example: 1245817
        trigger_id:
          type: string
          description: Unique event identifier. Lifetime — 3 seconds. Can be used, for example, to open a view for the user.
          example: a1b2c3d4-5e6f-7g8h-9i10-j11k12l13m14
        data:
          type: string
          description: Clicked button data
          example: button_data
        user_id:
          type: integer
          format: int32
          description: ID of the user who clicked the button
          example: 2345
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where the button was clicked
          example: 9012
        webhook_timestamp:
          type: integer
          format: int32
          description: Webhook send date and time (UTC+0) in UNIX format
          example: 1747574400
      description: Outgoing webhook payload for button click
    Chat:
      type: object
      required:
        - id
        - name
        - created_at
        - owner_id
        - member_ids
        - group_tag_ids
        - channel
        - archived
        - personal
        - public
        - last_message_at
        - meet_room_url
        - avatar_url
      properties:
        id:
          type: integer
          format: int32
          description: Created chat ID
          example: 334
        name:
          type: string
          maxLength: 255
          description: Name
          example: 🤿 aqua
        created_at:
          type: string
          format: date-time
          description: Chat creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2021-08-28T15:56:53.000Z'
        owner_id:
          type: integer
          format: int32
          description: ID of the user who created the chat
          example: 185
        member_ids:
          type: array
          items:
            type: integer
            format: int32
          description: Array of member user IDs
          example:
            - 185
            - 186
            - 187
        group_tag_ids:
          type: array
          items:
            type: integer
            format: int32
          description: Array of member tag IDs
          example:
            - 9111
        channel:
          type: boolean
          description: Whether this is a channel
          example: true
        archived:
          type: boolean
          description: Whether the chat is archived
          example: false
        personal:
          type: boolean
          description: Whether this is a direct message
          example: false
        public:
          type: boolean
          description: Whether the chat is publicly accessible
          example: false
        last_message_at:
          type: string
          format: date-time
          description: Date and time of the last message in the chat (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2021-08-28T15:56:53.000Z'
        meet_room_url:
          type: string
          description: Video chat link
          example: https://meet.pachca.com/aqua-94bb21b5
        avatar_url:
          type: string
          nullable: true
          description: Chat avatar link. `null` if no avatar is set.
          example: https://files.example.com/uploads/0001/0001/image.jpg
      description: Chat
    ChatActivity:
      type: string
      enum:
        - active
        - archived
      description: Activity state of the chats in the selection
      x-enum-descriptions:
        active: Active chats only
        archived: Archived chats only
    ChatAvailability:
      type: string
      enum:
        - is_member
        - public
      description: Chat availability for the user
      x-enum-descriptions:
        is_member: Chats where the user is a member
        public: All public chats in the workspace, regardless of user membership
    ChatCreateRequest:
      type: object
      required:
        - chat
      properties:
        chat:
          type: object
          properties:
            name:
              type: string
              maxLength: 255
              description: >-
                Name. An empty name is replaced with the first and last name of the token owner (for a bot, with its
                name), or with the nickname if there are none.
              example: 🤿 aqua
            member_ids:
              type: array
              items:
                type: integer
                format: int32
              description: Array of user IDs who will become members
              example:
                - 186
                - 187
            group_tag_ids:
              type: array
              items:
                type: integer
                format: int32
              description: Array of tag IDs to be added as members
              example:
                - 86
                - 18
            channel:
              type: boolean
              description: Whether this is a channel
              example: true
              default: false
            public:
              type: boolean
              description: Whether the chat is publicly accessible
              example: false
              default: false
          required:
            - name
          description: Chat parameters object to create
      description: Chat creation request
    ChatExport:
      type: object
      required:
        - id
      properties:
        id:
          type: integer
          format: int32
          description: Export ID
          example: 22322
      description: Ordered message export
    ChatMemberRole:
      type: string
      enum:
        - admin
        - editor
        - member
      description: Chat member role
      x-enum-descriptions:
        admin: Admin
        editor: Editor (available for channels only)
        member: Member or subscriber
    ChatMemberRoleFilter:
      type: string
      enum:
        - all
        - owner
        - admin
        - editor
        - member
      description: Chat member role (with all filter)
      x-enum-descriptions:
        all: Any role
        owner: Owner
        admin: Admin
        editor: Editor
        member: Member/subscriber
    ChatMemberWebhookPayload:
      type: object
      required:
        - type
        - event
        - chat_id
        - user_ids
        - created_at
        - webhook_timestamp
      properties:
        type:
          type: string
          enum:
            - chat_member
          description: Object type
          example: chat_member
          x-enum-descriptions:
            chat_member: Always chat_member for chat members
        event:
          allOf:
            - $ref: '#/components/schemas/MemberEventType'
          description: Event type
          example: add
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where membership changed
          example: 9012
        thread_id:
          type: integer
          format: int32
          nullable: true
          description: Thread ID. `null` if the members were added to a regular chat or channel rather than a thread.
          example: 5678
        user_ids:
          type: array
          items:
            type: integer
            format: int32
          description: Array of user IDs affected by the event
          example:
            - 2345
            - 6789
        created_at:
          type: string
          format: date-time
          description: >-
            Event date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ssZ format. In this webhook the time comes without
            fractions of a second, unlike in the rest.
          example: '2025-05-15T14:30:00Z'
        webhook_timestamp:
          type: integer
          format: int32
          description: Webhook send date and time (UTC+0) in UNIX format
          example: 1747574400
      description: Outgoing webhook payload for chat members
    ChatSortField:
      type: string
      enum:
        - id
        - last_message_at
      description: Chat sort field
      x-enum-descriptions:
        id: By chat ID
        last_message_at: By last message date and time
    ChatSubtype:
      type: string
      enum:
        - discussion
        - thread
      description: Chat type
      x-enum-descriptions:
        discussion: Channel or conversation
        thread: Thread
    ChatUpdateRequest:
      type: object
      required:
        - chat
      properties:
        chat:
          type: object
          properties:
            name:
              type: string
              maxLength: 255
              description: Name
              example: Pool
            public:
              type: boolean
              description: Whether the chat is publicly accessible
              example: true
          description: Chat parameters object to update
      description: Chat update request
    CompanyBotResponse:
      type: object
      required:
        - id
        - oauth_client
        - webhook
      properties:
        id:
          type: integer
          format: int32
          description: Bot ID (same as the bot's `user_id`)
          example: 1738816
        oauth_client:
          type: object
          allOf:
            - $ref: '#/components/schemas/BotOAuthClient'
          nullable: true
          description: >-
            Authorization on behalf of an employee. `null` for a bot you cannot edit. It can also come for a bot with
            authorization disabled, and a bot without tokens may get `null`.
        webhook:
          allOf:
            - $ref: '#/components/schemas/CompanyBotWebhook'
          description: Webhook parameters object
      description: Workspace bot parameters
    CompanyBotWebhook:
      type: object
      required:
        - name
        - nickname
        - outgoing_url
        - events
        - trigger_on
        - commands
        - scopes
        - template
        - template_engine
        - challenge_key
        - link_preview_enabled
        - ignore_self_messages
        - events_history_enabled
        - single_chat
        - can_edit
        - who_can_add
      properties:
        name:
          type: string
          maxLength: 255
          description: Bot name
          example: Tasks bot
        nickname:
          type: string
          maxLength: 255
          description: Bot nickname
          example: tasks_bot
        outgoing_url:
          type: string
          nullable: true
          description: Outgoing webhook URL. `null` if the bot has no outgoing webhook configured.
          example: https://example.com/tasks/new
        events:
          type: array
          items:
            $ref: '#/components/schemas/BotEventName'
          nullable: true
          description: Events the bot is subscribed to
          example:
            - message_new
        trigger_on:
          allOf:
            - $ref: '#/components/schemas/BotTriggerOn'
          nullable: true
          description: Outgoing webhook trigger condition
          example: commands
        commands:
          type: array
          items:
            type: string
          nullable: true
          description: Bot commands (trigger words)
          example:
            - /task
        scopes:
          type: array
          items:
            type: string
          nullable: true
          description: Bot token scopes (permissions)
          example:
            - messages:create
        template:
          type: string
          nullable: true
          description: Template for formatting the incoming webhook. `null` if not set.
          example: Order from {{ client }} for {{ amount }} ₽
        template_engine:
          allOf:
            - $ref: '#/components/schemas/BotTemplateEngine'
          nullable: true
          description: Template engine used to process the incoming webhook template
          example: liquid
        challenge_key:
          type: string
          nullable: true
          description: Verification field name for incoming webhook verification. `null` if not set.
          example: challenge
        link_preview_enabled:
          type: boolean
          nullable: true
          description: Show link previews in incoming webhook messages
          example: true
        ignore_self_messages:
          type: boolean
          nullable: true
          description: Skip events about the bot's own messages and reactions
          example: false
        events_history_enabled:
          type: boolean
          nullable: true
          description: Save the bot's event history for later retrieval via the event history method
          example: false
        single_chat:
          type: boolean
          nullable: true
          description: >-
            Restricts the bot to a single group chat. `true` — the bot can be added to one discussion or channel only,
            `false` — to multiple. Personal chats and threads don't count toward this limit
          example: false
        can_edit:
          type: array
          items:
            $ref: '#/components/schemas/BotCanEdit'
          nullable: true
          description: >-
            Roles allowed to edit the bot settings in addition to the creator. The creator can always edit. An empty
            array means only the creator can edit.
          example:
            - admin
        who_can_add:
          allOf:
            - $ref: '#/components/schemas/BotWhoCanAdd'
          nullable: true
          description: Who can add the bot to chats
          example: creator
      description: >-
        Webhook parameters of a workspace bot. Settings of a bot you cannot edit come back as `null` — only the name and
        the nickname remain.
    CompanyMemberWebhookPayload:
      type: object
      required:
        - type
        - event
        - user_ids
        - created_at
        - webhook_timestamp
      properties:
        type:
          type: string
          enum:
            - company_member
          description: Object type
          example: company_member
          x-enum-descriptions:
            company_member: Always company_member for workspace members
        event:
          allOf:
            - $ref: '#/components/schemas/UserEventType'
          description: Event type
          example: invite
        user_ids:
          type: array
          items:
            type: integer
            format: int32
          description: Array of user IDs affected by the event
          example:
            - 2345
            - 6789
        created_at:
          type: string
          format: date-time
          description: >-
            Event date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ssZ format. In this webhook the time comes without
            fractions of a second, unlike in the rest.
          example: '2025-05-15T14:30:00Z'
        webhook_timestamp:
          type: integer
          format: int32
          description: Webhook send date and time (UTC+0) in UNIX format
          example: 1747574400
      description: Outgoing webhook payload for workspace members
    CustomProperty:
      type: object
      required:
        - id
        - name
        - data_type
        - value
      properties:
        id:
          type: integer
          format: int32
          description: Property ID
          example: 1678
        name:
          type: string
          maxLength: 32
          description: Property name
          example: City
        data_type:
          allOf:
            - $ref: '#/components/schemas/CustomPropertyDataType'
          description: Property type
          example: string
        value:
          type: string
          nullable: true
          maxLength: 768
          description: >-
            Value. Returns `null` if the property is not filled in. A number is returned as a string, a date in ISO 8601
            format.
          example: Saint Petersburg
      description: Custom property
    CustomPropertyDataType:
      type: string
      enum:
        - string
        - number
        - date
        - link
      description: Custom property data type
      x-enum-descriptions:
        string: String value
        number: Number value
        date: Date
        link: Link
    CustomPropertyDefinition:
      type: object
      required:
        - id
        - name
        - data_type
      properties:
        id:
          type: integer
          format: int32
          description: Property ID
          example: 1678
        name:
          type: string
          maxLength: 32
          description: Property name
          example: City
        data_type:
          allOf:
            - $ref: '#/components/schemas/CustomPropertyDataType'
          description: Property type
          example: string
      description: Custom property
    Draft:
      type: object
      required:
        - id
        - entity_type
        - entity_id
        - chat_id
        - content
        - parent_message_id
        - files
        - voice_content
        - schedule
        - next_send_at
        - created_at
        - updated_at
      properties:
        id:
          type: integer
          format: int32
          description: Draft ID
          example: 4821
        entity_type:
          allOf:
            - $ref: '#/components/schemas/MessageEntityType'
          nullable: true
          description: >-
            Where the message will go: to a conversation or a channel, to a thread, or to a direct message with an
            employee
          example: discussion
        entity_id:
          type: integer
          format: int32
          nullable: true
          description: 'ID of what is named in `entity_type`: the conversation or channel, the thread, or the employee'
          example: 334
        chat_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the chat the draft lies in. For a thread draft this is the chat of the thread itself.
          example: 334
        content:
          type: string
          description: Draft text. A draft made of attachments alone comes with an empty string rather than `null`.
          example: 'Weekly report: sales are up 10%'
        parent_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the message the draft will be sent as a reply to. `null` if it is not a reply.
          example: 196093
        files:
          type: array
          items:
            $ref: '#/components/schemas/File'
          description: Attached files
        voice_content:
          type: object
          allOf:
            - $ref: '#/components/schemas/VoiceContent'
          nullable: true
          description: >-
            Voice message. `null` if there is no voice attachment. The transcription in `transcript` is always `null`
            for a draft — it starts after the sending.
        schedule:
          type: object
          allOf:
            - $ref: '#/components/schemas/DraftSchedule'
          nullable: true
          description: Sending schedule. `null` for an ordinary draft.
        next_send_at:
          type: string
          format: date-time
          nullable: true
          description: Next sending (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format. `null` for an ordinary draft.
          example: '2026-09-17T12:00:00.000Z'
        created_at:
          type: string
          format: date-time
          description: Creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2026-09-16T10:00:00.000Z'
        updated_at:
          type: string
          format: date-time
          description: Last change date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2026-09-16T10:00:00.000Z'
      description: Draft or scheduled message
    DraftCreateRequest:
      type: object
      required:
        - draft
      properties:
        draft:
          type: object
          properties:
            entity_type:
              allOf:
                - $ref: '#/components/schemas/MessageEntityType'
              description: >-
                Where the draft is written: to a conversation or a channel, to a thread, or to a direct message with an
                employee
              example: discussion
            entity_id:
              type: integer
              format: int32
              description: 'ID of what is named in `entity_type`: the conversation or channel, the thread, or the employee'
              example: 334
            content:
              type: string
              description: >-
                Draft text. It may be omitted if there are attachments, but a draft cannot be empty. Up to 40,000 bytes
                in UTF-8, and for a scheduled message in a workspace with advanced encryption — up to 27,000.
              example: 'Weekly report: sales are up 10%'
            parent_message_id:
              type: integer
              format: int32
              nullable: true
              description: ID of the message the draft will be sent as a reply to. The message must be in the same chat.
              example: 196093
            files:
              type: array
              items:
                $ref: '#/components/schemas/DraftFileRequest'
              maxItems: 10
              description: Files to attach, no more than ten
            schedule:
              type: object
              allOf:
                - $ref: '#/components/schemas/DraftScheduleRequest'
              nullable: true
              description: Sending schedule. With it a scheduled message is created, without it an ordinary draft.
          required:
            - entity_type
            - entity_id
          description: Draft parameters object
      description: Draft creation request
    DraftFileRequest:
      type: object
      required:
        - key
        - name
      properties:
        id:
          type: integer
          format: int32
          description: >-
            ID of a file that is already attached. It is passed when editing, to keep the attachment as it is. For a new
            file it is not specified.
          example: 3560
        key:
          type: string
          maxLength: 1000
          description: File path obtained from the [Upload file](POST /direct_url) method
          example: attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/logo.png
        name:
          type: string
          maxLength: 255
          description: File name to display to the user
          example: logo.png
        file_type:
          allOf:
            - $ref: '#/components/schemas/FileType'
          description: File type
          example: image
        size:
          type: integer
          format: int64
          description: File size in bytes, displayed to the user
          example: 12345
        width:
          type: integer
          format: int32
          description: Image width in pixels
          example: 800
        height:
          type: integer
          format: int32
          description: Image height in pixels
          example: 600
        duration_ms:
          type: integer
          format: int32
          description: >-
            Duration in milliseconds. Required for a voice message (`file_type` is `voice`). A voice message longer than
            30 minutes (1,800,000 ms) is rejected with `422`.
          example: 5400
        waveform:
          type: string
          maxLength: 256
          description: Waveform for visualization. Required for a voice message (`file_type` is `voice`).
          example: 4,8,12,20,16,10,6,3
      description: File attached to a draft
    DraftRepetition:
      type: object
      required:
        - interval
      properties:
        interval:
          allOf:
            - $ref: '#/components/schemas/DraftRepetitionInterval'
          description: Repetition interval
          example: weekly
        days:
          type: array
          items:
            type: integer
            format: int32
          description: 'Days of the week the message goes out on: 0 — Sunday, 6 — Saturday. Comes only with the `weekly` interval.'
          example:
            - 1
            - 3
        nth_day:
          type: integer
          format: int32
          nullable: true
          description: >-
            Which occurrence of the weekday in the month: 1 to 4 — the first, the second, the third, the fourth, 5 — the
            last. Comes only with a monthly interval, and `null` there means repetition by the day of the month from
            `start_date`.
          example: 2
      description: Repetition rule of a scheduled message
    DraftRepetitionInterval:
      type: string
      enum:
        - once
        - daily
        - weekly
        - monthly
        - every_2_months
        - every_3_months
        - every_4_months
        - every_6_months
        - yearly
      description: Repetition interval of a scheduled message
      x-enum-descriptions:
        once: Once
        daily: Every day
        weekly: Every week
        monthly: Every month
        every_2_months: Every two months
        every_3_months: Every three months
        every_4_months: Every four months
        every_6_months: Every six months
        yearly: Every year
    DraftRepetitionRequest:
      type: object
      required:
        - interval
      properties:
        interval:
          allOf:
            - $ref: '#/components/schemas/DraftRepetitionInterval'
          description: Repetition interval
          example: weekly
        days:
          type: array
          items:
            $ref: '#/components/schemas/Weekday'
          maxItems: 7
          description: >-
            Days of the week the message goes out on: 0 — Sunday, 6 — Saturday, without repeats. Taken into account only
            with the `weekly` interval; if not passed, the day of the week is taken from `start_date`.
          example:
            - 1
            - 3
        nth_day:
          type: integer
          format: int32
          nullable: true
          minimum: 1
          maximum: 5
          description: >-
            Which occurrence of the weekday in the month: 1 to 4 — the first, the second, the third, the fourth, 5 — the
            last. Taken into account only with a monthly interval; without it the repetition goes by the day of the
            month from `start_date`.
          example: 2
      description: Repetition rule in the request
    DraftSchedule:
      type: object
      required:
        - start_date
        - end_date
        - repetition
      properties:
        start_date:
          type: string
          format: date-time
          description: >-
            First sending (ISO-8601). The time of day, the day of the month, and the day of the week on which the
            repetition is built further are taken from it.
          example: '2026-09-17T12:00:00.000Z'
        end_date:
          type: string
          format: date-time
          nullable: true
          description: Date after which the repetition stops (ISO-8601). `null` if no end is set.
          example: '2026-12-31T12:00:00.000Z'
        repetition:
          allOf:
            - $ref: '#/components/schemas/DraftRepetition'
          description: Repetition rule
      description: Sending schedule of a scheduled message
    DraftScheduleRequest:
      type: object
      required:
        - start_date
        - repetition
      properties:
        start_date:
          type: string
          format: date-time
          description: >-
            First sending (ISO-8601). The time of day, the day of the month, and the day of the week on which the
            repetition is built further are taken from it. An offset such as `+03:00` is taken into account, and a time
            without an offset is treated as UTC.
          example: '2026-09-17T12:00:00.000Z'
        end_date:
          type: string
          format: date-time
          nullable: true
          description: Date after which the repetition stops (ISO-8601). Without it the repetition goes on indefinitely.
          example: '2026-12-31T12:00:00.000Z'
        repetition:
          allOf:
            - $ref: '#/components/schemas/DraftRepetitionRequest'
          description: Repetition rule
      description: Sending schedule in the request
    DraftType:
      type: string
      enum:
        - regular
        - scheduled
        - all
      description: What to return in the list of drafts
      x-enum-descriptions:
        regular: Ordinary drafts
        scheduled: Scheduled messages
        all: Both drafts and scheduled messages
    DraftUpdateRequest:
      type: object
      required:
        - draft
      properties:
        draft:
          type: object
          properties:
            content:
              type: string
              description: >-
                Draft text. Up to 40,000 bytes in UTF-8, and for a scheduled message in a workspace with advanced
                encryption — up to 27,000.
              example: 'Weekly report: sales are up 10%'
            parent_message_id:
              type: integer
              format: int32
              nullable: true
              description: ID of the message the draft will be sent as a reply to. `null` removes the reply.
              example: 196093
            files:
              type: array
              items:
                $ref: '#/components/schemas/DraftFileRequest'
              maxItems: 10
              description: >-
                Files to attach, no more than ten. The array you pass replaces the previous set: an empty one removes
                all the attachments, and to keep a file that is already attached, pass it with its `id`. Without this
                field the attachments stay as they were.
              x-replaces-set: true
            schedule:
              type: object
              allOf:
                - $ref: '#/components/schemas/DraftScheduleRequest'
              nullable: true
              description: >-
                Sending schedule. For an ordinary draft it turns the draft into a scheduled message. For a scheduled
                message the schedule can be changed but not removed: `null` gives `422` with the
                `draft_type_change_forbidden` code in response.
          description: Object of the draft parameters being changed
      description: Draft update request
    ExportRequest:
      type: object
      required:
        - start_at
        - end_at
      properties:
        start_at:
          type: string
          format: date
          description: >-
            Export start date in YYYY-MM-DD format. If a date with a time is sent, the time is silently dropped — the
            export always goes by calendar days.
          example: '2025-03-20'
        end_at:
          type: string
          format: date
          description: >-
            Export end date in YYYY-MM-DD format, inclusive. If a date with a time is sent, the time is silently
            dropped.
          example: '2025-03-20'
        webhook_url:
          type: string
          description: >-
            Address that the webhook with the number of the finished export arrives at once the archive is assembled.
            The number comes in the `export_id` field, and the whole webhook body is described in the
            [Export](/guides/export) section.
          example: https://example.com/webhooks/export
        chat_ids:
          type: array
          items:
            type: integer
            format: int32
          maxItems: 50
          description: Array of chat IDs. Specify to export messages from specific chats only.
          example:
            - 1381521
        skip_chats_file:
          type: boolean
          description: Skip generating the chat list file (chats.json)
          example: false
          default: false
      description: Message export request
    ExportWebhookPayload:
      type: object
      required:
        - type
        - event
        - export_id
        - created_at
      properties:
        type:
          type: string
          enum:
            - export
          description: Object type
          example: export
          x-enum-descriptions:
            export: Always export for an export
        event:
          type: string
          enum:
            - ready
          description: Event type
          example: ready
          x-enum-descriptions:
            ready: The archive is assembled
        export_id:
          type: integer
          format: int32
          description: 'Export ID: the [Download export archive](GET /chats/exports/{id}) method serves the archive by it'
          example: 22322
        created_at:
          type: string
          format: date-time
          description: Date and time the export was ordered (ISO-8601)
          example: '2025-03-20T12:33:58Z'
      description: 'Webhook about a finished export: it arrives at the address from `webhook_url` once the archive is assembled'
    File:
      type: object
      required:
        - id
        - key
        - name
        - file_type
        - url
      properties:
        id:
          type: integer
          format: int32
          description: File ID
          example: 3560
        key:
          type: string
          description: File path
          example: attaches/files/12/21zu7934-02e1-44d9-8df2-0f970c259796/congrat.png
        name:
          type: string
          description: File name with extension
          example: congrat.png
        file_type:
          allOf:
            - $ref: '#/components/schemas/FileType'
          description: File type
          example: image
        url:
          type: string
          description: >-
            File download link. Usually it leads straight to the storage and is valid for up to 7 days, and the
            remaining time may be shorter — if such a link returns `403`, fetch the message again to get a fresh one. If
            the workspace has encryption enabled or a secure perimeter set, the link leads to [Download file](GET
            /files/{id}): such a file has to be fetched with an `Authorization` header, and the token needs the
            `files:read` scope.
          example: >-
            https://files.example.com/attaches/files/12/21zu7934-02e1-44d9-8df2-0f970c259796/congrat.png?X-Amz-Expires=604800&X-Amz-Signature=98765asgfadsfdSaDSd4sdfg35asdf67sadf8
        width:
          type: integer
          format: int32
          nullable: true
          description: >-
            Image width in pixels. `null` for files that are not images, and if the size was not supplied at upload
            time.
          example: 1920
        height:
          type: integer
          format: int32
          nullable: true
          description: >-
            Image height in pixels. `null` for files that are not images, and if the size was not supplied at upload
            time.
          example: 1080
        duration_ms:
          type: integer
          format: int32
          nullable: true
          description: >-
            Duration in milliseconds for a voice, an audio, and a video file. `null` for the other files and if the
            duration was not supplied at upload time.
          example: 5400
      description: File
    FileTarget:
      type: string
      enum:
        - pdf_preview
        - pdf_first_page
        - thumb
        - image
      description: What to return instead of the original file
      x-enum-descriptions:
        pdf_preview: The document converted to PDF
        pdf_first_page: The first page of the document as an image
        thumb: A scaled-down copy of the image
        image: The image as it is
    FileType:
      type: string
      enum:
        - file
        - image
        - audio
        - voice
        - video
      description: File type
      x-enum-descriptions:
        file: Regular file
        image: Image
        audio: Audio file
        voice: Voice message
        video: Video file
    FileUploadRequest:
      type: object
      properties:
        Content-Disposition:
          type: string
          description: >-
            Content-Disposition parameter received in the response to [Get signature, key and other parameters](POST
            /uploads)
        acl:
          type: string
          description: >-
            acl parameter received in the response to [Get signature, key and other parameters](POST /uploads). Sent
            when the response has it.
        policy:
          type: string
          description: policy parameter received in the response to [Get signature, key and other parameters](POST /uploads)
        x-amz-credential:
          type: string
          description: >-
            x-amz-credential parameter received in the response to [Get signature, key and other parameters](POST
            /uploads)
        x-amz-algorithm:
          type: string
          description: >-
            x-amz-algorithm parameter received in the response to [Get signature, key and other parameters](POST
            /uploads)
        x-amz-date:
          type: string
          description: x-amz-date parameter received in the response to [Get signature, key and other parameters](POST /uploads)
        x-amz-signature:
          type: string
          description: >-
            x-amz-signature parameter received in the response to [Get signature, key and other parameters](POST
            /uploads)
        key:
          type: string
          description: key parameter received in the response to [Get signature, key and other parameters](POST /uploads)
        bucket:
          type: string
          description: >-
            bucket parameter received in the response to [Get signature, key and other parameters](POST /uploads). Sent
            when the response has it.
        file:
          type: string
          format: binary
          description: File to upload
      required:
        - Content-Disposition
        - policy
        - x-amz-credential
        - x-amz-algorithm
        - x-amz-date
        - x-amz-signature
        - key
        - file
    Forwarding:
      type: object
      required:
        - original_message_id
        - original_chat_id
        - author_id
        - original_created_at
        - original_thread_id
        - original_thread_message_id
        - original_thread_parent_chat_id
      properties:
        original_message_id:
          type: integer
          format: int32
          description: Original message ID
          example: 194275
        original_chat_id:
          type: integer
          format: int32
          description: ID of the chat containing the original message
          example: 334
        author_id:
          type: integer
          format: int32
          description: ID of the user who created the original message
          example: 12
        original_created_at:
          type: string
          format: date-time
          description: Original message creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-01-15T10:30:00.000Z'
        original_thread_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the thread containing the original message
          example: null
        original_thread_message_id:
          type: integer
          format: int32
          nullable: true
          description: >-
            ID of the message that the thread containing the original message was created for. `null` if the original
            message was not in a thread, or the thread was created without being linked to a message.
          example: null
        original_thread_parent_chat_id:
          type: integer
          format: int32
          nullable: true
          description: >-
            ID of the chat of the message that the thread containing the original message was created for. `null` if the
            original message was not in a thread, or the thread was created without being linked to a message.
          example: null
      description: Forwarded message information
    GroupTag:
      type: object
      required:
        - id
        - name
        - users_count
      properties:
        id:
          type: integer
          format: int32
          description: Tag ID
          example: 9111
        name:
          type: string
          maxLength: 255
          description: Tag name
          example: Design
        users_count:
          type: integer
          format: int32
          description: Number of employees who have this tag
          example: 6
      description: Group tag
    GroupTagRequest:
      type: object
      required:
        - group_tag
      properties:
        group_tag:
          type: object
          properties:
            name:
              type: string
              maxLength: 255
              description: Tag name
              example: New tag name
          required:
            - name
      description: Request to create or update a tag
    InviteStatus:
      type: string
      enum:
        - confirmed
        - sent
      description: User invitation status
      x-enum-descriptions:
        confirmed: Confirmed
        sent: Sent
    LinkPreview:
      type: object
      required:
        - title
        - description
      properties:
        title:
          type: string
          description: Title
          example: 'Article: Sending files'
        description:
          type: string
          description: Description
          example: Example of sending files to a remote server
        image_url:
          type: string
          description: Public image URL (if you want to upload an image file to Pachca, use the image parameter)
          example: https://example.com/img/landing.png
        image:
          type: object
          properties:
            key:
              type: string
              description: Image path obtained from the [Upload file](POST /direct_url) method
              example: attaches/files/93746/e354fd79-9jh6-f2hd-fj83-709dae24c763/${filename}
            name:
              type: string
              description: Image name (recommended to include the file extension)
              example: files-to-server.jpg
            size:
              type: integer
              format: int32
              description: Image size in bytes
              example: 695604
          required:
            - key
            - name
          description: Image
      description: Link preview data
    LinkPreviewsRequest:
      type: object
      required:
        - link_previews
      properties:
        link_previews:
          type: object
          additionalProperties:
            $ref: '#/components/schemas/LinkPreview'
          description: '`JSON` map of link previews, where each key is a `URL` received in the outgoing webhook about a new message'
          x-record-key-example: https://example.com/articles/123
      description: Link unfurling request
    LinkSharedWebhookPayload:
      type: object
      required:
        - type
        - event
        - chat_id
        - message_id
        - links
        - user_id
        - entity_type
        - entity_id
        - thread
        - created_at
        - webhook_timestamp
      properties:
        type:
          type: string
          enum:
            - message
          description: Object type
          example: message
          x-enum-descriptions:
            message: Always message for link unfurling
        event:
          type: string
          enum:
            - link_shared
          description: Event type
          example: link_shared
          x-enum-descriptions:
            link_shared: Link to a monitored domain detected
        chat_id:
          type: integer
          format: int32
          description: ID of the chat where the link was found
          example: 23438
        message_id:
          type: integer
          format: int32
          description: ID of the message containing the link
          example: 268092
        links:
          type: array
          items:
            $ref: '#/components/schemas/WebhookLink'
          description: Array of detected links to monitored domains
        user_id:
          type: integer
          format: int32
          description: Message sender ID
          example: 2345
        entity_type:
          allOf:
            - $ref: '#/components/schemas/MessageEntityType'
          description: Type of the entity the message with the link belongs to
          example: discussion
        entity_id:
          type: integer
          format: int32
          nullable: true
          description: >-
            Entity ID: the conversation or channel, or the thread. `null` in a direct chat: the bot does not take part
            in it, and the other participant is not disclosed to it.
          example: 23438
        thread:
          type: object
          allOf:
            - $ref: '#/components/schemas/WebhookMessageThread'
          nullable: true
          description: Thread the message with the link was sent in. `null` if the message was not sent in a thread.
        created_at:
          type: string
          format: date-time
          description: Message creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2024-09-18T19:53:14.000Z'
        webhook_timestamp:
          type: integer
          format: int32
          description: Webhook send date and time (UTC+0) in UNIX format
          example: 1726685594
      description: Outgoing webhook payload for link unfurling
    MarkChatUnreadRequest:
      type: object
      properties:
        message_id:
          type: integer
          format: int32
          minimum: 1
          description: >-
            ID of the message from which the chat becomes unread: this message and all messages after it. If omitted,
            the last message becomes unread.
          example: 1194275
      description: Request to mark a chat as unread
    MemberEventType:
      type: string
      enum:
        - add
        - remove
      description: Webhook event type for members
      x-enum-descriptions:
        add: Addition
        remove: Deleted
    Message:
      type: object
      required:
        - id
        - entity_type
        - entity_id
        - chat_id
        - root_chat_id
        - content
        - user_id
        - created_at
        - url
        - files
        - voice_content
        - buttons
        - thread
        - forwarding
        - parent_message_id
        - changed_at
        - deleted_at
      properties:
        id:
          type: integer
          format: int32
          description: Message ID
          example: 194275
        entity_type:
          allOf:
            - $ref: '#/components/schemas/MessageEntityType'
          description: Entity type the message belongs to
          example: discussion
        entity_id:
          type: integer
          format: int32
          description: ID of the entity the message belongs to (chat/channel, thread, or user)
          example: 334
        chat_id:
          type: integer
          format: int32
          description: ID of the chat containing the message
          example: 334
        root_chat_id:
          type: integer
          format: int32
          description: >-
            Root chat ID. For messages in threads — the ID of the chat where the thread was created. For regular
            messages, equals `chat_id`.
          example: 334
        content:
          type: string
          description: Message text
          example: Yesterday we sold 756 t-shirts (10% more than last Sunday)
        user_id:
          type: integer
          format: int32
          description: ID of the user who created the message
          example: 12
        created_at:
          type: string
          format: date-time
          description: Message creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2021-08-28T15:57:23.000Z'
        url:
          type: string
          description: Direct link to the message
          example: https://app.pachca.com/chats/334?message=194275
        files:
          type: array
          items:
            $ref: '#/components/schemas/File'
          description: Attached files
        voice_content:
          type: object
          allOf:
            - $ref: '#/components/schemas/VoiceContent'
          nullable: true
          description: Voice message data. Filled only for voice messages (file `file_type` is `voice`), otherwise `null`.
        buttons:
          type: array
          items:
            type: array
            items:
              $ref: '#/components/schemas/Button'
          nullable: true
          description: Array of rows, each represented as an array of buttons. `null` if the message was sent without buttons.
        thread:
          type: object
          properties:
            id:
              type: integer
              format: int64
              description: >-
                Thread ID. To write to the thread, pass it in `entity_id` of the [New message](POST /messages) method
                with `entity_type: "thread"`.
              example: 265142
            chat_id:
              type: integer
              format: int64
              description: >-
                Thread chat ID. It is used to read the thread's messages with the [List chat messages](GET /messages)
                method.
              example: 2637266155
          required:
            - id
            - chat_id
          nullable: true
          description: >-
            Thread created for this message. `null` if no thread was created, and for messages that are themselves
            inside a thread.
        forwarding:
          type: object
          allOf:
            - $ref: '#/components/schemas/Forwarding'
          nullable: true
          description: Forwarded message information. `null` if the message is not a forwarded one.
        parent_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the message being replied to. `null` if the message is not a reply to another message.
          example: null
        display_avatar_url:
          type: string
          nullable: true
          description: >-
            Message sender avatar URL. The field is present only on messages from bots; it is absent from the response
            for messages from employees. `null` if the bot did not override the value when sending.
          example: null
        display_name:
          type: string
          nullable: true
          description: >-
            Message sender full name. The field is present only on messages from bots; it is absent from the response
            for messages from employees. `null` if the bot did not override the value when sending.
          example: null
        changed_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Message last change date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format. For a message that
            was never edited it equals the creation date. `null` for messages sent before this field was introduced.
          example: '2021-08-28T16:10:00.000Z'
        deleted_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Message deletion date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format. `null` for messages
            that are not deleted. Deleted messages are not returned in the message list.
          example: null
      description: Message
    MessageCreateRequest:
      type: object
      required:
        - message
      properties:
        message:
          type: object
          properties:
            entity_type:
              allOf:
                - $ref: '#/components/schemas/MessageEntityType'
              description: >-
                Entity type. The value is case-insensitive. A value outside the list returns `400` with the `invalid`
                code.
              example: discussion
              default: discussion
            entity_id:
              type: integer
              format: int32
              description: >-
                Identifier of whatever is named in `entity_type`: a conversation or channel, a thread, or a user. A
                thread has two: its `id` goes with `entity_type: "thread"`, and its `chat_id` with `discussion`, like
                any chat.
              example: 334
            content:
              type: string
              description: >-
                Message text. Required if no files are attached to the message. Supports mentions: `@nickname` or
                `<@user_id>` (automatically converted to `@nickname`). `@all` mentions all members of the chat, `@here`
                those who are currently online, and `@` with a tag name without spaces the employees of that tag. A name
                without `@`, and a mention inside inline code or a code block, are not mentions. For a multi-guest,
                `<@user_id>` of an employee not accessible to them stays in the text as is. Up to 40,000 bytes in UTF-8,
                which is about 20,000 Cyrillic characters. In a workspace with advanced encryption — up to 27,000 bytes.
                The message goes out under the token owner's name, and a bot's with the Bot badge.
              example: Yesterday we sold 756 t-shirts (10% more than last Sunday)
            files:
              type: array
              items:
                type: object
                properties:
                  key:
                    type: string
                    maxLength: 1000
                    description: File path obtained from the [Upload file](POST /direct_url) method
                    example: attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/logo.png
                  name:
                    type: string
                    maxLength: 255
                    description: >-
                      File name to display to the user. The extension must match the extension of the file in `key`,
                      otherwise the response is 422 with the `wrong_params` code.
                    example: logo.png
                  file_type:
                    allOf:
                      - $ref: '#/components/schemas/FileType'
                    description: File type
                    example: image
                  size:
                    type: integer
                    format: int64
                    description: File size in bytes, displayed to the user
                    example: 12345
                  width:
                    type: integer
                    format: int32
                    description: Image width in px (used when file_type is set to image)
                    example: 800
                  height:
                    type: integer
                    format: int32
                    description: Image height in px (used when file_type is set to image)
                    example: 600
                  duration_ms:
                    type: integer
                    format: int32
                    minimum: 1
                    description: >-
                      Duration in milliseconds. Required for voice messages (`file_type` is `voice`), not used for other
                      types. A voice message longer than 30 minutes (1,800,000 ms) is rejected with `422`.
                    example: 5400
                  waveform:
                    type: string
                    maxLength: 256
                    description: >-
                      Waveform for visualizing the voice message. Required for voice messages (`file_type` is `voice`),
                      not used for other types.
                    example: 4,8,12,20,16,10,6,3
                required:
                  - key
                  - name
                  - file_type
              maxItems: 10
              description: Files to attach
            buttons:
              type: array
              items:
                $ref: '#/components/schemas/ButtonRowItem'
              maxItems: 32
              description: >-
                Array of rows, each represented as an array of buttons. Maximum 100 buttons per message, up to 8 buttons
                per row. Buttons are shown under the text and work only on messages sent with a bot token: a click on a
                button with `data` arrives as a `button_click` event to that same bot, carrying a `trigger_id` — there
                are 3 seconds to open a form with it, the [Open view](POST /views/open) method. A button with `url`
                simply follows the link and creates no event. Details are in the [Buttons](/guides/buttons) section.
              example:
                - - text: Learn more
                    url: https://example.com/details
                  - text: Great!
                    data: awesome
            parent_message_id:
              type: integer
              format: int32
              description: >-
                ID of the message you are replying to with a quote. You can reply to a message in any chat, including a
                thread: send the reply to the same chat or thread where that message is, otherwise the request returns a
                `422` error. To write into the thread under a message, set `entity_type: "thread"` and the thread's `id`
                in `entity_id`.
              example: 194270
            display_avatar_url:
              type: string
              maxLength: 255
              description: Custom sender avatar URL for this message. This field can only be used with a bot access_token.
              example: https://example.com/avatar.png
            display_name:
              type: string
              maxLength: 255
              description: >-
                Custom sender display name for this message. Together with `display_avatar_url` a bot signs the message
                with someone else's name and avatar, and only this message. The Bot badge stays, and the sender's
                profile still shows the real bot. This is how the original author is shown when messages are carried
                over from another system. With a personal token the field is not available and the response is `403`.
                Details are in the [Bots](/guides/bots/overview) section.
              example: Support Bot
            skip_invite_mentions:
              type: boolean
              description: >-
                Skip adding mentioned employees to the thread. In a thread a mention also works as an invitation: a
                mentioned employee who is not in the thread is added to it by Pachca and gains access to the thread and
                its parent message. In a conversation or a channel a mention adds nobody, and the parameter changes
                nothing there.
              example: false
              default: false
          required:
            - entity_id
          description: Message parameters object to create
        link_preview:
          type: boolean
          description: Display a preview of the first link found in the message text
          example: false
          default: false
      description: Message creation request
    MessageEntityType:
      type: string
      enum:
        - discussion
        - thread
        - user
      description: Entity type for messages
      x-enum-descriptions:
        discussion: Conversation or channel
        thread: Thread
        user: User
    MessageSearchSort:
      type: string
      enum:
        - created_at
        - relevance
      description: Message search results sort order
      x-enum-descriptions:
        created_at: By creation date (chronological)
        relevance: By relevance
    MessageSortField:
      type: string
      enum:
        - id
      description: Message sort field
      x-enum-descriptions:
        id: By message ID
    MessageUpdateRequest:
      type: object
      required:
        - message
      properties:
        message:
          type: object
          properties:
            content:
              type: string
              description: >-
                Message text. Supports mentions: `@nickname` or `<@user_id>` (automatically converted to `@nickname`).
                For a multi-guest, `<@user_id>` of an employee not accessible to them stays in the text as is. Up to
                40,000 bytes in UTF-8, which is about 20,000 Cyrillic characters. In a workspace with advanced
                encryption — up to 27,000 bytes.
              example: >-
                Try to spell these correctly on the first attempt: bureaucracy, accommodate, definitely, entrepreneur,
                liaison, necessary, surveillance, questionnaire.
            files:
              type: array
              items:
                type: object
                properties:
                  key:
                    type: string
                    maxLength: 1000
                    description: File path obtained from the [Upload file](POST /direct_url) method
                    example: attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/logo.png
                  name:
                    type: string
                    maxLength: 255
                    description: >-
                      File name to display to the user. The extension must match the extension of the file in `key`,
                      otherwise the response is 422 with the `wrong_params` code.
                    example: logo.png
                  file_type:
                    allOf:
                      - $ref: '#/components/schemas/FileType'
                    description: File type
                    example: image
                  size:
                    type: integer
                    format: int64
                    description: File size in bytes, displayed to the user
                    example: 12345
                  width:
                    type: integer
                    format: int32
                    description: Image width in px (used when file_type is set to image)
                    example: 800
                  height:
                    type: integer
                    format: int32
                    description: Image height in px (used when file_type is set to image)
                    example: 600
                  duration_ms:
                    type: integer
                    format: int32
                    minimum: 1
                    description: >-
                      Duration in milliseconds. Required for voice messages (`file_type` is `voice`), not used for other
                      types. A voice message longer than 30 minutes (1,800,000 ms) is rejected with `422`.
                    example: 5400
                  waveform:
                    type: string
                    maxLength: 256
                    description: >-
                      Waveform for visualizing the voice message. Without it a request with a voice file (`file_type` is
                      `voice`) does not pass validation, but when editing, the value that was sent is not saved. Not
                      used for other types.
                    example: 4,8,12,20,16,10,6,3
                required:
                  - key
                  - name
              maxItems: 10
              description: >-
                Files to attach. The set you pass replaces the previous one: to keep a file already attached, pass it
                again with the same `key`.
              x-replaces-set: true
            buttons:
              type: array
              items:
                $ref: '#/components/schemas/ButtonRowItem'
              maxItems: 32
              description: >-
                Array of rows, each represented as an array of buttons. Maximum 100 buttons per message, up to 8 buttons
                per row. To remove buttons, send an empty array.
              example:
                - - text: Learn more
                    url: https://example.com/details
              x-replaces-set: true
            display_avatar_url:
              type: string
              description: Custom sender avatar URL for this message. This field can only be used with a bot access_token.
              example: https://example.com/avatar.png
            display_name:
              type: string
              description: Custom sender display name for this message. This field can only be used with a bot access_token.
              example: Support Bot
          description: Message parameters object to update
      description: Message update request
    MessageWebhookPayload:
      type: object
      required:
        - type
        - id
        - event
        - entity_type
        - entity_id
        - content
        - user_id
        - created_at
        - url
        - chat_id
        - webhook_timestamp
      properties:
        type:
          type: string
          enum:
            - message
          description: Object type
          example: message
          x-enum-descriptions:
            message: Always message for messages
        id:
          type: integer
          format: int32
          description: Message ID
          example: 1245817
        event:
          allOf:
            - $ref: '#/components/schemas/WebhookEventType'
          description: Event type
          example: new
        entity_type:
          allOf:
            - $ref: '#/components/schemas/MessageEntityType'
          description: Entity type the message belongs to
          example: discussion
        entity_id:
          type: integer
          format: int32
          description: ID of the entity the message belongs to
          example: 5678
        content:
          type: string
          description: Message text
          example: Message text
        user_id:
          type: integer
          format: int32
          description: Message sender ID
          example: 2345
        created_at:
          type: string
          format: date-time
          description: Message creation date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format
          example: '2025-05-15T14:30:00.000Z'
        changed_at:
          type: string
          format: date-time
          nullable: true
          description: >-
            Message last change date and time (ISO-8601, UTC+0) in YYYY-MM-DDThh:mm:ss.sssZ format. For a message that
            was never edited it equals the creation date. `null` for messages sent before this field was introduced.
          example: '2025-05-15T14:35:00.000Z'
        url:
          type: string
          description: Direct link to the message
          example: https://app.pachca.com/chats/9012?message=1245817
        chat_id:
          type: integer
          format: int32
          description: ID of the chat containing the message
          example: 9012
        parent_message_id:
          type: integer
          format: int32
          nullable: true
          description: ID of the message being replied to. `null` if the message is not a reply to another message.
          example: 3456
        thread:
          type: object
          allOf:
            - $ref: '#/components/schemas/WebhookMessageThread'
          nullable: true
          description: >-
            The thread the message was sent in. `null` if the message was not sent in a thread. Unlike the `thread`
            field on the REST API message object, this describes the thread the message is inside of.
        webhook_timestamp:
          type: integer
          format: int32
          description: Webhook send date and time (UTC+0) in UNIX format
          example: 1747574400
      description: Outgoing webhook payload for messages
    OAuthError:
      type: object
      required:
        - error
        - error_description
      properties:
        error:
          allOf:
            - $ref: '#/components/schemas/OAuthErrorCode'
          description: >-
            Error code. API methods respond with `invalid_token` (`401`), `insufficient_scope` and `role_forbidden`
            (`403`). The token exchange and revoke methods respond with the other codes.
          example: invalid_token
        error_description:
          type: string
          description: Error description
          example: Access token is missing
      description: OAuth authorization error (used for 401 and 403)
      x-error: true
    OAuthErrorCode:
      type: string
      enum:
        - invalid_token
        - insufficient_scope
        - role_forbidden
        - invalid_request
        - invalid_client
        - invalid_grant
        - unsupported_grant_type
        - unauthorized_client
      description: OAuth error code
      x-enum-descriptions:
        invalid_token: The token is missing, not found, expired, or revoked
        insufficient_scope: The token lacks the scope the method requires
        role_forbidden: The token has the scope, but its owner's role does not allow the action
        invalid_request: A required parameter is missing or malformed
        invalid_client: Wrong `client_id` or `client_secret`
        invalid_grant: >-
          The code has expired, has already been used, was issued for a different `redirect_uri`, or does not match
          `code_verifier`
        unsupported_grant_type: The `grant_type` value is not supported
        unauthorized_client: The token was issued to another bot, or the client did not authenticate
    OAuthRevokeRequest:
      type: object
      required:
        - token
      properties:
        token:
          type: string
          description: The employee's token or its refresh token
          example: pato_bm90X2FfcmVhbF90b2tlbg
        token_type_hint:
          allOf:
            - $ref: '#/components/schemas/OAuthTokenTypeHint'
          description: What is passed in `token`. Without the hint the server works it out itself.
          example: access_token
        client_id:
          type: string
          description: Client ID of a server-side application
          example: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
        client_secret:
          type: string
          description: >-
            Client secret of a server-side application. Together with `client_id` it can be passed in the
            `Authorization: Basic` header.
          example: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
      description: Token revocation request
    OAuthScope:
