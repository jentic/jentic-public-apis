openapi: 3.0.0
info:
  title: Pachca API
  version: 1.0.0
tags:
  - name: OAuth
  - name: Chats
  - name: Profile
  - name: Users
  - name: Group tags
  - name: Members
  - name: Threads
  - name: Messages
  - name: Read members
  - name: Reactions
  - name: Search
  - name: Tasks
  - name: Drafts
  - name: Views
  - name: Bots
  - name: Security
  - name: Custom Properties
  - name: Files
paths:
  /audit_events:
    get:
      operationId: SecurityOperations_getAuditEvents
      description: >-
        Audit event log


        What has been happening in the workspace: sign-ins and sign-outs, changes of roles and settings, actions on
        chats, employees, and bots. The records are read-only — they cannot be changed or deleted either through the API
        or from the interface.


        The method is available to the workspace owner on the "Corporation" plan; other employees receive `403`.
        Accessing the audit log is itself written to the audit log — as the `audit_events_accessed` event.


        Events come from newest to oldest and are selected with filters: the period by `start_time` and `end_time`, the
        kind of event by `event_key`, and the actor by `actor_id` and `actor_type`. Without filters the method returns
        all events of the workspace page by page.
      parameters:
        - name: start_time
          in: query
          required: false
          description: >-
            Start timestamp, inclusive (ISO-8601). An offset such as `+03:00` is taken into account, and a time without
            an offset is treated as UTC. A value that could not be parsed removes the filter — the response comes in
            full, without an error.
          schema:
            type: string
            format: date-time
            example: '2025-05-01T09:11:00.000Z'
          example: '2025-05-01T09:11:00.000Z'
          explode: false
        - name: end_time
          in: query
          required: false
          description: >-
            End timestamp, inclusive (ISO-8601). An offset such as `+03:00` is taken into account, and a time without an
            offset is treated as UTC. A value that could not be parsed removes the filter — the response comes in full,
            without an error.
          schema:
            type: string
            format: date-time
            example: '2025-05-02T09:11:00.000Z'
          example: '2025-05-02T09:11:00.000Z'
          explode: false
        - name: event_key
          in: query
          required: false
          description: Filter by specific event type
          schema:
            $ref: '#/components/schemas/AuditEventKey'
            example: user_login
          example: user_login
          explode: false
        - name: actor_id
          in: query
          required: false
          description: ID of the user who performed the action
          schema:
            type: string
            example: '98765'
          example: '98765'
          explode: false
        - name: actor_type
          in: query
          required: false
          description: Actor type
          schema:
            type: string
            example: User
          example: User
          explode: false
        - name: entity_id
          in: query
          required: false
          description: ID of the affected entity
          schema:
            type: string
            example: '98765'
          example: '98765'
          explode: false
        - name: entity_type
          in: query
          required: false
          description: Entity type
          schema:
            type: string
            example: User
          example: User
          explode: false
        - name: limit
          in: query
          required: false
          description: Number of records to return. An integer outside the allowed range is replaced with the nearest bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/AuditEvent'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Security
      x-paginated: true
      x-requirements:
        scope: audit_events:read
        plan: corporation
  /bot/recreate_token:
    post:
      operationId: BotOperations_selfRecreateBotToken
      description: >-
        Bot self token rotation


        Allows a bot to generate a new `access_token` for itself using its own token — without an administrator and
        without knowing its own `id`.


        The bot's main token is reissued — the one without a name, or the oldest one if there is none — and it is
        invalidated immediately. If the bot works with an additional token, that token stays as it was.


        The new token is returned in the response once — be sure to save it, otherwise the bot loses access to the API.
        The scopes are carried over from the previous token.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotSelfTokenResponse'
                description: Response wrapper with data
              example:
                data:
                  id: 1738816
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
                  access_token: bm90X2FfcmVhbF90b2tlbg
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bot_self:write
  /bot/webhook:
    put:
      operationId: BotOperations_selfUpdateBotWebhook
      description: >-
        Bot webhook self-registration


        Allows a bot to change its own outgoing webhook `URL` using its own token — without an administrator and without
        knowing its own `id`. The webhook of the bot that owns the token is changed. To disable the webhook, send an
        empty string in `outgoing_url`.


        The address of a bot with link unfurling (the `message_link_shared` event or the `trigger_on: unfurl` mode) is
        changed only by a workspace administrator or owner, with [Edit bot](PUT /bots/{id}). To such a bot this method
        responds `400` to any new address, an empty string included.
      parameters: []
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotSelfResponse'
                description: Response wrapper with data
              example:
                data:
                  id: 1738816
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BotWebhookSelfUpdateRequest'
            example:
              webhook:
                outgoing_url: https://example.com/tasks/new
      x-requirements:
        scope: bot_self:webhook:write
  /bots:
    get:
      operationId: BotOperations_listBots
      description: >-
        List bots


        The bots the caller is entitled to configure: those they created themselves and those whose settings grant them
        edit access.


        The `query` parameter selects bots by part of the name, without typos. Bot tokens do not come in the list: a
        token value is shown once, and the bot's tokens themselves are returned by [Bot token list](GET
        /bots/{id}/tokens).


        The list of all bots in the workspace, including other people's, is available to the workspace owner on the
        "Corporation" plan — [List workspace bots](GET /company/bots). There other people's bots come with only a name
        and a nickname, and the rest of the settings are hidden.
      parameters:
        - name: query
          in: query
          required: false
          description: Search phrase to filter bots by name
          schema:
            type: string
            example: task
          example: task
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of entities returned per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6MTczODgxNn0
          example: eyJpZCI6MTczODgxNn0
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/BotResponse'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
              example:
                data:
                  - id: 1738816
                    name: Tasks bot
                    nickname: tasks_bot
                    avatar_url: null
                    creator_id: 12
                    created_at: '2025-05-15T14:30:00.000Z'
                    authorized_users_count: 3
                    last_used_at: '2025-05-20T09:15:00.000Z'
                    webhook:
                      name: Tasks bot
                      nickname: tasks_bot
                      outgoing_url: https://example.com/tasks/new
                      events:
                        - message_new
                      trigger_on: commands
                      commands:
                        - /task
                      scopes:
                        - messages:create
                      template: Order from {{ client }} for {{ amount }} ₽
                      template_engine: liquid
                      challenge_key: challenge
                      link_preview_enabled: true
                      ignore_self_messages: false
                      events_history_enabled: false
                      single_chat: false
                      can_edit:
                        - admin
                      who_can_add: creator
                      kind: simple
                      unfurl_domains: []
                      last_request_at: '2025-05-20T09:15:00.000Z'
                    oauth_client_enabled: true
                    oauth_client:
                      client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                      client_secret_preview: dGhpc19p...ZWNy
                      confidential: true
                      redirect_uris:
                        - https://example.com/oauth/callback
                      scopes:
                        - messages:read
                        - messages:create
                    promo:
                      description: Collects a summary of tasks and sends it to the chat
                      published: true
                      promo_images: []
                    permissions:
                      update_oauth_client: true
                      recreate_token: true
                      destroy: true
                meta:
                  paginate:
                    next_page: eyJpZCI6MTczODgxNn0
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Bots
      x-paginated: true
      x-requirements:
        scope: bots:read
    post:
      operationId: BotOperations_createBot
      description: >-
        New bot


        Creates a bot in the workspace. By default the bot gets an incoming webhook in its own format and immediately
        returns its `access_token`. Save the token at creation: the same one is not shown again, and what remains is to
        reissue it with [Bot token rotation](POST /bots/{id}/recreate_token).


        With `empty: true` an empty bot is created, as in the interface: only a name and a nickname, without a token and
        without an incoming webhook. Tokens are issued to it with [New bot token](POST /bots/{id}/tokens), and the
        incoming webhook is enabled with the `kind` field in the `webhook` object.


        A newly created bot does not write anywhere yet. It writes into a conversation and a channel only as a member,
        and it is added like an employee — with the [Add chat members](POST /chats/{id}/members) method, passing the
        bot's `id`. In a channel the bot receives the editor role. Direct messages and threads in public chats do not
        require membership.


        The bot's incoming webhook sends a message at once to every conversation and channel the bot belongs to, so it
        is the set of its chats that decides where it lands. No token is needed for that, the webhook address is enough.
        To write into one particular chat, take the [New message](POST /messages) method — that one does need a token.


        Authorization on behalf of an employee can be enabled right away by passing `oauth_client`, and the catalog page
        can be filled in `promo`. For a server-side client the secret comes in `client_secret` once. Learn more in
        [Authorization setup](/guides/oauth/setup). The authorization link for the button is built, and the code is
        exchanged for a token, by the bot's server — step by step in [Getting a token](/guides/oauth/flow).


        The nickname must end with `_bot` and be free in the workspace. Only a workspace administrator or owner creates
        a bot that unfurls links.


        The bot's avatar is set after creation with the [Upload bot avatar](PUT /bots/{id}/avatar) method.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotCreateResponse'
                description: Response wrapper with data
              example:
                data:
                  id: 1738816
                  name: Tasks bot
                  nickname: tasks_bot
                  avatar_url: null
                  creator_id: 12
                  created_at: '2025-05-15T14:30:00.000Z'
                  authorized_users_count: 0
                  last_used_at: null
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
                    kind: simple
                    unfurl_domains: []
                    last_request_at: null
                  oauth_client_enabled: true
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  promo:
                    description: null
                    published: false
                    promo_images: []
                  permissions:
                    update_oauth_client: true
                    recreate_token: true
                    destroy: true
                  client_secret: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
                  access_token: bm90X2FfcmVhbF90b2tlbg
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Bots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BotCreateRequest'
            example:
              webhook:
                name: Tasks bot
                nickname: tasks_bot
                outgoing_url: https://example.com/tasks/new
                events:
                  - message_new
                trigger_on: commands
                commands:
                  - /task
                scopes:
                  - messages:create
              oauth_client:
                confidential: true
                redirect_uris:
                  - https://example.com/oauth/callback
                scopes:
                  - messages:read
                  - messages:create
      x-requirements:
        scope: bots:write
  /bots/{id}:
    get:
      operationId: BotOperations_getBot
      description: >-
        Bot info


        The bot's settings. The token does not come in the response — it is shown once at the bot's creation and at [Bot
        token rotation](POST /bots/{id}/recreate_token). The bot's tokens are returned by [Bot token list](GET
        /bots/{id}/tokens).


        The method returns only the bots the caller is entitled to configure: their own, and, if the bot's settings
        allow it, also as a workspace administrator or as an owner or admin of a chat the bot belongs to. For someone
        else's bot the method responds `403`.


        The method also answers a token with the `bots:write` scope and no `bots:read`. If you can also manage the bot's
        tokens (`permissions.recreate_token`), `webhook` carries the incoming webhook address `url`, the signing secret
        `secret_token` and the body of the last request to the incoming webhook `last_request_body`.


        The list of all bots in the workspace, including other people's, is available to the workspace owner on the
        "Corporation" plan — [List workspace bots](GET /company/bots).
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotResponse'
                description: Response wrapper with data
              example:
                data:
                  id: 1738816
                  name: Tasks bot
                  nickname: tasks_bot
                  avatar_url: null
                  creator_id: 12
                  created_at: '2025-05-15T14:30:00.000Z'
                  authorized_users_count: 3
                  last_used_at: '2025-05-20T09:15:00.000Z'
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
                    kind: simple
                    unfurl_domains: []
                    last_request_at: '2025-05-20T09:15:00.000Z'
                    url: https://api.pachca.com/webhooks/01JAXK7R3B5Y8Q2W4E6T9V1N3M
                    secret_token: pachca_wh_3pX9vQ2mL7rT5yW8kN4bH6jF1dS0aZcVxE2uI9oP7qR3tY5wK8nM4gB6hJ1lD0fA
                    last_request_body: '{"client": "Acme Corp", "amount": 15000}'
                  oauth_client_enabled: true
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  promo:
                    description: Collects a summary of tasks and sends it to the chat
                    published: true
                    promo_images: []
                  permissions:
                    update_oauth_client: true
                    recreate_token: true
                    destroy: true
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:read
    put:
      operationId: BotOperations_updateBot
      description: >-
        Edit bot


        Changes a bot's settings: only the fields you pass are overwritten.


        The nickname must end with `_bot` and be free in the workspace, otherwise the method responds with a validation
        error. Commands, scopes, events, link unfurling domains, and edit roles are replaced by the passed list as a
        whole. Scopes apply to the bot's main token — the one without a name, or the oldest one if there is none — and
        take effect on it right away, there is no need to reissue it. The scopes of an additional token are changed by
        [Edit bot token](PUT /bots/{id}/tokens/{token_id}).


        When `oauth_client` makes the client server-side, its secret comes in `client_secret` once. The authorization
        link for the button is built, and the code is exchanged for a token, by the bot's server — step by step in
        [Getting a token](/guides/oauth/flow). The catalog page is set by `promo` while authorization is enabled.


        Only a workspace administrator or owner turns the `message_link_shared` event on or off, turns on the
        `trigger_on: unfurl` mode, and for a bot with either changes the domains and the webhook address or turns on the
        event history.


        If a change takes away the bot's right to be in tags (`single_chat: true` or `who_can_add` set to `creator` or
        `creator_admin`), it leaves all tags and the chats it got into through them, and stays in the chats it was added
        to directly. More in the [Bot in tags](/guides/bots/settings#bot-v-tegah) section.


        The bot name, authorization on behalf of an employee and the catalog page are changed only by the bot's creator,
        and a workspace administrator if the bot's settings grant administrators edit access. Other settings cannot be
        changed for a bot whose settings are not accessible to you (the "Who can edit bot settings" field on the
        "General" tab).


        The bot's avatar is set and removed by separate methods, [Upload bot avatar](PUT /bots/{id}/avatar) and [Delete
        bot avatar](DELETE /bots/{id}/avatar).
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotResponse'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BotUpdateRequest'
      x-requirements:
        scope: bots:write
    delete:
      operationId: BotOperations_deleteBot
      description: >-
        Delete bot


        Removes the bot from the workspace for good. All of the bot's tokens stop working at once, as do the
        authorizations employees granted to it. The bot is removed from all chats, and its webhooks and catalog page are
        deleted.


        Deletion is available to the bot's creator, and a workspace administrator if the bot's settings grant
        administrators edit access. Chat owners and admins cannot delete a bot, even if they are allowed to edit it.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:write
  /bots/{id}/avatar:
    put:
      operationId: BotOperations_updateBotAvatar
      description: >-
        Upload bot avatar


        Sets or replaces the bot's avatar. It can be changed by anyone who has access to [Edit bot](PUT /bots/{id}).


        The file is sent in `multipart/form-data` format, and the response contains only a link to the new image. `jpg`,
        `jpeg`, `png`, and `gif` are accepted, an animated `gif` must be no larger than 2 MB, and the image is scaled
        down to 1024 by 1024 pixels.


        A scaled-down copy comes in the bot's `avatar_url` field, for example in the [Bot info](GET /bots/{id}) method.
      parameters:
        - name: id
          in: path
