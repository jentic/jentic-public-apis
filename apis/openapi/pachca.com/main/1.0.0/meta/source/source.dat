  /tasks:
    post:
      operationId: TaskOperations_createTask
      description: >-
        New task


        Creates a task and assigns the employees responsible for it.


        Specifying the task type is required when creating a task: call, meeting, simple reminder, event, or email. A
        description is not required — without it the task takes the name of its type as the text. If a description is
        passed, it is what becomes the task's text.


        A task must have assignees; if none are specified, you are assigned as the responsible one.


        Any workspace employee can be assigned to a task that is not linked to any entity. You can get the current
        employee list using the [List employees](GET /users) method. If no user exists with an ID from `performer_ids`,
        the method responds `404`. If the caller cannot see the employee, the response is `403`: this happens with an
        employee of another workspace, a suspended or a deleted one, and for a guest with anyone they share no chat
        with. In both cases the task is not created.


        A task can be linked to a conversation with the `chat_id` field — then, besides the author and the assignees,
        the members of that conversation see it. Whoever links it must belong to that conversation. Tasks are not
        created in a channel, in a thread, or in an archived chat.


        Handing a task to somebody else means changing the assignee with [Edit task](PUT /tasks/{id}).


        If a calendar is connected to the workspace or to the profile, the task also appears there as an event.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Task'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Tasks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TaskCreateRequest'
      x-requirements:
        scope: tasks:create
    get:
      operationId: TaskOperations_listTasks
      description: >-
        List tasks


        The tasks available to the token owner.


        Without the `chat_ids` parameter only your own tasks are returned: those from conversations and channels you are
        a member of, plus tasks with no chat that you created or that are assigned to you. The `chat_ids` parameter
        changes the selection — all tasks of the listed chats are returned, including those of other employees.
      parameters:
        - name: status
          in: query
          required: false
          description: Filter by state. If the parameter is omitted, tasks in any state are returned.
          schema:
            $ref: '#/components/schemas/TaskStatus'
            example: undone
          example: undone
          explode: false
        - name: chat_ids
          in: query
          required: false
          description: >-
            Filter by the chats the tasks are attached to. Accessible chats are the ones you are a member of, public
            conversations and channels of the workspace, and threads available to you through their parent chat. For a
            multi-guest, public conversations and channels are accessible only if they are a member. The remaining IDs
            are ignored without an error. Up to 100 IDs.
          schema:
            type: array
            items:
              type: integer
              format: int32
            maxItems: 100
            x-query-array: brackets
            example:
              - 198
              - 334
          x-query-array: brackets
          example:
            - 198
            - 334
          explode: false
        - name: performer_ids
          in: query
          required: false
          description: Filter by task performers. Up to 100 IDs.
          schema:
            type: array
            items:
              type: integer
              format: int32
            maxItems: 100
            x-query-array: brackets
            example:
              - 12
              - 185
          x-query-array: brackets
          example:
            - 12
            - 185
          explode: false
        - name: author_id
          in: query
          required: false
          description: Filter by task author
          schema:
            type: integer
            format: int32
            example: 12
          example: 12
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Task'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Tasks
      x-paginated: true
      x-requirements:
        scope: tasks:read
  /tasks/{id}:
    get:
      operationId: TaskOperations_getTask
      description: >-
        Task info


        The task together with its author, assignees, and the chat it is linked to.


        A task is seen by its author, its assignees, and everyone who can access its chat. The rule is the same as for
        the `chat_ids` filter of [List tasks](GET /tasks): the chat members, and in open conversations and channels —
        any employee of the workspace. Access to the chat is enough only to read the task: it can be changed and deleted
        only by the author or one of the assignees.
      parameters:
        - name: id
          in: path
          required: true
          description: 'Task ID: in a web app link it is the number from the path `/tasks/{id}` or from the `task_id` parameter'
          schema:
            type: integer
            format: int32
            example: 22283
          example: 22283
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Task'
                description: Response wrapper with data
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Tasks
      x-requirements:
        scope: tasks:read
    put:
      operationId: TaskOperations_updateTask
      description: >-
        Edit task


        Changes a task: only the fields you pass are overwritten.


        Handing a task over to another employee is an edit too: add them to `performer_ids` in place of the previous
        one.


        A completed task is closed with this same method: `status: "done"` ticks it off and keeps it in the list,
        `status: "undone"` puts it back to work.


        Available to the author and the assignees. A member of the chat where the task hangs sees it but cannot change
        it. The link to a chat cannot be changed: to move a task to another chat, delete it and create it again with the
        `chat_id` you need.
      parameters:
        - name: id
          in: path
          required: true
          description: Task ID
          schema:
            type: integer
            format: int32
            example: 22283
          example: 22283
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Task'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Tasks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TaskUpdateRequest'
      x-requirements:
        scope: tasks:update
    delete:
      operationId: TaskOperations_deleteTask
      description: >-
        Delete task


        Removes a task for good: it cannot be restored, and it disappears for the assignees as well. If the task went
        into a connected calendar, the event is deleted there too.


        Available to the author and the assignees. A repeated call responds `404`.


        A completed task can be closed while keeping it in the list with [Edit task](PUT /tasks/{id}) and `status:
        "done"`.
      parameters:
        - name: id
          in: path
          required: true
          description: Task ID
          schema:
            type: integer
            format: int32
            example: 22283
          example: 22283
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Tasks
      x-requirements:
        scope: tasks:delete
  /threads:
    post:
      operationId: ThreadOperations_createStandaloneThread
      description: >-
        New unattached thread


        Creates a thread that is not linked to anything: a place to talk, a dialogue with an agent, or a call that needs
        no chat of its own. Any employees can be gathered in it.


        The thread creator becomes its only member, and the `message_id` and `message_chat_id` fields in the response
        are returned as `null`. The easiest way to add members to the thread is a mention: `@nickname` or `@tag` at the
        start or the end of the message text. The [Add chat members](POST /chats/{id}/members) method by the `chat_id`
        of the thread works too.


        A thread has no name, so send the first message into it right away — that is how employees will understand what
        it is about. It is addressed by the thread's `id` with `entity_type: "thread"`. A thread cannot be deleted. If
        what needs discussing is a particular message in a chat, start a thread under it with the [New thread](POST
        /messages/{id}/thread) method, and if a permanent place with a name is needed, use the [New chat](POST /chats)
        method.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Thread'
                description: Response wrapper with data
              example:
                data:
                  id: 265142
                  chat_id: 2637266155
                  message_id: null
                  message_chat_id: null
                  updated_at: '2023-02-01T19:20:47.204Z'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Threads
      x-requirements:
        scope: threads:create
    get:
      operationId: ThreadOperations_listThreads
      description: >-
        List threads


        Threads available to the token owner.


        Returns threads where you belong either to the thread itself or to the chat it was started in. Belonging to the
        thread is enough: you do not have to join the chat with the parent message, and standalone threads come as well.
        Threads from open chats of the workspace you have not joined, however, do not make it into the list, even though
        those chats are available to you.


        Sorted by the time of the last message in the thread, descending.


        A list item carries neither a title nor any text: only the identifiers of the thread, its chat, and the parent
        message. To find out what a thread is about, read its messages with [List chat messages](GET /messages) by
        `chat_id`, and a thread known by its topic is found with [Search messages](GET /search/messages).
      parameters:
        - name: last_message_at_after
          in: query
          required: false
          description: >-
            Filter by the time of the last message in the thread: threads where it is later than the specified one are
            returned. The value is in ISO-8601, an offset such as `+03:00` is taken into account, and a time without an
            offset is treated as UTC.
          schema:
            type: string
            format: date-time
            example: '2025-01-01T00:00:00.000Z'
          example: '2025-01-01T00:00:00.000Z'
          explode: false
        - name: last_message_at_before
          in: query
          required: false
          description: >-
            Filter by the time of the last message in the thread: threads where it is earlier than the specified one are
            returned. The value is in ISO-8601, an offset such as `+03:00` is taken into account, and a time without an
            offset is treated as UTC.
          schema:
            type: string
            format: date-time
            example: '2025-02-01T00:00:00.000Z'
          example: '2025-02-01T00:00:00.000Z'
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Thread'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Threads
      x-paginated: true
      x-requirements:
        scope: threads:read
  /threads/{id}:
    get:
      operationId: ThreadOperations_getThread
      description: >-
        Thread info


        The identifiers of the thread and of the message it hangs under. The thread's `id` is used to write to it with
        the [New message](POST /messages) method with `entity_type: "thread"`, and its `chat_id` to read its messages.
        For a standalone thread `message_id` and `message_chat_id` come back as `null`.


        The response carries identifiers only: a thread has no name and no message counter, and what it is about can be
        seen from the messages inside. The messages of a thread are read with the [List chat messages](GET /messages)
        method, and its members with the [List chat members](GET /chats/{id}/members) method, both by the `chat_id` of
        the thread.


        Access to a thread is broader than the results of [List threads](GET /threads): a thread that opens by `id` may
        well not appear in the list.


        In a web app link, `thread_message_id` is the ID of the message the thread hangs under. The thread itself is in
        the `thread` field of that message, and the message is returned by [Message info](GET /messages/{id}).
      parameters:
        - name: id
          in: path
          required: true
          description: 'Thread ID: in a web app link it is the number from the `thread_id` parameter'
          schema:
            type: integer
            format: int32
            example: 265142
          example: 265142
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Thread'
                description: Response wrapper with data
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Threads
      x-requirements:
        scope: threads:read
  /uploads:
    post:
      operationId: UploadOperations_getUploadParams
      description: >-
        Get signature, key and other parameters


        The first step of a file upload: the method issues the storage address and the signed form fields with which the
        file is uploaded by the next request.


        Nothing is created in Pachca at this point yet: the uploaded file is visible to nobody and linked to nothing. It
        becomes an attachment when its `key` is passed in the `files` field — to [New message](POST /messages) or [New
        draft](POST /drafts), and when editing either of them.


        The parameters are issued for one file: request them again for each next one. The signature is valid for 14
        days, and the `key` is tied to the token owner, so someone else's key cannot be attached to your own message.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UploadParams'
              example:
                Content-Disposition: attachment
                acl: private
                policy: >-
                  
                x-amz-credential: 286471_server/20211122/kz-6x/s3/aws4_request
                x-amz-algorithm: AWS4-HMAC-SHA256
                x-amz-date: 20211122T065734Z
                x-amz-signature: 87e8f3ba4083c937c0e891d7a11tre932d8c33cg4bacf5380bf27624c1ok1475
                key: attaches/files/93746/e354fd79-4f3e-4b5a-9c8d-1a2b3c4d5e6f/${filename}
                direct_url: https://uploads.storage.example.com
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
      tags:
        - Files
      x-requirements:
        scope: uploads:write
  /users:
    post:
      operationId: UserOperations_createUser
      description: >-
        New employee


        Creates an employee in the workspace and sends them an invitation by email. Available to the workspace owner and
        an administrator; the method is not available to a bot.


        If an employee with this email address already exists in the workspace, the response is `409`. A nickname that
        is already taken is not treated as an error: random characters are silently appended to it, and the response
        comes back with the modified one.


        A free workspace, including one on a trial, can send a limited number of emails per day: invitations and
        email-change letters are counted together, and the limit is given on the [Limits](/api/limits) page. Beyond it
        the method responds `422` with the `daily_invites_limit` code and does not create the employee, while the
        remainder and the reset time come in `payload`. With `skip_email_notify: true` no email is sent and nothing
        counts towards the limit.


        You can fill in custom properties for the employee that have been created in your workspace. You can get the
        current list of employee custom property IDs using the [List custom properties](GET /custom_properties) method.


        The `list_tags` field puts the employee into tags right away, and together with the tags into the chats those
        tags are linked to. A name that does not exist in the workspace yet creates a new tag. For a guest no tags are
        assigned at all: the response is successful and `list_tags` in it is empty.


        Through the `chat_ids` parameter the employee can be added to the specified chats right at creation. To create a
        guest, pass `role: "guest"` — for this role `chat_ids` is required and must contain exactly one active chat the
        token has permission to add members to. Violating the guest access rules returns `400` with an error on the
        `chat_ids` field.


        The employee's avatar is set after creation with the [Upload employee avatar](PUT /users/{user_id}/avatar)
        method.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/User'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '409':
          description: The request conflicts with the current state of the server.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Users
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserCreateRequest'
      x-requirements:
        scope: users:create
    get:
      operationId: UserOperations_listUsers
      description: >-
        List employees


        Every employee of the workspace except the deleted ones. Suspended employees come together with the rest and are
        distinguished by the `suspended` field.


        Bots in the workspace are employees too and come in the common list with `bot: true`. But they are excluded from
        the results for `query`: to find a bot by name, page through the list without a search query.


        For a multi-guest the method returns not the whole workspace but the people they see in the interface:
        themselves, members of their shared chats including bots, and public bots. Threads and archived chats do not
        count as shared.


        Email and phone come back as `null` if the display of personal data is turned off in the workspace and the
        caller is not an administrator. For a multi-guest they always come back as `null`.


        A `query` search may not finish in time: then the method responds `504` with the `timeout` code, and the query
        is worth narrowing.


        The profile of a single employee is returned by [Employee info](GET /users/{id}), and your own by [Own
        profile](GET /profile).
      parameters:
        - name: query
          in: query
          required: false
          description: >-
            Search phrase to filter results. Search works on the following fields: `first_name`, `last_name`, `email`,
            `phone_number`, and `nickname`.
          schema:
            type: string
            example: Oleg
          example: Oleg
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/User'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
