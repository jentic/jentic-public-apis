                  description: Avatar image file
              required:
                - image
      x-requirements:
        scope: bots:write
    delete:
      operationId: BotOperations_deleteBotAvatar
      description: >-
        Delete bot avatar


        Removes the bot's avatar. Available to the same people who have access to [Upload bot avatar](PUT
        /bots/{id}/avatar).


        If there was no avatar, the response is still `204`.
      parameters:
