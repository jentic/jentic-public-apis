  /chats/{id}/unread:
    put:
      operationId: ChatOperations_markChatUnread
      description: >-
        Mark chat as unread


        Marks a chat as unread for the token owner, like "Mark as unread" in the interface. Only their own counter
        changes, the other members notice nothing.


        Without `message_id` the last message of the chat becomes unread, with `message_id` — this message and all
        messages after it. A repeated request with the same message changes nothing, and in a chat without messages the
        method responds with success and does nothing.


        Works in conversations, channels, direct chats and threads the token owner belongs to: a thread is passed by its
        `chat_id`. A hidden direct chat appears in the list again. A public chat the token owner is not in and a message
        from another chat respond `404`. A private chat, an inaccessible thread, and a chat of another workspace respond
        `403`.
      parameters:
        - name: id
          in: path
          required: true
          description: Chat ID (conversation, channel, direct chat, or thread chat)
          schema:
            type: integer
            format: int32
            example: 334
          example: 334
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      requestBody:
        required: false
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MarkChatUnreadRequest'
            example:
              message_id: 1194275
      x-requirements:
        scope: chats:mark_unread
  /company/bots:
    get:
      operationId: CompanyBotOperations_listCompanyBots
      description: >-
        List workspace bots


        Every bot in the workspace, including the ones you cannot edit. For those, only the name and the nickname are
        returned, the rest of the settings come as `null`. Only those bots that you can configure are returned by the
        [List bots](GET /bots) method.


        The method is available to the workspace owner. Every request is written to the [audit
        log](/guides/audit-events) with the `company_bots_accessed` key.
      parameters:
        - name: query
          in: query
          required: false
          description: Search phrase to filter bots by name
          schema:
            type: string
            example: task
          example: task
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of entities returned per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6MTczODgxNn0
          example: eyJpZCI6MTczODgxNn0
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/CompanyBotResponse'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
              example:
                data:
                  - id: 1738816
                    oauth_client:
                      client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                      client_secret_preview: dGhpc19p...ZWNy
                      confidential: true
