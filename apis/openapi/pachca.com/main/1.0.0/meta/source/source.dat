  /group_tags/{id}:
    get:
      operationId: GroupTagOperations_getTag
      description: >-
        Tag info


        The tag name and the number of employees in it.


        Only active employees are counted in `users_count`: suspended ones do not make it into the counter, although
        they remain in [List tag employees](GET /group_tags/{id}/users).


        Only the tags that come to a multi-guest in [List tags](GET /group_tags) are available to them; for the rest the
        method responds `404`.
      parameters:
        - name: id
          in: path
          required: true
          description: 'Tag ID: in a web app link it is the number from the `tag_id` parameter'
          schema:
            type: integer
            format: int32
            example: 9111
          example: 9111
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
