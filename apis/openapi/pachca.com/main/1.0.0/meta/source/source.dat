                  name: Tasks bot
                  nickname: tasks_bot
                  avatar_url: null
                  creator_id: 12
                  created_at: '2025-05-15T14:30:00.000Z'
                  authorized_users_count: 3
                  last_used_at: '2025-05-20T09:15:00.000Z'
                  webhook:
                    name: Tasks bot
                    nickname: tasks_bot
                    outgoing_url: https://example.com/tasks/new
                    events:
                      - message_new
                    trigger_on: commands
                    commands:
                      - /task
                    scopes:
                      - messages:create
                    template: Order from {{ client }} for {{ amount }} ₽
                    template_engine: liquid
                    challenge_key: challenge
                    link_preview_enabled: true
                    ignore_self_messages: false
                    events_history_enabled: false
                    single_chat: false
                    can_edit:
                      - admin
                    who_can_add: creator
                    kind: simple
                    unfurl_domains: []
                    last_request_at: '2025-05-20T09:15:00.000Z'
                  oauth_client_enabled: true
                  oauth_client:
                    client_id: aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY
                    client_secret_preview: dGhpc19p...ZWNy
                    confidential: true
                    redirect_uris:
                      - https://example.com/oauth/callback
                    scopes:
                      - messages:read
                      - messages:create
                  promo:
                    description: Collects a summary of tasks and sends it to the chat
                    published: true
                    promo_images: []
                  permissions:
                    update_oauth_client: true
                    recreate_token: true
                    destroy: true
                  client_secret: dGhpc19pc19ub3RfYV9yZWFsX3NlY3JldA
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:write
  /bots/{id}/scopes:
    get:
      operationId: BotOperations_getBotScopes
      description: >-
        Bot scope catalog


        The scopes that can be granted to this bot: to its tokens and to authorization on behalf of an employee. Each
        scope has a description, a category and the ready-made sets it belongs to, as when choosing scopes in the
        interface.


        The catalog is available to the same people who see the bot's tokens: the bot's creator, and a workspace
        administrator if the bot's settings give administrators edit access.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BotScopeCatalog'
              example:
                scopes:
                  - id: messages:create
                    title: Send messages
                    group: messages
                    preset:
                      - admin
                groups:
                  - id: messages
                    title: Messages
                    description: Working with messages
                presets:
                  - id: read-only
                    title: Read only
                  - id: admin
                    title: Administrator
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:read
  /bots/{id}/tokens:
    get:
      operationId: BotOperations_listBotTokens
      description: >-
        Bot token list


        The bot's active tokens: the main one, issued together with the bot, and additional ones — each with its own
        name and scopes. The token value is masked here: in full it is shown once, when the token is issued and when it
        is reissued.


        Only the bot's creator and a workspace administrator, if the bot's settings give administrators edit access, can
        work with the bot's tokens. For the owner of a chat with the bot the method responds `403`, even when the bot's
        other settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
        - name: limit
          in: query
          required: false
          description: >-
            Number of entities returned per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page`)
          schema:
            type: string
            example: eyJpZCI6NDgyN30
          example: eyJpZCI6NDgyN30
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/BotAccessToken'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
              example:
                data:
                  - id: 4827
                    token: cH5kR9mN...x7Qp
                    name: Notification server
                    user_id: 1738816
                    scopes:
                      - messages:create
                      - chats:read
                    created_at: '2025-01-15T10:30:00.000Z'
                    revoked_at: null
                    expires_in: null
                    last_used_at: '2025-02-24T14:20:00.000Z'
                    authorized_at: null
                meta:
                  paginate:
                    next_page: eyJpZCI6NDgyN30
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-paginated: true
      x-requirements:
        scope: bots:read
    post:
      operationId: BotOperations_createBotToken
      description: >-
        New bot token


        Issues one more token for the bot, with its own name and scopes. A bot can have several tokens: for example, a
        separate one for each service, so that they can be revoked one by one.


        The token value comes in the response once — save it right away. The token does not expire and works until it is
        deleted.


        Scopes are chosen from those that can be granted to a bot: they are listed by [Bot scope catalog](GET
        /bots/{id}/scopes). For a scope that is not in the catalog the method responds `400`. Without `scopes` the token
        is issued without scopes.


        Only the bot's creator and a workspace administrator, if the bot's settings give administrators edit access, can
        work with the bot's tokens. For the owner of a chat with the bot the method responds `403`, even when the bot's
        other settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotAccessToken'
                description: Response wrapper with data
              example:
                data:
                  id: 4827
                  token: bm90X2FfcmVhbF90b2tlbg
                  name: Notification server
                  user_id: 1738816
                  scopes:
                    - messages:create
                    - chats:read
                  created_at: '2025-01-15T10:30:00.000Z'
                  revoked_at: null
                  expires_in: null
                  last_used_at: null
                  authorized_at: null
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BotTokenCreateRequest'
            example:
              name: Notification server
              scopes:
                - messages:create
                - chats:read
      x-requirements:
        scope: bots:write
  /bots/{id}/tokens/{token_id}:
    put:
      operationId: BotOperations_updateBotToken
      description: >-
        Edit bot token


        Changes the token's name or scopes. New scopes take effect immediately: there is no need to reissue the token,
        and its value stays the same. Scopes are replaced by the passed list as a whole.


        Only the bot's creator and a workspace administrator, if the bot's settings give administrators edit access, can
        work with the bot's tokens. For the owner of a chat with the bot the method responds `403`, even when the bot's
        other settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
        - name: token_id
          in: path
          required: true
          description: Token ID
          schema:
            type: integer
            format: int64
            example: 4827
          example: 4827
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotAccessToken'
                description: Response wrapper with data
              example:
                data:
                  id: 4827
                  token: cH5kR9mN...x7Qp
                  name: Notification server
                  user_id: 1738816
                  scopes:
                    - messages:create
                    - chats:read
                  created_at: '2025-01-15T10:30:00.000Z'
                  revoked_at: null
                  expires_in: null
                  last_used_at: '2025-02-24T14:20:00.000Z'
                  authorized_at: null
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BotTokenUpdateRequest'
            example:
              name: Notification server
              scopes:
                - messages:create
                - chats:read
      x-requirements:
        scope: bots:write
    delete:
      operationId: BotOperations_deleteBotToken
      description: >-
        Delete bot token


        Deletes the token: requests with it stop passing at once. The bot's other tokens keep working.


        Only the bot's creator and a workspace administrator, if the bot's settings give administrators edit access, can
        work with the bot's tokens. For the owner of a chat with the bot the method responds `403`, even when the bot's
        other settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
        - name: token_id
          in: path
          required: true
          description: Token ID
          schema:
            type: integer
            format: int64
            example: 4827
          example: 4827
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:write
  /bots/{id}/tokens/{token_id}/reissue:
    post:
      operationId: BotOperations_reissueBotToken
      description: >-
        Reissue bot token


        Replaces the token value with a new one: the previous value stops working at once, the name and scopes stay. The
        new value comes in the response once — save it right away.


        The method is needed when a token has leaked or is changed on schedule. The bot's main token can also be
        reissued with [Bot token rotation](POST /bots/{id}/recreate_token).


        Only the bot's creator and a workspace administrator, if the bot's settings give administrators edit access, can
        work with the bot's tokens. For the owner of a chat with the bot the method responds `403`, even when the bot's
        other settings are open to them.
      parameters:
        - name: id
          in: path
          required: true
          description: Bot ID
          schema:
            type: integer
            format: int32
            example: 1738816
          example: 1738816
        - name: token_id
          in: path
          required: true
          description: Token ID
          schema:
            type: integer
            format: int64
            example: 4827
          example: 4827
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/BotAccessToken'
                description: Response wrapper with data
              example:
                data:
                  id: 4827
                  token: bm90X2FfcmVhbF90b2tlbg
                  name: Notification server
                  user_id: 1738816
                  scopes:
                    - messages:create
                    - chats:read
                  created_at: '2025-01-15T10:30:00.000Z'
                  revoked_at: null
                  expires_in: null
                  last_used_at: '2025-02-24T14:20:00.000Z'
                  authorized_at: null
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Bots
      x-requirements:
        scope: bots:write
  /chats:
    post:
      operationId: ChatOperations_createChat
      description: >-
        New chat


        Creates a conversation or a channel. The token owner becomes the chat owner, and this role is not transferred
        later on.


        A multi-guest cannot create chats, as in the interface: the method responds `403` to them.


        To create a 1-on-1 direct message with a user, use the [New message](POST /messages) method. To discuss a
        particular message there is no need to create a chat — a thread is started under it with the [New thread](POST
        /messages/{id}/thread) method. Talking over a single topic needs no permanent place either: there is the [New
        unattached thread](POST /threads) method for it.


        Members can be passed right away: `member_ids` adds them one by one, `group_tag_ids` brings in everyone who
        belongs to the tag and keeps the membership up to date afterwards. IDs that do not exist in the workspace, as
        well as suspended and deleted employees, do not stop the request: the chat is created with the other members,
        and such IDs come back in `meta.not_found_member_ids`. Tags that do not exist are skipped silently. Bots are
        stricter: if a bot's "Who can add the bot to chats" setting does not let you add it, the chat is not created,
        and the method responds `403` with the `bot_add_denied` code and the IDs of such bots in `value`. A bot with the
        "Restrict to a single chat" setting that already belongs to another conversation or channel stops the request
        too if it is in `member_ids` or creates the chat itself: the chat is not created, and the method responds `409`
        with the `single_chat_bot_occupied` code and the IDs of such bots in `value`.


        The chat's avatar is set after creation with the [Upload chat avatar](PUT /chats/{id}/avatar) method.
      parameters: []
      responses:
        '201':
          description: The request has succeeded and a new resource has been created as a result.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    $ref: '#/components/schemas/Chat'
                  meta:
                    type: object
                    properties:
                      not_found_member_ids:
                        type: array
                        items:
                          type: integer
                          format: int32
                        description: >-
                          IDs from `member_ids` that could not be added: the employee is not in the workspace, is
                          suspended, or is deleted. An empty array when everyone was added.
                        example: []
                    required:
                      - not_found_member_ids
                    description: Response metadata
                description: Response wrapper with data and metadata
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '409':
          description: The request conflicts with the current state of the server.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatCreateRequest'
      x-requirements:
        scope: chats:create
    get:
      operationId: ChatOperations_listChats
      description: >-
        List chats


        By default — the conversations, channels, and direct messages the token owner belongs to. With
        `availability=public` the method returns instead all public chats of the workspace, including the ones the
        caller has not joined. For a multi-guest — only the public chats they are a member of.


        Private (closed) chats are returned only to their members, whatever `availability` and `archived` are. The list
        of all chats in the workspace, including private ones, is available to the workspace owner on the "Corporation"
        plan — [List workspace chats](GET /company/chats).


        Threads never come in this list; for them there is [List threads](GET /threads).


        `archived=true` does not switch the results to the archive, it adds archived chats to the active ones.
      parameters:
        - name: sort
          in: query
          required: false
          description: Sort field
          schema:
            allOf:
              - $ref: '#/components/schemas/ChatSortField'
            default: id
          example: id
          explode: false
        - name: order
          in: query
          required: false
          description: Sort direction
          schema:
            allOf:
              - $ref: '#/components/schemas/SortOrder'
            default: desc
          example: desc
          explode: false
        - name: availability
          in: query
          required: false
          description: Parameter that controls chat availability and filtering for the user
          schema:
            allOf:
              - $ref: '#/components/schemas/ChatAvailability'
            default: is_member
          example: is_member
          explode: false
        - name: archived
          in: query
          required: false
          description: >-
            Include archived chats in the response. By default only active chats are returned. Works with any
            `availability` value.
          schema:
            type: boolean
            example: true
            default: false
          example: true
          explode: false
        - name: last_message_at_after
          in: query
          required: false
          description: >-
            Filter by the creation time of the last message: chats where it is later than the specified one are
            returned. The value is in ISO-8601, an offset such as `+03:00` is taken into account, and a time without an
            offset is treated as UTC.
          schema:
            type: string
            format: date-time
            example: '2025-01-01T00:00:00.000Z'
          example: '2025-01-01T00:00:00.000Z'
          explode: false
        - name: last_message_at_before
          in: query
          required: false
          description: >-
            Filter by the creation time of the last message: chats where it is earlier than the specified one are
            returned. The value is in ISO-8601, an offset such as `+03:00` is taken into account, and a time without an
            offset is treated as UTC.
          schema:
            type: string
            format: date-time
            example: '2025-02-01T00:00:00.000Z'
          example: '2025-02-01T00:00:00.000Z'
          explode: false
        - name: personal
          in: query
          required: false
          description: Filter by direct and group chats. If not specified, all chats are returned.
          schema:
            type: boolean
            example: false
          example: false
          explode: false
        - name: limit
          in: query
          required: false
          description: >-
            Number of records to return per request. An integer outside the allowed range is replaced with the nearest
            bound.
          schema:
            type: integer
            format: int32
            minimum: 1
            maximum: 50
            example: 1
            default: 50
          example: 1
          explode: false
        - name: cursor
          in: query
          required: false
          description: Pagination cursor (from `meta.paginate.next_page` or `meta.paginate.prev_page`)
          schema:
            type: string
            example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          example: eyJpZCI6MTAsImRpciI6ImFzYyJ9
          explode: false
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - meta
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Chat'
                  meta:
                    $ref: '#/components/schemas/PaginationMeta'
                description: Response wrapper with data and pagination
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      x-paginated: true
      x-requirements:
        scope: chats:read
  /chats/exports:
    post:
      operationId: ExportOperations_requestExport
      description: >-
        Export messages


        Order an export of the workspace messages for a period. The archive is prepared in the background.


        The export period is at most 45 days, with `chat_ids` up to 366 days, and `end_at` cannot be earlier than
        `start_at`. A different period responds `422` with the `invalid_date_range` code.


        With the `Prefer: return=representation` header the response comes with status `202` and the export identifier
        in `data.id`. Without the header the response is empty, with status `204`. By the identifier the archive is
        served by the [Download export archive](GET /chats/exports/{id}) method once it is assembled.


        When the archive is ready, a webhook with the identifier in the `export_id` field arrives at the address from
        `webhook_url`. The employee who ordered it receives an email and a notification in Pachca with a link of the
        form `/full_exports/{id}` — the number in it is the identifier.


        The workspace can order the next export 90 seconds after the previous one, even if that one is still being
        assembled. An earlier request responds `422` with the `rate_limit` code.
      parameters:
        - name: Prefer
          in: header
          required: false
          description: Asks for the export identifier in the response. Without the header the response is empty, with status `204`.
          schema:
            type: string
            enum:
              - return=representation
          example: return=representation
      responses:
        '202':
          description: The request has been accepted for processing, but processing has not yet completed.
          headers:
            Preference-Applied:
              required: true
              description: The preference the server applied
              schema:
                type: string
                enum:
                  - return=representation
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/ChatExport'
                description: Response wrapper with data
              example:
                data:
                  id: 22322
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ExportRequest'
            example:
              start_at: '2025-03-01'
              end_at: '2025-03-20'
              chat_ids:
                - 1381521
      x-requirements:
        scope: chat_exports:write
        plan: corporation
  /chats/exports/{id}:
    get:
      operationId: ExportOperations_downloadExport
      description: >-
        Download export archive


        In response to the request the server returns `302 Found` with a `Location` header containing a temporary
        download link for the file. Most HTTP clients automatically follow the redirect and download the file.


        The link is valid for 5 minutes, so use it right away. The archive itself is stored for 7 days, and only the
        employee who ordered the export can download it — the method refuses another employee holding the same
        permission.


        While the archive is being assembled, the method responds `404` with the `export_file_not_found` code.
      parameters:
        - name: id
          in: path
          required: true
          description: >-
            Export ID: `export_id` from the webhook about the finished archive, or the number from a link of the form
            `/full_exports/{id}` in the notification in Pachca
          schema:
            type: integer
            format: int32
            example: 22322
          example: 22322
      responses:
        '302':
          description: Redirection
          headers:
            location:
              required: true
              description: Temporary link to the archive in storage, valid for 5 minutes
              schema:
                type: string
                format: uri
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      x-requirements:
        scope: chat_exports:read
        plan: corporation
  /chats/{id}:
    get:
      operationId: ChatOperations_getChat
      description: >-
        Chat info


        The chat's details together with the list of members and the linked tags. What is written in the chat is
        returned by the [List chat messages](GET /messages) method.


        A private conversation the caller does not belong to responds `403`, not `404`: this method does not hide the
        existence of a chat. A public channel of your own workspace is returned even to someone who has not joined it.
        The method does not open other people's private chats to the workspace owner either — the full list of those is
        returned by [List workspace chats](GET /company/chats).


        Only active members come in `member_ids`: suspended ones do not make it into the list, although their membership
        is kept.
      parameters:
        - name: id
          in: path
          required: true
          description: 'Chat ID: in a web app link it is the number from the path `/chats/{id}`'
          schema:
            type: integer
            format: int32
            example: 334
          example: 334
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Chat'
                description: Response wrapper with data
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      x-requirements:
        scope: chats:read
    put:
      operationId: ChatOperations_updateChat
      description: >-
        Edit chat


        Changes the name of a conversation or a channel and its availability. Both changes are visible to the members as
        a system message in the chat feed.


        A direct chat cannot be renamed, and neither can an archived one: [Unarchive chat](PUT /chats/{id}/unarchive) it
        first. In a private chat the method is available to the chat owner and a chat administrator, in a public one to
        any employee of the workspace, even a non-member.


        The membership is not changed by this method; for that there are [Add chat members](POST /chats/{id}/members)
        and [Remove chat member](DELETE /chats/{id}/members/{user_id}).


        The avatar is set and removed by separate methods, [Upload chat avatar](PUT /chats/{id}/avatar) and [Delete chat
        avatar](DELETE /chats/{id}/avatar).
      parameters:
        - name: id
          in: path
          required: true
          description: Chat ID
          schema:
            type: integer
            format: int32
            example: 334
          example: 334
      responses:
        '200':
          description: The request has succeeded.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: '#/components/schemas/Chat'
                description: Response wrapper with data
        '400':
          description: The server could not understand the request due to invalid syntax.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '422':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatUpdateRequest'
      x-requirements:
        scope: chats:update
  /chats/{id}/archive:
    put:
      operationId: ChatOperations_archiveChat
      description: >-
        Archive chat


        Sends a conversation or a channel to the archive: the chat disappears from the lists of all members, new
        messages are not accepted into it, and the history is kept.


        Archiving does not merely freeze the chat. All guests are removed from it and all tags are unlinked from it. The
        employees a tag brought in stay as ordinary members, but the membership is no longer maintained by itself. The
        [Unarchive chat](PUT /chats/{id}/unarchive) method brings back neither the guests nor the tag links.


        Threads created in the chat stay open: they can still be written to after archiving.


        A direct chat and a thread are not sent to the archive. Archiving a chat that is already archived responds
        `403`.
      parameters:
        - name: id
          in: path
          required: true
          description: Chat ID
          schema:
            type: integer
            format: int32
            example: 334
          example: 334
      responses:
        '204':
          description: 'There is no content to send for this request, but the headers may be useful. '
        '401':
          description: Access is unauthorized.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OAuthError'
        '402':
          description: Client error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: Access is forbidden.
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/ApiError'
                  - $ref: '#/components/schemas/OAuthError'
        '404':
          description: The server cannot find the requested resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
      tags:
        - Chats
      x-requirements:
        scope: chats:archive
  /chats/{id}/avatar:
    put:
      operationId: ChatOperations_updateChatAvatar
      description: >-
        Upload chat avatar


        Sets or replaces the avatar of a conversation or a channel. It can be changed by anyone who has access to [Edit
        chat](PUT /chats/{id}). A direct chat and a thread have no avatar of their own, and for them the method responds
        `403`. The same response comes for an archived chat: first bring it back from the archive with the [Unarchive
        chat](PUT /chats/{id}/unarchive) method.


        The file is sent in `multipart/form-data` format, and the response contains only a link to the new image. `jpg`,
        `jpeg`, `png`, and `gif` are accepted, an animated `gif` must be no larger than 2 MB, and the image is scaled
        down to 1024 by 1024 pixels.


        The same link comes in the chat's `avatar_url` field, for example in the [Chat info](GET /chats/{id}) method.
      parameters:
        - name: id
          in: path
          required: true
          description: Chat ID
          schema:
            type: integer
            format: int32
