{
  "openapi": "3.0.0",
  "info": {
    "title": "Documentacao Hub Vitta API",
    "description": "API for Documentacao Hub Vitta platform with multi-tenant support, JWT authentication, and role-based access control.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/aviabrasil/GeneratedAPI_2026-02-25-1147/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.hubvitta.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login returns JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials"
          }
        }
      }
    },
    "/auth/validate": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Validate JWT Token",
        "operationId": "validateToken",
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string",
                "description": "Bearer token string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token is valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/resposta-anamnese/respostas": {
      "post": {
        "tags": [
          "Resposta Anamnese"
        ],
        "summary": "Save anamnesis responses",
        "operationId": "saveRespostaAnamnese",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RespostaAnamnese"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Responses saved successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/resposta-anamnese": {
      "get": {
        "tags": [
          "Resposta Anamnese"
        ],
        "summary": "Get anamnesis responses by tenant and user",
        "operationId": "getRespostaAnamneseByTenantAndUser",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "idUsuario",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of anamnesis responses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RespostaAnamnese"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          }
        }
      }
    },
    "/tenants": {
      "post": {
        "tags": [
          "Tenant"
        ],
        "summary": "Create new tenant",
        "operationId": "createTenant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequestDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data"
          }
        }
      },
      "get": {
        "tags": [
          "Tenant"
        ],
        "summary": "List tenants",
        "operationId": "listTenants",
        "responses": {
          "200": {
            "description": "List of tenants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantResponseDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tenants/id/{id}": {
      "get": {
        "tags": [
          "Tenant"
        ],
        "summary": "Get tenant by ID",
        "operationId": "getTenantById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDTO"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found"
          }
        }
      }
    },
    "/tenants/publico": {
      "get": {
        "tags": [
          "Tenant"
        ],
        "summary": "Get public tenant",
        "operationId": "getPublicTenant",
        "responses": {
          "200": {
            "description": "Public tenant information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDTO"
                }
              }
            }
          }
        }
      }
    },
    "/tenants/{id}": {
      "put": {
        "tags": [
          "Tenant"
        ],
        "summary": "Update tenant",
        "operationId": "updateTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tenant updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDTO"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Tenant"
        ],
        "summary": "Delete tenant",
        "operationId": "deleteTenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Tenant deleted successfully"
          },
          "404": {
            "description": "Tenant not found"
          }
        }
      }
    },
    "/users": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Create new user",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequestDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Invalid data"
          }
        }
      },
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "List users",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponseDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Get user by ID",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDTO"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Update user",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDTO"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Usuários"
        ],
        "summary": "Delete user",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/usuarios_tenants": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Link user to tenant",
        "operationId": "linkUserToTenant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUsuarioTenantRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User linked to tenant successfully"
          },
          "400": {
            "description": "Invalid data"
          }
        }
      }
    },
    "/usuarios_tenants/usuario/{idUsuario}": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "List tenants linked to user",
        "operationId": "listTenantsByUser",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tenants linked to user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioTenant"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usuarios_tenants/tenant/{idTenant}": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "List users linked to tenant",
        "operationId": "listUsersByTenant",
        "parameters": [
          {
            "name": "idTenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users linked to tenant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioTenant"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequestDTO": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "strongPassword123"
          }
        }
      },
      "LoginResponseDTO": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "RespostaAnamnese": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "idUsuario": {
            "type": "integer",
            "format": "int64"
          },
          "idPerguntaAnamnese": {
            "type": "integer",
            "format": "int64"
          },
          "valorResposta": {
            "type": "string",
            "maxLength": 255
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "tenantId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "idUsuario",
          "idPerguntaAnamnese",
          "valorResposta",
          "criadoEm",
          "tenantId"
        ]
      },
      "CreateTenantRequestDTO": {
        "type": "object",
        "required": [
          "nomeFantasia",
          "razaoSocial",
          "cnpj",
          "idTiposTennant"
        ],
        "properties": {
          "nomeFantasia": {
            "type": "string",
            "example": "Empresa Exemplo"
          },
          "razaoSocial": {
            "type": "string",
            "example": "Empresa Exemplo Ltda"
          },
          "cnpj": {
            "type": "string",
            "example": "12.345.678/0001-99"
          },
          "idTiposTennant": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "tipoTenant": {
            "type": "string",
            "nullable": true,
            "example": "Tipo A"
          }
        }
      },
      "TenantResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nomeFantasia": {
            "type": "string"
          },
          "razaoSocial": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "idTiposTennant": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "ATIVO",
              "INATIVO"
            ]
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "excluido": {
            "type": "boolean"
          },
          "tipoTenant": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nomeFantasia",
          "razaoSocial",
          "cnpj",
          "idTiposTennant",
          "status",
          "criadoEm",
          "excluido"
        ]
      },
      "Tenant": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TenantResponseDTO"
          }
        ]
      },
      "CreateUserRequestDTO": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "johndoe@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPass!23"
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "John Doe"
          }
        }
      },
      "UserResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username",
          "email"
        ]
      },
      "CreateUsuarioTenantRequestDTO": {
        "type": "object",
        "required": [
          "idUsuario",
          "idTenant"
        ],
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int64"
          },
          "idTenant": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UsuarioTenant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "idUsuario": {
            "type": "integer",
            "format": "int64"
          },
          "idTenant": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "idUsuario",
          "idTenant"
        ]
      }
    }
  }
}
