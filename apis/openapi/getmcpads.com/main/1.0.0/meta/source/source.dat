{"openapi":"3.1.0","info":{"title":"Get MCP Ads Data API","version":"1.0.0","description":"Shared advertising reports, authenticated downloads and scheduled destinations. Create organization-scoped keys in the dashboard. Test keys return synthetic data. Source metrics retain their documented meanings. Polling and downloads are not additional request credits."},"servers":[{"url":"https://api.getmcpads.com"}],"security":[{"apiKey":[]}],"components":{"securitySchemes":{"apiKey":{"type":"http","scheme":"bearer","description":"gma_live_… or gma_test_… API key"}},"schemas":{"Synchronization":{"type":"object","additionalProperties":false,"required":["name","query","destination_id","interval_minutes"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"query":{"$ref":"#/components/schemas/ReportQuery"},"destination_id":{"type":"string","format":"uuid"},"interval_minutes":{"type":"integer","minimum":60,"maximum":44640},"lookback_days":{"type":"integer","minimum":1,"maximum":366,"default":7},"timezone":{"type":"string","default":"UTC"}}},"ReportQuery":{"type":"object","required":["source","account_ids","date_range","dimensions","metrics"],"properties":{"source":{"type":"string"},"account_ids":{"type":"array","items":{"type":"string"},"minItems":1},"date_range":{"type":"object","required":["start","end"],"properties":{"start":{"type":"string","format":"date"},"end":{"type":"string","format":"date"}}},"level":{"type":"string","enum":["account","campaign","ad_group","ad"]},"dimensions":{"type":"array","items":{"type":"string"},"description":"Include date for daily rows; omit it for native totals over date_range, grouped by the selected dimensions. Filters apply to these report rows."},"metrics":{"type":"array","items":{"type":"string"}},"resource":{"type":"string","description":"Google Ads resource from the source catalog."},"report_type":{"type":"string","description":"Microsoft, Amazon, Apple or Pinterest report type from catalog.query_options."},"attribution