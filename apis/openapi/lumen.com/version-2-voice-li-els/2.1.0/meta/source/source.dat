            ]
          },
          "zipCode": {
            "type": "string",
            "description": "5 digit zip code",
            "example": "80203"
          },
          "country": {
            "type": "string",
            "description": "Country Code",
            "example": "US"
          },
          "rateCenterAbbrev": {
            "type": "string",
            "description": "Rate center abbreviation",
            "example": "DENVER"
          },
          "alternateAddress": {
            "type": "boolean",
            "description": "Depicts if user input is an alternate address. Payload response body will always return the primary known address.",
            "example": false
          }
        },
        "description": "Address properties using USPS standards"
      }
