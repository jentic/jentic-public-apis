{
  "openapi": "3.0.0",
  "info": {
    "title": "Version 2 Voice LI-ELS",
    "description": "Full suite of APIs for end-to-end telephone number life-cycle management and workflow automation.",
    "version": "2.1.0",
    "termsOfService": "https://developer.lumen.com/terms-use",
    "contact": {
      "url": "https://developer.lumen.com/contact-us/"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/api-constructors-voice-addresscheck/2.1.0"
  },
  "tags": [
    {
      "name": "Rate Center Coverage API",
      "description": "Find rate centers and your TN utilization by rate center."
    },
    {
      "name": "Check Coverage",
      "description": "Check for portability and coverage availability.      "
    },
    {
      "name": "TN Reservation API",
      "description": "Add TNs to your inventory pool. TNs reserved into inventory will not be active. Use the order API to activate TNs and add subscriber detail."
    },
    {
      "name": "Reports",
      "description": "Active telephone numbers in your inventory."
    },
    {
      "name": "Order Management",
      "description": "Order new TNs from inventory or port-in TNs. Change TN and subscriber information. Disconnect TNs and cancel orders. "
    },
    {
      "name": "LNP Order Management",
      "description": "Supplement in-flight LNP order, and check LNP status."
    },
    {
      "name": "Notifications",
      "description": "Fetch API notifications for aynchronous responses."
    }
  ],
  "paths": {
    "/Voice/v1/Numbers/serviceAddress": {
      "post": {
        "tags": [
          "Coverage"
        ],
        "summary": "Validate an address.",
        "description": "Validates an address against Lumen systems and returns the __serviceAddress__ in [USPS fielded format](https://faq.usps.com/s/article/What-is-the-Format-and-Sequence-of-Information-for-the-Recipient-s-Address).\n\n__Required fields:__\n```\nstreetAddress\nstreetNumber\nstreetNumberSuffix\npreDirectional\nstreetName\npostDirectional\nstreetSuffix\ncity\nstate\nzipCode\ncountry\n```\n",
        "operationId": "validateAddressUsingPOST",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "Lumen defined customer ID. Also known as BusOrg number",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABC45"
          }
        ],
        "requestBody": {
          "description": "payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceAddressRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceAddressResponseBody"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "You are not authorized to view the resource"
          },
          "403": {
            "description": "Accessing the resource you were trying to reach is forbidden."
          },
          "404": {
            "description": "The resource you were trying to reach was not found."
          }
        },
        "deprecated": false,
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://api-test.lumen.com/"
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api-test.lumen.com/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Error400": {
        "description": "Bad Request. (https://tools.ietf.org/html/rfc7231#section-6.5.1)",
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "required": [
              "code"
            ],
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/Error400Code"
              }
            }
          }
        ]
      },
      "Error": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "maxLength": 255,
            "type": "string",
            "description": "Text that explains the reason for the error. This can be shown to a client user."
          },
          "message": {
            "type": "string",
            "description": "Text that provides mode details and corrective actions related to the error. This can be shown to a client user."
          },
          "referenceError": {
            "type": "string",
            "description": "URL pointing to documentation describing the error",
            "format": "uri"
          }
        },
        "description": "Standard Class used to describe API response error Not intended to be used directly. The `code` in the HTTP header is used as a discriminator for the type of error returned in runtime.\n"
      },
      "Error400Code": {
        "type": "string",
        "description": "One of the following error codes:\n- missingQueryParameter: The URI is missing a required query-string parameter\n- missingQueryValue: The URI is missing a required query-string parameter value\n- invalidQuery: The query section of the URI is invalid.\n- invalidBody: The request has an invalid body",
        "enum": [
          "missingQueryParameter",
          "missingQueryValue",
          "invalidQuery",
          "invalidBody"
        ]
      },
      "Error500": {
        "description": "Internal Server Error. (https://tools.ietf.org/html/rfc7231#section-6.6.1)",
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "required": [
              "code"
            ],
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The following error code:\n- internalError: Internal server error - the server encountered an unexpected condition that prevented it from fulfilling the request.",
                "enum": [
                  "internalError"
                ]
              }
            }
          }
        ]
      },
      "ServiceAddressRequestBody": {
        "title": "ServiceAddressBody",
        "type": "object",
        "properties": {
          "streetAddress": {
            "type": "string",
            "description": "Optional full string address composed of  streetNumber, streetNumberSuffix,  preDirectional, postDirectional, and streetSuffix.",
            "example": "200 E Colfax"
          },
          "streetNumber": {
            "type": "string",
            "description": "Street number",
            "example": "200"
          },
          "streetNumberSuffix": {
            "type": "string",
            "description": "A non-integer identifier which follows streetNumber. Not applicable for most addresses.",
            "example": ""
          },
          "preDirectional": {
            "type": "string",
            "description": "Directional identifier that appears before streetName.",
            "example": "E",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "streetName": {
            "type": "string",
            "description": "Name of the street",
            "example": "Colfax"
          },
          "postDirectional": {
            "type": "string",
            "description": "Directional identifier that appears after streetName.",
            "example": null,
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "streetSuffix": {
            "type": "string",
            "description": "Descriptor for the type of roadway that appears after streetName.",
            "example": "AVENUE"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "DENVER"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation",
            "example": "CO",
            "enum": [
              "AK",
              "AL",
              "AR",
              "AZ",
              "CA",
              "CO",
              "CT",
              "DC",
              "DE",
              "FL",
              "GA",
