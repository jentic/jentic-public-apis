              "MO",
              "MT",
              "NE",
              "NV",
              "NH",
              "NJ",
              "NM",
              "NY",
              "NC",
              "ND",
              "OH",
              "OK",
              "OR",
              "PA",
              "PR",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VT",
              "VA",
              "VI",
              "WA",
              "WV",
              "WI",
              "WY"
            ]
          },
          "zipCode": {
            "type": "string",
            "description": "5 digit zip code",
            "example": "80203"
          },
          "country": {
            "type": "string",
            "description": "Country Code",
            "example": "US"
          }
        },
        "description": "Address properties using USPS standards."
      },
      "ServiceAddressResponseBody": {
        "title": "ServiceAddresskBody",
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string",
            "description": "error message"
          },
          "streetNumber": {
            "type": "string",
            "description": "Street number",
            "example": "200"
          },
          "streetNumberSuffix": {
            "type": "string",
            "description": "The non-integer portion of the identifier for the building which follows after streetNumber. Not applicable for most addresses.",
            "example": null
          },
          "preDirectional": {
            "type": "string",
            "description": "pre directional",
            "example": "E",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "streetName": {
            "type": "string",
            "description": "Name of the street",
            "example": "COLFAX"
          },
          "postDirectional": {
            "type": "string",
            "description": "post directional",
            "example": null,
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "streetSuffix": {
            "type": "string",
            "description": "Suffix for the street",
            "example": "AVE"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "DENVER"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation",
            "example": "CO",
            "enum": [
