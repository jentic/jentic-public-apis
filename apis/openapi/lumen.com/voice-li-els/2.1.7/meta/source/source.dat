            "$ref": "#/components/schemas/CoverageRateCenter"
          },
          "portabilityAnalysisResult": {
            "$ref": "#/components/schemas/PortabilityAnalysisResult"
          },
          "resultCode": {
            "$ref": "#/components/schemas/ResultCode"
          },
          "tn": {
            "type": "string",
            "description": "TN",
            "example": "3039929900"
          }
        }
      },
