      "ServiceAvailabilityRequest": {
        "title": "ServiceAvailabilityRequest",
        "required": [
          "customerServiceName",
          "lnpIndicator",
          "productID",
          "serviceAddress",
          "tn"
        ],
        "type": "object",
        "properties": {
          "customerServiceName": {
            "type": "string",
            "description": "The customer service name (CSN) is a shortcut name for the IP trunks and addresses used for routing voice traffic on our network. For CSNs assigned to your account, please reference the enrollment form you received at the time of setup.",
            "example": "YOUR-CSN"
          },
          "e911Option": {
            "type": "string",
            "description": "Specifies the 911 solution the subscriber opts to use. Use valid values for your specific product only ",
            "example": "E_911_CUSTOMER_PROVIDED",
            "enum": [
              "E_911_STANDARD",
              "E_911_CUSTOMER_PROVIDED",
              "E_911_LYNC",
              "E_911_STANDARD"
            ]
          },
          "externalOrderID": {
            "type": "string",
            "description": "External Order ID",
            "example": "OR000011"
          },
          "lnpIndicator": {
            "type": "string",
            "description": "Local number portability indicator. Valid values are Y (LNP install) or N (new install)",
            "example": "Y",
            "enum": [
              "Y",
              "N"
            ]
          },
          "productID": {
            "type": "integer",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "format": "int32",
            "example": 2036
          },
          "serviceAddress": {
            "$ref": "#/components/schemas/ServiceAvailabilityServiceAddress"
          },
          "tn": {
            "type": "string",
            "description": "Telephone number to be ported or installed",
            "example": 13039929900
          }
        }
      },
