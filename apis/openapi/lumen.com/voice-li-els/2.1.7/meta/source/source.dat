            "example": "4803"
          },
          "internalPortInd": {
            "type": "string",
            "description": "Indicates whether the telephone number on the request is currently active on the network. This impacts the time to port the number to the new provider",
            "example": "Y or N"
          },
          "wirelessLnpYn": {
            "type": "string",
            "description": "Indicates whether the telephone number on the request is wireless telephone number",
            "example": "Y or N"
          },
