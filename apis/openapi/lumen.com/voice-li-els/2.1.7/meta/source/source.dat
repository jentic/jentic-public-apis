    "/Voice/v1/Numbers/orderInventory": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Reserve telephone numbers.",
        "description": "Submits an order for telephone numbers to be reserved based on the rate center and product.\n\n__Required fields:__\n```\nproductID\nrateCenters\ncustomerServiceName\n```\n__Note:__ You can reserve up to 399 telephone numbers per rate center per order.  You must install at least 75% of the current inventory in a rate center before ordering more inventory.\n",
        "operationId": "Create TN Order with quantity not greater than 399.",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          }
        ],
        "requestBody": {
          "description": "payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVoiceOrderRequestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceOrder"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceOrder"
                }
              }
            }
          },
          "402": {
            "description": "The resource you created does not meet the data requirement(s)..",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
