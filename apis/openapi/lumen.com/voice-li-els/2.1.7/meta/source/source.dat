      "tn": {
        "title": "tn",
        "required": [
          "startTN"
        ],
        "type": "object",
        "properties": {
          "npa": {
            "type": "string",
            "description": "NPA",
            "example": "303"
          },
          "nxx": {
            "type": "string",
            "description": "NXX",
            "example": "942"
          },
          "tnStartNumber": {
            "type": "string",
            "description": "tnStartNumber",
            "example": "9200"
          },
          "tnEndNumber": {
            "type": "string",
            "description": "tnStartNumber",
            "example": "9200"
          },
          "startTN": {
            "type": "string",
            "description": "Start Telephone Number in E.164 format (+13039929200) for a given telephone number range sequence.",
            "example": 13039929200
          },
          "endTN": {
            "type": "string",
            "description": "End Telephone Number in E.164 format (+13039929200) for a given telephone number range sequence.",
            "example": 13039929200
          }
        }
      },
      "LIProductFeatureList": {
        "type": "array",
        "description": "Collection of product feature attributes based on the product specification.",
        "example": [
          {
            "attributeName": "customerServiceName",
            "attributeValue": "1AB-CD-3"
