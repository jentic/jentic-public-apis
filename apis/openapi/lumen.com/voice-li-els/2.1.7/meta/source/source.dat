            },
            "example": "1-ABCDE"
          }
        ],
        "requestBody": {
          "description": "tnDisconnectRequest",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TNDisconnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted for processing.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceOrder"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "You are not authorized to view the resource."
          },
          "402": {
            "description": "The resource you created does not meet the data requirement(s)."
          },
          "403": {
            "description": "Accessing the resource you were trying to reach is forbidden."
          },
          "404": {
            "description": "The resource you were trying to reach was not found."
          }
        },
        "deprecated": false,
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/Voice/v1/Reports/inventoryDetails": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "List active telephone numbers v1.",
        "description": "Returns a list of active telephone numbers.\n\nYou must pass the <code>x-customer-number</code> parameter in the header to complete this call successfully. For this endpoint, the <code>x-customer-number</code> is the same as your <strong>Parent BusOrg</strong> ID.\n\nThe report includes the following information:\n- Subscriber\n- Address\n- E911 address\n- Customer Service Name\n- Requires the Master Customer Number (Bus Org) child numbers are not valid.\n\n__Note:__ The report details refresh every 24 hours. The production environment refreshes at 17:01 UTC.",
        "operationId": "getTNsUsingGET",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-A2-3456"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Requested index for the start of resources to be provided in response. If unspecified, the first page is returned.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Requested number of resources to be provided in response. Valid values range from 1 to 200 items. The default value is 10.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 10
          },
          {
