{
  "openapi": "3.0.0",
  "info": {
    "title": "Voice LI-ELS",
    "description": "Full suite of APIs for end-to-end telephone number life-cycle management and workflow automation.",
    "termsOfService": "https://developer.lumen.com/terms-use",
    "contact": {
      "url": "https://developer.lumen.com/contact-us/"
    },
    "version": "2.1.7",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/po-devcenter-scraper/2.1.7"
  },
  "servers": [
    {
      "url": "https://api-mock.lumen.com",
      "description": "Mock server"
    }
  ],
  "tags": [
    {
      "name": "Rate Centers",
      "description": "Find rate centers and telephone number utilization by rate center."
    },
    {
      "name": "Coverage",
      "description": "Check for portability and coverage availability."
    },
    {
      "name": "Inventory",
      "description": "Add telephone numbers to your inventory pool."
    },
    {
      "name": "Orders",
      "description": "Manage telephone number orders."
    },
    {
      "name": "Porting",
      "description": "Manage porting orders and real-time port requests."
    },
    {
      "name": "Reports",
      "description": "Access inventory reports."
    },
    {
      "name": "Notifications",
      "description": "Fetch API notifications for asynchronous responses."
    }
  ],
  "paths": {
    "/Voice/v1/Numbers/customerApproval": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Respond to a backorder request.",
        "description": "Submits a response indicating how you would like us to proceed with your telephone number request if it cannot be fulfilled.\n\nYou will receive a push notification indicating how many numbers can be fulfilled immediately and how many will be in backorder. The order will be canceled unless a response is received within 4 hours.\n\n__Required fields:__\n\n```\napprovalResponse\nvoiceOrderID\n```\nListed below are the possible enum values for the __approvalResponse__ field:\n\n- __Accept_with_BackOrder__<br>\n  Approval to proceed with a backorder for the given state and rate center.\n- __Accept_Available_Only__<br>\n  Approval to proceed with only the available telephone numbers and not create a backorder.\n- __Reject__<br>\n  Reject the entire order for the given state and rate center.\n",
        "operationId": "Customer Response on approval request",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          }
        ],
        "requestBody": {
          "description": "payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerApprovalRequestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerApprovalResponsePayload"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse401"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/Voice/v1/Numbers/inventory": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "List customer inventory telephone numbers.",
        "description": "Returns a list of customer inventory telephone numbers that are available for subscription.\n\nYou must pass the <code>x-customer-number</code> parameter in the header to complete this call successfully. For this endpoint, the <code>x-customer-number</code> is the same as your <strong>Parent BusOrg</strong> ID.\n\n__Note:__ If no telephone numbers are available in the query, the __tnResults__ returns an empty array. See the example response below.\n\n```\n{\n  \"rateCenter\": \"DENVER\",\n  \"state\": \"CO\",\n  \"tnResults\": []\n}\n```\n",
        "operationId": "List available telephone numbers by rate center",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Requested index for the start of resources to be provided in response. If unspecified, the first page is returned.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Requested number of resources to be provided in response. Valid values range from 1 to 200 items. The default value is 10.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "example": 10
          },
          {
            "name": "productID",
            "in": "query",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "2036"
          },
          {
            "name": "rateCenter",
            "in": "query",
            "description": "Rate center abbreviation",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "DENVER"
          },
          {
            "name": "state",
            "in": "query",
            "description": "State abbreviation",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "CO"
          },
          {
            "name": "voiceOrderID",
            "in": "query",
            "description": "Previously submitted Voice Order ID",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "example": 10000
          },
          {
            "name": "externalOrderID",
            "in": "query",
            "description": "Customer External Order ID",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "EXT-ORD-1"
          },
          {
            "name": "npa",
            "in": "query",
            "description": "NPA identifies the 3-digit Numbering Plan Area (area code)",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": 720
          },
          {
            "name": "nxx",
            "in": "query",
            "description": "NXX identifies the Central Office (aka. exchange) within the NPA",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": 999
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RateCenterTnsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/Voice/v3/Numbers/inventory": {
      "get": {
        "tags": [
