    "/Voice/v1/Numbers/rateCenters/utilization": {
      "post": {
        "tags": [
          "Rate Centers"
        ],
        "summary": "Retrieve rate center utilization.",
        "description": "Returns the percentage of active telephone numbers in inventory by rate center. You can search multiple rate centers at a time.\n\nYou must pass the <code>x-customer-number</code> parameter in the header to complete this call successfully. For this endpoint, the <code>x-customer-number</code> is the same as your <strong>Parent BusOrg</strong> ID.\n\n__Required fields:__\n```\nx-customer-number\nproductID\nrateCenters\n  rateCenterAbbrev\n  state\n```\n\n__Note:__ 75% of your rate center numbers in inventory must be active before ordering new numbers for that rate center.\n",
        "operationId": "Rate Center utilization for all Rate Centers",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          }
        ],
        "requestBody": {
          "description": "payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateCenterUtilizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RateCenterUtilizationResponse"
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "*/*": {
