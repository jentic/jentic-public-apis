        "title": "NotificationRequest",
        "type": "object",
        "properties": {
          "customerNumber": {
            "type": "string",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "example": "1-ABCDE"
          },
          "voiceOrderId": {
            "type": "object",
            "description": "Unique identifier of voice order.",
            "example": 10222021
          },
          "productId": {
            "type": "string",
            "description": "Lumen identification for a service.",
            "example": "2036"
          },
          "startDate": {
            "type": "string",
            "description": "Starting date in date range",
            "example": "2020-09-21T17:01:17+00:00"
          },
          "endDate": {
            "type": "string",
            "description": "Ending date in date range",
            "example": "2020-09-21T17:01:17+00:00"
          },
          "pageNumber": {
            "type": "integer",
            "description": "Requested index for the start of resources to be provided in response. If unspecified, the first page is returned.",
            "format": "int32",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "Requested number of resources to be provided in response. Valid values range from 1 to 200 items. The default value is 10.",
            "format": "int32",
            "example": 10
          }
        }
      },
