            "example": "APT 2001"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "DENVER"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation",
            "example": "CO",
            "enum": [
              "AK",
              "AL",
              "AR",
              "AZ",
              "CA",
              "CO",
              "CT",
              "DC",
              "DE",
              "FL",
              "GA",
              "HI",
