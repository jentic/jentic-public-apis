      "TNSupplementRequestNew": {
        "title": "TNSupplementRequestNew",
        "type": "object",
        "properties": {
          "voiceOrderID": {
            "type": "string",
            "description": "voice Order ID",
            "example": "1100221"
          },
          "parentTransactionID": {
            "type": "string",
            "description": "parent Transaction ID",
            "example": "1234567"
          },
          "productID": {
            "type": "integer",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "format": "int32",
            "example": 2042,
            "enum": [
              2036,
              2042
            ]
          },
          "externalOrderID": {
            "type": "string",
            "description": "externa lOrder ID",
            "example": "OR000011"
          },
          "externalOrderVersion": {
            "type": "string",
            "description": "external Order Version",
            "example": "1"
          },
          "customerRequestedDate": {
            "type": "string",
            "description": "customer Requested Date. This attribute needs to come in UTC. Lumen will convert this component to MT time zone internally.",
            "example": "2020-11-21T21:43:24+00:00"
          },
          "customerNumber": {
            "type": "string",
            "description": "customer Number",
            "example": "1-ABCDE"
          },
          "billingTelephoneNumber": {
            "type": "integer",
            "description": "Billing Telephone Number",
            "format": "int64",
            "example": 1112223333
          },
          "subscriberLineList": {
            "type": "array",
            "description": "List of subscriber line information",
            "items": {
              "$ref": "#/components/schemas/SuppLISubscriberLine"
            }
          },
          "tnRemoveList": {
            "type": "array",
            "description": "List of Tns",
            "items": {
              "$ref": "#/components/schemas/tn"
            }
          },
          "comments": {
            "type": "string",
            "description": "customer Number",
            "example": "Order Supplement reason."
          },
          "lnpIndicator": {
            "type": "string",
            "description": "LNP Indicator. Valid values are Y (LNP Order) and N (Native Order).",
            "example": "Y",
            "enum": [
              "Y",
              "N"
            ]
          }
        },
        "xml": {
          "name": "TNSupplementRequestNew"
        }
      },
