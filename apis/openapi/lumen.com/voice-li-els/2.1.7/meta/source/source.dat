    "/Voice/v1/Numbers/rateCenters": {
      "get": {
        "tags": [
          "Rate Centers"
        ],
        "summary": "List rate centers.",
        "description": "Returns a list of rate centers and their sellable status.\n\n__Note:__ The __static911=\"Y\"__ property indicates rate centers where Lumen provides 911 service at that rate center. Static 911 is not applicable for Local Inbound (LI) products.\n\nEnhanced Local Service (ELS) customers should only use rate centers where __static911=\"Y\"__ unless they have elected to use their own 911 provider.\n",
        "operationId": "List rate center by state",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Requested index for the start of resources to be provided in response. If unspecified, the first page is returned.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Requested number of resources to be provided in response. Valid values range from 1 to 200 items. The default value is 10.",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 10
          },
          {
            "name": "productID",
            "in": "query",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS).",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "2036"
          },
          {
            "name": "state",
            "in": "query",
            "description": "State abbreviation",
            "required": false,
            "allowEmptyValue": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "CO"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RateCenterInfoResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse401"
                }
              }
            }
          },
          "402": {
            "description": "Data validation",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse402"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
