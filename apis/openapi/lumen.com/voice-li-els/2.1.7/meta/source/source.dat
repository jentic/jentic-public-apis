    "/Voice/v2/Numbers/order/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Cancel an order.",
        "description": "Cancels an order with the given __voiceOrderID__. All telephone numbers tied to the given __voiceOrderID__ will be canceled.\n\n__Required fields:__\n```\nvoiceOrderID\n```\n\n__Note:__ The latest you can request a cancel transaction is by 11:00 PM GMT, one business day before the Firm Order Commit (FOC) date. \n",
        "operationId": "cancelOrderUsingNewPOST",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            },
            "example": "1-ABCDE"
          }
        ],
        "requestBody": {
          "description": "supplementOrderRequest",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TNCancelRequestNew"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted for processing.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceOrder"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "You are not authorized to view the resource."
          },
          "402": {
            "description": "The resource you created does not meet the data requirement(s)."
          },
          "403": {
            "description": "Accessing the resource you were trying to reach is forbidden."
          },
          "404": {
            "description": "The resource you were trying to reach was not found."
          }
        },
        "deprecated": false,
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
