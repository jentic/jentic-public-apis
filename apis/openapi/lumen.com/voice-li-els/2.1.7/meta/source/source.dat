    "/Voice/v1/Numbers/cancelBackOrder": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Cancel pending backorders.",
        "description": "Cancels all pending backorders associated with the given __voiceOrderID__.\n\n__Required fields:__\n```\nvoiceOrderID\n```\n\n__Note:__ This request will only cancel orders for telephone numbers not already added to inventory. To cancel backorders for a specific rate center and state combination, include the __rateCenter__ and __state__ fields in the request payload. See the example below.\n\n```\n{\n  \"voiceOrderId\": 1100221,\n  \"rateCenter\": \"DENVER\",\n  \"state\": \"CO\"\n}\n```\n",
        "operationId": "cancelBackOrderUsingPOST",
        "parameters": [
          {
            "name": "x-customer-number",
            "in": "header",
            "description": "customer number assigned by Lumen, also known as the BusOrg number.",
            "required": true,
