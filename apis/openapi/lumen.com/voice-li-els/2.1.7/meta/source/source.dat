      "Subscribers": {
        "title": "Subscribers",
        "type": "object",
        "properties": {
          "serviceID": {
            "type": "string",
            "description": "Unique identifier for the invoice item or billable service. You can find the serviceID on the invoice statement.",
            "example": "BCYX1234 - Voice Complete Only"
          },
          "locationID": {
            "type": "string",
            "description": "Location service ID - Voice Complete Only",
            "example": "BBPK4321 - Voice Complete Only"
          },
          "routeLabel": {
            "type": "string",
            "description": "Unique identifier of the individual Route Plans",
            "example": "Route Plan 1 - Voice Complete Only"
          },
          "billingAccountNumber": {
            "type": "string",
            "description": "Billing account number tied to the telephone number",
            "example": "1-ABCDEFGH"
          },
          "customerServiceName": {
            "type": "string",
            "description": "The customer service name (CSN) is a shortcut name for the IP trunks and addresses used for routing voice traffic on our network. For CSNs assigned to your account, please reference the enrollment form you received at the time of setup.",
            "example": "YOUR-CSN"
          },
          "e911Address": {
            "$ref": "#/components/schemas/E911Address"
          },
          "e911Option": {
            "type": "string",
            "description": "Valid values for ELS are: E_911_STANDARD, E_911_CUSTOMER_PROVIDED. Valid values for Voice Complete are: E_911_STANDARD, E_911_LYNC. E911 is not available for LI",
            "example": "E_911_STANDARD",
            "enum": [
              "E_911_STANDARD",
              "E_911_LYNC"
            ]
          },
          "serviceAddress": {
            "type": "string",
            "description": "Your service address represents the point where the Voice Complete service terminates",
            "example": "123 E yates Avenue,Denver,CO,12345,US"
          },
          "tnList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/tn"
            }
          }
        }
