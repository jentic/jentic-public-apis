      "portabilityAndRateCenters": {
        "title": "portabilityAndRateCenters",
        "type": "object",
        "properties": {
          "serviceAvailable": {
            "type": "string",
            "description": "Y indicates a valid matching address is found or a valid similar address is found, no errors are returned, and the single valid address is returned. N indicates the address is invalid, an error condition is generated, and 0 addresses are returned. In some cases, N will indicate that a range of similar addresses has been found and will be returned",
            "example": "Y"
          },
          "e911CoverageIndicator": {
            "type": "string",
            "description": "Y indicates the requested E-911Option is available. N indicates the requested E-911Option is unavailable",
            "example": "N"
          },
          "e911Disclaimer": {
            "type": "string",
            "description": "Disclaimer associated with chosen E-911Option",
            "example": "E-911 is not supported for LI products. "
          },
