  "components": {
    "schemas": {
      "portNow": {
        "title": "CreateVoiceOrderRequestPayload",
        "type": "object",
        "properties": {
          "parentOrderNumber": {
            "type": "string",
            "description": "Parent order number (PON)",
            "example": "900000583"
          },
          "tnList": {
            "type": "array",
            "description": "List of Tns",
            "items": {
              "$ref": "#/components/schemas/tn"
            }
          }
        }
      },
      "CreateVoiceOrderRequestPayload": {
        "title": "CreateVoiceOrderRequestPayload",
        "required": [
          "customerServiceName",
          "productID",
          "rateCenters"
        ],
        "type": "object",
        "properties": {
          "productID": {
            "type": "string",
            "description": "Lumen identification for a service.Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "example": "2036"
          },
          "rateCenters": {
            "type": "array",
            "description": "List of rate centers with telephone number quantity and state",
            "items": {
              "$ref": "#/components/schemas/RateCenter"
            }
          },
          "externalOrderID": {
            "type": "string",
            "description": "Customer External Order ID",
            "example": "Any String Value"
          },
          "customerServiceName": {
            "type": "string",
            "description": "The customer service name (CSN) is a shortcut name for the IP trunks and addresses used for routing voice traffic on our network. For CSNs assigned to your account, please reference the enrollment form you received at the time of setup.",
            "example": "YOUR-CSN"
          }
        }
      },
      "RateCenter": {
        "title": "RateCenter",
        "required": [
          "rateCenter",
          "state",
          "tnQuantity"
        ],
        "type": "object",
        "properties": {
          "rateCenter": {
            "type": "string",
            "description": "Rate center abbreviation",
            "example": "DENVER"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation",
            "example": "CO"
          },
          "tnQuantity": {
            "type": "integer",
            "description": "Requested telephone numbers quantity for given state and rate center",
            "format": "int32",
            "example": 10
          },
          "sequentialIndicator": {
            "type": "integer",
            "description": "Indicates sequential preference. Full sequential = 1. Best available sequential indicator = 2. If sequential is not required NULL",
            "format": "int32",
            "example": 1
          },
          "pbxIndex": {
            "type": "integer",
            "description": "PBX index indicates the digit in the 10 digit TN in which a specific value must be excluded. For example 5 indicates fifth digit from the left 123-456-7890. Indicate the value to be excluded using pbxValue.",
            "format": "int32",
            "example": 5
          },
          "pbxValue": {
            "type": "integer",
            "description": "PBX value that mush be excluded from the number as indicated in pbxIndex. For example 3 indicates the value 3 must be excluded from the 5th digit of the TN as indicated in PBXIndex example.",
            "format": "int32",
            "example": 3
          }
        }
      },
      "RateCenterInfoResponse": {
        "title": "RateCenterInfoResponse",
        "type": "object",
        "properties": {
          "rateCenterAbbrev": {
            "type": "string",
            "example": "Madrid"
          },
          "stateAbbrev": {
            "type": "string",
            "description": "State abbreviation",
            "example": "NY"
          },
          "lata": {
            "type": "string",
            "description": "Market code",
            "example": "136"
