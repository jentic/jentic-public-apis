      "CommonTNOrderRequest": {
        "title": "TNOrderRequest",
        "type": "object",
        "properties": {
          "productID": {
            "type": "integer",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "format": "int32",
            "example": 2042,
            "enum": [
              2036,
              2042
            ]
          },
          "customerRequestedDate": {
            "$ref": "#/components/schemas/customerRequestedDate"
          },
          "subscriberLineList": {
            "type": "array",
            "description": "List of subscriber line information",
            "items": {
              "$ref": "#/components/schemas/CommonELSSubscriberLine"
            }
          }
        },
        "description": "ELS TN Order Request",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseOrderRequest"
          },
          {
            "type": "object"
          }
        ]
      },
      "BaseOrderRequest": {
        "title": "BaseOrderRequest",
        "required": [
          "lnpIndicator",
          "productID",
          "subscriberLineList"
        ],
        "type": "object",
        "properties": {
          "productID": {
            "type": "integer",
            "description": "Lumen identification for a service. Valid values for Product ID are 2036 (Local Inbound - LI) and 2042 (Enhanced Local Service - ELS)",
            "format": "int32",
            "example": 2042,
            "enum": [
              2036,
              2042
            ]
          },
          "lnpIndicator": {
            "type": "string",
            "description": "LNP Indicator. Valid values are Y (LNP Order) and N (Native Order).",
            "example": "Y",
            "enum": [
              "Y",
              "N"
            ]
          },
          "externalOrderID": {
            "type": "string",
            "description": "Customer external order ID",
            "example": "OR000011"
          },
          "externalOrderVersion": {
            "type": "string",
            "description": "Customer external order version",
            "example": "OR000011"
          },
          "lnpProjectYN": {
            "type": "string",
            "description": "LNP lnpProjectYN. Valid values are Y and N.",
            "example": "Y",
            "enum": [
              "Y",
              "N"
            ]
          },
          "customerRequestedDate": {
            "type": "string",
            "description": "customer Requested Date",
            "example": "2020-11-21T21:43:24+00:00"
          },
          "customerNumber": {
            "type": "string",
            "description": "Customer number",
            "example": "1-ABCDE"
          },
          "subscriberLineList": {
            "type": "array",
            "description": "List of subscriber line information",
            "items": {
              "$ref": "#/components/schemas/LISubscriberLine"
            }
          },
          "comments": {
            "type": "string",
            "description": "comments",
            "example": "Order reason."
          }
        },
        "description": "LI TN Order Request"
      },
      "LISubscriberLine": {
        "title": "SubscriberLine",
        "type": "object",
        "properties": {
          "subscriber": {
            "$ref": "#/components/schemas/Subscriber"
          },
          "lspSubscriber": {
            "$ref": "#/components/schemas/Subscriber"
          },
          "e911Option": {
            "type": "string",
            "description": "Valid values for ELS are: E_911_STANDARD, E_911_CUSTOMER_PROVIDED. Valid values for Voice Complete are: E_911_STANDARD, E_911_LYNC. E911 is not available for LI",
            "example": "E_911_STANDARD",
            "enum": [
              "E_911_STANDARD",
              "E_911_CUSTOMER_PROVIDED"
            ]
          },
          "tnList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/tn"
            }
          },
          "ProductFeatureList": {
            "$ref": "#/components/schemas/LIProductFeatureList"
          },
          "orderMappingList": {
            "$ref": "#/components/schemas/LIOrderMappingList"
          }
        }
      },
      "Subscriber": {
        "title": "Subscriber",
        "type": "object",
        "properties": {
          "customerTypeIndicator": {
            "type": "string",
            "description": "Customer Type Indicator. Valid values are customerTypeIndicator are B (Business) and R (Residence). Maintained by Lumen at Subscriber Line level to support home-office scenarios, where both business and residential lines may exist",
            "example": "B",
            "enum": [
              "B",
              "R"
            ]
          },
          "businessName": {
            "type": "string",
            "description": "Required if subscriber has one or more subscriber lines where CustomerTypeIndicator = B. Invalid if customerTypeIndicator = R",
            "example": "B"
          },
          "firstName": {
            "type": "string",
            "description": "Required if subscriber has one or more subscriber lines where CustomerTypeIndicator = R. Invalid if customerTypeIndicator = B. <br/>Middle initial is to be included with first name in this format:\nFirst_M\n Titles are to be prepended to firstName.  For LNP orders partners are advised to use subscriber name as it appears in existing phone bills",
            "example": "First_N"
          },
          "middleInitial": {
            "type": "string",
            "description": "Required if subscriber has one or more subscriber lines\nwhere CTI = R. Invalid if CTI = B. Suffixes are to be appended to lastName. First + Middle +\nLast less than or equal to 25 chars\n",
            "example": "Last_N"
          },
          "lastName": {
            "type": "string",
            "description": "Required if subscriber has one or more subscriber lines\nwhere CTI = R. Invalid if CTI = B. Suffixes are to be appended to lastName. First + Middle +\nLast less than or equal to 25 chars\n",
            "example": "Last_N"
          },
          "externalSubscriberId": {
            "type": "string",
            "description": "Partner subscriber identifier, stored in Lumen systems for\npartner's reporting and querying purposes.",
            "example": "1234567890"
          },
          "serviceAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "e911Address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Address": {
        "title": "address",
