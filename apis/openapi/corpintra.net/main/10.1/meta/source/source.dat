{
  "info": {
    "contact": {
      "name": "STARC Support",
      "email": "starc-support@daimler.com"
    },
    "description": "Based on the codebeamer API version v3 with minor additions<p><b>Attention:</b> The base path for all requests is /starc/v3 (for intranet) and just /v3 (for internet)</p>",
    "version": "10.1",
    "title": "STARC API",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/EDMUNDMILKE/starc-api/10.1"
  },
  "paths": {
    "/starc/v3/trackers/{trackerId}/reports/{reportId}/items": {
      "get": {
        "operationId": "getTrackerReportItems",
        "summary": "Get report items of a specific tracker view",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportItemResult"
                }
              }
            },
            "description": "Tracker report items"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportItemResult"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportItemResult"
                }
              }
            },
            "description": "Tracker / Report not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "trackerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "reportId",
            "in": "path"
          },
          {
            "schema": {
              "default": 1,
              "type": "integer",
              "format": "int32"
            },
            "description": "Index of a report page starting from 1.",
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "default": 20,
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items a report page. Max value: 500",
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker report"
        ]
      }
    },
    "/starc/v3/traceability/items": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TraceabilityItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Tracker item list"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TraceabilityItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TraceabilityItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Tracker not found"
          }
        },
        "description": "Get traceability initial ids!",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items in a result page.",
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Index of the result page.",
            "required": false,
            "name": "pageNo",
            "in": "query"
          }
        ],
        "tags": [
          "Traceability"
        ],
        "summary": "Get initial ids",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TraceabilityInitialLevelFilter"
              }
            }
          }
        },
        "operationId": "getTraceabilityInitialItemIds"
      }
    },
    "/starc/v3/items/{itemId}": {
      "put": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Basic tracker item by id"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Request cannot be processed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Tracker / Field not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "description": "ext:updateTrackerItem.wiki",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": false,
            "name": "referenceItemId",
            "in": "query"
          },
          {
            "schema": {
              "enum": [
                "BEFORE",
                "AFTER",
                "BELOW"
              ],
              "type": "string"
            },
            "required": false,
            "name": "position",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker item"
        ],
        "summary": "Update tracker item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackerItem"
              }
            }
          }
        },
        "operationId": "updateTrackerItem"
      },
      "delete": {
        "operationId": "deleteTrackerItem",
        "summary": "Delete tracker item",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Basic tracker item by id"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Tracker not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          }
        ],
        "tags": [
          "Tracker item"
        ]
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Basic tracker item by id"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Tracker item not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": false,
            "name": "version",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": false,
            "name": "baselineId",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker item"
        ],
        "description": "API can be used for fetching basic information of a tracker item",
        "summary": "Get basic tracker item",
        "operationId": "getTrackerItem"
      }
    },
    "/starc/v3/wikipages/{wikiId}": {
      "delete": {
        "operationId": "deleteWikiPage",
        "summary": "Delete a wiki page by its ID",
        "responses": {
          "200": {
            "description": "The wiki page has been deleted successfully"
          },
          "400": {
            "description": "Request cannot be processed"
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "The wiki page does not exist, or the artifact is not a wiki page"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "ID of the wiki page",
            "required": true,
            "name": "wikiId",
            "in": "path"
          }
        ],
        "tags": [
          "Wiki"
        ]
      },
      "get": {
        "operationId": "getWikiPage",
        "summary": "Get wiki page",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WikiPage"
                }
              }
            },
            "description": "The wiki page"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WikiPage"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WikiPage"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WikiPage"
                }
              }
            },
            "description": "The wiki page does not exist, or the artifact is not a wiki page"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "ID of the wiki page",
            "required": true,
            "name": "wikiId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Version of the wiki page",
            "required": false,
            "name": "version",
            "in": "query"
          }
        ],
        "tags": [
          "Wiki"
        ]
      }
    },
    "/starc/v3/deployment": {
      "post": {
        "operationId": "uploadDeployment",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentModel"
              }
            }
          }
        },
        "summary": "Start a deployment process",
        "responses": {
          "200": {
            "description": "Deployment is executed"
          },
          "403": {
            "description": "Authentication is required"
          }
        },
        "tags": [
          "Deployment"
        ]
      }
    },
    "/starc/v3/trackers/{trackerId}/roles/{roleId}/permissions": {
      "put": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoleWithPermissions"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Tracker permissions are set"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoleWithPermissions"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoleWithPermissions"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Tracker / permission / roles not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "trackerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "roleId",
            "in": "path"
          }
        ],
        "tags": [
          "Tracker permission"
        ],
        "summary": "Set the tracker permissions for a specific role",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PermissionIdsRequest"
              }
            }
          }
        },
        "operationId": "updatePermission"
      },
      "delete": {
        "operationId": "removePermissions",
        "summary": "Removes all tracker permissions from a specific role",
        "responses": {
          "200": {
            "description": "Tracker permissions were removed."
          },
          "403": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Tracker/role is not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "trackerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "roleId",
            "in": "path"
          }
        ],
        "tags": [
          "Tracker permission"
        ]
      }
    },
