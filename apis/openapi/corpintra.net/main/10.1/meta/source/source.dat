            "type": "string"
          },
          "reference": {
            "type": "boolean"
          },
          "modelMap": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            }
          },
          "model": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "empty": {
            "type": "boolean"
          },
          "view": {
            "$ref": "#/components/schemas/View"
          }
        }
      },
      "TrackerReportSettings": {
        "required": [
          "cbQl",
          "columns",
