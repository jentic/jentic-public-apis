    "/starc/v3/items/{itemId}/children": {
      "put": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
            },
            "description": "First page of the new child list"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
