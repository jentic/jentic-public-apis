          },
          "skipAssociations": {
            "default": false,
            "type": "boolean",
            "description": "If true, then the Associations are not exported"
          },
          "skipTrackerItems": {
            "default": false,
            "type": "boolean",
            "description": "If true, then the Tracker Items are not exported"
