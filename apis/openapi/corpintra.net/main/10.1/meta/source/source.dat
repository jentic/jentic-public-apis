                    "$ref": "#/components/schemas/WorkflowTransition"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkflowTransition"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Tracker not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkflowTransition"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "trackerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The from status id filter for transitions.",
            "required": false,
            "name": "fromStatusId",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker"
        ]
      }
    },
    "/starc/v3/projects": {
      "get": {
        "operationId": "getProjects",
        "summary": "Get projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectReference"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Projects"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectReference"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectReference"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectReference"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Project not found"
          }
        },
        "tags": [
          "Project"
        ]
      }
    },
    "/starc/v3/attachments/{attachmentId}/history": {
      "get": {
        "operationId": "getAttachmentHistory",
        "summary": "Returns the change history of the specified attachment",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactRevisionSearchResult"
                }
              }
            },
            "description": "Attachment history"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestException"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceUnauthorizedException"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceForbiddenException"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceNotFoundException"
                }
              }
            },
            "description": "Attachment not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "attachmentId",
            "in": "path"
          },
          {
            "schema": {
              "default": 1,
              "type": "integer",
              "format": "int32"
            },
            "description": "Index of the result page starting from 1.",
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "default": 25,
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items in a result page. Max value: 500",
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "tags": [
          "Attachment"
        ]
      }
    },
    "/starc/v3/users/search": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserReferenceSearchResult"
                }
              }
            },
            "description": "Users"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserReferenceSearchResult"
                }
              }
            },
            "description": "Bad request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserReferenceSearchResult"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "parameters": [
          {
            "schema": {
              "default": 1,
              "type": "integer",
              "format": "int32"
            },
            "description": "Index of the result page starting from 1.",
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "default": 25,
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items in a result page. Max value: 500",
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "tags": [
          "User"
        ],
        "summary": "Search users",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserFilteringRequest"
              }
            }
          }
        },
        "operationId": "searchUsers"
      }
    },
    "/starc/v3/items/{itemId}/fields/tables/{tableFieldId}": {
      "put": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Basic tracker item by id"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Request cannot be processed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Authentication is required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Tracker / Field not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItem"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "tableFieldId",
            "in": "path"
          }
        ],
        "tags": [
          "Tracker item"
        ],
        "summary": "Update table field of tracker item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTrackerItemTableField"
              }
            }
          }
        },
        "operationId": "updateTableFieldTrackerItem"
      }
    },
    "/starc/v3/traceability/relations": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceabilityResult"
                }
              }
            },
            "description": "Traceability items list"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceabilityResult"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "description": "Get traceability item ids!",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items per level.",
            "required": false,
            "name": "itemsOnLevel",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items per item.",
            "required": false,
            "name": "itemsFromPreviousItem",
            "in": "query"
          }
        ],
        "tags": [
          "Traceability"
        ],
        "summary": "Get traceability level item ids",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TraceabilityLevelFilter"
              }
            }
          }
        },
        "operationId": "getTraceabilityLevelItemIds"
      }
    }
  },
  "servers": [
    {
      "url": "https://starc-backend-for-frontends-dev.run-caas.rd.corpintra.net/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "name": "STARC_SESSION",
        "in": "header"
      }
    },
    "schemas": {
      "DateField": {
        "type": "object",
        "description": "Date field",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractField"
          },
          {
            "type": "object",
            "properties": {
              "formula": {
                "type": "string",
                "description": "Formula value of a field"
              }
            }
          }
        ]
      },
      "ArtifactRevisionSearchResult": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Number of matched tracker items by the search criteria",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "description": "Index of the page",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "Size of the found page",
            "format": "int32"
          },
          "revisions": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRevision"
            },
            "type": "array",
            "description": "Found artifact revision"
          }
        },
        "description": "One page of artifact revisions."
      },
      "TrackerItemReviewConfig": {
        "type": "object",
        "properties": {
          "requiredApprovals": {
            "type": "integer",
            "description": "Number of approvals after which the review is considered approved",
            "format": "int32"
          },
          "requiredSignature": {
            "enum": [
              "NONE",
              "PASSWORD",
              "USERNAME_AND_PASSWORD"
            ],
            "type": "string",
            "description": "Whether the user has to provide its credentials to vote"
          },
          "requiredRejections": {
            "type": "integer",
            "description": "Number of rejections after which the review is considered rejected",
            "format": "int32"
          },
          "roleRequired": {
            "type": "boolean",
            "description": "Whether the reviewers have to chose in which of their roles do they want to vote"
          }
        },
        "description": "The configuration from which the review was created"
      },
      "AutoApplyTestStepReuses": {
        "type": "object",
        "properties": {
          "scanTestCaseLibraries": {
            "type": "boolean",
            "description": "If it scans/finds the duplicate Steps in Test Case libraries of the user? Note: that only Reusable Steps will be reused from these libraries!"
          },
          "testCases": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "type": "array",
            "description": "The Test Cases to find the duplicated steps inside: if these Test Cases has duplicated Steps these will be converted to Step-Reuses."
          }
        },
        "description": "Specifies which Test Cases are checked for duplicate Steps"
      },
      "UpdateTrackerItemField": {
        "type": "object",
        "properties": {
          "fieldValues": {
            "items": {
              "$ref": "#/components/schemas/AbstractFieldValue"
            },
            "type": "array",
            "description": "Fields of a tracker item"
          },
          "tableValues": {
            "items": {
              "$ref": "#/components/schemas/TableFieldValue"
            },
            "type": "array",
            "description": "Fields of a tracker item"
          }
        }
      },
      "BadRequestException": {
        "type": "object",
        "properties": {
          "resourceUri": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateTestRunRequest": {
        "type": "object",
        "properties": {
          "testSetIds": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "writeOnly": true,
            "type": "array"
          },
          "testSetRefs": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "type": "array",
            "description": "Test set ids to include into the test run"
          },
          "testCaseRefs": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "type": "array",
            "description": "Test case ids to include into the test run"
          },
          "testCaseIds": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "writeOnly": true,
            "type": "array"
          },
          "testRunModel": {
            "$ref": "#/components/schemas/TrackerItem"
          }
        },
        "description": "Request model to create a test run from multiple test cases or sets"
      },
      "ReportPermission": {
        "required": [
          "access",
          "project",
          "role"
        ],
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectReference"
          },
          "access": {
            "enum": [
              "NONE",
              "READ",
              "WRITE"
            ],
            "type": "string",
            "description": "Access level",
            "example": "READ"
          },
          "role": {
            "$ref": "#/components/schemas/RoleReference"
          }
        },
        "description": "Access permissions for the report."
      },
      "UrlField": {
        "type": "object",
        "description": "Url field",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractField"
          }
        ]
      },
      "Role": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of a role"
          },
          "id": {
            "minimum": 0,
            "type": "integer",
            "description": "Id of the entity",
            "format": "int32"
          },
          "descriptionFormat": {
            "enum": [
              "PlainText",
              "Html",
              "Wiki"
            ],
            "type": "string",
            "description": "Format of a role's description"
          },
          "name": {
            "type": "string",
            "description": "Name of the entity"
          }
        }
      },
      "InternalServerErrorException": {
        "type": "object",
        "properties": {
          "resourceUri": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "RedisConfig": {
        "description": "Persists config properties in redis for overriding",
        "type": "object",
        "properties": {
          "propertiesKey": {
            "type": "string"
          },
          "propertiesValue": {
            "type": "string"
          }
        },
        "title": "RedisConfig"
      },
      "ArtifactRevision": {
        "type": "object",
        "properties": {
          "modifiedBy": {
            "$ref": "#/components/schemas/UserReference"
          },
          "version": {
            "type": "integer",
            "description": "Version of the artifact",
            "format": "int32"
          },
          "modifiedAt": {
            "type": "string",
            "description": "The date when the entity was modified",
            "format": "date-time"
          },
          "id": {
            "minimum": 0,
            "type": "integer",
            "description": "Id of the entity",
            "format": "int32"
          },
          "changeSummary": {
            "type": "string",
            "description": "Summary of the change"
          }
        },
        "description": "Model for a specific version of an artifact"
      },
      "TextField": {
        "type": "object",
        "description": "Text field",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractField"
          },
          {
            "type": "object",
            "properties": {
              "formula": {
                "type": "string",
                "description": "Formula value of a field"
              },
              "max": {
                "type": "integer",
                "description": "Max length of value of a field",
                "format": "int32"
              },
              "min": {
                "type": "integer",
                "description": "Minimum length of value of a field",
                "format": "int32"
              }
            }
          }
        ]
      },
      "TableFieldValue": {
        "required": [
          "type"
        ],
        "type": "object",
        "description": "Value container of a table field",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractFieldValue"
          },
          {
            "type": "object",
            "properties": {
              "values": {
                "items": {
                  "items": {
                    "$ref": "#/components/schemas/AbstractFieldValue"
                  },
                  "type": "array",
                  "description": "Table values"
                },
                "type": "array",
                "description": "Table values"
              }
            }
          }
        ]
      },
      "ApplicationPasswordChange": {
        "description": "Password change object to update the batch-password of applications",
        "type": "object",
        "properties": {
          "batchPassword": {
            "type": "string",
            "description": "The batch password"
          }
        },
        "title": "ApplicationPasswordChange"
      },
      "UserGroupReference": {
        "type": "object",
        "description": "Reference to a user group",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractReference"
          }
        ]
      },
      "AbstractField": {
        "discriminator": {
          "propertyName": "type"
        },
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of a field"
          },
          "title": {
            "type": "string",
            "description": "Title of a field"
          },
          "mandatoryInStatuses": {
            "items": {
              "$ref": "#/components/schemas/ChoiceOptionReference"
            },
            "type": "array",
            "description": "List of statuses where the field is mandatory."
          },
          "trackerItemField": {
            "type": "string",
            "description": "Tracker item's field name for this field"
          },
          "valueModel": {
            "type": "string",
            "description": "Name of the updater/getter value model"
          },
          "hidden": {
            "type": "boolean",
            "description": "Visibility status of a field"
          },
          "type": {
            "type": "string",
            "description": "Type of a field"
          },
          "id": {
            "type": "integer",
            "description": "Id of a field",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Name of a field"
          }
        },
        "description": "Abstract field"
      },
      "ReferenceSearchResult": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Number of matched tracker items by the search criteria",
            "format": "int32"
          },
          "references": {
            "items": {
              "$ref": "#/components/schemas/AbstractReference"
            },
            "type": "array",
            "description": "Found references"
          },
          "page": {
            "type": "integer",
            "description": "Index of the page",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "Size of the found page",
            "format": "int32"
          }
        },
        "description": "One page of references."
      },
      "UpdateTrackerItemChildrenRequest": {
        "type": "object",
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/TrackerItemReference"
            },
            "type": "array",
            "description": "Child items to update"
          }
        },
        "description": "Tracker item child update request"
      },
      "ProjectSearchResult": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Number of matched tracker items by the search criteria",
            "format": "int32"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "description": "Found projects"
          },
          "page": {
            "type": "integer",
            "description": "Index of the page",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "Size of the found page",
            "format": "int32"
          }
        },
        "description": "One page of artifact revisions."
      },
      "ReportGroup": {
        "discriminator": {
          "propertyName": "type"
        },
        "type": "object",
        "properties": {
          "count": {
            "example": 32,
            "type": "number",
            "description": "Number of items in the group, if it has subgroups then the aggregated number of items.",
            "format": "double"
          },
          "groupingValueId": {
            "example": 2,
            "type": "integer",
            "description": "The id of the common value in the group, if it's available",
            "format": "int32"
          },
          "groupingValue": {
            "type": "string",
            "description": "The common value in the group, , if it's available",
            "example": "In progress"
          },
          "aggregates": {
            "items": {
              "$ref": "#/components/schemas/ReportAggregate"
            },
            "type": "array",
            "description": "List of the aggregate values with column id."
          },
          "header": {
            "type": "string",
            "description": "Grouping header",
            "example": "Status: In progress"
          },
          "type": {
            "type": "string",
            "description": "Type of the group.",
            "example": "row"
          }
        },
        "description": "A report group which can contain rows or other groups based on the type."
      },
      "TrackerItemRevision": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "description": "Tracker item version",
            "format": "int32"
          },
          "id": {
            "type": "integer",
            "description": "Tracker item id",
            "format": "int32"
          }
        },
        "description": "Tracker item revision identifier"
      },
      "IntegerField": {
        "type": "object",
        "description": "Integer field",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractField"
          },
          {
            "type": "object",
            "properties": {
              "formula": {
                "type": "string",
                "description": "Formula value of a field"
              },
              "max": {
                "type": "integer",
                "description": "Maximum value of a field",
                "format": "int32"
              },
              "min": {
                "type": "integer",
                "description": "Minimum value of a field",
                "format": "int32"
              }
            }
          }
        ]
      },
      "IncomingTrackerItemAssociation": {
        "type": "object",
        "description": "Association pointing to an item",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractTrackerItemReference"
          }
        ]
