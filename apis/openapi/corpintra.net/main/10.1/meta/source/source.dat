          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "default": 25,
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items in the result page. Max value: 500",
            "required": false,
            "name": "resultPageSize",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker item"
        ],
