            "description": "If true, then the Reports are not exported"
          },
          "skipBranches": {
            "default": false,
            "type": "boolean",
            "description": "If true, then the Branches are not exported"
          },
          "selectedTrackerIds": {
            "items": {
              "type": "integer",
              "description": "If this list is not empty then only the Trackers listed here are exported.é",
              "format": "int32"
            },
            "type": "array",
            "description": "If this list is not empty then only the Trackers listed here are exported.é"
          },
          "skipDocuments": {
            "default": false,
            "type": "boolean",
            "description": "If true, then the Documents are not exported"
          },
          "skipWikiPages": {
            "default": false,
            "type": "boolean",
