          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTrackerItemChildrenRequest"
              }
            }
          }
        },
        "operationId": "replaceChildrenOfTrackerItem"
      },
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "Child item reference with index"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "Request cannot be processed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          }
        ],
        "tags": [
          "Tracker item"
        ],
        "summary": "Add a child item to a tracker item",
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/TrackerItemRevision"
              }
            }
          }
        },
        "operationId": "addChildToTrackerItem"
      },
      "patch": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "New child item reference on the requested index"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "Request cannot be processed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemChildReference"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "enum": [
                "INSERT",
                "REPLACE",
                "REMOVE"
              ],
              "type": "string"
            },
            "required": true,
            "name": "mode",
            "in": "query"
          }
        ],
        "tags": [
          "Tracker item"
        ],
        "summary": "Patch the child item list of a tracker item",
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/TrackerItemChildReference"
              }
            }
          }
        },
        "operationId": "patchChildrenOfTrackerItem"
      },
      "get": {
        "operationId": "findTrackerItemChildren",
        "summary": "Get child items of a tracker item",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
            },
            "description": "List child items of a tracker item ordered by ordinal"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
            },
            "description": "Request cannot be processed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerItemReferenceSearchResult"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "required": true,
            "name": "itemId",
            "in": "path"
          },
          {
            "schema": {
              "default": 1,
              "type": "integer",
              "format": "int32"
            },
            "description": "Index of the result page starting from 1.",
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "default": 25,
              "type": "integer",
              "format": "int32"
            },
            "description": "Number of items in a result page. Max value: 500",
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "tags": [
