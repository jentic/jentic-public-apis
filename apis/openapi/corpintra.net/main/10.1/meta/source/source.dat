    "/auth": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "tags": [
          "authorization"
        ],
        "deprecated": false,
        "description": "The body you need to send is a json - the attribute \"client_type\" is optional and only used in very special cases.<br/><pre>{ \"application_id\": \"012345-12344-1234-1234-1234\", \"application_token\": \"Mxyxxjaghiussakbsdkdk\" }</pre><br/>After a successful login you will be redirected to a '/confirmed' url; at this point in time, you will find the session id in a cookie with the key 'STARC_SESSION'.<br/>If the login is not successful, this service will return an error code and an error message in json format<br/><b>For interactive clients:</b><br/>The service will return an redirect to an url which needs to be opened in a browser on client side. The browser will be redirected multiple times including the Daimler login form, where you need to provide your username and password.<br/>The last redirect will be to an url '/confirmed', which marks a successful login. The required session id is stored in and can be read read from a cookie with key 'STARC_SESSION' and will be returned as json in the response.<br/><b>For batch applications:</b><br>The call will be redirected directly to the '/confirmed' url which marks a successful login. The required session idis stored in and can be read read from a cookie with key 'STARC_SESSION' and will be returned as json in the response.",
        "summary": "Authenticate an application",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationData"
              }
            }
          },
          "description": "The id and token of the application"
        },
        "operationId": "prepareSessionUsingPOST"
      },
      "delete": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "tags": [
          "authorization"
        ],
        "deprecated": false,
        "description": "This invalidates the session given as 'STARC_SESSION' in the request header.",
        "summary": "Logout an application.",
        "operationId": "logoutUsingDELETE"
      }
    },
