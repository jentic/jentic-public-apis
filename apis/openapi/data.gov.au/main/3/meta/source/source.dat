{
  "openapi": "3.0.3",
  "info": {
    "title": "data.gov.au CKAN API",
    "description": "The Australian Government open data portal API, powered by CKAN. Provides access to thousands of Australian government datasets including geospatial, statistical, and administrative data.",
    "version": "3",
    "contact": {
      "name": "data.gov.au",
      "url": "https://data.gov.au/"
    },
    "x-jentic-source-url": "https://data.gov.au/data/api/3/action/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://data.gov.au/data/api/3",
      "description": "data.gov.au CKAN API v3"
    }
  ],
  "paths": {
    "/action/package_list": {
      "get": {
        "operationId": "packageList",
        "summary": "List all dataset names",
        "description": "Return a list of the names of the site's datasets (packages).",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of packages to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/package_show": {
      "get": {
        "operationId": "packageShow",
        "summary": "Get dataset details",
        "description": "Return the metadata of a dataset (package) and its resources.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with dataset details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanPackageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Dataset not found"
          }
        }
      }
    },
    "/action/package_search": {
      "get": {
        "operationId": "packageSearch",
        "summary": "Search datasets",
        "description": "Searches for datasets satisfying a given search criteria.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The solr query string. Use * for all datasets.",
            "schema": {
              "type": "string",
              "default": "*:*"
            }
          },
          {
            "name": "fq",
            "in": "query",
            "description": "Filter query to apply",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order, e.g., 'name asc', 'metadata_modified desc'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rows",
            "in": "query",
            "description": "Number of matching rows to return (default 10)",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Offset in the complete result for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "facet",
            "in": "query",
            "description": "Enable faceted results (true/false)",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "facet.field",
            "in": "query",
            "description": "Fields to facet upon. Can be specified multiple times.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "facet.limit",
            "in": "query",
            "description": "Maximum number of values per facet field",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "include_private",
            "in": "query",
            "description": "Include private datasets (requires auth)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/resource_show": {
      "get": {
        "operationId": "resourceShow",
        "summary": "Get resource details",
        "description": "Return the metadata of a resource.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id of the resource",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with resource details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResourceResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/action/resource_search": {
      "get": {
        "operationId": "resourceSearch",
        "summary": "Search resources",
        "description": "Search for resources satisfying a given search criteria.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "The search query in field:term format, e.g., name:csv",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "Field to sort results by",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/tag_list": {
      "get": {
        "operationId": "tagList",
        "summary": "List all tags",
        "description": "Return a list of the site's tags.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "A tag name query to search for",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_fields",
            "in": "query",
            "description": "Return full tag dictionaries instead of just names",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of tags",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/tag_show": {
      "get": {
        "operationId": "tagShow",
        "summary": "Get tag details",
        "description": "Return the details of a tag and all its datasets.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The name or id of the tag",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with tag details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Tag not found"
          }
        }
      }
    },
    "/action/group_list": {
      "get": {
        "operationId": "groupList",
        "summary": "List all groups",
        "description": "Return a list of the names of the site's groups.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field and order, e.g., 'name asc'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_fields",
            "in": "query",
            "description": "Return group dictionaries instead of just names",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of groups to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of groups",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/group_show": {
      "get": {
        "operationId": "groupShow",
        "summary": "Get group details",
        "description": "Return the details of a group.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the group",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_datasets",
            "in": "query",
            "description": "Include datasets in the group",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with group details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Group not found"
          }
        }
      }
    },
    "/action/organization_list": {
      "get": {
        "operationId": "organizationList",
        "summary": "List all organizations",
        "description": "Return a list of the names of the site's organizations.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field and order, e.g., 'name asc'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_fields",
            "in": "query",
            "description": "Return organization dictionaries instead of just names",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of organizations to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of organizations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/organization_show": {
      "get": {
        "operationId": "organizationShow",
        "summary": "Get organization details",
        "description": "Return the details of an organization.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the organization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_datasets",
            "in": "query",
            "description": "Include datasets in the organization",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with organization details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Organization not found"
          }
        }
      }
    },
    "/action/status_show": {
      "get": {
        "operationId": "statusShow",
        "summary": "Get site status",
        "description": "Return the site status including CKAN version, site title, and extension info.",
        "responses": {
          "200": {
            "description": "Successful response with site status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/recently_changed_packages_activity_list": {
      "get": {
        "operationId": "recentlyChangedPackagesActivityList",
        "summary": "List recently changed packages",
        "description": "Return the activity stream of all recently added or changed packages.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of activities to return (default 31)",
            "schema": {
              "type": "integer",
              "default": 31
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with activity list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/action/package_activity_list": {
      "get": {
        "operationId": "packageActivityList",
        "summary": "List package activity",
        "description": "Return a package's activity stream (changes over time).",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the package",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of activities to return",
            "schema": {
              "type": "integer",
              "default": 31
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with activity list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Package not found"
          }
        }
      }
    },
    "/action/group_package_show": {
      "get": {
        "operationId": "groupPackageShow",
        "summary": "List datasets in a group",
        "description": "Return the datasets (packages) of a group.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the group",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of datasets to return",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of datasets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Group not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CkanResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string",
            "description": "URL to the help documentation for this action"
          },
          "success": {
            "type": "boolean",
            "description": "Whether the request was successful"
          },
          "result": {
            "description": "The result data"
          }
        }
      },
      "CkanListResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CkanSearchResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Total number of matching results"
              },
              "sort": {
                "type": "string"
              },
              "facets": {
                "type": "object"
              },
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CkanPackage"
                }
              },
              "search_facets": {
                "type": "object"
              }
            }
          }
        }
      },
      "CkanPackageResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/CkanPackage"
          }
        }
      },
      "CkanResourceResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/CkanResource"
          }
        }
      },
      "CkanPackage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Dataset description"
          },
          "author": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "maintainer": {
            "type": "string"
          },
          "maintainer_email": {
            "type": "string"
          },
          "license_id": {
            "type": "string"
          },
          "license_title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "metadata_created": {
            "type": "string",
            "format": "date-time"
          },
          "metadata_modified": {
            "type": "string",
            "format": "date-time"
          },
          "num_resources": {
            "type": "integer"
          },
          "num_tags": {
            "type": "integer"
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CkanResource"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                }
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CkanResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "mimetype": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "last_modified": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "security": []
}
