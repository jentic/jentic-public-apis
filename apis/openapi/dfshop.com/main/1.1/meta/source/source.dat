{
  "openapi": "3.0.0",
  "info": {
    "version": "1.1",
    "title": "DfShop API",
    "description": "Dataforce Shop API",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DataforceCH/DfShop-API/1.1"
  },
  "servers": [
    {
      "url": "https://api.dfshop.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/v1/products": {
      "get": {
        "summary": "List all products",
        "description": "Returns a list of products for the current Store.",
        "tags": [
          "Products"
        ],
        "operationId": "products-list",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "$ref": "#/components/parameters/LangParam"
          },
          {
            "$ref": "#/components/parameters/ProductFilterParam"
          },
          {
            "in": "query",
            "name": "options_requires_variant",
            "schema": {
              "type": "boolean"
            },
            "description": "Returns any product with options (`has_options:true`) with at least one variant, even if it has no variants."
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProductList"
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/products/{product_id}": {
      "get": {
        "summary": "Retrieve a product",
        "description": "Returns product details. You can use product id:\n```\nGET /v1/products/1022R\n```",
        "tags": [
          "Products"
        ],
        "operationId": "show-product",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductParam"
          },
          {
            "$ref": "#/components/parameters/LangParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Product"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/products.csv": {
      "get": {
        "summary": "Get product data in csv format",
        "description": "Returns a csv file (semicolon-separated).",
        "tags": [
          "Products"
        ],
        "operationId": "products-csv",
        "parameters": [
          {
            "$ref": "#/components/parameters/LangParam"
          },
          {
            "$ref": "#/components/parameters/ProductFilterParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns CSV format. Please note, probably not all columns will be exported. It will be determined by the token settings.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "example": "product_key;variant_key;option_key;name;additional_name;variant_name;option_name;option_name_alt;product_description_short;product_description;product_description_video;stock_level;stock_text;stock_class;stock_quantity;last_stock;price;display_price;discount;display_discount;original_price;display_original_price;cost_price;cost_price_discount;cost_price_total;tax_rate;sku;barcode;sales_unit;weight;origin;packing_unit;packing_quantity;display_packing_unit;ext_link;display_ext_link;ext_link2;display_ext_link2;hexcolor1;hexcolor2;hexcolor3;image_url;brand_id;brand_name;season_id;season_name;season_year;category;category_alt;property[];variant_label;option_label;option_group"
                }
              }
            }
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/googlefeed.txt": {
      "get": {
        "summary": "Get google shopping feed",
        "description": "Returns a tab delimited file.",
        "tags": [
          "Products"
        ],
        "operationId": "products-googlefeed",
        "parameters": [
          {
            "$ref": "#/components/parameters/LangParam"
          },
          {
            "$ref": "#/components/parameters/ProductFilterParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns tab delimited content. Please note, probably not all columns will be exported. It will be determined by the token settings.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "example": "id  title   description   google product category  product type  link  image link  additional image link  condition  availability  price  sale price  sale price effective date  gtin  brand  mpn  item group id  gender  age group  color  size  identifier exists"
                }
              }
            }
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/inventory": {
      "get": {
        "summary": "List inventory data",
        "description": "",
        "tags": [
          "Inventory"
        ],
        "operationId": "inventory-list",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "$ref": "#/components/parameters/InventoryFilterParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InventoryList"
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/inventory/{product_id}": {
      "get": {
        "summary": "Get inventory data for a specific product",
        "description": "",
        "tags": [
          "Inventory"
        ],
        "operationId": "show-inventory",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InventoryList"
          }
        },
        "security": [
          {
            "ProductsHeaderToken": []
          },
          {
            "ProductsQueryToken": []
          }
        ]
      }
    },
    "/v1/orders": {
      "get": {
        "summary": "List all orders",
        "description": "Returns all orders placed by the current user in the current store.",
        "tags": [
          "Orders"
        ],
        "operationId": "orders-list",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "$ref": "#/components/parameters/OrderFilterParam"
          },
          {
            "in": "query",
            "name": "show_details",
            "schema": {
              "type": "boolean"
            },
            "description": "Returns the orders including **bill_address**, **ship_address** and **line_items**"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OrderList"
          }
        },
        "security": [
          {
            "OrdersHeaderToken": []
          },
          {
            "OrdersQueryToken": []
          }
        ]
      },
      "post": {
        "summary": "Create an order",
        "description": "Creates a new order.",
        "tags": [
          "Orders"
        ],
        "operationId": "create-order",
        "requestBody": {
          "$ref": "#/components/requestBodies/OrderPayload"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Order"
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "422": {
            "$ref": "#/components/responses/422UnprocessableEntity"
          }
        },
        "security": [
          {
            "OrdersHeaderToken": []
          },
          {
            "OrdersQueryToken": []
          }
        ]
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "summary": "Retrieve an order",
        "description": "Returns order details. You can use order id:\n```\nGET /v1/orders/1234\n```",
        "tags": [
          "Orders"
        ],
        "operationId": "show-order",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Order"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          }
        },
        "security": [
          {
            "OrdersHeaderToken": []
          },
          {
            "OrdersQueryToken": []
          }
        ]
      },
      "put": {
        "summary": "Update an order",
        "description": "Update an existing order. ",
        "tags": [
          "Orders"
        ],
        "operationId": "update-order",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/OrderPayload"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Order"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "422": {
            "$ref": "#/components/responses/422UnprocessableEntity"
          }
        },
        "security": [
          {
            "OrdersHeaderToken": []
          },
          {
            "OrdersQueryToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProductsHeaderToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DfApi-Token",
        "description": "Use this header **as an alternative** to the query parameter `token` to authenticate your request.\n**Only one of the two methods is required.**\n"
      },
      "OrdersHeaderToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DfApi-Token",
        "description": "Use this header **as an alternative** to the query parameter `token` to authenticate your request.\n**Only one of the two methods is required.**\n"
      },
      "ProductsQueryToken": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Use this query parameter **as an alternative** to the header `X-DfApi-Token` to authenticate your request.\n**Only one of the two methods is required.**\n"
      },
      "OrdersQueryToken": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Use this query parameter **as an alternative** to the header `X-DfApi-Token` to authenticate your request.\n**Only one of the two methods is required.**\n"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ProductWithVariantsAndOptions"
          },
          {
            "$ref": "#/components/schemas/ProductWithVariants"
          },
          {
            "$ref": "#/components/schemas/ProductWithOptions"
          },
          {
            "$ref": "#/components/schemas/ProductSimple"
          }
        ]
      },
      "ProductBase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1022R"
          },
          "key": {
            "type": "string",
            "example": "1022R"
          },
          "name": {
            "type": "string",
            "example": "T-Shirt for men"
          },
          "additional_name": {
            "type": "string",
            "example": "light"
          },
          "text": {
            "type": "string",
            "example": "Regular fit t-shirt."
          },
          "description": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Description"
            }
          },
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          },
          "price": {
            "type": "number",
            "example": 79.95
          },
          "display_price": {
            "type": "string",
            "example": "CHF 79.95"
          },
          "discount": {
            "type": "number",
            "example": 10
          },
          "display_discount": {
            "type": "string",
            "example": "-10%"
          },
          "original_price": {
            "type": "number",
            "example": 88.85
          },
          "display_original_price": {
            "type": "string",
            "example": "CHF 88.85"
          },
          "cost_price": {
            "type": "number",
            "example": 74.23
          },
          "sales_unit": {
            "type": "string",
            "example": "Stück"
          },
          "weight": {
            "type": "number",
            "example": 1.255
          },
          "origin": {
            "type": "string",
            "example": "CH"
          },
          "ext_link": {
            "type": "string",
            "example": "https://www.dfshop.com"
          },
          "display_ext_link": {
            "type": "string",
            "example": "Herstellerseite"
          },
          "ext_link2": {
            "type": "string",
            "example": "https://www.dataforce.ch"
          },
          "display_ext_link2": {
            "type": "string",
            "example": "Partnerseite"
          },
          "order_allowed": {
            "type": "boolean"
          },
          "modified_at": {
            "type": "string",
            "example": "2023-10-25T14:20:24.645"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Property"
            }
          }
        }
      },
      "ProductSimple": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductBase"
          },
          {
            "type": "object",
            "properties": {
              "has_variants": {
                "type": "boolean",
                "example": false
              },
              "has_options": {
                "type": "boolean",
                "example": false
              },
              "order_allowed": {
                "type": "boolean"
              },
              "sku": {
                "type": "string",
                "example": "1022R-38"
              },
              "packing_unit": {
                "type": "string",
                "example": "Pack"
              },
              "packing_quantity": {
                "type": "number",
                "example": 3
              },
              "display_packing_unit": {
                "type": "string",
                "example": "3 Stück/Pack"
              },
              "barcode": {
                "type": "string",
                "example": 7123456789123
              }
            }
          }
        ]
      },
      "ProductWithVariantsAndOptions": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductBase"
          },
          {
            "type": "object",
            "properties": {
              "has_variants": {
                "type": "boolean"
              },
              "variants_label": {
                "type": "string",
                "example": "Color"
              },
              "has_options": {
                "type": "boolean"
              },
              "options_label": {
                "type": "string",
                "example": "Size"
              },
              "options_group": {
                "type": "string",
                "example": "CM"
              },
              "order_allowed": {
                "type": "boolean"
              },
              "variants": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VariantWithOptions"
                }
              }
            }
          }
        ]
      },
      "ProductWithOptions": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductBase"
          },
          {
            "type": "object",
            "properties": {
              "has_variants": {
                "type": "boolean",
                "example": false
              },
              "has_options": {
                "type": "boolean"
              },
              "options_label": {
                "type": "string",
                "example": "Gr&ouml;sse"
              },
              "options_group": {
                "type": "string",
                "example": "CM"
              },
              "order_allowed": {
                "type": "boolean"
              },
              "sku": {
                "type": "string",
                "example": "1022R-38"
              },
              "packing_unit": {
                "type": "string",
                "example": "Pack"
              },
              "packing_quantity": {
                "type": "number",
                "example": 3
              },
              "display_packing_unit": {
                "type": "string",
                "example": "3 Stück/Pack"
              },
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Option"
                }
              }
            }
          }
        ]
      },
      "ProductWithVariants": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductBase"
          },
          {
            "type": "object",
            "properties": {
              "has_variants": {
                "type": "boolean"
              },
              "has_options": {
                "type": "boolean",
                "example": false
              },
              "order_allowed": {
                "type": "boolean"
              },
              "sku": {
                "type": "string",
                "example": "1022R-38"
              },
              "packing_unit": {
                "type": "string",
                "example": "Pack"
              },
              "packing_quantity": {
                "type": "number",
                "example": 3
              },
              "display_packing_unit": {
                "type": "string",
                "example": "3 Stück/Pack"
              },
              "variants": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VariantSimple"
                }
              }
            }
          }
        ]
      },
      "VariantBase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1022R-38"
          },
          "name": {
            "type": "string",
            "example": "Bottle Green"
          },
          "key": {
            "type": "string",
            "example": -38
          },
          "sku": {
            "type": "string",
            "example": "1022R-38"
          },
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "type": {
            "$ref": "#/components/schemas/Type"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          },
          "price": {
            "type": "number",
            "example": 79.95
          },
          "display_price": {
            "type": "string",
            "example": "CHF 79.95"
          },
          "discount": {
            "type": "number",
            "example": 10
          },
          "display_discount": {
            "type": "string",
            "example": "-10%"
          },
          "original_price": {
            "type": "number",
            "example": 88.85
          },
          "display_original_price": {
            "type": "string",
            "example": "CHF 88.85"
          },
          "cost_price": {
            "type": "number",
            "example": 74.23
          },
          "tier_price": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TierPrice"
            }
          },
          "packing_unit": {
            "type": "string",
            "example": "Pack"
          },
          "packing_quantity": {
            "type": "number",
            "example": 3
          },
          "display_packing_unit": {
            "type": "string",
            "example": "3 Stück/Pack"
          },
          "hexcolor": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "#008000"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        }
      },
      "VariantSimple": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VariantBase"
          },
          {
            "type": "object",
            "properties": {
              "barcode": {
                "type": "string",
                "example": 7123456789123
              }
            }
          }
        ]
      },
      "VariantWithOptions": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VariantBase"
          },
          {
            "type": "object",
            "properties": {
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Option"
                }
              }
            }
          }
        ]
      },
      "Option": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "002M-38_6"
          },
          "key": {
            "type": "number",
            "example": 6,
            "minimum": 1,
            "maximum": 22,
            "description": "option identifier, unique in compound with `product.options_group`"
          },
          "name": {
            "type": "string",
            "example": "XL",
            "description": "option value"
          },
          "alternate_name": {
            "type": "string",
            "example": 36,
            "description": "alternate option value or equivalent dimension value"
          },
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          },
          "barcode": {
            "type": "string",
            "example": 4023203782463
          },
          "price": {
            "type": "number",
            "example": 79.95
          },
          "display_price": {
            "type": "string",
            "example": "CHF 79.95"
          },
          "discount": {
            "type": "number",
            "example": 10
          },
          "display_discount": {
            "type": "string",
            "example": "-10%"
          },
          "original_price": {
            "type": "number",
            "example": 88.85
          },
          "display_original_price": {
            "type": "string",
            "example": "CHF 88.85"
          },
          "cost_price": {
            "type": "number",
            "example": 74.23
          }
        }
      },
      "TierPrice": {
        "type": "object",
        "properties": {
          "min_quantity": {
            "type": "number",
            "example": 10
          },
          "display_min_quantity": {
            "type": "string",
            "example": "ab 10 Stück"
          },
          "price": {
            "type": "number",
            "example": 75.95
          },
          "display_price": {
            "type": "string",
            "example": "CHF 75.95"
          },
          "cost_price": {
            "type": "number",
            "example": 70.51
          },
          "discount": {
            "type": "number",
            "example": 5
          },
          "display_discount": {
            "type": "string",
            "example": "-5%"
          }
        }
      },
      "Brand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Example Brand Ltd."
          }
        }
      },
      "Description": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "PDT"
          },
          "title": {
            "type": "string",
            "example": "Description"
          },
          "html": {
            "type": "string",
            "description": "Product description with HTML formatting.",
            "example": "<p>T-shirt for men.<br>Regular fit.<br>Slits at hem.<br>The 4-way stretch material stretches to all directions giving a maximum freedom of movement.</p>."
          },
          "text": {
