    "parameters": {
      "ProductParam": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "description": "The wished product id",
        "schema": {
          "type": "string"
        },
        "example": "1022R"
      },
      "ProductFilterParam": {
        "in": "query",
        "name": "q",
        "schema": {
          "type": "object",
          "properties": {
            "brand_id_eq": {
              "type": "string",
              "example": 1
            }
          }
        },
        "style": "deepObject",
        "explode": true,
        "description": "Filter the search result.\n\n*Syntax*:\n```\nq[<property>_<operator>]=<value>\n```\nSupported properties:\n- product_id\n- product_key\n- name\n- additional_name\n- text\n- modified_at\n- stock_level\n- stock_quantity\n- last_stock\n- brand_id\n\nSupported operators:\n- eq (equal)\n- not_eq (not equal)\n- matches \n- does_not_match\n- lt (less than)\n- lteq (less than or equal)\n- gt (greater than)\n- gteq (greater than or equal)\n- in (match any values in array)\n  e.g. q[currency_in][]=CHF&q[currency_in][]=EUR\n- not_in (match none of values in array)\n\n*Examples*:\n```\nq[brand_id_eq]=1\n```\n*List all products from the given brand*"
      },
      "InventoryFilterParam": {
        "in": "query",
        "name": "q",
        "schema": {
          "type": "object",
          "properties": {
            "brand_id_eq": {
              "type": "string",
              "example": 1
            }
          }
        },
        "style": "deepObject",
        "explode": true,
        "description": "Filter the search result.\n\n*Syntax*:\n```\nq[<property>_<operator>]=<value>\n```\nSupported properties:\n- modified_at\n- brand_id\n\nSupported operators:\n- eq (equal)\n- not_eq (not equal)\n- matches \n- does_not_match\n- lt (less than)\n- lteq (less than or equal)\n- gt (greater than)\n- gteq (greater than or equal)\n- in (match any values in array)\n  e.g. q[currency_in][]=CHF&q[currency_in][]=EUR\n- not_in (match none of values in array)\n\n*Examples*:\n```\nq[modified_at_gteq]=2024-06-01\n```\n*List inventory data that has changed since june 1, 2024*"
      },
      "LangParam": {
        "name": "lang",
        "in": "query",
        "description": "Requested language",
        "schema": {
          "type": "string",
          "enum": [
            "de",
            "fr",
            "it",
            "en"
          ]
        }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Number of requested page when paginating collection",
        "schema": {
          "type": "integer",
          "default": 1
        },
        "example": 1
      },
      "PerPageParam": {
        "name": "per_page",
        "in": "query",
        "description": "Number of requested records per page when paginating collection",
        "schema": {
          "type": "integer",
          "default": 25
        },
        "example": 25
      },
      "OrderParam": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "description": "ID of the requested order",
        "schema": {
          "type": "number",
          "example": 1234
        },
        "example": 1234
      },
      "OrderFilterParam": {
        "in": "query",
        "name": "q",
        "schema": {
          "type": "object",
          "properties": {
            "order_state_eq": {
              "type": "string",
              "example": "cart"
            },
            "created_at_gteq": {
              "type": "string",
              "example": "2019-01-01"
            },
            "created_at_lteq": {
              "type": "string",
              "example": "2019-01-15"
            }
          }
        },
        "style": "deepObject",
        "explode": true,
        "description": "Filter the search result.\n\n*Syntax*:\n```\nq[<property>_<operator>]=<value>\n```\nSupported properties:\n- order_id\n- order_number\n- customer_id\n- created_at\n- updated_at\n- delivery_date\n- currency\n- language_iso\n- department\n- total\n- adjustment_total\n- tax_total\n- ship_total\n- surcharge_total\n\nSupported operators:\n- eq (equal)\n- not_eq (not equal)\n- matches \n- does_not_match\n- lt (less than)\n- lteq (less than or equal)\n- gt (greater than)\n- gteq (greater than or equal)\n- in (match any values in array)\n  e.g. q[currency_in][]=CHF&q[currency_in][]=EUR\n- not_in (match none of values in array)\n\n*Examples*:\n```\nq[order_state_eq]=exported \n```\n*List all orders with state “exported”*\n```\nq[created_at_gteq]=2019-01-01&q[created_at_lteq]=2019-01-15\n```\n*List all orders which are created between the 1st and 15th january.*"
      }
    },
    "requestBodies": {
      "OrderPayload": {
        "required": true,
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string",
                  "example": "ABC1234",
                  "description": "order reference"
                },
                "order_state": {
                  "type": "string",
                  "example": "cart",
                  "description": "order status:\n * `cart` - order is in draft and can still be modified\n * `complete` - order is complete and ready for submission\n"
                },
                "acknowledge_state": {
                  "type": "number",
                  "example": 0,
                  "minimum": 0,
                  "maximum": 1,
                  "description": "can be used to confirm receipt"
