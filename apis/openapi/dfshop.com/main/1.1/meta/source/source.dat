            "type": "number",
            "example": 607.5,
            "description": "total invoice amount"
          },
          "display_total": {
            "type": "string",
            "example": "CHF 607.50",
            "description": "formatted total"
          },
          "adjustment_total": {
            "type": "number",
            "example": 292.5,
            "description": "total order adjustments"
          },
          "tax_total": {
            "type": "number",
            "example": 22.5,
            "description": "total tax amount"
          },
          "ship_total": {
            "type": "number",
            "example": 9.7,
            "description": "total ship amount"
          },
          "surcharge_total": {
            "type": "number",
            "example": 4.8,
            "description": "small surcharge amount"
          },
          "total_quantity": {
            "type": "number",
            "example": 123,
            "description": "total order quantity"
          }
        }
      },
      "OrderState": {
        "type": "string",
        "description": "Order state.\nAllowed values: * `cart` - order is in draft and can still be modified * `complete` - order is complete and ready for submission * `exported` - order has been submitted to the ERP / back office * `exported` - order was completely cancelled\nClients may only SEND the following values: - cart - complete\nThe following values are set exclusively by the server (read-only): - exported - cancelled\n",
        "enum": [
          "cart",
          "complete",
          "exported",
          "cancelled"
        ],
        "x-readonly-values": [
          "exported",
          "cancelled"
        ]
      },
