{
  "openapi": "3.0.3",
  "info": {
    "title": "Patrika AI Generated Articles API",
    "version": "1",
    "description": "API to ingest AI-generated articles.\n\nThis API accepts MULTIPLE articles in a single request.\n\nRules:\n- Maximum 5 articles per request\n- Images are allowed ONLY as Base64\n- Image URLs inside post_content are NOT allowed\n- featured_image must be Base64 only\n- Text-only content is allowed\n- Rate limit: 1 request per 10 seconds\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/patrika/API/1"
  },
  "servers": [
    {
      "url": "https://zimbea-develop.go-vip.net/wp-json"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/patrika/v1/ai-articles": {
      "post": {
        "tags": [
          "AI Articles"
        ],
        "summary": "Create AI-generated articles",
        "description": "Important:\n- The request body MUST be an array\n- Each array item represents ONE article\n- A maximum of 5 articles are allowed per request\n- Type : articles,breaking,images,trending\n\nValidation rules:\n- title, post_content and type are required\n- post_content may contain Base64 images or no images\n- Image URLs inside post_content are NOT allowed\n- featured_image must be Base64 only\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Array of AI article objects.\n\nYou can send:\n- 1 article\n- OR multiple articles (up to 5) in a single request\n",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "$ref": "#/components/schemas/AiArticle"
                }
              },
              "examples": {
                "singleArticle": {
                  "summary": "Single article payload",
                  "value": [
                    {
                      "title": "Single AI Article",
                      "alternate_title": "AI Revolution in Indian Media",
                      "post_content": "<p>Single article content</p>",
                      "type": "articles",
                      "excerpt": "Short summary",
                      "featured_image": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
                    }
                  ]
                },
                "multipleArticles": {
                  "summary": "Multiple articles payload",
                  "value": [
                    {
                      "title": "First AI Article",
                      "alternate_title": "AI Revolution in Indian Media",
                      "post_content": "<p>First content</p>",
                      "type": "breaking",
                      "excerpt": "First summary",
                      "featured_image": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
                    },
                    {
                      "title": "Second AI Article",
                      "alternate_title": "AI Revolution in Indian Media",
                      "post_content": "<p>Second content</p><img src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\" />",
                      "type": "trending",
                      "excerpt": "Second summary",
                      "featured_image": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Articles created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or more than 5 articles"
          },
          "401": {
            "description": "Authorization token missing"
          },
          "403": {
            "description": "Invalid API token"
          },
          "422": {
            "description": "Validation error (missing fields, invalid Base64, image URL not allowed)"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API_TOKEN"
      }
    },
    "schemas": {
      "AiArticle": {
        "type": "object",
        "required": [
          "title",
          "post_content",
          "type"
        ],
        "description": "Single AI article object.\n\nThis object represents ONE article.\nMultiple objects can be sent together as an array.\n",
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title",
            "example": "AI Generated Headline"
          },
          "post_content": {
            "type": "string",
            "description": "HTML content of the article.\n\nRules:\n- Images must be Base64 encoded\n- Image URLs are NOT allowed\n- Text-only content is allowed\n",
            "example": "<p>Content</p><img src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\" />"
          },
          "type": {
            "type": "string",
            "description": "Article category type",
            "enum": [
              "articles",
              "images",
              "breaking",
              "trending"
            ],
            "example": "breaking"
          },
          "excerpt": {
            "type": "string",
            "description": "Optional short summary of the article",
            "example": "This is a short excerpt shown in listings"
          },
          "alternate_title": {
            "type": "string",
            "description": "Optional alternate title",
            "example": "Alternate AI Headline"
          },
          "featured_image": {
            "type": "string",
            "description": "Base64 encoded image only.\n\nRules:\n- Must start with data:image/*\n- Image URLs are NOT allowed\n",
            "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "saved": {
            "type": "integer",
            "description": "Number of articles successfully saved",
            "example": 2
          },
          "post_ids": {
            "type": "array",
            "description": "WordPress post IDs created",
            "items": {
              "type": "integer"
            },
            "example": [
              123,
              124
            ]
          }
        }
      }
    }
  }
}
