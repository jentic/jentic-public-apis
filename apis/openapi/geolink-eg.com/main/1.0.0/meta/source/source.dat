{
  "openapi": "3.0.0",
  "info": {
    "title": "GeoLink Directions API",
    "description": "Fast, affordable routing API with real-time traffic, 40+ language support, and global coverage.\n\n**Key Features:**\n- ⚡ Sub-200ms response times\n- 🌍 Global routing coverage\n- 🚛 Truck routing with dimension constraints\n- 🗣️ 40+ language support\n- 💰 90% cheaper than Google Maps\n\n**Perfect for:**\n- Delivery and logistics apps\n- Fleet management systems\n- Travel planning applications\n- Store locators with directions\n- Last-mile optimization\n\n**Getting Started:**\n1. Subscribe to a plan\n2. Get your API key\n3. Make your first request\n4. Start building!\n",
    "version": "1.0.0",
    "contact": {
      "email": "support@geolink-api.com",
      "url": "https://docs.geolink-api.com"
    },
    "termsOfService": "https://geolink-api.com/terms",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/geolinkeg/geolink-directions/1.0.0"
  },
  "servers": [
    {
      "url": "https://geolink-eg.com/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/directions": {
      "get": {
        "summary": "Calculate route between two points",
        "description": "Get optimal routing directions between origin and destination with real-time traffic,\nturn-by-turn navigation, and distance/duration metrics.\n\n**Response includes:**\n- Route waypoints (lat/lng pairs)\n- Total distance (meters + formatted text)\n- Estimated duration (seconds + formatted text)\n- Bounds (for map fitting)\n- Full and short addresses for origin/destination\n",
        "operationId": "getDirections",
        "tags": [
          "Routing"
        ],
        "parameters": [
          {
            "name": "origin_latitude",
            "in": "query",
            "required": true,
            "description": "Starting point latitude (-90 to 90)",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -90,
              "maximum": 90
            },
            "example": 30.0621239
          },
          {
            "name": "origin_longitude",
            "in": "query",
            "required": true,
            "description": "Starting point longitude (-180 to 180)",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -180,
              "maximum": 180
            },
            "example": 31.2436662
          },
          {
            "name": "destination_latitude",
            "in": "query",
            "required": true,
            "description": "Destination latitude (-90 to 90)",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -90,
              "maximum": 90
            },
            "example": 30.0592759
          },
          {
            "name": "destination_longitude",
            "in": "query",
            "required": true,
            "description": "Destination longitude (-180 to 180)",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -180,
              "maximum": 180
            },
            "example": 31.2407176
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Response language (ISO 639-1 code). Supports 40+ languages including:\nar (Arabic), en (English), es (Spanish), fr (French), de (German), \nzh (Chinese), ja (Japanese), pt (Portuguese), ru (Russian), hi (Hindi)\n",
            "schema": {
              "type": "string",
              "default": "ar"
            },
            "example": "en"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country code (ISO 3166-1 alpha-2) for localized results",
            "schema": {
              "type": "string",
              "default": "eg"
            },
            "example": "us"
          },
          {
            "name": "alternatives",
            "in": "query",
            "required": false,
            "description": "Return multiple route alternatives (up to 3 routes)",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "example": true
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "description": "Your API key (provided after subscription)",
            "schema": {
              "type": "string"
            },
            "example": "your_api_key_here"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with route data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "distance": {
                            "type": "object",
                            "properties": {
                              "meters": {
                                "type": "integer",
                                "description": "Distance in meters",
                                "example": 814
                              },
                              "text": {
                                "type": "string",
                                "description": "Formatted distance with units",
                                "example": "0.8 km"
                              }
                            }
                          },
                          "duration": {
                            "type": "object",
                            "properties": {
                              "seconds": {
                                "type": "integer",
                                "description": "Duration in seconds",
                                "example": 201
                              },
                              "text": {
                                "type": "string",
                                "description": "Formatted duration",
                                "example": "3 minutes"
                              }
                            }
                          },
                          "bounds": {
                            "type": "object",
                            "properties": {
                              "northeast": {
                                "type": "object",
                                "properties": {
                                  "lat": {
                                    "type": "number",
                                    "example": 30.0627119
                                  },
                                  "lng": {
                                    "type": "number",
                                    "example": 31.2438739
                                  }
                                }
                              },
                              "southwest": {
                                "type": "object",
                                "properties": {
                                  "lat": {
                                    "type": "number",
                                    "example": 30.0584527
                                  },
                                  "lng": {
                                    "type": "number",
                                    "example": 31.2407176
                                  }
                                }
                              }
                            }
                          },
                          "origin": {
                            "type": "object",
                            "properties": {
                              "lat": {
                                "type": "number",
                                "example": 30.0621239
                              },
                              "lng": {
                                "type": "number",
                                "example": 31.2436662
                              },
                              "address": {
                                "type": "string",
                                "example": "123 Main Street, Cairo, Egypt"
                              },
                              "short_address": {
                                "type": "string",
                                "example": "Downtown Cairo"
                              }
                            }
                          },
                          "destination": {
                            "type": "object",
                            "properties": {
                              "lat": {
                                "type": "number",
                                "example": 30.0592759
                              },
                              "lng": {
                                "type": "number",
                                "example": 31.2407176
                              },
                              "address": {
                                "type": "string",
                                "example": "456 Oak Avenue, Cairo, Egypt"
                              },
                              "short_address": {
                                "type": "string",
                                "example": "City Center"
                              }
                            }
                          },
                          "waypoints": {
                            "type": "array",
                            "description": "Route path as [lat, lng] coordinate pairs",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            "example": [
                              [
                                30.0621239,
                                31.2436662
                              ],
                              [
                                30.0624077,
                                31.2438739
                              ]
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid coordinates provided"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid API key"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Rate limit exceeded. Upgrade your plan."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "x-code-samples": [
          {
            "lang": "cURL",
            "source": "curl --request GET \\\n  --url 'https://geolink-eg.com/api/directions?origin_latitude=30.0621239&origin_longitude=31.2436662&destination_latitude=30.0592759&destination_longitude=31.2407176&alternatives=true&key=YOUR_API_KEY' \\\n  --header 'X-RapidAPI-Host: geolink-directions.p.rapidapi.com' \\\n  --header 'X-RapidAPI-Key: YOUR_RAPIDAPI_KEY'\n  \n"
          },
          {
            "lang": "Python",
            "source": "import requests\n\nurl = \"https://geolink-eg.com/api/directions\"\n\nquerystring = {\n    \"origin_latitude\": \"30.0621239\",\n    \"origin_longitude\": \"31.2436662\",\n    \"destination_latitude\": \"30.0592759\",\n    \"destination_longitude\": \"31.2407176\",\n    \"alternatives\": \"true\",\n    \"key\": \"YOUR_API_KEY\"\n}\n\nheaders = {\n    \"X-RapidAPI-Key\": \"YOUR_RAPIDAPI_KEY\",\n    \"X-RapidAPI-Host\": \"geolink-directions.p.rapidapi.com\"\n}\n\nresponse = requests.get(url, headers=headers, params=querystring)\nprint(response.json())\n"
          },
          {
            "lang": "JavaScript",
            "source": "const options = {\n  method: 'GET',\n  headers: {\n    'X-RapidAPI-Key': 'YOUR_RAPIDAPI_KEY',\n    'X-RapidAPI-Host': 'geolink-directions.p.rapidapi.com'\n  }\n};\n\nfetch('https://geolink-eg.com/api/directions?origin_latitude=30.0621239&origin_longitude=31.2436662&destination_latitude=30.0592759&destination_longitude=31.2407176&alternatives=true&key=YOUR_API_KEY', options)\n  .then(response => response.json())\n  .then(data => console.log(data))\n  .catch(err => console.error(err));\n"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Routing",
      "description": "Calculate optimal routes between locations"
    }
  ]
}
