{
  "openapi": "3.0.3",
  "info": {
    "title": "FreelanceHub API",
    "description": "REST API for **FreelanceHub** – a freelance marketplace platform.\nThis API covers the full **Client → Job Post** workflow as modelled in the\nFreelanceHub UI, including authentication, dashboard statistics, multi-step\njob creation (title/category/description → skills/experience → budget/timeline),\nreview, publishing, and proposal management.\n\n## Auth\nAll protected endpoints require a Bearer JWT token obtained from `POST /auth/login`.\n\n## Job-post lifecycle\n```\ndraft (POST /jobs)\n  │\n  ├─ patch fields (PATCH /jobs/{jobId})\n  │\n  └─ publish (POST /jobs/{jobId}/publish)\n        │\n        └─ active  ──►  closed\n```\n",
    "version": "1.0.0",
    "contact": {
      "name": "FreelanceHub Engineering",
      "email": "api@freelancehub.io"
    },
    "license": {
      "name": "MIT"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/buet-983/freelancehub-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.freelancehub.io/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration, login and token management"
    },
    {
      "name": "Clients",
      "description": "Client profile and dashboard"
    },
    {
      "name": "Jobs",
      "description": "Job-post creation, editing and publishing"
    },
    {
      "name": "Proposals",
      "description": "Freelancer proposals on a job"
    },
    {
      "name": "Reference",
      "description": "Static reference data (categories, skills)"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user account",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "email": "jane.doe@example.com",
                "password": "S3cur3P@ss!",
                "fullName": "Jane Doe",
                "role": "client"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate and receive a JWT",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "jane.doe@example.com",
                "password": "S3cur3P@ss!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Invalidate the current JWT",
        "operationId": "logoutUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange a refresh token for a new access token",
        "operationId": "refreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/clients/{clientId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/clientId"
        }
      ],
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "Get client profile",
        "operationId": "getClient",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Client profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Clients"
        ],
        "summary": "Update client profile",
        "operationId": "updateClient",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated client profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/clients/{clientId}/dashboard": {
      "parameters": [
        {
          "$ref": "#/components/parameters/clientId"
        }
      ],
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "Get client dashboard statistics",
        "description": "Returns summary stats shown on the Client Dashboard – active jobs, total spend, active contracts, and average response time.",
        "operationId": "getClientDashboard",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardStats"
                },
                "example": {
                  "activeJobs": 3,
                  "totalSpent": 12450.0,
                  "activeContracts": 5,
                  "avgResponseTimeHours": 2.5
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "List job posts",
        "description": "Returns a paginated list of job posts. Clients see their own posts; publicly visible published posts are available without auth.",
        "operationId": "listJobs",
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "active",
                "closed"
              ]
            },
            "description": "Filter by job status"
          },
          {
            "name": "clientId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by owning client"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by category name"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of job posts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create a new job post (draft)",
        "description": "Creates the job post in **draft** status.\nThe multi-step flow in the UI builds up the payload across Steps 1–3 and\nPOSTs the complete object at the end of Step 3 or when saving progress.\n",
        "operationId": "createJob",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              },
              "example": {
                "title": "Build a responsive e-commerce website",
                "category": "Web Development",
                "description": "We need a professional React developer to build a fully responsive e-commerce platform integrated with Stripe payments and a CMS backend. The site must be mobile-first...",
                "skills": [
                  "React",
                  "Node.js",
                  "TypeScript",
                  "MongoDB"
                ],
                "experienceLevel": "intermediate",
                "projectScope": "medium",
                "budgetType": "fixed",
                "budgetMin": 3000,
                "budgetMax": 5000,
                "duration": "1-3 months"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job post created as draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/jobId"
        }
      ],
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Get a single job post",
        "operationId": "getJob",
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Job post detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Jobs"
        ],
        "summary": "Update a job post (Step 1 / 2 / 3 partial saves)",
        "description": "Partially updates a job that is still in **draft** status.\nUse this endpoint to persist each step's data independently,\nmatching the multi-step form flow (Step 1 → Step 2 → Step 3).\n",
        "operationId": "updateJob",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobUpdateRequest"
              },
              "examples": {
                "step1": {
                  "summary": "Save Step 1 – Job Details",
                  "value": {
                    "title": "Senior React Developer for SaaS Dashboard",
                    "category": "Web Development",
                    "description": "Looking for an experienced React developer to build a modern analytics dashboard with real-time data visualisation and role-based access control..."
                  }
                },
                "step2": {
                  "summary": "Save Step 2 – Skills & Experience",
                  "value": {
                    "skills": [
                      "React",
                      "TypeScript",
                      "AWS",
                      "Docker"
                    ],
                    "experienceLevel": "expert",
                    "projectScope": "large"
                  }
                },
                "step3": {
                  "summary": "Save Step 3 – Budget & Timeline",
                  "value": {
                    "budgetType": "hourly",
                    "hourlyRate": 65,
                    "duration": "3-6 months"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated job post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Job is already published and cannot be edited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "delete": {
        "tags": [
          "Jobs"
        ],
        "summary": "Delete a job post",
        "operationId": "deleteJob",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Job deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/jobs/{jobId}/publish": {
      "parameters": [
        {
          "$ref": "#/components/parameters/jobId"
        }
      ],
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Publish a draft job post",
        "description": "Transitions the job from **draft** → **active** and makes it visible to\nfreelancers. Corresponds to the \"Publish Job Post\" CTA on Step 4 (Review screen).\nReturns `422` if required fields are missing.\n",
        "operationId": "publishJob",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Job published and now active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "Job is incomplete and cannot be published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}/close": {
      "parameters": [
        {
          "$ref": "#/components/parameters/jobId"
        }
      ],
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Close an active job post",
        "description": "Transitions the job from **active** → **closed**, stopping new proposals.",
        "operationId": "closeJob",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Job closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/jobs/{jobId}/proposals": {
      "parameters": [
        {
          "$ref": "#/components/parameters/jobId"
        }
      ],
      "get": {
        "tags": [
          "Proposals"
        ],
        "summary": "List proposals for a job",
        "description": "Returns all freelancer proposals submitted against the given job. Only the owning client can access this endpoint.",
        "operationId": "listProposals",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "shortlisted",
                "rejected",
                "hired"
              ]
            },
            "description": "Filter proposals by status"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of proposals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/proposals/{proposalId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/proposalId"
        }
      ],
      "get": {
        "tags": [
          "Proposals"
        ],
        "summary": "Get a single proposal",
        "operationId": "getProposal",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/proposals/{proposalId}/shortlist": {
      "parameters": [
        {
          "$ref": "#/components/parameters/proposalId"
        }
      ],
      "post": {
        "tags": [
          "Proposals"
        ],
        "summary": "Shortlist a proposal",
        "operationId": "shortlistProposal",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal shortlisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/proposals/{proposalId}/reject": {
      "parameters": [
        {
          "$ref": "#/components/parameters/proposalId"
        }
      ],
      "post": {
        "tags": [
          "Proposals"
        ],
        "summary": "Reject a proposal",
        "operationId": "rejectProposal",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "Budget does not align with our requirements."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposal rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "List all job categories",
        "description": "Returns the static list of job categories rendered in the Step 1 category dropdown.",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Array of category objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                },
                "example": [
                  {
                    "id": "cat_web_dev",
                    "name": "Web Development"
                  },
                  {
                    "id": "cat_mobile_dev",
                    "name": "Mobile Development"
                  },
                  {
                    "id": "cat_design",
                    "name": "Design & Creative"
                  },
                  {
                    "id": "cat_writing",
                    "name": "Writing & Content"
                  },
                  {
                    "id": "cat_marketing",
                    "name": "Marketing & Sales"
                  },
                  {
                    "id": "cat_data",
                    "name": "Data Science & Analytics"
                  },
                  {
                    "id": "cat_it",
                    "name": "IT & Networking"
                  },
                  {
                    "id": "cat_customer",
                    "name": "Customer Service"
                  },
                  {
                    "id": "cat_admin",
                    "name": "Admin & Support"
                  },
                  {
                    "id": "cat_engineering",
                    "name": "Engineering & Architecture"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/skills/suggestions": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "Get suggested / popular skills",
        "description": "Returns the popular skills list shown in the Step 2 skill-tag selector.",
        "operationId": "getSkillSuggestions",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optionally filter suggestions by job category name"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Partial skill name for autocomplete"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of skill suggestion strings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": [
                  "React",
                  "Node.js",
                  "Python",
                  "JavaScript",
                  "TypeScript",
                  "UI/UX Design",
                  "Figma",
                  "WordPress",
                  "SEO",
                  "Content Writing",
                  "Graphic Design",
                  "Vue.js",
                  "AWS",
                  "Docker",
                  "MongoDB"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT obtained from `POST /auth/login`"
      }
    },
    "parameters": {
      "clientId": {
        "name": "clientId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Unique identifier of the client",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "jobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Unique identifier of the job post",
        "example": "7c9e6679-7425-40de-944b-e07fc1f90ae7"
      },
      "proposalId": {
        "name": "proposalId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Unique identifier of the proposal",
        "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "fullName",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "example": "S3cur3P@ss!"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "freelancer"
            ],
            "example": "client"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "S3cur3P@ss!"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT (15 min)"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived refresh token (7 days)"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Access token TTL in seconds",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "freelancer"
            ]
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        }
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "initials": {
            "type": "string",
            "description": "2-letter avatar initials (derived)",
            "example": "JD"
          },
          "companyName": {
            "type": "string",
            "nullable": true,
            "example": "Acme Corp"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "example": "New York, USA"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClientUpdateRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "activeJobs": {
            "type": "integer",
            "description": "Number of currently active job posts",
            "example": 3
          },
          "totalSpent": {
            "type": "number",
            "format": "double",
            "description": "Total USD spent across all contracts",
            "example": 12450.0
          },
          "activeContracts": {
            "type": "integer",
            "description": "Number of ongoing contracts",
            "example": 5
          },
          "avgResponseTimeHours": {
            "type": "number",
            "format": "double",
            "description": "Average time (hours) for the client to respond to proposals",
            "example": 2.5
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "closed"
            ],
            "description": "Lifecycle state of the job post"
          },
          "title": {
            "type": "string",
            "example": "Build a responsive e-commerce website"
          },
          "category": {
            "type": "string",
            "example": "Web Development"
          },
          "description": {
            "type": "string",
            "minLength": 50,
            "example": "We need a professional React developer to build a fully responsive e-commerce platform..."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "React",
              "Node.js",
              "TypeScript"
            ]
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "entry",
              "intermediate",
              "expert"
            ],
            "example": "intermediate"
          },
          "projectScope": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ],
            "description": "small = < 1 month, medium = 1-3 months, large = 3+ months",
            "example": "medium"
          },
          "budgetType": {
            "type": "string",
            "enum": [
              "fixed",
              "hourly"
            ],
            "example": "fixed"
          },
          "budgetMin": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Minimum fixed-price budget in USD (only when budgetType = fixed)",
            "example": 3000
          },
          "budgetMax": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Maximum fixed-price budget in USD (only when budgetType = fixed)",
            "example": 5000
          },
          "hourlyRate": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Maximum hourly rate in USD (only when budgetType = hourly)",
            "example": 65
          },
          "duration": {
            "type": "string",
            "enum": [
              "Less than 1 week",
              "1-2 weeks",
              "2-4 weeks",
              "1-3 months",
              "3-6 months",
              "More than 6 months"
            ],
            "example": "1-3 months"
          },
          "proposalCount": {
            "type": "integer",
            "description": "Total number of proposals received",
            "example": 12
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobCreateRequest": {
        "type": "object",
        "required": [
          "title",
          "category",
          "description",
          "skills",
          "experienceLevel",
          "projectScope",
          "budgetType",
          "duration"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "example": "Build a responsive e-commerce website"
          },
          "category": {
            "type": "string",
            "example": "Web Development"
          },
          "description": {
            "type": "string",
            "minLength": 50,
            "example": "We need a professional React developer..."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "example": [
              "React",
              "Node.js",
              "TypeScript"
            ]
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "entry",
              "intermediate",
              "expert"
            ],
            "example": "intermediate"
          },
          "projectScope": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ],
            "example": "medium"
          },
          "budgetType": {
            "type": "string",
            "enum": [
              "fixed",
              "hourly"
            ],
            "example": "fixed"
          },
          "budgetMin": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Required when budgetType = fixed",
            "example": 3000
          },
          "budgetMax": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Required when budgetType = fixed",
            "example": 5000
          },
          "hourlyRate": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Required when budgetType = hourly",
            "example": null
          },
          "duration": {
            "type": "string",
            "enum": [
              "Less than 1 week",
              "1-2 weeks",
              "2-4 weeks",
              "1-3 months",
              "3-6 months",
              "More than 6 months"
            ],
            "example": "1-3 months"
          }
        }
      },
      "JobUpdateRequest": {
        "type": "object",
        "description": "All fields are optional – send only the fields being updated (per-step partial save).",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 50
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "entry",
              "intermediate",
              "expert"
            ]
          },
          "projectScope": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "budgetType": {
            "type": "string",
            "enum": [
              "fixed",
              "hourly"
            ]
          },
          "budgetMin": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "budgetMax": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "hourlyRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "duration": {
            "type": "string",
            "enum": [
              "Less than 1 week",
              "1-2 weeks",
              "2-4 weeks",
              "1-3 months",
              "3-6 months",
              "More than 6 months"
            ]
          }
        }
      },
      "JobListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "freelancerId": {
            "type": "string",
            "format": "uuid"
          },
          "freelancerName": {
            "type": "string",
            "example": "Alex Kim"
          },
          "freelancerAvatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "coverLetter": {
            "type": "string",
            "example": "I have 7 years of experience building React applications..."
          },
          "bidAmount": {
            "type": "number",
            "format": "double",
            "description": "Proposed rate (fixed total or hourly rate) in USD",
            "example": 4200
          },
          "estimatedDuration": {
            "type": "string",
            "example": "2-3 months"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "shortlisted",
              "rejected",
              "hired"
            ],
            "example": "pending"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProposalListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Proposal"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cat_web_dev"
          },
          "name": {
            "type": "string",
            "example": "Web Development"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 47
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "JOB_ALREADY_PUBLISHED"
          },
          "message": {
            "type": "string",
            "example": "This job post has already been published and cannot be modified."
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "The request body contains invalid or missing fields."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "description"
                },
                "message": {
                  "type": "string",
                  "example": "Must be at least 50 characters."
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid authentication token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "UNAUTHORIZED",
              "message": "Authentication token is missing or invalid."
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated user does not have permission",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "FORBIDDEN",
              "message": "You do not have permission to access this resource."
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "NOT_FOUND",
              "message": "The requested resource could not be found."
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource already exists",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "CONFLICT",
              "message": "A user with this email address already exists."
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
