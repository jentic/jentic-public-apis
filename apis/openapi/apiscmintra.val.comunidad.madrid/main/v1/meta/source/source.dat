  "paths": {
    "/trabajos/{uuid_trabajo}": {
      "get": {
        "summary": "Devuelve un trabajo",
        "description": "Devuelve un trabajo\n",
        "tags": [
          "trabajos (consultas)"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          },
          {
            "$ref": "#/components/parameters/uuid_trabajo_param"
          },
          {
            "$ref": "#/components/parameters/standard_select_param"
          },
          {
            "$ref": "#/components/parameters/standard_exclude_param"
          },
          {
            "$ref": "#/components/parameters/standard_expand_param"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/trabajo_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR",
              "JAPI_SC_CONSULTA"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      },
      "put": {
        "summary": "Modifica un trabajo, su dirección o asignaturas",
        "description": "Permite modificar un trabajo, su dirección o asignaturas.\n### códigos de error del método:\n| código | Error |\n| -- | -- |\n| 2xxx | Pendiente |\n### Este endpoint es un ejemplo de\n- PUT normal de un recurso\n- En este caso se pueden modificar los datos del trabajo, así como la dirección y asignaturas asociadas por médio de sus id's (id_pagina e asignaturas_id)\n- Dado que el POST crea un trabajo sin asignaturas es con el PUT como se pueden añadir asignaturas al trabajos\n- Validación de negocio - Una asignatura no puede tener más de 5 trabajos, por lo que al añadir una asignatura se hace esta comprobación\n- El NIF no se ha incluido de forma deliberada, porque no queremos que se pueda modificar\n",
        "tags": [
          "trabajos (modificación)"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/put_trabajo_body_param"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/uuid_trabajo_param"
          },
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/trabajo_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      },
      "delete": {
        "summary": "Elimina un trabajo (baja lógica)",
        "description": "Hace una baja lógica de un trabajo.\n### Este endpoint es un ejemplo de:\n- DELETE lógico de un recurso porque existe el campo FC_BAJA_FILA\n",
        "tags": [
          "trabajos (modificación)"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          },
          {
            "$ref": "#/components/parameters/uuid_trabajo_param"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/standard_delete_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_trabajo"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      }
    },
    "/trabajos": {
      "post": {
        "summary": "Crea un recurso trabajo",
        "description": "Da de alta un trabajo.\n### Códigos de error del método:\n| código | Error |\n| -- | -- |\n|2001|Fecha de nacimiento incorrecta. Valores válidos del año 1900 al actual|\n|2004|NIF no válido\n### Este endpoint es un ejemplo de\n- POST normal de un recurso\n- Validaciones personalidadas (NIF, o Fecha) que se tienen que hacer a mano\n- Siempre hay que indicar los posibles errores de negocio en el Swagger\n- En los responses de las paginas se calcula a mano los literales de provincia y municipio\n- En este ejemplo en el POST se crea el trabajo sin asignaturas. Si se quieren añadir asignaturas al trabajo se hará con el PUT\n",
        "tags": [
          "trabajos (modificación)"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/post_trabajo_body_param"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          }
        ],
        "responses": {
          "201": {
            "$ref": "#/components/responses/post_trabajo_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      }
    },
    "/paginas": {
      "post": {
        "summary": "Da de alta una nueva dirección",
        "description": "Da de alta una nueva dirección.\n### Este endpoint es un ejemplo de\n- Un recurso que se crea sobre una tabla JAPI_pagina que tiene:\n  - PK sobre id_pagina, y que es autogenerada\n  - Una FK compuesta: id_provincia, id_municipio (ambas de la tabla JAPI_MUNICIPIO)\n- Tiene una restricción UNIQUE sobre cuatro de sus campos: id_pagina, id_provincia, id_municipio, id_via (y ninguno puede ser null)\n",
        "tags": [
          "paginas (modificación)"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/post_pagina_body_param"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          }
        ],
        "responses": {
          "201": {
            "$ref": "#/components/responses/post_pagina_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      }
    },
    "/paginas/{id_pagina}": {
      "get": {
        "summary": "Devuelve una dirección por su id",
        "description": "Devuelve una dirección.\nPermite usar $select, $exclude, $expand\n### Este endpoint es un ejemplo de\n- un recurso con solo dos endpoints de consulta básicos\n",
        "tags": [
          "paginas (consultas)"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id_pagina_param"
          },
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          },
          {
            "$ref": "#/components/parameters/standard_select_param"
          },
          {
            "$ref": "#/components/parameters/standard_exclude_param"
          },
          {
            "$ref": "#/components/parameters/standard_expand_param"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/pagina_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      },
      "put": {
        "summary": "Modifica una dirección",
        "description": "Permite modificar una dirección\n### códigos de error del método:\n| código | Error |\n| -- | -- |\n| 2xxx | Pendiente |\n### Este endpoint es un ejemplo de\n- PUT de un recurso normal, con id (PK) simple: id_pagina, pero tiene una relación con \"municipio\" que es una FK compuesta: id_provincia, id_municipio\n- No se puede modificar la PK \"id_pagina\", pero si el resto: id_provincia, id_municipio, id_via, calle, numero\n",
        "tags": [
          "paginas (modificación)"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/put_pagina_body_param"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/id_pagina_param"
          },
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/post_pagina_response"
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      },
      "delete": {
        "summary": "Elimina una dirección",
        "description": "Elimina una dirección.\n### Este endpoint es un ejemplo de:\n- Borrado lógico de un recurso normal, con id (PK) simple: id_pagina, pero tiene una relación con \"municipio\" que es una FK compuesta: id_provincia, id_municipio\n- No se utiliza el standard_delete_response, pues no se devuelve \"uuid\"  o \"id\", ya que en este caso a su id queremos llamarle 'id_pagina'.\n\nLa respuesta incluye el id de la dirección eliminada: id_pagina.\n",
        "tags": [
          "paginas (modificación)"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id_pagina_param"
          },
          {
            "$ref": "#/components/parameters/standard_trace_id_header_param"
          }
        ],
        "responses": {
          "200": {
            "description": "Recurso pagina eliminado correctamente",
            "headers": {
              "x-trace-id": {
                "description": "Cabecera de rastreo de petición",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/standard_response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id_pagina": {
                              "type": "integer",
                              "format": "int32",
                              "description": "Identificador de la pagina eliminada",
                              "example": "1111"
                            }
                          }
                        }
                      }
                    }
                  ],
                  "example": {
                    "result": {
                      "status": true,
                      "http_code": 200,
                      "info": "Solicitud realizada con éxito",
                      "trace_id": "123456abcde"
                    },
                    "data": {
                      "id_pagina": 1031
                    }
                  }
                },
                "examples": {
                  "Ejemplo 1": {
                    "value": {
                      "result": {
                        "status": true,
                        "http_code": 200,
                        "info": "Solicitud realizada con éxito",
                        "trace_id": "123456abcde"
                      },
                      "data": {
                        "id_pagina": 1031
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/standard_bad_request_response"
          },
          "401": {
            "$ref": "#/components/responses/standard_unauthorized_response"
          },
          "403": {
            "$ref": "#/components/responses/standard_forbidden_response"
          },
          "404": {
            "$ref": "#/components/responses/standard_not_found_response"
          },
          "429": {
            "$ref": "#/components/responses/standard_too_many_requests_response"
          },
          "default": {
            "$ref": "#/components/responses/standard_server_error_response"
          }
        },
        "security": [
          {
            "default": [
              "JAPI_SC_ADMIN",
              "JAPI_SC_GESTOR"
            ]
          }
        ],
        "x-throttling-tier": "MDPolAvan100TPMinuto",
        "x-auth-type": "Application & Application User",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      }
    }
  },
  "components": {
    "parameters": {
      "standard_init_param": {
        "in": "query",
        "name": "$init",
        "description": "Registro inicial deseado\n* Valor mínimo: 0\n* Valor máximo: Número total de registros\n",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 0,
          "minimum": 0
        },
        "example": 0
      },
      "standard_limit_param": {
        "in": "query",
        "name": "$limit",
        "description": "Número máximo de registros a mostrar por página\n* Valor mínimo: 1\n",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "default": 25
        },
        "example": 25
      },
      "standard_total_param": {
        "in": "query",
        "name": "$total",
        "description": "Indica si se deben calcular y devolver los atributos _total_ y _total_pages_ en el objeto _metadata.paging_ de la respuesta estándar.\n",
        "schema": {
          "type": "boolean",
          "default": false
        },
        "example": true
      },
      "standard_select_param": {
        "in": "query",
        "name": "$select",
        "description": "Permite seleccionar los atributos del recurso que se desean obtener en la consulta.\nSe recomienda su uso cuando sólo se desea obtener unos pocos atributos de un recurso complejo.\nPuede especificarse como un array de atributos. Ver estándar de definición de APIs.\n",
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "example": [
          "id",
          "nombre",
          "tipo"
        ]
      },
      "standard_exclude_param": {
        "in": "query",
        "name": "$exclude",
        "description": "Permite excluir determinados atributos del recurso.\nSe recomienda su uso cuando se desea excluir algunos atributos de un recurso complejo.\nPuede especificarse como un array de atributos. Ver estándar de definición de APIs.\n",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "example": [
          "id",
          "tipo"
        ]
      },
      "standard_expand_param": {
        "in": "query",
        "name": "$expand",
        "description": "Indica una lista de subatributos que se desea expandir.\nPuede especificarse como un array de atributos. Ver estándar de definición de APIs.\n",
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "example": [
          "subcategoria",
          "nombre_tipo"
        ]
      },
      "standard_order_by_param": {
        "in": "query",
        "name": "$orderby",
        "description": "Permite indicar los criterios de ordenación de una consulta.\nEl formato a utilizar será un signo + ó - para indicar si es\nascendente o descendente seguido del nombre de la columna o campo por el que se ordena.\n",
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "example": [
          "-date"
        ]
      },
      "standard_trace_id_header_param": {
        "in": "header",
        "name": "x-trace-id",
        "description": "Cabecera indicando el id de traceo de la petición.\nDebe ser una cadena aleatoria basada en timestamp.\n",
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "12345abcde"
          }
        }
      },
      "uuid_trabajo_param": {
        "in": "path",
        "name": "uuid_trabajo",
        "description": "UUID del trabajo (en el path)",
        "schema": {
          "$ref": "#/components/schemas/uuid"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "62977d46-7a50-41c9-8d84-38272ac2a8df"
          }
        }
      },
      "id_trabajo_query_param": {
        "in": "query",
        "name": "id_trabajo",
        "description": "Identificador del trabajo a filtrar (en la query)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "example": 1164
      },
      "id_asignatura_param": {
        "in": "path",
        "name": "id_asignatura",
        "description": "Identificador de la asignatura a obtener (en el path)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": 1009
          }
        }
      },
      "id_asignatura_query_param": {
        "in": "query",
        "name": "id_asignatura",
        "description": "Identificador de la asignatura a obtener (en la query)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "example": 1009
      },
      "curso_query_param": {
        "in": "query",
        "name": "curso",
        "description": "Curso por el que filtrar",
        "schema": {
          "type": "string",
          "maxLength": 4
        },
        "examples": {
          "Ejemplo 1": {
            "value": "2022"
          }
        }
      },
      "edad_query_param": {
        "in": "query",
        "name": "edad",
        "description": "Edad por la que filtrar",
        "schema": {
          "type": "string",
          "maxLength": 2
        },
        "examples": {
          "Ejemplo 1": {
            "value": "16"
          }
        }
      },
      "id_pagina_param": {
        "in": "path",
        "name": "id_pagina",
        "description": "Identificador de la dirección a obtener (en el path)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": 1031
          }
        }
      },
      "id_provincia_param": {
        "in": "path",
        "name": "id_provincia",
        "schema": {
          "type": "string",
          "maxLength": 2
        },
        "description": "Identificador de la provincia",
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "28"
          }
        }
      },
      "id_municipio_param": {
        "in": "path",
        "name": "id_municipio",
        "schema": {
          "type": "string",
          "maxLength": 3
        },
        "description": "Identificador del municipio",
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "092"
          }
        }
      },
      "id_solicitud_beca_param": {
        "in": "path",
        "name": "id_solicitud_beca",
        "description": "Identificador de la solicitud de beca a obtener (en el path)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": 2
          }
        }
      },
      "id_solicitud_beca_query_param": {
        "in": "query",
        "name": "id_solicitud_beca",
        "description": "Identificador de la solicitud de beca (en la query)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "required": true,
        "example": 1
      },
      "id_adjunto_param": {
        "in": "path",
        "name": "id_adjunto",
        "description": "Identificador del adjunto de una solicitud de beca (en el path)",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": 1020
          }
        }
      },
      "id_file_param": {
        "in": "path",
        "name": "id_file",
        "description": "Identificador de fichero (en el path)",
        "schema": {
          "type": "string"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": 1
          }
        }
      },
      "file_name_query_param": {
        "in": "query",
        "name": "file_name",
        "description": "Nombre a dar al fichero descargado",
        "schema": {
          "type": "string"
        },
        "example": "fichero"
      },
      "mime_type_query_param": {
        "in": "query",
        "name": "mime_type",
        "description": "Tipo MIME a emplear en la respuesta",
        "schema": {
          "type": "string"
        },
        "example": "application/pdf"
      },
      "storage_type_param": {
        "in": "query",
        "name": "storage_type",
        "description": "Tipo de guardado",
        "schema": {
          "type": "string"
        },
        "example": "COMPARTIDO"
      },
      "cabecera_numero_1_param": {
        "in": "header",
        "name": "cabecera_numero_1",
        "description": "Cabecera de prueba 1. Obligatoria\n",
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "12345abcde"
          }
        }
      },
      "cabecera_numero_2_param": {
        "in": "header",
        "name": "cabecera_numero_2",
        "description": "Cabecera de prueba 2. Opcional. Con valores un ejemplo de valores permitidos\n",
        "schema": {
          "type": "string",
          "maxLength": 100,
          "enum": [
            "valor1",
            "valor2",
            "valor3"
          ]
        },
        "examples": {
          "Ejemplo 1": {
            "value": "valor1"
          }
        }
      },
      "querystring_numero_1_param": {
        "in": "query",
        "name": "query_string_1",
        "description": "QueryString de prueba 1. Opcional\n",
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "examples": {
          "Ejemplo 1": {
            "value": "valor1"
          }
        }
      },
      "querystring_numero_2_param": {
        "in": "query",
        "name": "query_string_2",
        "description": "QueryString de prueba 2. Obligatoria\n",
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "valor2"
          }
        }
      },
      "nombre_trabajo_param": {
        "in": "path",
        "name": "nombre_trabajo",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "examples": {
          "Ejemplo 1": {
            "value": "Tomás"
          }
        }
      },
      "fecha_nacimiento_trabajo_param": {
        "in": "path",
        "name": "fecha_nacimiento_trabajo",
        "required": true,
        "schema": {
          "type": "string",
          "format": "date"
        },
        "examples": {
          "Ejemplo 1": {
            "value": "1980-02-09"
          }
        }
      },
      "captcha_response_header_param": {
        "in": "header",
        "name": "captcha_response",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "Ejemplo 1": {
