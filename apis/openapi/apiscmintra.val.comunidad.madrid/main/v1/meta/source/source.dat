      "post_put_solicitud_body_param": {
        "description": "Alta o modificación de una solicitud",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "id_trabajo": {
                  "type": "integer",
                  "format": "int32",
                  "description": "identificador del trabajo que hace la solicitud",
                  "example": 1002
                },
                "fecha_solicitud": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de la nota. Fecha ISO 8061 en formato yyyy-MM-ddTHH:mm:ss",
                  "example": "2021-01-25T11:50:59"
                },
                "tipo_solicitud": {
                  "type": "string",
                  "maxLength": 1,
                  "description": "Tipo de solicitud",
                  "example": "N"
                },
                "observaciones": {
                  "type": "string",
                  "maxLength": 2600,
                  "description": "Observaciones que pueda meter el trabajo al hacer la solicitud",
                  "example": "Observaciones de la solicitud..."
                }
              }
            },
            "examples": {
              "Ejemplo 1": {
