      },
      "s3_key_query_param": {
        "in": "query",
        "name": "s3_key",
        "description": "Clave S3 del fichero",
        "schema": {
          "type": "string"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "DES/JAPI_S3_TEMP_03/00000000-0000-0000-0000-000000000000/documento.pdf"
          }
        }
      },
      "sg_caducidad_query_param": {
        "in": "query",
        "name": "sg_caducidad",
        "description": "Caducidad del URL en segundos",
        "schema": {
          "type": "integer"
        },
        "required": false,
        "examples": {
          "Ejemplo 1": {
            "value": 300
          }
        }
      },
      "id_fica_param": {
        "in": "path",
        "name": "id_fica",
        "description": "ID interno del fichero FICA",
        "schema": {
          "type": "string"
        },
        "required": true,
        "examples": {
          "Ejemplo 1": {
            "value": "1234567"
          }
        }
      }
    },
    "schemas": {
      "standard_response": {
        "description": "Respuesta estándar cuando un recurso devuelve un solo elemento\nDebe usarse en los recursos que consultan o modifican un recurso por su identificador.\nTambién debe usarse en las respuestas de error aunque no devuelvan datos del recurso.\nEn esta plantilla dichas respuestas son reutilizables y ya referencian este modelo.\n",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/standard_response_result"
          }
        ],
        "required": [
          "result"
        ]
      },
      "standard_response_with_metadata": {
        "description": "Respuesta estándar cuando un recurso devuelve una lista de elementos\nDebe usarse en los recursos que devuelven listados paginados cumplimentando el objeto metadata.\nEn los errores se aplica la misma política que en los endpoints que devuelven un solo recurso.\n",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/standard_response_result"
          },
          {
            "$ref": "#/components/schemas/standard_response_metadata"
          }
        ],
        "required": [
          "result"
        ]
      },
      "standard_response_result": {
        "description": "Objeto result que tienen que devolver todos los recursos, correctos o incorrectos.\nLos campos que SIEMPRE se devolverán en este objeto son status, http_code y trace_id.\nEl uso del resto de campos está descrito brevemente en sus propias descripciones, pero debe\nconsultarse el estándar de definición de APIs de MD para más información.\n",
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "type": "boolean",
                "description": "Resultado de éxito o error de la operación",
                "example": true
              },
              "http_code": {
                "type": "integer",
                "format": "int32",
                "description": "Código http de la respuesta.",
                "example": 200
              },
              "info": {
                "type": "string",
                "description": "Breve mensaje indicando si la operación fue exitosa o no.",
                "example": "Solicitud realizada con éxito."
              },
              "errors": {
                "type": "array",
                "description": "Array de errores. Opcional. Se usará cuando se haya producido al menos un error, pudiéndose especificar tódos los que se hayan producido.",
                "items": {
                  "$ref": "#/components/schemas/standard_error"
                }
              },
              "stack_trace": {
                "type": "array",
                "description": "Array que recoge los errores en caso de que sea necesario facilitar la depuración. Solo se incluirá en el entorno de desarrollo.",
                "items": {
                  "type": "object",
                  "properties": {
                    "method_name": {
                      "type": "string",
                      "description": "Método",
                      "example": "readJavaType"
                    },
                    "file_name": {
                      "type": "string",
                      "description": "Nombre del archivo",
                      "example": "archivo.java"
                    },
                    "line_number": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Número de línea",
                      "example": 36
                    },
                    "class_name": {
                      "type": "string",
                      "description": "Clase",
                      "example": "org.springframework.http.converter.json.AbstractJackson2HttpMessageConverter"
                    },
                    "native_method": {
                      "type": "boolean",
                      "description": "Método nativo",
                      "example": false
                    }
                  }
                }
              },
              "trace_id": {
                "type": "string",
                "description": "Identificador de la petición en el sistema de logging para facilitar la depuración de errores. Contenido de la cabecera x-trace-id.",
                "example": "b8240028-8df4-4019-8b03-182a0a9bc88d"
              },
              "updated_elements": {
                "type": "integer",
                "format": "int32",
                "description": "Número de elementos borrados o modificados cuando se reciben llamadas con métodos PUT o DELETE sobre varios recursos. Obligatorio para borrados lógicos.",
                "example": 0
              }
            },
            "required": [
              "status",
              "http_code",
              "trace_id"
            ]
          }
        }
      },
      "standard_response_metadata": {
        "description": "Este objeto se usa en respuestas paginadas. Está incluido en el modelo de respuesta estándar con metadatos\nstandard_response_with_metadata, por lo que no es necesario referenciarlo directamente.\n",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "paging": {
                "$ref": "#/components/schemas/standard_paging"
              }
            }
          }
        }
      },
      "standard_error": {
        "description": "Modelo de error estándar a usar cuando se rellena el array de errores.\nYa está referenciado en la respuesta estándar.\n",
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "Codigo de error devuelto por la API. Se especificarán códigos de errores controlados. En el caso de errores no controlados se especificará si es posible. De lo contrario se deberá indicar un código 500.",
            "example": 1003
          },
          "message": {
            "type": "string",
            "description": "Descripción textual del error devuelto",
            "example": "Atributo con valor superior al máximo"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "standard_paging": {
        "description": "Modelo de objeto paginación usado en la respuesta estándar con metadatos.\nIncluye la información sobre paginación y se devuelve en todas las respuestas paginadas.\n",
        "type": "object",
        "properties": {
          "init": {
            "type": "integer",
            "format": "int32",
            "description": "Registro inicial de la página.",
            "example": 3
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Tamaño de página.",
            "example": 5
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "description": "Número total de registros.",
            "example": 35
          },
          "num_page": {
            "type": "integer",
            "format": "int32",
            "description": "Número de la página actual.",
            "example": 2
          },
          "total_pages": {
            "type": "integer",
            "format": "int32",
            "description": "Número total de páginas.",
            "example": 7
          },
          "links": {
            "type": "object",
            "properties": {
              "self": {
                "description": "Enlace a la propia página devuelta.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/standard_paging_link"
                  }
                ]
              },
              "previous": {
                "description": "Enlace a la página previa",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/standard_paging_link"
                  }
                ]
              },
              "next": {
                "description": "Enlace a la página siguiente.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/standard_paging_link"
                  }
                ]
              },
              "first": {
                "description": "Enlace a la primera página.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/standard_paging_link"
                  }
                ]
              },
              "last": {
                "description": "Enlace a la última página.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/standard_paging_link"
                  }
                ]
              }
            },
            "required": [
              "next",
              "previous",
              "self"
            ]
          }
        },
        "required": [
          "init",
          "limit",
          "links"
        ]
      },
      "standard_paging_link": {
        "description": "Modelo de enlace referenciado en el modelo de paginación.",
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "description": "Enlace codificado en html.",
            "example": "https://apis.comunidad.madrid/ciencia-tecnologia/test-api/v1/resources?$init=15&amp;$limit=5"
          }
        }
      },
      "standard_status_endpoint_system_object": {
        "description": "Modelo de objeto de sistema para el endpoint de monitorización.",
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "description": "Nombre del sistema probado",
            "example": "Database"
          },
          "status": {
            "type": "boolean",
            "description": "Estado del sistema probado",
            "example": true
          }
        }
      },
      "standard_status_endpoint_request_object": {
        "description": "Modelo de objeto de petición para el endpoint de monitorización.",
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "description": "Recurso de la API al que se ha hecho la llamada",
            "example": "/users"
          },
          "response": {
            "type": "integer",
            "format": "int32",
            "description": "Código http de la respuesta obtenida",
            "example": 200
          }
        }
      },
      "standard_filter_value": {
        "description": "Modelo de valor de objeto de filtrado.\nConsiste en un par clave-valor que indica un criterio para realizar el filtrado.\n",
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "description": "Nombre de la propiedad (columna de BBDD)",
            "example": "property_1"
          },
          "prop_type": {
            "type": "string",
            "description": "Tipo de dato",
            "enum": [
              "STRING",
              "INTEGER",
              "FLOAT",
              "DATE",
              "DATETIME",
              "BOOLEAN"
            ],
            "example": "STRING"
          },
          "prop_value": {
            "type": "string",
            "description": "Valor de la propiedad.",
            "example": "value_1"
          },
          "prop_values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array de valores a usar como rango"
          },
          "$filter": {
            "$ref": "#/components/schemas/standard_filter_object_base"
          }
        }
      },
      "standard_filter_object": {
        "type": "object",
        "description": "Modelo de objeto de filtrado.\nParámetro que indica los criterios para una consulta compleja.\nPermite realizar operaciones AND, OR, mayor o igual, substring, like, etc\n",
        "properties": {
          "operation": {
            "type": "string",
            "description": "Operación a realizar",
            "example": "LT",
            "enum": [
              "AND",
              "OR",
              "GT",
              "LT",
              "GTEQ",
              "LTEQ",
              "EQ",
              "NEQ",
              "IN",
              "BETWEEN",
              "SUBSTRING",
              "LIKE",
              "ILIKE",
              "NLIKE",
              "REGEXP"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/standard_filter_value"
            }
          }
        }
      },
      "standard_filter_object_base": {
        "description": "Este objeto permite anidar (concatenar) filtros para realizar consultas más complejas.\nSu implementación es la misma que se refleja en la definición de standard_filter_object.\n",
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "description": "Operación a realizar",
            "example": "LT",
            "enum": [
              "AND",
              "OR",
              "GT",
              "LT",
              "GTEQ",
              "LTEQ",
              "EQ",
              "NEQ",
              "IN",
              "BETWEEN",
              "SUBSTRING",
              "LIKE",
              "ILIKE",
              "NLIKE",
              "REGEXP"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Este objeto es el mismo que se refleja en la definición de standard_filter_value.\nPermite concatenar valores para el filtro. Su tipo es el mismo que dicho objeto,\naunque aquí esté definido como string para evitar referencias circulares.\n"
            }
          }
        }
      },
      "uuid": {
        "description": "Modelo para identificadores basados en UUID",
        "type": "string",
        "format": "uuid",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        "example": "62977d46-7a50-41c9-8d84-38272ac2a8df"
      },
      "trabajo": {
        "description": "trabajo con su dirección y asignaturas y algunos campos calculados que no está directamente en la tabla trabajos como edad y número de asignaturas aprobadas\n",
        "type": "object",
        "properties": {
          "idExternoRpa": {
            "type": "string",
            "format": "uuid",
            "description": "identificador único del trabajo",
            "example": "cf4a8327-f969-4415-81fb-c5346befb80c"
          },
          "idEstadoTrabajo": {
            "type": "integer",
            "description": "estado del trabajo",
            "example": 1
          },
          "fechaCreacion": {
            "type": "string",
            "maxLength": 30
          },
          "pathFicheroOrigen": {
            "type": "string",
            "maxLength": 500
          },
          "numeroPaginas": {
            "type": "integer"
          },
          "paginasProcesadas": {
            "type": "integer"
          },
          "paginasConError": {
            "type": "integer"
          },
          "score": {
            "type": "integer"
          },
          "metadatosDocumento": {
            "type": "string"
          }
        },
        "required": [
          "idExternoRpad",
          "idEstadoTrabajo",
          "pathFicheroOrigen"
        ]
      },
      "asignatura": {
        "type": "object",
        "description": "Asignatura con sus datos básicos",
        "properties": {
          "nombre_asignatura": {
            "type": "string",
            "maxLength": 50,
            "description": "Nombre de la asignatura",
            "example": "Matemáticas"
          },
          "curso": {
            "type": "string",
            "maxLength": 4,
            "description": "Curso de inicio de la asignatura",
            "example": "2020"
          },
          "profesor": {
            "type": "object",
            "description": "Profesor de la asignatura",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int32",
                "description": "Identificador del profesor de la asignatura",
                "example": 1
              },
              "nombre": {
                "type": "string",
                "maxLength": 50,
                "description": "Nombre de profesor de la asignatura",
                "example": "Luís Martinez"
              }
            }
          }
        },
        "required": [
          "id_asignatura",
          "nombre_asignatura",
          "curso"
        ]
      },
      "asignatura_with_id": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id_asignatura": {
                "type": "integer",
                "format": "int32",
                "description": "identificador único de la asignatura",
                "example": 27
              }
            }
          },
          {
            "$ref": "#/components/schemas/asignatura"
          }
        ]
      },
      "pagina": {
        "type": "object",
        "description": "Dirección (de trabajo o tutor). Tendrá la provincia y municipio como literales, y sólo el nombre de la calle y número\n",
        "properties": {
          "id_pagina": {
            "type": "integer",
            "format": "int32",
            "description": "Identificador de la dirección",
            "example": 1
          },
          "provincia": {
            "type": "string",
            "maxLength": 50,
            "description": "Nombre de la provincia",
            "example": "Madrid"
          },
          "id_provincia": {
            "type": "string",
            "maxLength": 2,
            "description": "Identificador de la provincia",
            "example": "28"
          },
          "municipio": {
            "type": "string",
            "maxLength": 50,
            "description": "Nombre del municipio",
            "example": "Móstoles"
          },
          "id_municipio": {
            "type": "string",
            "maxLength": 3,
            "description": "Identificador del municipio",
            "example": "079"
          },
          "id_via": {
            "type": "string",
            "maxLength": 5,
            "description": "Identificador de la via",
            "example": "5"
          },
          "calle": {
            "type": "string",
            "maxLength": 50,
            "description": "Nombre de la calle",
            "example": "Paseo de la Florida"
          },
          "numero": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 9999,
            "description": "Número dentro de la calle",
            "example": 25
          }
        },
        "required": [
          "id_pagina",
          "provincia",
          "municipio",
          "id_via",
          "calle",
          "numero"
        ]
      },
      "municipio": {
        "type": "object",
        "description": "Datos de un municipio\n",
        "properties": {
          "id_provincia": {
            "type": "string",
            "maxLength": 2,
            "description": "Identificador de la provincia",
            "example": "28"
          },
          "provincia": {
            "type": "string",
            "maxLength": 50,
            "description": "Descripción de la provincia del trabajo",
            "example": "Madrid"
          },
          "id_municipio": {
            "type": "string",
            "maxLength": 3,
            "description": "Identificador del municipio",
            "example": "079"
          },
          "municipio": {
            "type": "string",
            "maxLength": 50,
            "description": "Literal con el nombre del municipio",
            "example": "Madrid"
          }
        },
        "required": [
          "id_provincia",
          "id_municipio",
          "municipio"
        ]
      },
      "provincia": {
        "type": "object",
        "description": "Datos de una provincia\n",
        "properties": {
          "id_provincia": {
            "type": "string",
            "maxLength": 2,
            "description": "Identificador de la provincia",
            "example": "28"
          },
          "provincia": {
            "type": "string",
            "maxLength": 50,
            "description": "Descripción de la provincia",
            "example": "Madrid"
          }
        }
      },
      "solicitud_beca": {
        "type": "object",
        "description": "Datos de la solicitud de una beca\n",
        "properties": {
          "id_solicitud": {
            "type": "integer",
            "format": "int32",
            "description": "identificador de la solicitud",
            "example": 1
          },
          "id_trabajo": {
            "type": "integer",
            "format": "int32",
            "description": "identificador del trabajo que hace la solicitud",
            "example": 1002
          },
          "fecha_solicitud": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de la nota. Fecha ISO 8061 en formato yyyy-MM-ddTHH:mm:ss",
            "example": "2021-01-25T11:50:59"
          },
          "nif_presentante": {
            "type": "string",
            "maxLength": 9,
            "description": "Nif de la persona que presenta la solicitud",
            "example": "000000001R"
          },
          "tipo_solicitud": {
            "type": "string",
            "maxLength": 1,
            "description": "Tipo de solicitud",
            "example": "N"
          },
          "observaciones": {
            "type": "string",
            "maxLength": 2600,
            "description": "Observaciones que pueda meter el trabajo al hacer la solicitud",
            "example": "Observaciones de la solicitud...."
          }
        }
      },
      "solicitud_beca_adjunto": {
        "type": "object",
        "description": "Datos del fichero subido a una solicitud de una beca\n",
        "properties": {
          "id_adjunto": {
            "type": "integer",
            "format": "int32",
            "description": "identificador del adjunto",
            "example": 1
          },
          "id_solicitud": {
            "type": "integer",
            "format": "int32",
            "description": "identificador de la solicitud a la que se anexa el adjunto",
            "example": 1
          },
          "id_fica": {
            "type": "string",
            "description": "identificador de fica del fichero subido",
            "example": 12043233
          },
          "nombre_fichero": {
            "type": "string",
            "description": "Nombre del fichero subido",
            "example": "justifiante.pdf"
          },
          "tamano_bytes": {
            "type": "integer",
            "format": "int32",
            "description": "Tamaño en bytes del fichero subido",
            "example": 25835
          }
        }
      }
    },
    "requestBodies": {
      "standard_filter_body_param": {
        "description": "Parámetro de consulta de filtrado complejo a través de cuerpo de petición.\nSe debe utilizar mediante una petición de caso especial POST como GET.\n",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "$filter": {
                  "$ref": "#/components/schemas/standard_filter_object"
                }
              }
            },
            "examples": {
              "Ejemplo 1": {
                "value": {
                  "$filter": {
                    "operation": "EQ",
                    "values": [
                      {
                        "property": "property_1",
                        "prop_type": "INTEGER",
                        "prop_value": "7"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "required": false
      },
      "standard_delete_multiple_body_param": {
        "description": "Ejemplo de cuerpo de petición que contiene un listado de los identificadores\nde recursos a eliminar en una operación de borrado múltiple.\nSe debe usar en los endpoints de borrado masivo.\nSu definición es un ejemplo, dado que los identificadores pueden ser de distinto tipo.\nLa definición de este cuerpo dependerá del recurso.\n",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uuid": {
                        "type": "string",
                        "format": "uuid",
                        "description": "UUID del recurso",
                        "example": "2bd80c5a-fc3f-49a7-b79a-0c174e19aef6"
                      },
                      "id": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Identificador del recurso",
                        "example": "2bd80c5a-fc3f-49a7-b79a-0c174e19aef6"
                      }
                    }
                  },
                  "description": "Array con los identificadores o UUIDs de los recursos a eliminar."
                }
              }
            },
            "examples": {
              "Ejemplo 1": {
                "value": [
                  {
                    "uuid": "2bd80c5a-fc3f-49a7-b79a-0c174e19aef6"
                  },
                  {
                    "uuid": "497faaf6-5aab-425b-bb6d-a8e374c6ec98"
                  }
                ]
              }
            }
          }
        },
        "required": true
      },
      "post_adjunto_body_param": {
        "description": "Archivo a subir para adjuntar a la solicitud de beca",
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "encoding": {
              "file": {
                "contentType": "application/pdf, application/msword, application/vnd.ms-excel"
              }
            },
            "examples": {
              "Ejemplo 1": {
                "value": "Al ser un fichero, se sube un binario, por lo que no es posible mostrar aquí un ejemplo. Se especifica aquí a fin informativo"
              }
            }
          }
        }
      },
      "post_trabajo_body_param": {
        "description": "Propiedades necesarias para crear un trabajo (no incluye variables derivadas)",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "nombre_trabajo": {
                  "type": "string",
                  "maxLength": 30,
                  "description": "Nombre del trabajo",
                  "example": "Antonio"
                },
                "apellido_1": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "apellido1 del trabajo",
                  "example": "Perez"
                },
                "apellido_2": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "apellido2 del trabajo",
                  "example": "Martinez"
                },
                "nif": {
                  "type": "string",
                  "maxLength": 9,
                  "description": "NIF del trabajo",
                  "example": "00000001F"
                },
                "fecha_nacimiento": {
                  "type": "string",
                  "format": "date",
                  "description": "Fecha de nacimiento. Fecha ISO 8061 en formato yyyy-MM-dd",
                  "example": "1980-06-25"
                },
                "fecha_inscripcion": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de inscripción del trabajos en el centro. Fecha ISO 8061 con hora",
                  "example": "2022-09-12T12:01:02"
                },
                "id_pagina_trabajo": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Identificador de la dirección del trabajo",
                  "example": 1
                },
                "id_pagina_tutor": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Identificador de la dirección del tutor",
                  "example": 1
                }
              },
              "required": [
                "nombre_trabajo",
                "fecha_nacimiento",
                "apellido_1",
                "nif"
              ]
            },
            "examples": {
              "Ejemplo 1": {
                "$ref": "#/components/examples/post_trabajo_body_param_example"
              }
            }
          }
        },
        "required": true
      },
      "put_trabajo_body_param": {
        "description": "Propiedades a modificar en un trabajo, que *no* incluye variables derivadas, sólo sus id (id_pagina, asignaturas_ids). Para modificar las propiedades derivadas se utiliza el recurso de trabajo \"completo\".",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "nombre_trabajo": {
                  "type": "string",
                  "maxLength": 30,
                  "description": "Nombre del trabajo",
                  "example": "Antonio"
                },
                "apellido_1": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "primer apellido del trabajo",
                  "example": "Perez"
                },
                "apellido_2": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "segundo apellido del trabajo",
                  "example": "Martinez"
                },
                "fecha_nacimiento": {
                  "type": "string",
                  "format": "date",
                  "description": "Fecha de nacimiento. Fecha ISO 8061 en formato yyyy-MM-dd",
                  "example": "1980-06-25"
                },
                "fecha_inscripcion": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de inscripción del trabajos en el centro. Fecha ISO 8061 con hora",
                  "example": "2022-09-12T12:01:02"
                },
                "id_pagina": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Identificador de la dirección del trabajo",
                  "example": 1
                },
                "asignaturas_ids": {
                  "type": "array",
                  "description": "Array de identificadores de las asignaturas a asignar al trabajo",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "example": [
                    1,
                    2,
                    3,
                    4
                  ]
                }
              }
            },
            "examples": {
              "Ejemplo 1": {
                "$ref": "#/components/examples/put_trabajo_body_param_example"
              }
            }
          }
        }
      },
      "put_trabajo_completo_body_param": {
        "description": "Modificar en un trabajo \"completo\" (incluye variables derivadas: dirección de trabajo, dirección de tutor y asignaturas)",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "nombre_trabajo": {
                  "type": "string",
                  "maxLength": 30,
                  "description": "Nombre del trabajo",
                  "example": "Antonio"
                },
                "apellido_1": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "Primer apellido del trabajo",
                  "example": "Perez"
                },
                "apellido_2": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "Segundo apellido del trabajo",
                  "example": "Martinez"
                },
                "fecha_nacimiento": {
                  "type": "string",
                  "format": "date",
                  "description": "Fecha de nacimiento. Fecha ISO-8061 en formato yyyy-MM-dd",
                  "example": "1980-06-25"
                },
                "fecha_inscripcion": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de inscripción del trabajos en el centro. Fecha ISO 8061 con hora",
                  "example": "2022-09-12T12:01:02"
                },
                "pagina_trabajo": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/pagina"
                    }
                  ]
                },
                "pagina_tutor": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/pagina"
                    }
                  ]
                },
                "asignaturas": {
                  "type": "array",
                  "description": "Asignaturas en las que está matriculado el trabajo",
                  "items": {
                    "$ref": "#/components/schemas/asignatura_with_id"
                  }
                }
              }
            },
            "examples": {
              "Ejemplo 1": {
                "$ref": "#/components/examples/put_trabajo_completo_body_param_example"
              }
            }
          }
        }
      },
      "post_pagina_body_param": {
        "description": "Alta de una dirección",
