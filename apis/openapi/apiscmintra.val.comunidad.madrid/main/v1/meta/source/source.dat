      "url_carga_temporal_body_param": {
        "description": "Datos para obtener URL de carga temporal",
        "content": {
          "application/json": {
            "schema": {
              "description": "Datos de entrada para obtener URL de carga temporal\n",
              "type": "object",
              "properties": {
                "nombre_fichero": {
                  "type": "string",
                  "description": "Nombre del fichero a subir",
                  "example": "documento.pdf"
                },
                "sg_caducidad": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Segundos de caducidad de la URL",
                  "example": 300
                }
              },
              "required": [
                "nombre_fichero"
              ]
            },
            "examples": {
              "Ejemplo 1": {
                "value": {
                  "nombre_fichero": "documento.pdf",
                  "sg_caducidad": 300
                }
              }
            }
          }
        },
        "required": true
      },
      "consolidar_fichero_body_param": {
        "description": "Datos para consolidar un fichero",
        "content": {
          "application/json": {
            "schema": {
              "description": "Datos de entrada para consolidar un fichero\n",
              "type": "object",
              "properties": {
                "s3_key": {
                  "type": "string",
                  "description": "Clave S3 del fichero temporal",
                  "example": "DES/JAPI_S3_TEMP_03/00000000-0000-0000-0000-000000000000/documento.pdf"
                },
                "nombre_fichero": {
                  "type": "string",
                  "description": "Nombre del fichero",
                  "example": "documento.pdf"
                },
                "id_externo": {
                  "type": "string",
                  "description": "Id externo",
                  "example": "ID_EXTERNO"
                }
              },
              "required": [
                "s3_key",
                "nombre_fichero"
              ]
            },
            "examples": {
              "Ejemplo 1": {
                "value": {
                  "s3_key": "DES/JAPI_S3_TEMP_03/00000000-0000-0000-0000-000000000000/documento.pdf",
                  "nombre_fichero": "documento.pdf",
                  "id_externo": "ID_EXTERNO",
                  "app_data": {
                    "nombre_propio": "Jaime",
                    "num_asociado": 2
                  }
                }
              }
            }
          }
        },
        "required": true
      }
    },
