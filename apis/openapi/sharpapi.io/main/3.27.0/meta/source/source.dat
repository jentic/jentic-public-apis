        ],
        "properties": {
          "market_id": {
            "type": "string",
            "example": "championship_winner"
          },
          "display_name": {
            "type": "string",
            "example": "NBA Championship Winner"
          },
          "sport": {
            "type": "string",
            "example": "basketball"
          },
          "league": {
            "type": "string",
            "example": "nba"
          },
          "future_type": {
            "type": "string",
            "enum": [
              "TEAM",
              "PLAYER",
              "OVER_UNDER",
              "YES_NO"
            ]
          },
          "selection_count": {
            "type": "integer",
            "description": "Number of available selections"
          },
          "books_available": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sportsbooks offering this futures market"
          }
        }
      },
      "FutureOdds": {
        "type": "object",
        "required": [
          "selection",
          "sportsbook",
          "odds_american",
          "odds_decimal",
          "probability",
          "future_type",
          "future_market_id",
          "future_market_name",
          "sport",
          "league",
          "event_start_time",
          "timestamp"
        ],
        "properties": {
          "selection": {
            "type": "string",
            "example": "Boston Celtics"
          },
          "sportsbook": {
            "type": "string",
            "example": "draftkings"
          },
          "odds_american": {
            "type": "number",
            "example": 350
          },
          "odds_decimal": {
            "type": "number",
            "example": 4.5
          },
          "probability": {
            "type": "number",
            "example": 0.2222
          },
          "line": {
            "type": [
              "number",
              "null"
            ]
          },
          "future_type": {
            "type": "string"
          },
          "future_market_id": {
            "type": "string"
          },
          "future_market_name": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "event_start_time": {
            "type": "string",
            "format": "date-time"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SplitsGame": {
        "type": "object",
        "description": "Public betting splits for a single event from one source sportsbook.",
        "required": [
          "event_id",
          "sport",
          "league",
          "sportsbook"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "description": "Canonical event ID (joinable with /odds)"
          },
          "sport": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "sportsbook": {
            "type": "string",
            "enum": [
              "draftkings",
              "circa",
              "betmgm",
              "consensus"
            ],
            "description": "Source sportsbook for the splits data. `consensus` is a synthetic label, not a sportsbook: when every source covering an event posts identical numbers those rows are merged into one row tagged `consensus`, so a `sportsbook=draftkings` filter does not return them. It is accepted by this endpoint's `sportsbook` filter but never appears in /api/v1/sportsbooks."
          },
          "away_team": {
            "type": "string"
          },
          "home_team": {
            "type": "string"
          },
          "spread": {
            "type": "object",
            "description": "Spread market splits. NOTE: `away_odds` and `home_odds` here carry spread *line* values (e.g. -1.5/+1.5), not American odds. Field naming is a known inconsistency vs `/splits/history` which uses `away_line`/`home_line`.",
            "properties": {
              "away_odds": {
                "type": "number"
              },
              "home_odds": {
                "type": "number"
              },
              "handle_pct": {
                "type": "object",
                "description": "Share of money wagered on each side (0.0-1.0). Both members are `null` on `betmgm` rows: BetMGM publishes a ticket percentage only, so no handle figure exists to report. The keys are always present - only their values are null.",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "description": "Share of tickets wagered on each side (0.0-1.0). Members are `null` when the source has posted no percentage for this market; observed on `betmgm` rows, whose feed is intermittent. The keys are always present - only their values are null.",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "total": {
            "type": "object",
            "properties": {
              "line": {
                "type": "number"
              },
              "handle_pct": {
                "type": "object",
                "description": "Share of money wagered on each side (0.0-1.0). Both members are `null` on `betmgm` rows: BetMGM publishes a ticket percentage only, so no handle figure exists to report. The keys are always present - only their values are null.",
                "properties": {
                  "over": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "under": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "description": "Share of tickets wagered on each side (0.0-1.0). Members are `null` when the source has posted no percentage for this market; observed on `betmgm` rows, whose feed is intermittent. The keys are always present - only their values are null.",
                "properties": {
                  "over": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "under": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "moneyline": {
            "type": "object",
            "properties": {
              "away_odds": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "American odds. `null` when the source has pulled the moneyline for this event while still publishing its split percentages; the key stays present."
              },
              "home_odds": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "American odds. `null` when the source has pulled the moneyline for this event while still publishing its split percentages; the key stays present."
              },
              "handle_pct": {
                "type": "object",
                "description": "Share of money wagered on each side (0.0-1.0). Both members are `null` on `betmgm` rows: BetMGM publishes a ticket percentage only, so no handle figure exists to report. The keys are always present - only their values are null.",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "description": "Share of tickets wagered on each side (0.0-1.0). Members are `null` when the source has posted no percentage for this market; observed on `betmgm` rows, whose feed is intermittent. The keys are always present - only their values are null.",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_metrics": {
            "type": "array",
            "description": "Which public-betting split metrics this row's sportsbook publishes AT ALL. This is a per-book declaration, not a description of the values this particular row happens to hold, and it is serialised in the order shown. Omitted entirely when SharpAPI has not declared what the book publishes: an absent field means 'not stated', never 'publishes nothing'. Read it together with the value - `handle_pct` listed while its members are `null` is a number we are missing, whereas `handle_pct` absent from this list while its members are `null` means the book does not publish money share. A synthetic `consensus` row carries the intersection of its contributing books, and omits the field if any contributor is undeclared.",
            "items": {
              "type": "string",
              "enum": [
                "bets_pct",
                "handle_pct"
              ]
            }
          }
        }
      },
      "SplitsHistoryEntry": {
        "type": "object",
        "description": "A single timestamped splits snapshot for an event from one source.",
        "required": [
          "book",
          "ts",
          "timestamp"
        ],
        "properties": {
          "book": {
            "type": "string",
            "enum": [
              "draftkings",
              "circa",
              "betmgm"
            ],
            "description": "Source sportsbook; history uses book where /splits uses sportsbook. No synthetic consensus history is produced."
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "Snapshot timestamp (RFC 3339)."
          },
          "timestamp": {
            "type": "number",
            "description": "Snapshot timestamp (Unix seconds, fractional)."
          },
          "spread": {
            "type": "object",
            "properties": {
              "away_line": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Spread line for this side, in the book's own sign convention (e.g. `-1.5`). `null` when the source posted no spread for this event at snapshot time; the key may be absent on BetMGM samples."
              },
              "home_line": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Spread line for this side, in the book's own sign convention (e.g. `-1.5`). `null` when the source posted no spread for this event at snapshot time; the key may be absent on BetMGM samples."
              },
              "handle_pct": {
                "type": "object",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "total": {
            "type": "object",
            "properties": {
              "line": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Total (over/under) line. `null` when the source posted no total for this event at snapshot time; the key may be absent on BetMGM samples."
              },
              "handle_pct": {
                "type": "object",
                "properties": {
                  "over": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "under": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "properties": {
                  "over": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "under": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "moneyline": {
            "type": "object",
            "properties": {
              "away_odds": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "American odds. `null` when the source has pulled the moneyline for this event while still publishing its split percentages; the key may be absent on BetMGM samples."
              },
              "home_odds": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "American odds. `null` when the source has pulled the moneyline for this event while still publishing its split percentages; the key may be absent on BetMGM samples."
              },
              "handle_pct": {
                "type": "object",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "bets_pct": {
                "type": "object",
                "properties": {
                  "away": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "home": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "available_metrics": {
            "type": "array",
            "description": "Metrics the source book publishes at all. BetMGM declares bets_pct only; DraftKings and Circa declare bets_pct and handle_pct. Omitted for undeclared books.",
            "items": {
              "type": "string",
              "enum": [
                "bets_pct",
                "handle_pct"
              ]
            }
          }
        }
      },
      "DataEnvelope": {
        "type": "object",
        "description": "Standard shape for non-paginated responses. Emitted by endpoints that return a single resource or a small fixed list. No `success` flag — HTTP status codes indicate success/failure.",
        "required": [
          "data",
          "updated_at"
        ],
        "properties": {
          "data": {},
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Server emit time (RFC 3339)."
          }
        }
      }
    }
  }
}
