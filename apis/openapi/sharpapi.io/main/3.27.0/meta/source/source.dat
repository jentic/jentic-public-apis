    "/odds": {
      "get": {
        "operationId": "listOdds",
        "summary": "List odds",
        "description": "Returns odds across all sportsbooks and events. Supports extensive filtering and grouping. Results are ordered chronologically by event start time.\n",
        "tags": [
          "Odds"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/sport"
          },
          {
            "$ref": "#/components/parameters/league"
          },
          {
            "$ref": "#/components/parameters/sportsbook"
          },
          {
            "$ref": "#/components/parameters/market"
          },
          {
            "$ref": "#/components/parameters/event_id"
          },
          {
            "$ref": "#/components/parameters/is_live"
          },
          {
            "$ref": "#/components/parameters/live"
          },
          {
            "$ref": "#/components/parameters/date"
          },
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/min_odds"
          },
          {
            "$ref": "#/components/parameters/max_odds"
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "Group results by event",
            "schema": {
              "type": "string",
              "enum": [
                "event"
              ]
            }
          },
          {
            "name": "is_alternate_line",
            "in": "query",
            "description": "Filter on the row's main-line cohort. `false` returns main lines only, `true` returns alternate lines only, omit for both. A row is an alternate line when its `line` differs from the best-effort main line for its cohort. A cohort is (event, market_type, selection axis), resolved per sportsbook: the selection axis is the player for player-prop markets, the team side for spread and team-total markets, and the raw selection everywhere else. Rows in markets with no line (moneyline, outright) are always main lines. Note the cohort-pending case: a row whose cohort has not been published yet (cold start, brand-new event) has both `is_alternate_line` and `is_main_line` false, so `is_alternate_line=false` includes those rows while `is_main_line=true` excludes them. Use `is_main_line=true` for a strict main-lines-only view.",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "example": false
          },
          {
            "name": "is_main_line",
            "in": "query",
            "description": "Filter on the row's main-line cohort, positive polarity. `true` returns main lines only and excludes cohort-pending rows, `false` returns alternate lines only, omit for both. See `is_alternate_line` for the negative-polarity sibling and for how the two differ on cohort-pending rows. Also accepted on `/odds/best`.",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "example": true
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset_capped"
          },
          {
            "name": "include_futures",
            "in": "query",
            "description": "Include futures markets (season-long props, outrights, championship winners, etc.) in results. Defaults to false. Naming a futures market type via `market=` does not opt you in on its own — pass `include_futures=true` as well.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated odds",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              },
              "X-Data-Delay": {
                "$ref": "#/components/headers/X-Data-Delay"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Odds"
                          }
                        },
                        "meta": {
                          "type": "object",
                          "description": "Optional — omitted (never `null`) on ordinary non-empty single-book responses. Carries `store` on every empty result (zero rows), and `books` on queries that resolve to two or more sportsbooks — or, on an empty page, to none at all because the key's dashboard book selection resolved to nothing (`books.reason`).",
                          "properties": {
                            "store": {
                              "$ref": "#/components/schemas/StoreReadiness"
                            },
                            "books": {
                              "type": "object",
                              "description": "Resolved book scope. Present for queries resolving to two or more sportsbooks, so a book that contributed nothing to this page is not mistaken for a book SharpAPI does not carry — and on the empty page of a dashboard book selection that resolved to no servable book, where `in_scope` / `in_page` are empty and `reason` / `selected` name the cause.",
                              "required": [
                                "in_scope",
                                "in_page"
                              ],
                              "properties": {
                                "in_scope": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "description": "The resolved book set, sorted, whether or not each book contributed to this page. `[]` on the `selection_disjoint` page.",
                                  "example": [
                                    "draftkings",
                                    "fanduel",
                                    "pinnacle"
                                  ]
                                },
                                "in_page": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "integer"
                                  },
                                  "description": "Rows per book in this page. Books contributing nothing are omitted rather than emitted as 0 — `in_scope` already says they were in scope. `{}` on the `selection_disjoint` page.",
                                  "example": {
                                    "draftkings": 31,
                                    "fanduel": 19
                                  }
                                },
                                "reason": {
                                  "type": "string",
                                  "enum": [
                                    "selection_disjoint"
                                  ],
                                  "description": "Optional. Present only on the zero-book page: the key's dashboard sportsbook selection resolved to nothing — every selected book absent from the served snapshot or not included in the tier — while the tier alone would have resolved to at least one book. Takes precedence over `meta.store.reason`, which stays `no_match` (the store is populated). Never emitted on the Free tier, on an empty or warming store, or with an explicit `sportsbook=` filter (that case is answered with `403 tier_restricted` / `403 book_not_selected` / `503 book_unavailable` instead). The 200 stands.",
                                  "example": "selection_disjoint"
                                },
                                "selected": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "description": "Optional; accompanies `reason`. The dashboard selection that resolved to nothing — canonical sportsbook IDs, sorted.",
                                  "example": [
                                    "betano",
                                    "bwin"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
