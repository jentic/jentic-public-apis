    "/odds/comparison": {
      "get": {
        "operationId": "compareOdds",
        "summary": "Compare odds across books",
        "description": "Returns side-by-side odds comparison for a specific event across all sportsbooks.",
        "tags": [
          "Odds"
        ],
        "parameters": [
          {
            "name": "event_id",
            "in": "query",
            "required": true,
            "description": "Event ID to compare. A single id only: unlike the `event_id` filter on the other paths, a comma-separated list is not honored here — exactly one of the ids is used and which one is not defined. The legacy spelling `event` is still accepted, with the same `Deprecation` and `Warning` headers described on the shared `event_id` parameter. No `Sunset` date is sent.",
            "schema": {
              "type": "string"
            },
            "example": "nba-20260309-lal-bos"
          },
          {
            "name": "market",
            "in": "query",
            "description": "Filter by market type (comma-separated)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_futures",
            "in": "query",
            "description": "Include futures markets (season-long props, outrights, championship winners, etc.) in results. Defaults to false. Naming a futures market type via `market=` does not opt you in on its own — pass `include_futures=true` as well.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Odds comparison",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/DataEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/Odds"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
