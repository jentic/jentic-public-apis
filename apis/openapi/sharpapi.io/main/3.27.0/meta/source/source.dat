                      "is_sharp": false,
                      "has_live_odds": true,
                      "has_player_props": true,
                      "has_limits": false,
                      "regions": [
                        "US"
                      ],
                      "requires_tier": "free",
                      "status": "active",
                      "event_count": 320,
                      "last_update": "2026-03-09T14:22:00Z",
                      "unlisted": false
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
