            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "schema": {
              "type": "string",
              "enum": [
                "US",
                "UK",
                "EU",
                "AU",
                "GLOBAL"
              ]
            },
            "example": "US"
          },
          {
            "name": "sharp",
            "in": "query",
            "description": "Filter by sharp book status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "catalog",
            "in": "query",
            "description": "Return config-based catalog (no Redis dependency)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "include_unlisted",
            "in": "query",
            "description": "Include unlisted sportsbooks",
