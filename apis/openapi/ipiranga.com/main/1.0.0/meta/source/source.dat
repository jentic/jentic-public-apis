{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Ve\u00edculo",
    "version": "1.0.0",
    "description": "API REST para controlar ve\u00edculo, composi\u00e7\u00e3o e dados relacionados.  \n\nO tratamento de erros segue o padr\u00e3o Problem Details (RFC 7807/9457).  \n\nDefini\u00e7\u00f5es do padr\u00e3o {Major}.{Minor}.{Patch} usado para versionar a especifica\u00e7\u00e3o:  \n\n\n  Major - Mudan\u00e7as no contrato da API que provocam quebras nos consumidores da vers\u00e3o anterior;\n\n          * Remover endpoint; mudar m\u00e9todo (POST\u2192PUT); mudar URI sem redirecionar;\n          * Tornar obrigat\u00f3rio algo que era opcional; remover campo; mudar tipo/sem\u00e2ntica de campo;\n          * Alterar c\u00f3digos HTTP esperados (ex.: 200\u2192202/204) ou formato de erro;\n          * Mudar pagina\u00e7\u00e3o/filtros de forma incompat\u00edvel.\n\n  Minor - Mudan\u00e7as no contrato da API que n\u00e3o provocam quebras;\n\n          * Adicionar endpoint novo; adicionar campo opcional em requests/responses.\n          * Adicionar par\u00e2metros de filtro opcionais; aumentar limites de payload/pagina\u00e7\u00e3o.\n          * Aten\u00e7\u00e3o: adicionar um novo valor a um enum pode quebrar clientes muito estritos; trate enums como \u201cabertos\u201d ou documente o contrato de toler\u00e2ncia antes de tratar como MINOR.\n\n  Patch  - Mudan\u00e7as no aquivo da especifica\u00e7\u00e3o que n\u00e3o geram mudan\u00e7as de contrato.\n\n          * Corrigir typos/descri\u00e7\u00f5es; melhorar textos de `summary`/`description`;\n          * Ajustar ou corrigir exemplos (`example/examples`) para refletir o comportamento real;\n          * Adicionar `externalDocs`, tags, links de migra\u00e7\u00e3o, notas de deprecia\u00e7\u00e3o (`deprecated: true`) sem desligar nada;\n          * Incluir anota\u00e7\u00f5es `x-*` (vendor extensions) usadas por portais/linters.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Test44927/api-de-veiculo/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ipiranga.com/publicacao/v1",
      "description": "Servidor de produ\u00e7\u00e3o."
    },
    {
      "url": "https://api-hml.ipiranga.com/publicacao/v1",
      "description": "Servidor de homologa\u00e7\u00e3o."
    },
    {
      "url": "https://api-dev.ipiranga.com/publicacao/v1",
      "description": "Servidor de desenvolvimento."
    }
  ],
  "paths": {
    "/veiculos": {
      "post": {
        "summary": "Cria\u00e7\u00e3o de Ve\u00edculo",
        "operationId": "criacaoDeVeiculo",
        "tags": [
          "veiculos"
        ],
        "description": "Cria um ve\u00edculo ou composi\u00e7\u00e3o.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequisicaoCriacaoDeVeiculo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "O veiculo foi criado com sucesso.",
            "headers": {
              "Location": {
                "description": "URL do recurso rec\u00e9m-criado.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaCriacaoDeVeiculo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          }
        }
      },
      "get": {
        "summary": "Consulta de Ve\u00edculos",
        "operationId": "consultaDeVeiculos",
        "tags": [
          "veiculos"
        ],
        "description": "Pesquisa ve\u00edculos que atendam o crit\u00e9rio de busca.",
        "parameters": [
          {
            "name": "filtros",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Busca pelo identificador de banco do veiculo."
                },
                "placa": {
                  "type": "string",
                  "description": "Busca placa do ve\u00edculo por chave parcial de busca."
                },
                "idExterno": {
                  "type": "string",
                  "description": "Identificador externo do ve\u00edculo mais sequencial da composi\u00e7\u00e3o, quando for composto, e deve ser utilizado como chave de busca se n\u00e3o for informado o id.",
                  "example": "ABC1234.001"
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A consulta de ve\u00edculo foi executada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaConsultaDeVeiculo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          }
        }
      },
      "put": {
        "summary": "Atualiza\u00e7\u00e3o de Ve\u00edculo",
        "operationId": "atualizacaoDeVeiculo",
        "tags": [
          "veiculos"
        ],
        "description": "Atualiza dados do ve\u00edculo ou composi\u00e7\u00e3o.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequisicaoAtualizacaoDeVeiculo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "O ve\u00edculo foi atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaAtualizacaoDeVeiculo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          }
        }
      },
      "delete": {
        "summary": "Exclus\u00e3o de Ve\u00edculo",
        "operationId": "exclusaoDeVeiculo",
        "tags": [
          "veiculos"
        ],
        "description": "Remove logicamente um ve\u00edculo ou composi\u00e7\u00e3o. Caso j\u00e1 tenha sido exclu\u00eddo apenas ignora a requisi\u00e7\u00e3o.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "O identificador \u00fanico de banco do ve\u00edculo ou composi\u00e7\u00e3o.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "idExterno",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Identificador externo do ve\u00edculo mais sequencial da composi\u00e7\u00e3o, quando for composto, e deve, obrigatoriamente, ser utilizado como chave de busca se n\u00e3o for informado o id.",
            "example": "ABC1234.001"
          }
        ],
        "responses": {
          "204": {
            "description": "O ve\u00edculo foi removido com sucesso."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisi\u00e7\u00e3o inv\u00e1lida. Indica que o servidor n\u00e3o consegue processar a requisi\u00e7\u00e3o do cliente devido a um erro na pr\u00f3pria requisi\u00e7\u00e3o. Isso significa que o problema est\u00e1 no lado do cliente, e n\u00e3o no servidor. Geralmente, a requisi\u00e7\u00e3o \u00e9 mal formada, inv\u00e1lida ou cont\u00e9m informa\u00e7\u00f5es que o servidor n\u00e3o consegue interpretar.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Erros de valida\u00e7\u00e3o de neg\u00f3cio. Requisi\u00e7\u00e3o bem-formada mas semanticamente inv\u00e1lida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso n\u00e3o encontrado. Indica que o servidor n\u00e3o conseguiu encontrar o recurso solicitado pelo cliente. Em outras palavras, a p\u00e1gina ou arquivo que voc\u00ea est\u00e1 tentando acessar n\u00e3o existe no local especificado.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Falha na autentica\u00e7\u00e3o devido a credenciais inv\u00e1lidas.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Sem permiss\u00e3o para acessar o recurso. As credenciais s\u00e3o v\u00e1lidas mas o usu\u00e1rio n\u00e3o tem autoriza\u00e7\u00e3o para acessar o recurso.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InternalError": {
        "description": "Erro interno do servidor. Indica que o servidor encontrou uma condi\u00e7\u00e3o inesperada que o impediu de atender \u00e0 solicita\u00e7\u00e3o do cliente. \u00c9 um erro gen\u00e9rico, significando que o servidor n\u00e3o p\u00f4de especificar um erro mais preciso.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotImplemented": {
        "description": "N\u00e3o Implementado indica que o servidor n\u00e3o suporta a funcionalidade necess\u00e1ria para atender \u00e0 solicita\u00e7\u00e3o do cliente. Isso significa que o servidor n\u00e3o reconhece o m\u00e9todo de solicita\u00e7\u00e3o (como GET, POST, etc.) ou n\u00e3o \u00e9 capaz de process\u00e1-lo para o recurso solicitado.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "DataISO": {
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])T(2[0-3]|[01][0-9]):[0-5][0-9]:[0-5][0-9]-(2[0-3]|[01][0-9]):00$",
        "type": "string",
        "description": "Data e hora em que o evento ocorreu no sistema de origem.",
        "format": "date-time",
        "example": "2020-03-18T12:13:14-03:00"
      },
      "TipoDeCarregamento": {
        "type": "string",
        "description": "Indicador de tipo de carregamento: B - Bottom; T - Top; A - Ambos.\n",
        "enum": [
          "B",
          "T",
          "A"
        ]
      },
      "TipoDeImagem": {
        "type": "integer",
        "format": "int64",
        "description": "Identifica a imagem (caracteriza\u00e7\u00e3o) do ve\u00edculo. Por exemplo, 1=Ipiranga, 2=Atlantic, 3=NovaImagem, 4=Texaco e 9-Outro.",
        "enum": [
          1,
          2,
          3,
          4,
          9
        ]
      },
      "ComponenteVeiculo": {
        "type": "object",
        "properties": {
          "ordem": {
            "type": "integer",
            "format": "int32",
            "description": "Ordem do est\u00e1gio na composi\u00e7\u00e3o."
          },
          "veiculoId": {
            "type": "integer",
            "format": "int64",
            "description": "O id do ve\u00edculo que participa como est\u00e1gio da composi\u00e7\u00e3o."
          },
          "veiculoIdExterno": {
            "type": "string",
            "description": "Identificador do ve\u00edculo mais sequencial da composi\u00e7\u00e3o, quando for composto, e deve obrigatoriamente ser utilizado como chave de busca se n\u00e3o for informado o id.",
            "example": "ABC1234.001"
          }
        },
        "description": "Um m\u00f3dulo da composi\u00e7\u00e3o numa determinada posi\u00e7\u00e3o ou ordem. Sendo que um m\u00f3dulo \u00e9 um ve\u00edculo simples."
      },
      "TipoDeCargaDoCompartimento": {
        "type": "string",
        "description": "P - Peso; V - Volume.",
        "enum": [
          "P",
          "V"
        ]
      },
      "CategoriaProdutoCompartimento": {
        "type": "string",
        "description": "10 - Etanol Hidratado; 13 - Etanol Anidro; 15 - Diesel; 11 - Gasolina; 18 - Biodiesel; 14 - Querosene; 16 - \u00d3leo Combust\u00edvel.",
        "enum": [
          10,
          13,
          15,
          11,
          18,
          14,
          16
        ]
      },
      "Seta": {
        "type": "object",
        "properties": {
          "idSeta": {
            "type": "integer",
            "format": "int64",
            "description": "Identificador \u00fanico do cadastro de Seta."
          },
          "volume": {
            "type": "string",
            "description": "Volume da capacidade da Seta"
          },
          "categoriasProdutos": {
            "type": "array",
            "description": "Lista por prefixos de produtos para os compartimentos do veiculo, ou seja, uma indica\u00e7\u00e3o do que pode ser colocado na seta do compartimento baseado na densidade do produto.",
            "items": {
              "$ref": "#/components/schemas/CategoriaProdutoCompartimento"
            }
          }
        }
      },
      "CompartimentoVeiculo": {
        "type": "object",
        "properties": {
          "idCompartimentoVeiculo": {
            "type": "integer",
            "format": "int64",
            "description": "Identificador \u00fanico do cadastro de compartimento de um ve\u00edculo."
          },
          "pesoCapacidadeMaxima": {
            "type": "integer",
            "format": "int64",
            "description": "Quantidade peso capacidade m\u00e1xima."
          },
          "volumeCapacidadeMaxima": {
            "type": "integer",
            "format": "int64",
            "description": "Volume capacidade m\u00e1xima."
          },
          "numeroCompartimento": {
            "type": "integer",
            "format": "int64",
            "description": "Sequencial do compartimento."
          },
          "quantidadeLacre": {
            "type": "integer",
            "format": "int64",
            "description": "Quantidade Lacre."
          },
          "tipoCarga": {
            "$ref": "#/components/schemas/TipoDeCargaDoCompartimento"
          },
          "setas": {
            "type": "array",
            "description": "Informa\u00e7\u00f5es de sub compartimentos do ve\u00edculo.\n",
            "items": {
              "$ref": "#/components/schemas/Seta"
            }
          }
        },
        "description": "Cont\u00e9m os compartimentos (subdivis\u00f5es) de cada ve\u00edculo."
      },
      "ClasseVeiculoCarga": {
        "type": "string",
        "description": "Determina a classifica\u00e7\u00e3o do ve\u00edculo quanto a sua estrutura.  \n\nPode ser:\n  \n  \n    BT - Balsa Tanque;  \n    CA - Carreta Embalado;  \n    CE - Caminh\u00e3o Embalado;  \n    CM - Caminh\u00e3o Tanque;  \n    CR - Composi\u00e7\u00e3o Rodovi\u00e1ria;  \n    CT - Carreta Tanque;  \n    CV - Cavalo;  \n    DO - Dolly;  \n    DU - Duto;  \n    RB - Rebocador/Empurrador;  \n    VT - Vag\u00e3o.  \n",
        "enum": [
          "BT",
          "CA",
          "CE",
          "CM",
          "CR",
          "CT",
          "CV",
          "DO",
          "DU",
          "RB",
          "VT"
        ]
      },
      "TipoDocumento": {
        "type": "object",
        "description": "CK - Checklist;   CA - Capacita\u00e7\u00e3o (CIV);   PP - Capacita\u00e7\u00e3o (CIPP);   AF - Aferi\u00e7\u00e3o;   LV - CRLV;   LA - Licen\u00e7a IBAMA;   LE - Licen\u00e7a Estadual;   LM - Licen\u00e7a Municipal;   CS - Certificado de Seguran\u00e7a;   SR - Seguro Resp. C\u00edvil do Armador de Car;   LR - Licen\u00e7a de Esta\u00e7\u00e3o de R\u00e1dio;   CB - Certificado de Borda Livre;   DC - Declara\u00e7\u00e3o de Conformidade;   CQ - Certificado de Arquea\u00e7\u00e3o;   AT - Autoriza\u00e7\u00e3o ANTAQ p/ Transporte Fluvial;   XX - CIV (N\u00e3o utilizar).  \n",
        "enum": [
          "CK",
          "CA",
          "PP",
          "AF",
          "LV",
          "LA",
          "LE",
          "LM",
          "CS",
          "SR",
          "LR",
          "CB",
          "DC",
          "CQ",
          "AT",
          "XX"
        ]
      },
      "DocumentoVeiculo": {
        "type": "object",
        "properties": {
          "idDocumentoVeiculo": {
            "type": "integer",
            "format": "int64",
            "description": "Identificador \u00fanico no cadastro de documento do ve\u00edculo"
          },
          "numeroDocumento": {
            "type": "integer",
            "format": "int64",
            "description": "N\u00famero da documenta\u00e7\u00e3o correspondente ao documento.\n",
            "example": "N\u00famero do NR35."
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoDocumento"
              }
            ],
            "description": "Codigo do tipo do documento do requisito."
          },
          "observacao": {
            "type": "string",
            "description": "Documento ve\u00edculo corporativo."
          },
          "dataDeEmissao": {
            "description": "Data de emiss\u00e3o do documento do requisito.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DataISO"
              }
            ]
          },
          "dataDoVencimento": {
            "description": "Data de vencimento do documento do requisito.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DataISO"
              }
            ]
          },
          "municipio": {
            "type": "integer",
            "format": "int64",
            "description": "C\u00f3digo IBGE do munic\u00edpio para documentos de licen\u00e7a ambiental municipal."
          },
          "uf": {
            "type": "string",
            "description": "Sigla da UF para documentos de licen\u00e7a ambiental estadual."
          }
        },
        "description": "Requisitos do veiculo para o ve\u00edculo poder trafegar em vias publicas.\n",
        "example": "Aferi\u00e7\u00e3o; Licen\u00e7a IBAMA; Licen\u00e7a Estadual."
      },
      "Motorista": {
        "type": "object",
        "properties": {
          "idMotorista": {
            "type": "integer",
            "format": "int64",
            "description": "Identificador \u00fanico do cadastro de motorista."
          },
          "numeroCPF": {
            "type": "string",
            "description": "N\u00famero do CPF do motoristas sem formata\u00e7\u00e3o. Se n\u00e3o for passado o idMotorista, tem que ser informado obrigatoriamente."
          }
        },
        "description": "Informa um motorista transportador."
      },
      "TransportadorAgregadoFob": {
        "type": "object",
        "description": "Transportador contratado pelo cliente para operar o transporte do produto que ele adquiriu.",
        "required": [
          "tipoPessoa",
          "nome",
          "codigo"
        ],
        "properties": {
          "tipoPessoa": {
            "$ref": "#/components/schemas/TipoPessoa"
          },
          "nome": {
            "type": "string",
            "description": "Nome completo (PF) ou raz\u00e3o social (PJ).",
            "maxLength": 255
          },
          "nomeFantasia": {
            "type": "string",
            "description": "Nome fantasia, aplic\u00e1vel somente a PJ.",
            "maxLength": 255
          },
          "codigo": {
            "type": "string",
            "description": "CPF(PF) ou CNPJ(PJ) sem formata\u00e7\u00e3o.",
            "maxLength": 20
          },
          "endereco": {
            "type": "string",
            "description": "Endere\u00e7o do logradouro do transportador."
          },
          "municipio": {
            "type": "integer",
            "format": "int64",
            "description": "C\u00f3digo do munic\u00edpio em que o transportador est\u00e1 cadastrado."
          },
          "uf": {
            "type": "string",
            "description": "Sigla UF do transportador."
          },
          "inscricoesEstaduais": {
            "type": "array",
            "description": "Inscri\u00e7\u00f5es estaduais, quando aplic\u00e1vel (PJ).",
            "items": {
              "$ref": "#/components/schemas/InscricaoEstadual"
            }
          }
        }
      },
      "Cliente": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Pessoa"
          },
          {
            "properties": {
              "veiculoProprio": {
                "type": "boolean"
              },
              "transportador": {
                "$ref": "#/components/schemas/TransportadorAgregadoFob"
              }
            }
          }
        ],
        "description": "Cliente associado a um veiculo corporativo para o cen\u00e1rio outbound FOB.\n"
      },
      "TipoPessoa": {
        "type": "string",
        "description": "Tipo da pessoa: PF - F\u00edsica; PJ - Jur\u00eddica.\n",
        "enum": [
          "PF",
          "PJ"
        ]
      },
      "SituacaoDaInscricaoEstadual": {
        "type": "string",
        "description": "Valores poss\u00edveis: H - Habilitada; N - N\u00e3o habilitada; P - Pendente.  \n\n1 - Quando a a situa\u00e7\u00e3o da IE for Habilitada, o indicador de libera\u00e7\u00e3o de uso dever\u00e1 ser Sim;  \n2 - Quando a a situa\u00e7\u00e3o da IE for N\u00e3o habilitada, o indicador de libera\u00e7\u00e3o de uso dever\u00e1 ser N\u00e3o;  \n3 - Quando a a situa\u00e7\u00e3o da IE for Pendente o indicador de libera\u00e7\u00e3o de uso poder\u00e1 ser Sim ou N\u00e3o, a crit\u00e9iro do usu\u00e1rio.\n",
        "enum": [
          "H",
          "N",
          "P"
        ]
      },
      "InscricaoEstadual": {
        "type": "object",
        "description": "Inscri\u00e7\u00f5es estaduais de pessoa Jur\u00eddica",
        "properties": {
          "sequencialInscricaoEstadual": {
            "type": "integer",
            "format": "int64",
            "description": "Sequencial da inscri\u00e7\u00e3o estadual para uma pessoa."
          },
          "codigo": {
            "type": "string",
            "description": "C\u00f3digo da inscri\u00e7\u00e3o estadual.",
            "maxLength": 20
          },
          "codigoClassificacaoAtividade": {
            "type": "string",
            "description": "C\u00f3digo de classifica\u00e7\u00e3o da atividade.",
            "maxLength": 4
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoDaInscricaoEstadual"
          },
          "uf": {
            "type": "string",
            "description": "UF da inscri\u00e7\u00e3o estadual.",
            "maxLength": 2
          }
        },
        "required": [
          "sequencialInscricaoEstadual",
          "codigo",
          "uf"
        ]
      },
      "Pessoa": {
        "type": "object",
        "description": "Dados cadastrais do cliente.",
        "properties": {
          "idPessoa": {
            "type": "string",
            "description": "Identificador \u00fanico do cadastro de pessoas."
          },
          "codigo": {
            "type": "string",
            "description": "CPF(PF) ou CNPJ(PJ) sem formata\u00e7\u00e3o. Se n\u00e3o informado idPessoa, o sistema deve usar o c\u00f3digo para recuperar idPessoa do ponto de entrega principal (igual a 1).",
            "maxLength": 20
          }
        }
      },
      "SituacaoDoVeiculo": {
        "type": "string",
        "description": "Informa a situa\u00e7\u00e3o do ve\u00edculo:  \n\n1 -  Ativo;   2 -  Inativo;   3 -  Checklist Vencido;   4 -  Capacita\u00e7\u00e3o Vencida;   5 -  Aferi\u00e7\u00e3o Vencida;   6 -  Sem Motorista;   7 -  Bloqueio Tempor\u00e1rio;   8 -  Licen\u00e7a Ambiental Vencida.\n",
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      },
      "TipoDeDescarga": {
        "type": "string",
        "description": "Tipos de descarga que um ve\u00edculo de transporte de carga pode realizar: 1 - Lateral; 2 - Traseira.\n",
        "enum": [
          1,
          2
        ]
      },
      "TipoDeCarreta": {
        "type": "string",
        "description": "Tipos de carreta para um veiculo de transporte de carga: 1 - Longa; 2 - Curta.  \n\nA diferen\u00e7a entre carretas e caminh\u00f5es \u00e9 que nas carretas a for\u00e7a motriz as rodas de tra\u00e7\u00e3o e o motor ficam em uma parte enquanto a carga fica em outra. \n\nA parte em que fica a cabine recebe o nome de cavalo mec\u00e2nico e a parte em que fica a carga (m\u00f3dulo de carga) \u00e9 o semi-reboque.\n\nDa mesma forma que regulamentou os tipos de caminh\u00f5es, o CONTRAN tamb\u00e9m regulamenta os tipos de carretas.  \n\nAs categorias variam de acordo com o n\u00famero de eixos, medidas e capacidades do conjunto cavalo mec\u00e2nico e semi-reboque.\n",
        "enum": [
          1,
          2
        ]
      },
      "TipoDeEquipamento": {
        "type": "string",
        "description": "1 BO - Bomba; 2 DS - Descarga Selada; 3  MA - Ma\u00e7arico; 4  ML - Mangote Longo; 5  MR - Mangote c/ Redu\u00e7\u00e3o; 6  SE - Serpentina; 7  TE - Tranca Eletr\u00f4nica; 8  GC - Guarda-Corpo.\n",
        "enum": [
          "BO",
          "DS",
          "MA",
          "ML",
          "MR",
          "SE",
          "TE",
          "GC"
        ]
      },
      "TipoDeSaida": {
        "type": "string",
        "description": "Indicador de sa\u00edda de produto do ve\u00edculo: TRASEIRA; LATERAL.\n",
        "enum": [
          "TRASEIRA",
          "LATERAL"
        ]
      },
      "FilialTransportador": {
        "type": "object",
        "description": "Filial de uma Pessoa transportadora. A filial do transportador \u00e9 representada por codigoTransportador.",
        "allOf": [
          {
            "$ref": "#/components/schemas/Pessoa"
          },
          {
            "properties": {
              "codigoTransportador": {
                "type": "string",
                "description": "C\u00f3digo do transportador."
              }
            }
          }
        ]
      },
      "TransportadorUnidadeOperacional": {
        "type": "object",
        "description": "Para uma determinada Pessoa Transportadora, define qual o c\u00f3digo dela \u00e9 v\u00e1lido para uma unidade operacional, pois ela pode ter v\u00e1rias filiais.",
        "properties": {
          "codigoUnidOper": {
            "type": "string",
            "description": "C\u00f3digo da unidade operacional."
          },
          "transportador": {
            "$ref": "#/components/schemas/FilialTransportador"
          }
        }
      },
      "ProprietarioVeiculo": {
        "type": "object",
        "description": "Dados cadastrais do cliente.",
        "required": [
          "nome",
          "codigo"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do propriet\u00e1rio do ve\u00edculo."
          },
          "codigo": {
            "type": "string",
            "description": "CPF(PF) ou CNPJ(PJ) sem formata\u00e7\u00e3o.",
            "maxLength": 20
          }
        }
      },
      "TipoCarga": {
        "type": "string",
        "enum": [
          "GRANEL_CLARO",
          "GRANEL_ESCURO",
          "EMBALADO",
          "MISTO"
        ]
      },
      "RequisicaoBasicaDeVeiculo": {
        "type": "object",
        "required": [
          "idExterno",
          "identificacaoExterna",
          "descricao",
          "situacao",
          "classe"
        ],
        "description": "Estrutura para transfer\u00eancia de dados b\u00e1sicos de um ve\u00edculo ou composi\u00e7\u00e3o. No caso de cadastro simplificado, que aplica-se somente a rodovi\u00e1rio,  ainda ser\u00e1 necess\u00e1rio indicar  as placas na sua sequ\u00eancia (quando for composi\u00e7\u00e3o).  \n\nPara novos ve\u00edculos, de cadastro simplificado, a situa\u00e7\u00e3o ser\u00e1 sempre checklist vencido visto que tal documento n\u00e3o \u00e9 informado.\n\nPara cadastros simplificados com mais de uma placa dever\u00e3o ser cadastrados os ve\u00edculos unit\u00e1rios considerando o primeiro como cavalo e os demais como carreta, conclu\u00edndo com a cria\u00e7\u00e3o da composi\u00e7\u00e3o.\n\nEmbora seja um cadastro simplificado, ser\u00e1 necess\u00e1rio informar a compartimenta\u00e7\u00e3o de cada carreta, embora n\u00e3o seja necess\u00e1rio informar detalhes como seta ou quantidade de lacres.\n\nAo registrar um cadastro simplificado de composi\u00e7\u00e3o, caso a placa esteja cadastrada, como ve\u00edculo unit\u00e1rio, deve ser utilizado o ve\u00edculo j\u00e1 cadastrado.\n\nAo registrar um cadastro simplificado de composi\u00e7\u00e3o, caso a composi\u00e7\u00e3o esteja cadastrada, deve ser utilizado o ve\u00edculo composto j\u00e1 cadastrado, gerando apenas a associa\u00e7\u00e3o deste ve\u00edculo com fornecedor que est\u00e1 realizando o cadastro. Teremos fornecedor de compra CIF ou cong\u00eanere.\n",
        "properties": {
          "identificacaoExterna": {
            "type": "string",
            "description": "Para veiculos rodovi\u00e1rios simples cont\u00e9m a placa. Para ve\u00edculos rodovi\u00e1rios compostos cont\u00e9m a placa do \u00faltimo m\u00f3dulo da composi\u00e7\u00e3o. Para ve\u00edculo fluvial \u00e9 nome da balsa. Para vag\u00e3o \u00e9 o n\u00famero do vag\u00e3o."
          },
          "idExterno": {
            "type": "string",
            "description": "Identificador externo do ve\u00edculo mais sequencial da composi\u00e7\u00e3o, quando for composto, e deve obrigatoriamente ser utilizado como chave de busca se n\u00e3o for informado o id.",
            "example": "ABC1234.001"
          },
          "descricao": {
            "type": "string",
            "description": "Nome vis\u00edvel para o usu\u00e1rio. No caso de balsa cont\u00e9m o nome da balsa. E para ve\u00edculos rodovi\u00e1rios uma ou mais placas concatendas conforme classe de ve\u00edculo."
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoDoVeiculo"
          },
          "codigoTipoImagem": {
            "$ref": "#/components/schemas/TipoDeImagem"
          },
          "tipoSaidaProduto": {
            "$ref": "#/components/schemas/TipoDeSaida"
          },
          "pesoVeiculo": {
            "type": "integer",
            "format": "int64",
            "description": "Quantidade total do peso do ve\u00edculo em toneladas."
          },
          "tipoCarga": {
            "$ref": "#/components/schemas/TipoCarga"
          },
          "codigoTipoCarregamento": {
            "$ref": "#/components/schemas/TipoDeCarregamento"
          },
          "comprimentoVeiculo": {
            "$ref": "#/components/schemas/TipoDeCarreta"
          },
          "tipoVeiculoContran": {
            "type": "string",
            "description": "Identificador do perfil de veiculo no CONTRAN. Permite avaliar o limite de peso padr\u00e3o por ve\u00edculo. Se o usu\u00e1rio informar um valor maior tem que exigir informar se o ve\u00edculo possui licen\u00e7a especial e com isso deve anexar o documento correspondente na lista de documentos do ve\u00edculo."
          },
          "codigoChassi": {
            "type": "string",
            "description": "Identifica\u00e7\u00e3o do chassi do ve\u00edculo."
          },
          "veiculoMonitorado": {
            "type": "boolean",
            "description": "Campo para indicar se o ve\u00edculo \u00e9 monitorado: S - Sim; N - N\u00e3o.\n"
          },
          "quantidadeEixo": {
            "type": "integer",
            "format": "int64",
            "description": "Quantidade total de eixos do ve\u00edculo."
          },
          "quantidadeEixoDescarregado": {
            "type": "integer",
            "format": "int64",
            "description": "Quantidade de eixos do ve\u00edculo que tocam o solo quando o ve\u00edculo est\u00e1 descarregado."
          },
          "codigoAntena": {
            "type": "string",
            "description": "O c\u00f3digo da tecnologia de rastreamento."
          },
          "codigoRastreio": {
            "type": "string",
            "description": "Identificador do equipamento de GPS para fins de rastreamento."
          },
          "pesoMaximoCarga": {
            "type": "integer",
            "format": "int64",
            "description": "Volume m\u00e1ximo de carga do ve\u00edculo. Se n\u00e3o estiver preenchido pode ser igual ao campo pesoMaximoCargaEixo multiplicado pela quantidade eixos."
          },
          "pesoMaximoCargaEixo": {
            "type": "integer",
            "format": "int64",
            "description": "Volume m\u00e1ximo de carga por eixo do ve\u00edculo."
          },
          "anoFabricacao": {
            "type": "integer",
            "format": "int64",
            "description": "Ano de fabrica\u00e7\u00e3o do ve\u00edculo."
          },
          "compartimentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompartimentoVeiculo"
            },
            "description": "Compartimentos (subdivis\u00f5es) do ve\u00edculo de carga."
          },
          "proprietario": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProprietarioVeiculo"
              }
            ],
            "description": "Propriet\u00e1rio do ve\u00edculo."
          },
          "classe": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClasseVeiculoCarga"
              }
            ],
            "description": "Classifica\u00e7\u00e3o do ve\u00edculo quanto a sua estrutura."
          },
          "motoristaPrincipal": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Motorista"
              }
            ],
            "description": "O motorista t\u00edtular. Um ve\u00edculo pode ter no m\u00e1ximo um motorista titular."
          },
          "componentes": {
            "type": "array",
            "description": "Lista de est\u00e1gios que fazem parte da composi\u00e7\u00e3o.",
            "items": {
              "$ref": "#/components/schemas/ComponenteVeiculo"
            }
          }
        }
      },
      "RequisicaoDeVeiculo": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/RequisicaoBasicaDeVeiculo"
          },
          {
            "properties": {
              "tiposDeEquipamento": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TipoDeEquipamento"
                }
              },
              "transportadores": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TransportadorUnidadeOperacional"
                },
                "description": "Transportadores associadas ao ve\u00edculo, por unidade operacional."
              },
              "documentos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DocumentoVeiculo"
                },
                "description": "Lista de documentos do ve\u00edculo. A lista deve retornar o documento com a vig\u00eancia mais recente de cada tipo."
              },
              "motoristas": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Motorista"
                },
                "description": "Representa todos os motoristas que podem operar o ve\u00edculo."
              },
              "clientes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Cliente"
                },
                "description": "Entidade respons\u00e1vel por associar clientes a um ve\u00edculo."
              }
            }
          }
        ],
        "description": "Estrutura para transfer\u00eancia de todos os dados de um ve\u00edculo ou composi\u00e7\u00e3o.\n\n\nTipos de ve\u00edculos e suas capacidades de carga:\n\n-> Caminh\u00f5es: s\u00e3o  ve\u00edculos fixos, monoblocos, constituindo-se de uma \u00fanica parte que incorpora a cabine, com motor, e a unidade de carga (carroceria). Podem apresentar os mais variados tamanhos ter de 2 ou 4 eixos, podendo atingir peso bruto total de at\u00e9 29 toneladas.  \n\n-> Carretas: s\u00e3o ve\u00edculos articulados e, portanto, possuindo unidades de tra\u00e7\u00e3o e de carga em m\u00f3dulos separados.  \n\nEstas duas unidades s\u00e3o denominadas cavalos mec\u00e2nicos e semi-reboques.  \n\nOs semirreboques s\u00e3o tamb\u00e9m chamados de boogies, trailers e chassis porta-containers.  \n\nEste tipo de ve\u00edculo de transporte pode apresentar-se em duas formas:  \n\n- Aquele totalmente dependente de equipamentos externos para a coloca\u00e7\u00e3o ou retirada do container do ve\u00edculo.  \n\n- Equipado com guindastes (containerlift). Estes est\u00e3o colocados nas duas extremidades da plataforma, permitindo o embarque e desembarque de containers por seus pr\u00f3prios meios.  \n\n-> Combina\u00e7\u00f5es de Ve\u00edculos de Cargas - CVC: s\u00e3o composi\u00e7\u00f5es de ve\u00edculos constitu\u00eddas por cavalos mec\u00e2nicos, semi-reboques e reboques, portanto, compostos de tr\u00eas partes, normalmente usadas para o transporte de comodities como gr\u00e3os, madeira e min\u00e9rio de ferro.  \n\nEstes ve\u00edculos em face do seu elevado peso bruto total (de at\u00e9 74 toneladas), devem ser previamente autorizados pelos \u00f3rg\u00e3os rodovi\u00e1rios (DNIT, DER''s, etc).\n"
      },
      "RequisicaoCriacaoDeVeiculo": {
        "type": "object",
        "description": "Requisi\u00e7\u00e3o da opera\u00e7\u00e3o de cria\u00e7\u00e3o de ve\u00edculo. A aplica\u00e7\u00e3o deve calcular um hashcode de versao, a partir dos atributos do veiculo, para verificar se ele j\u00e1 existe na base. Caso sim ignora a requisi\u00e7\u00e3o.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RequisicaoDeVeiculo"
          }
        ]
      },
      "RespostaCriacaoDeVeiculo": {
        "type": "object",
        "required": [
          "id",
          "versao",
          "dataDeCriacao"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Identificador \u00fanico do cadastro de ve\u00edculo ou composi\u00e7\u00e3o."
          },
          "versao": {
            "type": "string",
            "description": "Um hashcode calculado a partir dos atributos do ve\u00edculo. No c\u00e1lculo n\u00e3o entra ids de banco."
          },
          "dataDeCriacao": {
            "description": "A data em que a aplica\u00e7\u00e3o efetivamente cadastrou o ve\u00edculo ou composi\u00e7\u00e3o.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DataISO"
              }
            ]
          }
        }
      },
      "Veiculo": {
        "type": "object",
        "allOf": [
          {
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "description": "Identificador \u00fanico do cadastro de ve\u00edculo."
              },
              "versao": {
                "type": "string",
                "description": "Um hashcode calculado a partir dos atributos do ve\u00edculo. No c\u00e1lculo n\u00e3o entra ids de banco."
              }
            },
            "required": [
              "id",
              "versao"
            ]
          },
          {
            "$ref": "#/components/schemas/RequisicaoBasicaDeVeiculo"
          }
        ]
      },
      "RespostaConsultaDeVeiculo": {
        "type": "object",
        "properties": {
          "veiculos": {
            "type": "array",
            "description": "Lista de ve\u00edculos.",
            "items": {
              "$ref": "#/components/schemas/Veiculo"
            }
          }
        }
      },
      "RequisicaoAtualizacaoDeVeiculo": {
        "type": "object",
        "description": "Requisi\u00e7\u00e3o da opera\u00e7\u00e3o de atualiza\u00e7\u00e3o de ve\u00edculo ou composi\u00e7\u00e3o. A aplica\u00e7\u00e3o deve calcular a nova vers\u00e3o do veiculo com base na requisi\u00e7\u00e3o. Se esta nova vers\u00e3o existir no banco, significa que as atualiza\u00e7\u00f5es j\u00e1 foram aplicadas. Nesse caso a requisi\u00e7\u00e3o pode ser ignorada.",
        "required": [
          "versaoAnterior"
        ],
        "allOf": [
          {
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "description": "Identificador \u00fanico do cadastro de ve\u00edculo."
              },
              "idExterno": {
                "type": "string",
                "description": "Identificador do ve\u00edculo mais sequencial da composi\u00e7\u00e3o, quando for composto, e deve obrigatoriamente ser utilizado como chave de busca se n\u00e3o for informado o id.",
                "example": "ABC1234.001"
              },
              "versaoAnterior": {
                "type": "string",
                "description": "Vers\u00e3o do ve\u00edculo para a qual foi aplicada a atualiza\u00e7\u00e3o. Ser\u00e1 utilizada para validar se a origem fez as mudan\u00e7as a partir da vers\u00e3o mais atualizada do ve\u00edculo."
              }
            }
          },
          {
            "$ref": "#/components/schemas/RequisicaoDeVeiculo"
          }
        ]
      },
      "RespostaAtualizacaoDeVeiculo": {
        "type": "object",
        "required": [
          "versao",
          "dataDaAtualizacao"
        ],
        "properties": {
          "versao": {
            "type": "string",
            "description": "Um hashcode calculado a partir dos atributos do ve\u00edculo. No c\u00e1lculo n\u00e3o entra ids de banco. \u00c9 a nova vers\u00e3o do ve\u00edculo ap\u00f3s aplicadas as atualiza\u00e7\u00f5es em banco."
          },
          "dataDaAtualizacao": {
            "description": "Data em que a aplica\u00e7\u00e3o efetivamente aplicou as atualiza\u00e7\u00f5es em banco.",
            "allOf": [
              {
                "$ref": "#/components/schemas/DataISO"
              }
            ]
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Objeto de erro no formato RFC 7807 / RFC 9457 (Problem Details).",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI que identifica o tipo de problema."
          },
          "title": {
            "type": "string",
            "description": "Resumo leg\u00edvel do problema."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "C\u00f3digo HTTP correspondente."
          },
          "detail": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o detalhada do problema."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "URI da ocorr\u00eancia espec\u00edfica."
          },
          "errors": {
            "type": "array",
            "description": "Lista de viola\u00e7\u00f5es espec\u00edficas quando h\u00e1 m\u00faltiplos erros do mesmo tipo.",
            "items": {
              "$ref": "#/components/schemas/Violation"
            }
          },
          "correlationId": {
            "type": "string",
            "description": "Identificador para rastreabilidade (extens\u00e3o opcional)."
          }
        },
        "additionalProperties": true
      },
      "Violation": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do campo/par\u00e2metro com erro."
          },
          "pointer": {
            "type": "string",
            "description": "Caminho RFC 6901 (ex.: /placa)."
          },
          "in": {
            "type": "string",
            "enum": [
              "body",
              "query",
              "path",
              "header"
            ],
            "description": "Local do erro."
          },
          "code": {
            "type": "string",
            "description": "C\u00f3digo t\u00e9cnico da regra violada (ex.: pattern, required, range)."
          },
          "message": {
            "type": "string",
            "description": "Mensagem amig\u00e1vel da viola\u00e7\u00e3o."
          },
          "rejectedValue": {
            "description": "Valor rejeitado."
          }
        },
        "required": [
          "name",
          "message"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}