  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Terraform Cloud API token (user, team, or organization)"
      }
    },
    "schemas": {
      "JsonApiDocument": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          },
          "included": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "$ref": "#/components/schemas/PaginationLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "JsonApiListDocument": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "$ref": "#/components/schemas/PaginationLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": "string"
          },
          "first": {
            "type": "string"
          },
          "prev": {
            "type": "string",
            "nullable": true
          },
          "next": {
            "type": "string",
            "nullable": true
          },
          "last": {
            "type": "string"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "pagination": {
            "type": "object",
            "properties": {
              "current-page": {
                "type": "integer"
              },
              "page-size": {
                "type": "integer"
              },
              "prev-page": {
                "type": "integer",
                "nullable": true
              },
              "next-page": {
                "type": "integer",
                "nullable": true
              },
              "total-pages": {
                "type": "integer"
              },
              "total-count": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "pointer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "organizations"
            ]
          },
          "attributes": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "external-id": {
                "type": "string"
              },
              "created-at": {
                "type": "string",
                "format": "date-time"
              },
              "session-timeout": {
                "type": "integer",
                "nullable": true
              },
              "session-remember": {
                "type": "integer",
                "nullable": true
              },
              "collaborator-auth-policy": {
                "type": "string",
                "enum": [
                  "password",
                  "two_factor_mandatory"
                ]
              },
              "cost-estimation-enabled": {
                "type": "boolean"
              },
              "permissions": {
                "type": "object"
              }
            }
          }
        }
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "workspaces"
            ]
          },
          "attributes": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "auto-apply": {
                "type": "boolean"
              },
              "file-triggers-enabled": {
                "type": "boolean"
              },
              "working-directory": {
                "type": "string"
              },
              "terraform-version": {
                "type": "string"
              },
              "execution-mode": {
                "type": "string",
                "enum": [
                  "remote",
                  "local",
                  "agent"
                ]
              },
              "resource-count": {
                "type": "integer"
              },
              "locked": {
                "type": "boolean"
              },
              "created-at": {
                "type": "string",
                "format": "date-time"
              },
              "updated-at": {
                "type": "string",
                "format": "date-time"
              },
              "vcs-repo": {
                "type": "object",
                "nullable": true
              },
              "permissions": {
                "type": "object"
              },
              "setting-overwrites": {
                "type": "object"
              }
            }
          },
          "relationships": {
            "type": "object"
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "runs"
            ]
          },
          "attributes": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "is-destroy": {
                "type": "boolean"
              },
              "auto-apply": {
                "type": "boolean"
              },
              "has-changes": {
                "type": "boolean"
              },
              "created-at": {
                "type": "string",
                "format": "date-time"
              },
              "plan-only": {
                "type": "boolean"
              },
              "refresh": {
                "type": "boolean"
              },
              "refresh-only": {
                "type": "boolean"
              },
              "replace-addrs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "target-addrs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permissions": {
                "type": "object"
              },
              "status-timestamps": {
                "type": "object"
              }
            }
          },
          "relationships": {
            "type": "object"
          }
        }
      },
      "Variable": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "vars"
            ]
          },
          "attributes": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "terraform",
                  "env"
                ]
              },
              "hcl": {
                "type": "boolean"
              },
              "sensitive": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "StateVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
