      "PublicAssessmentDetail": {
        "type": "object",
        "required": ["id", "target_id", "target_name", "assessment_type", "assessment_method", "status", "created_at", "updated_at", "started_at", "completed_at", "expected_testing_stages", "stages", "stage_progress"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "target_id": {"type": "string", "format": "uuid"},
          "target_name": {"type": ["string", "null"]},
          "assessment_type": {
            "type": "string",
            "enum": ["black-box", "white-box"]
          },
          "assessment_method": {
            "type": ["string", "null"],
            "enum": ["balanced", "deep", "ultra", null]
          },
          "status": {
            "type": "string",
            "enum": ["active", "completed", "failed", "canceled"]
          },
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "failure_reason": {
            "type": ["string", "null"],
            "maxLength": 1000,
            "description": "Customer-visible reason recorded for a failed assessment. Null for non-failed assessments or when no reason was recorded."
          },
          "expected_testing_stages": {
            "type": "array",
            "description": "Target-specific testing stages expected for this assessment. A stage without a matching entry in stages.state has not started yet.",
            "items": {"$ref": "#/components/schemas/PublicExpectedAssessmentStage"}
          },
          "stages": {
            "description": "Current assessment stages, including their statuses and individual test run times.",
            "anyOf": [
              {"$ref": "#/components/schemas/PublicAssessmentStages"},
              {"type": "null"}
            ]
          },
          "stage_progress": {
            "type": "array",
            "description": "Progress for planned and recorded assessment stages. Use this instead of reconciling expected_testing_stages with stages.state. NOT_STARTED means expected but not yet observed.",
            "items": {"$ref": "#/components/schemas/PublicAssessmentStageProgress"}
          }
        },
        "additionalProperties": false
      },
      "BulkFindingStatusRequest": {
        "type": "object",
        "required": [
          "finding_ids",
          "status"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESOLVED",
              "ARCHIVED"
            ]
          },
          "resolve_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "FIX",
              "WONT_FIX",
              "FALSE_POSITIVE",
              null
            ],
            "description": "Resolution reason. FALSE_POSITIVE is only valid when status is ARCHIVED and requires resolve_context."
          },
          "resolve_context": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Optional resolution context. Required when archiving a FALSE_POSITIVE."
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["resolve_reason"],
              "properties": {"resolve_reason": {"const": "FALSE_POSITIVE"}}
            },
            "then": {
              "required": ["resolve_context"],
              "properties": {
                "status": {"const": "ARCHIVED"},
                "resolve_context": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": ["resolve_reason"],
                  "properties": {"resolve_reason": {"enum": ["FIX", "WONT_FIX"]}}
                },
                {
                  "required": ["resolve_context"],
                  "properties": {"resolve_context": {"type": "string"}},
                  "not": {
                    "required": ["resolve_reason"],
                    "properties": {"resolve_reason": {"const": "FALSE_POSITIVE"}}
                  }
                }
              ]
            },
            "then": {"properties": {"status": {"const": "RESOLVED"}}}
          }
        ],
        "additionalProperties": false
      },
      "SeverityOverrideRequest": {
        "type": "object",
        "properties": {
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "secured",
              "info",
              null
            ],
            "description": "`secured` is the public value. `info` is accepted only as a deprecated input alias. Null clears the override."
          },
          "severity_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.0,
            "maximum": 10.0,
            "multipleOf": 0.1,
            "description": "Optional CVSS v3.1 score override. Null clears the override."
          }
        },
        "anyOf": [
          {
            "required": [
              "severity"
            ]
          },
          {
            "required": [
              "severity_score"
            ]
          }
        ],
        "additionalProperties": false
      },
