    "/v1/targets/{target_id}/credentials": {
      "get": {
        "operationId": "listTargetCredentials",
        "summary": "List Target Credentials",
        "description": "Return credential metadata needed to select and use a configured flow. Stored passwords, API keys, TOTP seeds, inbox IDs, and cached one-time codes are never returned.",
        "tags": ["Credentials"],
        "parameters": [
          {"name": "target_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}},
          {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "default": 0}}
        ],
        "responses": {
          "200": {"description": "Credential metadata returned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicTargetCredentialList"}}}}
        },
        "x-required-permission": "targets:read"
      },
      "post": {
        "operationId": "createTargetCredential",
        "summary": "Create Target Credential",
        "description": "Store a credential on a target. Email MFA requires pending_email_id; username and password are optional and should be supplied only when the target requests primary credentials. Before adding an api_key credential, the API target must already have non-empty api_auth_instructions; update the target with the validation route, HTTP method, request shape, and successful response first.",
        "tags": ["Credentials"],
        "parameters": [{"name": "target_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TargetCredentialCreateRequest"}}}},
        "responses": {
          "201": {"description": "Credential stored", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicTargetCredential"}}}}
        },
        "x-required-permission": "targets:write"
      }
    },
