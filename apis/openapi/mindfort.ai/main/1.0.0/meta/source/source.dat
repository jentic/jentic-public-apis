      "DeleteTargetResponse": {
        "type": "object",
        "required": [
          "success",
          "target_id"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "PublicAssessmentLifecycle": {
        "properties": {
