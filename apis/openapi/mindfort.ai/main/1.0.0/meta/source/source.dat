          "assessment_id": {"type": "string", "format": "uuid"},
          "completion_state": {"type": "string", "enum": ["pending", "running", "complete", "incomplete"]},
          "customer_summary": {"type": ["string", "null"], "description": "Customer-safe summary of the latest coverage run."},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"}
        },
