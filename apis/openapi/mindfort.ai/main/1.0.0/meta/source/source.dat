          },
          "status": {
            "type": "string",
            "enum": ["NOT_STARTED", "RUNNING", "ACTIVE", "COMPLETED", "SKIPPED", "FAILED", "TIMED_OUT", "CANCELED", "TERMINATED", "CONTINUED_AS_NEW"]
          },
          "attempt": {"type": ["integer", "null"], "minimum": 1},
          "executors": {
            "type": ["array", "null"],
