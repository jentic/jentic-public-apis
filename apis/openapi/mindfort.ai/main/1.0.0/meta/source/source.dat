              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retest_completed_at": {
            "title": "Retest Completed At",
            "description": "When the current retest reached COMPLETED or FAILED.",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retest_in_progress": {
            "type": "boolean",
            "title": "Retest In Progress",
            "description": "True while the current retest is queued or running.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "PublicFindingSummary",
        "additionalProperties": false
      },
      "SeverityScoreTimePoint": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "title": "Date"
          },
          "average_severity_score": {
            "type": "number",
            "title": "Average Severity Score"
          },
          "finding_count": {
            "type": "integer",
            "title": "Finding Count"
          },
          "assessment_count": {
            "type": "integer",
            "title": "Assessment Count",
            "description": "Distinct linked assessments in the bucket. This can be zero when the bucket contains orphan findings without an assessment_id."
          }
        },
        "type": "object",
        "required": [
          "date",
          "average_severity_score",
          "finding_count",
          "assessment_count"
        ],
        "title": "SeverityScoreTimePoint",
        "additionalProperties": false
      },
      "HealthScoreResponse": {
        "properties": {
          "target_id": {
            "type": "string",
            "format": "uuid",
            "title": "Target Id"
          },
          "health_score": {
            "title": "Health Score",
            "minimum": 0,
            "maximum": 10,
            "description": "Security health score from 0 to 10; higher is better. Null means the target has not completed a red-team assessment.",
            "type": [
              "number",
              "null"
            ]
          },
          "health_grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F",
              "N/A"
            ],
            "title": "Health Grade",
            "description": "A >= 9, B >= 8, C >= 7, D >= 6, and F < 6; N/A means not assessed."
          },
          "total_findings": {
            "type": "integer",
            "title": "Total Findings",
            "description": "Active vulnerable findings contributing to the health score."
          }
        },
        "type": "object",
        "required": [
          "target_id",
          "health_grade",
          "total_findings"
        ],
        "title": "HealthScoreResponse",
        "additionalProperties": false
      },
      "PublicRemediationMetrics": {
        "properties": {
          "target_id": {
            "title": "Target Id",
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "org_wide": {
            "type": "boolean",
            "title": "Org Wide"
          },
          "overall_count": {
            "type": "integer",
            "title": "Overall Count",
            "default": 0
          },
          "overall_mttr_hours": {
            "title": "Overall Mttr Hours",
            "type": [
              "number",
              "null"
            ]
          },
          "overall_p90_hours": {
            "title": "Overall P90 Hours",
            "type": [
              "number",
              "null"
            ]
          },
          "by_severity": {
            "items": {
              "$ref": "#/components/schemas/PublicRemediationBySeverity"
            },
            "type": "array",
            "title": "By Severity"
          }
        },
        "type": "object",
        "required": [
          "org_wide",
          "by_severity"
        ],
        "title": "PublicRemediationMetrics",
        "additionalProperties": false
      },
      "PublicFindingsList": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/PublicFindingSummary"
            },
            "type": "array",
            "title": "Findings"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "next_cursor": {
            "title": "Next Cursor",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object",
        "required": [
          "findings",
          "total",
          "limit",
          "offset",
          "next_cursor"
        ],
        "title": "PublicFindingsList",
        "additionalProperties": false
      }
    }
  }
}
