      "Slot": {
        "name": "slot",
        "in": "path",
        "required": true,
        "description": "Loadout slot identifier",
        "schema": {
          "type": "string",
          "example": 1
        }
      },
      "Preference": {
        "name": "preference",
        "in": "path",
        "required": true,
        "description": "Preference identifier",
        "schema": {
          "type": "string",
          "example": "preference_name"
        }
      },
      "SetId": {
        "name": "set_id",
        "in": "path",
        "required": true,
        "description": "Set identifier for preferences",
        "schema": {
          "type": "string",
          "example": "set_123"
        }
      },
      "Value": {
        "name": "value",
        "in": "path",
        "required": true,
        "description": "Value for preference setting",
        "schema": {
          "type": "string",
          "example": true
        }
      },
      "Page": {
        "name": "page",
        "in": "path",
        "required": true,
        "description": "Page number for pagination",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "MatchId": {
        "name": "matchId",
        "in": "path",
        "required": true,
        "description": "Match identifier",
        "schema": {
          "type": "string",
          "example": "match_123456"
        }
      },
      "Periods": {
        "name": "periods",
        "in": "query",
        "required": false,
        "description": "Time periods for stats",
        "schema": {
          "type": "string",
          "example": "alltime,daily,weekly"
        }
      },
      "PeriodsPath": {
        "name": "periods",
        "in": "path",
        "required": true,
        "description": "Time periods for stats",
        "schema": {
          "type": "string",
          "example": "alltime,daily,weekly"
        }
      },
      "Reaction": {
        "name": "reaction",
        "in": "path",
        "required": true,
        "description": "Reaction type for user feed",
        "schema": {
          "type": "string",
          "example": "like"
        }
      },
      "ApiVersion": {
        "name": "version",
        "in": "path",
        "required": true,
        "description": "API version (v1, v2, v3, v4)",
        "schema": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "v3",
            "v4"
          ],
          "example": "v2"
        }
      },
      "ApiVersionV1": {
        "name": "version",
        "in": "path",
        "required": true,
        "description": "API version (v1, v2, v3, v4)",
        "schema": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "v3",
            "v4"
          ],
          "default": "v1",
          "example": "v1"
        }
      },
      "ApiVersionV2": {
        "name": "version",
        "in": "path",
        "required": true,
        "description": "API version (v1, v2, v3, v4)",
        "schema": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "v3",
            "v4"
          ],
          "default": "v2",
          "example": "v2"
        }
      },
      "ApiVersionV3": {
        "name": "version",
        "in": "path",
        "required": true,
        "description": "API version (v1, v2, v3, v4)",
        "schema": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "v3",
            "v4"
          ],
          "default": "v3",
          "example": "v3"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Not permitted: not authenticated"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "User not found"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ],
                      "example": "error"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Internal server error occurred"
                    }
                  }
                }
              ]
            }
          },
          "text/html": {
            "schema": {
              "type": "string",
              "description": "HTML error page (common for 500 errors)"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/apexrest/oshp/landingpage": {
      "get": {
        "tags": [
          "Game Status"
        ],
        "summary": "Get game server status",
        "description": "Returns server status information for all Activision games including Call of Duty",
        "operationId": "getGameStatus",
        "servers": [
          {
            "url": "https://prod-psapi.infra-ext.activision.com/open/api",
            "description": "Game Status Server"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response (works without authentication)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStatusResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/papi-client/crm/cod/{version}/identities": {
      "get": {
        "tags": [
          "Account Management"
        ],
        "summary": "Get user title identities (v2)",
