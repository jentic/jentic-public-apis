    "/bans/{version}/appeal": {
      "get": {
        "tags": [
          "Ban Check"
        ],
        "summary": "Check ban status for authenticated account (v2)",
        "description": "Checks the ban status for the currently authenticated account using session cookies.\nRequires prior reCAPTCHA verification and valid Activision session cookies.\nNote: This endpoint only works for the account that is currently authenticated via cookies. Default version: v2\n",
        "operationId": "checkBanStatus",
        "servers": [
          {
            "url": "https://support.activision.com/api",
            "description": "Activision Support Server"
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiVersionV2"
          },
          {
            "$ref": "#/components/parameters/LocalePath"
          },
          {
            "$ref": "#/components/parameters/ReCaptchaToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful ban status check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanCheckResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "400": {
            "description": "Bad request - invalid reCAPTCHA token",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "error"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "message": {
                              "type": "string",
                              "example": "Invalid reCAPTCHA token"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
