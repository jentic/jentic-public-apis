{
  "openapi": "3.0.3",
  "info": {
    "title": "Call of Duty API",
    "description": "Unofficial Call of Duty API for accessing player stats, match history, and account information.\n\n## Authentication\nThis API requires authentication using the ACT_SSO_COOKIE cookie obtained from callofduty.com.\n\n## Game Title Codes\n- mw2 - Modern Warfare 2 (2022)\n- mw - Modern Warfare (2019)\n- bo4 - Black Ops 4\n- cw - Black Ops Cold War\n- vg - Vanguards\n- bo3 - Black Ops 3\n- iw - Infinite Warfare\n- ww2 - World War 2\n- jup - Modern Warfare 3 (2023)\n- cer - Black Ops 6\n- bo7 - Black Ops 7\n\n## Platform Codes\n- battle - Battle.net\n- bnet - Battle.net (alternative)\n- uno - Activision/UNO\n- xbl - Xbox Live\n- psn - PlayStation Network\n- steam - Steam\n\n## Mode Codes\n- mp - Multiplayer\n- wz - Warzone\n- zm - Zombies\n",
    "version": "1.0.0",
    "contact": {
      "name": "Call of Duty API Community"
    },
    "license": {
      "name": "MIT"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/na-867/CallOfDutyApi/1.0.0"
  },
  "servers": [
    {
      "url": "https://callofduty.com/api",
      "description": "Production server"
    },
    {
      "url": "https://my.callofduty.com/api",
      "description": "Old production server"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ACT_SSO_COOKIE",
        "description": "Authentication cookie obtained from callofduty.com"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "description": "Response status"
          },
          "data": {
            "type": "object",
            "description": "Response data (varies by endpoint)"
          },
          "message": {
            "type": "string",
            "description": "Error message (when status is error)"
          }
        }
      },
      "ErrorData": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "code": {
            "type": "integer",
            "description": "Error code"
          }
        }
      },
      "PlayerStats": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Game title code"
          },
          "platform": {
            "type": "string",
            "description": "Platform code"
          },
          "username": {
            "type": "string",
            "description": "Player username"
          },
          "type": {
            "type": "string",
            "description": "Game mode"
          },
          "level": {
            "type": "number",
            "description": "Current level"
          },
          "maxLevel": {
            "type": "number",
            "description": "Maximum level"
          },
          "prestige": {
            "type": "number",
            "description": "Current prestige level"
          },
          "totalXp": {
            "type": "number",
            "description": "Total XP earned"
          },
          "lifetime": {
            "$ref": "#/components/schemas/StatsBreakdown"
          },
          "weekly": {
            "$ref": "#/components/schemas/StatsBreakdown"
          }
        }
      },
      "StatsBreakdown": {
        "type": "object",
        "properties": {
          "all": {
            "type": "object",
            "description": "Overall statistics",
            "properties": {
              "kills": {
                "type": "integer",
                "description": "Total kills"
              },
              "deaths": {
                "type": "integer",
                "description": "Total deaths"
              },
              "wins": {
                "type": "integer",
                "description": "Total wins"
              },
              "losses": {
                "type": "integer",
                "description": "Total losses"
              },
              "kdRatio": {
                "type": "number",
                "description": "Kill/Death ratio"
              },
              "winLossRatio": {
                "type": "number",
                "description": "Win/Loss ratio"
              },
              "scorePerMinute": {
                "type": "number",
                "description": "Score per minute"
              },
              "timePlayed": {
                "type": "number",
                "description": "Time played (seconds)"
              }
            }
          }
        }
      },
      "MatchHistory": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "summary": {
            "type": "object",
            "description": "Match summary statistics"
          }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "matchID": {
            "type": "string",
            "description": "Unique match identifier"
          },
          "mode": {
            "type": "string",
            "description": "Game mode"
          },
          "map": {
            "type": "string",
            "description": "Map name"
          },
          "result": {
            "type": "string",
            "description": "Match result (win/loss/draw)"
          },
          "kills": {
            "type": "integer",
            "description": "Kills in match"
          },
          "deaths": {
            "type": "integer",
            "description": "Deaths in match"
          },
          "score": {
            "type": "integer",
            "description": "Match score"
          },
          "duration": {
            "type": "integer",
            "description": "Match duration (seconds)"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Match timestamp"
          }
        }
      },
      "AccountInfo": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Account username"
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL"
          },
          "level": {
            "type": "integer",
            "description": "Account level"
          },
          "prestige": {
            "type": "integer",
            "description": "Account prestige"
          }
        }
      },
      "UserAccounts": {
        "type": "object",
        "properties": {
          "battle": {
            "$ref": "#/components/schemas/AccountInfo"
          },
          "xbl": {
            "$ref": "#/components/schemas/AccountInfo"
          },
          "uno": {
            "$ref": "#/components/schemas/AccountInfo"
          },
          "steam": {
            "$ref": "#/components/schemas/AccountInfo"
          },
          "psn": {
            "$ref": "#/components/schemas/AccountInfo"
          }
        }
      },
      "TitleIdentities": {
        "type": "object",
        "properties": {
          "titleIdentities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Game title"
                },
                "username": {
                  "type": "string",
                  "description": "Username for this title"
                }
              }
            }
          }
        }
      },
      "LootData": {
        "type": "object",
        "properties": {
          "categoryName": {
            "type": "string",
            "description": "Category name"
          },
          "categoryTitle": {
            "type": "string",
            "description": "Category title"
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Tier information"
            }
          },
          "chase": {
            "type": "object",
            "description": "Chase items"
          }
        }
      },
      "GameStatusResponse": {
        "type": "object",
        "properties": {
          "updatedTime": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "serverStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerStatus"
            },
            "description": "List of server statuses"
          },
          "redAlertTranslations": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Red alert translations"
          },
          "redAlerts": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Current red alerts"
          },
          "recentlyResolved": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Recently resolved issues"
          },
          "platformsRO": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Platform read-only data"
          },
          "issuesListRO": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Issues list read-only data"
          },
          "gameTitlesRO": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Game titles read-only data"
          },
          "gameTitles": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Game titles data"
          },
          "eventHistories": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Event histories"
          }
        }
      },
      "ServerStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true,
            "description": "Server status (outage, maintenance, etc.)"
          },
          "platform": {
            "type": "string",
            "description": "Platform name"
          },
          "gameTitle": {
            "type": "string",
            "description": "Game title"
          },
          "eventId": {
            "type": "string",
            "description": "Event ID"
          },
          "alertId": {
            "type": "string",
            "description": "Alert ID"
          }
        }
      },
      "BanCheckResponse": {
        "type": "object",
        "properties": {
          "banned": {
            "type": "boolean",
            "description": "Whether the account is banned",
            "example": false
          },
          "reason": {
            "type": "string",
            "description": "Reason for the ban (if banned)",
            "example": null
          },
          "banDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the ban was issued (if banned)",
            "example": null
          },
          "duration": {
            "type": "string",
            "description": "Duration of the ban (if banned)",
            "example": null
          },
          "canAppeal": {
            "type": "boolean",
            "description": "Whether the ban can be appealed",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Additional information about the ban status",
            "example": "Account is in good standing"
          }
        }
      },
      "ReCaptchaToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Google reCAPTCHA verification token",
            "example": "03AFcWeA7hhSvsqcpU3GAkKSQYBV65wMfz_P6pNZz-X63p6XK8qakBGC6wdAcsRu3yBpKS0vZOW7C7o2RTPYEXy5Kq68bJGZQXH_zHlc0c_F_UA6_b2lpjMudbHn2_pT76nZ2hM9473RI-AMdPv4qAVFyordY6rITMRDF2gw24wFdRVA9xUIBvDQ2zlXS2Gw41WC9ang6Sf1I-2yogHUVXLXDN3ruOY--v3nKNSTns8Uokif67-oHKhEX481ubvm1aFjeiBwJZX1aAfEas8G4DPm9GWN7FlIZHl53HxY-3HZqL8leBi17sVp-HMrFP0WNkgHYKQv18PpnQg72743bIY3p5ksLYKoO_I0KZHmtVf-6TG31LohrIYkRDjwRcgbm4D-3NI5DC_n0jiNpkE-hmztrnH65SwFzM7uFU30FTzxI0MZvpSlx1-7AUQIeEu8SmNLREkkwdvNHeZ7d2u8m2JMNuJNdfP5IhQHBf1XxfCeb-UFKT0auOfOOq8_wd1jqbQ72tMDTUODrq6P25turGyDaWSOfVAA631xnSGtpfLTzmABeN_XLJ0E3mI0Lc3FKCiRPHX3FCdsTyTE8fqN4sfhXHD2-J9gW6LSaBFLt-rZGXLEj-Q7n9mcQoxMuyGco0HlaVr85dvRqCRffgP782tqe2cLYm5bZg1VnovGV9azEmIgyLaBbyPOcsSyzxuYYs7XiRM7T98akx3Cctyey2tEFfIVZGiU7aGPll98k1RxxECzxT62zaDLGOL1tike3EK3mdkzwLLOxgTI8VeccFpBBR0IDvggct3_SYYWu9P4r13fPdNUwfnOGGiPZCnTm5FQf8LTln06jsv077NzL4xNNLalsBN39VKGoClwJyH9IS9jT0mW_oJWn78KOegpAkofD0S60isihehaEjtO0EkE3pnvt1fVEuZ3LpHfU3iXwKvQ6PH6LdcqsK2yHJdCUERcW0rhFx_uvNY3-PestRqYhJ7xhH8wYvQyDLPscgp0ke1xnONI6iLlkwM-N-KN8nXlDUqex5_Fy4fSpjxk1_EHAH6a9eqI4CxjUmlArV86ByltHZlIAeu4C3EQrw0n6McmVBXdO94pRHj4wKNSzdMTJmIoeAPEbhENp4XDFYBjHGfqW68Zh1S_Wr1HDEqsAJfenh_OBg30MJK3_RhnheRjEATOH7FcXaxbFj7JIxiHfWn9cXhHDjMRRTsHPZt64-oEr-Ww1TArkEnpPDKB4zrrpzwkHFWf0rdV3XLpQ22hWu7dPRQY15tObFxVpFMs7sG5ZVfPDWSqCqkfs4Hao_YvvyiXC-tI_9Y_XFI7RFot0lRQb9W6fZYP6rPZTApIBEChb0pIq7oT8hOgHu6LYYqNApBcD-m3XIhoWZtM98zQ-Ue9Ao1vqnX7LSg965njFAm9FqAYpGobvJRtb8WkUe1MGPt3JCSlrAYcR1EXCfS6UtW_Xlsf7Jo6dh-ulaqi4NVPyMuVgrkVs9Y--20yDbVXEcSlLt7Yr0WJGZf7YedwZEBhgZ9zQay7gg5thamK9Hyw6K4loaAwZqLpNTZwgcme4LJtK_Wj_UIA8rsrZkvUDnc-Pk5s7S5qXp9rcxY1W2I0w5Jp-jh01qteERXH4izrxksJYF4Po_6CsREiq11hCQcyw6zCxxvWA2ZsTmP0x4s-FZgsYxcZedQDYvyBXgEgewpvQm_WXYz6IR9czWb9h_UTN3QtbmwUCJwaGpscIYfdYQ6276WFKJVb_4XOITyfKG_QLSmxiJ5DQ0DZGxt3UoKf910HST7RDfWbRpA4OI8naga1qvWpBtUBVUlu3OITTT_iqwThhUzmKDrgSLvmUzyClixPAifjHGtT5HvHa5qwloG-x3tIoKxTnqXYbptelTSHDHSzRZeJlGbvpmOkvshSajagEckVp0V10ibcABHFPvF8v6BuKG8oOa6-eFnimLs3lQUSszL5YLvM_ic4WSrCoVjFP5"
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "Token expiration time",
            "example": "2026-01-26T19:00:00Z"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "data": {
            "type": "object",
            "description": "Success response data (varies by endpoint)"
          },
          "message": {
            "type": "string",
            "description": "Success message (optional)"
          }
        }
      },
      "PlayerStatsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/PlayerStats"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ],
                "example": "success"
              }
            }
          }
        ]
      },
      "AccountInfoResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/AccountInfo"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ],
                "example": "success"
              }
            }
          }
        ]
      },
      "MatchHistoryResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/MatchHistory"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ],
                "example": "success"
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "Platform": {
        "name": "platform",
        "in": "path",
        "required": true,
        "description": "Platform code (battle, bnet, uno, xbl, psn, steam)",
        "schema": {
          "type": "string",
          "enum": [
            "battle",
            "bnet",
            "uno",
            "xbl",
            "psn",
            "steam"
          ],
          "example": "uno"
        }
      },
      "Username": {
        "name": "username",
        "in": "path",
        "required": true,
        "description": "Player username (URL encoded)",
        "schema": {
          "type": "string",
          "example": "camjowl%238749827"
        }
      },
      "Title": {
        "name": "title",
        "in": "path",
        "required": true,
        "description": "Game title code",
        "schema": {
          "type": "string",
          "enum": [
            "mw2",
            "mw3",
            "mw",
            "bo4",
            "cw",
            "vg",
            "bo3",
            "iw",
            "ww2",
            "jup",
            "cer",
            "bo7"
          ],
          "example": "mw2"
        }
      },
      "Mode": {
        "name": "mode",
        "in": "path",
        "required": true,
        "description": "Game mode",
        "schema": {
          "type": "string",
          "enum": [
            "mp",
            "wz",
            "zm"
          ],
          "example": "mp"
        }
      },
      "GameMode": {
        "name": "gameMode",
        "in": "path",
        "required": true,
        "description": "Specific game mode type",
        "schema": {
          "type": "string",
          "example": "all"
        }
      },
      "Timeframe": {
        "name": "timeframe",
        "in": "path",
        "required": true,
        "description": "Time period for stats",
        "schema": {
          "type": "string",
          "enum": [
            "alltime",
            "daily",
            "weekly",
            "monthly"
          ],
          "example": "alltime"
        }
      },
      "Type": {
        "name": "type",
        "in": "path",
        "required": true,
        "description": "Stats type",
        "schema": {
          "type": "string",
          "enum": [
            "core",
            "hardcore"
          ],
          "example": "core"
        }
      },
      "Start": {
        "name": "start",
        "in": "path",
        "required": true,
        "description": "Start index for match history",
        "schema": {
          "type": "integer",
          "default": 0,
          "example": 0
        }
      },
      "End": {
        "name": "end",
        "in": "path",
        "required": true,
        "description": "End index for match history",
        "schema": {
          "type": "integer",
          "default": 0,
          "example": 0
        }
      },
      "Locale": {
        "name": "locale",
        "in": "query",
        "required": false,
        "description": "Locale for response",
        "schema": {
          "type": "string",
          "default": "en_US",
          "example": "en_US"
        }
      },
      "LocalePath": {
        "name": "locale",
        "in": "path",
        "required": true,
        "description": "Locale for response",
        "schema": {
          "type": "string",
          "enum": [
            "en_US",
            "es_ES",
            "fr_FR",
            "de_DE",
            "it_IT",
            "pt_BR",
            "ru_RU",
            "ja_JP",
            "ko_KR",
            "zh_CN"
          ],
          "example": "en_US"
        }
      },
      "UnoId": {
        "name": "unoId",
        "in": "path",
        "required": true,
        "description": "UNO ID for user identification",
        "schema": {
          "type": "string",
          "example": 123456789
        }
      },
      "List": {
        "name": "list",
        "in": "path",
        "required": true,
        "description": "List type for loot data",
        "schema": {
          "type": "string",
          "enum": [
            "season",
            "featured",
            "bundles"
          ],
          "example": "season"
        }
      },
      "Otp": {
        "name": "otp",
        "in": "path",
        "required": true,
        "description": "One-time password for gifting verification",
        "schema": {
          "type": "string",
          "example": 123456
        }
      },
      "Sku": {
        "name": "sku",
        "in": "path",
        "required": true,
        "description": "Stock keeping unit for items",
        "schema": {
          "type": "string",
          "example": 12345
        }
      },
      "Item": {
        "name": "item",
        "in": "path",
        "required": true,
        "description": "Item identifier",
        "schema": {
          "type": "string",
          "example": 12345
        }
      },
      "ReCaptchaToken": {
        "name": "g-cc",
        "in": "query",
        "required": true,
        "description": "Google reCAPTCHA verification token",
        "schema": {
          "type": "string",
