                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/FieldConfig" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/enrichment-config": {
      "get": {
        "operationId": "getEnrichmentConfig",
