{
  "openapi": "3.0.3",
  "info": {
    "title": "Shoot-360 Payment Middleware API",
    "description": "## Overview\nThe Shoot-360 Payment Middleware API provides a unified payment processing layer for all Point of Sale (POS) \ntransactions across multiple countries (US, Thailand, Philippines, Japan). \n\nThis middleware acts as an abstraction layer between e-commerce front-ends and third-party Payment Service Providers \n(PSPs) such as **Stripe**, **PayPal**, and **Square**.\n\n## Key Features\n- **Multi-PSP Support** — Seamlessly route transactions to configured payment providers per POS location.\n- **PCI DSS Compliant** — All cardholder data is encrypted and tokenized; raw card data is never stored.\n- **Multi-Currency** — Supports local currencies (USD, THB, PHP, JPY) with automatic formatting.\n- **Extensible** — Easily onboard new PSPs and business capabilities (merchandise, loyalty, court rentals).\n\n## Security & Compliance\n- All API requests must use **HTTPS/TLS 1.2+**\n- Card data is **tokenized** before storage; raw PAN is never persisted.\n- Authentication via **Bearer JWT tokens** (OAuth 2.0) for admin endpoints.\n- API keys (public/secret) are **AES-256 encrypted** at rest.\n- Fully compliant with **PCI DSS v4.0** standards.\n\n## Authentication\n- **Customer-facing endpoints**: Authenticated via session tokens issued by the e-commerce platform.\n- **Admin endpoints**: Authenticated via OAuth 2.0 Bearer tokens with role-based access control.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Shoot-360 Engineering Team",
      "email": "engineering@shoot360.com",
      "url": "https://shoot360.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://shoot360.com/terms"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/self-9e6/shoot-360-payment-middleware-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.shoot360.com/v1",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Payments",
      "description": "Customer-facing payment processing endpoints. These endpoints are invoked by the e-commerce \nwebsite to initiate and process payments. All credit card data is tokenized upon receipt.\n"
    },
    {
      "name": "Payment Service Providers",
      "description": "Admin endpoints for managing Payment Service Provider (PSP) configurations. These endpoints \nallow administrators to register, update, retrieve, and remove PSP integrations per POS.\n"
    },
    {
      "name": "PSP Transactions",
      "description": "Admin endpoints for invoking PSP API endpoints directly with valid authentication credentials.\n"
    },
    {
      "name": "Health",
      "description": "System health and status checks."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Returns the health status of the payment middleware service.",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-03-17T12:00:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create a Payment",
        "description": "Initiates a new payment transaction. This endpoint is invoked by the business e-commerce website.\n\n**Flow:**\n1. Customer payment details are received and validated.\n2. Credit card data is immediately **tokenized** (PCI DSS compliant).\n3. The payment is routed to the configured PSP for the originating POS.\n4. Transaction result is recorded in the backend database.\n5. A payment confirmation object is returned.\n\n> ⚠️ **PCI DSS Note:** Raw card numbers (PAN) are never stored. Only tokenized references are persisted.\n",
        "operationId": "createPayment",
        "security": [
          {
            "SessionToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              },
              "examples": {
                "usd_payment": {
                  "summary": "US Dollar Payment",
                  "value": {
                    "customer": {
                      "first_name": "John",
                      "last_name": "Doe",
                      "email": "john.doe@example.com",
                      "phone": "+1-555-0123",
                      "address": {
                        "line1": "123 Main Street",
                        "line2": "Suite 400",
                        "city": "Los Angeles",
                        "state": "CA",
                        "postal_code": "90001",
                        "country": "US"
                      }
                    },
                    "payment_method": {
                      "type": "card",
                      "card": {
                        "number": "4242424242424242",
                        "exp_month": 12,
                        "exp_year": 2028,
                        "cvc": "314",
                        "cardholder_name": "John Doe"
                      }
                    },
                    "amount": 15000,
                    "currency": "usd",
                    "description": "Basketball training session - Advanced",
                    "metadata": {
                      "pos_id": "pos_us_la_001",
                      "order_id": "ORD-2026-00142",
                      "service_type": "training"
                    }
                  }
                },
                "jpy_payment": {
                  "summary": "Japanese Yen Payment",
                  "value": {
                    "customer": {
                      "first_name": "Takeshi",
                      "last_name": "Yamamoto",
                      "email": "takeshi@example.jp",
                      "phone": "+81-90-1234-5678",
                      "address": {
                        "line1": "1-2-3 Shibuya",
                        "city": "Tokyo",
                        "postal_code": "150-0002",
                        "country": "JP"
                      }
                    },
                    "payment_method": {
                      "type": "card",
                      "card": {
                        "number": "4000003920000003",
                        "exp_month": 6,
                        "exp_year": 2027,
                        "cvc": "123",
                        "cardholder_name": "Takeshi Yamamoto"
                      }
                    },
                    "amount": 250000,
                    "currency": "jpy",
                    "description": "Court rental - 2 hours",
                    "metadata": {
                      "pos_id": "pos_jp_tokyo_001",
                      "order_id": "ORD-JP-2026-00087",
                      "service_type": "court_rental"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                },
                "example": {
                  "id": "pay_1N5xK2eZvKYlo2CjJnGxBpZ7",
                  "object": "payment",
                  "status": "succeeded",
                  "amount": 15000,
                  "currency": "usd",
                  "description": "Basketball training session - Advanced",
                  "payment_method": {
                    "id": "pm_1N5xK2eZvKYlo2CjCard001",
                    "type": "card",
                    "card": {
                      "brand": "visa",
                      "last4": "4242",
                      "exp_month": 12,
                      "exp_year": 2028,
                      "funding": "credit"
                    }
                  },
                  "customer": {
                    "id": "cus_OaB3FhkP9q2nYZ",
                    "first_name": "John",
                    "last_name": "Doe",
                    "email": "john.doe@example.com"
                  },
                  "psp_reference": {
                    "provider": "stripe",
                    "transaction_id": "ch_3N5xK2eZvKYlo2Cj0lFe7LkS"
                  },
                  "metadata": {
                    "pos_id": "pos_us_la_001",
                    "order_id": "ORD-2026-00142",
                    "service_type": "training"
                  },
                  "created_at": "2026-03-17T12:30:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Payment failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "type": "card_error",
                    "code": "card_declined",
                    "message": "Your card was declined. Please try a different payment method.",
                    "decline_code": "insufficient_funds"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/payments/{payment_id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Retrieve a Payment",
        "description": "Retrieves the details of a previously created payment by its unique identifier.",
        "operationId": "getPayment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/admin/payment-service-providers": {
      "post": {
        "tags": [
          "Payment Service Providers"
        ],
        "summary": "Register a Payment Service Provider",
        "description": "Registers a new Payment Service Provider (PSP) configuration. This allows administrators \nto onboard providers like Stripe, PayPal, or Square for specific POS locations.\n\n**Security:** API keys (public and secret) are encrypted using AES-256 before storage. \nSecret keys are never returned in API responses after initial creation.\n",
        "operationId": "createPSP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PSPCreateRequest"
              },
              "examples": {
                "stripe_us": {
                  "summary": "Register Stripe for US POS",
                  "value": {
                    "name": "Stripe",
                    "code": "stripe",
                    "description": "Stripe payment processing for US operations",
                    "api_base_url": "https://api.stripe.com/v1",
                    "credentials": {
                      "public_key": "pk_live_51N5xK2eZvKYlo2Cj...",
                      "secret_key": "sk_live_51N5xK2eZvKYlo2Cj..."
                    },
                    "supported_currencies": [
                      "usd"
                    ],
                    "supported_payment_methods": [
                      "card",
                      "bank_transfer"
                    ],
                    "pos_assignments": [
                      "pos_us_la_001",
                      "pos_us_ny_001"
                    ],
                    "webhook_url": "https://api.shoot360.com/v1/webhooks/stripe",
                    "is_active": true,
                    "environment": "production"
                  }
                },
                "paypal_ph": {
                  "summary": "Register PayPal for Philippines POS",
                  "value": {
                    "name": "PayPal",
                    "code": "paypal",
                    "description": "PayPal payment processing for Philippines operations",
                    "api_base_url": "https://api.paypal.com/v2",
                    "credentials": {
                      "public_key": "AYSq3RDGsmBLJE...",
                      "secret_key": "EGnHDxD_qRPdaS..."
                    },
                    "supported_currencies": [
                      "php"
                    ],
                    "supported_payment_methods": [
                      "card",
                      "paypal_wallet"
                    ],
                    "pos_assignments": [
                      "pos_ph_manila_001"
                    ],
                    "webhook_url": "https://api.shoot360.com/v1/webhooks/paypal",
                    "is_active": true,
                    "environment": "production"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PSP successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PSPResponse"
                },
                "example": {
                  "id": "psp_stripe_us_001",
                  "object": "payment_service_provider",
                  "name": "Stripe",
                  "code": "stripe",
                  "description": "Stripe payment processing for US operations",
                  "api_base_url": "https://api.stripe.com/v1",
                  "credentials": {
                    "public_key": "pk_live_51N5xK2eZvKYlo2Cj...",
                    "secret_key": "sk_live_••••••••••••"
                  },
                  "supported_currencies": [
                    "usd"
                  ],
                  "supported_payment_methods": [
                    "card",
                    "bank_transfer"
                  ],
                  "pos_assignments": [
                    "pos_us_la_001",
                    "pos_us_ny_001"
                  ],
                  "webhook_url": "https://api.shoot360.com/v1/webhooks/stripe",
                  "is_active": true,
                  "environment": "production",
                  "created_at": "2026-03-17T10:00:00Z",
                  "updated_at": "2026-03-17T10:00:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "PSP with this code already exists for the assigned POS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "get": {
        "tags": [
          "Payment Service Providers"
        ],
        "summary": "List All Payment Service Providers",
        "description": "Retrieves a paginated list of all registered Payment Service Providers. \nSupports filtering by status, country, and provider code.\n",
        "operationId": "listPSPs",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (1-indexed)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Number of records per page",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "description": "Filter by active status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Filter by provider code (e.g., stripe, paypal, square)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Filter by associated country code (ISO 3166-1 alpha-2)",
            "schema": {
              "type": "string",
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of PSPs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PSPResponse"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/payment-service-providers/{psp_id}": {
      "get": {
        "tags": [
          "Payment Service Providers"
        ],
        "summary": "Retrieve a Payment Service Provider",
        "description": "Retrieves the details of a specific Payment Service Provider by its unique ID.",
        "operationId": "getPSP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PSPId"
          }
        ],
        "responses": {
          "200": {
            "description": "PSP details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PSPResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Payment Service Providers"
        ],
        "summary": "Update a Payment Service Provider",
        "description": "Partially updates a Payment Service Provider configuration. Only provided fields will be updated.\n\n> ⚠️ **Note:** When updating credentials, both `public_key` and `secret_key` must be provided together.\n",
        "operationId": "updatePSP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PSPId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PSPUpdateRequest"
              },
              "example": {
                "description": "Updated Stripe configuration for US",
                "is_active": true,
                "credentials": {
                  "public_key": "pk_live_NEW_KEY...",
                  "secret_key": "sk_live_NEW_SECRET..."
                },
                "supported_currencies": [
                  "usd",
                  "cad"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PSP updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PSPResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Payment Service Providers"
        ],
        "summary": "Delete a Payment Service Provider",
        "description": "Removes a Payment Service Provider configuration. This is a **soft delete** — the record is \nmarked as inactive and retained for audit purposes. Active transactions will not be affected.\n",
        "operationId": "deletePSP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PSPId"
          }
        ],
        "responses": {
          "200": {
            "description": "PSP successfully deleted (soft delete)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "psp_stripe_us_001"
                    },
                    "object": {
                      "type": "string",
                      "example": "payment_service_provider"
                    },
                    "deleted": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/admin/payment-service-providers/{psp_id}/invoke": {
      "post": {
        "tags": [
          "PSP Transactions"
        ],
        "summary": "Invoke PSP API Endpoint",
        "description": "Directly invokes a configured PSP's API endpoint using the stored credentials (public/secret key).\n\nThis endpoint acts as a **secure proxy** to the PSP, automatically injecting the appropriate \nauthentication headers. Useful for:\n- Processing refunds\n- Checking transaction status at the PSP\n- Creating PSP-specific resources (e.g., Stripe customers, PayPal orders)\n\n> 🔒 **Security:** The secret key is retrieved from encrypted storage and injected server-side. \n> It is never exposed to the caller.\n",
        "operationId": "invokePSPEndpoint",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PSPId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PSPInvokeRequest"
              },
              "examples": {
                "stripe_charge": {
                  "summary": "Create a Stripe Charge",
                  "value": {
                    "method": "POST",
                    "endpoint": "/charges",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": {
                      "amount": 15000,
                      "currency": "usd",
                      "source": "tok_visa",
                      "description": "Shoot-360 Training Session"
                    }
                  }
                },
                "paypal_order": {
                  "summary": "Create a PayPal Order",
                  "value": {
                    "method": "POST",
                    "endpoint": "/checkout/orders",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "intent": "CAPTURE",
                      "purchase_units": [
                        {
                          "amount": {
                            "currency_code": "PHP",
                            "value": "5000.00"
                          },
                          "description": "Court Rental - Manila POS"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PSP API call executed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PSPInvokeResponse"
                },
                "example": {
                  "success": true,
                  "psp_provider": "stripe",
                  "http_status": 200,
                  "response_body": {
                    "id": "ch_3N5xK2eZvKYlo2Cj0lFe7LkS",
                    "object": "charge",
                    "amount": 15000,
                    "currency": "usd",
                    "status": "succeeded"
                  },
                  "invoked_at": "2026-03-17T12:35:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "description": "PSP returned an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "type": "psp_error",
                    "code": "psp_api_failure",
                    "message": "The payment service provider returned an error.",
                    "psp_response": {
                      "status": 400,
                      "body": {
                        "error": "Invalid API Key"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 Bearer token for admin endpoints. Tokens are issued by the Shoot-360 \nIdentity Provider and include role-based claims.\n"
      },
      "SessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Session-Token",
        "description": "Session token issued by the e-commerce platform upon customer authentication. \nUsed for customer-facing payment endpoints.\n"
      }
    },
    "parameters": {
      "PaymentId": {
        "name": "payment_id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the payment (prefixed with `pay_`)",
        "schema": {
          "type": "string",
          "pattern": "^pay_[a-zA-Z0-9]{24}$",
          "example": "pay_1N5xK2eZvKYlo2CjJnGxBpZ7"
        }
      },
      "PSPId": {
        "name": "psp_id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the Payment Service Provider (prefixed with `psp_`)",
        "schema": {
          "type": "string",
          "pattern": "^psp_[a-zA-Z0-9_]{5,50}$",
          "example": "psp_stripe_us_001"
        }
      }
    },
    "schemas": {
      "PaymentRequest": {
        "type": "object",
        "required": [
          "customer",
          "payment_method",
          "amount",
          "currency"
        ],
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/CustomerInfo"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "amount": {
            "type": "integer",
            "description": "Payment amount in the **smallest currency unit** (e.g., cents for USD, satang for THB).\nExample: $150.00 = 15000\n",
            "minimum": 1,
            "example": 15000
          },
          "currency": {
            "type": "string",
            "description": "Three-letter ISO 4217 currency code (lowercase)",
            "enum": [
              "usd",
              "thb",
              "php",
              "jpy"
            ],
            "example": "usd"
          },
          "description": {
            "type": "string",
            "description": "An arbitrary string describing the payment",
            "maxLength": 500,
            "example": "Basketball training session - Advanced"
          },
          "metadata": {
            "type": "object",
            "description": "Set of key-value pairs for storing additional information. \nUseful for linking to POS, orders, or service types.\n",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "pos_id": "pos_us_la_001",
              "order_id": "ORD-2026-00142",
              "service_type": "training"
            }
          }
        }
      },
      "CustomerInfo": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "email",
          "address"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Customer's first name",
            "maxLength": 100,
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "description": "Customer's last name",
            "maxLength": 100,
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Customer's email address",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Customer's phone number (E.164 format recommended)",
            "example": "+1-555-0123"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "postal_code",
          "country"
        ],
        "properties": {
          "line1": {
            "type": "string",
            "maxLength": 200,
            "example": "123 Main Street"
          },
          "line2": {
            "type": "string",
            "maxLength": 200,
            "example": "Suite 400"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "example": "Los Angeles"
          },
          "state": {
            "type": "string",
            "maxLength": 100,
            "example": "CA"
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20,
            "example": "90001"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "minLength": 2,
            "maxLength": 2,
            "example": "US"
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "required": [
          "type",
          "card"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of payment method",
            "enum": [
              "card",
              "bank_transfer",
              "wallet"
            ],
            "example": "card"
          },
          "card": {
            "$ref": "#/components/schemas/CardDetails"
          }
        }
      },
      "CardDetails": {
        "type": "object",
        "description": "Credit/debit card details. **PCI DSS Compliance:** Card data is tokenized immediately \nupon receipt. The full card number and CVC are never stored in the database.\n",
        "required": [
          "number",
          "exp_month",
          "exp_year",
          "cvc",
          "cardholder_name"
        ],
        "properties": {
          "number": {
            "type": "string",
            "description": "Card number (PAN). Transmitted over TLS and immediately tokenized.",
            "pattern": "^[0-9]{13,19}$",
            "example": "4242424242424242"
          },
          "exp_month": {
            "type": "integer",
            "description": "Two-digit expiration month (1-12)",
            "minimum": 1,
            "maximum": 12,
            "example": 12
          },
          "exp_year": {
            "type": "integer",
            "description": "Four-digit expiration year",
            "minimum": 2026,
            "example": 2028
          },
          "cvc": {
            "type": "string",
            "description": "Card verification code (3-4 digits). Never stored.",
            "pattern": "^[0-9]{3,4}$",
            "example": "314"
          },
          "cardholder_name": {
            "type": "string",
            "description": "Name on the card",
            "maxLength": 200,
            "example": "John Doe"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique payment identifier",
            "example": "pay_1N5xK2eZvKYlo2CjJnGxBpZ7"
          },
          "object": {
            "type": "string",
            "example": "payment"
          },
          "status": {
            "type": "string",
            "description": "Current payment status",
            "enum": [
              "pending",
              "processing",
              "succeeded",
              "failed",
              "refunded",
              "cancelled"
            ],
            "example": "succeeded"
          },
          "amount": {
            "type": "integer",
            "example": 15000
          },
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "description": {
            "type": "string",
            "example": "Basketball training session - Advanced"
          },
          "payment_method": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "pm_1N5xK2eZvKYlo2CjCard001"
              },
              "type": {
                "type": "string",
                "example": "card"
              },
              "card": {
                "type": "object",
                "description": "Masked card info (last 4 digits only)",
                "properties": {
                  "brand": {
                    "type": "string",
                    "enum": [
                      "visa",
                      "mastercard",
                      "amex",
                      "discover",
                      "jcb",
                      "unionpay"
                    ],
                    "example": "visa"
                  },
                  "last4": {
                    "type": "string",
                    "example": "4242"
                  },
                  "exp_month": {
                    "type": "integer",
                    "example": 12
                  },
                  "exp_year": {
                    "type": "integer",
                    "example": 2028
                  },
                  "funding": {
                    "type": "string",
                    "enum": [
                      "credit",
                      "debit",
                      "prepaid",
                      "unknown"
                    ],
                    "example": "credit"
                  }
                }
              }
            }
          },
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "cus_OaB3FhkP9q2nYZ"
              },
              "first_name": {
                "type": "string",
                "example": "John"
              },
              "last_name": {
                "type": "string",
                "example": "Doe"
              },
              "email": {
                "type": "string",
                "example": "john.doe@example.com"
              }
            }
          },
          "psp_reference": {
            "type": "object",
            "description": "Reference to the PSP transaction",
            "properties": {
              "provider": {
                "type": "string",
                "example": "stripe"
              },
              "transaction_id": {
                "type": "string",
                "example": "ch_3N5xK2eZvKYlo2Cj0lFe7LkS"
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-17T12:30:00Z"
          }
        }
      },
      "PSPCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "code",
          "api_base_url",
          "credentials",
          "supported_currencies",
          "supported_payment_methods",
          "pos_assignments",
          "environment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the PSP",
            "maxLength": 100,
            "example": "Stripe"
          },
          "code": {
            "type": "string",
            "description": "Unique code identifier for the PSP (lowercase, no spaces)",
            "pattern": "^[a-z][a-z0-9_]{1,30}$",
            "example": "stripe"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "example": "Stripe payment processing for US operations"
          },
          "api_base_url": {
            "type": "string",
            "format": "uri",
            "description": "Base URL for the PSP's API",
            "example": "https://api.stripe.com/v1"
          },
          "credentials": {
            "$ref": "#/components/schemas/PSPCredentials"
          },
          "supported_currencies": {
            "type": "array",
            "description": "ISO 4217 currency codes supported by this PSP configuration",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "example": [
              "usd"
            ]
          },
          "supported_payment_methods": {
            "type": "array",
            "description": "Payment methods supported by this PSP",
            "items": {
              "type": "string",
              "enum": [
                "card",
                "bank_transfer",
                "paypal_wallet",
                "gcash",
                "line_pay",
                "paypay"
              ]
            },
            "minItems": 1,
            "example": [
              "card",
              "bank_transfer"
            ]
          },
          "pos_assignments": {
            "type": "array",
            "description": "POS location identifiers that should route to this PSP",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "example": [
              "pos_us_la_001",
              "pos_us_ny_001"
            ]
          },
          "webhook_url": {
            "type": "string",
            "format": "uri",
            "description": "URL for receiving PSP webhook notifications",
            "example": "https://api.shoot360.com/v1/webhooks/stripe"
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether this PSP configuration is active",
            "default": true
          },
          "environment": {
            "type": "string",
            "description": "Deployment environment",
            "enum": [
              "sandbox",
              "production"
            ],
            "example": "production"
          }
        }
      },
      "PSPCredentials": {
        "type": "object",
        "description": "PSP API credentials. **Security:** Keys are encrypted with AES-256 before storage. \nSecret keys are masked in all API responses after creation.\n",
        "required": [
          "public_key",
          "secret_key"
        ],
        "properties": {
          "public_key": {
            "type": "string",
            "description": "Public/publishable API key",
            "example": "pk_live_51N5xK2eZvKYlo2Cj..."
          },
          "secret_key": {
            "type": "string",
            "description": "Secret API key (write-only — masked in responses)",
            "example": "sk_live_51N5xK2eZvKYlo2Cj..."
          }
        }
      },
      "PSPUpdateRequest": {
        "type": "object",
        "description": "Partial update for PSP configuration. Only provided fields are updated.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "credentials": {
            "$ref": "#/components/schemas/PSPCredentials"
          },
          "supported_currencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supported_payment_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pos_assignments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "is_active": {
            "type": "boolean"
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ]
          }
        }
      },
      "PSPResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "psp_stripe_us_001"
          },
          "object": {
            "type": "string",
            "example": "payment_service_provider"
          },
          "name": {
            "type": "string",
            "example": "Stripe"
          },
          "code": {
            "type": "string",
            "example": "stripe"
          },
          "description": {
            "type": "string",
            "example": "Stripe payment processing for US operations"
          },
          "api_base_url": {
            "type": "string",
            "example": "https://api.stripe.com/v1"
          },
          "credentials": {
            "type": "object",
            "properties": {
              "public_key": {
                "type": "string",
                "example": "pk_live_51N5xK2eZvKYlo2Cj..."
              },
              "secret_key": {
                "type": "string",
                "description": "Always masked in responses",
                "example": "sk_live_••••••••••••"
              }
            }
          },
          "supported_currencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "usd"
            ]
          },
          "supported_payment_methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "card",
              "bank_transfer"
            ]
          },
          "pos_assignments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "pos_us_la_001",
              "pos_us_ny_001"
            ]
          },
          "webhook_url": {
            "type": "string",
            "example": "https://api.shoot360.com/v1/webhooks/stripe"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "environment": {
            "type": "string",
            "example": "production"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PSPInvokeRequest": {
        "type": "object",
        "required": [
          "method",
          "endpoint"
        ],
        "properties": {
          "method": {
            "type": "string",
            "description": "HTTP method for the PSP API call",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "example": "POST"
          },
          "endpoint": {
            "type": "string",
            "description": "PSP API endpoint path (appended to the PSP's base URL)",
            "example": "/charges"
          },
          "headers": {
            "type": "object",
            "description": "Additional headers to include in the PSP request",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "object",
            "description": "Request body to send to the PSP endpoint",
            "additionalProperties": true
          }
        }
      },
      "PSPInvokeResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "psp_provider": {
            "type": "string",
            "example": "stripe"
          },
          "http_status": {
            "type": "integer",
            "example": 200
          },
          "response_body": {
            "type": "object",
            "description": "Raw response from the PSP",
            "additionalProperties": true
          },
          "invoked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Error type category",
                "enum": [
                  "api_error",
                  "authentication_error",
                  "authorization_error",
                  "card_error",
                  "validation_error",
                  "rate_limit_error",
                  "psp_error",
                  "not_found_error"
                ],
                "example": "validation_error"
              },
              "code": {
                "type": "string",
                "description": "Machine-readable error code",
                "example": "invalid_card_number"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message",
                "example": "The card number provided is invalid."
              },
              "param": {
                "type": "string",
                "description": "The parameter that caused the error",
                "example": "payment_method.card.number"
              },
              "decline_code": {
                "type": "string",
                "description": "Decline code from the PSP (for card errors)"
              },
              "psp_response": {
                "type": "object",
                "description": "Raw PSP error response (for psp_error type)"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "page_size": {
            "type": "integer",
            "example": 20
          },
          "total_count": {
            "type": "integer",
            "example": 5
          },
          "total_pages": {
            "type": "integer",
            "example": 1
          },
          "has_more": {
            "type": "boolean",
            "example": false
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — invalid parameters or malformed request body",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "validation_error",
                "code": "invalid_request",
                "message": "The request body is malformed or missing required fields."
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed — missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "authentication_error",
                "code": "invalid_token",
                "message": "The provided authentication token is invalid or expired."
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authorization failed — insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "authorization_error",
                "code": "insufficient_permissions",
                "message": "You do not have permission to perform this action."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "not_found_error",
                "code": "resource_not_found",
                "message": "The requested resource was not found."
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error — one or more fields failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "validation_error",
                "code": "invalid_field",
                "message": "One or more fields failed validation.",
                "param": "payment_method.card.exp_month"
              }
            }
          }
        }
      },
      "RateLimitExceeded": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "rate_limit_error",
                "code": "rate_limit_exceeded",
                "message": "Too many requests. Please retry after 60 seconds."
              }
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Number of seconds to wait before retrying"
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "type": "api_error",
                "code": "internal_error",
                "message": "An unexpected error occurred. Please try again later."
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "SessionToken": []
    }
  ]
}
