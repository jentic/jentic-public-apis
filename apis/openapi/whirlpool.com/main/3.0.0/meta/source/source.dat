{
  "openapi": "3.0.4",
  "info": {
    "title": "Manusis Integration",
    "description": "Integration of the Manusis system with the SAP ECC ERP system.",
    "version": "3.0.0",
    "contact": {
      "name": "Manusis",
      "email": "customer@manusis4.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MATHEUSLUZ39/Whirlpool/3.0.0"
  },
  "servers": [
    {
      "url": "https://api.whirlpool.com/manufacturing/v1/cmms/lar-cmms-integration-manusis-v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "functionalLocation",
      "description": "Operations related to functional locations"
    },
    {
      "name": "notification",
      "description": "Operations related to maintenance notifications"
    }
  ],
  "paths": {
    "/ZMANUSIS_LOC_SRV/functionalLocationSet": {
      "get": {
        "tags": [
          "functionalLocation"
        ],
        "operationId": "getFunctionalLocations",
        "summary": "Retorna localizações funcionais com filtros de data",
        "parameters": [
          {
            "name": "$filter",
            "in": "query",
            "description": "Filtro OData para dataDe e dataAte. Exemplo dataDe eq '1980-01-01' and dataAte eq '2025-01-31'",
            "required": true,
            "schema": {
              "type": "string",
              "example": "dataDe eq '1980-01-01' and dataAte eq '2025-01-31'"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de localizações funcionais retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "d": {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FunctionalLocation"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida, erro no filtro OData."
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ZMANUSIS_NOTAS_SRV/createNotifSet": {
      "post": {
        "tags": [
          "notification"
        ],
        "operationId": "createNotification",
        "summary": "Cria uma nova nota de manutenção no SAP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Notificação criada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos na requisição."
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Erro interno no servidor",
        "content": {
          "application/json": {
            "example": {
              "status": 500,
              "error": "Internal Server Error",
              "message": "Erro inesperado no servidor"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Chave de API necessária"
      },
      "oauth2": {
        "type": "oauth2",
        "description": "Fluxo client_credentials para autenticação",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://login.microsoftonline.com/b99c3b6c-f036-4302-8856-96366409afe5/oauth2/v2.0/token",
            "scopes": {
              "api://sap-ecc--dev/.default": "Escopo padrão"
            }
          }
        }
      }
    },
    "schemas": {
      "FunctionalLocation": {
        "type": "object",
        "description": "Detalhes de uma localização funcional",
        "properties": {
          "__metadata": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "https://larlmq0a01.whirlpool.com:8003/sap/opu/odata/sap/ZMANUSIS_LOC_SRV/functionalLocationSet('110-3-III-UTI')"
              },
              "uri": {
                "type": "string",
                "example": "https://larlmq0a01.whirlpool.com:8003/sap/opu/odata/sap/ZMANUSIS_LOC_SRV/functionalLocationSet('110-3-III-UTI')"
              },
              "type": {
                "type": "string",
                "example": "ZMANUSIS_LOC_SRV.FunctionalLocation"
              }
            }
          },
          "Pltxt": {
            "type": "string",
            "description": "Texto da planta",
            "example": "UTILIDADES E SERVIÇOS \"EQUIP. DIVER"
          },
          "dataAte": {
            "type": "string",
            "description": "Data até (formato YYYY-MM-DD)",
            "format": "date",
            "example": ""
          },
          "dataDe": {
            "type": "string",
            "description": "Data de (formato YYYY-MM-DD)",
            "format": "date",
            "example": ""
          },
          "Kostl": {
            "type": "string",
            "description": "Centro de custo",
            "example": "M015520"
          },
          "Iwerk": {
            "type": "string",
            "description": "Centro de planejamento de manutenção",
            "example": "110"
          },
          "Tplma": {
            "type": "string",
            "description": "Tipo de localização funcional",
            "example": "110-3-III"
          },
          "Tplnr": {
            "type": "string",
            "description": "Localização funcional",
            "example": "110-3-III-UTI"
          }
        }
      },
      "NotificationCreateRequest": {
        "type": "object",
        "description": "Payload para criação de uma nova nota de manutenção",
        "required": [
          "notifType",
          "shortText",
          "reportedBy",
          "notifData",
          "notifTime",
          "priority"
        ],
        "properties": {
          "notifType": {
            "type": "string",
            "description": "Tipo da notificação (ex. M1)",
            "example": "M1"
          },
          "shortText": {
            "type": "string",
            "description": "Texto curto da notificação",
            "example": "Teste Equipamento"
          },
          "reportedBy": {
            "type": "string",
            "description": "Usuário que reportou a notificação",
            "example": "GHIDIH"
          },
          "notifData": {
            "type": "string",
            "description": "Data da notificação no formato OData (ex. /Date(timestamp)/)",
            "pattern": "^/Date|$\\d+$|/$",
            "example": "/Date(1770163200000)/"
          },
          "notifTime": {
            "type": "string",
            "description": "Hora da notificação no formato de duração ISO 8601 (ex. PT10H30M00S)",
            "pattern": "^PT(\\d+H)?(\\d+M)?(\\d+S)?$",
            "example": "PT10H30M00S"
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da notificação (ex. 1)",
            "example": "1"
          },
          "functionalLocation": {
            "type": "string",
            "description": "Localização funcional associada à notificação",
            "example": "110-2-MON-FEF"
          },
          "equipment": {
            "type": "string",
            "description": "Equipamento associado à notificação",
            "example": "BV42103"
          }
        }
      },
      "NotificationCreateResponse": {
        "type": "object",
        "description": "Resposta da criação de uma nota de manutenção",
        "properties": {
          "d": {
            "type": "object",
            "properties": {
              "__metadata": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "https://larlmq0a01.whirlpool.com:8003/sap/opu/odata/sap/ZMANUSIS_NOTAS_SRV/createNotifSet('000013900674')"
                  },
                  "uri": {
                    "type": "string",
                    "example": "https://larlmq0a01.whirlpool.com:8003/sap/opu/odata/sap/ZMANUSIS_NOTAS_SRV/createNotifSet('000013900674')"
                  },
                  "type": {
                    "type": "string",
                    "example": "ZMANUSIS_NOTAS_SRV.createNotif"
                  }
                }
              },
              "notifNumber": {
                "type": "string",
                "description": "Número da notificação criada",
                "example": "000013900674"
              },
              "equipment": {
                "type": "string",
                "description": "Equipamento associado (pode vir vazio se não for o foco principal)",
                "example": ""
              },
              "functionalLocation": {
                "type": "string",
                "description": "Localização funcional associada (pode vir vazio se não for o foco principal)",
                "example": ""
              },
              "notifData": {
                "type": "string",
                "description": "Data da notificação no formato OData (ex. /Date(timestamp)/)",
                "pattern": "^/Date|$\\d+$|/$",
                "example": "/Date(1770249600000)/"
              },
              "notifTime": {
                "type": "string",
                "description": "Hora da notificação no formato de duração ISO 8601 (ex. PT09H17M53S)",
                "pattern": "^PT(\\d+H)?(\\d+M)?(\\d+S)?$",
                "example": "PT09H17M53S"
              },
              "notifType": {
                "type": "string",
                "description": "Tipo da notificação",
                "example": ""
              },
              "priority": {
                "type": "string",
                "description": "Prioridade da notificação",
                "example": ""
              },
              "reportedBy": {
                "type": "string",
                "description": "Usuário que reportou",
                "example": ""
              },
              "shortText": {
                "type": "string",
                "description": "Texto curto da notificação",
                "example": ""
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "oauth2": [
        "api://sap-ecc--dev/.default"
      ]
    }
  ]
}
