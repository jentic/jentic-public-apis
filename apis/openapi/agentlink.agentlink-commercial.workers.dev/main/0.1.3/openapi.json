                  ],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    },
                    "retryable": {
                      "type": "boolean"
