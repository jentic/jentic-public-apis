{
  "openapi": "3.1.2",
  "info": {
    "title": "AgentLink isolated free record check",
    "version": "0.1.3",
    "description": "Isolated free evaluation enabled. Indicative future USD 0.03; payments disabled. Synthetic/non-sensitive data only; no authentication required. 4096-byte request limit; at most 16 scalar record fields and 16 required fields; rate/quota/shutdown refusals and no SLA. MCP execution and A2A unavailable. Privacy: https://agentlink.agentlink-commercial.workers.dev/privacy.json",
    "x-jentic-source-url": "https://agentlink.agentlink-commercial.workers.dev/openapi.json"
  },
  "servers": [
    {
      "url": "https://agentlink.agentlink-commercial.workers.dev"
    }
  ],
  "x-release-state": "PUBLIC_FREE_EVALUATION",
  "x-evaluation-enabled": true,
  "x-payments": "DISABLED",
  "paths": {
    "/v1/record-check": {
      "post": {
        "operationId": "checkRecord",
        "summary": "Check declared fields and types",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "record",
                  "required_fields",
                  "field_types"
                ],
                "additionalProperties": false,
                "description": "Exactly these three properties. required_fields is nonempty and unique. field_types keys must be a subset of required_fields (runtime-enforced cross-property constraint); types may be omitted for presence-only checks. Missing record fields produce a valid FAIL diagnosis, not an input error. String length counts Unicode code points. Integer checks use the original JSON token, so 1.0 and 1e0 are not integers.",
                "x-runtime-constraints": [
                  "field_types keys are a subset of required_fields",
                  "integer check requires an integer JSON token",
                  "total HTTP request <=4096 UTF-8 bytes"
                ],
                "properties": {
                  "record": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
                      "maxLength": 32,
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 256
                        },
                        {
                          "type": "number",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required_fields": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
                      "maxLength": 32,
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    }
                  },
                  "field_types": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
                      "maxLength": 32,
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              "examples": {
                "boolean_is_not_integer": {
                  "value": {
                    "record": {
                      "count": true,
                      "ready": false
                    },
                    "required_fields": [
                      "count",
                      "ready"
                    ],
                    "field_types": {
                      "count": "integer",
                      "ready": "boolean"
                    }
                  }
                },
                "integer_record": {
                  "value": {
                    "record": {
                      "n": 1
                    },
                    "required_fields": [
                      "n"
                    ],
                    "field_types": {
                      "n": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed deterministic check, including FAIL diagnoses; unavailable when evaluation disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "kind",
                    "result",
                    "checks",
                    "limits",
                    "price"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "validate_record"
                    },
                    "result": {
                      "enum": [
                        "PASS",
                        "FAIL"
                      ]
                    },
                    "checks": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "required": [
                          "check",
                          "field",
                          "passed"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "check": {
                            "enum": [
                              "required",
                              "type"
                            ]
                          },
                          "field": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
                            "maxLength": 32,
                            "not": {
                              "enum": [
                                "__proto__",
                                "prototype",
                                "constructor"
                              ]
                            }
                          },
                          "passed": {
                            "type": "boolean"
                          },
                          "expected": {
                            "enum": [
                              "string",
                              "integer",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      }
                    },
                    "limits": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "price": {
                      "type": "object",
                      "required": [
                        "evaluation_usd",
                        "indicative_future_usd",
                        "payments"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "evaluation_usd": {
                          "const": "0.00"
                        },
                        "indicative_future_usd": {
                          "const": "0.03"
                        },
                        "payments": {
                          "const": "DISABLED"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "retained_public_PASS": {
                    "summary": "Retained FC05 synthetic public PASS response; not a new live call",
                    "value": {
                      "kind": "validate_record",
                      "result": "PASS",
                      "checks": [
                        {
                          "check": "required",
                          "field": "n",
                          "passed": true
                        },
                        {
                          "check": "type",
                          "field": "n",
                          "expected": "integer",
                          "passed": true
                        }
                      ],
                      "limits": [
                        "Declared required fields and primitive types only; no truth, identity, permission or regulatory assurance."
                      ],
                      "price": {
                        "evaluation_usd": "0.00",
                        "indicative_future_usd": "0.03",
                        "payments": "DISABLED"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Structured refusal; no action",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "retryable"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Structured refusal; no action",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
