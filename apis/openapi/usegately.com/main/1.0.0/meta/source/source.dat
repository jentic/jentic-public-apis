                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit Feedback",
        "description": "Submit new feedback",
        "operationId": "submitFeedback",
        "tags": ["Feedback"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "type": { "type": "string", "enum": ["bug", "feature", "improvement"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feedback submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
