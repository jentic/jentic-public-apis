    },
    "/lms/courses": {
      "get": {
        "summary": "List Courses",
        "description": "**DEPRECATED — removed from public API. Do not use.**",
        "deprecated": true,
        "x-internal": true,
        "operationId": "listCourses",
        "tags": ["LMS"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
