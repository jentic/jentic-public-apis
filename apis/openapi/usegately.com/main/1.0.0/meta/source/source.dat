{
  "openapi": "3.0.3",
  "info": {
    "title": "Gately API",
    "description": "REST API for managing members, forms, analytics, campaigns, and more.\n\n**Base URL:** `https://api.usegately.com/api/v1`\n\n**Authentication:** Pass your API key as `Authorization: Bearer gately_sk_live_xxxxx`. Get keys from Dashboard → Settings → API Keys.\n\n> **Deprecated endpoints:** `/lms/*`, `/ecommerce/*`, `/shop/*`, and `/help/*` are deprecated and will be removed in a future version. Do not use them in new integrations.",
    "version": "1.0.0",
    "contact": {
      "name": "Gately Support",
      "email": "support@usegately.com",
      "url": "https://usegately.com/docs"
    }
  },
  "servers": [
    {
      "url": "https://api.usegately.com/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token",
        "description": "API key from Dashboard → Settings → API Keys (format: gately_sk_live_xxxxx)"
      }
    },
    "schemas": {
      "Member": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "full_name": { "type": "string" },
          "avatar_url": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "inactive", "pending"] },
          "plan_id": { "type": "string" },
          "metadata": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "total_pages": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    { "name": "Authentication", "description": "Member authentication endpoints" },
    { "name": "Members", "description": "Member management endpoints" },
    { "name": "Email Campaigns", "description": "Email campaign endpoints" },
    { "name": "Plans", "description": "Subscription plan endpoints" },
    { "name": "Contacts", "description": "CRM contact management endpoints" },
    { "name": "Discussions", "description": "Community discussion endpoints" },
    { "name": "Webhooks", "description": "Webhook management endpoints" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate a user with email and password",
        "operationId": "login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "description": "User's email address" },
                  "password": { "type": "string", "description": "User's password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/Member" },
                    "session": {
                      "type": "object",
                      "properties": {
                        "access_token": { "type": "string" },
                        "refresh_token": { "type": "string" },
                        "expires_at": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Sign Up",
        "description": "Create a new user account",
        "operationId": "signup",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string", "minLength": 6 },
                  "metadata": { "type": "object", "description": "Additional user metadata" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/Member" },
                    "session": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "description": "End a user session",
        "operationId": "logout",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh Token",
        "description": "Refresh an expired access token",
        "operationId": "refreshToken",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "expires_in": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "summary": "Password Reset",
        "description": "Request a password reset email",
        "operationId": "passwordReset",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string" },
                  "redirect_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset email sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/members": {
      "get": {
        "summary": "List Members",
        "description": "Retrieve a paginated list of members in your project",
        "operationId": "listMembers",
        "tags": ["Members"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by email or name" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "inactive", "pending"] } },
          { "name": "plan", "in": "query", "schema": { "type": "string" }, "description": "Filter by plan ID" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "default": "created_at", "enum": ["created_at", "email", "full_name"] } },
          { "name": "order", "in": "query", "schema": { "type": "string", "default": "desc", "enum": ["asc", "desc"] } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Member",
        "description": "Create a new member in your project",
        "operationId": "createMember",
        "tags": ["Members"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string" },
                  "full_name": { "type": "string" },
                  "password": { "type": "string" },
                  "plan_id": { "type": "string" },
                  "metadata": { "type": "object" },
                  "send_welcome_email": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Member" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/members/{memberId}": {
      "get": {
        "summary": "Get Member",
        "description": "Retrieve a single member by ID",
        "operationId": "getMember",
        "tags": ["Members"],
        "parameters": [
          { "name": "memberId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Member" }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Member",
        "description": "Update an existing member",
        "operationId": "updateMember",
        "tags": ["Members"],
        "parameters": [
          { "name": "memberId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "full_name": { "type": "string" },
                  "status": { "type": "string", "enum": ["active", "inactive", "pending"] },
                  "plan_id": { "type": "string" },
                  "metadata": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Member" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Member",
        "description": "Delete a member from your project",
        "operationId": "deleteMember",
        "tags": ["Members"],
        "parameters": [
          { "name": "memberId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Member deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/plans": {
      "get": {
        "summary": "List Plans",
        "description": "Retrieve all subscription plans",
        "operationId": "listPlans",
        "tags": ["Plans"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "description": { "type": "string" },
                          "price": { "type": "number" },
                          "interval": { "type": "string", "enum": ["month", "year", "one_time"] },
                          "features": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/forms": {
      "get": {
        "summary": "List Forms",
        "description": "**DEPRECATED — removed from public API. Do not use.**",
        "deprecated": true,
        "x-internal": true,
        "operationId": "listForms",
        "tags": ["Forms"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "type": { "type": "string" },
                          "submissions_count": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/forms/{formId}/submissions": {
      "get": {
        "summary": "List Form Submissions",
        "description": "**DEPRECATED — removed from public API. Do not use.**",
        "deprecated": true,
        "x-internal": true,
        "operationId": "listFormSubmissions",
        "tags": ["Forms"],
        "parameters": [
          { "name": "formId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "type": "object" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/analytics/events": {
      "post": {
        "summary": "Track Event",
        "description": "**DEPRECATED — removed from public API. Do not use.**",
        "deprecated": true,
        "x-internal": true,
        "operationId": "trackEvent",
        "tags": ["Analytics"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event_name"],
                "properties": {
                  "event_name": { "type": "string" },
                  "member_id": { "type": "string" },
                  "properties": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event tracked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/analytics/pageviews": {
      "get": {
        "summary": "Get Pageviews",
        "description": "**DEPRECATED — removed from public API. Do not use.**",
        "deprecated": true,
        "x-internal": true,
        "operationId": "getPageviews",
        "tags": ["Analytics"],
        "parameters": [
          { "name": "start_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "end_date", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/discussions": {
      "get": {
        "summary": "List Discussions",
        "description": "Retrieve all discussions",
        "operationId": "listDiscussions",
        "tags": ["Discussions"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "category", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "type": "object" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Discussion",
        "description": "Create a new discussion thread",
        "operationId": "createDiscussion",
        "tags": ["Discussions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "content"],
                "properties": {
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "category_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Discussion created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
