    "/api/v1/tools/linkedin_delete_creative/execute": {
      "post": {
        "operationId": "linkedin_delete_creative",
        "summary": "Delete a LinkedIn creative (ad)",
        "description": "Permanently removes a creative (an ad in Campaign Manager) from a campaign (ad set). **This cannot be undone**, and LinkedIn stops reporting its past performance against the campaign, so the campaign's historical totals change.\nA creative still in draft is deleted outright; one that has been out of draft is marked PENDING_DELETION, which stops it serving at once and has LinkedIn remove it afterwards — so it can still appear in linkedin_list_creatives with that status for a while. The result says which happened.\nUse when: the user has explicitly asked to delete — a creative published with the wrong asset, or something that must not exist for a legal or brand reason. Requires confirm_delete: true.\nDo not use it to stop an ad. linkedin_pause_creative stops delivery instantly, is reversible, and keeps the history — that is what \"turn this off\" means, every time.\nDo not delete a creative that has spent money without telling the user that the campaign's reported history will change afterwards. Show them linkedin_get_creative_performance first so the numbers are recorded somewhere before they vanish.\nNever call this because a creative is underperforming. Losing a test result is worse than the £30 the ad cost.\nReturns confirmation and what was removed. Show the user exactly which creative, on which campaign, and get an explicit yes before calling with confirm_delete: true.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "delete this LinkedIn creative permanently",
          "remove the ad with the wrong logo"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "creative_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The creative to delete permanently. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "confirm_delete": {
                        "description": "Must be true to remove anything. Ask the user first.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "creative_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
