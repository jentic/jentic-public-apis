    "/api/v1/tools/linkedin_analyze_wasted_spend/execute": {
      "post": {
        "operationId": "linkedin_analyze_wasted_spend",
        "summary": "Find LinkedIn spend that produced nothing",
        "description": "Finds campaigns (ad sets in Campaign Manager) spending without result: impressions with no clicks, clicks with no leads or conversions, and cost per lead well above the account average or a ceiling you give.\nUse when: the user asks where money is going, before a budget review, or when spend rose without results. Run it on last_30_days — a shorter window on LinkedIn's volumes produces confident nonsense.\nDo not act on its findings without checking tracking first: \"clicks but no leads\" is a conversion-rule problem as often as a creative one, and pausing a campaign whose leads simply are not being recorded destroys a working campaign. The tool says so in every such finding.\nDo not present the recoverable figure as guaranteed savings — it is what would stop being spent, not profit.\nReturns a ranked list of findings with the spend behind each and a specific next step. Campaigns below the minimum spend are excluded rather than judged on noise.\nIf nothing is found, say the account is clean for this window instead of manufacturing a recommendation.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "where am I wasting money on LinkedIn?",
          "which LinkedIn campaigns should I cut?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
