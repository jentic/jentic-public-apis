    "/api/v1/tools/linkedin_explain_objectives/execute": {
      "post": {
        "operationId": "linkedin_explain_objectives",
        "summary": "What each LinkedIn objective permits",
        "description": "Explains LinkedIn's campaign objectives: what each one optimises towards, which ad formats and cost types it allows, when a marketer should pick it, and whether it needs a conversion rule to work at all.\nUse when: choosing an objective before creating a campaign, or explaining why a format the user asked for is not available. The objective is the single least reversible choice on a LinkedIn campaign — it cannot be changed after creation, so getting it right here saves rebuilding the campaign later.\nDo not use it as a source of costs or benchmarks; it describes what the platform permits, not what anything will cost. Do not pick an objective for the user when their goal is ambiguous — show the two candidates and ask which outcome they are paying for.\nReturns the matrix for one objective, or all of them. Costs nothing.\nWEBSITE_CONVERSION only optimises once a conversion rule with real volume is attached — if the user has no tracking, say so and recommend WEBSITE_VISIT instead of setting them up to fail.\nLEAD_GENERATION needs a Lead Gen Form on every ad, which this server cannot attach yet: its create tools refuse that objective, so a lead-gen campaign is built in Campaign Manager.\nA campaign created without a bid uses LinkedIn's automated bidding for its objective and is billed CPM; a bid switches it to manual bidding on the cost type given. Text ads only bid manually.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "which LinkedIn objective should I use for lead generation?",
          "what ad formats work with the video views objective?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "objective": {
                        "description": "One objective to explain. Omit for the whole matrix.",
                        "type": "string",
                        "enum": [
                          "BRAND_AWARENESS",
                          "WEBSITE_VISIT",
                          "ENGAGEMENT",
                          "VIDEO_VIEW",
                          "LEAD_GENERATION",
                          "WEBSITE_CONVERSION",
                          "JOB_APPLICANT"
                        ]
                      },
                      "goal": {
                        "description": "The user's goal in their own words, echoed back with the recommendation.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
