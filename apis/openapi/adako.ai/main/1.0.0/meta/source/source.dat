                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "mobile": {
                        "description": "Bid multiplier for phones.",
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 10
                      },
                      "desktop": {
                        "description": "Bid multiplier for computers.",
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 10
                      },
                      "tablet": {
                        "description": "Bid multiplier for tablets.",
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 10
