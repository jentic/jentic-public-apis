                      },
                      "creative_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The creative to act on, from linkedin_list_creatives. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
