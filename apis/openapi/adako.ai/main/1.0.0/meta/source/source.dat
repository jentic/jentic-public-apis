    "/api/v1/tools/tiktok_get_ad_group_performance/execute": {
      "post": {
        "operationId": "tiktok_get_ad_group_performance",
        "summary": "Read TikTok ad group performance",
        "description": "Reports the same metrics one level down: per ad group, with the previous-period comparison.\nUse when: a campaign's total looks fine or looks bad and you need to know which audience or budget split is responsible. On TikTok the ad group is where targeting, budget and bidding all live, so this is usually the level a decision is actually made at.\nDo not compare ad groups that started on different days over the same window — the newer one is still learning and will look worse than it is. Check the schedule with tiktok_list_ad_groups first.\nReturns each ad group's spend, CTR, CPA and video ratios. Two ad groups with the same creative and very different hook rates are an audience difference; the same audience with very different hook rates is a creative difference.\nPass campaign_id to scope it, or adgroup_id for a single one.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "performance",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Which TikTok ad groups are working?",
          "Show ad group performance for my TikTok campaign last 14 days",
          "What is the CPA per TikTok ad group?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
