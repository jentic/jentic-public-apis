    "/api/v1/tools/tiktok_search_targeting/execute": {
      "post": {
        "operationId": "tiktok_search_targeting",
        "summary": "Find TikTok targeting ids",
        "description": "Turns names into the ids TikTok targets by: places into location ids, interest names into interest category ids (interest_category_ids), keyword phrases into additional interest ids (interest_keyword_ids), languages into language codes, and lists the device and network enums verbatim.\nUse when: the user names any place, interest or language the ads should target — always before tiktok_create_video_campaign, tiktok_add_ad_group or tiktok_update_ad_group. Those tools take ids only, check them against TikTok's lists, and refuse anything that looks like a name.\nDo not guess an id, reuse one from another ad platform, or pass a place name into a write. A wrong location id spends real money in the wrong country and TikTok will not warn you.\nDo not pass a country together with a region or city inside it: TikTok refuses overlapping locations in one ad group. Which locations exist depends on the campaign objective, so pass objective when it is known.\nDo not resolve sensitive categories (health conditions, sexual orientation, religion, politics): TikTok restricts them and Adako will not target them. If the user asks for one, say why not and offer a behavioural interest instead.\nReturns every match with whatever distinguishes them — a location's level and country, an interest's depth in the taxonomy. When several matches look plausible, show them and ask the user which they mean rather than taking the first.\nCosts nothing, so resolve every name the user mentions, one type per call.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Find the TikTok location id for Germany",
          "What TikTok interest categories relate to fitness?",
          "Which device targeting options does TikTok have?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "location",
                          "interest",
                          "interest_keyword",
                          "language",
                          "device"
                        ],
                        "description": "What to resolve: location (countries, regions, cities), interest (TikTok's interest categories), interest_keyword (free phrases like \"home workout\", resolved to additional interests), language, or device (returns the fixed enums, no search needed)."
                      },
                      "query": {
                        "description": "The name to look up, as the user said it, in English. Not needed for type \"device\".",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "objective": {
                        "description": "The campaign objective the ids are for; TikTok offers different locations per objective. Defaults to TRAFFIC. Only used for type \"location\".",
                        "type": "string",
                        "enum": [
                          "REACH",
                          "TRAFFIC",
                          "VIDEO_VIEWS",
                          "ENGAGEMENT",
                          "LEAD_GENERATION",
                          "WEB_CONVERSIONS",
                          "APP_PROMOTION",
                          "PRODUCT_SALES"
                        ]
                      },
                      "limit": {
                        "description": "Maximum matches to return (default 20).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
