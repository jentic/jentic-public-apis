        "operationId": "chatgpt_list_pixels",
        "summary": "List ChatGPT Ads pixels",
        "description": "Lists the measurement pixels on the advertiser account, when each last received an event, and whether a Conversions API key exists for it. The key itself is never read or shown — only whether one is there.\nUse when: the user asks about conversion tracking, or before launching anything with a conversions objective, because that objective needs a conversion event to optimise towards.\nDo not use it to read results — conversions that were recorded show up in chatgpt_get_performance. Do not tell the user tracking \"works\" because a pixel exists: a pixel that has never fired is not tracking anything, which is what the last-event column is for.\nReturns one row per pixel. Pixel management has to be enabled on the ad account; when it is not, the platform answers 404 and the tool says so explicitly instead of failing — that answer is final, so relay it and move on rather than retrying.\nThe platform publishes how to create a pixel but not how to list them, so treat an empty result as \"nothing visible to the API\", not as proof that nothing exists.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Do I have a pixel on my ChatGPT Ads account?",
          "Is conversion tracking set up before I launch a conversions campaign?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "limit": {
                        "description": "Maximum rows to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
