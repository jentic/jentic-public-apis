    "/api/v1/tools/google_search_audiences/execute": {
      "post": {
        "operationId": "google_search_audiences",
        "summary": "Find audiences, user lists and interest segments",
        "description": "Finds audiences usable in this account: the account's own audiences and remarketing/customer lists, plus Google's in-market and affinity interest segments when you pass a search term.\nUse when: you need an audience id for google_add_audience_signal, or the user asks what audiences exist.\nDo not use when: the user means keywords or locations — those are google_research_keywords and google_resolve_locations.\nRemarketing lists need a minimum size before they can be used (roughly 1,000 for Search), and the reported size is an estimate. A list that is too small is returned with its size so you can tell the user why it will not work, rather than it silently doing nothing.\nThis is a resolver: never invent an audience id, always pass one this tool returned.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "audiences",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What remarketing lists do we have?",
          "Find an in-market audience for home improvement",
          "Which audiences can I use as a PMax signal?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "search": {
                        "description": "Term to match against audience and list names, and against Google in-market/affinity segment names.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 60
                      },
                      "include_interest_segments": {
                        "description": "Include Google's in-market and affinity segments. Requires a search term; defaults to true when one is given.",
                        "type": "boolean"
                      },
                      "limit": {
                        "description": "Maximum rows per group (default 25).",
                        "type": "integer",
