    "/api/v1/tools/google_update_campaign_locations/execute": {
      "post": {
        "operationId": "google_update_campaign_locations",
        "summary": "Change where a campaign runs",
        "description": "Adds or removes the locations a campaign targets. Ids must come from google_resolve_locations; the tool verifies every id against Google and refuses anything it cannot find, so a wrong number never becomes wrong targeting.\nUse when: the user has named the places and you have resolved them to ids.\nDo not use when: the user wants to *exclude* a place rather than stop targeting it — an exclusion is a different criterion, and removing a targeted location is not the same as excluding it.\nThe preview lists the place names, not the ids. Removing every location a campaign targets would stop it serving anywhere, so the tool refuses that outright.\nLocation changes take effect within minutes and can move spend sharply: a new country starts competing against the same daily budget.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add Germany and Austria to campaign 111",
          "Stop running this campaign in Canada"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
