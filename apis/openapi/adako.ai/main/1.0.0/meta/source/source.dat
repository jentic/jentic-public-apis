    "/api/v1/tools/google_get_benchmark_context/execute": {
      "post": {
        "operationId": "google_get_benchmark_context",
        "summary": "Indicative industry benchmarks for Google Search",
        "description": "Returns indicative Google Search medians — click-through rate, cost per click and landing-page conversion rate — for an industry. The table is static, so this call is free, needs no connection and touches no API.\nUse when: the user asks whether a number is normal, or wants a sanity check before setting expectations.\nDo not use when: the user wants a target. These are medians across thousands of accounts with different offers, prices, landing pages and countries, gathered from public industry surveys and denominated in US dollars. They cannot tell anyone what their CPC *should* be, and quoting them as a goal is misleading.\nThe honest benchmark for an account is its own recent history: compare against google_get_campaign_performance over the previous period first, and use this table only to say whether something is in the right order of magnitude.\nPass a vertical, or call it with nothing to see the whole table. If the user's industry is not listed, say so rather than picking the nearest row and presenting it as theirs.\nCPC medians are US dollars. A CPC in another currency is only compared once it has been converted to US dollars and passed with compare_cpc_currency \"USD\"; otherwise the tool shows it next to the median without a reading. Never present a euro or yen CPC as above or below a dollar median.\nIf you are unsure which industry the user is in, ask them — do not guess.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Is a 3% CTR good for a law firm?",
          "What is a typical conversion rate for e-commerce?",
          "How do our numbers compare to the industry?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "vertical": {
                        "description": "Industry to look up, e.g. \"legal\", \"e-commerce\", \"home improvement\".",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 60
                      },
                      "compare_ctr": {
                        "description": "The account's own CTR as a fraction (0.042 for 4.2%), to put next to the median.",
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "compare_cpc": {
                        "description": "The account's own average CPC, for the same comparison. The medians are in US dollars: pass compare_cpc_currency when this CPC is in another currency.",
                        "type": "number",
                        "minimum": 0
                      },
                      "compare_cpc_currency": {
                        "description": "ISO code of compare_cpc, e.g. \"EUR\" — the account currency list_connected_accounts shows. Default USD. A CPC in any other currency is shown but not compared, because the medians are US dollars and this tool does no currency conversion.",
                        "type": "string",
                        "pattern": "^[A-Za-z]{3}$"
                      },
                      "compare_conversion_rate": {
                        "description": "The account's own conversion rate as a fraction.",
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
