    "/api/v1/tools/linkedin_update_campaign/execute": {
      "post": {
        "operationId": "linkedin_update_campaign",
        "summary": "Edit a LinkedIn campaign (ad set)",
        "description": "Changes the name, daily or lifetime budget, bid, run dates, targeting or delivery settings of a campaign (an ad set in Campaign Manager). Targeting is **merged**, never replaced: facets you do not mention are left exactly as they are.\nUse when: the user has named a specific change. Read the campaign first with linkedin_list_campaigns so you are changing what is actually there.\nDo not use it to pause or resume — linkedin_pause_campaign and linkedin_resume_campaign exist so the risk of that change is stated properly before approval.\nDo not add targeting without resolving URNs through linkedin_search_targeting; free text is refused. After any targeting change, re-check the audience with linkedin_estimate_audience_size — a merge can push it under the platform minimum or make it far broader than intended.\nDo not double a budget casually: LinkedIn re-enters a learning phase after a large change and costs rise for a few days first. If the user says \"increase the budget\" without a number, ask.\nDo not set a bid on a campaign that bids automatically without saying so: it switches the campaign to manual bidding, and the preview refuses until cost_type says whether the bid is per click or per 1,000 impressions — ask the user.\nReturns the campaign read back from LinkedIn, so the new values are confirmed rather than assumed. The objective, type and format of an existing campaign cannot be changed at all — that needs a new campaign.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "raise the daily budget on this LinkedIn campaign to £150",
          "add these job titles to the campaign targeting",
          "change the budget on this LinkedIn ad set"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign to edit. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "name": {
                        "description": "New campaign name.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255
                      },
                      "daily_budget": {
                        "description": "New daily budget, a decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "total_budget": {
                        "description": "New lifetime ceiling for this campaign.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bid": {
                        "description": "New manual bid, a decimal in the account currency, billed the way the campaign already is. On a campaign using LinkedIn's automated bidding this switches it to manual bidding and needs cost_type.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "cost_type": {
                        "description": "How the new bid is billed: CPC per click, CPM per 1,000 impressions, CPV per video view. Only with bid. Required when the campaign bids automatically today — ask the user, never guess.",
                        "type": "string",
                        "enum": [
                          "CPM",
                          "CPC",
                          "CPV"
                        ]
                      },
                      "start_date": {
                        "description": "New start date, YYYY-MM-DD. Leave it out to keep the current start exactly as it is.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "New end date, YYYY-MM-DD. Changing only this keeps the current start untouched.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "add_targeting": {
                        "description": "Entity URNs to ADD to the existing targeting.",
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
