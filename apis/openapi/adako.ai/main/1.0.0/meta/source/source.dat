    "/api/v1/tools/google_analyze_wasted_spend/execute": {
      "post": {
        "operationId": "google_analyze_wasted_spend",
        "summary": "Find Google Ads spend with nothing to show for it",
        "description": "Finds keywords, and the campaigns they sit in, that spent real money over the period and recorded zero conversions.\nThe rule is deliberately conservative so it never flags something that simply has not had a chance yet: a keyword must have spent at least the threshold — never less than the cost of 20 average clicks in this account, so the floor means the same in every currency — must have zero conversions, and its campaign must have been running for more than 14 days. Anything newer is in its learning period and is excluded and counted separately.\nUse when: the user asks where money is being wasted, wants to cut costs, or asks for a spend audit.\nDo not use when: conversion tracking may be missing entirely — check google_list_conversion_actions first, because zero conversions everywhere usually means broken tracking rather than bad keywords.\nReturns candidates only. Pausing anything is a separate, explicit step the user must approve.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Where are we wasting money?",
          "Find spend with nothing to show for it"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
