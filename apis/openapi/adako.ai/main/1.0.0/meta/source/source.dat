    "/api/v1/tools/linkedin_get_engagement_metrics/execute": {
      "post": {
        "operationId": "linkedin_get_engagement_metrics",
        "summary": "LinkedIn engagement and video metrics",
        "description": "Reports the social half of LinkedIn delivery: reactions, comments, shares, page follows, total engagements and engagement rate, plus video views and completions where the creative is a video.\nUse when: the objective is BRAND_AWARENESS, ENGAGEMENT or VIDEO_VIEW — for those, clicks and leads are the wrong scoreboard. Also use it to explain a campaign whose CTR looks weak but whose content is being shared.\nDo not use it to judge a lead-generation or conversion campaign: engagement there is a vanity number, and linkedin_get_campaign_performance has the metrics that matter.\nReturns totals and a per-campaign (ad set) table. Engagement rate is engagements ÷ impressions. Video completion rate is completions ÷ views, which on LinkedIn counts a view at two seconds, so completion rate reads low compared with other platforms. LinkedIn ad accounts carry no reporting timezone, so every window here is UTC days.\nIf video metrics are all zero on a video campaign, the creative is probably an image — check linkedin_list_creatives.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "reporting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "how much engagement did the LinkedIn ads get?",
          "video completion rate for this campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
