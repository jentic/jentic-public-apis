    "/api/v1/tools/meta_detect_creative_fatigue/execute": {
      "post": {
        "operationId": "meta_detect_creative_fatigue",
        "summary": "Detect Meta creative fatigue",
        "description": "Compares the first days of a window with the last days, per ad, and flags creative fatigue: click-through rate falling while frequency and CPM rise.\nUse when: performance has drifted down without an obvious change, the user asks whether to refresh creative, or before scaling an ad that has been running a while.\nDo not use it on an ad that has barely delivered — the tool says \"insufficient data\" rather than reading noise, and that answer is the truth, not a failure.\nDo not read a single flagged signal as proof: one signal earns \"watch\", agreeing signals earn \"fatigued\". Report which signals fired.\nReturns per-ad baseline and recent numbers (CTR, CPM, frequency, cost per result), the signals that fired and a plain-language verdict.\nThe default window is 14 days, which is the shortest span where a three-day baseline and a three-day recent period are both meaningful.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Are any of my Meta ads burning out?",
          "Why has the CTR on this campaign dropped over the last two weeks?",
          "Which creatives should I refresh?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
