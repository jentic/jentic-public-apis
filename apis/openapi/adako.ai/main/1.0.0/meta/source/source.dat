    "/api/v1/tools/google_get_device_performance/execute": {
      "post": {
        "operationId": "google_get_device_performance",
        "summary": "Performance by device",
        "description": "Splits spend, clicks, conversions, CPA and ROAS by device (mobile, desktop, tablet) for the period, next to the previous period of the same length.\nUse when: the user asks about mobile versus desktop, or before setting device bid modifiers.\nDo not use when: the campaign uses Smart Bidding and the user wants to act on the split — Smart Bidding already bids per device, so the split is information, not an instruction.\nA device with very little spend is not evidence. Mobile usually shows a worse conversion rate on considered purchases and a better one on calls and local intent; look at the landing page before blaming the device.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
