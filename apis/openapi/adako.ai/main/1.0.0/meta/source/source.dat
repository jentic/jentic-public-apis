                      },
                      "max_cost_per_lead": {
                        "description": "The highest cost per lead the user is willing to pay, a decimal in the account currency. Only pass it if they named a number.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "min_spend": {
                        "description": "Ignore campaigns that spent less than this in the window, a decimal in the account currency. Default: five days of LinkedIn's minimum daily budget in that currency (50 in USD, EUR or GBP), or 2% of the window's spend for a currency without a known minimum.",
