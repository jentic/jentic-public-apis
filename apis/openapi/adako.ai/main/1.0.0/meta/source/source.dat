    "/api/v1/tools/meta_set_frequency_cap/execute": {
      "post": {
        "operationId": "meta_set_frequency_cap",
        "summary": "Set a frequency cap on a Meta reach ad set",
        "description": "Limits how often one person may see the ads in a reach-optimised ad set: at most max_frequency impressions every interval_days.\nUse when: the ad set optimises for reach (or ad recall) and frequency is climbing — the usual first response to creative fatigue on a brand campaign.\nDo not use on a conversion, traffic or engagement ad set. Meta only honours a frequency cap on reach buying, and setting it elsewhere either fails or does nothing; the preview refuses rather than pretending.\nDo not set an aggressive cap on a small audience: Meta simply stops delivering once the cap binds, and the budget goes unspent.\nReturns the ad set read back from Meta with the cap that is actually in force.\nIf the user wants \"less repetition\" on a conversion campaign, the honest answer is to refresh the creative or widen the audience, not to cap frequency.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Cap this reach ad set at two impressions per person per week",
          "Stop showing this ad more than once a day to the same person"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The reach-optimised ad set to cap, from meta_list_ad_sets."
                      },
                      "max_frequency": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90,
                        "description": "Maximum impressions one person may receive inside the interval."
                      },
                      "interval_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90,
                        "description": "Length of the window in days, e.g. 7 for \"twice a week\" with max_frequency 2."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_set_id",
                      "max_frequency",
                      "interval_days"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
