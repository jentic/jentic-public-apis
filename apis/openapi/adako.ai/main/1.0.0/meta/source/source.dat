    "/api/v1/tools/linkedin_pause_creative/execute": {
      "post": {
        "operationId": "linkedin_pause_creative",
        "summary": "Pause a LinkedIn creative (ad)",
        "description": "Sets one creative (an ad in Campaign Manager) to PAUSED so it stops serving while its campaign (ad set) keeps running on its other creatives. Nothing is deleted and the performance history stays.\nUse when: a creative is clearly losing on enough data to say so — check linkedin_analyze_creative_performance first, which will not give a verdict below 1,000 impressions.\nDo not pause the last active creative on a live campaign: the campaign stays ACTIVE, spends nothing, and looks healthy in every list. Add the replacement first.\nDo not pause a \"fatiguing\" creative as the fix. Fatigue means the audience has seen it too often; a fresh creative into the same audience is what helps, and pausing without a replacement just shrinks delivery.\nLinkedIn only allows an ad to be paused once its review is APPROVED: one still in review, or rejected, is refused with that explanation rather than attempted, and neither is serving meanwhile. To stop delivery whatever the ads say, pause the campaign (ad set).\nReturns the creative read back, so the pause is confirmed.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "pause the losing LinkedIn creative",
          "stop this ad but keep the campaign running",
          "pause this LinkedIn ad"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
