    "/api/v1/tools/meta_update_ad_set/execute": {
      "post": {
        "operationId": "meta_update_ad_set",
        "summary": "Edit a Meta ad set (targeting is merged)",
        "description": "Changes one ad set's targeting, optimisation goal, schedule, DSA fields or name. Targeting is **merged**: every add and remove is applied to the spec Meta currently holds, so nothing you did not name is lost. The preview shows the merged result field by field before anything is sent.\nUse when: the user wants to widen, narrow or correct an existing audience, or shift its schedule.\nDo not use to change the budget (meta_update_adset_budget) or to pause it (meta_pause_entity).\nDo not change targeting on an ad set that is still learning unless the user accepts that learning restarts and delivery gets worse first — the preview warns when that applies.\nDo not pass free text: interests, behaviours and locations must be ids from meta_search_targeting or meta_browse_targeting.\nReturns the ad set read back from Meta, so the merged targeting is confirmed rather than assumed.\nIf a removal would leave the ad set with no location or no detailed targeting at all, the tool refuses or warns — ask the user what they intended instead of guessing. It also refuses EU/EEA locations added to an ad set without dsa_beneficiary and dsa_payor (ask the user for both), unknown location keys, past dates, placement combinations Meta rejects, and targeting the campaign's special ad category forbids.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add Austria and Switzerland to this ad set without losing the existing targeting",
          "Exclude our customer list from this ad set",
          "Stop this ad set from running on Audience Network"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The ad set to change, from meta_list_ad_sets."
                      },
                      "name": {
                        "description": "New ad set name.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "add_countries": {
                        "description": "ISO 3166-1 two-letter country codes to add to the existing locations (GB, not UK).",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "remove_countries": {
                        "description": "Two-letter country codes to remove. The ad set must keep at least one location.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "add_region_keys": {
                        "description": "Region keys to add, from meta_search_targeting. Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_region_keys": {
                        "description": "Region keys to remove.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "add_city_keys": {
                        "description": "City keys to add, from meta_search_targeting (not postcodes or media markets). Each gets a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_city_keys": {
                        "description": "City keys to remove.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "add_interest_ids": {
                        "description": "Interest ids to add, from meta_search_targeting or meta_browse_targeting.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_interest_ids": {
                        "description": "Interest ids to remove.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "add_behavior_ids": {
                        "description": "Behaviour ids to add.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_behavior_ids": {
                        "description": "Behaviour ids to remove.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "add_custom_audience_ids": {
                        "description": "Custom audience ids to include, from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_custom_audience_ids": {
                        "description": "Custom audience ids to stop including.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "add_excluded_custom_audience_ids": {
                        "description": "Custom audience ids to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove_excluded_custom_audience_ids": {
                        "description": "Custom audience ids to stop excluding.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "New minimum age.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "New maximum age.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "New gender targeting.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "publisher_platforms": {
                        "description": "Replace the placement platforms with exactly this list. Omit to leave placements alone (Advantage+ placements). audience_network cannot be the only one, and threads needs instagram.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "facebook",
                            "instagram",
                            "audience_network",
                            "messenger",
                            "threads"
                          ]
                        }
                      },
                      "device_platforms": {
                        "description": "Replace the device targeting with exactly this list.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "mobile",
                            "desktop"
                          ]
                        }
                      },
                      "advantage_audience": {
                        "description": "Turn Advantage+ audience on or off for this ad set.",
                        "type": "boolean"
                      },
                      "optimization_goal": {
                        "description": "New optimisation goal. Must be valid for the campaign objective; delivery relearns.",
                        "type": "string"
                      },
                      "start_time": {
                        "description": "New start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset. Not in the past.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "New end: YYYY-MM-DD (23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset.",
                        "type": "string"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required when this change adds EU/EEA locations to an ad set that has no beneficiary yet.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required when this change adds EU/EEA locations to an ad set that has no payor yet.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_set_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_update_adset_budget/execute": {
      "post": {
        "operationId": "meta_update_adset_budget",
        "summary": "Change a Meta ad set budget",
        "description": "Changes the daily or lifetime budget of one ad set. The preview shows the current and new amounts as decimals in the account currency and the percentage change, so the user approves a real number rather than a raw platform value.\nUse when: the user has decided to scale an ad set up or down and named the ad set and the amount.\nDo not use on an ad set whose campaign holds the budget — campaign budget optimisation means Meta manages ad set budgets and this call will be rejected. Change the campaign instead.\nDo not change the budget of an ad set that is still learning unless the user accepts that learning restarts: a large change resets what Meta has learned and delivery gets worse before it gets better.\nReturns the ad set read back from Meta after the change so the new budget is confirmed, not assumed.\nAmounts are decimals in the account currency. For currencies Meta treats as whole units (yen, won, forint and similar) the conversion is handled here — never send minor units.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Raise this ad set to 100 a day",
          "Halve the budget on the worst ad set"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The ad set to re-budget, from meta_list_ad_sets."
                      },
                      "daily_budget": {
                        "description": "New daily budget, decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "New lifetime budget, decimal in the account currency. The ad set must already have an end date.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_set_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
