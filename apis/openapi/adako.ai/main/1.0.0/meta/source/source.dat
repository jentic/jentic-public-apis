    "/api/v1/tools/get_tool_schema/execute": {
      "post": {
        "operationId": "get_tool_schema",
        "summary": "Get the exact arguments a tool takes",
        "description": "Returns the live JSON schema of one or more tools: required fields, enums, defaults, example prompts and the exact line to call it with. Free and instant — it never touches an ad platform.\nUse when: search_tools or a router pointed you at a tool and you need its arguments before calling it; or a call failed validation and you want the real field names.\nWhen not to use: the tool is already in your tool list with its schema attached — read that instead.\nReturns: one block per tool with risk, cost, the \"How to call\" line and the schema. Pass verbose=false for a compact field/type list when you only need the names.\nIf a name is unknown, you get near matches; pick one or call search_tools. Never invent field names.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What arguments does google_create_search_campaign take?",
          "Show me the schema for meta_update_adset_budget",
          "Which fields are required to create a campaign?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "tool_names": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "description": "Exact tool names, 1–10 of them. Use the names search_tools or a router returned."
                      },
                      "verbose": {
                        "description": "Full JSON schema (default true). false returns just field names and types.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "tool_names"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
