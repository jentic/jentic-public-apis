    "/api/v1/tools/meta_validate_creative_url/execute": {
      "post": {
        "operationId": "meta_validate_creative_url",
        "summary": "Check an image URL and ad copy before building an ad",
        "description": "Fetches a public image URL and reports whether it is reachable, what type and size it is, and its pixel dimensions, then checks any ad copy against Meta's length guidance.\nUse when: the user supplies an image URL or ad text, always before meta_create_image_campaign. The create tools refuse a link that is not a reachable image in their preview, before anything exists; checking here first saves a round trip.\nDo not use for landing page quality or policy review — this checks that the file exists and fits the format, nothing about its content.\nReturns dimensions when the file is a PNG or JPEG, plus warnings for anything Meta is likely to reject or crop: too small, wrong aspect ratio, unsupported type, or copy that will be truncated in the feed.\nCosts nothing and calls no ad platform, so run it as often as needed.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
