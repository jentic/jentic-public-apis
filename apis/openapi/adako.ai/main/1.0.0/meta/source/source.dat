    "/api/v1/tools/tiktok_get_audience_insights/execute": {
      "post": {
        "operationId": "tiktok_get_audience_insights",
        "summary": "Break TikTok results down by audience",
        "description": "Breaks spend, impressions, CTR, conversions and CPA down by age, gender, placement, device OS or language for a window.\nUse when: the user asks who their TikTok ads are reaching, or whether a placement or age band is worth keeping. Scope it with campaign_id or adgroup_id.\nDo not read this as a targeting instruction. TikTok decided where the budget went, and a band with a high CPA is often one the algorithm bought cheaply on purpose; excluding it commonly just raises the price of everything that remains. Recommend an exclusion only when a band has meaningful spend and no conversions at all over a long enough window.\nDo not use age or gender data to make claims about individuals, and do not target sensitive categories — TikTok restricts them and so does Adako.\nReturns one table per requested breakdown, each ranked by spend, with each band's share of total spend so a 2% slice is not mistaken for a finding. If a breakdown comes back empty, TikTok does not report that dimension for this objective; say so rather than inferring anything.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Who is actually converting on my TikTok ads?",
          "Break my TikTok spend down by age and gender",
          "Is Pangle placement wasting my TikTok budget?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only this campaign."
                      },
                      "adgroup_id": {
                        "type": "string",
