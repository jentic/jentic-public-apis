    "/api/v1/tools/linkedin_resume_campaign/execute": {
      "post": {
        "operationId": "linkedin_resume_campaign",
        "summary": "Resume a LinkedIn campaign (ad set)",
        "description": "Sets a campaign (an ad set in Campaign Manager) to ACTIVE so it can deliver. Real money starts being spent as soon as LinkedIn approves the creatives.\nUse when: the user has reviewed something paused — usually a campaign this server created — and wants it live.\nDo not resume without telling the user the daily budget first, and without checking three things that quietly keep an ACTIVE campaign at zero: the campaign group (the Campaign Manager campaign) must also be active, at least one creative (ad) must exist and be resumed, and LinkedIn must have approved it. linkedin_get_campaign_structure and linkedin_list_creatives answer all three.\nDo not report \"resumed\" as \"running\". Check the read-back: the serving issues it returns are LinkedIn saying why nothing is delivering.\nA campaign whose end date has already passed is refused rather than resumed: LinkedIn would accept it and serve nothing. Give it a new end date with linkedin_update_campaign first.\nReturns the campaign read back, including its budget and any serving issue.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "set this LinkedIn campaign live",
          "resume the paused campaign",
          "turn this LinkedIn ad set back on"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign to act on. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
