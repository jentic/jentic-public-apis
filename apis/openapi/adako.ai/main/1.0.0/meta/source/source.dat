    "/api/v1/tools/google_get_search_themes/execute": {
      "post": {
        "operationId": "google_get_search_themes",
        "summary": "Read the signals on an asset group",
        "description": "Lists the signals on a Performance Max asset group: the search themes and the audience signals, with Google's approval status for each.\nUse when: before adding or removing themes, or when the user asks what Performance Max has been told to look for.\nDo not use when: the user expects keywords. Search themes are hints, not keywords: Google is free to ignore them and will also serve on queries you never listed.\nAn asset group may hold at most 25 search themes. A theme with a non-approved status is not being used at all.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
