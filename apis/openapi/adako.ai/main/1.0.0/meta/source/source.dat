    "/api/v1/tools/manage_action/execute": {
      "post": {
        "operationId": "manage_action",
        "summary": "Approve or reject a change a monitor proposed",
        "description": "Applies or declines one proposal that a monitor created. Approving executes it exactly once against the ad platform and reads the object back; rejecting marks it so it can never execute.\nUse when: the user has explicitly said yes or no to the specific change — quote its summary from list_pending_actions first.\nDo not use when: the user is still deciding, or the proposal came from a tool call they made themselves (use approve_proposal / reject_proposal, which say the same thing in that context).\nApproving is real money: a pause stops delivery, a budget cut changes what the campaign can spend. If the proposal expired or was already decided, this returns an error — say so rather than silently recreating it.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Approve the pause the ROAS monitor proposed",
          "Reject that budget cut"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "proposal_id": {
                        "type": "string",
                        "minLength": 8,
                        "description": "Id from list_pending_actions."
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "approve",
                          "reject"
                        ],
                        "description": "approve applies the change; reject retires the proposal."
                      },
                      "reason": {
                        "description": "Why it was rejected. Stored with the proposal; it improves later proposals.",
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "proposal_id",
                      "action"
                    ]
                  }
                },
                "required": [
                  "arguments"
