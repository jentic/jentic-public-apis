    "/api/v1/tools/google_update_campaign/execute": {
      "post": {
        "operationId": "google_update_campaign",
        "summary": "Update Google Ads campaign settings",
        "description": "Changes a campaign's name, on/off state, end date or Search-partner setting. Only the fields you pass are touched; everything else is left alone.\nUse when: the user asked for one of these specific changes and named the campaign.\nDo not use when: the user only wants to pause or resume — google_pause_campaign and google_resume_campaign say exactly that and are easier to audit. Do not use it to change budgets (google_update_campaign_budget).\nSearch partners default to off for a reason: that inventory sits on other search sites, cannot be excluded site by site, and usually performs differently from Google Search. Turning it on is a real change in where ads appear, so say so.\nSetting an end date stops delivery at the end of that day (23:59:59) in the account time zone. An end date before today, or before the campaign's start date, is refused. The preview shows the exact before/after for every field.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Rename campaign 111",
          "Set an end date on this campaign"
        ],
        "parameters": [
          {
