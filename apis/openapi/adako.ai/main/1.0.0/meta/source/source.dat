    "/api/v1/tools/google_create_search_campaign/execute": {
      "post": {
        "operationId": "google_create_search_campaign",
        "summary": "Create a Google Ads Search campaign (paused)",
        "description": "Creates a complete Search campaign in one atomic operation: daily budget, campaign, location and language targeting, ad groups, keywords, one responsive search ad per ad group and optional campaign-level negatives. Either everything is created or nothing is.\nThe campaign is created PAUSED and its ad groups and ads are created enabled inside it, so no money can be spent until the campaign is turned on, and turning it on launches everything. Say this explicitly when you report the result, with the two links the result gives (Google Ads and the campaign's page in Adako), and offer \"enable all\": google_resume_campaign turns the campaign on in one approval.\nUse when: the user has agreed on a structure (budget, locations, ad groups, keywords, ad copy) and wants it built.\nDo not use when: anything is still undecided. Resolve place names with google_resolve_locations first (free text is rejected), take language ids from google_list_languages, check ad copy with google_validate_ad_copy, and confirm the daily budget in the account currency. Call this once per campaign: on an error, read what exists with google_list_campaigns rather than retrying.\nThe preview runs Google's own dry run (validateOnly), so policy and structural rejections surface before anything is created. Search partners are off unless include_search_partners is true. Locations reach people in or regularly in those places (Presence) unless location_targeting is PRESENCE_OR_INTEREST, which also reaches people elsewhere who show interest in them. Leaving language_ids out sets no language criterion, so language does not restrict the campaign. Google Ads Help says that from September 2026 Search ads are matched on the language of the ad text and the campaign language setting is being removed for Search, so write the ads in the language the audience reads.\nDates are whole days in the account time zone: a start date before today is refused, and an end date stops the campaign at the end of that day. Budgets and bids are decimals in the account currency, never micros, rounded to the smallest amount Google bills in that currency (whole units for JPY, KRW and a few others); the preview shows the rounded amounts. Ids are strings.\nPolitical advertising is not supported: every campaign is declared as containing no EU political advertising. If the user wants to run political ads, tell them to create the campaign in the Google Ads interface.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Create a search campaign for our new product",
          "Build a campaign with these keywords and ads"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "description": "Campaign name. Must not already exist in the account."
                      },
                      "daily_budget": {
                        "description": "Average daily budget as a decimal in the account currency (for example 50 for $50/day). Never micros. Give this or budget_id, never both.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_id": {
                        "description": "Join a budget that already exists instead of creating one: the `budget_id` of any campaign in google_list_campaigns. Use it for a shared budget, where several campaigns draw on one amount — the campaigns then compete for it, and changing the amount later moves all of them at once.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "bidding_strategy": {
                        "description": "How Google should bid. TARGET_CPA needs target_cpa; TARGET_ROAS needs target_roas. Give this or portfolio_strategy_id, never both.",
                        "type": "string",
                        "enum": [
                          "MAXIMIZE_CLICKS",
                          "MAXIMIZE_CONVERSIONS",
                          "TARGET_CPA",
                          "TARGET_ROAS",
                          "MANUAL_CPC"
                        ]
                      },
                      "portfolio_strategy_id": {
                        "description": "Run the campaign on a portfolio (shared) bidding strategy that already exists, from google_list_bidding_strategies. The strategy then decides the bidding for every campaign on it, so target_cpa and target_roas belong to it and are not set here.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "target_cpa": {
                        "description": "Target cost per conversion, decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "target_roas": {
                        "description": "Target return on ad spend as a ratio, e.g. 4 for 400%.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "location_ids": {
                        "minItems": 1,
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "Geo target constant ids from google_resolve_locations. Place names are rejected."
                      },
                      "location_targeting": {
                        "description": "Who the locations reach. PRESENCE (the default here): people in or regularly in those places. PRESENCE_OR_INTEREST (Google’s own default): also people elsewhere who show interest in them, e.g. someone abroad planning a trip. Choose it only when the user wants that wider reach.",
                        "type": "string",
                        "enum": [
                          "PRESENCE",
                          "PRESENCE_OR_INTEREST"
                        ]
                      },
                      "language_ids": {
                        "description": "Language constant ids from google_list_languages, e.g. [\"1000\"] for English. Omit to set no language criterion, which leaves the campaign unrestricted by language.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "include_search_partners": {
                        "description": "Show on Google Search partner sites too. Default false: partner traffic converts differently and is hard to segment.",
                        "type": "boolean"
                      },
                      "start_date": {
                        "description": "First day the campaign may run (YYYY-MM-DD), in the account time zone. Today or later; omit to start whenever it is enabled.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day the campaign may run (YYYY-MM-DD), in the account time zone; it stops at the end of that day.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "ad_groups": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255,
                              "description": "Ad group name, unique within the campaign."
                            },
                            "default_bid": {
                              "description": "Default max CPC for the ad group, decimal in the account currency.",
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "keywords": {
                              "minItems": 1,
                              "maxItems": 200,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "text": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 80,
                                    "description": "Keyword text, without match-type punctuation."
                                  },
                                  "match_type": {
                                    "type": "string",
                                    "enum": [
                                      "EXACT",
                                      "PHRASE",
                                      "BROAD"
                                    ],
                                    "description": "EXACT, PHRASE or BROAD."
                                  },
                                  "cpc_bid": {
                                    "description": "Optional max CPC for this keyword, decimal in the account currency.",
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  }
                                },
                                "required": [
                                  "text",
                                  "match_type"
                                ]
                              },
                              "description": "Keywords for this ad group."
                            },
                            "headlines": {
                              "minItems": 3,
                              "maxItems": 15,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "description": "Between 3 and 15 headlines, each at most 30 characters."
                            },
                            "descriptions": {
                              "minItems": 2,
                              "maxItems": 4,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "description": "Between 2 and 4 descriptions, each at most 90 characters."
                            },
                            "path1": {
                              "description": "First display path segment.",
                              "type": "string",
                              "maxLength": 15
                            },
                            "path2": {
                              "description": "Second display path segment; needs path1.",
                              "type": "string",
                              "maxLength": 15
                            },
                            "final_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Landing page for this ad group, including https://."
                            }
                          },
                          "required": [
                            "name",
                            "keywords",
                            "headlines",
                            "descriptions",
                            "final_url"
                          ]
                        },
                        "description": "One to ten ad groups, each with keywords and one responsive search ad."
                      },
                      "negative_keywords": {
                        "description": "Campaign-level negative keywords applied to every ad group.",
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "match_type": {
                              "type": "string",
                              "enum": [
                                "EXACT",
                                "PHRASE",
                                "BROAD"
                              ]
                            }
                          },
                          "required": [
                            "text",
                            "match_type"
                          ]
                        }
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_name",
                      "location_ids",
                      "ad_groups"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/google_explain_performance_anomaly/execute": {
      "post": {
        "operationId": "google_explain_performance_anomaly",
        "summary": "Explain why a metric moved",
        "description": "Decomposes a period-over-period change in one metric across campaigns, devices, networks, countries and search terms, and ranks the segments by how much of the total change each one accounts for.\nUse when: the user says something dropped, spiked or \"looks wrong\" and wants to know why. This is the right first tool for that question.\nDo not use when: the user just wants the numbers (google_get_campaign_performance) or a single dimension they already suspect (google_get_device_performance, google_get_geo_performance).\nReturns, per dimension, the segments that moved most, with their share of the total change. Read the top one or two lines and say what they mean — a change concentrated in one campaign is an account change, one spread evenly across every dimension is usually seasonality or an auction-wide shift you did not cause.\nTwo cautions worth repeating to the user: a short window makes everything look dramatic, and conversions keep arriving for days after the click, so the most recent days always look worse than they will turn out to be.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Why did conversions drop last week?",
          "Our cost jumped — what changed?",
          "Explain the fall in ROAS this month"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "metric": {
                        "description": "Which metric moved. Defaults to cost.",
                        "type": "string",
                        "enum": [
                          "cost",
                          "clicks",
                          "impressions",
                          "conversions",
                          "conversion_value",
                          "cpa",
                          "roas"
                        ]
                      },
                      "campaign_id": {
                        "description": "Limit the whole analysis to one campaign.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "date_range": {
                        "description": "Preset range. Alternatively pass start_date and end_date (YYYY-MM-DD). Never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day of the period (YYYY-MM-DD). Use with end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day of the period (YYYY-MM-DD). Use with start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "include_search_terms": {
                        "description": "Include the search-term breakdown (default true). It is the slowest dimension.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
