    "/api/v1/tools/meta_get_ad_creatives/execute": {
      "post": {
        "operationId": "meta_get_ad_creatives",
        "summary": "Show the creatives behind Meta ads",
        "description": "Lists the creatives used by one ad, or by every ad in an ad set: headline, primary text, destination link, format and thumbnail.\nUse when: the user asks what an ad actually says, before rewriting copy, or to find a creative_id to reuse with meta_add_ad.\nDo not use for performance numbers — meta_get_ad_performance answers which creative works.\nReturns one row per creative with its id, format and text, plus the raw spec in the data for follow-up questions.\nPass either ad_id or ad_set_id. Carousel creatives report their card count; flexible creatives report how many text and image assets they carry.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
