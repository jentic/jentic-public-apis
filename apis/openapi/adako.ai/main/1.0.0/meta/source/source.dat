                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "callouts": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 25
