    "/api/v1/tools/linkedin_pause_campaign/execute": {
      "post": {
        "operationId": "linkedin_pause_campaign",
        "summary": "Pause a LinkedIn campaign (ad set)",
        "description": "Stops delivery on one campaign (an ad set in Campaign Manager) by setting it to PAUSED. Spend stops; nothing is deleted, the creatives and history stay, and linkedin_resume_campaign starts it again.\nUse when: the user has explicitly asked to stop something and you have shown them what it is currently spending and producing.\nDo not pause on a few days of data. LinkedIn's B2B volumes are small and a week is the minimum honest window — show last_7_days from linkedin_get_campaign_performance, or last_30_days for anything involving cost per lead, and let the user decide.\nDo not pause a campaign that reports no conversions until linkedin_list_conversions confirms a rule is attached: an untracked campaign looks identical to a failing one.\nDo not use pausing as deletion. Pausing is reversible; nothing in this adapter deletes a campaign at all.\nReturns the campaign read back from LinkedIn, which is how you confirm the pause applied rather than reporting an intention as a fact.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "pause this LinkedIn campaign",
          "stop the campaign that is not converting"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
