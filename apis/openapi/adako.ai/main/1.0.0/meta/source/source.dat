    "/api/v1/tools/google_remove_negative_keywords/execute": {
      "post": {
        "operationId": "google_remove_negative_keywords",
        "summary": "Remove campaign negative keywords (permanent)",
        "description": "Deletes negative keywords from a campaign so those queries can trigger ads again. This is the only tool in Adako that removes anything, and the removal is permanent: a removed criterion cannot be restored, only re-added as a new one.\nUse when: the user has confirmed that a specific negative is blocking traffic they want, and you have shown them the exact list by name.\nDo not use when: the user asked to \"turn off\", \"stop\" or \"pause\" something — that is never a removal. Negatives cannot be paused; if the user is unsure, leave them in place.\nRequires confirm_delete: true. Ask the user first, in plain words, naming every negative that will be deleted. Ids that are not negatives on this campaign are reported back rather than silently ignored.\nRemoving a negative widens matching immediately, which can increase spend.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "keywords",
        "x-adako-since": "v1",
