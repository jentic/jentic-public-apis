    "/api/v1/tools/google_list_bidding_strategies/execute": {
      "post": {
        "operationId": "google_list_bidding_strategies",
        "summary": "List portfolio bidding strategies",
        "description": "Lists the portfolio (shared) bidding strategies in the account, their type, their target and how many campaigns use each one. An id from here goes into google_update_bid_strategy (attach_portfolio_strategy_id) to put a campaign on one, or into google_create_search_campaign (portfolio_strategy_id) to create it on one.\nUse when: google_update_bid_strategy has refused because a campaign is on a portfolio, or the user asks why several campaigns move together.\nDo not use when: you want a single campaign's bidding — google_list_campaigns already shows the strategy type per campaign.\nA portfolio strategy is one set of bids shared by several campaigns: changing its target changes every campaign on it. Campaigns with their own standard strategy never appear here.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
