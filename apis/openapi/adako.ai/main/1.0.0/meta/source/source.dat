    "/api/v1/tools/linkedin_associate_conversion/execute": {
      "post": {
        "operationId": "linkedin_associate_conversion",
        "summary": "Attach a conversion rule to a LinkedIn campaign (ad set)",
        "description": "Attaches a conversion rule to a campaign (an ad set in Campaign Manager), or detaches it, so LinkedIn reports that conversion against that campaign's spend.\nUse when: a campaign reports no conversions although the rule exists and fires, and whenever a new campaign should be measured against existing tracking. LinkedIn associates rules with campaigns individually and a new campaign inherits none — attaching is a separate, deliberate act, and this is the tool for it.\nDo not detach a rule to \"clean up\" reporting: the campaign's conversion history stops being reported against it and the numbers the user saw last month will no longer reconcile.\nDo not attach every rule to every campaign. A campaign attributed to five rules counts five different things as success and its cost per conversion becomes meaningless.\nReturns the rule read back with its campaign list, so the attachment is confirmed rather than assumed.\nAttribution is not retroactive in reporting for periods before the association — say so when a user expects last week's conversions to appear.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "attach the demo-request conversion to this LinkedIn campaign",
          "why is this campaign not reporting conversions?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "conversion_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The conversion rule, from linkedin_list_conversions. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign to attach it to. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "detach": {
                        "description": "Set true to remove the association instead of creating it. Ask the user first.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
