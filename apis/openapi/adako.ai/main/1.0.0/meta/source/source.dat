    "/api/v1/tools/tiktok_detect_creative_fatigue/execute": {
      "post": {
        "operationId": "tiktok_detect_creative_fatigue",
        "summary": "Find TikTok creative that is wearing out",
        "description": "Compares the first and second halves of a window per ad and flags the ones whose hook rate, CTR or CPA have moved against them while frequency climbed — the signature of creative fatigue rather than a bad week.\nUse when: results have slipped without anything being changed, or the user asks whether they need new videos. A 14-day window is the default because a shorter one cannot tell fatigue from noise.\nDo not read a single declining metric as fatigue. Real fatigue looks like this: the hook rate falls, frequency rises, and CPM rises with them — the same people are seeing the same video again and TikTok is paying more to show it. A CTR drop on its own, with flat frequency, is usually an audience or landing-page change instead.\nDo not pause a fatigued ad automatically. The fix is almost always a new video against the same audience, not less budget: pausing removes the spend and the learning with it.\nReturns per ad the before/after hook rate, CTR, CPM and frequency with the change in each, and a one-line verdict. Ads with too little volume in either half are excluded and listed separately.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Is my TikTok creative getting tired?",
          "Which TikTok ads are declining?",
          "Do I need new TikTok videos?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only ads in this campaign."
                      },
                      "adgroup_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only ads in this ad group."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in — it matters on TikTok, where video metrics settle for hours. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
