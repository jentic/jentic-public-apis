    "/api/v1/tools/meta_list_ads/execute": {
      "post": {
        "operationId": "meta_list_ads",
        "summary": "List Meta ads",
        "description": "Lists individual ads with delivery status, the creative behind each one and a preview link the user can open.\nUse when: you need ad ids to pause or compare specific ads, or the user asks what creative is live.\nDo not use to judge creative quality — get the numbers from meta_get_ad_performance first.\nReturns effective_status, which is where you see review problems: DISAPPROVED or PENDING_REVIEW explain zero delivery far more often than budget does.\nScope with ad_set_id or campaign_id; without either you get the whole account.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What ads are live in this ad set?",
          "Show me every ad in the account with its thumbnail"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Only ads in this ad set."
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Only ads in this campaign."
                      },
                      "status": {
                        "description": "Comma-separated effective_status filter, e.g. \"ACTIVE,PAUSED\". Omit (or pass ALL) for everything except deleted and archived.",
                        "type": "string"
                      },
                      "limit": {
                        "description": "Maximum ads to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
