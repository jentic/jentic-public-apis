    "/api/v1/tools/chatgpt_update_ad_group/execute": {
      "post": {
        "operationId": "chatgpt_update_ad_group",
        "summary": "Edit a ChatGPT Ads ad group",
        "description": "Changes an ad group's name, maximum bid or context hints, and — because geo targeting is a campaign setting on this platform — optionally the locations the whole parent campaign runs in.\nUse when: the user has named what to change and what to change it to. Read the ad group first with chatgpt_list_ad_groups so the diff is against something you have shown them.\nDo not use it to pause or resume: chatgpt_pause_ad_group and chatgpt_resume_ad_group state the risk of that change properly. Do not use it for budgets — those are on the campaign, so use chatgpt_update_campaign.\nDo not ask it for automatic bidding: Adako only sets fixed bids here, so automatic_bidding: true is refused. The platform's own Maximize Results bidding needs a campaign on a daily budget and has to be set in Ads Manager. The bid's unit follows the campaign objective — a CPM (per 1,000 impressions) for reach, per click for clicks, per conversion for conversions — and the preview shows the old and new bid in that unit.\nDo not pass place names in the location arguments; resolve them with chatgpt_geo_lookup first. Changing locations here replaces the campaign's whole include or exclude list, country-level targeting included, and therefore affects every ad group under it. The preview shows exactly what is replaced.\nReturns the ad group read back from the platform, so the new bid is confirmed rather than assumed. A maximum bid far below the market stops winning auctions altogether, which looks like a broken ad group; the preview warns when a change looks like that.\nAt least one field must be given. If the user says \"bid higher\" without a number, ask how much.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Raise the max bid on ad group adg_01 to $3",
          "Lower the CPM bid on ad group adg_01 to $40",
          "Only run the autumn campaign in Germany"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "ad_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "The ad group to edit, from chatgpt_list_ad_groups."
                      },
                      "name": {
                        "description": "New name.",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000
                      },
                      "max_bid": {
                        "description": "New maximum bid, a decimal in the account currency. Its meaning follows the campaign objective: reach → the most to pay per 1,000 impressions (CPM, 60 means 60.00 per thousand); clicks → the most to pay per click (2.5 means 2.50 per click); conversions → the target cost per conversion (100 means 100.00 per conversion, although billing is still per click).",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "automatic_bidding": {
                        "description": "Not supported here: Adako only sets fixed bids on this platform, so true is refused. Pass max_bid with the amount the user wants instead.",
                        "type": "boolean"
                      },
                      "context_hints": {
                        "description": "Replaces the context hints entirely. Pass an empty array to clear them.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "geo_location_ids": {
                        "description": "Location ids from chatgpt_geo_lookup that the ads may run in. Ids only — a place name here is refused. Targeting lives on the campaign on this platform, so this replaces the campaign’s whole location list (country-level targeting included) and applies to every ad group under it.",
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "excluded_geo_location_ids": {
                        "description": "Location ids from chatgpt_geo_lookup the ads must not run in. Ids only. Like the include list, this is campaign-wide and replaces the campaign’s whole exclude list, excluded countries included.",
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_group_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/chatgpt_update_campaign/execute": {
      "post": {
        "operationId": "chatgpt_update_campaign",
        "summary": "Edit a ChatGPT Ads campaign",
        "description": "Changes a campaign's name, status or spend limit. Both limits are decimals in the account currency: the lifetime limit is a hard ceiling on everything the campaign will ever spend, the daily limit paces it per day.\nA campaign has one or the other, never both, so pass only one of lifetime_budget and daily_budget — passing both is refused. Setting a daily budget on a lifetime campaign replaces the ceiling permanently: the platform cannot switch back, so read chatgpt_list_campaigns first and tell the user which kind of limit the campaign has now.\nUse when: renaming for clarity, or the user has decided to scale a campaign up or down and named the amount.\nDo not use it to pause or resume — chatgpt_pause_campaign and chatgpt_resume_campaign exist so the risk of that change is stated correctly to the user before they approve it.\nDo not lower the lifetime ceiling below what the campaign has already spent: the platform refuses it, and once a campaign is at its ceiling it stops delivering. Check spend with chatgpt_get_performance first.\nReturns the campaign read back from the platform after the change, so the new values are confirmed rather than assumed. At least one of name, status, lifetime_budget or daily_budget must be given.\nIf the user says \"increase the budget\" without a number, ask which limit and how much. Never pick an amount for them.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Raise the daily budget on my autumn campaign to $40",
          "Rename campaign cmp_01 to something clearer"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "The campaign to edit."
                      },
                      "name": {
                        "description": "New campaign name.",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000
                      },
                      "status": {
                        "description": "New status. Prefer chatgpt_pause_campaign / chatgpt_resume_campaign, which explain the risk properly.",
                        "type": "string",
                        "enum": [
                          "active",
                          "paused"
                        ]
                      },
                      "lifetime_budget": {
                        "description": "Hard ceiling on total spend, decimal in the account currency (25 means twenty-five, not 2500). Only for a campaign that already has a lifetime ceiling; a daily-budget campaign cannot be switched back. Never pass this together with daily_budget.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "daily_budget": {
                        "description": "Daily spending limit, decimal in the account currency. Replaces a lifetime ceiling permanently if the campaign has one. Never pass this together with lifetime_budget.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
