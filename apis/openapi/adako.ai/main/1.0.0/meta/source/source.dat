                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign whose creatives to list. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "campaign_ids": {
                        "description": "Several campaigns at once, instead of campaign_id.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "description": "Only objects in this state. LinkedIn statuses are upper case. Defaults to everything except archived, cancelled and removed.",
                        "type": "string",
                        "enum": [
                          "ACTIVE",
                          "PAUSED",
                          "DRAFT",
                          "ARCHIVED",
                          "COMPLETED",
