    "/api/v1/tools/linkedin_forecast_campaign_supply/execute": {
      "post": {
        "operationId": "linkedin_forecast_campaign_supply",
        "summary": "Forecast LinkedIn bid and budget ranges",
        "description": "Asks LinkedIn what the auction currently costs for a targeting spec: the suggested bid and its range, the lowest and highest bid allowed, and the daily budget limits, for the objective and cost type you intend to use. It does not forecast impressions, clicks or leads.\nUse when: the user asks what a campaign will cost before it exists, or when choosing a bid. It is the only honest answer to \"what CPC should I set\" — LinkedIn's ranges vary enormously by audience and season, and a remembered benchmark is worse than no number.\nDo not present the forecast as a promise. It is the platform's estimate for an unproven audience, it moves week to week, and actual cost per lead depends on the landing page, which LinkedIn knows nothing about.\nDo not use it in place of linkedin_estimate_audience_size — a forecast against a sub-minimum audience is meaningless.\nReturns the suggested bid with its range, the allowed bid range and the daily budget limits, in the account currency.\nIf LinkedIn returns nothing for this spec (it does for very narrow audiences), say the forecast is unavailable and fall back to the audience size plus the platform minimum daily budget. Do not invent a number.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "what will this LinkedIn audience cost per click?",
          "what daily budget does LinkedIn require for this audience?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "targeting": {
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "description": "Targeting entity URNs per facet, exactly as linkedin_search_targeting returned them (for example locations: [\"urn:li:geo:103644278\"]). Never free text. locations is required. Entities inside one facet widen the audience (title A or title B); separate facets narrow it (location and title)."
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "BRAND_AWARENESS",
                          "WEBSITE_VISIT",
                          "ENGAGEMENT",
                          "VIDEO_VIEW",
                          "LEAD_GENERATION",
                          "WEBSITE_CONVERSION",
                          "JOB_APPLICANT"
                        ],
                        "description": "The objective the campaign will use — the forecast depends on it."
                      },
                      "cost_type": {
                        "description": "How the campaign will be billed (default CPC).",
                        "type": "string",
                        "enum": [
                          "CPM",
                          "CPC",
                          "CPV"
                        ]
                      },
                      "campaign_type": {
                        "description": "Campaign type (default SPONSORED_UPDATES).",
                        "type": "string",
                        "enum": [
                          "SPONSORED_UPDATES",
                          "TEXT_AD",
                          "SPONSORED_INMAILS",
                          "DYNAMIC"
                        ]
                      },
                      "daily_budget": {
                        "description": "The daily budget being considered, a decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "targeting",
                      "objective"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
