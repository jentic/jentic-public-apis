                      "audience_expansion": {
                        "description": "Let LinkedIn deliver to similar members outside the spec. Off by default; only turn it on if the user asked.",
                        "type": "boolean"
                      },
                      "audience_network": {
                        "description": "Buy impressions on third-party apps and sites too (LinkedIn Audience Network). Off by default. LinkedIn refuses it for text ads, carousels on WEBSITE_VISIT or ENGAGEMENT, and lead generation.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      },
                      "organization_urn": {
                        "type": "string",
                        "description": "The company page that authors the post, from linkedin_get_organizations."
                      },
                      "video_url": {
                        "description": "The video file. Omit when passing video_urn. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "video_urn": {
                        "description": "An existing urn:li:video:… already in the account. Preferred over uploading.",
                        "type": "string"
                      },
                      "headline": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Headline shown under the video."
                      },
                      "commentary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 3000,
                        "description": "The post text above the video. Sent as plain text: #hashtags and @mentions are not linked."
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where the ad sends people."
                      }
                    },
                    "required": [
                      "name",
                      "objective",
                      "daily_budget",
                      "targeting",
                      "organization_urn",
                      "headline",
                      "commentary",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
