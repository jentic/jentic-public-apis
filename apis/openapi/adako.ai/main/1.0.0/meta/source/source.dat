    "/api/v1/tools/linkedin_get_campaign_performance/execute": {
      "post": {
        "operationId": "linkedin_get_campaign_performance",
        "summary": "LinkedIn campaign (ad set) performance",
        "description": "Reports spend, impressions, clicks, CTR, CPC, CPM, leads, cost per lead and website conversions for a window, per campaign (an ad set in Campaign Manager) and in total, next to the equally long window before it so every number has a baseline.\nUse when: the user asks how LinkedIn is doing, before recommending any budget or bid change, and to decide which campaign is worth more money. Start here, not with a list tool.\nDo not use it for a brief or a report to keep or forward: that is generate_report_now (monitoring router), which covers every connected account and saves a page.\nDo not judge a LinkedIn campaign on a day or two: at typical B2B volumes a single day is noise, and LinkedIn's cost per lead is an order of magnitude above other channels by design. Use last_7_days at minimum, last_30_days for a decision about money.\nDo not read a rise in CPC as failure on its own — on LinkedIn it usually means the auction got busier, and the number that matters is cost per lead.\nReturns account totals with period-over-period change, plus a per-campaign table sorted by spend. LinkedIn ad accounts carry no reporting timezone, so every window here is UTC days.\nIf the user has not said which window, use last_30_days and say so. If a campaign shows spend but zero leads, check linkedin_list_conversions before concluding the ads are bad — an unattached conversion rule reports nothing.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "performance",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "how did my LinkedIn campaigns do last week?",
          "what is my cost per lead on LinkedIn this month?",
          "how are my LinkedIn ad sets performing?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_ids": {
                        "description": "Limit the report to these campaigns. Omit for the whole account.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "campaign_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Limit the report to one campaign group. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "compare_previous": {
                        "description": "Include the previous equally long period for comparison (default true).",
                        "type": "boolean"
                      },
                      "limit": {
                        "description": "Maximum rows to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
