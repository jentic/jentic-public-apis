    "/api/v1/tools/google_research_keywords/execute": {
      "post": {
        "operationId": "google_research_keywords",
        "summary": "Google Ads keyword ideas with volume and bid ranges",
        "description": "Asks Google Keyword Planner for keyword ideas from seed terms or a landing page, and returns average monthly searches, competition and the top-of-page bid range for each.\nUse when: planning a new campaign, expanding an existing one, or checking whether a term has any real search volume.\nDo not use when: the user wants the performance of keywords they already run (google_get_keyword_performance) or the queries that triggered their ads (google_analyze_search_terms).\nVolumes are broad averages Google rounds heavily, and bid ranges are estimates, not what you will pay. Pass location_ids (from google_resolve_locations) and language_id (from google_list_languages) for the market the campaign will target: without locations Google reports worldwide volumes, and without a language it includes keywords in every language, which overstates what one country can deliver. The answer states which market the numbers cover.\nKeyword Planner needs at least Basic API access; on a lower access level this returns access_level_insufficient — say so plainly and suggest planning from search-term data instead.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "research",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Find keyword ideas for running shoes",
          "What is the search volume for this term?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "seed_keywords": {
                        "description": "Starting terms. Give either these, a page_url, or both.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "page_url": {
                        "description": "A landing page Google should read for ideas.",
                        "type": "string",
                        "format": "uri"
                      },
                      "location_ids": {
                        "description": "Geo target constant ids from google_resolve_locations. Volumes are for these places; omit for worldwide volumes.",
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "language_id": {
                        "description": "Language constant id from google_list_languages, e.g. \"1000\" for English. Omit to include keywords in every language.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "include_search_partners": {
                        "description": "Include the Search Network partners in the volume estimate. Default false.",
                        "type": "boolean"
                      },
                      "limit": {
                        "description": "Maximum ideas to return (default 50).",
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 200
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
