    "/api/v1/tools/validate_campaign_draft/execute": {
      "post": {
        "operationId": "validate_campaign_draft",
        "summary": "Dry-run a campaign draft against the platform rules",
        "description": "Checks a campaign draft field by field against Adako's spec for that platform and campaign type, and returns every problem with a severity and what to do about it. Pure dry run: it contacts no platform, changes nothing and costs nothing.\nCatches: missing required fields, text over the character limit, lists with too few or too many items, budgets under the platform floor, objective and optimisation-goal pairings the platform refuses, ids passed as numbers, money that looks like micros or cents, and place or interest names where an id belongs.\nBudget floors: pass currency (the ad account's ISO code, from list_connected_accounts or the account read). The floors Adako knows offline are USD figures, so they are enforced for USD only; in any other or unknown currency the draft is not told it clears the floor — the create tool's preview checks the account's own minimum.\nUse when: you have assembled a draft and before you call any create tool. Run it again after fixing, until there are no blockers.\nWhen not to use: you do not have a draft yet — call get_campaign_spec to learn what to ask the user for.\nReturns per-field issues (blocker / warning / note) and the resolver or tool to call next. A clean result means the draft satisfies the rules Adako knows; the platform is still the final judge, so a create can still be rejected for policy or account state.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Check this campaign draft before we create it.",
          "Is this Meta ad set objective and optimisation goal combination valid?",
          "Are my headlines short enough for a Google search ad?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "platform": {
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads"
                        ],
                        "description": "Which ad platform the draft is for."
                      },
                      "campaign_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "description": "Campaign type, e.g. search, image, video, carousel, chat_card."
                      },
                      "draft": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {},
                        "description": "The draft campaign as an object: the arguments you intend to pass to the create tool."
                      },
                      "currency": {
                        "description": "ISO 4217 code of the ad account currency, e.g. USD, EUR, JPY. Omit when unknown: USD budget floors are then not enforced, and large whole numbers are only flagged as possible micros.",
                        "type": "string",
                        "pattern": "^[A-Za-z]{3}$"
                      }
                    },
                    "required": [
                      "platform",
                      "campaign_type",
                      "draft"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
