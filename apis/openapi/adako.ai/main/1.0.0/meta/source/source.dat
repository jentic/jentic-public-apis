    "/api/v1/tools/linkedin_clone_campaign/execute": {
      "post": {
        "operationId": "linkedin_clone_campaign",
        "summary": "Copy a LinkedIn campaign (ad set)",
        "description": "Copies the settings of an existing campaign (an ad set in Campaign Manager) — objective, type, format, bidding (automatic, or manual with its cost type and bid), budgets, language, delivery settings and targeting — into a new **PAUSED** campaign, with optional overrides for name, budget, schedule, language, Audience Network and targeting.\nUse when: an approach works and should be repeated for another market, audience or offer. Cloning keeps the settings that are working and makes the difference explicit.\nFor another market: put the new locations in add_targeting.locations AND the original ones in remove_targeting.locations — add_targeting alone keeps the original market too — and pass language when that market uses LinkedIn in another language. The preview names the locations the copy will target; read them to the user before they approve.\nDo not expect the creatives (ads) to come with it: LinkedIn creatives belong to a campaign, and the clone starts empty. Add one with linkedin_add_creative or it can never spend, however healthy the settings look.\nDo not clone to make a small change to the original — that is linkedin_update_campaign. Two near-identical campaigns split the audience, compete in the same auction, and make both look worse.\nDo not clone into the same audience without changing the targeting; state plainly that the two will overlap if the user asks for it anyway.\nThe preview counts the copy's audience and refuses targeting under LinkedIn's 300-member minimum.\nReturns the new campaign id and what was copied versus overridden. Nothing spends until it is resumed and has a creative.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "duplicate this LinkedIn campaign for the German market",
          "copy the winning campaign with a higher budget",
          "duplicate this LinkedIn ad set for another market"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign to copy. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "description": "Name for the new campaign."
                      },
                      "campaign_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Put the copy in this group. Defaults to the original's group. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "daily_budget": {
                        "description": "Override the daily budget on the copy.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "add_targeting": {
                        "description": "Entity URNs to add to the copied targeting. New locations are added to the original ones: to move market, also remove those with remove_targeting.",
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "remove_targeting": {
                        "description": "Entity URNs to remove from the copied targeting.",
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "start_date": {
                        "description": "Override the start date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Override the end date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "language": {
                        "description": "Two-letter language members of the new market use LinkedIn in (for example \"de\"); only they see the ads. Defaults to the original's language. LinkedIn supports en, ar, zh, cs, da, id, ms, nl, fr, fi, de, it, ja, ko, no, pl, pt, ro, ru, es, sv, th, tl, tr.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "audience_network": {
                        "description": "Override the LinkedIn Audience Network setting on the copy. Defaults to the original's; LinkedIn refuses it for text ads, lead generation, and carousels on WEBSITE_VISIT or ENGAGEMENT.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id",
                      "name"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
