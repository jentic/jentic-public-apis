    "/api/v1/tools/linkedin_create_text_campaign/execute": {
      "post": {
        "operationId": "linkedin_create_text_campaign",
        "summary": "Create a LinkedIn text ad campaign (ad set)",
        "description": "Creates a TEXT_AD campaign (an ad set in Campaign Manager) — the small desktop-sidebar unit with a 25-character headline and a 75-character description. Campaign group (campaign), campaign and creative (ad); the campaign starts paused and holds everything back.\nUse when: the user has no company page to post from (text ads need none), or wants a cheap desktop-only test of a message before committing to sponsored content. CPCs are far lower than feed placements and so are click volumes.\nDo not use it as the main channel for a serious campaign: text ads do not appear on mobile at all, which is most of LinkedIn's traffic. Say that before recommending it.\nDo not exceed 25 characters of headline or 75 of description — LinkedIn truncates silently and the ad reads as an accident.\nDo not call it without a bid: LinkedIn text ads only bid manually (CPC or CPM), and a manual campaign without a bid never delivers. If the user has no figure, get LinkedIn's suggested range from linkedin_forecast_campaign_supply with campaign_type TEXT_AD and ask. Text ads run with BRAND_AWARENESS, WEBSITE_VISIT or WEBSITE_CONVERSION, never on the Audience Network.\nReturns the campaign and creative ids. Nothing delivers until the campaign is resumed. Say that the campaign is paused when you report the result, with the two links the result gives (LinkedIn Campaign Manager and the campaign's page in Adako), and offer \"enable all\": one linkedin_resume_campaign call, listed in the result as go_live.enable_all, one approval.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "create a LinkedIn text ad campaign for the pricing page",
          "run a cheap LinkedIn test without a company page"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "description": "Campaign name."
                      },
                      "campaign_group_id": {
                        "description": "Existing campaign group id. Omit and a group named after the campaign is created first — prefer reusing one from linkedin_list_campaign_groups.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "BRAND_AWARENESS",
                          "WEBSITE_VISIT",
                          "ENGAGEMENT",
                          "VIDEO_VIEW",
                          "LEAD_GENERATION",
                          "WEBSITE_CONVERSION",
                          "JOB_APPLICANT"
                        ],
                        "description": "Campaign objective. It cannot be changed later — confirm it with linkedin_explain_objectives if unsure. LEAD_GENERATION is refused: its ads need a Lead Gen Form, which this server cannot attach yet."
                      },
                      "daily_budget": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily budget, a decimal in the account currency (50 means fifty). Must clear the LinkedIn per-currency minimum."
                      },
                      "total_budget": {
                        "description": "Optional lifetime ceiling for this campaign.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bid": {
                        "description": "Manual bid, a decimal in the account currency: per click with cost_type CPC, per 1,000 impressions with CPM, per view with CPV. Setting it puts the campaign on manual bidding, where LinkedIn never bids above it. Omit it for LinkedIn's automated bidding, which optimises for the objective and always bills CPM. Text ads need a bid.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "cost_type": {
                        "description": "How a manual bid is billed; defaults to what the objective prefers. Only with bid: without one the campaign bids automatically and is billed CPM.",
                        "type": "string",
                        "enum": [
                          "CPM",
                          "CPC",
                          "CPV"
                        ]
                      },
                      "targeting": {
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "description": "Targeting entity URNs per facet, exactly as linkedin_search_targeting returned them (for example locations: [\"urn:li:geo:103644278\"]). Never free text. locations is required. Entities inside one facet widen the audience (title A or title B); separate facets narrow it (location and title)."
                      },
                      "exclude": {
                        "description": "Facets to exclude from the audience.",
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "start_date": {
                        "description": "YYYY-MM-DD; defaults to today.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "YYYY-MM-DD, optional.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "language": {
                        "description": "Two-letter language members use LinkedIn in; only they see the ads (default \"en\"). LinkedIn supports en, ar, zh, cs, da, id, ms, nl, fr, fi, de, it, ja, ko, no, pl, pt, ro, ru, es, sv, th, tl, tr.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "country": {
                        "description": "Not where the ads run — that is targeting.locations. Only matters for Chinese: \"TW\" or \"HK\" for Traditional, otherwise Simplified. Usually omit.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "audience_expansion": {
                        "description": "Let LinkedIn deliver to similar members outside the spec. Off by default; only turn it on if the user asked.",
                        "type": "boolean"
                      },
                      "audience_network": {
                        "description": "Buy impressions on third-party apps and sites too (LinkedIn Audience Network). Off by default. LinkedIn refuses it for text ads, carousels on WEBSITE_VISIT or ENGAGEMENT, and lead generation.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      },
                      "headline": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 25,
                        "description": "Headline, at most 25 characters."
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 75,
                        "description": "Description, at most 75 characters."
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where the ad sends people."
                      }
                    },
                    "required": [
                      "name",
                      "objective",
                      "daily_budget",
                      "targeting",
                      "headline",
                      "description",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
