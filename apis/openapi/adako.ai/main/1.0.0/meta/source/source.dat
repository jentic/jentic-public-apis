    "/api/v1/tools/google_get_keyword_performance/execute": {
      "post": {
        "operationId": "google_get_keyword_performance",
        "summary": "Google Ads keyword performance (top spenders)",
        "description": "Reports the highest-spending keywords for a period with match type, state, quality score, clicks, conversions, CPA and ROAS.\nUse when: the user asks which keywords work, which are expensive, or you need keyword ids and current bids before changing them.\nDo not use when: the user asks about the actual search queries people typed — those are search terms, not keywords (google_analyze_search_terms).\nReturns the top N by spend, so a keyword missing from the list simply spent less than the ones shown. Pass either date_range or start_date + end_date, never both.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
