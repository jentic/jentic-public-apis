    "/api/v1/tools/google_update_conversion_action/execute": {
      "post": {
        "operationId": "google_update_conversion_action",
        "summary": "Change a conversion action",
        "description": "Changes one conversion action: its status, category, counting type, default value, click-through window, or whether it counts towards the Conversions column.\nUse when: the user knows what the setting should be and why. Marking an action secondary, for example, is the correct fix when a low-value goal is dragging Smart Bidding around.\nDo not use when: you are not sure what the action currently tracks. Read google_get_conversion_action_performance first and show the user the current settings.\nEvery conversion-based campaign in the account bids against the primary actions, so a change here reaches far beyond one campaign. Counting-type and category changes are not retroactive: historical conversions keep their old shape, which makes before/after comparisons misleading for the following weeks.\nThe preview shows each field before and after; read-back confirms what Google stored.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Set the lead conversion to count one per click",
          "Give the signup conversion a default value of 50",
          "Make the newsletter conversion secondary so it stops driving bidding"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "conversion_action_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "From google_list_conversion_actions."
                      },
                      "status": {
                        "description": "Pausing a conversion action stops it recording anything new.",
                        "type": "string",
                        "enum": [
                          "ENABLED",
                          "PAUSED"
                        ]
                      },
                      "category": {
                        "description": "What kind of conversion this is.",
                        "type": "string",
                        "enum": [
                          "DEFAULT",
                          "PURCHASE",
                          "LEAD",
                          "SUBMIT_LEAD_FORM",
                          "BOOK_APPOINTMENT",
                          "REQUEST_QUOTE",
                          "SIGNUP",
                          "CONTACT",
                          "PHONE_CALL_LEAD",
                          "ADD_TO_CART",
                          "BEGIN_CHECKOUT",
                          "SUBSCRIBE_PAID",
                          "DOWNLOAD",
                          "PAGE_VIEW",
                          "ENGAGEMENT",
                          "OUTBOUND_CLICK",
                          "QUALIFIED_LEAD"
                        ]
                      },
                      "counting_type": {
                        "description": "ONE_PER_CLICK counts one conversion per ad click (leads); MANY_PER_CLICK counts every one (sales).",
                        "type": "string",
                        "enum": [
                          "ONE_PER_CLICK",
                          "MANY_PER_CLICK"
                        ]
                      },
                      "default_value": {
                        "description": "Default value per conversion, a decimal in the conversion action's own default currency (google_get_conversion_action_performance shows it; usually the account currency).",
                        "type": "number",
                        "minimum": 0
                      },
                      "always_use_default_value": {
                        "description": "Use the default value even when the tag sends its own value.",
                        "type": "boolean"
                      },
                      "click_lookback_days": {
                        "description": "Click-through conversion window in days (1–90).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "counts_towards_conversions": {
                        "description": "Whether this action feeds the Conversions column Smart Bidding optimises against (primary) or is observation only (secondary).",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "conversion_action_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
