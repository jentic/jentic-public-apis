    "/api/v1/tools/tiktok_list_ad_videos/execute": {
      "post": {
        "operationId": "tiktok_list_ad_videos",
        "summary": "List TikTok videos in the ad account library",
        "description": "Lists the videos already uploaded to the advertiser's creative library with their ids, dimensions, duration and file size, and flags any that break TikTok's in-feed rules.\nUse when: the user wants to launch with a video they have already uploaded, or you need a video_id for tiktok_add_ad. Reusing a video that has already been approved is faster than uploading a new one and avoids a fresh review.\nDo not upload a video that is already here — a duplicate starts its review again and splits the performance data across two ids.\nReturns each video's aspect ratio and duration against TikTok's rules (5–60 seconds, 9:16 / 1:1 / 16:9). A video outside them can still be used in some placements, but the note says what will happen.\nPreview URLs are deliberately not returned: they expire quickly and are not something to paste into a conversation. Costs nothing.",
        "tags": [
          "TikTok Ads"
        ],
