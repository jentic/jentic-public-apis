    "/api/v1/tools/google_list_languages/execute": {
      "post": {
        "operationId": "google_list_languages",
        "summary": "Language ids for campaign targeting",
        "description": "Returns Google's language constant ids, which google_update_campaign_languages needs. The table is the same in every account, so this call is free, needs no connection and touches no API.\nUse when: you are about to set language targeting and need the numeric ids.\nDo not use when: the user is asking about locations — that is google_resolve_locations.\nLanguage targeting matches the language of the user's Google interface and of the pages they browse, not the language of your keywords. Targeting only one language when your ads are in that language is usually right; adding English on top is a common accident that brings the wrong traffic.\nPass a search term to filter the table.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
