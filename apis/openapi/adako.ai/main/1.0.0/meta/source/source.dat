    "/api/v1/tools/tiktok_add_ad/execute": {
      "post": {
        "operationId": "tiktok_add_ad",
        "summary": "Add an ad to a TikTok ad group (paused)",
        "description": "Creates one more ad inside an existing TikTok ad group, PAUSED, from a video already in the library or an organic post (Spark Ad).\nUse when: testing a second creative, or replacing one that tiktok_detect_creative_fatigue has flagged. Adding a fresh ad to a working ad group is the right way to handle fatigue: it keeps the ad group's learning, which pausing and rebuilding would throw away.\nDo not upload a video here — this tool takes a video_id. Upload happens in tiktok_create_video_campaign, or the user uploads in Ads Manager and tiktok_list_ad_videos finds the id.\nDo not add more than two or three ads to one ad group. TikTok concentrates delivery on whichever wins early, so extra ads mostly divide the learning rather than expand the test.\nDo not guess the identity. TikTok requires one on every ad; list them with tiktok_list_identities and ask the user which account the ad appears as. A video_id ad also needs exactly one cover image (tiktok_upload_images).\nDo not assume the new ad delivers immediately: it is created paused and, once resumed, TikTok reviews it first — usually a few hours.\nValidates before creating: the identity (it must exist on the advertiser, be available, and be able to carry the post), the cover image, the ad text (no emoji; Chinese and Japanese characters count double), and the landing page the campaign's objective requires.\nReturns the new ad id, read back from TikTok with its review status.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 2,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a new video to my TikTok ad group",
          "Test a second creative in this TikTok ad group",
          "Refresh the creative on my fatigued TikTok ad"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "adgroup_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The ad group to add the ad to, from tiktok_list_ad_groups."
                      },
                      "ad_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "description": "Ad name, for the account's own reporting. No emoji."
                      },
                      "video_id": {
                        "description": "A video in the library, from tiktok_list_ad_videos.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "spark_item_id": {
                        "description": "An organic TikTok post id, for a Spark Ad from an existing post. Needs the posting account's identity and its permission.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "image_ids": {
                        "description": "The cover image, from tiktok_upload_images: exactly one id, same aspect ratio as the video. Required with video_id; not used with spark_item_id.",
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "ad_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "The caption shown with the video: up to 100 characters as TikTok counts them (Chinese and Japanese characters count as two), no emoji."
                      },
                      "call_to_action": {
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "DOWNLOAD_NOW",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "SUBSCRIBE",
                          "WATCH_NOW",
                          "PLAY_GAME",
                          "INSTALL_NOW",
                          "READ_MORE",
                          "VIEW_NOW",
                          "ORDER_NOW"
                        ],
                        "description": "Button text on the ad."
                      },
                      "landing_page_url": {
                        "description": "Where the ad sends people; https only. Required for TRAFFIC and WEB_CONVERSIONS campaigns.",
                        "type": "string",
                        "maxLength": 2048
                      },
                      "identity_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The identity the ad posts as, from tiktok_list_identities. TikTok requires one on every ad."
                      },
                      "identity_type": {
                        "description": "Identity kind, from tiktok_list_identities; read from TikTok when omitted. TikTok no longer accepts new ads as CUSTOMIZED_USER on placements that include TikTok.",
                        "type": "string",
                        "enum": [
                          "CUSTOMIZED_USER",
                          "AUTH_CODE",
                          "TT_USER",
                          "BC_AUTH_TT"
                        ]
                      },
                      "identity_authorized_bc_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The Business Center a BC_AUTH_TT identity is authorised through, from tiktok_list_identities. Required for BC_AUTH_TT; read from TikTok when omitted."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "adgroup_id",
                      "ad_name",
                      "ad_text",
                      "call_to_action"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
