    "/api/v1/tools/linkedin_get_organizations/execute": {
      "post": {
        "operationId": "linkedin_get_organizations",
        "summary": "List the LinkedIn pages this login can post as",
        "description": "Lists the LinkedIn organizations (company pages) the connected login administers, with their URNs.\nUse when: before creating any image, video or carousel campaign. Every sponsored post on LinkedIn is authored by a page, and the page URN is a required input to linkedin_create_image_campaign and its siblings — this is the only tool that produces valid ones.\nDo not use it to pick a page on the user's behalf when more than one comes back: show the list and ask which brand the ad should speak as. Getting this wrong publishes an ad under the wrong company name.\nReturns id, URN, name, vanity name and the login's role on each page. Costs nothing.\nIf the list is empty the login administers no page: the user must be given a Sponsored Content Poster or Page Admin role on the page in LinkedIn, then reconnect. A text-ad campaign (linkedin_create_text_campaign) needs no page and is the only thing that can run meanwhile.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "which LinkedIn pages can I advertise from?",
          "what company page will the ad be posted by?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
