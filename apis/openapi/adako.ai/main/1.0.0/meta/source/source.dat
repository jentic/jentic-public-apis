    "/api/v1/tools/chatgpt_resume_ad/execute": {
      "post": {
        "operationId": "chatgpt_resume_ad",
        "summary": "Resume a ChatGPT Ads ad",
        "description": "Sets one ad back to active so it can be shown again, inside whatever its ad group and campaign are doing.\nUse when: the user has reviewed a paused creative — often one this server created — and wants it delivering.\nDo not assume resuming makes it live. An ad in review, a paused ad group or a paused campaign each keep it at zero; the read-back and chatgpt_list_ads say which.\nDo not resume a rejected ad and expect a different answer: fix the copy or the destination with chatgpt_update_ad first, which restarts review.\nReturns the ad read back from the platform with its status and review verdict.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Turn ad ad_01 back on",
          "Resume the ad now that it is approved"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
