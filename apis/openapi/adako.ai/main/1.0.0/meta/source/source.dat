    "/api/v1/tools/google_optimize_budget_allocation/execute": {
      "post": {
        "operationId": "google_optimize_budget_allocation",
        "summary": "Propose a budget reallocation (writes nothing)",
        "description": "Produces a **plan** for moving budget between campaigns, based on what each one currently returns and whether it is actually budget-limited. **It changes nothing.** Applying any line of the plan means calling google_update_campaign_budget for that campaign, which the user approves separately.\nUse when: the user asks where their money should go and several campaigns have enough data to compare.\nDo not use when: campaigns have very different objectives (brand versus prospecting), or when a campaign has fewer than about 15 conversions in the window — the comparison is then noise dressed up as arithmetic. Say that instead of producing a plan.\nThe heuristic: rank campaigns by cost per conversion (or by ROAS when you ask for value), raise the efficient ones that are spending their budget, lower the inefficient ones, cap every move at max_change_percentage, never go below min_daily_budget, and keep the account total the same unless you ask otherwise. Proposed budgets are whole multiples of the smallest amount Google bills in the account currency (a whole yen or won, a cent for most others), so any line can be applied exactly as shown.\nA campaign that is not spending its budget will not spend more just because the budget goes up: the plan says so rather than proposing a rise.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "How should I split the budget between these campaigns?",
          "Which campaigns deserve more money?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "objective": {
                        "description": "Optimise for cost per conversion (default) or for return on ad spend.",
                        "type": "string",
                        "enum": [
                          "conversions",
                          "value"
                        ]
                      },
                      "date_range": {
                        "description": "Preset range. Alternatively pass start_date and end_date (YYYY-MM-DD). Never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day of the period (YYYY-MM-DD). Use with end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day of the period (YYYY-MM-DD). Use with start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "max_change_percentage": {
                        "description": "Largest move for any one campaign, as a percentage. Default 20.",
                        "type": "number",
                        "minimum": 5,
                        "maximum": 100
                      },
                      "min_daily_budget": {
                        "description": "Floor no campaign goes below, as a decimal in the account currency.",
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
