    "/api/v1/tools/google_remove_asset_links/execute": {
      "post": {
        "operationId": "google_remove_asset_links",
        "summary": "Unlink assets from a campaign or ad group",
        "description": "Removes the link between an asset and a campaign, ad group or the account, so the extension stops serving there. The asset itself stays in the account library and can be linked again later.\nUse when: the user has confirmed which extensions should stop showing, by name.\nDo not use when: the user said \"pause\" or \"turn off for now\" and you have not explained that Google has no pause for asset links — removing and re-linking is the only path, and the link's history is lost.\nRequires confirm_delete: true. Pass the link resource names from google_list_assets (each asset's links[].link_resource_name), not asset ids: an asset id alone does not say which of its links you mean, and an asset with an empty links list is not linked anywhere, so there is nothing to remove.\nRemoving a link is immediate. Nothing else about the campaign changes.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Remove the old sale sitelink from campaign 123",
          "Take the phone number off the account"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
