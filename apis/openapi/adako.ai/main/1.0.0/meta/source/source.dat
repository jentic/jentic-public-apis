                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "seniorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "staffCountRanges": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interests": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memberBehaviors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
