    "/api/v1/tools/google_get_campaign_structure/execute": {
      "post": {
        "operationId": "google_get_campaign_structure",
        "summary": "Google Ads campaign contents (ad groups, keywords, ads)",
        "description": "Returns the inside of one campaign: its ad groups, the keywords in each (text, match type, state, quality score) and the responsive search ads (headlines, descriptions, display paths, final URL).\nUse when: you need ad group or keyword ids before changing anything, or the user asks what a campaign is actually targeting or saying.\nDo not use when: the user asks about performance numbers (use the performance tools) or about which search queries triggered ads (use google_analyze_search_terms).\nPaginated by ad group. When has_more is true, call again with page_token set to the returned value and merge the pages before answering; never present a partial structure as complete.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What is inside campaign 111?",
          "Show the ad groups and keywords"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "page_size": {
                        "description": "Ad groups per page (default 5, max 20).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "page_token": {
                        "description": "Cursor from the previous call. Omit for the first page.",
                        "type": "string"
                      },
                      "include": {
                        "description": "Trim the response: summary lists ad groups only.",
                        "type": "string",
                        "enum": [
                          "all",
                          "keywords",
                          "ads",
                          "summary"
                        ]
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
