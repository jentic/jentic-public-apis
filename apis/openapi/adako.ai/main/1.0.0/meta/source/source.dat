    "/api/v1/tools/google_set_ad_schedule/execute": {
      "post": {
        "operationId": "google_set_ad_schedule",
        "summary": "Set a campaign ad schedule",
        "description": "Replaces a campaign's whole ad schedule with the blocks you pass. Google has no way to edit one block, so the old schedule is removed and the new one created in the same atomic change.\nUse when: the user wants the campaign to run only at certain times, or to bid differently at certain times, and you have looked at google_get_hourly_performance so the decision is based on something.\nDo not use when: the campaign has little data. Turning ads off for two-thirds of the week on a hunch is the fastest way to make a campaign stop learning, and a Smart Bidding campaign already handles time of day itself — a schedule then mostly removes volume.\n**Any day you do not list becomes a day the campaign does not serve.** The preview says exactly which days go dark.\nHours are in the account timezone. Blocks may not overlap and may not cross midnight; a 22:00–02:00 window is two blocks on two days.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Only run campaign 111 on weekdays 9 to 18",
          "Bid 20% more during working hours",
          "Stop this campaign running overnight"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "schedule": {
                        "minItems": 1,
                        "maxItems": 84,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "day": {
                              "type": "string",
                              "enum": [
                                "MONDAY",
                                "TUESDAY",
                                "WEDNESDAY",
                                "THURSDAY",
                                "FRIDAY",
                                "SATURDAY",
                                "SUNDAY"
                              ],
                              "description": "Day of the week."
                            },
                            "start_hour": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 23,
                              "description": "First hour the ads may serve (0–23)."
                            },
                            "end_hour": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 24,
                              "description": "Hour the block ends (1–24). 24 means midnight."
                            },
                            "start_minute": {
                              "description": "Minute within start_hour. Defaults to ZERO.",
                              "type": "string",
                              "enum": [
                                "ZERO",
                                "FIFTEEN",
                                "THIRTY",
                                "FORTY_FIVE"
                              ]
                            },
                            "end_minute": {
                              "description": "Minute within end_hour. Defaults to ZERO.",
                              "type": "string",
                              "enum": [
                                "ZERO",
                                "FIFTEEN",
                                "THIRTY",
                                "FORTY_FIVE"
                              ]
                            },
                            "bid_modifier": {
                              "description": "Optional bid multiplier for this block.",
                              "type": "number",
                              "minimum": 0.1,
                              "maximum": 10
                            }
                          },
                          "required": [
                            "day",
                            "start_hour",
                            "end_hour"
                          ]
                        },
                        "description": "The complete weekly schedule. This replaces whatever is there now: any day not listed becomes a day the campaign does not serve."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_id",
                      "schedule"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
