                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "include": {
                        "description": "Which kinds to list. Default all: scheduled briefs and monitors together.",
                        "type": "string",
                        "enum": [
                          "all",
                          "briefs",
                          "monitors"
                        ]
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
