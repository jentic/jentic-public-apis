    "/api/v1/tools/why_did_this_fail/execute": {
      "post": {
        "operationId": "why_did_this_fail",
        "summary": "Explain the recent failed calls",
        "description": "Reads this user's real Adako call log, finds the calls that failed or were blocked, and explains each one: the cause, the fix, and the tool to call next. Free; reads Adako's own database and contacts no platform.\nUse when: the user says \"that didn't work\", \"why did that fail\" or \"it's broken\", or after any tool returned an error and you want the history rather than one message.\nWhen not to use: the user pasted a raw platform error — explain_error decodes that directly. And this cannot see failures from other conversations of other users, only this user's own calls.\nReturns one row per failed call, newest first, with the redacted arguments so the user recognises it. If nothing has failed it says so plainly rather than inventing a problem.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Why did that fail?",
          "Something went wrong a minute ago — what was it?",
          "Why do my Google Ads calls keep failing?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
