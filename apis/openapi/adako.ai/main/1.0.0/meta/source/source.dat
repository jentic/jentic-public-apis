    "/api/v1/tools/google_resume_campaign/execute": {
      "post": {
        "operationId": "google_resume_campaign",
        "summary": "Resume a paused Google Ads campaign",
        "description": "Turns a paused campaign back on. It resumes against its existing daily budget and bidding strategy.\nWith include_paused_children: true it also turns on every paused ad group, ad and asset group inside it in the same approval. Use it for a campaign whose ad groups or ads were paused on their own (campaigns Adako created before 2026-10 start that way): a campaign shows nothing while its ad groups, ads or asset groups are paused. A campaign Adako creates now needs only the campaign turned on.\nUse when: the user has asked to restart a specific campaign, or said \"enable all\" after a create.\nDo not use when: the campaign was paused because of a problem that is still unresolved (broken landing page, disapproved ads, exhausted budget) — check first and say what you found.\nMoney starts moving again immediately, so confirm the daily budget with the user before resuming. Automated bidding may need a few days to re-learn.\nA campaign whose end date has already passed is refused rather than resumed: Google would accept the change and serve nothing. Give it a new end date with google_update_campaign first.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Resume campaign 111",
          "Turn the search campaign back on"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "include_paused_children": {
                        "description": "Also turn on every paused ad group, ad and asset group (Performance Max) in the campaign, in the same approval. Use it when the user asked to \"enable all\" on a campaign whose ad groups or ads are paused on their own. Default false: only the campaign changes. Not for a campaign where someone paused parts on purpose.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
