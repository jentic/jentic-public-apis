    "/api/v1/tools/google_pause_campaign/execute": {
      "post": {
        "operationId": "google_pause_campaign",
        "summary": "Pause a Google Ads campaign",
        "description": "Stops a live campaign from serving. Spend stops as soon as Google applies the change; nothing is deleted and google_resume_campaign puts it back exactly as it was.\nUse when: the user has clearly said to stop a specific campaign, and you have shown them what it is currently spending.\nDo not use when: the user only wants to reduce spend (change the budget instead), or when the campaign is already paused — check google_list_campaigns first.\nPausing is never a way to delete something. Smart Bidding strategies lose learning while paused, so a long pause can mean a slower ramp when it is resumed; mention this for conversion-based campaigns.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Pause campaign 111",
          "Stop the brand campaign for now"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
