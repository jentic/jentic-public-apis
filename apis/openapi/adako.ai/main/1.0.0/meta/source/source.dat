    "/api/v1/tools/google_update_keyword/execute": {
      "post": {
        "operationId": "google_update_keyword",
        "summary": "Change a keyword bid or state",
        "description": "Pauses, re-enables or re-bids one keyword.\nUse when: a specific keyword is over- or under-spending and the user has agreed what to do about it.\nDo not use when: you want to change the keyword text or its match type — neither can be edited after creation. Add a new keyword with google_add_keywords and pause the old one instead, and say that is what you are doing.\nBids are decimals in the account currency. A max CPC is ignored while the campaign uses an automated bidding strategy, so check the strategy with google_list_campaigns before promising the bid will take effect.\nPausing a keyword stops it matching; it is not deleted and can be re-enabled at any time.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "keywords",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Pause this keyword",
          "Set the bid on this keyword to 1.50"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
