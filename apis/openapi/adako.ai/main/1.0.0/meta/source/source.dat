    "/api/v1/tools/google_update_campaign_languages/execute": {
      "post": {
        "operationId": "google_update_campaign_languages",
        "summary": "Set the languages a campaign targets",
        "description": "Replaces the set of languages a campaign targets. Pass the complete list you want, not just the change: anything missing from the list is removed.\nUse when: the user has said which languages the campaign should reach and you have ids from google_list_languages.\nDo not use when: the user means the language of the ad copy. Google's language targeting matches the user's interface language and browsing, not your keywords; an English-language campaign targeting every language mostly buys traffic that cannot read the ad.\nThe preview names the languages being added and removed. Leaving a campaign with no language criterion at all is not possible through this tool — pass at least one.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Target German only on campaign 111",
          "Add English to the languages of this campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "language_ids": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "The complete set of languages the campaign should target, from google_list_languages. This replaces the current set."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
