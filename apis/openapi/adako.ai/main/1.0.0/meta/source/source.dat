    "/api/v1/tools/google_get_ad_creative/execute": {
      "post": {
        "operationId": "google_get_ad_creative",
        "summary": "Read the copy behind an ad",
        "description": "Returns the actual copy of responsive search ads: every headline and description, the display paths, the final URLs, the ad strength and Google's approval status.\nUse when: the user wants to see, review or rewrite what is running, or before creating a replacement ad so the new one is genuinely different.\nDo not use when: you want numbers per ad (google_get_ad_performance) or per headline (google_get_asset_performance).\nPass ad_id for one ad, or ad_group_id for every ad in an ad group. An ad's copy cannot be edited in place on Google: changing an ad means creating a new one and pausing the old.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Show me the copy of ad 999",
          "What headlines are running in ad group 456?",
          "Read out the current ads so I can rewrite them"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "ad_id": {
                        "description": "One specific ad.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "ad_group_id": {
                        "description": "Every ad in this ad group.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      }
                    },
                    "description": "Pass ad_id or ad_group_id."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
