    "/api/v1/tools/google_apply_label/execute": {
      "post": {
        "operationId": "google_apply_label",
        "summary": "Apply a label to campaigns or ad groups",
        "description": "Applies an existing label to campaigns and/or ad groups.\nUse when: the user wants to group things for reporting and the label already exists (google_list_labels, or create it with google_create_label).\nDo not use when: the user actually wants to change a campaign name or state — a label is only a tag.\nApplying a label changes nothing about delivery, bids or spend. Things that already carry the label are skipped rather than linked twice.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Label campaigns 111 and 112 as \"Q4 push\"",
          "Tag this ad group with the testing label"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
