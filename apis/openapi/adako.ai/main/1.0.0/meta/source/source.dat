    "/api/v1/tools/google_remove_search_themes/execute": {
      "post": {
        "operationId": "google_remove_search_themes",
        "summary": "Remove search themes from an asset group",
        "description": "Removes search themes from a Performance Max asset group. Removal is permanent: a theme can be added again, but its history is gone.\nUse when: a theme is bringing the wrong traffic and the user has confirmed which ones to drop, by name.\nDo not use when: the user wants to \"pause\" a theme — Google has no paused state for signals, so removal is the only option and it is not reversible in the reporting sense. Say that first.\nRequires confirm_delete: true. Pass the exact theme texts; anything that is not on the asset group is reported back rather than silently ignored.\nRemoving every theme does not stop the campaign: Performance Max keeps serving from the assets and the landing page.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "audiences",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Remove the outdated search themes from asset group 555",
          "Clear the theme about winter sale"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "asset_group_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Asset group id as a string of digits."
                      },
                      "search_themes": {
                        "minItems": 1,
                        "maxItems": 25,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "description": "The exact theme texts to remove, as google_get_search_themes shows them."
                      },
                      "confirm_delete": {
                        "description": "Must be true to remove anything. Ask the user first.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "asset_group_id",
                      "search_themes"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
