    "/api/v1/tools/meta_list_ad_sets/execute": {
      "post": {
        "operationId": "meta_list_ad_sets",
        "summary": "List Meta ad sets",
        "description": "Lists ad sets with budget, optimisation goal, billing event, a one-line targeting summary, schedule and learning-phase state.\nUse when: you need ad set ids, want to know what an ad set optimises for before changing its budget, or need to know whether it is still learning.\nDo not use for results — pair it with meta_get_adset_performance.\nReturns learning stage: an ad set in LEARNING has not yet had enough conversions for stable delivery, so budget or targeting edits restart the phase. Say so before recommending a change.\nPass campaign_id to scope the list; without it you get every ad set in the account.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "List the ad sets in this campaign",
          "Which ad sets have their own budget?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
