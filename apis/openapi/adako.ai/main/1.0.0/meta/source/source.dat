          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/google_validate_and_prepare_assets/execute": {
      "post": {
        "operationId": "google_validate_and_prepare_assets",
        "summary": "Check assets against Google rules before uploading",
        "description": "Checks assets against Google's published rules without writing anything: image URLs are downloaded and measured (format, file size, dimensions, aspect ratio for the slot), text is length-checked, and every URL is checked for being a valid https address.\nUse when: before google_add_image_assets or google_create_pmax_campaign, so the user learns about a wrong crop before a half-built campaign does.\nDo not use when: you want per-asset performance (google_get_asset_performance) or the account's existing assets (google_list_assets).\nThis call is free, needs no connection to a campaign and changes nothing. It reports each asset as ok or with the exact reason it would be rejected.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Will these images work as Performance Max assets?",
          "Check my sitelink texts before I add them"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "images": {
                        "description": "The image files to download and measure. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "field_type": {
                              "type": "string",
                              "enum": [
                                "MARKETING_IMAGE",
                                "SQUARE_MARKETING_IMAGE",
                                "PORTRAIT_MARKETING_IMAGE",
                                "LOGO",
                                "LANDSCAPE_LOGO"
                              ],
                              "description": "Which slot you intend to use the image for."
                            }
                          },
                          "required": [
                            "url",
                            "field_type"
                          ]
                        }
                      },
                      "headlines": {
                        "description": "Headlines to length-check (30; each Chinese, Japanese or Korean character counts as 2).",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "long_headlines": {
                        "description": "Performance Max long headlines to length-check (90).",
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "descriptions": {
                        "description": "Descriptions to length-check (90; the first one 60).",
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "business_name": {
                        "description": "Business name to length-check (25).",
                        "type": "string"
                      },
                      "final_url": {
                        "description": "Landing page URL to check.",
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_add_ad/execute": {
      "post": {
        "operationId": "meta_add_ad",
        "summary": "Add a paused ad to a Meta ad set",
        "description": "Creates one ad, PAUSED, inside an ad set that already exists. The creative is either one that already exists (creative_id) or a new single-image creative built from image_url plus copy.\nUse when: the user wants another ad in an ad set — a new creative to test, or the same creative reused in a second audience.\nDo not use to create a campaign or an ad set; meta_create_image_campaign and meta_add_ad_set do that.\nDo not pass both creative_id and image_url: reusing a creative and making one are different intentions and the tool will not guess.\nReturns the new ad id (and the creative id when one was created) and reads the ad back so the paused status is confirmed.\nIf the user has not said which ad set, ask. Adding an ad to the wrong ad set puts it in front of the wrong audience.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 2,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a second image ad to this ad set",
          "Put the existing creative into the new ad set as a paused ad"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The ad set the new ad goes into, from meta_list_ad_sets."
                      },
                      "ad_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name for the new ad."
                      },
                      "creative_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Reuse an existing creative, from meta_get_ad_creatives. Pass exactly one of creative_id, image_url or image_hash."
                      },
                      "image_hash": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 200,
                        "description": "An image already in the account library, from meta_list_media (its `image_hash`). Pass this instead of image_url when the file is already in the account — nothing is downloaded or uploaded, so it works for a file that has no public link at all."
                      },
                      "image_url": {
                        "description": "The image for a brand-new single-image creative. Requires primary_text and landing_page_url. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "primary_text": {
                        "description": "Main copy for the new creative. Required with image_url.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200
                      },
                      "headline": {
                        "description": "Headline for the new creative.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "description": {
                        "description": "Description line for the new creative.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "landing_page_url": {
                        "description": "Where the new creative sends people. Required with image_url.",
                        "type": "string",
                        "format": "uri"
                      },
                      "call_to_action": {
                        "description": "Button label. Defaults to LEARN_MORE.",
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "SUBSCRIBE",
                          "DOWNLOAD",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "GET_OFFER",
                          "ORDER_NOW",
                          "SEE_MORE",
                          "GET_STARTED",
                          "BUY_NOW",
                          "DONATE_NOW",
                          "NO_BUTTON"
                        ]
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the new creative runs from, from meta_list_pages."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the new creative from."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_set_id",
                      "ad_name"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_add_ad_set/execute": {
      "post": {
        "operationId": "meta_add_ad_set",
        "summary": "Add a paused ad set to a Meta campaign",
        "description": "Creates one new ad set, PAUSED, inside a campaign that already exists: its own audience, optimisation goal, budget and schedule. It does not create any ads — add one afterwards with meta_add_ad.\nUse when: the user wants to test another audience, another geography or another optimisation goal inside the same campaign.\nDo not use when the campaign holds the budget (campaign budget optimisation): the new ad set must not carry its own budget, and Meta rejects it. The preview says so before anything is sent.\nDo not pass free text for locations or interests; use meta_search_targeting first.\nReturns the new ad set id and reads it back so the paused status and budget are confirmed.\nThe preview refuses what Meta would reject: unknown location keys, EU/EEA targeting without dsa_beneficiary and dsa_payor, a budget below Meta's minimum, past dates, and targeting the campaign's special ad category forbids.\nIf the user has not said what the new ad set should target differently, ask — a duplicate of an existing ad set just splits the same budget.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 2,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a second ad set targeting Germany to this campaign",
          "Create a new paused ad set for the lookalike audience"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The campaign the new ad set belongs to, from meta_list_campaigns."
                      },
                      "ad_set_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name for the new ad set."
                      },
                      "daily_budget": {
                        "description": "Daily budget as a decimal in the account currency (25 means 25 dollars, not 2500 cents). One of daily_budget or lifetime_budget is required.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "Total budget for the whole flight, decimal in the account currency. Requires end_time.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_level": {
                        "description": "Which level holds the budget. \"ad_set\" (the default) gives this ad set its own budget, so every ad set is funded separately. \"campaign\" is Meta's campaign budget optimisation (Advantage campaign budget): the campaign holds one budget and Meta decides how much each ad set gets — ad sets added later must then carry no budget of their own. Only \"campaign\" can be edited with meta_update_campaign_budget.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "campaign"
                        ]
                      },
                      "start_time": {
                        "description": "When delivery may start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset, e.g. 2026-10-01T09:00:00+02:00. Not in the past; today or omitted means as soon as the user activates it.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "When delivery must stop: YYYY-MM-DD (runs to 23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset. Required with lifetime_budget.",
                        "type": "string"
                      },
                      "optimization_goal": {
                        "description": "Override what the ad set optimises for. Leave empty to use the objective default. LEAD_GENERATION (instant forms) is not supported; PAGE_LIKES promotes the Page.",
                        "type": "string"
                      },
                      "billing_event": {
                        "description": "What Meta charges for. Leave empty to use IMPRESSIONS.",
                        "type": "string"
                      },
                      "countries": {
                        "description": "ISO 3166-1 two-letter country codes from meta_search_targeting: GB, not UK; GR, not EL.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "region_keys": {
                        "description": "Region keys from meta_search_targeting (never region names). Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "city_keys": {
                        "description": "City keys from meta_search_targeting (never city names, postcodes or media markets). Each city is targeted with a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "Youngest age to target. Minimum 18.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "Oldest age to target. 65 means 65 and over.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "Restrict by gender. Defaults to all — narrow only when the user asks.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "interest_ids": {
                        "description": "Interest ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "behavior_ids": {
                        "description": "Behaviour ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "custom_audience_ids": {
                        "description": "Custom audience ids from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excluded_custom_audience_ids": {
                        "description": "Custom audiences to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "advantage_audience": {
                        "description": "Let Meta deliver beyond the listed interests. Defaults to off so the targeting the user asked for is the targeting they get.",
                        "type": "boolean"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one, including territories such as Réunion.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "objective": {
                        "description": "Only needed when the campaign uses a legacy objective Meta no longer accepts on create. Normally leave empty: the campaign decides.",
                        "type": "string",
                        "enum": [
                          "OUTCOME_AWARENESS",
                          "OUTCOME_TRAFFIC",
                          "OUTCOME_ENGAGEMENT",
                          "OUTCOME_LEADS",
                          "OUTCOME_SALES",
                          "OUTCOME_APP_PROMOTION"
                        ]
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel for a conversion-optimised ad set; from meta_list_pixels."
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The Page a PAGE_LIKES ad set promotes, from meta_list_pages. Only used with optimization_goal PAGE_LIKES; required when the account has several Pages."
                      },
                      "dynamic_creative": {
                        "description": "Make this a dynamic creative ad set, which Meta requires before meta_create_flexible_ad can put an asset-feed ad in it. Meta allows exactly one ad in such an ad set, so leave it off unless the plan is a flexible ad.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id",
                      "ad_set_name"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
