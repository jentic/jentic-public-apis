    "/api/v1/tools/get_monitor_history/execute": {
      "post": {
        "operationId": "get_monitor_history",
        "summary": "Show what a monitor saw each day",
        "description": "Returns one row per day the monitor was evaluated: the value, the baseline, whether the rule held and whether an alert was sent. Free.\nUse when: the user asks why an alert did or did not fire, or wants to see the trend the monitor is watching.\nA row can say \"skipped\" — no synced data that day, or a ROAS rule on an account that records no conversion value. That is not a failure; it is the monitor refusing to judge on nothing.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Show the history of my ROAS monitor",
          "Has the CPA alert fired this week?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "monitor_id": {
                        "type": "string",
                        "minLength": 8,
                        "description": "Id from list_monitors."
                      },
                      "limit": {
                        "description": "How many days back. Default 30.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
