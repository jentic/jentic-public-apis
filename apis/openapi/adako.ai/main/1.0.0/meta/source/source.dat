    "/api/v1/tools/google_add_sitelinks/execute": {
      "post": {
        "operationId": "google_add_sitelinks",
        "summary": "Add sitelink extensions",
        "description": "Creates sitelink assets and links them to the account, a campaign or an ad group. A sitelink is a short label plus a URL that appears under the ad.\nUse when: the user has given the link texts and the URLs they point to.\nDo not use when: you would be inventing the destinations — a sitelink pointing at a page that does not exist is a bad ad and a disapproval risk. Ask for the URLs.\nGoogle wants at least four sitelinks before it shows them, and both description lines together or neither. Identical sitelinks already linked at the same level are skipped, not duplicated.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add sitelinks for pricing, docs and contact to campaign 123",
          "Put our four main sitelinks on the whole account"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Attach at campaign level. Leave out to attach to the whole account.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "ad_group_id": {
                        "description": "Attach at ad group level. Narrower than campaign level.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "sitelinks": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "link_text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 25,
                              "description": "The clickable text, 25 characters or fewer (12 in Chinese, Japanese or Korean, whose characters count as 2)."
                            },
                            "final_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Where the sitelink goes. Must be an https URL."
                            },
                            "description1": {
                              "description": "First description line, 35 characters. Give both lines or neither.",
                              "type": "string",
                              "maxLength": 35
                            },
                            "description2": {
                              "description": "Second description line, 35 characters.",
                              "type": "string",
                              "maxLength": 35
                            }
                          },
                          "required": [
                            "link_text",
                            "final_url"
                          ]
                        },
                        "description": "The sitelinks to add."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "sitelinks"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
