    "/api/v1/tools/list_pending_proposals/execute": {
      "post": {
        "operationId": "list_pending_proposals",
        "summary": "List proposals waiting for approval",
        "description": "Lists writes that were proposed but not yet approved, with their preview and expiry (48 h).\nUse when: the user asks \"what is waiting for my approval\", or after a tool returned proposal_pending. Free.\nPass proposal_ids to also get those proposals as they stand now, whatever their status (approved and applied with what exists now, rejected, failed or expired): use it when the user asks whether a change went through.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "proposals",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What changes are waiting for my approval?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "proposal_ids": {
                        "description": "Proposals to return as they stand now, whatever their status. Omit to list only what is pending.",
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 8
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
