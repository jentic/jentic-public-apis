    "/api/v1/tools/linkedin_list_creatives/execute": {
      "post": {
        "operationId": "linkedin_list_creatives",
        "summary": "List the creatives (ads) on a LinkedIn campaign (ad set)",
        "description": "Lists the creatives (ads in Campaign Manager) attached to one or more campaigns (ad sets), with their intended status, whether they are actually serving, their review verdict and any rejection reason.\nUse when: a campaign is ACTIVE but spending nothing (the answer is usually a creative in review or rejected), before pausing or deleting a creative, and to get the creative ids the pause/resume/delete tools take.\nDo not read performance here — that is linkedin_get_creative_performance. Do not treat \"intended status ACTIVE\" as live: the is_serving column is the truth, and a paused parent campaign overrides an active creative.\nReturns one row per creative, including the post URN it renders so you can tell two similar ads apart.\nIf a creative is rejected, report the rejection reason verbatim and stop — appealing is done in Campaign Manager, not through this server.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
