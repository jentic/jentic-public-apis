    "/api/v1/tools/chatgpt_archive_campaign/execute": {
      "post": {
        "operationId": "chatgpt_archive_campaign",
        "summary": "Archive a ChatGPT Ads campaign permanently",
        "description": "Archives one campaign permanently. This cannot be undone on this platform: the campaign and everything under it stop delivering for good, cannot be resumed, renamed or reused, and only its historical numbers remain.\nUse when: the user has explicitly asked to remove or clean up a campaign they are certain about, and understands it is permanent. Requires confirm_delete: true, which you may only set after they have said so in their own words.\nDo not use it to stop spend — chatgpt_pause_campaign does that, reversibly, and is almost always what \"stop\", \"turn off\" or \"kill\" actually means. If there is any doubt at all, pause instead and say why.\nDo not archive to tidy up on your own initiative, and never archive something you created in this conversation without being asked twice.\nReturns the campaign read back from the platform in its archived state. Once that read-back says archived, there is nothing anyone can do to bring it back — say that plainly rather than offering to undo it.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Archive the old test campaign so it stops cluttering the list",
          "Delete campaign cmp_02 — we will never use it again"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
