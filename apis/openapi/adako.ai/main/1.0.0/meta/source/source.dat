    "/api/v1/tools/tiktok_analyze_geo_performance/execute": {
      "post": {
        "operationId": "tiktok_analyze_geo_performance",
        "summary": "Compare TikTok results by country",
        "description": "Breaks spend, impressions, CTR, conversions and CPA down by country for a window, ranked by spend, and flags countries taking meaningful budget with nothing to show for it.\nUse when: the user sells in specific markets, suspects budget is going somewhere it should not, or wants to know where to concentrate. Scope it with campaign_id or adgroup_id.\nDo not treat a high CPA in a small market as a finding — a country with a handful of conversions has a CPA that means nothing. The tool marks which rows have enough volume to judge; trust that marking rather than the ranking.\nDo not change targeting from this tool. It reads; changing where a campaign runs is tiktok_update_ad_group, and the location ids it needs come from tiktok_search_targeting, never from a country name.\nReturns country codes as TikTok reports them (ISO two-letter). If the user asks about a region rather than a country, say which countries you are reading and let them correct you.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Which countries are my TikTok ads working in?",
          "Is my TikTok budget leaking into countries I do not sell to?",
          "Compare TikTok CPA by country"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only this campaign."
                      },
                      "adgroup_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only this ad group."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in — it matters on TikTok, where video metrics settle for hours. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "limit": {
                        "description": "Maximum countries to return (default 20, by spend).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/tiktok_analyze_wasted_spend/execute": {
      "post": {
        "operationId": "tiktok_analyze_wasted_spend",
        "summary": "Find TikTok spend with nothing to show for it",
        "description": "Lists the ad groups and ads that spent real money over a window and produced no conversions, excluding anything still in its learning period or too thin to judge.\nUse when: the user asks what to cut, where budget is leaking, or why the account's CPA is high. Run it before recommending any pause.\nDo not pause anything from this list without showing it to the user first, and do not use it on a window shorter than a week — TikTok needs roughly 7 days per ad group before its numbers mean anything, and this tool excludes newer ones for exactly that reason.\nDo not treat \"no conversions\" as proof of failure when the account has no working pixel: if every ad group shows zero, the problem is measurement, not delivery. Check tiktok_list_pixels before drawing any conclusion.\nReturns each candidate with its spend, impressions, clicks and how long it has been running, plus the total that could be reclaimed. Anything under 1000 impressions is listed separately as \"too thin to judge\" rather than recommended — a cheap ad group that has barely run has not failed yet.\nIf the user wants to act, tiktok_pause_ad_group and tiktok_pause_ad do it one object at a time, each with its own confirmation.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Where is my TikTok budget being wasted?",
          "Which TikTok ad groups have spent money with no conversions?",
          "What should I pause on TikTok?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Only inside this campaign."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in — it matters on TikTok, where video metrics settle for hours. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "min_spend": {
                        "description": "Ignore objects that spent less than this (decimal in the account currency). Defaults to 3× the account CPA, or 2% of total spend.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "level": {
                        "description": "Which level to inspect. Defaults to ad_group, where budget decisions are made.",
                        "type": "string",
                        "enum": [
                          "ad_group",
                          "ad"
                        ]
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/tiktok_create_video_campaign/execute": {
      "post": {
        "operationId": "tiktok_create_video_campaign",
        "summary": "Create a TikTok video campaign (paused)",
        "description": "Builds a complete TikTok campaign — campaign, one ad group and one in-feed video ad — from a video URL, an existing video id, or an organic post for a Spark Ad. The campaign is created PAUSED and its ad group and ad enabled inside it, so nothing spends until the campaign is turned on, and turning it on launches everything.\nUse when: the user wants a new TikTok campaign and has given the pieces: what it should achieve, a daily budget, where it should run, the video, the TikTok account the ad should appear as, and (for a video) a cover image. Resolve every place, language and interest with tiktok_search_targeting first, pick the identity with tiktok_list_identities, and confirm the objective with tiktok_explain_objective — this tool takes ids and refuses names.\nDo not call it twice for the same campaign. It creates three objects and Adako has no delete tool: a duplicate must be paused and abandoned by hand. If a call fails, read the error — it names exactly which objects were created before the failure — and fix forward rather than retrying.\nDo not invent a budget, an audience, an identity or a landing page. If the user has not named one, ask. Do not use a WEB_CONVERSIONS objective without checking tiktok_list_pixels: optimising for an event that is not firing burns the budget in the learning phase and never settles.\nWhat it validates before creating anything: the objective / optimisation goal / billing combination, the campaign and ad group budget range and precision for the account's currency, the bid against its limits and both budgets, the schedule (days are the advertiser's, and a start more than a few hours in the past is refused), the pixel and event when the objective needs them, every location id against TikTok's list (including overlaps and the under-18 rules), the language codes, the identity (it must exist, be available, and be able to carry the post), the cover image, the ad text (no emoji; Chinese and Japanese characters count double), and the video itself — which is uploaded and read back from TikTok first, so a video that is too short never leaves a campaign behind.\nReturns the campaign, ad group and ad ids, read back from TikTok, plus what to do next. Say explicitly that the campaign is paused when you report the result, with the two links the result gives (TikTok Ads Manager and the campaign's page in Adako), and offer \"enable all\": one tiktok_resume_campaign call, listed in the result as go_live.enable_all, one approval. TikTok also reviews the ad before it delivers, which usually takes a few hours.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Launch a TikTok campaign for my new product with this video",
          "Set up a TikTok traffic campaign targeting Germany at $60 a day",
          "Create a TikTok Spark Ad from our latest post"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "REACH",
                          "TRAFFIC",
                          "VIDEO_VIEWS",
                          "ENGAGEMENT",
                          "WEB_CONVERSIONS"
                        ],
                        "description": "What the campaign buys. Call tiktok_explain_objective first if the user described a goal rather than naming one — the objective cannot be changed after the campaign exists."
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "description": "Campaign name as it appears in Ads Manager. No emoji."
                      },
                      "campaign_daily_budget": {
                        "description": "Daily budget for the campaign, a decimal in the account currency (60 means sixty, not 6000). Whole numbers only in currencies such as JPY, KRW, IDR, VND and TWD. Give this or campaign_lifetime_budget.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "campaign_lifetime_budget": {
                        "description": "Budget for the whole campaign instead of a daily one (TikTok's BUDGET_MODE_TOTAL). Decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "adgroup_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "description": "Ad group name. No emoji."
                      },
                      "adgroup_daily_budget": {
                        "description": "Daily budget for the ad group, decimal in the account currency. Cannot exceed the campaign budget. Give this or adgroup_lifetime_budget.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "adgroup_lifetime_budget": {
                        "description": "Budget for the ad group's whole flight instead of a daily one. Needs end_date: a total budget paces to the end of the flight.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "start_date": {
                        "description": "First day the ad group may deliver, YYYY-MM-DD in the advertiser's timezone: from 00:00 that day there, or from now if it is today. A past day is refused. Omit to start from the moment it is created — it still only delivers once resumed.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, inclusive, in the advertiser's timezone: delivery stops at 23:59:59 that day there. Omit to run open-ended.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "optimization_goal": {
                        "description": "What the ad group optimises for. Omit to take the objective's default — tiktok_explain_objective lists the valid pairs.",
                        "type": "string",
                        "maxLength": 40
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel to optimise against. Required for WEB_CONVERSIONS; from tiktok_list_pixels."
                      },
                      "optimization_event": {
                        "description": "The pixel event to optimise for, e.g. ON_WEB_ORDER. Required for WEB_CONVERSIONS; pick one that is actually firing.",
                        "type": "string",
                        "maxLength": 64
                      },
                      "bid": {
                        "description": "Manual bid (cost cap), decimal in the account currency. The unit follows the optimisation goal: per click for CLICK and PAGE_VISIT, per 1,000 impressions for REACH, per focused view for ENGAGED_VIEW and ENGAGED_VIEW_FIFTEEN, and a target cost per result for FOLLOWERS, CONVERT and VALUE. It must be lower than both the ad group and the campaign budget. Omit to let TikTok bid automatically, which is the right default for a new ad group.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "location_ids": {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "TikTok location ids from tiktok_search_targeting. Never a country or city name, and never a place together with a place inside it (a country and one of its cities) — TikTok refuses overlapping locations."
                      },
                      "age_groups": {
                        "description": "Age bands to target. Leave unset to reach every age TikTok allows, which includes 13–17 in most markets — pass the adult bands explicitly if the product is for adults only. In the US, Canada, Latin America, the EEA, the UK and Switzerland, TikTok limits an ad group that narrows by gender or interests to 18+, and refuses AGE_13_17 combined with them.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "AGE_13_17",
                            "AGE_18_24",
                            "AGE_25_34",
                            "AGE_35_44",
                            "AGE_45_54",
                            "AGE_55_100"
                          ]
                        }
                      },
                      "gender": {
                        "description": "Gender to target. Leave unset unless the product genuinely requires it.",
                        "type": "string",
                        "enum": [
                          "GENDER_UNLIMITED",
                          "GENDER_MALE",
                          "GENDER_FEMALE"
                        ]
                      },
                      "languages": {
                        "description": "Language codes exactly as tiktok_search_targeting (type: language) returns them, e.g. \"en\", \"pt-BR\". Checked against TikTok's list before anything is created.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 16
                        }
                      },
                      "interest_category_ids": {
                        "description": "Interest category ids from tiktok_search_targeting (type: interest). Omit to let TikTok find the audience itself.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "interest_keyword_ids": {
                        "description": "Additional interest ids from tiktok_search_targeting (type: interest_keyword). Omit unless the user asked for a specific interest the categories do not cover.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "operating_systems": {
                        "description": "Target only one mobile operating system: ANDROID or IOS. TikTok takes a single value; leave unset for both.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "ANDROID",
                            "IOS"
                          ]
                        }
                      },
                      "placement_type": {
                        "description": "PLACEMENT_TYPE_AUTOMATIC (default, and usually cheapest) or PLACEMENT_TYPE_NORMAL to choose placements, which then requires placements.",
                        "type": "string",
                        "enum": [
                          "PLACEMENT_TYPE_AUTOMATIC",
                          "PLACEMENT_TYPE_NORMAL"
                        ]
                      },
                      "placements": {
                        "description": "Which placements, required when placement_type is PLACEMENT_TYPE_NORMAL and ignored otherwise. PLACEMENT_PANGLE is off-app inventory; PLACEMENT_GLOBAL_APP_BUNDLE only reaches Brazil, Indonesia, Vietnam, the Philippines, Thailand, Malaysia, Mexico, Saudi Arabia and Japan.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "PLACEMENT_TIKTOK",
                            "PLACEMENT_PANGLE",
                            "PLACEMENT_GLOBAL_APP_BUNDLE"
                          ]
                        }
                      },
                      "special_industries": {
                        "description": "Set when the ads promote housing, employment or credit opportunities (TikTok's special ad categories, generally available to advertisers registered in the US or Canada). The ad group may then not target by gender, age below 18+ or interest keywords. Ask the user rather than guess.",
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "HOUSING",
                            "EMPLOYMENT",
                            "CREDIT"
                          ]
                        }
                      },
                      "video_url": {
                        "description": "The video file for the ad. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "maxLength": 2048
                      },
                      "video_id": {
                        "description": "A video already in the library, from tiktok_list_ad_videos.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "spark_item_id": {
                        "description": "An organic TikTok post id, for a Spark Ad from an existing post. Needs the posting account's identity and its permission.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "image_ids": {
                        "description": "The cover image, from tiktok_upload_images: exactly one id, with the same aspect ratio as the video. Required with video_url or video_id — TikTok refuses a video ad without one. Not used with spark_item_id, which keeps the post's own cover.",
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "ad_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "description": "Ad name, for the account's own reporting. No emoji."
                      },
                      "ad_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "The caption shown with the video: up to 100 characters as TikTok counts them (each Chinese or Japanese character counts as two), no emoji. The first 40 characters are what actually gets read in feed."
                      },
                      "call_to_action": {
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "DOWNLOAD_NOW",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "SUBSCRIBE",
                          "WATCH_NOW",
                          "PLAY_GAME",
                          "INSTALL_NOW",
                          "READ_MORE",
                          "VIEW_NOW",
                          "ORDER_NOW"
                        ],
                        "description": "Button text on the ad."
                      },
                      "landing_page_url": {
                        "description": "Where the ad sends people, https only. Required for TRAFFIC and WEB_CONVERSIONS; optional for REACH, VIDEO_VIEWS and ENGAGEMENT.",
                        "type": "string",
                        "maxLength": 2048
                      },
                      "identity_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The identity the ad posts as, from tiktok_list_identities. TikTok requires one on every ad; ask the user which account the ad should appear as."
                      },
                      "identity_type": {
                        "description": "Identity kind, from tiktok_list_identities; read from TikTok when omitted. TT_USER or BC_AUTH_TT run a video_id as a Spark Ad; AUTH_CODE only runs spark_item_id; TikTok no longer accepts new ads as CUSTOMIZED_USER on placements that include TikTok.",
                        "type": "string",
                        "enum": [
                          "CUSTOMIZED_USER",
                          "AUTH_CODE",
                          "TT_USER",
                          "BC_AUTH_TT"
                        ]
                      },
                      "identity_authorized_bc_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The Business Center a BC_AUTH_TT identity is authorised through, from tiktok_list_identities. Required for BC_AUTH_TT; read from TikTok when omitted."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "objective",
                      "campaign_name",
                      "adgroup_name",
                      "location_ids",
                      "ad_name",
                      "ad_text",
                      "call_to_action"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
