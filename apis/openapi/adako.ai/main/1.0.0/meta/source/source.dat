    "/api/v1/tools/chatgpt_launch_ad/execute": {
      "post": {
        "operationId": "chatgpt_launch_ad",
        "summary": "Launch a ChatGPT Ads chat card ad",
        "description": "Builds a complete, paused campaign on ChatGPT Ads: image upload, campaign, ad group and one chat card ad. The campaign is created paused and its ad group and ad active inside it, so nothing delivers and nothing spends until the campaign is turned on, and turning it on launches everything. Say this explicitly when you report the result, with the two links the result gives (ChatGPT Ads Manager and the campaign's page in Adako), and offer \"enable all\": one chatgpt_resume_campaign call, listed in the result as go_live.enable_all, one approval.\nUse when: the user has given a budget, a maximum bid, a destination, ad copy and a square image, and has decided to launch. Resolve every place they named with chatgpt_geo_lookup first — this tool takes location ids and refuses names.\nDo not call it twice for the same brief. If a step fails, the error lists what already exists; finish or remove that rather than starting again, or you will create a second campaign spending a second budget.\nPass exactly one of lifetime_budget and daily_budget: a campaign on this platform can have a total ceiling or a daily limit, never both, and passing both is refused before anything is created.\nDo not invent copy, a budget, a bid, a destination or a location the user did not give. If any of those is missing, ask. max_bid is required because this tool creates a fixed-bid ad group, and its unit follows the objective: a CPM (per 1,000 impressions) for reach, per click for clicks, per conversion for conversions.\nBefore the user approves, confirm with them that every market in the targeting is enabled for advertising on their account: a valid location id does not mean the account may advertise there. The preview lists each location id with its place and country when a recent chatgpt_geo_lookup returned it.\nThe card limits are hard: the title must be 3–50 characters, the body at most 100, and the image must be square. These, the bid and the schedule are all checked before anything is created, so a rejection here costs nothing. Schedule dates are days in the ad account time zone, and a start date already past there is refused.\nReturns the ids of the four objects created and reads all of them back so their state is confirmed rather than assumed. Budgets and bids are decimals in the account currency.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 8,
        "x-adako-category": "creation",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Launch a ChatGPT Ads campaign for my autumn sale with a $500 budget",
          "Create my first ChatGPT Ads campaign from this image and copy"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000,
                        "description": "Name shown in Ads Manager. Say what it sells and to whom."
                      },
                      "lifetime_budget": {
                        "description": "Hard ceiling on everything this campaign will ever spend, as a decimal in the account currency (100 means one hundred, not 10000). A campaign takes either this or daily_budget, never both — pass exactly one.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "daily_budget": {
                        "description": "Daily spending limit, decimal in the account currency, with no total ceiling. A campaign takes either this or lifetime_budget, never both — pass exactly one.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "objective": {
                        "description": "What the platform optimises for: reach, clicks or conversions. Defaults to clicks. Conversions also needs conversion_event_setting_id. It also decides what max_bid means.",
                        "type": "string",
                        "enum": [
                          "reach",
                          "clicks",
                          "conversions"
                        ]
                      },
                      "conversion_event_setting_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "The conversion event to optimise for. Required when objective is conversions."
                      },
                      "geo_location_ids": {
                        "description": "Location ids from chatgpt_geo_lookup to run in. Ids only — a place name here is refused. Omit to run wherever the account is enabled to advertise.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "excluded_geo_location_ids": {
                        "description": "Location ids from chatgpt_geo_lookup the campaign must not run in, for example a region inside an included country. Ids only; an id cannot be both included and excluded.",
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "ad_group_name": {
                        "description": "Ad group name. Defaults to the campaign name with a suffix.",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000
                      },
                      "context_hints": {
                        "description": "Short free-text hints about the audience or context the ad suits. This platform has no keywords; these are the nearest thing.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "max_bid": {
                        "description": "Maximum bid, a decimal in the account currency. This tool creates a fixed-bid ad group, which the platform will not accept without one, so a launch without it is refused before anything is created — ask the user for the number, never invent one. Its meaning follows the campaign objective: reach → the most to pay per 1,000 impressions (CPM, 60 means 60.00 per thousand); clicks → the most to pay per click (2.5 means 2.50 per click); conversions → the target cost per conversion (100 means 100.00 per conversion, although billing is still per click).",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "title": {
                        "type": "string",
                        "description": "Chat card headline, 3–50 characters. This is the line people read first."
                      },
                      "body": {
                        "type": "string",
                        "description": "Chat card body copy, at most 100 characters. Put the offer in the first half."
                      },
                      "target_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where a click goes. Must be https and reachable without a login."
                      },
                      "image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The card image. It must be square; its bytes are checked here before anything is created. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "start_date": {
                        "description": "First day delivery may start, YYYY-MM-DD, in the ad account time zone. Must be today or later there. Defaults to whenever the user activates it.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day of delivery, YYYY-MM-DD, inclusive, in the ad account time zone.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_name",
                      "title",
                      "body",
                      "target_url",
                      "image_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
