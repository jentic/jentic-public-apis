    "/api/v1/tools/tiktok_list_ad_groups/execute": {
      "post": {
        "operationId": "tiktok_list_ad_groups",
        "summary": "List TikTok ad groups",
        "description": "Lists ad groups with their on/off state, TikTok's delivery status, budget and mode, optimisation goal, billing event, bid and schedule.\nUse when: you need ad group ids, or want to know how an ad group buys before changing anything above it. On TikTok the ad group is where budget, bidding, targeting and the pixel all live, so this is the level most questions are really about.\nDo not use it for results — pair it with tiktok_get_ad_group_performance.\nReturns bid_type: BID_TYPE_NO_BID means TikTok spends the budget without a cap on the bid, which is the default this server creates; BID_TYPE_CUSTOM means a cap is set, and a cap far below the market is the most common reason an ad group is active and spends nothing.\nPass campaign_id to scope the list; without it you get every ad group in the advertiser account.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
