    "/api/v1/tools/google_resume_ad_group/execute": {
      "post": {
        "operationId": "google_resume_ad_group",
        "summary": "Resume a paused Google Ads ad group",
        "description": "Turns a paused ad group back on.\nUse when: the user asked to restart a specific ad group.\nDo not use when: its campaign is paused — the ad group will still show nothing, and the user probably means google_resume_campaign. Check the campaign state and say so.\nThe ad group resumes with the keywords, bids and ads it already had; nothing is recreated.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
