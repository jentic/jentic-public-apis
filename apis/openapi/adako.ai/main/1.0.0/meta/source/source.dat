    "/api/v1/tools/google_analyze_search_terms/execute": {
      "post": {
        "operationId": "google_analyze_search_terms",
        "summary": "Analyse Google Ads search terms and suggest negatives",
        "description": "Reads the actual queries people typed before an ad showed, then sorts them into three buckets: converting (at least one conversion), wasted (spend at or above the threshold with no conversions — by default the cost of 10 average clicks in this account, or wasted_threshold in the account currency) and new (not yet added as a keyword or a negative). It also proposes negative keywords with a match type and says why each was chosen.\nUse when: the user asks where their budget is going, wants negative keyword ideas, or wants to find keywords worth adding.\nDo not use when: the user means the keywords they bid on rather than the queries that matched them (google_get_keyword_performance).\nSuggestions are proposals only — nothing is added. To apply them call google_add_negative_keywords, and show the user the list first. Search term data lags roughly a day and Google hides low-volume queries, so the numbers here will not add up exactly to campaign spend.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What are people actually searching for?",
          "Find negative keyword candidates"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Limit to one campaign.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "date_range": {
                        "description": "Preset range. Alternatively pass start_date and end_date (YYYY-MM-DD). Never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day of the period (YYYY-MM-DD). Use with end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day of the period (YYYY-MM-DD). Use with start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "wasted_threshold": {
                        "description": "Minimum spend (decimal, in the account currency) before a zero-conversion term counts as wasted. Default: the cost of 10 average clicks in this account over the period, so it means the same in every currency.",
                        "type": "number",
                        "minimum": 0
                      },
                      "limit": {
                        "description": "How many terms to pull, by spend (default 200).",
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 500
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
