    "/api/v1/tools/chatgpt_geo_lookup/execute": {
      "post": {
        "operationId": "chatgpt_geo_lookup",
        "summary": "Find ChatGPT Ads location ids",
        "description": "Turns a place name into the location ids the platform targets by. \"Berlin\", \"California\", \"Japan\" go in; ids, canonical names and location types come out.\nUse when: the user names any place the ad should run in, always before chatgpt_launch_ad. The launch tool accepts ids only and refuses anything that looks like a name.\nDo not guess an id, reuse one from another ad platform, or pass a place name straight into a write — a wrong id spends real money in the wrong country and the platform will not warn you.\nReturns every match with its type and country code, so you can tell one Springfield from another. Types include country, region, city and dma (a US media market covering several cities, which is often what a metro name resolves to). If several matches look plausible, show them and ask the user which one they mean rather than taking the first.\nA match only proves the place exists. It does not mean this ad account can advertise there: ask the user to confirm the market is enabled for their account before launching in it.\nCosts nothing, so resolve every place the user mentions, one place per call.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Find the ChatGPT Ads location id for Berlin",
          "I want to run this only in California — what is the id?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "description": "The place name to look up, as the user said it. One place per call."
                      },
                      "limit": {
                        "description": "Maximum matches to return (default 10).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "query"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
