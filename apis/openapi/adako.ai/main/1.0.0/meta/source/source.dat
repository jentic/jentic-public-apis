    "/api/v1/tools/tiktok_get_ad_performance/execute": {
      "post": {
        "operationId": "tiktok_get_ad_performance",
        "summary": "Read TikTok ad performance",
        "description": "Reports per ad: spend, impressions, clicks, conversions and the full set of video metrics, with the previous-period comparison.\nUse when: the user asks which creative works, or before deciding what to make more of. This is the level creative decisions are made at.\nDo not judge a creative on fewer than a few thousand impressions — TikTok's early delivery is not representative, and killing a video after a day is the most common way to throw away a winner.\nReturns hook rate, hold rate and completion per ad. Read them in that order: a video that nobody watches past two seconds cannot be fixed by changing the call to action, and a video with a strong hook and weak completion usually needs a shorter edit, not a new idea.\nPair it with tiktok_detect_creative_fatigue when an ad that used to work has slipped: this tool says what is true now, that one says what has been changing.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "performance",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Which TikTok video is performing best?",
          "Show me ad-level TikTok results for last week",
          "What is the completion rate on each of my TikTok ads?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "campaign_id": {
