    "/api/v1/tools/chatgpt_list_ad_groups/execute": {
      "post": {
        "operationId": "chatgpt_list_ad_groups",
        "summary": "List ChatGPT Ads ad groups",
        "description": "Lists ad groups with status, bidding configuration (what the account is billed on and the maximum bid as a decimal in the account currency, in its unit), the free-text context hints that steer where the ads appear, and any serving issue.\nUse when: you need ad group ids, or want to know how an ad group bids before changing anything above it.\nDo not use for results — pair it with chatgpt_get_performance at ad-group level.\nReturns max_bid with bid_unit, which follows the campaign objective: cpm (per 1,000 impressions) for reach, cpc (per click) for clicks, cpa (per conversion) for conversions. The bid is where \"why is this not spending\" often lives: an ad group bidding far below the market simply never wins. bid_strategy says how it bids: fixed_bid carries a maximum bid, while maximize_clicks and maximize_conversions let the platform set the bid and show none.\nNote that geo and audience targeting are set on the **campaign** on this platform, not here — read chatgpt_list_campaigns for where an ad group is allowed to run. Pass campaign_id to scope the list.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v1",
