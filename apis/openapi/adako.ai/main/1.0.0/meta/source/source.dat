    "/api/v1/tools/chatgpt_get_pixel_settings/execute": {
      "post": {
        "operationId": "chatgpt_get_pixel_settings",
        "summary": "Read one ChatGPT Ads pixel and its conversion events",
        "description": "Reads one pixel in detail: when it last received an event, whether a Conversions API key exists, and the conversion event settings on it — the ids a conversions campaign optimises towards.\nUse when: the user is about to launch or move a campaign to the conversions objective, or asks which events are being measured. Pass the id from chatgpt_list_pixels; with exactly one pixel on the account you can omit it.\nDo not use it to judge results — how many conversions were recorded is chatgpt_get_performance. Do not ask the user for their Conversions API key and never put one in a tool argument: this tool reports only whether a key exists.\nReturns the event settings with their ids, so a conversion_event_setting_id for chatgpt_launch_ad never has to be guessed. An event marked not eligible for optimisation cannot be used as a campaign's objective even though it is listed.\nIf the account is not enabled for this part of the API the tool says so plainly; that answer is final, so relay it instead of retrying.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What conversion events can I optimise for?",
          "Is the Conversions API set up on my pixel?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
