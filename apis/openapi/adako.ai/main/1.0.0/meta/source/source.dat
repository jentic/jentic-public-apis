    "/api/v1/tools/linkedin_resume_creative/execute": {
      "post": {
        "operationId": "linkedin_resume_creative",
        "summary": "Resume a LinkedIn creative (ad)",
        "description": "Sets one creative (an ad in Campaign Manager) to ACTIVE so it can serve, subject to the status of its campaign (ad set) and LinkedIn's review.\nUse when: a newly created creative has been reviewed by the user and should go live, or a paused variant is being brought back.\nDo not assume it will serve. A creative only delivers when its campaign is ACTIVE, its campaign group (the Campaign Manager campaign) is ACTIVE, and LinkedIn's review has passed — a creative moving from DRAFT to ACTIVE starts a review that takes up to 24 hours. Check with linkedin_list_creatives rather than promising the user it is live.\nDo not resume several variants at once on a small budget: LinkedIn splits delivery between them and none gets enough impressions to prove anything. Three or four active creatives per campaign is the practical ceiling.\nReturns the creative read back with its review status.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
