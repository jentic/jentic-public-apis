    "/api/v1/tools/meta_browse_targeting/execute": {
      "post": {
        "operationId": "meta_browse_targeting",
        "summary": "Browse Meta’s targeting catalogue",
        "description": "Walks Meta's targeting catalogue by category — interests, behaviours, demographics, life events, industries — instead of searching for a word. Returns the ids a write tool needs.\nUse when: the user described a kind of person rather than naming a topic (\"people who just moved\", \"small business owners\") and a keyword search found nothing useful.\nDo not use when the user named a thing: meta_search_targeting finds \"yoga\" or \"Berlin\" faster and more precisely.\nDo not pick a category for the user when several fit. Show the options with their sizes and let them choose — the wrong interest silently changes who sees the ads.\nReturns id, name, the category path and the approximate audience size for each entry.\nFree: this call does not cost a task. The ids go straight into interest_ids or behavior_ids on the creation and update tools.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What behaviour categories can we target on Meta?",
          "Show me the life-event targeting options",
          "What demographics does Meta offer?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "interests",
                          "behaviors",
                          "demographics",
                          "life_events",
                          "industries"
                        ],
                        "description": "Which part of the catalogue to browse. behaviors covers purchase and device behaviour; life_events covers moves, jobs and relationships."
                      },
                      "contains": {
                        "description": "Filter the returned entries to those whose name or path contains this text.",
                        "type": "string",
                        "maxLength": 60
                      },
                      "limit": {
                        "description": "Maximum entries (default 40).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "category"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
