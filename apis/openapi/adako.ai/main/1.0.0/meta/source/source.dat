    "/api/v1/tools/linkedin_manage_conversions/execute": {
      "post": {
        "operationId": "linkedin_manage_conversions",
        "summary": "Create or edit a LinkedIn conversion rule",
        "description": "Creates a conversion rule on the account, or edits an existing one's name, value, attribution windows or enabled state.\nUse when: the user needs a conversion to track before running a WEBSITE_CONVERSION campaign, or wants to change what a conversion is worth. A new rule is created **enabled but attached to nothing** — it records nothing until linkedin_associate_conversion attaches it to a campaign, and this tool says so in its result.\nDo not create a second rule for something already tracked: duplicate rules double-count and make every cost-per-conversion figure wrong. Run linkedin_list_conversions first, every time.\nDo not change an attribution window on a live rule without telling the user the reported history will shift — LinkedIn re-attributes, and last month's numbers will no longer match what they saw.\nDo not use this for Lead Gen Form leads: those are counted by LinkedIn automatically and need no rule.\nPass url_rules for a rule the site-wide Insight Tag fires by page URL (a thank-you page, say). A rule without URL rules is event-specific: it records nothing until the site runs that rule's own event snippet from Campaign Manager — say so to the user. On an existing rule, url_rules replaces the whole list.\nAttribution windows are 1, 7 or 30 days (post-click default 30, view-through default 7).\nReturns the rule read back from the platform. A rule requires the Insight Tag to be installed on the site; this tool cannot verify that, so say it plainly if the user is unsure.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "create a LinkedIn conversion rule for the demo request page",
          "change the attribution window on this conversion"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "conversion_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The rule to edit. Omit to create a new one. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "name": {
                        "description": "Rule name as it appears in reporting.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 100
                      },
                      "type": {
                        "description": "What the conversion represents (default LEAD for a new rule). LinkedIn documents ADD_TO_CART, DOWNLOAD, INSTALL, KEY_PAGE_VIEW, LEAD, PURCHASE, SIGN_UP, OTHER; the other values are refused with the closest one named.",
                        "type": "string",
                        "enum": [
                          "LANDING",
                          "DOWNLOAD",
                          "SIGN_UP",
                          "PURCHASE",
                          "ADD_TO_CART",
                          "KEY_PAGE_VIEW",
                          "LEAD",
                          "JOB_APPLY",
                          "INSTALL",
                          "PHONE_CALL",
                          "TALK_TO_HUMAN",
                          "OTHER"
                        ]
                      },
                      "value": {
                        "description": "What one conversion is worth, a decimal in the account currency.",
                        "type": "number",
                        "minimum": 0
                      },
                      "post_click_window_days": {
                        "description": "Post-click attribution window in days: 1, 7 or 30 (LinkedIn defaults to 30). 90 is refused.",
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 1
                          },
                          {
                            "type": "number",
                            "const": 7
                          },
                          {
                            "type": "number",
                            "const": 30
                          },
                          {
                            "type": "number",
                            "const": 90
                          }
                        ]
                      },
                      "view_through_window_days": {
                        "description": "View-through attribution window in days (1, 7 or 30; LinkedIn defaults to 7).",
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 1
                          },
                          {
                            "type": "number",
                            "const": 7
                          },
                          {
                            "type": "number",
                            "const": 30
                          }
                        ]
                      },
                      "enabled": {
                        "description": "Switch the rule on or off.",
                        "type": "boolean"
                      },
                      "url_rules": {
                        "description": "Page URLs that count as this conversion when the Insight Tag sees them; a visit matching any one rule counts. Omit for an event-specific rule the site fires itself. On an existing rule this replaces every current URL rule.",
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "match_type": {
                              "type": "string",
                              "enum": [
                                "EXACT",
                                "STARTS_WITH",
                                "CONTAINS"
                              ],
                              "description": "EXACT (the whole URL), STARTS_WITH (a prefix) or CONTAINS (a fragment)."
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500,
                              "description": "The URL text to match, without the protocol: \"example.com/thank-you\". No regular expressions."
                            }
                          },
                          "required": [
                            "match_type",
                            "value"
                          ]
                        }
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
