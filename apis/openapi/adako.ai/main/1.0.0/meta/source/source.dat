                              "type": "string"
                            }
                          },
                          "employers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "degrees": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "fieldsOfStudy": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "interfaceLocales": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "start_date": {
                        "description": "YYYY-MM-DD; defaults to today.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "YYYY-MM-DD, optional.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "language": {
                        "description": "Two-letter language members use LinkedIn in; only they see the ads (default \"en\"). LinkedIn supports en, ar, zh, cs, da, id, ms, nl, fr, fi, de, it, ja, ko, no, pl, pt, ro, ru, es, sv, th, tl, tr.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "country": {
                        "description": "Not where the ads run — that is targeting.locations. Only matters for Chinese: \"TW\" or \"HK\" for Traditional, otherwise Simplified. Usually omit.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "audience_expansion": {
                        "description": "Let LinkedIn deliver to similar members outside the spec. Off by default; only turn it on if the user asked.",
                        "type": "boolean"
                      },
                      "audience_network": {
                        "description": "Buy impressions on third-party apps and sites too (LinkedIn Audience Network). Off by default. LinkedIn refuses it for text ads, carousels on WEBSITE_VISIT or ENGAGEMENT, and lead generation.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      },
                      "organization_urn": {
                        "type": "string",
                        "description": "The company page that authors the post, from linkedin_get_organizations (urn:li:organization:…)."
                      },
                      "image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The creative image (1200×627 or 1200×1200). Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
