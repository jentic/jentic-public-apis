    "/api/v1/tools/google_resume_ad/execute": {
      "post": {
        "operationId": "google_resume_ad",
        "summary": "Resume a paused ad",
        "description": "Turns a paused ad back on. It serves again alongside the other enabled ads in its ad group.\nUse when: the user asked for a specific ad to run again.\nDo not use when: the ad was paused for a policy reason that still stands, or its landing page is still broken — check google_get_ad_creative for the approval status first.\nThe ad group's traffic is split between all enabled ads, so resuming one takes impressions from the others.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Resume ad 999",
          "Turn the old ad back on"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
