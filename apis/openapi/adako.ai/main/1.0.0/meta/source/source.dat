    "/api/v1/tools/google_add_structured_snippets/execute": {
      "post": {
        "operationId": "google_add_structured_snippets",
        "summary": "Add structured snippet extensions",
        "description": "Creates a structured snippet asset — a fixed header such as \"Types\" or \"Brands\" followed by 3–10 values — and links it to the account, a campaign or an ad group.\nUse when: the user has a list that genuinely fits one of Google's headers.\nDo not use when: no header fits. Google only accepts its own header list (Amenities, Brands, Courses, Degree programs, Destinations, Featured hotels, Insurance coverage, Models, Neighborhoods, Service catalog, Shows, Styles, Types); inventing one fails. Callouts are the right tool for free-form selling points.\nThe header must be Google's exact translation for the language of the ads. Pass header in English and, when the ads are not in English, language as Google's locale code (for example \"de\", \"fr\", \"ja\", \"pt-BR\", \"zh-TW\"): the tool sends Google's translated header, and refuses a header Google has not translated for that locale. When language is left out the header is sent in English and the preview warns if the campaign targets other languages. If you do not know the language of the ads, ask.\nEach value is 25 characters or fewer (12 in Chinese, Japanese or Korean) and at least three values are required. An identical header+values snippet already linked at the same level is skipped.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a Types snippet listing our three plans",
          "Add structured snippets for the services we offer"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Attach at campaign level. Leave out to attach to the whole account.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "ad_group_id": {
                        "description": "Attach at ad group level. Narrower than campaign level.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "header": {
                        "type": "string",
                        "enum": [
                          "Amenities",
                          "Brands",
                          "Courses",
                          "Degree programs",
                          "Destinations",
                          "Featured hotels",
                          "Insurance coverage",
                          "Models",
                          "Neighborhoods",
                          "Service catalog",
                          "Shows",
                          "Styles",
                          "Types"
                        ],
                        "description": "One of Google's predefined snippet headers, in English; see language."
                      },
                      "language": {
                        "description": "Google locale code of the ad text, e.g. \"de\", \"es-419\", \"ja\". The header is sent as Google's exact translation for it. Omit for English.",
                        "type": "string",
                        "enum": [
                          "en",
                          "ar",
                          "bg",
                          "ca",
                          "zh-HK",
                          "zh-CN",
                          "zh-TW",
                          "hr",
                          "cs",
                          "da",
                          "nl",
                          "en-AU",
                          "en-GB",
                          "et",
                          "fil",
                          "fi",
                          "fr",
                          "de",
                          "el",
                          "iw",
                          "hi",
                          "hu",
                          "id",
                          "it",
                          "ja",
                          "ko",
                          "lv",
                          "lt",
                          "ms",
                          "no",
                          "pl",
                          "pt-BR",
                          "pt-PT",
                          "ro",
                          "ru",
                          "sr",
                          "sk",
                          "sl",
                          "es-419",
                          "es",
                          "sv",
                          "th",
                          "tr",
                          "uk",
                          "vi"
                        ]
                      },
                      "values": {
                        "minItems": 3,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 25
                        },
                        "description": "3–10 values, 25 characters or fewer each."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "header",
                      "values"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
