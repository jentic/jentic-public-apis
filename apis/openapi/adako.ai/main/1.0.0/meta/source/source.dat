    "/api/v1/tools/google_add_call_asset/execute": {
      "post": {
        "operationId": "google_add_call_asset",
        "summary": "Add a call extension",
        "description": "Creates a call asset — a phone number shown next to the ad — and links it to the account, a campaign or an ad group.\nUse when: the user gave you the number and the country it belongs to, and someone actually answers it during the hours the ads run.\nDo not use when: the number is not staffed, or the user has not confirmed it. Never guess a phone number.\nThe number must be in the country given by country_code and pass Google's verification; numbers that fail verification stop serving silently. Calls are charged like clicks. An identical number already linked at the same level is skipped.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add our sales number as a call extension",
          "Put the phone number on campaign 123"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Attach at campaign level. Leave out to attach to the whole account.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "ad_group_id": {
                        "description": "Attach at ad group level. Narrower than campaign level.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "phone_number": {
                        "type": "string",
                        "minLength": 5,
                        "maxLength": 30,
                        "description": "The phone number as a user would dial it locally, e.g. \"020 7946 0958\"."
                      },
                      "country_code": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2,
                        "description": "Two-letter country code the number belongs to, e.g. \"GB\"."
                      },
                      "call_conversion_reporting": {
                        "description": "Use the account-level call conversion action. Defaults to the account setting; only set it when the user asked.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "phone_number",
                      "country_code"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
