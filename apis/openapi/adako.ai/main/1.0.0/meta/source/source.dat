    "/api/v1/tools/manage_scheduled_task/execute": {
      "post": {
        "operationId": "manage_scheduled_task",
        "summary": "Pause, resume or delete a scheduled brief or a monitor",
        "description": "Pauses, resumes or deletes one recurring brief or one monitor. Adako settings only; nothing on the ad platform changes, past reports stay readable and proposals a monitor already made stay in the approvals inbox.\nUse when: the user says a brief is too frequent, an alert is too noisy, or wants either one back.\nName what you are acting on: task_id for a brief, monitor_id for a monitor. Both come from list_scheduled_tasks; monitor ids also come from list_monitors. Pass one, never both.\nPrefer pause over delete: a paused brief keeps its settings, a paused monitor keeps its history, and either resumes in one call. Deleting needs confirm_delete: true — a schedule cannot be recovered and a deleted monitor takes its evaluation history with it.\nDo not use when: the user wants a monitor's threshold or rule changed — that is update_monitor.\nReturns the new state of whichever one you named.\nIf you are unsure whether the user means a brief or a monitor, call list_scheduled_tasks and ask.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "reporting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Pause my weekly brief",
          "Stop sending the daily report",
          "Turn the Monday report back on",
          "Pause the ROAS monitor"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "task_id": {
                        "description": "Id of a scheduled brief, from list_scheduled_tasks. Pass this or monitor_id.",
                        "type": "string",
                        "minLength": 8
                      },
                      "monitor_id": {
                        "description": "Id of a monitor, from list_scheduled_tasks or list_monitors. Pass this or task_id.",
                        "type": "string",
                        "minLength": 8
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "pause",
                          "resume",
                          "delete"
                        ],
                        "description": "pause stops delivery or evaluation and keeps the settings; delete removes the schedule or the monitor."
                      },
                      "confirm_delete": {
                        "description": "Must be true to remove anything. Ask the user first.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  }
                },
                "required": [
