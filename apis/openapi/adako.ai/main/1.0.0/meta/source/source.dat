    "/api/v1/tools/linkedin_get_audience_insights/execute": {
      "post": {
        "operationId": "linkedin_get_audience_insights",
        "summary": "LinkedIn audience demographics",
        "description": "Breaks delivery down by who saw it: job title, industry, seniority, company size, country, job function or company. This is the demographic report LinkedIn is uniquely good at, and the main reason to advertise there.\nUse when: deciding whether the targeting actually reached the intended buyer, finding a segment worth its own campaign, or finding one worth excluding. It is the evidence behind every targeting change you propose.\nDo not read a segment with a handful of impressions as a signal — LinkedIn reports a long tail of tiny segments and the bottom of the table is noise. Do not treat these as targeting URNs: they are report labels, and a write needs URNs from linkedin_search_targeting.\nReturns the segments sorted by spend with impressions, clicks, CTR, leads and cost per lead per segment. LinkedIn ad accounts carry no reporting timezone, so every window here is UTC days.\nIf the user has not said which dimension, ask — job title and company size lead to different decisions. Do not guess.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "audiences",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "what job titles are clicking my LinkedIn ads?",
          "which industries convert best on LinkedIn?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "pivot": {
                        "type": "string",
                        "enum": [
                          "MEMBER_JOB_TITLE",
                          "MEMBER_INDUSTRY",
                          "MEMBER_SENIORITY",
                          "MEMBER_COMPANY_SIZE",
                          "MEMBER_COUNTRY_V2",
                          "MEMBER_JOB_FUNCTION",
                          "MEMBER_COMPANY"
                        ],
                        "description": "Which dimension to break delivery down by: MEMBER_JOB_TITLE, MEMBER_INDUSTRY, MEMBER_SENIORITY, MEMBER_COMPANY_SIZE, MEMBER_COUNTRY_V2, MEMBER_JOB_FUNCTION or MEMBER_COMPANY."
                      },
                      "campaign_ids": {
                        "description": "Limit to these campaigns.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "limit": {
                        "description": "Maximum rows to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "pivot"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
