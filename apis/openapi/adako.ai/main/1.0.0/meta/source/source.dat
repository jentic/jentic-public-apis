    "/api/v1/tools/meta_list_saved_audiences/execute": {
      "post": {
        "operationId": "meta_list_saved_audiences",
        "summary": "List saved Meta audiences",
        "description": "Lists the saved audiences in the ad account: the reusable targeting definitions someone built in Ads Manager, with their size estimate.\nUse when: the user mentions an audience by name, or you want to know whether a definition already exists before rebuilding it interest by interest.\nDo not confuse these with custom audiences (meta_list_custom_audiences): a saved audience is a targeting recipe, a custom audience is a list of people.\nReturns the id, name, description and approximate size of each saved audience, plus its targeting summary.\nFree: this call does not cost a task. Saved audiences cannot be applied to an ad set through this server yet — say so rather than implying they can.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "audiences",
