    "/api/v1/tools/meta_list_lead_forms/execute": {
      "post": {
        "operationId": "meta_list_lead_forms",
        "summary": "List Meta lead forms",
        "description": "Lists the instant (lead gen) forms attached to the Pages this ad account can advertise from, with how many leads each has collected and what it asks for.\nUse when: the user asks about lead forms, wants a form id for meta_get_lead_form_submissions, or wants to know which form a campaign should use.\nDo not use to read the leads themselves — that is meta_get_lead_form_submissions, and it returns personal data.\nReturns each form's id, name, status, lead count and question labels. Question labels are metadata, not answers, so nothing personal appears here.\nReading forms needs leads_retrieval and pages_manage_ads on the connection and leads access to the Page. If Meta refuses, say which permissions the connection needs rather than guessing the form list.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What lead forms are on our Page?",
          "How many leads has each form collected?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
