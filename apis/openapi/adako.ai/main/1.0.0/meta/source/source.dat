    "/api/v1/tools/tiktok_update_campaign/execute": {
      "post": {
        "operationId": "tiktok_update_campaign",
        "summary": "Edit a TikTok campaign",
        "description": "Changes a TikTok campaign's name or budget. The budget is a decimal in the account currency.\nUse when: renaming for clarity, or the user has decided to scale a campaign and named the amount.\nDo not use it to pause or resume — tiktok_pause_campaign and tiktok_resume_campaign exist so the risk of that change is stated correctly before the user approves it.\nDo not use it for dates: a TikTok campaign has no schedule of its own, so start_date and end_date are refused here — set them on each ad group with tiktok_update_ad_group.\nDo not change a budget by more than about 30% at a time. TikTok treats a large jump as a new learning phase and the CPA gets worse for a few days before it settles; the tool warns when a change crosses that line, and the warning is worth repeating to the user.\nDo not set a budget here when the campaign uses BUDGET_MODE_INFINITE: the ad groups hold the budget and this tool will refuse, because capping the campaign would throttle every ad group at once. TikTok also refuses a new budget below 105% of what the campaign has already spent today (lifetime, for a lifetime budget); the tool checks that first.\nReturns the campaign read back from TikTok after the change, so the new values are confirmed rather than assumed. At least one of name or daily_budget must be given.\nIf the user says \"increase the budget\" without a number, ask how much. Never pick an amount for them.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Raise my TikTok campaign budget to $150 a day",
          "Rename this TikTok campaign",
          "Lower the budget on my TikTok campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The campaign to edit."
                      },
                      "name": {
                        "description": "New campaign name. No emoji.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "daily_budget": {
                        "description": "The new budget, decimal in the account currency (150 means one hundred and fifty, not 15000). It is read in whatever mode the campaign already uses: a daily amount on a daily budget, the whole flight on a lifetime one (tiktok_list_campaigns shows which). TikTok has no way to switch a campaign between the two — that is set when it is created. Must be at least 105% of what the campaign has already spent.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "start_date": {
                        "description": "Not supported: TikTok campaigns have no schedule, so this is refused. Use tiktok_update_ad_group.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Not supported: TikTok campaigns have no schedule, so this is refused. Use tiktok_update_ad_group.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
