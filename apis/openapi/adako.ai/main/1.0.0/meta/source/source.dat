                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/schedule_brief/execute": {
      "post": {
        "operationId": "schedule_brief",
        "summary": "Schedule a recurring performance brief by email",
        "description": "Sets up a daily or weekly brief composed from Adako's synced data and emailed to the operator. Adako settings only; nothing on the ad platform changes.\nUse when: the user asks for a recurring summary (\"every Monday\", \"each morning\"). Confirm the cadence, the hour and the timezone before saving; the timezone defaults to UTC, so ask for it rather than relying on the default.\nDo not use when: the user wants one report right now — that is generate_report_now.\nThe brief compares the period with the one before it: a daily brief covers yesterday against the day before, a weekly one the last 7 days against the previous 7. The evaluation job runs once a day, so the hour schedules the day rather than the minute: the brief goes out on the first daily pass at or after your hour.\nreport_type is saved with the schedule and every run composes that type: performance_brief (the default: totals, per account, top campaigns), detailed_analysis (adds the biggest movers), executive_summary (totals and a few lines).\nReturns the schedule in plain words and when it will first run.\nIf you are unsure which accounts, cadence or period the user means, ask rather than guessing.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "reporting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Send me a weekly summary of all my accounts on Monday mornings",
          "Email me a daily brief at 8am",
          "Set up a Monday report for the Google account"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "cadence": {
                        "type": "string",
                        "enum": [
                          "daily",
                          "weekly"
                        ],
                        "description": "How often the brief goes out."
                      },
                      "weekday": {
                        "description": "Weekly only: 0 = Sunday … 6 = Saturday. Default Monday (1).",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      },
                      "hour": {
                        "description": "Local hour, 0–23. Default 7.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 23
                      },
                      "timezone": {
                        "description": "IANA timezone, for example Europe/Warsaw or America/New_York. Defaults to UTC; ask the user for theirs rather than guessing.",
                        "type": "string",
                        "minLength": 1
                      },
                      "platforms": {
                        "description": "Which platforms to cover. Leave empty for every platform with an active account.",
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "google_ads",
                            "meta_ads",
                            "chatgpt_ads",
                            "tiktok_ads",
                            "linkedin_ads"
                          ]
                        }
                      },
                      "account_ids": {
                        "description": "Platform account ids to cover. Leave empty for every active account.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "delivery_email": {
                        "description": "Where to send it. Defaults to the account owner’s email. Any other address gets a confirmation link first, and the brief goes to the owner’s email until someone at that address confirms.",
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "report_type": {
                        "type": "string",
                        "enum": [
                          "performance_brief",
                          "detailed_analysis",
                          "executive_summary"
                        ],
                        "description": "performance_brief: totals, per account and the top campaigns. detailed_analysis: adds the biggest movers. executive_summary: totals and three lines, nothing else."
                      }
                    },
                    "required": [
                      "cadence"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/search_tools/execute": {
      "post": {
        "operationId": "search_tools",
        "summary": "Find the right Adako tool for a job",
        "description": "Finds the tools that do a job, ranked, from the user's own wording. Free and instant.\nUse when: you are not sure which tool to call, the user asked for something you have not seen a tool for, or a tool name you guessed came back unknown. Searching costs nothing — guessing costs a failed call.\nWhen not to use: you already know the tool name (call it, or call get_tool_schema for its arguments).\nReturns: up to top_k rows with the tool name, what it does, its risk and cost, its arguments (required ones marked) and the exact \"How to call\" line — most tools are reached through their platform router, so follow that line as written. For flat arguments that is enough to make the call; get_tool_schema adds descriptions and nested fields. A request to delete campaigns, ad groups, ad sets or ads also gets a note first: no tool does that, and what to offer instead.\nSearches every platform unless you pass platform. If nothing matches, say so and ask the user what they want to achieve; do not invent a tool name.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "How do I pause a campaign?",
          "Is there a tool for negative keywords?",
          "What can Adako do with Meta audiences?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "query": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 300,
                        "description": "What the user wants to do, in their own words (\"stop wasting money on bad search terms\")."
                      },
                      "platform": {
                        "description": "Restrict to one platform. Leave empty to search all of them.",
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads",
                          "system"
                        ]
                      },
                      "top_k": {
                        "description": "How many tools to return. Default 5.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      }
                    },
                    "required": [
                      "query"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
