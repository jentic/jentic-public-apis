    "/api/v1/tools/explain_error/execute": {
      "post": {
        "operationId": "explain_error",
        "summary": "Explain a platform error",
        "description": "Translates a raw error from any connected ad platform into a plain-language cause, a concrete fix, and the Adako tool to call next. Deterministic rule table, no guessing.\nCovers Google Ads error codes, Meta Graph codes, ChatGPT Ads HTTP shapes, TikTok numeric codes and LinkedIn codes.\nUse when: a tool returned platform_error, or the user pastes an error from the platform UI.\nWhen not to use: the failure was an Adako error (quota, validation, not connected) — call why_did_this_fail instead, which reads the real call log.\nReturns the best-matching rule with cause, fix and next tool. If nothing matches it says so and lists what it does know for that platform; never invent a cause.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What does \"(#100) Invalid parameter\" from Meta mean?",
          "Google returned CUSTOMER_NOT_ENABLED — what do I do?",
          "TikTok error 40105, what is wrong?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "error_text": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 4000,
                        "description": "The raw error message or JSON, pasted verbatim."
                      },
                      "platform": {
                        "description": "Narrows the rule table. Pass it whenever you know the platform: HTTP statuses like 401 mean different things on different platforms.",
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads"
                        ]
                      }
                    },
                    "required": [
                      "error_text"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
