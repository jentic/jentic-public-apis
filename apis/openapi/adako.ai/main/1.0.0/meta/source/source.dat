    "/api/v1/tools/meta_optimize_placements/execute": {
      "post": {
        "operationId": "meta_optimize_placements",
        "summary": "Find Meta placements that are not earning their spend",
        "description": "Breaks spend and results down by placement (platform and position) and says which placements cost far more per result than the account average.\nUse when: the user suspects one surface is wasting money, or before deciding whether to leave Advantage+ placements on.\nDo not treat a recommendation as a decision. Restricting placements shrinks the auction Meta can buy in, so costs on the remaining placements usually rise — say that whenever you report an exclusion.\nDo not exclude a placement on a few days of data or on a placement with a small share of spend; the verdicts already stay neutral there.\nReturns the placement table, a verdict per row, and the exact publisher_platforms list to pass to meta_update_ad_set if the user agrees. It writes nothing itself.\nIf everything is close to average, the right answer is to change nothing.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Is Audience Network wasting money on this campaign?",
          "Which placements give the cheapest results?",
          "Should I turn off Stories?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
