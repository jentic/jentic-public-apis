    "/api/v1/tools/google_get_asset_performance/execute": {
      "post": {
        "operationId": "google_get_asset_performance",
        "summary": "Per-asset performance labels (BEST / GOOD / LOW)",
        "description": "Returns Google's per-asset performance labels for responsive search ads — BEST, GOOD, LOW, LEARNING or PENDING — for each headline and description, with the impressions behind them.\nUse when: the user wants to improve an existing ad and needs to know which parts to replace.\nDo not use when: the ad is new. Assets stay LEARNING until Google has served them enough, and replacing a LEARNING asset restarts that clock for nothing.\nThe labels are relative to the other assets in the same ad, not absolute quality: in a strong ad, some asset still has to be LOW. Replace LOW assets with genuinely different ideas rather than reworded versions of the BEST one, or the next report says the same thing.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
