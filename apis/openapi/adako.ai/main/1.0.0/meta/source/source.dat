    "/api/v1/tools/linkedin_analyze_creative_performance/execute": {
      "post": {
        "operationId": "linkedin_analyze_creative_performance",
        "summary": "Rank LinkedIn creatives (ads) and flag fatigue",
        "description": "Ranks the creatives (ads in Campaign Manager) of one campaign (ad set) against each other on CTR and cost per lead, and flags the ones whose CTR fell sharply in the second half of the window — the signature of creative fatigue on LinkedIn's small, repeatedly-reached audiences.\nUse when: deciding which ad to keep, which to refresh, and which to leave alone. It is the read to run before linkedin_pause_creative.\nDo not act on a creative marked \"too_early\": under 1,000 impressions the numbers are noise, and pausing it destroys the test. Do not treat fatigue as a reason to cut spend — on LinkedIn it means the same people have seen the ad too often, and a new creative into the same audience is usually the fix.\nDo not use it to compare campaigns; that is linkedin_get_campaign_performance.\nReturns a verdict per creative (winner / steady / underperforming / fatiguing / too_early) with the number behind it, plus the campaign average it was judged against.\nIf every creative is \"too_early\", say the campaign needs more time and recommend nothing.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "which LinkedIn creative should I pause?",
          "are my LinkedIn ads wearing out?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign whose creatives to rank. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "limit": {
                        "description": "Maximum rows to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
