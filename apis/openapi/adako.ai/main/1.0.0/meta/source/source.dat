    "/api/v1/tools/google_pause_ad/execute": {
      "post": {
        "operationId": "google_pause_ad",
        "summary": "Pause one ad",
        "description": "Stops one ad from serving, leaving the rest of the ad group running.\nUse when: the ad is clearly the worst performer over a meaningful number of impressions, and the user has agreed.\nDo not use when: it is the only enabled ad in the ad group — the ad group then shows nothing and the keywords stop getting traffic. Check google_get_ad_performance first and say what will be left.\nNothing is deleted; google_resume_ad puts it back. Responsive search ads need a few weeks to be judged fairly, so pausing after a couple of days usually just resets learning.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Pause the losing ad in ad group 456",
          "Turn off ad 999"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
