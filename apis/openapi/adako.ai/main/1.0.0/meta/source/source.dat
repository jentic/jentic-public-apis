                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "form_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The lead form to read, from meta_list_lead_forms."
                      },
                      "limit": {
                        "description": "Maximum leads to fetch (default 100). Meta pages them in blocks of 100.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "since": {
                        "description": "Only leads created on or after this date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
