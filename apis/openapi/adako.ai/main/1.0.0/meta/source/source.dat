    "/api/v1/tools/google_remove_label/execute": {
      "post": {
        "operationId": "google_remove_label",
        "summary": "Take a label off campaigns or ad groups",
        "description": "Removes the link between a label and the campaigns or ad groups you list. The label itself is **not** deleted — it stays in the account and can be applied again.\nUse when: the user has said which campaigns or ad groups should stop carrying the label.\nDo not use when: the user wants the label gone from the account entirely. Adako does not delete labels: that has to be done in the Google Ads UI, because a deleted label disappears from every saved report that filtered on it.\nRequires confirm_delete: true. Items that do not carry the label are reported back rather than silently ignored.\nRemoving a label changes nothing about delivery, bids or spend.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
