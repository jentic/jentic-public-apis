                        "type": "string"
                      },
                      "ad_group_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Ad group id as returned by google_get_campaign_structure."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
