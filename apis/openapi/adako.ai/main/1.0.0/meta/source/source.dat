    "/api/v1/tools/google_set_business_name/execute": {
      "post": {
        "operationId": "google_set_business_name",
        "summary": "Set the business name asset",
        "description": "Creates a text asset holding the business name and links it as the BUSINESS_NAME asset of a campaign (or of the account).\nUse when: you are building a Performance Max campaign, or a campaign is missing its business name.\nDo not use when: the campaign already has one — Google allows a single business name per campaign and a second link is rejected. Check google_list_assets first.\nA business name is linked to a campaign or to the whole account; Google has no ad-group-level business name, so passing ad_group_id is refused with that explanation instead of failing at Google.\nGoogle requires advertiser verification on the account before a business name asset can be used; without it the call comes back CUSTOMER_NOT_VERIFIED. That is the account's state, not the arguments: tell the user to finish verification in Google Ads and do not retry with different text.\nThe name is 25 characters or fewer and should be the business as customers know it, not a slogan. An identical name already linked at the same level is skipped.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Set the business name to Acme Tools",
          "Add our brand name to the PMax campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Attach at campaign level. Leave out to attach to the whole account.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "ad_group_id": {
                        "description": "Not usable for a business name: Google links one only to a campaign or to the whole account. Leave it out.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "business_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 25,
                        "description": "The business name as customers know it, 25 characters or fewer (Chinese, Japanese and Korean characters count as 2)."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "business_name"
                    ]
                  }
                },
                "required": [
                  "arguments"
