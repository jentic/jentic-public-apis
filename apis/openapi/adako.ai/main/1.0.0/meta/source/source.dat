    "/api/v1/tools/meta_list_media/execute": {
      "post": {
        "operationId": "meta_list_media",
        "summary": "List the images and videos already in a Meta ad account",
        "description": "Lists the images and videos that already exist in the ad account's library, with the image hash or video id an ad is built from.\nUse when: the user says the file is \"already in the account\", asks to reuse a creative from an earlier ad, or has a file but no public link — uploading it once in Ads Manager and reusing it here needs no hosting anywhere.\nDo not use to check a file the user has only as a link; that is check_media, which is free.\nReturns each image's hash, name and pixel size, and each video's id, title and length. Those ids go straight into the create tools as image_hash or video_id, and skip the upload entirely.\nIf the library is empty, say so and offer the two other ways in: a public link to the file, or an upload in Ads Manager first.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Use the image from our last campaign",
          "What creatives are already in the account?",
          "I uploaded the video in Ads Manager — can you find it?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
