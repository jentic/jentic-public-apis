    "/api/v1/tools/google_add_callouts/execute": {
      "post": {
        "operationId": "google_add_callouts",
        "summary": "Add callout extensions",
        "description": "Creates callout assets — short, non-clickable phrases such as \"Free shipping\" or \"Cancel anytime\" — and links them to the account, a campaign or an ad group.\nUse when: the user has given the phrases, or approved ones you proposed.\nDo not use when: the phrase is a claim the business cannot back up, contains a phone number or a URL, or repeats a headline — Google disapproves those.\nEach callout is 25 characters or fewer. Google shows at least two at a time, so four or more is the useful minimum. Identical callouts already linked at the same level are skipped.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add callouts: free shipping, 24/7 support, no setup fee",
          "Put our callouts on campaign 123"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "description": "Attach at campaign level. Leave out to attach to the whole account.",
