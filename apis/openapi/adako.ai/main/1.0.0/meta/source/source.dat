    "/api/v1/tools/linkedin_search_targeting/execute": {
      "post": {
        "operationId": "linkedin_search_targeting",
        "summary": "Resolve LinkedIn targeting entities",
        "description": "Turns plain words into the LinkedIn targeting URNs a campaign actually accepts — job titles, industries, seniorities, company-size bands, locations, skills, interests, member behaviours, employers, degrees, fields of study and interface locales.\nUse when: before every create or update that touches targeting, without exception. A campaign payload takes URNs and nothing else, and there is no fuzzy match on the write path: an invented URN either errors or targets strangers.\nDo not guess a URN, reuse one from a demographic report (those are report labels), or copy one between accounts without checking it here first. Do not pass a user's phrase straight into a create tool — that is what this tool exists to prevent.\nReturns matching entities with their URN and display name — a location's name already carries its parents (\"Sacramento, California, United States\"). Seniorities, staffCountRanges and interfaceLocales are short fixed lists: when nothing matches the query, the whole list comes back for the user to choose from. interfaceLocales is the language members use LinkedIn in (one locale per language, e.g. urn:li:locale:en_US for all English), never a country. Costs nothing, so run it as many times as the audience needs facets.\nIf a search returns nothing, try a shorter or more common phrasing (LinkedIn matches on its own canonical titles), and if it still fails tell the user that facet cannot be targeted rather than substituting something close.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "find the LinkedIn targeting entity for \"VP of Marketing\"",
          "what is the URN for the software industry on LinkedIn?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "facet": {
                        "type": "string",
                        "enum": [
                          "locations",
                          "titles",
                          "industries",
                          "seniorities",
                          "staffCountRanges",
                          "skills",
                          "interests",
                          "memberBehaviors",
                          "employers",
                          "degrees",
                          "fieldsOfStudy",
                          "interfaceLocales"
                        ],
                        "description": "Which targeting dimension to search: locations (always required on a campaign), titles, industries, seniorities, staffCountRanges, skills, interests, memberBehaviors, employers, degrees, fieldsOfStudy or interfaceLocales."
                      },
                      "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "What to search for, in the user's own words (\"marketing manager\", \"Berlin\", \"software\")."
                      },
                      "limit": {
                        "description": "Maximum rows to return (default 100).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "facet",
                      "query"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
