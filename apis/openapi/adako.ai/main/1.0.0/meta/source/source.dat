    "/api/v1/tools/tiktok_explain_objective/execute": {
      "post": {
        "operationId": "tiktok_explain_objective",
        "summary": "Explain TikTok objectives and what each one needs",
        "description": "Explains what each TikTok campaign objective buys, which optimisation goals and billing events it allows, what it requires before it can be created, and what Adako can build end to end.\nUse when: the user describes a goal in their own words (\"I want sales\", \"I want followers\") and a campaign has to be chosen, or before any create so the objective, goal and billing event are a valid combination rather than a guess.\nDo not skip it before tiktok_create_video_campaign. An invalid combination is rejected by TikTok with a numeric code and no explanation; this tool is what prevents that round trip.\nDo not promise conversion optimisation without a pixel. WEB_CONVERSIONS requires a pixel id and a specific event, and a pixel with too few recent events will not leave the learning phase however high the budget goes — check tiktok_list_pixels first.\nReturns, per objective: what it is for, its valid goal/billing pairs, what it requires, and the minimum daily budget in the account's currency. Retired goal names (VIDEO_VIEW, PROFILE_VISIT) are not listed; a create that still sends one is moved to its replacement and the preview says so. Costs nothing.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Which TikTok objective should I use to get sales?",
          "What does WEB_CONVERSIONS need on TikTok?",
          "Can I optimise for conversions without a pixel on TikTok?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "objective": {
                        "description": "Explain just this one. Omit to get the full matrix.",
                        "type": "string",
                        "enum": [
                          "REACH",
                          "TRAFFIC",
                          "VIDEO_VIEWS",
                          "ENGAGEMENT",
                          "LEAD_GENERATION",
                          "WEB_CONVERSIONS",
                          "APP_PROMOTION",
                          "PRODUCT_SALES"
                        ]
                      },
                      "goal": {
                        "description": "What the user said they want, in their words. Used only to point at the likely objectives.",
                        "type": "string",
