    "/api/v1/tools/meta_get_adset_performance/execute": {
      "post": {
        "operationId": "meta_get_adset_performance",
        "summary": "Meta ad set performance",
        "description": "Ad-set level results with the objective's own KPI and a previous-period comparison, optionally split by a breakdown (age and gender, publisher platform and position, device, or country).\nUse when: one campaign is under- or over-performing and you need to know which audience or placement is responsible.\nDo not use with a breakdown to judge overall performance — breakdown rows do not sum to the campaign total for every metric, and some metrics are unavailable when a breakdown is applied.\nReturns each ad set's spend, results, cost per result and ROAS where the objective supports it.\nIf the user asks \"why is this campaign expensive\", run this with the placement breakdown before recommending anything.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "performance",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Which ad set is performing best?",
          "Break the campaign down by ad set for the last 14 days"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
