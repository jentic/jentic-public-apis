    "/api/v1/tools/list_scheduled_tasks/execute": {
      "post": {
        "operationId": "list_scheduled_tasks",
        "summary": "List scheduled briefs, reports and monitors",
        "description": "Lists everything Adako runs on its own for this user: recurring briefs and reports with their cadence, address and next run, and the monitors that judge an account once a day. Free; reads Adako's database only.\nUse when: the user asks what they are subscribed to, what is being watched, or before scheduling or creating another one.\nDo not use when: the user wants the day-by-day record of one monitor — that is get_monitor_history — or the reports already composed, which is list_reports.\ninclude narrows the list: all (the default: briefs and monitors), briefs, monitors. Leaving it out lists both.\nReturns ids for manage_scheduled_task, which pauses, resumes or deletes either kind, and the same monitor ids update_monitor and delete_monitor take.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "reporting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What reports am I getting by email?",
          "List my scheduled briefs",
          "What runs on a schedule, emails and monitors both?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
