    "/api/v1/tools/tiktok_list_identities/execute": {
      "post": {
        "operationId": "tiktok_list_identities",
        "summary": "List TikTok identities the ads can post as",
        "description": "Lists the identities this advertiser can run ads as — the handle and avatar a viewer sees on the ad — including the custom identities created in Ads Manager and any TikTok accounts authorised through Business Center.\nUse when: creating any ad, and always before a Spark Ad. A Spark Ad runs as the account that posted the original video, so it needs that account's identity id and its permission; without both, the create fails.\nDo not pick an identity for the user when several exist. Which account an ad appears as is a brand decision and a legal one — ask.\nReturns can_push_video, which is what distinguishes an identity that can carry a real TikTok post from a display-only custom identity, and the Business Center id a BC_AUTH_TT identity needs passed as identity_authorized_bc_id. TikTok no longer accepts new ads that post as a custom identity (CUSTOMIZED_USER) on placements that include TikTok, so offer a TikTok account identity.\nCosts nothing, and the answer rarely changes, so read it once per launch rather than per ad.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
