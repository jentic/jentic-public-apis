    "/api/v1/tools/google_add_image_assets/execute": {
      "post": {
        "operationId": "google_add_image_assets",
        "summary": "Upload image assets from URLs",
        "description": "Downloads images from https URLs, checks them against Google's rules (PNG/JPEG/static GIF, at most 5120 KB, the aspect ratio and minimum size of the slot they are for) and uploads the ones that pass as image assets.\nUse when: the user gave you image URLs and you are about to build a Performance Max asset group or add image extensions.\nDo not use when: you have not seen the images pass google_validate_and_prepare_assets and the user has not confirmed which slot each one is for — an image in the wrong slot is rejected by Google with an unhelpful error.\nNothing is uploaded unless every image passes: a half-uploaded set is harder to clean up than a refusal. Google silently drops a new name for an image whose bytes already exist, so re-uploading the same file is safe but keeps the original name.\nThe upload creates assets in the account library; it does not link them to anything. Link them with google_add_sitelinks-style tools or by building an asset group.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Upload these three images as assets",
          "Add our logo and a landscape image to the account"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "images": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "description": "The image file (PNG, JPEG or static GIF). Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "description": "A name for the asset library, e.g. \"Spring sale — square\"."
                            },
                            "field_type": {
                              "type": "string",
                              "enum": [
                                "MARKETING_IMAGE",
                                "SQUARE_MARKETING_IMAGE",
                                "PORTRAIT_MARKETING_IMAGE",
                                "LOGO",
                                "LANDSCAPE_LOGO"
                              ],
                              "description": "Which slot the image fills. Each slot has its own aspect ratio; the tool checks it before uploading."
                            }
                          },
                          "required": [
                            "url",
                            "name",
                            "field_type"
                          ]
                        },
                        "description": "The images to upload."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "images"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
