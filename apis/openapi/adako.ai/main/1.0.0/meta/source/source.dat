    "/api/v1/tools/chatgpt_create_ad/execute": {
      "post": {
        "operationId": "chatgpt_create_ad",
        "summary": "Create a ChatGPT Ads chat card ad",
        "description": "Adds one paused chat card ad to an ad group that already exists: the image is downloaded, checked and uploaded, then the ad is created. Nothing delivers and nothing spends until the user resumes it.\nUse when: the user wants another creative in a structure they already have — a second headline to test, a replacement for a rejected ad. Get the ad group id from chatgpt_list_ad_groups.\nDo not use it to build a campaign from nothing: that is chatgpt_launch_ad. Do not invent copy, a destination or an image the user did not give; if any of the four is missing, ask.\nThe limits are hard and checked before anything is created, so a rejection here costs nothing: the title must be 3–50 characters, the body at most 100, the destination an https URL, and the image square. Run chatgpt_validate_chat_card first if you want to check copy for free.\nReturns the new ad id, read back from the platform with its paused state and its review verdict. A new ad always starts in review; it delivers nothing until the platform approves it, so do not tell the user it is live until chatgpt_list_ads says approved.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a second ad to ad group adg_01 with this headline and image",
          "Create another chat card in my autumn ad group to test different copy"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "ad_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "The ad group to add the ad to, from chatgpt_list_ad_groups."
                      },
                      "title": {
                        "type": "string",
                        "description": "Chat card headline, 3–50 characters. This is the line people read first."
                      },
                      "body": {
                        "type": "string",
                        "description": "Chat card body copy, at most 100 characters. Put the offer in the first half."
                      },
                      "target_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where a click goes. Must be https and reachable without a login."
                      },
                      "image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The card image. It must be square; its bytes are checked here before anything is created. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "name": {
                        "description": "Ad name in Ads Manager. Defaults to the headline.",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_group_id",
                      "title",
                      "body",
                      "target_url",
                      "image_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
