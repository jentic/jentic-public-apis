                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_create_app_install_campaign/execute": {
      "post": {
        "operationId": "meta_create_app_install_campaign",
        "summary": "Create a paused Meta app-install campaign",
        "description": "Builds a complete app-install campaign: campaign, one ad set pointed at the right operating system, the image upload, the creative and one ad. The campaign is created PAUSED and its ad set and ad ACTIVE inside it, so nothing spends until the campaign is turned on, and turning it on launches the ad. Say that the campaign is paused when you report the result, with the two links the result gives (Ads Manager and the campaign's page in Adako), and offer \"enable all\": one meta_resume_entity call on the campaign, listed in the result as go_live.enable_all, one approval.\nUse when: the user wants installs for an app that is already registered to their business — get the application_id and store URL from meta_list_promotable_apps first.\nDo not use for a website or a lead form; that is meta_create_image_campaign. One campaign promotes one app on one operating system, because the store URL decides the OS.\nDo not pass free text for locations or interests; use meta_search_targeting.\nReturns the new ids and reads the statuses back so you can confirm the campaign is paused (the ad set and ad read ACTIVE, held by the campaign).\niOS install reporting is limited by Apple's tracking rules unless the app uses the Meta SDK with SKAdNetwork — say so when reporting iOS results rather than treating low numbers as poor performance.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Create an app install campaign for our iOS app",
          "Launch a paused Meta campaign driving installs from Google Play"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name shown in Ads Manager."
                      },
                      "application_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The app to promote, from meta_list_promotable_apps."
                      },
                      "object_store_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The store listing URL. apps.apple.com means an iOS campaign, play.google.com an Android one — the tool targets the matching operating system automatically."
                      },
                      "daily_budget": {
                        "description": "Daily budget as a decimal in the account currency (25 means 25 dollars, not 2500 cents). One of daily_budget or lifetime_budget is required.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "Total budget for the whole flight, decimal in the account currency. Requires end_time.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_level": {
                        "description": "Which level holds the budget. \"ad_set\" (the default) gives this ad set its own budget, so every ad set is funded separately. \"campaign\" is Meta's campaign budget optimisation (Advantage campaign budget): the campaign holds one budget and Meta decides how much each ad set gets — ad sets added later must then carry no budget of their own. Only \"campaign\" can be edited with meta_update_campaign_budget.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "campaign"
                        ]
                      },
                      "start_time": {
                        "description": "When delivery may start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset, e.g. 2026-10-01T09:00:00+02:00. Not in the past; today or omitted means as soon as the user activates it.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "When delivery must stop: YYYY-MM-DD (runs to 23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset. Required with lifetime_budget.",
                        "type": "string"
                      },
                      "optimization_goal": {
                        "description": "Override what the ad set optimises for. Leave empty to use the objective default. LEAD_GENERATION (instant forms) is not supported; PAGE_LIKES promotes the Page.",
                        "type": "string"
                      },
                      "billing_event": {
                        "description": "What Meta charges for. Leave empty to use IMPRESSIONS.",
                        "type": "string"
                      },
                      "countries": {
                        "description": "ISO 3166-1 two-letter country codes from meta_search_targeting: GB, not UK; GR, not EL.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "region_keys": {
                        "description": "Region keys from meta_search_targeting (never region names). Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "city_keys": {
                        "description": "City keys from meta_search_targeting (never city names, postcodes or media markets). Each city is targeted with a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "Youngest age to target. Minimum 18.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "Oldest age to target. 65 means 65 and over.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "Restrict by gender. Defaults to all — narrow only when the user asks.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "interest_ids": {
                        "description": "Interest ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "behavior_ids": {
                        "description": "Behaviour ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "custom_audience_ids": {
                        "description": "Custom audience ids from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excluded_custom_audience_ids": {
                        "description": "Custom audiences to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "advantage_audience": {
                        "description": "Let Meta deliver beyond the listed interests. Defaults to off so the targeting the user asked for is the targeting they get.",
                        "type": "boolean"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one, including territories such as Réunion.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "ad_set_name": {
                        "description": "Ad set name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "ad_name": {
                        "description": "Ad name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the ad runs from, from meta_list_pages."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the ad from."
                      },
                      "image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The image the app-install ad will show. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "primary_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200,
                        "description": "Main ad copy."
                      },
                      "headline": {
                        "description": "Headline under the image.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "description": {
                        "description": "Description line.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "call_to_action": {
                        "description": "Button label. Defaults to INSTALL_MOBILE_APP.",
                        "type": "string",
                        "enum": [
                          "INSTALL_MOBILE_APP",
                          "USE_APP",
                          "PLAY_GAME",
                          "SHOP_NOW",
                          "BOOK_NOW",
                          "DOWNLOAD"
                        ]
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_name",
                      "application_id",
                      "object_store_url",
                      "image_url",
                      "primary_text"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_create_carousel_campaign/execute": {
      "post": {
        "operationId": "meta_create_carousel_campaign",
        "summary": "Create a paused Meta carousel campaign",
        "description": "Builds a complete carousel campaign: campaign, one ad set, one image upload per card, the creative and one ad. The campaign is created PAUSED and its ad set and ad ACTIVE inside it, so nothing spends until the campaign is turned on, and turning it on launches the ad. Say that the campaign is paused when you report the result, with the two links the result gives (Ads Manager and the campaign's page in Adako), and offer \"enable all\": one meta_resume_entity call on the campaign, listed in the result as go_live.enable_all, one approval.\nUse when: the user has two to ten distinct images (products, features, steps) with their own headlines and, optionally, their own links.\nDo not use for a single image — that is meta_create_image_campaign — and do not use it to add a carousel to an existing campaign, which is meta_add_ad.\nDo not invent card headlines or duplicate an image to reach a card count: ask the user for the real ones.\nReturns every new id, including one image hash per card, and reads the statuses back so you can confirm the campaign is paused (the ad set and ad read ACTIVE, held by the campaign).\nCard order matters unless optimize_card_order is on; say which you used when you report back.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Create a carousel campaign with these five products",
          "Launch a paused Meta carousel showing our three bestsellers"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name shown in Ads Manager."
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "OUTCOME_AWARENESS",
                          "OUTCOME_TRAFFIC",
                          "OUTCOME_ENGAGEMENT",
                          "OUTCOME_LEADS",
                          "OUTCOME_SALES",
                          "OUTCOME_APP_PROMOTION"
                        ],
                        "description": "What Meta optimises for. OUTCOME_SALES and OUTCOME_LEADS need a pixel. OUTCOME_APP_PROMOTION is refused here: use meta_create_app_install_campaign."
                      },
                      "daily_budget": {
                        "description": "Daily budget as a decimal in the account currency (25 means 25 dollars, not 2500 cents). One of daily_budget or lifetime_budget is required.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "Total budget for the whole flight, decimal in the account currency. Requires end_time.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_level": {
                        "description": "Which level holds the budget. \"ad_set\" (the default) gives this ad set its own budget, so every ad set is funded separately. \"campaign\" is Meta's campaign budget optimisation (Advantage campaign budget): the campaign holds one budget and Meta decides how much each ad set gets — ad sets added later must then carry no budget of their own. Only \"campaign\" can be edited with meta_update_campaign_budget.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "campaign"
                        ]
                      },
                      "start_time": {
                        "description": "When delivery may start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset, e.g. 2026-10-01T09:00:00+02:00. Not in the past; today or omitted means as soon as the user activates it.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "When delivery must stop: YYYY-MM-DD (runs to 23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset. Required with lifetime_budget.",
                        "type": "string"
                      },
                      "optimization_goal": {
                        "description": "Override what the ad set optimises for. Leave empty to use the objective default. LEAD_GENERATION (instant forms) is not supported; PAGE_LIKES promotes the Page.",
                        "type": "string"
                      },
                      "billing_event": {
                        "description": "What Meta charges for. Leave empty to use IMPRESSIONS.",
                        "type": "string"
                      },
                      "countries": {
                        "description": "ISO 3166-1 two-letter country codes from meta_search_targeting: GB, not UK; GR, not EL.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "region_keys": {
                        "description": "Region keys from meta_search_targeting (never region names). Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "city_keys": {
                        "description": "City keys from meta_search_targeting (never city names, postcodes or media markets). Each city is targeted with a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "Youngest age to target. Minimum 18.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "Oldest age to target. 65 means 65 and over.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "Restrict by gender. Defaults to all — narrow only when the user asks.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "interest_ids": {
                        "description": "Interest ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "behavior_ids": {
                        "description": "Behaviour ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "custom_audience_ids": {
                        "description": "Custom audience ids from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excluded_custom_audience_ids": {
                        "description": "Custom audiences to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "advantage_audience": {
                        "description": "Let Meta deliver beyond the listed interests. Defaults to off so the targeting the user asked for is the targeting they get.",
                        "type": "boolean"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one, including territories such as Réunion.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "ad_set_name": {
                        "description": "Ad set name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "ad_name": {
                        "description": "Ad name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel that records the conversion; from meta_list_pixels."
                      },
                      "conversion_event": {
                        "description": "The pixel event to optimise for. Defaults to PURCHASE for sales, LEAD for leads.",
                        "type": "string",
                        "enum": [
                          "PURCHASE",
                          "LEAD",
                          "COMPLETE_REGISTRATION",
                          "ADD_TO_CART",
                          "INITIATED_CHECKOUT",
                          "ADD_PAYMENT_INFO",
                          "SUBSCRIBE",
                          "START_TRIAL",
                          "SUBMIT_APPLICATION",
                          "CONTACT",
                          "SCHEDULE",
                          "SEARCH",
                          "CONTENT_VIEW",
                          "DONATE",
                          "FIND_LOCATION"
                        ]
                      },
                      "special_ad_categories": {
                        "description": "Declare a restricted category. Leave empty unless the ad genuinely falls into one. CREDIT is sent as FINANCIAL_PRODUCTS_SERVICES, which replaced it. Housing, employment and financial products keep the audience at ages 18–65+, all genders, no behaviours and no lookalikes. Political ads (ISSUES_ELECTIONS_POLITICS) cannot be created here.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "EMPLOYMENT",
                            "HOUSING",
                            "CREDIT",
                            "ISSUES_ELECTIONS_POLITICS",
                            "ONLINE_GAMBLING_AND_GAMING",
                            "FINANCIAL_PRODUCTS_SERVICES"
                          ]
                        }
                      },
                      "special_ad_category_country": {
                        "description": "Countries the special ad category ads run in (ISO two-letter codes). Meta requires it with any special_ad_categories; omit it to use the targeted countries.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the ad runs from, from meta_list_pages."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the ad from, from meta_list_instagram_accounts."
                      },
                      "cards": {
                        "minItems": 2,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "The image for this card. Square (1080×1080) works on every placement. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                            },
                            "headline": {
                              "description": "Card headline. About 32 characters show under the image.",
                              "type": "string",
                              "maxLength": 255
                            },
                            "description": {
                              "description": "Card description, shown under the headline.",
                              "type": "string",
                              "maxLength": 255
                            },
                            "link": {
                              "description": "Where this card sends people. Defaults to landing_page_url.",
                              "type": "string",
                              "format": "uri"
                            }
                          },
                          "required": [
                            "image_url"
                          ]
                        },
                        "description": "Between 2 and 10 cards, in the order people should swipe through them. Each card needs its own image; repeating one is rejected."
                      },
                      "primary_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200,
                        "description": "Copy above the carousel. The same text is shown for every card."
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Default destination, used for any card without its own link."
                      },
                      "call_to_action": {
                        "description": "Button label on every card. Defaults to LEARN_MORE.",
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "SUBSCRIBE",
                          "DOWNLOAD",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "GET_OFFER",
                          "ORDER_NOW",
                          "SEE_MORE",
                          "GET_STARTED",
                          "BUY_NOW",
                          "DONATE_NOW",
                          "NO_BUTTON"
                        ]
                      },
                      "optimize_card_order": {
                        "description": "Let Meta reorder the cards by performance. Turn it off when the cards tell a story in sequence.",
                        "type": "boolean"
                      },
                      "show_end_card": {
                        "description": "Show the Page profile card at the end. Defaults to on.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_name",
                      "objective",
                      "cards",
                      "primary_text",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_create_flexible_ad/execute": {
      "post": {
        "operationId": "meta_create_flexible_ad",
        "summary": "Create a paused flexible (dynamic creative) Meta ad",
        "description": "Creates one ad that carries several primary texts, headlines, descriptions and images; Meta assembles the combinations and learns which one works per person. The ad is created PAUSED inside an ad set that already exists.\nUse when: the user wants to test creative variants inside one audience, and the ad set is already set up. Get the ad set id from meta_list_ad_sets.\nDo not use to create a campaign — meta_create_image_campaign, meta_create_video_campaign and meta_create_carousel_campaign do that. Do not use it to run a clean A/B test where each variant needs its own reporting: Meta reports the ad, not the combination, so per-variant numbers are limited.\nDo not pad the lists with near-identical wording. Fewer, genuinely different assets learn faster.\nReturns the new ad and creative ids, the uploaded image hashes and how many combinations Meta can build.\nIf the user has not said which ad set, ask — this tool never creates one.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 2,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Test five headlines and three images in one Meta ad",
          "Create a dynamic creative ad in this ad set with these copy variants"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The existing ad set the flexible ad goes into, from meta_list_ad_sets."
                      },
                      "ad_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name for the new ad, shown in Ads Manager."
                      },
                      "primary_texts": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2200
                        },
                        "description": "Up to 5 genuinely different versions of the main copy. Meta picks per person; near-duplicates waste the test."
                      },
                      "headlines": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "description": "Up to 5 headlines. About 40 characters show."
                      },
                      "descriptions": {
                        "description": "Optional description lines, shown on some placements only.",
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        }
                      },
                      "image_urls": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "description": "Up to 10 images for Meta to combine with the texts. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where every combination sends people."
                      },
                      "call_to_action": {
                        "description": "Button label used by every combination. Defaults to LEARN_MORE.",
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "SUBSCRIBE",
                          "DOWNLOAD",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "GET_OFFER",
                          "ORDER_NOW",
                          "SEE_MORE",
                          "GET_STARTED",
                          "BUY_NOW",
                          "DONATE_NOW",
                          "NO_BUTTON"
                        ]
                      },
                      "url_tags": {
                        "description": "Tracking parameters appended to the destination, e.g. utm_source=facebook&utm_medium=paid.",
                        "type": "string",
                        "maxLength": 1000
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the ad runs from, from meta_list_pages."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the ad from."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_set_id",
                      "ad_name",
                      "primary_texts",
                      "headlines",
                      "image_urls",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_create_image_campaign/execute": {
      "post": {
        "operationId": "meta_create_image_campaign",
        "summary": "Create a paused Meta image campaign",
        "description": "Builds a complete single-image campaign: campaign, one ad set, the image upload, the creative and one ad. The campaign is created PAUSED and its ad set and ad ACTIVE inside it, so nothing spends until the campaign is turned on, and turning it on launches the ad. Say that the campaign is paused when you report the result, with the two links the result gives (Ads Manager and the campaign's page in Adako), and offer \"enable all\": one meta_resume_entity call on the campaign, listed in the result as go_live.enable_all, one approval.\nUse when: the user has agreed on objective, budget, audience, image and copy. Gather those first — resolve locations and interests with meta_search_targeting, the Page with meta_list_pages, the pixel with meta_list_pixels, and check the image with meta_validate_creative_url.\nDo not use to add another ad or audience to something that already exists; this always creates a new campaign, and calling it twice for the same brief creates two campaigns that both spend.\nDo not pass free text for locations or interests — only ids from the resolver tools are accepted.\nReturns the four new ids and reads the statuses back so you can confirm the campaign is paused (the ad set and ad read ACTIVE, held by the campaign).\nRefuses to start when: the account has no promotable Page; the account has several Pages and none was chosen; a sales or leads objective has no pixel; a country code is not ISO or a region or city key is unknown to Meta; the targeting reaches the EU/EEA without dsa_beneficiary and dsa_payor; a date is in the past or a timestamp has no UTC offset; the budget is below Meta's minimum for this account; the objective is app promotion or the goal is an instant form; a special ad category is combined with targeting Meta forbids for it; or image_url does not answer with a JPEG, PNG or GIF file under 30 MB. Ask the user for the missing piece rather than substituting a value.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Create a paused Meta campaign with this image",
          "Launch a traffic campaign for 20 a day"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name shown in Ads Manager. Say what it sells and to whom."
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "OUTCOME_AWARENESS",
                          "OUTCOME_TRAFFIC",
                          "OUTCOME_ENGAGEMENT",
                          "OUTCOME_LEADS",
                          "OUTCOME_SALES",
                          "OUTCOME_APP_PROMOTION"
                        ],
                        "description": "What Meta should optimise the campaign for. OUTCOME_SALES and OUTCOME_LEADS need a pixel; OUTCOME_TRAFFIC, OUTCOME_ENGAGEMENT and OUTCOME_AWARENESS do not. OUTCOME_APP_PROMOTION is refused here: use meta_create_app_install_campaign."
                      },
                      "daily_budget": {
                        "description": "Daily budget as a decimal in the account currency (25 means 25 dollars, not 2500 cents). One of daily_budget or lifetime_budget is required.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "Total budget for the whole flight, decimal in the account currency. Requires end_time.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_level": {
                        "description": "Which level holds the budget. \"ad_set\" (the default) gives this ad set its own budget, so every ad set is funded separately. \"campaign\" is Meta's campaign budget optimisation (Advantage campaign budget): the campaign holds one budget and Meta decides how much each ad set gets — ad sets added later must then carry no budget of their own. Only \"campaign\" can be edited with meta_update_campaign_budget.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "campaign"
                        ]
                      },
                      "start_time": {
                        "description": "When delivery may start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset, e.g. 2026-10-01T09:00:00+02:00. Not in the past; today or omitted means as soon as the user activates it.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "When delivery must stop: YYYY-MM-DD (runs to 23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset. Required with lifetime_budget.",
                        "type": "string"
                      },
                      "optimization_goal": {
                        "description": "Override what the ad set optimises for. Leave empty to use the objective default. LEAD_GENERATION (instant forms) is not supported; PAGE_LIKES promotes the Page.",
                        "type": "string"
                      },
                      "billing_event": {
                        "description": "What Meta charges for. Leave empty to use IMPRESSIONS.",
                        "type": "string"
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel that records the conversion. Required for sales and leads objectives; get it from meta_list_pixels."
                      },
                      "conversion_event": {
                        "description": "The pixel event to optimise for. Defaults to PURCHASE for sales, LEAD for leads.",
                        "type": "string",
                        "enum": [
                          "PURCHASE",
                          "LEAD",
                          "COMPLETE_REGISTRATION",
                          "ADD_TO_CART",
                          "INITIATED_CHECKOUT",
                          "ADD_PAYMENT_INFO",
                          "SUBSCRIBE",
                          "START_TRIAL",
                          "SUBMIT_APPLICATION",
                          "CONTACT",
                          "SCHEDULE",
                          "SEARCH",
                          "CONTENT_VIEW",
                          "DONATE",
                          "FIND_LOCATION"
                        ]
                      },
                      "countries": {
                        "description": "ISO 3166-1 two-letter country codes from meta_search_targeting: GB, not UK; GR, not EL.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "region_keys": {
                        "description": "Region keys from meta_search_targeting (never region names). Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "city_keys": {
                        "description": "City keys from meta_search_targeting (never city names, postcodes or media markets). Each city is targeted with a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "Youngest age to target. Minimum 18.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "Oldest age to target. 65 means 65 and over.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "Restrict by gender. Defaults to all — narrow only when the user asks.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "interest_ids": {
                        "description": "Interest ids from meta_search_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "behavior_ids": {
                        "description": "Behaviour ids from meta_search_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "custom_audience_ids": {
                        "description": "Custom audience ids from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excluded_custom_audience_ids": {
                        "description": "Custom audiences to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "advantage_audience": {
                        "description": "Let Meta deliver beyond the listed interests. Defaults to off so the targeting the user asked for is the targeting they get.",
                        "type": "boolean"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one, including territories such as Réunion.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "special_ad_categories": {
                        "description": "Declare a restricted category (housing, employment, credit, politics, gambling, financial products). Leave empty unless the ad genuinely falls into one — a wrong declaration limits delivery, a missing one breaks Meta policy. CREDIT is sent as FINANCIAL_PRODUCTS_SERVICES, which replaced it. Housing, employment and financial products keep the audience at ages 18–65+, all genders, no behaviours and no lookalikes. Political ads (ISSUES_ELECTIONS_POLITICS) cannot be created here.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "EMPLOYMENT",
                            "HOUSING",
                            "CREDIT",
                            "ISSUES_ELECTIONS_POLITICS",
                            "ONLINE_GAMBLING_AND_GAMING",
                            "FINANCIAL_PRODUCTS_SERVICES"
                          ]
                        }
                      },
                      "special_ad_category_country": {
                        "description": "Countries the special ad category ads run in (ISO two-letter codes). Meta requires it with any special_ad_categories; omit it to use the targeted countries.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the ad runs from, from meta_list_pages. Required when the account has more than one Page."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the ad from, from meta_list_pages."
                      },
                      "image_url": {
                        "description": "The image the ad will show, as a link to the file itself. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "image_hash": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 200,
                        "description": "An image already in the account library, from meta_list_media (its `image_hash`). Pass this instead of image_url when the file is already in the account — nothing is downloaded or uploaded, so it works for a file that has no public link at all."
                      },
                      "primary_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200,
                        "description": "Main ad copy. About 125 characters show before \"See more\"."
                      },
                      "headline": {
                        "description": "Headline under the image. About 40 characters show.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "description": {
                        "description": "Description line. About 30 characters show, and only on some placements.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where the ad sends people. Must be HTTPS."
                      },
                      "call_to_action": {
                        "description": "Button label. Defaults to LEARN_MORE.",
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "SUBSCRIBE",
                          "DOWNLOAD",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "GET_OFFER",
                          "ORDER_NOW",
                          "SEE_MORE",
                          "GET_STARTED",
                          "BUY_NOW",
                          "DONATE_NOW",
                          "NO_BUTTON"
                        ]
                      },
                      "ad_set_name": {
                        "description": "Ad set name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "ad_name": {
                        "description": "Ad name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_name",
                      "objective",
                      "primary_text",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_create_video_campaign/execute": {
      "post": {
        "operationId": "meta_create_video_campaign",
        "summary": "Create a paused Meta video campaign",
        "description": "Builds a complete single-video campaign: campaign, one ad set, the video upload, the creative and one ad. The campaign is created PAUSED and its ad set and ad ACTIVE inside it, so nothing spends until the campaign is turned on, and turning it on launches the ad. Say that the campaign is paused when you report the result, with the two links the result gives (Ads Manager and the campaign's page in Adako), and offer \"enable all\": one meta_resume_entity call on the campaign, listed in the result as go_live.enable_all, one approval.\nUse when: the user has a video file at a public URL and has agreed on objective, budget, audience and copy. Resolve locations and interests with meta_search_targeting, the Page with meta_list_pages and the pixel with meta_list_pixels first.\nDo not use to add a video ad to a campaign that already exists — that is meta_add_ad. Calling this twice for the same brief creates two campaigns that both spend.\nDo not pass free text for locations or interests; only ids from the resolver tools are accepted.\nReturns the campaign, ad set, video, creative and ad ids, and reads the statuses back so you can confirm the campaign is paused (the ad set and ad read ACTIVE, held by the campaign).\nMeta transcodes the video before it can be used, which takes up to about half a minute. If the upload is still processing when the wait runs out the tool stops and tells you what exists — do not call it again, tell the user.\nIf unsure which objective fits a video, ask: awareness and engagement optimise for views, sales and leads optimise for conversions and need a pixel.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Launch a video campaign for our new product from this MP4",
          "Create a paused Meta campaign using this video and a 30 EUR daily budget"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Name shown in Ads Manager. Say what it sells and to whom."
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "OUTCOME_AWARENESS",
                          "OUTCOME_TRAFFIC",
                          "OUTCOME_ENGAGEMENT",
                          "OUTCOME_LEADS",
                          "OUTCOME_SALES",
                          "OUTCOME_APP_PROMOTION"
                        ],
                        "description": "What Meta should optimise the campaign for. OUTCOME_SALES and OUTCOME_LEADS need a pixel; OUTCOME_AWARENESS and OUTCOME_ENGAGEMENT suit view-through goals such as THRUPLAY. OUTCOME_APP_PROMOTION is refused here: use meta_create_app_install_campaign."
                      },
                      "daily_budget": {
                        "description": "Daily budget as a decimal in the account currency (25 means 25 dollars, not 2500 cents). One of daily_budget or lifetime_budget is required.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "Total budget for the whole flight, decimal in the account currency. Requires end_time.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "budget_level": {
                        "description": "Which level holds the budget. \"ad_set\" (the default) gives this ad set its own budget, so every ad set is funded separately. \"campaign\" is Meta's campaign budget optimisation (Advantage campaign budget): the campaign holds one budget and Meta decides how much each ad set gets — ad sets added later must then carry no budget of their own. Only \"campaign\" can be edited with meta_update_campaign_budget.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "campaign"
                        ]
                      },
                      "start_time": {
                        "description": "When delivery may start: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset, e.g. 2026-10-01T09:00:00+02:00. Not in the past; today or omitted means as soon as the user activates it.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "When delivery must stop: YYYY-MM-DD (runs to 23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset. Required with lifetime_budget.",
                        "type": "string"
                      },
                      "optimization_goal": {
                        "description": "Override what the ad set optimises for. Leave empty to use the objective default. LEAD_GENERATION (instant forms) is not supported; PAGE_LIKES promotes the Page.",
                        "type": "string"
                      },
                      "billing_event": {
                        "description": "What Meta charges for. Leave empty to use IMPRESSIONS.",
                        "type": "string"
                      },
                      "countries": {
                        "description": "ISO 3166-1 two-letter country codes from meta_search_targeting: GB, not UK; GR, not EL.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "region_keys": {
                        "description": "Region keys from meta_search_targeting (never region names). Checked with Meta first.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "city_keys": {
                        "description": "City keys from meta_search_targeting (never city names, postcodes or media markets). Each city is targeted with a 25 km radius.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "age_min": {
                        "description": "Youngest age to target. Minimum 18.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "age_max": {
                        "description": "Oldest age to target. 65 means 65 and over.",
                        "type": "integer",
                        "minimum": 18,
                        "maximum": 65
                      },
                      "genders": {
                        "description": "Restrict by gender. Defaults to all — narrow only when the user asks.",
                        "type": "string",
                        "enum": [
                          "all",
                          "men",
                          "women"
                        ]
                      },
                      "interest_ids": {
                        "description": "Interest ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "behavior_ids": {
                        "description": "Behaviour ids from meta_search_targeting or meta_browse_targeting. Never free text.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "custom_audience_ids": {
                        "description": "Custom audience ids from meta_list_custom_audiences.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "excluded_custom_audience_ids": {
                        "description": "Custom audiences to exclude, e.g. existing customers.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "advantage_audience": {
                        "description": "Let Meta deliver beyond the listed interests. Defaults to off so the targeting the user asked for is the targeting they get.",
                        "type": "boolean"
                      },
                      "dsa_beneficiary": {
                        "description": "Who benefits from the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one, including territories such as Réunion.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "dsa_payor": {
                        "description": "Who pays for the ad. Required whenever the targeting reaches the EU or EEA — a country, or a region or city inside one.",
                        "type": "string",
                        "maxLength": 512
                      },
                      "ad_set_name": {
                        "description": "Ad set name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "ad_name": {
                        "description": "Ad name. Defaults to the campaign name plus a suffix.",
                        "type": "string",
                        "maxLength": 200
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel that records the conversion. Required for sales and leads objectives; get it from meta_list_pixels."
                      },
                      "conversion_event": {
                        "description": "The pixel event to optimise for. Defaults to PURCHASE for sales, LEAD for leads.",
                        "type": "string",
                        "enum": [
                          "PURCHASE",
                          "LEAD",
                          "COMPLETE_REGISTRATION",
                          "ADD_TO_CART",
                          "INITIATED_CHECKOUT",
                          "ADD_PAYMENT_INFO",
                          "SUBSCRIBE",
                          "START_TRIAL",
                          "SUBMIT_APPLICATION",
                          "CONTACT",
                          "SCHEDULE",
                          "SEARCH",
                          "CONTENT_VIEW",
                          "DONATE",
                          "FIND_LOCATION"
                        ]
                      },
                      "special_ad_categories": {
                        "description": "Declare a restricted category (housing, employment, credit, politics, gambling, financial products). Leave empty unless the ad genuinely falls into one. CREDIT is sent as FINANCIAL_PRODUCTS_SERVICES, which replaced it. Housing, employment and financial products keep the audience at ages 18–65+, all genders, no behaviours and no lookalikes. Political ads (ISSUES_ELECTIONS_POLITICS) cannot be created here.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "EMPLOYMENT",
                            "HOUSING",
                            "CREDIT",
                            "ISSUES_ELECTIONS_POLITICS",
                            "ONLINE_GAMBLING_AND_GAMING",
                            "FINANCIAL_PRODUCTS_SERVICES"
                          ]
                        }
                      },
                      "special_ad_category_country": {
                        "description": "Countries the special ad category ads run in (ISO two-letter codes). Meta requires it with any special_ad_categories; omit it to use the targeted countries.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        }
                      },
                      "facebook_page_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Page the ad runs from, from meta_list_pages. Required when the account has more than one Page."
                      },
                      "instagram_account_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Instagram account to run the ad from, from meta_list_instagram_accounts."
                      },
                      "video_url": {
                        "description": "The video file for the ad: MP4 or MOV, H.264, under 4 GB. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "video_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "A video already in the account library, from meta_list_media (its `video_id`). Pass this instead of video_url when the file is already in the account — nothing is downloaded, uploaded or transcoded."
                      },
                      "thumbnail_url": {
                        "description": "Optional still image for the thumbnail. Leave it out to use the frame Meta picks itself. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "primary_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200,
                        "description": "Main ad copy. About 125 characters show before \"See more\"."
                      },
                      "headline": {
                        "description": "Headline under the video.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "description": {
                        "description": "Description line, shown on some placements only.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "landing_page_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Where the ad sends people. Must be HTTPS."
                      },
                      "call_to_action": {
                        "description": "Button label. Defaults to LEARN_MORE.",
                        "type": "string",
                        "enum": [
                          "LEARN_MORE",
                          "SHOP_NOW",
                          "SIGN_UP",
                          "SUBSCRIBE",
                          "DOWNLOAD",
                          "BOOK_NOW",
                          "GET_QUOTE",
                          "CONTACT_US",
                          "APPLY_NOW",
                          "GET_OFFER",
                          "ORDER_NOW",
                          "SEE_MORE",
                          "GET_STARTED",
                          "BUY_NOW",
                          "DONATE_NOW",
                          "NO_BUTTON"
                        ]
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_name",
                      "objective",
                      "primary_text",
                      "landing_page_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
