    "/api/v1/tools/tiktok_add_ad_group/execute": {
      "post": {
        "operationId": "tiktok_add_ad_group",
        "summary": "Add an ad group to a TikTok campaign (paused)",
        "description": "Creates one more ad group inside an existing TikTok campaign, PAUSED, with its own budget, schedule and targeting.\nUse when: the user wants to test a second audience, split budget across markets, or add a market to a campaign that already works. The campaign's objective decides what the ad group may optimise for, so nothing has to be chosen twice.\nDo not use it to change an existing ad group — that is tiktok_update_ad_group. Do not create near-duplicate ad groups targeting overlapping audiences: on TikTok they bid against each other and both get more expensive.\nDo not add an ad group and expect it to deliver: it is created paused and it has no ads. Add one with tiktok_add_ad, then resume both.\nValidates before creating: the optimisation goal against the campaign's objective, the ad group budget range for the account's currency, the bid against its limits and both budgets, the schedule (the advertiser's days; a past start is refused), the pixel and event when the objective needs them (the pixel must be on the account and receive that event), every location id and language code against TikTok's lists (overlapping locations and the under-18 rules included), and the campaign's special ad category limits.\nReturns the new ad group id, read back from TikTok.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 2,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add a second TikTok ad group targeting France",
          "Test a different audience in my TikTok campaign",
          "Create another TikTok ad group with a lower budget"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The campaign to add the ad group to, from tiktok_list_campaigns."
                      },
                      "adgroup_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "description": "Ad group name. No emoji."
                      },
                      "daily_budget": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily budget, decimal in the account currency."
                      },
                      "optimization_goal": {
                        "description": "What to optimise for. Omit to take the campaign objective's default; tiktok_explain_objective lists the valid pairs.",
                        "type": "string",
                        "maxLength": 40
                      },
                      "pixel_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Pixel to optimise against, for conversion objectives. From tiktok_list_pixels."
                      },
                      "optimization_event": {
                        "description": "The pixel event to optimise for, e.g. ON_WEB_ORDER.",
                        "type": "string",
                        "maxLength": 64
                      },
                      "bid": {
                        "description": "Manual bid (cost cap), decimal in the account currency. The unit follows the optimisation goal: per click for CLICK and PAGE_VISIT, per 1,000 impressions for REACH, per focused view for ENGAGED_VIEW and ENGAGED_VIEW_FIFTEEN, and a target cost per result for FOLLOWERS, CONVERT and VALUE. It must be lower than both the ad group and the campaign budget. Omit to let TikTok bid automatically, which is the right default for a new ad group.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "start_date": {
                        "description": "First day it may deliver, in the advertiser's timezone: from 00:00 that day there, or from now if it is today. Omit to start from now.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, inclusive, in the advertiser's timezone (delivery stops at 23:59:59 that day).",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "location_ids": {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "TikTok location ids from tiktok_search_targeting. Never a country or city name, and never a place together with a place inside it (a country and one of its cities) — TikTok refuses overlapping locations."
                      },
                      "age_groups": {
                        "description": "Age bands to target. Leave unset to reach every age TikTok allows, which includes 13–17 in most markets — pass the adult bands explicitly if the product is for adults only. In the US, Canada, Latin America, the EEA, the UK and Switzerland, TikTok limits an ad group that narrows by gender or interests to 18+, and refuses AGE_13_17 combined with them.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "AGE_13_17",
                            "AGE_18_24",
                            "AGE_25_34",
                            "AGE_35_44",
                            "AGE_45_54",
                            "AGE_55_100"
                          ]
                        }
                      },
                      "gender": {
                        "description": "Gender to target. Leave unset unless the product genuinely requires it.",
                        "type": "string",
                        "enum": [
                          "GENDER_UNLIMITED",
                          "GENDER_MALE",
                          "GENDER_FEMALE"
                        ]
                      },
                      "languages": {
                        "description": "Language codes exactly as tiktok_search_targeting (type: language) returns them, e.g. \"en\", \"pt-BR\". Checked against TikTok's list before anything is created.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 16
                        }
                      },
                      "interest_category_ids": {
                        "description": "Interest category ids from tiktok_search_targeting (type: interest). Omit to let TikTok find the audience itself.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "interest_keyword_ids": {
                        "description": "Additional interest ids from tiktok_search_targeting (type: interest_keyword). Omit unless the user asked for a specific interest the categories do not cover.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "operating_systems": {
                        "description": "Target only one mobile operating system: ANDROID or IOS. TikTok takes a single value; leave unset for both.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "ANDROID",
                            "IOS"
                          ]
                        }
                      },
                      "placement_type": {
                        "description": "PLACEMENT_TYPE_AUTOMATIC (default, and usually cheapest) or PLACEMENT_TYPE_NORMAL to choose placements, which then requires placements.",
                        "type": "string",
                        "enum": [
                          "PLACEMENT_TYPE_AUTOMATIC",
                          "PLACEMENT_TYPE_NORMAL"
                        ]
                      },
                      "placements": {
                        "description": "Which placements, required when placement_type is PLACEMENT_TYPE_NORMAL and ignored otherwise. PLACEMENT_PANGLE is off-app inventory; PLACEMENT_GLOBAL_APP_BUNDLE only reaches Brazil, Indonesia, Vietnam, the Philippines, Thailand, Malaysia, Mexico, Saudi Arabia and Japan.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "PLACEMENT_TIKTOK",
                            "PLACEMENT_PANGLE",
                            "PLACEMENT_GLOBAL_APP_BUNDLE"
                          ]
                        }
                      },
                      "identity_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "Not used on the ad group: TikTok only takes an identity on Shopping ad groups, which Adako does not build. Pass the identity to tiktok_add_ad instead."
                      },
                      "identity_type": {
                        "description": "Not used on the ad group; pass it to tiktok_add_ad.",
                        "type": "string",
                        "enum": [
                          "CUSTOMIZED_USER",
                          "AUTH_CODE",
                          "TT_USER",
                          "BC_AUTH_TT"
                        ]
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id",
                      "adgroup_name",
                      "daily_budget",
                      "location_ids"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
