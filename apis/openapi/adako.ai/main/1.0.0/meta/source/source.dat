    "/api/v1/tools/chatgpt_get_account_limits/execute": {
      "post": {
        "operationId": "chatgpt_get_account_limits",
        "summary": "Show what this ChatGPT Ads account can do",
        "description": "Lists what this advertiser account supports: the campaign objectives, what the platform can bid towards, what it bills on, the minimum spend limit, the chat card and image rules, and the account's own currency, timezone and review state.\nUse when: planning anything before creating it — choosing an objective, quoting a minimum budget, or answering \"can this platform do X\". Run it instead of guessing; guessing produces a proposal the user approves and the platform then refuses.\nDo not use it to read what exists (chatgpt_list_campaigns) or how it performs (chatgpt_get_performance). Do not present these limits as advice: they are what the API accepts, and a value outside them is refused before anything is created.\nReturns the minimum spend limit as a decimal in the account currency, and flags an account whose review verdict means nothing will deliver whatever is built. A conversions objective additionally needs a conversion event — find one with chatgpt_get_pixel_settings.\nCosts nothing and makes one cached read, so run it whenever the answer would otherwise be a guess.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "discovery",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What is the minimum budget on ChatGPT Ads?",
          "Which objectives can I use on this account?",
          "What are the rules before I launch here?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
