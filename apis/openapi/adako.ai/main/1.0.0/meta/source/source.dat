    "/api/v1/tools/meta_get_audience_insights/execute": {
      "post": {
        "operationId": "meta_get_audience_insights",
        "summary": "Break Meta performance down by audience",
        "description": "Splits spend and results by one audience dimension: age, gender, age and gender together, country, region, platform, device or placement position.\nUse when: the user asks who their ads reached, or wants to see whether one demographic or geography carries the account.\nDo not use to decide where to move budget on its own — meta_analyze_audiences ranks the same rows and says which segments are actually above or below average.\nDo not read a small segment as a finding: rows with a few impressions move wildly. The table reports spend share so the weight of each row is visible.\nReturns one row per segment with spend, impressions, CTR, results and cost per result, in the account currency.\nMeta reports some rows as \"unknown\" when it cannot attribute them; they are shown, labelled, and never presented as a real audience.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Break this campaign down by age and gender",
          "Which countries is my spend going to?",
          "Show performance by platform for the last 30 days"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Report on one campaign. Omit both ids to report the whole account."
                      },
                      "ad_set_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Report on one ad set."
                      },
                      "breakdown": {
                        "type": "string",
                        "enum": [
                          "age",
                          "gender",
                          "age_gender",
                          "country",
                          "region",
                          "publisher_platform",
                          "device_platform",
                          "platform_position"
                        ],
                        "description": "Which dimension to split by. age_gender crosses the two; platform_position splits feed, reels, stories and so on."
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "breakdown"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/meta_get_campaign_performance/execute": {
      "post": {
        "operationId": "meta_get_campaign_performance",
        "summary": "Meta campaign performance",
        "description": "Campaign-level results for a window, next to the same-length window before it, with the KPI each campaign's objective is actually judged on: purchases and purchase ROAS for sales, leads and cost per lead for lead generation, link clicks and CPC for traffic, reach and CPM for awareness, engagements for engagement, installs for app promotion.\nUse when: the user asks how Meta is doing, which campaigns are worth more budget, or what changed week over week.\nDo not use it for a brief or a report to keep or forward: that is generate_report_now (monitoring router), which covers every connected account and saves a page.\nDo not use to inspect settings (meta_list_campaigns) or to find waste inside an ad set (meta_analyze_wasted_spend).\nReturns \"not applicable\" rather than a blank or a zero for ROAS on objectives that record no revenue — never present a missing ROAS as a bad ROAS.\nIf the user's date wording is vague (\"recently\", \"lately\"), ask which window they mean instead of picking one.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "performance",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "How did our Meta campaigns do last week?",
          "What is our Facebook ROAS this month?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
