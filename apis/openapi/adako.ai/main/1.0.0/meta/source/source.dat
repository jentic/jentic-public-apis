    "/api/v1/tools/linkedin_list_conversions/execute": {
      "post": {
        "operationId": "linkedin_list_conversions",
        "summary": "List LinkedIn conversion rules",
        "description": "Lists the account's conversion rules with their type, tracking method, attribution windows, assigned value and — most importantly — which campaigns (ad sets in Campaign Manager) each one is attached to.\nUse when: a campaign shows clicks but no conversions, before creating a WEBSITE_CONVERSION campaign, and whenever you are about to tell a user their ads are not working. On LinkedIn a rule reports nothing against a campaign it is not associated with, and new campaigns inherit no rules at all, so an unattached rule looks exactly like a failing campaign.\nDo not conclude \"the ads do not convert\" until you have checked the campaign appears in a rule's campaign list here. Do not create a duplicate rule because an existing one looks unattached — attach it with linkedin_associate_conversion instead.\nReturns one row per rule, plus a warning naming any rule attached to nothing.\nIf the account has no rules at all, conversion reporting is impossible and a WEBSITE_CONVERSION campaign cannot optimise — say so before anything is built.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "what conversion rules exist on this LinkedIn account?",
          "why is LinkedIn reporting no conversions?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
