    "/api/v1/tools/google_list_assets/execute": {
      "post": {
        "operationId": "google_list_assets",
        "summary": "List Google Ads assets and where they are used",
        "description": "Lists the assets (extensions) that exist in the account and which campaigns or ad groups they are linked to. Assets live once in an account library and are then linked in one or more places, so the same sitelink can serve on several campaigns.\nUse when: you need asset ids before linking, removing or building a Performance Max asset group, or the user asks what extensions are running.\nDo not use when: the user wants ad copy (google_get_ad_creative) or per-asset performance labels (google_get_asset_performance).\nReturns one row per asset with its type, content and the campaigns/ad groups it is linked to. Paging is by asset id: pass the returned next_after_asset_id as after_asset_id to get the next page.\nBusiness names are stored as plain text assets, so asking for BUSINESS_NAME lists text assets; the link field type is what makes one a business name.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What sitelinks do we already have?",
          "List the callouts on the brand campaign",
          "Show every image asset in the account"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "asset_types": {
                        "description": "Asset types to include. Defaults to every type listed here.",
                        "minItems": 1,
                        "maxItems": 6,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "SITELINK",
                            "CALLOUT",
                            "STRUCTURED_SNIPPET",
                            "CALL",
                            "BUSINESS_NAME",
                            "IMAGE"
                          ]
                        }
                      },
                      "campaign_id": {
                        "description": "Only show assets linked to this campaign (and account-level assets it inherits).",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "limit": {
                        "description": "Maximum assets per page (default 50).",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 200
                      },
                      "after_asset_id": {
                        "description": "Page cursor: the next_after_asset_id from the previous call.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
