    "/api/v1/tools/meta_update_campaign_budget/execute": {
      "post": {
        "operationId": "meta_update_campaign_budget",
        "summary": "Change a Meta campaign budget (CBO)",
        "description": "Changes the daily or lifetime budget held at campaign level, which is how campaign budget optimisation (CBO) campaigns are funded: Meta distributes one budget across the ad sets.\nUse when: the campaign itself holds the budget. Check with meta_list_campaigns — a campaign with a budget shows one there.\nDo not use on a campaign whose ad sets hold their own budgets; Meta rejects it and the right tool is meta_update_adset_budget. The preview refuses before anything is sent.\nA campaign only holds a budget if it was created that way: the launch tools take budget_level: \"campaign\". It cannot be moved afterwards from here.\nDo not make large jumps casually: Meta re-enters the learning phase on big budget moves, and delivery gets worse before it gets better. Steps of 20% or less are safer.\nReturns the campaign read back from Meta so the new budget is confirmed rather than assumed.\nAmounts are decimals in the account currency; whole-unit currencies such as yen are converted here.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Raise the campaign budget to 200 a day",
          "Cut this campaign budget by half until the weekend"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The campaign to re-budget, from meta_list_campaigns."
                      },
                      "daily_budget": {
                        "description": "New campaign daily budget, decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "lifetime_budget": {
                        "description": "New campaign lifetime budget, decimal in the account currency. Needs an end date.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
