    "/api/v1/tools/google_add_search_themes/execute": {
      "post": {
        "operationId": "google_add_search_themes",
        "summary": "Add search themes to an asset group",
        "description": "Adds search themes to a Performance Max asset group. A search theme is a phrase telling Google what customers look for; it is a hint, not a keyword, and Google may serve on plenty of queries you never listed.\nUse when: the campaign is new and has nothing to learn from, or the user knows terms the ads should cover.\nDo not use when: the user expects keyword-level control. Performance Max has none, and search themes do not add any. Say so rather than implying otherwise.\nAn asset group holds at most 25 themes; the tool refuses if the addition would go over, and themes that are already there are skipped rather than duplicated.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "audiences",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Add search themes for \"waterproof hiking boots\" to asset group 555",
          "Seed this PMax asset group with our main product terms"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "asset_group_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Asset group id as a string of digits."
                      },
                      "search_themes": {
                        "minItems": 1,
                        "maxItems": 25,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "description": "Short phrases describing what customers search for. At most 25 in total per group."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
