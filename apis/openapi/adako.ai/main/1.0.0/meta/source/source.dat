    "/api/v1/tools/google_bulk_update_keyword_status/execute": {
      "post": {
        "operationId": "google_bulk_update_keyword_status",
        "summary": "Pause or enable many keywords at once",
        "description": "Pauses or enables up to 300 keywords in one call. Each id is looked up first, so the preview shows the actual keyword text, match type and current state — never a bare count.\nUse when: you have a concrete list of keyword ids from an analysis tool (google_analyze_wasted_spend, google_get_keyword_performance) and the user has seen and agreed to the list.\nDo not use when: the list came from your own guesswork, or when the user asked to *remove* keywords — pausing is not removing, and Adako does not delete keywords.\nIds that are not keywords in this account are reported back rather than silently ignored. Keywords already in the requested state are skipped. If Google rejects individual rows, the rest still apply and every rejected row is named.\nPausing a whole ad group's worth of keywords stops that ad group serving; check what is left before you do it.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "keywords",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Pause every keyword that spent money with no conversions last month",
          "Turn these 40 keywords back on"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "keyword_ids": {
                        "minItems": 1,
                        "maxItems": 300,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "Keyword criterion ids from google_get_keyword_performance. At most 300 per call."
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "ENABLED",
                          "PAUSED"
                        ],
                        "description": "The state to put every listed keyword into."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
