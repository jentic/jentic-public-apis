                        "description": "Geo target constant ids to add. They must come from google_resolve_locations.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "remove_location_ids": {
                        "description": "Geo target constant ids to stop targeting.",
