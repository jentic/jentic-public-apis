{
  "openapi": "3.1.0",
  "info": {
    "title": "Adako REST API",
    "version": "1.0.0",
    "description": "Adako is an MCP server and REST API for Google Ads, Meta Ads, ChatGPT Ads, TikTok Ads and\nLinkedIn Ads. Every tool an AI assistant can call over MCP is also one HTTP call here, with the\nsame validation, the same task quota and the same safety rules.\n\nAuthenticate with an Adako API key: Authorization: Bearer ak_live_...\n\nReads run immediately. Writes create a proposal: the response carries proposal_id and\napprove_url, and nothing changes on the ad platform until the proposal is approved. Created\ncampaigns are always paused.\n\nMoney is a decimal number in the account currency. Ids are strings.",
    "x-adako-tool-count": 233
  },
  "servers": [
    {
      "url": "https://adako.ai"
    }
  ],
  "tags": [
    {
      "name": "Discovery"
    },
    {
      "name": "Adako"
    },
    {
      "name": "Google Ads"
    },
    {
      "name": "Meta Ads"
    },
    {
      "name": "ChatGPT Ads"
    },
    {
      "name": "TikTok Ads"
    },
    {
      "name": "LinkedIn Ads"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/tools": {
      "get": {
        "operationId": "list_tools",
        "summary": "List every callable tool",
        "description": "Name, title, platform, category, risk, task cost and the URL to POST to. Any valid API key may call this.",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "description": "Filter by platform, for example google_ads.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tool list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "count": {
                      "type": "integer"
                    },
                    "tools": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ToolSummary"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "count",
                    "tools",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Unknown platform filter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/{tool_name}": {
      "get": {
        "operationId": "describe_tool",
        "summary": "Describe one tool",
        "description": "The full standard-operating-procedure description, the JSON Schema of its arguments and example prompts.",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "name": "tool_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tool.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "tool": {
                      "$ref": "#/components/schemas/ToolDetail"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "tool",
                    "request_id"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/approve_proposal/execute": {
      "post": {
        "operationId": "approve_proposal",
        "summary": "Approve and execute a pending proposal",
        "description": "Executes a pending proposal exactly once and reads the object back. Only call after the user has explicitly said yes to the specific proposal (quote its summary).\nUse when: the user's write policy is \"inbox\" and they approve in chat, or a client deferred a write.\nIf the proposal expired or was already decided, returns an error — do not re-create it silently; tell the user.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 0,
        "x-adako-category": "proposals",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Approve the budget change",
          "Yes, apply that pause"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "proposal_id": {
                        "type": "string",
                        "minLength": 8,
                        "description": "Id from list_pending_proposals or the proposal_pending error"
                      }
                    },
                    "required": [
                      "proposal_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/check_media/execute": {
      "post": {
        "operationId": "check_media",
        "summary": "Check an image or video before it becomes an ad",
        "description": "Checks a creative file before any ad is built from it, and answers where a file with no link yet has to go.\nUse when: the user offers an image or a video in any form — a link, a file on their computer, \"the one from our site\" — and always before a create tool that takes image_url or video_url.\nWhat it does: repairs the share links that do not serve files (Drive, Dropbox, OneDrive, GitHub, Imgur have a direct form), fetches only the head of the file to read its type, size, dimensions and an MP4's duration, and reports slot by slot which platforms accept it and what would be cropped.\nCall it with no arguments when the user has a file but no link: it returns the three ways to get one, cheapest first, starting with reusing what is already in their ad account.\nAdako hosts nothing and never receives the file. The platform downloads the URL itself, from its own servers and often hours later, which is why a local path, a login-gated page or a link that expires cannot work however it is passed.\nFree, instant, touches no ad account and creates nothing, so run it as often as needed. If a file is refused, say exactly which rule it broke and what to change — never retry a create with the same file.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Here is the image for the ad, can you use it?",
          "I have the video on my laptop — how do I get it into the ad?",
          "Will this photo work on Meta and TikTok?",
          "The image link I gave you was refused — what now?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "urls": {
                        "description": "The file links to check, as the user gave them — share pages and http links are repaired rather than rejected. Leave this out to get the \"where do I put my file\" answer instead.",
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      },
                      "platforms": {
                        "description": "Only judge these platforms. Defaults to all five, which is what to use when the user has not chosen yet.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "google_ads",
                            "meta_ads",
                            "chatgpt_ads",
                            "tiktok_ads",
                            "linkedin_ads"
                          ]
                        }
                      },
                      "kind": {
                        "description": "Only judge image slots or video slots. Defaults to what the file turns out to be.",
                        "type": "string",
                        "enum": [
                          "image",
                          "video"
                        ]
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/create_monitor/execute": {
      "post": {
        "operationId": "create_monitor",
        "summary": "Create a daily monitor on an ad account",
        "description": "Saves a rule that Adako evaluates once a day against its synced copy of the account — no platform call, no task cost. When the rule holds it emails the operator, and when it carries an action it creates a proposal they can approve.\nUse when: the user asks to be told about a metric (\"alert me if…\", \"watch…\", \"let me know when…\") and has named a metric, a direction and a number.\nDo not use when: the user wants a one-off answer about the last few days — read the data instead. Do not create a second monitor for a rule that already exists; call list_monitors first.\nReturns the monitor, the rule in plain words, and the day it will first be evaluated. Monitors read yesterday in the account's timezone once that day has fully synced (a day later for accounts far behind UTC), compared with a baseline of the previous baseline_days days.\nA monitor with an action still changes nothing on its own: the action becomes a proposal the user approves. Actions need exactly one campaign id so the proposal names one object, and they run on Google Ads, Meta Ads, LinkedIn Ads and ChatGPT Ads; a monitor on any other platform emails and proposes nothing.\nWatching an agency's whole platform: pass all_accounts instead of account_id. One monitor then covers every active account on that platform, each judged on its own numbers and currency, and one email a day lists the accounts that fired. Leave platform out as well and it covers every platform the user has connected. Either way it cannot carry an action or campaign ids, because both name one account.\nIf you are unsure which metric, account or threshold the user means, ask. Never invent a threshold.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Alert me when ROAS on my Google account drops below 2",
          "Tell me if spend rises more than 30% versus the last 30 days",
          "Watch CPA on campaign 123 and email me if it goes over 80"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "Short name the operator will recognise in email, for example \"ROAS floor — Brand\"."
                      },
                      "platform": {
                        "description": "Which ad platform the monitor watches. Leave it out only with all_accounts, which then covers every synced platform this user has connected.",
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads"
                        ]
                      },
                      "account_id": {
                        "description": "Platform account id (Google customer id, Meta act_…). Defaults to the primary active account on the platform.",
                        "type": "string",
                        "minLength": 1
                      },
                      "all_accounts": {
                        "description": "Watch every active account on the platform instead of one, including accounts connected later. Each account is judged on its own numbers, in its own currency and its own timezone, so a money threshold means that number of each account's own currency. Leave it out, or pass false, to watch a single account.",
                        "type": "boolean"
                      },
                      "metric": {
                        "type": "string",
                        "enum": [
                          "spend",
                          "clicks",
                          "impressions",
                          "conversions",
                          "conv_value",
                          "ctr",
                          "cpc",
                          "cpa",
                          "cpm",
                          "roas",
                          "conversion_rate",
                          "cost_per_lead",
                          "budget_utilization"
                        ],
                        "description": "What to watch. Rates are computed from the window totals: ctr = clicks/impressions, cpc = spend/clicks, cpa = spend/conversions, cpm = spend per 1,000 impressions, roas = conversion value/spend, conversion_rate = conversions/clicks, cost_per_lead = spend/leads, budget_utilization = spend/daily budget."
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "less_than",
                          "greater_than",
                          "changes_by",
                          "drops_by",
                          "rises_by"
                        ],
                        "description": "How to compare. less_than/greater_than use the threshold as a level; changes_by, drops_by and rises_by read the threshold as a percent move against the baseline."
                      },
                      "threshold": {
                        "type": "number",
                        "description": "The number to compare against: a value in the account currency for money metrics, a count for volume metrics, a fraction for ctr / conversion_rate / budget_utilization (0.02 means 2%, never 2), a multiplier of the baseline when threshold_type is relative, or a percent move for changes_by / drops_by / rises_by."
                      },
                      "threshold_type": {
                        "description": "absolute (default): the threshold is a value in the account currency or the metric's own unit. relative: the threshold is a multiplier of the baseline, so 0.5 means \"half of the usual\".",
                        "type": "string",
                        "enum": [
                          "absolute",
                          "relative"
                        ]
                      },
                      "baseline_days": {
                        "description": "Days of history the baseline averages. Default 30.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "consecutive_days": {
                        "description": "Require the rule to hold this many days in a row before alerting. Default 1.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 14
                      },
                      "campaign_ids": {
                        "description": "Platform campaign ids as strings. Leave empty to watch the whole account.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "conditions": {
                        "description": "Optional extra conditions, for example \"ROAS below 2 AND spend above 100\".",
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "and",
                              "or"
                            ],
                            "description": "How the extra conditions combine with the main one."
                          },
                          "conditions": {
                            "minItems": 1,
                            "maxItems": 3,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "metric": {
                                  "type": "string",
                                  "enum": [
                                    "spend",
                                    "clicks",
                                    "impressions",
                                    "conversions",
                                    "conv_value",
                                    "ctr",
                                    "cpc",
                                    "cpa",
                                    "cpm",
                                    "roas",
                                    "conversion_rate",
                                    "cost_per_lead",
                                    "budget_utilization"
                                  ],
                                  "description": "What to watch. Rates are computed from the window totals: ctr = clicks/impressions, cpc = spend/clicks, cpa = spend/conversions, cpm = spend per 1,000 impressions, roas = conversion value/spend, conversion_rate = conversions/clicks, cost_per_lead = spend/leads, budget_utilization = spend/daily budget."
                                },
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "less_than",
                                    "greater_than",
                                    "changes_by",
                                    "drops_by",
                                    "rises_by"
                                  ],
                                  "description": "How to compare. less_than/greater_than use the threshold as a level; changes_by, drops_by and rises_by read the threshold as a percent move against the baseline."
                                },
                                "threshold": {
                                  "type": "number"
                                },
                                "thresholdType": {
                                  "type": "string",
                                  "enum": [
                                    "absolute",
                                    "relative"
                                  ]
                                }
                              },
                              "required": [
                                "metric",
                                "operator",
                                "threshold"
                              ]
                            }
                          }
                        },
                        "required": [
                          "mode",
                          "conditions"
                        ]
                      },
                      "notify_email": {
                        "description": "Where to send the alert. Defaults to the account owner’s email. Any other address gets a confirmation link first, and alerts go to the owner’s email until someone at that address confirms.",
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "action": {
                        "description": "Optional. When set, a firing monitor creates a proposal the user still has to approve (in chat or at /approvals). Requires exactly one campaign id. Available on Google Ads, Meta Ads, LinkedIn Ads and ChatGPT Ads; on any other platform a monitor emails and proposes nothing.",
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "pause_campaign",
                              "lower_budget"
                            ],
                            "description": "What to propose when the monitor fires. Nothing is applied automatically."
                          },
                          "percent": {
                            "description": "lower_budget only: how much to cut the daily budget by, in percent. Default 20.",
                            "type": "number",
                            "minimum": 1,
                            "maximum": 90
                          }
                        },
                        "required": [
                          "type"
                        ]
                      },
                      "enabled": {
                        "description": "Create it switched off by passing false. Default true.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name",
                      "metric",
                      "operator",
                      "threshold"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/delete_monitor/execute": {
      "post": {
        "operationId": "delete_monitor",
        "summary": "Delete a monitor",
        "description": "Removes a monitor and its evaluation history for good. Adako settings only; nothing on the ad platform changes, and any proposals it already created stay in the approvals inbox.\nUse when: the user has said to delete this specific monitor and you have shown them its name and rule.\nDo not use when: they only want it quiet for a while — update_monitor with enabled: false pauses it and keeps the history.\nRequires confirm_delete: true. Ask first; there is no undo.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
