    "/api/v1/tools/linkedin_list_campaigns/execute": {
      "post": {
        "operationId": "linkedin_list_campaigns",
        "summary": "List LinkedIn campaigns (ad sets)",
        "description": "Lists campaigns (ad sets in Campaign Manager) with their group, status, objective, format, bid, daily and total budget, schedule, audience-expansion settings and a one-line targeting summary.\nUse when: the user asks what is running, before any change to a campaign (you need its real current settings, not a remembered one), and to get the campaign ids every other LinkedIn tool takes.\nDo not use it for spend or results — it returns configuration only. Performance comes from linkedin_get_campaign_performance. Do not assume a campaign with status ACTIVE is delivering: check the serving issues column, which is where LinkedIn reports an exhausted group budget or a creative still in review.\nReturns one row per campaign. Money is a decimal in the account currency.\nIf nothing comes back, check the status filter before telling the user the account is empty — DRAFT campaigns are excluded from an ACTIVE filter.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
