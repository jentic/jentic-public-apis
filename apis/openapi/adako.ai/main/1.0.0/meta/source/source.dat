    "/api/v1/tools/google_list_campaigns/execute": {
      "post": {
        "operationId": "google_list_campaigns",
        "summary": "List Google Ads campaigns",
        "description": "Lists the campaigns in a Google Ads account with their state, campaign type, bidding strategy, daily budget (shared or not) and last-30-day spend, clicks and conversions.\nUse when: you need campaign ids for any other tool, or the user asks what campaigns exist, what they cost or which are running.\nDo not use when: the user wants performance over a specific period (use google_get_campaign_performance) or the contents of one campaign (use google_get_campaign_structure).\nReturns one row per campaign, most expensive first. Budgets are decimals in the account currency; a \"shared\" budget is used by more than one campaign, so changing it affects all of them. A budget_id from here can be given to google_create_search_campaign as budget_id, which puts the new campaign on that same budget instead of creating another.\nGoogle does not report when a campaign was created. The nearest signal is the Started column: a campaign starts on the day it was made unless someone set a later date. Campaign ids are not creation order — never rank them by id to find the newest, and if the user asks for \"the latest one\", say what you are going by and let them confirm.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "What campaigns are running?",
          "List the campaigns and their budgets"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
