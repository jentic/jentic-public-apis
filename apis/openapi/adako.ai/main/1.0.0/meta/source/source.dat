    "/api/v1/tools/linkedin_add_creative/execute": {
      "post": {
        "operationId": "linkedin_add_creative",
        "summary": "Add a creative (ad) to a LinkedIn campaign (ad set)",
        "description": "Adds one more creative (an ad in Campaign Manager) to an existing campaign (ad set) — either from a new image URL (uploaded and posted as a dark post) or from a post URN that already exists. LinkedIn refuses a paused creative before its review, so inside a campaign that is not live it is created ACTIVE (reviewed now, held back by the campaign) and inside a campaign that is already ACTIVE it is created DRAFT.\nUse when: adding a variant to test against the current ad, or finishing a campaign whose create chain failed partway. This is the tool that repairs a campaign with no ad in it; do not re-run the create tool for that.\nDo not add a fifth variant to a campaign: LinkedIn's delivery optimisation splits budget across creatives and beyond three or four none of them gets enough impressions to prove anything.\nDo not add a creative whose image has not been checked — a failed upload here wastes a task and leaves nothing useful behind.\nDo not use it on a LEAD_GENERATION campaign: every ad there needs a Lead Gen Form this server cannot attach, so it is refused; add those ads in Campaign Manager.\nReturns the creative read back with its review status. A DRAFT creative serves nothing until the user approves linkedin_resume_creative; an ACTIVE one serves once its campaign is resumed and LinkedIn approves it.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "add another image to this LinkedIn campaign",
          "sponsor this existing post on the campaign",
          "add a new ad to this LinkedIn ad set"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign to add the creative to. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "post_urn": {
                        "description": "An existing post (urn:li:share:… or urn:li:ugcPost:…) to sponsor. Use this or image_url.",
                        "type": "string"
                      },
                      "organization_urn": {
                        "description": "Company page that authors the new post. Required when image_url is used.",
                        "type": "string"
                      },
                      "image_url": {
                        "description": "A new creative image. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet.",
                        "type": "string",
                        "format": "uri"
                      },
                      "headline": {
                        "description": "Headline for the new image.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "commentary": {
                        "description": "Post text above the new image. Sent as plain text: #hashtags and @mentions are not linked.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 3000
                      },
                      "landing_page_url": {
                        "description": "Where the new creative sends people.",
                        "type": "string",
                        "format": "uri"
                      },
                      "name": {
                        "description": "A name for the creative, for your own reference.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
