    "/api/v1/tools/linkedin_list_campaign_groups/execute": {
      "post": {
        "operationId": "linkedin_list_campaign_groups",
        "summary": "List LinkedIn campaign groups (Campaign Manager campaigns)",
        "description": "Lists the campaign groups (campaigns in Campaign Manager) in the ad account with their status, lifetime budget and run dates.\nNaming: Campaign Manager calls a campaign group a \"campaign\" and an API campaign an \"ad set\", while these tools keep the API names. When a user says \"campaign\" they may mean a group listed here, and \"ad set\" always means a campaign from linkedin_list_campaigns, so confirm the level before changing anything.\nUse when: orienting yourself in a new account, or before creating a campaign — every LinkedIn campaign must belong to a group, and reusing the right existing group is almost always better than creating another one.\nDo not read performance from here: a group's numbers come from linkedin_get_campaign_performance with the group's campaigns. Do not confuse a group's total budget with a campaign's daily budget; the group ceiling caps everything beneath it.\nReturns id, name, status, total budget and schedule per group, plus any serving issue LinkedIn reports.\nIf the account has no groups, say so and offer linkedin_create_campaign_group — do not create one unprompted.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "what campaign groups exist?",
          "show me the LinkedIn groups and their budgets",
          "show my Campaign Manager campaigns and their total budgets"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
