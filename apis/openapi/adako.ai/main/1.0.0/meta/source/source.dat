    "/api/v1/tools/google_get_conversion_action_performance/execute": {
      "post": {
        "operationId": "google_get_conversion_action_performance",
        "summary": "Conversion action performance",
        "description": "Reports, per conversion action, how many conversions it recorded in the period, their value, and whether it counts towards the \"Conversions\" column that Smart Bidding optimises against.\nUse when: the user asks whether tracking works, which goals fire, or why a campaign's conversion number looks wrong.\nDo not use when: you want conversions per campaign (google_get_campaign_performance) or the account's configuration only (google_list_conversion_actions, which is cheaper).\nA conversion action recording zero over a long window is the single most common cause of \"Smart Bidding stopped working\": it means the tag is broken or the page changed. Flag it plainly rather than reporting a zero without comment.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "How many conversions did each goal record last month?",
          "Is our purchase conversion still firing?",
          "Which conversion actions count towards bidding?"
        ],
