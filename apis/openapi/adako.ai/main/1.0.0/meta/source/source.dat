    "/api/v1/tools/chatgpt_update_ad/execute": {
      "post": {
        "operationId": "chatgpt_update_ad",
        "summary": "Edit the copy on a ChatGPT Ads ad",
        "description": "Changes the headline, body copy or destination URL on an existing chat card. The creative is replaced as a whole, so everything not being changed — the uploaded image above all — is sent back with it and nothing is silently dropped.\nUse when: the user wants different copy on an ad that already exists, or the landing page has moved. Read the ad first with chatgpt_list_ads so the before/after you show is real.\nDo not use it to change the image: an image is uploaded when the ad is created, so a new picture means a new ad with chatgpt_create_ad. Do not use it to pause or resume — those tools state the risk properly.\nEditing a creative sends the ad back into review on this platform. An approved ad stops delivering until it is approved again, which is a real cost on a good ad — say so before the user approves the change.\nReturns the ad read back from the platform, including its review verdict, so the new copy and the new review state are confirmed rather than assumed. The limits are the same as when creating: title 3–50, body at most 100, https destination.\nAt least one of title, body or target_url must be given. Do not rewrite the user's wording to fit a limit — tell them it is too long and ask.",
        "tags": [
          "ChatGPT Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Change the headline on ad ad_01 to something shorter",
          "Point ad ad_01 at the new landing page"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "ChatGPT Ads advertiser account id. One advertiser key belongs to one account, so this is only needed when the user has connected more than one key. Omit it to use the primary account.",
                        "type": "string"
                      },
                      "ad_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "The ad to edit, from chatgpt_list_ads."
                      },
                      "title": {
                        "description": "New headline, 3–50 characters.",
                        "type": "string"
                      },
                      "body": {
                        "description": "New body copy, at most 100 characters.",
                        "type": "string"
                      },
                      "target_url": {
                        "description": "New destination URL. Must be https.",
                        "type": "string",
                        "format": "uri"
                      },
                      "name": {
                        "description": "New ad name in Ads Manager. Cosmetic; does not affect delivery.",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1000
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ad_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
