    "/api/v1/tools/google_set_device_bid_modifiers/execute": {
      "post": {
        "operationId": "google_set_device_bid_modifiers",
        "summary": "Set device bid modifiers",
        "description": "Sets the bid multiplier for phones, computers and tablets on one campaign. A multiplier of 1 leaves bids alone; 0.8 bids 20% less; 1.2 bids 20% more. Google allows 0.1 (−90%) to 10 (+900%).\nUse when: google_get_device_performance shows a clear, sustained difference in cost per conversion between devices and there is enough data behind it.\nDo not use when: the campaign uses target CPA or target ROAS. Those strategies set their own device bids and ignore these modifiers except as a hint — the change looks like an action and does nothing. Say that instead.\nDo not use it to switch a device off either: 0.1 is the lowest multiplier and still buys traffic. Excluding a device entirely is a different change Adako does not make.\nThe preview shows the current and new multiplier per device. Devices you do not pass are left alone.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Bid 30% less on mobile for campaign 111",
          "Set the desktop modifier to +20%"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
