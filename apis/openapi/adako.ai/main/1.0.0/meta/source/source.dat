    "/api/v1/tools/google_create_conversion_action/execute": {
      "post": {
        "operationId": "google_create_conversion_action",
        "summary": "Create a website conversion action",
        "description": "Creates a website (WEBPAGE) conversion action so the account can record a goal.\nUse when: the user has decided what they want to count and has a way to fire the tag on their site.\nDo not use when: a conversion action for the same thing already exists — duplicates double-count and make every CPA in the account wrong. Check google_list_conversion_actions first, always.\n**This tool creates the action ENABLED, not paused.** Every other create in Adako is paused, but a paused conversion action records nothing at all, so creating one paused would be the same as not creating it. Creating it changes no spend and no bids by itself; it only starts collecting.\nCreating the action is only half the job: the user still has to put the tag or the Google tag event on their site (Adako cannot do that part). Until the tag fires, the action records zero and any campaign bidding on it is bidding on nothing. Say that.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "conversions",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Create a conversion action for demo requests",
          "Set up purchase tracking with a default value of 80"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "A name the user will recognise, e.g. \"Demo request\"."
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "DEFAULT",
                          "PURCHASE",
                          "LEAD",
                          "SUBMIT_LEAD_FORM",
                          "BOOK_APPOINTMENT",
                          "REQUEST_QUOTE",
                          "SIGNUP",
                          "CONTACT",
                          "PHONE_CALL_LEAD",
                          "ADD_TO_CART",
                          "BEGIN_CHECKOUT",
                          "SUBSCRIBE_PAID",
                          "DOWNLOAD",
                          "PAGE_VIEW",
                          "ENGAGEMENT",
                          "OUTBOUND_CLICK",
                          "QUALIFIED_LEAD"
                        ],
                        "description": "What kind of conversion this is."
                      },
                      "counting_type": {
                        "description": "Defaults to ONE_PER_CLICK, which is right for leads. Use MANY_PER_CLICK for sales where a repeat purchase should count again.",
                        "type": "string",
                        "enum": [
                          "ONE_PER_CLICK",
                          "MANY_PER_CLICK"
                        ]
                      },
                      "default_value": {
                        "description": "Value per conversion as a decimal in the account currency (set as the action's default currency). Leave out when the tag sends its own value.",
                        "type": "number",
                        "minimum": 0
                      },
                      "click_lookback_days": {
                        "description": "Click-through window in days; Google defaults to 30.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "counts_towards_conversions": {
                        "description": "Primary (true, the default) means Smart Bidding optimises towards it. False makes it observation only.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "name",
                      "category"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
