    "/api/v1/tools/linkedin_get_campaign_structure/execute": {
      "post": {
        "operationId": "linkedin_get_campaign_structure",
        "summary": "Show the LinkedIn account tree",
        "description": "Returns the whole account in one call: every campaign group (a campaign in Campaign Manager), the campaigns (ad sets) inside it, and the creatives (ads) inside those, with status and budget at each level.\nNaming: since October 2025 Campaign Manager calls the three levels campaign → ad set → ad, while the API and these tools say campaign group → campaign → creative. A user's \"campaign\" may mean a campaign group, and their \"ad set\" or \"ad\" means a campaign or a creative here, so check which level they mean before acting on it.\nUse when: taking over an unfamiliar account, auditing how something is set up, or answering \"where does this campaign sit\". One call here replaces three list calls and keeps the ids consistent between levels.\nDo not use it on a very large account when you only need one branch — pass campaign_group_id, or use linkedin_list_campaigns, so the answer stays readable. Do not use it for performance.\nReturns the tree plus counts, and flags every level that is not delivering.\nIf a campaign has no creatives it can never spend, however healthy its budget looks — say so rather than reporting it as ready.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "show me how this LinkedIn account is organised",
          "group → campaign → creative for this account",
          "show my LinkedIn campaigns, ad sets and ads"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Limit the tree to one campaign group. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "include_creatives": {
                        "description": "Read the creatives under each campaign (default true). Turn off for a fast overview.",
                        "type": "boolean"
                      },
                      "status": {
                        "description": "Only objects in this state. LinkedIn statuses are upper case. Defaults to everything except archived, cancelled and removed.",
                        "type": "string",
                        "enum": [
                          "ACTIVE",
                          "PAUSED",
                          "DRAFT",
                          "ARCHIVED",
                          "COMPLETED",
                          "all"
                        ]
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
