    "/api/v1/tools/linkedin_batch_update_campaigns/execute": {
      "post": {
        "operationId": "linkedin_batch_update_campaigns",
        "summary": "Change status or budget on many LinkedIn campaigns (ad sets)",
        "description": "Applies one status or one daily budget to up to 50 campaigns (ad sets in Campaign Manager) at once, reporting each campaign's result separately.\nUse when: the user has decided the same thing about several named campaigns — pausing a whole test, or standardising a budget. It is one approval instead of twenty.\nDo not use it to apply a budget the user has not named per campaign: the same figure across different audiences is rarely right, and \"£50 each\" across ten campaigns is £500 a day. State the total in the confirmation.\nDo not use it to pause an entire account — pause the campaign group (the Campaign Manager campaign) instead, which is one reversible change rather than fifty.\nDo not treat it as atomic. LinkedIn is called once per campaign, so a failure partway leaves earlier campaigns changed; the result lists exactly which succeeded and which did not. Never re-run the whole batch after a partial failure — re-run only the failures.\nReturns per-campaign success or failure with the reason.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "pause all these LinkedIn campaigns",
          "set a £50 daily budget across these five campaigns",
          "pause all these LinkedIn ad sets"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_ids": {
                        "minItems": 1,
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "The campaigns to change, at most 50."
                      },
                      "status": {
                        "description": "Set every listed campaign to this status.",
                        "type": "string",
                        "enum": [
                          "ACTIVE",
                          "PAUSED"
                        ]
                      },
                      "daily_budget": {
                        "description": "Set every listed campaign to this daily budget, a decimal in the account currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_ids"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
