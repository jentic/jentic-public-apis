    "/api/v1/tools/google_list_labels/execute": {
      "post": {
        "operationId": "google_list_labels",
        "summary": "List labels and what they are applied to",
        "description": "Lists the labels defined in the account and the campaigns and ad groups each one is applied to.\nUse when: the user organises work by label, or you need a label id before applying or removing one.\nDo not use when: the user means campaign names or campaign types — labels are a separate, optional layer.\nLabels change nothing about delivery, bids or spend. They exist so a person can group things; Google reports can then be filtered by them.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What labels exist in this account?",
          "Which campaigns carry the \"seasonal\" label?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
