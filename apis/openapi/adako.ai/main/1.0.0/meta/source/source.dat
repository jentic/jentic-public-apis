    "/api/v1/tools/tiktok_update_ad_group/execute": {
      "post": {
        "operationId": "tiktok_update_ad_group",
        "summary": "Edit a TikTok ad group",
        "description": "Changes a TikTok ad group's name, daily budget, bid, schedule or targeting (locations, ages, gender, languages, interests).\nUse when: the user wants to scale, narrow or reschedule an existing ad group. Resolve every location, language and interest with tiktok_search_targeting first — this tool takes ids and refuses names.\nDo not treat targeting fields as additive. TikTok replaces them wholesale: passing one location id to an ad group targeting five leaves it targeting one. The preview always shows the full before and after for exactly that reason — read it to the user before they approve.\nDo not change budget or bid by more than about 30% at a time: TikTok restarts the learning phase after a large move and performance dips for days. The tool warns when a change crosses that line. TikTok also refuses a budget below 105% of what the ad group has spent today, and a bid that is not below both the ad group and campaign budgets; both are checked first.\nDo not set a manual bid on an ad group that is bidding automatically unless the user asked for a cap and understands the risk — a cap below the market price stops delivery silently, with no error anywhere.\nDates are the advertiser's days. Moving the start of an ad group that has already started is refused (TikTok does not allow it); changing only the end date keeps the start, and changing only the start keeps an existing end date.\nReturns the ad group read back from TikTok after the change. At least one field must be given.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Increase the budget on this TikTok ad group to $80",
          "Change the TikTok targeting to Germany and Austria only",
          "Set a bid cap on my TikTok ad group"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "adgroup_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9]+$",
                        "description": "The ad group to edit."
                      },
                      "name": {
                        "description": "New ad group name. No emoji.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "daily_budget": {
                        "description": "The new budget, decimal in the account currency. It is read in whatever mode the ad group already uses: a daily amount on a daily budget, the whole flight on a lifetime one. The Update endpoint takes no budget_mode, so the mode itself cannot be changed here. Must be at least 105% of what the ad group has already spent.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bid": {
                        "description": "Manual bid (cost cap), decimal in the account currency. The unit follows the optimisation goal: per click for CLICK and PAGE_VISIT, per 1,000 impressions for REACH, per focused view for ENGAGED_VIEW and ENGAGED_VIEW_FIFTEEN, and a target cost per result for FOLLOWERS, CONVERT and VALUE. It must be lower than both the ad group and the campaign budget. Omit to let TikTok bid automatically, which is the right default for a new ad group. Setting one switches the ad group off automatic bidding.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "start_date": {
                        "description": "New first day, in the advertiser's timezone. Refused once the ad group has started; a past day is refused.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "New last day, inclusive, in the advertiser's timezone (delivery stops at 23:59:59 that day).",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "location_ids": {
                        "description": "Replaces the ad group's locations entirely. Ids from tiktok_search_targeting; checked against TikTok's list, including overlaps.",
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "age_groups": {
                        "description": "Replaces the ad group's age bands entirely. In the US, Canada, Latin America, the EEA, the UK and Switzerland, an ad group narrowed by gender or interests must name adult bands only.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "AGE_13_17",
                            "AGE_18_24",
                            "AGE_25_34",
                            "AGE_35_44",
                            "AGE_45_54",
                            "AGE_55_100"
                          ]
                        }
                      },
                      "gender": {
                        "description": "Gender to target. Leave unset unless the product genuinely requires it.",
                        "type": "string",
                        "enum": [
                          "GENDER_UNLIMITED",
                          "GENDER_MALE",
                          "GENDER_FEMALE"
                        ]
                      },
                      "languages": {
                        "description": "Replaces the ad group's languages entirely. Codes exactly as tiktok_search_targeting returns them.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 16
                        }
                      },
                      "interest_category_ids": {
                        "description": "Replaces the ad group's interests entirely. Ids from tiktok_search_targeting.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "interest_keyword_ids": {
                        "description": "Replaces the ad group's additional interests entirely. Ids from tiktok_search_targeting (type: interest_keyword).",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "adgroup_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
