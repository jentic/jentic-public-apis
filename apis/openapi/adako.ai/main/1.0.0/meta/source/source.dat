    "/api/v1/tools/linkedin_estimate_audience_size/execute": {
      "post": {
        "operationId": "linkedin_estimate_audience_size",
        "summary": "Estimate a LinkedIn audience size",
        "description": "Counts how many LinkedIn members a targeting spec reaches, before a campaign is created against it.\nUse when: after resolving URNs with linkedin_search_targeting and before any create or targeting update. LinkedIn refuses a campaign under 300 members, and a spec just above that floor will deliver expensively and exhaust itself in days — this is the check that catches both.\nDo not skip it because the spec \"looks broad\": stacking three facets multiplies narrowly, and an audience of 400 is the single most common reason a carefully built LinkedIn campaign underperforms. Do not pass names instead of URNs; this tool refuses free text for the same reason the writers do.\nReturns the estimated audience, whether it clears the platform minimum, and a plain-language read on whether it is big enough to spend against.\nIf it comes back under a few thousand, tell the user which facet to widen before you build anything — do not create the campaign and hope.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "targeting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "how big is this LinkedIn audience?",
          "is my LinkedIn targeting too narrow to run?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "targeting": {
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
