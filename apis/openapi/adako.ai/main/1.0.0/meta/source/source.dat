    "/api/v1/tools/tiktok_resume_ad/execute": {
      "post": {
        "operationId": "tiktok_resume_ad",
        "summary": "Resume a TikTok ad",
        "description": "Sets one TikTok ad back to ENABLE so it can deliver again. Real money starts being spent as soon as TikTok approves delivery.\nUse when: the user has reviewed something paused — often something this server created — and wants it live.\nDo not resume without telling the user the budget first: on TikTok the daily budget applies from that moment, and a ad resumed on a Friday evening spends the weekend.\nDo not assume ENABLE means delivering. Check the read-back: an ad still in review, a parent that is paused, an exhausted budget or a schedule that has passed will all keep an enabled ad at zero, and the delivery status in the read-back says which.\nReturns the ad read back from TikTok, including its budget and delivery status.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
