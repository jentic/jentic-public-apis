    "/api/v1/tools/tiktok_validate_assets/execute": {
      "post": {
        "operationId": "tiktok_validate_assets",
        "summary": "Check TikTok creative URLs before uploading",
        "description": "Checks a video or image URL before anything is uploaded: that it is reachable without a login, that it serves a format TikTok accepts, and that it is inside the size limit — then states the rules that can only be verified after upload.\nUse when: the user gives a URL for a creative, before tiktok_create_video_campaign or tiktok_upload_images. It costs nothing and it catches the failures that would otherwise appear as an opaque upload error.\nDo not treat a clean result as approval. Duration, aspect ratio and dimensions cannot be read from HTTP headers — TikTok reports them after upload, and the create tool checks them there. What this catches is the common half: an expired signed link, a file behind a login, a MOV where an MP4 was meant, a 700 MB export.\nDo not use it on a TikTok CDN link or a video already in the library; use tiktok_list_ad_videos for those, which gives the real dimensions.\nReturns per URL: reachable, content type, size, and what to fix. The rules are 5–60 seconds, 9:16 (or 1:1 / 16:9), under 500 MB, MP4 preferred.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Will this video work as a TikTok ad?",
          "Check my TikTok creative URLs before I launch",
          "What are the TikTok video requirements?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "urls": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 8,
                          "maxLength": 2048
                        },
                        "description": "Public URLs to check. One call can take several."
                      },
                      "kind": {
                        "description": "What these URLs are. Defaults to video.",
                        "type": "string",
                        "enum": [
                          "video",
                          "image"
                        ]
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "urls"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
