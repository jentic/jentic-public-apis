    "/api/v1/tools/tiktok_list_campaigns/execute": {
      "post": {
        "operationId": "tiktok_list_campaigns",
        "summary": "List TikTok campaigns",
        "description": "Lists the campaigns in a TikTok advertiser account with objective, on/off state, budget and budget mode, and the delivery status TikTok computed for each one.\nUse when: you need campaign ids before reading performance or changing anything, or the user asks what is running on TikTok.\nDo not use it to compare results — that is tiktok_get_campaign_performance; this returns configuration only, with no spend or views in it.\nReturns two different status fields, and the difference matters: \"status\" is what the advertiser set (active or paused), while \"delivery\" is what TikTok computed. A campaign can be active and still deliver nothing because its budget is exhausted, its ad groups are all paused, or its ads are still in review. When every number in a report is zero, read this first.\nBudgets are decimals in the account currency. A campaign with budget mode BUDGET_MODE_INFINITE holds no budget of its own — the ad groups underneath do, so look there with tiktok_list_ad_groups.\nIf the user names a campaign you cannot find here, say so and ask; never guess an id.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
