    "/api/v1/tools/google_update_bid_strategy/execute": {
      "post": {
        "operationId": "google_update_bid_strategy",
        "summary": "Change a campaign bidding strategy",
        "description": "Changes how a campaign bids: maximise conversions (optionally with a target CPA), maximise conversion value (optionally with a target ROAS), maximise clicks, or manual CPC.\nUse when: the user has said what they want to optimise for and, for a target, the number they want.\nDo not use when: the campaign is less than two weeks old or has fewer than ~15 conversions in the last 30 days — Smart Bidding needs data, and switching resets the learning period for about a week, during which cost per conversion usually gets worse before it gets better. Say that first.\nBefore changing anything the tool checks two things. If the campaign is driven by a *portfolio* strategy it refuses, names the portfolio and says how many campaigns share it; changing what that portfolio targets is then possible only with portfolio_strategy_id passed explicitly, because it moves every campaign on it. If you ask for conversion-based bidding it checks that the account actually has a working conversion action, and refuses with an explanation if it does not.\nMoving one campaign between strategies is separate and safe for the others: attach_portfolio_strategy_id puts this campaign on an existing portfolio (from google_list_bidding_strategies), and detach_from_portfolio takes it off and gives it the strategy you pass. Neither touches the portfolio or the other campaigns on it.\nThe preview shows the before and after. Read-back confirms what Google stored.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Switch campaign 123 to maximise conversions with a $40 target CPA",
          "Put this campaign on target ROAS 400%",
          "Go back to manual CPC on the brand campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "strategy": {
                        "description": "MAXIMIZE_CONVERSIONS (optionally with a target CPA), MAXIMIZE_CONVERSION_VALUE (optionally with a target ROAS), TARGET_SPEND (shown as \"Maximize clicks\" in Google Ads) or MANUAL_CPC. Required unless attach_portfolio_strategy_id moves the campaign onto a portfolio, which decides the bidding itself.",
                        "type": "string",
                        "enum": [
                          "MAXIMIZE_CONVERSIONS",
                          "MAXIMIZE_CONVERSION_VALUE",
                          "TARGET_SPEND",
                          "MANUAL_CPC"
                        ]
                      },
                      "target_cpa": {
                        "description": "Target cost per conversion as a decimal in the account currency. Only with MAXIMIZE_CONVERSIONS. Rounded to the smallest amount Google bills in that currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "target_roas": {
                        "description": "Target return on ad spend as a multiplier (4 means 400%). Only with MAXIMIZE_CONVERSION_VALUE.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "enhanced_cpc": {
                        "description": "Retired by Google and refused by the API: passing true returns an error explaining what to use instead. Kept so older callers get that explanation rather than a raw platform error. Leave it unset.",
                        "type": "boolean"
                      },
                      "portfolio_strategy_id": {
                        "description": "Required when the campaign is driven by a portfolio strategy and you are changing that strategy (which changes every campaign on it). Pass the id the refusal message gave you, after telling the user how many campaigns share it. To move this campaign onto a portfolio, or off one, use attach_portfolio_strategy_id or detach_from_portfolio instead.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "attach_portfolio_strategy_id": {
                        "description": "Move this one campaign onto an existing portfolio (shared) bidding strategy, from google_list_bidding_strategies. The portfolio then decides its bidding, and nothing about the other campaigns on it changes. Its own strategy and targets are replaced, so pass no strategy with it.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "detach_from_portfolio": {
                        "description": "Take this one campaign off the portfolio strategy that drives it and give it the strategy in `strategy` instead. The portfolio and every other campaign on it are untouched.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
