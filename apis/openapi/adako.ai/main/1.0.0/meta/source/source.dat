  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An Adako API key (ak_live_...). Scopes: ads:read, ads:write, accounts:read, usage:read."
      }
    },
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "access_level_insufficient",
          "account_ambiguous",
          "account_limit",
          "confirmation_required",
          "duplicate_create",
          "idempotency_mismatch",
          "internal",
          "needs_reauth",
          "not_connected",
          "plan_required",
          "platform_error",
          "platform_rate_limited",
          "proposal_expired",
          "proposal_failed_before",
          "proposal_not_found",
          "proposal_not_pending",
          "proposal_pending",
          "quota_exceeded",
          "rate_limited",
          "unauthorized",
          "unknown_tool",
          "validation"
        ],
        "description": "Stable machine-readable error code. Switch on this, never on the message."
      },
      "Quota": {
        "type": "object",
        "description": "Task usage for the current billing period.",
        "properties": {
          "plan": {
            "type": "string"
          },
          "used": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "period_end": {
            "type": "string"
          },
          "upgrade_url": {
            "type": "string"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "recovery_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "recovery_steps"
        ]
      },
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "tool": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Machine-readable result."
          },
          "markdown": {
            "type": "string",
            "description": "The same result written for a person or a model."
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          },
          "proposal_id": {
            "type": "string",
            "description": "Present for writes. Nothing changes on the ad platform until it is approved."
          },
          "approve_url": {
            "type": "string",
            "description": "Where a person approves the proposal."
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "tool",
          "data",
          "markdown",
          "request_id"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ToolError"
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "error",
          "request_id"
        ]
      },
      "ToolSummary": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "read-only",
              "write",
              "destructive-write"
            ]
          },
          "cost": {
            "type": "integer",
            "description": "Tasks charged per call. 0 is never billed."
          },
          "since": {
            "type": [
              "string",
              "null"
            ]
          },
          "call_url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "platform",
          "risk",
          "cost",
          "call_url"
        ]
      },
      "ToolDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ToolSummary"
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "read",
                  "write"
                ]
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "input_schema": {
                "type": "object",
                "additionalProperties": true
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}