    "/api/v1/tools/meta_optimize_budget/execute": {
      "post": {
        "operationId": "meta_optimize_budget",
        "summary": "Plan a Meta budget reallocation",
        "description": "Compares the ad sets in a campaign (or the whole account) on cost per result — or ROAS where revenue exists — and produces a reallocation plan: which budgets to raise, which to lower, by how much, and why.\nUse when: the user asks where to put more money, or wants a defensible weekly rebalance.\nDo not expect it to write anything. It returns a plan; each move is then a separate meta_update_adset_budget call the user approves.\nDo not apply moves to an ad set still in the learning phase — the plan leaves those out and says so, because a budget change restarts learning.\nDo not exceed the step size without saying what it costs: moves are capped at max_change_percentage (20% by default) because Meta re-enters learning on large jumps.\nReturns the plan with before and after budgets, the reason per move, and the ad sets deliberately left alone.\nIf every ad set performs close to the average, the honest plan is to change nothing.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "analysis",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Where should I move budget across these ad sets?",
          "Which ad sets deserve more money this week?",
          "Plan a 20% rebalance across the campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Limit the plan to the ad sets of one campaign."
                      },
                      "max_change_percentage": {
                        "description": "Biggest step any single budget may move, as a fraction. Default 0.2 (20%).",
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 1
                      },
                      "min_daily_budget": {
                        "description": "Floor no budget may fall below, decimal in the account currency. Default: Meta's own minimum daily budget for what each ad set is charged for, in this account's currency.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "keep_total": {
                        "description": "Fund every increase from the decreases so the total daily budget stays the same.",
                        "type": "boolean"
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
