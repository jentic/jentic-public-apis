    "/api/v1/tools/google_create_pmax_campaign/execute": {
      "post": {
        "operationId": "google_create_pmax_campaign",
        "summary": "Create a Performance Max campaign (paused)",
        "description": "Creates a whole Performance Max campaign in one atomic change: budget, campaign, location targeting, asset group, every text and image asset, and optional search themes and audience signal. The campaign is created PAUSED and its asset group enabled inside it, so nothing serves and nothing is spent until the campaign is turned on, and turning it on launches everything. Report that with the two links the result gives (Google Ads and the campaign's page in Adako), and offer \"enable all\": google_resume_campaign turns the campaign on in one approval.\nUse when: the user has given a budget, a landing page, the copy, the images and the countries — and understands what Performance Max is: one campaign that spends across Search, Shopping, YouTube, Display, Discover, Gmail and Maps with very little per-channel control or reporting.\nDo not use when: anything is missing or invented. Google needs at least 3 headlines, 1 long headline, 2 descriptions, a business name, a landscape image, a square image and a square logo; the tool refuses with a plain list of what is missing rather than sending a request that fails halfway. Do not use it when a Search campaign is what the user actually needs — Performance Max cannot be steered by keyword and will happily cannibalise an existing brand campaign.\nImages may be asset ids (from google_list_assets) or https URLs, which are downloaded, measured against Google's aspect-ratio rules and uploaded in the same change. Locations must be ids from google_resolve_locations; they reach people in or regularly in those places (Presence) unless location_targeting is PRESENCE_OR_INTEREST. Final-URL expansion is switched off, so traffic goes to the page you named. Text limits count each Chinese, Japanese or Korean character as 2, and the daily budget is rounded to the smallest amount Google bills in the account currency.\nIf anything is rejected, nothing at all is created: there is no half-built campaign to clean up.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Build a Performance Max campaign for our online shop",
          "Create a PMax campaign with these images and a 400% ROAS target"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "description": "Campaign name the user will recognise."
                      },
                      "daily_budget": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Average daily budget as a decimal in the account currency. Never micros."
                      },
                      "final_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The landing page the asset group points at (https)."
                      },
                      "business_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 25,
                        "description": "Business name, 25 characters or fewer (Chinese, Japanese and Korean count as 2)."
                      },
                      "headlines": {
                        "minItems": 3,
                        "maxItems": 15,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        },
                        "description": "At least 3 headlines, 30 characters or fewer each (Chinese, Japanese and Korean characters count as 2). Five is the practical minimum."
                      },
                      "long_headlines": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 90
                        },
                        "description": "At least 1 long headline, 90 characters or fewer."
                      },
                      "descriptions": {
                        "minItems": 2,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 90
                        },
                        "description": "At least 2 descriptions; the first must be 60 characters or fewer."
                      },
                      "marketing_images": {
                        "minItems": 1,
                        "maxItems": 15,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9]+$",
                              "description": "An existing image asset id from google_list_assets."
                            },
                            {
                              "type": "string",
                              "format": "uri",
                              "description": "An https URL; the image is downloaded, checked and uploaded."
                            }
                          ]
                        },
                        "description": "Landscape 1.91:1 images — asset ids or https URLs."
                      },
                      "square_images": {
                        "minItems": 1,
                        "maxItems": 15,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9]+$",
                              "description": "An existing image asset id from google_list_assets."
                            },
                            {
                              "type": "string",
                              "format": "uri",
                              "description": "An https URL; the image is downloaded, checked and uploaded."
                            }
                          ]
                        },
                        "description": "Square 1:1 images — asset ids or https URLs."
                      },
                      "logos": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9]+$",
                              "description": "An existing image asset id from google_list_assets."
                            },
                            {
                              "type": "string",
                              "format": "uri",
                              "description": "An https URL; the image is downloaded, checked and uploaded."
                            }
                          ]
                        },
                        "description": "Square 1:1 logos — asset ids or https URLs."
                      },
                      "location_ids": {
                        "minItems": 1,
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "description": "Geo target constant ids from google_resolve_locations. Free text is never accepted."
                      },
                      "location_targeting": {
                        "description": "Who the locations reach. PRESENCE (the default here): people in or regularly in those places. PRESENCE_OR_INTEREST (Google’s own default): also people elsewhere who show interest in them, e.g. someone abroad planning a trip. Choose it only when the user wants that wider reach.",
                        "type": "string",
                        "enum": [
                          "PRESENCE",
                          "PRESENCE_OR_INTEREST"
                        ]
                      },
                      "target_roas": {
                        "description": "Optional target ROAS (4 means 400%). With it the campaign maximises conversion value; without it, conversions.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "search_themes": {
                        "description": "Optional search themes to seed the asset group (at most 25).",
                        "maxItems": 25,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "audience_id": {
                        "description": "Optional audience signal. Audience id from google_search_audiences — only an entry from its `audiences` list. The `interest_segments` and `user_lists` it also returns are different kinds of id and Google refuses them here with INVALID_COMBINED_AUDIENCE_ID (seen live 2026-09-18). An account with an empty `audiences` list has no audience to signal with; say so rather than passing an interest id.",
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_name",
                      "daily_budget",
                      "final_url",
                      "business_name",
                      "headlines",
                      "long_headlines",
                      "descriptions",
                      "marketing_images",
                      "square_images",
                      "logos",
                      "location_ids"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/google_create_responsive_search_ad/execute": {
      "post": {
        "operationId": "google_create_responsive_search_ad",
        "summary": "Create a responsive search ad (paused)",
        "description": "Creates one responsive search ad inside an existing ad group. The ad is created **PAUSED**: it costs nothing and serves nothing until the user enables it with google_resume_ad, so a mistake is never live.\nUse when: the ad group exists, the user has approved the copy, and the landing page is the one they named.\nDo not use when: you would be inventing claims, prices or offers — everything in an ad must be true and must appear on the landing page. Ask rather than guess. Do not use it to \"edit\" an ad either: Google has no ad edit, and creating a near-duplicate splits the data for no gain.\nEvery headline and description is checked against the same rules as google_validate_ad_copy before anything is sent: length, shouting, repeated punctuation, duplicates. A failing ad is refused with the exact reason.\nGoogle needs at least three headlines and two descriptions; eight to ten distinct headlines is what earns a good ad strength.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Create a new responsive search ad in ad group 456",
          "Add a second ad variant for the pricing page"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "ad_group_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "The ad group the new ad goes into."
                      },
                      "headlines": {
                        "minItems": 3,
                        "maxItems": 15,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        },
                        "description": "3–15 headlines, 30 characters or fewer each (each Chinese, Japanese or Korean character counts as 2). Aim for 8–10 genuinely different ones."
                      },
                      "descriptions": {
                        "minItems": 2,
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 90
                        },
                        "description": "2–4 descriptions, 90 characters or fewer each."
                      },
                      "final_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The landing page, an https URL."
                      },
                      "path1": {
                        "description": "First display path segment, 15 characters.",
                        "type": "string",
                        "maxLength": 15
                      },
                      "path2": {
                        "description": "Second display path segment, 15 characters.",
                        "type": "string",
                        "maxLength": 15
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "ad_group_id",
                      "headlines",
                      "descriptions",
                      "final_url"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
