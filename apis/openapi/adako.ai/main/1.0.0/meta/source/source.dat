    "/api/v1/tools/meta_explain_anomaly/execute": {
      "post": {
        "operationId": "meta_explain_anomaly",
        "summary": "Explain a change in Meta performance",
        "description": "Compares a window with the equally long window before it and attributes the change to the ad sets, placements, countries or age-and-gender groups that caused it.\nUse when: a number moved and the user wants to know why, before changing anything.\nDo not present the biggest row as the cause on its own — check its share of the move, which the table reports. A change spread thinly across everything usually means an auction or seasonality shift, not something inside the account.\nDo not use it to compare two arbitrary periods of different lengths; the comparison window is always the same number of days, immediately before.\nReturns the total before and after, the rows that account for most of the move, and each row's contribution.\nIf nothing explains more than about a sixth of the change, the tool says so instead of inventing a cause.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Why did our Meta spend jump last week?",
          "Conversions fell — what caused it?",
          "What is behind the CPM rise in this campaign?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "Limit the analysis to one campaign."
                      },
                      "metric": {
                        "description": "What moved. Default spend. \"results\" uses the objective’s own KPI.",
                        "type": "string",
                        "enum": [
                          "spend",
                          "results",
                          "impressions",
                          "clicks",
                          "revenue"
                        ]
                      },
                      "dimension": {
                        "description": "How to split the change. Default ad_set, which is usually where a real change lives.",
                        "type": "string",
                        "enum": [
                          "ad_set",
                          "placement",
                          "age_gender",
                          "country"
                        ]
                      },
                      "date_range": {
                        "description": "Preset window. The \"last N days\" ones end yesterday, so no partial day is mixed in. Either this or start_date + end_date, never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "description": "First day, YYYY-MM-DD. Needs end_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "Last day, YYYY-MM-DD, inclusive. Needs start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
