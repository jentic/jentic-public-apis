    "/api/v1/tools/tiktok_upload_images/execute": {
      "post": {
        "operationId": "tiktok_upload_images",
        "summary": "Upload cover images to TikTok",
        "description": "Uploads one or more images to the advertiser's creative library from public URLs and returns their image ids, which tiktok_add_ad and tiktok_create_video_campaign take as the ad's cover.\nUse when: the user wants a specific frame as the ad's cover rather than the one TikTok picks. Validate the URLs with tiktok_validate_assets first — it is free and catches the failures this cannot recover from.\nDo not use it for videos: video upload happens inside tiktok_create_video_campaign, which needs to attach the result to an ad in the same operation.\nDo not re-upload an image that is already in the library; check tiktok_list_ad_videos' sibling library in Ads Manager, or reuse the image id from an existing ad via tiktok_list_ads.\nUploading changes nothing that spends money — it adds files to a library — but it is a write, so it goes through the proposal engine like every other write and is never repeated on a retry.\nReturns the image ids, dimensions and sizes TikTok recorded.",
        "tags": [
          "TikTok Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Upload this image as my TikTok ad cover",
          "Add a thumbnail to my TikTok creative library"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "advertiser_id": {
                        "description": "TikTok advertiser id (a long numeric string). Only needed when the user has authorised more than one advertiser. Omit it to use the primary one.",
                        "type": "string"
                      },
                      "image_urls": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 8,
                          "maxLength": 2048
                        },
                        "description": "The image files to add to the creative library. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "image_urls"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
