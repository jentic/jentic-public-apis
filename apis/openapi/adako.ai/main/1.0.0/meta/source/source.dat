    "/api/v1/tools/google_update_campaign_networks/execute": {
      "post": {
        "operationId": "google_update_campaign_networks",
        "summary": "Turn search partners and display expansion on or off",
        "description": "Turns a Search campaign's two extra networks on or off: Google search partners (other search sites) and display expansion (the Display Network with leftover budget).\nUse when: the user has asked about where their ads appear, or an audit shows partner or display traffic performing badly.\nDo not use when: you have not looked at what those networks are actually doing — google_get_campaign_performance segmented by network (google_explain_performance_anomaly reports it) shows whether they are worth keeping.\nBoth default to off for good reason. Search-partner inventory cannot be excluded site by site. Display expansion buys cheap impressions with very different intent and often flatters CTR while quietly raising CPA.\nTurning either on is a real change in where money goes; say so before doing it.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Turn off search partners on campaign 111",
          "Stop this search campaign showing on display"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Campaign id as returned by google_list_campaigns."
                      },
                      "search_partners": {
                        "description": "Show on Google Search partner sites. Off is the safer default.",
                        "type": "boolean"
                      },
                      "display_expansion": {
                        "description": "Let a Search campaign also show on the Display Network with leftover budget. Off is the safer default.",
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
