    "/api/v1/tools/meta_get_lead_form_submissions/execute": {
      "post": {
        "operationId": "meta_get_lead_form_submissions",
        "summary": "Read submissions from a Meta lead form",
        "description": "Reads the submissions of one lead form: when each lead arrived, which ad and campaign produced it, and the answers given.\nUse when: the user wants to know how many leads arrived, which ads produced them, or needs the answers to pass into their own system.\nDo not paste lead answers into a chat summary. The markdown reports counts, field names and timing only; the answers are in the structured data, and it is the user's decision what happens to them.\nDo not use it as a CRM sync — this is a read of what Meta holds, one page at a time.\nReturns the count, the per-campaign split, the field names, and each lead's answers in the data payload.\nMeta expires lead data after 90 days. If a form shows leads but none come back, say that rather than reporting zero as if no one applied.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "structure",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "How many leads came in this week and from which campaign?",
          "Pull the submissions from this lead form"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
