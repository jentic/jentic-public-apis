    "/api/v1/tools/generate_report_now/execute": {
      "post": {
        "operationId": "generate_report_now",
        "summary": "Compose a performance report now",
        "description": "Composes a report from Adako's synced data and stores it, so it also has a permanent web page. Returns immediately — no platform calls, no waiting. Free.\nUse when: the user asks how a period went, wants a summary to forward, or asks for \"a report\" or \"a brief\" — including when they name one platform, because this covers every connected account and keeps the page.\nPrefer it over the per-platform performance tools whenever the answer is meant to be kept or sent on: those read one platform live and store nothing.\nDo not use when: the user asks about today — today is still syncing; use the live performance tools for \"right now\".\nreport_type: performance_brief (totals, per account, top campaigns), detailed_analysis (adds the biggest movers), executive_summary (totals and a few lines).\nPass either date_range or start_date + end_date, never both. Every period is compared with the equally long period immediately before it.\nPeriods follow each account's own timezone and cover complete days only: a day that has not ended in an account's timezone is left out, and the report says when an account's days differ from the headline period.\nReturns the report as markdown plus a link to its page. The user can email it to themselves from that page; for recurring delivery use schedule_brief.\nIf you are unsure which accounts, cadence or period the user means, ask rather than guessing.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "reporting",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Give me a report on last month across both platforms",
          "Give me a performance brief for the last 30 days",
          "Executive summary for the last 7 days",
          "Detailed analysis of the Google account for September"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "report_type": {
                        "type": "string",
                        "enum": [
                          "performance_brief",
                          "detailed_analysis",
                          "executive_summary"
                        ],
                        "description": "performance_brief: totals, per account and the top campaigns. detailed_analysis: adds the biggest movers. executive_summary: totals and three lines, nothing else."
                      },
                      "date_range": {
                        "description": "Preset range. Alternatively pass start_date and end_date (YYYY-MM-DD). Never both.",
                        "type": "string",
                        "enum": [
                          "today",
                          "yesterday",
                          "last_7_days",
                          "last_14_days",
                          "last_30_days",
                          "this_month",
                          "last_month"
                        ]
                      },
                      "start_date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "platforms": {
                        "description": "Which platforms to cover. Leave empty for every platform with an active account.",
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "google_ads",
                            "meta_ads",
                            "chatgpt_ads",
                            "tiktok_ads",
                            "linkedin_ads"
                          ]
                        }
                      },
                      "account_ids": {
                        "description": "Platform account ids to cover. Leave empty for every active account.",
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "delivery_email": {
                        "description": "Recorded on the report as its intended recipient. On-demand sending happens from the report page; use schedule_brief for recurring email.",
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "report_type"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
