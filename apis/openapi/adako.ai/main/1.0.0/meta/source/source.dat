    "/api/v1/tools/google_get_ad_performance/execute": {
      "post": {
        "operationId": "google_get_ad_performance",
        "summary": "Ad performance with a period comparison",
        "description": "Reports spend, clicks, CTR, conversions, CPA and ROAS for each ad, next to the immediately preceding period of the same length so the direction is visible.\nUse when: the user asks which ad or which creative is working, or before pausing an ad.\nDo not use when: the question is about keywords (google_get_keyword_performance), ad groups (google_get_ad_group_performance) or the copy itself (google_get_ad_creative).\nReturns one row per ad, most expensive first, with the ad strength Google assigns. Judge ads on conversions and CPA, not on CTR alone; and an ad with very few impressions has not been tested yet — say so rather than declaring a winner.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
