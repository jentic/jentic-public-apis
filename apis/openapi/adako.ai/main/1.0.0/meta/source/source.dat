    "/api/v1/tools/google_add_audience_signal/execute": {
      "post": {
        "operationId": "google_add_audience_signal",
        "summary": "Add an audience signal to an asset group",
        "description": "Adds an audience as a signal on a Performance Max asset group. A signal tells Google who to start with; it is not targeting and Google will serve well outside it.\nUse when: the account has a genuinely useful audience — a customer list, a converter list, a close in-market segment — and the user picked it from google_search_audiences.\nDo not use when: the user expects the campaign to stay inside that audience. It will not. If they want strict targeting, Performance Max is the wrong campaign type and a Search or Display campaign is the honest answer.\nPass an audience id from google_search_audiences. Adding a second identical signal is refused.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "audiences",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Use our customer list as an audience signal on asset group 555",
          "Add the in-market audience signal to this PMax campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
