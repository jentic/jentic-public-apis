              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/linkedin_create_carousel_campaign/execute": {
      "post": {
        "operationId": "linkedin_create_carousel_campaign",
        "summary": "Create a LinkedIn carousel campaign (ad set)",
        "description": "Builds a carousel sponsored-content campaign from two to ten square images, each with its own headline and destination — campaign group (a campaign in Campaign Manager), campaign (ad set), uploads, dark post and creative (ad). The campaign starts paused and holds everything back (LinkedIn creates groups and creatives only active or draft).\nUse when: the content is genuinely sequential (a process, a product range, several proof points). A carousel is more work than a single image and only beats one when each card earns its swipe.\nDo not use mixed aspect ratios: carousel cards render square (1200×1200) and anything else is cropped inconsistently across cards. Run linkedin_validate_assets on every URL first.\nDo not exceed ten cards or go below two — LinkedIn refuses both, and the refusal comes after the campaign has been created.\nDo not call it twice after a failure; it names what exists and linkedin_add_creative finishes it.\nReturns every id created. Nothing delivers until the user resumes the campaign. Say that the campaign is paused when you report the result, with the two links the result gives (LinkedIn Campaign Manager and the campaign's page in Adako), and offer \"enable all\": one linkedin_resume_campaign call, listed in the result as go_live.enable_all, one approval.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "create a LinkedIn carousel with these four images",
          "build a carousel ad for the product tour"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "description": "Campaign name."
                      },
                      "campaign_group_id": {
                        "description": "Existing campaign group id. Omit and a group named after the campaign is created first — prefer reusing one from linkedin_list_campaign_groups.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "BRAND_AWARENESS",
                          "WEBSITE_VISIT",
                          "ENGAGEMENT",
                          "VIDEO_VIEW",
                          "LEAD_GENERATION",
                          "WEBSITE_CONVERSION",
                          "JOB_APPLICANT"
                        ],
                        "description": "Campaign objective. It cannot be changed later — confirm it with linkedin_explain_objectives if unsure. LEAD_GENERATION is refused: its ads need a Lead Gen Form, which this server cannot attach yet."
                      },
                      "daily_budget": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily budget, a decimal in the account currency (50 means fifty). Must clear the LinkedIn per-currency minimum."
                      },
                      "total_budget": {
                        "description": "Optional lifetime ceiling for this campaign.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bid": {
