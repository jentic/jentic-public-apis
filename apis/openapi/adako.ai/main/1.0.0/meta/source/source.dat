    "/api/v1/tools/google_bulk_update_keyword_bids/execute": {
      "post": {
        "operationId": "google_bulk_update_keyword_bids",
        "summary": "Change many keyword bids at once",
        "description": "Sets the maximum CPC on up to 300 keywords in one call. Bids are decimals in the account currency; Adako converts them for Google.\nUse when: the campaign uses manual bidding and the user has given the new amounts, or approved amounts you proposed from google_get_keyword_performance.\nDo not use when: the campaign runs Smart Bidding (maximise conversions, target CPA, target ROAS). Keyword bids are ignored there, so setting them looks like an action but changes nothing — check the strategy with google_list_campaigns and say so instead.\nEach id is resolved first: the preview shows the keyword text and its current bid next to the new one, and keywords that already have the requested bid are skipped. Ids that are not keywords in this account are reported back.\nRaising bids raises cost per click immediately, so the effect on the daily budget is immediate too.\nIf you are unsure which account, campaign or period the user means, ask them — do not guess ids or dates.",
        "tags": [
          "Google Ads"
        ],
        "x-adako-risk": "destructive-write",
        "x-adako-cost": 1,
        "x-adako-category": "keywords",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Lower the bid to 0.80 on these 30 expensive keywords",
          "Raise bids on the converting keywords to 2.50"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "customer_id": {
                        "description": "Google Ads customer id (10 digits, dashes optional). Omit to use the primary account; list_connected_accounts shows the valid ids.",
                        "type": "string"
                      },
                      "bids": {
                        "minItems": 1,
                        "maxItems": 300,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "keyword_id": {
                              "type": "string",
                              "pattern": "^[0-9]+$",
                              "description": "Keyword criterion id."
                            },
                            "cpc_bid": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "New maximum CPC as a decimal in the account currency. Never micros. Rounded to the smallest amount Google bills in that currency."
                            }
                          },
                          "required": [
                            "keyword_id",
                            "cpc_bid"
                          ]
                        },
                        "description": "One entry per keyword, at most 300 per call."
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "bids"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
