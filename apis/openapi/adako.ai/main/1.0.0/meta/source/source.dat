                      },
                      "days": {
                        "description": "How many days to look at, ending yesterday. Default 14.",
                        "type": "integer",
                        "minimum": 7,
                        "maximum": 30
                      },
                      "min_spend": {
                        "description": "Ignore ads that spent less than this over the window. Default 0 (report everything).",
