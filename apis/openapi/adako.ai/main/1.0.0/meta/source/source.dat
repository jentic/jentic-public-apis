    "/api/v1/tools/usage_value_summary/execute": {
      "post": {
        "operationId": "usage_value_summary",
        "summary": "What this account has actually used Adako for",
        "description": "Summarises this user's real activity over a period: tasks by platform and by kind of work, reads versus writes, proposals created, approved, rejected and executed, the five most-used tools, and a plain statement of what those calls did. Free; reads Adako's own call log and proposal store.\nUse when: the user asks what they have used Adako for, whether it is earning its keep, or wants a summary before a renewal decision.\nWhen not to use: the user wants campaign results — that is a performance tool on the platform, not this.\nReturns counts only. It never estimates money saved or performance gained: Adako cannot attribute a result to a tool call, and inventing a number would be a lie the user might repeat.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "diagnostics",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "What have I used Adako for this month?",
          "Show me what we have done in the last 30 days.",
          "Is this subscription worth it?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "period": {
                        "default": "last_30_days",
                        "description": "this_month is the calendar month to date; last_30_days is a rolling window. Default last_30_days.",
                        "type": "string",
                        "enum": [
                          "this_month",
                          "last_30_days"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
