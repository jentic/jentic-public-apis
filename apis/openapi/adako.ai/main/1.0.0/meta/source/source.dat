    "/api/v1/tools/linkedin_create_campaign_group/execute": {
      "post": {
        "operationId": "linkedin_create_campaign_group",
        "summary": "Create a LinkedIn campaign group (Campaign Manager campaign)",
        "description": "Creates a campaign group (a campaign in Campaign Manager) — the container every LinkedIn campaign (ad set) must sit inside, and the place a shared lifetime budget can be set across several campaigns.\nUse when: starting a distinct initiative (a launch, a quarter, a market) that should be budgeted and reported as one thing, or when a create tool needs a group and no sensible existing one is there.\nDo not create a group per campaign: that is what campaigns are for, and a forest of one-campaign groups makes the account unreadable. Run linkedin_list_campaign_groups first and reuse.\nDo not set a total budget the user has not named. A group budget is a hard ceiling: when it is reached every campaign inside stops, whatever their own budgets say. LinkedIn only accepts a total budget together with an end date; if the user gave no end date, ask for one.\nThe group is created ACTIVE, because LinkedIn creates groups only as ACTIVE or DRAFT. It holds no campaigns, so nothing spends, and every campaign created inside it starts paused.\nReturns the group read back from LinkedIn.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "create a LinkedIn campaign group for the Q4 launch",
          "set up a group with a £10,000 total budget",
          "set up a new Campaign Manager campaign for the Q4 launch"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "description": "Group name as it appears in Campaign Manager. At most 200 bytes of UTF-8: about 200 Latin letters, fewer in scripts such as Japanese."
                      },
                      "total_budget": {
                        "description": "Lifetime ceiling across every campaign in the group, a decimal in the account currency. Only set it if the user named a number. Requires end_date.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "start_date": {
                        "description": "YYYY-MM-DD; defaults to today.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "YYYY-MM-DD, optional. Required when total_budget is set.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
