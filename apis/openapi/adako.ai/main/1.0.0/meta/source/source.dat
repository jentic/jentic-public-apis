    "/api/v1/tools/linkedin_create_image_campaign/execute": {
      "post": {
        "operationId": "linkedin_create_image_campaign",
        "summary": "Create a LinkedIn single-image campaign (ad set)",
        "description": "Builds a complete single-image sponsored-content campaign: campaign group (a campaign in Campaign Manager, reused or created), campaign (ad set), image upload, dark post authored by a company page, and the creative (ad). The campaign starts paused and holds everything back: LinkedIn creates groups and creatives only active or draft, so those are ACTIVE.\nUse when: the user has given an objective, a budget, an image URL, a destination URL, the post text, and targeting resolved through linkedin_search_targeting. Check the image with linkedin_validate_assets first; a failure mid-chain leaves a campaign behind with no ad in it. The preview counts the audience and refuses targeting under 300 members, so nothing is created against a spec LinkedIn would reject.\nDo not call it with targeting the user has not confirmed, or with any value you did not get from a resolver — LinkedIn takes URNs literally and a wrong one spends real money on the wrong people.\nDo not call it twice. If it fails partway it says exactly what exists; finish that with linkedin_add_creative rather than starting again, or the user pays for two campaigns.\nDo not pick the company page yourself when linkedin_get_organizations returns more than one — the page name is on the ad.\nReturns every id it created and the campaign read back. Nothing delivers until the campaign is resumed. Say that the campaign is paused when you report the result, with the two links the result gives (LinkedIn Campaign Manager and the campaign's page in Adako), and offer \"enable all\": one linkedin_resume_campaign call, listed in the result as go_live.enable_all, one approval.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "creation",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "create a LinkedIn ad for our demo page targeting marketing directors in the UK",
          "launch a paused single-image campaign with a £100 daily budget"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "description": "Campaign name."
                      },
                      "campaign_group_id": {
                        "description": "Existing campaign group id. Omit and a group named after the campaign is created first — prefer reusing one from linkedin_list_campaign_groups.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "objective": {
                        "type": "string",
                        "enum": [
                          "BRAND_AWARENESS",
                          "WEBSITE_VISIT",
                          "ENGAGEMENT",
                          "VIDEO_VIEW",
                          "LEAD_GENERATION",
                          "WEBSITE_CONVERSION",
                          "JOB_APPLICANT"
                        ],
                        "description": "Campaign objective. It cannot be changed later — confirm it with linkedin_explain_objectives if unsure. LEAD_GENERATION is refused: its ads need a Lead Gen Form, which this server cannot attach yet."
                      },
                      "daily_budget": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily budget, a decimal in the account currency (50 means fifty). Must clear the LinkedIn per-currency minimum."
                      },
                      "total_budget": {
                        "description": "Optional lifetime ceiling for this campaign.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bid": {
                        "description": "Manual bid, a decimal in the account currency: per click with cost_type CPC, per 1,000 impressions with CPM, per view with CPV. Setting it puts the campaign on manual bidding, where LinkedIn never bids above it. Omit it for LinkedIn's automated bidding, which optimises for the objective and always bills CPM. Text ads need a bid.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "cost_type": {
                        "description": "How a manual bid is billed; defaults to what the objective prefers. Only with bid: without one the campaign bids automatically and is billed CPM.",
                        "type": "string",
                        "enum": [
                          "CPM",
                          "CPC",
                          "CPV"
                        ]
                      },
                      "targeting": {
                        "type": "object",
                        "properties": {
                          "locations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "industries": {
