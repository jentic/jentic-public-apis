    "/api/v1/tools/meta_get_ad_set_targeting/execute": {
      "post": {
        "operationId": "meta_get_ad_set_targeting",
        "summary": "Show a Meta ad set’s targeting",
        "description": "Renders one ad set's targeting exactly as Meta holds it: locations, age, gender, detailed targeting, custom audiences, placements, devices and the Advantage+ audience setting.\nUse when: the user asks who an ad set reaches, or before meta_update_ad_set so the merge starts from a shared understanding.\nDo not use for performance — meta_get_adset_performance answers how it is doing.\nReturns both a readable table and the raw spec, so the ids needed for a later edit are already at hand.\nFree: this call does not cost a task.",
