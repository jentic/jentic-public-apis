                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/switch_primary_account/execute": {
      "post": {
        "operationId": "switch_primary_account",
        "summary": "Switch the primary ad account for a platform",
        "description": "Makes one account the primary account for its platform, the one later tools use when no account id is passed, and switches it on if it was inactive. Other active accounts stay active. When switching it on would go over the ad accounts the plan covers this billing period, the platform's previous primary is switched off to make room if that frees a place (it stays connected); otherwise the call fails with account_limit. Changes Adako settings only; nothing on the ad platform changes, so no proposal is created.\nUse when: the user says \"use account X from now on\", or a tool returned account_ambiguous or not_connected and the user confirmed which account they mean.\nNot for: manager accounts, which hold no campaigns. If you are unsure which account the user means, ask before switching.\nThe account must already be known to Adako (see list_connected_accounts).",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "system",
        "x-adako-since": "v1",
        "x-adako-examples": [
          "Use the Acme account by default",
          "Switch to customer 123-456-7890"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "platform": {
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads"
                        ]
                      },
                      "account_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Platform account id as shown by list_connected_accounts"
                      }
                    },
                    "required": [
                      "platform",
                      "account_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/test_monitor/execute": {
      "post": {
        "operationId": "test_monitor",
        "summary": "Dry-run a monitor against the last week",
        "description": "Runs a monitor — a saved one, or one described inline — against the synced data for each of the last 7 days and says which days it would have alerted on. Nothing is saved and no email is sent. Free.\nUse when: the user is choosing a threshold, or says an alert is too noisy or too quiet. Always dry-run an inline rule before create_monitor when the user is unsure of the number.\nReturns a day-by-day table with the value, the baseline and the verdict, plus the same one-line message the alert email would carry.\nPass monitor_id for a saved monitor, or the inline fields (platform, metric, operator, threshold) for a rule that does not exist yet.\nIf you are unsure which metric, account or threshold the user means, ask. Never invent a threshold.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Would an alert at ROAS below 2 have fired last week?",
          "Test my CPA monitor before I turn it on",
          "Is 80 a sensible CPA threshold for this account?"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "monitor_id": {
                        "description": "A saved monitor to dry-run. Omit to describe one inline.",
                        "type": "string",
                        "minLength": 8
                      },
                      "platform": {
                        "type": "string",
                        "enum": [
                          "google_ads",
                          "meta_ads",
                          "chatgpt_ads",
                          "tiktok_ads",
                          "linkedin_ads"
                        ],
                        "description": "Which ad platform the monitor watches."
                      },
                      "account_id": {
                        "description": "Platform account id (Google customer id, Meta act_…). Defaults to the primary active account on the platform.",
                        "type": "string",
                        "minLength": 1
                      },
                      "metric": {
                        "type": "string",
                        "enum": [
                          "spend",
                          "clicks",
                          "impressions",
                          "conversions",
                          "conv_value",
                          "ctr",
                          "cpc",
                          "cpa",
                          "cpm",
                          "roas",
                          "conversion_rate",
                          "cost_per_lead",
                          "budget_utilization"
                        ],
                        "description": "What to watch. Rates are computed from the window totals: ctr = clicks/impressions, cpc = spend/clicks, cpa = spend/conversions, cpm = spend per 1,000 impressions, roas = conversion value/spend, conversion_rate = conversions/clicks, cost_per_lead = spend/leads, budget_utilization = spend/daily budget."
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "less_than",
                          "greater_than",
                          "changes_by",
                          "drops_by",
                          "rises_by"
                        ],
                        "description": "How to compare. less_than/greater_than use the threshold as a level; changes_by, drops_by and rises_by read the threshold as a percent move against the baseline."
                      },
                      "threshold": {
                        "type": "number"
                      },
                      "threshold_type": {
                        "description": "absolute (default): the threshold is a value in the account currency or the metric's own unit. relative: the threshold is a multiplier of the baseline, so 0.5 means \"half of the usual\".",
                        "type": "string",
                        "enum": [
                          "absolute",
                          "relative"
                        ]
                      },
                      "baseline_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "consecutive_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 14
                      },
                      "campaign_ids": {
                        "description": "Platform campaign ids as strings. Leave empty to watch the whole account.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "conditions": {
                        "description": "Optional extra conditions, for example \"ROAS below 2 AND spend above 100\".",
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "and",
                              "or"
                            ],
                            "description": "How the extra conditions combine with the main one."
                          },
                          "conditions": {
                            "minItems": 1,
                            "maxItems": 3,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "metric": {
                                  "type": "string",
                                  "enum": [
                                    "spend",
                                    "clicks",
                                    "impressions",
                                    "conversions",
                                    "conv_value",
                                    "ctr",
                                    "cpc",
                                    "cpa",
                                    "cpm",
                                    "roas",
                                    "conversion_rate",
                                    "cost_per_lead",
                                    "budget_utilization"
                                  ],
                                  "description": "What to watch. Rates are computed from the window totals: ctr = clicks/impressions, cpc = spend/clicks, cpa = spend/conversions, cpm = spend per 1,000 impressions, roas = conversion value/spend, conversion_rate = conversions/clicks, cost_per_lead = spend/leads, budget_utilization = spend/daily budget."
                                },
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "less_than",
                                    "greater_than",
                                    "changes_by",
                                    "drops_by",
                                    "rises_by"
                                  ],
                                  "description": "How to compare. less_than/greater_than use the threshold as a level; changes_by, drops_by and rises_by read the threshold as a percent move against the baseline."
                                },
                                "threshold": {
                                  "type": "number"
                                },
                                "thresholdType": {
                                  "type": "string",
                                  "enum": [
                                    "absolute",
                                    "relative"
                                  ]
                                }
                              },
                              "required": [
                                "metric",
                                "operator",
                                "threshold"
                              ]
                            }
                          }
                        },
                        "required": [
                          "mode",
                          "conditions"
                        ]
                      },
                      "days": {
                        "description": "How many past days to test. Default 7.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 14
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/update_monitor/execute": {
      "post": {
        "operationId": "update_monitor",
        "summary": "Change or pause a monitor",
        "description": "Changes a monitor's threshold, rule or on/off state. Adako settings only; nothing on the ad platform changes.\nUse when: the user says the alert is too noisy, wants a different number, or wants it switched off for a while.\nDo not use when: the user wants the monitor gone for good — that is delete_monitor, and it needs confirm_delete.\nPass only the fields that change; everything else is left alone. Returns the monitor with its new rule in plain words.\nIf you are unsure which metric, account or threshold the user means, ask. Never invent a threshold.",
        "tags": [
          "Adako"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 0,
        "x-adako-category": "monitoring",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Pause the ROAS monitor",
          "Change the CPA alert to 95",
          "Turn my spend monitor back on"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "monitor_id": {
                        "type": "string",
                        "minLength": 8,
                        "description": "Id from list_monitors."
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "metric": {
                        "type": "string",
                        "enum": [
                          "spend",
                          "clicks",
                          "impressions",
                          "conversions",
                          "conv_value",
                          "ctr",
                          "cpc",
                          "cpa",
                          "cpm",
                          "roas",
                          "conversion_rate",
                          "cost_per_lead",
                          "budget_utilization"
                        ],
                        "description": "What to watch. Rates are computed from the window totals: ctr = clicks/impressions, cpc = spend/clicks, cpa = spend/conversions, cpm = spend per 1,000 impressions, roas = conversion value/spend, conversion_rate = conversions/clicks, cost_per_lead = spend/leads, budget_utilization = spend/daily budget."
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "less_than",
                          "greater_than",
                          "changes_by",
                          "drops_by",
                          "rises_by"
                        ],
                        "description": "How to compare. less_than/greater_than use the threshold as a level; changes_by, drops_by and rises_by read the threshold as a percent move against the baseline."
                      },
                      "threshold": {
                        "type": "number"
                      },
                      "threshold_type": {
                        "description": "absolute (default): the threshold is a value in the account currency or the metric's own unit. relative: the threshold is a multiplier of the baseline, so 0.5 means \"half of the usual\".",
                        "type": "string",
                        "enum": [
                          "absolute",
                          "relative"
                        ]
                      },
                      "baseline_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      },
                      "consecutive_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 14
                      },
                      "campaign_ids": {
                        "description": "Platform campaign ids as strings. Leave empty to watch the whole account.",
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "notify_email": {
                        "description": "Where to send the alert. Defaults to the account owner’s email. Any other address gets a confirmation link first, and alerts go to the owner’s email until someone at that address confirms.",
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "enabled": {
                        "description": "false pauses the monitor without deleting it.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "monitor_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
