              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/linkedin_update_campaign_group/execute": {
      "post": {
        "operationId": "linkedin_update_campaign_group",
        "summary": "Edit a LinkedIn campaign group (Campaign Manager campaign)",
        "description": "Changes the name, lifetime budget, run dates or status of a campaign group (a campaign in Campaign Manager).\nUse when: the shared ceiling across several campaigns needs to move, or a whole initiative should stop or start at once. Changing the group is the efficient way to act on many campaigns together.\nDo not lower a group budget below what it has already spent: every campaign inside stops immediately and lowering it further will not bring them back. Check spend with linkedin_get_campaign_performance first.\nDo not pause a group to stop one campaign — that takes everything inside down with it. Use linkedin_pause_campaign.\nSetting the group ACTIVE does not start anything on its own: each campaign inside keeps its own status. Setting it PAUSED stops everything inside regardless of theirs.\nReturns the group read back from LinkedIn.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 1,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "raise the total budget on this LinkedIn campaign group",
          "set an end date on the Q4 group",
          "raise the total budget on this Campaign Manager campaign"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "campaign_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "The campaign group to edit. LinkedIn ids are numeric strings; a full urn:li:… value is also accepted."
                      },
                      "name": {
                        "description": "New group name, at most 200 bytes of UTF-8.",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255
                      },
                      "total_budget": {
                        "description": "New lifetime ceiling across the group. LinkedIn requires an end date with it: pass end_date too if the group has none.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "status": {
                        "description": "New group status. PAUSED stops every campaign inside; ACTIVE only lifts the block.",
                        "type": "string",
                        "enum": [
                          "ACTIVE",
                          "PAUSED"
                        ]
                      },
                      "start_date": {
                        "description": "New start date, YYYY-MM-DD.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end_date": {
                        "description": "New end date, YYYY-MM-DD.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_group_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/linkedin_validate_assets/execute": {
      "post": {
        "operationId": "linkedin_validate_assets",
        "summary": "Check images before a LinkedIn ad is built",
        "description": "Checks image URLs against LinkedIn's sponsored-content specs before anything is created: reachable over https, an accepted file type, under the size limit, and either 1.91:1 (1200×627) or square (1200×1200) so the feed does not choose its own crop.\nUse when: the user supplies creative URLs, and always before linkedin_create_image_campaign or linkedin_add_creative. An image that fails here fails mid-way through a create, after the campaign has already been made — which leaves half a campaign behind.\nDo not treat a warning as a blocker: a non-standard ratio uploads fine and simply gets cropped, and the user may be happy with that. Errors are blockers; warnings are the user's call.\nDo not use it for video — LinkedIn's video specs are not checked here.\nReturns per-URL content type, byte size, dimensions, which recommended size it matches, and separate error and warning lists. Costs nothing and downloads only the file header.\nIf dimensions cannot be read, say so plainly rather than assuming the image is fine.",
        "tags": [
          "LinkedIn Ads"
        ],
        "x-adako-risk": "read-only",
        "x-adako-cost": 0,
        "x-adako-category": "assets",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "is this image the right size for a LinkedIn ad?",
          "check these creative URLs before I launch"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "LinkedIn ad account id — the numeric id from Campaign Manager, as a string (\"506699162\"). Omit it to use the primary account; pass it when the user manages several.",
                        "type": "string"
                      },
                      "image_urls": {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "description": "The images to check. Adako hosts no files: the platform downloads this URL itself, from its own servers and often hours later, so it must be a public link straight to the file — not a file on the computer, not a Drive, Dropbox or design-tool share page, not a link that expires or asks for a login. Call check_media first: it repairs the usual share links, checks the file against this platform, and says where to put a file that has no link yet."
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "image_urls"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Monthly task quota used up, or the plan does not include this tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The connected ad account lacks the access level this tool needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Not connected, reconnect needed, confirmation required, a proposal already pending or no longer pending, an identical create that failed earlier today (proposal_failed_before), a create that duplicates an approved one (duplicate_create), the ad-account limit of the plan reached (account_limit), or an Idempotency-Key reused with different arguments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by Adako or by the ad platform. See Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error inside Adako.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The ad platform returned an error.",
            "content": {
