                      },
                      "end_date": {
                        "description": "Last day of the period (YYYY-MM-DD). Use with start_date.",
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "min_spend": {
                        "description": "Minimum spend (decimal, in the account currency) for a keyword to count. Raised to the floor — the cost of 20 average clicks in this account over the period — if lower. Default: that floor.",
                        "type": "number",
                        "minimum": 0
                      },
                      "limit": {
                        "description": "How many keyword rows to scan, by spend (default 300).",
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 500
                      }
                    }
                  }
                }
              }
            }
