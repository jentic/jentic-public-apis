    "/api/v1/tools/meta_duplicate_campaign/execute": {
      "post": {
        "operationId": "meta_duplicate_campaign",
        "summary": "Duplicate a Meta campaign (paused)",
        "description": "Copies one campaign with Meta's own duplication, always PAUSED and always renamed with a suffix so the two are never confused. A deep copy brings the ad sets and ads with it; a shallow copy takes the campaign row only.\nUse when: the user wants a second version of something that already works — a new audience, a new market, a new flight — without rebuilding it by hand.\nDo not use to make a small change to the original: editing is meta_update_campaign, meta_update_ad_set or meta_update_ad. Two nearly identical live campaigns bid against each other.\nDo not deep-copy a very large campaign casually: Meta runs it in the background and the copy can take minutes; the tool reports the job rather than inventing ids.\nReturns the new campaign id, the copied child ids where Meta returned them, and reads the copy back to confirm it is paused.\nThe copy never inherits ACTIVE status, whatever the original was.",
        "tags": [
          "Meta Ads"
        ],
        "x-adako-risk": "write",
        "x-adako-cost": 3,
        "x-adako-category": "management",
        "x-adako-since": "v2",
        "x-adako-examples": [
          "Duplicate this campaign so I can test a different audience",
          "Clone the winning campaign and pause the copy"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional 8-128 character key. A successful envelope is cached for 24 hours; replaying the key with the same arguments returns it again with Idempotent-Replayed: true, and replaying it with different arguments answers 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "arguments": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "ad_account_id": {
                        "description": "Meta ad account id such as act_1234567890. Omit it to use the primary account; if several accounts are active and none is primary the call fails and lists the valid ids.",
                        "type": "string"
                      },
                      "campaign_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]+$",
                        "description": "The campaign to copy, from meta_list_campaigns."
                      },
                      "name_suffix": {
                        "description": "Appended to the copied names. Defaults to \" — copy\".",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "deep_copy": {
                        "description": "Copy the ad sets and ads too. Defaults to true — a campaign with no ad sets cannot be tested.",
                        "type": "boolean"
                      },
                      "start_time": {
                        "description": "Start time for the copied ad sets: YYYY-MM-DD (00:00 in the ad account's time zone) or an ISO timestamp with a UTC offset. Not in the past.",
                        "type": "string"
                      },
                      "end_time": {
                        "description": "End time for the copied ad sets: YYYY-MM-DD (23:59:59 in the ad account's time zone) or an ISO timestamp with a UTC offset.",
                        "type": "string"
                      },
                      "idempotency_key": {
                        "description": "Optional caller-supplied key; identical keys never execute twice.",
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                      },
                      "raw_data": {
                        "description": "Return compact JSON only (no markdown). Use when you will compute on the result.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "campaign_id"
                    ]
                  }
                },
                "required": [
                  "arguments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool ran. A write returns proposal_id and approve_url while the change waits for approval.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Trace id for this call."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present when the body came from the idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the ad account could not be resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
