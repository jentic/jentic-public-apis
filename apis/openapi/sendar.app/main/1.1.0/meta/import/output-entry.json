    "/emails/batch": {
      "post": {
        "operationId": "sendBatchEmails",
        "tags": [
          "emails"
        ],
        "summary": "Send up to 100 emails in one request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/BatchEmailItem"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Emails accepted and queued for delivery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchSendResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or content; inspect error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked credentials.",
            "content": {
              "application/json": {
