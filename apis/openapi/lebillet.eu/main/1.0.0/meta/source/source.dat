{
  "openapi": "3.0.3",
  "info": {
    "title": "LeBillet - API de Assentos",
    "description": "API para listagem, reserva e ativação de assentos de eventos.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ClickCob/lebillet-api-de-assentos/1.0.0"
  },
  "servers": [
    {
      "url": "https://lebillet.eu",
      "description": "Produção"
    }
  ],
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/api_seats/seats/{id_event}": {
      "get": {
        "summary": "Listar assentos disponíveis",
        "description": "Retorna todos os assentos disponíveis para um evento específico.",
        "parameters": [
          {
            "name": "id_event",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "event_id": {
                      "type": "integer",
                      "example": 1
                    },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "777"
                          },
                          "row": {
                            "type": "string",
                            "example": "A"
                          },
                          "number": {
                            "type": "string",
                            "example": "10"
                          },
                          "status": {
                            "type": "string",
                            "example": "available"
                          },
                          "value": {
                            "type": "string",
                            "example": "10.00"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado"
          }
        }
      }
    },
    "/api_seats/reserveSeat": {
      "post": {
        "summary": "Reservar assento",
        "description": "Realiza o bloqueio temporário de um assento.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "id_event"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "777"
                  },
                  "id_event": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assento reservado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Assento reservado com sucesso"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 900
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Assento indisponível"
          }
        }
      }
    },
    "/api_seats/activeSeat": {
      "post": {
        "summary": "Ativar assento",
        "description": "Confirma a compra do assento reservado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "id_event",
                  "code",
                  "value_product",
                  "value_tax",
                  "value_discount",
                  "value_total",
                  "email_customer",
                  "cell_number_customer"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "777"
                  },
                  "id_event": {
                    "type": "integer",
                    "example": 1
                  },
                  "code": {
                    "type": "string",
                    "example": "000000"
                  },
                  "value_product": {
                    "type": "string",
                    "example": "10.00"
                  },
                  "value_tax": {
                    "type": "string",
                    "example": "0.90"
                  },
                  "value_discount": {
                    "type": "string",
                    "example": "0.00"
                  },
                  "value_total": {
                    "type": "string",
                    "example": "10.90"
                  },
                  "email_customer": {
                    "type": "string",
                    "example": "teste@gmail.com"
                  },
                  "cell_number_customer": {
                    "type": "string",
                    "example": "+351999999999"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assento ativado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Assento ativado com sucesso"
                    },
                    "sale": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "example": "000000"
                        },
                        "seat_id": {
                          "type": "string",
                          "example": "777"
                        },
                        "event_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "value_total": {
                          "type": "string",
                          "example": "10.90"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          }
        }
      }
    }
  }
}
