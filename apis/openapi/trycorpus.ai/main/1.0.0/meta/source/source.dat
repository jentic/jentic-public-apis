    "/v1/attestations": {
      "get": {
        "operationId": "listAttestations",
        "tags": [
          "discovery"
        ],
        "summary": "Daily on-chain attestations of the fixing set (free).",
        "description": "One record per store day: the keccak256 of the day's signed fixings file (served at /attest/<day>.json), the Ethereum Attestation Service UID and transaction on Base (eip155:8453), the publisher address and the schema UID. Re-hash the file bytes and compare with fixingsHash to verify; every row inside the file carries its own EIP-712 signature. See /governance.",
        "security": [],
        "responses": {
          "200": {
            "description": "Attestations, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "publisher": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "chain": {
                      "type": "string"
                    },
                    "eas": {
                      "type": "string"
                    },
                    "schemaUid": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "attestations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": {
                            "type": "string",
                            "format": "date"
                          },
                          "methodology": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer"
                          },
                          "fixingsHash": {
                            "type": "string"
                          },
                          "uri": {
                            "type": "string"
                          },
                          "tx": {
                            "type": "string"
                          },
                          "uid": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "attested_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/capacity/headline": {
      "get": {
        "operationId": "getCapacityHeadline",
        "tags": [
          "capacity"
        ],
        "summary": "Capacity stress score per GPU model for the latest day, score only (free).",
        "description": "Rounded score from 0 (slack) to 100 (tight) per GPU with at least two signals, tightest first, cached ten minutes. The components and their inputs are in the paid /capacity/stress and /capacity/board.",
        "responses": {
          "200": {
            "description": "Scores.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "day": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "methodology": {
                      "type": "string"
                    },
                    "scale": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gpu": {
                            "type": "string"
                          },
                          "score": {
                            "type": "integer"
                          },
                          "signals": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The store is still warming up after a restart; retry in a minute. No payment is taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
