            "schema": {
              "type": "string"
            }
          },
          {
            "name": "market",
            "in": "query",
            "description": "Restrict to one market (`ondemand`, `spot`, `bid`, `secure`, `community`, `network`, `lease`, `executed`).",
            "schema": {
