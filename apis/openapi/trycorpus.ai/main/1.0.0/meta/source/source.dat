                    {
                      "scheme": "exact",
                      "network": "eip155:146",
                      "asset": "0x29219dd400f2Bf60E5a23d13Be72B486D4038894",
                      "amount": "10000",
                      "payTo": "0x3f60008Dfd0EfC03F476D9B489D6C5B13B3eBF2C",
