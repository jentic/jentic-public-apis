                    },
                    {
                      "scheme": "exact",
                      "network": "eip155:480",
                      "asset": "0x79A02482A880bCE3F13e09Da970dC34db4CD24d1",
                      "amount": "10000",
                      "payTo": "0x3f60008Dfd0EfC03F476D9B489D6C5B13B3eBF2C",
                      "maxTimeoutSeconds": 604900
                    },
                    {
                      "scheme": "exact",
                      "network": "eip155:1329",
                      "asset": "0xe15fC38F6D8c56aF07bbCBe3BAf5708A2Bf42392",
