{
  "openapi": "3.0.3",
  "info": {
    "title": "Wibl Provider API",
    "description": "REST API for the Wibl platform. Covers authentication, locations, ordering,\npayment, and cashpoints/wallet.\n\n**Status legend used in this document:**\n- `[existing]` — endpoint is live\n- `[proposed]` — endpoint does not exist yet, planned for implementation\n",
    "version": "0.6.0",
    "contact": {
      "name": "Wibl"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Injected-Reality/wibl-provider-api/0.6.0"
  },
  "servers": [
    {
      "url": "https://api.wibl.4up.no",
      "description": "Production"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and user identity"
    },
    {
      "name": "Locations",
      "description": "Companies, locations, and map data"
    },
    {
      "name": "Menu",
      "description": "Menus, products, allergens"
    },
    {
      "name": "Session",
      "description": "Table sessions and ordering flow (customer-facing)"
    },
    {
      "name": "Payment",
      "description": "Payment methods and checkout"
    },
    {
      "name": "Wallet",
      "description": "Cashpoints and wallet management [proposed]"
    },
    {
      "name": "Notifications",
      "description": "Push notification settings"
    }
  ],
  "paths": {
    "/api/token/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Obtain JWT token pair [existing]",
        "description": "Phone/email + password login. Returns access and refresh tokens.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/token/anon/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Obtain anonymous JWT token pair [existing]",
        "description": "Creates an anonymous user and returns a token pair. Used before registration.",
        "security": [],
        "responses": {
          "200": {
            "description": "Token pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          }
        }
      }
    },
    "/api/token/refresh/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh access token [existing]",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh"
                ],
                "properties": {
                  "refresh": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/token/verify/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify a token [existing]",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token is valid"
          }
        }
      }
    },
    "/api/me/": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current user [existing]",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update current user [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/sms/{action}/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "SMS verification [existing]",
        "description": "Actions:\n- `request` — send a verification code to a phone number\n- `verify` — verify the code and return a token pair\n",
        "security": [],
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "request",
                "verify"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SmsRequest"
                  },
                  {
                    "$ref": "#/components/schemas/SmsVerify"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/password-reset/": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request password reset email [existing]",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent"
          }
        }
      }
    },
    "/api/locations/": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "List locations [existing]",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated location list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedLocations"
                }
              }
            }
          }
        }
      }
    },
    "/api/locations/{id}/": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "Retrieve a location [existing]",
        "parameters": [
          {
            "$ref": "#/components/parameters/UUIDPathParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Location detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          }
        }
      }
    },
    "/api/location_map_markers/": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "Get map markers for all locations [existing]",
        "description": "Lightweight endpoint for map pins — returns coordinates and basic info only.",
        "responses": {
          "200": {
            "description": "List of map markers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocationMapMarker"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/companies/{id}/": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "Retrieve a company [existing]",
        "parameters": [
          {
            "$ref": "#/components/parameters/UUIDPathParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Company detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          }
        }
      }
    },
    "/api/locationmenu/{id}/": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Get full menu for a location [existing]",
        "parameters": [
          {
            "$ref": "#/components/parameters/UUIDPathParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Full location menu with segments and items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationMenu"
                }
              }
            }
          }
        }
      }
    },
    "/api/allergens/": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "List all allergens [existing]",
        "responses": {
          "200": {
            "description": "Allergen list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Allergen"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/join-table/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Join a table [existing]",
        "description": "Creates or joins an active serving session for a given table.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "locationId",
                  "tableNumber"
                ],
                "properties": {
                  "locationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "tableNumber": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "addWaiterAsParticipant": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/add-order/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Add items to order [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "menuItems"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "menuItems": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/components/schemas/CartItem"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/remove-order/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Remove an item from the order [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "productOrderId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "productOrderId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/update-order/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Update quantity of an order item [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "productOrderId",
                  "quantity"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "productOrderId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/send-orders-to-kitchen/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Confirm and send orders to kitchen [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "waiter": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servingsessions/skip-wait-for-table/": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Skip waiting for other table participants [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated serving session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServingSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/payment_methods/": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "List saved payment methods [existing]",
        "responses": {
          "200": {
            "description": "List of payment methods",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentMethod"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stripe/{action}/": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Stripe payment actions [existing]",
        "description": "Actions include creating payment intents and confirming payments.\n",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stripe response"
          }
        }
      }
    },
    "/api/cash/": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Register a cash payment [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment registered"
          }
        }
      }
    },
    "/api/cashpoints/wallets/": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "List all wallets for the authenticated user [proposed]",
        "description": "Returns one wallet per company the user has earned cashpoints at.\nEach wallet contains all cashpoints earned at that company, with\nlocation-scoping indicated per cashpoint.\n\nCashpoints with `location: null` are usable at any location belonging\nto the company. Cashpoints with a `location` set are locked to that\nspecific location.\n",
        "responses": {
          "200": {
            "description": "List of wallets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Wallet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cashpoints/wallets/{id}/": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "Retrieve a single wallet [proposed]",
        "parameters": [
          {
            "$ref": "#/components/parameters/UUIDPathParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/cashpoints/redeem/": {
      "post": {
        "tags": [
          "Wallet"
        ],
        "summary": "Redeem cashpoints against a cart [proposed]",
        "description": "Applies cashpoints as a discount against the provided cart total.\nThe backend validates that:\n- The user has sufficient balance in their wallet for the given company\n- The requested amount does not exceed `max_redeem_pct` of the cart total\n- Location-locked cashpoints are only applied when redeeming at that location\n\nOn success, the cashpoints are deducted and the response includes the\ndiscounted total ready for payment processing.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redemption result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemResult"
                }
              }
            }
          },
          "400": {
            "description": "Insufficient balance or invalid amount",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications_settings/": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Get notification settings for current user [existing]",
        "responses": {
          "200": {
            "description": "Notification settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettings"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Notifications"
        ],
        "summary": "Update notification settings [existing]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated notification settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettings"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Register FCM device token [existing]",
        "description": "Registers a Firebase Cloud Messaging device token for push notifications.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationId",
                  "type"
                ],
                "properties": {
                  "registrationId": {
                    "type": "string",
                    "description": "FCM device token"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "android",
                      "ios",
                      "web"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device registered"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "UUIDPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication credentials were not provided or are invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "TokenPair": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string"
          },
          "refresh": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "isAnon": {
            "type": "boolean"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "SmsRequest": {
        "type": "object",
        "required": [
          "phone"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 format, e.g. +4712345678"
          }
        }
      },
      "SmsVerify": {
        "type": "object",
        "required": [
          "phone",
          "code"
        ],
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "country": {
            "$ref": "#/components/schemas/Country"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "point": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "cuisines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cuisine"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            }
          },
          "openingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHoursPeriod"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationImage"
            }
          }
        }
      },
      "LocationMapMarker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "point": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "companyLogo": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        }
      },
      "PaginatedLocations": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "next": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "previous": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          }
        }
      },
      "GeoPoint": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Point"
            ]
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[longitude, latitude]"
          }
        }
      },
      "OpeningHoursPeriod": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0=Monday, 6=Sunday"
          },
          "openTime": {
            "type": "string",
            "format": "time"
          },
          "closeTime": {
            "type": "string",
            "format": "time"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "LocationImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Cuisine": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Feature": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Currency": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOK"
          },
          "name": {
            "type": "string",
            "example": "Norwegian Krone"
          }
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "NO"
          }
        }
      },
      "LocationMenu": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "type": "string",
            "format": "uuid"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuSegment"
            }
          }
        }
      },
      "MenuSegment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "description": "Decimal string, e.g. \"149.00\""
          },
          "currency": {
            "type": "string",
            "example": "NOK"
          },
          "vatRate": {
            "type": "number",
            "nullable": true
          },
          "allergens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "accessoryGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccessoryGroup"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "AccessoryGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "Allergen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ServingSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "type": "string",
            "format": "uuid"
          },
          "hasOrdered": {
            "type": "boolean"
          },
          "sentToKitchenTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionParticipant"
            }
          },
          "productOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionProductOrder"
            }
          }
        }
      },
      "SessionParticipant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user": {
            "type": "string",
            "format": "uuid"
          },
          "guestNumber": {
            "type": "integer"
          },
          "hasOrdered": {
            "type": "boolean"
          },
          "showMessageReadyToOrder": {
            "type": "boolean"
          },
          "showMessageOrderSentToKitchen": {
            "type": "boolean"
          }
        }
      },
      "SessionProductOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "menuItem": {
            "$ref": "#/components/schemas/MenuItem"
          },
          "quantity": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "waiting",
              "claimed",
              "done"
            ]
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "participant": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "accessories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "CartItem": {
        "type": "object",
        "required": [
          "menuItemId",
          "quantity"
        ],
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "accessories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "accessoryId"
              ],
              "properties": {
                "accessoryId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "participantId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "card",
              "vipps",
              "mobilepay"
            ]
          },
          "last4": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "isDefault": {
            "type": "boolean"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "description": "A wallet groups all cashpoints a user has earned at a given company.\nOne wallet per user per company.\n",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "totalBalance": {
            "type": "string",
            "description": "Aggregate spendable balance across all cashpoints in this wallet,\nin the company's currency. Decimal string, e.g. \"42.50\".\n"
          },
          "currency": {
            "type": "string",
            "example": "NOK"
          },
          "cashpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cashpoint"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Cashpoint": {
        "type": "object",
        "description": "An individual cashpoint batch within a wallet.\n\n`location` scoping:\n- `null` — usable at any location belonging to the wallet's company\n- set    — locked to that specific location only\n\n`pointType` values:\n- `cashback` — standard earned cashback (current)\n- `outbound` — cross-restaurant O-Points (future)\n- `locked`   — return-loop L-Points locked to origin (future)\n- `network`  — fungible N-Points across the network (future)\n",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "balance": {
            "type": "string",
            "description": "Decimal string, e.g. \"15.00\""
          },
          "currency": {
            "type": "string",
            "example": "NOK"
          },
          "location": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LocationSummary"
              }
            ],
            "nullable": true,
            "description": "If null, cashpoint is usable at any location of the company"
          },
          "pointType": {
            "type": "string",
            "enum": [
              "cashback",
              "outbound",
              "locked",
              "network"
            ],
            "default": "cashback"
          },
          "earnedFromAction": {
            "type": "string",
            "nullable": true,
            "enum": [
              "cashback_reward",
              "after_first_purchase",
              "invite_a_friend",
              "share_wibl_location",
              "rated_wibl_location",
              "other"
            ]
          },
          "earnedFromDeal": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "ID of the offer/deal that triggered this cashpoint, if any"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LocationSummary": {
        "type": "object",
        "description": "Minimal location representation used inside nested responses",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RedeemRequest": {
        "type": "object",
        "required": [
          "walletId",
          "locationId",
          "amount"
        ],
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid",
            "description": "The wallet to draw cashpoints from"
          },
          "locationId": {
            "type": "string",
            "format": "uuid",
            "description": "The location where the redemption is happening"
          },
          "amount": {
            "type": "string",
            "description": "Currency amount to redeem, as a decimal string, e.g. \"20.00\".\nMust not exceed 30% of cartTotal.\n"
          },
          "cartTotal": {
            "type": "string",
            "description": "Total value of the cart before discount, as a decimal string.\nUsed to validate the redemption cap. Required if cap enforcement\nis desired.\n"
          }
        }
      },
      "RedeemResult": {
        "type": "object",
        "properties": {
          "redeemedAmount": {
            "type": "string",
            "description": "Amount actually deducted from the wallet"
          },
          "remainingBalance": {
            "type": "string",
            "description": "Wallet total balance after redemption"
          },
          "discountedTotal": {
            "type": "string",
            "description": "Cart total after cashpoint discount applied"
          },
          "cashpointsUsed": {
            "type": "array",
            "description": "Which individual cashpoint records were drawn from",
            "items": {
              "type": "object",
              "properties": {
                "cashpointId": {
                  "type": "string",
                  "format": "uuid"
                },
                "amountUsed": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "orderReady": {
            "type": "boolean"
          },
          "promotions": {
            "type": "boolean"
          },
          "cashpointsEarned": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
