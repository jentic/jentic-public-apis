            "type": "string"
          },
          "defaultCurrency": {
            "type": "string"
          },
          "vatRateBps": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "country",
          "defaultCurrency",
          "createdAt",
          "updatedAt"
        ]
      },
      "DashboardSummary": {
        "type": "object",
