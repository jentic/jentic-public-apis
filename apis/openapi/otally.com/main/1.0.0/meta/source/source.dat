    "/v1/businesses/{businessId}/invoices/upload": {
      "parameters": [
        {
          "$ref": "#/components/parameters/businessId"
        }
      ],
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Import your invoices",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The CSV file to upload"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "text/csv"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully populated your invoices"
          }
        }
      }
    },
