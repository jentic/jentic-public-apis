          },
          "address": {
            "type": "object",
            "properties": {
              "line1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "postalCode": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "name",
          "country",
          "defaultCurrency"
        ]
      },
