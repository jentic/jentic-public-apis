{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounting SaaS MVP API",
    "version": "1.0.0",
    "description": "API-first endpoints to support onboarding, sales (customers/invoices), expenses (with receipts), banking (manual transactions + categorization), tax engine + tax ledger (VAT input/output, WHT), team/roles, activity log, and reports.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/otally/Otally/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.otally.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Businesses"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Customers"
    },
    {
      "name": "Invoices"
    },
    {
      "name": "Expenses"
    },
    {
      "name": "Banking"
    },
    {
      "name": "Tax"
    },
    {
      "name": "Team"
    },
    {
      "name": "Roles"
    },
    {
      "name": "ActivityLog"
    },
    {
      "name": "Reports"
    }
  ],
  "paths": {
    "/v1/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
