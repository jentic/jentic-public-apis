    "/iot/v2/crashdumps": {
      "get": {
        "tags": [
          "IoT Crashdumps"
        ],
        "description": "Retrieve stored crashdumps for diagnostics",
        "operationId": "get_crashdump",
        "responses": {
          "200": {
            "description": "List of crashdumps",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Crashdump"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "IoT Crashdumps"
        ],
        "description": "Upload a compressed crashdump generated by a device",
        "operationId": "create_crashdump",
        "requestBody": {
          "description": "Multipart form with a binary crashdump file and optional JSON metadata.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "crashdump",
                  "metadata"
                ],
                "properties": {
                  "crashdump": {
                    "type": "string",
                    "format": "binary"
                  },
                  "metadata": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "JSON metadata string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Crashdump stored"
          },
          "400": {
            "description": "Invalid crashdump payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
