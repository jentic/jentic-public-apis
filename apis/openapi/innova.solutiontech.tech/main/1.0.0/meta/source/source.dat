              "schema": {
                "$ref": "#/components/schemas/RegisterNodesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Nodes registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceResponse"
                  }
