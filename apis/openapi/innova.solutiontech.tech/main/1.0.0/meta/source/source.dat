            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/iot/v2/firmwares/update": {
      "get": {
        "tags": [
          "IoT Firmwares"
        ],
        "description": "Check whether newer firmware is available for the device",
        "operationId": "check_firmware_update",
        "parameters": [
          {
            "name": "gateway",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "main",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Firmware update availability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirmwareUpdateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/iot/v2/firmwares/{firmware_id}": {
      "get": {
        "tags": [
          "IoT Firmwares"
        ],
        "description": "Download firmware binary by its unique identifier",
        "operationId": "get_firmware_by_id",
        "parameters": [
          {
            "name": "firmware_id",
            "in": "path",
            "description": "Firmware unique identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Firmware binary",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "Firmware not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalendarConfigurationResponse": {
        "type": "object",
        "required": [
          "macAddress",
          "nodeId",
          "preset",
          "configuration"
        ],
        "properties": {
          "configuration": {},
          "macAddress": {
            "type": "string",
            "format": "mac",
            "example": "00:1A:2B:3C:4D:5E"
          },
          "nodeId": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "preset": {
            "$ref": "#/components/schemas/Preset"
          }
        }
      },
      "CalendarResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "schedules",
          "configurations"
        ],
        "properties": {
          "configurations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarConfigurationResponse"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarScheduleResponse"
            }
          }
        }
      },
      "CalendarSchedule": {
        "type": "object",
        "required": [
          "preset",
          "days",
          "schedule"
        ],
        "properties": {
          "days": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "preset": {
            "$ref": "#/components/schemas/Preset"
          },
          "schedule": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CalendarScheduleResponse": {
        "type": "object",
        "required": [
          "preset",
          "days",
          "schedule"
        ],
        "properties": {
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "preset": {
            "$ref": "#/components/schemas/Preset"
          },
          "schedule": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "Crashdump": {
        "type": "object",
        "required": [
          "id",
          "mac_address",
          "saved_at",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mac_address": {
            "type": "string",
            "format": "mac-address"
          },
          "metadata": {},
          "saved_at": {
            "type": "string",
            "format": "date-time"
          },
          "serial_number": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CrashdumpUploadSchema": {
        "type": "object",
        "required": [
          "crashdump",
          "metadata"
        ],
        "properties": {
          "crashdump": {
            "type": "string",
            "format": "binary"
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ],
            "format": "JSON metadata string"
          }
        }
      },
      "CreateCalendarRequest": {
        "type": "object",
        "required": [
          "name",
          "homeId"
        ],
        "properties": {
          "homeId": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDeviceRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CreateHomeRequest": {
        "type": "object",
        "required": [
          "name",
          "timezone"
        ],
        "properties": {
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HomeLocationRequest"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "CreateInviteRequest": {
        "type": "object",
        "required": [
          "email",
          "homeId",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "homeId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/UserHomeRole"
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "homeId",
          "name"
        ],
        "properties": {
          "homeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "firstname",
          "lastname",
          "password",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "DeviceResponse": {
        "type": "object",
        "required": [
          "macAddress",
          "nodeId",
          "name",
          "uid"
        ],
        "properties": {
          "macAddress": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nodeId": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "orderIndex": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "uid": {
            "$ref": "#/components/schemas/DeviceUid"
          }
        }
      },
      "DeviceUid": {
        "type": "object",
        "properties": {
          "hwRevision": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "productId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "vendorId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "EmailVerificationRequest": {
        "type": "object",
        "required": [
          "verificationCode"
        ],
        "properties": {
          "verificationCode": {
            "type": "string"
          }
        }
      },
