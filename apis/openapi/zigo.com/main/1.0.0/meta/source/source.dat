{
  "openapi": "3.0.3",
  "info": {
    "title": "Zigo API",
    "description": "API de Zigo para gestión de guías, manifiestos, tarimas, camiones y más",
    "version": "1.0.0",
    "contact": {
      "name": "Zigo Support"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/zigoentregas/zigo-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.zigo.com",
      "description": "Servidor de producción"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticación y autorización"
    },
    {
      "name": "User",
      "description": "Gestión de usuarios"
    },
    {
      "name": "Guide",
      "description": "Gestión de guías"
    },
    {
      "name": "Manifest",
      "description": "Gestión de manifiestos"
    },
    {
      "name": "Pallet",
      "description": "Gestión de tarimas"
    },
    {
      "name": "Truck",
      "description": "Gestión de camiones y viajes"
    },
    {
      "name": "Recipient",
      "description": "Gestión de destinatarios"
    },
    {
      "name": "Sender",
      "description": "Gestión de remitentes"
    },
    {
      "name": "Billing",
      "description": "Facturación"
    },
    {
      "name": "Claim",
      "description": "Reclamos"
    },
    {
      "name": "Geolocation",
      "description": "Información geográfica"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "data": {
                    "user": {
                      "username": "COSORIO",
                      "name": "CHRISTIAN OSORIO",
                      "hubId": "TEST1"
                    },
                    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJDT1NPUklPIiwibmFtZSI6IkNIUklTVElBTiBPU09SSU8iLCJpc3MiOiJhdXRoLXNlcnZpY2UiLCJhdWQiOiJodHRwczovL2FwaS5leGFtcGxlLmNvbSIsImlhdCI6MTc0Mjg4NDQ0MywiZXhwIjoxNzQyODkxNjQzfQ.GIua5JeQOd1RyAJaLOeOZy9ApKotK9f3ehVdGRqWZlk",
                    "expireIn": 1742891643,
                    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJDT1NPUklPIiwibmFtZSI6IkNIUklTVElBTiBPU09SSU8iLCJpc3MiOiJhdXRoLXNlcnZpY2UiLCJhdWQiOiJodHRwczovL2FwaS5leGFtcGxlLmNvbSIsImlhdCI6MTc0Mjg4NDQ0MywiZXhwIjoxNzQzNDg5MjQzfQ.Mg2-eyHs6xAwqk955Kl9Yx8kBVVKKTKzNxX8qmKSIaQ",
                    "refreshExpiresIn": 1743489243,
                    "tokenType": "Bearer"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": {
                    "type": "UnauthorizedException",
                    "message": "User is inactive. Please contact the administrator",
                    "timestamp": "2025-07-04T03:36:56.257Z",
                    "path": "/auth/login",
                    "method": "POST"
                  }
                }
              }
            }
          }
        }
      }
    },
