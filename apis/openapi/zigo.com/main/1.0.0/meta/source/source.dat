    "/auth/request/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Solicitar reset de contraseña (envía password temporal por email)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "usuario@zigo.com.gt"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password temporal enviado por email exitosamente"
          },
          "400": {
            "description": "Error de validación o usuario no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "invalidEmail": {
                    "summary": "Formato de email inválido",
                    "value": {
                      "error": {
                        "type": "BadRequestException",
                        "message": [
                          "email must be an email"
                        ],
                        "timestamp": "2025-11-18T17:23:14.314Z",
                        "path": "/auth/request/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "userNotFound": {
                    "summary": "Usuario no encontrado",
                    "value": {
                      "error": {
                        "type": "AUTH.UserNotFound",
                        "message": "User not found",
                        "timestamp": "2025-11-19T19:15:30.123Z",
                        "path": "/auth/request/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "userInactive": {
                    "summary": "Usuario inactivo",
                    "value": {
                      "error": {
                        "type": "AUTH.UserIsInactive",
                        "message": "User is inactive. Please contact the administrator",
                        "timestamp": "2025-11-19T19:15:30.123Z",
                        "path": "/auth/request/reset-password",
                        "method": "POST"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Resetear contraseña con password temporal",
        "description": "Permite cambiar la contraseña usando el password temporal recibido por email. Valida que las nuevas contraseñas coincidan y cumplan con la política de seguridad.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "currentPassword",
                  "newPassword",
                  "confirmNewPassword"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email del usuario",
                    "example": "alejandro.alvizures@zigo.com.gt"
                  },
                  "currentPassword": {
                    "type": "string",
                    "description": "Password temporal recibido por email",
                    "example": "TempP@ss10"
                  },
                  "newPassword": {
                    "type": "string",
                    "description": "Nueva contraseña (mínimo 6 caracteres, 1 mayúscula, 1 número, 1 carácter especial)",
                    "example": "MyNewPassw0rd!"
                  },
                  "confirmNewPassword": {
                    "type": "string",
                    "description": "Confirmación de la nueva contraseña (debe coincidir con newPassword)",
                    "example": "MyNewPassw0rd!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contraseña actualizada exitosamente"
          },
          "400": {
            "description": "Error de validación",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "passwordMismatch": {
                    "summary": "Las nuevas contraseñas no coinciden",
                    "value": {
                      "error": {
                        "type": "BadRequestException",
                        "message": [
                          "New password does not match, please enter the same password on both fields"
                        ],
                        "timestamp": "2025-11-18T18:53:16.534Z",
                        "path": "/auth/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "currentPasswordMismatch": {
                    "summary": "Password temporal incorrecto",
                    "value": {
                      "error": {
                        "type": "AUTH.CurrentPasswordMismatch",
                        "message": "Current Password does not match, try again",
                        "timestamp": "2025-11-18T18:53:16.534Z",
                        "path": "/auth/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "passwordPolicyViolation": {
                    "summary": "La nueva contraseña no cumple con la política",
                    "value": {
                      "error": {
                        "type": "AUTH.PasswordPolicyViolation",
                        "message": "Password must be at least 6 characters long, include one uppercase letter, one number, and one special character",
                        "timestamp": "2025-07-07T22:20:20.182Z",
                        "path": "/auth/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "userNotFound": {
                    "summary": "Usuario no encontrado",
                    "value": {
                      "error": {
                        "type": "AUTH.UserNotFound",
                        "message": "User not found",
                        "timestamp": "2025-06-23T20:12:30.277Z",
                        "path": "/auth/reset-password",
                        "method": "POST"
                      }
                    }
                  },
                  "userInactive": {
                    "summary": "Usuario inactivo",
                    "value": {
                      "error": {
                        "type": "AUTH.UserIsInactive",
                        "message": "User is inactive. Please contact the administrator",
                        "timestamp": "2025-07-04T04:19:07.153Z",
                        "path": "/auth/reset-password",
                        "method": "POST"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
