{
  "openapi": "3.0.3",
  "info": {
    "title": "API Asistente Inteligente de Jugos de Frutas",
    "description": "Contrato REST del sistema \"Asistente Inteligente de Jugos de Frutas\".\nLa API expone administración del corpus en cuatro tablas: Recetas, Ingredientes,\nBeneficios y Embeddings de Recetas. Incluye CRUD completo para cada tabla.\n",
    "contact": {
      "name": "Equipo 12 — Definición de API",
      "email": "A01795611@tec.mx"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/tec-e46/api-asistente-inteligente-de-jugos-de-frutas/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.jugos.equipo12.dev/v1",
      "description": "Producción"
    },
    {
      "url": "https://ideal-spoon-g44jrpgp4g59fvqjj-8000.app.github.dev",
      "description": "Codespace (demo, sin /v1)"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Recetas",
      "description": "Administración del corpus de recetas."
    },
    {
      "name": "Ingredientes",
      "description": "Administración del catálogo de ingredientes base."
    },
    {
      "name": "Beneficios",
      "description": "Administración del catálogo de beneficios."
    },
    {
      "name": "Embeddings_recetas",
      "description": "Embeddings/representaciones vectoriales por receta."
    },
    {
      "name": "Consultas",
      "description": "Captura y consulta de Queries de usuario."
    },
    {
      "name": "Recomendaciones",
      "description": "Recomendaciones y sus ítems."
    },
    {
      "name": "Refinamientos",
      "description": "Refinamientos sobre una receta base."
    },
    {
      "name": "Reglas",
      "description": "Reglas de negocio y sus dependencias."
    },
    {
      "name": "Operacion",
      "description": "Telemetría y operación del servicio."
    },
    {
      "name": "Mantenimiento",
      "description": "Incidencias, despliegues, respaldos y verificaciones."
    }
  ],
  "paths": {
    "/recetas/{id}/ingredientes": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Recetas"
        ],
        "summary": "Listar ingredientes (tabla recipe_ingredients)",
        "operationId": "listRecipeIngredients",
        "responses": {
          "200": {
            "description": "Ingredientes de la receta",
