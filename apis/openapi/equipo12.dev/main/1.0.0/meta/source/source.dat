  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Requerida para POST/PUT/DELETE (GET públicos en demo)."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud inválida (parámetros o cuerpo)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Falta o es inválida la credencial",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto (por ejemplo, id duplicado)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Degradación/indisponibilidad",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "recipe_ingredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "recipe_id": {
            "type": "integer",
            "format": "int64"
          },
          "ingredient": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "id",
          "recipe_id",
          "ingredient"
        ]
      },
      "recipe_ingredient_create": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "ingredient"
        ]
      },
      "recipe_tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "recipe_id": {
            "type": "integer",
            "format": "int64"
          },
          "tag": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "recipe_id",
          "tag"
        ]
      },
      "recipe_tag_create": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "tag"
        ]
      },
      "Ingredient": {
        "type": "object",
        "required": [
          "name",
          "quantity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del ingrediente",
            "example": "Manzana"
          },
          "quantity": {
            "type": "string",
            "description": "Cantidad/unidad (p. ej., \"1 pieza\", \"200 ml\")",
            "example": "1 pieza"
          }
        }
      },
      "Benefit": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Beneficio resumido",
            "example": "Fuente de fibra"
          },
          "detail": {
            "type": "string",
            "description": "Detalle opcional del beneficio",
            "example": "Contribuye a la saciedad"
          }
        }
      },
      "RecipeBase": {
        "type": "object",
        "required": [
          "name",
          "ingredients",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de la receta"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "steps": {
            "type": "string",
            "description": "Pasos de preparación"
          },
          "benefits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Benefit"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "name": "Energía Verde",
          "ingredients": [
            {
              "name": "Manzana",
              "quantity": "1 pieza"
            },
            {
              "name": "Espinaca",
              "quantity": "1 taza"
            },
            {
              "name": "Agua",
              "quantity": "200 ml"
            }
          ],
          "steps": "Lavar, cortar y licuar por 45 segundos.",
          "benefits": [
            {
              "name": "Fuente de fibra",
              "detail": "Contribuye a la saciedad"
            }
          ],
          "tags": [
            "verde",
            "energizante"
          ]
        }
      },
      "Recipe": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RecipeBase"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "example": 17
              }
            }
          }
        ]
      },
      "RecipeCreate": {
        "$ref": "#/components/schemas/RecipeBase"
      },
      "RecipeUpdate": {
        "$ref": "#/components/schemas/RecipeBase"
      },
      "RecipesPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recipe"
            }
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 124
          }
        }
      },
      "Ingrediente": {
        "type": "object",
        "description": "Registro del catálogo de ingredientes.",
        "additionalProperties": false,
        "properties": {
          "id_ingrediente": {
            "type": "string",
            "description": "Identificador interno de 3 dígitos.",
            "maxLength": 3,
            "pattern": "^\\d{3}$",
            "example": "015"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del ingrediente",
            "example": "Espinaca"
          },
          "unidad": {
            "type": "string",
            "description": "Unidad base (opcional)",
            "example": "taza"
          },
          "objectId": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36,
            "description": "Identificador único del registro (UUID v4 con guiones)",
            "example": "4e9b2f0d-2b1e-4a9b-9c6b-3c5d2f1a9e21"
          }
        },
        "required": [
          "id_ingrediente",
          "nombre"
        ]
      },
      "IngredientesPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingrediente"
            }
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 320
          }
        }
      },
      "Beneficios": {
        "type": "object",
        "description": "Registro de beneficios disponible en la base de datos.",
        "additionalProperties": false,
        "properties": {
          "id_beneficios": {
            "type": "string",
            "description": "Identificador interno de 3 dígitos.",
            "maxLength": 3,
            "pattern": "^\\d{3}$",
            "example": "001"
          },
          "descripcion_beneficios": {
            "type": "string",
            "description": "Descripción corta del beneficio.",
            "maxLength": 35,
            "example": "Mas energía",
            "enum": [
              "Mas energía",
              "Mejor digestión",
              "Alta hidratación",
              "Refuerzo inmunológico",
              "Absorción rápida",
              "Aporte vitamínico",
              "Efecto desintoxicante"
            ]
          },
          "objectId": {
            "type": "string",
            "description": "Identificador único del registro (UUID v4 con guiones). Solo lectura.",
            "format": "uuid",
            "maxLength": 36,
            "example": "bbdc01d0-6600-4cc2-857f-d48f9a0c6b5e"
          }
        },
        "required": [
          "id_beneficios",
          "descripcion_beneficios"
        ]
      },
      "BeneficiosPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Beneficios"
            }
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 64
          }
        }
      },
      "EmbeddingRecetaBase": {
        "type": "object",
        "properties": {
          "recipeId": {
            "type": "integer",
            "description": "ID de receta a la que pertenece el embedding",
            "example": 17
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo usado para generar el embedding",
            "example": "all-MiniLM-L6-v2"
          },
          "dim": {
            "type": "integer",
            "description": "Dimensión del vector",
            "example": 384
          },
          "vector": {
            "type": "array",
            "description": "Vector de representación (valores normalizados o crudos)",
            "minItems": 8,
            "items": {
              "type": "number",
              "format": "float"
            }
          },
