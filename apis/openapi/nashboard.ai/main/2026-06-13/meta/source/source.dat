/usage/sla":{"get":{"operationId":"getSla","tags":["Usage & SLA"],"summary":"Get trailing 12-month SLA history","description":"Required scope: `usage:read`. Returns per-month aggregates from enrich_sla_tracking (populated daily). failure_rate is derived at read time. The public uptime probe is GET /readyz (no auth).","parameters":[{"$ref":"#/components/parameters/NashboardVersion"}],"responses":{"200":{"description":"Trailing 12-month SLA data.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SlaResponse"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient scope or scope escalation attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflict (e.g. email already taken).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"415":{"description":"Unsupported media type.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited, quota exceeded, or DP budget exhausted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream dependency error (e.g. receipt image storage unavailable — code storage_failure).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/benchmarks":{"get":{"operationId":"getBenchmarks","tags":["Public"],"summary":"Get enrichment accuracy benchmarks","description":"Public, no auth required. Returns the committed eval artifact (P@1 per stratum, evaluated_at timestamp). Returns 503 until a real eval run has been committed — never serves a fabricated number. Edge-cached up to 1h.","security":[],"parameters":[],"responses":{"200":{"description":"Eval artifact. Shape includes evaluated_at (ISO date-time) and per-stratum P@1.","content":{"application/json":{"schema":{"type":"object","required":["evaluated_at"],"properties":{"evaluated_at":{"type":"string","format":"date-time"}},"additionalProperties":true}}}},"503":{"description":"Benchmarks not yet published.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["benchmarks_unavailable"]},"message":{"type":"string"}}}},"additionalProperties":true}}}}}}}},"tags":[{"name":"Self-serve","description":"Account signup and management."},{"name":"Merchant Enrichment","description":"Normalize raw bank descriptors to merchant identity, category, and hierarchy."},{"name":"Receipt OCR","description":"Upload and parse receipt images."},{"name":"Webhooks","description":"Push delivery for async OCR results."},{"name":"Key Management","description":"Self-service API key lifecycle."},{"name":"Flywheel","description":"Feed the merchant-correction learning corpus."},{"name":"Usage & SLA","description":"Billing usage and SLA history."},{"name":"Public","description":"Unauthenticated public endpoints."}]}