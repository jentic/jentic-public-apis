{"openapi":"3.1.0","info":{"title":"Nashboard B2B API","version":"2026-06-13","description":"The Nashboard B2B API provides merchant enrichment, receipt OCR, and self-service account management for fintech developers. Base URL: https://api.nashboard.ai. Interactive docs: https://api.nashboard.ai/docs.\n\n## Data sources & attribution\n\nThe merchant reference corpus is built exclusively from openly licensed data:\n\n- **Overture Maps Places** — © Overture Maps Foundation and its data contributors. Licensed under CDLA Permissive 2.0 (only the CDLA-Permissive-2.0 subset is ingested).\n- **Foursquare Open Source Places (FSQ OS Places)** — © Foursquare. Licensed under the Apache License, Version 2.0 (https://www.apache.org/licenses/LICENSE-2.0).\n- **Wikidata** — released under CC0 1.0.\n- **AllThePlaces** and **GLEIF LEI** — released under CC0 1.0.\n\nNo OpenStreetMap/ODbL or other share-alike data is included in API responses — share-alike rows are filtered out at the source-license layer, so API output is redistributable.","contact":{"url":"https://nashboard.ai","email":"api@nashboard.ai"}},"servers":[{"url":"https://api.nashboard.ai"}],"security":[{"apiKeyBearer":[]},{"apiKeyHeader":[]}],"components":{"securitySchemes":{"apiKeyBearer":{"type":"http","scheme":"bearer","description":"API key as a Bearer token: `Authorization: Bearer nsh_live_...`"},"apiKeyHeader":{"type":"apiKey","in":"header","name":"X-API-Key","description":"API key as a custom header: `X-API-Key: nsh_live_...`"}},"parameters":{"NashboardVersion":{"name":"X-Nashboard-Version","in":"header","required":false,"schema":{"type":"string","enum":["2026-06-13"],"default":"2026-06-13"},"description":"API version pin (ISO date). Absent → latest. Unknown or future → 400 unsupported_version. The X-Amouen-Version header name is still accepted as a deprecated alias; when both are present, X-Nashboard-Version takes precedence."}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string","enum":["missing_api_key","malformed_api_key","invalid_api_key","api_key_revoked","api_key_expired","insufficient_scope","scope_escalation","unsupported_version","rate_limited","quota_exceeded","dp_budget_exhausted","validation_failed","invalid_json","invalid_id","invalid_cursor","invalid_multipart","payload_too_large","unsupported_media_type","not_found","email_taken","internal_error","storage_failure"],"description":"Machine-readable error code."},"message":{"type":"string","description":"Human-readable explanation."},"details":{"type":"array","description":"Per-field validation errors (validation_failed only).","items":{"type":"object","required":["path","message"],"properties":{"path":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false}},"additionalProperties":false},"TransactionInput":{"type":"object","required":["raw_descriptor"],"properties":{"raw_descriptor":{"type":"string","minLength":1,"maxLength":200,"description":"Raw bank transaction descriptor string. Send it exactly as it appears on the statement — do not pre-clean. PSP prefixes (e.g. \"PAYPAL *\", \"SQ *\", \"TST*\"), POS channel markers (\"POS DEBIT\", \"CHECKCARD\"), store numbers, and trailing city/country tokens are unwrapped server-side before matching. Non-Latin descriptors (Arabic, Persian, Cyrillic, Turkish) are matched natively in-script — no transliteration needed."},"amount_minor":{"type":"integer","minimum":0,"description":"Transaction amount in minor currency units (e.g. cents)."},"currency_code":{"type":"string","pattern":"^[A-Z]{3}$","description":"ISO 4217 currency code (e.g. USD)."},"date_hint":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Transaction date hint (YYYY-MM-DD)."},"country_hint":{"type":"string","pattern":"^[A-Z]{2}$","description":"ISO 3166-1 alpha-2 country hint."},"user_locale":{"type":"string","maxLength":35,"description":"BCP 47 locale tag (e.g. en-US)."}},"additionalProperties":false},"EnrichResponse":{"type":"object","required":["request_id","match_score","match_method","ai_generated","counterparties","is_recurring","homoglyph_detected","ai_confidence","latency_ms"],"properties":{"request_id":{"type":"string","format":"uuid"},"merchant_id":{"type":"string","nullable":true,"format":"uuid","description":"Matched merchant ID, or null on no-match."},"merchant":{"type":"object","nullable":true,"description":"Resolved merchant object (null on no-match). Carries additional hierarchy/standards fields not all enumerated here.","properties":{"name":{"type":"string"},"name_localized":{"type":"object","additionalProperties":{"type":"string"},"nullable":true,"description":"Localized display names keyed by locale (e.g. en, ar, ru)."},"logo_url":{"type":"string","nullable":true},"confidence_tier":{"type":"integer"}},"additionalProperties":true},"match_score":{"type":"number","minimum":0,"maximum":1,"description":"Customer-facing retrieval confidence 0-1. Distinct from ai_confidence."},"match_method":{"type":"string","description":"How the match was determined (e.g. exact, fuzzy, ai_haiku, ai_sonnet, no_match)."},"ai_generated":{"type":"boolean","description":"True only when the AI disambiguation step produced/altered the returned match (EU AI Act Art. 50)."},"ai_confidence":{"type":"number","nullable":true,"description":"AI self-reported confidence 0-1 when AI fired; null otherwise."},"counterparties":{"type":"array","description":"Rail-aware counterparty provenance (e.g. BNPL chains).","items":{"type":"object","additionalProperties":true}},"is_recurring":{"type":"boolean","description":"True when the merchant has a known subscription pattern."},"recurrence":{"type":"object","nullable":true,"description":"Recurrence cadence details; null when is_recurring is false.","additionalProperties":true},"homoglyph_detected":{"type":"boolean","description":"Fraud signal: true when the descriptor mixes lookalike scripts (e.g. Cyrillic+Latin)."},"latency_ms":{"type":"integer","description":"Server-side pipeline latency in ms."},"cache_hit":{"type":"boolean"},"category":{"type":"object","description":"Taxonomy classification result.","additionalProperties":true},"hierarchy":{"type":"object","nullable":true,"description":"Brand → operator → location hierarchy.","additionalProperties":true},"alternates":{"type":"array","description":"Top-N alternate merchant candidates.","items":{"type":"object","properties":{"merchant_id":{"type":"string","format":"uuid"},"name":{"type":"string"},"confidence":{"type":"number"}},"additionalProperties":true}}},"additionalProperties":true,"description":"W5a flat EnrichResponse. additionalProperties:true — fields such as merchant{}, hierarchy, bin_signal, debug fields (rank_gap, nb_extensions) are present but not fully closed in this schema."},"SignupRequest":{"type":"object","required":["company_name","contact_email"],"properties":{"company_name":{"type":"string","minLength":1,"maxLength":200},"contact_email":{"type":"string","format":"email","maxLength":254}},"additionalProperties":false},"SignupResponse":{"type":"object","required":["tenant_id","live_key","test_key","scopes"],"properties":{"tenant_id":{"type":"string","format":"uuid"},"live_key":{"type":"string","description":"Live API key (nsh_live_…). Returned ONCE — store immediately."},"test_key":{"type":"string","description":"Sandbox test key (nsh_test_…). Returned ONCE — store immediately."},"scopes":{"type":"array","items":{"type":"string"},"description":"Scopes granted to both keys (free-tier defaults)."}},"additionalProperties":false},"BulkEnrichRequest":{"type":"object","required":["items"],"properties":{"items":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/components/schemas/TransactionInput"}}},"additionalProperties":false},"BulkEnrichResponse":{"type":"object","required":["results","summary"],"properties":{"results":{"type":"array","items":{"oneOf":[{"type":"object","required":["index","status","result"],"properties":{"index":{"type":"integer","minimum":0},"status":{"type":"string","enum":["ok"]},"result":{"$ref":"#/components/schemas/EnrichResponse"}},"additionalProperties":false},{"type":"object","required":["index","status","error_code","message"],"properties":{"index":{"type":"integer","minimum":0},"status":{"type":"string","enum":["error"]},"error_code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}]}},"summary":{"type":"object","required":["total","ok","error"],"properties":{"total":{"type":"integer"},"ok":{"type":"integer"},"error":{"type":"integer"}},"additionalProperties":false}},"additionalProperties":false},"ReceiptQueued":{"type":"object","required":["id","status","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["queued"]},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"ReceiptDetail":{"type":"object","required":["id","status","currency","total_minor","captured_at","ai_generated"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["queued","parsed","failed"]},"currency":{"type":"string"},"total_minor":{"type":"integer"},"subtotal_minor":{"type":"integer","nullable":true},"tax_minor":{"type":"integer","nullable":true},"tax_lines":{"type":"object","nullable":true,"additionalProperties":true},"service_charge_minor":{"type":"integer","nullable":true},"tip_minor":{"type":"integer","nullable":true},"payment_method":{"type":"string","nullable":true},"merchant_id":{"type":"string","format":"uuid","nullable":true},"merchant_confidence":{"type":"number","nullable":true},"captured_at":{"type":"string","format":"date-time"},"detected_langs":{"type":"array","nullable":true,"items":{"type":"string"}},"extraction_confidence":{"type":"number","nullable":true},"product_links_status":{"type":"string","enum":["pending","ready"]},"needs_review":{"type":"boolean"},"failure_reason":{"type":"string","nullable":true},"ai_generated":{"type":"boolean","description":"Always true (EU AI Act Art. 50 disclosure)."},"line_items":{"type":"array","items":{"type":"object","properties":{"line_no":{"type":"integer"},"description":{"type":"string","nullable":true},"quantity":{"type":"number","nullable":true},"unit_price_minor":{"type":"integer","nullable":true},"total_minor":{"type":"integer","nullable":true},"gtin":{"type":"string","nullable":true},"product_global_id":{"type":"string","format":"uuid","nullable":true},"product_link_confidence":{"type":"number","nullable":true}},"additionalProperties":true}}},"additionalProperties":true},"ReceiptSummary":{"type":"object","required":["id","status","currency","total_minor","captured_at","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["queued","parsed","failed"]},"currency":{"type":"string"},"total_minor":{"type":"integer"},"merchant_id":{"type":"string","format":"uuid","nullable":true},"captured_at":{"type":"string","format":"date-time"},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"ReceiptList":{"type":"object","required":["data"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/ReceiptSummary"}},"next_cursor":{"type":"string","nullable":true,"description":"Opaque keyset cursor for the next page; null on last page."}},"additionalProperties":false},"ReceiptParseRequest":{"type":"object","required":["line_items"],"properties":{"line_items":{"type":"array","maxItems":50,"items":{"type":"object","required":["description"],"properties":{"description":{"type":"string","minLength":1,"maxLength":500},"gtin":{"type":"string","pattern":"^\\d{8,14}$","description":"GTIN barcode (8-14 digits)."}},"additionalProperties":false}},"country_hint":{"type":"string","maxLength":8,"description":"ISO 3166-1 alpha-2 country hint."}},"additionalProperties":false},"ReceiptParseResponse":{"type":"object","required":["resolved"],"properties":{"resolved":{"type":"array","description":"Per-line resolution results.","items":{"type":"object","additionalProperties":true}}},"additionalProperties":false},"WebhookCreateRequest":{"type":"object","required":["endpoint_url","secret","event_types"],"properties":{"endpoint_url":{"type":"string","format":"uri","description":"HTTPS endpoint to receive delivery POSTs. Must not be a private/loopback host."},"secret":{"type":"string","minLength":16,"maxLength":256,"description":"Shared secret for HMAC-SHA256 signature verification. Never returned after creation."},"event_types":{"type":"array","minItems":1,"items":{"type":"string"},"description":"Event types to subscribe to (e.g. receipt.parsed, receipt.failed)."}},"additionalProperties":false},"WebhookSubscription":{"type":"object","required":["id","endpoint_url","event_types","active"],"properties":{"id":{"type":"string","format":"uuid"},"endpoint_url":{"type":"string","format":"uri"},"event_types":{"type":"array","items":{"type":"string"}},"active":{"type":"boolean"},"failure_count":{"type":"integer"},"last_success_at":{"type":"string","format":"date-time","nullable":true},"last_failure_at":{"type":"string","format":"date-time","nullable":true},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":true},"WebhookUpdateRequest":{"type":"object","properties":{"endpoint_url":{"type":"string","format":"uri"},"secret":{"type":"string","minLength":16,"maxLength":256},"event_types":{"type":"array","minItems":1,"items":{"type":"string"}},"active":{"type":"boolean"}},"additionalProperties":false,"description":"At least one field required."},"KeyCreateRequest":{"type":"object","required":["scopes"],"properties":{"name":{"type":"string","minLength":1,"maxLength":120},"scopes":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$","description":"Scope token in product:verb format."},"description":"Requested scopes — must be a subset of the calling key's own scopes (403 scope_escalation otherwise)."},"expires_in_days":{"type":"integer","minimum":1,"maximum":3650,"description":"TTL in days. Omit for non-expiring key."}},"additionalProperties":false},"KeyCreated":{"type":"object","required":["id","key","prefix","scopes","expires_at","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"key":{"type":"string","description":"Plaintext API key (nsh_live_…). Returned ONCE — store immediately."},"prefix":{"type":"string"},"name":{"type":"string","nullable":true},"scopes":{"type":"array","items":{"type":"string"}},"expires_at":{"type":"string","format":"date-time","nullable":true},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"KeyMeta":{"type":"object","required":["id","prefix","scopes","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"prefix":{"type":"string"},"name":{"type":"string","nullable":true},"scopes":{"type":"array","items":{"type":"string"}},"last_used_at":{"type":"string","format":"date-time","nullable":true},"expires_at":{"type":"string","format":"date-time","nullable":true},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"CorrectionRequest":{"type":"object","properties":{"enrich_request_id":{"type":"string","format":"uuid"},"receipt_id":{"type":"string","format":"uuid"},"transaction_id":{"type":"string","format":"uuid"},"predicted_merchant_id":{"type":"string","format":"uuid"},"corrected_merchant_id":{"type":"string","format":"uuid"},"correction_reason":{"type":"string","minLength":1,"maxLength":500}},"additionalProperties":false,"description":"At least one of corrected_merchant_id or correction_reason is required."},"UsageResponse":{"type":"object","required":["period_start","period_end","plan","call_count","quota","quota_remaining"],"properties":{"period_start":{"type":"string","format":"date-time"},"period_end":{"type":"string","format":"date-time"},"plan":{"type":"string","description":"Tenant plan tier (e.g. free, starter, growth, enterprise)."},"call_count":{"type":"integer","description":"Billable API calls in the current calendar month."},"quota":{"type":"integer","nullable":true,"description":"Monthly call quota; null for unlimited plans."},"quota_remaining":{"type":"integer","nullable":true,"description":"Remaining quota; null for unlimited plans."}},"additionalProperties":false},"SlaResponse":{"type":"object","required":["months"],"properties":{"months":{"type":"array","description":"Trailing 12 months of SLA data, newest first.","items":{"type":"object","required":["month","total_requests","failed_requests","failure_rate","uptime_pct"],"properties":{"month":{"type":"string","description":"Calendar month (YYYY-MM-DD, first day of month)."},"total_requests":{"type":"integer"},"failed_requests":{"type":"integer"},"failure_rate":{"type":"number","description":"Derived: failed_requests / total_requests (0 when total is 0)."},"p95_latency_ms":{"type":"integer"},"p99_latency_ms":{"type":"integer"},"sla_breaches":{"type":"integer"},"uptime_pct":{"type":"number"}},"additionalProperties":false}}},"additionalProperties":false}}},"paths":{"/v1/b2b/signup":{"post":{"operationId":"b2bSignup","tags":["Self-serve"],"summary":"Create a new B2B account","description":"Unauthenticated. Creates a tenant and returns a live + test key pair. The keys are returned ONCE in this response — store them immediately. A welcome email is also sent but is best-effort. Idempotent on retry after a mid-flow failure.","security":[],"parameters":[{"$ref":"#/components/parameters/NashboardVersion"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignupRequest"}}}},"responses":{"201":{"description":"Account created. Keys returned once.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignupResponse"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient scope or scope escalation attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflict (e.g. email already taken).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"415":{"description":"Unsupported media type.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited, quota exceeded, or DP budget exhausted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream dependency error (e.g. receipt image storage unavailable — code storage_failure).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/enrich/transaction":{"post":{"operationId":"enrichTransaction","tags":["Merchant Enrichment"],"summary":"Enrich a bank transaction descriptor","description":"Required scope: `enrich:transaction`. Returns a normalized merchant identity, category, hierarchy, and rail signals. Send descriptors as-is: bank-statement scaffolding (PSP prefixes, channel markers, store numbers, trailing city/country tokens) is stripped server-side before retrieval — client-side pre-cleaning is unnecessary. Descriptors in non-Latin scripts (Arabic, Persian, Cyrillic, Turkish) are matched natively without transliteration. Use `?debug=1` with the `enrich:debug` scope to surface internal scoring fields (rank_gap, nb_extensions) — silently ignored without the scope.","parameters":[{"$ref":"#/components/parameters/NashboardVersion"},{"name":"debug","in":"query","required":false,"schema":{"type":"string","enum":["1"]},"description":"Surface debug fields (rank_gap, nb_extensions). Requires `enrich:debug` scope; silently ignored otherwise."},{"name":"taxonomy","in":"query","required":false,"schema":{"type":"string","enum":["consumer_v2026.05","mcc","naics_2022","isic_rev5","nace_rev21","uk_sic_2026","anzsic_2006","pfc_v2"],"default":"consumer_v2026.05"},"description":"Taxonomy system for the category field."},{"name":"X-Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":128},"description":"Optional idempotency key (max 128 chars)."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransactionInput"}}}},"responses":{"200":{"description":"Enriched result.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnrichResponse"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient scope or scope escalation attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflict (e.g. email already taken).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"415":{"description":"Unsupported media type.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited, quota exceeded, or DP budget exhausted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream dependency error (e.g. receipt image storage unavailable — code storage_failure).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/enrich/bulk":{"post":{"operationId":"enrichBulk","tags":["Merchant Enrichment"],"summary":"Enrich up to 100 transactions in a single request","description":"Required scope: `enrich:transaction`. AI fallback is forced OFF for bulk (retrieval-grade only). Billed per successful item. Partial failures do not roll back successes. Retry failed items individually via POST /v1/enrich/transaction (which supports X-Idempotency-Key).","parameters":[{"$ref":"#/components/parameters/NashboardVersion"},{"name":"debug","in":"query","required":false,"schema":{"type":"string","enum":["1"]},"description":"Surface debug fields. Requires `enrich:debug` scope."},{"name":"taxonomy","in":"query","required":false,"schema":{"type":"string","enum":["consumer_v2026.05","mcc","naics_2022","isic_rev5","nace_rev21","uk_sic_2026","anzsic_2006","pfc_v2"],"default":"consumer_v2026.05"},"description":"Taxonomy system applied to all items."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkEnrichRequest"}}}},"responses":{"200":{"description":"Per-item results and summary. Partial failures do not fail the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkEnrichResponse"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient scope or scope escalation attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflict (e.g. email already taken).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"415":{"description":"Unsupported media type.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited, quota exceeded, or DP budget exhausted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream dependency error (e.g. receipt image storage unavailable — code storage_failure).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/receipts":{"post":{"operationId":"uploadReceipt","tags":["Receipt OCR"],"summary":"Upload a receipt image for asynchronous OCR","description":"Required scope: `receipts:write`. Accepts multipart/form-data with fields: `image` (JPEG/PNG/WebP, max 10 MB), `external_user_id` (required), `captured_at` (ISO-8601, optional), `currency_hint` (ISO 4217, optional), `locale` (BCP47, optional). Returns 202 with the receipt ID. Poll GET /v1/receipts/{id} or use webhooks for the parsed result.","parameters":[{"$ref":"#/components/parameters/NashboardVersion"}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["image","external_user_id"],"properties":{"image":{"type":"string","format":"binary","description":"Receipt image file (JPEG/PNG/WebP, max 10 MB)."},"external_user_id":{"type":"string","minLength":1,"maxLength":200,"description":"Your end-user identifier."},"captured_at":{"type":"string","format":"date-time","description":"When the receipt was captured (ISO-8601 with offset)."},"currency_hint":{"type":"string","pattern":"^[A-Z]{3}$","description":"ISO 4217 currency hint."},"locale":{"type":"string","maxLength":35,"description":"BCP47 locale hint."}},"additionalProperties":false}}}},"responses":{"202":{"description":"Receipt accepted and queued for OCR.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReceiptQueued"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient scope or scope escalation attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Conflict (e.g. email already taken).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"415":{"description":"Unsupported media type.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited, quota exceeded, or DP budget exhausted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream dependency error (e.g. receipt image storage unavailable — code storage_failure).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listReceipts","tags":["Receipt OCR"],"summary":"List receipts (keyset-paginated)","description":"Required scope: `receipts:read`. Returns a summary projection (no line items) ordered by created_at DESC. Supports `after` cursor, `limit` (1-100, default 20), and `status` filter.","parameters":[{"$ref":"#/components/parameters/NashboardVersion"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"after","in":"query","required":false,"schema":{"type":"string","maxLength":512},"description":"Opaque keyset cursor returned in the previous page's next_cursor."},{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["queued","parsed","failed"]},"description":"Filter by wire status."}],"responses":{"200":{"description":"Paginated list of receipt summaries.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReceiptList"}}}},"400":{"description":"Bad request (invalid JSON, invalid ID, invalid cursor, etc.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed, or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/