          "agent_id": {
            "pattern": "^agent_[A-Za-z0-9]+$",
            "title": "Agent Id",
            "type": "string"
          },
          "object": {
            "const": "agent.draft",
            "default": "agent.draft",
            "title": "Object",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "managed_runtime_pricing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublisherPricing"
              },
              {
                "type": "null"
              }
            ]
