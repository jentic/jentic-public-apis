            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublisherEarnings"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PublisherForbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/publisher/agents": {
      "get": {
        "tags": [
          "Publisher Agents"
        ],
        "operationId": "listPublisherAgents",
        "summary": "List your agents",
        "description": "Returns agents owned by the current Workspace, newest first.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PublisherLimit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "in": "query",
            "name": "archived",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Show archived agents instead of active agents."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of owned agents.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublisherAgentList"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/PublisherAgentListExample"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PublisherForbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "Publisher Agents"
        ],
        "operationId": "createPublisherAgent",
        "summary": "Create a Managed or External agent draft",
        "description": "Choose hosting before creation. External connections are checked before the draft is stored.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePublisherAgentRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "name": "Weather Market Forecaster",
                    "slug": "weather-market-forecaster",
                    "description": "Compares weather forecasts and prediction-market prices."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created agent.",
            "headers": {
              "location": {
                "description": "URL for the created agent.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              },
              "etag": {
                "$ref": "#/components/headers/DraftEtag"
              },
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublisherAgent"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/PublisherAgentExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The connection or request needs attention.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/ConnectionCheckError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PublisherForbidden"
          },
          "409": {
            "$ref": "#/components/responses/PublisherConflict"
          },
          "422": {
            "description": "The Agent Card needs attention or could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionCheckError"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "description": "The Agent Card needs attention or could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionCheckError"
                }
              }
            }
          }
        }
      }
    },
