      "CreateRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "input"
        ],
        "properties": {
          "tool_settings": {
            "$ref": "#/components/schemas/ToolSettings"
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeneralExecutionChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "agent": {
            "$ref": "#/components/schemas/AgentId"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "Natural-language instruction for the agent."
          },
          "files": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FileId"
            }
          },
          "session_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Existing session to continue. Omit it to create a session."
          },
          "workstream_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkstreamId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Existing Workstream for a new Thread."
          },
          "workstream_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Title used when creating a Workstream."
          },
          "workstream_objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Objective used when creating a Workstream."
          },
          "thread_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Title used when creating a Thread."
          },
          "max_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001,
            "description": "Optional hard maximum total buyer charge for this run."
          },
          "deposit_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.000001,
            "description": "Wallet buyers only. Ask to prepay this much credit instead of only the gap, so later runs need no payment."
          },
          "background": {
            "type": "boolean",
            "default": false,
            "description": "Return immediately with an accepted run."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Return Server-Sent Events until the run becomes terminal."
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        },
        "allOf": [
          {
            "not": {
              "required": [
                "background",
                "stream"
              ],
              "properties": {
                "background": {
                  "const": true
                },
                "stream": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "limit_reached",
          "cancelled",
          "failed"
        ]
      },
      "RunSource": {
        "type": "object",
        "additionalProperties": false,
        "description": "One place an answer came from.",
        "required": [
          "url",
          "title",
          "site",
          "quote",
          "cited"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "description": "The publisher name when the page gave one, otherwise the bare host."
          },
          "quote": {
            "type": [
              "string",
              "null"
            ],
            "description": "A line quoted from the page. Null unless the agent reported one."
          },
          "cited": {
            "type": "boolean",
            "description": "True when the answer cites this source."
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_settings",
          "id",
          "object",
          "agent",
          "status",
          "output_text",
          "output",
          "sources",
          "usage",
          "cost_usd",
          "max_cost_usd",
          "session_id",
          "workstream_id",
          "thread_title",
          "stop_reason",
          "error",
          "created_at",
          "started_at",
          "completed_at",
          "metadata",
          "parent_run_id",
          "root_run_id",
          "depth",
          "subagents"
        ],
        "properties": {
          "tool_settings": {
            "$ref": "#/components/schemas/ToolSettings"
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeneralRunExecution"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/RunId"
          },
          "object": {
            "type": "string",
            "const": "run"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentId"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "output_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Concatenated text output. Null until text output exists."
          },
          "output": {
            "type": "array",
            "description": "Ordered outputs. Tool records appear only when the provider marks them customer-visible.",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "sources": {
            "type": "array",
            "description": "Where the answer came from. Empty when the agent reported nothing.",
            "items": {
              "$ref": "#/components/schemas/RunSource"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Final buyer charge, rounded to six decimal places."
          },
          "max_cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Effective authorized ceiling used for this run."
          },
          "session_id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "workstream_id": {
            "$ref": "#/components/schemas/WorkstreamId"
          },
          "thread_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "stop_reason": {
            "oneOf": [
              {
                "type": "string",
                "const": "max_cost_reached"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "parent_run_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunId"
              },
              {
                "type": "null"
              }
            ]
          },
          "root_run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "subagents": {
            "$ref": "#/components/schemas/SubagentSummary"
          },
          "payer": {
            "description": "The wallet that paid for this run. Absent for key and session buyers.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunPayer"
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit": {
            "description": "The wallet payment this request settled. Absent when the run was admitted from balance.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunDeposit"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RunPayer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "address",
          "balance_usd"
        ],
        "properties": {
          "network": {
            "type": "string",
            "description": "CAIP-2 network, for example eip155:8453."
          },
          "address": {
            "type": "string"
          },
          "balance_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Balance left on the wallet after this run's maximum was held. Set on the creating response."
          }
        }
      },
      "RunDeposit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "credits_usd",
          "fee_usd",
          "amount_usd",
          "transaction",
          "transaction_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "credits_usd": {
            "type": "string"
          },
          "fee_usd": {
            "type": "string"
          },
          "amount_usd": {
            "type": "string"
          },
          "transaction": {
            "type": "string"
          },
          "transaction_url": {
            "type": "string"
          }
        }
      },
      "AgentPayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "options",
          "siwx_origin",
          "topup_fee_percent"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "const": "exact"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "network",
                "asset",
                "pay_to",
                "decimals"
              ],
              "properties": {
                "network": {
                  "type": "string"
                },
                "asset": {
                  "type": "string"
                },
                "pay_to": {
                  "type": "string"
                },
                "decimals": {
                  "type": "integer"
                }
              }
            }
          },
          "siwx_origin": {
            "type": "string"
          },
          "topup_fee_percent": {
            "type": "string"
          }
        }
      },
      "PaymentRequired": {
        "description": "The x402 v2 body a wallet buyer receives with a 402. Also base64 encoded in the PAYMENT-REQUIRED header.",
        "type": "object",
        "required": [
          "x402Version",
          "error",
          "resource",
          "accepts",
          "extensions"
        ],
        "properties": {
          "x402Version": {
            "type": "integer",
            "const": 2
          },
          "error": {
            "type": "string"
          },
          "resource": {
            "type": "object",
            "required": [
              "url",
              "description",
              "mimeType"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            }
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "scheme",
                "network",
                "asset",
                "payTo",
                "amount",
                "maxTimeoutSeconds"
              ],
              "properties": {
                "scheme": {
                  "type": "string",
                  "const": "exact"
                },
                "network": {
                  "type": "string"
                },
                "asset": {
                  "type": "string"
                },
                "payTo": {
                  "type": "string"
                },
                "amount": {
                  "type": "string",
                  "description": "Atomic USDC units due, credits plus fee."
                },
                "maxTimeoutSeconds": {
                  "type": "integer"
                },
                "extra": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SubagentSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "active",
          "completed",
          "failed",
          "cost_usd"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "SubagentRun": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "thread_id",
          "agent_id",
          "agent_name",
          "agent_logo_url",
          "status",
          "depth",
          "title",
          "status_text",
          "output_text",
          "output",
          "cost_usd",
          "updated_at",
          "error"
        ],
        "properties": {
          "run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "thread_id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "agent_name": {
            "type": "string"
          },
          "agent_logo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "depth": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SubagentRunList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "data",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubagentRun"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextOutput"
          },
          {
            "$ref": "#/components/schemas/FileOutput"
          },
          {
            "$ref": "#/components/schemas/DataOutput"
          },
          {
            "$ref": "#/components/schemas/ToolUseOutput"
          },
          {
            "$ref": "#/components/schemas/ToolResultOutput"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/TextOutput",
            "file": "#/components/schemas/FileOutput",
            "data": "#/components/schemas/DataOutput",
            "tool_use": "#/components/schemas/ToolUseOutput",
            "tool_result": "#/components/schemas/ToolResultOutput"
          }
        }
      },
      "TextOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text",
          "annotations"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "text"
          },
          "text": {
            "type": "string"
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TextAnnotation"
            }
          }
        }
      },
      "TextAnnotation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UrlCitation"
          },
          {
            "$ref": "#/components/schemas/FileCitation"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "url_citation": "#/components/schemas/UrlCitation",
            "file_citation": "#/components/schemas/FileCitation"
          }
        }
      },
      "UrlCitation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "start_index",
          "end_index",
          "url",
          "title"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "url_citation"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "FileCitation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "start_index",
          "end_index",
          "file_id",
          "filename"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "file_citation"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "file_id": {
            "$ref": "#/components/schemas/FileId"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "FileOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "file_id",
          "filename",
          "media_type",
          "size_bytes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "file"
          },
          "file_id": {
            "$ref": "#/components/schemas/FileId"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DataOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "data"
          },
          "data": {
            "description": "JSON value returned as a final agent result."
          }
        }
      },
      "ToolUseOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_use"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "input": {
            "description": "Customer-visible JSON input supplied to the provider's tool."
          }
        }
      },
      "ToolResultOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "tool_use_id",
          "output",
          "is_error"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_result"
          },
          "tool_use_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "output": {
            "description": "Customer-visible JSON result returned by the provider's tool."
          },
          "is_error": {
            "type": "boolean"
          }
        }
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rate_card_id",
          "meters"
        ],
        "properties": {
          "rate_card_id": {
            "type": "string",
            "pattern": "^rc_[A-Za-z0-9_]+$"
          },
          "meters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageMeter"
            }
          }
        }
      },
      "UsageMeter": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quantity",
          "cost_usd"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Meter charge in USD, rounded to six decimal places."
          }
        }
      },
      "RenameFileRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$"
          }
        }
      },
      "FileList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "File": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "purpose",
          "filename",
          "media_type",
          "size_bytes",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/FileId"
          },
          "object": {
            "type": "string",
            "const": "file"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "agent_input",
              "agent_output"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Metadata": {
        "type": "object",
        "maxProperties": 16,
        "default": {},
        "additionalProperties": {
          "type": "string",
          "maxLength": 512
        }
      },
      "ConnectionCheckError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "connection_checks"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "connection_checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionCheck"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "type",
          "param",
          "code"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "invalid_request_error",
              "authentication_error",
              "permission_error",
              "payment_error",
              "rate_limit_error",
              "provider_error",
              "api_error"
            ]
          },
          "param": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_agent",
              "invalid_file",
              "invalid_target_url",
              "unsupported_input",
              "invalid_session",
              "max_cost_too_low",
              "authentication_failed",
              "permission_denied",
              "insufficient_balance",
              "not_found",
              "gone",
              "idempotency_conflict",
              "payload_too_large",
              "unsupported_media_type",
              "rate_limit_exceeded",
              "provider_failed",
              "seo_provider_unavailable",
              "seo_provider_rejected",
              "external_usage_mismatch",
              "model_usage_mismatch",
              "missing_output",
              "provider_unavailable",
              "provider_timeout",
              "provider_protocol_error",
              "provider_interaction_not_supported",
              "cost_limit_exceeded",
              "missing_text_output",
              "internal_error",
              "insufficient_scope",
              "slug_conflict",
              "revision_conflict",
              "draft_invalid",
              "active_review_exists",
              "invalid_transition",
              "thread_busy",
              "file_conflict",
              "file_save_failed",
              "file_storage_unavailable",
              "file_too_large",
              "storage_limit_exceeded"
            ]
          }
        }
      },
      "RunStreamEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RunCreatedEvent"
          },
          {
            "$ref": "#/components/schemas/RunProgressEvent"
          },
          {
            "$ref": "#/components/schemas/RunActivityEvent"
          },
          {
            "$ref": "#/components/schemas/OutputTextDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/OutputItemAddedEvent"
          },
          {
            "$ref": "#/components/schemas/RunCompletedEvent"
          },
          {
            "$ref": "#/components/schemas/RunLimitReachedEvent"
          },
          {
            "$ref": "#/components/schemas/RunCancelledEvent"
          },
          {
            "$ref": "#/components/schemas/RunFailedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "run.created": "#/components/schemas/RunCreatedEvent",
            "run.progress": "#/components/schemas/RunProgressEvent",
            "run.activity": "#/components/schemas/RunActivityEvent",
            "output.text.delta": "#/components/schemas/OutputTextDeltaEvent",
            "output.item.added": "#/components/schemas/OutputItemAddedEvent",
            "run.completed": "#/components/schemas/RunCompletedEvent",
            "run.limit_reached": "#/components/schemas/RunLimitReachedEvent",
            "run.cancelled": "#/components/schemas/RunCancelledEvent",
            "run.failed": "#/components/schemas/RunFailedEvent"
          }
        }
      },
      "RunCreatedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "run"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "run.created"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          }
        }
      },
      "RunProgressEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "run_id",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "run.progress"
          },
          "run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "description": "Customer-safe progress text. It cannot contain hidden tool output."
          }
        }
      },
      "RunActivitySource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "icon_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri-reference"
          }
        }
      },
      "RunActivityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "run_id",
          "activity_id",
          "kind",
          "status",
          "label",
          "occurred_at"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "run.activity"
          },
          "run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Stable identifier shared by every update for one activity."
          },
          "kind": {
            "type": "string",
            "enum": [
              "reasoning",
              "tool",
              "plugin",
              "subagent",
              "search"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "failed"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Customer-safe description. It cannot contain tool arguments, credentials, or hidden reasoning."
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunActivitySource"
              },
              {
                "$ref": "#/components/schemas/SearchActivitySource"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OutputTextDeltaEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "run_id",
          "output_index",
          "delta"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "output.text.delta"
          },
          "run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "output_index": {
            "type": "integer",
            "minimum": 0
          },
          "delta": {
            "type": "string"
          }
        }
      },
      "OutputItemAddedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
