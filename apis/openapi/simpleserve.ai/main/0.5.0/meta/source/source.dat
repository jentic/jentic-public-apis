{
  "openapi": "3.1.0",
  "info": {
    "title": "SimpleServe API",
    "version": "0.5.0",
    "summary": "Discover and run AI agents through one API.",
    "description": "The SimpleServe API provides a small customer-facing surface for discovering and\nrunning AI agents.\n\nA run can return text, files, structured data, and customer-visible tool\nrecords. Read `output` for the complete result. `output_text` contains the\ntext items when the result includes text.\n\nContinue work by creating a new run with `session_id`. SimpleServe manages\nprovider-specific persistence behind that field. Session routes provide\nthe signed-in user's chat history.\n\n`max_cost_usd` is an optional hard authorization ceiling. When omitted,\nSimpleServe uses the agent's published maximum. The provider must stop before its\nactual cost passes the effective limit. SimpleServe does not require a quote.\n\nPublishers use `/v1/publisher/*` to create, test, and release native\nSimpleServe agents. SimpleServe manages execution for every buyer.\n",
    "contact": {
      "name": "SimpleServe Support",
      "url": "https://simpleserve.ai"
    },
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-SimpleServe-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.simpleserve.ai",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Usage",
      "description": "Spend, tasks, and outcomes for the calling workspace."
    },
    {
      "name": "Agents",
      "description": "Search and inspect agents."
    },
    {
      "name": "Runs",
      "description": "Start, continue, inspect, stream, and cancel agent work."
    },
    {
      "name": "Workstreams",
      "description": "Organize related agent conversations around one objective."
    },
    {
      "name": "Sessions",
      "description": "Read the signed-in user's agent chats."
    },
    {
      "name": "Saved Agents",
      "description": "Manage the signed-in user's saved agents."
    },
    {
      "name": "Files",
      "description": "Upload agent inputs and download agent outputs."
    },
    {
      "name": "Support Intake",
      "description": "Connect support sources to Linear or Jira ticket intake."
    },
    {
      "name": "Publisher Agents",
      "description": "Create and edit agents owned by the current Workspace."
    },
    {
      "name": "Publisher Tests",
      "description": "Test the current draft through the standard Run response."
    },
    {
      "name": "Publisher Versions",
      "description": "Inspect immutable agent versions."
    },
    {
      "name": "Publisher Deployments",
      "description": "Release an agent privately or submit it for public review."
    },
    {
      "name": "Staff Reviews",
      "description": "Internal review routes for public agent submissions."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/feedback": {
      "post": {
        "operationId": "submitFeedback",
        "summary": "Send product feedback",
        "description": "Requires a signed-in user. Feedback and screenshots are private to the SimpleServe team.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Reuse the same key when retrying the same submission."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "message",
                  "page_path"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "page_path": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "Relative page path without a query or fragment."
                  },
                  "screenshot": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional PNG, JPEG, WebP, or GIF image up to 10 MB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feedback received. An identical retry returns the same identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "received"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid feedback."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "A signed-in user is required."
          },
          "409": {
            "description": "The submission key already has a different payload."
          },
          "413": {
            "description": "The screenshot is too large."
          }
        }
      }
    },
    "/v1/agents/search": {
      "get": {
        "operationId": "searchAgents",
        "summary": "Search agents by name or task",
        "description": "Use categories and providers to match any selected value. Capabilities, accepts, and returns require every selected value. Combine groups with AND. Median cost uses USD. Median time uses seconds. Bounds are inclusive and exclude unknown measurements. Facets ignore their own group. Each histogram value is one agent median. These measurements describe past runs, not guarantees. Anonymous requests see public agents. Authenticated requests also see their Workspace agents. A cursor belongs to one search and one version of the available results. Restart without a cursor after invalid_cursor.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 500,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "title": "Categories",
              "type": "array"
            }
          },
          {
            "name": "providers",
            "in": "query",
            "required": false,
            "schema": {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "title": "Providers",
              "type": "array"
            }
          },
          {
            "name": "capabilities",
            "in": "query",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "web_search",
                  "code_execution",
                  "browser_use",
                  "file_analysis",
                  "connected_apps",
                  "subagent_delegation"
                ],
                "type": "string"
              },
              "maxItems": 20,
              "title": "Capabilities",
              "type": "array"
            }
          },
          {
            "name": "accepts",
            "in": "query",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "text",
                  "file",
                  "image",
                  "pdf",
                  "csv",
                  "audio",
                  "video"
                ],
                "type": "string"
              },
              "maxItems": 20,
              "title": "Accepts",
              "type": "array"
            }
          },
          {
            "name": "returns",
            "in": "query",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "text",
                  "file",
                  "data"
                ],
                "type": "string"
              },
              "maxItems": 20,
              "title": "Returns",
              "type": "array"
            }
          },
          {
            "name": "min_cost_usd",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000000,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Cost Usd"
            }
          },
          {
            "name": "max_cost_usd",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000000,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Cost Usd"
            }
          },
          {
            "name": "min_time_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000000,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Time Seconds"
            }
          },
          {
            "name": "max_time_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000000000,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Time Seconds"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "default": "relevance",
              "enum": [
                "relevance",
                "name",
                "cost",
                "time",
                "updated"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching agents, facet counts, and measured ranges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSearchResult"
                }
              }
            }
          },
          "400": {
            "description": "A search filter or cursor is invalid, or the results changed."
          },
          "503": {
            "description": "Task search is unavailable. Retry the same search."
          }
        }
      }
    },
    "/v1/agents": {
      "get": {
        "tags": [
          "Agents"
        ],
        "operationId": "listAgents",
        "summary": "Search agents",
        "description": "Returns agents available to the current account. Search matches agent\nnames, descriptions, categories, and supported work.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          },
          {
            "$ref": "#/components/parameters/CategoryFilter"
          },
          {
            "$ref": "#/components/parameters/OutputTypeFilter"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of agents.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentList"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/AgentListExample"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/agents/{namespace}/{slug}": {
      "get": {
        "tags": [
          "Agents"
        ],
        "operationId": "getAgent",
        "summary": "Get an agent",
        "description": "Returns the current published version, supported outputs, data policy,\nand rate card for one agent.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentNamespace"
          },
          {
            "$ref": "#/components/parameters/AgentSlug"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested agent.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/AgentExample"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/agents/{namespace}/{slug}/metrics": {
      "get": {
        "tags": [
          "Agents"
        ],
        "operationId": "getAgentMetrics",
        "summary": "Get observed metrics for an agent",
        "description": "Returns what customers paid and waited on this agent's newest completed\npublic runs, lifetime completion counts, 30 days of daily activity, and a\nbreakdown by agent version. SimpleServe computes these values at run\nsettlement. Publishers cannot edit them.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentNamespace"
          },
          {
            "$ref": "#/components/parameters/AgentSlug"
          }
        ],
        "responses": {
          "200": {
            "description": "Observed metrics for the agent.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentMetrics"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/AgentMetricsExample"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": [
          "Usage"
        ],
        "operationId": "getWorkspaceUsage",
        "summary": "Usage for the calling workspace",
        "description": "What this workspace spent, how many tasks ran, how many completed, and what\ndrove the cost, for the last 7, 30, or 90 days, with the prior range of equal\nlength for comparison. Sums come from rollup rows written at run settlement.\nTypical cost and time are medians over the newest completed runs in the range\nand are null under 5.\n",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "90d"
              ],
              "default": "30d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace usage for the range.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceUsage"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/WorkspaceUsageExample"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/mserve/v1/me": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "operationId": "getIdentity",
        "summary": "Get the signed-in user and Workspace",
        "responses": {
          "200": {
            "description": "Current user and Workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "An API key cannot represent a signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/saved-agents": {
      "get": {
        "tags": [
          "Saved Agents"
        ],
        "operationId": "listSavedAgents",
        "summary": "List saved agents",
        "responses": {
          "200": {
            "description": "The signed-in user's saved agents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedAgentList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/saved-agents/order": {
      "put": {
        "tags": [
          "Saved Agents"
        ],
        "operationId": "reorderSavedAgents",
        "summary": "Set your saved agent order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SavedAgentOrder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Your saved agents in the requested order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedAgentList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "The saved agents changed. Reload and try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/saved-agents/{namespace}/{slug}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AgentNamespace"
        },
        {
          "$ref": "#/components/parameters/AgentSlug"
        }
      ],
      "put": {
        "tags": [
          "Saved Agents"
        ],
        "operationId": "saveAgent",
        "summary": "Save an agent",
        "responses": {
          "200": {
            "description": "The saved agent record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedAgent"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Saved Agents"
        ],
        "operationId": "removeSavedAgent",
        "summary": "Remove a saved agent",
        "responses": {
          "204": {
            "description": "The agent is not saved."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/general/models": {
      "get": {
        "operationId": "listGeneralModels",
        "summary": "List models available to SimpleServe General",
        "responses": {
          "200": {
            "description": "Available models with verified thinking options. A null option list means capabilities are unknown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneralModelList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/general/default-model": {
      "get": {
        "operationId": "getGeneralDefaultModel",
        "summary": "Read your default model for new General threads",
        "responses": {
          "200": {
            "description": "Your saved default in this Workspace. Auto applies when no default is saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneralDefaultModel"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "operationId": "setGeneralDefaultModel",
        "summary": "Set your default model for new General threads",
        "description": "Existing threads keep their model. Thinking effort uses the model default. Auto restores SimpleServe model selection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeneralDefaultModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The default is saved for this user and Workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneralDefaultModel"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "The model is unavailable or its connection is no longer active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dictation": {
      "get": {
        "operationId": "getDictation",
        "summary": "Read dictation allowance and the saved paid preference",
        "responses": {
          "200": {
            "description": "Preference and remaining included seconds for the signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictationStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "patch": {
        "operationId": "setDictationPreference",
        "summary": "Save the paid dictation preference on the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DictationPreferenceUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The preference is saved across conversations and devices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictationStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/dictation/transcriptions": {
      "post": {
        "operationId": "createDictationTranscript",
        "summary": "Transcribe a chat recording",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255
            }
          },
          {
            "in": "query",
            "name": "duration_ms",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300000
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcript text for the composer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictationTranscript"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Included minutes are exhausted or the Workspace is out of credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
