      "RunId": {
        "type": "string",
        "pattern": "^run_[A-Za-z0-9]+$",
        "example": "run_01JXYZ1234567890"
      },
      "SessionId": {
        "type": "string",
        "pattern": "^ses_[A-Za-z0-9]+$",
        "example": "ses_01JXYZ1234567890"
      },
      "WorkstreamId": {
        "type": "string",
        "pattern": "^wks_[A-Za-z0-9]+$",
        "example": "wks_01JXYZ1234567890"
      },
      "NodeKey": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "example": "synthesis"
      },
      "FileId": {
        "type": "string",
        "pattern": "^file_[A-Za-z0-9]+$",
        "example": "file_01JXYZ1234567890"
      },
      "OutputType": {
        "type": "string",
        "enum": [
          "text",
          "file",
          "data",
          "tool_use",
          "tool_result"
        ]
      },
      "SupportedCapabilityId": {
        "type": "string",
        "enum": [
          "web_search",
          "code_execution",
          "browser_use",
          "file_analysis",
          "connected_apps",
          "subagent_delegation"
        ]
      },
      "SupportedCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/SupportedCapabilityId"
          },
          "evidence": {
            "type": "string",
            "enum": [
              "platform_managed",
              "publisher_declared"
            ]
          }
        }
      },
      "AgentStatus": {
        "type": "string",
        "enum": [
          "available",
          "unavailable"
        ]
      },
      "Agent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_availability",
          "id",
          "object",
          "name",
          "description",
          "provider",
          "version",
          "status",
          "hosting",
          "categories",
          "example_prompts",
          "input",
          "output_types",
          "supported_capabilities",
          "compatible_plugins",
          "pricing",
          "data_policy",
          "observed",
          "updated_at"
        ],
        "properties": {
          "tool_availability": {
            "$ref": "#/components/schemas/ToolAvailability"
          },
          "id": {
            "$ref": "#/components/schemas/AgentId"
          },
          "object": {
            "type": "string",
            "const": "agent"
          },
          "observed": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentObserved"
              },
              {
                "type": "null"
              }
            ]
          },
          "ratings": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentMetrics/properties/ratings"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Supplier-defined immutable version label."
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus"
          },
          "hosting": {
            "type": "string",
            "enum": [
              "managed",
              "external"
            ],
            "description": "Managed agents run on SimpleServe. External agents run outside SimpleServe, including A2A agents. Hosting is independent of publisher identity."
          },
          "categories": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "example_prompts": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "input": {
            "$ref": "#/components/schemas/AgentInputSupport"
          },
          "output_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/OutputType"
            }
          },
          "supported_capabilities": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/SupportedCapability"
            }
          },
          "compatible_plugins": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "description": "Workspace plugins that the user can select for this agent.",
            "items": {
              "type": "string",
              "pattern": "^plugin_[A-Za-z0-9]+$"
            }
          },
          "pricing": {
            "$ref": "#/components/schemas/RateCard"
          },
          "payment": {
            "description": "How a buying agent pays from a wallet. Present when wallet payments are on. Read it before your first request to pay in one hop.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentPayment"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_policy": {
            "$ref": "#/components/schemas/DataPolicy"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Provider": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "verified",
          "logo_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "verified": {
            "type": "boolean",
            "description": "Whether SimpleServe verified control of the supplier identity."
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Publisher-controlled logo for agent discovery surfaces."
          },
          "website": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "AgentInputSupport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "files",
          "accepted_media_types"
        ],
        "properties": {
          "text": {
            "type": "boolean",
            "const": true,
            "description": "All SimpleServe agents accept a natural-language instruction."
          },
          "files": {
            "type": "boolean"
          },
          "accepted_media_types": {
            "type": "array",
            "uniqueItems": true,
            "description": "Empty when `files` is false. Wildcards such as `image/*` are allowed.",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255
            }
          }
        }
      },
      "RateCard": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "currency",
          "minimum_cost_usd",
          "maximum_cost_usd",
          "primary_meter_id",
          "meters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rc_[A-Za-z0-9_]+$"
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "minimum_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001,
            "description": "Minimum buyer charge for one run. The publisher's list price, with nothing added."
          },
          "maximum_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001,
            "description": "Maximum buyer charge for one run. The publisher's list price, with nothing added. This is not a quote."
          },
          "primary_meter_id": {
            "type": "string",
            "description": "Meter shown with the Agent in discovery views."
          },
          "meters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/RateCardMeter"
            }
          }
        }
      },
      "RateCardMeter": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit",
          "price_usd"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "example": "premium_searches"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "search"
          },
          "price_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001,
            "description": "Publisher price for one unit."
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "DataPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retention",
          "training"
        ],
        "properties": {
          "retention": {
            "type": "string",
            "enum": [
              "none",
              "temporary",
              "provider_defined"
            ]
          },
          "retention_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Required when the policy defines a fixed temporary period."
          },
          "training": {
            "type": "boolean"
          },
          "policy_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "AgentObserved": {
        "type": "object",
        "additionalProperties": false,
        "description": "What customers paid and waited, from the agent's newest completed public\nruns. SimpleServe computes this; publishers cannot edit it. `status` is\n`insufficient_data` below 5 completed runs, `early` from 5 to 19, and\n`ok` from 20. Agents with no completed runs return zero counts and nulls.\n",
        "required": [
          "status",
          "sample_size",
          "full_at",
          "median_cost_usd",
          "p90_cost_usd",
          "median_duration_seconds",
          "completion_rate",
          "last_completed_at"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ObservedStatus"
          },
          "sample_size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "full_at": {
            "type": "integer",
            "const": 20
          },
          "median_cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Median buyer cost per completed run in the sample. Present from `early`."
          },
          "p90_cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "90th percentile buyer cost. Present from `ok`."
          },
          "median_duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Median start-to-finish time. Present from `early`."
          },
          "completion_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Lifetime completed / (completed + failed). Null before the first attempt."
          },
          "last_completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ObservedStatus": {
        "type": "string",
        "enum": [
          "insufficient_data",
          "early",
          "ok"
        ]
      },
      "AgentMetrics": {
        "type": "object",
        "additionalProperties": false,
        "description": "Observed ratings, cost, speed, reliability, and activity for one agent.",
        "required": [
          "object",
          "agent",
          "status",
          "sample",
          "lifetime",
          "cost",
          "speed",
          "reliability",
          "ratings",
          "daily",
          "samples",
          "versions",
          "updated_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "const": "agent.metrics"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentId"
          },
          "status": {
            "$ref": "#/components/schemas/ObservedStatus"
          },
          "sample": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size",
              "capacity",
              "full_at",
              "oldest_completed_at"
            ],
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "capacity": {
                "type": "integer",
                "const": 50
              },
              "full_at": {
                "type": "integer",
                "const": 20
              },
              "oldest_completed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "lifetime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "completed_count",
              "failed_count",
              "cancelled_count",
              "limit_reached_count"
            ],
            "properties": {
              "completed_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Runs that finished on their own. Excludes limit stops."
              },
              "failed_count": {
                "type": "integer",
                "minimum": 0
              },
              "cancelled_count": {
                "type": "integer",
                "minimum": 0
              },
              "limit_reached_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Runs that stopped at the agent's own published maximum. A stop at a lower limit the buyer chose is not counted here."
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "median_usd",
              "p90_usd",
              "limit_reached_rate",
              "publisher_maximum_usd",
              "meter_averages"
            ],
            "properties": {
              "median_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "p90_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "limit_reached_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1,
                "description": "Share of the sample that stopped at the agent's own published maximum."
              },
              "publisher_maximum_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Copied from the rate card. The most one run can charge."
              },
              "meter_averages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "unit",
                    "mean_quantity",
                    "mean_cost_usd"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string",
                      "description": "Customer-facing meter name, for example `Web searches`."
                    },
                    "unit": {
                      "type": "string"
                    },
                    "mean_quantity": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mean_cost_usd": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "speed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "median_seconds",
              "p90_seconds"
            ],
            "properties": {
              "median_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "p90_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "completion_rate",
              "last_completed_at"
            ],
            "properties": {
              "completion_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "last_completed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "ratings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "finished_count",
              "partly_count",
              "not_finished_count",
              "finished_rate",
              "partly_rate",
              "not_finished_rate"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "finished_count": {
                "type": "integer",
                "minimum": 0
              },
              "partly_count": {
                "type": "integer",
                "minimum": 0
              },
              "not_finished_count": {
                "type": "integer",
                "minimum": 0
              },
              "finished_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1,
                "description": "Share of explicit ratings marked Yes."
              },
              "partly_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "not_finished_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "daily": {
            "type": "array",
            "minItems": 30,
            "maxItems": 30,
            "description": "One row per UTC day, oldest first, zero rows filled in.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "completed",
                "failed",
                "limit_reached",
                "cancelled",
                "mean_cost_usd"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "completed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit_reached": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Runs that stopped at the agent's own published maximum."
                },
                "cancelled": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean_cost_usd": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Mean charge across completed and limit-reached runs."
                }
              }
            }
          },
          "samples": {
            "type": "array",
            "maxItems": 50,
            "description": "One point per completed run in the sample, oldest first.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "completed_at",
                "cost_usd",
                "duration_seconds",
                "version_id",
                "version_number",
                "limit_reached"
              ],
              "properties": {
                "completed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "version_id": {
                  "type": "string"
                },
                "version_number": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "0 when the run has no managed agent version."
                },
                "limit_reached": {
                  "type": "boolean"
                }
              }
            }
          },
          "versions": {
            "type": "array",
            "description": "Sample grouped by agent version, newest first.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version_id",
                "version_number",
                "completed_count",
                "median_cost_usd",
                "first_seen_at",
                "last_seen_at"
              ],
              "properties": {
                "version_id": {
                  "type": "string"
                },
                "version_number": {
                  "type": "integer",
                  "minimum": 0
                },
                "completed_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "median_cost_usd": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "first_seen_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "last_seen_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgentList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "data",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateWorkstreamNode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "agent",
          "title",
          "input_template"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/NodeKey",
            "description": "Unique node name used by dependencies and template references."
          },
          "agent": {
            "$ref": "#/components/schemas/AgentId",
            "description": "Agent that runs this node."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Short human-readable name for this Thread."
          },
          "input_template": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "Instruction for this agent. Reference an ancestor with `{{nodes.<key>.output}}` or `{{nodes.<key>.artifacts}}`."
          },
          "depends_on": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "default": [],
            "description": "Direct dependency node keys. Omit this field for a root node.",
            "items": {
              "$ref": "#/components/schemas/NodeKey"
            }
          },
          "file_ids": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "default": [],
            "description": "Existing SimpleServe files attached to this node.",
            "items": {
              "$ref": "#/components/schemas/FileId"
            }
          },
          "max_cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "multipleOf": 0.000001,
            "description": "Optional hard cost limit for this node."
          }
        }
      },
      "CreateWorkstreamRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "objective",
          "nodes"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Human-readable Workstream name."
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Shared outcome for every node in this Workstream."
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "description": "Complete acyclic graph. Submit every node in one request.",
            "items": {
              "$ref": "#/components/schemas/CreateWorkstreamNode"
            }
          }
