            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ThreadFileList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "has_more",
          "next_cursor",
          "directory_generation",
          "save_state",
          "save_error",
          "save_operation",
          "busy",
          "max_file_bytes",
          "storage_limit_bytes"
        ],
        "properties": {
          "data": {
            "type": "array",
