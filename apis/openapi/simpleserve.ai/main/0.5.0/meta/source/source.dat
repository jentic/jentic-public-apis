          "version",
          "endpoint",
          "protocol",
          "input_modes",
          "output_modes",
          "example_prompts",
          "supports_commerce",
          "checked_at"
        ],
        "title": "ExternalConnection",
        "type": "object"
      },
      "ConnectionCheck": {
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "discovery",
              "authentication",
              "protocol",
              "capabilities",
              "endpoint",
              "retry_safety"
            ],
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_checked",
              "declared"
            ],
            "title": "Status",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ConnectionIssue"
            },
            "title": "Issues",
            "type": "array"
          }
        },
        "required": [
          "stage",
          "status",
          "message"
        ],
        "title": "ConnectionCheck",
        "type": "object"
      },
      "ConnectionIssue": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "received": {
            "title": "Received",
            "type": "string"
          },
          "expected": {
            "title": "Expected",
            "type": "string"
          },
          "suggested_fix": {
            "title": "Suggested Fix",
            "type": "string"
          }
        },
        "required": [
          "field",
          "received",
          "expected",
          "suggested_fix"
        ],
        "title": "ConnectionIssue",
        "type": "object"
      },
      "ExternalConnectionRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_card_url": {
            "maxLength": 2048,
            "minLength": 8,
            "pattern": "^https://",
            "title": "Agent Card Url",
            "type": "string"
          },
          "authentication": {
            "default": "none",
            "enum": [
              "none",
              "bearer"
            ],
            "title": "Authentication",
            "type": "string"
          },
          "bearer_token": {
            "anyOf": [
              {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bearer Token",
            "writeOnly": true
          },
          "retry_safety": {
            "anyOf": [
              {
                "enum": [
                  "deduplicated",
                  "free_read_only"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retry Safety"
          }
        },
        "required": [
          "agent_card_url"
        ],
        "title": "ExternalConnectionRequest",
        "type": "object"
      },
      "AgentSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "q": {
            "default": "",
            "maxLength": 500,
            "title": "Q",
            "type": "string"
          },
          "categories": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Categories",
            "type": "array"
          },
          "providers": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Providers",
            "type": "array"
          },
          "capabilities": {
            "items": {
