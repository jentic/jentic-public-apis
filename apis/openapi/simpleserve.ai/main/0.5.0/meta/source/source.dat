            "type": "boolean"
          },
          "max_file_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "storage_limit_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PublisherAgentRemoval": {
