    "responses": {
      "PublisherForbidden": {
        "description": "The API key lacks the required publisher or staff scope.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "This API key cannot manage agents.",
                "type": "permission_error",
                "param": null,
                "code": "insufficient_scope"
              }
            }
          }
        }
      },
      "PublisherConflict": {
        "description": "The slug or idempotency key conflicts with existing state.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "slug": {
                "value": {
                  "error": {
                    "message": "This slug is already in use in your namespace.",
                    "type": "invalid_request_error",
                    "param": "slug",
                    "code": "slug_conflict"
                  }
                }
              },
              "idempotency": {
                "value": {
                  "error": {
                    "message": "This idempotency key was already used with another request.",
                    "type": "invalid_request_error",
                    "param": "Idempotency-Key",
                    "code": "idempotency_conflict"
                  }
                }
              }
            }
          }
        }
      },
      "RevisionConflict": {
        "description": "The supplied draft revision is stale, or the idempotency key conflicts.",
        "headers": {
          "etag": {
            "$ref": "#/components/headers/DraftEtag"
          },
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "revision": {
                "value": {
                  "error": {
                    "message": "The draft changed after this revision was loaded.",
                    "type": "invalid_request_error",
                    "param": "If-Match",
                    "code": "revision_conflict"
                  }
                }
              },
              "idempotency": {
                "value": {
                  "error": {
                    "message": "This idempotency key was already used with another request.",
                    "type": "invalid_request_error",
                    "param": "Idempotency-Key",
                    "code": "idempotency_conflict"
                  }
                }
              }
            }
          }
        }
      },
      "PublicSubmissionConflict": {
        "description": "The draft revision, idempotency key, or active review conflicts with this submission.",
        "headers": {
          "etag": {
            "$ref": "#/components/headers/DraftEtag"
          },
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "active_review": {
                "value": {
                  "error": {
                    "message": "This agent already has a public submission under review.",
                    "type": "invalid_request_error",
                    "param": null,
                    "code": "active_review_exists"
                  }
                }
              },
              "revision": {
                "value": {
                  "error": {
                    "message": "The draft changed after this revision was loaded.",
                    "type": "invalid_request_error",
                    "param": "If-Match",
                    "code": "revision_conflict"
                  }
                }
              },
              "idempotency": {
                "value": {
                  "error": {
                    "message": "This idempotency key was already used with another request.",
                    "type": "invalid_request_error",
                    "param": "Idempotency-Key",
                    "code": "idempotency_conflict"
                  }
                }
              }
            }
          }
        }
      },
      "InvalidPublisherTransition": {
        "description": "The requested state change is not valid for this deployment or review.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "This resource is already in a final state.",
                "type": "invalid_request_error",
                "param": null,
                "code": "invalid_transition"
              }
            }
          }
        }
      },
      "DraftInvalid": {
        "description": "The draft has blockers for this action.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DraftInvalidErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "The draft is not ready for public review.",
                "type": "invalid_request_error",
                "param": "pricing",
                "code": "draft_invalid"
              },
              "validation": {
                "private_ready": true,
                "public_ready": false,
                "errors": [
                  {
                    "path": "pricing",
                    "message": "Add public usage pricing.",
                    "blocks": "public"
                  }
                ]
              }
            }
          }
        }
      },
      "AgentReviewDecision": {
        "description": "The review after the decision.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentReview"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request is invalid.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "max_cost_usd is below this agent's published minimum cost.",
                "type": "invalid_request_error",
                "param": "max_cost_usd",
                "code": "max_cost_too_low"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The API key is missing or invalid.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "Authentication failed.",
                "type": "authentication_error",
                "param": null,
                "code": "authentication_failed"
              }
            }
          }
        }
      },
      "PaymentRequired": {
        "description": "The account balance or wallet cannot cover the authorized maximum cost.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          },
          "PAYMENT-REQUIRED": {
            "$ref": "#/components/headers/PaymentRequired"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              ]
            },
            "example": {
              "error": {
                "message": "The account balance cannot cover the effective spending limit.",
                "type": "payment_error",
                "param": "max_cost_usd",
                "code": "insufficient_balance"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource does not exist or is not visible to this account.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "The requested resource was not found.",
                "type": "invalid_request_error",
                "param": null,
                "code": "not_found"
              }
            }
          }
        }
      },
      "Gone": {
        "description": "The file existed but its content expired.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "The file content expired.",
                "type": "invalid_request_error",
                "param": "file_id",
                "code": "gone"
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with existing state.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "This idempotency key was already used with another request.",
                "type": "invalid_request_error",
                "param": "Idempotency-Key",
                "code": "idempotency_conflict"
              }
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The request or uploaded file exceeds the account limit.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "The uploaded file exceeds the account limit.",
                "type": "invalid_request_error",
                "param": "file",
                "code": "payload_too_large"
              }
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The uploaded media type is not accepted.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "The uploaded media type is not accepted.",
                "type": "invalid_request_error",
                "param": "file",
                "code": "unsupported_media_type"
              }
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "The request is valid JSON but cannot be executed as specified.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "example": {
              "error": {
                "message": "This agent does not accept one of the attached file types.",
                "type": "invalid_request_error",
                "param": "files",
                "code": "invalid_file"
