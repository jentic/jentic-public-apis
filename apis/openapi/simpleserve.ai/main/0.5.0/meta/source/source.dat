          },
          "source_connection_id": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "slack_channel",
              "email_inbox"
            ]
          },
          "source_resource_id": {
            "type": "string"
          },
          "source_resource_label": {
            "type": "string"
          },
          "destination_connection_id": {
            "type": "string"
          },
          "destination_kind": {
            "type": "string",
            "enum": [
              "linear",
              "jira"
            ]
          },
          "destination_resource_id": {
            "type": "string"
          },
          "destination_resource_label": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "destination_fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "connection_required",
              "paused"
            ]
