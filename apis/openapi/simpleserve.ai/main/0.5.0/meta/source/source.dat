      "ManagedToolId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "examples": [
          "web.search",
          "browser",
          "shell"
        ]
      },
      "PluginReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "version"
        ],
        "properties": {
          "plugin_id": {
            "type": "string",
            "pattern": "^plugin_[A-Za-z0-9]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
            "description": "Exact plugin version."
          }
        }
      },
      "PublisherPricing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimum_cost_usd",
          "maximum_cost_usd",
          "rates"
        ],
        "description": "Usage pricing for one version. `maximum_cost_usd` must be greater than\nor equal to `minimum_cost_usd`. Each meter can appear only once.\n",
        "properties": {
          "minimum_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001
          },
          "maximum_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.000001
          },
          "rates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/StandardMeterRate"
            }
          }
        }
      },
      "StandardMeterRate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meter",
          "price_usd"
        ],
        "properties": {
          "meter": {
            "type": "string",
            "enum": [
              "model_input_tokens",
              "model_output_tokens",
              "sandbox_seconds",
              "tool_calls",
              "dataforseo_cost_microusd"
            ]
          },
          "price_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Published price for one unit."
          }
        }
      },
      "DraftValidation": {
        "type": "object",
