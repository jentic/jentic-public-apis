  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SimpleServe API key",
        "description": "Send a SimpleServe API key as `Authorization: Bearer <key>`."
      },
      "staffAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SimpleServe staff credential",
        "description": "Internal SimpleServe reviewer authentication."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Stable identifier for this HTTP request.",
        "schema": {
          "type": "string",
          "example": "req_01JXYZ1234567890"
        }
      },
      "DraftEtag": {
        "description": "Revision identifier required by draft test and release requests.",
        "schema": {
          "type": "string",
          "pattern": "^(?:W/)?\"draft-[1-9][0-9]*\"$",
          "example": "\"draft-12\""
        }
      },
      "PaymentRequired": {
        "description": "Base64-encoded x402 payment terms. Present on wallet payment responses.",
        "schema": {
          "type": "string"
        }
      },
      "PaymentResponse": {
        "description": "Base64-encoded x402 settlement receipt. Present when this request settles a payment.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "PublisherAgentId": {
        "name": "agent_id",
        "in": "path",
        "required": true,
        "description": "Publisher-owned agent ID.",
        "schema": {
          "$ref": "#/components/schemas/PublisherAgentId"
        }
      },
      "AgentVersionId": {
        "name": "version_id",
        "in": "path",
        "required": true,
        "description": "Immutable agent version ID.",
        "schema": {
          "$ref": "#/components/schemas/AgentVersionId"
        }
      },
      "DeploymentId": {
        "name": "deployment_id",
        "in": "path",
        "required": true,
        "description": "Agent deployment ID.",
        "schema": {
          "$ref": "#/components/schemas/DeploymentId"
        }
      },
      "ReviewId": {
        "name": "review_id",
        "in": "path",
        "required": true,
        "description": "Public review ID.",
        "schema": {
          "$ref": "#/components/schemas/ReviewId"
        }
      },
      "IfMatchDraft": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "ETag from the latest draft response.",
        "schema": {
          "type": "string",
          "pattern": "^(?:W/)?\"draft-[1-9][0-9]*\"$"
        },
        "example": "\"draft-12\""
      },
      "PublisherLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum records to return.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "ReviewStatusFilter": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Return reviews with this exact status.",
        "schema": {
          "$ref": "#/components/schemas/ReviewStatus"
        }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Natural-language search text.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "example": "construction projects in Miami"
      },
      "CategoryFilter": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Exact category slug.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "example": "construction"
      },
      "OutputTypeFilter": {
        "name": "output_type",
        "in": "query",
        "required": false,
        "description": "Require support for this final output type.",
        "schema": {
          "$ref": "#/components/schemas/OutputType"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum agents to return.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor from `next_cursor`.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "AgentNamespace": {
        "name": "namespace",
        "in": "path",
        "required": true,
        "description": "Supplier namespace from the namespaced agent ID.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "example": "acme"
      },
      "AgentSlug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "description": "Agent slug from the namespaced agent ID.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "example": "construction-researcher"
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RunId"
        }
      },
      "WorkstreamId": {
        "name": "workstream_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/WorkstreamId"
        }
      },
      "WorkstreamCursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Workstream ID from `next_cursor`.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "FileId": {
        "name": "file_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/FileId"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Prevents duplicate work and charges when a request is retried. Reusing\na key with a different request returns `409 idempotency_conflict`.\n",
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "example": "01JXYZ1234567890ABCDEF"
      },
      "LastEventId": {
        "name": "Last-Event-ID",
        "in": "header",
        "required": false,
        "description": "Resume a Run event stream after this durable event number.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "PaymentSignature": {
        "name": "PAYMENT-SIGNATURE",
        "in": "header",
        "required": false,
        "description": "Base64-encoded x402 v2 payment payload.",
        "schema": {
          "type": "string"
        }
      },
      "SignInWithX": {
        "name": "SIGN-IN-WITH-X",
        "in": "header",
        "required": false,
        "description": "CAIP-122 proof for a wallet with an existing credit balance.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ThreadSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/AgentId"
          },
