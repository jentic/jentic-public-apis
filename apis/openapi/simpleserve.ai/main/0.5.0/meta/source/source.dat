          }
        }
      },
      "ThreadFolderRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "parent_id",
          "expected_generation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ThreadEntryPatch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_generation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ThreadRestoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_generation"
        ],
        "properties": {
          "expected_generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ThreadRetrySaveRequest": {
        "type": "object",
