            "default": null,
            "title": "Retry Safety"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          },
          "protocol": {
            "title": "Protocol",
            "type": "string"
          },
          "input_modes": {
            "items": {
              "type": "string"
            },
            "title": "Input Modes",
            "type": "array"
          },
          "output_modes": {
            "items": {
              "type": "string"
            },
            "title": "Output Modes",
            "type": "array"
          },
          "example_prompts": {
            "items": {
              "type": "string"
            },
            "title": "Example Prompts",
            "type": "array"
          },
          "supports_commerce": {
            "title": "Supports Commerce",
