      "CreateAgentTestRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "files": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FileId"
            }
          },
          "plugins": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "default": [],
            "description": "Connected Workspace plugins available to this managed-agent run.",
            "items": {
              "type": "string",
              "pattern": "^plugin_[A-Za-z0-9]+$"
            }
          },
          "session_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionId"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "max_cost_usd": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01
          },
          "background": {
            "type": "boolean",
            "default": false
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        },
        "allOf": [
          {
            "not": {
              "required": [
                "background",
                "stream"
              ],
              "properties": {
                "background": {
                  "const": true
                },
                "stream": {
                  "const": true
                }
              }
            }
          }
        ]
      },
