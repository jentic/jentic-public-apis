            "type": "integer",
            "default": 0
          }
        }
      },
      "GeneralExecutionChoice": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "default": "simpleserve",
            "enum": [
              "simpleserve",
              "chatgpt"
            ],
            "title": "Provider",
            "type": "string"
          },
          "model": {
            "default": "auto",
            "maxLength": 255,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "effort": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Effort"
          }
        },
        "title": "GeneralExecutionChoice",
        "type": "object"
      },
      "GeneralRunExecution": {
        "additionalProperties": false,
