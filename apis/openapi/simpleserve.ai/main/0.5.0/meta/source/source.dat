            "type": "string",
            "enum": [
              "slack_channel",
              "email_inbox"
            ]
          },
          "source_resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "source_resource_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "destination_connection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "destination_kind": {
            "type": "string",
            "enum": [
              "linear",
              "jira"
            ]
          },
          "destination_resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "destination_resource_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "labels": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "destination_fields": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string"
            }
          },
          "slack_channel_private": {
            "type": "boolean",
            "default": false
          }
        }
