              }
            ],
            "default": null,
            "title": "Pricing"
          },
          "icon_file_id": {
            "anyOf": [
              {
                "pattern": "^file_[A-Za-z0-9]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Icon File Id"
          },
          "categories": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 5,
            "title": "Categories",
            "type": "array"
          },
          "example_prompts": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "title": "Example Prompts",
            "type": "array"
          },
          "test_status": {
            "anyOf": [
              {
                "enum": [
                  "queued",
                  "running",
                  "completed",
                  "failed",
                  "limit_reached",
                  "cancelled"
