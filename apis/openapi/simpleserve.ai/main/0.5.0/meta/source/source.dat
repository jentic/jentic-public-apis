          "save_operation_id"
        ],
        "properties": {
          "save_operation_id": {
            "type": "string"
          }
        }
      },
      "ThreadSaveStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "tool_step_id",
          "last_committed_generation",
          "state",
          "recovery",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_committed_generation": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "saving",
              "saved",
              "failed"
            ]
          },
          "recovery": {
            "type": "string",
            "enum": [
              "none",
              "retryable",
              "unavailable"
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ThreadEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "session_id",
          "parent_id",
          "name",
          "path",
          "kind",
          "file",
          "revision_id",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "session_id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "folder"
            ]
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
