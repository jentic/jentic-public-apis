                "code_execution",
                "browser_use",
                "file_analysis",
                "connected_apps",
                "subagent_delegation"
              ],
              "type": "string"
            },
            "maxItems": 20,
            "title": "Capabilities",
            "type": "array"
          },
          "accepts": {
            "items": {
              "enum": [
                "text",
                "file",
                "image",
                "pdf",
                "csv",
                "audio",
                "video"
              ],
              "type": "string"
            },
            "maxItems": 20,
            "title": "Accepts",
            "type": "array"
          },
          "returns": {
            "items": {
              "enum": [
                "text",
                "file",
                "data"
              ],
              "type": "string"
            },
            "maxItems": 20,
            "title": "Returns",
            "type": "array"
          },
          "min_cost_usd": {
            "anyOf": [
              {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Cost Usd"
          },
          "max_cost_usd": {
            "anyOf": [
              {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Cost Usd"
          },
          "min_time_seconds": {
            "anyOf": [
              {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Time Seconds"
          },
          "max_time_seconds": {
            "anyOf": [
              {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Time Seconds"
          },
          "sort": {
            "default": "relevance",
