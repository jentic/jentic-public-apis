    "/user/v1/user/update_email_mobile": {
      "post": {
        "summary": "Update Email or Mobile",
        "description": "Updates the authenticated user's email or mobile number after successful OTP verification. Provide either email OR mobile with calling_code.\n",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "required": [
                      "email"
                    ]
                  },
                  {
                    "required": [
                      "mobile",
                      "calling_code"
                    ]
                  }
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "newemail@example.com"
                  },
                  "mobile": {
                    "type": "string",
                    "example": "9876543210"
                  },
                  "calling_code": {
                    "type": "string",
                    "example": "+91"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact updated successfully",
            "content": {
              "application/json": {
                "examples": {
                  "EmailUpdate": {
                    "summary": "Email Updated Successfully",
                    "value": {
                      "status": true,
                      "message": "User Email updated successfully.",
                      "data": {
                        "email": "newemail@example.com",
                        "mobile": null,
                        "calling_code": null
                      },
                      "meta": {},
                      "error": {}
                    }
                  },
                  "MobileUpdate": {
                    "summary": "Mobile Updated Successfully",
                    "value": {
                      "status": true,
                      "message": "User Mobile updated successfully.",
                      "data": {
                        "email": null,
                        "mobile": "9876543255",
                        "calling_code": "+91"
                      },
                      "meta": {},
                      "error": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "MissingContact": {
                    "summary": "Missing email or mobile",
                    "value": {
                      "status": false,
                      "message": "Provide either email or mobile with calling_code.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US016",
                        "type": "Validation Error",
                        "details": "Email or mobile + calling_code is required."
                      }
                    }
                  },
                  "BothProvided": {
                    "summary": "Both email and mobile provided",
                    "value": {
                      "status": false,
                      "message": "Provide only one contact method.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US039",
                        "type": "Validation Error",
                        "details": "Email and mobile cannot be updated together."
                      }
                    }
                  },
                  "AlreadyExists": {
                    "summary": "Email or mobile already in use",
                    "value": {
                      "status": false,
                      "message": "This contact is already associated with another account.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US021",
                        "type": "Validation Error",
                        "details": "Duplicate email or mobile."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        },
        "security": [
          {
            "ApiToken": []
          }
        ]
      }
    },
    "/user/v1/user/update_otp_verify": {
      "post": {
        "summary": "Update Verify OTP (Email/Mobile)",
        "description": "Verifies OTP for various intents (Email, Mobile).",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/VerifyOTPRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "intent": {
                        "type": "string",
                        "enum": [
                          "forgot_password"
                        ],
                        "example": "forgot_password"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP Verified",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "An OTP has successfully verified.",
                  "data": {},
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "MissingEmailOrMobile": {
                    "summary": "Email or Mobile required",
                    "value": {
                      "status": false,
                      "message": "Either email or mobile number is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US016",
                        "type": "Validation Error",
                        "details": "Provide email or mobile + calling_code."
                      }
                    }
                  },
                  "MissingOtp": {
                    "summary": "OTP required",
                    "value": {
                      "status": false,
                      "message": "OTP is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US011",
                        "type": "Validation Error",
                        "details": "Please provide otp."
                      }
                    }
                  },
                  "InvalidEmailFormat": {
                    "summary": "Invalid email",
                    "value": {
                      "status": false,
                      "message": "Invalid email format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US019",
                        "type": "Validation Error",
                        "details": "Email must be a valid format."
                      }
                    }
                  },
                  "InvalidMobileFormat": {
                    "summary": "Invalid mobile",
                    "value": {
                      "status": false,
                      "message": "Invalid mobile number.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US020",
                        "type": "Validation Error",
                        "details": "Mobile number must contain only digits."
                      }
                    }
                  },
                  "InvalidOtp": {
                    "summary": "Incorrect OTP",
                    "value": {
                      "status": false,
                      "message": "Invalid OTP.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US015",
                        "type": "Validation Error",
                        "details": "The OTP you entered is incorrect."
                      }
                    }
                  },
                  "InvalidIntent": {
                    "summary": "Invalid intent value",
                    "value": {
                      "status": false,
                      "message": "Invalid intent.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US038",
                        "type": "Validation Error",
                        "details": "Intent must be registration."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "OtpExpired",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "OTP has expired.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US013",
                    "type": "Validation Error",
                    "details": "Request a new OTP."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/update_resend_otp": {
      "post": {
        "summary": "Update Resend OTP (If Expired)",
