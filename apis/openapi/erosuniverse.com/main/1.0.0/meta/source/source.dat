{
  "openapi": "3.0.0",
  "info": {
    "title": "User App API",
    "description": "API specification for User Authentication and Profile management.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/logituit-fae/user-app-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.erosuniverse.com",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "paths": {
    "/user/v1/device/{device_id}": {
      "get": {
        "summary": "Check Device Invite Status",
        "description": "Checks whether a device is already invited using device_id.",
        "tags": [
          "Device Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          },
          {
            "name": "device_id",
            "in": "query",
            "required": true,
            "description": "Unique device identifier",
            "schema": {
              "type": "string",
              "example": "device_abc123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device invite status",
            "content": {
              "application/json": {
                "examples": {
                  "DeviceInvited": {
                    "summary": "Device already invited",
                    "value": {
                      "status": true,
                      "message": "Device is already invited",
                      "data": {
                        "device_id": "device_abc123",
                        "coupon_id": "invite50"
                      },
                      "meta": {},
                      "error": {}
                    }
                  },
                  "DeviceNotInvited": {
                    "summary": "Device not invited",
                    "value": {
                      "status": true,
                      "message": "Device is Not Invited",
                      "data": {},
                      "meta": {},
                      "error": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing device_id",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "device_id is required",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US400",
                    "type": "Validation Error",
                    "details": "Query parameter device_id is missing."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/device/invite": {
      "post": {
        "summary": "Invite Device Using Coupon",
        "description": "Invites a device using a valid coupon code.",
        "tags": [
          "Device Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device invited successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "Device invited successfully",
                  "data": {
                    "device_id": "device_abc123",
                    "coupon_id": "invite50"
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "200": {
            "description": "Coupon validation error",
            "content": {
              "application/json": {
                "examples": {
                  "CouponExpired": {
                    "summary": "Coupon expired or consumed",
                    "value": {
                      "status": false,
                      "message": "Coupon expired or consumed",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US200",
                        "type": "Invalid Coupon",
                        "details": "Coupon expired or consumed"
                      }
                    }
                  },
                  "CouponNotFound": {
                    "summary": "Coupon code does not exist",
                    "value": {
                      "status": false,
                      "message": "Coupon code does not exist.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US200",
                        "type": "Invalid Coupon",
                        "details": "Coupon code does not exist."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "examples": {
                  "MissngDeviceID": {
                    "summary": "Missing Device Id",
                    "value": {
                      "status": false,
                      "message": "device_id is required",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US400",
                        "type": "Validation Error",
                        "details": "Query parameter device_id is missing."
                      }
                    }
                  },
                  "MissngCOupenID": {
                    "summary": "Missing Coupen Id",
                    "value": {
                      "status": true,
                      "message": "coupen_id is required",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US400",
                        "type": "Validation Error",
                        "details": "Query parameter coupen_id is missing."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/register_with_profile": {
      "post": {
        "summary": "Sign Up - Step 1 (Check Existence and Register)",
        "description": "Checks if the user already exists before registration.",
        "tags": [
          "Registration"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterWithProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User state returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                },
                "example": {
                  "status": true,
                  "message": "User Created. Redirect to OTP verification.",
                  "data": {
                    "redirect_url": "erosnowapp://verify_otp?email=user@example.com&intent=registration"
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "409": {
            "description": "User already exists",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "User already registered.",
                  "data": {
                    "user_status": "US001"
                  },
                  "meta": {},
                  "error": {
                    "code": "US001",
                    "type": "User exists",
                    "details": "User is already registered"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "MissingEmailOrMobile": {
                    "summary": "Email or Mobile is required",
                    "value": {
                      "status": false,
                      "message": "Either email or mobile number is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US004",
                        "type": "Validation Error",
                        "details": "Provide either a valid email or mobile + calling_code."
                      }
                    }
                  },
                  "MissingPassword": {
                    "summary": "Password is required",
                    "value": {
                      "status": false,
                      "message": "Password is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US017",
                        "type": "Validation Error",
                        "details": "Password cannot be empty."
                      }
                    }
                  },
                  "MissingCallingCode": {
                    "summary": "Calling code is required when mobile is provided",
                    "value": {
                      "status": false,
                      "message": "Calling code is required when mobile number is provided.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US018",
                        "type": "Validation Error",
                        "details": "Provide calling_code along with mobile number."
                      }
                    }
                  },
                  "InvalidEmailFormat": {
                    "summary": "Invalid email format",
                    "value": {
                      "status": false,
                      "message": "Invalid email format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US019",
                        "type": "Validation Error",
                        "details": "Email must be a valid format."
                      }
                    }
                  },
                  "InvalidMobileFormat": {
                    "summary": "Invalid mobile number format",
                    "value": {
                      "status": false,
                      "message": "Invalid mobile number format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US020",
                        "type": "Validation Error",
                        "details": "Mobile number should contain only digits."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/verify_otp_register": {
      "post": {
        "summary": "Sign Up - Step 2 (Verify OTP & Create)",
        "description": "Verifies OTP, sets password, and creates the user account.",
        "tags": [
          "Registration"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOTPRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User registered and logged in",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "User registered successfully.",
                  "data": {
                    "auth_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ1dWlkIjoiMDcxYTI5MzktZGM4Mi00NDE3LTk0MTYtYzgxZWRhODZiYmY3IiwiZXhwIjoxNzczMzA3Nzc1fQ.zf55gvxEGDuhx6NmYe9e_q_CEtxQg2UMFKu-0XQnqMU"
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationOTPErrorResponse"
          },
          "404": {
            "description": "OTP expired",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "OTP expired.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US013",
                    "type": "OTP Error",
                    "details": "Please request a new OTP."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Incorrect OTP or already verified",
            "content": {
              "application/json": {
                "examples": {
                  "OTPIncorrect": {
                    "summary": "OTP does not match",
                    "value": {
                      "status": false,
                      "message": "Invalid OTP.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US012",
                        "type": "OTP Mismatch",
                        "details": "The provided OTP is incorrect."
                      }
                    }
                  },
                  "AlreadyVerified": {
                    "summary": "Already verified",
                    "value": {
                      "status": false,
                      "message": "User already verified.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US014",
                        "type": "Already Verified",
                        "details": "The OTP for this session is already used."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/resend_otp": {
      "post": {
        "summary": "Resend OTP (If Expired)",
        "description": "Resends OTP for Registration",
        "tags": [
          "Registration"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ResendOTPRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "intent": {
                        "type": "string",
                        "enum": [
                          "registration"
                        ],
                        "example": "registration"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ResendOTPSuccess"
          },
          "400": {
            "$ref": "#/components/responses/ResendOTPBadRequest"
          },
          "404": {
            "$ref": "#/components/responses/ResendOTPNotFound"
          }
        }
      }
    },
    "/user/v1/user/login": {
      "post": {
        "summary": "Sign In / Login",
        "description": "Authenticates a user using Email or Mobile.",
        "tags": [
          "Login"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "User logged in successfully",
                  "data": {
                    "auth_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ1dWlkIjoiMDcxYTI5MzktZGM4Mi00NDE3LTk0MTYtYzgxZWRhODZiYmY3IiwiZXhwIjoxNzczMzA3Nzc1fQ.zf55gvxEGDuhx6NmYe9e_q_CEtxQg2UMFKu-0XQnqMU",
                    "token": "",
                    "token_secret": "",
                    "auth_token_expiry": 1773313277,
                    "user": {
                      "user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "email": "user@example.com",
                      "name": "Test User",
                      "image": null
                    }
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "401": {
            "description": "Incorrect password",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "Incorrect password.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US021",
                    "type": "Authentication Failed",
                    "details": "The password entered is incorrect."
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "User not found.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US002",
                    "type": "User Not Found",
                    "details": "No user exists with the provided email or mobile."
                  }
                }
              }
            }
          },
          "409": {
            "description": "User account blocked",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "Your account is temporarily locked due to multiple failed login attempts.",
                  "data": {
                    "user_status": "U003"
                  },
                  "meta": {},
                  "error": {
                    "code": "US003",
                    "type": "Account Locked",
                    "details": "Please try again after some time."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/forgot_password": {
      "post": {
        "summary": "Forgot Password",
        "description": "Initiates forgot password flow for Email or Mobile.",
        "tags": [
          "Login"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Reset instructions sent (OTP or Email)",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "OTP sent you successfully",
                  "data": {},
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "MissingEmailOrMobile": {
                    "summary": "Email or Mobile required",
                    "value": {
                      "status": false,
                      "message": "Either email or mobile number is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US004",
                        "type": "Validation Error",
                        "details": "Provide either a valid email or mobile + calling_code."
                      }
                    }
                  },
                  "MissingCallingCode": {
                    "summary": "Calling code required when mobile provided",
                    "value": {
                      "status": false,
                      "message": "Calling code is required when mobile number is provided.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US018",
                        "type": "Validation Error",
                        "details": "calling_code must be provided with a mobile number."
                      }
                    }
                  },
                  "InvalidEmailFormat": {
                    "summary": "Invalid email format",
                    "value": {
                      "status": false,
                      "message": "Invalid email format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US019",
                        "type": "Validation Error",
                        "details": "Email must be in a valid format."
                      }
                    }
                  },
                  "InvalidMobileFormat": {
                    "summary": "Invalid mobile format",
                    "value": {
                      "status": false,
                      "message": "Invalid mobile number.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US020",
                        "type": "Validation Error",
                        "details": "Mobile must contain only digits."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "User not found.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US002",
                    "type": "Not Found",
                    "details": "No user found with the provided email or mobile number."
                  }
                }
              }
            }
          },
          "409": {
            "description": "User account blocked",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "Your account is temporarily locked due to multiple failed attempts.",
                  "data": {
                    "user_status": "U003"
                  },
                  "meta": {},
                  "error": {
                    "code": "US003",
                    "type": "Account Locked",
                    "details": "Try again after some time."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/user/change_password": {
      "put": {
        "summary": "Change Password",
        "description": "Changes the user's password.",
        "tags": [
          "Login"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "Password changed successfully",
                  "data": {},
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "MissingNewPassword": {
                    "summary": "New password missing",
                    "value": {
                      "status": false,
                      "message": "New password is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US035",
                        "type": "Validation Error",
                        "details": "Please provide new_password."
                      }
                    }
                  },
                  "InvalidPasswordFormat": {
                    "summary": "Invalid password format",
                    "value": {
                      "status": false,
                      "message": "Invalid password format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US037",
                        "type": "Validation Error",
                        "details": "Password must contain uppercase, lowercase, number, and special character."
                      }
                    }
                  },
                  "WeakPassword": {
                    "summary": "Weak password",
                    "value": {
                      "status": false,
                      "message": "Password is too weak.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US022",
                        "type": "Validation Error",
                        "details": "Choose a stronger password."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        },
        "security": [
          {
            "ApiToken": []
          }
        ]
      }
    },
    "/user/v1/user/profile": {
      "get": {
        "summary": "Get User Profile",
        "description": "Retrieves the authenticated user's profile.",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "User Profile Data",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "User Information Retrived",
                  "data": {
                    "uuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "email": "user@example.com",
                    "name": "Test User",
                    "firstname": "Test",
                    "lastname": "User",
