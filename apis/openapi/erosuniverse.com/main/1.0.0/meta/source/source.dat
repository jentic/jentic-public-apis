    },
    "parameters": {
      "ApiClientHeader": {
        "name": "x-api-client",
        "in": "header",
        "description": "Client ID identifying the application (e.g., 'android', 'ios', 'web').",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "AppVersionHeader": {
        "name": "x-app-version",
        "in": "header",
        "description": "Application version (e.g., '1.0.0')",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "DeviceIdHeader": {
        "name": "x-device-id",
        "in": "header",
        "description": "Unique identifier for the device.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PlatformHeader": {
        "name": "x-platform",
        "in": "header",
        "description": "Platform of the client.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "android",
            "ios",
            "web"
          ]
        }
      },
      "CountryHeader": {
        "name": "x-country",
        "in": "header",
