  },
  "components": {
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "InviteDeviceRequest": {
        "type": "object",
        "required": [
          "device_id",
          "coupon_id"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "example": "device_abc123"
          },
          "coupon_id": {
            "type": "string",
            "example": "invite50"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Pass@122"
          },
          "mobile": {
            "type": "string",
            "example": "6389547210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          }
        }
      },
      "VerifyOTPRequest": {
        "required": [
          "otp",
          "intent"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "mobile": {
            "type": "string",
            "example": "6389547210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          },
          "otp": {
            "type": "string",
            "example": 4711
          },
          "intent": {
            "type": "string",
            "enum": [
              "registration",
              "forgot_password",
              "joinwaitlist"
            ]
          }
        }
      },
      "ResendOTPRequest": {
        "type": "object",
        "description": "Common resend OTP request for all flows",
        "required": [
          "intent"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "mobile": {
            "type": "string",
            "example": "9876543210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          },
          "intent": {
            "type": "string",
            "enum": [
              "registration",
              "update_profile",
              "joinwaitlist"
            ],
            "example": "registration"
          }
        },
        "oneOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "mobile",
              "calling_code"
            ]
          }
        ]
      },
      "RegisterWithProfileRequest": {
        "description": "Either provide email or mobile+calling_code. At least one must be provided.",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "mobile": {
            "type": "string",
            "example": "6389547210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          },
          "password": {
            "type": "string",
            "example": "Test@123"
          },
          "name": {
            "type": "string",
            "example": "Test User"
          },
          "avatar_id": {
            "type": "integer",
            "example": 15
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "example": "21/06/2003"
          },
          "profile_image": {
            "type": "string",
            "format": "binary",
            "example": null,
            "description": "Profile picture Image file"
          }
        },
        "required": [
          "password"
        ],
        "anyOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "mobile",
              "calling_code"
            ]
          }
        ]
      },
      "VerifyOTPRegisterRequest": {
        "required": [
          "email",
          "intent",
          "otp",
          "password"
        ],
        "oneOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "mobile",
              "calling_code"
            ]
          }
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "mobile": {
            "type": "string",
            "example": "6389547210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          },
          "otp": {
            "type": "string",
            "example": 4711
          },
          "password": {
            "type": "string",
            "example": "Test@123"
          },
          "intent": {
            "type": "string",
            "enum": [
              "registration"
            ]
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "mobile": {
            "type": "string",
            "example": "6389547210"
          },
          "calling_code": {
            "type": "string",
            "example": "+91"
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "new_password"
        ],
        "type": "object",
        "properties": {
          "new_password": {
            "type": "string",
            "example": "Pass@123"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Provided parameter failed validation"
          },
          "data": {
            "type": "object"
          },
          "meta": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "example": 400
              },
              "type": {
                "type": "string",
                "example": "Invalid Identifier"
              },
              "details": {
                "type": "string",
                "example": "The provided identifier is not valid"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationErrorResponse": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "examples": {
              "MissingEmailOrMobile": {
                "summary": "Email or Mobile required",
                "value": {
                  "status": false,
                  "message": "Either email or mobile number is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US016",
                    "type": "Validation Error",
                    "details": "Provide either email or mobile + calling_code."
                  }
                }
              },
              "MissingPassword": {
                "summary": "Password required",
                "value": {
                  "status": false,
                  "message": "Password is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US017",
                    "type": "Validation Error",
                    "details": "Password cannot be empty."
                  }
                }
              },
              "InvalidEmailFormat": {
                "summary": "Invalid email",
                "value": {
                  "status": false,
                  "message": "Invalid email format.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US019",
                    "type": "Validation Error",
                    "details": "Email must be a valid format."
                  }
                }
              },
              "InvalidMobileFormat": {
                "summary": "Invalid mobile",
                "value": {
                  "status": false,
                  "message": "Invalid mobile number.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US020",
                    "type": "Validation Error",
                    "details": "Mobile number must contain only digits."
                  }
                }
              }
            }
          }
        }
      },
      "ValidationOTPErrorResponse": {
        "description": "Validation OTP Error",
        "content": {
          "application/json": {
            "examples": {
              "MissingEmailOrMobile": {
                "summary": "Email or Mobile is required",
                "value": {
                  "status": false,
                  "message": "Either email or mobile number is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US016",
                    "type": "Validation Error",
                    "details": "Provide either a valid email or mobile + calling_code."
                  }
                }
              },
              "MissingOTP": {
                "summary": "OTP required",
                "value": {
                  "status": false,
                  "message": "OTP is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US011",
                    "type": "Validation Error",
                    "details": "otp field cannot be empty."
                  }
                }
              },
              "MissingPassword": {
                "summary": "Password required",
                "value": {
                  "status": false,
                  "message": "Password is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US017",
                    "type": "Validation Error",
                    "details": "Password cannot be empty."
                  }
                }
              },
              "PasswordMismatch": {
                "summary": "Wrong Password",
                "value": {
                  "status": false,
                  "message": "Wrong Password.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US017",
                    "type": "Validation Error",
                    "details": "Wrong Password"
                  }
                }
              },
              "InvalidOTPFormat": {
                "summary": "OTP format invalid",
                "value": {
                  "status": false,
                  "message": "Invalid OTP format.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US015",
                    "type": "Validation Error",
                    "details": "OTP must be a 4-6 digit number."
                  }
                }
              },
              "InvalidEmailFormat": {
                "summary": "Invalid email",
                "value": {
                  "status": false,
                  "message": "Invalid email format.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US019",
                    "type": "Validation Error",
                    "details": "Email must be a valid format."
                  }
                }
              },
              "InvalidMobileFormat": {
                "summary": "Invalid mobile",
                "value": {
                  "status": false,
                  "message": "Invalid mobile number.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US020",
                    "type": "Validation Error",
                    "details": "Mobile number must contain only digits."
                  }
                }
              }
            }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "Unauthorized": {
                "value": {
                  "success": false,
                  "message": "Authentication failed",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US401",
                    "type": "Unauthorized",
                    "details": "Invalid or missing token. Please provide a valid JWT token."
                  }
                }
              }
            }
          }
        }
      },
      "US400": {
        "description": "Invalid Input",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Validation Error",
              "data": {},
              "meta": {},
              "error": {
                "code": "US400",
                "type": "Validation Error",
                "details": "Missing or invalid input parameters"
              }
            }
          }
        }
      },
      "US022": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Authentication failed",
              "data": {},
              "meta": {},
              "error": {
                "code": "US401",
                "type": "Unauthorized",
                "details": "Invalid token or credentials"
              }
            }
          }
        }
      },
      "ResendOTPSuccess": {
        "description": "OTP resent or already verified",
        "content": {
          "application/json": {
            "examples": {
              "OtpResent": {
                "value": {
                  "status": "otp_resent",
                  "message": "A new OTP has been sent successfully.",
                  "data": {
                    "is_verified": false
                  },
                  "meta": {},
                  "error": {}
                }
              },
              "AlreadyVerified": {
                "value": {
                  "status": "already_verified",
                  "message": "This contact is already verified.",
                  "data": {
                    "is_verified": true
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          }
        }
      },
      "ResendOTPBadRequest": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "examples": {
              "MissingEmailOrMobile": {
                "value": {
                  "status": false,
                  "message": "Either email or mobile number is required.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US004",
                    "type": "Validation Error",
                    "details": "Provide either a valid email or mobile + calling_code."
                  }
                }
              },
              "MissingCallingCode": {
                "value": {
                  "status": false,
                  "message": "Calling code is required when mobile number is provided.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US018",
                    "type": "Validation Error",
                    "details": "Provide calling_code along with mobile number."
                  }
                }
              },
              "InvalidEmailFormat": {
                "value": {
                  "status": false,
                  "message": "Invalid email format.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US019",
                    "type": "Validation Error",
                    "details": "Email must be a valid format."
                  }
                }
              },
              "InvalidMobileFormat": {
                "value": {
                  "status": false,
                  "message": "Invalid mobile number format.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US020",
                    "type": "Validation Error",
                    "details": "Mobile number should contain only digits."
                  }
                }
              },
              "InvalidIntent": {
                "value": {
                  "status": false,
                  "message": "Invalid intent.",
                  "data": {},
