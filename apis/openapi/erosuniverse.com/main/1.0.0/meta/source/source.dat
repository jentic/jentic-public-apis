    "/user/v1/social/friend-invite": {
      "post": {
        "summary": "Invite Friends",
        "description": "Send invitations via email or mobile.",
        "tags": [
          "Waitlist and Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "invited_list"
                ],
                "properties": {
                  "invited_list": {
                    "type": "array",
                    "description": "List of invitees. Can contain: - objects with email - objects with mobile + calling_code - plain email strings\n",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "example": "simple@email.com"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "email": {
                              "type": "string",
                              "format": "email",
                              "example": "friend@example.com"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "mobile": {
                              "type": "string",
                              "example": "1234567890"
                            },
                            "calling_code": {
                              "type": "string",
                              "example": "+1"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waitlist not found",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "No waitlist entry found for this device_id.",
                  "data": {
                    "status": "No Waitlist Found",
                    "status_code": "E052"
                  },
                  "meta": {},
                  "error": {
                    "code": "US031",
                    "type": "Validation Error",
                    "details": "No waitlist entry exists for the given device_id."
                  }
                }
              }
            }
          },
          "201": {
            "description": "Invites sent (full or partial success)",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "2 invites sent successfully",
                  "data": {
                    "invited": [
                      {
                        "id": 1,
                        "uuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                        "email_id": "user@example.com",
                        "phone_number": "98653274140",
                        "calling_code": "+91",
                        "invited_email_id": "invite1@example.com",
                        "invited_phone_number": "7890564321",
                        "invited_calling_code": "+91",
                        "created_at": "2025-12-12T15:56:07.005Z",
                        "updated_at": "2025-12-12T15:56:07.005Z"
                      }
                    ],
                    "duplicates": [
                      {
                        "email": "duplicate@example.com"
                      }
                    ],
                    "invalid": [
                      {
                        "email": "invalid-email"
                      }
                    ],
                    "failed": [
                      {
                        "mobile": "123",
                        "calling_code": "+1"
                      }
                    ]
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "examples": {
                  "InvalidListFormat": {
                    "summary": "Invalid invited_list format",
                    "value": {
                      "status": false,
                      "message": "Invalid invited_list format.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US034",
                        "type": "Validation Error",
                        "details": "invited_list must be an array of emails or mobile objects."
                      }
                    }
                  },
                  "EmptyList": {
                    "summary": "No invitees provided",
                    "value": {
                      "status": false,
                      "message": "invited_list cannot be empty.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US039",
                        "type": "Validation Error",
                        "details": "Provide at least one invitation entry."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        },
        "security": [
          {
            "ApiToken": []
          }
        ]
      }
    },
    "/user/v1/social/waitlist": {
      "post": {
        "summary": "Join Waitlist",
        "description": "Add a user to the waitlist via email or mobile.",
        "tags": [
          "Waitlist and Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_id"
                ],
                "properties": {
                  "device_id": {
                    "type": "string",
                    "example": "device_abc123"
                  },
                  "email_id": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "mobile": {
                    "type": "string",
                    "example": "9876543210"
                  },
                  "calling_code": {
                    "type": "string",
                    "example": "+91"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already exists",
            "content": {
              "application/json": {
                "examples": {
                  "AlreadyOnWaitlist": {
                    "summary": "User already on the waitlist",
                    "value": {
                      "success": false,
                      "message": "Already on the Waitlist.",
                      "data": {
                        "queue_number": 123,
                        "is_verified": true
                      },
                      "meta": {},
                      "error": {
                        "code": "US030",
                        "type": "Waitlist Exists",
                        "details": "User already exists on waitlist."
                      }
                    }
                  },
                  "OtpResent": {
                    "summary": "Device exists but not verified, OTP resent",
                    "value": {
                      "success": false,
                      "message": "Device already exists but not verified. OTP has been resent.",
                      "data": {
                        "status": "otp_resent",
                        "queue_number": 126,
                        "is_verified": false
                      },
                      "meta": {},
                      "error": {
                        "code": null,
                        "type": null,
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "New waitlist entry created",
            "content": {
              "application/json": {
                "example": {
                  "WaitlistCreated": {
                    "summary": "Waitlist entry created successfully",
                    "value": {
                      "success": true,
                      "message": "OTP sent to your email. Please verify to confirm your spot.",
                      "data": {
                        "queue_number": 123,
                        "is_verified": false
                      },
                      "meta": {},
                      "error": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "example": {
                  "ValidationError": {
                    "summary": "Missing or invalid input",
                    "value": {
                      "success": false,
                      "message": "Invalid request data.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US016",
                        "type": "Validation Error",
                        "details": "Provide a valid email or mobile number."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        },
        "security": [
          {
            "ApiToken": []
          }
        ]
      }
    },
    "/user/v1/social/waitlist_verify-otp": {
      "post": {
        "summary": "Verify OTP for waitlist",
        "description": "Verifies OTP sent to the user and confirms the waitlist entry.",
        "tags": [
          "Waitlist and Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/VerifyOTPRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "intent": {
                        "type": "string",
                        "enum": [
                          "joinwaitlist"
                        ],
                        "example": "joinwaitlist"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful responses",
            "content": {
              "application/json": {
                "examples": {
                  "Verified": {
                    "summary": "OTP verified successfully",
                    "value": {
                      "success": true,
                      "message": "You're #126 in the queue.",
                      "data": {
                        "status": "verified",
                        "queue_number": 126
                      },
                      "meta": {},
                      "error": {
                        "code": null,
                        "type": null,
                        "details": null
                      }
                    }
                  },
                  "NotFound": {
                    "summary": "No waitlist entry found",
                    "value": {
                      "success": false,
                      "message": "No waitlist entry found for this email",
                      "data": null,
                      "meta": {},
                      "error": {
                        "code": "US031",
                        "type": "Not Found",
                        "details": "No waitlist entry exists for the given email"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid OTP",
            "content": {
              "application/json": {
                "examples": {
                  "MissingEmailOrMobile": {
                    "summary": "Email or Mobile is required",
                    "value": {
                      "status": false,
                      "message": "Either email or mobile number is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US016",
                        "type": "Validation Error",
                        "details": "Provide either a valid email or mobile + calling_code."
                      }
                    }
                  },
                  "MissingOTP": {
                    "summary": "OTP required",
                    "value": {
                      "status": false,
                      "message": "OTP is required.",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": "US011",
                        "type": "Validation Error",
                        "details": "otp field cannot be empty."
                      }
                    }
                  },
                  "OTPInvalid": {
                    "summary": "OTP is invalid",
                    "value": {
                      "status": false,
                      "message": "OTP is invalid.",
                      "data": null,
                      "meta": {},
                      "error": {
                        "code": "US012",
                        "type": "Invalid OTP",
                        "details": "The provided OTP is invalid."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Otp Expired",
            "content": {
              "application/json": {
                "example": {
                  "status": false,
                  "message": "OTP has expired.",
                  "data": {},
                  "meta": {},
                  "error": {
                    "code": "US013",
                    "type": "Validation Error",
                    "details": "Request a new OTP."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/v1/social/waitlist_resend_otp": {
      "post": {
        "summary": "Resend OTP for waitlist (If Expired)",
        "description": "Resends OTP for Join Waitlist",
        "tags": [
          "Waitlist and Invite"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ResendOTPRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "intent": {
                        "type": "string",
                        "enum": [
                          "joinwaitlist"
                        ],
                        "example": "joinwaitlist"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ResendOTPSuccess"
          },
          "400": {
            "$ref": "#/components/responses/ResendOTPBadRequest"
          },
          "404": {
            "$ref": "#/components/responses/ResendOTPNotFound"
          }
        }
      }
    },
    "/user/v1/social/google_login": {
      "post": {
        "summary": "Google Login / Sign Up",
        "description": "Logs in a user via Google OAuth. Creates a new account if it does not exist.",
        "tags": [
          "Social Login"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiClientHeader"
          },
          {
            "$ref": "#/components/parameters/DeviceIdHeader"
          },
          {
            "$ref": "#/components/parameters/PlatformHeader"
          },
          {
            "$ref": "#/components/parameters/CountryHeader"
          },
          {
            "$ref": "#/components/parameters/AppVersionHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "token"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "description": "Google user ID",
                    "example": "12345678901234567890"
                  },
                  "token": {
                    "type": "string",
                    "description": "Google OAuth ID token",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "User logged in successfully",
                  "data": {
                    "auth_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...",
                    "user": {
                      "user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "email": "user@example.com",
                      "name": "Test User",
                      "image": null
                    }
                  },
                  "meta": {},
                  "error": {}
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/US400"
          },
          "401": {
            "$ref": "#/components/responses/US022"
          }
        }
      }
    },
