openapi: 3.1.0
info:
  title: MuPag Public API
  version: 1.0.0
  description: Contrato publico servido pelo API Gateway para integracoes MuPag.
servers:
  - url: https://api.sandbox.mupag.com.br
    description: QA (`test`)
  - url: https://api.mupag.com.br
    description: Produção (`prd`; contrato reservado até a ativação)
security:
  - merchantApiKey: []
paths:
  /v1/_test/charges/{id}/simulate-paid:
    post:
      tags: [Sandbox]
      operationId: simulateSandboxChargePaid
      summary: Confirma uma cobrança sandbox pelo fluxo canônico
      description: |
        Operação auxiliar autenticada, isolada por lojista e exclusiva de sandbox. A mesma
        `Idempotency-Key` retorna o resultado original; reutilizar a chave em outra operação falha com conflito.
      security:
        - merchantApiKey: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
        - name: Idempotency-Key
          in: header
          required: true
          example: sandbox-charge-paid-550e8400
          schema:
            type: string
            minLength: 16
            maxLength: 128
            pattern: "^[\\x21-\\x7E]+$"
      responses:
        "200":
          description: Transição canônica concluída ou resposta original retornada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SandboxTestResult"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/_test/charges/{id}/simulate-failed:
    post:
      tags: [Sandbox]
      operationId: simulateSandboxChargeFailed
      summary: Marca uma cobrança sandbox como falha pelo fluxo canônico
      description: |
        Operação auxiliar autenticada, isolada por lojista e exclusiva de sandbox. Produz os mesmos
        efeitos duráveis da transição canônica de falha e preserva a resposta original em novas tentativas.
      security:
        - merchantApiKey: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
        - name: Idempotency-Key
          in: header
          required: true
          example: sandbox-charge-failed-550e8400
          schema:
            type: string
            minLength: 16
            maxLength: 128
            pattern: "^[\\x21-\\x7E]+$"
      responses:
        "200":
          description: Transição canônica concluída ou resposta original retornada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SandboxTestResult"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/_test/subscriptions/{id}/advance-billing:
    post:
      tags: [Sandbox]
      operationId: advanceSandboxSubscriptionBilling
      summary: Antecipa a elegibilidade do próximo ciclo de uma assinatura sandbox
      description: |
        Executado de forma síncrona pelo serviço responsável pela assinatura. Nunca retrocede um período
        já processado, e novas tentativas com a mesma `Idempotency-Key` retornam o resultado persistido.
      security:
        - merchantApiKey: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
        - name: Idempotency-Key
          in: header
          required: true
          example: sandbox-billing-advance-550e8400
          schema:
            type: string
            minLength: 16
            maxLength: 128
            pattern: "^[\\x21-\\x7E]+$"
      responses:
        "200":
          description: Avanço aplicado ou resposta original retornada sem alterar um ciclo já processado.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SandboxTestResult"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/_test/data/seed:
    post:
      tags: [Sandbox]
      operationId: seedSandboxData
      summary: Cria dados mínimos de teste do lojista no sandbox
      description: |
        Cria clientes e produtos de forma determinística no escopo autenticado. Novas tentativas retornam
        os mesmos identificadores persistidos; a rota exige simultaneamente os escopos de clientes e produtos.
      security:
        - merchantApiKey: []
      parameters:
        - name: Idempotency-Key
          in: header
          required: true
          example: sandbox-seed-data-550e8400
          schema:
            type: string
            minLength: 16
            maxLength: 128
            pattern: "^[\\x21-\\x7E]+$"
      responses:
        "200":
          description: Dados de teste criados ou resposta original retornada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SandboxSeedResult"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"

  /v1/_test/psp-subaccounts/{provider}/decision:
    post:
      tags: [Sandbox]
      operationId: simulateSandboxPspSubaccountDecision
      summary: Simula uma decisão do PSP sobre a subconta do lojista
      description: |
        Helper autenticado e tenant-scoped disponível somente em QA (`test`). A rota não existe
        no ambiente `prd`. Reutilize a mesma `Idempotency-Key` em retries; `event_id` também é
        deduplicado, `event_sequence` ordena eventos e decisões finais não podem ser revertidas.
      security:
        - merchantApiKey: []
      parameters:
        - name: provider
          in: path
          required: true
          schema:
            type: string
            enum: [asaas, woovi]
        - name: Idempotency-Key
          in: header
          required: true
          example: sandbox-decision-550e8400
          schema:
            type: string
            minLength: 16
            maxLength: 128
            pattern: "^[\\x21-\\x7E]+$"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SandboxSubaccountDecisionRequest"
      responses:
        "200":
          description: Estado corrente do PSP sandbox após aplicar ou ignorar replay/reorder.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SandboxSubaccountDecisionResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          description: Credencial sem escopo ou pertencente ao ambiente `prd`.
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/Problem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"

  /v1/public/influencer-pre-registrations:
    post:
      operationId: createInfluencerPreRegistration
      summary: Registra interesse antecipado de influenciador
      description: Submissoes novas e duplicadas retornam a mesma resposta para nao revelar cadastro previo.
      security: []
      parameters:
        - name: Idempotency-Key
          in: header
          required: true
          schema:
            type: string
            format: uuid
            maxLength: 80
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/InfluencerPreRegistrationRequest"
      responses:
        "202":
          description: Solicitacao aceita sem revelar se ja existia.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/InfluencerPreRegistrationAccepted"
        "400":
          $ref: "#/components/responses/ValidationProblem"
        "403":
          description: Requisicao nao originada do proxy autenticado da landing oficial.
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/Problem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
        "503":
          $ref: "#/components/responses/UpstreamProblem"
  /v1/charges:
    get:
      operationId: listCharges
      summary: Lista cobrancas do merchant autenticado
      description: Paginacao keyset ordenada por created_at e charge_id decrescentes.
      parameters:
        - name: status
          in: query
          schema:
            $ref: "#/components/schemas/ChargeStatus"
        - name: customer_id
          in: query
          schema:
            type: string
            format: uuid
        - name: payment_method
          in: query
          schema:
            $ref: "#/components/schemas/PaymentMethod"
        - name: created_at_from
          in: query
          description: Limite inferior inclusivo.
          schema:
            type: string
            format: date-time
        - name: created_at_to
          in: query
          description: Limite superior exclusivo.
          schema:
            type: string
            format: date-time
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 25
        - name: cursor
          in: query
          description: Cursor opaco retornado em next_cursor.
          schema:
            type: string
            maxLength: 256
      responses:
        "200":
          description: Pagina de cobrancas sem PII.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChargeListPage"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
    post:
      operationId: createCharge
      summary: Cria uma cobranca PIX ou cartao B2B direto
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateChargeRequest"
      responses:
        "201":
          description: Cobranca criada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChargeResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
        "502":
          $ref: "#/components/responses/UpstreamProblem"
  /v1/charges/{chargeId}/cancel:
    post:
      tags: [Charges]
      operationId: cancelCharge
      summary: Cancela uma cobrança pendente
      description: |
        Cancela somente cobranças no estado `pending`. Um `202` indica que o resultado ainda
        não é autoritativo. Não há reconciliação em background: faça replay da mesma
        `Idempotency-Key` e do mesmo payload para continuar a reconciliação segura. Antes do
        envio mutável ao PSP, ausência no provedor mantém a intenção pendente; depois do fence
        durável de envio, ausência em consulta confirma o cancelamento sem repetir o DELETE.
      security:
        - merchantApiKey: []
      parameters:
        - $ref: "#/components/parameters/ChargeId"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: false
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ChargeCancellationRequest"
      responses:
        "200":
          description: Cancelamento confirmado de forma autoritativa.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChargeCancellationResponse"
        "202":
          description: Resultado pendente; faça replay da mesma Idempotency-Key e do mesmo payload.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChargeCancellationResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
        "502":
          $ref: "#/components/responses/UpstreamProblem"
  /v1/charges/{chargeId}/refunds:
    parameters:
      - $ref: "#/components/parameters/ChargeId"
    get:
      operationId: listChargeRefunds
      summary: Lista estornos de uma cobranca
      description: Paginacao keyset ordenada por requested_at e refund_id decrescentes.
      parameters:
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 100
        - name: cursor
          in: query
          description: Cursor opaco retornado em next_cursor.
          schema:
            type: string
            maxLength: 256
      responses:
        "200":
          description: Pagina bounded de estornos.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RefundListPage"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
    post:
      operationId: requestRefund
      summary: Solicita estorno total ou parcial
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/RefundRequest"
      responses:
        "202":
          description: Estorno aceito para processamento idempotente.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RefundResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
        "502":
          $ref: "#/components/responses/UpstreamProblem"
  /v1/refunds/{refundId}:
    get:
      operationId: getRefund
      summary: Consulta um estorno no escopo autenticado
      parameters:
        - $ref: "#/components/parameters/RefundId"
      responses:
        "200":
          description: Estorno encontrado.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RefundResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/checkout-sessions:
    post:
      operationId: createCheckoutSession
      summary: Cria uma sessao de checkout hospedado
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateCheckoutSessionRequest"
      responses:
        "201":
          description: Sessao criada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CreateCheckoutSessionResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/subscriptions:
    post:
      operationId: createSubscription
      summary: Cria uma assinatura
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateSubscriptionRequest"
      responses:
        "201":
          description: Assinatura criada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SubscriptionDetail"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/subscriptions/{id}/cancel:
    post:
      operationId: cancelSubscription
      summary: Cancela uma assinatura imediatamente ou no fim do periodo
      parameters:
        - $ref: "#/components/parameters/SubscriptionId"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CancelSubscriptionRequest"
      responses:
        "200":
          description: Assinatura cancelada ou agendada para cancelamento.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SubscriptionDetail"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/customers:
    get:
      operationId: listCustomers
      summary: Lista clientes do merchant autenticado
      parameters:
        - name: email
          in: query
          schema:
            type: string
            format: email
        - name: tax_id
          in: query
          schema:
            type: string
        - name: created_at_from
          in: query
          schema:
            type: string
            format: date-time
        - name: created_at_to
          in: query
          schema:
            type: string
            format: date-time
      responses:
        "200":
          description: Clientes encontrados.
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/CustomerSummary"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
    post:
      operationId: createCustomer
      summary: Cria um cliente
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CustomerRequest"
      responses:
        "201":
          description: Cliente criado.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CustomerResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/customers/{id}:
    patch:
      operationId: updateCustomer
      summary: Atualiza os campos publicos de um cliente
      parameters:
        - $ref: "#/components/parameters/CustomerId"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CustomerRequest"
      responses:
        "200":
          description: Cliente atualizado.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CustomerResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "429":
          $ref: "#/components/responses/RateLimitProblem"
  /v1/merchants/{merchantId}/production-activation:
    get:
      tags: [Production activation]
      operationId: getProductionActivation
      summary: Consulta a jornada coordenada de ativacao da producao
      security:
        - accountBearer: []
      parameters:
        - $ref: "#/components/parameters/MerchantDashboardId"
      responses:
        "200":
          description: Snapshot canonico; respostas com perfil usam Cache-Control no-store.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProductionActivation"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
  /v1/merchants/{merchantId}/production-activation/profile:
    patch:
      tags: [Production activation]
      operationId: saveProductionActivationProfile
      summary: Salva ou confirma o perfil juridico e seus representantes
      security:
        - accountBearer: []
      parameters:
        - $ref: "#/components/parameters/MerchantDashboardId"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProductionActivationProfileRequest"
      responses:
        "200":
          description: Perfil salvo de forma idempotente.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProductionActivation"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/merchants/{merchantId}/production-activation/refresh:
    post:
      tags: [Production activation]
      operationId: refreshProductionActivation
      summary: Solicita reconciliacao segura sem inventar estado do provedor
      security:
        - accountBearer: []
      parameters:
        - $ref: "#/components/parameters/MerchantDashboardId"
        - $ref: "#/components/parameters/IdempotencyKey"
      responses:
        "200":
          description: Snapshot atual apos registrar a solicitacao.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProductionActivation"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
  /v1/merchants/{merchantId}/production-activation/action:
    get:
      tags: [Production activation]
      operationId: getProductionActivationAction
      summary: Retorna a proxima acao canonica da jornada
      security:
        - accountBearer: []
      parameters:
        - $ref: "#/components/parameters/MerchantDashboardId"
      responses:
        "200":
          description: Acao derivada exclusivamente do estado persistido.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProductionActivationAction"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
  /v1/merchants/{merchantId}/production-activation/woovi/start:
    post:
      tags: [Production activation]
      operationId: startWooviProductionActivation
      summary: Inicia de forma idempotente o KYC hospedado da Woovi
      description: |
        Cria ou reutiliza o registro BaaS da Woovi e devolve uma URL HTTPS validada para ser
        aberta em nova aba. A conclusao e acompanhada por webhook e reconciliacao; a aplicacao
        nunca infere aprovacao pelo retorno do navegador.
      security:
        - accountBearer: []
      parameters:
        - $ref: "#/components/parameters/MerchantDashboardId"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/WooviProductionActivationStartRequest"
      responses:
        "200":
          description: Registro criado ou resposta idempotente reutilizada.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/WooviProductionActivationStartResponse"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "403":
          $ref: "#/components/responses/ForbiddenProblem"
        "409":
          $ref: "#/components/responses/ConflictProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "503":
          description: Integracao BaaS indisponivel ou desabilitada.
  /v1/public/provider-webhooks/woovi:
    post:
      tags: [Provider callbacks]
      operationId: receiveWooviProviderWebhook
      summary: Recebe eventos assinados de onboarding BaaS da Woovi
      security: []
      parameters:
        - name: x-webhook-signature
          in: header
          required: true
          schema:
            type: string
            minLength: 1
            maxLength: 4096
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
      responses:
        "200":
          $ref: "#/components/responses/ProviderWebhookAccepted"
        "401":
          description: Assinatura ausente ou invalida.
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/public/provider-webhooks/asaas:
    post:
      tags: [Provider callbacks]
      operationId: receiveAsaasProviderWebhook
      summary: Recebe eventos autenticados de onboarding BaaS do Asaas
      security: []
      parameters:
        - name: asaas-access-token
          in: header
          required: true
          schema:
            type: string
            minLength: 32
            maxLength: 255
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
      responses:
        "200":
          $ref: "#/components/responses/ProviderWebhookAccepted"
        "401":
          description: Token ausente ou invalido.
        "422":
          $ref: "#/components/responses/ValidationProblem"
  /v1/address/cep/{cep}:
    get:
      tags: [Production activation]
      operationId: resolveBrazilianPostalCode
      summary: Consulta CEP pelo backend com cache e permite correcao posterior
      security:
        - accountBearer: []
      parameters:
        - name: cep
          in: path
          required: true
          schema:
            type: string
            pattern: "^[0-9-]{8,9}$"
      responses:
        "200":
          description: Endereco normalizado.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PostalCodeAddress"
        "401":
          $ref: "#/components/responses/AuthProblem"
        "404":
          $ref: "#/components/responses/NotFoundProblem"
        "422":
          $ref: "#/components/responses/ValidationProblem"
        "503":
          $ref: "#/components/responses/UpstreamProblem"
components:
  securitySchemes:
    merchantApiKey:
      type: http
      scheme: bearer
      bearerFormat: sk_test_* ou sk_prd_*
    accountBearer:
      type: http
      scheme: bearer
      bearerFormat: JWT de sessao do dashboard
  parameters:
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      description: Chave ASCII visivel e estavel por operacao logica; reutilize em retries.
      schema:
        type: string
        minLength: 1
        maxLength: 128
        pattern: "^[\\x21-\\x7E]+$"
    ChargeId:
      name: chargeId
      in: path
      required: true
      schema:
        type: string
        format: uuid
    RefundId:
      name: refundId
      in: path
      required: true
      schema:
        type: string
        format: uuid
    SubscriptionId:
      name: id
      in: path
      required: true
      schema:
        type: string
        format: uuid
    CustomerId:
      name: id
      in: path
      required: true
      schema:
        type: string
        format: uuid
    MerchantDashboardId:
      name: merchantId
      in: path
      required: true
      schema:
        type: string
        format: uuid
  responses:
    AuthProblem:
      description: Credencial ausente, invalida ou expirada.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    ForbiddenProblem:
      description: Credencial sem escopo ou acesso ao recurso.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    NotFoundProblem:
      description: Recurso nao encontrado no tenant autenticado.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    ConflictProblem:
      description: Conflito de estado ou reutilizacao incompatível da chave de idempotencia.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    ValidationProblem:
      description: Entrada invalida.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    RateLimitProblem:
      description: Limite de requisicoes excedido.
      headers:
        Retry-After:
          schema:
            type: integer
            minimum: 0
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    UpstreamProblem:
      description: Integracao externa temporariamente indisponivel.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    ProviderWebhookAccepted:
      description: Evento autenticado aceito ou replay reconhecido.
      content:
        application/json:
          schema:
            type: object
            additionalProperties: false
            required: [status]
            properties:
              status:
                type: string
                enum: [processed, duplicate, unmatched, ignored]
  schemas:
    ProductionActivationAddress:
      type: object
      additionalProperties: false
      required: [postal_code, street, number, city, state]
      properties:
        postal_code:
          type: string
          pattern: "^[0-9]{8}$"
        street:
          type: string
          maxLength: 200
        number:
          type: string
          maxLength: 30
        complement:
          type: [string, "null"]
          maxLength: 120
        neighborhood:
          type: [string, "null"]
          maxLength: 120
        city:
          type: string
          maxLength: 120
        state:
          type: string
          pattern: "^[A-Z]{2}$"
    ProductionActivationRepresentativeRequest:
      type: object
      additionalProperties: false
      required: [role, primary, full_name, tax_id, birth_date, email, phone, address]
      properties:
        id:
          type: string
          format: uuid
        role:
          type: string
          enum: [legal_representative, partner, director, attorney, other]
        primary:
          type: boolean
        full_name:
          type: string
          maxLength: 200
        tax_id:
          type: string
          description: CPF; cifrado por envelope no customer-service.
        birth_date:
          type: string
          format: date
        email:
          type: string
          format: email
        phone:
          type: string
        address:
          $ref: "#/components/schemas/ProductionActivationAddress"
    ProductionActivationProfileRequest:
      type: object
      additionalProperties: false
      required:
        - expected_version
        - representatives
        - confirm
      properties:
        expected_version:
          type: integer
          format: int64
          minimum: 1
        company_type:
          type: [string, "null"]
          enum: [mei, ei, ltda, slu, sa, association, foundation, other, null]
        legal_name:
          type: [string, "null"]
          maxLength: 200
        trade_name:
          type: [string, "null"]
          maxLength: 160
        tax_id:
          type: [string, "null"]
          description: CNPJ; cifrado por envelope no customer-service.
        business_description:
          type: [string, "null"]
          maxLength: 2000
        products_description:
          type: [string, "null"]
          maxLength: 2000
        website:
          type: [string, "null"]
          format: uri
        incorporated_at:
          type: [string, "null"]
          format: date
        account_purpose:
          type: [string, "null"]
          maxLength: 500
        estimated_monthly_revenue_cents:
          type: [integer, "null"]
          format: int64
          minimum: 0
        address:
          oneOf:
            - $ref: "#/components/schemas/ProductionActivationAddress"
            - type: "null"
        terms_version:
          type: [string, "null"]
          maxLength: 80
        terms_accepted:
          type: boolean
        representatives:
          type: array
          maxItems: 10
          items:
            $ref: "#/components/schemas/ProductionActivationRepresentativeRequest"
        confirm:
          type: boolean
          description: Confirmar e deixar o perfil pronto para iniciar a Woovi.
    ProductionActivation:
      type: object
      additionalProperties: false
      required: [activation_id, merchant_id, state, version, providers, capabilities]
      properties:
        activation_id:
          type: string
          format: uuid
        merchant_id:
          type: string
          format: uuid
        state:
          type: string
          enum: [not_started, collecting_data, woovi_action_required, under_review, partially_approved, approved, rejected]
        version:
          type: integer
          format: int64
        started_at:
          type: [string, "null"]
          format: date-time
        woovi_submitted_at:
          type: [string, "null"]
          format: date-time
        decision_deadline_at:
          type: [string, "null"]
          format: date-time
        business_calendar_version:
          type: [string, "null"]
        profile:
          type: [object, "null"]
          description: Perfil completo, retornado somente a owner/admin em resposta no-store.
          additionalProperties: true
        providers:
          type: array
          items:
            type: object
            additionalProperties: true
        capabilities:
          type: array
          items:
            type: object
            additionalProperties: true
    WooviProductionActivationStartRequest:
      type: object
      additionalProperties: false
      required: [expected_version]
      properties:
        expected_version:
          type: integer
          format: int64
          minimum: 1
    WooviProductionActivationStartResponse:
      type: object
      additionalProperties: false
      required: [activation, action_url]
      properties:
        activation:
          $ref: "#/components/schemas/ProductionActivation"
        action_url:
          type: string
          format: uri
    ProductionActivationAction:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
          enum: [complete_profile, start_woovi, continue_woovi, awaiting_analysis]
        message:
          type: string
        url:
          type: [string, "null"]
          format: uri
    PostalCodeAddress:
      type: object
      additionalProperties: false
      required: [cep, street, city, state, source]
      properties:
        cep:
          type: string
          pattern: "^[0-9]{8}$"
        street:
          type: string
        neighborhood:
          type: [string, "null"]
        city:
          type: string
        state:
          type: string
          pattern: "^[A-Z]{2}$"
        source:
          type: string
          enum: [brasilapi]
    SandboxTestResult:
      type: object
      additionalProperties: false
      required: [id, status, updated_at]
      properties:
        id:
          type: string
          format: uuid
        status:
          type: string
          minLength: 1
          maxLength: 64
        updated_at:
          type: string
          format: date-time
    SandboxSeedResult:
      type: object
      additionalProperties: false
      required: [environment, customers, products]
      properties:
        environment:
          type: string
          enum: [test]
        customers:
          type: array
          maxItems: 100
          items:
            type: string
            format: uuid
        products:
          type: array
          maxItems: 100
          items:
            type: string
            format: uuid

    SandboxSubaccountDecisionRequest:
      type: object
      additionalProperties: false
      required: [event_id, event_sequence, status]
      properties:
        event_id:
          type: string
          format: uuid
        event_sequence:
          type: integer
          format: int64
          minimum: 1
        status:
          type: string
          enum: [pending, approved, rejected]
        rejection_reason:
          type: string
          maxLength: 500
      allOf:
        - if:
            properties:
              status:
                const: rejected
          then:
            required: [rejection_reason]
    SandboxSubaccountDecisionResponse:
      type: object
      additionalProperties: false
      required: [provider, provider_reference, status, event_sequence]
      properties:
        provider:
          type: string
          enum: [asaas, woovi]
        provider_reference:
          type: string
        status:
          type: string
          enum: [pending, approved, rejected]
        event_sequence:
          type: integer
          format: int64
          minimum: 0
        rejection_reason:
          type: [string, "null"]
          maxLength: 500

    Problem:
      type: object
      required: [title, status, detail]
      properties:
        type:
          type: string
          format: uri-reference
        title:
          type: string
        status:
          type: integer
        detail:
          type: string
        code:
          type: string
        suggestion:
          type: string
        documentation_url:
          type: string
          format: uri
        request_id:
          type: string
        instance:
          type: string
          format: uri-reference
    PublicProblem:
      type: object
      additionalProperties: false
      required: [type, title, status, detail, instance]
      properties:
        type:
          type: string
          format: uri-reference
        title:
          type: string
        status:
          type: integer
        detail:
          type: string
        instance:
          type: string
          format: uri-reference
    InfluencerPreRegistrationRequest:
      type: object
      additionalProperties: false
      required: [name, email, phone, socialNetwork, socialHandle, privacyAcknowledged, privacyNoticeVersion, marketingConsent]
      properties:
        name:
          type: string
          minLength: 2
          maxLength: 120
        email:
          type: string
          format: email
          maxLength: 254
        phone:
          type: string
          maxLength: 32
        socialNetwork:
          type: string
          enum: [instagram, tiktok, youtube, kwai, x]
        socialHandle:
          type: string
          maxLength: 81
        privacyAcknowledged:
          const: true
        privacyNoticeVersion:
          type: string
          const: influencer-pre-registration-v1
        marketingConsent:
          type: boolean
        company:
          type: string
          maxLength: 200
    InfluencerPreRegistrationAccepted:
      type: object
      additionalProperties: false
      required: [accepted]
      properties:
        accepted:
          const: true
    PaymentMethod:
      type: string
      enum: [pix, credit_card]
    ChargeStatus:
      type: string
      enum: [created, pending, authorized, paid, partially_refunded, refunded, failed, expired, cancelled, disputed, chargeback]
    CreateChargeRequest:
      type: object
      additionalProperties: false
      required: [amount_cents, payment_method, customer]
      properties:
        amount_cents:
          type: integer
          format: int64
          minimum: 100
          maximum: 9000000000000000
        payment_method:
          $ref: "#/components/schemas/PaymentMethod"
        installments:
          type: integer
          minimum: 1
          maximum: 1
        card_token:
          type: string
          description: Token Asaas obtido pelo lojista fora do checkout público MuPag; nunca envie PAN ou CVV.
        card_token_id:
          type: string
          format: uuid
        save_card:
          type: boolean
        customer:
          $ref: "#/components/schemas/ChargeCustomer"
        description:
          type: string
          maxLength: 500
        soft_descriptor:
          type: string
          deprecated: true
          description: Não suportado pelo PSP Asaas; requisições com valor são rejeitadas.
        payer_ip:
          type: string
          description: IP literal do pagador, atestado pelo lojista; obrigatório para credit_card.
        auth_only:
          type: boolean
        product_max_installments:
          type: integer
          minimum: 1
          maximum: 1
        external_reference:
          type: string
        expires_in_seconds:
          type: integer
          minimum: 1
        metadata:
          type: object
          additionalProperties: true
        affiliate_code:
          type: string
        coupon_code:
          type: string
        split_rules:
          type: array
          maxItems: 50
          items:
            $ref: "#/components/schemas/SplitRuleRequest"
        is_mit:
          type: boolean
        initial_mit_reference_id:
          type: string
          format: uuid
    ChargeCustomer:
      oneOf:
        - $ref: "#/components/schemas/ExistingChargeCustomer"
        - $ref: "#/components/schemas/NewChargeCustomer"
    ExistingChargeCustomer:
      type: object
      additionalProperties: false
      required: [id, name, email, tax_id]
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        email:
          type: string
          format: email
        tax_id:
          type: string
          pattern: "^(?:[0-9]{11}|[0-9]{14})$"
    NewChargeCustomer:
      type: object
      additionalProperties: false
      required: [name, email, tax_id]
      properties:
        name:
          type: string
        email:
          type: string
          format: email
        tax_id:
          type: string
          pattern: "^(?:[0-9]{11}|[0-9]{14})$"
    SplitRuleRequest:
      type: object
      additionalProperties: false
      required: [recipient_id, value_type]
      properties:
        recipient_id:
          type: string
          format: uuid
        value_type:
          type: string
          enum: [percentage_of_gross, fixed_amount]
        value_bps:
          type: integer
          minimum: 1
          maximum: 10000
        value_cents:
          type: integer
          format: int64
          minimum: 1
      oneOf:
        - required: [value_bps]
        - required: [value_cents]
    ChargeResponse:
      type: object
      required: [charge_id, status, amount_cents]
      properties:
        charge_id:
          type: string
          format: uuid
        status:
          type: string
        amount_cents:
          type: integer
          format: int64
        psp_charge_id:
          type: [string, "null"]
        card_token_id:
          type: [string, "null"]
          format: uuid
        card_brand:
          type: [string, "null"]
        card_last4:
          type: [string, "null"]
        three_ds_acs_url:
          type: [string, "null"]
          deprecated: true
          description: Reservado; o fluxo direto atual do Asaas não oferece 3DS exigível.
        failure_classification:
          type: [string, "null"]
        pix_qr_code_base64:
          type: [string, "null"]
        pix_emv_code:
          type: [string, "null"]
        expires_at:
          type: [string, "null"]
          format: date-time
    ChargeCancellationRequest:
      type: object
      additionalProperties: false
      properties:
        reason:
          type: string
          enum: [payment_attempt_cancelled]
    ChargeCancellationResponse:
      type: object
      additionalProperties: false
      required: [charge_id, status, reason, cancelled_at]
      properties:
        charge_id:
          type: string
          format: uuid
        status:
          type: string
          enum: [cancelled, cancellation_pending]
        reason:
          type: string
          enum: [payment_attempt_cancelled]
        cancelled_at:
          type: [string, "null"]
          format: date-time
    ChargeListPage:
      type: object
      additionalProperties: false
      required: [data]
      properties:
        data:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/ChargeListItem"
        next_cursor:
          type: string
          maxLength: 256
    ChargeListItem:
      type: object
      additionalProperties: false
      required: [charge_id, amount_cents, status, created_at]
      properties:
        charge_id:
          type: string
          format: uuid
        amount_cents:
          type: integer
          format: int64
          minimum: 1
        status:
          $ref: "#/components/schemas/ChargeStatus"
        psp_charge_id:
          type: string
        card_token_id:
          type: string
          format: uuid
        pix_qr_code:
          type: string
        pix_copy_paste:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    RefundRequest:
      type: object
      additionalProperties: false
      properties:
        amount_cents:
          type: integer
          format: int64
          minimum: 1
          maximum: 9000000000000000
        full:
          type: boolean
        reason:
          type: string
          maxLength: 500
      oneOf:
        - required: [amount_cents]
        - required: [full]
          properties:
            full:
              const: true
    RefundResponse:
      type: object
      required: [refund_id, charge_id, amount_cents, status, requested_at]
      properties:
        refund_id:
          type: string
          format: uuid
        charge_id:
          type: string
          format: uuid
        amount_cents:
          type: integer
          format: int64
          minimum: 1
        status:
          type: string
          enum: [requested, processing, completed, failed, cancelled, unknown]
        psp_refund_id:
          type: [string, "null"]
        reason:
          type: [string, "null"]
        requested_at:
          type: string
          format: date-time
        completed_at:
          type: [string, "null"]
          format: date-time
        failure_reason:
          type: [string, "null"]
    RefundListPage:
      type: object
      additionalProperties: false
      required: [refunds]
      properties:
        refunds:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/RefundResponse"
        next_cursor:
          type: string
          maxLength: 256
    CreateCheckoutSessionRequest:
      type: object
      additionalProperties: false
      required: [items, success_url, cancel_url]
      properties:
        items:
          type: array
          minItems: 1
          maxItems: 100
          items:
            $ref: "#/components/schemas/CheckoutItemRequest"
        success_url:
          type: string
          format: uri
          maxLength: 2048
        cancel_url:
          type: string
          format: uri
          maxLength: 2048
        customer_id:
          type: string
          format: uuid
        customer_data:
          $ref: "#/components/schemas/CheckoutCustomerDataRequest"
        allowed_payment_methods:
          type: array
          minItems: 1
          maxItems: 1
          uniqueItems: true
          items:
            type: string
            enum: [pix]
        affiliate_code:
          type: string
        coupon_id:
          type: string
          format: uuid
        utm_params:
          type: object
          maxProperties: 20
          propertyNames:
            minLength: 1
            maxLength: 64
          additionalProperties:
            type: string
            maxLength: 256
        expires_in_minutes:
          type: integer
          minimum: 1
          maximum: 1440
          default: 30
        metadata:
          type: object
          maxProperties: 50
          propertyNames:
            minLength: 1
            maxLength: 64
          additionalProperties: true
          description: >
            JSON limitado a 4 níveis, 200 nós, strings de até 1000 caracteres e peso
            estrutural total de 16 KiB.
        collect_shipping_address:
          type: boolean
        delivery_type:
          type: string
        allow_coupons:
          type: boolean
          default: true
          description: Omissao ou null preserva o comportamento legado e permite cupons.
    CheckoutItemRequest:
      type: object
      additionalProperties: false
      required: [name, quantity, unit_amount_cents]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 200
        quantity:
          type: integer
          minimum: 1
          maximum: 10000
        unit_amount_cents:
          type: integer
          format: int64
          minimum: 100
    CheckoutCustomerDataRequest:
      type: object
      additionalProperties: false
      properties:
        name:
          type: string
          maxLength: 200
        email:
          type: string
          format: email
          maxLength: 254
        document:
          type: string
          maxLength: 32
        phone:
          type: string
          maxLength: 32
    CreateCheckoutSessionResponse:
      type: object
      required: [id, url, expires_at]
      properties:
        id:
          type: string
          format: uuid
        url:
          type: string
          format: uri
        expires_at:
          type: string
          format: date-time
    CreateSubscriptionRequest:
      type: object
      additionalProperties: false
      required: [customer_id, plan_id, payment_method]
      properties:
        customer_id:
          type: string
          format: uuid
        plan_id:
          type: string
          format: uuid
        payment_method:
          $ref: "#/components/schemas/PaymentMethod"
        card_token_id:
          type: string
          format: uuid
        coupon_id:
          type: string
          format: uuid
        trial_days:
          type: integer
          minimum: 0
        affiliate_code:
          type: string
        metadata:
          type: object
          additionalProperties: true
        external_reference:
          type: string
    CancelSubscriptionRequest:
      type: object
      additionalProperties: false
      required: [mode]
      properties:
        mode:
          type: string
          enum: [immediate, end_of_period]
        reason:
          type: string
          maxLength: 500
    SubscriptionDetail:
      type: object
      required: [id, customer_id, plan_id, payment_method, status, cancel_at_period_end, metadata]
      properties:
        id:
          type: string
          format: uuid
        customer_id:
          type: string
          format: uuid
        plan_id:
          type: string
          format: uuid
        payment_method:
          $ref: "#/components/schemas/PaymentMethod"
        card_token_id:
          type: [string, "null"]
          format: uuid
        status:
          type: string
        current_period_start:
          type: [string, "null"]
          format: date-time
        current_period_end:
          type: [string, "null"]
          format: date-time
        next_billing_date:
          type: [string, "null"]
          format: date-time
        trialing_until:
          type: [string, "null"]
          format: date-time
        paused_at:
          type: [string, "null"]
          format: date-time
        paused_resume_at:
          type: [string, "null"]
          format: date-time
        cancel_at_period_end:
          type: boolean
        cancel_at:
          type: [string, "null"]
          format: date-time
        canceled_at:
          type: [string, "null"]
          format: date-time
        cancellation_reason:
          type: [string, "null"]
        metadata:
          type: object
          additionalProperties: true
        external_reference:
          type: [string, "null"]
    CustomerRequest:
      type: object
      additionalProperties: false
      required: [name, email]
      properties:
        name:
          type: string
          minLength: 1
        email:
          type: string
          format: email
        tax_id:
          type: string
        phone:
          type: string
        birth_date:
          type: string
          format: date
        external_reference:
          type: string
        marketing_consent:
          type: boolean
    CustomerSummary:
      type: object
      required: [id, name, email]
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        email:
          type: string
          format: email
        tax_id:
          type: [string, "null"]
        phone:
          type: [string, "null"]
    CustomerResponse:
      type: object
      required: [id, merchant_id, environment, name, email, marketing_consent, created_at, updated_at]
      properties:
        id:
          type: string
          format: uuid
        merchant_id:
          type: string
          format: uuid
        environment:
          type: string
          enum: [sandbox, prd]
        name:
          type: string
        email:
          type: string
          format: email
        tax_id:
          type: [string, "null"]
        phone:
          type: [string, "null"]
        birth_date:
          type: [string, "null"]
          format: date
        external_reference:
          type: [string, "null"]
        marketing_consent:
          type: boolean
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
