pe":"string","description":"The type of action. Besides `api`, `search`, `lead` and `button`, actions created in the dashboard can have other types, such as `scrape`, `document`, `order_tracking`, `appointment-ui`, `mcp` or `workflow_action`."},"index":{"type":"integer","description":"The position of the action in the chatbot's action list (0-based)."},"return_file":{"type":"boolean","description":"Whether the action returns a file.","default":false}}}]},"subscriptions":{"title":"Current subscriptions of the workspace","description":"The quantity of each plan and add-on the workspace subscribes to. A workspace without subscriptions gets `{ \"free\": 1 }`; otherwise every key below is listed, with 0 for items it does not subscribe to, and `free` is always 1.","type":"object","properties":{"free":{"type":"number","description":"Quantity of the Free plan in the workspace.","default":1},"entry":{"type":"number","description":"Quantity of the Entry plan in the workspace."},"standard":{"type":"number","description":"Quantity of the Standard plan in the workspace."},"professional":{"type":"number","description":"Quantity of the Professional plan in the workspace."},"extra_messages":{"type":"number","description":"Quantity of the Extra Message Credits add-on in the workspace."},"extra_chatbots":{"type":"number","description":"Quantity of the Extra Chatbots add-on in the workspace."},"remove_brand":{"type":"number","description":"Quantity of the Reseller plan in the workspace."},"remove_label":{"type":"number","description":"Quantity of the Remove 'Powered by Chat Data' add-on in the workspace."},"live_chat":{"type":"number","description":"Quantity of the Live Chat add-on in the workspace."},"webhook_delivery":{"type":"number","description":"Quantity of the Webhook Delivery add-on in the workspace."},"storage":{"type":"number","description":"Quantity of the 10GB Storage add-on in the workspace."},"sso_login":{"type":"number","description":"Quantity of the SSO Login add-on in the workspace."},"customize_plan_1":{"type":"number","description":"Quantity of the Enterprise plan in the workspace."},"scrape":{"type":"number","description":"Quantity of the legacy monthly scrape credits subscription in the workspace."},"entry_legacy":{"type":"number","description":"How many of the `entry` subscriptions are on the Entry plan as sold before August 2026."}},"example":{"free":1,"entry":0,"standard":1,"professional":0,"customize_plan_1":0,"extra_chatbots":0,"extra_messages":0,"live_chat":0,"remove_brand":0,"remove_label":0,"webhook_delivery":0,"sso_login":0,"storage":0,"scrape":0,"entry_legacy":0}},"currentPlan":{"required":["subscriptions","remainingTrainingChars","refreshingTrainingChars","remainingCredits","refreshingCredits","chatbots","chatbotsLimit","chatbotCharactersLimit","gatherLeads","customDomain","api","customModel","userAnalysis","shareAnalysis","notification","gpt4","removeBrand","files"],"type":"object","properties":{"subscriptions":{"$ref":"#/components/schemas/subscriptions"},"remainingTrainingChars":{"type":"number","example":50000000,"description":"The number of characters currently available for training or retraining chatbots in the workspace. Remaining characters do not carry over to the next billing period."},"refreshingTrainingChars":{"type":"number","example":110000000,"description":"The number of training characters the plan grants each billing period."},"remainingCredits":{"type":"number","example":5000,"description":"The number of message credits currently available for asking questions. It includes purchased permanent credits, which carry over; plan credits do not carry over to the next billing period."},"refreshingCredits":{"type":"number","example":10000,"description":"The number of message credits that renew each billing period."},"chatbots":{"type":"number","example":2,"description":"The number of chatbots in the workspace."},"chatbotsLimit":{"type":"number","example":5,"description":"The maximum number of chatbots allowed in the workspace."},"chatbotCharactersLimit":{"type":"number","example":11000000,"description":"The maximum number of characters that can be used to train one chatbot. The effective limit can be lower, because all chatbots in the workspace share its character capacity."},"gatherLeads":{"type":"boolean","example":true,"description":"Whether the workspace can collect customer information through the chatbot."},"customDomain":{"type":"boolean","example":true,"description":"Whether the chatbot can be hosted under a custom domain."},"api":{"type":"boolean","example":true,"description":"Whether the workspace can use the API."},"customModel":{"type":"boolean","example":true,"description":"Whether the workspace can use its own model as the backend for the chatbot widget UI."},"userAnalysis":{"type":"boolean","example":true,"description":"Whether the workspace can access aggregated user analysis statistics."},"shareAnalysis":{"type":"boolean","example":true,"description":"Whether the workspace can share a chatbot's analytics publicly."},"notification":{"type":"boolean","example":true,"description":"Whether the workspace can receive daily email notifications."},"gpt4":{"type":"boolean","example":true,"description":"Whether the workspace can use GPT-4 models to answer questions."},"removeBrand":{"type":"boolean","example":false,"description":"Whether the plan removes the Chat Data branding. The \"Powered by Chat Data\" label can also be hidden by the Remove Label add-on, which this field does not reflect."},"files":{"type":"number","example":2560,"description":"The file storage limit of the workspace, in MB."}}},"analysisRes":{"example":{"status":"success","countryDistribution":[{"country":"US","count":184},{"country":"GB","count":61}],"hourDistribution":[{"hour":"14","source":"iframe","count":37},{"hour":"15","source":"iframe","count":29}],"creditsDistribution":[{"date":1791849600000,"source":"api","count":96},{"date":1791936000000,"source":"iframe","count":412}],"mess