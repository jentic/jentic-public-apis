ay, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the messages were sent."},"count":{"type":"number","description":"The number of messages sent on the specified date."}}}},"liveChatEmailsDistribution":{"title":"Date Distribution of Live Chat Emails","type":"array","description":"One entry per day and source, oldest first.","items":{"type":"object","properties":{"date":{"type":"number","description":"The day, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the live chat emails were sent."},"count":{"type":"number","description":"The number of live chat emails sent on the specified date."}}}},"liveChatSmsDistribution":{"title":"Date Distribution of Live Chat SMS","type":"array","description":"One entry per day and source, oldest first.","items":{"type":"object","properties":{"date":{"type":"number","description":"The day, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the live chat SMS messages were sent."},"count":{"type":"number","description":"The number of live chat SMS messages sent on the specified date."}}}},"liveChatEscalationsDistribution":{"title":"Date Distribution of Live Chat Escalations","type":"array","descri