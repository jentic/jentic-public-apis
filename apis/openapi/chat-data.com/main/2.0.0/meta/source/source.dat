tle":"Date Distribution of Conversations","type":"array","description":"One entry per day and source, oldest first.","items":{"type":"object","properties":{"date":{"type":"number","description":"The day, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the conversations started."},"count":{"type":"number","description":"The number of conversations started on the specified date."}}}},"leadsCountDistribution":{"title":"Date Distribution of Leads","type":"array","description":"One entry per day and source, oldest first.","items":{"type":"object","properties":{"date":{"type":"number","description":"The day, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the leads were collected."},"count":{"type":"number","description":"The number of leads collected on the specified date."}}}},"workflowEmailsDistribution":{"title":"Date Distribution of Workflow Emails","type":"array","description":"One entry per day and source, oldest first.","items":{"type":"object","properties":{"date":{"type":"number","description":"The day, as a timestamp in milliseconds since the Unix epoch."},"source":{"type":"string","enum":["widget","iframe","site","api","Whatsapp","WhatsappWebAPI","Messenger","Instagram","Telegram","Line","Slack","Discord","Workflow Studio","cron-trigger","youtube-transcription","image-description-test","metering"],"description":"The source where the workflow emails were sent."},"count":{"type":"number","description":"The number of workflow emails sent on the specified date."}}}},"topicsDistribution":{"title":"Distribution of Chat Topics","type":"array","description":"Totals per topic, highest count first.","items":{"type":"object","properties":{"topic":{"type":"string","description":"The topic name."},"count":{"type":"number","description":"The number of user messages classified with this topic."}}}},"sentimentsDistribution":{"title":"Distribution of Chat Sentiments","type":"array","description":"Totals per sentiment, highest count first.","items":{"type":"object","properties":{"sentiment":{"type":"string","description":"The sentiment value (for example positive, negative or neutral)."},"count":{"type":"number","description":"The number of user messages classified with this sentiment."}}}},"ratingDistribution":{"title":"Distribution of Chat Ratings","type":"array","description":"Totals per rating, highest count first.","items":{"type":"object","properties":{"rating":{"type":"string","description":"The rating value (1-5)."},"count":{"type":"number","description":"The number of conversations with this rating."}}}}}},"currentPlanRes":{"required":["status","plan","email","name"],"type":"object","title":"Current plan","properties":{"status":{"type":"string","enum":["success"]},"email":{"type":"string","description":"The email address of the workspace owner.","example":"jane@example.com"},"name":{"type":"string","description":"The name of the workspace owner.","example":"Jane Doe"},"plan":{"$ref":"#/components/schemas/currentPlan","description":"The workspace's current plan."}}},"ChatbotStatusRes":{"title":"Chatbot Status Response","required":["status","progress"],"type":"object","properties":{"status":{"type":"string","enum":["success"],"description":"The overall status of the chatbot."},"progress":{"type":"number","minimum":0,"maximum":100,"description":"The training progress of the chatbot. For the pre-trained medical chat models, the progress is set to 100 when the chatbot is created. For chatbots trained on your own data, it starts at 0.\n"}}},"SuccessStatus":{"title":"Success","required":["status"],"type":"object","properties":{"status":{"type":"string","enum":["success"]}}},"ErrorStatus":{"type":"object","title":"Error","required":["status","message"],"properties":{"status":{"type":"string","enum":["error"]},"message":{"type":"string","description":"A detailed explanation of why the request has failed.","example":"No chatbot associated with the provided chatbotId was found for the user."}}},"RateLimitError":{"type":"object","title":"Too many requests error","required":["status","message"],"properties":{"status":{"type":"string","enum":["error"]},"message":{"type":"string","description":"Says how many seconds to wait before retrying. The same number is in the `Retry-After` header.","example":"Too many API requests in a row. Please retry after 12 seconds"}}},"AuthenticationErrorObject":{"type":"object","title":"Authentication Error","required":["status","message"],"properties":{"status":{"type":"string","enum":["error"]},"message":{"type":"string","description":"Why authentication failed. One of:\n- `Authorization header is missing`\n- `Invalid Authorization header format` (the header is not `Bearer <key>`)\n- `Unauthenticated Request` (no API key matches)\n- `API key workspace is unavailable or has been deleted.`\n- `API key workspace has no owner.`\n- `API access isn't included in your workspace's current plan. Upgrade at https://www.chat-data.com/pricing to enable API calls.`","example":"Unauthenticated Request"}}},"SubUserErrorObject":{"type":"object","title":"Sub-user error","description":"Error body of the sub-user operations. It has a `message` and, unlike other errors, usually no `status` field.","required":["message"],"properties":{"status":{"type":"string","enum":["error"],"description":"Only present on the 403 returned for a chatbot-scoped API key."},"message":{"type":"string","description":"A detailed explanation of why the request has failed."}}}},"securitySchemes":{"HTTPBearer":{"type":"http","scheme":"bearer"}}}}