{
  "openapi": "3.0.3",
  "info": {
    "title": "JazzHR API",
    "description": "JazzHR (formerly Resumator) applicant tracking system API",
    "version": "0.1",
    "x-jentic-source-url": "https://www.resumatorapi.com/v1/resources.json"
  },
  "servers": [
    {
      "url": "https://api.jazz.co/api"
    }
  ],
  "paths": {
    "/activities/{activity_id}": {
      "get": {
        "summary": "Find Activity By ID",
        "description": "Returns Only One Activity",
        "operationId": "activitiesID",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of the Activity",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/activities": {
      "get": {
        "summary": "Find Activities By Parameters",
        "description": "Any Number Of Parameters Can Be Used",
        "operationId": "activities",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "User ID of the Activity ",
            "required": true
          },
          {
            "name": "object_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Object ID of the Activity ",
            "required": true
          },
          {
            "name": "category",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Category of the Activity ",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/applicants/{applicant_id}": {
      "get": {
        "summary": "Find applicant by ID",
        "description": "Returns only one applicant.",
        "operationId": "applicantsID",
        "parameters": [
          {
            "name": "applicant_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Applicant's ID",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/applicants": {
      "get": {
        "summary": "Find applicants by parameters",
        "description": "Returns one page of applicants that meet search criteria.",
        "operationId": "applicants",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Any substring in first or last name",
            "required": true
          },
          {
            "name": "city",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": " ",
            "required": true
          },
          {
            "name": "job_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": " ",
            "required": true
          },
          {
            "name": "job_title",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": " ",
            "required": true
          },
          {
            "name": "recruiter_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": " ",
            "required": true
          },
          {
            "name": "apply_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Exact applied date in YYYY-MM-DD format",
            "required": true
          },
          {
            "name": "from_apply_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD",
            "required": true
          },
          {
            "name": "to_apply_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD",
            "required": true
          },
          {
            "name": "status",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Applicant's workflow status ID",
            "required": true
          },
          {
            "name": "rating",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Applicant's rating (1-5)",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      },
      "post": {
        "summary": "Create an applicant",
        "description": "Create an applicant and optionally apply them to a single job. To apply the applicant to more jobs, use applicants2jobs.",
        "operationId": "applicants",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/applicants2jobs/{appjob_id}": {
      "get": {
        "summary": "Find Applicants2Jobs Details By ID",
        "description": "Returns a single Applicants2Jobs record.",
        "operationId": "applicant2jobs",
        "parameters": [
          {
            "name": "appjob_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of the Job",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/applicants2jobs": {
      "get": {
        "summary": "Find Applicants2Jobs mapping By parameters",
        "description": "Multiple parameters can be used.",
        "operationId": "applicants2jobs",
        "parameters": [
          {
            "name": "applicant_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of Applicant",
            "required": true
          },
          {
            "name": "job_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of Job",
            "required": true
          },
          {
            "name": "rating",
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                {
                  "key": 0,
                  "val": "0"
                },
                {
                  "key": 1,
                  "val": "1"
                },
                {
                  "key": 2,
                  "val": "2"
                },
                {
                  "key": 3,
                  "val": "3"
                },
                {
                  "key": 4,
                  "val": "4"
                },
                {
                  "key": 5,
                  "val": "5"
                }
              ]
            },
            "description": "Hiring manager rating of job. 0-5 (stars)",
            "required": true
          },
          {
            "name": "workflow_step_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of Workflow Status (step) that Applicant is currently in.  Defaults to first Workflow Step in Workflow, which is “New” for Default Workflow.  To find workflow_step_id, in Settings | Workflows screen, Inspect Element for white background edge of a workflow step and look for an ID of the form id=”25007” on the inspected element (25007 would be the workflow_step_id).",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      },
      "post": {
        "summary": "Post Applicants2Jobs Mapping",
        "description": "Multiple parameters can be used.",
        "operationId": "applicants2jobs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/hires": {
      "get": {
        "summary": "Find candidates who were hired.",
        "description": "Ordered by hired date.",
        "operationId": "hires",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "schema": {
              "type": "numeric"
            },
            "description": "Page number (100 results per page)",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/categories/{category_id}": {
      "get": {
        "summary": "Find Category Details By ID",
        "description": "Returns Only One Category detail",
        "operationId": "category",
        "parameters": [
          {
            "name": "category_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of the Category",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Find Categories By parameters",
        "description": "Any Number Of Parameters Can Be Used",
        "operationId": "categories",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of the User who created the category",
            "required": true
          },
          {
            "name": "name",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "String tag for category itself.  E.g. passing string 'Golf' creates a new category 'Golf' which can be used to tag applicants",
            "required": true
          },
          {
            "name": "status",
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                {
                  "key": 0,
                  "val": "0 = Disabled"
                },
                {
                  "key": 1,
                  "val": "1 = Enabled"
                }
              ]
            },
            "description": "Select category status to filter",
            "required": true
          },
          {
            "name": "from_creation_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Category creation From Date. Use YYYY-MM-DD format",
            "required": true
          },
          {
            "name": "to_creation_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Category creation To Date. Use YYYY-MM-DD format",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      },
      "post": {
        "summary": "Post Category",
        "description": "Any Number Of Parameters Can Be Used",
        "operationId": "categories",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
