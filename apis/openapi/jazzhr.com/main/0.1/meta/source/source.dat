    "/jobs/{job_id}": {
      "get": {
        "summary": "Find Job By ID",
        "description": "Returns Only One Job",
        "operationId": "jobsID",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "ID of the Job",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "Find Jobs By Parameters",
        "description": "Any Number Of Parameters Can Be Used",
        "operationId": "jobs",
        "parameters": [
          {
            "name": "title",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Title of the Job ",
            "required": true
          },
          {
            "name": "recruiter",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Recruiter of the Job ",
            "required": true
          },
          {
            "name": "board_code",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Board Code of the Job ",
            "required": true
          },
          {
            "name": "department",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Department of the Job ",
            "required": true
          },
          {
            "name": "hiring_lead",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Hiring Lead of the Job ",
            "required": true
          },
          {
            "name": "state",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Location of Job by State ",
            "required": true
          },
          {
            "name": "city",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Location of Job by City ",
            "required": true
          },
          {
            "name": "from_open_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Filter by job open date. Use YYYY-MM-DD format",
            "required": true
          },
          {
            "name": "to_open_date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Filter by job open date. Use YYYY-MM-DD format",
            "required": true
          },
          {
            "name": "status",
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                {
                  "key": "open",
                  "val": "Open"
                },
                {
                  "key": "on hold",
                  "val": "On Hold"
                },
                {
                  "key": "approved",
                  "val": "Approved"
                },
                {
                  "key": "needs approval",
                  "val": "Needs Approval"
                },
                {
                  "key": "drafting",
                  "val": "Drafting"
                },
                {
                  "key": "filled",
                  "val": "Filled"
                },
                {
                  "key": "cancelled",
                  "val": "Cancelled"
                },
                {
                  "key": "closed",
                  "val": "Closed"
                }
              ]
            },
            "description": "Filter by Job Status",
            "required": true
          },
          {
            "name": "confidential",
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                {
                  "key": "true",
                  "val": "true"
                },
                {
                  "key": "false",
                  "val": "false"
                }
              ]
            },
            "description": "Filter by confidentiality",
            "required": true
          },
          {
            "name": "private",
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                {
                  "key": "true",
                  "val": "true"
                },
                {
                  "key": "false",
                  "val": "false"
                }
              ]
            },
            "description": "Filter by privacy",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      },
      "post": {
        "summary": "Create a Job",
        "description": "Any Number Of Parameters Can Be Used",
        "operationId": "job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Invalid API Key"
          }
        }
      }
    },
