          },
          {
            "name": "applicant_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Applicant ID",
            "required": true
          },
          {
            "name": "job_id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "description": "Job Id",
            "required": true
          },
          {
            "name": "page",
            "in": "path",
            "schema": {
              "type": "numeric"
            },
            "description": "Page number (100 results per page)",
            "required": true
          }
        ],
