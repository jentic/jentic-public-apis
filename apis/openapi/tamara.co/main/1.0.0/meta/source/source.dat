    "/merchants/payment-types": {
      "get": {
        "summary": "Get payment types",
        "description": "Get available payment types for the merchant",
        "operationId": "getPaymentTypes",
        "tags": [
          "merchant"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/merchants/payment-options/pre-check": {
      "post": {
        "summary": "Pre-check payment options",
        "description": "Check available payment options for a customer",
        "operationId": "preCheckPaymentOptions",
        "tags": [
          "merchant"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
