{
  "openapi": "3.1.0",
  "info": {
    "title": "INITE AI Visibility",
    "version": "2.0.0",
    "summary": "The AI visibility audit, and the company data behind it, as HTTP.",
    "description": "Four endpoints a third party may call. Two are public reads; two are JSON-RPC surfaces behind OAuth — MCP for a model holding tools, A2A for an agent handing another agent a task. Both are described by their own discovery documents, linked from `externalDocs`.",
    "contact": {
      "name": "inite LLC",
      "url": "https://inite.ai",
      "email": "info@inite.ai"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://inite.ai/en/terms"
    },
    "x-jentic-source-url": "https://inite.ai/.well-known/openapi.json"
  },
  "servers": [
    {
      "url": "https://inite.ai"
    }
  ],
  "paths": {
    "/api/ai-data": {
      "get": {
        "operationId": "getCompanyData",
        "summary": "Structured company data",
        "description": "The fullest structured answer about this company: what is sold, at what price, the service ladder, the site routes, the analyzer feature list and the FAQ. Written for a model crawling or answering questions about INITE. English is canonical.",
        "tags": [
          "public"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The company record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Assembled from the same sources the site renders from, so the shape follows the catalogue rather than a frozen contract. Read it, do not pin to it.",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/badge": {
      "get": {
        "operationId": "getVisibilityBadge",
        "summary": "Embeddable AI visibility badge",
        "description": "An SVG badge a site owner places on their own pages after an audit. Prints the composite score of the shared report named by `report`; the number is read from the report, never taken from the URL. Without a report it shows no score.",
        "tags": [
          "public"
        ],
        "security": [],
        "parameters": [
          {
            "name": "report",
            "in": "query",
            "required": false,
            "description": "The public share id of the audit report (the id in /report/{shareId}).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "style",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "flat",
                "gradient"
              ],
              "default": "gradient"
            }
          },
          {
            "name": "theme",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "dark",
                "light"
              ],
              "default": "dark"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The badge.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "operationId": "callMcp",
        "summary": "Model Context Protocol endpoint (JSON-RPC 2.0)",
        "description": "Streamable HTTP MCP, three rails: portal (services, prices, call slots, booking, contact, guides), analyzer (identity check, AI visibility audit) and atlas (tool matching, a tool's measured record, search, market changes, coupons). Open without a token: a guest gets every open tool under per-address allowances and the audit as a survey. A token adds the member tools and the account's own tier; a member tool called without one answers 401 with WWW-Authenticate. Stateless, no session. `/api/mcp/{rail}` serves one rail.",
        "tags": [
          "agent"
        ],
        "externalDocs": {
          "description": "MCP server card",
          "url": "https://inite.ai/.well-known/mcp.json"
        },
        "security": [
          {},
          {
            "mcpOAuth": []
          }
        ],
