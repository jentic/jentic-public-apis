                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The JSON-RPC reply. For the two streaming methods the body is `text/event-stream` and each event is one `data:` line carrying a JSON-RPC envelope.",
            "content": {
