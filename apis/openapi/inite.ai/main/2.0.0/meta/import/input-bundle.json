    "/api/a2a": {
      "post": {
        "operationId": "callA2a",
        "summary": "Agent2Agent endpoint (JSON-RPC 2.0, A2A v1.0)",
        "description": "A2A v1.0 — PascalCase methods (`SendMessage`, `GetTask`, `ListTasks`, `CancelTask`) and ProtoJSON shapes, so enums arrive as `TASK_STATE_WORKING` and fields as camelCase. `SendStreamingMessage` and `SubscribeToTask` answer with `text/event-stream` instead of JSON. A client announcing an older version in `A2A-Version` is refused rather than served 1.0 shapes under a 0.3 name.",
        "tags": [
          "agent"
        ],
        "externalDocs": {
          "description": "A2A agent card",
          "url": "https://inite.ai/.well-known/agent-card.json"
        },
        "security": [
          {},
          {
            "a2aOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "A2A-Version",
            "in": "header",
            "required": false,
            "description": "A2A service parameter. Only 1.0 is implemented; anything else is refused with VersionNotSupportedError.",
            "schema": {
              "type": "string",
              "enum": [
                "1.0"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
