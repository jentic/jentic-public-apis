      "get": {
        "tags": [
          "checks"
        ],
        "summary": "Get Check Heatmap",
        "description": "Return the heatmap image (PNG) for a check if available.\n\nAccess control: admin can access any, regular user only own checks.\n404 if check not found or heatmap missing.",
        "operationId": "get_check_heatmap_api_checks__check_id__heatmap_get",
