    "/api/billing/paddle/webhook": {
      "post": {
        "tags": [
          "paddle"
        ],
        "summary": "Paddle Webhook",
        "description": "Paddle webhook endpoint для обработки событий оплаты.\n\nСобытия:\n- transaction.completed: Успешная оплата\n- transaction.payment_failed: Неудачная оплата\n\nFlow:\n1. Проверить подпись webhook\n2. Парсить событие\n3. Найти order по custom_data.order_id\n4. Проверить идемпотентность (status != succeeded)\n5. Начислить кредиты пользователю\n6. Обновить статус order\n7. Вернуть 200 OK",
        "operationId": "paddle_webhook_api_billing_paddle_webhook_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
