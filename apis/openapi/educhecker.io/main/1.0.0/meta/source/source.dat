    "/api/checks/{check_id}/document": {
      "get": {
        "tags": [
          "checks"
        ],
        "summary": "Get Document File",
        "description": "Return original document file for a check (image/PDF). Access control enforced.\n\nFor images, the frontend can display this directly. For PDFs, consider a specialized viewer.",
        "operationId": "get_document_file_api_checks__check_id__document_get",
