    "/api/checks/{check_id}/payment": {
      "get": {
        "tags": [
          "checks"
        ],
        "summary": "Get Check Payment Info",
        "description": "Return payment info for a specific check: order id, amount, currency, and mock payment link.\nIf the check is already paid, respond accordingly. If payment is awaited but no order exists\n(unlikely), return a generic awaiting state.",
        "operationId": "get_check_payment_info_api_checks__check_id__payment_get",
        "security": [
          {
