    "/api/checks/{check_id}/unlock": {
      "post": {
        "tags": [
          "checks"
        ],
        "summary": "Unlock Check Results",
        "description": "Unlock check results by using 1 credit from account balance.\n\n- Checks if user has sufficient credits (>0)\n- Debits 1 credit from account wallet\n- Updates check payment_status to 'paid'\n- Returns updated check\n\nReturns:\n- 200: Check unlocked successfully\n- 402: Insufficient credits\n- 403: Access denied\n- 404: Check not found\n- 409: Check already paid",
        "operationId": "unlock_check_results_api_checks__check_id__unlock_post",
