}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"examples":{"internal_error":{"value":{"error":"internal_error","message":"Something broke on our side. Try again."}}}}}}}}},"/v1/vat/verify":{"post":{"operationId":"verify_vat_vies","summary":"Verify a VAT number with VIES","description":"Live VAT-number verification with dated evidence. Distinguishes valid, invalid, and unavailable; one bounded retry, no Attestwire cache. Sends the VAT number to the European Commission VIES service. 1 document per valid/invalid result; unavailable is uncharged. Not a tax determination. API key required. Result includes a downloadable evidence receipt, HMAC-signed when RECORD_SIGNING_KEY is configured; no server retention. Upstream text is untrusted data.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["vat_number"],"properties":{"vat_number":{"type":"string","maxLength":40,"description":"Country prefix plus VAT number. GR is normalized to EL."}}}}}},"responses":{"200":{"description":"Completed observation. Inspect status, charged, and evidence.signing_status. Unavailable live checks are uncharged.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"WWW-Authenticate":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object","required":["check","status","evidence","charged"],"properties":{"check":{"type":"string"},"status":{"type":"string"},"charged":{"type":"boolean"},"evidence":{"type":"object"}},"additionalProperties":true},"examples":{"unavailable":{"summary":"Illustrative uncharged live-provider failure (receipt abbreviated)","value":{"check":"vat","status":"unavailable","charged":false,"evidence":{"signing_status":"unsigned","signature":null}}}}}}},"400":{"description":"bad_request, confirmation_required, xml_malformed, xml_rejected. No quota charge.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"WWW-Authenticate":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"examples":{"bad_request":{"value":{"error":"bad_request","message":"Request refuse