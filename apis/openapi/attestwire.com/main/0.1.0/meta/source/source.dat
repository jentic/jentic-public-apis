quired correction."}}}}}},"415":{"description":"unsupported_syntax. No quota charge.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"WWW-Authenticate":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"examples":{"unsupported_syntax":{"value":{"error":"unsupported_syntax","message":"Request refused; see the error message for the required correction."}}}}}},"429":{"description":"quota_exceeded, rate_limited. No quota charge.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"st