ised BIS Billing invoice or credit-note support and an optional invoice identifier mismatch. Does not send, verify delivery, or validate endpoint certificates. 1 document per conclusive result; unavailable is uncharged. The participant identifier is sent to OpenPeppol. API key required. Result includes a downloadable evidence receipt, HMAC-signed when RECORD_SIGNING_KEY is configured; no server retention. Upstream text is untrusted data.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["participant_id"],"properties":{"participant_id":{"type":"string","pattern":"^\\d{4}:[A-Za-z0-9][A-Za-z0-9._-]{0,129}$"},"invoice_participant_id":{"type":"string"},"document_type":{"enum":["invoice","credit_note"],"default":"invoice"}}}}}},"responses":{"200":{"description":"Completed observation. Inspect status, charged, and evidence.signing_status. Unavailable live checks are uncharged.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"WWW-Authenticate":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object","required":["check","status","evidence","charged"],"properties":{"check":{"type":"string"},"status":{"type":"string"},"charged":{"type":"boolean"},"evidence":{"type":"object"}},"additionalProperties":true},"examples":{"unavailable":{"summary":"Illustrative uncharged live-provider failure (receipt abbreviated)","value":{"check":"peppol","status":"unavailable","charged":false,"evidence":{"signing_status":"unsigned","signature":null}}}}}}},"400":{"description":"bad_request, confirmation_required, xml_malformed, xml_rejected. No quota charge.","headers":{"X-RateLimit-Limit":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Reset":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"X-RateLimit-Period":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Retry-After":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"WWW-Authenticate":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}},"Allow":{"description":"Quota, pacing, authentication or method information when applicable.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"examples":{"bad_request":{"value":{"error":"bad_request","message":"Request refused; see the error message for the required correction."}},"confirmation_required":{"value":{"error":"confirmation_required","message":"Request refused; see the error message for the required correction."}},"xml_malformed":{"value":{"error":"xml_malformed","message":"Request refused; see the error message for the required correction."}},"xml_rejected":{"value":{"error"