  "security": [
    {
      "tokenUsuario": []
    },
    {
      "tokenDispositivo": []
    }
  ],
  "components": {
    "securitySchemes": {
      "tokenUsuario": {
        "type": "http",
        "scheme": "bearer"
      },
      "tokenDispositivo": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "RespuestaBase": {
        "description": "Encapsula la información base de cualquier respuesta de la API.",
        "type": "object",
        "properties": {
          "estado": {
            "type": "integer",
            "format": "int32",
            "description": "Código de resultado de la solicitud. 1 es éxito, cualquier otro código es error."
          },
          "mensaje": {
            "type": "string",
            "description": "Descripción del código de resultado"
          }
        },
        "required": [
          "estado",
          "mensaje"
        ]
      },
      "RespuestaFallida": {
        "description": "Encapsula la información de una respuesta fallida.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaBase"
          }
        ]
      },
      "RespuestaFallidaConDepuracion": {
        "description": "Encapsula la información de una respuesta fallida con datos adicionales de depuración.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaFallida"
          }
        ],
        "type": "object",
        "properties": {
          "debug": {
            "type": "string",
            "description": "Información adicional sobre el error"
          }
        },
        "required": [
          "debug"
        ]
      },
      "ResultadoModulo": {
        "description": "Encapsula el listado de resultados de un módulo.",
        "type": "object",
        "properties": {
          "_": {
            "type": "integer",
            "format": "int64",
            "description": "Valor enviado en el parámetro _"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total de registros existentes en el módulo."
          },
          "filtrados": {
            "type": "integer",
            "format": "int64",
            "description": "Total de registros que cumplen con el filtro especificado."
          }
        },
        "required": [
          "_",
          "total",
          "filtrados"
        ]
      },
      "s_QueryCondicion": {
        "description": "Encapsula una condición de filtrado en las llamadas a /query",
        "type": "object",
        "properties": {
          "campo": {
            "type": "string",
            "description": "Campo por el que se filtrará o nombre del grupo de condiciones"
          },
          "operador": {
            "type": "number",
            "description": "Operador contra el que se comparará el valor del campo y el valor proporcionado"
          },
          "valor": {
            "type": "string",
            "description": "Valor a comparar"
          },
          "concatenador": {
            "type": "number",
            "description": "Tipo de lógica con el que se concatenará esta condición a las demás. Si no se especifica se asume FDW_DATO_BDD_LOGICA_Y"
          }
        },
        "required": [
          "campo"
        ]
      },
      "QueryCondicion": {
        "description": "Encapsula una condición o grupo de condiciones de filtrado en las llamadas a /query",
        "allOf": [
          {
            "$ref": "#/components/schemas/s_QueryCondicion"
          }
        ],
        "type": "object",
        "properties": {
          "grupo": {
            "type": "array",
            "description": "Arreglo de condiciones del grupo",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/components/schemas/s_QueryCondicion"
                }
              ]
            }
          }
        },
        "required": [
          "resultado"
        ]
      },
      "rbConfiguracionImagen": {
        "description": "Encapsula la configuración de imágenes solicitadas en las llamadas que lo requieran.",
        "type": "object",
        "properties": {
          "tipo": {
            "type": "number",
            "description": "Tipo de imagen soliciada (original, horizontal, vertica o cuadrada)"
          },
          "tamano": {
            "type": "number",
            "description": "Tamaño de la imagen solicitada (chica o grande)"
          }
        }
      },
      "rbQuery": {
        "description": "Encapsula los parámetros del body en las llamadas a /query",
        "properties": {
          "inicio": {
            "type": "number",
            "format": "int64",
            "description": "Registro inicial"
          },
          "registros": {
            "type": "number",
            "format": "int64",
            "description": "Número de registros solicitados"
          },
          "campos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Listado de campos separados por comas solicitados. Si no se proporcionan se utilizarán los campos predeterminados del módulo."
          },
          "ordenamiento_campos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Listado de campos que se utilizarán para el ordenamiento. Si no se proporciona los resultados no se ordenarán. Opcionalmente se puede incluir el símbolo + (ascendente) o - (descendente) para indicar el orden."
          },
          "_": {
            "type": "number",
            "format": "int64",
            "description": "Valor de referencia que será regresado en la respuesta tal y como se proporciona"
          },
          "filtro": {
            "type": "array",
            "description": "Arreglo de condiciones del grupo",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/components/schemas/QueryCondicion"
                }
              ]
            }
          },
          "imagen": {
            "$ref": "#/components/schemas/rbConfiguracionImagen"
          }
        },
        "required": [
          "inicio",
          "registros"
        ]
      },
      "RespuestaPerfilPublicoEmpresa": {
        "description": "Encapsula la información pública del perfil de empresa.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaBase"
          }
        ],
        "type": "object",
        "properties": {
          "resultado": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PerfilPublicoEmpresa"
              }
            ]
          }
        },
        "required": [
          "resultado"
        ]
      },
      "RespuestaPerfilPublicoUsuario": {
        "description": "Encapsula la información pública del perfil de usuario.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaBase"
          }
        ],
        "type": "object",
        "properties": {
          "resultado": {
            "type": "object",
            "properties": {
              "usuario": {
                "type": "object",
                "description": "Perfil del usuario en sesión.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PerfilPublicoUsuarioAEWeb"
                  }
                ]
              },
              "permisos": {
                "type": "array",
                "description": "Arreglo con los permisos del usuario.",
                "items": {
                  "type": "object",
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Permiso"
                    }
                  ]
                }
              },
              "configuraciones": {
                "type": "array",
                "description": "Arreglo con los permisos del usuario.",
                "items": {
                  "type": "object",
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Configuracion"
                    }
                  ]
                }
              },
              "sesion": {
                "type": "object",
                "description": "Información de la sesión actual",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/InformacionSesion"
                  }
                ]
              }
            },
            "required": [
              "usuario",
              "permisos",
              "configuraciones"
            ]
          }
        },
        "required": [
          "resultado"
        ]
      },
      "RespuestaCPs": {
        "description": "Encapsula la información del CP especificado.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaBase"
          }
        ],
        "type": "object",
        "properties": {
          "resultado": {
            "type": "array",
            "description": "Arreglo con los códigos postales disponibles.",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/components/schemas/CP"
                }
              ]
            }
          }
        },
        "required": [
          "resultado"
        ]
      },
      "PerfilPublicoEmpresa": {
        "description": "Encapsula la información pública del perfil de empresa.",
        "type": "object",
        "properties": {
          "repositorio": {
            "type": "string",
            "description": "Directorio de la empresa dentro del repositorio. https://archivo.aeweb.app/{repositorio}"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre completo de la empresa"
          },
          "nombre_corto": {
            "type": "string",
            "description": "Nombre corto de la empresa"
          },
          "numero_de_decimales": {
            "type": "integer",
            "format": "int64",
            "description": "Número de decimales utilizados por la empresa"
          },
          "logotipo_url": {
            "type": "string",
            "description": "URL del logotipo"
          },
          "pie_de_pagina_url": {
            "type": "string",
            "description": "URL del pié de página para URL públicas"
          },
          "modulo_ruta": {
            "type": "boolean",
            "description": "Modulo Ruta habilitado"
          },
          "modulo_bi": {
            "type": "boolean",
            "description": "Modulo BI habilitado"
          },
          "modulo_contabilidad": {
            "type": "boolean",
            "description": "Modulo Contabilidad habilitado"
          },
          "modulo_tienda": {
            "type": "boolean",
            "description": "Modulo Tienda habilitado"
          }
        },
        "required": [
          "repositorio",
          "nombre",
          "nombre_corto",
          "numero_de_decimales",
          "modulo_ruta",
          "modulo_bi",
          "modulo_contabilidad",
          "modulo_tienda"
        ]
      },
      "CP": {
        "description": "Información de un código postal",
        "type": "object",
        "properties": {
          "cp": {
            "type": "string",
            "description": "Código Postal asentamiento"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de asentamiento (Catálogo SEPOMEX)"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre asentamiento"
          },
          "ciudad": {
            "type": "string",
            "description": "Nombre Ciudad (Catálogo SEPOMEX)"
          },
          "municipio": {
            "type": "string",
            "description": "Nombre Municipio (INEGI, Marzo 2013)"
          },
          "estado": {
            "type": "string",
            "description": "Nombre Entidad (INEGI, Marzo 2013)"
          },
          "zona": {
            "type": "string",
            "description": "Zona en la que se ubica el asentamiento (Urbano/Rural)"
          },
          "municipio_inegi": {
            "type": "string",
            "description": "Clave Municipio (INEGI, Marzo 2013)"
          },
          "latitud": {
            "type": "number",
            "format": "double",
            "description": "Latitud aproximada de la ubicación"
          },
          "longitud": {
            "type": "number",
            "format": "double",
            "description": "Longitud aproximada de la ubicación"
          }
        },
        "required": [
          "cp",
          "nombre",
          "municipio",
          "estado"
        ]
      },
      "PerfilPublicoUsuarioGenerico": {
        "description": "Encapsula la información pública del perfil de usuario.",
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "format": "int64",
            "description": "ID del usuario"
          },
          "usuario": {
            "type": "string",
            "description": "Nombre de usuario"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre completo del usuario"
          },
          "fotografia_perfil_url": {
            "type": "string",
            "description": "URL de la fotografía de perfil"
          },
          "tfa_habilitado": {
            "type": "boolean",
            "description": "¿TFA está habilitado en el usuario?"
          }
        },
        "required": [
          "id",
          "usuario",
          "nombre",
          "fotografia_perfil_url"
        ]
      },
      "PerfilPublicoUsuarioAEWeb": {
        "description": "Encapsula la información pública del perfil de usuario AEWeb.",
        "allOf": [
          {
            "$ref": "#/components/schemas/PerfilPublicoUsuarioGenerico"
          }
        ],
        "type": "object",
        "properties": {
          "almacen_id": {
            "type": "number",
            "format": "int64"
          },
          "empleado_id": {
            "type": "number",
            "format": "int64"
          }
        }
      },
      "InformacionSesion": {
        "description": "Encapsula la información pública del perfil de usuario.",
        "type": "object",
        "properties": {
          "token_id": {
            "type": "number",
            "format": "int64",
            "description": "ID del token de la sesión"
          }
        }
      },
      "Permiso": {
        "description": "Encapsula la información de un permiso de usuario.",
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre del permiso de usuario"
          },
          "valor": {
            "type": "number",
            "format": "int64",
            "description": "Valor con los permisos (a nivel de bits) del usuario"
          }
        },
        "required": [
          "nombre",
          "valor"
        ]
      },
      "Configuracion": {
        "description": "Encapsula la información de una configuración del sistema.",
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre de la configuración"
          },
          "valor": {
            "type": "string",
            "description": "Valor de la configuración"
          }
        },
        "required": [
          "nombre",
          "valor"
        ]
      },
      "NodoReportePorSurtir": {
        "description": "Información de un nodo del reporte por surtir",
        "type": "object",
        "properties": {
          "almacen_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID del almacén del nodo"
          },
          "presentacion_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID de la presentación del nodo"
          },
          "existencia": {
            "type": "integer",
            "format": "int64",
            "description": "Existencia en el almacén"
          },
          "por_surtir": {
            "type": "integer",
            "format": "int64",
            "description": "Unidades por surtir"
          },
          "presentacion_codigo": {
            "type": "string",
            "description": "Código de la presentación"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "presentacion_nombre": {
            "type": "string",
            "description": "Nombre de la presentación"
          }
        },
        "required": [
          "almacen_id",
          "presentacion_id",
          "existencia",
          "por_surtir",
          "presentacion_codigo",
          "producto_nombre",
          "presentacion_nombre"
        ]
      },
      "RespuestaReportePorSurtir": {
        "description": "Encapsula la información del reporte por surtir.",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespuestaBase"
          }
        ],
        "type": "object",
