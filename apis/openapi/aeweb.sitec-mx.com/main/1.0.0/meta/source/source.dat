{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://aeweb.sitec-mx.com",
      "description": "API de producción"
    }
  ],
  "paths": {
    "/{empresa}/perfil": {
      "get": {
        "summary": "Obtiene el perfil de la empresa",
        "description": "Obtiene la información pública de la empresa.",
        "parameters": [
          {
            "name": "empresa",
            "in": "path",
            "description": "Empresa",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string",
              "example": "empresa"
            }
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaPerfilPublicoEmpresa"
                }
              }
            }
          },
          "400": {
            "description": "Error al procesar la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "404": {
            "description": "Empresa inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "500": {
            "description": "Error desconocido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaFallidaConDepuracion"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible por mantenimiento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          }
        },
        "tags": [
          "Empresa"
        ]
      }
    },
    "/{empresa}/empresa/regiones": {
      "get": {
        "summary": "Obtiene las regiones disponibles",
        "parameters": [
          {
            "name": "empresa",
            "in": "path",
            "description": "Empresa",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string",
              "example": "empresa"
            }
          },
          {
            "name": "inicio",
            "in": "query",
            "description": "Registro inicial",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          },
          {
            "name": "registros",
            "in": "query",
            "description": "Número de registros solicitados",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          {
            "name": "campos",
            "in": "query",
            "description": "Listado de campos separados por comas solicitados. Si no se proporcionan se utilizarán los campos predeterminados del módulo.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "id, nombre"
            }
          },
          {
            "name": "busqueda",
            "in": "query",
            "description": "Término de búsqueda por el que se filtrarán los registros solicitados.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "prueba"
            }
          },
          {
            "name": "busqueda_campos",
            "in": "query",
            "description": "Listado de campos separados por comas en donde se buscará el término de búsqueda. Si no se proporciona se utilizarán los campos del parámetro 'campos'.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "campo1,campo2"
            }
          },
          {
            "name": "ordenamiento_campos",
            "in": "query",
            "description": "Listado de campos separados por comas que se utilizarán para el ordenamiento. Si no se proporciona los resultados no se ordenarán. Opcionalmente se puede incluir el símbolo + (ascendente) o - (descendente) para indicar el orden.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "campo1,-campo2"
            }
          },
          {
            "name": "_",
            "in": "query",
            "description": "Valor de referencia que será regresado en la respuesta tal y como se proporciona",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaRegionesModulo"
                }
              }
            }
          },
          "400": {
            "description": "Error al procesar la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "500": {
            "description": "Error desconocido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaFallidaConDepuracion"
                }
              }
            }
          }
        },
        "tags": [
          "Empresa"
        ]
      },
      "post": {
        "summary": "Agrega una nueva región",
        "parameters": [
          {
            "name": "empresa",
            "in": "path",
            "description": "Empresa",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string",
              "example": "empresa"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rbRegion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Éxito",
            "content": {
