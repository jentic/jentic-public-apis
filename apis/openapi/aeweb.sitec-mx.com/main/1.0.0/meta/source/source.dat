    "/{empresa}/cfdi/usocfdis": {
      "get": {
        "summary": "Obtiene los usos de CFDI disponibles",
        "description": "Obtiene los usos de CFDI disponibles.",
        "parameters": [
          {
            "name": "empresa",
            "in": "path",
            "description": "Empresa",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string",
              "example": "empresa"
            }
          },
          {
            "name": "inicio",
            "in": "query",
            "description": "Registro inicial",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          },
          {
            "name": "registros",
            "in": "query",
            "description": "Número de registros solicitados",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          {
            "name": "campos",
            "in": "query",
            "description": "Listado de campos separados por comas solicitados. Si no se proporcionan se utilizarán los campos predeterminados del módulo.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "id, nombre"
            }
          },
          {
            "name": "busqueda",
            "in": "query",
            "description": "Término de búsqueda por el que se filtrarán los registros solicitados.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "prueba"
            }
          },
          {
            "name": "busqueda_campos",
            "in": "query",
            "description": "Listado de campos separados por comas en donde se buscará el término de búsqueda. Si no se proporciona se utilizarán los campos del parámetro 'campos'.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "campo1,campo2"
            }
          },
          {
            "name": "ordenamiento_campos",
            "in": "query",
            "description": "Listado de campos separados por comas que se utilizarán para el ordenamiento. Si no se proporciona los resultados no se ordenarán. Opcionalmente se puede incluir el símbolo + (ascendente) o - (descendente) para indicar el orden.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "campo1,-campo2"
            }
          },
          {
            "name": "_",
            "in": "query",
            "description": "Valor de referencia que será regresado en la respuesta tal y como se proporciona",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaUsosCFDIModulo"
                }
              }
            }
          },
          "400": {
            "description": "Error al procesar la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBase"
                }
              }
            }
          },
          "500": {
            "description": "Error desconocido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaFallidaConDepuracion"
                }
              }
            }
          }
        },
        "tags": [
          "CFDI"
        ]
      }
    },
