{
  "openapi": "3.1.0",
  "info": {
    "title": "CryptoN API \u0434\u043b\u044f \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c",
    "description": "\u041f\u0440\u0438\u0451\u043c \u043e\u043f\u043b\u0430\u0442\u044b \u0432 BTC, LTC, TRX, USDT TRC20. \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u044b, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 \u0434\u043b\u044f \u043f\u0440\u0438\u0451\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439. \u0411\u0430\u043b\u0430\u043d\u0441\u044b \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u0432, \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0438 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u043f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 Platform Bot.\n\n**\u0412\u0430\u0436\u043d\u043e:** \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044f 2.5% \u043e\u0442\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0441\u0443\u043c\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 \u0438\u043d\u0432\u043e\u0439\u0441\u0435.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/crypton-34a/crypton-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://websamart.xyz",
      "description": "\u0411\u0430\u0437\u043e\u0432\u044b\u0439 URL (\u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u043e\u0439 \u0434\u043e\u043c\u0435\u043d, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c)"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "\u0421\u043b\u0443\u0436\u0435\u0431\u043d\u044b\u0435"
        ],
        "summary": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u0438 API",
        "description": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e API \u0437\u0430\u043f\u0443\u0449\u0435\u043d \u0438 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442. \u041d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 API-\u043a\u043b\u044e\u0447\u0430.",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "API \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments": {
      "post": {
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "summary": "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u043b\u0430\u0442\u0451\u0436",
        "description": "\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0442\u0435\u0436\u0430. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u0434\u0440\u0435\u0441 \u0434\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u044b \u0438 \u0441\u0443\u043c\u043c\u0443. \u041a\u043b\u0438\u0435\u043d\u0442 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442 \u043a\u0440\u0438\u043f\u0442\u0443 \u043d\u0430 \u044d\u0442\u043e\u0442 \u0430\u0434\u0440\u0435\u0441; \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0432 \u0441\u0435\u0442\u0438 \u0441\u0442\u0430\u0442\u0443\u0441 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f \u043d\u0430 confirmed. \u0418\u043d\u0432\u043e\u0439\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u0435\u043d 60 \u043c\u0438\u043d\u0443\u0442. \u0414\u043b\u044f USDT TRC20 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0443 \u0445\u0435\u0448\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 (verify). \u041a\u043e\u043c\u0438\u0441\u0441\u0438\u044f 2.5% \u043e\u0442\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0441\u0443\u043c\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 \u0438\u043d\u0432\u043e\u0439\u0441\u0435.",
        "operationId": "create_payment",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "\u041f\u043b\u0430\u0442\u0451\u0436 \u0441\u043e\u0437\u0434\u0430\u043d. \u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0439\u0442\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0443 address \u0438 amount.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b (\u0432\u0430\u043b\u044e\u0442\u0430, \u0441\u0443\u043c\u043c\u0430 \u0438 \u0442.\u043f.)."
          },
          "401": {
            "description": "\u041d\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 X-API-Key."
          },
          "403": {
            "description": "\u041a\u043b\u044e\u0447 \u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439, \u043d\u043e \u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u044d\u0442\u043e\u043c\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443 (\u0434\u0440\u0443\u0433\u0430\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f)."
          },
          "409": {
            "description": "\u0417\u0430\u043a\u0430\u0437 \u0441 \u0442\u0430\u043a\u0438\u043c order_id \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 order_id."
          },
          "422": {
            "description": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "429": {
            "description": "\u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d rate limit; \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432."
          },
          "503": {
            "description": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430."
          }
        }
      }
    },
    "/api/v1/payments/{order_id}/status": {
      "get": {
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "summary": "\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430",
        "description": "\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u043f\u043e order_id. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u044b: pending, partial, confirmed, partial_confirmed, failed, expired, cancelled. \u041f\u0440\u0438 partial \u0432 \u043e\u0442\u0432\u0435\u0442\u0435 \u0435\u0441\u0442\u044c amount_received \u0438 remaining_amount \u2014 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0439\u0442\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0443 \u043d\u0435\u0434\u043e\u043f\u043b\u0430\u0442\u0443. \u0414\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043f\u043e\u043b\u043b\u0438\u043d\u0433\u0430 \u0440\u0430\u0437 \u0432 60 \u0441\u0435\u043a\u0443\u043d\u0434. \u0414\u043b\u044f USDT TRC20 \u043f\u043e\u043b\u043b\u0438\u043d\u0433 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u2014 \u0441\u0442\u0430\u0442\u0443\u0441 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0445\u0435\u0448\u0430 \u0447\u0435\u0440\u0435\u0437 verify.",
        "operationId": "get_payment_status",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435"
          }
        ],
        "responses": {
          "200": {
            "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 (order_id, status, amount, currency; \u043f\u0440\u0438 partial \u2014 amount_received, remaining_amount)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "amount_received": {
                      "type": "string"
                    },
                    "remaining_amount": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "confirmed": {
                    "summary": "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043e",
                    "value": {
                      "order_id": "order-abc-123",
                      "status": "confirmed",
                      "amount": "0.005",
                      "amount_received": "0.005",
                      "currency": "LTC"
                    }
                  },
                  "partial": {
                    "summary": "\u0427\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u0437\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435",
                    "value": {
                      "order_id": "order-abc-123",
                      "status": "partial",
                      "amount": "0.005",
                      "currency": "LTC",
                      "amount_received": "0.003",
                      "remaining_amount": "0.002"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b."
          },
          "401": {
            "description": "\u041d\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 X-API-Key."
          },
          "403": {
            "description": "\u041d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443 (\u0434\u0440\u0443\u0433\u0430\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f)."
          },
          "404": {
            "description": "\u0417\u0430\u043a\u0430\u0437 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
          },
          "422": {
            "description": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "429": {
            "description": "\u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d rate limit."
          },
          "503": {
            "description": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430."
          }
        }
      }
    },
    "/api/v1/payments/{order_id}/cancel": {
      "post": {
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "summary": "\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u043b\u0430\u0442\u0451\u0436",
        "description": "\u041e\u0442\u043c\u0435\u043d\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0435 pending. \u041e\u0442\u043c\u0435\u043d\u0451\u043d\u043d\u044b\u0439 \u043f\u043b\u0430\u0442\u0451\u0436 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u043b\u043b\u0438\u043d\u0433. \u0415\u0441\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043c\u0435\u043d\u044b \u0432\u044b\u0437\u0432\u0430\u0442\u044c GET \u0441\u0442\u0430\u0442\u0443\u0441\u0430, \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442 \u0430\u0434\u0440\u0435\u0441; \u0435\u0441\u043b\u0438 \u043a\u043b\u0438\u0435\u043d\u0442 \u0443\u0441\u043f\u0435\u043b \u043f\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u2014 \u0441\u0442\u0430\u0442\u0443\u0441 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044c confirmed.",
        "operationId": "cancel_payment",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "\u041f\u043b\u0430\u0442\u0451\u0436 \u043e\u0442\u043c\u0435\u043d\u0451\u043d (order_id, status: cancelled, amount, currency)"
          },
          "400": {
            "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0438\u043b\u0438 \u043f\u043b\u0430\u0442\u0451\u0436 \u043d\u0435 \u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0435 pending."
          },
          "401": {
            "description": "\u041d\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 X-API-Key."
          },
          "403": {
            "description": "\u041d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443."
          },
          "404": {
            "description": "\u0417\u0430\u043a\u0430\u0437 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
          },
          "422": {
            "description": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "429": {
            "description": "\u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d rate limit."
          },
          "503": {
            "description": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430."
          }
        }
      }
    },
    "/api/v1/payments/{order_id}/verify": {
      "post": {
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "summary": "\u0412\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u043e \u0445\u0435\u0448\u0443 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 (USDT TRC20)",
        "description": "\u0422\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f USDT_TRC20. \u041f\u043b\u0430\u0442\u0435\u0436\u0438 \u0432 USDT TRC20 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0443 \u0445\u0435\u0448\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438. \u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u043c \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0438\u0437 \u043a\u043e\u0448\u0435\u043b\u044c\u043a\u0430 \u0445\u0435\u0448 (TxID, ID \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438) \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u0432 \u044d\u0442\u043e\u0442 \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442 \u2014 \u0441\u0443\u043c\u043c\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u0430 \u0432 \u0441\u0435\u0442\u0438 TRON \u0438 \u0437\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0430. \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0435 \u043e\u043f\u043b\u0430\u0442\u044b (\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0445\u0435\u0448\u0435\u0439 \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430).",
        "operationId": "verify_payment",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "\u041e\u0431\u043d\u043e\u0432\u043b\u0451\u043d\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 (partial \u0438\u043b\u0438 confirmed), \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 remaining_amount"
          },
          "400": {
            "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0438\u043b\u0438 \u0432\u0430\u043b\u044e\u0442\u0430 \u043d\u0435 USDT TRC20."
          },
          "401": {
            "description": "\u041d\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 X-API-Key."
          },
          "403": {
            "description": "\u041d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443."
          },
          "404": {
            "description": "\u0417\u0430\u043a\u0430\u0437 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
          },
          "422": {
            "description": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "429": {
            "description": "\u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d rate limit."
          },
          "503": {
            "description": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "\u041a\u043b\u044e\u0447 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438 (\u0432\u044b\u0434\u0430\u0451\u0442\u0441\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c \u043f\u0440\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438). \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u0435\u043d \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 \u043a \u043f\u043b\u0430\u0442\u0435\u0436\u0430\u043c."
      }
    },
    "schemas": {
      "Currency": {
        "type": "string",
        "enum": [
          "BTC",
          "LTC",
          "TRX",
          "USDT_TRC20"
        ],
        "description": "\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u0430\u043b\u044e\u0442\u044b"
      },
      "PaymentCreateRequest": {
        "type": "object",
        "required": [
          "store_number",
          "order_id",
          "amount",
          "currency"
        ],
        "properties": {
          "store_number": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 99999,
            "description": "\u0412 \u0430\u0434\u043c\u0438\u043d\u043a\u0435 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f, \u043a\u0443\u0434\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0432\u0432\u043e\u0434\u0438\u0442 \u044d\u0442\u043e\u0442 \u043d\u043e\u043c\u0435\u0440. \u041d\u043e\u043c\u0435\u0440 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0432 @CryptoN_pay_bot (\u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u00abID \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430\u00bb). 5-\u0437\u043d\u0430\u0447\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e (10000\u201399999)."
          },
          "order_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435"
          },
          "amount": {
            "type": "string",
            "description": "\u0421\u0443\u043c\u043c\u0430 \u0434\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u044b (\u0441\u0442\u0440\u043e\u043a\u0430, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \"0.001\")"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "description": "\u0422\u0435\u043b\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0442\u0435\u0436\u0430"
      },
      "PaymentCreateResponse": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "\u0410\u0434\u0440\u0435\u0441 \u0434\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u044b"
          },
          "amount": {
            "type": "string",
            "description": "\u0421\u0443\u043c\u043c\u0430"
          },
          "order_id": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        },
        "description": "\u041e\u0442\u0432\u0435\u0442: \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0439\u0442\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0443 address \u0438 amount"
      },
      "PaymentVerifyRequest": {
        "type": "object",
        "required": [
          "tx_hash"
        ],
        "properties": {
          "tx_hash": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100,
            "description": "\u0425\u0435\u0448 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 (TxID) \u0432 \u0441\u0435\u0442\u0438 TRON"
          }
        },
        "description": "\u0422\u0435\u043b\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 (\u0442\u043e\u043b\u044c\u043a\u043e USDT TRC20)"
      },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "loc": {
            "type": "array"
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "APIKeyHeader": []
    }
  ]
}