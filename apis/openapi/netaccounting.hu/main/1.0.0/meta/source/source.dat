{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://teszt.netaccounting.hu/sending",
      "description": "Test server"
    }
  ],
  "info": {
    "version": "1.0.0",
    "title": "Send in APIs",
    "description": "The API list to send in data to NetAccounting system",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/szaklodgozat/testing/1.0.0"
  },
  "paths": {
    "/UploadService": {
      "post": {
        "summary": "Upload one document",
        "description": "You can upload a new document to NetAccounting",
        "operationId": "upload",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "$ref": "#/components/schemas/DocumentType"
            }
          },
          {
            "name": "documentLabel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "note",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successfully uploaded document"
          }
        }
      }
    },
    "/bookInvoiceService/{direction}": {
      "post": {
        "summary": "receive invoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/szamla"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "direction",
            "description": "pass an optional search string for looking up inventory",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/direction"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "search results matching criteria",
            "content": {
              "application/xml": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/szamlavalasz"
                    },
                    {
                      "$ref": "#/components/schemas/szamlabevalasz"
                    },
                    {
                      "$ref": "#/components/schemas/hibakod"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/journalService": {
      "post": {
        "summary": "Create journal entries to given date",
        "description": "You can upload a new document to NetAccounting",
        "parameters": [
          {
            "in": "query",
            "name": "logType",
            "schema": {
              "type": "integer",
              "enum": [
                3,
                4,
                20,
                21,
                26,
                29
              ]
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/journal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successfully booked journal"
          },
          "400": {
            "description": "there is an error in the given json"
          },
          "401": {
            "description": "not authorized"
          }
        }
      }
    },
    "/bank/import": {
      "post": {
        "summary": "Create bank import from give json",
        "description": "You can upload a new bank statement to NetAccounting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/bank"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successfully booked journal"
          },
          "400": {
            "description": "there is an error in the given json"
          },
          "401": {
            "description": "not authorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentType": {
        "type": "string",
        "enum": [
          "Bevétel",
          "Kiadás",
          "Bankkivonat",
          "Vámhatározat",
          "Pénztár",
          "Egyéb"
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "ki",
          "be"
        ]
      },
      "szamlavalasz": {
        "type": "object",
        "properties": {
          "alap": {
            "type": "array",
            "xml": {
              "name": "alap"
            },
            "items": {
              "$ref": "#/components/schemas/alap"
            }
          }
        },
        "xml": {
          "name": "szamlavalasz"
        }
      },
      "szamlabevalasz": {
        "type": "object",
        "properties": {
          "alap": {
            "type": "array",
            "xml": {
              "name": "alap"
            },
            "items": {
              "$ref": "#/components/schemas/alap"
            }
          }
        },
        "xml": {
          "name": "szamlavalasz"
        }
      },
      "hibakod": {
        "type": "object",
        "properties": {
          "iktatoszam": {
            "type": "string"
          }
        },
        "xml": {
          "name": "szamlavalasz"
        }
      },
      "alap": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "szamla ID tag értéke"
          },
          "iktatoszam": {
            "type": "string",
            "description": "Sikeres könyvelés esetén a NetAccounting által generált azonosító"
          }
        },
        "xml": {
          "name": "alap"
        }
      },
      "szamla": {
        "type": "object",
        "description": "Külön elérhető XML dokumentációban leírva az értékek: https://netaccounting.hu/sample/szamlaNA.xml illetvgóe az xsd: https://netaccounting.hu/sample/szamla.xsd"
      },
      "journal": {
        "type": "object",
        "example": {
          "2025-01-02": {
            "0": {
              "costHolder": "",
              "amount": 12000,
              "partnerName": "",
              "rate": 0,
              "costCenter": "",
              "rowNum": 3,
              "description": "",
              "debit": "113",
              "credit": "112",
              "currencyID": 1
            }
          },
          "2025-01-01": {
            "0": {
              "costHolder": "",
              "amount": 12000,
              "partnerName": "",
              "rate": 0,
              "costCenter": "",
              "rowNum": 2,
              "description": "",
              "debit": "113",
              "credit": "112",
              "currencyID": 1
            }
          }
        },
        "description": "the requested date of the journal",
        "properties": {
          "date": {
            "type": "object",
            "description": "incrementing rownum start by 1 by each day",
            "properties": {
              "rownum": {
                "type": "object",
                "required": [
                  "debit",
                  "credit",
                  "amount"
                ],
                "properties": {
                  "debit": {
                    "type": "string",
                    "description": "debit ledger number"
                  },
                  "credit": {
                    "type": "string",
                    "description": "credit ledger number"
                  },
                  "description": {
                    "type": "string",
                    "description": "short description of event"
                  },
                  "rowNum": {
                    "type": "integer",
                    "description": "uniqe incremental number of row for identify if error",
                    "example": 1
                  },
                  "amount": {
                    "type": "number",
                    "description": "should be given in original currency"
                  },
                  "rate": {
                    "type": "number",
                    "description": "if the system calculated rate is not good"
                  },
                  "currencyID": {
                    "type": "integer",
                    "description": "the values can download from https://app.swaggerhub.com/apis-docs/NetAccounting/Reporting/1.0.0#/baseData"
                  },
                  "costCenter": {
                    "type": "string"
                  },
                  "costHolder": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "bank": {
        "type": "object",
        "example": {
          "accountNumber": "12345678-12345678-12345678",
          "items": [
            {
              "id": "abc",
              "date": "2025.01.01",
              "amount": 125.15,
              "comment": "Nettó bér fizetés",
              "original_comment": "Kis Gizella bér",
              "partnerName": "",
              "accountNumber": "",
              "type": 1
            },
            {
              "id": "abc",
              "date": "2025.01.01",
              "amount": 125.15,
              "comment": "Nettó bér fizetés",
              "original_comment": "Kis Gizella bér",
              "partnerName": "",
              "accountNumber": "",
              "type": 1,
              "reference": [
                {
                  "invoiceNumber": "1/2025",
                  "amount": 10.15
                },
                {
                  "invoiceNumber": "2/2025",
                  "amount": 110
                }
              ]
            }
          ]
        },
        "description": "the items must contain the bank lines",
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "The account number of the bank statement"
          },
          "items": {
            "type": "array",
            "description": "each bank row must have one row",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "unique id of each row. The system will check double insertion by this value"
                },
                "date": {
                  "example": "2025.01.01",
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "comment": {
                  "example": "Bér fizetés",
                  "description": "Here can defined a list, what can be a rule base in NetAccounting system",
                  "type": "string"
                },
                "original_comment": {
                  "example": "Kis Gizella bér fizetés",
                  "description": "Here can defined the original comment",
                  "type": "string"
                },
                "partnerName": {
                  "description": "Here can defined the partner name",
                  "type": "string"
                },
                "accountNumber": {
                  "description": "Here can defined the partner account number",
                  "type": "string"
                },
                "type": {
                  "description": "0 - Partner account payment, 1 - payment without partner, 2 - Payment with partner but without invoice, 4 - transfer between accounts",
                  "type": "integer",
                  "enum": [
                    0,
                    1,
                    2,
                    4
                  ]
                },
                "reference": {
                  "type": "array",
                  "description": "here you can define if more invoice is related to one bank payment row",
                  "items": {
                    "type": "object",
                    "properties": {
                      "invoiceNumber": {
                        "type": "string",
                        "description": "the original invoice number"
                      },
                      "amount": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "APIKey"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}
