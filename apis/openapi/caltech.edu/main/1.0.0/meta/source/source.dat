{
  "openapi": "3.0.3",
  "info": {
    "title": "NASA Exoplanet Archive TAP API",
    "description": "The NASA Exoplanet Archive Table Access Protocol (TAP) service provides programmatic access to exoplanet data tables including confirmed planets, stellar properties, photometric data, and discovery metadata. Uses ADQL (Astronomical Data Query Language) for queries.",
    "version": "1.0.0",
    "contact": {
      "name": "NASA Exoplanet Science Institute",
      "url": "https://exoplanetarchive.ipac.caltech.edu"
    },
    "x-jentic-source-url": "https://exoplanetarchive.ipac.caltech.edu/docs/program_interfaces.html",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://exoplanetarchive.ipac.caltech.edu",
      "description": "NASA Exoplanet Archive"
    }
  ],
  "paths": {
    "/TAP/sync": {
      "get": {
        "operationId": "tapSyncQuery",
        "summary": "Execute a synchronous TAP query",
        "description": "Executes an ADQL query synchronously against the Exoplanet Archive database and returns results immediately.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "ADQL query string (e.g., SELECT * FROM ps WHERE disc_year=2022)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "tsv",
                "votable",
                "ipac"
              ],
              "default": "votable"
            }
          },
          {
            "name": "LANG",
            "in": "query",
            "description": "Query language",
            "schema": {
              "type": "string",
              "enum": [
                "ADQL"
              ],
              "default": "ADQL"
            }
          },
          {
            "name": "REQUEST",
            "in": "query",
            "description": "TAP request type",
            "schema": {
              "type": "string",
              "enum": [
                "doQuery"
              ],
              "default": "doQuery"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query results in the requested format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-votable+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query syntax"
          }
        }
      },
      "post": {
        "operationId": "tapSyncQueryPost",
        "summary": "Execute a synchronous TAP query via POST",
        "description": "Executes an ADQL query synchronously using POST, useful for long queries.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "ADQL query string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "tsv",
                      "votable",
                      "ipac"
                    ]
                  },
                  "LANG": {
                    "type": "string",
                    "default": "ADQL"
                  },
                  "REQUEST": {
                    "type": "string",
                    "default": "doQuery"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results"
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/TAP/async": {
      "post": {
        "operationId": "tapAsyncQuery",
        "summary": "Submit an asynchronous TAP query",
        "description": "Submits a long-running ADQL query for asynchronous execution. Returns a job URL to poll for results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "tsv",
                      "votable",
                      "ipac"
                    ]
                  },
                  "LANG": {
                    "type": "string",
                    "default": "ADQL"
                  },
                  "REQUEST": {
                    "type": "string",
                    "default": "doQuery"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Job created, redirect to job URL"
          }
        }
      }
    },
    "/TAP/async/{jobId}": {
      "get": {
        "operationId": "getAsyncJobStatus",
        "summary": "Get status of an asynchronous TAP job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status information"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/TAP/async/{jobId}/results/result": {
      "get": {
        "operationId": "getAsyncJobResults",
        "summary": "Get results of a completed asynchronous TAP job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query results"
          },
          "404": {
            "description": "Job or results not found"
          }
        }
      }
    },
    "/TAP/tables": {
      "get": {
        "operationId": "getTapTables",
        "summary": "List available TAP tables",
        "description": "Returns metadata about all available database tables including column definitions.",
        "responses": {
          "200": {
            "description": "Table metadata in VOTable format"
          }
        }
      }
    },
    "/cgi-bin/nstedAPI/nph-nstedAPI": {
      "get": {
        "operationId": "legacyApiQuery",
        "summary": "Legacy API query (limited tables)",
        "description": "Legacy query interface. Most tables have been migrated to TAP. Only missionstars and mission_exocat tables remain available here.",
        "parameters": [
          {
            "name": "table",
            "in": "query",
            "required": true,
            "description": "Table name (missionstars or mission_exocat)",
            "schema": {
              "type": "string",
              "enum": [
                "missionstars",
                "mission_exocat"
              ]
            }
          },
          {
            "name": "select",
            "in": "query",
            "description": "Comma-separated column names to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "where",
            "in": "query",
            "description": "SQL-like WHERE clause for filtering",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Column to sort by, optionally with desc",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "ipac",
                "json",
                "xml",
                "votable"
              ]
            }
          },
          {
            "name": "ra",
            "in": "query",
            "description": "Right ascension for cone search (degrees)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "dec",
            "in": "query",
            "description": "Declination for cone search (degrees)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Cone search radius",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query results in requested format"
          }
        }
      }
    }
  },
  "security": []
}
