    "schemas": {
      "Frame": {
        "type": "object",
        "description": "A single film frame. Thumbnails and deep links only — never raw image bytes.",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Deep link to this frame on FrameThrower"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri"
          },
          "depthUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Precomputed depth map (Depth-Anything V2), WebP, same pixel dimensions as the frame — feed straight to a depth ControlNet. null when the frame has no map; a stale URL 404s, in which case compute depth locally. Never falls back to the colour image."
          },
          "score": {
            "type": "number",
            "description": "Relevance, when the call was a search"
          },
          "film": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "year": {
                "type": "integer"
              },
              "slug": {
                "type": "string"
              },
              "frameCount": {
                "type": "integer"
              },
              "director": {
                "type": "string"
              },
              "cinematographer": {
                "type": "string"
              }
            }
          },
          "shot_type": {
            "type": "string"
          },
          "lens_character": {
            "type": "string"
          },
          "camera_angle": {
            "type": "string"
          },
          "setting": {
            "type": "string"
          },
          "time_of_day": {
            "type": "string"
          },
          "visual_style": {
            "type": "string"
          },
          "colorPalette": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Dominant colours as hex"
          },
          "colorDescription": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "Stored descriptive prompt for the frame"
          }
        }
      },
      "Error": {
        "type": "object",
