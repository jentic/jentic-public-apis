        "/api/v1/public/brands/{brandSlug}/visibility/overview/": {
            "get": {
                "operationId": "publicVisibilityOverview",
                "description": "One projection per call, selected with `view`:\n\n- `kpis`: visibility score, share of voice, rank, average position and citation share, each with its previous value\n- `trend`: the same headline numbers over time\n- `share_of_voice`: the entity leaderboard, brand and competitors together\n- `platform_matrix`: the same picture split by assistant\n- `prompt_scores`: per tracked prompt, how often the brand is mentioned\n- `citation_gaps`: domains assistants cite for competitors but not for this brand\n- `top_sources`: what assistants cite most in this category\n\nStart at `kpis` and follow the weak number into the view that explains it.\n\nIf `enabled` is false, tracking is off for this brand and every row is empty. That is an absence of measurement, not a score of zero.",
                "summary": "Get AI visibility",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Rows to return, 1-50, default 10."
                    },
                    {
                        "in": "query",
                        "name": "platform",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "chatgpt",
                                "gemini",
                                "google_ai_overview"
                            ]
                        },
                        "description": "Restrict to one assistant. Omit to aggregate across all of them."
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "view",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "citation_gaps",
                                "kpis",
                                "platform_matrix",
                                "prompt_scores",
                                "share_of_voice",
                                "top_sources",
                                "trend"
                            ],
                            "default": "kpis"
                        }
                    },
                    {
                        "in": "query",
                        "name": "window",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "28d",
                                "7d",
                                "90d"
                            ],
                            "default": "28d"
                        },
                        "description": "Rolling window ending today."
                    }
                ],
                "tags": [
                    "Public: Visibility"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicVisibilityOverviewErrorResponse400"
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
                            },
                            "RateLimit-Remaining": {
                                "$ref": "#/components/headers/RateLimit-Remaining"
                            },
                            "RateLimit-Reset": {
                                "$ref": "#/components/headers/RateLimit-Reset"
                            },
                            "RateLimit-Policy": {
                                "$ref": "#/components/headers/RateLimit-Policy"
                            }
                        }
