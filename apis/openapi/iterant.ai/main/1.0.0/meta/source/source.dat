            "PublicPageOpportunityList": {
                "type": "object",
                "description": "The schema for what ``paginated`` builds. Kept beside it deliberately.\n\nA list operation whose ``responses`` named the *item* serializer with\n``many=True`` published a bare array while the runtime returned this object,\nso a generated client broke on its first call. Subclasses add ``items``:\neach operation needs its own named component or the item type is erased.",
                "properties": {
                    "total": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Rows matching the query, before `limit` and `offset`. Null when a `status` filter outran the scan bound and the true count is not knowable. `note` says so."
                    },
                    "offset": {
                        "type": "integer",
                        "description": "Rows skipped. Echoed back so a caller can page without bookkeeping."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Cap actually applied, which may be lower than the one requested."
                    },
                    "note": {
                        "type": "string",
                        "description": "How to narrow, when the cap hid rows. Empty when the response is the whole answer."
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PublicPageOpportunitySummary"
                        }
                    }
                },
                "required": [
                    "items",
                    "limit",
                    "note",
                    "offset",
                    "total"
                ]
            },
            "PublicPageOpportunitySummary": {
                "type": "object",
                "properties": {
                    "ref": {
                        "type": "string",
                        "readOnly": true,
                        "description": "Stable, human-readable handle. Pass it back to the opportunity detail route."
                    },
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "readOnly": true,
                        "description": "Derived display status, folding in the state of any page the opportunity produced."
                    },
                    "intent": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "surface": {
                        "type": "string"
                    },
                    "archetype": {
                        "type": "string",
                        "readOnly": true
                    },
                    "primaryKeyword": {
                        "type": "string"
                    },
                    "priorityScore": {
                        "type": "integer"
                    },
                    "searchVolumeMonthly": {
                        "type": "integer",
                        "nullable": true
                    },
                    "keywordDifficulty": {
                        "type": "integer",
                        "nullable": true
                    },
                    "seoScore": {
                        "type": "integer",
                        "nullable": true
                    },
                    "geoScore": {
                        "type": "integer",
                        "nullable": true
                    },
                    "resultingUrlPath": {
                        "type": "string",
                        "nullable": true,
                        "readOnly": true
                    }
                },
                "required": [
                    "archetype",
                    "geoScore",
                    "id",
                    "intent",
                    "keywordDifficulty",
                    "primaryKeyword",
                    "priorityScore",
                    "ref",
                    "resultingUrlPath",
                    "role",
                    "searchVolumeMonthly",
                    "seoScore",
                    "status",
                    "surface",
                    "title"
                ]
            },
            "PublicPageReport": {
                "type": "object",
                "description": "A page (or brand-wide) report, projected to the requested `metrics`.",
                "properties": {
                    "brandSlug": {
                        "type": "string"
                    },
                    "scope": {
                        "type": "object",
                        "additionalProperties": {}
                    },
                    "window": {
                        "type": "string"
                    },
                    "performance": {
                        "$ref": "#/components/schemas/PublicPerformance"
                    },
                    "traffic": {
                        "$ref": "#/components/schemas/PublicSourceBlock"
                    },
                    "conversions": {
                        "$ref": "#/components/schemas/PublicConversions"
                    },
                    "anatomy": {
                        "$ref": "#/components/schemas/PublicAnatomy"
                    }
                },
                "required": [
                    "brandSlug",
                    "scope",
                    "window"
                ]
            },
            "PublicPageReportErrorResponse400": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/ParseErrorResponse"
                    }
                ],
                "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                        "client_error": "#/components/schemas/ParseErrorResponse"
                    }
                }
            },
            "PublicPageSummary": {
                "type": "object",
                "properties": {
                    "urlPath": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "locales": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PublicPageLocale"
                        },
                        "readOnly": true,
                        "description": "Every language the page serves in and the route it serves at there: the default language first at the page's own urlPath, then one entry per other language of the site the page exists in. A page written in one language alone lists that language at its own urlPath."
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "liveUrl": {
                        "type": "string",
                        "nullable": true,
                        "readOnly": true
                    }
                },
                "required": [
                    "liveUrl",
                    "locales",
                    "status",
                    "title",
                    "updatedAt",
                    "urlPath"
                ]
            },
            "PublicPagesByPathErrorResponse400": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/ParseErrorResponse"
                    }
                ],
                "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                        "client_error": "#/components/schemas/ParseErrorResponse"
                    }
                }
            },
            "PublicPagesListErrorResponse400": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/ParseErrorResponse"
                    }
                ],
                "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                        "client_error": "#/components/schemas/ParseErrorResponse"
                    }
                }
            },
            "PublicPerformance": {
                "type": "object",
                "properties": {
                    "search": {
                        "$ref": "#/components/schemas/PublicSourceBlock"
                    }
                },
                "required": [
                    "search"
                ]
            },
            "PublicSourceBlock": {
                "type": "object",
                "description": "A metric block plus the state that produced it.\n\n``state`` is load-bearing: metrics are null whenever it is not ``ok``, and a\nconsumer that reads that as zero is wrong rather than approximately right.",
                "properties": {
                    "state": {
                        "type": "string",
                        "description": "One of: ok, no_data, unconfigured, error."
                    },
                    "windowDays": {
                        "type": "integer",
                        "nullable": true
                    },
                    "effectiveThrough": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "metrics": {
                        "type": "object",
                        "additionalProperties": {},
                        "nullable": true
                    }
                },
                "required": [
                    "effectiveThrough",
                    "metrics",
                    "state",
                    "windowDays"
                ]
            },
            "PublicVisibilityOverviewErrorResponse400": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/ParseErrorResponse"
                    }
                ],
                "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                        "client_error": "#/components/schemas/ParseErrorResponse"
                    }
                }
            },
            "PublicVisibilityReport": {
                "type": "object",
                "properties": {
                    "brandSlug": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean",
                        "description": "False means tracking is off for this brand: rows are empty because nothing was measured."
                    },
                    "view": {
                        "type": "string"
                    },
                    "windowDays": {
                        "type": "integer"
                    },
                    "startDate": {
                        "type": "string",
                        "nullable": true
                    },
                    "endDate": {
                        "type": "string",
                        "nullable": true
                    },
                    "completedRuns": {
                        "type": "integer"
                    },
                    "platform": {
                        "type": "string"
                    },
                    "rows": {},
                    "note": {
                        "type": "string"
                    }
                },
                "required": [
                    "brandSlug",
                    "completedRuns",
                    "enabled",
                    "endDate",
                    "note",
                    "platform",
                    "rows",
                    "startDate",
                    "view",
                    "windowDays"
                ]
            },
            "ServerErrorEnum": {
                "enum": [
                    "server_error"
                ],
                "type": "string",
                "description": "* `server_error` - Server Error"
            },
            "StatusEnum": {
                "enum": [
                    "running",
                    "succeeded",
                    "failed"
                ],
                "type": "string",
                "description": "* `running` - Running\n* `succeeded` - Succeeded\n* `failed` - Failed"
            },
            "UpgradeRequired": {
                "type": "object",
                "description": "Body of a 403 raised by `require_entitlement`.",
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "Always 'upgrade_required'."
                    },
                    "key": {
                        "type": "string",
                        "description": "Entitlement key that refused, e.g. 'publishing.custom_domain'."
                    },
                    "limit": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The plan's ceiling; null is unlimited."
                    },
                    "used": {
                        "type": "number",
                        "format": "double",
                        "description": "Consumption at the time of the refusal."
                    },
                    "plan": {
                        "$ref": "#/components/schemas/PlanTierEnum"
                    }
                },
                "required": [
                    "key",
                    "limit",
                    "plan",
                    "type",
                    "used"
                ]
            },
            "ValidationErrorEnum": {
                "enum": [
                    "validation_error"
                ],
                "type": "string",
                "description": "* `validation_error` - Validation Error"
            }
        },
        "securitySchemes": {
            "tenantApiKeyAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "headers": {
            "RateLimit-Limit": {
                "description": "Requests allowed per window, for the tightest budget this request drew on.",
                "schema": {
                    "type": "integer"
                }
            },
            "RateLimit-Remaining": {
                "description": "Requests left in the current window.",
                "schema": {
                    "type": "integer"
                }
            },
            "RateLimit-Reset": {
                "description": "Seconds until the budget has room again.",
                "schema": {
                    "type": "integer"
                }
            },
            "RateLimit-Policy": {
                "description": "The budget as `<limit>;w=<window seconds>`, e.g. `600;w=60`.",
                "schema": {
                    "type": "string"
                }
            },
            "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                    "type": "integer"
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://api.iterant.ai",
            "description": "Production server"
        }
    ]
}