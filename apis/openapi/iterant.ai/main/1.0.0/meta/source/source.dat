{
    "openapi": "3.0.3",
    "info": {
        "title": "Iterant Public API",
        "version": "1.0.0",
        "description": "The Iterant public API: read a brand's pages, page opportunities, reports and AI visibility, and start Iterant's agent on a page. Guides: https://iterant.ai/docs/developers/rest-api\n\n**Authentication.** Send `Authorization: Bearer itr_...`, an API key an organization admin mints at Settings > Developers.\n\n**Rate limits.** 600 requests per minute per key, and 30 task starts per minute. Responses carry the IETF `RateLimit-Limit`, `RateLimit-Remaining`, `RateLimit-Reset` and `RateLimit-Policy` fields. A `429` carries `Retry-After` in seconds. Requests without a valid key are limited to 60 per minute per client IP.\n\n**Idempotency.** `POST .../tasks/` takes an `Idempotency-Key` header. For 24 hours, a retry with the same key and body returns the first task instead of starting a second.\n\n**Versioning and deprecation.** The version is in the path: `/api/v1/`. Breaking changes ship under a new version. A deprecated version keeps working for at least 6 months after the announcement, and its responses carry `Deprecation` and `Sunset` headers (RFC 9745, RFC 8594). Nothing is deprecated today. Policy: https://iterant.ai/docs/developers/rest-api#versioning-and-deprecation\n"
    },
    "paths": {
        "/api/v1/public/brands/": {
            "get": {
                "operationId": "publicBrandsList",
                "description": "The brands this credential can read, with their slug, site and how much work is outstanding on each. Call this first when the brand is not already known: every other route takes a `brandSlug`.\n\nAn org-scoped key returns every brand in the organization; a brand-pinned key returns exactly its own.",
                "summary": "List accessible brands",
                "parameters": [
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "string"
                        },
                        "description": "1-100, default 25."
                    },
                    {
                        "in": "query",
                        "name": "offset",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Rows to skip."
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    }
                ],
                "tags": [
                    "Public: Brands"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicBrandsListErrorResponse400"
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
                            },
                            "RateLimit-Remaining": {
                                "$ref": "#/components/headers/RateLimit-Remaining"
                            },
                            "RateLimit-Reset": {
                                "$ref": "#/components/headers/RateLimit-Reset"
                            },
                            "RateLimit-Policy": {
