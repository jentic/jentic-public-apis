            "PublicAgentTask": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "command": {
                        "$ref": "#/components/schemas/CommandEnum"
                    },
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "finishedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "Null while the task is running."
                    },
                    "resultingRoute": {
                        "type": "string",
                        "description": "The route the build produced. Always empty for a \"prompt\" task: a free-form turn has no single route, so its result is the chat thread."
                    },
                    "chatUrl": {
                        "type": "string"
                    },
                    "error": {
                        "type": "string",
                        "description": "Present only when `status` is `failed`."
                    }
                },
                "required": [
                    "chatUrl",
                    "command",
                    "createdAt",
                    "finishedAt",
                    "resultingRoute",
                    "status",
                    "taskId"
                ]
            },
            "PublicAgentTaskCreate": {
                "type": "object",
                "properties": {
                    "command": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/CommandEnum"
                            }
                        ],
                        "description": "\"prompt\" runs a free-form instruction as an autonomous agent turn. \"build_page\" builds one page opportunity.\n\n* `prompt` - Prompt\n* `build_page` - Build page"
                    },
                    "prompt": {
                        "type": "string",
                        "description": "Required when `command` is \"prompt\". The instruction for the agent, in plain language.",
                        "maxLength": 32768
                    },
                    "opportunityRef": {
                        "type": "string",
                        "description": "Required when `command` is \"build_page\". The `ref` of the opportunity to build, from the page-opportunities list.",
                        "maxLength": 200
                    },
                    "callbackUrl": {
                        "type": "string",
                        "description": "Optional https:// endpoint to POST the outcome to when the task settles. Polling `GET /tasks/{taskId}/` remains the authority.",
                        "maxLength": 2000
                    }
                },
                "required": [
                    "command"
                ]
            },
            "PublicAgentTaskCreateCallbackUrlErrorComponent": {
                "type": "object",
                "properties": {
                    "attr": {
                        "enum": [
                            "callback_url"
                        ],
                        "type": "string",
                        "description": "* `callback_url` - callback_url"
                    },
                    "code": {
                        "enum": [
                            "invalid",
                            "max_length",
                            "null",
                            "null_characters_not_allowed",
                            "surrogate_characters_not_allowed"
                        ],
                        "type": "string",
                        "description": "* `invalid` - invalid\n* `max_length` - max_length\n* `null` - null\n* `null_characters_not_allowed` - null_characters_not_allowed\n* `surrogate_characters_not_allowed` - surrogate_characters_not_allowed"
                    },
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "attr",
                    "code",
                    "detail"
                ]
            },
            "PublicAgentTaskCreateCommandErrorComponent": {
