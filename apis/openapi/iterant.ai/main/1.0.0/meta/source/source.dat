        "/api/v1/public/brands/{brandSlug}/reports/pages/": {
            "get": {
                "operationId": "publicPageReport",
                "description": "How a page is performing, projected to the `metrics` you ask for. Each one is a separate upstream read, so ask for what you need:\n\n- `performance`: Search Console clicks/impressions/CTR/position\n- `traffic`: visitor sessions and conversions from the signals mart\n- `conversions`: per-definition conversion counts\n- `anatomy`: which components get clicked and how far visitors scroll\n\nEvery performance block carries a `state`: only `ok` means the numbers are real. `no_data`, `unconfigured` and `error` return null metrics. Report the state, never substitute zero.\n\n`traffic`, `conversions` and `anatomy` are sampling-weighted estimates and honour `window`. `performance` is snapshot-shaped: it reports the window the capture covered, which `window` does not change. Omit `urlPath` for a brand-wide roll-up.\n\nA localized route (`/es/pricing`) reports on its page, the same as the page's own route: `scope.urlPath` names the page, and `traffic` and `anatomy` count the visits to every route the page serves at, in every language.",
                "summary": "Get a page (or brand-wide) report",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "metrics",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Comma-separated projections. Legal values: performance, traffic, conversions, anatomy. Defaults to performance."
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "urlPath",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Page route, localized or not. Omit for a brand-wide roll-up."
                    },
                    {
                        "in": "query",
                        "name": "window",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "28d",
                                "7d",
                                "90d"
                            ],
                            "default": "28d"
                        },
                        "description": "Rolling window ending today."
                    }
                ],
                "tags": [
                    "Public: Reports"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicPageReportErrorResponse400"
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
                            },
                            "RateLimit-Remaining": {
                                "$ref": "#/components/headers/RateLimit-Remaining"
                            },
                            "RateLimit-Reset": {
                                "$ref": "#/components/headers/RateLimit-Reset"
                            },
                            "RateLimit-Policy": {
                                "$ref": "#/components/headers/RateLimit-Policy"
                            }
                        }
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse401"
                                },
                                "examples": {
                                    "AuthenticationFailed": {
                                        "value": {
