                            "required"
                        ],
                        "type": "string",
                        "description": "* `invalid_choice` - invalid_choice\n* `null` - null\n* `required` - required"
                    },
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "attr",
                    "code",
                    "detail"
                ]
