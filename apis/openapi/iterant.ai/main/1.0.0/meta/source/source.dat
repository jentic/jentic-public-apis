            },
            "PublicAdvisoryLink": {
                "type": "object",
                "properties": {
                    "sourceUrl": {
                        "type": "string"
                    },
                    "anchorText": {
                        "type": "string"
                    },
                    "anchorVariants": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
