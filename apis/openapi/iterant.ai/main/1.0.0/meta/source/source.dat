        "/api/v1/public/brands/{brandSlug}/tasks/": {
            "get": {
                "operationId": "publicAgentTasksList",
                "description": "Tasks this brand has run, newest first.\n\nA `build_page` task reports the state of the page build it wraps, so its `status` is always what the opportunity itself says. A task that has been running for more than two hours with no word from the agent is reported as `failed`.",
                "summary": "List agent tasks",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "string"
                        },
                        "description": "1-50, default 20."
                    },
                    {
                        "in": "query",
                        "name": "offset",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Rows to skip."
                    },
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "failed",
                                "running",
                                "succeeded"
                            ]
                        },
                        "description": "Only tasks in this state."
                    }
                ],
                "tags": [
                    "Public: Tasks"
