        "/api/v1/public/brands/{brandSlug}/page-opportunities/": {
            "get": {
                "operationId": "publicPageOpportunitiesList",
                "description": "Pages Iterant thinks are worth building or improving, ranked by priority score.\n\nEach row carries a `ref`: a stable, human-readable handle derived from the title. It is what the detail route takes. Refs are not constructible: use one that came back from here.\n\n`status` is the derived display status, which folds in the state of any page the opportunity produced: `ready`/`enriched`/`discovered` are open work, `drafting`/`drafted`/`publishing` are in flight, `published`/`dismissed`/`superseded` are done.\n\nCapped and paginated; the `note` says how to narrow when rows are hidden. Filtering by `status` walks rows, so it stops after the 500 highest-priority opportunities; past that bound `total` is null rather than a count of what happened to fit inside it.",
                "summary": "List page opportunities",
                "parameters": [
                    {
                        "in": "query",
                        "name": "archetype",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "comparison",
                                "standard"
                            ]
                        }
                    },
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "intent",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "commercial",
                                "informational",
                                "navigational",
                                "transactional"
                            ]
                        }
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "string"
                        },
                        "description": "1-50, default 20."
                    },
                    {
                        "in": "query",
                        "name": "offset",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Rows to skip."
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "role",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pillar",
                                "spoke",
                                "standalone"
                            ]
                        }
                    },
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "backlog",
                                "discovered",
                                "dismissed",
                                "drafted",
                                "drafting",
                                "enriched",
                                "failed_generation",
                                "publish_failed",
                                "published",
                                "publishing",
                                "ready",
                                "republish_pending",
                                "scheduled",
                                "superseded"
                            ]
                        },
                        "description": "Only this display status."
                    },
                    {
                        "in": "query",
                        "name": "surface",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "dual",
                                "geo_primary",
                                "seo_primary"
                            ]
                        }
                    }
                ],
                "tags": [
                    "Public: Opportunities"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicPageOpportunitiesListErrorResponse400"
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
