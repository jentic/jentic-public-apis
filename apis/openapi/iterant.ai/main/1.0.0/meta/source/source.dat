        "/api/v1/public/brands/{brandSlug}/pages/": {
            "get": {
                "operationId": "publicPagesList",
                "description": "Pages with their route, title, status and languages. This is where a `urlPath` comes from: every other page route takes one. The live URL (`liveUrl`) is on the by-path route, and on list rows only with `responseFormat=detailed`.\n\nA page is one route served in every language of the site. `locales` lists each language with the route it serves at there, the default language first at the page's own `urlPath`.\n\nAn archived page has left the site (its file or row is gone) and is listed only with `status=archived`.\n\nCapped and paginated. When the cap bites the response carries a `note` saying how to narrow: filter by `status` or `urlPathPrefix` rather than paging through everything.",
                "summary": "List a brand's pages",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "string"
                        },
                        "description": "1-100, default 20."
                    },
                    {
                        "in": "query",
                        "name": "offset",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Rows to skip."
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "archived",
                                "changed",
                                "draft",
                                "failed_generation",
                                "generating",
                                "polishing",
                                "published",
                                "review_required"
                            ]
                        },
                        "description": "Only pages in this status. Without it, every page but the archived ones."
                    },
                    {
                        "in": "query",
                        "name": "urlPathPrefix",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Only routes starting with this prefix, e.g. \"/blog/\"."
                    }
                ],
                "tags": [
                    "Public: Pages"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
