        "/api/v1/public/brands/{brandSlug}/tasks/{taskId}/": {
            "get": {
                "operationId": "publicAgentTaskDetail",
                "description": "Poll this every 30-60 seconds while a task runs; a typical task settles in about five minutes.\n\n`resultingRoute` is the page a `build_page` task produced. It is always empty for a `prompt` task, even on success: a free-form turn has no single route, and its result is the chat thread at `chatUrl`.\n\n`error` is present only when `status` is `failed`.",
                "summary": "Get an agent task",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "taskId",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
