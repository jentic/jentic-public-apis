        "/api/v1/public/brands/{brandSlug}/pages/by-path/": {
            "get": {
                "operationId": "publicPagesByPath",
                "description": "Full detail for one page: meta, status and publish time.\n\n`urlPath` takes any route the site serves the page at, including a localized one: `/es/pricing` (or `/es/feed/pricing` for a brand on a folder) returns the `/pricing` page with `requestedLocale` set to `es`. `locales` lists every language and its route.\n\n`responseFormat=detailed` adds `outline`, the page's section components in order.",
                "summary": "Get one page by route",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "urlPath",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Page route as returned by the pages list, e.g. \"/pricing\". Always starts with \"/\"."
                    }
                ],
                "tags": [
                    "Public: Pages"
                ],
