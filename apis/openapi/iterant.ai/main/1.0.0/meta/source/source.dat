        "/api/v1/public/brands/{brandSlug}/linking/advisory/": {
            "get": {
                "operationId": "publicLinkingAdvisory",
                "description": "Internal links worth adding *to* a page: which existing pages should link to it, the suggested anchor text, and the passage the link would sit in.\n\n`relevance` is 0-1; below about 0.6 a placement is usually not worth making. An empty `links` array is a real answer: nothing on the site is a good enough source yet.\n\nThese are advisory. This endpoint never edits a page, and Iterant does not place these links itself: the source pages are the customer's own, hand-built ones.\n\n`responseFormat=detailed` adds the anchor variants and the passage excerpt.",
                "summary": "Get internal-linking recommendations",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "urlPath",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Page route as returned by the pages list, e.g. \"/pricing\". Always starts with \"/\"."
                    }
                ],
                "tags": [
                    "Public: Linking"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
