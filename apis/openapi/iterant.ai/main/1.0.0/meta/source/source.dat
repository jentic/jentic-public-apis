        "/api/v1/public/brands/{brandSlug}/overview/": {
            "get": {
                "operationId": "publicBrandOverview",
                "description": "One call that says what state a brand is in: the languages its site serves, page counts by status, the highest-priority open opportunities, topic-coverage gaps, the AI-visibility headline and traffic/conversion rollups.\n\nCheaper and better oriented than fanning out across the other routes, and its `nextActions` field points at what is worth looking at next. Narrow with `sections` when you need only half the picture.\n\nSignals figures are sampling-weighted estimates, not exact counts. Visibility figures are empty, not zero, when the brand has no tracking enabled.",
                "summary": "Get a brand overview",
                "parameters": [
                    {
                        "in": "path",
                        "name": "brandSlug",
                        "schema": {
                            "type": "string",
                            "pattern": "^[^/]+$"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "responseFormat",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "concise",
                                "detailed"
                            ],
                            "default": "concise"
                        },
                        "description": "How much to return. `concise` (the default) omits long-form text: briefs, outlines, evidence, passage excerpts, per-dimension breakdowns. `detailed` includes it and costs several times the tokens."
                    },
                    {
                        "in": "query",
                        "name": "sections",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Comma-separated. Legal values: pages, opportunities, coverage, visibility, signals. Defaults to all five."
                    },
                    {
                        "in": "query",
                        "name": "window",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "28d",
                                "7d",
                                "90d"
                            ],
                            "default": "28d"
                        },
                        "description": "Rolling window ending today."
                    }
                ],
                "tags": [
                    "Public: Brands"
                ],
                "security": [
                    {
                        "tenantApiKeyAuth": []
                    }
                ],
                "responses": {
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicBrandOverviewErrorResponse400"
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
                            },
                            "RateLimit-Remaining": {
                                "$ref": "#/components/headers/RateLimit-Remaining"
                            },
                            "RateLimit-Reset": {
                                "$ref": "#/components/headers/RateLimit-Reset"
                            },
                            "RateLimit-Policy": {
                                "$ref": "#/components/headers/RateLimit-Policy"
                            }
                        }
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse401"
                                },
                                "examples": {
                                    "AuthenticationFailed": {
                                        "value": {
                                            "type": "client_error",
                                            "errors": [
                                                {
                                                    "code": "authentication_failed",
                                                    "detail": "Incorrect authentication credentials.",
                                                    "attr": null
                                                }
                                            ]
                                        }
                                    },
                                    "NotAuthenticated": {
                                        "value": {
                                            "type": "client_error",
                                            "errors": [
                                                {
                                                    "code": "not_authenticated",
                                                    "detail": "Authentication credentials were not provided.",
                                                    "attr": null
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        },
                        "description": "",
                        "headers": {
                            "RateLimit-Limit": {
                                "$ref": "#/components/headers/RateLimit-Limit"
                            },
                            "RateLimit-Remaining": {
                                "$ref": "#/components/headers/RateLimit-Remaining"
                            },
                            "RateLimit-Reset": {
                                "$ref": "#/components/headers/RateLimit-Reset"
                            },
                            "RateLimit-Policy": {
