{
  "openapi": "3.0.3",
  "info": {
    "title": "TVSSCS TMS - ZT INTEGRATION API",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/hashlog-1f5/TVSSCS-ZT_TMS_Integration/1.0.0"
  },
  "servers": [
    {
      "url": "https://app.zingtrack.com/ZingTrak-Backend"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/GenerateAuthKey": {
      "post": {
        "summary": "API for generating a new Authkey",
        "description": "This API generates a new Auth Key for a specified validity time which can be used for calling ZT API's. The security for this API is the Access Token which prefixed.",
        "tags": [
          "TVSSCS -> ZT"
        ],
        "operationId": "generateauthkey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accesstoken": {
                    "type": "string",
                    "example": "CSETVSSCS0001"
                  }
                }
              },
              "examples": {
                "GENERATE_AUTHKEY": {
                  "value": {
                    "accesstoken": "CSETVSSCS0001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful authkey generation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authkey": {
                      "type": "string",
                      "example": "ssddddffdsfsd234"
                    },
                    "validity": {
                      "type": "string",
                      "example": "2050:01:01 10:00:00"
                    },
                    "responseCode": {
                      "type": "number",
                      "example": 200
                    }
                  }
                },
                "examples": {
                  "Response": {
                    "value": {
                      "authkey": "ssddddffdsfsd234",
                      "validity": "2050:01:01 10:00:00",
                      "responseCode": 200
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Invalid access token"
          }
        }
      }
    },
    "/ValidateVehicle": {
      "post": {
        "summary": "API for validating the given Vehicle",
        "description": "The API takes the Project/Customer ID and the vehicle as input and confirms if the vehicle is on-boarded in ZT or not for the given project.",
        "tags": [
          "TVSSCS -> ZT"
        ],
        "operationId": "validateVehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectid": {
                    "description": "Pre-agreed unique ID for each onboarded Project. Eg. Hero, TVSMotors etc.",
                    "type": "number",
                    "example": 500
                  },
                  "vehiclenumber": {
                    "type": "string",
                    "example": "TN09AP1234"
                  }
                }
              },
              "examples": {
                "VALIDATE_VEHICLE": {
                  "value": {
                    "projectid": 365,
                    "vehiclenumber": "TN09AP1234"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid Vehicle",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "responseCode": {
                      "type": "number",
                      "example": 200
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Authkey Expired"
          },
          "211": {
            "description": "Vehicle Not Available in the Project"
          },
          "212": {
            "description": "Not a Valid Vehicle"
          }
        }
      }
    },
    "/AddTrip": {
      "post": {
        "summary": "API for Vehicle Assignment to Trip/Set of Trips",
        "description": "API will be called to assign a valid vehicle to a new Trip with the given details in the API for further tracking in ZT.",
        "tags": [
          "TVSSCS -> ZT"
        ],
        "operationId": "addtrip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nooftrips": {
                    "description": "Provide the number of trips included in the message for verification.",
                    "type": "number",
                    "example": 10
                  },
                  "triplist": {
                    "description": "List of trips in an array for processing.",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "projectid": {
                          "description": "Pre-agreed unique ID for each onboarded Project. Eg. Hero, TVSMotors etc.",
                          "type": "number",
                          "example": 365
                        },
                        "bookingCode": {
                          "description": "Unique Trip Number/LR Number as generated by TMS for further reference.",
                          "type": "string",
                          "example": "25DUCIGTAB02362"
                        },
                        "vehiclenumber": {
                          "type": "string",
                          "example": "TN01AP1234"
                        },
                        "driver": {
                          "type": "object",
                          "properties": {
                            "driverMobile": {
                              "type": "string",
                              "example": "3434343434"
                            },
                            "driverName": {
                              "type": "string",
                              "example": "adhi"
                            }
                          }
                        },
                        "routecode": {
                          "description": "Pre-agreed route-code within the project. It is an optional field.",
                          "type": "string",
                          "example": "RC01"
                        },
                        "routeinfo": {
                          "description": "Route information. Minimum of two locations should be there. Origin, Destination.",
                          "type": "object",
                          "properties": {
                            "locations": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "locationCode": {
                                    "description": "Pre-agreed unique location cide for the given project. If the location code is new, it will be created. Locations shall be in order of sequence.",
                                    "type": "string",
                                    "example": "LO00504"
                                  },
                                  "locationName": {
                                    "description": "Name of the location as a label.",
                                    "type": "string",
                                    "example": "TVS Motors Hosur"
                                  },
                                  "lat": {
                                    "description": "Geo Location - Latidude",
                                    "type": "number",
                                    "example": 13.3357
                                  },
                                  "long": {
                                    "description": "Geo Location - Longtitude",
                                    "type": "number",
                                    "example": 79.9451
                                  },
                                  "windowtime": {
                                    "description": "Planned Loading/Unloading time within the location for the trip in minutes",
                                    "type": "number",
                                    "example": 60
                                  },
                                  "transittime": {
                                    "description": "Travel time to this location from the Origin station. For origins this value will not be used or set to zero. The value shall be in minutes",
                                    "type": "number",
                                    "example": 300
                                  },
                                  "distance": {
                                    "description": "Distance to this location from origin. For origin this value shall be set to zero. the value is in km's.",
                                    "type": "number",
                                    "example": 100
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip Created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "responseCode": {
                            "type": "number",
                            "example": 200
                          },
                          "projectid": {
                            "description": "Project ID for confirmation",
                            "type": "number",
                            "example": 365
                          },
                          "bookingCode": {
                            "description": "TMS booking code for confirmation.",
                            "type": "string",
                            "example": "2045SDFSDFSDF"
                          },
                          "zttripid": {
                            "description": "ZT Trip ID for technical reference",
                            "type": "number",
                            "example": 1234567
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Authkey Expired"
          },
          "203": {
            "description": "Invalid Message"
          },
          "211": {
            "description": "Vehicle Not Available in the Project"
          },
          "212": {
            "description": "Not a Valid Vehicle"
          },
          "213": {
            "description": "Duplicate Booking Code"
          },
          "214": {
            "description": "Minimum two locations required for trip creation"
          },
          "215": {
            "description": "Invalid Route code"
          },
          "216": {
            "description": "Trip data not matching the No. of trips."
          },
          "300": {
            "description": "Processing Error. Call Admin."
          }
        }
      }
    },
    "/CancelTrip": {
      "post": {
        "summary": "API for cancel/Reject an active trip",
        "description": "The API takes the Project/Customer ID , Booking Code and the vehicle as input and cancels the trip if active after due validations.",
        "tags": [
          "TVSSCS -> ZT"
        ],
        "operationId": "cancelTrip",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectid": {
                    "description": "Pre-agreed unique ID for each onboarded Project. Eg. Hero, TVSMotors etc.",
                    "type": "number",
                    "example": 500
                  },
                  "bookingcode": {
                    "description": "unique booking code provided by TMS",
                    "type": "string",
                    "example": "2025EWRWERDWER"
                  },
                  "vehiclenumber": {
                    "type": "string",
                    "example": "TN09AP1234"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "responseCode": {
                      "type": "number",
                      "example": 200
                    },
                    "projectid": {
                      "description": "Pre-agreed Project code for each customer/project",
                      "type": "number",
                      "example": 500
                    },
                    "bookingcode": {
                      "description": "unique booking code provided by TMS",
                      "type": "string",
                      "example": "2025EWRWERDWER"
                    },
                    "vehiclenumber": {
                      "type": "string",
                      "example": "TN09AP1234"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Authkey Expired"
          },
          "203": {
            "description": "Invalid Message"
          },
          "211": {
            "description": "Vehicle Not Available in the Project"
          },
          "212": {
            "description": "Not a Valid Vehicle"
          },
          "221": {
            "description": "Trip is not active"
          },
          "222": {
            "description": "Invalid Trip"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
