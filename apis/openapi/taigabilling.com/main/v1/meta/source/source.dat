ered during requirements review. Use stable snake_case keys supplied by Taiga.","type":"object"},"place_of_service_code":{"description":"Two-digit CMS place-of-service code for the requested care.","pattern":"^\\d{2}$","type":"string"},"plan_of_care":{"additionalProperties":false,"properties":{"end_date":{"format":"date","type":"string"},"evaluation_date":{"format":"date","type":"string"},"frequency":{"additionalProperties":false,"properties":{"count":{"maximum":31,"minimum":1,"type":"integer"},"period":{"enum":["WEEK","MONTH"],"type":"string"}},"required":["count","period"],"type":"object"},"frequency_notes":{"maxLength":500,"type":"string"},"requested_visits":{"description":"Total visits requested for the plan of care. This is the plan-level request and is never divided or copied across service lines; it is inherited by a service line only when the request has exactly one line with unit_type VISITS and no requested_units.","maximum":10000,"minimum":1,"type":"integer"},"start_date":{"format":"date","type":"string"}},"required":["evaluation_date","start_date","end_date","requested_visits","frequency"],"type":"object","description":"Requested treatment window, visits, frequency, and evaluation date."},"previous_authorization":{"additionalProperties":false,"properties":{"approved_visits":{"maximum":10000,"minimum":1,"type":"integer"},"effective_date":{"format":"date","type":"string"},"expiration_date":{"format":"date","type":"string"},"prior_authorization_number":{"maxLength":200,"type":"string"},"used_visits":{"maximum":10000,"minimum":0,"type":"integer"}},"required":["prior_authorization_number"],"type":"object","nullable":true},"referring_provider":{"additionalProperties":false,"properties":{"contact_name":{"maxLength":200,"type":"string"},"fax":{"type":"string"},"name":{"maxLength":200,"type":"string"},"npi":{"pattern":"^\\d{10}$","type":"string"},"phone":{"type":"string"}},"required":["npi"],"type":"object","nullable":true},"rendering_provider_npi":{"pattern":"^\\d{10}$","type":"string","description":"Rendering therapist NPI. This NPI must be in the partner organization's scope."},"request_type":{"default":"INITIAL","description":"REAUTHORIZATION also requires previous_authorization. INITIAL is used for a new patient, condition, or payer-defined new episode.","enum":["INITIAL","REAUTHORIZATION","MODIFICATION","RETROSPECTIVE"],"type":"string"},"requesting_provider_npi":{"pattern":"^\\d{10}$","type":"string","nullable":true},"service_facility_id":{"type":"string"},"service_lines":{"description":"Requested CPT/HCPCS codes. Procedure-level units and dates are optional when the plan_of_care supplies the visit-level request.","items":{"additionalProperties":false,"properties":{"end_date":{"format":"date","type":"string"},"frequency":{"maxLength":100,"type":"string"},"modifiers":{"default":[],"items":{"pattern":"^[A-Z0-9]{2}$","type":"string"},"maxItems":4,"type":"array"},"place_of_service_code":{"pattern":"^\\d{2}$","type":"string"},"procedure_code":{"pattern":"^[A-Z0-9]{4,7}$","type":"string"},"requested_units":{"description":"Requested quantity for this service line. Optional at intake; payers that authorize per service line require it on every line before submission. Sole exception: a request with exactly one service line whose unit_type is VISITS inherits plan_of_care.requested_visits. With multiple lines the plan total is never divided or copied — missing values result in a NEEDS_INFORMATION status naming the affected procedure codes when the clinic runs its Availity readiness review.","maximum":10000,"minimum":1,"type":"integer"},"start_date":{"format":"date","type":"string"},"unit_type":{"default":"VISITS","description":"Unit of the requested quantity. VISITS and UNITS have verified payer-portal quantity codes; other values are accepted at intake but produce a NEEDS_INFORMATION status when the clinic runs its Availity readiness review before submission.","enum":["VISITS","UNITS","DAYS","PROCEDURES","OTHER"],"type":"string"}},"required":["procedure_code"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"service_type":{"default":"PHYSICAL_THERAPY","enum":["PHYSICAL_THERAPY","OCCUPATIONAL_THERAPY","SPEECH_THERAPY","OTHER"],"type":"string"},"supporting_documents":{"default":[],"description":"Existing uploaded document IDs with semantic types. Upload the file first: POST /images/v1 returns an id, a version and a signed_url; PUT the bytes to that signed_url; then PUT /images/v1/{id}/{version} with status UPLOADED, where the version segment is the current version plus 1 (so 1 for a freshly created image). Use the image id as document_id. Documents are optional at intake; missing payer-required documents produce NEEDS_INFORMATION.","items":{"additionalProperties":false,"properties":{"document_id":{"type":"string"},"document_type":{"enum":["INITIAL_EVALUATION","PLAN_OF_CARE","PHYSICIAN_ORDER","PROGRESS_NOTE","OUTCOME_MEASURE","IEP","IMAGING_REPORT","OPERATIVE_REPORT","OTHER"],"type":"string"},"title":{"maxLength":200,"type":"string"}},"required":["document_id","document_type"],"type":"object"},"maxItems":30,"type":"array"},"test_mode":{"type":"boolean"},"therapy_attestations":{"additionalProperties":false,"properties":{"ordering_provider_approved_plan_of_care":{"type":"boolean"},"ordering_provider_will_be_notified_at_discharge":{"type":"boolean"},"plan_of_care_reviewed_with_patient":{"type":"boolean"},"school_iep_unavailable_reason":{"maxLength":2000,"type":"string"}},"type":"object","default":{}},"urgency":{"default":"ROUTINE","description":"URGENT requires urgency_reason and should only be used when the payer's expedited-review standard is met.","enum":["ROUTINE","URGENT"],"type":"string"},"urgency_reason":{"nullable":true,"type":"string"},"approved_unit_type":{"nullable":true,"type":"string"},"approved_units":{"nullable":true,"type":"integer"},"authorized_service_lines":{"items":{"additionalProperties":false,"properties":{"approved_units":{"maximum":10000,"minimum":1,"type":"in