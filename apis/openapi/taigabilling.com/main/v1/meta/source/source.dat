ng"},"totals":{"nullable":true,"properties":{"base":{"description":"Patient responsibility for the priced base lines, in cents. Null when no line could be priced.","nullable":true,"type":"integer"},"base_plus_add_ons_max":{"description":"Upper bound of the base plus every add-on, in cents.","nullable":true,"type":"integer"},"priced_items":{"type":"integer"},"unpriced_items":{"type":"integer"}},"type":"object"}},"required":["id","object","livemode","status","mode","created_at"],"type":"object"},"PriceCreate":{"description":"Send exactly one of `items` (the codes to price), `appointment` (the codes are predicted from the appointment, and `patient.reference` is required) or `treatments` (price a prediction from the treatments endpoint).","properties":{"appointment":{"properties":{"department":{"maxLength":200,"type":"string"},"location":{"maxLength":200,"type":"string"},"notes":{"maxLength":2000,"type":"string"},"reference":{"maxLength":128,"minLength":1,"pattern":"^(?=.*\\S)[\\x20-\\x7E]+$","type":"string"},"scheduled_for":{"format":"date-time","type":"string"},"specialty":{"maxLength":200,"type":"string"},"type":{"description":"Appointment type as scheduled.","maxLength":200,"type":"string"}},"required":["type"],"type":"object"},"billing_provider_npi":{"pattern":"^\\d{10}$","type":"string"},"insurances":{"description":"Primary first, then an optional secondary.","items":{"properties":{"group_number":{"maxLength":80,"type":"string"},"member_id":{"maxLength":80,"minLength":1,"type":"string"},"payer_id":{"description":"Payer id or exact payer name.","maxLength":64,"minLength":1,"type":"string"},"plan_name":{"maxLength":200,"type":"string"},"state":{"description":"Two-letter US state of the plan.","maxLength":2,"minLength":2,"type":"string"}},"required":["payer_id","member_id","state"],"type":"object"},"maxItems":2,"minItems":1,"type":"array"},"items":{"items":{"properties":{"code":{"pattern":"^[A-Za-z0-9]{5}$","type":"string"},"modifiers":{"default":[],"items":{"pattern":"^[A-Za-z0-9]{2}$","type":"string"},"maxItems":4,"type":"array"}},"required":["code"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"patient":{"properties":{"dob":{"format":"date","type":"string"},"first_name":{"maxLength":100,"minLength":1,"type":"string"},"last_name":{"maxLength":100,"minLength":1,"type":"string"},"reference":{"maxLength":128,"minLength":1,"pattern":"^(?=.*\\S)[\\x20-\\x7E]+$","type":"string","description":"Your patient id. Required with `appointment`."}},"required":["first_name","last_name","dob"],"type":"object"},"provider":{"properties":{"last_name":{"maxLength":100,"minLength":1,"type":"string"},"npi":{"pattern":"^\\d{10}$","type":"string"}},"required":["npi","last_name"],"type":"object"},"service_date":{"format":"date","type":"string"},"treatments":{"properties":{"trt_id":{"description":"A prediction id from the treatments endpoint.","type":"string"}},"required":["trt_id"],"type":"object"}},"required":["billing_provider_npi","patient","insurances","provider"],"type":"object"},"TreatmentPrediction":{"properties":{"candidates":{"description":"Further likely codes, best first.","items":{"properties":{"code":{"pattern":"^[A-Za-z0-9]{5}$","type":"string"},"modifiers":{"items":{"type":"string"},"type":"array"},"probability":{"description":"Likelihood the code is billed. Null on codes committed by your appointment-type configuration; check `selection` before sorting.","maximum":1,"minimum":0,"nullable":true,"type":"number"},"selection":{"description":"`model` (scored) or `route` (committed by configuration).","type":"string"},"treatment_name":{"nullable":true,"type":"string"}},"required":["code","modifiers","probability"],"type":"object"},"type":"array"},"created_at":{"format":"date-time","type":"string"},"id":{"description":"Send as `treatments.trt_id` to price this prediction.","type":"string"},"livemode":{"type":"boolean"},"model_version":{"nullable":true,"type":"string"},"object":{"enum":["treatment_prediction"],"type":"string"},"predicted":{"description":"The codes expected for the visit.","items":{"properties":{"code":{"pattern":"^[A-Za-z0-9]{5}$","type":"string"},"modifiers":{"items":{"type":"string"},"type":"array"},"probability":{"description":"Likelihood the code is billed. Null on codes committed by your appointment-type configuration; check `selection` before sorting.","maximum":1,"minimum":0,"nullable":true,"type":"number"},"selection":{"description":"`model` (scored) or `route` (committed by configuration).","type":"string"},"treatment_name":{"nullable":true,"type":"string"}},"required":["code","modifiers","probability"],"type":"object"},"type":"array"},"selection_mode":{"description":"`model`, `route` or `suppressed`.","nullable":true,"type":"string"}},"required":["id","object","livemode","created_at","predicted","candidates"],"type":"object"},"TreatmentPredictionCreate":{"properties":{"appointment":{"properties":{"department":{"maxLength":200,"type":"string"},"location":{"maxLength":200,"type":"string"},"notes":{"maxLength":2000,"type":"string"},"reference":{"maxLength":128,"minLength":1,"pattern":"^(?=.*\\S)[\\x20-\\x7E]+$","type":"string"},"scheduled_for":{"format":"date-time","type":"string"},"specialty":{"maxLength":200,"type":"string"},"type":{"description":"Appointment type as scheduled.","maxLength":200,"type":"string"}},"required":["type"],"type":"object"},"billing_provider_npi":{"pattern":"^\\d{10}$","type":"string"},"insurance":{"properties":{"group_number":{"maxLength":80,"type":"string"},"member_id":{"maxLength":80,"type":"string"},"payer_id":{"maxLength":64,"type":"string"},"plan_name":{"maxLength":200,"type":"string"}},"type":"object"},"max_candidates":{"description":"Defaults to 5.","maximum":10,"minimum":1,"type":"integer"},"patient":{"properties":{"dob":{"format":"date","type":"string"},"reference":{"maxLength":128,"minLength":1,"pattern":"^(?=.*\\S)[\\x20-\\x7E]+$","type":"string","description":"Your patient id."},"sex":{"enum":["female","male","other","unknown"],"type":"string"},"state":{"maxLength":2,"minLength":2,"type":"string"}},"required":["reference"],"type":"object"},"provider":{"properties":{"npi":{"pattern":"^\\d{10}$","type":"string"},"taxonomy":{"maxLength":30,"type":"string"}},"type":"object"}},"required":["billing_provider_npi","appointment","patient"],"type":"object"},"EligibilityBenefitsInformation":{"additionalProperties":true,"description":"One benefit fact. Payers return many entries per response — the same service type code typically repeats across several entries, each stating a different aspect of the benefit (coverage status, copay, deductible, limitation). Filter by `code` and `serviceTypeCodes` rather than assuming position. Which entries appear, and which optional fields each populates, varies by payer and by the service type code sent on the request.","properties":{"additionalInformation":{"description":"Free-text payer notes. Often carries plan or carve-out detail available nowhere else in the response.","items":{"additionalProperties":true,"properties":{"description":{"type":"string"}},"type":"object"},"type":"array"},"authOrCertIndicator":{"type":"string"},"benefitAmount":{"type":"string","description":"Currency amount, as a string (e.g. `\"350\"`). Applies to the benefit named by `code`."},"benefitPercent":{"type":"string","description":"Percentage, as a decimal string (e.g. `\"0.5\"`). Passed through exactly as the payer sent it — some payers report the patient's share and others the plan-paid share, and the response does not say which. Confirm the polarity per payer rather than assuming."},"benefitQuantity":{"type":"string","description":"A quantity limit on the benefit. Read together with `quantityQualifier` (e.g. `Maximum`, `Visits`) and `timeQualifier` (e.g. `Day`, `Calendar Year`, `Lifetime`) — the quantity is meaningless without both. An out-of-network facility per-day maximum, for example, arrives as a `code: \"F\"` entry with `timeQualifier: \"Day\"`, `quantityQualifier: \"Maximum\"`, `benefitQuantity: \"350\"` and `inPlanNetworkIndicator: \"No\"`."},"benefitsAdditionalInformation":{"additionalProperties":true,"type":"object"},"benefitsDateInformation":{"additionalProperties":true,"type":"object","description":"Dates bounding the benefit, keyed by kind (e.g. `plan`, `benefitBegin`, `benefitEnd`, `eligibilityBegin`)."},"benefitsRelatedEntities":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"benefitsRelatedEntity":{"additionalProperties":true,"type":"object"},"benefitsServiceDelivery":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"code":{"type":"string","description":"Benefit type discriminator, present on every entry. Common values: `1` Active Coverage, `A` Co-Insurance, `B` Co-Payment, `C` Deductible, `F` Limitations, `G` Out of Pocket (Stop Loss), `I` Non-Covered. `name` carries the same value in prose."},"coverageLevel":{"type":"string","description":"e.g. `Individual`, `Family`, `Employee and Spouse`."},"coverageLevelCode":{"type":"string"},"eligibilityAdditionalInformation":{"additionalProperties":true,"type":"object","description":"Place-of-service context for the benefit (e.g. `industry: \"Office\"`, `industryCode: \"11\"`)."},"eligibilityAdditionalInformationList":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"inPlanNetworkIndicator":{"type":"string","description":"`Yes` in-network, `No` out-of-network, `Not Applicable` when the payer does not distinguish. Absent on some entries."},"inPlanNetworkIndicatorCode":{"type":"string"},"insuranceType":{"type":"string"},"insuranceTypeCode":{"type":"string"},"name":{"type":"string"},"planCoverage":{"type":"string"},"quantityQualifier":{"type":"string","description":"What `benefitQuantity` counts, e.g. `Maximum`, `Visits`, `Days`, `Services or Procedures`."},"quantityQualifierCode":{"type":"string"},"serviceTypeCodes":{"items":{"type":"string"},"type":"array","description":"Service type codes this benefit applies to, e.g. `[\"47\", \"50\"]`. An entry may cover several at once."},"serviceTypes":{"items":{"type":"string"},"type":"array","description":"Prose form of `serviceTypeCodes`, e.g. `[\"Hospital\", \"Hospital - Outpatient\"]`."},"timeQualifier":{"type":"string","description":"Period the benefit or limit applies over, e.g. `Day`, `Visit`, `Calendar Year`, `Remaining`, `Lifetime`."},"timeQualifierCode":{"type":"string"}},"title":"EligibilityBenefitsInformation","type":"object"},"EligibilityRawResponse":{"additionalProperties":true,"description":"The clearinghouse response, forwarded rather than reshaped. `benefitsInformation` is the authoritative benefit detail — it is the fully parsed form of the 271 and is strictly richer than `parsed_response`, which omits benefit types it has no slot for (notably `LIMITATION`). Prefer it for anything beyond deductible, out-of-pocket, copay and coinsurance. `x12` carries the raw transaction if you need to go further still. Some values are normalized in transit (e.g. dates are rendered ISO `YYYY-MM-DD` rather than X12 `CCYYMMDD`), so this mirrors the clearinghouse payload in shape and content without being a byte-for-byte copy.","properties":{"benefitsInformation":{"description":"Every benefit fact the payer returned. Empty or absent when the payer returned no benefits.","items":{"$ref":"#/components/schemas/EligibilityBenefitsInformation"},"type":"array"},"controlNumber":{"type":"string"},"dependents":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"eligibilitySearchId":{"type":"string"},"errors":{"description":"Payer-side rejections (e.g. member not found, date of service outside the payer's inquiry window).","items":{"additionalProperties":true,"type":"object"},"type":"array"},"id":{"type":"string"},"meta":{"additionalProperties":true,"type":"object"},"payer":{"additionalProperties":true,"type":"object"},"planDateInformation":{"additionalProperties":true,"type":"object"},"planInformation":{"additionalProperties":true,"type":"object"},"planStatus":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"provider":{"additionalProperties":true,"type":"object"},"reassociationKey":{"type":"string"},"subscriber":{"additionalProperties":true,"type":"object"},"subscriberTraceNumbers":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"tradingPartnerServiceId":{"type":"string"},"x12":{"type":"string","description":"The raw 271 transaction, as received from the payer."}},"title":"EligibilityRawResponse","type":"object"},"EligibilityResponseEnvelope":{"additionalProperties":true,"description":"Eligibility vendor metadata plus the parsed clearinghouse response. Read the benefit detail from this envelope's `response.benefitsInformation`, which is `response.response.benefitsInformation` on the eligibility check.","properties":{"response":{"$ref":"#/components/schemas/EligibilityRawResponse"},"vendor":{"type":"string"},"version":{"type":"integer"}},"required":["response"],"title":"EligibilityResponseEnvelope","type":"object"},"GatewayValidationError":{"description":"A field-level validation failure detected by Taiga before the request was submitted for billing. Correct the listed fields and retry; the request is not retryable as sent.","properties":{"errors":{"items":{"properties":{"expected":{"description":"The value the field must take, when known.","type":"string"},"field":{"description":"The request-body field the failure applies to (e.g. `provider_type`).","type":"string"},"message":{"description":"Human-readable explanation of the failure.","type":"string"},"received":{"description":"The value that was submitted, when known.","type":"string"}},"required":["field","message"],"type":"object"},"type":"array"},"message":{"description":"Summary of why the request was rejected.","type":"string"}},"required":["message","errors"],"type":"object"},"PatientDuplicateConflictErrorBody":{"description":"A patient create that matched an existing patient. `data.potentialDuplicates` lists only patients visible to your organization; an empty list means the identifier is unavailable.","properties":{"data":{"properties":{"potentialDuplicates":{"items":{"properties":{"existingPatientId":{"format":"uuid","type":"string"},"existingPatientMrn":{"type":"string"}},"required":["existingPatientId","existingPatientMrn"],"type":"object"},"type":"array"}},"required":["potentialDuplicates"],"type":"object"},"message":{"type":"string"}},"required":["message","data"],"type":"object"}},"securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer"}}},"servers":[{"url":"https://api.taigabilling.com"}]}