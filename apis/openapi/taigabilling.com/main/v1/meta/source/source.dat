cuments":[{"document_id":"image_xxx","document_type":"OFFICE_NOTES_DX"}]}},"outpatientTherapy":{"description":"An outpatient physical therapy authorization request.","summary":"Outpatient therapy request","value":{"billing_provider_npi":"1234567890","clinical_information":{"body_regions":["knee"],"functional_limitations":["Unable to climb stairs without assistance"],"home_exercise_program":"Daily mobility and strengthening program","laterality":"RIGHT","medical_necessity_rationale":"Skilled therapy is required to restore safe functional mobility.","objective_findings":"Reduced knee range of motion and strength.","onset_date":"2026-07-01","standardized_tests":[{"name":"Lower Extremity Functional Scale","result":"31/80"}],"treatment_goals":["Ascend and descend one flight of stairs safely within six weeks"]},"contact":{"email":"authorizations@example.com","name":"Authorization Team","phone":"2015550123"},"coverage_id":"coverage_xxx","diagnosis_codes":["M25.561"],"external_id":"rehab-auth-123","ordering_provider":{"name":"Ordering Clinician","npi":"2345678901","phone":"2015550139"},"patient_id":"patient_xxx","place_of_service_code":"11","plan_of_care":{"end_date":"2026-09-02","evaluation_date":"2026-07-21","frequency":{"count":2,"period":"WEEK"},"requested_visits":12,"start_date":"2026-07-22"},"rendering_provider_npi":"3456789012","request_type":"INITIAL","service_facility_id":"facility_xxx","service_lines":[{"modifiers":["GP"],"procedure_code":"97110","requested_units":24,"unit_type":"UNITS"},{"modifiers":["GP"],"procedure_code":"97530"}],"service_type":"PHYSICAL_THERAPY","supporting_documents":[{"document_id":"image_evaluation_xxx","document_type":"INITIAL_EVALUATION"},{"document_id":"image_plan_xxx","document_type":"PLAN_OF_CARE"}],"therapy_attestations":{"ordering_provider_approved_plan_of_care":true,"plan_of_care_reviewed_with_patient":true},"urgency":"ROUTINE"}}},"schema":{"$ref":"#/components/schemas/PriorAuthorizationCreate"}}},"required":true},"responses":{"200