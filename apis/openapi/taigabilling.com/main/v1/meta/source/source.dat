{"openapi":"3.0.1","info":{"title":"Taiga Partner API","version":"v1"},"paths":{"/api/billing_notes/v2":{"post":{"operationId":"billingNotes_v2_create","tags":["BillingNotesV2"],"parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/billing-notesv2BillingNote"}}}},"404":{"content":{"application/json":{"schema":{"properties":{"message":{"enum":["Not found"],"type":"string"}},"required":["message"],"type":"object"}}},"description":"The encounter does not exist or is outside your scope."},"422":{"content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/GatewayValidationError"}]}}},"description":"The request failed validation. `encounter_id` is required and must be the UUID of an encounter you can read; Taiga returns a field-level `errors` array naming it. An encounter you cannot read returns 404."}},"summary":"Create billing note","servers":[{"url":"https://api.taigabilling.com"}],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"encounter_id":{"$ref":"#/components/schemas/EncounterId"}},"required":["encounter_id"],"allOf":[{"$ref":"#/components/schemas/billing-notesv2BillingNoteBase"}]}}}}}},"/api/billing_notes/v2/{billing_note_id}":{"delete":{"operationId":"billingNotes_v2_delete","tags":["BillingNotesV2"],"parameters":[{"name":"billing_note_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/billing-notesv2BillingNoteId"}}],"responses":{"204":{"description":""},"400":{"description":"","content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"errorName":{"type":"string","enum":["OrganizationNotAuthorizedError"]},"content":{"$ref":"#/components/schemas/OrganizationNotAuthorizedErrorMessage"}}}]}}}},"403":{"description":"","content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"errorName":{"type":"string","enum":["UnauthorizedErro