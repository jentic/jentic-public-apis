itionalProperties":false,"description":"Caregiver contact, when the member has one.","properties":{"name":{"maxLength":200,"type":"string"},"phone":{"maxLength":30,"type":"string"}},"type":"object"},"ecm_enrollment":{"description":"Whether the member is enrolled in Enhanced Care Management.","type":"boolean"},"service_type":{"enum":["COMMUNITY_SUPPORTS"],"type":"string"},"services":{"description":"One entry per Community Support requested for this member.","items":{"additionalProperties":false,"properties":{"chronic_conditions":{"description":"Nutrition-sensitive chronic condition categories. NONE cannot be combined with a named condition.","items":{"enum":["DIABETES","CONGESTIVE_HEART_FAILURE","STROKE","CHRONIC_LUNG_DISORDERS","HIV","CANCER","GESTATIONAL_DIABETES_OR_HIGH_RISK_PERINATAL","CHRONIC_OR_DISABLING_MENTAL_BEHAVIORAL_HEALTH","OTHER","NONE"],"type":"string"},"minItems":1,"type":"array"},"discharge_or_high_risk":{"description":"Being discharged from a hospital or skilled nursing facility, or at high risk of hospitalization or nursing facility placement.","type":"boolean"},"extensive_care_coordination_needs":{"type":"boolean"},"mtm_types":{"description":"NUTRITION_EDUCATION is an add-on and cannot be the only value.","items":{"enum":["HOME_DELIVERED_MEALS","VOUCHERS","BOX","NUTRITION_EDUCATION"],"type":"string"},"minItems":1,"type":"array"},"service":{"enum":["MEDICALLY_TAILORED_MEALS"],"type":"string"}},"required":["service","chronic_conditions","extensive_care_coordination_needs","discharge_or_high_risk","mtm_types"],"type":"object"},"maxItems":13,"minItems":1,"type":"array"},"supporting_documents":{"description":"Existing uploaded document IDs, typed to the payer's Community Supports attachment kinds. Upload the file first exactly as for a therapy request.","items":{"additionalProperties":false,"properties":{"document_id":{"maxLength":128,"type":"string"},"document_type":{"enum":["OFFICE_NOTES_DX","SN_DISCHARGE_PLAN","SUPPORTING_DOC","DISCHARGE_PAPERWORK",