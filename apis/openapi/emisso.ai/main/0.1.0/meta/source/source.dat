}$","x-emisso-formato":"AAAA-MM-DD"},{"type":"null"}],"description":"Fecha de ingreso del escrito en AAAA-MM-DD."},"referencia":{"anyOf":[{"type":"string","minLength":1,"maxLength":4000},{"type":"null"}],"description":"Referencia del escrito publicada por OJV."},"solicitante":{"anyOf":[{"type":"string","minLength":1,"maxLength":4000},{"type":"null"}],"description":"Solicitante publicado por OJV."},"tipoIngreso":{"anyOf":[{"type":"string","minLength":1,"maxLength":4000},{"type":"null"}],"description":"Tipo de ingreso publicado por OJV."}},"required":["tieneDocumento","tieneAnexos","fechaIngreso","referencia","solicitante","tipoIngreso"],"additionalProperties":false},"description":"Escritos pendientes publicados en la tabla observada."}},"required":["seccion","filas"],"additionalProperties":false},{"type":"object","properties":{"seccion":{"type":"string","const":"remisiones","description":"Tabla laboral de remisiones a Corte."},"filas":{"maxItems":5000,"type":"array","items":{"type":"object","properties":{"rolCorte":{"anyOf":[{"type":"string","minLength":1,"maxLength":4000},{"type":"null"}],"description":"Rol de Corte visible; null cuando solo hay un control sin rol publicado."},"descripcion":{"anyOf":[{"type":"string","minLength":1,"maxLength":4000},{"type":"null"}],"description":"Descripción del trámite de remisión publicada."},"fechaTramite":{"anyOf":[{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","x-emisso-formato":"AAAA-MM-DD"},{"type":"null"}],"description":"Fecha de trámite de la remisión en AAAA-MM-DD."},"tieneReferenciaCorte":{"type":"boolean","description":"Hay un control para consultar la referencia de Corte; no acredita lectura de su expediente."}},"required":["rolCorte","descripcion","fechaTramite","tieneReferenciaCorte"],"additionalProperties":false},"description":"Remisiones publicadas en la tabla observada; no contienen el expediente de Corte."}},"required":["seccion","filas"],"additionalProperties":false}],"description":"Filas observadas en la causa laboral, sin enlaces privados ni IDs inventados."},"filasDesde":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Posición de la primera fila devuelta en esta tabla, comenzando en cero. No es un ID judicial."},"totalFilas":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Filas en la última tabla guardada. Revisa el cursor de la respuesta para continuar la lectura."}},"required":["fuente","contenido","filasDesde","totalFilas"],"additionalProperties":false}},"ambitoHistoria":{"default":null,"description":"Dónde presenta OJV la historia observada. null cuando no hay expediente disponible; causa no acredita un inventario completo de cuadernos.","anyOf":[{"type":"string","enum":["causa","cuadernos"]},{"type":"null"}]},"cursor":{"default":null,"description":"Continuación de las tablas en el mismo corte; null si esta lectura terminó. No acredita cobertura completa de OJV.","anyOf":[{"type":"string","minLength":1,"maxLength":4096,"description":"Cursor opaco de la respuesta anterior. Reenvíalo sin construirlo ni modificarlo."},{"type":"null"}]},"estadoDatos":{"type":"string","enum":["sin_sincronizar","disponibles","incompletos"],"description":"Una lista vacía con sin_sincronizar o incompletos no acredita ausencia de actividad judicial."},"observadoHasta":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","description":"Instante ISO 8601 con zona horaria."},{"type":"null"}],"description":"Corte de observación de los datos persistidos. No es la fecha de la consulta ni la de una resolución."},"cobertura":{"type":"array","items":{"type":"object","properties":{"causaId":{"type":"string","pattern":"^pjc_[a-zA-Z0-9_-]{16,80}$","description":"ID obtenido de pjud.causas.consultar. No es el rol escrito en el portal."},"cuadernoId":{"anyOf":[{"type":"string","pattern":"^pjq_[a-zA-Z0-9_-]{16,80}$","description":"Identificador estable de cuaderno, obtenido de causas.detallar."},{"type":"null"}],"description":"Cuaderno al que corresponde la información; null para una sección de toda la causa."},"seccion":{"type":"string","enum":["cabecera","historia","litigantes","notificaciones","escritos_por_resolver","exhortos","remisiones","documentos","diligencias","liquidacion","materias"],"description":"Sección concreta cuya cobertura se informa."},"estado":{"type":"string","enum":["con_datos","sin_registros","parcial","fallida","no_accesible","no_implementada"],"description":"Solo con_datos y sin_registros acreditan revisión completa de esta sección. Los otros valores indican información pendiente o inaccesible."},"revisadaEn":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","description":"Instante ISO 8601 con zona horaria."},{"type":"null"}],"description":"Instante ISO 8601 de revisión; null si esa sección no se revisó."},"registrosObservados":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}],"description":"Filas observadas en la sección; null significa que no se pudo contar, no cero."},"codigoIncidencia":{"anyOf":[{"type":"string","pattern":"^pjud_[a-z_]+$"},{"type":"null"}],"description":"Código saneado; nunca mensajes, cookies o HTML del proveedor."}},"required":["causaId","cuadernoId","seccion","estado","revisadaEn","registrosObservados","codigoIncidencia"],"additionalProperties":false},"description":"Secciones efectivamente revisadas y sus límites, para las causas de esta consulta."}},"required":["causa","cuadernos","partes","seccionesCiviles","seccionesLaborales","ambitoHistoria","cursor","estadoDatos","observadoHasta","cobertura"],"additionalProperties":false},"pjud__conexion__sincronizar__Input":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"periodo":{"description":"Período de ejecución en AAAA-MM; si se omite, usa el mes actual en Santiago al ejecutar. No filtra la historia de las causas.","type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$"},"alcances":{"default":["expedientes"],"description":"Módulo judicial que se sincroniza en esta llamada.","minItems":1,"maxItems":1,"type":"array","items":{"type":"string","const":"expedientes"}}},"additionalProperties":false},"pjud__conexion__sincronizar__Output":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"periodo":{"type":"string","description":"Período de ejecución en AAAA-MM."},"estado":{"type":"string","enum":["encolado","completado"],"description":"'encolado' = la sincronización quedó en cola y va a empezar enseguida; esta respuesta NO trae datos todavía, y el trabajo se sigue por 'jobId'. 'completado' = la sincronización ya corrió y su resumen por alcance viene en 'results'. Un cliente recibe siempre 'encolado': un sync abre una sesión real contra el sistema externo y puede tardar minutos, así que no se te hace esperar por él."},"jobId":{"description":"El identificador de la sincronización encolada. Por la API REST, el avance se consulta en 'GET /v1/syncs/{jobId}'; por MCP, búscalo en 'trabajos' de 'conexiones.estado.consultar' y revisa 'datosListos' ahí mismo. Es el mismo id que viaja en el webhook 'sync.succeeded' o 'sync.failed' si tu plan los incluye. Es null cuando 'estado' es 'completado', porque ahí el resultado ya está en la respuesta, y cuando 'yaEnCurso' es true y esa sincronización ya está corriendo.","anyOf":[{"type":"string"},{"type":"null"}]},"yaEnCurso":{"description":"'true' significa que ya había una sincronización viva para esa conexión y ese período, así que no se creó otra. No es un error ni un rechazo. Si esa sincronización sigue en cola, 'jobId' es el suyo; si ya está corriendo, 'jobId' llega null y su avance se ve en 'trabajos' de 'conexiones.estado.consultar'. Cubre el período, no necesariamente los alcances que pediste: si pediste otros, vuelve a pedirlos cuando termine. Ojo con el otro lado: 'false' NO garantiza que la hayas creado tú: dos llamadas a la vez pueden recibir las dos 'false' y el MISMO 'jobId'. Lo que sí vale siempre es que hay una sola sincronización activa por conexión y período.","type":"boolean"},"results":{"description":"El resumen por alcance, una fila por alcance sincronizado. AUSENTE cuando 'estado' es 'encolado': el trabajo todavía no corrió. Ausente no es lo mismo que vacío: un arreglo vacío significaría que se miró y no había nada.","type":"array","items":{"type":"object","properties":{"alcance":{"type":"string","const":"expedientes","description":"Módulo de expedientes judiciales."},"status":{"type":"string","enum":["ok","partial"],"description":"Partial indica que se guardaron avances con cobertura pendiente; no equivale a una revisión completa."},"recordsSynced":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Registros entregados a persistencia por esta ejecución; no es el total histórico de la conexión."},"causasRevisadas":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Causas con una observación recuperada, aun cuando alguna sección quedó pendiente."},"causasPendientes":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Causas elegidas cuya lectura no pudo completarse en esta ejecución."},"documentosDescargados":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Originales recuperados e incluidos en el guardado de esta ejecución."},"detalle":{"type":"string","description":"Explicación de la cobertura o de una cartera sin selección."}},"required":["alcance","status","recordsSynced","causasRevisadas","causasPendientes","documentosDescargados","detalle"],"additionalProperties":false}}},"required":["periodo","estado"],"additionalProperties":false},"pjud__conexion__verificar__Input":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{},"additionalProperties":false},"pjud__conexion__verificar__Output":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"verificadoEn":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$","description":"Instante ISO 8601 en que se comprobó la identidad del titular."}},"required":["verificadoEn"],"additionalProperties":false},"pjud__documentos__consultar__Input":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"causaId":{"type":"string","pattern":"^pjc_[a-zA-Z0-9_-]{16,80}$","description":"ID obtenido de pjud.causas.consultar. No es el rol escrito en el portal."},"cuadernoId":{"type":"string","pattern":"^pjq_[a-zA-Z0-9_-]{16,80}$","description":"Identificador estable de cuaderno, obtenido de causas.detallar."},"actuacionId":{"type":"string","pattern":"^pja_[a-zA-Z0-9_-]{16,80}$","description":"Identificador estable de actuación dentro de su causa y ámbito de historia."},"busqueda":{"type":"string","minLength":1,"maxLength":200,"description":"Texto de búsqueda entre los datos persistidos de la conexión."},"clase":{"type":"string","enum":["principal","certificado_envio","anexo","ebook","sin_clasificar"],"description":"Clase documental identificada desde la referencia de OJV."},"desde":{"description":"Día inicial del rango en AAAA-MM-DD, inclusive.","type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","x-emisso-formato":"AAAA-MM-DD"},"hasta":{"description":"Día final del rango en AAAA-MM-DD, inclusive.","type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","x-emisso-formato":"AAAA-MM-DD"},"cursor":{"type":"string","minLength":1,"maxLength":4096,"description":"Cursor opaco de la respuesta anterior. Reenvíalo sin construirlo ni modificarlo."},"limit":{"default":50,"description":"Máximo de filas por página; conserva el cursor para continuar en el mismo corte.","type":"integer","minimum":1,"maximum":100}},"required":["causaId"],"additionalProperties":false},"pjud__documentos__consultar__Output":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"documentos":{"type":"array","items":{"type":"object","properties":{"documentoId":{"type":"string","pattern":"^pjd_[a-zA-Z0-9_-]{16,80}$","description":"ID obtenido de pjud.documentos.consultar; nunca un enlace ni un token de OJV."},"causaId":{"type":"string","pattern":"^pjc_[a-zA-Z0-9_-]{16,80}$","description":"ID obtenido de pjud.causas.consultar. No es el rol escrito en el portal."},"cuadernoId":{"anyOf":[{"type":"string","pattern":"^pjq_[a-zA-Z0-9_-]{16,80}$","description":"Identificador estable de cuaderno, obtenido de causas.detallar."},{"type":"null"}],"description":"Cuaderno al que corresponde la información; null para una sección de toda la causa."},"actuacionId":{"anyOf":[{"type":"string","pattern":"^pja_[a-zA-Z0-9_-]{16,80}$","description":"Identificador estable de actuación dentro de su causa y ámbito de historia."},{"type":"null"}],"description":"Actuación asociada; null para información de toda la causa."},"descripcion":{"type":"string","description":"Descripción de la pieza o cambio observado."},"tipoFuente":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Tipo de pieza o trámite informado por la fuente."},"folioFuente":{"description":"Folio del documento en su listado de origen, distinto del folio de la actuación.","type":"string","minLength":1,"maxLength":100},"anexoObservado":{"description":"Solo para anexos civiles sin folio publicado. Los bytes diferentes se conservan separados y la cobertura del listado permanece parcial.","type":"object","properties":{"identidad":{"type":"string","const":"contenido_en_ambito","description":"Identifica este archivo por sus bytes y su causa o actuación. No identifica un documento judicial ni relaciona archivos diferentes como versiones."},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$","description":"Huella inmutable del archivo observado, incluso si después se restringe su acceso."},"referencias":{"minItems":1,"maxItems":5000,"type":"array","items":{"type":"object","properties":{"fecha":{"anyOf":[{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","x-emisso-formato":"AAAA-MM-DD"},{"type":"null"}],"description":"Fecha publicada junto a la referencia del anexo; null cuando no se informa."},"descripcion":{"type":"string","minLength":1,"maxLength":4000,"description":"Referencia literal publicada por OJV para el archivo observado; no es un folio ni establece identidad judicial."}},"required":["fecha","descripcion"],"additionalProperties":false},"description":"Referencias del listado que apuntaban a estos mismos bytes en el mismo ámbito. Se conservan repeticiones; no implican identidad judicial."}},"required":["identidad","sha256","referencias"],"additionalProperties":false},"clase":{"type":"string","enum":["principal","certificado_envio","anexo","ebook","sin_clasificar"],"description":"Clase documental identificada desde la referencia de OJV."},"fechaFuente":{"anyOf":[{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","x-emisso-formato":"AAAA-MM-DD"},{"type":"null"}],"description":"Día de fuente asociado a la pieza o al cambio en AAAA-MM-DD; null si no está disponible."},"descarga":{"type":"string","enum":["referenciado","descargado","fallido","no_accesible"],"description":"Descargado confirma bytes originales guardados; referenciado so