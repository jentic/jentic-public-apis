    "/v2/annotations": {
      "get": {
        "operationId": "listAnnotations",
        "summary": "List Annotations",
        "description": "Lists the annotations in your Confident AI project one page at a time, newest first by default. Filter by the trace, span or thread they were left on, by rating scale, and by time window.",
        "tags": [
          "annotations"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page of annotations to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of annotations per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Returns only annotations left at or after this ISO 8601 datetime. Defaults to 60 days ago.",
            "example": "2025-01-01T00:00:00Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "Returns only annotations left before this ISO 8601 datetime. Defaults to the current time.",
            "example": "2025-01-31T23:59:59Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "This determines the field to sort by. Defaults to `createdAt`.",
            "schema": {
              "$ref": "#/components/schemas/AnnotationSortBy",
              "default": "createdAt"
            }
          },
          {
            "name": "ascending",
            "in": "query",
            "required": false,
            "description": "This determines if the field specified in `sortBy` should be in ascending order. Defaults to `false`, which returns the newest annotations first.",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "traceUuid",
            "in": "query",
            "required": false,
            "description": "Returns only annotations left on this trace.",
            "example": "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "spanUuid",
            "in": "query",
            "required": false,
            "description": "Returns only annotations left on this span.",
            "example": "9d2c6f7e-1a3b-4c5d-8e9f-0a1b2c3d4e5f",
