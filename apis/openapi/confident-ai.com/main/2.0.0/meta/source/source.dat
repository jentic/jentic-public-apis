            "description": "How many consecutive days the project has gone with no failing control.",
            "example": 12
          },
          "lastAssessedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When this project was most recently assessed, or `null` when it has never been assessed within the health window.",
            "example": "2025-01-15T02:00:00.000Z"
          }
        },
        "required": [
          "checksTotal",
          "checksRun",
          "checksFailing",
          "streakDays",
          "lastAssessedAt"
        ],
        "description": "The check counts behind a project's governance status. `checksRun` is the denominator of its pass rate, so a project with controls that have never run reports a `checksTotal` above its `checksRun`.",
        "title": "Governance Project Health"
      },
      "GovernanceProjectList": {
