            "schema": {
              "type": "string"
            }
          },
          {
            "name": "policyId",
            "in": "path",
            "required": true,
            "description": "The id of the project policy.",
            "example": "<POLICY-ID>",
            "schema": {
              "type": "string"
            }
          }
