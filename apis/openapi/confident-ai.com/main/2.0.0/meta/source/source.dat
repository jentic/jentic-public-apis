    "/v2/organization/invitations/{invitationId}": {
      "put": {
        "operationId": "resendInvitation",
        "summary": "Resend Organization Invitation",
        "description": "Emails the invitation again and returns it, resetting it in the process: the status goes back to `PENDING`, a fresh token is issued, and any link sent earlier stops working. That reset is what revives an invitation the invitee declined. An invitation that was already accepted is reset the same way, mailing the member a link they no longer need without touching the access they have — revoke the invitation or remove the member instead if that is what you meant.",
        "tags": [
          "organization"
        ],
        "parameters": [
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "description": "The id of the organization invitation.",
            "example": 42,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resend Organization Invitation succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/OrganizationInvitation"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "operationId": "deleteInvitation",
        "summary": "Revoke Organization Invitation",
        "description": "Deletes the invitation, whatever its status, so its link can no longer be accepted. Only the invitation goes: an invitee who already accepted keeps their organization membership, so revoke access by removing them from the members instead. This cannot be undone — invite the address again to issue a new invitation with a new token.",
        "tags": [
          "organization"
        ],
        "parameters": [
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "description": "The id of the organization invitation.",
            "example": 42,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoke Organization Invitation succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/InvitationRef"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
