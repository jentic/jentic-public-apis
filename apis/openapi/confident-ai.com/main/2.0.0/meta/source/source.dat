    "/v2/projects/{projectId}/invitations/{invitationId}": {
      "put": {
        "operationId": "resendProjectInvitation",
        "summary": "Resend Project Invitation",
        "description": "Emails the project invitation again and returns it, resetting it in the process: the status goes back to `PENDING`, a fresh token is issued, and any link sent earlier stops working. That reset is what revives an invitation the invitee declined. An invitation that was already accepted is reset the same way, mailing the member a link they no longer need without touching the access they have — revoke the invitation or remove the member instead if that is what you meant.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The id of the project, which must belong to your organization.",
            "example": "<PROJECT-ID>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "description": "The id of the project invitation.",
            "example": 42,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resend Project Invitation succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ProjectInvitation"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
