            "description": "The project's verdict history over the last 30 days, newest first. Several assessments of the same control on the same day are collapsed to the last one, so each control appears at most once per day however often it was recomputed."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner",
          "governancePolicy",
          "controls",
          "assessments"
        ],
        "description": "A project's governance view in full: the controls its policy applies and the verdict history behind its status. Only an enrolled project has this view — a project belonging to no governance policy has nothing to assess and is reported as not found.",
        "title": "Governance Project"
      },
      "GovernanceProjectControl": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the governance control.",
            "example": "<GOVERNANCE-CONTROL-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the governance control.",
            "example": "Groundedness above 0.9"
          },
          "description": {
            "type": [
