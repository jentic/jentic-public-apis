    "/v2/spans": {
      "get": {
        "operationId": "listSpans",
        "summary": "List Spans",
        "description": "Lists the spans in your Confident AI project one page at a time, newest first by default, as summary rows. Retrieve a span by id for its full detail.",
        "tags": [
          "spans"
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of results per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "This is used for pagination, and should be set to the `nextCursor` value returned in the previous response to get the next page of results.",
            "example": "<NEXT-CURSOR>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "This filters for results created at or after the specified start datetime, in ISO 8601 format. Defaults to 60 days ago.",
            "example": "2025-01-01T00:00:00Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "This filters for results created before the specified end datetime, in ISO 8601 format. Defaults to the current time.",
            "example": "2025-01-31T23:59:59Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "ascending",
            "in": "query",
            "required": false,
            "description": "This determines if the field specified in `sortBy` should be in ascending order. Defaults to `false`, which returns the newest results first.",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "This determines the field to sort by. Defaults to `createdAt`.",
            "schema": {
              "$ref": "#/components/schemas/SpanSortBy",
              "default": "createdAt"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "This filters the spans by the environment where their trace was created, and returns spans from all environments if not specified.",
            "schema": {
              "$ref": "#/components/schemas/Environment"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter by the specific type of span.",
            "schema": {
              "$ref": "#/components/schemas/SpanType"
            }
          },
          {
            "name": "traceUuid",
            "in": "query",
            "required": false,
            "description": "Filter spans that belong to the trace with this uuid.",
            "example": "<TRACE-UUID>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Filter spans by their exact name.",
            "example": "OpenAI Call",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hasError",
            "in": "query",
            "required": false,
            "description": "Filter for spans that either failed (`true`) or succeeded (`false`).",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Filter LLM spans by the model used.",
            "example": "gpt-4o",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promptAlias",
            "in": "query",
            "required": false,
            "description": "This filters the spans by the prompt alias used.",
            "example": "geography-assistant",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promptVersion",
            "in": "query",
            "required": false,
            "description": "This filters the spans by the prompt version used.",
            "example": "00.00.01",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promptLabel",
            "in": "query",
            "required": false,
            "description": "This filters the spans by the prompt label used.",
            "example": "production",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promptCommitHash",
            "in": "query",
            "required": false,
            "description": "This filters the spans by the exact prompt commit hash used.",
            "example": "bab04ce",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "embedder",
            "in": "query",
            "required": false,
            "description": "Filter retriever spans by the embedder model used.",
            "example": "text-embedding-3-small",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topK",
            "in": "query",
            "required": false,
            "description": "Filter retriever spans by the `topK` value.",
            "example": 3,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "chunkSize",
            "in": "query",
            "required": false,
            "description": "Filter retriever spans by the chunk size.",
            "example": 512,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Spans succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
