    "/v2/organization/roles/{roleId}": {
      "put": {
        "operationId": "updateOrganizationRole",
        "summary": "Update Organization Role",
        "description": "Replaces a custom organization role's name, description, and attached policies. Every member holding the role is affected immediately, since permissions are resolved on each request. A global, system-defined role responds `404`.",
