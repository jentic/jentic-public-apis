    "/v2/projects/{projectId}/policies/{policyId}": {
      "put": {
        "operationId": "updateProjectPolicy",
        "summary": "Update Project Policy",
        "description": "Replaces a project policy's name, description, and granted permissions. The change reaches people through the roles the policy is attached to, and it reaches them immediately: every member holding any of those roles gains or loses the affected permissions on their next call.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The id of the project the policy belongs to.",
