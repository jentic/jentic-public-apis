    "/v2/transformers/{transformerId}/test-code": {
      "post": {
        "operationId": "testTransformerCode",
        "summary": "Test Transformer Code",
        "description": "Runs the transformer's stored code against a sample value and returns what it produced. Code that raises or times out is a completed test, so it comes back with a `200` and `success: false` carrying `error` and `reason` — branch on `success` rather than on the status. A `400` means the transformer has no code saved to run.",
        "tags": [
          "transformers"
        ],
        "parameters": [
          {
            "name": "transformerId",
            "in": "path",
            "required": true,
            "description": "The id of the transformer.",
            "example": "<TRANSFORMER-ID>",
