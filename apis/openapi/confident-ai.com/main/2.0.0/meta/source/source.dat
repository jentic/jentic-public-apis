    "/v2/organization/invitations": {
      "get": {
        "operationId": "listInvitations",
        "summary": "List Organization Invitations",
        "description": "Lists the invitations to your organization that are still outstanding — those the invitee has not answered, and those they declined. An invitation disappears from this list once it is accepted or revoked. Invitations do not expire on their own, so a pending one stays acceptable until it is revoked or resent. Every entry carries the token from the invitee's invite link, so treat the response as sensitive.",
        "tags": [
          "organization"
        ],
        "responses": {
          "200": {
            "description": "List Organization Invitations succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
