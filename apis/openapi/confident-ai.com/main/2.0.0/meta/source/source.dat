      "delete": {
        "operationId": "deleteReportTemplate",
        "summary": "Delete Report Template",
        "description": "Permanently deletes a report template and the schedule that generates it. This cannot be undone, and every report it generated becomes unreachable — set `enabled` to `false` instead to pause generation while keeping past reports readable.",
        "tags": [
          "report-templates"
