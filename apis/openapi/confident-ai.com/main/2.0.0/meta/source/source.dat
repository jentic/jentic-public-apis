      "ReportContentSectionInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CONTENT"
            ],
            "description": "Always `CONTENT`.",
            "example": "CONTENT"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The heading rendered above the section. Omit it for an unheaded section.",
            "example": "Overview"
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report. Defaults to `false`.",
            "example": false
          },
          "content": {
            "$ref": "#/components/schemas/ReportNarrativeContent"
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false,
        "description": "A section of prose.",
        "title": "Content Section"
      },
      "ReportDateRange": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date-time",
            "description": "The start of the window, as an ISO 8601 datetime.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "description": "The end of the window, as an ISO 8601 datetime.",
            "example": "2025-01-08T00:00:00.000Z"
          }
        },
        "required": [
          "startDate",
          "endDate"
        ],
        "additionalProperties": false,
        "description": "The window a report describes, shown in its header.",
        "title": "Report Date Range"
      },
      "ReportGraphConfigContent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "config"
            ],
            "description": "Always `config`.",
            "example": "config"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Which data source resolves the query.",
            "example": "aggregate"
          },
          "title": {
            "type": "string",
            "description": "The chart title.",
            "example": "Daily trace error rate"
          },
          "dataModel": {
            "type": "string",
            "description": "The data model queried, such as `TRACE`, `SPAN` or `METRIC_DATA`.",
            "example": "TRACE"
          },
          "metric": {
            "type": "string",
            "description": "The aggregate plotted, such as `error_rate` or `total_cost`.",
            "example": "error_rate"
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ],
            "description": "The property the metric is split by, giving one line per value. Null for a plain trend over time.",
            "example": null
          },
          "granularity": {
            "type": [
              "string",
              "null"
            ],
            "description": "The time bucket, such as `hour`, `day`, `week` or `month`.",
            "example": "day"
          },
          "spanType": {
            "type": [
              "string",
              "null"
            ],
            "description": "The span type queried, for `SPAN` charts only.",
            "example": null
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "The start of the queried window as an ISO 8601 datetime, pinning the chart to a point in time.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "The end of the queried window as an ISO 8601 datetime.",
            "example": "2025-01-08T00:00:00.000Z"
          },
          "sources": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reader-facing labels for the data this section draws on, rendered beneath it. Omit them unless you want the section to cite where its numbers came from.",
            "example": [
              "Traces, 1-8 Jan 2025"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "dataModel",
          "metric"
        ],
        "description": "The content of a `GRAPH` section that Confident AI generated as a live query rather than a snapshot. It carries no data of its own: the query is run against your project when the report is rendered. Read-only — a chart you write yourself is always a snapshot.",
        "title": "Graph Config Content"
      },
      "ReportGraphContent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "snapshot"
            ],
            "description": "Always `snapshot`.",
            "example": "snapshot"
          },
          "graphType": {
            "$ref": "#/components/schemas/ReportGraphType"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The x-axis labels. At least one is required.",
            "example": [
              "2025-01-06",
              "2025-01-07",
              "2025-01-08"
            ]
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportGraphSeries"
            },
            "minItems": 1,
            "description": "One entry per plotted line. Every series' `values` must be the same length as `categories`."
          },
          "xAxisLabel": {
            "type": [
              "string",
              "null"
            ],
            "description": "A label for the x-axis.",
            "example": "Day"
          },
          "yAxisLabel": {
            "type": [
              "string",
              "null"
            ],
            "description": "A label for the y-axis.",
            "example": "Errored traces / total traces"
          },
          "sources": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reader-facing labels for the data this section draws on, rendered beneath it. Omit them unless you want the section to cite where its numbers came from.",
            "example": [
              "Traces, 1-8 Jan 2025"
            ]
          }
        },
        "required": [
          "type",
          "graphType",
          "categories",
          "series"
        ],
        "additionalProperties": false,
        "description": "The content of a `GRAPH` section — a chart with its data baked in. This is the only chart form you can write over the API, so the chart always renders exactly the numbers you supply.",
        "title": "Graph Content"
      },
      "ReportGraphSectionInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "GRAPH"
            ],
            "description": "Always `GRAPH`.",
            "example": "GRAPH"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The heading rendered above the section. Omit it for an unheaded section.",
            "example": "Overview"
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report. Defaults to `false`.",
            "example": false
          },
          "content": {
            "$ref": "#/components/schemas/ReportGraphContent"
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false,
        "description": "A chart plotting the numbers you supply.",
        "title": "Graph Section"
      },
      "ReportGraphSeries": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The series label, which doubles as its legend entry.",
            "example": "Error Rate"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "One number per category, aligned positionally with them.",
            "example": [
              0.031,
              0.025,
              0.021
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "A colour for the series. Confident AI picks one when omitted.",
            "example": "#F97316"
          }
        },
        "required": [
          "name",
          "values"
        ],
        "additionalProperties": false,
        "description": "One plotted line on a `GRAPH` section.",
        "title": "Report Graph Series"
      },
      "ReportGraphType": {
        "type": "string",
        "enum": [
          "LINE",
          "AREA",
          "BAR",
          "STACKED_BAR"
        ],
        "description": "The chart style a `GRAPH` section renders as.",
        "title": "Report Graph Type"
      },
      "ReportList": {
        "type": "object",
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            },
            "description": "The reports for the current page, newest first."
          },
          "totalReports": {
            "type": "integer",
            "description": "The total number of reports matching the filters.",
            "example": 12
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of reports per page.",
            "example": 25
          }
        },
        "required": [
          "reports",
          "totalReports",
          "page",
          "pageSize"
        ],
        "description": "One page of reports, with the total across all pages.",
        "title": "Report List"
      },
      "ReportMetadata": {
        "type": "object",
        "properties": {
          "reportTitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "The report's title, as rendered in its header.",
            "example": "Weekly Health Check"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "One line on what the report covers.",
            "example": "Production health for the last week."
          },
          "dateRange": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportDateRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "generatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the report was written. Always stamped by Confident AI.",
            "example": "2025-01-08T00:00:00.000Z"
          }
        },
        "required": [
          "reportTitle",
          "description",
          "dateRange",
          "generatedAt"
        ],
        "description": "The report's stored header information. A field the report was written without comes back as `null`.",
        "title": "Report Metadata"
      },
      "ReportMetadataInput": {
        "type": "object",
        "properties": {
          "reportTitle": {
            "type": "string",
            "minLength": 1,
            "description": "The report's title. Defaults to the name of the report template it is written under.",
            "example": "Weekly Health Check"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "One line on what the report covers.",
            "example": "Production health for the last week."
          },
          "dateRange": {
            "$ref": "#/components/schemas/ReportDateRange"
          }
        },
        "additionalProperties": false,
        "description": "The report's header information. Confident AI stamps `generatedAt` itself.",
        "title": "Report Metadata Input"
      },
      "ReportNarrativeContent": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "narrative"
            ],
            "description": "Always `narrative`.",
            "example": "narrative"
          },
          "narrative": {
            "type": "string",
            "description": "Plain text only — no markdown headings, bold, or code fences. Do not repeat the section's heading, which renders above this text. Express a list as one item per line, each starting with \"- \".",
            "example": "Traffic held steady while the error rate fell by a third, and spend stayed inside budget."
          },
          "sources": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reader-facing labels for the data this section draws on, rendered beneath it. Omit them unless you want the section to cite where its numbers came from.",
            "example": [
              "Traces, 1-8 Jan 2025"
            ]
          }
        },
        "required": [
          "kind",
          "narrative"
        ],
        "additionalProperties": false,
        "description": "The content of a `CONTENT` section — a block of prose.",
        "title": "Narrative Content"
      },
      "ReportRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the report, generated by Confident AI.",
            "example": "<REPORT-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a report by its id.",
        "title": "Report Ref"
      },
      "ReportSection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the section, generated by Confident AI.",
            "example": "<REPORT-SECTION-ID>"
          },
          "type": {
            "$ref": "#/components/schemas/ReportSectionType"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "description": "The heading rendered above the section, or `null` when it has none.",
            "example": "Overview"
          },
          "order": {
            "type": "integer",
            "description": "The section's position in the report, starting at 0.",
            "example": 0
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportNarrativeContent"
              },
              {
                "$ref": "#/components/schemas/ReportAdmonitionContent"
              },
              {
                "$ref": "#/components/schemas/ReportStatCardsContent"
              },
              {
                "$ref": "#/components/schemas/ReportTableContent"
              },
              {
                "$ref": "#/components/schemas/ReportGraphContent"
              },
              {
                "$ref": "#/components/schemas/ReportGraphConfigContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why this section failed to generate, when it did.",
            "example": null
          },
          "startOnNewPage": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the section starts on a new page in the exported report.",
            "example": false
          }
        },
        "required": [
          "id",
          "type",
          "heading",
          "order",
          "content",
          "error",
          "startOnNewPage"
        ],
        "description": "One section of a report. Its `content` is `null` while Confident AI is still writing it.",
        "title": "Report Section"
      },
      "ReportSectionInput": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ReportContentSectionInput"
          },
          {
            "$ref": "#/components/schemas/ReportAdmonitionSectionInput"
          },
          {
            "$ref": "#/components/schemas/ReportStatCardsSectionInput"
          },
          {
            "$ref": "#/components/schemas/ReportTableSectionInput"
          },
          {
            "$ref": "#/components/schemas/ReportGraphSectionInput"
          }
        ],
        "description": "One section to write into a report. Its `content` must match its `type`, and sections render in the order you send them.",
        "title": "Report Section Input"
      },
      "ReportSectionType": {
        "type": "string",
        "enum": [
          "CONTENT",
          "STAT_CARDS",
          "TABLE",
          "GRAPH",
          "ADMONITION"
        ],
        "description": "What a section renders as, which decides the shape of its content: `CONTENT` is prose, `ADMONITION` a callout, `STAT_CARDS` a row of headline numbers, `TABLE` a grid, and `GRAPH` a chart.",
        "title": "Report Section Type"
      },
      "ReportStatCard": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "A short Title Case phrase of 2-4 words — never a sentence or a raw column name.",
            "example": "Error Rate"
          },
          "value": {
            "type": "string",
            "description": "A number, percentage, or short phrase, with numbers rounded to 2 decimal places.",
            "example": "2.10%"
          },
          "caption": {
            "type": [
              "string",
              "null"
            ],
            "description": "One short supporting line of 10 words or fewer.",
            "example": "412 of 19,600 requests"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "description": "One headline number on a `STAT_CARDS` section.",
        "title": "Report Stat Card"
      },
      "ReportStatCardsContent": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportStatCard"
            },
            "minItems": 1,
            "description": "Three to five cards read best. At least one is required."
          },
          "highlights": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ReportStatHighlight"
            },
            "description": "At most three standout findings. Omit rather than padding."
          },
          "sources": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reader-facing labels for the data this section draws on, rendered beneath it. Omit them unless you want the section to cite where its numbers came from.",
            "example": [
              "Traces, 1-8 Jan 2025"
            ]
          }
        },
        "required": [
          "cards"
        ],
        "additionalProperties": false,
        "description": "The content of a `STAT_CARDS` section — a row of headline numbers.",
        "title": "Stat Cards Content"
      },
      "ReportStatCardsSectionInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "STAT_CARDS"
            ],
            "description": "Always `STAT_CARDS`.",
            "example": "STAT_CARDS"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The heading rendered above the section. Omit it for an unheaded section.",
            "example": "Overview"
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report. Defaults to `false`.",
            "example": false
          },
          "content": {
            "$ref": "#/components/schemas/ReportStatCardsContent"
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false,
        "description": "A row of headline numbers.",
        "title": "Stat Cards Section"
      },
      "ReportStatHighlight": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "A short Title Case phrase.",
            "example": "Costliest Model"
          },
          "value": {
            "type": "string",
            "description": "The highlighted value.",
            "example": "gpt-4o, $96.20"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "description": "A standout finding shown alongside the stat cards.",
        "title": "Report Stat Highlight"
      },
      "ReportStatus": {
        "type": "string",
        "enum": [
          "IN_PROGRESS",
          "COMPLETED",
          "ERRORED"
        ],
        "description": "Where a report is in its life: `IN_PROGRESS` while its sections are still being written, `COMPLETED` once it is readable, `ERRORED` when writing it failed.",
        "title": "Report Status"
      },
      "ReportSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the report, generated by Confident AI.",
            "example": "<REPORT-ID>"
          },
          "reportTemplateId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the report template this report is written under, or `null` once that template has been deleted, which leaves the report unreachable on the platform.",
            "example": "<REPORT-TEMPLATE-ID>"
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the report failed, when it did.",
            "example": null
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the report was created.",
            "example": "2025-01-08T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the report was last updated.",
            "example": "2025-01-08T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "reportTemplateId",
          "status",
          "error",
          "metadata",
          "createdAt",
          "updatedAt"
        ],
        "description": "A report as it appears in a list: its status and header information, without its sections.",
        "title": "Report Summary"
      },
      "ReportTableContent": {
        "type": "object",
        "properties": {
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The column headers. At least one is required.",
            "example": [
              "Model",
              "Total Cost"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "The rows. Every row must hold exactly as many cells as there are headers, in the same order.",
            "example": [
              [
                "gpt-4o",
                "$96.20"
              ],
              [
                "gpt-4o-mini",
                "$32.20"
              ]
            ]
          },
          "sources": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reader-facing labels for the data this section draws on, rendered beneath it. Omit them unless you want the section to cite where its numbers came from.",
            "example": [
              "Traces, 1-8 Jan 2025"
            ]
          }
        },
        "required": [
          "headers",
          "rows"
        ],
        "additionalProperties": false,
        "description": "The content of a `TABLE` section — headers and the rows beneath them.",
        "title": "Table Content"
      },
      "ReportTableSectionInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TABLE"
            ],
            "description": "Always `TABLE`.",
            "example": "TABLE"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The heading rendered above the section. Omit it for an unheaded section.",
            "example": "Overview"
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report. Defaults to `false`.",
            "example": false
          },
          "content": {
            "$ref": "#/components/schemas/ReportTableContent"
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false,
        "description": "A grid of headers and rows.",
        "title": "Table Section"
      },
      "ReportTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the report template, generated by Confident AI.",
            "example": "<REPORT-TEMPLATE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The template's name, also used as the report's title.",
            "example": "Weekly Health Check"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question the generated report answers, which drives what data the generator retrieves.",
            "example": "Give me an overall health check for the last week: request volume, error rate, latency, total cost and user activity."
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind of report this template generates."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether scheduled generation is running. A disabled template generates nothing.",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the report template was created.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "schedule": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateSchedule"
              },
              {
                "type": "null"
              }
            ],
            "description": "The template's generation cadence, including how many times it has run, or `null` when it has no schedule."
          },
          "templateSections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportTemplateSection"
            },
            "description": "The template's sections, in render order. Empty when the generator chooses the structure from `description`."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "type",
          "enabled",
          "createdAt",
          "schedule",
          "templateSections"
        ],
        "description": "A recurring report definition, generated on the schedule you set — every 1 day unless you say otherwise.",
        "title": "Report Template"
      },
      "ReportTemplateList": {
        "type": "object",
        "properties": {
          "reportTemplates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportTemplateSummary"
            },
            "description": "The report templates for the current page, oldest first."
          },
          "totalReportTemplates": {
            "type": "integer",
            "description": "The total number of report templates in this project.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of report templates per page.",
            "example": 25
          }
        },
        "required": [
          "reportTemplates",
          "totalReportTemplates",
          "page",
          "pageSize"
        ],
        "description": "One page of report templates, with the total across all pages.",
        "title": "Report Template List"
      },
      "ReportTemplateRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the report template, generated by Confident AI.",
            "example": "<REPORT-TEMPLATE-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a report template by its id.",
        "title": "Report Template Ref"
      },
      "ReportTemplateSchedule": {
        "type": "object",
        "properties": {
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many `repeatUnit`s pass between runs — the 2 in \"every 2 weeks\". Always set on an `INTERVAL` schedule, `null` on a `ONCE` one.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit `repeatEvery` counts in. Always set on an `INTERVAL` schedule, `null` on a `ONCE` one."
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the first run was scheduled for, or `null` when it started immediately.",
            "example": "2025-01-08T09:00:00.000Z"
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The number of generations after which the schedule stops, or `null` for no cap.",
            "example": 12
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The time after which the schedule stops, or `null` for no end date.",
            "example": null
          },
          "runCount": {
            "type": "integer",
            "description": "How many reports this template has generated, counted against `maxRuns`.",
            "example": 3
          },
          "lastRunAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the template last generated a report, or `null` when it never has.",
            "example": "2025-01-22T09:00:00.000Z"
          }
        },
        "required": [
          "recurrence",
          "repeatEvery",
          "repeatUnit",
          "startAt",
          "maxRuns",
          "endAt",
          "runCount",
          "lastRunAt"
        ],
        "description": "When a report template generates, and how far it has got: the cadence you set, plus the read-only progress against it.",
        "title": "Report Template Schedule"
      },
      "ReportTemplateSection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the template section.",
            "example": "<REPORT-TEMPLATE-SECTION-ID>"
          },
          "type": {
            "$ref": "#/components/schemas/ReportTemplateSectionType"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "description": "The heading rendered above the section, or `null` when it has none.",
            "example": "What's Failing"
          },
          "order": {
            "type": "integer",
            "description": "The section's position in the report, starting at 0.",
            "example": 0
          },
          "useAI": {
            "type": "boolean",
            "description": "Whether the generator authors this section from `prompt`.",
            "example": true
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "The directive handed to the generator for this section, or `null` when the section is hardcoded.",
            "example": "Summarize the dominant failure modes in 2-4 sentences, citing error counts."
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateSectionContent"
              },
              {
                "type": "null"
              }
            ],
            "description": "The static content rendered for a hardcoded section, or `null` when the section is AI-authored."
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report.",
            "example": false
          }
        },
        "required": [
          "id",
          "type",
          "heading",
          "order",
          "useAI",
          "prompt",
          "content",
          "startOnNewPage"
        ],
        "description": "A stored section of a report template.",
        "title": "Report Template Section"
      },
      "ReportTemplateSectionConfig": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id of the section. Send the id a section was read back with to keep its creation time across a rewrite; omit it and Confident AI assigns one.",
            "example": "<REPORT-TEMPLATE-SECTION-ID>"
          },
          "type": {
            "$ref": "#/components/schemas/ReportTemplateSectionType"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "description": "The heading rendered above the section. Omit it for an unheaded section.",
            "example": "What's Failing"
          },
          "useAI": {
            "type": "boolean",
            "description": "Whether the generator authors this section from `prompt`. Defaults to `false`, which renders `content` verbatim instead.",
            "example": true
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when `useAI` is `true`: a single directive for what this section must cover.",
            "example": "Summarize the dominant failure modes in 2-4 sentences, citing error counts."
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateSectionContent"
              },
              {
                "type": "null"
              }
            ],
            "description": "The static content of a hardcoded section. Required for a `CONTENT` section with `useAI` `false`, and ignored when `useAI` is `true`."
          },
          "startOnNewPage": {
            "type": "boolean",
            "description": "Whether the section starts on a new page in the exported report. Defaults to `false`.",
            "example": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "description": "One section of a report template. Either AI-authored (`useAI` `true`, with a `prompt`) or hardcoded (`useAI` `false`, with static `content`). `STAT_CARDS`, `TABLE` and `GRAPH` must be AI-authored; `CONTENT` and `ADMONITION` can be either. A section's position in `templateSections` sets the order it renders in.",
        "title": "Report Template Section Config"
      },
      "ReportTemplateSectionContent": {
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "The section's literal text, written verbatim into every generated report.",
            "example": "Generated daily for the platform team."
          },
          "severity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateSectionSeverity"
              },
              {
                "type": "null"
              }
            ],
            "description": "`ADMONITION` sections only: the callout style. Defaults to `INFO` when omitted."
          }
        },
        "additionalProperties": false,
        "description": "The static content of a hardcoded (non-AI) template section. Null for AI-authored sections, which are written by the generator from their prompt.",
        "title": "Report Template Section Content"
      },
      "ReportTemplateSectionSeverity": {
        "type": "string",
        "enum": [
          "INFO",
          "SUCCESS",
          "WARNING",
          "DANGER"
        ],
        "description": "The callout style of an `ADMONITION` section, from an informational note to a danger warning.",
        "title": "Report Template Section Severity"
      },
      "ReportTemplateSectionType": {
        "type": "string",
        "enum": [
          "CONTENT",
          "STAT_CARDS",
          "TABLE",
          "GRAPH",
          "ADMONITION"
        ],
        "description": "What a section renders as. `STAT_CARDS`, `TABLE` and `GRAPH` must be AI-authored; `CONTENT` and `ADMONITION` can be either AI-authored or hardcoded.",
        "title": "Report Template Section Type"
      },
      "ReportTemplateSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the report template, generated by Confident AI.",
            "example": "<REPORT-TEMPLATE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The template's name, also used as the report's title.",
            "example": "Weekly Health Check"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question the generated report answers, which drives what data the generator retrieves.",
            "example": "Give me an overall health check for the last week: request volume, error rate, latency, total cost and user activity."
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportTemplateType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind of report this template generates."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether scheduled generation is running. A disabled template generates nothing.",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the report template was created.",
            "example": "2025-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "type",
          "enabled",
          "createdAt"
        ],
        "description": "A report template as it appears in a list. Retrieve one by id for its cadence and its sections.",
        "title": "Report Template Summary"
      },
      "ReportTemplateType": {
        "type": "string",
        "enum": [
          "RISK_ASSESSMENT_REPORT",
          "EXECUTIVE_REPORT"
        ],
        "description": "The kind of report a template generates. Templates you create over the API generate executive reports; `RISK_ASSESSMENT_REPORT` belongs to the reports Confident AI generates for a risk assessment.",
        "title": "Report Template Type"
      },
      "RetrieverSpanRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "RETRIEVER"
            ],
            "description": "The type of the span, always `RETRIEVER` for a retriever span.",
            "example": "RETRIEVER"
          },
          "uuid": {
            "type": "string",
            "description": "The unique identifier of the span, generated by your application. Values that are not UUIDs are hashed into one.",
            "example": "<SPAN-UUID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "input": {
            "description": "This is the input to the span, as a string or any JSON value.",
            "example": "What is the capital of France?"
          },
          "output": {
            "description": "This is the output of the span, as a string or any JSON value.",
            "example": "The capital of France is Paris."
          },
          "error": {
            "type": "string",
            "description": "This is the error message, if an error occurred inside the span.",
            "example": "The model timed out after 30 seconds."
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus",
            "default": "SUCCESS"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:02Z"
          },
          "parentUuid": {
            "type": "string",
            "description": "This is the unique identifier of the span's parent span. Omit it for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollection": {
            "type": "string",
            "description": "This is the metric collection to be used for evaluating the span.",
            "example": "LLM Collection Name"
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your span, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your span, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the span, which is to be used for evaluation."
          },
          "integration": {
            "type": "string",
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDataConfig"
            },
            "description": "Metric results you already computed for this span, recorded as-is instead of being evaluated by Confident AI."
          },
          "embedder": {
            "type": "string",
            "description": "This is the embedder model used in the span.",
            "example": "text-embedding-3-small"
          },
          "topK": {
            "type": "integer",
            "description": "This is the top K chunks retrieved from your knowledge base.",
            "example": 3
          },
          "chunkSize": {
            "type": "integer",
            "description": "This is the chunk size of each retrieved context.",
            "example": 512
          }
        },
        "required": [
          "type",
          "uuid",
          "name",
          "startTime",
          "endTime",
          "embedder"
        ],
        "additionalProperties": false,
        "description": "A span recording a knowledge-base lookup, with the embedder and retrieval settings it used.",
        "title": "Retriever Span"
      },
      "RiskAssessmentRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the risk assessment the run started.",
            "example": "<RISK-ASSESSMENT-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a risk assessment by its id.",
        "title": "Risk Assessment Ref"
      },
      "RiskCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the risk category, generated by Confident AI.",
            "example": "<RISK-CATEGORY-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the risk category, unique within the framework.",
            "example": "Data protection"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What this risk category covers.",
            "example": "Risks around leaking data the model was given."
          },
          "vulnerabilityTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskCategoryVulnerabilityType"
            },
            "description": "The vulnerability types this category probes for."
          },
          "attackMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskCategoryAttackMethod"
            },
            "description": "The attack methods this category probes with."
          },
          "vulnerabilityIdToPriorityLevel": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "description": "How much of the assessment each vulnerability gets, keyed by vulnerability id, from 0 to 3. A vulnerability with no entry runs at the default weight.",
            "example": {
              "<VULNERABILITY-ID>": 2
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "vulnerabilityTypes",
          "attackMethods",
          "vulnerabilityIdToPriorityLevel"
        ],
        "description": "One area of risk inside a framework, pairing the vulnerability types to probe for with the attack methods to probe with.",
        "title": "Risk Category"
      },
      "RiskCategoryAttackMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the attack method.",
            "example": "<ATTACK-METHOD-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the attack method.",
            "example": "Prompt Injection"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether the attack plays out over a conversation rather than a single request.",
            "example": false
          }
        },
        "required": [
          "id",
          "name",
          "multiTurn"
        ],
        "description": "An attack method selected into a risk category.",
        "title": "Risk Category Attack Method"
      },
      "RiskCategoryList": {
        "type": "object",
        "properties": {
          "riskCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskCategorySummary"
            },
            "description": "The risk categories for the current page, ordered by name."
          },
          "totalRiskCategories": {
            "type": "integer",
            "description": "The total number of risk categories in this framework.",
            "example": 8
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of risk categories per page.",
            "example": 25
          }
        },
        "required": [
          "riskCategories",
          "totalRiskCategories",
          "page",
          "pageSize"
        ],
        "description": "One page of risk categories, with the total across all pages.",
        "title": "Risk Category List"
      },
      "RiskCategoryRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the risk category, generated by Confident AI.",
            "example": "<RISK-CATEGORY-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a risk category by its id.",
        "title": "Risk Category Ref"
      },
      "RiskCategorySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the risk category, generated by Confident AI.",
            "example": "<RISK-CATEGORY-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the risk category, unique within the framework.",
            "example": "Data protection"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What this risk category covers.",
            "example": "Risks around leaking data the model was given."
          },
          "numVulnerabilityTypes": {
            "type": "integer",
            "description": "How many vulnerability types the category selects.",
            "example": 4
          },
          "numAttackMethods": {
            "type": "integer",
            "description": "How many attack methods the category selects.",
            "example": 3
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "numVulnerabilityTypes",
          "numAttackMethods"
        ],
        "description": "A risk category as it appears in a list: what it covers and how much it selects, without naming the selections.",
        "title": "Risk Category Summary"
      },
      "RiskCategoryVulnerabilityType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the vulnerability type.",
            "example": "<VULNERABILITY-TYPE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the vulnerability type.",
            "example": "System prompt disclosure"
          },
          "vulnerabilityId": {
            "type": "string",
            "description": "The id of the vulnerability this type belongs to.",
            "example": "<VULNERABILITY-ID>"
          },
          "vulnerabilityName": {
            "type": "string",
            "description": "The name of the vulnerability this type belongs to.",
            "example": "Prompt Leakage"
          }
        },
        "required": [
          "id",
          "name",
          "vulnerabilityId",
          "vulnerabilityName"
        ],
        "description": "A vulnerability type selected into a risk category.",
        "title": "Risk Category Vulnerability Type"
      },
      "RolePolicy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the policy, generated by Confident AI.",
            "example": "<POLICY-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the policy.",
            "example": "Billing read-only"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "A policy attached to a role, by id and name. The permissions it grants are not listed here; retrieve the policy from the policies endpoint of the same scope (`GET /v2/organization/policies` or `GET /v2/projects/{projectId}/policies`) to see them.",
        "title": "Role Policy"
      },
      "RoleRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the role that was deleted.",
            "example": "<ROLE-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that the role no longer exists.",
        "title": "Role Ref"
      },
      "RotateApiKeyRequest": {
        "type": "object",
        "properties": {
          "gracePeriodInHours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 168,
            "description": "How long the current value keeps authenticating alongside the new one, in hours from now — a duration, not a date, stored on the key as `rotatesAt` and never set past `expiresAt`. Defaults to 0, which replaces the value immediately and stops the old one at once.",
            "example": 24
          },
          "expiresInDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 365,
            "description": "A new lifetime for the key, in days from now — a duration, not a date, stored on the key as `expiresAt`. Omit it to keep the current expiry, or send `null` to remove the expiry altogether. Required when rotating a key that has already expired.",
            "example": 90
          }
        },
        "description": "How to rotate the key. Every field is optional; an empty body rotates the value immediately and leaves the expiry alone.",
        "title": "Rotate API Key Request"
      },
      "RotatedApiKey": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ImmediatelyRotatedApiKey"
          },
          {
            "$ref": "#/components/schemas/PendingRotationApiKey"
          }
        ],
        "description": "A just-rotated API key. Which variant you get follows `gracePeriodInHours`: without one the new secret is `value` and `shadowValue` is `null`, with one the new secret is `shadowValue` and `value` is the masked outgoing key."
      },
      "Rubric": {
        "type": "object",
        "properties": {
          "scoreRange": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            ],
            "description": "The inclusive start and end of the score range this outcome describes, each between 0 and 10, with the start no greater than the end.",
            "example": [
              8,
              10
            ]
          },
          "expectedOutcome": {
            "type": "string",
            "description": "What a response scoring in this range looks like.",
            "example": "The answer is factually correct and complete."
          }
        },
        "required": [
          "scoreRange",
          "expectedOutcome"
        ],
        "description": "A score range and the outcome it stands for. Ranges must not overlap."
      },
      "RunDatasetEvaluationRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the metric collection to evaluate against. Names come from the list metric collections endpoint.",
            "example": "Answer Quality"
          },
          "identifier": {
            "type": "string",
            "description": "A label for the resulting test run, used to recognise it in the test runs list.",
            "example": "Nightly regression"
          },
          "version": {
            "type": "string",
            "description": "The dataset version to evaluate. Omit this field to evaluate the latest version.",
            "example": "00.00.01"
          },
          "aiConnectionId": {
            "type": "string",
            "description": "The id of the AI connection used to generate the actual outputs before evaluating them. Required when `generationMode` is `AI_CONNECTION`, and not allowed together with `promptAlias`.",
            "example": "<AI-CONNECTION-ID>"
          },
          "voiceConnectionId": {
            "type": "string",
            "description": "The id of the voice connection to call while simulating each golden's conversation. Required when `generationMode` is `VOICE_CONNECTION`, needs a multi-turn dataset with `includeSimulation` enabled, and is not allowed together with `aiConnectionId` or `promptAlias`.",
            "example": "<VOICE-CONNECTION-ID>"
          },
          "promptAlias": {
            "type": "string",
            "description": "The alias of the prompt used to generate the actual outputs before evaluating them. Required when `generationMode` is `PROMPT`, and not allowed together with `aiConnectionId`.",
            "example": "capital-lookup"
          },
          "promptCommit": {
            "type": "string",
            "description": "The prompt commit hash to generate with. Requires `promptAlias`. Omit this field to generate with the latest commit on the prompt's main branch.",
            "example": "bab04ce"
          },
          "generationMode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "variablesMapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Maps each variable in the prompt to the golden field it is interpolated with, such as `Input` or `Expected Output`, or to a dataset custom column key. This field applies only when generating from a prompt.",
            "example": {
              "question": "Input"
            }
          },
          "includeSimulation": {
            "type": "boolean",
            "description": "Whether to simulate a conversation for each golden before evaluating it, for multi-turn datasets. Every golden needs a `scenario` when this is enabled, and `turns` when it is disabled.",
            "example": false
          },
          "maxConcurrentGeneration": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of generation calls to run in parallel. An AI connection's own `maxConcurrency` takes precedence over this value.",
            "example": 5
          },
          "generationTimeout": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of seconds to wait for a single generation before it is marked as errored.",
            "example": 60
          },
          "numGenerations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many times to run each golden, so a single outlier response does not skew the results. Omit this field to use the AI connection's `defaultNumGenerations`, which is 1 when the connection does not set one.",
            "example": 1
          },
          "mcpServerIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the MCP servers to attach to the run. A tool call whose name matches a tool exposed by one of these servers is labeled an MCP tool call rather than a function call.",
            "example": [
              "<MCP-SERVER-ID>"
            ]
          }
        },
        "required": [
          "metricCollection"
        ],
        "additionalProperties": false,
        "description": "How to evaluate the dataset. By default the goldens' stored actual outputs are evaluated; supply one of `aiConnectionId`, `promptAlias` or `voiceConnectionId` to generate them first."
      },
      "RunDatasetEvaluationResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the test run the dataset is evaluated in, generated by Confident AI and not to be confused with the identifier you supplied.",
            "example": "<TEST-RUN-ID>"
          },
          "testCaseCount": {
            "type": "integer",
            "description": "The number of test cases the evaluation was started with.",
            "example": 42
          }
        },
        "required": [
          "id",
          "testCaseCount"
        ]
      },
      "RunRTFrameworkRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "A human-readable identifier for the risk assessment, shown on the Confident AI platform.",
            "example": "pre-release-2025-01"
          },
          "riskCategories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The names of the framework's risk categories to run. Every name must belong to this framework.",
            "example": [
              "Data protection"
            ]
          },
          "exposure": {
            "$ref": "#/components/schemas/Level"
          },
          "aiConnectionId": {
            "type": "string",
            "description": "The id of the AI connection to attack. Send this or `promptAlias`, never both.",
            "example": "<AI-CONNECTION-ID>"
          },
          "promptAlias": {
            "type": "string",
            "description": "The alias of the prompt to attack. Send this or `aiConnectionId`, never both.",
            "example": "customer-support"
          },
          "promptCommit": {
            "type": "string",
            "description": "The commit hash of the prompt to attack. Requires `promptAlias`; defaults to its latest commit.",
            "example": "bab04ce"
          },
          "generationMode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "attackEngine": {
            "$ref": "#/components/schemas/AttackEngine"
          }
        },
        "required": [
          "riskCategories",
          "exposure"
        ],
        "additionalProperties": false,
        "description": "What to attack and how far to go. Provide exactly one target — an AI connection or a prompt — and the risk categories to run.",
        "title": "Run RT Framework Request"
      },
      "SchedulableExportType": {
        "type": "string",
        "enum": [
          "TRACES",
          "TRACES_WITH_SPANS",
          "CONVERSATIONS",
          "CONVERSATION_METRICS",
          "ANNOTATIONS",
          "TEST_RUNS",
          "AUDIT_LOGS"
        ],
        "description": "What each run of the schedule exports. Only project-scoped export types can be scheduled: `TRACES_WITH_SPANS`, `TRACES`, `CONVERSATIONS`, `CONVERSATION_METRICS`, `ANNOTATIONS`, `TEST_RUNS`. Audit log exports are organization-scoped and are not export schedules. Please configure them on the platform instead.",
        "title": "Schedulable Export Type"
      },
      "ScheduleIntervalUnit": {
        "type": "string",
        "enum": [
          "MINUTE",
          "HOUR",
          "DAY",
          "WEEK",
          "MONTH"
        ],
        "description": "The unit `repeatEvery` counts for an `INTERVAL` schedule.",
        "title": "Schedule Interval Unit"
      },
      "ScheduleRecurrenceType": {
        "type": "string",
        "enum": [
          "ONCE",
          "INTERVAL"
        ],
        "description": "How often a schedule fires: `ONCE` runs a single time at `startAt`, `INTERVAL` repeats every `repeatEvery` `repeatUnit`s.",
        "title": "Schedule Recurrence Type"
      },
      "ScheduledAlert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the scheduled alert, generated by Confident AI.",
            "example": "<SCHEDULED-ALERT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the alert, shown in the notification.",
            "example": "Trace error rate spike"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the alert means and what to do about it, or `null` when it has no description.",
            "example": "Errors above 5% over the last hour."
          },
          "type": {
            "$ref": "#/components/schemas/ScheduledAlertType"
          },
          "dataModel": {
            "$ref": "#/components/schemas/AlertDataModel"
          },
          "aggregation": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the alert measures, as an aggregation token, or `null` for alerts that are not `THRESHOLD` alerts.",
            "example": "ERROR_RATE"
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet"
          },
          "thresholdSettings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AlertThresholdSettings"
              },
              {
                "type": "null"
              }
            ]
          },
          "detectionSettings": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "traceName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "avg_score",
                        "error_rate",
                        "avg_latency",
                        "avg_cost",
                        "negative_label_rate"
                      ]
                    },
                    "minItems": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "WORSENED",
                      "ANY"
                    ]
                  },
                  "minAffectedCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "significantOnly": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "direction",
                  "minAffectedCount",
                  "significantOnly"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "traceName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "avg_score",
                        "error_rate",
                        "avg_latency",
                        "avg_cost",
                        "negative_label_rate"
                      ]
                    },
                    "minItems": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "WORSENED",
                      "ANY"
                    ]
                  },
                  "minAffectedCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "direction",
                  "minAffectedCount"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "classifierIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "WORSENED",
                      "ANY"
                    ]
                  },
                  "minAffectedCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "classifierIds",
                  "direction",
                  "minAffectedCount"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/AlertSeverity"
          },
          "scheduleSettings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduledAlertScheduleSettings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "type",
          "dataModel",
          "aggregation",
          "filters",
          "thresholdSettings",
          "detectionSettings",
          "severity",
          "scheduleSettings"
        ],
        "description": "An alert that runs on a schedule and notifies when an aggregate crosses its threshold, or while a regression, anomaly or signal spike is detected.",
        "title": "Scheduled Alert"
      },
      "ScheduledAlertDetectionSettings": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "traceName": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "avg_score",
                    "error_rate",
                    "avg_latency",
                    "avg_cost",
                    "negative_label_rate"
                  ]
                },
                "minItems": 1
              },
              "direction": {
                "type": "string",
                "enum": [
                  "WORSENED",
                  "ANY"
                ]
              },
              "minAffectedCount": {
                "type": "integer",
                "minimum": 0
              },
              "significantOnly": {
                "type": "boolean"
              }
            },
            "required": [
              "direction",
              "minAffectedCount",
              "significantOnly"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "traceName": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "avg_score",
                    "error_rate",
                    "avg_latency",
                    "avg_cost",
                    "negative_label_rate"
                  ]
                },
                "minItems": 1
              },
              "direction": {
                "type": "string",
                "enum": [
                  "WORSENED",
                  "ANY"
                ]
              },
              "minAffectedCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "direction",
              "minAffectedCount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "classifierIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "direction": {
                "type": "string",
                "enum": [
                  "WORSENED",
                  "ANY"
                ]
              },
              "minAffectedCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "classifierIds",
              "direction",
              "minAffectedCount"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Which detections notify, for `REGRESSION`, `ANOMALY` and `SIGNAL_SPIKE` alerts. Regressions and anomalies take an optional `traceName` (omit for every trace), optional `metrics` (omit for all of `avg_score`, `error_rate`, `avg_latency`, `avg_cost`, `negative_label_rate`), `direction` (`WORSENED` or `ANY`) and `minAffectedCount`, the fewest affected traces a detection needs; regressions also take `significantOnly`. Signal spikes take `classifierIds`, `direction` and `minAffectedCount`, counted in threads when `dataModel` is `THREAD`.",
        "title": "Scheduled Alert Detection Settings",
        "example": {
          "direction": "WORSENED",
          "significantOnly": true,
          "minAffectedCount": 20
        }
      },
      "ScheduledAlertList": {
        "type": "object",
        "properties": {
          "scheduledAlerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduledAlertSummary"
            },
            "description": "The scheduled alerts for the current page, ordered by name."
          },
          "totalScheduledAlerts": {
            "type": "integer",
            "description": "The total number of scheduled alerts matching the filters.",
            "example": 7
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of scheduled alerts per page.",
            "example": 25
          }
        },
        "required": [
          "scheduledAlerts",
          "totalScheduledAlerts",
          "page",
          "pageSize"
        ],
        "description": "One page of scheduled alerts, with the total across all pages.",
        "title": "Scheduled Alert List"
      },
      "ScheduledAlertRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the scheduled alert, generated by Confident AI.",
            "example": "<SCHEDULED-ALERT-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a scheduled alert by its id.",
        "title": "Scheduled Alert Ref"
      },
      "ScheduledAlertScheduleSettings": {
        "type": "object",
        "properties": {
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many `repeatUnit`s apart the runs are, or `null` when the alert runs once.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ]
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule first runs, or `null` when it started immediately.",
            "example": null
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule stops running, or `null` when it is open-ended.",
            "example": null
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many times the alert runs before it stops, or `null` when it runs indefinitely.",
            "example": null
          },
          "runCount": {
            "type": "integer",
            "description": "How many times the alert has run so far.",
            "example": 12
          },
          "lastRunAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the alert last ran, or `null` until its first run.",
            "example": "2025-02-01T10:00:00.000Z"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the schedule is currently running.",
            "example": true
          }
        },
        "required": [
          "recurrence",
          "repeatEvery",
          "repeatUnit",
          "startAt",
          "endAt",
          "maxRuns",
          "runCount",
          "lastRunAt",
          "enabled"
        ],
        "description": "The alert's cadence together with its run history.",
        "title": "Scheduled Alert Schedule Settings"
      },
      "ScheduledAlertSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the scheduled alert, generated by Confident AI.",
            "example": "<SCHEDULED-ALERT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the alert.",
            "example": "Trace error rate spike"
          },
          "type": {
            "$ref": "#/components/schemas/ScheduledAlertType"
          },
          "dataModel": {
            "$ref": "#/components/schemas/AlertDataModel"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the alert's schedule is running. False when the alert has no schedule.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "dataModel",
          "enabled"
        ],
        "description": "An alert as it appears in a list: what it measures and whether it is running. Retrieve it by id for its aggregation, filters, threshold, severity and run history.",
        "title": "Scheduled Alert Summary"
      },
      "ScheduledAlertType": {
        "type": "string",
        "enum": [
          "THRESHOLD",
          "REGRESSION",
          "ANOMALY",
          "SIGNAL_SPIKE"
        ],
        "description": "What the alert watches. `THRESHOLD` alerts compare an aggregation against `thresholdSettings`. `REGRESSION`, `ANOMALY` and `SIGNAL_SPIKE` alerts notify on every run while Confident AI detects one inside the alert's `filters`, as configured by `detectionSettings`. Defaults to `THRESHOLD`.",
        "title": "Scheduled Alert Type"
      },
      "SchemaDataType": {
        "type": "string",
        "enum": [
          "OBJECT",
          "ARRAY",
          "STRING",
          "FLOAT",
          "INTEGER",
          "BOOLEAN",
          "NULL"
        ],
        "description": "This is the data type of a schema field."
      },
      "SetGovernancePolicyControlsRequest": {
        "type": "object",
        "properties": {
          "controlIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The complete set of controls the policy should attach directly. Any control it currently attaches and you leave out is detached, and an empty array detaches all of them. An inherited control cannot appear here — it is attached on the base policy that owns it.",
            "example": [
              "<GOVERNANCE-CONTROL-ID>"
            ]
          }
        },
        "required": [
          "controlIds"
        ],
        "additionalProperties": false,
        "description": "The controls a governance policy should apply. This replaces the policy's own attachments outright rather than adding to them.",
        "title": "Set Governance Policy Controls Request"
      },
      "SignalPolarity": {
        "type": "string",
        "enum": [
          "HIGHER_IS_BETTER",
          "LOWER_IS_BETTER",
          "NEUTRAL"
        ],
        "description": "Whether more of a signal is good, bad, or neither, for trend reporting.",
        "title": "Signal Polarity"
      },
      "SingleTurnGolden": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
