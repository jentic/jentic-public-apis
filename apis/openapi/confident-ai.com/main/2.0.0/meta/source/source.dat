            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ],
            "description": "The stored LiteLLM configuration, with its secret fields masked, or `null` when none is stored.",
            "example": null
          },
          "huggingFaceConfig": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ],
            "description": "The stored Hugging Face configuration, with its secret fields masked, or `null` when none is stored.",
            "example": null
          },
          "organizationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the organization these credentials belong to, or `null` when they belong to a single project.",
            "example": "<ORGANIZATION-ID>"
          }
        },
        "required": [
          "id",
          "openAiApiKey",
          "anthropicApiKey",
          "geminiApiKey",
          "xAiApiKey",
          "deepSeekApiKey",
          "mistralApiKey",
          "perplexityApiKey",
          "zAiApiKey",
          "typeSafeApiKey",
          "falApiKey",
          "bedrockModelConfig",
          "vertexAiModelConfig",
          "azureModelConfig",
          "portKeyConfig",
          "openRouterConfig",
          "trueFoundryConfig",
          "liteLlmConfig",
          "huggingFaceConfig",
          "organizationId"
        ],
        "description": "One provider credential per field, for the whole organization or for a single project. Every secret comes back masked — fifteen asterisks followed by its last six characters, and the same treatment for the secret leaves inside a configuration object — so a stored credential can never be read back in full once it is set. A field is `null` when no credential is stored for that provider.",
        "title": "Model Credentials"
      },
      "ModelProvider": {
        "type": "string",
        "enum": [
          "OPEN_AI",
          "CUSTOM",
          "CONFIDENT_AI",
          "BEDROCK",
          "ANTHROPIC",
          "GEMINI",
          "X_AI",
          "DEEPSEEK",
          "MOONSHOT_AI",
          "VERTEX_AI",
          "AZURE",
          "MISTRAL",
          "PERPLEXITY",
          "OPEN_ROUTER",
          "PORTKEY",
          "LITE_LLM",
          "TRUE_FOUNDRY",
          "HUGGING_FACE",
          "TYPE_SAFE",
          "FAL",
          "Z_AI"
        ],
        "description": "This is the provider of the model.",
        "title": "Model Provider"
      },
      "ModelSettings": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/ModelProvider"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the model.",
            "example": "gpt-4o"
          },
          "temperature": {
            "type": "number",
            "description": "This controls randomness in the model's output. Higher values make output more random.",
            "example": 0.7
          },
          "maxTokens": {
            "type": "number",
            "description": "This is the maximum number of tokens to generate.",
            "example": 1024
          },
          "topP": {
            "type": "number",
            "description": "This controls diversity via nucleus sampling. Lower values focus on more likely tokens.",
            "example": 1
          },
          "topK": {
            "type": "number",
            "description": "This limits sampling to the K most likely tokens at each step.",
            "example": 40
          },
          "frequencyPenalty": {
            "type": "number",
            "description": "This is the penalty for tokens based on their frequency in the text so far.",
            "example": 0
          },
          "presencePenalty": {
            "type": "number",
            "description": "This is the penalty for tokens based on whether they appear in the text so far.",
            "example": 0
          },
          "stopSequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the sequences where the model will stop generating further tokens.",
            "example": [
              "\n\nHuman:",
              "###"
            ]
          },
          "reasoningEffort": {
            "$ref": "#/components/schemas/ReasoningEffort"
          },
          "verbosity": {
            "$ref": "#/components/schemas/Verbosity"
          }
        },
        "description": "This is the model settings the prompt was authored for."
      },
      "ModelSource": {
        "type": "string",
        "enum": [
          "project",
          "organization"
        ],
        "description": "Where the model in effect for a project comes from: `project` when the model is project scoped or has a project override, and `organization` when it follows the organization's default.",
        "title": "Model Source"
      },
      "ModelType": {
        "type": "string",
        "enum": [
          "EVALUATION",
          "PLATFORM",
          "GENERATION",
          "SIMULATION",
          "TEXT_TO_SPEECH",
          "SPEECH_TO_TEXT",
          "DECISION",
          "SPEECH_TO_SPEECH"
        ],
        "description": "What a configured model is used for. `EVALUATION` is the LLM judge that scores a project's metrics, `PLATFORM` is the model behind Confident AI's own AI features such as classification, summaries and report generation, and `SIMULATION` is the model that simulates user turns in conversation simulations. Those three are the only types the public API reads or writes.",
        "title": "Model Type"
      },
      "MultiTurnGolden": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "This is a description of the conversation context.",
            "example": "A traveller wants to book a hotel in Paris."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "This describes the expected outcome, or ideal conversation flow, of the conversation.",
            "example": "The assistant confirms a reservation near the Louvre."
          },
          "userDescription": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the description of the user in the conversation.",
            "example": "A traveller planning a weekend in Paris."
          },
          "turns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "description": "This is the list of turns in the conversation.",
            "example": [
              {
                "role": "user",
                "content": "I need a hotel in Paris near the Louvre."
              },
              {
                "role": "assistant",
                "content": "Hôtel du Louvre has rooms available. Which dates?"
              }
            ]
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the context of the conversation.",
            "example": [
              "Hôtel du Louvre is a five-minute walk from the museum."
            ]
          },
          "id": {
            "type": "string",
            "description": "The id of the golden assigned by Confident AI. Use it to get, update or delete this golden.",
            "example": "<GOLDEN-ID>"
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "These are what the LLM system must and must not do for this golden.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is any comments associated with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the source file from which the golden was retrieved.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "These are the source files the golden was retrieved from.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "description": "This is `true` when the golden is finalized and ready to use in evaluations.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-value pairs representing custom table column data for this golden. Keys correspond to the custom column keys defined in the dataset. Absent when the golden has no custom column values.",
            "example": {
              "difficulty": "easy"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "These are the tags associated with the golden.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "scenario",
          "expectedOutcome",
          "userDescription",
          "turns",
          "context",
          "id",
          "additionalMetadata",
          "expectations",
          "comments",
          "sourceFile",
          "sourceFiles",
          "finalized",
          "tags"
        ],
        "additionalProperties": false,
        "description": "A multi-turn golden as stored in the dataset.",
        "title": "Multi-Turn Golden"
      },
      "MultiTurnGoldenRequest": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "This is a description of the conversation context.",
            "example": "A traveller wants to book a hotel in Paris."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "This describes the expected outcome, or ideal conversation flow, of the conversation.",
            "example": "The assistant confirms a reservation near the Louvre."
          },
          "userDescription": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the description of the user in the conversation.",
            "example": "A traveller planning a weekend in Paris."
          },
          "turns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "description": "This is the list of turns in the conversation.",
            "example": [
              {
                "role": "user",
                "content": "I need a hotel in Paris near the Louvre."
              },
              {
                "role": "assistant",
                "content": "Hôtel du Louvre has rooms available. Which dates?"
              }
            ]
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the context of the conversation.",
            "example": [
              "Hôtel du Louvre is a five-minute walk from the museum."
            ]
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Additional metadata to associate with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "What the LLM system must and must not do for this golden. Omit it to leave stored expectations unchanged, or send null to clear them.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comments to associate with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source file the golden was retrieved from. Like `tags` and `customColumnKeyValues`, this is left unchanged when the request omits it; send `null` to clear it.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The source files the golden was retrieved from. Like `tags` and `customColumnKeyValues`, these are left unchanged when the request omits them; send an empty array to clear them.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "default": true,
            "description": "Whether the golden is ready to use in evaluations. When pushing or queueing a list of goldens the request decides this for every golden and this field is ignored.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom dataset column values keyed by column name. A column that does not exist in the dataset yet is created.",
            "example": {
              "difficulty": "easy"
            }
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "The media this golden refers to, keyed by the id inside each placeholder. Put `[DEEPEVAL:IMAGE:<id>]` or `[DEEPEVAL:PDF:<id>]` in a text field where the media belongs, and the platform substitutes the entry with a matching key.",
            "example": {
              "map": {
                "url": "https://example.com/paris.png",
                "local": false
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags to associate with the golden, which is useful for grouping and filtering goldens. A tag that does not exist in the dataset yet is created.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "scenario"
        ],
        "additionalProperties": false,
        "description": "A multi-turn golden to write: the scenario of a conversation with your LLM application and, optionally, its turns.",
        "title": "Multi-Turn Golden Request"
      },
      "MultiTurnTestCase": {
        "type": "object",
        "properties": {
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "minItems": 1,
            "description": "This is the list of turns in the conversation.",
            "example": [
              {
                "role": "user",
                "content": "How tall is Mount Everest?"
              },
              {
                "role": "assistant",
                "content": "Mount Everest is 8,848 metres tall."
              }
            ]
          },
          "scenario": {
            "type": "string",
            "description": "This is a description of the conversation context.",
            "example": "A traveller asking about mountain heights."
          },
          "expectedOutcome": {
            "type": "string",
            "description": "This describes the expected outcome, or ideal conversation flow, of the conversation.",
            "example": "The assistant states Everest's height."
          },
          "userDescription": {
            "type": "string",
            "description": "This is the description of the user in the conversation.",
            "example": "A traveller planning a trek."
          },
          "chatbotRole": {
            "type": "string",
            "description": "This is the role of the chatbot in the conversation.",
            "example": "A helpful geography assistant."
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your LLM application.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "tokenCost": {
            "type": "number",
            "minimum": 0,
            "description": "This is the cost of the tokens used by the LLM model.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 24
          },
          "outputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 12
          },
          "name": {
            "type": "string",
            "description": "This is the name of your test case, it allows you to search and match test cases across different test runs.",
            "example": "everest-height"
          },
          "flaky": {
            "type": "boolean",
            "description": "This is `true` if the test case's verdict was non-deterministic across runs.",
            "example": false
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "This is the mapping of image placeholders in your test case to the images they refer to.",
            "example": {
              "summit": {
                "url": "https://example.com/everest.png",
                "local": false
              }
            }
          },
          "additionalMetadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "Additional metadata associated with this test case.",
            "example": {
              "region": "Nepal"
            }
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "This is the custom column key values of the LLM application.",
            "example": {
              "team": "search"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the list of tags associated with the test case, which is useful for grouping and filtering for test cases.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "turns"
        ],
        "additionalProperties": false,
        "description": "A test case for a conversation with your LLM application.",
        "title": "Multi-Turn Test Case"
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the organization, generated by Confident AI.",
            "example": "<ORGANIZATION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "example": "Acme"
          },
          "plan": {
            "$ref": "#/components/schemas/OrganizationPlan"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the organization was created.",
            "example": "2025-01-14T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "plan",
          "created_at"
        ],
        "description": "The tenant every project, API key and member belongs to. An organization API key is scoped to exactly one of these, so this is the top of the hierarchy the admin endpoints operate on.",
        "title": "Organization"
      },
      "OrganizationInvitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the invitation, generated by Confident AI.",
            "example": 42
          },
          "email": {
            "type": "string",
            "description": "The email address the invitation was sent to, lowercased when it was created.",
            "example": "jane@acme.com"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the invitation was issued, as an ISO 8601 datetime. Resending an invitation stamps this again.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "organizationRoleId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the organization role the invitee lands on when they accept, or `null` to give them the default `Member` role.",
            "example": "<ORGANIZATION-ROLE-ID>"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "The token embedded in the invitee's invite link, returned unmasked. Anyone holding it can accept the invitation as the invited email address, so treat it as a secret. It is replaced whenever the invitation is resent, which invalidates any link sent earlier. It is `null` when the invitation has no token stored, in which case its link only points the invitee at signup.",
            "example": "<INVITATION-TOKEN>"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "created_at",
          "organizationRoleId",
          "token"
        ],
        "description": "A standing offer of access to your organization. Accepting one makes the invitee an organization member; it grants no access to any project on its own.",
        "title": "Organization Invitation"
      },
      "OrganizationInvitationList": {
        "type": "object",
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationInvitation"
            },
            "description": "The organization's pending and declined invitations."
          }
        },
        "required": [
          "invitations"
        ],
        "description": "Every organization invitation that has not been accepted or revoked. Accepted invitations are left out, since the invitee is an organization member by then.",
        "title": "Organization Invitation List"
      },
      "OrganizationMember": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the user.",
            "example": "<USER-ID>"
          },
          "email": {
            "type": "string",
            "description": "This is the email address of the user.",
            "example": "jane@acme.com"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the display name of the user, or `null` when they have not set one.",
            "example": "Jane Doe"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the URL of the user's avatar, or `null` when they have none.",
            "example": null
          },
          "organizationRole": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemberRole"
              },
              {
                "type": "null"
              }
            ],
            "description": "The organization role this member holds, or `null` when they are attached to the organization without one."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "image",
          "organizationRole"
        ],
        "description": "A user who belongs to your organization, with the role that decides what they can do in it. Organization membership alone grants no access to any project's data.",
        "title": "Organization Member"
      },
      "OrganizationMemberList": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationMember"
            },
            "description": "The organization's members for the current page."
          },
          "totalOrganizationMembers": {
            "type": "integer",
            "description": "The total number of members in the organization, across every page.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of members per page.",
            "example": 25
          }
        },
        "required": [
          "members",
          "totalOrganizationMembers",
          "page",
          "pageSize"
        ],
        "description": "One page of organization members, with the total across all pages.",
        "title": "Organization Member List"
      },
      "OrganizationPlan": {
        "type": "string",
        "enum": [
          "TRIAL",
          "FREE",
          "STARTER",
          "ENTERPRISE",
          "TEAM",
          "PREMIUM"
        ],
        "description": "The billing plan the organization is on, which decides its entitlements and usage limits. Plans rank `FREE` and `TRIAL`, then `STARTER`, `PREMIUM`, `TEAM` and `ENTERPRISE`, each carrying every lower plan's entitlements plus more projects and seats: `FREE` allows a single project, `STARTER` up to five, and the paid plans above it bill extra project spaces as usage. Some features are reserved outright — red teaming through the API is `ENTERPRISE` only. `TRIAL` is a time-limited run at paid entitlements; once the trial period has elapsed the organization is entitled as `FREE`, but this field keeps reporting the stored plan, so it is not a substitute for a 403 when deciding whether a call will be allowed.",
        "title": "Organization Plan"
      },
      "OrganizationRole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the role, generated by Confident AI.",
            "example": "<ROLE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the role.",
            "example": "Billing Auditor"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the role is for, or `null` when it has no description.",
            "example": "Read-only access to invoices and model costs."
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePolicy"
            },
            "description": "The organization policies attached to the role, whose permissions together are everything a member holding it can do. A global role's permissions are system-defined rather than drawn from policies, so its list is empty."
          },
          "organizationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The id of the organization that owns the role, or `null` for a global, system-defined role that every organization can assign.",
            "example": "<ORGANIZATION-ID>"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "policies",
          "organizationId"
        ],
        "description": "A named set of organization policies that a member can hold. A member holds at most one organization role, and every organization permission they have comes from the policies attached to it.",
        "title": "Organization Role"
      },
      "OrganizationRoleList": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationRole"
            },
            "description": "The roles your organization can assign: the roles it owns, plus the global, system-defined roles available to every organization."
          }
        },
        "required": [
          "roles"
        ],
        "description": "Every organization role a member can be given, owned and global together.",
        "title": "Organization Role List"
      },
      "OutputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "This is the name of the output schema.",
            "example": "Greeting"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutputSchemaField"
            },
            "description": "This is the array of fields that define the output schema structure."
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "description": "This is the output schema definition, used when `outputType` is `SCHEMA`."
      },
      "OutputSchemaField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique identifier for the schema field. Use it as the `parentId` of nested fields.",
            "example": "<FIELD-ID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the schema field.",
            "example": "greeting"
          },
          "type": {
            "$ref": "#/components/schemas/SchemaDataType"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "This indicates whether the field is required in the output.",
            "example": true
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the id of the parent field for nested structures, or `null` for a top-level field.",
            "example": null
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "PendingRotationApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key, generated by Confident AI.",
            "example": 1420
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The label for the key, shown on the Confident AI platform.",
            "example": "CI pipeline"
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the key authenticates. A deactivated key is rejected on every request until it is reactivated.",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the key was created.",
            "example": "2025-01-15T09:30:00.000Z"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The instant the key stops authenticating, or `null` when it never expires. Confident AI computes it from the `expiresInDays` duration sent when the key was created or last rotated.",
            "example": "2025-04-15T09:30:00.000Z"
          },
          "value": {
            "type": "string",
            "description": "The outgoing key, masked. It keeps authenticating alongside `shadowValue` until `rotatesAt`, then stops.",
            "example": "***************LmNoPq"
          },
          "shadowValue": {
            "type": "string",
            "description": "The new full API key, issued by this rotation. This response is the only place it is ever returned, so store it now — every later response masks it. It authenticates immediately and becomes `value` once `rotatesAt` passes.",
            "example": "confident_us_org_5tRw8xYz2aBc4dEf6gHi8jKl0mNo2pQr4sTu6vWx"
          },
          "rotatesAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the grace period ends: `shadowValue` becomes `value` and the outgoing value is rejected. Confident AI computes it from the `gracePeriodInHours` duration and never sets it past `expiresAt`.",
            "example": "2025-03-01T12:00:00.000Z"
          },
          "lastUsed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the key last authenticated a request, or `null` when it never has.",
            "example": "2025-02-28T18:45:12.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "valid",
          "created_at",
          "expiresAt",
          "value",
          "shadowValue",
          "rotatesAt",
          "lastUsed"
        ],
        "additionalProperties": false,
        "description": "The result of rotating with a grace period: two values authenticate at once, the outgoing one until `rotatesAt` and the new one from now on.",
        "title": "API Key With Rotation Pending"
      },
      "Permission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the permission, generated by Confident AI. This is what a policy references in its `permissionIds`.",
            "example": "<PERMISSION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The permission, written as `resource:action` — the resource it applies to, then what it allows on it. `read` grants viewing, `manage` grants creating and updating, and `create`, `update` and `delete` appear where a resource distinguishes them.",
            "example": "user:read"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the permission allows, in prose, or `null` when it has none. Confident AI creates these permissions from its own catalog and does not describe them, so this is `null` unless someone has filled it in.",
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "description": "One thing a policy can allow. Permissions are never granted to a member directly: a policy names a set of them, a role holds policies, and a member holds roles.",
        "title": "Permission"
      },
      "PermissionList": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "description": "Every permission in the catalog for this scope, in no particular order."
          }
        },
        "required": [
          "permissions"
        ],
        "description": "The complete set of permissions a policy in this scope can grant, taken from Confident AI's own catalog rather than from what your organization happens to use already.",
        "title": "Permission List"
      },
      "Persona": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the persona, generated by Confident AI.",
            "example": "<PERSONA-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the persona, unique within the project.",
            "example": "Frustrated support caller"
          },
          "characteristics": {
            "type": "string",
            "description": "How this persona behaves in a conversation, as the simulator reads it on every user turn.",
            "example": "An impatient customer who has already been transferred twice. Types in lowercase, asks short direct questions, and pushes back when given a generic answer."
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Structured facts the persona can draw on, available to the simulator and to your AI connection payload.",
            "example": {
              "accountId": "acc_123",
              "plan": "pro"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time the persona was created, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time the persona was last changed, as an ISO 8601 datetime.",
            "example": "2025-01-16T09:12:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "characteristics",
          "metadata",
          "createdAt",
          "updatedAt"
        ],
        "description": "A reusable character for the simulated user in a multi-turn conversation. Confident AI simulates conversations against your LLM app from multi-turn goldens, and a golden that names a persona has its user side played in character: the persona supplies who is talking, while the golden supplies what they want and when the conversation is done. Defining the character once here is what keeps 'a frustrated customer who types in lowercase' from being retyped on every row, and lets you compare runs where only the user changed.",
        "title": "Persona"
      },
      "PersonaList": {
        "type": "object",
        "properties": {
          "personas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonaSummary"
            },
            "description": "The personas for the current page, newest first."
          },
          "totalPersonas": {
            "type": "integer",
            "description": "The total number of personas in this project.",
            "example": 4
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of personas per page.",
            "example": 25
          }
        },
        "required": [
          "personas",
          "totalPersonas",
          "page",
          "pageSize"
        ],
        "description": "One page of personas, with the total across all pages.",
        "title": "Persona List"
      },
      "PersonaRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the persona, generated by Confident AI.",
            "example": "<PERSONA-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a persona by its id.",
        "title": "Persona Ref"
      },
      "PersonaSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the persona, generated by Confident AI.",
            "example": "<PERSONA-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the persona.",
            "example": "Frustrated support caller"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "A persona as it appears in a list: enough to recognise it and pick its id. Retrieve one by id to read the characteristics that drive the simulation.",
        "title": "Persona Summary"
      },
      "PhoneVoiceConfig": {
        "type": "object",
        "properties": {
          "transport": {
            "type": "string",
            "enum": [
              "PHONE"
            ]
          },
          "phoneNumber": {
            "type": "string",
            "description": "The E.164 phone number to dial.",
            "example": "+14155550100"
          },
          "carrier": {
            "type": "string",
            "enum": [
              "CONFIDENT",
              "CUSTOM_TRUNK"
            ],
            "description": "Who carries the call to the phone network: `CONFIDENT` uses Confident AI's own trunk, `CUSTOM_TRUNK` uses yours."
          },
          "trunkUri": {
            "type": "string",
            "description": "The sip: address of your outbound trunk. Required when `carrier` is `CUSTOM_TRUNK`.",
            "example": "sip:outbound@trunk.example.com"
          },
          "trunkCredentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SipCredentials"
              },
              {
                "type": "null"
              }
            ],
            "description": "Credentials for your outbound trunk, or null when it needs none."
          },
          "callerId": {
            "type": "string",
            "description": "The number or sip: address presented to your agent as the caller. Leave it empty to use the default.",
            "example": "+14155550199"
          }
        },
        "required": [
          "transport",
          "phoneNumber",
          "carrier",
          "trunkUri",
          "trunkCredentials",
          "callerId"
        ],
        "description": "Dials your agent over the phone network.",
        "title": "Phone Voice Config"
      },
      "PingAIConnectionRequest": {
        "type": "object",
        "properties": {
          "multiturn": {
            "type": "boolean",
            "default": false,
            "description": "Whether to test the connection over a simulated multi-turn conversation instead of a single call. Defaults to `false`.",
            "example": false
          }
        },
        "additionalProperties": false,
        "description": "How to test the connection. Send `{}` to make a single call with a sample test case.",
        "title": "Ping AI Connection Request"
      },
      "Policy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the policy, generated by Confident AI.",
            "example": "<POLICY-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the policy.",
            "example": "Billing read-only"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the policy is for, or `null` when it has no description.",
            "example": "Lets a role read invoices and model costs, but change neither."
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PolicyPermission"
            },
            "description": "The permissions this policy grants."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "permissions"
        ],
        "description": "A named set of permissions owned by an organization or by a project. A policy is attached to roles of the same scope, never to a member directly, so it only grants anything once a role that holds it is assigned to someone.",
        "title": "Policy"
      },
      "PolicyList": {
        "type": "object",
        "properties": {
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Policy"
            },
            "description": "The custom policies the organization or project owns."
          }
        },
        "required": [
          "policies"
        ],
        "description": "The policies available to attach to the roles of the same organization or project.",
        "title": "Policy List"
      },
      "PolicyPermission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the permission, generated by Confident AI.",
            "example": "<PERMISSION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The permission, written as `resource:action` — the resource it applies to, then what it allows on it.",
            "example": "billing:read"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "A permission granted by a policy. Its `name` is a `resource:action` pair such as `billing:read` or `dataset:read`; the permissions endpoint of the same scope (`GET /v2/organization/permissions` or `GET /v2/projects/{projectId}/permissions`) lists every pair a policy there can grant.",
        "title": "Policy Permission"
      },
      "PolicyRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the policy that was deleted.",
            "example": "<POLICY-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that the policy no longer exists.",
        "title": "Policy Ref"
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the project, generated by Confident AI.",
            "example": "<PROJECT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the project, unique within the organization.",
            "example": "Customer Support Agent"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the project covers, or `null` when it has no description.",
            "example": "The support chatbot serving acme.com."
          },
          "organizationId": {
            "type": "string",
            "description": "The id of the organization the project belongs to.",
            "example": "<ORGANIZATION-ID>"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the project was created.",
            "example": "2025-01-14T09:30:00.000Z"
          },
          "governancePolicy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectGovernancePolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "The governance policy the project is enrolled in, or `null` when it is not enrolled."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "organizationId",
          "created_at",
          "governancePolicy"
        ],
        "description": "A workspace inside your organization. A project owns its own API keys, members, datasets, prompts, metrics and traces, and every project-scoped endpoint reads and writes within exactly one of them.",
        "title": "Project"
      },
      "ProjectDefaultApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key, generated by Confident AI. Pass it as `apiKeyId` when deactivating or rotating the key.",
            "example": 1041
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The label the key is listed under.",
            "example": "Default Key"
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the key is active. A deactivated key is rejected on authentication.",
            "example": true
          },
          "value": {
            "type": "string",
            "description": "The full, unmasked key. This is the only response that ever carries it — every later read of this key redacts it to its last six characters — so store it now.",
            "example": "confident_us_proj_KZ0m8vQ2sVxT1bR4dYnJ6hLpA3wUcE9f"
          },
          "shadowValue": {
            "type": [
              "string",
              "null"
            ],
            "description": "The replacement value while a rotation's grace period is running. Always `null` on a freshly provisioned key, since nothing has been rotated yet.",
            "example": null
          },
          "rotatesAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a pending rotation completes and `shadowValue` replaces `value`, or `null` when no rotation is pending.",
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the key was created.",
            "example": "2025-01-14T09:30:00.000Z"
          },
          "lastUsed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the key was last used to authenticate, or `null` if it has never been used.",
            "example": null
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the key expires, or `null` if it never expires. A provisioned key never expires; create your own key with `expiresInDays` if you want one that does.",
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "valid",
          "value",
          "shadowValue",
          "rotatesAt",
          "created_at",
          "lastUsed",
          "expiresAt"
        ],
        "description": "The project-scoped API key provisioned alongside a new project, returned with its full value exactly once. This is the key an SDK config gets, and it is the credential the project's own data endpoints authenticate with — the organization key you created the project with cannot reach them.",
        "title": "Project Default API Key"
      },
      "ProjectGovernancePolicy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the governance policy, generated by Confident AI.",
            "example": "<GOVERNANCE-POLICY-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the governance policy.",
            "example": "EU AI Act"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "The governance policy a project is enrolled in, named rather than resolved. Retrieve the policy itself to see the controls it enforces.",
        "title": "Project Governance Policy"
      },
      "ProjectInvitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the invitation, generated by Confident AI.",
            "example": 42
          },
          "email": {
            "type": "string",
            "description": "The email address the invitation was sent to, lowercased when it was created.",
            "example": "jane@acme.com"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the invitation was issued, as an ISO 8601 datetime. Resending an invitation stamps this again.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "projectRoleId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the project role the invitee lands on when they accept, or `null` to give them the default `Member` role.",
            "example": "<PROJECT-ROLE-ID>"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "The token embedded in the invitee's invite link, returned unmasked. Anyone holding it can accept the invitation as the invited email address, so treat it as a secret. It is replaced whenever the invitation is resent, which invalidates any link sent earlier. It is `null` when the invitation has no token stored, in which case its link only points the invitee at signup.",
            "example": "<INVITATION-TOKEN>"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "created_at",
          "projectRoleId",
          "token"
        ],
        "description": "A standing offer of access to one project. Accepting one adds the invitee to the project and, if they are not in it yet, to the organization the project belongs to.",
        "title": "Project Invitation"
      },
      "ProjectInvitationList": {
