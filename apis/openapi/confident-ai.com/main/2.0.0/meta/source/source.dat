          }
        },
        "required": [
          "controls",
          "totalGovernancePolicyControls"
        ],
        "description": "The controls a governance policy applies, as they stand after the call.",
        "title": "Governance Policy Control List"
      },
      "GovernancePolicyControlSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the governance control.",
