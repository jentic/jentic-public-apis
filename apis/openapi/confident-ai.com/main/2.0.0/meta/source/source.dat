    "/v2/organization/policies/{policyId}": {
      "put": {
        "operationId": "updateOrganizationPolicy",
        "summary": "Update Organization Policy",
        "description": "Replaces an organization policy's name, description, and granted permissions. The change reaches people through the roles the policy is attached to, and it reaches them immediately: every member holding any of those roles gains or loses the affected permissions on their next call.",
        "tags": [
          "organization"
        ],
        "parameters": [
          {
            "name": "policyId",
