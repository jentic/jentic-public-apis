      "put": {
        "operationId": "updateTransformer",
        "summary": "Update Transformer",
        "description": "Renames a transformer, changes its description, or replaces its code, and returns it. Sending `codeDefinition` overwrites the stored code, which every AI connection and metric collection already using this transformer picks up on its next run.",
