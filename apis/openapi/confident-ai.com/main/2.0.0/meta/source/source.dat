    "/v2/metrics-data": {
      "get": {
        "operationId": "listMetricData",
        "summary": "List Metric Data",
        "description": "Lists every metric result in your Confident AI project one page at a time, newest first, across all evaluations on traces, spans, threads and test cases.",
        "tags": [
          "metrics-data"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page of metric data to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of results per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Returns only results recorded at or after this ISO 8601 datetime.",
            "example": "2025-01-01T00:00:00Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "Returns only results recorded before this ISO 8601 datetime.",
            "example": "2025-01-31T23:59:59Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "multiTurn",
            "in": "query",
            "required": false,
            "description": "Filter for results evaluated on your test case type, `true` for multi-turn, `false` for single-turn. Returns both if not specified.",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "description": "Returns only results whose metric name contains this text, case-insensitively.",
            "example": "Answer Relevancy",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Metric Data succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/MetricDataList"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
