        "title": "Governance Project List"
      },
      "GovernanceProjectPortfolio": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "How many projects your organization has in total.",
            "example": 12
          },
          "healthy": {
            "type": "integer",
            "description": "How many projects have no failing control.",
            "example": 7
          },
          "needsAttention": {
            "type": "integer",
            "description": "How many projects have failing controls but a pass rate at or above the healthy threshold.",
