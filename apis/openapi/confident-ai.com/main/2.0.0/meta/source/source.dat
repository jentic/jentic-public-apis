        "title": "Project List"
      },
      "ProjectMember": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the user.",
            "example": "<USER-ID>"
          },
          "email": {
            "type": "string",
            "description": "This is the email address of the user.",
            "example": "jane@acme.com"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the display name of the user, or `null` when they have not set one.",
            "example": "Jane Doe"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the URL of the user's avatar, or `null` when they have none.",
            "example": null
          },
          "projectRole": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemberRole"
              },
              {
                "type": "null"
              }
            ],
            "description": "The role this member holds in the project, or `null` when they are attached to the project without one."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "image",
          "projectRole"
        ],
        "description": "A user who belongs to this project, with the role that decides what they can do inside it. Every project member is also a member of the project's organization, but the reverse does not hold.",
        "title": "Project Member"
      },
      "ProjectMemberList": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectMember"
            },
            "description": "The project's members for the current page."
          },
          "totalProjectMembers": {
            "type": "integer",
            "description": "The total number of members in the project, across every page.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of members per page.",
            "example": 25
          }
        },
        "required": [
          "members",
          "totalProjectMembers",
          "page",
          "pageSize"
        ],
        "description": "One page of project members, with the total across all pages.",
        "title": "Project Member List"
      },
      "ProjectModel": {
        "type": "object",
        "properties": {
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Model"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model in effect for the project, or `null` when nothing has been configured for that type — which for `PLATFORM` and `SIMULATION` means neither the project nor the organization has set one."
          },
          "source": {
            "$ref": "#/components/schemas/ModelSource"
          }
        },
        "required": [
          "model",
          "source"
        ],
        "description": "The model the project actually runs for one type, whether that is its own override or the organization's default.",
        "title": "Project Model"
      },
      "ProjectRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the project that was deleted.",
            "example": "<PROJECT-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that the project was deleted.",
        "title": "Delete Project Result"
      },
      "ProjectRole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the role, generated by Confident AI.",
            "example": "<ROLE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the role.",
            "example": "Release Manager"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the role is for, or `null` when it has no description.",
            "example": "Can publish prompts and run evaluations, but not delete data."
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePolicy"
            },
            "description": "The project policies attached to the role, whose permissions together are everything a member holding it can do in the project. A global role's permissions are system-defined rather than drawn from policies, so its list is empty."
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The id of the project that owns the role, or `null` for a global, system-defined role that every project can assign.",
            "example": "<PROJECT-ID>"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "policies",
          "projectId"
        ],
        "description": "A named set of project policies that a project member can hold. A member holds at most one role per project, and every permission they have in that project comes from the policies attached to it.",
        "title": "Project Role"
      },
      "ProjectRoleList": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectRole"
            },
            "description": "The roles this project can assign: the roles it owns, plus the global, system-defined roles available to every project."
          }
        },
        "required": [
          "roles"
        ],
        "description": "Every project role a member can be given in this project, owned and global together.",
        "title": "Project Role List"
      },
      "ProjectSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the project, generated by Confident AI.",
            "example": "<PROJECT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the project, unique within the organization.",
            "example": "Customer Support Agent"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the project covers, or `null` when it has no description.",
            "example": "The support chatbot serving acme.com."
          },
          "organizationId": {
            "type": "string",
            "description": "The id of the organization the project belongs to.",
            "example": "<ORGANIZATION-ID>"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the project was created.",
            "example": "2025-01-14T09:30:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "organizationId",
          "created_at"
        ],
        "description": "A project's own fields, without its governance enrollment. This is the shape create returns, where the project cannot yet be enrolled in a policy.",
        "title": "Project Summary"
      },
      "Prompt": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/TextPrompt"
          },
          {
            "$ref": "#/components/schemas/MessagesPrompt"
          }
        ],
        "description": "A single commit of a prompt, as pulled by version, commit hash, or label. It carries `text` when the prompt is a text prompt and `messages` when it is a messages prompt, never both."
      },
      "PromptBranch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the prompt branch.",
            "example": "<BRANCH-ID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the prompt branch.",
            "example": "experiment"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PromptBranchList": {
        "type": "object",
        "properties": {
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptBranch"
            },
            "description": "This is the list of branches on the prompt."
          }
        },
        "required": [
          "branches"
        ]
      },
      "PromptBranchRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the prompt branch.",
            "example": "<BRANCH-ID>"
          }
        },
        "required": [
          "id"
        ]
      },
      "PromptCommit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of a commit generated by Confident AI, not to be confused with the prompt id or the commit hash.",
            "example": "<COMMIT-ID>"
          },
          "hash": {
            "type": "string",
            "description": "The hash of a commit generated by Confident AI.",
            "example": "bab04ce"
          },
          "message": {
            "type": "string",
            "description": "The message associated with a commit, not to be confused with a prompt's messages.",
            "example": "Committed from API"
          }
        },
        "required": [
          "id",
          "hash",
          "message"
        ]
      },
      "PromptCommitList": {
        "type": "object",
        "properties": {
          "commits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptCommit"
            },
            "description": "This is the list of commits on the prompt, newest first."
          }
        },
        "required": [
          "commits"
        ]
      },
      "PromptHyperparameter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the prompt version the run used.",
            "example": "<PROMPT-VERSION-ID>"
          },
          "type": {
            "$ref": "#/components/schemas/PromptType"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "description": "A reference to the prompt version the run used.",
        "title": "Prompt Hyperparameter"
      },
      "PromptInterpolationType": {
        "type": "string",
        "enum": [
          "MUSTACHE",
          "MUSTACHE_WITH_SPACE",
          "FSTRING",
          "DOLLAR_BRACKETS",
          "JINJA"
        ],
        "description": "The type of interpolation format used in the prompt to insert dynamic variables."
      },
      "PromptList": {
        "type": "object",
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptSummary"
            },
            "description": "This is the list of prompts in your project."
          }
        },
        "required": [
          "prompts"
        ]
      },
      "PromptMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "This is the role of the message, which can be user, assistant, system, or developer.",
            "example": "user"
          },
          "content": {
            "type": "string",
            "description": "This is the text content of the message.",
            "example": "Hello, {{name}}! How can I help you today?"
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptMessageToolCall"
            },
            "description": "Tool calls made by an assistant message, in the OpenAI chat format."
          },
          "tool_call_id": {
            "type": "string",
            "description": "For tool messages, the id of the assistant tool call this result answers.",
            "example": "call_abc123"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "PromptMessageToolCall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "call_abc123"
          },
          "type": {
            "type": "string",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "get_weather"
              },
              "arguments": {
                "type": "string",
                "description": "JSON-encoded arguments passed to the tool.",
                "example": "{\"city\":\"London\"}"
              }
            },
            "required": [
              "name",
              "arguments"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "function"
        ]
      },
      "PromptMetricConfig": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ],
                  "description": "Who the message is from. A system message is only allowed first."
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The message text. Use `{{name}}` to insert a mapped variable."
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "description": "The judge prompt, as one or more messages."
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "input",
                    "output",
                    "metadata",
                    "tools_called"
                  ],
                  "description": "The part of the trace or span the variable reads."
                },
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "description": "Steps into the field: a string reads a key, a number reads a list item (`-1` is the last), and `*` reads every item. An empty path uses the whole field."
                }
              },
              "required": [
                "field",
                "path"
              ],
              "additionalProperties": false
            },
            "description": "Maps every `{{name}}` used in the messages to the data it is filled with."
          }
        },
        "required": [
          "messages",
          "variables"
        ],
        "additionalProperties": false,
        "description": "The judge prompt of a `PROMPT` metric, and how its variables are filled. The judge scores from 0 to 10 and the score is normalized to 0 to 1.",
        "title": "Prompt Metric Config",
        "example": {
          "messages": [
            {
              "role": "system",
              "content": "You grade support answers."
            },
            {
              "role": "user",
              "content": "QUESTION: {{question}}\nANSWER: {{answer}}"
            }
          ],
          "variables": {
            "question": {
              "field": "input",
              "path": [
                "messages",
                0,
                "content"
              ]
            },
            "answer": {
              "field": "output",
              "path": [
                "messages",
                -1,
                "content"
              ]
            }
          }
        }
      },
      "PromptOutputType": {
        "type": "string",
        "enum": [
          "TEXT",
          "JSON",
          "SCHEMA"
        ],
        "description": "The type of output expected from the prompt."
      },
      "PromptSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the prompt.",
            "example": "<PROMPT-ID>"
          },
          "alias": {
            "type": "string",
            "description": "This is the alias of the prompt, which is unique within your project.",
            "example": "greeting"
          },
          "type": {
            "$ref": "#/components/schemas/PromptType"
          }
        },
        "required": [
          "id",
          "alias",
          "type"
        ],
        "description": "A prompt as it appears in your project's prompt list, without any version content."
      },
      "PromptType": {
        "type": "string",
        "enum": [
          "TEXT",
          "LIST"
        ],
        "description": "This is the type of the prompt, which can be either a simple text or a list of messages."
      },
      "PromptVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the prompt version generated by Confident AI, not to be confused with the version number.",
            "example": "<PROMPT-VERSION-ID>"
          },
          "version": {
            "type": "string",
            "description": "This is the version number of the prompt version.",
            "example": "00.00.01"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "PromptVersionList": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptVersion"
            },
            "description": "This is the list of versions released for the prompt, oldest first."
          },
          "type": {
            "$ref": "#/components/schemas/PromptType"
          }
        },
        "required": [
          "versions",
          "type"
        ]
      },
      "PushDatasetRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "The alias of the dataset, unique within your project. A new dataset is created when no dataset with this alias exists.",
            "example": "capitals"
          },
          "finalized": {
            "type": "boolean",
            "default": true,
            "description": "Whether the goldens pushed are finalized, that is ready to use in evaluations. Applies to every golden in this request.",
            "example": true
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The dataset version to push the goldens onto, for example `00.00.01`. When the dataset has versions, omitting it pushes to the latest version; when it has none, omitting it leaves the goldens unversioned. A version cannot be given for a dataset that does not exist yet. Requires the Team plan or above.",
            "example": "00.00.01"
          },
          "goldens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PushGolden"
            },
            "minItems": 1,
            "description": "The goldens to push. A golden carrying an `id` updates the golden already in the dataset; one without is added. Every golden in one request must be of the same kind — all single-turn, or all multi-turn — and match the dataset's `multiTurn`. A new dataset takes its kind from them."
          }
        },
        "required": [
          "alias",
          "goldens"
        ],
        "additionalProperties": false,
        "description": "Goldens to write to the dataset with the given `alias`, creating the dataset first when it does not exist. Goldens carrying an `id` are updated in place, so a pulled dataset can be edited and pushed back without duplicating it."
      },
      "PushGolden": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/PushSingleTurnGolden"
          },
          {
            "$ref": "#/components/schemas/PushMultiTurnGolden"
          }
        ],
        "description": "One golden to push: single-turn when it carries `input`, multi-turn when it carries `scenario`. A golden cannot be both, and its kind must match the dataset's `multiTurn`. Carrying an `id` updates that golden instead of adding one."
      },
      "PushMessagesPrompt": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptMessage"
            },
            "minItems": 1,
            "description": "The list of messages that make up the prompt.",
            "example": [
              {
                "role": "system",
                "content": "You are a helpful assistant."
              },
              {
                "role": "user",
                "content": "Hello, {{name}}! How can I help you today?"
              }
            ]
          },
          "alias": {
            "type": "string",
            "description": "The alias of the prompt, unique within your project. A new prompt is created when no prompt with this alias exists.",
            "example": "greeting"
          },
          "interpolationType": {
            "$ref": "#/components/schemas/PromptInterpolationType"
          },
          "modelSettings": {
            "$ref": "#/components/schemas/ModelSettings"
          },
          "outputType": {
            "$ref": "#/components/schemas/PromptOutputType"
          },
          "outputSchema": {
            "$ref": "#/components/schemas/OutputSchema"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "description": "This is the list of tools to make available to the prompt."
          },
          "branch": {
            "type": "string",
            "default": "main",
            "description": "The name of the branch to push the new commit to. The branch is created from `main` when it does not exist yet.",
            "example": "main"
          }
        },
        "required": [
          "messages",
          "alias"
        ],
        "additionalProperties": false,
        "description": "Pushes a commit to a messages prompt. `interpolationType` defaults to `FSTRING` when omitted.",
        "title": "Push Messages Prompt"
      },
      "PushMultiTurnGolden": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "This is a description of the conversation context.",
            "example": "A traveller wants to book a hotel in Paris."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "This describes the expected outcome, or ideal conversation flow, of the conversation.",
            "example": "The assistant confirms a reservation near the Louvre."
          },
          "userDescription": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the description of the user in the conversation.",
            "example": "A traveller planning a weekend in Paris."
          },
          "turns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "description": "This is the list of turns in the conversation.",
            "example": [
              {
                "role": "user",
                "content": "I need a hotel in Paris near the Louvre."
              },
              {
                "role": "assistant",
                "content": "Hôtel du Louvre has rooms available. Which dates?"
              }
            ]
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the context of the conversation.",
            "example": [
              "Hôtel du Louvre is a five-minute walk from the museum."
            ]
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Additional metadata to associate with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "What the LLM system must and must not do for this golden. Omit it to leave stored expectations unchanged, or send null to clear them.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comments to associate with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source file the golden was retrieved from. Like `tags` and `customColumnKeyValues`, this is left unchanged when the request omits it; send `null` to clear it.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The source files the golden was retrieved from. Like `tags` and `customColumnKeyValues`, these are left unchanged when the request omits them; send an empty array to clear them.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "default": true,
            "description": "Whether the golden is ready to use in evaluations. When pushing or queueing a list of goldens the request decides this for every golden and this field is ignored.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom dataset column values keyed by column name. A column that does not exist in the dataset yet is created.",
            "example": {
              "difficulty": "easy"
            }
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "The media this golden refers to, keyed by the id inside each placeholder. Put `[DEEPEVAL:IMAGE:<id>]` or `[DEEPEVAL:PDF:<id>]` in a text field where the media belongs, and the platform substitutes the entry with a matching key.",
            "example": {
              "map": {
                "url": "https://example.com/paris.png",
                "local": false
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags to associate with the golden, which is useful for grouping and filtering goldens. A tag that does not exist in the dataset yet is created.",
            "example": [
              "geography"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id of a golden already in this dataset, as returned when the dataset is pulled. That golden is updated in place, staying in the version it is already in. Omit it to add a new golden.",
            "example": "<GOLDEN-ID>"
          }
        },
        "required": [
          "scenario"
        ],
        "additionalProperties": false,
        "description": "A multi-turn golden to push: the scenario of a conversation with your LLM application and, optionally, its turns, updating the golden named by `id` when there is one.",
        "title": "Push Multi-Turn Golden"
      },
      "PushPromptRequest": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/PushTextPrompt"
          },
          {
            "$ref": "#/components/schemas/PushMessagesPrompt"
          }
        ],
        "description": "The commit to push. Send `text` for a text prompt or `messages` for a messages prompt, never both. The kind must match the existing prompt's type."
      },
      "PushPromptResult": {
        "type": "object",
        "properties": {
          "promptId": {
            "type": "string",
            "description": "This is the id of the prompt generated by Confident AI, not to be confused with the alias you supplied.",
            "example": "<PROMPT-ID>"
          },
          "hash": {
            "type": "string",
            "description": "This is the hash of the commit created by this push, not to be confused with a version number.",
            "example": "bab04ce"
          }
        },
        "required": [
          "promptId",
          "hash"
        ]
      },
      "PushSingleTurnGolden": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "This is the input to your LLM application.",
            "example": "What is the capital of France?"
          },
          "actualOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the actual output of your LLM application.",
            "example": "The capital of France is Paris."
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the expected output of your LLM application, which is the ideal actual output.",
            "example": "Paris."
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your LLM application.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your LLM application.",
            "example": [
              "Paris is the capital and largest city of France."
            ]
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your LLM application."
          },
          "expectedTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the LLM application."
          },
          "tokenCost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "This is the cost of the tokens used to produce the actual output.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 12
          },
          "outputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 3
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Additional metadata to associate with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "What the LLM system must and must not do for this golden. Omit it to leave stored expectations unchanged, or send null to clear them.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comments to associate with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source file the golden was retrieved from. Like `tags` and `customColumnKeyValues`, this is left unchanged when the request omits it; send `null` to clear it.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The source files the golden was retrieved from. Like `tags` and `customColumnKeyValues`, these are left unchanged when the request omits them; send an empty array to clear them.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "default": true,
            "description": "Whether the golden is ready to use in evaluations. When pushing or queueing a list of goldens the request decides this for every golden and this field is ignored.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom dataset column values keyed by column name. A column that does not exist in the dataset yet is created.",
            "example": {
              "difficulty": "easy"
            }
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "The media this golden refers to, keyed by the id inside each placeholder. Put `[DEEPEVAL:IMAGE:<id>]` or `[DEEPEVAL:PDF:<id>]` in a text field where the media belongs, and the platform substitutes the entry with a matching key.",
            "example": {
              "map": {
                "url": "https://example.com/paris.png",
                "local": false
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags to associate with the golden, which is useful for grouping and filtering goldens. A tag that does not exist in the dataset yet is created.",
            "example": [
              "geography"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id of a golden already in this dataset, as returned when the dataset is pulled. That golden is updated in place, staying in the version it is already in. Omit it to add a new golden.",
            "example": "<GOLDEN-ID>"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false,
        "description": "A single-turn golden to push: one input to your LLM application and the outputs expected of it, updating the golden named by `id` when there is one.",
        "title": "Push Single-Turn Golden"
      },
      "PushTextPrompt": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text content of the prompt.",
            "example": "Hello, {{name}}! How can I help you today?"
          },
          "alias": {
            "type": "string",
            "description": "The alias of the prompt, unique within your project. A new prompt is created when no prompt with this alias exists.",
            "example": "greeting"
          },
          "interpolationType": {
            "$ref": "#/components/schemas/PromptInterpolationType"
          },
          "modelSettings": {
            "$ref": "#/components/schemas/ModelSettings"
          },
          "outputType": {
            "$ref": "#/components/schemas/PromptOutputType"
          },
          "outputSchema": {
            "$ref": "#/components/schemas/OutputSchema"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "description": "This is the list of tools to make available to the prompt."
          },
          "branch": {
            "type": "string",
            "default": "main",
            "description": "The name of the branch to push the new commit to. The branch is created from `main` when it does not exist yet.",
            "example": "main"
          }
        },
        "required": [
          "text",
          "alias"
        ],
        "additionalProperties": false,
        "description": "Pushes a commit to a text prompt. `interpolationType` defaults to `FSTRING` when omitted.",
        "title": "Push Text Prompt"
      },
      "QueueDatasetGoldensRequest": {
        "type": "object",
        "properties": {
          "goldens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoldenRequest"
            },
            "minItems": 1,
            "description": "The goldens to queue for review. Every golden in one request must be of the same kind and match the dataset's `multiTurn`. They are stored unfinalized, whatever each golden's own `finalized` says."
          }
        },
        "required": [
          "goldens"
        ],
        "additionalProperties": false
      },
      "QueueIngestionTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the task, generated by Confident AI.",
            "example": "<QUEUE-INGESTION-TASK-ID>"
          },
          "annotationQueueId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The queue the task fills, which is also the queue it is addressed under. Null for a recurring task that creates a queue of its own each period.",
            "example": "<ANNOTATION-QUEUE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the task.",
            "example": "Failed capital lookups"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the task harvests.",
            "example": "Traces where the assistant failed to name a capital."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task is running.",
            "example": true
          },
          "sampleRate": {
            "type": "number",
            "description": "The fraction of matching items the task queues.",
            "example": 0.1
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ],
            "description": "The filters an item must match to be queued, or `null` when every item of the data model qualifies."
          },
          "maxItems": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The maximum number of items this task will queue, or `null` when it is uncapped.",
            "example": 500
          },
          "assignmentStrategy": {
            "$ref": "#/components/schemas/AssignmentStrategy"
          },
          "reviewers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserReference"
            },
            "description": "The project members harvested items are assigned to, in the order the strategy deals them out."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was last changed.",
            "example": "2025-01-16T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "annotationQueueId",
          "name",
          "description",
          "enabled",
          "sampleRate",
          "dataModel",
          "filters",
          "maxItems",
          "assignmentStrategy",
          "reviewers",
          "createdAt",
          "updatedAt"
        ],
        "description": "A rule that keeps an annotation queue filled from your production data.",
        "title": "Queue Ingestion Task"
      },
      "QueueIngestionTaskList": {
        "type": "object",
        "properties": {
          "queueIngestionTasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueIngestionTaskSummary"
            },
            "description": "The tasks filling this queue, newest first."
          }
        },
        "required": [
          "queueIngestionTasks"
        ],
        "description": "The ingestion tasks filling an annotation queue.",
        "title": "Queue Ingestion Task List"
      },
      "QueueIngestionTaskRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the task, generated by Confident AI.",
            "example": "<QUEUE-INGESTION-TASK-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a queue ingestion task by its id.",
        "title": "Queue Ingestion Task Ref"
      },
      "QueueIngestionTaskSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the task, generated by Confident AI.",
            "example": "<QUEUE-INGESTION-TASK-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the task.",
            "example": "Failed capital lookups"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task is running.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "dataModel"
        ],
        "description": "A task as it appears in a list: what it harvests and whether it is running, without its filters or reviewers.",
        "title": "Queue Ingestion Task Summary"
      },
      "QueueItemAnnotation": {
        "type": "object",
        "properties": {
          "fieldType": {
            "type": "string",
            "enum": [
              "THUMBS_RATING",
              "FIVE_STAR_RATING"
            ],
            "description": "The kind of rating. Defaults to `THUMBS_RATING`."
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The rating to record: `true` or `false` for a `THUMBS_RATING`, 1 to 5 for a `FIVE_STAR_RATING`.",
            "example": true
          },
          "name": {
            "type": "string",
            "description": "A name for what this rating is for. On a queue with a form, it matches a rating field's label; on a queue without one, omit it for the default rating.",
            "example": "Helpfulness"
          },
          "explanation": {
            "type": "string",
            "description": "Why the rating was given.",
            "example": "Answered the question and cited the right source."
          },
          "expectedOutput": {
            "type": "string",
            "description": "The output the target should have produced. Only for an item holding a trace or span.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "expectedOutcome": {
            "type": "string",
            "description": "The outcome the conversation should have reached. Only for an item holding a thread.",
            "example": "The user learns how tall Mount Everest is."
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "Images referenced by `[DEEPEVAL:IMAGE:<key>]` markers in the text fields, keyed by that marker's key."
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false,
        "description": "One rating, as an annotator would leave it on the item. `fieldType` defaults to `THUMBS_RATING`.",
        "title": "Queue Item Annotation"
      },
      "QueueItemFormResponse": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The label of the form field being answered, exactly as the form spells it.",
            "example": "How helpful was the answer?"
          },
          "value": {
            "description": "The annotation value, in the shape the field's type expects: a string for `TEXT`, a number for `NUMBER` or `FLOAT`, a boolean for `BOOLEAN`, one of the options in the field's `config` for `CHOICE`, and a list of them for `MULTIPLE_CHOICE`.",
            "example": "Very helpful"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "One annotation on a field of the queue's annotation form.",
        "title": "Queue Item Form Response"
      },
      "QueueItemStatus": {
        "type": "string",
        "enum": [
          "IN_PROGRESS",
          "DRAFT",
          "DEFERRED",
          "COMPLETED"
        ],
        "description": "Where an item stands in the review: `IN_PROGRESS` before work starts, `DRAFT` after work is autosaved but before it is submitted, `DEFERRED` once a reviewer has set it aside to come back to, and `COMPLETED` once it has been submitted.",
        "title": "Queue Item Status"
      },
