              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/GovernancePolicySkill"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/organization/<ORGANIZATION-ID>/governance/policies/<GOVERNANCE-POLICY-ID>"
