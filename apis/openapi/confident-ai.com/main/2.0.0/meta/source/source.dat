          },
          "actualOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the actual output of your LLM application.",
            "example": "The capital of France is Paris."
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the expected output of your LLM application, which is the ideal actual output.",
            "example": "Paris."
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your LLM application.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your LLM application.",
            "example": [
              "Paris is the capital and largest city of France."
            ]
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your LLM application."
          },
          "expectedTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the LLM application."
          },
          "tokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the cost of the tokens used to produce the actual output.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 12
          },
          "outputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 3
          },
          "id": {
            "type": "string",
            "description": "The id of the golden assigned by Confident AI. Use it to get, update or delete this golden.",
            "example": "<GOLDEN-ID>"
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "These are what the LLM system must and must not do for this golden.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is any comments associated with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the source file from which the golden was retrieved.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "These are the source files the golden was retrieved from.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "description": "This is `true` when the golden is finalized and ready to use in evaluations.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-value pairs representing custom table column data for this golden. Keys correspond to the custom column keys defined in the dataset. Absent when the golden has no custom column values.",
            "example": {
              "difficulty": "easy"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "These are the tags associated with the golden.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "input",
          "actualOutput",
          "expectedOutput",
          "context",
          "retrievalContext",
          "toolsCalled",
          "expectedTools",
          "tokenCost",
          "inputTokenCount",
          "outputTokenCount",
          "id",
          "additionalMetadata",
          "expectations",
          "comments",
          "sourceFile",
          "sourceFiles",
          "finalized",
          "tags"
        ],
        "additionalProperties": false,
        "description": "A single-turn golden as stored in the dataset.",
        "title": "Single-Turn Golden"
      },
      "SingleTurnGoldenRequest": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "This is the input to your LLM application.",
            "example": "What is the capital of France?"
          },
          "actualOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the actual output of your LLM application.",
            "example": "The capital of France is Paris."
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the expected output of your LLM application, which is the ideal actual output.",
            "example": "Paris."
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your LLM application.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your LLM application.",
            "example": [
              "Paris is the capital and largest city of France."
            ]
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your LLM application."
          },
          "expectedTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the LLM application."
          },
          "tokenCost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "This is the cost of the tokens used to produce the actual output.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 12
          },
          "outputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 3
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Additional metadata to associate with the golden.",
            "example": {
              "source": "faq"
            }
          },
          "expectations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mustNot": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "must",
              "mustNot"
            ],
            "description": "What the LLM system must and must not do for this golden. Omit it to leave stored expectations unchanged, or send null to clear them.",
            "example": {
              "must": [
                "Cite a source"
              ],
              "mustNot": [
                "Mention competitors"
              ]
            }
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comments to associate with the golden.",
            "example": "Reviewed by the support team."
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source file the golden was retrieved from. Like `tags` and `customColumnKeyValues`, this is left unchanged when the request omits it; send `null` to clear it.",
            "example": "capitals.csv"
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The source files the golden was retrieved from. Like `tags` and `customColumnKeyValues`, these are left unchanged when the request omits them; send an empty array to clear them.",
            "example": [
              "capitals.csv"
            ]
          },
          "finalized": {
            "type": "boolean",
            "default": true,
            "description": "Whether the golden is ready to use in evaluations. When pushing or queueing a list of goldens the request decides this for every golden and this field is ignored.",
            "example": true
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom dataset column values keyed by column name. A column that does not exist in the dataset yet is created.",
            "example": {
              "difficulty": "easy"
            }
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "The media this golden refers to, keyed by the id inside each placeholder. Put `[DEEPEVAL:IMAGE:<id>]` or `[DEEPEVAL:PDF:<id>]` in a text field where the media belongs, and the platform substitutes the entry with a matching key.",
            "example": {
              "map": {
                "url": "https://example.com/paris.png",
                "local": false
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags to associate with the golden, which is useful for grouping and filtering goldens. A tag that does not exist in the dataset yet is created.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false,
        "description": "A single-turn golden to write: one input to your LLM application and the outputs expected of it.",
        "title": "Single-Turn Golden Request"
      },
      "SingleTurnTestCase": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "This is the input to your LLM application.",
            "example": "How tall is mount everest?"
          },
          "actualOutput": {
            "type": "string",
            "description": "This is the actual output of your LLM application.",
            "example": "No clue, pretty tall I guess?"
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your LLM application, which is the ideal actual output.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your LLM application.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your LLM application."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the LLM application."
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your LLM application.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "tokenCost": {
            "type": "number",
            "minimum": 0,
            "description": "This is the cost of the tokens used by the LLM model.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 24
          },
          "outputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 12
          },
          "name": {
            "type": "string",
            "description": "This is the name of your test case, it allows you to search and match test cases across different test runs.",
            "example": "everest-height"
          },
          "flaky": {
            "type": "boolean",
            "description": "This is `true` if the test case's verdict was non-deterministic across runs.",
            "example": false
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "This is the mapping of image placeholders in your test case to the images they refer to.",
            "example": {
              "summit": {
                "url": "https://example.com/everest.png",
                "local": false
              }
            }
          },
          "additionalMetadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "Additional metadata associated with this test case.",
            "example": {
              "region": "Nepal"
            }
          },
          "customColumnKeyValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "This is the custom column key values of the LLM application.",
            "example": {
              "team": "search"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the list of tags associated with the test case, which is useful for grouping and filtering for test cases.",
            "example": [
              "geography"
            ]
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false,
        "description": "A test case for a single exchange with your LLM application.",
        "title": "Single-Turn Test Case"
      },
      "SipCredentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The SIP digest username.",
            "example": "confident"
          },
          "password": {
            "type": "string",
            "description": "The SIP digest password.",
            "example": "YOUR-SIP-PASSWORD"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "description": "Digest credentials used to authenticate a SIP call.",
        "title": "SIP Credentials"
      },
      "SipVoiceConfig": {
        "type": "object",
        "properties": {
          "transport": {
            "type": "string",
            "enum": [
              "SIP"
            ]
          },
          "sipUri": {
            "type": "string",
            "description": "The sip: address of your agent.",
            "example": "sip:agent@sip.example.com"
          },
          "signalingTransport": {
            "type": "string",
            "enum": [
              "UDP",
              "TCP",
              "TLS"
            ],
            "description": "The transport used for SIP signaling. A `;transport=` parameter on `sipUri` takes precedence."
          },
          "credentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SipCredentials"
              },
              {
                "type": "null"
              }
            ],
            "description": "Credentials for your SIP endpoint, or null when it needs none."
          },
          "callerId": {
            "type": "string",
            "description": "The number or sip: address presented to your agent as the caller. Leave it empty to use the default.",
            "example": "+14155550199"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceHeader"
            },
            "description": "Extra `X-` headers sent on the INVITE, for routing on your side."
          }
        },
        "required": [
          "transport",
          "sipUri",
          "signalingTransport",
          "credentials",
          "callerId",
          "headers"
        ],
        "description": "Calls your agent's SIP address directly.",
        "title": "SIP Voice Config"
      },
      "SnowflakeExportDestinationConfig": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "description": "The Snowflake account identifier, as `<organization>-<account>`. A full `https://<account>.snowflakecomputing.com` URL is accepted and trimmed to the identifier.",
            "example": "myorg-myaccount"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "The Snowflake user Confident AI signs in as, ideally a `TYPE = SERVICE` user whose `RSA_PUBLIC_KEY` matches `privateKey`.",
            "example": "CONFIDENT_EXPORTER"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "The role loads run as. It needs USAGE on the warehouse, database and schema, and CREATE `TABLE` on the schema.",
            "example": "CONFIDENT_EXPORT_ROLE"
          },
          "warehouse": {
            "type": "string",
            "minLength": 1,
            "description": "The warehouse that runs each load.",
            "example": "CONFIDENT_WH"
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "description": "The database the export tables live in.",
            "example": "ANALYTICS"
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "description": "The schema Confident AI creates `CONFIDENT_TRACES` and `CONFIDENT_ANNOTATIONS` in.",
            "example": "CONFIDENT"
          },
          "privateKey": {
            "type": "string",
            "minLength": 1,
            "description": "The PEM private key paired with the user's `RSA_PUBLIC_KEY`. Reads return it masked, so a masked value is rejected here — send the real key.",
            "example": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"
          },
          "privateKeyPassphrase": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The passphrase of an encrypted private key. Omit it, or send `null`, for an unencrypted key.",
            "example": "correct-horse-battery-staple"
          }
        },
        "required": [
          "account",
          "username",
          "role",
          "warehouse",
          "database",
          "schema",
          "privateKey"
        ],
        "description": "How Confident AI signs in to Snowflake with key-pair authentication, and where it creates the export tables.",
        "title": "Snowflake Export Destination Config"
      },
      "SnowflakeExportDestinationMaskedConfig": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "description": "The Snowflake account identifier, as `<organization>-<account>`. A full `https://<account>.snowflakecomputing.com` URL is accepted and trimmed to the identifier.",
            "example": "myorg-myaccount"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "The Snowflake user Confident AI signs in as, ideally a `TYPE = SERVICE` user whose `RSA_PUBLIC_KEY` matches `privateKey`.",
            "example": "CONFIDENT_EXPORTER"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "The role loads run as. It needs USAGE on the warehouse, database and schema, and CREATE `TABLE` on the schema.",
            "example": "CONFIDENT_EXPORT_ROLE"
          },
          "warehouse": {
            "type": "string",
            "minLength": 1,
            "description": "The warehouse that runs each load.",
            "example": "CONFIDENT_WH"
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "description": "The database the export tables live in.",
            "example": "ANALYTICS"
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "description": "The schema Confident AI creates `CONFIDENT_TRACES` and `CONFIDENT_ANNOTATIONS` in.",
            "example": "CONFIDENT"
          },
          "privateKey": {
            "type": "string",
            "description": "The stored private key, masked: fifteen asterisks followed by its last six characters. Send this value back on an update to keep the stored key.",
            "example": "***************Y-----"
          },
          "privateKeyPassphrase": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stored passphrase, fully masked as fifteen asterisks, or `null` when the key is unencrypted. Send it back on an update to keep the stored passphrase.",
            "example": "***************"
          }
        },
        "required": [
          "account",
          "username",
          "role",
          "warehouse",
          "database",
          "schema",
          "privateKey",
          "privateKeyPassphrase"
        ],
        "description": "A Snowflake destination's settings with the private key and passphrase masked.",
        "title": "Snowflake Export Destination Masked Config"
      },
      "Span": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "This is the unique identifier of the span.",
            "example": "<SPAN-UUID>"
          },
          "traceUuid": {
            "type": "string",
            "description": "This is the uuid of the trace containing the span.",
            "example": "<TRACE-UUID>"
          },
          "parentUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the uuid of the parent span, or `null` for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "type": {
            "$ref": "#/components/schemas/SpanType"
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended.",
            "example": "2025-01-15T10:30:02.000Z"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the error string that caused the span to fail, or `null` when no error occurred.",
            "example": null
          },
          "integration": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the LLM provider used in an LLM span.",
            "example": "OpenAI"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the LLM model used in an LLM span.",
            "example": "gpt-4o"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the API endpoint the model was called through in an LLM span.",
            "example": null
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the span in `USD`, or `null` when it is not known.",
            "example": 0.00018
          },
          "inputTokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the input tokens passed to the LLM model in an LLM span.",
            "example": 0.00006
          },
          "outputTokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the output tokens generated by the LLM model in an LLM span.",
            "example": 0.00012
          },
          "costPerInputToken": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the cost per input token of the LLM model for an LLM span.",
            "example": 0.0000025
          },
          "costPerOutputToken": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the cost per output token of the LLM model for an LLM span.",
            "example": 0.00001
          },
          "inputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the total number of input tokens passed to the LLM model in an LLM span.",
            "example": 24
          },
          "outputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the total number of output tokens generated by the LLM model in an LLM span.",
            "example": 12
          },
          "promptAlias": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the alias of your prompt which is stored on Confident AI.",
            "example": "geography-assistant"
          },
          "promptVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the version assigned to your prompt on Confident AI.",
            "example": "00.00.01"
          },
          "promptLabel": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the label assigned to a specific version of prompt on the Confident AI platform.",
            "example": "production"
          },
          "promptCommitHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the hash of the current prompt being logged in the llm span.",
            "example": "bab04ce"
          },
          "embedder": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the embedder model used in a retriever span.",
            "example": null
          },
          "topK": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the top K chunks retrieved from your knowledge base in a retriever span.",
            "example": null
          },
          "chunkSize": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the chunk size of each retrieved context for a retriever span.",
            "example": null
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is a description if the span is a tool span.",
            "example": null
          },
          "agentHandoffs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the list of agent handoffs associated with an agent span.",
            "example": null
          },
          "availableTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the list of available tools associated with an agent span.",
            "example": null
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollectionName": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the metric collection to evaluate the span.",
            "example": "LLM Collection Name"
          },
          "input": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the input to the span. JSON inputs are serialized to a string.",
            "example": "What is the capital of France?"
          },
          "output": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the output of the span. JSON outputs are serialized to a string.",
            "example": "The capital of France is Paris."
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the expected output of your span, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your span, which is to be used for evaluation.",
            "example": null
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your span, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the span, which is to be used for evaluation."
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricData"
            },
            "description": "This is the metrics data associated with the span."
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnnotationSummary"
            },
            "description": "This is the list of annotations associated with the span."
          }
        },
        "required": [
          "uuid",
          "traceUuid",
          "parentUuid",
          "name",
          "type",
          "status",
          "startTime",
          "endTime",
          "error",
          "integration",
          "provider",
          "model",
          "endpoint",
          "cost",
          "inputTokenCost",
          "outputTokenCost",
          "costPerInputToken",
          "costPerOutputToken",
          "inputTokenCount",
          "outputTokenCount",
          "promptAlias",
          "promptVersion",
          "promptLabel",
          "promptCommitHash",
          "embedder",
          "topK",
          "chunkSize",
          "description",
          "agentHandoffs",
          "availableTools",
          "metadata",
          "metricCollectionName",
          "input",
          "output",
          "expectedOutput",
          "retrievalContext",
          "context",
          "toolsCalled",
          "expectedTools",
          "metricsData",
          "annotations"
        ],
        "description": "A span with its full input and output, evaluation fields, results and annotations."
      },
      "SpanAnnotationRequest": {
        "type": "object",
        "properties": {
          "spanUuid": {
            "type": "string",
            "format": "uuid",
            "description": "The uuid of the span being annotated.",
            "example": "9d2c6f7e-1a3b-4c5d-8e9f-0a1b2c3d4e5f"
          },
          "expectedOutput": {
            "type": "string",
            "description": "The output the span should have produced.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "fieldType": {
            "$ref": "#/components/schemas/AnnotationFieldType"
          },
          "value": {
            "$ref": "#/components/schemas/AnnotationValue"
          },
          "name": {
            "type": "string",
            "description": "A name for what this annotation is for. Omit it for the default annotation.",
            "example": "Helpfulness"
          },
          "explanation": {
            "type": "string",
            "description": "Why the annotation was given.",
            "example": "Answered the question and cited the right source."
          },
          "userId": {
            "type": "string",
            "description": "The id of the end user this annotation came from, when it was collected from your own users rather than your team.",
            "example": "end-user-42"
          },
          "imagesMapping": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MLLMImage"
            },
            "description": "Images referenced by `[DEEPEVAL:IMAGE:<key>]` markers in the text fields, keyed by that marker's key."
          }
        },
        "required": [
          "spanUuid",
          "value"
        ],
        "additionalProperties": false,
        "description": "An annotation left on a span.",
        "title": "Span Annotation Request"
      },
      "SpanList": {
        "type": "object",
        "properties": {
          "spans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpanSummary"
            },
            "description": "The list of spans for the current page."
          },
          "totalSpans": {
            "type": "integer",
            "description": "The total number of spans matching the query across all pages. Present on the first page only; omitted when a `cursor` is given.",
            "example": 1
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "The value to pass as `cursor` to get the next page, or `null` when this is the last page.",
            "example": null
          }
        },
        "required": [
          "spans",
          "nextCursor"
        ]
      },
      "SpanRequest": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/BaseSpanRequest"
          },
          {
            "$ref": "#/components/schemas/LlmSpanRequest"
          },
          {
            "$ref": "#/components/schemas/RetrieverSpanRequest"
          },
          {
            "$ref": "#/components/schemas/ToolSpanRequest"
          },
          {
            "$ref": "#/components/schemas/AgentSpanRequest"
          }
        ],
        "description": "A span to record inside the trace. Its `type` selects the variant: omit it or send `SPAN` for a plain span, `LLM` for a model call, `RETRIEVER` for a knowledge-base lookup, `TOOL` for a tool call, or `AGENT` for an agent step. Each variant accepts only its own fields."
      },
      "SpanSortBy": {
        "type": "string",
        "enum": [
          "createdAt",
          "endedAt",
          "cost",
          "duration",
          "name"
        ],
        "description": "The span field to sort by: `createdAt` and `endedAt` order by the span's start and end time, cost by its cost, duration by how long it took, and name alphabetically."
      },
      "SpanSummary": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "This is the unique identifier of the span.",
            "example": "<SPAN-UUID>"
          },
          "traceUuid": {
            "type": "string",
            "description": "This is the uuid of the trace containing the span.",
            "example": "<TRACE-UUID>"
          },
          "parentUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the uuid of the parent span, or `null` for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "type": {
            "$ref": "#/components/schemas/SpanType"
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended.",
            "example": "2025-01-15T10:30:02.000Z"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the error string that caused the span to fail, or `null` when no error occurred.",
            "example": null
          },
          "integration": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the LLM provider used in an LLM span.",
            "example": "OpenAI"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the LLM model used in an LLM span.",
            "example": "gpt-4o"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the API endpoint the model was called through in an LLM span.",
            "example": null
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the span in `USD`, or `null` when it is not known.",
            "example": 0.00018
          },
          "inputTokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the input tokens passed to the LLM model in an LLM span.",
            "example": 0.00006
          },
          "outputTokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the total cost of the output tokens generated by the LLM model in an LLM span.",
            "example": 0.00012
          },
          "costPerInputToken": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the cost per input token of the LLM model for an LLM span.",
            "example": 0.0000025
          },
          "costPerOutputToken": {
            "type": [
              "number",
              "null"
            ],
            "description": "This is the cost per output token of the LLM model for an LLM span.",
            "example": 0.00001
          },
          "inputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the total number of input tokens passed to the LLM model in an LLM span.",
            "example": 24
          },
          "outputTokenCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the total number of output tokens generated by the LLM model in an LLM span.",
            "example": 12
          },
          "promptAlias": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the alias of your prompt which is stored on Confident AI.",
            "example": "geography-assistant"
          },
          "promptVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the version assigned to your prompt on Confident AI.",
            "example": "00.00.01"
          },
          "promptLabel": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the label assigned to a specific version of prompt on the Confident AI platform.",
            "example": "production"
          },
          "promptCommitHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the hash of the current prompt being logged in the llm span.",
            "example": "bab04ce"
          },
          "embedder": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the embedder model used in a retriever span.",
            "example": null
          },
          "topK": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the top K chunks retrieved from your knowledge base in a retriever span.",
            "example": null
          },
          "chunkSize": {
            "type": [
              "integer",
              "null"
            ],
            "description": "This is the chunk size of each retrieved context for a retriever span.",
            "example": null
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is a description if the span is a tool span.",
            "example": null
          },
          "agentHandoffs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the list of agent handoffs associated with an agent span.",
            "example": null
          },
          "availableTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the list of available tools associated with an agent span.",
            "example": null
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollectionName": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the metric collection to evaluate the span.",
            "example": "LLM Collection Name"
          },
          "inputPreview": {
            "type": [
              "string",
              "null"
            ],
            "description": "The first characters of the span's input, or `null` when it has none. Retrieve the span by id for the full value.",
            "example": "What is the capital of France?"
          },
          "outputPreview": {
            "type": [
              "string",
              "null"
            ],
            "description": "The first characters of the span's output, or `null` when it has none. Retrieve the span by id for the full value.",
            "example": "The capital of France is Paris."
          }
        },
        "required": [
          "uuid",
          "traceUuid",
          "parentUuid",
          "name",
          "type",
          "status",
          "startTime",
          "endTime",
          "error",
          "integration",
          "provider",
          "model",
          "endpoint",
          "cost",
          "inputTokenCost",
          "outputTokenCost",
          "costPerInputToken",
          "costPerOutputToken",
          "inputTokenCount",
          "outputTokenCount",
          "promptAlias",
          "promptVersion",
          "promptLabel",
          "promptCommitHash",
          "embedder",
          "topK",
          "chunkSize",
          "description",
          "agentHandoffs",
          "availableTools",
          "metadata",
          "metricCollectionName",
          "inputPreview",
          "outputPreview"
        ],
        "description": "A span as it appears in a list: its timing, cost, model and prompt details with a preview of its input and output, but without its evaluation fields, results or annotations."
      },
      "SpanType": {
        "type": "string",
        "enum": [
          "SPAN",
          "AGENT",
          "TOOL",
          "RETRIEVER",
          "LLM"
        ],
        "description": "The kind of work a span records: `SPAN` for a plain step, `LLM` for a model call, `RETRIEVER` for a knowledge-base lookup, `TOOL` for a tool call, and `AGENT` for an agent step.",
        "title": "Span Type"
      },
      "StructuredSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the schema assigned by Confident AI.",
            "example": "<STRUCTURED-SCHEMA-ID>"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the schema.",
            "example": "GetCustomerNameInput"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StructuredSchemaField"
            },
            "description": "This is the array of fields that define the tool's input structure."
          }
        },
        "required": [
          "fields"
        ],
        "description": "This is the schema for your tool's input."
      },
      "StructuredSchemaField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique identifier for the schema field. Use it as the `parentId` of nested fields.",
            "example": "<FIELD-ID>"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the schema field.",
            "example": "customerId"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the description of the schema field.",
            "example": "The id of the customer to look up."
          },
          "type": {
            "$ref": "#/components/schemas/SchemaDataType"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "This indicates whether the field is required in the input.",
            "example": true
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the id of the parent field for nested structures, or `null` for a top-level field.",
            "example": null
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "SubmitTestCaseResultRequest": {
        "type": "object",
        "properties": {
          "actualOutput": {
            "type": "string",
            "description": "The actual output produced by your agent.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The retrieval context your agent used, if any.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "The tools your agent called while producing the output."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "The tools you expected to be called for this test case."
          },
          "tokenCost": {
            "type": "number",
            "minimum": 0,
            "description": "This is the cost of the tokens used to produce the output.",
            "example": 0.002
          },
          "inputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 24
          },
          "outputTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 12
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "Optional additional metadata to attach to the test case.",
            "example": {
              "region": "Nepal"
            }
          }
        },
        "additionalProperties": false,
        "description": "The result your agent produced for one dispatched test case. Every field is optional; a field you omit keeps the value Confident AI already holds for the golden."
      },
      "SubmittedTestCaseResult": {
        "type": "object",
        "properties": {
          "testCaseId": {
            "type": "string",
            "description": "The test case id the result was recorded for.",
            "example": "<TEST-CASE-ID>"
          },
          "status": {
            "$ref": "#/components/schemas/TestCaseResultStatus"
          }
        },
        "required": [
          "testCaseId",
          "status"
        ],
        "description": "The recorded test case id and whether its result was accepted."
      },
      "SummaryOverview": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The headline findings across every topic.",
            "example": [
              "8 of 10 test cases passed."
            ]
          },
          "actionItems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What to change to improve the next test run.",
            "example": [
              "Add goldens for lesser-known peaks."
            ]
          }
        },
        "required": [
          "summary",
          "actionItems"
        ],
        "description": "The headline findings and action items of a test run."
      },
      "SummaryPoint": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "One finding about the test cases in this topic.",
            "example": "Answers about mountain heights were correct and cited the retrieved context."
          },
          "testCaseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the test cases this finding is drawn from.",
            "example": [
              "<TEST-CASE-ID>"
            ]
          },
          "grade": {
            "type": "number",
            "description": "How well the test cases behind this finding performed, from 0 to 1.",
            "example": 0.9
          }
        },
        "required": [
          "content",
          "testCaseIds"
        ],
        "description": "A single finding in a topic summary."
      },
      "TestCase": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/SingleTurnTestCase"
          },
          {
            "$ref": "#/components/schemas/MultiTurnTestCase"
          }
        ],
        "description": "One test case to evaluate: single-turn when it carries `input`, multi-turn when it carries `turns`. A test case cannot be both, and one request cannot mix the two kinds."
      },
      "TestCaseMetricData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier of the metric data entry.",
            "example": "<METRIC-DATA-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the metric.",
            "example": "Answer Relevancy"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "The final metric score, or `null` when the metric errored or was skipped.",
            "example": 0.95
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "The reason for the metric score, generated by the evaluation model at evaluation time.",
            "example": "The answer directly states the capital of France."
          },
          "success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the metric score is above the threshold, or `null` while the evaluation is still running.",
            "example": true
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ],
            "description": "The threshold for the metric, which determines if the metric is passing or failing.",
            "example": 0.5
          },
          "strictMode": {
            "type": "boolean",
            "description": "Whether the metric was run in strict mode, which outputs a binary score of 0 or 1.",
            "example": false
          },
          "skipped": {
            "type": "boolean",
            "description": "Whether the metric evaluation was skipped.",
            "example": false
          },
          "flaky": {
            "type": "boolean",
            "description": "Whether the metric's verdict was non-deterministic across runs.",
            "example": false
          },
          "evaluationModel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The evaluation model used to run the evaluation.",
            "example": "gpt-4o"
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of running the evaluation in `USD`.",
            "example": 0.0004
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The error message if the evaluation failed.",
            "example": null
          },
          "errorType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationErrorType"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time the metric data was created.",
            "example": "2025-01-15T10:30:06.000Z"
          },
          "evaluatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The time the metric was evaluated, or `null` while it is still running.",
            "example": "2025-01-15T10:30:09.000Z"
          },
          "traceUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the trace this metric was evaluated on, for test cases formed from traces.",
            "example": "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f"
          },
          "spanUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the span this metric was evaluated on, for component-level metrics.",
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "score",
          "reason",
          "success",
          "threshold",
          "strictMode",
          "skipped",
          "flaky",
          "evaluationModel",
          "evaluationCost",
          "error",
          "errorType",
          "createdAt",
          "evaluatedAt",
          "traceUuid",
          "spanUuid"
        ],
        "description": "The result of evaluating one metric against a test case."
      },
      "TestCaseResultStatus": {
        "type": "string",
        "enum": [
          "accepted",
          "already_received"
        ],
        "description": "`accepted` when the result was queued for evaluation; `already_received` when a result for this test case had already been recorded and this retry was ignored."
      },
      "TestCaseTrace": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "This is the unique identifier of the trace.",
            "example": "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the trace.",
            "example": "geography-agent"
          },
          "input": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the input to the trace.",
            "example": "How tall is Mount Everest?"
          },
          "output": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the output of the trace.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "startTime": {
            "type": "string",
            "description": "This is the time the trace started.",
            "example": "2025-01-01T12:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "description": "This is the time the trace ended.",
            "example": "2025-01-01T12:00:01.500Z"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the trace.",
            "example": {
              "region": "Nepal"
            }
          },
          "tags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is any tags associated with the trace, which helps with grouping traces and filtering them on the Confident AI platform.",
            "example": [
              "geography"
            ]
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the unique identifier of the thread associated with the trace.",
            "example": "thread-42"
          },
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the unique identifier for your end user for the trace.",
            "example": "end-user-42"
          },
          "metricCollectionName": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the name of the metric collection the trace was evaluated with.",
            "example": "Agent Quality"
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your trace, which is to be used for evaluation.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your trace, which is to be used for evaluation.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the expected output of your trace, which is the ideal actual output and to be used for evaluation.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your trace, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the trace, which is to be used for evaluation."
          }
        },
        "required": [
          "uuid",
          "name",
          "input",
          "output",
          "startTime",
          "endTime",
          "environment",
          "metadata",
          "tags",
          "threadId",
          "userId",
          "metricCollectionName",
          "retrievalContext",
          "context",
          "expectedOutput",
          "toolsCalled",
          "expectedTools"
        ],
        "description": "The trace a component-level test case was formed from, without its spans. Fetch the trace by `uuid` for the full span tree."
      },
      "TestRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique ID for the test run, generated by Confident AI and not to be confused with the identifier provided by the user.",
            "example": "<TEST-RUN-ID>"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time the test run was created.",
            "example": "2025-01-01T12:00:00.000Z"
          },
          "identifier": {
            "type": [
              "string",
              "null"
            ],
            "description": "The human-readable identifier you gave the test run, if any.",
            "example": "run-399-102"
          },
          "status": {
            "$ref": "#/components/schemas/TestRunStatus"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether this test run contains multi-turn test cases.",
            "example": false
          },
          "testsPassed": {
            "type": "integer",
            "description": "The number of test cases that passed.",
            "example": 8
          },
          "testsFailed": {
            "type": "integer",
            "description": "The number of test cases that failed.",
            "example": 2
          },
          "totalTests": {
            "type": "integer",
            "description": "The total number of test cases in this test run.",
            "example": 10
          },
          "metricsScores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricScores"
            },
            "description": "The aggregated metric scores across all test cases."
          },
          "expectationsScores": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectationsScores"
              },
              {
                "type": "null"
              }
            ],
            "description": "The aggregated expectations results, or `null` when no test case was judged against expectations. Always `null` for test runs with more than one generation per golden."
          },
          "runDuration": {
            "type": "number",
            "description": "The total duration of the test run in seconds.",
            "example": 15.2
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of evaluating every test case in the test run.",
            "example": 0.254
          },
          "datasetAlias": {
            "type": [
              "string",
              "null"
            ],
            "description": "The alias of the dataset the test run was evaluated on, if any.",
            "example": "geography-goldens"
          },
          "testFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The test file the test run was started from, if any.",
            "example": "test_geography.py"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AiInsightsSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "testCases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestRunTestCase"
            },
            "description": "The test cases in this test run. Every test case is of the same kind: single-turn, multi-turn or trace-based."
          }
        },
        "required": [
          "id",
          "createdAt",
          "identifier",
          "status",
          "multiTurn",
          "testsPassed",
          "testsFailed",
          "totalTests",
          "metricsScores",
          "expectationsScores",
          "runDuration",
          "evaluationCost",
          "datasetAlias",
          "testFile",
          "summary",
          "testCases"
        ],
        "description": "A test run with its aggregated metric scores and every test case in it."
      },
      "TestRunList": {
        "type": "object",
        "properties": {
          "testRuns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestRunSummary"
            },
            "description": "This is the page of test runs."
          },
          "totalTestRuns": {
            "type": "integer",
            "description": "Total number of test runs matching the filters.",
            "example": 113
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of test runs per page.",
            "example": 25
          }
        },
        "required": [
