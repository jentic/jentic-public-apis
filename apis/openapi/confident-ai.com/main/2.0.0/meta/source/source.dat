            "description": "How many projects are enrolled in a policy but have never been assessed.",
            "example": 1
          },
          "notEnrolled": {
            "type": "integer",
            "description": "How many projects belong to no governance policy.",
            "example": 1
          },
          "aggregatePassRate": {
            "type": [
              "number",
              "null"
            ],
            "description": "The share of passing checks across every enrolled project, from 0 to 100, or `null` when nothing has been assessed anywhere.",
            "example": 92
          }
        },
        "required": [
          "total",
          "healthy",
          "needsAttention",
          "critical",
          "awaiting",
          "notEnrolled",
          "aggregatePassRate"
        ],
        "description": "An organization-wide roll-up of project statuses. The five bucket counts are mutually exclusive and sum to `total`, and the roll-up always covers the whole organization even when the accompanying list is filtered or paginated.",
        "title": "Governance Project Portfolio"
      },
      "GovernanceProjectReference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the project.",
            "example": "<PROJECT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the project.",
            "example": "Customer Support Agent"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "A project, named by id.",
        "title": "Governance Project Reference"
      },
      "GovernanceProjectStatus": {
        "type": "string",
        "enum": [
          "healthy",
          "needs_attention",
          "critical",
          "awaiting",
          "not_enrolled"
        ],
        "description": "Where a project stands under governance. `not_enrolled` means it belongs to no governance policy and so has nothing to assess; `awaiting` means it is enrolled but no control has produced a verdict yet; `healthy` means no control is failing. `needs_attention` and `critical` both have failing controls and differ only by pass rate, with `critical` below Confident AI's healthy threshold.",
        "title": "Governance Project Status"
      },
      "GovernanceProjectSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the project.",
            "example": "<PROJECT-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the project.",
            "example": "Customer Support Agent"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the project is for, or `null` when it has no description.",
            "example": "Front-line support assistant for billing questions."
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ],
            "description": "The organization member who owns the project, or `null` when nobody holds the owner role on it."
          },
          "governancePolicy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GovernancePolicyReference"
              },
              {
                "type": "null"
              }
            ],
            "description": "The governance policy this project is enrolled in, or `null` when it is enrolled in none."
          },
          "controlsCount": {
            "type": "integer",
            "description": "How many controls apply to this project through the policy it is enrolled in, counting the ones that policy inherits. 0 for a project enrolled in no policy.",
            "example": 6
          },
          "status": {
            "$ref": "#/components/schemas/GovernanceProjectStatus"
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GovernanceProjectHealth"
              },
              {
                "type": "null"
              }
            ],
            "description": "The project's check counts, or `null` when it is enrolled in no policy and so has nothing to assess."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner",
          "governancePolicy",
          "controlsCount",
          "status",
          "health"
        ],
        "description": "A project as it appears in the governance inventory: which policy governs it, how many controls that brings, and where it currently stands. Every project in the organization appears here, enrolled or not.",
        "title": "Governance Project Summary"
      },
      "HyperparameterValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/PromptHyperparameter"
          }
        ],
        "description": "A plain value such as a model name, or a reference to the prompt the run used."
      },
      "ImmediatelyRotatedApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key, generated by Confident AI.",
            "example": 1420
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The label for the key, shown on the Confident AI platform.",
            "example": "CI pipeline"
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the key authenticates. A deactivated key is rejected on every request until it is reactivated.",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the key was created.",
            "example": "2025-01-15T09:30:00.000Z"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The instant the key stops authenticating, or `null` when it never expires. Confident AI computes it from the `expiresInDays` duration sent when the key was created or last rotated.",
            "example": "2025-04-15T09:30:00.000Z"
          },
          "value": {
            "type": "string",
            "description": "The new full API key. This response is the only place it is ever returned, so store it now — every later response masks it.",
            "example": "confident_us_org_5tRw8xYz2aBc4dEf6gHi8jKl0mNo2pQr4sTu6vWx"
          },
          "shadowValue": {
            "type": "null",
            "description": "Always `null`: the rotation completed as this request was served, so no second value is in flight."
          },
          "rotatesAt": {
            "type": "null",
            "description": "Always `null`: no rotation is pending."
          },
          "lastUsed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the key last authenticated a request, or `null` when it never has.",
            "example": "2025-02-28T18:45:12.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "valid",
          "created_at",
          "expiresAt",
          "value",
          "shadowValue",
          "rotatesAt",
          "lastUsed"
        ],
        "additionalProperties": false,
        "description": "The result of rotating without a grace period: `value` has already been replaced and the previous value stopped authenticating the moment this response was produced.",
        "title": "Immediately Rotated API Key"
      },
      "IngestionDataModel": {
        "type": "string",
        "enum": [
          "TRACE",
          "SPAN",
          "THREAD"
        ],
        "description": "What kind of production item an ingestion task harvests. `THREAD` tasks fill multi-turn datasets; `TRACE` and `SPAN` tasks fill single-turn ones."
      },
      "InvitationRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the invitation, generated by Confident AI.",
            "example": 42
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that the invitation is gone and its link can no longer be accepted.",
        "title": "Invitation Ref"
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "ACCEPTED",
          "DECLINED"
        ],
        "description": "Where an invitation stands: `PENDING` while its link can still be accepted, `ACCEPTED` once the invitee joined, `DECLINED` once they turned it down. A declined invitation cannot be accepted again until it is resent.",
        "title": "Invitation Status"
      },
      "JevQuestion": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "noul"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "trueDescription": {
                "type": "string"
              },
              "falseDescription": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "question"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "score"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 10,
                "description": "Between 2 and 10 ordered levels, worst first."
              }
            },
            "required": [
              "type",
              "question",
              "levels"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "choice"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Each option maps to a credit between 0 and 1, or `null` to mark the question not applicable when that option is likely."
              }
            },
            "required": [
              "type",
              "question",
              "options"
            ],
            "additionalProperties": false
          }
        ],
        "description": "A bounded question a `JEVAL` metric asks the decision model: a `noul` (`true`/`false`) question, a score question over ordered levels (worst first), or a choice question over options with credits.",
        "title": "Jev Question",
        "example": {
          "type": "noul",
          "question": "Does the actual output answer the input?",
          "weight": 2
        }
      },
      "Level": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ],
        "description": "A three-step scale, `LOW` to `HIGH`, used for how exposed a system under test is and how easily an attack method exploits it.",
        "title": "Level"
      },
      "LlmSpanRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LLM"
            ],
            "description": "The type of the span, always `LLM` for an LLM span.",
            "example": "LLM"
          },
          "uuid": {
            "type": "string",
            "description": "The unique identifier of the span, generated by your application. Values that are not UUIDs are hashed into one.",
            "example": "<SPAN-UUID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "input": {
            "description": "This is the input to the span, as a string or any JSON value.",
            "example": "What is the capital of France?"
          },
          "output": {
            "description": "This is the output of the span, as a string or any JSON value.",
            "example": "The capital of France is Paris."
          },
          "error": {
            "type": "string",
            "description": "This is the error message, if an error occurred inside the span.",
            "example": "The model timed out after 30 seconds."
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus",
            "default": "SUCCESS"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:02Z"
          },
          "parentUuid": {
            "type": "string",
            "description": "This is the unique identifier of the span's parent span. Omit it for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollection": {
            "type": "string",
            "description": "This is the metric collection to be used for evaluating the span.",
            "example": "LLM Collection Name"
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your span, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your span, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the span, which is to be used for evaluation."
          },
          "integration": {
            "type": "string",
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDataConfig"
            },
            "description": "Metric results you already computed for this span, recorded as-is instead of being evaluated by Confident AI."
          },
          "model": {
            "type": "string",
            "description": "This is the LLM model used in the span.",
            "example": "gpt-4o"
          },
          "provider": {
            "type": "string",
            "description": "This is the provider of the generation model used in the span.",
            "example": "OpenAI"
          },
          "endpoint": {
            "type": "string",
            "description": "This is the API endpoint the model was called through, for providers that expose more than one.",
            "example": "https://api.openai.com/v1/chat/completions"
          },
          "costPerInputToken": {
            "type": "number",
            "description": "This is the cost per input token of the LLM model.",
            "example": 0.0000025
          },
          "costPerOutputToken": {
            "type": "number",
            "description": "This is the cost per output token of the LLM model.",
            "example": 0.00001
          },
          "inputTokenCount": {
            "type": "integer",
            "description": "This is the number of input tokens passed to the LLM model.",
            "example": 24
          },
          "outputTokenCount": {
            "type": "integer",
            "description": "This is the number of output tokens generated by the LLM model.",
            "example": 12
          },
          "promptAlias": {
            "type": "string",
            "description": "This is the alias of your prompt which is stored on Confident AI.",
            "example": "geography-assistant"
          },
          "promptVersion": {
            "type": "string",
            "description": "This is the version assigned to your prompt on Confident AI.",
            "example": "00.00.01"
          },
          "promptLabel": {
            "type": "string",
            "description": "This is the label assigned to a specific version of prompt on the Confident AI platform.",
            "example": "production"
          },
          "promptCommitHash": {
            "type": "string",
            "description": "This is the hash of the current prompt being logged in the llm span.",
            "example": "bab04ce"
          }
        },
        "required": [
          "type",
          "uuid",
          "name",
          "startTime",
          "endTime"
        ],
        "additionalProperties": false,
        "description": "A span recording a call to a language model, with its model, token counts, costs and the prompt it used.",
        "title": "LLM Span"
      },
      "MLLMImage": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "This is the URL of the image.",
            "example": "https://example.com/everest.png"
          },
          "local": {
            "type": "boolean",
            "description": "This is `true` when the image is your local file.",
            "example": false
          },
          "base64": {
            "type": "string",
            "description": "The base64 data of the image.",
            "example": "iVBORw0KGgo="
          },
          "filename": {
            "type": "string",
            "description": "The original file name.",
            "example": "everest.png"
          },
          "mimeType": {
            "type": "string",
            "description": "The image's MIME type.",
            "example": "image/png"
          },
          "dataBase64": {
            "type": "string",
            "description": "The image encoded as a base64 data URL.",
            "example": "data:image/png;base64,iVBORw0KGgo="
          }
        },
        "required": [
          "url",
          "local"
        ],
        "description": "An image referenced from a text field by a `[DEEPEVAL:IMAGE:<key>]` marker. Send either a public `url` or the bytes in `base64`.",
        "title": "MLLM Image"
      },
      "McpServer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the MCP server, generated by Confident AI.",
            "example": "<MCP-SERVER-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the MCP server.",
            "example": "Internal Tools"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the MCP server is for.",
            "example": "Internal engineering tools"
          },
          "transport": {
            "$ref": "#/components/schemas/McpServerTransport"
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the last connection attempt succeeded. Set by the connect route, and reset to `false` by any update.",
            "example": true
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL of the server. Only set when `transport` is `HTTP`.",
            "example": "https://mcp.internal.example.com/sse"
          },
          "headers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "description": "The static headers sent with every request, returned as stored. Only set when `authType` is `HEADERS`.",
            "example": {
              "Authorization": "Bearer YOUR-TOKEN"
            }
          },
          "authType": {
            "$ref": "#/components/schemas/McpServerAuthType"
          },
          "authConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/McpServerMaskedAuthConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "The stored credentials with the OAuth client secret masked, or `null` when `authType` is `HEADERS`."
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "description": "The command that launches the server. Only set when `transport` is `STDIO`.",
            "example": "npx"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The arguments passed to `command`. Empty unless `transport` is `STDIO`.",
            "example": [
              "-y",
              "@modelcontextprotocol/server-filesystem"
            ]
          },
          "availableTools": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/McpServerTool"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The tools discovered by the last successful connection, or `null` when the server has never connected. An update does not clear them, so treat them as stale whenever `connected` is `false`."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "transport",
          "connected",
          "url",
          "headers",
          "authType",
          "authConfig",
          "command",
          "args",
          "availableTools"
        ],
        "description": "An MCP server registered with your project: how Confident AI reaches it, how it authenticates, and the tools the last connection found. The stored OAuth client secret is never returned — `authConfig.clientSecretPreview` masks it.",
        "title": "MCP Server"
      },
      "McpServerAuthConfig": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "description": "The Azure AD directory (tenant) id. Required when `authType` is `AZURE_AD`.",
            "example": "72f988bf-86f1-41af-91ab-2d7cd011db47"
          },
          "clientId": {
            "type": "string",
            "description": "The OAuth client id. Required when `authType` is `AZURE_AD` or `OAUTH_CLIENT_CREDENTIALS`.",
            "example": "9a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"
          },
          "clientSecret": {
            "type": "string",
            "description": "The OAuth client secret. Write-only: it is never returned, and `clientSecretPreview` comes back in its place. Omit this field to leave the stored secret exactly as it is, or send a new value to replace it. Changing `authType` discards the stored secret, so a new one must be sent in the same call.",
            "example": "abc123~ExampleClientSecretValue"
          },
          "scope": {
            "type": "string",
            "description": "The OAuth scope to request. Required when `authType` is `AZURE_AD`.",
            "example": "api://internal-tools/.default"
          }
        },
        "description": "Credentials for a non-`HEADERS` auth type. Unlike `headers`, these fields merge into what is stored, so send only the ones you are changing. Unknown keys are ignored, which is what lets you send back an object you read from the API without stripping its `clientSecretPreview` first.",
        "title": "MCP Server Auth Config"
      },
      "McpServerAuthType": {
        "type": "string",
        "enum": [
          "HEADERS",
          "OAUTH_CLIENT_CREDENTIALS",
          "AZURE_AD"
        ],
        "description": "How Confident AI authenticates to the server. `HEADERS` sends the static `headers` map, `OAUTH_CLIENT_CREDENTIALS` and `AZURE_AD` fetch a token from `authConfig` before every call. `HTTP` transport only; a `STDIO` server is always `HEADERS`.",
        "title": "MCP Server Auth Type"
      },
      "McpServerConnection": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "Whether Confident AI completed a handshake with the server. A failed attempt is reported here rather than as an error status, so read this field for the verdict.",
            "example": true
          },
          "availableTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McpServerTool"
            },
            "description": "The tools the server exposes. Empty when the attempt failed."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the attempt failed, as your server or the network reported it. Null when `connected` is `true`.",
            "example": "MCP connection timed out"
          }
        },
        "required": [
          "connected",
          "availableTools",
          "error"
        ],
        "description": "The outcome of a connection attempt, which also becomes the server's stored `connected` and `availableTools`.",
        "title": "MCP Server Connection"
      },
      "McpServerList": {
        "type": "object",
        "properties": {
          "mcpServers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McpServerSummary"
            },
            "description": "The MCP servers for the current page, ordered by name."
          },
          "totalMcpServers": {
            "type": "integer",
            "description": "The total number of MCP servers in this project.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of MCP servers per page.",
            "example": 25
          }
        },
        "required": [
          "mcpServers",
          "totalMcpServers",
          "page",
          "pageSize"
        ],
        "description": "One page of MCP servers, with the total across all pages.",
        "title": "MCP Server List"
      },
      "McpServerMaskedAuthConfig": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "description": "The Azure AD directory (tenant) id, as stored.",
            "example": "72f988bf-86f1-41af-91ab-2d7cd011db47"
          },
          "clientId": {
            "type": "string",
            "description": "The OAuth client id, as stored.",
            "example": "9a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"
          },
          "scope": {
            "type": "string",
            "description": "The OAuth scope requested, as stored.",
            "example": "api://internal-tools/.default"
          },
          "clientSecretPreview": {
            "type": "string",
            "description": "A mask of the stored OAuth client secret — bullets followed by its last six characters — so you can tell which secret is stored without reading it. This is not a credential and sending it back sets nothing: to leave the stored secret alone omit `clientSecret` from your update, and to change it send the new secret in `clientSecret`.",
            "example": "••••••••Xk3mZq"
          }
        },
        "description": "The stored credentials with the secret removed: `clientSecret` never leaves Confident AI, and a masked `clientSecretPreview` stands in for it.",
        "title": "MCP Server Masked Auth Config"
      },
      "McpServerRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the MCP server, generated by Confident AI.",
            "example": "<MCP-SERVER-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an MCP server by its id.",
        "title": "MCP Server Ref"
      },
      "McpServerSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the MCP server, generated by Confident AI.",
            "example": "<MCP-SERVER-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the MCP server.",
            "example": "Internal Tools"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the MCP server is for.",
            "example": "Internal engineering tools"
          },
          "transport": {
            "$ref": "#/components/schemas/McpServerTransport"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL of the server. Only set when `transport` is `HTTP`.",
            "example": "https://mcp.internal.example.com/sse"
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the last connection attempt succeeded.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "transport",
          "url",
          "connected"
        ],
        "description": "An MCP server as it appears in a list: enough to pick one, without its configuration or credentials.",
        "title": "MCP Server Summary"
      },
      "McpServerTool": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the tool, as the server reports it.",
            "example": "search_issues"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the tool does, or `null` when the server does not describe it.",
            "example": "Search issues in a repository"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": {},
            "description": "The JSON Schema describing the tool's arguments.",
            "example": {
              "type": "object"
            }
          },
          "annotations": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ],
            "description": "Extra hints the server attaches to the tool, or `null` when it attaches none.",
            "example": {
              "readOnlyHint": true
            }
          }
        },
        "required": [
          "name",
          "description",
          "inputSchema",
          "annotations"
        ],
        "description": "A tool an MCP server exposes, as the last connection saw it.",
        "title": "MCP Server Tool"
      },
      "McpServerTransport": {
        "type": "string",
        "enum": [
          "STDIO",
          "HTTP"
        ],
        "description": "How Confident AI reaches the server. `HTTP` requires `url` and is the only transport that authenticates; `STDIO` requires `command` and launches the server as a local process.",
        "title": "MCP Server Transport"
      },
      "MemberRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the user who was removed.",
            "example": "<USER-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that the user is no longer a member. Removing an organization member also removes them from every project in it; removing a project member leaves their organization membership untouched.",
        "title": "Member Ref"
      },
      "MemberRole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the role.",
            "example": "<ROLE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the role.",
            "example": "Admin"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "The role a member holds, as referenced from the member. Retrieve the role by id from the roles endpoint of the same scope to see the policies behind it.",
        "title": "Member Role"
      },
      "MessagesPrompt": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptMessage"
            },
            "minItems": 1,
            "description": "This is the list of messages that make up the prompt.",
            "example": [
              {
                "role": "system",
                "content": "You are a helpful assistant."
              },
              {
                "role": "user",
                "content": "Hello, {{name}}! How can I help you today?"
              }
            ]
          },
          "alias": {
            "type": "string",
            "description": "This is the alias of the prompt, which is unique within your project.",
            "example": "greeting"
          },
          "id": {
            "type": "string",
            "description": "This is the id of the commit pulled, generated by Confident AI, not to be confused with the prompt id, the version number, or the commit hash.",
            "example": "<COMMIT-ID>"
          },
          "hash": {
            "type": "string",
            "description": "This is the commit hash of the prompt pulled.",
            "example": "bab04ce"
          },
          "version": {
            "type": "string",
            "description": "The version number of the prompt, present when the commit pulled has been released as a version.",
            "example": "00.00.01"
          },
          "label": {
            "type": "string",
            "description": "The user-defined label of the version pulled, present when the version carries one.",
            "example": "production"
          },
          "type": {
            "$ref": "#/components/schemas/PromptType"
          },
          "interpolationType": {
            "$ref": "#/components/schemas/PromptInterpolationType"
          },
          "modelSettings": {
            "$ref": "#/components/schemas/ModelSettings"
          },
          "outputType": {
            "$ref": "#/components/schemas/PromptOutputType"
          },
          "outputSchema": {
            "$ref": "#/components/schemas/OutputSchema"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "description": "This is the list of tools available to the prompt."
          }
        },
        "required": [
          "messages",
          "alias",
          "id",
          "hash",
          "type",
          "interpolationType",
          "outputType"
        ],
        "additionalProperties": false,
        "description": "A pulled prompt whose content is a list of messages.",
        "title": "Messages Prompt"
      },
      "Metric": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the metric.",
            "example": "<METRIC-ID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the metric, unique within your project.",
            "example": "Correctness"
          },
          "algorithm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricAlgorithm"
              },
              {
                "type": "null"
              }
            ]
          },
          "criteria": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the criteria the metric scores against, or `null` when it uses evaluation steps.",
            "example": "Determine if the actual output is correct based on the expected output."
          },
          "evaluationSteps": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "These are the steps the metric follows to score, or `null` when it uses criteria.",
            "example": null
          },
          "rubric": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Rubric"
            },
            "description": "These are the score ranges that anchor how the metric scores, or `null`."
          },
          "dag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricDag"
              },
              {
                "type": "null"
              }
            ]
          },
          "questions": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JevQuestion"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "These are the questions a `JEVAL` metric asks the decision model, or `null` for other algorithms."
          },
          "promptConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PromptMetricConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "This is the judge prompt of a `PROMPT` metric, or `null` for other algorithms."
          },
          "multiTurn": {
            "type": "boolean",
            "description": "This is `true` when the metric evaluates conversations rather than single test cases.",
            "example": false
          },
          "requiredParameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricEvaluationParam"
            },
            "description": "The test case fields the metric needs to run.",
            "example": [
              "actualOutput",
              "expectedOutput"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "algorithm",
          "criteria",
          "evaluationSteps",
          "rubric",
          "dag",
          "questions",
          "promptConfig",
          "multiTurn",
          "requiredParameters"
        ],
        "description": "A custom metric: how it scores, and which test case fields it needs."
      },
      "MetricAlgorithm": {
        "type": "string",
        "enum": [
          "DEFAULT",
          "DAG",
          "GEVAL",
          "JEVAL",
          "CODE",
          "PROMPT"
        ],
        "description": "The algorithm the metric is evaluated with. `GEVAL` scores against criteria or evaluation steps, `DAG` walks a decision graph, `JEVAL` asks a decision model bounded questions, `PROMPT` sends your own judge prompt to the evaluation model, `CODE` runs your own code, and `DEFAULT` is a built-in metric.",
        "title": "Metric Algorithm"
      },
      "MetricCodeDefinition": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "PYTHON"
            ],
            "description": "This is the language the code is written in.",
            "example": "PYTHON"
          },
          "code": {
            "type": "string",
            "description": "This is the source code the metric runs.",
            "example": "def measure(test_case): return 1.0"
          }
        },
        "required": [
          "language",
          "code"
        ],
        "description": "The code a CODE metric runs to score a test case.",
        "title": "Metric Code Definition"
      },
      "MetricCollection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the metric collection.",
            "example": "<METRIC-COLLECTION-ID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the metric collection, which you supply to the evals API to run evaluations remotely.",
            "example": "RAG Quality"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether this is a multi-turn collection. Multi-turn collections contain only multi-turn metrics and evaluate conversations rather than single test cases.",
            "example": false
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The share of eligible entities this collection is run against, between 0 and 1. Applied on top of each metric's own `sampleRate`.",
            "example": 1
          },
          "inputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that reshapes the payload before evaluation, or `null` when the collection does not use one.",
            "example": "<TRANSFORMER-ID>"
          },
          "outputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that reshapes the result after evaluation, or `null` when the collection does not use one.",
            "example": null
          },
          "metricsSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricSetting"
            },
            "description": "The metrics in the collection with their settings."
          }
        },
        "required": [
          "id",
          "name",
          "multiTurn",
          "sampleRate",
          "inputTransformerId",
          "outputTransformerId",
          "metricsSettings"
        ],
        "description": "A metric collection: its name, sampling and transformer configuration, and the settings for every metric inside it."
      },
      "MetricCollectionList": {
        "type": "object",
        "properties": {
          "metricCollections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricCollection"
            },
            "description": "This is the list of metric collections in your project."
          }
        },
        "required": [
          "metricCollections"
        ]
      },
      "MetricCollectionRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the metric collection.",
            "example": "<METRIC-COLLECTION-ID>"
          }
        },
        "required": [
          "id"
        ]
      },
      "MetricDag": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "object",
            "additionalProperties": {},
            "description": "The graph's nodes keyed by node id, as serialized by deepeval's `DAG` metric. Judgement nodes list their `children` by id; verdict nodes carry a `verdict` and a `score`, or point at another metric by `metric_name`.",
            "example": {
              "root": {
                "type": "BinaryJudgementNode",
                "criteria": "Does the actual output answer the input?",
                "evaluation_params": [
                  "input",
                  "actual_output"
                ],
                "children": [
                  "pass",
                  "fail"
                ]
              },
              "pass": {
                "type": "VerdictNode",
                "verdict": true,
                "score": 10
              },
              "fail": {
                "type": "VerdictNode",
                "verdict": false,
                "score": 0
              }
            }
          }
        },
        "required": [
          "nodes"
        ],
        "description": "The decision graph of a `DAG` metric. It is validated on write, and metric references are resolved against the metrics in your project.",
        "title": "Metric DAG"
      },
      "MetricData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier of the metric data entry.",
            "example": "<METRIC-DATA-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the metric.",
            "example": "Answer Relevancy"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "The final metric score, or `null` when the metric errored or was skipped.",
            "example": 0.95
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "The reason for the metric score, generated by the evaluation model at evaluation time.",
            "example": "The answer directly states the capital of France."
          },
          "success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the metric score is above the threshold, or `null` while the evaluation is still running.",
            "example": true
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ],
            "description": "The threshold for the metric, which determines if the metric is passing or failing.",
            "example": 0.5
          },
          "strictMode": {
            "type": "boolean",
            "description": "Whether the metric was run in strict mode, which outputs a binary score of 0 or 1.",
            "example": false
          },
          "skipped": {
            "type": "boolean",
            "description": "Whether the metric evaluation was skipped.",
            "example": false
          },
          "flaky": {
            "type": "boolean",
            "description": "Whether the metric's verdict was non-deterministic across runs.",
            "example": false
          },
          "evaluationModel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The evaluation model used to run the evaluation.",
            "example": "gpt-4o"
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of running the evaluation in `USD`.",
            "example": 0.0004
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The error message if the evaluation failed.",
            "example": null
          },
          "errorType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationErrorType"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time the metric data was created.",
            "example": "2025-01-15T10:30:06.000Z"
          },
          "evaluatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The time the metric was evaluated, or `null` while it is still running.",
            "example": "2025-01-15T10:30:09.000Z"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether this metric was evaluated on a multi-turn conversation.",
            "example": false
          },
          "traceUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the trace this metric was evaluated on, or `null` if it was not evaluated on one.",
            "example": "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f"
          },
          "spanUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the span this metric was evaluated on, for component-level metrics.",
            "example": null
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the thread this metric was evaluated on, for conversation-level metrics.",
            "example": null
          },
          "testCaseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the test case this metric was evaluated on."
          },
          "testRunId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the test run this result belongs to. Retrieve that test run to read the result alongside the rest of its test cases.",
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "score",
          "reason",
          "success",
          "threshold",
          "strictMode",
          "skipped",
          "flaky",
          "evaluationModel",
          "evaluationCost",
          "error",
          "errorType",
          "createdAt",
          "evaluatedAt",
          "multiTurn",
          "traceUuid",
          "spanUuid",
          "threadId",
          "testCaseId",
          "testRunId"
        ],
        "description": "The result of an evaluated metric, with the ids of whatever it was recorded against."
      },
      "MetricDataConfig": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the metric.",
            "example": "Answer Relevancy"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "The metric score, typically between 0 and 1.",
            "example": 0.95
          },
          "success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the metric passed its threshold.",
            "example": true
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ],
            "description": "The threshold the metric was scored against.",
            "example": 0.5
          },
          "strictMode": {
            "type": "boolean",
            "description": "Whether the metric ran in strict mode, which outputs a binary score of 0 or 1.",
            "example": false
          },
          "flaky": {
            "type": "boolean",
            "description": "Whether the metric's verdict was non-deterministic across runs.",
            "example": false
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "The reason for the metric score.",
            "example": "The answer directly states the capital of France."
          },
          "evaluationModel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model used to evaluate the metric.",
            "example": "gpt-4o"
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of running the evaluation in `USD`.",
            "example": 0.0004
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The error message if the evaluation failed.",
            "example": null
          },
          "errorType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationErrorType"
              },
              {
                "type": "null"
              }
            ]
          },
          "verboseLogs": {
            "type": [
              "string",
              "null"
            ],
            "description": "Detailed logs from the evaluation.",
            "example": null
          }
        },
        "required": [
          "name"
        ],
        "description": "A metric result you computed yourself, recorded on the trace or span as-is instead of being evaluated by Confident AI."
      },
      "MetricDataList": {
        "type": "object",
        "properties": {
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricData"
            },
            "description": "The metric results for the current page, newest first. Each result reports whether it was evaluated on a multi-turn conversation, and carries the ids of whatever it was recorded against."
          },
          "totalMetricsData": {
            "type": "integer",
            "description": "The total number of results matching the query across all pages.",
            "example": 120
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of results per page.",
            "example": 25
          }
        },
        "required": [
          "metricsData",
          "totalMetricsData",
          "page",
          "pageSize"
        ],
        "description": "One page of metric results, with the total across all pages.",
        "title": "Metric Data List"
      },
      "MetricEvaluationParam": {
        "type": "string",
        "enum": [
          "input",
          "actualOutput",
          "expectedOutput",
          "context",
          "expectedTools",
          "content",
          "role",
          "scenario",
          "expectedOutcome",
          "turns",
          "toolsCalled",
          "retrievalContext",
          "metadata",
          "tags"
        ],
        "description": "A test case field a metric evaluates. Single-turn metrics take input, `actualOutput`, `expectedOutput`, context and `expectedTools`; multi-turn metrics take content, role, scenario, `expectedOutcome` and turns; `toolsCalled`, `retrievalContext`, metadata and tags apply to both."
      },
      "MetricList": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Metric"
            },
            "description": "This is the list of metrics."
          }
        },
        "required": [
          "metrics"
        ]
      },
      "MetricRef": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the metric, which must match a metric in your project or one of Confident AI's built-in metrics.",
            "example": "Answer Relevancy"
          }
        },
        "required": [
          "name"
        ],
        "description": "A metric referenced by its name."
      },
      "MetricScores": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "description": "This is the name of the metric.",
            "example": "Answer Correctness"
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "This is an array of scores for the metric across test cases, one per test case that produced a score.",
            "example": [
              0.9,
              1
            ]
          },
          "passes": {
            "type": "integer",
            "description": "This is the number of times this metric passed the threshold.",
            "example": 8
          },
          "fails": {
            "type": "integer",
            "description": "This is the number of times this metric failed to pass the threshold.",
            "example": 2
          },
          "errors": {
            "type": "integer",
            "description": "This is the number of times this metric errored during evaluation.",
            "example": 0
          },
          "errorType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationErrorType"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "metric",
          "scores",
          "passes",
          "fails",
          "errors",
          "errorType"
        ],
        "description": "A metric's aggregated results across the test cases in a test run."
      },
      "MetricSetting": {
        "type": "object",
        "properties": {
          "metric": {
            "$ref": "#/components/schemas/MetricSummary"
          },
          "activated": {
            "type": "boolean",
            "description": "Whether this metric is activated. Only activated metrics are run during an evaluation.",
            "example": true
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The threshold this metric is scored against. A metric passes when its score is equal to or greater than the threshold.",
            "example": 0.8
          },
          "includeReason": {
            "type": "boolean",
            "description": "Whether a written reason explaining the metric's score is generated during evaluation.",
            "example": true
          },
          "strictMode": {
            "type": "boolean",
            "description": "Whether this metric runs in strict mode, which outputs a binary score of 0 or 1 instead of a continuous score.",
            "example": false
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The probability that this metric is run for any given evaluation, between 0 and 1. Applied on top of the collection's own `sampleRate`.",
            "example": 1
          },
          "evaluationModelProvider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "evaluationModelName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the model this metric is evaluated with, or `null` when the project's default evaluation model is used.",
            "example": "gpt-4o"
          },
          "evaluationModelCredentialId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For `BEDROCK` and `AZURE`, the id of the stored credential this metric is evaluated with, or null when it uses the provider's default credential.",
            "example": null
          },
          "decisionModelProvider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionModelName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the decision model this metric decides with, or `null` when the project's default decision model is used.",
            "example": "jev-latest"
          },
          "evalMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvalMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "metric",
          "activated",
          "threshold",
          "includeReason",
          "strictMode",
          "sampleRate",
          "evaluationModelProvider",
          "evaluationModelName",
          "evaluationModelCredentialId",
          "decisionModelProvider",
          "decisionModelName",
          "evalMode"
        ],
        "description": "A metric in the collection with the settings that decide whether and how it runs."
      },
      "MetricSettingConfig": {
        "type": "object",
        "properties": {
          "metric": {
            "$ref": "#/components/schemas/MetricRef"
          },
          "activated": {
            "type": "boolean",
            "default": true,
            "description": "Whether this metric is activated. Only activated metrics are run during an evaluation.",
            "example": true
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "description": "The threshold this metric is scored against. A metric passes when its score is equal to or greater than the threshold.",
            "example": 0.8
          },
          "includeReason": {
            "type": "boolean",
            "default": true,
            "description": "Whether a written reason explaining the metric's score is generated during evaluation.",
            "example": true
          },
          "strictMode": {
            "type": "boolean",
            "default": false,
            "description": "Whether this metric runs in strict mode, which outputs a binary score of 0 or 1 instead of a continuous score.",
            "example": false
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 1,
            "description": "The probability that this metric is run for any given evaluation, between 0 and 1. Applied on top of the collection's own `sampleRate`.",
            "example": 1
          },
          "evaluationModelProvider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "evaluationModelName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the model this metric is evaluated with. Required whenever `evaluationModelProvider` is set to anything other than `CONFIDENT_AI`, and has no effect without a provider.",
            "example": "gpt-4o"
          },
          "evaluationModelCredentialId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For `BEDROCK` and `AZURE`, the id of the stored credential this metric is evaluated with. Omit it or send null to use the provider's default credential.",
            "example": "<MODEL-CREDENTIAL-ID>"
          },
          "decisionModelProvider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionModelName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the decision model this metric decides with, used in the `HYBRID` and `DECISION` eval modes. Required whenever `decisionModelProvider` is set, and has no effect without a provider.",
            "example": "jev-latest"
          },
          "evalMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvalMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "metric"
        ],
        "description": "A metric to include in the collection with the settings that decide whether and how it runs. Omit `evaluationModelProvider` to evaluate with your project's default model, and `decisionModelProvider` to decide with your project's default decision model."
      },
      "MetricSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "This is the id of the metric.",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "This is the name of the metric.",
            "example": "Answer Relevancy"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "A metric as it appears inside a collection, by id and name."
      },
      "MetricVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the version.",
            "example": "<METRIC-VERSION-ID>"
          },
          "version": {
            "type": "string",
            "description": "This is the human-readable label for `sequence`, written as three two-digit groups that roll over at 100, so sequence 2 is `00.00.02` and sequence 100 is `00.01.00`.",
            "example": "00.00.02"
          },
          "sequence": {
            "type": "integer",
            "description": "This is the position of the version in the metric's history, counting from 1. The highest sequence is the definition new evaluations run.",
            "example": 2
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "This is when the version was saved.",
            "example": "2025-01-18T16:45:00.000Z"
          },
          "algorithm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricAlgorithm"
              },
              {
                "type": "null"
              }
            ]
          },
          "criteria": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the criteria the version scores against, or null when it uses evaluation steps.",
            "example": "Determine if the actual output is correct based on the expected output."
          },
          "evaluationSteps": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "These are the steps the version follows to score, or null when it uses criteria.",
            "example": null
          },
          "rubric": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Rubric"
            },
            "description": "These are the score ranges that anchor how the version scores, or null."
          },
          "dag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricDag"
              },
              {
                "type": "null"
              }
            ]
          },
          "questions": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JevQuestion"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "These are the questions a JEVAL version asks the decision model, or null for other algorithms."
          },
          "promptConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PromptMetricConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "This is the judge prompt of a PROMPT version, or null for other algorithms."
          },
          "requireInput": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `input`.",
            "example": false
          },
          "requireActualOutput": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `actualOutput`.",
            "example": false
          },
          "requireExpectedOutput": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `expectedOutput`.",
            "example": false
          },
          "requireContext": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `context`.",
            "example": false
          },
          "requireExpectedTools": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `expectedTools`.",
            "example": false
          },
          "requireContent": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `content`.",
            "example": false
          },
          "requireRole": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `role`.",
            "example": false
          },
          "requireScenario": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `scenario`.",
            "example": false
          },
          "requireExpectedOutcome": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `expectedOutcome`.",
            "example": false
          },
          "requireRetrievalContext": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `retrievalContext`.",
            "example": false
          },
          "requireToolsCalled": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `toolsCalled`.",
            "example": false
          },
          "requireMetadata": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `metadata`.",
            "example": false
          },
          "requireTags": {
            "type": "boolean",
            "description": "This is true when the metric needs the test case's `tags`.",
            "example": false
          },
          "codeDefinition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricCodeDefinition"
              },
              {
                "type": "null"
              }
            ],
            "description": "This is the code a CODE version runs, or null for other algorithms."
          }
        },
        "required": [
          "id",
          "version",
          "sequence",
          "createdAt",
          "algorithm",
          "criteria",
          "evaluationSteps",
          "rubric",
          "dag",
          "questions",
          "promptConfig",
          "requireInput",
          "requireActualOutput",
          "requireExpectedOutput",
          "requireContext",
          "requireExpectedTools",
          "requireContent",
          "requireRole",
          "requireScenario",
          "requireExpectedOutcome",
          "requireRetrievalContext",
          "requireToolsCalled",
          "requireMetadata",
          "requireTags",
          "codeDefinition"
        ],
        "description": "An immutable snapshot of a metric's definition. Saving a metric whose definition changed appends a new version instead of editing this one, and saving an unchanged definition appends nothing.",
        "title": "Metric Version"
      },
      "MetricVersionList": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricVersion"
            },
            "description": "The metric's definition history for the current page, newest version first, so the first entry of the first page is the current definition."
          },
          "totalMetricVersions": {
            "type": "integer",
            "description": "The number of versions this metric has, across every page.",
            "example": 2
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of versions per page.",
            "example": 25
          }
        },
        "required": [
          "versions",
          "totalMetricVersions",
          "page",
          "pageSize"
        ],
        "description": "One page of a metric's definition history, with the total across all pages.",
        "title": "Metric Version List"
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the model configuration, generated by Confident AI.",
            "example": "<MODEL-ID>"
          },
          "type": {
            "$ref": "#/components/schemas/ModelType"
          },
          "provider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ],
            "description": "The provider the model runs on, or `null` when your organization's model provider policy stopped allowing the configured provider and Confident AI cleared it.",
            "example": "GEMINI"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model to call at that provider, or `null` when the provider's default is used. Always `null` for `CONFIDENT_AI`.",
            "example": "gemini-2.0-flash"
          },
          "maxConcurrency": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many calls Confident AI makes to this model at once, or `null` for no limit of its own.",
            "example": 5
          },
          "maxInputTokens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many input tokens Confident AI sends to this model per call, or `null` for no limit of its own.",
            "example": 128000
          },
          "modelCredentialId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For `BEDROCK` and `AZURE`, the id of the stored credential the model is called with, or null when it uses the provider's default credential.",
            "example": null
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the project this configuration overrides the organization default for, or `null` when it is the organization default itself.",
            "example": null
          },
          "organizationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the organization this configuration is the default for, or `null` when it is a project override.",
            "example": "<ORGANIZATION-ID>"
          }
        },
        "required": [
          "id",
          "type",
          "provider",
          "name",
          "maxConcurrency",
          "maxInputTokens",
          "modelCredentialId",
          "projectId",
          "organizationId"
        ],
        "description": "One model configuration: the provider and model Confident AI calls for a given purpose, with the limits it calls them under. A configuration belongs either to the organization (`organizationId` set) or to a single project (`projectId` set), never to both.",
        "title": "Model"
      },
      "ModelCost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the model cost, generated by Confident AI.",
            "example": "<MODEL-COST-ID>"
          },
          "matchPattern": {
            "type": "string",
            "description": "The case-insensitive regular expression a model name must match for this cost to apply.",
            "example": "^gpt-4o"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model provider this cost applies to, or `null` when it applies whatever the provider.",
            "example": "openai"
          },
          "inputCostPerMillionTokens": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost in `USD` of one million input tokens, or `null` when the input rate is not priced.",
            "example": 2.5
          },
          "outputCostPerMillionTokens": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost in `USD` of one million output tokens, or `null` when the output rate is not priced.",
            "example": 10
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the model cost was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the model cost was last updated.",
            "example": "2025-01-16T09:05:00.000Z"
          }
        },
        "required": [
          "id",
          "matchPattern",
          "provider",
          "inputCostPerMillionTokens",
          "outputCostPerMillionTokens",
          "createdAt",
          "updatedAt"
        ],
        "description": "A custom price for the models whose names match `matchPattern`. Confident AI uses it to cost an LLM span whose provider did not report a priceable cost, taking a provider-specific match first and a provider-less one otherwise.",
        "title": "Model Cost"
      },
      "ModelCostList": {
        "type": "object",
        "properties": {
          "modelCosts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelCost"
            },
            "description": "The model costs for the current page, newest first."
          },
          "totalModelCosts": {
            "type": "integer",
            "description": "The total number of model costs this project resolves.",
            "example": 4
          },
          "inherit": {
            "type": "boolean",
            "description": "Whether these model costs come from the organization rather than the project. When `true` they are read-only through the API, and creating, updating or deleting one fails until 'Inherit Custom Model Pricing From Organization' is turned off in the project's model costs settings.",
            "example": false
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of model costs per page.",
            "example": 25
          }
        },
        "required": [
          "modelCosts",
          "totalModelCosts",
          "inherit",
          "page",
          "pageSize"
        ],
        "description": "One page of model costs, with the total across all pages.",
        "title": "Model Cost List"
      },
      "ModelCostRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the model cost, generated by Confident AI.",
            "example": "<MODEL-COST-ID>"
          }
        },
        "required": [
          "id"
