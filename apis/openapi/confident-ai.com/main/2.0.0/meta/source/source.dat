    "/v2/organization/models/{modelType}": {
      "put": {
        "operationId": "updateOrganizationModel",
        "summary": "Set Organization Model",
        "description": "Sets one of your organization's default models, selected by the `modelType` path segment. Each applies to every project that has no override of its own for that type. The provider's credential must already be configured on the organization through the model credentials endpoint, and a provider your organization's model provider policy does not allow is rejected with `403`. `CONFIDENT_AI` needs no credential and stores a `null` model name.",
