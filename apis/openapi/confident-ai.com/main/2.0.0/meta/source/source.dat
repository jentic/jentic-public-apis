    "/v2/vulnerabilities": {
      "get": {
        "operationId": "listVulnerabilities",
        "summary": "List Vulnerabilities",
        "description": "Lists the vulnerabilities available to your Confident AI project one page at a time, both the ones Confident AI ships and your project's own. Filter by catalog category or by whether a vulnerability is built in.",
        "tags": [
          "vulnerabilities"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page of vulnerabilities to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of vulnerabilities per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Returns only vulnerabilities in this catalog category. An unknown category is rejected with the list of valid ones.",
            "example": "Data Privacy",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "builtIn",
            "in": "query",
            "required": false,
            "description": "When `true`, returns only the vulnerabilities Confident AI ships; when `false`, only the ones your project defined. Omit to return both.",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Vulnerabilities succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
