  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "CONFIDENT_API_KEY",
        "description": "A project or organization API key created on the Confident AI platform."
      }
    },
    "schemas": {
      "AIConnection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the AI connection, generated by Confident AI.",
            "example": "<AI-CONNECTION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the AI connection, unique within the project.",
            "example": "Production Chatbot"
          },
          "type": {
            "$ref": "#/components/schemas/AIConnectionType"
          },
          "active": {
            "type": "boolean",
            "description": "Whether Confident AI could last reach your application and read an answer out of its response. Computed by Confident AI whenever the configuration changes or the connection is pinged, not writable.",
            "example": true
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL Confident AI calls, or `null` when no endpoint has been configured.",
            "example": "https://api.example.com/chat"
          },
          "responseMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AIConnectionResponseMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "How your application replies, or `null` when the answer is read out of a completed HTTP response body."
          },
          "asyncResponse": {
            "type": "boolean",
            "description": "Whether your application acknowledges the request and posts the result back later instead of answering inline.",
            "example": false
          },
          "timeout": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many seconds Confident AI waits for your application to answer, or `null` when no timeout is set.",
            "example": 60
          },
          "maxConcurrency": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The most requests Confident AI sends at the same time, or `null` when it is unbounded.",
            "example": 5
          },
          "maxRetries": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many times a failed request is retried, or `null` when it is not retried.",
            "example": 3
          },
          "defaultNumGenerations": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many times your application is called per test case, or `null` when it is called once.",
            "example": 1
          },
          "headers": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AIConnectionKeyValue"
            },
            "description": "The headers sent with every request, returned with their values exactly as stored, or `null` when none are configured.",
            "example": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR-TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "queryParams": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AIConnectionKeyValue"
            },
            "description": "The query parameters appended to every request, returned with their values exactly as stored, or `null` when none are configured.",
            "example": [
              {
                "key": "stream",
                "value": "false"
              }
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The request body template sent to your application, with its placeholders unresolved, or `null` when none is configured.",
            "example": {
              "query": "{{input}}"
            }
          },
          "payloadMode": {
            "$ref": "#/components/schemas/AIConnectionPayloadMode"
          },
          "hyperparameters": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The settings recorded against every test run made through this connection, or `null` when none are configured.",
            "example": {
              "model": "gpt-4o",
              "temperature": 0.2
            }
          },
          "authentication": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The authentication configuration applied when calling your application, returned exactly as stored, or `null` when none is configured.",
            "example": {
              "authType": "HMAC",
              "hmacConfig": {
                "headerKey": "X-Signature",
                "signaturePrefix": "sha256=",
                "secret": "YOUR-SIGNING-SECRET"
              }
            }
          },
          "cloudProvider": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The cloud vault configuration used to pull credentials at call time, returned exactly as stored, or `null` when none is configured.",
            "example": {
              "enabled": true,
              "provider": "AZURE_KEY_VAULT",
              "vaultUrl": "https://acme-vault.vault.azure.net/",
              "azureCredentials": {
                "tenantId": "YOUR-TENANT-ID",
                "clientId": "YOUR-CLIENT-ID",
                "clientSecret": "YOUR-CLIENT-SECRET"
              }
            }
          },
          "actualOutputKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked through your application's response to find its answer, each element an object key or an array index. Empty when a transformer extracts the answer instead, or when nothing is configured.",
            "example": [
              "choices",
              0,
              "message",
              "content"
            ]
          },
          "retrievalContextKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the retrieved context. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "retrieval",
              "documents"
            ]
          },
          "toolsCalledKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the tools your application called. Empty when a transformer extracts them instead, or when nothing is configured.",
            "example": [
              "tool_calls"
            ]
          },
          "stateKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the conversation state carried between simulated turns. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "session",
              "state"
            ]
          },
          "metadataKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the metadata written onto generated test cases. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "metadata"
            ]
          },
          "inputTokenCountKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the prompt token count. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "usage",
              "prompt_tokens"
            ]
          },
          "outputTokenCountKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the completion token count. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "usage",
              "completion_tokens"
            ]
          },
          "tokenCostKeyPath": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "The path walked to find the cost of the call. Empty when a transformer extracts it instead, or when nothing is configured.",
            "example": [
              "usage",
              "cost"
            ]
          },
          "actualOutputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the answer, or `null` when a key path does it instead.",
            "example": null
          },
          "retrievalContextTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the retrieved context, or `null` when a key path does it instead.",
            "example": null
          },
          "toolsCalledTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the tools called, or `null` when a key path does it instead.",
            "example": null
          },
          "stateTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the conversation state, or `null` when a key path does it instead.",
            "example": null
          },
          "metadataTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the metadata object, or `null` when a key path does it instead.",
            "example": null
          },
          "inputTokenCountTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the prompt token count, or `null` when a key path does it instead.",
            "example": null
          },
          "outputTokenCountTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the completion token count, or `null` when a key path does it instead.",
            "example": null
          },
          "tokenCostTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that extracts the cost of the call, or `null` when a key path does it instead.",
            "example": null
          },
          "actualOutputEvent": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a streaming `responseMode`, the event whose data carries the answer, or `null` when the answer is read out of a completed body.",
            "example": null
          },
          "retrievalContextEvent": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a streaming `responseMode`, the event whose data carries the retrieved context, or `null` when it is read out of a completed body.",
            "example": null
          },
          "toolsCalledEvent": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a streaming `responseMode`, the event whose data carries the tools called, or `null` when they are read out of a completed body.",
            "example": null
          },
          "stateEvent": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a streaming `responseMode`, the event whose data carries the conversation state, or `null` when it is read out of a completed body.",
            "example": null
          },
          "metadataEvent": {
            "type": [
              "string",
              "null"
            ],
            "description": "For a streaming `responseMode`, the event whose data carries the metadata, or `null` when it is read out of a completed body.",
            "example": null
          },
          "actualOutputAccumulate": {
            "type": "boolean",
            "description": "For a streaming `responseMode`, whether the chunks arriving on `actualOutputEvent` are joined into one answer rather than only the last one being kept.",
            "example": true
          },
          "mergeMetadata": {
            "type": "boolean",
            "description": "Whether extracted metadata is merged over the golden's metadata, the response winning on shared keys, rather than replacing it.",
            "example": true
          },
          "prompts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/AIConnectionPromptRef"
            },
            "description": "The prompts substituted into the request body, keyed by the placeholder they fill, or `null` when the connection references none.",
            "example": {
              "systemPrompt": {
                "alias": "customer-support",
                "label": "production"
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "active",
          "endpoint",
          "responseMode",
          "asyncResponse",
          "timeout",
          "maxConcurrency",
          "maxRetries",
          "defaultNumGenerations",
          "headers",
          "queryParams",
          "payload",
          "payloadMode",
          "hyperparameters",
          "authentication",
          "cloudProvider",
          "actualOutputKeyPath",
          "retrievalContextKeyPath",
          "toolsCalledKeyPath",
          "stateKeyPath",
          "metadataKeyPath",
          "inputTokenCountKeyPath",
          "outputTokenCountKeyPath",
          "tokenCostKeyPath",
          "actualOutputTransformerId",
          "retrievalContextTransformerId",
          "toolsCalledTransformerId",
          "stateTransformerId",
          "metadataTransformerId",
          "inputTokenCountTransformerId",
          "outputTokenCountTransformerId",
          "tokenCostTransformerId",
          "actualOutputEvent",
          "retrievalContextEvent",
          "toolsCalledEvent",
          "stateEvent",
          "metadataEvent",
          "actualOutputAccumulate",
          "mergeMetadata",
          "prompts"
        ],
        "description": "An LLM application registered with Confident AI: how to call it, and where in its response each value being evaluated lives. `headers`, `queryParams`, `authentication` and `cloudProvider` come back exactly as they were stored, credentials included.",
        "title": "AI Connection"
      },
      "AIConnectionKeyValue": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The header or query parameter name.",
            "example": "Authorization"
          },
          "value": {
            "type": "string",
            "description": "The value sent under this name on every request. It is stored as sent and read back as stored.",
            "example": "Bearer YOUR-TOKEN"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false,
        "description": "One header or query parameter Confident AI sends with every request to your application.",
        "title": "AI Connection Key Value"
      },
      "AIConnectionList": {
        "type": "object",
        "properties": {
          "aiConnections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AIConnectionSummary"
            },
            "description": "The AI connections for the current page, ordered by name."
          },
          "totalAIConnections": {
            "type": "integer",
            "description": "The total number of AI connections in this project.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of AI connections per page.",
            "example": 25
          }
        },
        "required": [
          "aiConnections",
          "totalAIConnections",
          "page",
          "pageSize"
        ],
        "description": "One page of AI connections, with the total across all pages.",
        "title": "AI Connection List"
      },
      "AIConnectionPayloadMode": {
        "type": "string",
        "enum": [
          "JSON",
          "CODE"
        ],
        "description": "Where the request body sent to your application comes from: JSON when it is the stored `payload` template, `CODE` when it is built by a code definition authored on the Confident AI platform. Sending `payload` through the API sets this to JSON.",
        "title": "AI Connection Payload Mode"
      },
      "AIConnectionPingResult": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Whether your application answered and Confident AI could read the configured values out of its response. This verdict replaces the connection's stored `active`.",
            "example": true
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the ping failed, or `null` when it succeeded. A failed ping is still a 200 response with `active` `false`, so read this rather than the status code.",
            "example": null
          },
          "statusCode": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The HTTP status your application returned: 408 when it timed out, 500 when the call could not be made at all, and `null` when no call was attempted.",
            "example": 200
          },
          "timeTaken": {
            "type": [
              "number",
              "null"
            ],
            "description": "How long the call took in seconds, or `null` when no call was attempted.",
            "example": 1.42
          },
          "request": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The body that was sent, with the payload placeholders and prompts resolved, or `null` when no call was attempted.",
            "example": {
              "query": "How tall is Mount Everest?"
            }
          },
          "response": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Your application's parsed response body. This is where to look for the real response shape behind a key path that read nothing, and it carries the reason when the call itself failed.",
            "example": {
              "choices": [
                {
                  "message": {
                    "content": "Mount Everest is 8,848 metres tall."
                  }
                }
              ]
            }
          },
          "rawResponse": {
            "type": [
              "string",
              "null"
            ],
            "description": "The unparsed response body, for applications that do not answer with JSON. Null when the response parsed.",
            "example": null
          },
          "actualOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "What `actualOutputKeyPath` or the actual output transformer pulled out of the response. Check it to confirm the connection reads the field you expect.",
            "example": "Mount Everest is 8,848 metres tall."
          },
          "retrievalContext": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "What was pulled out as the retrieved context, or `null` when the connection extracts none.",
            "example": null
          },
          "toolsCalled": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "description": "What was pulled out as the tools called, or `null` when the connection extracts none.",
            "example": null
          },
          "state": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "What was pulled out as the conversation state, or `null` when the connection extracts none.",
            "example": null
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "What was pulled out as the metadata, or `null` when the connection extracts none.",
            "example": null
          },
          "inputTokenCount": {
            "type": [
              "number",
              "null"
            ],
            "description": "What was pulled out as the prompt token count, or `null` when the connection extracts none.",
            "example": 18
          },
          "outputTokenCount": {
            "type": [
              "number",
              "null"
            ],
            "description": "What was pulled out as the completion token count, or `null` when the connection extracts none.",
            "example": 9
          },
          "tokenCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "What was pulled out as the cost of the call, or `null` when the connection extracts none.",
            "example": 0.002
          },
          "invalidActualOutput": {
            "type": "boolean",
            "description": "Whether the answer was found at its key path but is not a string, which means the path points at the wrong field.",
            "example": false
          },
          "invalidRetrievalContext": {
            "type": "boolean",
            "description": "Whether the retrieved context was found but is not a list of strings.",
            "example": false
          },
          "invalidToolsCalled": {
            "type": "boolean",
            "description": "Whether the tools called were found but are not a list of tool calls.",
            "example": false
          },
          "invalidState": {
            "type": "boolean",
            "description": "Whether the conversation state was found but could not be read.",
            "example": false
          },
          "invalidMetadata": {
            "type": "boolean",
            "description": "Whether the metadata was found but is not an object.",
            "example": false
          },
          "invalidInputTokenCount": {
            "type": "boolean",
            "description": "Whether the prompt token count was found but is not a number.",
            "example": false
          },
          "invalidOutputTokenCount": {
            "type": "boolean",
            "description": "Whether the completion token count was found but is not a number.",
            "example": false
          },
          "invalidTokenCost": {
            "type": "boolean",
            "description": "Whether the cost of the call was found but is not a number.",
            "example": false
          }
        },
        "required": [
          "active",
          "error",
          "statusCode",
          "timeTaken",
          "request",
          "response",
          "rawResponse",
          "actualOutput",
          "retrievalContext",
          "toolsCalled",
          "state",
          "metadata",
          "inputTokenCount",
          "outputTokenCount",
          "tokenCost",
          "invalidActualOutput",
          "invalidRetrievalContext",
          "invalidToolsCalled",
          "invalidState",
          "invalidMetadata",
          "invalidInputTokenCount",
          "invalidOutputTokenCount",
          "invalidTokenCost"
        ],
        "description": "What one test call to your application produced: whether it answered, what it sent back, and what Confident AI managed to extract from it. A ping that failed is reported here with `active` `false` rather than as an error status.",
        "title": "AI Connection Ping Result"
      },
      "AIConnectionPromptBranchRef": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "The alias of the prompt in this project.",
            "example": "customer-support"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "description": "The branch of the prompt to follow. The branch's head commit is what gets sent, so it moves as the branch moves.",
            "example": "main"
          }
        },
        "required": [
          "alias",
          "branch"
        ],
        "additionalProperties": false,
        "description": "A prompt followed through the head commit of one branch.",
        "title": "AI Connection Prompt Branch Ref"
      },
      "AIConnectionPromptCommitRef": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "The alias of the prompt in this project.",
            "example": "customer-support"
          },
          "hash": {
            "type": "string",
            "minLength": 1,
            "description": "The hash of the prompt commit to send, pinned exactly.",
            "example": "bab04ce"
          }
        },
        "required": [
          "alias",
          "hash"
        ],
        "additionalProperties": false,
        "description": "A prompt pinned to one of its commits.",
        "title": "AI Connection Prompt Commit Ref"
      },
      "AIConnectionPromptLabelRef": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "The alias of the prompt in this project.",
            "example": "customer-support"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The label on the prompt to follow. Whatever the label points at when the connection is called is what gets sent.",
            "example": "production"
          }
        },
        "required": [
          "alias",
          "label"
        ],
        "additionalProperties": false,
        "description": "A prompt followed through one of its labels.",
        "title": "AI Connection Prompt Label Ref"
      },
      "AIConnectionPromptRef": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AIConnectionPromptVersionRef"
          },
          {
            "$ref": "#/components/schemas/AIConnectionPromptLabelRef"
          },
          {
            "$ref": "#/components/schemas/AIConnectionPromptBranchRef"
          },
          {
            "$ref": "#/components/schemas/AIConnectionPromptCommitRef"
          }
        ],
        "description": "Which prompt to substitute into the payload, and how to pick the text of it. Name the prompt by `alias`, then choose it with exactly one of `version`, `label`, `branch` or `hash`.",
        "title": "AI Connection Prompt Ref"
      },
      "AIConnectionPromptVersionRef": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "The alias of the prompt in this project.",
            "example": "customer-support"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The version of the prompt to send, pinned exactly.",
            "example": "00.00.01"
          }
        },
        "required": [
          "alias",
          "version"
        ],
        "additionalProperties": false,
        "description": "A prompt pinned to one of its published versions.",
        "title": "AI Connection Prompt Version Ref"
      },
      "AIConnectionRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the AI connection, generated by Confident AI.",
            "example": "<AI-CONNECTION-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an AI connection by its id.",
        "title": "AI Connection Ref"
      },
      "AIConnectionResponseMode": {
        "type": "string",
        "enum": [
          "HTTP_RESPONSE",
          "SSE_STREAMING",
          "HTTP_STREAMING",
          "WEBSOCKET"
        ],
        "description": "How your application replies. `HTTP_RESPONSE` returns one completed body. `SSE_STREAMING`, `HTTP_STREAMING` and `WEBSOCKET` stream the answer, so the values are read from named events as they arrive rather than out of a finished body, and `WEBSOCKET` requires a `wss://` endpoint. Voice agents are set up as voice connections instead.",
        "title": "AI Connection Response Mode"
      },
      "AIConnectionSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the AI connection, generated by Confident AI.",
            "example": "<AI-CONNECTION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the AI connection, unique within the project.",
            "example": "Production Chatbot"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL Confident AI calls, or `null` when no endpoint has been configured.",
            "example": "https://api.example.com/chat"
          },
          "active": {
            "type": "boolean",
            "description": "Whether Confident AI could last reach your application and read an answer out of its response. Computed by Confident AI, not writable.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "endpoint",
          "active"
        ],
        "description": "An AI connection as it appears in a list: enough to pick one out. Retrieve it by id for its request, response and authentication configuration.",
        "title": "AI Connection Summary"
      },
      "AIConnectionType": {
        "type": "string",
        "enum": [
          "ENDPOINT",
          "RELAY_ENDPOINT",
          "AGENT_HANDLER"
        ],
        "description": "How Confident AI reaches your LLM application: `ENDPOINT` calls the `endpoint` you registered, `RELAY_ENDPOINT` calls it through the Confident AI relay so it never leaves your network boundary, and `AGENT_HANDLER` expects your own runner to pull work rather than being called, so it needs no endpoint. Defaults to `ENDPOINT`.",
        "title": "AI Connection Type"
      },
      "AdHocWidgetQueryRequest": {
        "type": "object",
        "properties": {
          "widget": {
            "$ref": "#/components/schemas/CreateWidgetRequest"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "The start of the range to compute over, as an ISO 8601 datetime. Must be sent together with `endTime`, and overrides a range set on the widget itself.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "The end of the range to compute over, as an ISO 8601 datetime. Must be sent together with `startTime`, and must be later than it.",
            "example": "2025-01-31T23:59:59.999Z"
          },
          "granularity": {
            "$ref": "#/components/schemas/WidgetGranularity"
          }
        },
        "required": [
          "widget"
        ],
        "additionalProperties": false,
        "description": "A widget definition to compute once without saving it. The same limits apply as to any query: at most 20 lines, a `topK.limit` of at most 100, and a range no longer than 366 days.",
        "title": "Ad Hoc Widget Query Request"
      },
      "AdHocWidgetQueryResult": {
        "type": "object",
        "properties": {
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The visualization the widget asked for, echoed back. It says how to draw the result, not how to read it — branch on `data.kind` for that."
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "The aggregation mode the widget asked for, echoed back. Branch on `data.kind` rather than on this when reading the result."
          },
          "data": {
            "$ref": "#/components/schemas/WidgetData"
          }
        },
        "required": [
          "type",
          "mode",
          "data"
        ],
        "description": "The computed data for a widget that was defined inline rather than saved, so it carries no widget id.",
        "title": "Ad Hoc Widget Query Result"
      },
      "AddQueueItemsRequest": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AddTraceQueueItemsRequest"
          },
          {
            "$ref": "#/components/schemas/AddSpanQueueItemsRequest"
          },
          {
            "$ref": "#/components/schemas/AddThreadQueueItemsRequest"
          }
        ],
        "description": "The production data to add to the queue. Send the list that matches the queue's `type` — `traceUuids` for a `TRACE` queue, `spanUuids` for a `SPAN` queue, `threadIds` for a `THREAD` queue — and every id must already exist in your project. Items already in the queue are skipped."
      },
      "AddSpanQueueItemsRequest": {
        "type": "object",
        "properties": {
          "spanUuids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The uuids of the spans to add.",
            "example": [
              "9d2c6f7e-1a3b-4c5d-8e9f-0a1b2c3d4e5f"
            ]
          }
        },
        "required": [
          "spanUuids"
        ],
        "additionalProperties": false,
        "description": "Spans to add to a `SPAN` queue.",
        "title": "Add Span Queue Items Request"
      },
      "AddThreadQueueItemsRequest": {
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The ids of the threads to add.",
            "example": [
              "thread-42"
            ]
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false,
        "description": "Threads to add to a `THREAD` queue.",
        "title": "Add Thread Queue Items Request"
      },
      "AddTraceQueueItemsRequest": {
        "type": "object",
        "properties": {
          "traceUuids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The uuids of the traces to add.",
            "example": [
              "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f"
            ]
          }
        },
        "required": [
          "traceUuids"
        ],
        "additionalProperties": false,
        "description": "Traces to add to a `TRACE` queue.",
        "title": "Add Trace Queue Items Request"
      },
      "AddedQueueItems": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the queue items created, one per item that was not already in the queue.",
            "example": [
              "<QUEUE-ITEM-ID>"
            ]
          }
        },
        "required": [
          "ids"
        ],
        "description": "The items created by adding production data to a queue.",
        "title": "Added Queue Items"
      },
      "AgentSpanRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "AGENT"
            ],
            "description": "The type of the span, always `AGENT` for an agent span.",
            "example": "AGENT"
          },
          "uuid": {
            "type": "string",
            "description": "The unique identifier of the span, generated by your application. Values that are not UUIDs are hashed into one.",
            "example": "<SPAN-UUID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "input": {
            "description": "This is the input to the span, as a string or any JSON value.",
            "example": "What is the capital of France?"
          },
          "output": {
            "description": "This is the output of the span, as a string or any JSON value.",
            "example": "The capital of France is Paris."
          },
          "error": {
            "type": "string",
            "description": "This is the error message, if an error occurred inside the span.",
            "example": "The model timed out after 30 seconds."
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus",
            "default": "SUCCESS"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:02Z"
          },
          "parentUuid": {
            "type": "string",
            "description": "This is the unique identifier of the span's parent span. Omit it for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollection": {
            "type": "string",
            "description": "This is the metric collection to be used for evaluating the span.",
            "example": "LLM Collection Name"
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your span, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your span, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the span, which is to be used for evaluation."
          },
          "integration": {
            "type": "string",
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDataConfig"
            },
            "description": "Metric results you already computed for this span, recorded as-is instead of being evaluated by Confident AI."
          },
          "availableTools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the list of names of available tools to be used in the span.",
            "example": [
              "get_capital"
            ]
          },
          "agentHandoffs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the list of potential agent handoffs in the span.",
            "example": [
              "geography_agent"
            ]
          }
        },
        "required": [
          "type",
          "uuid",
          "name",
          "startTime",
          "endTime",
          "availableTools",
          "agentHandoffs"
        ],
        "additionalProperties": false,
        "description": "A span recording an agent step, with the tools and handoffs available to it.",
        "title": "Agent Span"
      },
      "AiInsightsSummary": {
        "type": "object",
        "properties": {
          "summaryOverview": {
            "$ref": "#/components/schemas/SummaryOverview"
          },
          "topicSummaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicSummary"
            },
            "description": "The findings for each topic the test cases were grouped into."
          }
        },
        "required": [
          "summaryOverview",
          "topicSummaries"
        ],
        "description": "The AI-generated summary of a test run, produced on the Confident AI platform. Null until it has been generated.",
        "title": "AI Insights Summary"
      },
      "AlertDataModel": {
        "type": "string",
        "enum": [
          "TRACE",
          "SPAN",
          "LLM_SPAN",
          "AGENT_SPAN",
          "RETRIEVER_SPAN",
          "TOOL_SPAN",
          "CUSTOM_SPAN",
          "THREAD"
        ],
        "description": "What kind of production item an alert measures over. `TRACE` and `SPAN` alerts aggregate single requests; `THREAD` alerts aggregate conversations.",
        "title": "Alert Data Model"
      },
      "AlertSeverity": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "ERROR",
          "WARNING",
          "INFO"
        ],
        "description": "How urgent the alert is. It also decides who hears about it: an integration receives an alert only when it subscribes to that severity.",
        "title": "Alert Severity"
      },
      "AlertThresholdDirection": {
        "type": "string",
        "enum": [
          "above",
          "below"
        ],
        "description": "Whether the alert fires when the measured value rises above the threshold or falls below it.",
        "title": "Alert Threshold Direction"
      },
      "AlertThresholdSettings": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "description": "The number the measured value is compared against.",
            "example": 0.05
          },
          "direction": {
            "$ref": "#/components/schemas/AlertThresholdDirection"
          }
        },
        "required": [
          "value",
          "direction"
        ],
        "additionalProperties": false,
        "description": "When the alert fires. Latency is compared in seconds, cost in `USD`, and rates such as `ERROR_RATE` as fractions between 0 and 1.",
        "title": "Alert Threshold Settings"
      },
      "AnnotateQueueItemRequest": {
        "type": "object",
        "properties": {
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItemAnnotation"
            },
            "description": "The criteria ratings to record on the item, one entry per criterion."
          },
          "formResponses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItemFormResponse"
            },
            "description": "The annotations for the fields of the queue's annotation form. Sending them requires `annotatorEmail`."
          },
          "annotatorEmail": {
            "type": "string",
            "format": "email",
            "description": "The email address of the project member the work is credited to. Required when `formResponses` are sent, and what makes the annotation visible on the platform.",
            "example": "jane@acme.com"
          },
          "flagged": {
            "type": "boolean",
            "default": false,
            "description": "Whether to flag the item for a second opinion.",
            "example": false
          },
          "markAsCompleted": {
            "type": "boolean",
            "description": "Whether to mark the item annotated, taking it out of the pending list. Defaults to `true`.",
            "example": true
          }
        },
        "additionalProperties": false,
        "description": "The annotation to record on one queue item. Send at least one of `annotations` or `formResponses`."
      },
      "AnnotateQueueItemResult": {
        "type": "object",
        "properties": {
          "annotationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the annotations recorded, one per criterion rated.",
            "example": [
              "<ANNOTATION-ID>"
            ]
          },
          "formResponseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the form answers recorded, one per field answered.",
            "example": [
              "<ANNOTATION-FORM-RESPONSE-ID>"
            ]
          }
        },
        "required": [
          "annotationIds",
          "formResponseIds"
        ],
        "description": "What one item's annotation wrote.",
        "title": "Annotate Queue Item Result"
      },
      "Annotation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the annotation generated by Confident AI.",
            "example": "<ANNOTATION-ID>"
          },
          "fieldType": {
            "$ref": "#/components/schemas/AnnotationFieldType"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The annotated value, in the shape its `fieldType` expects: a boolean for `THUMBS_RATING` (`true` is thumbs up) and `BOOLEAN`, a whole number from 1 to 5 for `FIVE_STAR_RATING`, a number for `NUMBER` or `FLOAT`, a string for `TEXT` and `CHOICE`, and a list of strings for `MULTIPLE_CHOICE`. Null when the annotation was left without a value.",
            "example": true
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the annotation.",
            "example": null
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the explanation for the annotation.",
            "example": "Correct and concise."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the annotated expected outcome, for conversation annotations.",
            "example": null
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the annotated expected output, for span and trace annotations.",
            "example": "The capital of France is Paris."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the annotation was created.",
            "example": "2025-01-15T11:00:00.000Z"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "traceUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the trace this annotation was left on, or `null` when it was left on a span or thread.",
            "example": "3f9c2a1e-5b7d-4c8e-9f01-2a3b4c5d6e7f"
          },
          "spanUuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The uuid of the span this annotation was left on, or `null` when it was left on a trace or thread.",
            "example": null
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the thread this annotation was left on. It is also set for an annotation on a trace that belongs to a thread.",
            "example": null
          },
          "testCaseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the test case the annotated trace formed, for a trace ingested into a test run.",
            "example": null
          }
        },
        "required": [
          "id",
          "fieldType",
          "value",
          "name",
          "explanation",
          "expectedOutcome",
          "expectedOutput",
          "createdAt",
          "user",
          "traceUuid",
          "spanUuid",
          "threadId",
          "testCaseId"
        ],
        "description": "A human annotation left on a trace, span or thread, with the ids of what it was left on."
      },
      "AnnotationFieldType": {
        "type": "string",
        "enum": [
          "TEXT",
          "NUMBER",
          "FLOAT",
          "BOOLEAN",
          "CHOICE",
          "MULTIPLE_CHOICE",
          "FIVE_STAR_RATING",
          "THUMBS_RATING"
        ],
        "description": "The kind of value an annotation holds: `TEXT`, `NUMBER`, `FLOAT` or `BOOLEAN` for a free value, `CHOICE` or `MULTIPLE_CHOICE` for a choice from the options in the field's `config`, and `THUMBS_RATING` or `FIVE_STAR_RATING` for a rating.",
        "title": "Annotation Field Type"
      },
      "AnnotationList": {
        "type": "object",
        "properties": {
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Annotation"
            },
            "description": "The annotations for the current page."
          },
          "totalAnnotations": {
            "type": "integer",
            "description": "The total number of annotations matching the query across all pages.",
            "example": 1
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of annotations per page.",
            "example": 25
          }
        },
        "required": [
          "annotations",
          "totalAnnotations",
          "page",
          "pageSize"
        ],
        "description": "One page of annotations, with the total across all pages.",
        "title": "Annotation List"
      },
      "AnnotationQueue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the queue, generated by Confident AI.",
            "example": "<ANNOTATION-QUEUE-ID>"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the queue, unique within the project.",
            "example": "Failed geography answers"
          },
          "type": {
            "$ref": "#/components/schemas/AnnotationQueueType"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the queue was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the queue was last changed.",
            "example": "2025-01-16T09:00:00.000Z"
          },
          "formId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the annotation form asked of every item in this queue, or `null` when the queue has no form.",
            "example": "<ANNOTATION-FORM-ID>"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags on the queue, for grouping and filtering the queues in your project.",
            "example": [
              "geography",
              "week-12"
            ]
          },
          "totalItems": {
            "type": "integer",
            "description": "How many items the queue holds.",
            "example": 40
          },
          "completedItems": {
            "type": "integer",
            "description": "How many of those items have been annotated.",
            "example": 30
          },
          "pendingItems": {
            "type": "integer",
            "description": "How many items are still waiting to be annotated.",
            "example": 10
          },
          "completionPercentage": {
            "type": "integer",
            "description": "The share of the queue that has been annotated, from 0 to 100, rounded to a whole number.",
            "example": 75
          },
          "assignedItems": {
            "type": "integer",
            "description": "How many items in the queue are assigned to a reviewer.",
            "example": 24
          },
          "assignmentBreakdown": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AssignmentBreakdownEntry"
            },
            "description": "Each reviewer's share of the queue, keyed by their email address. Empty when no item is assigned.",
            "example": {
              "jane@acme.com": {
                "assigned": 12,
                "completed": 9
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "createdAt",
          "updatedAt",
          "formId",
          "tags",
          "totalItems",
          "completedItems",
          "pendingItems",
          "completionPercentage",
          "assignedItems",
          "assignmentBreakdown"
        ],
        "description": "A queue of production data your team annotates, with its progress and how the work is shared out.",
        "title": "Annotation Queue"
      },
      "AnnotationQueueItem": {
