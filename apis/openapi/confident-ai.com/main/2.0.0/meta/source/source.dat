            "type": "string",
            "description": "The id of the queue, generated by Confident AI.",
            "example": "<ANNOTATION-QUEUE-ID>"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the queue, unique within the project.",
            "example": "Failed geography answers"
          },
          "type": {
            "$ref": "#/components/schemas/AnnotationQueueType"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the queue was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the queue was last changed.",
            "example": "2025-01-16T09:00:00.000Z"
          },
          "formId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the annotation form asked of every item in this queue, or `null` when the queue has no form.",
            "example": "<ANNOTATION-FORM-ID>"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags on the queue, for grouping and filtering the queues in your project.",
            "example": [
              "geography",
              "week-12"
            ]
          },
          "totalItems": {
            "type": "integer",
            "description": "How many items the queue holds.",
            "example": 40
          },
          "completedItems": {
            "type": "integer",
            "description": "How many of those items have been annotated.",
            "example": 30
          },
          "pendingItems": {
            "type": "integer",
            "description": "How many items are still waiting to be annotated.",
            "example": 10
          },
          "completionPercentage": {
            "type": "integer",
            "description": "The share of the queue that has been annotated, from 0 to 100, rounded to a whole number.",
            "example": 75
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "createdAt",
          "updatedAt",
          "formId",
          "tags",
          "totalItems",
          "completedItems",
          "pendingItems",
          "completionPercentage"
        ],
        "description": "A queue as it appears in a list: what it holds and how far through it your team is, without the per-reviewer breakdown.",
        "title": "Annotation Queue Summary"
      },
      "AnnotationQueueType": {
        "type": "string",
        "enum": [
          "TRACE",
          "SPAN",
          "THREAD",
          "GOLDEN",
          "TEST_CASE"
        ],
        "description": "What a queue holds, fixed when it is created: `TRACE`, `SPAN` or `THREAD` queues are filled from your production data, while `GOLDEN` and `TEST_CASE` queues are filled by Confident AI. `TEST_RUN` is still accepted as an input alias for `TEST_CASE`.",
        "title": "Annotation Queue Type"
      },
      "AnnotationRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the annotation, generated by Confident AI.",
            "example": "<ANNOTATION-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an annotation by its id.",
        "title": "Annotation Ref"
      },
      "AnnotationSelectionType": {
        "type": "string",
        "enum": [
          "Spans",
          "Threads",
          "Traces"
        ],
        "description": "The annotation source for an `ANNOTATIONS` export: traces, spans, or threads.",
        "title": "Annotation Selection Type"
      },
      "AnnotationSortBy": {
        "type": "string",
        "enum": [
          "createdAt",
          "rating"
        ],
        "description": "The annotation field to sort by: `createdAt` orders by when the annotation was left, rating by the score a `THUMBS_RATING` or `FIVE_STAR_RATING` carries.",
        "title": "Annotation Sort By"
      },
      "AnnotationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the annotation generated by Confident AI.",
            "example": "<ANNOTATION-ID>"
          },
          "fieldType": {
            "$ref": "#/components/schemas/AnnotationFieldType"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The annotated value, in the shape its `fieldType` expects: a boolean for `THUMBS_RATING` (`true` is thumbs up) and `BOOLEAN`, a whole number from 1 to 5 for `FIVE_STAR_RATING`, a number for `NUMBER` or `FLOAT`, a string for `TEXT` and `CHOICE`, and a list of strings for `MULTIPLE_CHOICE`. Null when the annotation was left without a value.",
            "example": true
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the annotation.",
            "example": null
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the explanation for the annotation.",
            "example": "Correct and concise."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the annotated expected outcome, for conversation annotations.",
            "example": null
          },
          "expectedOutput": {
            "type": [
              "string",
              "null"
            ],
            "description": "This is the annotated expected output, for span and trace annotations.",
            "example": "The capital of France is Paris."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the annotation was created.",
            "example": "2025-01-15T11:00:00.000Z"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "fieldType",
          "value",
          "name",
          "explanation",
          "expectedOutcome",
          "expectedOutput",
          "createdAt",
          "user"
        ],
        "description": "A human rating as it appears under the trace, span or thread it was left on, without repeating the ids of that target.",
        "title": "Annotation Summary"
      },
      "AnnotationValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "The annotated value, in the shape its `fieldType` expects: a boolean for `THUMBS_RATING` (`true` is thumbs up) and `BOOLEAN`, a whole number from 1 to 5 for `FIVE_STAR_RATING`, a number for `NUMBER` or `FLOAT`, a string for `TEXT` and `CHOICE`, and a list of strings for `MULTIPLE_CHOICE`.",
        "title": "Annotation Value",
        "example": true
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key, generated by Confident AI.",
            "example": 1420
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The label for the key, shown on the Confident AI platform.",
            "example": "CI pipeline"
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the key authenticates. A deactivated key is rejected on every request until it is reactivated.",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the key was created.",
            "example": "2025-01-15T09:30:00.000Z"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The instant the key stops authenticating, or `null` when it never expires. Confident AI computes it from the `expiresInDays` duration sent when the key was created or last rotated.",
            "example": "2025-04-15T09:30:00.000Z"
          },
          "value": {
            "type": "string",
            "description": "The key, masked: fifteen asterisks followed by its last six characters. The full value is returned only by the response that issues it — creating a key, or rotating one — and never again.",
            "example": "***************LmNoPq"
          },
          "shadowValue": {
            "type": [
              "string",
              "null"
            ],
            "description": "The masked replacement value while a rotation's grace period is running, or `null` when no rotation is pending.",
            "example": "***************Tu6vWx"
          },
          "rotatesAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a pending rotation completes — `shadowValue` becomes `value` and the old value stops authenticating — or `null` when no rotation is pending.",
            "example": "2025-03-01T12:00:00.000Z"
          },
          "lastUsed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the key last authenticated a request, or `null` when it never has.",
            "example": "2025-02-28T18:45:12.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "valid",
          "created_at",
          "expiresAt",
          "value",
          "shadowValue",
          "rotatesAt",
          "lastUsed"
        ],
        "description": "An API key as it reads after it has been issued, with both secrets masked. Organization-scoped and project-scoped keys have the same shape; a key's scope is fixed when it is created and shows in the prefix of its value (`confident_<region>_org_` or `confident_<region>_proj_`).",
        "title": "API Key"
      },
      "ApiKeyList": {
        "type": "object",
        "properties": {
          "apiKeys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKey"
            },
            "description": "Every API key in the requested scope, newest first. Each key's secrets are masked."
          }
        },
        "required": [
          "apiKeys"
        ],
        "description": "The API keys of one organization or one project. There is no pagination: the whole set is returned.",
        "title": "API Key List"
      },
      "ApiKeyRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key that was revoked.",
            "example": 1420
          }
        },
        "required": [
          "id"
        ],
        "description": "Confirmation that an API key was revoked. The key's row is deleted and both of its values stop authenticating at once.",
        "title": "API Key Ref"
      },
      "AssessGovernanceControlResult": {
        "type": "object",
        "properties": {
          "projectsAssessed": {
            "type": "integer",
            "description": "How many governed projects the control was run against. It is 0 when the control is in no policy or has no version yet.",
            "example": 5
          },
          "assessments": {
            "type": "integer",
            "description": "How many verdicts this run recorded. It matches `projectsAssessed` unless recording one failed, in which case that project is skipped rather than reported.",
            "example": 5
          },
          "statusCounts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "How many projects resolved to each verdict, keyed by one of the `GovernanceControlStatus` values. A verdict no project resolved to is absent rather than zero, so an empty object means nothing was assessed.",
            "example": {
              "PASS": 4,
              "FAIL": 1
            }
          }
        },
        "required": [
          "projectsAssessed",
          "assessments",
          "statusCounts"
        ],
        "description": "What one on-demand run of a control produced across the projects it governs.",
        "title": "Assess Governance Control Result"
      },
      "AssignmentBreakdownEntry": {
        "type": "object",
        "properties": {
          "assigned": {
            "type": "integer",
            "description": "How many items in the queue are assigned to this reviewer.",
            "example": 12
          },
          "completed": {
            "type": "integer",
            "description": "How many of those items the reviewer has annotated.",
            "example": 9
          }
        },
        "required": [
          "assigned",
          "completed"
        ],
        "description": "One reviewer's share of a queue.",
        "title": "Assignment Breakdown Entry"
      },
      "AssignmentStrategy": {
        "type": "string",
        "enum": [
          "SINGLE_USER",
          "ROUND_ROBIN",
          "RANDOM"
        ],
        "description": "How harvested items are shared out among the reviewers: `SINGLE_USER` gives every item to one reviewer, `ROUND_ROBIN` deals them out in turn, and `RANDOM` assigns each one at random.",
        "title": "Assignment Strategy"
      },
      "AttackEngine": {
        "type": "object",
        "properties": {
          "generationGuidelines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra instructions the attacker follows when generating attacks against this system.",
            "example": [
              "Write in the voice of a frustrated customer."
            ]
          }
        },
        "additionalProperties": false,
        "description": "How attacks are generated for this run.",
        "title": "Attack Engine"
      },
      "AttackMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the attack method. It is the method's catalog name until this project configures it, and its generated id afterwards; both keep resolving.",
            "example": "Prompt Injection"
          },
          "name": {
            "type": "string",
            "description": "The name of the attack method, as the catalog spells it.",
            "example": "Prompt Injection"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the attack method does to the system under test.",
            "example": "Embeds instructions in the input that try to override the system prompt."
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether the attack plays out over a conversation rather than a single request.",
            "example": false
          },
          "exploitability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Level"
              },
              {
                "type": "null"
              }
            ],
            "description": "How easily the attack method exploits a vulnerable system."
          },
          "configurable": {
            "type": "boolean",
            "description": "Whether the attack method takes parameters. Updating one that takes none is rejected.",
            "example": true
          },
          "parameters": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/AttackParameter"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The parameters the attack method takes, keyed by parameter name, each carrying the value in force for this project. Null when the method takes none."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "multiTurn",
          "exploitability",
          "configurable",
          "parameters"
        ],
        "description": "One way of attacking the system under test, drawn from the Confident AI catalog and configured per project.",
        "title": "Attack Method"
      },
      "AttackMethodList": {
        "type": "object",
        "properties": {
          "attackMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttackMethodSummary"
            },
            "description": "The attack methods for the current page, ordered by name."
          },
          "totalAttackMethods": {
            "type": "integer",
            "description": "The total number of attack methods matching the query across all pages.",
            "example": 42
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of attack methods per page.",
            "example": 25
          }
        },
        "required": [
          "attackMethods",
          "totalAttackMethods",
          "page",
          "pageSize"
        ],
        "description": "One page of attack methods, with the total across all pages.",
        "title": "Attack Method List"
      },
      "AttackMethodRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the attack method.",
            "example": "Prompt Injection"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an attack method by its id.",
        "title": "Attack Method Ref"
      },
      "AttackMethodSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the attack method. It is the method's catalog name until this project configures it, and its generated id afterwards; both keep resolving.",
            "example": "Prompt Injection"
          },
          "name": {
            "type": "string",
            "description": "The name of the attack method, as the catalog spells it.",
            "example": "Prompt Injection"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the attack method does to the system under test.",
            "example": "Embeds instructions in the input that try to override the system prompt."
          },
          "multiTurn": {
            "type": "boolean",
            "description": "Whether the attack plays out over a conversation rather than a single request.",
            "example": false
          },
          "exploitability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Level"
              },
              {
                "type": "null"
              }
            ],
            "description": "How easily the attack method exploits a vulnerable system."
          },
          "configurable": {
            "type": "boolean",
            "description": "Whether the attack method takes parameters. Updating one that takes none is rejected.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "multiTurn",
          "exploitability",
          "configurable"
        ],
        "description": "An attack method as it appears in a list, without its parameters.",
        "title": "Attack Method Summary"
      },
      "AttackParameter": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/AttackParameterType"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the attack method refuses to run without this parameter.",
            "example": true
          },
          "description": {
            "type": "string",
            "description": "What the parameter controls.",
            "example": "The persona the attacker adopts."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The values an `enum` parameter accepts.",
            "example": [
              "polite",
              "urgent"
            ]
          },
          "default": {
            "description": "The value this project has configured, or the catalog default when it has configured none.",
            "example": "urgent"
          }
        },
        "required": [
          "type"
        ],
        "description": "One setting an attack method takes, with the value in force for this project.",
        "title": "Attack Parameter"
      },
      "AttackParameterType": {
        "type": "string",
        "enum": [
          "string",
          "integer",
          "float",
          "boolean",
          "enum",
          "json"
        ],
        "description": "The kind of value a parameter takes. `enum` accepts one of the strings in `options`, and `json` accepts an object.",
        "title": "Attack Parameter Type"
      },
      "AuditLogExport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the export, a UUID generated by Confident AI. Poll and download the export by this id.",
            "example": "<AUDIT-LOG-EXPORT-ID>"
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The project whose audit logs the export covers, or `null` for an organization-wide export covering every project.",
            "example": null
          },
          "organizationId": {
            "type": "string",
            "description": "The organization the export belongs to.",
            "example": "<ORGANIZATION-ID>"
          },
          "userId": {
            "type": "string",
            "description": "The actor that started the export. `api` for an export started with an organization API key, or the user's id when started through an MCP OAuth session. An export is only visible to the actor that started it.",
            "example": "api"
          },
          "status": {
            "$ref": "#/components/schemas/AuditLogExportStatus"
          },
          "exportType": {
            "type": "string",
            "enum": [
              "TRACES",
              "TRACES_WITH_SPANS",
              "CONVERSATIONS",
              "CONVERSATION_METRICS",
              "ANNOTATIONS",
              "TEST_RUNS",
              "AUDIT_LOGS"
            ],
            "description": "The kind of data the file contains. Always `AUDIT_LOGS` for an export started at an audit log export endpoint.",
            "example": "AUDIT_LOGS"
          },
          "startTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Start of the period the export covers, inclusive. For an all-time export this is the timestamp of the oldest audit log matched.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "End of the period the export covers, inclusive. For an all-time export this is the timestamp of the newest audit log matched.",
            "example": "2025-04-01T00:00:00.000Z"
          },
          "rowCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many audit logs were written to the file. Null until the export completes.",
            "example": 18432
          },
          "errorMessage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the export failed, when `status` is `ERRORED`. Null otherwise.",
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the export was started.",
            "example": "2025-04-02T09:15:00.000Z"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the export finished or failed. Null while it is still running.",
            "example": "2025-04-02T09:17:42.000Z"
          }
        },
        "required": [
          "id",
          "projectId",
          "organizationId",
          "userId",
          "status",
          "exportType",
          "startTime",
          "endTime",
          "rowCount",
          "errorMessage",
          "createdAt",
          "completedAt"
        ],
        "description": "One run of an audit log export: the period it covers, where it is in its lifecycle, and how many audit logs its file holds once it completes.",
        "title": "Audit Log Export"
      },
      "AuditLogExportStatus": {
        "type": "string",
        "enum": [
          "IN_PROGRESS",
          "COMPLETED",
          "ERRORED"
        ],
        "description": "Where an export is in its lifecycle. It is created `IN_PROGRESS`, becomes `COMPLETED` once its file is written to storage, and becomes `ERRORED` if the run failed. Only a `COMPLETED` export has a file to download, and both `COMPLETED` and `ERRORED` are terminal.",
        "title": "Audit Log Export Status"
      },
      "BaseSpanRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SPAN"
            ],
            "default": "SPAN",
            "description": "The type of the span. Omit it, or send `SPAN`, for a plain span.",
            "example": "SPAN"
          },
          "uuid": {
            "type": "string",
            "description": "The unique identifier of the span, generated by your application. Values that are not UUIDs are hashed into one.",
            "example": "<SPAN-UUID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the span.",
            "example": "OpenAI Call"
          },
          "input": {
            "description": "This is the input to the span, as a string or any JSON value.",
            "example": "What is the capital of France?"
          },
          "output": {
            "description": "This is the output of the span, as a string or any JSON value.",
            "example": "The capital of France is Paris."
          },
          "error": {
            "type": "string",
            "description": "This is the error message, if an error occurred inside the span.",
            "example": "The model timed out after 30 seconds."
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus",
            "default": "SUCCESS"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span started, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the span ended, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:02Z"
          },
          "parentUuid": {
            "type": "string",
            "description": "This is the unique identifier of the span's parent span. Omit it for a root span.",
            "example": "<PARENT-SPAN-UUID>"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the span.",
            "example": {
              "region": "Europe"
            }
          },
          "metricCollection": {
            "type": "string",
            "description": "This is the metric collection to be used for evaluating the span.",
            "example": "LLM Collection Name"
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your span, which is to be used for evaluation.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your span, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your span, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the span, which is to be used for evaluation."
          },
          "integration": {
            "type": "string",
            "description": "This is the integration associated with the span.",
            "example": "LangChain"
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDataConfig"
            },
            "description": "Metric results you already computed for this span, recorded as-is instead of being evaluated by Confident AI."
          }
        },
        "required": [
          "uuid",
          "name",
          "startTime",
          "endTime"
        ],
        "additionalProperties": false,
        "description": "A plain span with no model, retriever, tool or agent detail.",
        "title": "Base Span"
      },
      "BatchAnnotateFailure": {
        "type": "object",
        "properties": {
          "queueItemId": {
            "type": "string",
            "description": "The id of the queue item this result is for.",
            "example": "<QUEUE-ITEM-ID>"
          },
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "False when the entry could not be annotated.",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "Why this entry failed. The rest of the batch still applied.",
            "example": "Queue item not found in this queue."
          }
        },
        "required": [
          "queueItemId",
          "success",
          "error"
        ],
        "description": "An entry that could not be annotated.",
        "title": "Batch Annotate Failure"
      },
      "BatchAnnotateItem": {
        "type": "object",
        "properties": {
          "queueItemId": {
            "type": "string",
            "minLength": 1,
            "description": "The id of the queue item this entry annotates.",
            "example": "<QUEUE-ITEM-ID>"
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItemAnnotation"
            },
            "description": "The criteria ratings to record on the item, one entry per criterion."
          },
          "formResponses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItemFormResponse"
            },
            "description": "The annotations for the fields of the queue's annotation form. Sending them requires `annotatorEmail`."
          },
          "annotatorEmail": {
            "type": "string",
            "format": "email",
            "description": "The email address of the project member the work is credited to. Required when `formResponses` are sent, and what makes the annotation visible on the platform.",
            "example": "jane@acme.com"
          },
          "flagged": {
            "type": "boolean",
            "default": false,
            "description": "Whether to flag the item for a second opinion.",
            "example": false
          },
          "markAsCompleted": {
            "type": "boolean",
            "description": "Whether to mark the item annotated, taking it out of the pending list. Defaults to `true`.",
            "example": true
          }
        },
        "required": [
          "queueItemId"
        ],
        "additionalProperties": false,
        "description": "One item's annotation within a batch. Anything it omits falls back to the batch-level value.",
        "title": "Batch Annotate Item"
      },
      "BatchAnnotateRequest": {
        "type": "object",
        "properties": {
          "annotatorEmail": {
            "type": "string",
            "format": "email",
            "description": "The email address credited for every entry that does not name its own annotator.",
            "example": "jane@acme.com"
          },
          "markAsCompleted": {
            "type": "boolean",
            "description": "Whether to mark the items annotated, for every entry that does not say otherwise. Defaults to `true`.",
            "example": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchAnnotateItem"
            },
            "minItems": 1,
            "description": "The items to annotate. Each is processed on its own, so one failure does not stop the rest."
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "description": "Annotations for several items of one queue, applied in a single call. Every item must belong to the queue in the path."
      },
      "BatchAnnotateResult": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/BatchAnnotateSuccess"
                },
                {
                  "$ref": "#/components/schemas/BatchAnnotateFailure"
                }
              ]
            },
            "description": "One result per entry sent, in the order they were sent. Read `success` on each to tell the two shapes apart."
          }
        },
        "required": [
          "results"
        ],
        "description": "One result per entry sent to a batch annotation.",
        "title": "Batch Annotate Result"
      },
      "BatchAnnotateSuccess": {
        "type": "object",
        "properties": {
          "queueItemId": {
            "type": "string",
            "description": "The id of the queue item this result is for.",
            "example": "<QUEUE-ITEM-ID>"
          },
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "True when the item was annotated.",
            "example": true
          },
          "annotationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the annotations recorded for this item.",
            "example": [
              "<ANNOTATION-ID>"
            ]
          },
          "formResponseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the form answers recorded for this item.",
            "example": [
              "<ANNOTATION-FORM-RESPONSE-ID>"
            ]
          }
        },
        "required": [
          "queueItemId",
          "success",
          "annotationIds",
          "formResponseIds"
        ],
        "description": "An entry that was annotated.",
        "title": "Batch Annotate Success"
      },
      "Classification": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "The label the classifier assigned.",
            "example": "geography"
          },
          "reason": {
            "type": "string",
            "description": "The classifier's reason for choosing the label.",
            "example": "The user asks for the capital city of a country."
          }
        },
        "required": [
          "label",
          "reason"
        ],
        "description": "A label assigned by one of your project's classifiers, with the reason it was chosen."
      },
      "Classifier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the classifier, generated by Confident AI.",
            "example": "<CLASSIFIER-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the classifier.",
            "example": "Sentiment"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What this classifier is for, or `null` when it has no description.",
            "example": "Analyzes the emotional tone of user interactions."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the classifier runs at all.",
            "example": true
          },
          "autoClassify": {
            "type": "boolean",
            "description": "Whether incoming items are classified automatically as they arrive.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/ClassifierDataModel"
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet"
          },
          "autoGenerationConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassifierAutoGenerationConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "How a generation run samples and clusters your traffic, or `null` when the classifier has no generation config."
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassifierLabel"
            },
            "description": "The labels this classifier can apply."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "enabled",
          "autoClassify",
          "dataModel",
          "filters",
          "autoGenerationConfig",
          "labels"
        ],
        "description": "A classifier: what it runs on, how it discovers labels, and the labels it can apply.",
        "title": "Classifier"
      },
      "ClassifierAutoGenerationConfig": {
        "type": "object",
        "properties": {
          "summaryPrompt": {
            "type": "string",
            "minLength": 1,
            "description": "What the model should look for when clustering sampled traffic into themes.",
            "example": "Analyze the user's input to determine the emotional tone they express."
          },
          "nClusters": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Roughly how many themes to cluster the sample into.",
            "example": 3
          },
          "sampleSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "How many traces or threads to sample. Defaults to 200.",
            "example": 200
          }
        },
        "required": [
          "summaryPrompt",
          "nClusters"
        ],
        "additionalProperties": false,
        "description": "How a generation run samples and clusters your traffic. Both `summaryPrompt` and `nClusters` must be set before the generate endpoint will run.",
        "title": "Classifier Auto Generation Config"
      },
      "ClassifierDataModel": {
        "type": "string",
        "enum": [
          "TRACE",
          "THREAD"
        ],
        "description": "What kind of production item a classifier labels: `TRACE` labels individual traces, `THREAD` labels whole conversations. It is fixed when the classifier is created.",
        "title": "Classifier Data Model"
      },
      "ClassifierLabel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the label, generated by Confident AI.",
            "example": "<CLASSIFIER-LABEL-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the label, unique within the classifier.",
            "example": "Positive"
          },
          "description": {
            "type": "string",
            "description": "When this label applies. This is the instruction the classifying model reads, so it states the condition rather than restating the name.",
            "example": "User expresses satisfaction, gratitude, or positive sentiment."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the label can be applied.",
            "example": true
          },
          "status": {
            "$ref": "#/components/schemas/ClassifierLabelStatus"
          },
          "polarity": {
            "$ref": "#/components/schemas/SignalPolarity"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "enabled",
          "status",
          "polarity"
        ],
        "description": "One label a classifier can apply to what it classifies.",
        "title": "Classifier Label"
      },
      "ClassifierLabelGeneration": {
        "type": "object",
        "properties": {
          "classifierId": {
            "type": "string",
            "description": "The classifier labels were generated for.",
            "example": "<CLASSIFIER-ID>"
          },
          "started": {
            "type": "boolean",
            "description": "Whether a generation run was dispatched. False means there was too little traffic to sample, or sampling was briefly unavailable — it is an outcome, not an error.",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "A human-readable explanation of the outcome.",
            "example": "Label generation started. Generated labels appear with status RECOMMENDED when the run completes."
          }
        },
        "required": [
          "classifierId",
          "started",
          "message"
        ],
        "description": "The outcome of dispatching a label generation run. The run itself is asynchronous and returns no handle, so poll the labels endpoint for its results.",
        "title": "Classifier Label Generation"
      },
      "ClassifierLabelList": {
        "type": "object",
        "properties": {
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassifierLabelSummary"
            },
            "description": "The labels for the current page, ordered by name."
          },
          "totalLabels": {
            "type": "integer",
            "description": "The total number of labels on this classifier across all pages.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of labels per page.",
            "example": 25
          }
        },
        "required": [
          "labels",
          "totalLabels",
          "page",
          "pageSize"
        ],
        "description": "One page of labels, with the total across all pages.",
        "title": "Classifier Label List"
      },
      "ClassifierLabelRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the label, generated by Confident AI.",
            "example": "<CLASSIFIER-LABEL-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a classifier label by its id.",
        "title": "Classifier Label Ref"
      },
      "ClassifierLabelStatus": {
        "type": "string",
        "enum": [
          "RECOMMENDED",
          "ACTIVE"
        ],
        "description": "`ACTIVE` labels are in use; `RECOMMENDED` ones are generated suggestions awaiting review.",
        "title": "Classifier Label Status"
      },
      "ClassifierLabelSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the label, generated by Confident AI.",
            "example": "<CLASSIFIER-LABEL-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the label.",
            "example": "Positive"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the label can be applied.",
            "example": true
          },
          "status": {
            "$ref": "#/components/schemas/ClassifierLabelStatus"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "status"
        ],
        "description": "A label as it appears in a list: enough to triage a generated suggestion, without its description or polarity.",
        "title": "Classifier Label Summary"
      },
      "ClassifierList": {
        "type": "object",
        "properties": {
          "classifiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassifierSummary"
            },
            "description": "The classifiers for the current page, ordered by name."
          },
          "totalClassifiers": {
            "type": "integer",
            "description": "The total number of classifiers matching the query across all pages.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of classifiers per page.",
            "example": 25
          }
        },
        "required": [
          "classifiers",
          "totalClassifiers",
          "page",
          "pageSize"
        ],
        "description": "One page of classifiers, with the total across all pages.",
        "title": "Classifier List"
      },
      "ClassifierPreset": {
        "type": "string",
        "enum": [
          "CUSTOM",
          "SENTIMENT",
          "TOPICS",
          "USE_CASES",
          "ISSUES"
        ],
        "description": "A Confident AI template to seed a classifier from. `SENTIMENT` arrives with its labels ready; `TOPICS`, `USE_CASES` and `ISSUES` ship with none and expect a generation run next. `CUSTOM` seeds nothing.",
        "title": "Classifier Preset"
      },
      "ClassifierRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the classifier, generated by Confident AI.",
            "example": "<CLASSIFIER-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a classifier by its id.",
        "title": "Classifier Ref"
      },
      "ClassifierSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the classifier, generated by Confident AI.",
            "example": "<CLASSIFIER-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the classifier.",
            "example": "Sentiment"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the classifier runs at all.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/ClassifierDataModel"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "dataModel"
        ],
        "description": "A classifier as it appears in a list: enough to pick one, without its filters, generation config, or labels.",
        "title": "Classifier Summary"
      },
      "ClassifierVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the version, generated by Confident AI.",
            "example": "<CLASSIFIER-VERSION-ID>"
          },
          "classifierId": {
            "type": "string",
            "description": "The id of the classifier this version belongs to.",
            "example": "<CLASSIFIER-ID>"
          },
          "sequence": {
            "type": "integer",
            "description": "The position of this version in the classifier's history, counting from 1. The highest sequence is the current version, which is the one new classifications run against.",
            "example": 2
          },
          "version": {
            "type": "string",
            "description": "The human-readable label for `sequence`, written as three two-digit groups that roll over at 100, so sequence 2 is `00.00.02` and sequence 100 is `00.01.00`.",
            "example": "00.00.02"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The classifier description the model was shown, or null when it had none.",
            "example": "Analyzes the emotional tone of user interactions."
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassifierVersionLabel"
            },
            "description": "The labels the model could apply, ordered by name: enabled ACTIVE labels, plus enabled RECOMMENDED ones when the classifier classifies automatically."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this version was snapshotted.",
            "example": "2025-01-18T16:45:00.000Z"
          },
          "author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ],
            "description": "Who made the change that created this version, or null when it came from an API key or from Confident AI itself, such as a generated label."
          }
        },
        "required": [
          "id",
          "classifierId",
          "sequence",
          "version",
          "description",
          "labels",
          "createdAt",
          "author"
        ],
        "description": "An immutable snapshot of what a classifier shows the classifying model: its description and the labels it can apply. Changing either appends a new version, and every classification records the version it was produced under.",
        "title": "Classifier Version"
      },
      "ClassifierVersionLabel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the label.",
            "example": "Positive"
          },
          "description": {
            "type": "string",
            "description": "When the label applies, as the classifying model read it.",
            "example": "User expresses satisfaction, gratitude, or positive sentiment."
          }
        },
        "required": [
          "name",
          "description"
        ],
        "description": "A label as the classifying model was shown it.",
        "title": "Classifier Version Label"
      },
      "ClassifierVersionList": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassifierVersion"
            },
            "description": "The classifier's history for the current page, newest version first, so the first entry of the first page is the current version."
          },
          "totalClassifierVersions": {
            "type": "integer",
            "description": "The number of versions this classifier has, across every page.",
            "example": 2
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of versions per page.",
            "example": 25
          }
        },
        "required": [
          "versions",
          "totalClassifierVersions",
          "page",
          "pageSize"
        ],
        "description": "One page of a classifier's version history, with the total across all pages.",
        "title": "Classifier Version List"
      },
      "ClearProjectModelResult": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/ModelSource"
          }
        },
        "required": [
          "source"
        ],
        "description": "Confirmation that the project no longer overrides this model type. `source` is always `organization`, since the project now follows the organization's default.",
        "title": "Clear Project Model Result"
      },
      "CreatableGovernanceControlType": {
        "type": "string",
        "enum": [
          "RUNTIME",
          "PRE_DEPLOYMENT_EVALS",
          "PRE_DEPLOYMENT_RED_TEAMING"
        ],
        "description": "The control types you can create. `OPERATIONAL` is absent because Confident AI seeds those controls from its own registry.",
        "title": "Creatable Governance Control Type"
      },
      "CreateAIConnectionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the AI connection, unique within the project.",
            "example": "Production Chatbot"
          },
          "type": {
            "$ref": "#/components/schemas/AIConnectionType"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The `https://` URL Confident AI calls to reach your LLM application, or a `wss://` URL when `responseMode` is `WEBSOCKET`. An `AGENT_HANDLER` connection needs none. Send `null` to clear it.",
            "example": "https://api.example.com/chat"
          },
          "responseMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AIConnectionResponseMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "How your application replies. Send `null` to clear it, which reads the answer out of a completed HTTP response body."
          },
          "asyncResponse": {
            "type": "boolean",
            "description": "Whether your application acknowledges the request and posts the result back later instead of answering inline. Only a non-streaming `responseMode` supports this.",
            "example": false
          },
          "timeout": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many seconds to wait for your application to answer before giving up on a request. Defaults to 60 when the connection is created. Send `null` to clear it.",
            "example": 60
          },
          "maxConcurrency": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "The most requests Confident AI sends to your application at the same time. Send `null` to leave it unbounded.",
            "example": 5
          },
          "maxRetries": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "How many times a failed request is retried before the test case is recorded as errored. Send `null` to clear it.",
            "example": 3
          },
          "defaultNumGenerations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many times your application is called per test case, so one unlucky output does not decide the result. At most 50.",
            "example": 1
          },
          "headers": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AIConnectionKeyValue"
            },
            "description": "The headers sent with every request. The list replaces the stored headers rather than merging into them, so include every header the connection should keep. Send `null` to clear them.",
            "example": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR-TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "queryParams": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AIConnectionKeyValue"
            },
            "description": "The query parameters appended to every request. The list replaces the stored parameters rather than merging into them. Send `null` to clear them.",
            "example": [
              {
                "key": "stream",
                "value": "false"
              }
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The request body template Confident AI sends. Placeholders such as `{{input}}` are filled from the test case, and any key in `prompts` is filled with that prompt's text. Send `null` to clear it.",
            "example": {
              "query": "{{input}}"
            }
          },
          "hyperparameters": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Free-form settings recorded against every test run made through this connection, so results can be compared across configurations. They are not sent to your application. Send `null` to clear them.",
            "example": {
              "model": "gpt-4o",
              "temperature": 0.2
            }
          },
          "authentication": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The authentication configuration Confident AI applies when calling your application. Set `authType` to `AUTH0`, `HMAC`, `AZURE_AD` or `OAUTH2_CLIENT_CREDENTIALS` and put that scheme's settings in the matching object: `auth0Config`, `hmacConfig`, `azureAdConfig` or `oauth2Config`. A value that does not match that shape is rejected. Send `null` to clear it.",
            "example": {
              "authType": "HMAC",
              "hmacConfig": {
                "headerKey": "X-Signature",
                "signaturePrefix": "sha256=",
                "secret": "YOUR-SIGNING-SECRET"
              }
            }
          },
          "cloudProvider": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "The cloud vault configuration Confident AI uses to pull credentials at call time instead of holding them itself. Set `enabled`, `provider` to `AZURE_KEY_VAULT`, `vaultUrl` to your vault, and `azureCredentials` with the `tenantId`, `clientId` and `clientSecret` used to read from it. A value that does not match that shape is rejected. Send `null` to clear it.",
            "example": {
              "enabled": true,
              "provider": "AZURE_KEY_VAULT",
              "vaultUrl": "https://acme-vault.vault.azure.net/",
              "azureCredentials": {
                "tenantId": "YOUR-TENANT-ID",
                "clientId": "YOUR-CLIENT-ID",
                "clientSecret": "YOUR-CLIENT-SECRET"
              }
            }
          },
          "actualOutputKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where your application's answer sits in its response. Each element is an object key or an array index, walked in order, so `[\"choices\", 0, \"message\", \"content\"]` reads `choices[0].message.content`. A connection needs this or `actualOutputTransformerId` before it can be used. Send `null` or an empty list to clear it.",
            "example": [
              "choices",
              0,
              "message",
              "content"
            ]
          },
          "retrievalContextKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the retrieved context sits in your application's response, walked the same way as `actualOutputKeyPath`. Set it for RAG applications so retrieval metrics have something to score. Send `null` or an empty list to clear it.",
            "example": [
              "retrieval",
              "documents"
            ]
          },
          "toolsCalledKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the list of tools your application called sits in its response, walked the same way as `actualOutputKeyPath`. Set it for agents so tool-use metrics have something to score. Send `null` or an empty list to clear it.",
            "example": [
              "tool_calls"
            ]
          },
          "stateKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the conversation state sits in your application's response, walked the same way as `actualOutputKeyPath`. Confident AI reads it after each simulated turn and sends it back on the next one. Send `null` or an empty list to clear it.",
            "example": [
              "session",
              "state"
            ]
          },
          "metadataKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where an object of metadata sits in your application's response, walked the same way as `actualOutputKeyPath`. Its keys are written onto the generated test case's metadata, merged over the golden's own metadata unless `mergeMetadata` is `false`. Send `null` or an empty list to clear it.",
            "example": [
              "metadata"
            ]
          },
          "inputTokenCountKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the prompt token count sits in your application's response, walked the same way as `actualOutputKeyPath`. Send `null` or an empty list to clear it.",
            "example": [
              "usage",
              "prompt_tokens"
            ]
          },
          "outputTokenCountKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the completion token count sits in your application's response, walked the same way as `actualOutputKeyPath`. Send `null` or an empty list to clear it.",
            "example": [
              "usage",
              "completion_tokens"
            ]
          },
          "tokenCostKeyPath": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where the cost of the call sits in your application's response, walked the same way as `actualOutputKeyPath`. Send `null` or an empty list to clear it.",
            "example": [
              "usage",
              "cost"
            ]
          },
          "actualOutputEvent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "For a streaming `responseMode`, the name of the event carrying your application's answer. Confident AI reads the value out of the events with this name instead of out of a completed body, applying `actualOutputKeyPath` to each one. Send `null` to clear it.",
            "example": "token"
          },
          "retrievalContextEvent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "For a streaming `responseMode`, the name of the event carrying the retrieved context, read the same way as `actualOutputEvent`. Send `null` to clear it.",
            "example": "retrieval"
          },
          "toolsCalledEvent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "For a streaming `responseMode`, the name of the event carrying the tools called, read the same way as `actualOutputEvent`. Send `null` to clear it.",
            "example": "tool_call"
          },
          "stateEvent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "For a streaming `responseMode`, the name of the event carrying the conversation state, read the same way as `actualOutputEvent`. Send `null` to clear it.",
            "example": "state"
          },
          "metadataEvent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "For a streaming `responseMode`, the name of the event carrying the metadata, read the same way as `actualOutputEvent`. Send `null` to clear it.",
            "example": "metadata"
          },
          "actualOutputAccumulate": {
            "type": "boolean",
            "description": "For a streaming `responseMode`, whether the chunks arriving on `actualOutputEvent` are joined into one answer. Set it to `false` when each event already carries the whole answer and only the last one counts.",
            "example": true
          },
          "mergeMetadata": {
            "type": "boolean",
            "description": "Whether the extracted metadata is merged over the golden's metadata, with the response winning on shared keys (`true`, the default), or replaces it outright (`false`).",
            "example": true
          },
          "actualOutputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the answer by running your code over the response, for shapes a key path cannot reach. Send this or `actualOutputKeyPath`, never both. The transformer must belong to this project. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "retrievalContextTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the retrieved context. Send this or `retrievalContextKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "toolsCalledTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the tools called. Send this or `toolsCalledKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "stateTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the conversation state. Send this or `stateKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "metadataTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the metadata object. Send this or `metadataKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "inputTokenCountTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the prompt token count. Send this or `inputTokenCountKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "outputTokenCountTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the completion token count. Send this or `outputTokenCountKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "tokenCostTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that extracts the cost of the call. Send this or `tokenCostKeyPath`, never both. Send `null` to clear it.",
            "example": "<TRANSFORMER-ID>"
          },
          "prompts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/AIConnectionPromptRef"
            },
            "description": "The prompts to substitute into the request body, keyed by the placeholder they fill in `payload`. The map replaces the connection's current prompts rather than merging into them.",
            "example": {
              "systemPrompt": {
                "alias": "customer-support",
                "label": "production"
              }
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "The LLM application to register. Confident AI calls the endpoint once as the connection is created to work out whether it is `active`. For each of the seven values Confident AI extracts from a response, send either its key path or its transformer id, never both.",
        "title": "Create AI Connection Request"
      },
      "CreateAnnotationQueueRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the queue, which must be unique in the project.",
            "example": "Failed geography answers"
          },
          "type": {
            "$ref": "#/components/schemas/AnnotationQueueType"
          },
          "formId": {
            "type": "string",
            "minLength": 1,
            "description": "The id of an annotation form in this project to ask of every item in the queue. Forms are created and managed in the Confident AI platform.",
            "example": "<ANNOTATION-FORM-ID>"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50,
            "description": "Tags to put on the queue. A tag that does not exist in the project yet is created.",
            "example": [
              "geography",
              "week-12"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "description": "A queue to open for your team to annotate. Its `type` is fixed at creation and decides what can be added to it."
      },
      "CreateAnnotationRequest": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/TraceAnnotationRequest"
          },
          {
            "$ref": "#/components/schemas/SpanAnnotationRequest"
          },
          {
            "$ref": "#/components/schemas/ThreadAnnotationRequest"
          }
        ],
        "description": "An annotation to record against exactly one target. Send `traceUuid`, `spanUuid` or `threadId` — never more than one — and the field that goes with it: `expectedOutput` for a trace or span, `expectedOutcome` for a thread. `fieldType` defaults to `THUMBS_RATING`."
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A label for the key, shown on the Confident AI platform.",
            "example": "CI pipeline"
          },
          "expiresInDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "How long the key lasts, in days from now — a duration, not a date. Confident AI turns it into the `expiresAt` instant on the key. Omit it for a key that never expires.",
            "example": 90
          }
        },
        "required": [
          "name"
        ],
        "description": "The key to mint. Its value is generated by Confident AI and returned once, in the response.",
        "title": "Create API Key Request"
      },
      "CreateAuditLogExportRequest": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the period to export, inclusive, as an ISO 8601 timestamp. Omit along with `endTime` to export all time.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "End of the period to export, inclusive, as an ISO 8601 timestamp. Must be after `startTime`. Omit along with `startTime` to export all time.",
            "example": "2025-04-01T00:00:00.000Z"
          },
          "searchTerm": {
            "type": "string",
            "description": "Only export audit logs matching this term. Matched as a substring against the actor email, API key name, API key id, actor type, action, HTTP method, IP address, resource id, user agent, and status code.",
            "example": "jane@acme.com"
          }
        },
        "additionalProperties": false,
        "description": "Which audit logs to export. Send an empty object to export every audit log ever recorded; `startTime` and `endTime` must be sent together to export one period instead.",
        "title": "Create Audit Log Export Request"
      },
      "CreateClassifierLabelRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the label, unique within the classifier.",
            "example": "Positive"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "When this label applies. It is the instruction the classifying model reads, so state the condition rather than restating the name.",
            "example": "User expresses satisfaction, gratitude, or positive sentiment."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the label can be applied. Defaults to `true` on create; omit it on an update to leave it unchanged.",
            "example": true
          },
          "status": {
            "$ref": "#/components/schemas/ClassifierLabelStatus"
          },
          "polarity": {
            "$ref": "#/components/schemas/SignalPolarity"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "description": "A label to add to the classifier. Setting `status` to `ACTIVE` also enables the label, so sending `enabled` `false` alongside it is rejected.",
        "title": "Create Classifier Label Request"
      },
      "CreateClassifierRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the classifier, unique per data model within the project.",
            "example": "Sentiment"
          },
          "dataModel": {
            "$ref": "#/components/schemas/ClassifierDataModel"
          },
          "preset": {
            "$ref": "#/components/schemas/ClassifierPreset"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What this classifier is for. Send `null` to clear it.",
            "example": "Analyzes the emotional tone of user interactions."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the classifier runs at all. Defaults to `true` on create; omit it on an update to leave it unchanged.",
            "example": true
          },
          "autoClassify": {
            "type": "boolean",
            "description": "Whether incoming items are classified automatically as they arrive. Defaults to `true` on create; omit it on an update to leave it unchanged.",
            "example": true
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ],
            "description": "Narrows which traces or threads the classifier runs on, so it can watch one route rather than the whole project. Only the groups are stored, so the set's top-level operator is dropped and the groups are combined by the platform. Send `null` to clear the filters and classify everything of this data model.",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Trace Name",
                      "condition": "Is",
                      "value": "checkout"
                    }
                  ]
                }
              ]
            }
          },
          "autoGenerationConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassifierAutoGenerationConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "How a generation run samples and clusters your traffic to discover labels. Send `null` to clear it."
          }
        },
        "required": [
          "name",
          "dataModel"
        ],
        "additionalProperties": false,
        "description": "A classifier to add to this project, which tags incoming traces or threads with labels. Sending a `preset` seeds the description, the generation config, and a starting set of labels; any field you send explicitly overrides what the preset would have set.",
        "title": "Create Classifier Request"
      },
      "CreateDashboardRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the dashboard.",
            "example": "Production overview"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the dashboard covers. Send `null` to leave it unset.",
            "example": "Traffic and latency across production."
          },
          "private": {
            "type": "boolean",
            "default": false,
            "description": "Whether the dashboard is visible only to its creator. Defaults to `false`, which shares it with the project.",
            "example": false
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateWidgetRequest"
            },
            "description": "The widgets to create the dashboard with. Each one that sends no `layout` is packed onto the grid in the order given."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A dashboard to add to this project, optionally with the widgets it starts out with.",
        "title": "Create Dashboard Request"
      },
      "CreateDatasetIngestionTaskRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A name for the task, unique within the dataset.",
            "example": "Harvest failed lookups"
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the task harvests. Send `null` to clear it.",
            "example": "Traces where the assistant failed to name a capital."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task runs. Disabling it unschedules the harvesting job, and goldens already created are kept. Defaults to `false` on create; omit it on an update to leave it unchanged.",
            "example": true
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The fraction of matching items to ingest, between 0 and 1. On create it defaults to 1, all of them; omit it on an update to leave it unchanged.",
            "example": 0.1
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Name",
                      "condition": "Is",
                      "value": "capital-lookup"
                    }
                  ]
                }
              ]
            }
          },
          "maxGoldens": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "The maximum number of goldens this task will ever create. Send `null` to remove the cap.",
            "example": 500
          },
          "inputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of a transformer that reshapes the harvested input before it is stored. Send `null` to detach it.",
            "example": "<TRANSFORMER-ID>"
          },
          "outputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of a transformer that reshapes the harvested output before it is stored. Send `null` to detach it.",
            "example": null
          },
          "includeInput": {
            "type": "boolean",
            "description": "Populate the golden's `input` from the harvested item. On create it defaults to `true` and every other include flag defaults to `false`; omit it on an update to leave it unchanged.",
            "example": true
          },
          "includeActualOutput": {
            "type": "boolean",
            "description": "Populate the golden's `actualOutput` from the harvested item.",
            "example": true
          },
          "includeExpectedOutput": {
            "type": "boolean",
            "description": "Populate the golden's `expectedOutput` from the harvested item.",
            "example": false
          },
          "includeRetrievalContext": {
            "type": "boolean",
            "description": "Populate the golden's `retrievalContext` from the harvested item.",
            "example": false
          },
          "includeContext": {
            "type": "boolean",
            "description": "Populate the golden's `context` from the harvested item.",
            "example": false
          },
          "includeToolsCalled": {
            "type": "boolean",
            "description": "Populate the golden's `toolsCalled` from the harvested item.",
            "example": false
          },
          "includeExpectedTools": {
            "type": "boolean",
            "description": "Populate the golden's `expectedTools` from the harvested item.",
            "example": false
          }
        },
        "required": [
          "name",
          "dataModel"
        ],
        "additionalProperties": false,
        "description": "A standing rule that harvests matching production items into the dataset as goldens. `dataModel` must match the dataset: `THREAD` for a multi-turn dataset, `TRACE` or `SPAN` for a single-turn one."
      },
      "CreateDatasetVersionResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the new dataset version assigned by Confident AI, not to be confused with the version number.",
            "example": "<DATASET-VERSION-ID>"
          },
          "version": {
            "type": "string",
            "description": "The version number generated by Confident AI for the new version. It is always incremental.",
            "example": "00.00.02"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "CreateEvaluationRuleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A name for the rule, unique within the project.",
            "example": "Score production answers"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether the rule evaluates matching items as they arrive. Defaults to `true`.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/EvaluationRuleDataModel"
          },
          "metricCollectionId": {
            "type": "string",
            "minLength": 1,
            "description": "The id of the metric collection to run. It must be multi-turn for `THREAD` rules and single-turn for `TRACE` and `SPAN` rules.",
            "example": "<METRIC-COLLECTION-ID>"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the rule checks. Send `null` to clear it.",
            "example": "Scores answers we serve to end users."
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The fraction of matching items to evaluate, between 0 and 1. On create it defaults to 1, all of them; omit it on an update to leave it unchanged.",
            "example": 0.2
          },
          "spanType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpanType"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only evaluate spans of this kind. Allowed only when `dataModel` is `SPAN`, and cleared automatically if the rule moves off `SPAN`. Send `null` to evaluate every span."
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only evaluate items matching these filters. Send `null` to evaluate every item the rule's `dataModel` covers.",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Name",
                      "condition": "Is",
                      "value": "capital-lookup"
                    }
                  ]
                }
              ]
            }
          },
          "threadTimelimit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 120,
            "description": "For `THREAD` rules, the seconds of inactivity to wait before evaluating a thread, so an in-progress conversation is not scored halfway. The minimum is 120, which leaves time for the last traces to be stored. Send `null` to use the project's thread timelimit, which defaults to 300.",
            "example": 300
          },
          "overwriteEvals": {
            "type": "boolean",
            "description": "Re-evaluate items that already have results for this metric collection instead of skipping them. Defaults to `false` on create; omit it on an update to leave it unchanged.",
            "example": false
          }
        },
        "required": [
          "name",
          "dataModel",
          "metricCollectionId"
        ],
        "additionalProperties": false,
        "description": "The standing rule to create: what to evaluate, which metric collection to run, and how much of the matching traffic to score.",
        "title": "Create Evaluation Rule Request"
      },
      "CreateExportDestinationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the destination, as it appears in your project.",
            "example": "Nightly S3 exports"
          },
          "type": {
            "$ref": "#/components/schemas/ExportDestinationType"
          },
          "bucket": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the bucket exports are uploaded to. Required for `S3` destinations and rejected for `SNOWFLAKE`.",
            "example": "acme-llm-exports"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "The region the bucket lives in. Required for `S3` destinations and rejected for `SNOWFLAKE`.",
            "example": "us-east-1"
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1,
            "description": "Required for `S3` destinations. The access key id Confident AI uploads with. Reads return this masked, as fifteen asterisks followed by its last six characters, so a masked value is rejected here — send the real key id.",
            "example": "AKIAIOSFODNN7EXAMPLE"
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1,
            "description": "Required for `S3` destinations. The secret access key paired with `accessKeyId`. Confident AI never returns it in full, so a masked value is rejected here — send the real secret.",
            "example": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
          },
          "pathPrefix": {
            "type": [
              "string",
              "null"
            ],
            "description": "A folder inside the bucket to write exports under. A leading slash is stripped and a trailing one added, so `/confident-ai` is stored as `confident-ai/`. Omit it, or send `null` or an empty string, to write to the root of the bucket.",
            "example": "confident-ai/"
          },
          "snowflakeConfig": {
            "$ref": "#/components/schemas/SnowflakeExportDestinationConfig"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether export schedules may upload to this destination. Defaults to `true`.",
            "example": true
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A destination to add to this project, which export schedules send exports to. Send the bucket fields for `S3` or `snowflakeConfig` for `SNOWFLAKE`. Credentials must be sent in full: a value copied from a read is masked, and storing the mask would produce a destination whose uploads can never authenticate.",
        "title": "Create Export Destination Request"
      },
      "CreateExportScheduleRequest": {
        "type": "object",
        "properties": {
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many `repeatUnit`s apart the runs are, for an `INTERVAL` schedule. Send `null` to clear it.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit `repeatEvery` counts, for an `INTERVAL` schedule. Send `null` to clear it."
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule first runs, as an ISO 8601 datetime. Send `null` to start it immediately.",
            "example": "2025-02-01T09:00:00Z"
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many times the schedule runs before it stops. Send `null` to let it run indefinitely.",
            "example": 12
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule stops running, as an ISO 8601 datetime. Send `null` to leave it open-ended.",
            "example": "2025-12-31T23:59:59Z"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the schedule.",
            "example": "Weekly checkout conversations"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the schedule exports. Send `null` to leave it unset.",
            "example": "Last week's checkout conversations for the data team."
          },
          "exportType": {
            "$ref": "#/components/schemas/SchedulableExportType"
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Name",
                      "condition": "Is",
                      "value": "checkout-assistant"
                    }
                  ]
                }
              ]
            }
          },
          "environment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Environment"
              },
              {
                "type": "null"
              }
            ],
            "description": "The environment each run exports data from. Omit it, or send `null`, to export data from every environment. Ignored for `TEST_RUNS` exports, which have no environment.",
            "example": "production"
          },
          "annotationSelectionType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnnotationSelectionType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The annotation source for each `ANNOTATIONS` export run. Omit it, or send `null`, to export annotations from every source. Ignored for other export types.",
            "example": "Traces"
          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of the export destination each run delivers its file to. A scheduled run has no recipient of its own, so a schedule created without a destination produces files that go nowhere.",
            "example": "<EXPORT-DESTINATION-ID>"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether the schedule starts running as soon as it is created. Defaults to `true`.",
            "example": true
          }
        },
        "required": [
          "name",
          "exportType"
        ],
        "additionalProperties": false,
        "description": "An export schedule to add to this project. Each run exports the `exportType` data from the window since the previous run, scoped by `filters`, `environment` and, for annotations, `annotationSelectionType`, and delivers it to `destinationId`.",
        "title": "Create Export Schedule Request"
      },
      "CreateForwardingConnectorRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the connector, shown on the Confident AI platform and in forwarding failure messages.",
            "example": "Acme OTLP collector"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "The HTTPS URL of the OTLP/HTTP collector that receives the forwarded traces. It must resolve to a public address; private and loopback addresses are rejected.",
            "example": "https://otlp.acme-observability.com/v1/traces"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForwardingConnectorHeaderConfig"
            },
            "description": "The complete set of HTTP headers to send with every forwarded batch, alongside the `Content-Type: application/x-protobuf` header Confident AI sets. Omit this field to leave the stored headers untouched. When you do send it, the list replaces all stored headers, so resend every header you want to keep — including the ones whose values you read back masked, which are kept as stored.",
            "example": [
              {
                "key": "Authorization",
                "value": "Bearer sk-live-a1b2c3"
              }
            ]
          },
          "environments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Environment"
            },
            "description": "The environments whose traces this connector forwards. An empty list forwards traces from every environment. Omit this field to leave the stored environments unchanged.",
            "example": [
              "production"
            ]
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the connector forwards traces. Defaults to `true` on create; omit it on an update to leave it unchanged.",
            "example": true
          }
        },
        "required": [
          "name",
          "endpoint"
        ],
        "additionalProperties": false,
        "description": "The forwarding connector to create. A project can hold at most 3 connectors, so creating one past that limit is rejected.",
        "title": "Create Forwarding Connector Request"
      },
      "CreateGoldenRequest": {
        "type": "object",
        "properties": {
          "golden": {
            "$ref": "#/components/schemas/GoldenRequest"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The dataset version to add the golden to. Omitting it targets the latest version, or the unversioned goldens when the dataset has no versions.",
            "example": "00.00.01"
          }
        },
        "required": [
          "golden"
        ],
        "additionalProperties": false
      },
      "CreateGovernanceControlRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the control, unique within your organization.",
            "example": "Production error rate under 2%"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the control checks and why. Send `null` to leave it unset.",
            "example": "Traces must error on fewer than 2% of production requests over the last day."
          },
          "type": {
            "$ref": "#/components/schemas/CreatableGovernanceControlType"
          },
          "runtimeConfig": {
            "$ref": "#/components/schemas/GovernanceControlRuntimeConfig"
          },
          "preDeploymentConfig": {
            "$ref": "#/components/schemas/GovernanceControlPreDeploymentConfig"
          },
          "governancePolicyId": {
            "type": "string",
            "description": "Accepted but not acted on: the control is created unattached whether or not you send it. Attach it through the governance policy's own controls endpoint.",
            "example": "<GOVERNANCE-POLICY-ID>"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "description": "A governance control to add to your organization. Send the config that matches `type` — `runtimeConfig` for `RUNTIME`, `preDeploymentConfig` for either pre-deployment type — to snapshot the control's first version in the same call; send neither and the control is created with no definition, which assesses as `ERROR` until you add a version. A config that does not match `type` is ignored rather than rejected.",
        "title": "Create Governance Control Request"
      },
      "CreateGovernanceControlVersionRequest": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/GovernanceControlRuntimeConfig"
          },
          {
            "$ref": "#/components/schemas/GovernanceControlPreDeploymentConfig"
          }
        ],
        "description": "The definition to snapshot as the control's next version. Which of the two shapes is expected is decided by the control's own `type`, not by what you send: a pre-deployment control takes the pre-deployment config, and every other type — `RUNTIME` and `OPERATIONAL` alike — takes the runtime config. Except for `extraQueryParams`, every field is required even when `null`, so a version is a complete definition rather than a patch of the one before it."
      },
      "CreateGovernancePolicyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the governance policy, unique within your organization.",
            "example": "EU AI Act readiness"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the policy covers. Omit it, or send `null`, to leave it unset.",
            "example": "The checks every customer-facing agent must pass before release."
          },
          "basePolicyIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "The policies this policy extends, whose controls then also apply to its projects. Omit for a standalone policy. Inheritance is exactly two levels deep, so every id here must name a policy that extends nothing itself.",
            "example": [
              "<GOVERNANCE-POLICY-ID>"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A governance policy to add to your organization. It starts with no controls attached and no projects enrolled, so both are done afterwards through their own endpoints.",
        "title": "Create Governance Policy Request"
      },
      "CreateMcpServerRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the MCP server, unique within the project.",
            "example": "Internal Tools"
          },
          "transport": {
            "$ref": "#/components/schemas/McpServerTransport"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the MCP server is for. Send `null` to leave it unset.",
            "example": "Internal engineering tools"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL of the server. Required when `transport` is `HTTP`, and cleared otherwise.",
            "example": "https://mcp.internal.example.com/sse"
          },
          "headers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "description": "Static headers sent with every request. Only used when `authType` is `HEADERS`, and cleared otherwise. This map is stored as a whole rather than merged, so send every header you want to keep.",
            "example": {
              "Authorization": "Bearer YOUR-TOKEN"
            }
          },
          "authType": {
            "$ref": "#/components/schemas/McpServerAuthType"
          },
          "authConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/McpServerAuthConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "The credentials for a non-`HEADERS` auth type. Send `null` to clear them."
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "description": "The command that launches the server. Required when `transport` is `STDIO`, and cleared otherwise.",
            "example": "npx"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The arguments passed to `command`. `STDIO` transport only. This list is stored as a whole rather than appended to.",
            "example": [
              "-y",
              "@modelcontextprotocol/server-filesystem"
            ]
          }
        },
        "required": [
          "name",
          "transport"
        ],
        "additionalProperties": false,
        "description": "One of your MCP servers to register with the project. An `HTTP` server needs `url`, a `STDIO` server needs `command`, and an `AZURE_AD` or `OAUTH_CLIENT_CREDENTIALS` server needs its `authConfig` credentials including `clientSecret`, since there is no stored secret to fall back on yet. Registering does not connect.",
        "title": "Create MCP Server Request"
      },
      "CreateMetricCollectionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the metric collection, which must be unique within your project.",
            "example": "RAG Quality"
          },
          "multiTurn": {
            "type": "boolean",
            "default": false,
            "description": "This is `true` if the collection is multi-turn, which contains only multi-turn metrics. It cannot be changed once the collection exists.",
            "example": false
          },
          "metricsSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricSettingConfig"
            },
            "description": "The metrics in the collection with their settings. Each metric must exist in your project and match `multiTurn`."
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The share of eligible entities the whole collection is run against, between 0 and 1. Applied on top of each metric's own `sampleRate`. Defaults to 1 on create; omit it on an update to leave it unchanged.",
            "example": 1
          },
          "inputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that reshapes the payload before evaluation. Send `null` to unset it.",
            "example": "<TRANSFORMER-ID>"
          },
          "outputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "The id of a transformer that reshapes the result after evaluation. Send `null` to unset it.",
            "example": null
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "CreateMetricRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the metric, unique within your project.",
            "example": "Correctness"
          },
          "multiTurn": {
            "type": "boolean",
            "default": false,
            "description": "This is `true` when the metric evaluates conversations rather than single test cases. It decides which `evaluationParams` are valid and cannot be changed later.",
            "example": false
          },
          "criteria": {
            "type": "string",
            "description": "The criteria the metric scores against. A `GEVAL` metric needs `criteria` or `evaluationSteps`.",
            "example": "Determine if the actual output is correct based on the expected output."
          },
          "evaluationSteps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The steps the metric follows to score, as an alternative to `criteria`.",
            "example": [
              "Compare the actual output with the expected output.",
              "Penalise any factual contradiction."
            ]
          },
          "evaluationParams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricEvaluationParam"
            },
            "description": "The test case fields the metric evaluates. A single-turn metric needs at least one, and every field must match `multiTurn`.",
            "example": [
              "actualOutput",
              "expectedOutput"
            ]
          },
          "rubric": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rubric"
            },
            "description": "Score ranges that anchor how the metric scores."
          },
          "algorithm": {
            "$ref": "#/components/schemas/MetricAlgorithm"
          },
          "dag": {
            "$ref": "#/components/schemas/MetricDag"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JevQuestion"
            },
            "minItems": 1,
            "description": "The questions a `JEVAL` metric asks the decision model. Required when `algorithm` is `JEVAL`."
          },
          "promptConfig": {
            "$ref": "#/components/schemas/PromptMetricConfig"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A metric to create. `GEVAL` metrics need `criteria` or `evaluationSteps`; a `DAG` metric needs `algorithm` set to `DAG` and a `dag`; a `JEVAL` metric needs `algorithm` set to `JEVAL` and `questions`; a `PROMPT` metric needs `algorithm` set to `PROMPT` and a `promptConfig`."
      },
      "CreateMetricsBatchRequest": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateMetricRequest"
            },
            "minItems": 1,
            "description": "The metrics to create. Names must be unique within the batch for the same `multiTurn`, and `DAG` metrics are not accepted here."
          }
        },
        "required": [
          "metrics"
        ],
        "additionalProperties": false
      },
      "CreateModelCostRequest": {
        "type": "object",
        "properties": {
          "matchPattern": {
            "type": "string",
            "description": "The case-insensitive regular expression a model name must match for this cost to apply.",
            "example": "^gpt-4o"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model provider this cost applies to, matched case-insensitively against the provider recorded on the LLM span. Send `null` or omit it for a cost that applies whatever the provider, which is only used when no provider-specific cost matches.",
            "example": "openai"
          },
          "inputCostPerMillionTokens": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost in `USD` of one million input tokens. Send `null` when only the output rate is priced; input tokens are then costed at zero.",
            "example": 2.5
          },
          "outputCostPerMillionTokens": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost in `USD` of one million output tokens. Send `null` when only the input rate is priced; output tokens are then costed at zero.",
            "example": 10
          }
        },
        "required": [
          "matchPattern"
        ],
        "additionalProperties": false,
        "description": "A custom model price to add to this project. Send at least one of `inputCostPerMillionTokens` and `outputCostPerMillionTokens`; the pair of `matchPattern` and `provider` must not already be priced in this project.",
        "title": "Create Model Cost Request"
      },
      "CreateOrUpdatePolicyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the policy, unique within the organization or project that owns it. It is what identifies the policy when attaching it to a role.",
            "example": "Billing read-only"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the policy is for. On an update, omit it to leave the stored description unchanged, or send `null` to clear it.",
            "example": "Lets a role read invoices and model costs, but change neither."
          },
          "permissionIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the permissions this policy grants. This is the policy's complete permission set: on an update the list replaces what is stored rather than adding to it, and an empty array leaves the policy granting nothing. Discover assignable ids with the permissions endpoint of the same scope; an id from the other scope's catalog is stored but never matches a permission check here.",
            "example": [
              "<PERMISSION-ID>"
            ]
          }
        },
        "required": [
          "name",
          "permissionIds"
        ],
        "description": "A policy to create, or the complete state to give an existing one. Every field is applied, so an update must resend `name` and `permissionIds` even when they are unchanged.",
        "title": "Create Or Update Policy Request"
      },
      "CreateOrUpdateRoleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the role, unique among the roles the organization or project can use. It cannot match the name of a global, system-defined role, compared without regard to case.",
            "example": "Billing Auditor"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the role is for. On an update, omit it to leave the stored description unchanged, or send `null` to clear it.",
            "example": "Read-only access to invoices and model costs."
          },
          "policyIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the policies to attach to the role, which is what gives the role its permissions. This is the role's complete policy set: on an update the list replaces what is stored rather than adding to it, and an empty array leaves the role with no permissions at all. Discover assignable policies with the policies endpoint of the same scope.",
            "example": [
              "<POLICY-ID>"
            ]
          }
        },
        "required": [
          "name",
          "policyIds"
        ],
        "description": "A role to create, or the complete state to give an existing one. Every field is applied, so an update must resend `name` and `policyIds` even when they are unchanged.",
        "title": "Create Or Update Role Request"
      },
      "CreateOrganizationInvitationsRequest": {
        "type": "object",
        "properties": {
          "emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "description": "An email address to invite.",
              "example": "jane@acme.com"
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "The email addresses to invite, between 1 and 50 of them. Each is trimmed and lowercased, and must be a company address — free and disposable domains are refused.",
            "example": [
              "jane@acme.com"
            ]
          },
          "organizationRoleId": {
            "type": "string",
            "format": "uuid",
            "description": "The id of the organization role every invitee lands on when they accept. Omit it to give them the default `Member` role. The `Owner` role cannot be handed out this way.",
            "example": "<ORGANIZATION-ROLE-ID>"
          }
        },
        "required": [
          "emails"
        ],
        "additionalProperties": false,
        "description": "Who to invite into the organization, and the role they should hold once they accept.",
        "title": "Create Organization Invitations Request"
      },
      "CreatePersonaRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the persona, unique within the project. It is the label the persona is picked by wherever a golden is given one, so make it recognisable on its own — 'Frustrated support caller' rather than 'Persona 2'.",
            "example": "Frustrated support caller"
          },
          "characteristics": {
            "type": "string",
            "minLength": 1,
            "description": "How this persona behaves in a conversation: tone, temperament, patience, how much they volunteer, how they phrase things. The simulator reads it as the standing instruction for the user side of every turn, so describe a person rather than a task — what the conversation is about and when it is finished come from the golden's scenario and expected outcome, not from here.",
            "example": "An impatient customer who has already been transferred twice. Types in lowercase, asks short direct questions, and pushes back when given a generic answer."
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Structured facts the persona can draw on, such as an account, a resume or an order. The simulator reads it alongside the characteristics, and it is available to your AI connection payload as conversationalGolden.persona.metadata.",
            "example": {
              "accountId": "acc_123",
              "plan": "pro"
            }
          }
        },
        "required": [
          "name",
          "characteristics"
        ],
        "additionalProperties": false,
        "description": "A persona to add to this project. Creating one only defines the character — attach it to a multi-turn golden for a simulated conversation to be played in its voice.",
        "title": "Create Persona Request"
      },
      "CreateProjectInvitationsRequest": {
        "type": "object",
        "properties": {
          "emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "description": "An email address to invite.",
              "example": "jane@acme.com"
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "The email addresses to invite, between 1 and 50 of them. Each is trimmed and lowercased, and must be a company address — free and disposable domains are refused.",
            "example": [
              "jane@acme.com"
            ]
          },
          "projectRoleId": {
            "type": "string",
            "format": "uuid",
            "description": "The id of the project role every invitee lands on when they accept. Omit it to give them the default `Member` role. The `Owner` role cannot be handed out this way.",
            "example": "<PROJECT-ROLE-ID>"
          }
        },
        "required": [
          "emails"
        ],
        "additionalProperties": false,
        "description": "Who to invite into the project, and the role they should hold in it once they accept.",
        "title": "Create Project Invitations Request"
      },
      "CreateProjectRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the project, which must not already be taken by another project in the organization.",
            "example": "Customer Support Agent"
          },
          "description": {
            "type": "string",
            "description": "What the project covers. Omit it to leave it unset.",
            "example": "The support chatbot serving acme.com."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The email of an existing member of your organization to assign as the project's Owner, which also attributes the provisioned API key to them. Omit it and the project has no member: it is reachable through its API key and to organization admins only.",
            "example": "jane@acme.com"
          }
        },
        "required": [
          "name"
        ],
        "description": "The project to create in your organization. How many projects you may hold depends on your plan, so this call can be refused on entitlement grounds even when the name is free.",
        "title": "Create Project Request"
      },
      "CreateProjectResult": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectSummary"
          },
          "apiKey": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectDefaultApiKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "The project-scoped API key provisioned with the project, carrying its full value for the only time. Null only if no key was provisioned."
          }
        },
        "required": [
          "project",
          "apiKey"
        ],
        "description": "The created project and the API key provisioned with it. The key's `value` is not retrievable afterwards, so read it out of this response.",
        "title": "Create Project Result"
      },
      "CreatePromptBranchRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the branch to create. It diverges from the head commit of `main`.",
            "example": "experiment"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreatePromptVersionRequest": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "description": "The hash of the commit to release as a new version. Only commits newer than the last versioned commit can be released. When omitted, the head commit of `main` is versioned.",
            "example": "bab04ce"
          }
        }
      },
      "CreatePromptVersionResult": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The version number generated by Confident AI for the new version. It is always incremental.",
            "example": "00.00.02"
          },
          "hash": {
            "type": "string",
            "description": "The hash of the commit that was versioned. This is the hash you passed, or the head of `main` when you omitted it.",
            "example": "bab04ce"
          }
        },
        "required": [
          "version",
          "hash"
        ]
      },
      "CreateQueueIngestionTaskRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the task.",
            "example": "Failed capital lookups"
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the task harvests. Send `null` to clear it.",
            "example": "Traces where the assistant failed to name a capital."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task runs. Disabling it stops new items arriving; items already queued are kept. Defaults to `false` on create; omit it on an update to leave it unchanged.",
            "example": true
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The fraction of matching items to queue, between 0 and 1. On create it defaults to 1, all of them; omit it on an update to leave it unchanged.",
            "example": 0.1
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Name",
                      "condition": "Is",
                      "value": "capital-lookup"
                    }
                  ]
                }
              ]
            }
          },
          "maxItems": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "The maximum number of items this task will ever queue. Send `null` to remove the cap.",
            "example": 500
          },
          "assignmentStrategy": {
            "$ref": "#/components/schemas/AssignmentStrategy"
          },
          "reviewerEmails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "description": "The project members harvested items are assigned to, following `assignmentStrategy`.",
            "example": [
              "jane@acme.com"
            ]
          }
        },
        "required": [
          "name",
          "dataModel"
        ],
        "additionalProperties": false,
        "description": "A rule that keeps the queue filled from your production data: it matches items against `filters` and queues the share named by `sampleRate`."
      },
      "CreateRTFrameworkRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the framework, unique within the project.",
            "example": "OWASP Top 10 for LLMs"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the framework covers. Send `null` to leave it unset.",
            "example": "Our baseline coverage before each release."
          },
          "template": {
            "type": "string",
            "description": "A Confident AI template to fill the framework from, which creates its risk categories with vulnerability types and attack methods already selected. Omit it for an empty framework.",
            "example": "EU Artificial Intelligence Act"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A red teaming framework to add to this project. A framework groups risk categories, and running one starts a risk assessment.",
        "title": "Create RT Framework Request"
      },
      "CreateReportRequest": {
        "type": "object",
        "properties": {
          "reportTemplateId": {
            "type": "string",
            "minLength": 1,
            "description": "The report template to write this report under. Required, since a report is read under its template.",
            "example": "<REPORT-TEMPLATE-ID>"
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Why the report failed, when creating it as `ERRORED`.",
            "example": null
          },
          "metadata": {
            "$ref": "#/components/schemas/ReportMetadataInput"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSectionInput"
            },
            "minItems": 1,
            "description": "The report's sections, in render order. At least one is required."
          }
        },
        "required": [
          "reportTemplateId",
          "sections"
        ],
        "additionalProperties": false,
        "description": "A report to write into your project, stored and rendered exactly as supplied. `status` defaults to `COMPLETED`, which makes the report immediately readable; send `IN_PROGRESS` to fill it in over several requests.",
        "title": "Create Report Request"
      },
      "CreateReportTemplateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The template's name, also used as the report's title.",
            "example": "Weekly Health Check"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question the report should answer, written as a question. Supply this even when providing sections — it drives the single data retrieval that serves them all.",
            "example": "Give me an overall health check for the last week: request volume, error rate, latency, total cost and user activity."
          },
          "templateSections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportTemplateSectionConfig"
            },
            "description": "The report's exact sections, in render order. Omit it to let the generator choose the structure from `description`."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether to start generating on the schedule. Defaults to `true`; send `false` to create the template without scheduling it.",
            "example": true
          },
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many `repeatUnit`s apart the runs are, for an `INTERVAL` schedule. Send `null` to clear it.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit `repeatEvery` counts, for an `INTERVAL` schedule. Send `null` to clear it."
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule first runs, as an ISO 8601 datetime. Send `null` to start it immediately.",
            "example": "2025-02-01T09:00:00Z"
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many times the schedule runs before it stops. Send `null` to let it run indefinitely.",
            "example": 12
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule stops running, as an ISO 8601 datetime. Send `null` to leave it open-ended.",
            "example": "2025-12-31T23:59:59Z"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "The report template to create. A template with no cadence of its own repeats every 1 day, and an `INTERVAL` cadence must carry both `repeatEvery` and `repeatUnit`.",
        "title": "Create Report Template Request"
      },
      "CreateRiskCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the risk category, unique within the framework.",
            "example": "Data protection"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What this risk category covers. Send `null` to clear it.",
            "example": "Risks around leaking data the model was given."
          },
          "vulnerabilityTypeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The ids of the vulnerability types to probe for. The list replaces the category's current selection.",
            "example": [
              "<VULNERABILITY-TYPE-ID>"
            ]
          },
          "attackMethodIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The ids of the attack methods to probe with. The list replaces the category's current selection.",
            "example": [
              "<ATTACK-METHOD-ID>"
            ]
          },
          "vulnerabilityIdToPriorityLevel": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "How much of the assessment each vulnerability gets, keyed by vulnerability id, from 0 to 3. Send `null` to clear every weight.",
            "example": {
              "<VULNERABILITY-ID>": 2
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A risk category to add to the framework. Selecting vulnerability types and attack methods now saves a second call to update it."
      },
      "CreateScheduledAlertRequest": {
        "type": "object",
        "properties": {
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many `repeatUnit`s apart the runs are, for an `INTERVAL` schedule. Send `null` to clear it.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit `repeatEvery` counts, for an `INTERVAL` schedule. Send `null` to clear it."
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule first runs, as an ISO 8601 datetime. Send `null` to start it immediately.",
            "example": "2025-02-01T09:00:00Z"
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "How many times the schedule runs before it stops. Send `null` to let it run indefinitely.",
            "example": 12
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule stops running, as an ISO 8601 datetime. Send `null` to leave it open-ended.",
            "example": "2025-12-31T23:59:59Z"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the alert means and what to do about it, included in the notification. Send `null` to clear it.",
            "example": "Errors above 5% over the last hour."
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ],
            "description": "Narrows what the alert measures over, so an alert can watch one route rather than the whole project. Send `null` to clear the filters and measure everything.",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Trace Name",
                      "condition": "Is",
                      "value": "checkout"
                    }
                  ]
                }
              ]
            }
          },
          "severity": {
            "$ref": "#/components/schemas/AlertSeverity"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A name for the alert, shown in the notification.",
            "example": "Trace error rate spike"
          },
          "type": {
            "$ref": "#/components/schemas/ScheduledAlertType"
          },
          "dataModel": {
            "$ref": "#/components/schemas/AlertDataModel"
          },
          "aggregation": {
            "type": "string",
            "minLength": 1,
            "description": "What to measure, as an aggregation token. Which tokens are valid depends on `dataModel`: `TRACE` accepts `COUNT`, `ERROR_RATE`, `PASS_RATE`, `UNIQUE_END_USERS`, `UNIQUE_THREADS`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `TOTAL_COST`, `AVG_COST`, `UNIQUE_METADATA_VALUES`; `SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `INPUT_TOKENS`, `OUTPUT_TOKENS`, `TOTAL_TOKENS`, `UNIQUE_METADATA_VALUES`; `LLM_SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `INPUT_TOKENS`, `OUTPUT_TOKENS`, `TOTAL_TOKENS`, `UNIQUE_METADATA_VALUES`; `AGENT_SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `UNIQUE_METADATA_VALUES`; `RETRIEVER_SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `UNIQUE_METADATA_VALUES`; `TOOL_SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `UNIQUE_METADATA_VALUES`; `CUSTOM_SPAN` accepts `COUNT`, `AVG_LATENCY`, `P50_LATENCY`, `P90_LATENCY`, `P99_LATENCY`, `ERROR_RATE`, `ERROR_COUNT`, `INPUT_COST`, `OUTPUT_COST`, `TOTAL_COST`, `AVG_COST`, `UNIQUE_METADATA_VALUES`; `THREAD` accepts `COUNT`, `UNIQUE_USERS`, `UNIQUE_METADATA_VALUES`. Required for `THRESHOLD` alerts only.",
            "example": "ERROR_RATE"
          },
          "thresholdSettings": {
            "$ref": "#/components/schemas/AlertThresholdSettings"
          },
          "detectionSettings": {
            "$ref": "#/components/schemas/ScheduledAlertDetectionSettings"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether the schedule runs. Defaults to `true`.",
            "example": true
          }
        },
        "required": [
          "name",
          "dataModel"
        ],
        "additionalProperties": false,
        "description": "An alert that runs on a schedule. A `THRESHOLD` alert re-runs an aggregate query and notifies when the result crosses the threshold; `repeatEvery` and `repeatUnit` also set its measurement window, so an alert repeating every hour compares the last hour of data, and a `ONCE` alert measures the last 24 hours. A `REGRESSION`, `ANOMALY` or `SIGNAL_SPIKE` alert takes `detectionSettings` instead of `aggregation` and `thresholdSettings`, and looks at the same window: what was detected since the previous run.",
        "title": "Create Scheduled Alert Request"
      },
      "CreateTestRunRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "description": "The name of the metric collection used to evaluate the test cases formed from traces ingested into this test run. It must be a single-turn collection.",
            "example": "Agent Quality"
          },
          "identifier": {
            "type": "string",
            "description": "An optional human-readable identifier for the test run, shown on the Confident AI platform.",
            "example": "run-399-102"
          }
        },
        "additionalProperties": false,
        "description": "A test run to open for trace ingestion. Both fields are optional; without `metricCollection` the ingested traces are recorded but not evaluated."
      },
      "CreateTraceRequest": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "The unique identifier of the trace, generated by your application. Values that are not UUIDs are hashed into one, and the hashed uuid is what the response and every later lookup use.",
            "example": "<TRACE-UUID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the trace.",
            "example": "Geography QA"
          },
          "input": {
            "description": "This is the input to the trace, as a string or any JSON value.",
            "example": "What is the capital of France?"
          },
          "output": {
            "description": "This is the output of the trace, as a string or any JSON value.",
            "example": "The capital of France is Paris."
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the trace started, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "This is the time the trace ended, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:05Z"
          },
          "status": {
            "$ref": "#/components/schemas/TraceSpanStatus",
            "default": "SUCCESS"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "This is any additional metadata associated with the trace.",
            "example": {
              "client": "acme-corp"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is any tags associated with the trace, which helps with grouping traces and filtering them on the Confident AI platform.",
            "example": [
              "geography"
            ]
          },
          "threadId": {
            "type": "string",
            "description": "This is the unique identifier of the thread associated with the trace, which groups traces in the same thread into a conversation.",
            "example": "thread-42"
          },
          "thread": {
            "$ref": "#/components/schemas/ThreadRequest"
          },
          "userId": {
            "type": "string",
            "description": "This is the unique identifier for your end user for the trace.",
            "example": "end-user-42"
          },
          "user": {
            "$ref": "#/components/schemas/UserRequest"
          },
          "customerId": {
            "type": "string",
            "description": "This is the unique identifier of the customer the trace belongs to — the account, tenant or organization your end user belongs to.",
            "example": "acme-hotels"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerRequest"
          },
          "metricCollection": {
            "type": "string",
            "description": "This is the metric collection you wish to use to evaluate the trace.",
            "example": "Collection Name"
          },
          "testRunId": {
            "type": "string",
            "minLength": 1,
            "description": "This is the unique identifier of the test run to associate the trace with. When set, the trace becomes one test case in that test run and `metricCollection` is required. It cannot be combined with `testCaseId`.",
            "example": "<TEST-RUN-ID>"
          },
          "testCaseId": {
            "type": "string",
            "description": "The id of an existing test case to attach the trace to, when the trace was produced while evaluating that test case.",
            "example": "<TEST-CASE-ID>"
          },
          "turnId": {
            "type": "string",
            "description": "The id of the conversational test case turn to attach the trace to, when the trace was produced while evaluating that turn.",
            "example": "<TURN-ID>"
          },
          "retrievalContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the retrieval context of your trace, which is to be used for evaluation.",
            "example": [
              "Paris is the capital and most populous city of France."
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This is the ideal retrieval context of your trace, which is to be used for evaluation.",
            "example": [
              "Paris is the capital of France."
            ]
          },
          "expectedOutput": {
            "type": "string",
            "description": "This is the expected output of your trace, which is the ideal actual output and to be used for evaluation.",
            "example": "Paris"
          },
          "toolsCalled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the tools called by your trace, which is to be used for evaluation."
          },
          "expectedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "description": "This is the expected tools to be called by the trace, which is to be used for evaluation."
          },
          "spans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpanRequest"
            },
            "description": "This is the list of spans in the trace. Each span's `type` decides which fields it accepts.",
            "example": [
              {
                "uuid": "<SPAN-UUID>",
                "type": "LLM",
                "name": "OpenAI Call",
                "model": "gpt-4o",
                "provider": "OpenAI",
                "integration": "LangChain",
                "input": "What is the capital of France?",
                "output": "The capital of France is Paris.",
                "startTime": "2025-01-15T10:30:00Z",
                "endTime": "2025-01-15T10:30:02Z"
              }
            ]
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDataConfig"
            },
            "description": "Metric results you already computed for this trace, recorded as-is instead of being evaluated by Confident AI."
          },
          "attachments": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TraceAttachment"
            },
            "description": "Map of attachment ids to payloads for all `[DEEPEVAL:IMAGE:…]` and `[DEEPEVAL:PDF:…]` markers in this trace. Define attachments at the trace level with the same ids for the same instances.",
            "example": {
              "doc-1": {
                "mimeType": "application/pdf",
                "dataBase64": "JVBERi0xLjQK"
              }
            }
          }
        },
        "required": [
          "uuid",
          "startTime",
          "endTime"
        ],
        "additionalProperties": false,
        "description": "A trace to record, with the spans it contains. Send `metricCollection` to evaluate it online, `threadId` to group it into a conversation, and `testRunId` with `metricCollection` to record it as a test case of an in-progress test run."
      },
      "CreateTransformerRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the transformer, unique within the project.",
            "example": "Extract nested answer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the transformer extracts. Send `null` to leave it unset.",
            "example": "Pulls the answer out of a nested envelope."
          },
          "codeDefinition": {
            "$ref": "#/components/schemas/TransformerCodeDefinition"
          }
        },
        "required": [
          "name",
          "codeDefinition"
        ],
        "additionalProperties": false,
        "description": "A transformer to add to this project. Confident AI runs its code wherever the transformer is attached, so send the code with it.",
        "title": "Create Transformer Request"
      },
      "CreateVoiceConnectionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A name for the voice connection, unique within the project.",
            "example": "Support line"
          },
          "config": {
            "$ref": "#/components/schemas/VoiceTransportConfig"
          },
          "callSettings": {
            "$ref": "#/components/schemas/VoiceCallSettingsPatch"
          }
        },
        "required": [
          "name",
          "config"
        ],
        "additionalProperties": false,
        "description": "The voice connection to create.",
        "title": "Create Voice Connection Request"
      },
      "CreateVulnerabilityRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the vulnerability, unique within the project.",
            "example": "Prompt Leakage"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the vulnerability covers.",
            "example": "The system reveals its instructions or configuration."
          },
          "criteria": {
            "type": "string",
            "minLength": 1,
            "description": "The rule the evaluator applies to decide whether a reply is vulnerable.",
            "example": "The output must not reveal the system prompt or its rules."
          },
          "vulnerabilityTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "The names of the types this vulnerability breaks down into. At least one is required, and they must be distinct.",
            "example": [
              "System prompt disclosure",
              "Secrets disclosure"
            ]
          },
          "evaluationGuidelines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra instructions the evaluator follows when applying `criteria`.",
            "example": [
              "Treat a partial quote of the prompt as a failure."
            ]
          },
          "evaluationExamples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VulnerabilityEvaluationExample"
            },
            "description": "Worked examples that steer the evaluator."
          }
        },
        "required": [
          "name",
          "criteria",
          "vulnerabilityTypes"
        ],
        "additionalProperties": false,
        "description": "A vulnerability to add to this project. Its name cannot match one Confident AI ships — customise that one instead."
      },
      "CreateWidgetRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name shown as the widget's title.",
            "example": "Trace volume"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the widget shows. Send `null` to leave it unset.",
            "example": "Traces served per day across production."
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The visualization to draw the widget as.",
            "example": "LINE"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit the widget's values are labelled with.",
            "example": "COUNT"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "How the widget aggregates its lines. `DIMENSION_SERIES` requires `dimension`.",
            "example": "TIME_SERIES"
          },
          "bucketMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetBucketMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "How the query range is bucketed. Defaults to `SERIES` when omitted.",
            "example": "SERIES"
          },
          "dimension": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetDimension"
              },
              {
                "type": "null"
              }
            ],
            "description": "The property to break the widget's data down by. Required when `mode` is `DIMENSION_SERIES`.",
            "example": "model"
          },
          "topK": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetTopK"
              },
              {
                "type": "null"
              }
            ],
            "description": "Caps a dimension breakdown at its top values. Send `null`, or omit it, to plot every value."
          },
          "startTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The start of the widget's own time range, as an ISO 8601 datetime. Send `null` to let the query decide the range.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The end of the widget's own time range, as an ISO 8601 datetime. Send `null` to let the query decide the range.",
            "example": "2025-01-31T23:59:59.999Z"
          },
          "layout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetLayout"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the widget sits on the dashboard grid. Omit it, or send `null`, and Confident AI packs the widget into the first free space."
          },
          "lines": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/WidgetLineConfig"
            },
            "description": "The series the widget plots."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A widget to add to a dashboard: the chart to draw, the time range and breakdown to draw it over, and the lines to plot on it.",
        "title": "Create Widget Request"
      },
      "CreatedApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the API key, generated by Confident AI.",
            "example": 1420
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The label for the key, shown on the Confident AI platform.",
            "example": "CI pipeline"
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the key authenticates. A deactivated key is rejected on every request until it is reactivated.",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the key was created.",
            "example": "2025-01-15T09:30:00.000Z"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The instant the key stops authenticating, or `null` when it never expires. Confident AI computes it from the `expiresInDays` duration sent when the key was created or last rotated.",
            "example": "2025-04-15T09:30:00.000Z"
          },
          "value": {
            "type": "string",
            "description": "The full API key. This response is the only place it is ever returned, so store it now — every later response masks it, and a lost value can only be replaced by rotating the key.",
            "example": "confident_us_org_9mJq2sVb1hXk4pR7tYw0aZc3eF6gH8iJ0kLmNoPq"
          },
          "shadowValue": {
            "type": "null",
            "description": "Always `null` on a key that has just been created; only a rotation with a grace period puts a second value in flight."
          },
          "rotatesAt": {
            "type": "null",
            "description": "Always `null` on a key that has just been created."
          },
          "lastUsed": {
            "type": "null",
            "description": "Always `null` on a key that has just been created; it is set the first time the key authenticates a request."
          }
        },
        "required": [
          "id",
          "name",
          "valid",
          "created_at",
          "expiresAt",
          "value",
          "shadowValue",
          "rotatesAt",
          "lastUsed"
        ],
        "description": "A newly minted API key, carrying the only copy of its full value.",
        "title": "Created API Key"
      },
      "CustomerRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The customer id. Equivalent to top-level `customerId`; if both are set they must match.",
            "example": "acme-hotels"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "A human-readable display name for the customer, shown instead of the id.",
            "example": "Acme Hotels"
          }
        },
        "description": "Customer-level fields applied to the customer record. `id` is an alternate way to specify the customer and must match top-level `customerId` if both are provided. `name` only takes effect when a customer id is resolvable; successive ingestions take the latest name."
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the dashboard, generated by Confident AI.",
            "example": "<DASHBOARD-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the dashboard.",
            "example": "Production overview"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the dashboard covers, or `null` when it has no description.",
            "example": "Traffic and latency across production."
          },
          "private": {
            "type": "boolean",
            "description": "Whether the dashboard is visible only to its creator.",
            "example": false
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the dashboard was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the dashboard was last changed.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Widget"
            },
            "description": "The widgets on the dashboard, with their full configuration."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "private",
          "user",
          "createdAt",
          "updatedAt",
          "widgets"
        ],
        "description": "A dashboard and the widgets on it. It carries the widgets' configuration, not their data — a query endpoint computes that.",
        "title": "Dashboard"
      },
      "DashboardList": {
        "type": "object",
        "properties": {
          "dashboards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardSummary"
            },
            "description": "The dashboards for the current page, newest first."
          },
          "totalDashboards": {
            "type": "integer",
            "description": "The total number of dashboards in this project.",
            "example": 7
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of dashboards per page.",
            "example": 25
          }
        },
        "required": [
          "dashboards",
          "totalDashboards",
          "page",
          "pageSize"
        ],
        "description": "One page of dashboards, with the total across all pages.",
        "title": "Dashboard List"
      },
      "DashboardQueryRequest": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "The start of the range to compute over, as an ISO 8601 datetime. Must be sent together with `endTime`, and overrides each widget's own range for this query only.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "The end of the range to compute over, as an ISO 8601 datetime. Must be sent together with `startTime`, and must be later than it.",
            "example": "2025-01-31T23:59:59.999Z"
          },
          "granularity": {
            "$ref": "#/components/schemas/WidgetGranularity"
          },
          "widgetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The widgets to compute. Omit it to compute every widget on the dashboard.",
            "example": [
              "<WIDGET-ID>"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Which widgets to compute and over what range. Send `{}` to compute every widget over its own saved range.",
        "title": "Dashboard Query Request"
      },
      "DashboardQueryResult": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardWidgetQueryResult"
            },
            "description": "One entry per widget the query covered."
          }
        },
        "required": [
          "results"
        ],
        "description": "The computed data for the widgets of one dashboard.",
        "title": "Dashboard Query Result"
      },
      "DashboardRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the dashboard, generated by Confident AI.",
            "example": "<DASHBOARD-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to a dashboard by its id.",
        "title": "Dashboard Ref"
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the dashboard, generated by Confident AI.",
            "example": "<DASHBOARD-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the dashboard.",
            "example": "Production overview"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the dashboard covers, or `null` when it has no description.",
            "example": "Traffic and latency across production."
          },
          "private": {
            "type": "boolean",
            "description": "Whether the dashboard is visible only to its creator.",
            "example": false
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the dashboard was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the dashboard was last changed.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "widgetCount": {
            "type": "integer",
            "description": "How many widgets the dashboard holds.",
            "example": 4
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "private",
          "user",
          "createdAt",
          "updatedAt",
          "widgetCount"
        ],
        "description": "A dashboard as it appears in a list: what it is and how much it holds, without its widgets' configuration.",
        "title": "Dashboard Summary"
      },
      "DashboardWidgetQueryFailure": {
        "type": "object",
        "properties": {
          "widgetId": {
            "type": "string",
            "description": "The id of the widget this result was computed for.",
            "example": "<WIDGET-ID>"
          },
          "status": {
            "type": "string",
            "enum": [
              "ERROR"
            ],
            "description": "Marks the widget as failed."
          },
          "error": {
            "$ref": "#/components/schemas/WidgetQueryError"
          }
        },
        "required": [
          "widgetId",
          "status",
          "error"
        ],
        "additionalProperties": false,
        "description": "A widget of the dashboard that could not be computed. One widget failing does not fail the rest of the query.",
        "title": "Dashboard Widget Query Failure"
      },
      "DashboardWidgetQueryResult": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/DashboardWidgetQuerySuccess"
          },
          {
            "$ref": "#/components/schemas/DashboardWidgetQueryFailure"
          }
        ],
        "description": "What a dashboard query produced for one widget. Branch on `status`.",
        "title": "Dashboard Widget Query Result"
      },
      "DashboardWidgetQuerySuccess": {
        "type": "object",
        "properties": {
          "widgetId": {
            "type": "string",
            "description": "The id of the widget this result was computed for.",
            "example": "<WIDGET-ID>"
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The widget's visualization, echoed from its configuration. It says how to draw the result, not how to read it — branch on `data.kind` for that."
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WidgetMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "The widget's aggregation mode, echoed from its configuration. Branch on `data.kind` rather than on this when reading the result."
          },
          "status": {
            "type": "string",
            "enum": [
              "OK"
            ],
            "description": "Marks the widget as computed."
          },
          "data": {
            "$ref": "#/components/schemas/WidgetData"
          }
        },
        "required": [
          "widgetId",
          "type",
          "mode",
          "status",
          "data"
        ],
        "additionalProperties": false,
        "description": "A widget of the dashboard that Confident AI computed.",
        "title": "Dashboard Widget Query Success"
      },
      "Dataset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the dataset.",
            "example": "<DATASET-ID>"
          },
          "alias": {
            "type": "string",
            "description": "This is the alias of the dataset, which is unique within your project.",
            "example": "capitals"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "This is `true` if the dataset is multi-turn, which contains multi-turn goldens. Single-turn datasets have `multiTurn` set to `false` and contain single-turn goldens.",
            "example": false
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "The version number of the goldens returned, or `null` when the dataset has no versions.",
            "example": "00.00.01"
          },
          "goldens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Golden"
            },
            "description": "The goldens in the dataset, oldest first. Every golden is single-turn or multi-turn according to the dataset's `multiTurn`."
          }
        },
        "required": [
          "id",
          "alias",
          "multiTurn",
          "version",
          "goldens"
        ],
        "description": "A pulled dataset with the goldens of one version."
      },
      "DatasetIngestionTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique id of the ingestion task.",
            "example": "<DATASET-INGESTION-TASK-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the ingestion task, unique within the dataset.",
            "example": "Harvest failed lookups"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the task harvests, or `null`.",
            "example": "Traces where the assistant failed to name a capital."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task is currently harvesting.",
            "example": true
          },
          "sampleRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The fraction of matching items the task ingests, between 0 and 1.",
            "example": 0.1
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxGoldens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The maximum number of goldens this task will ever create, or `null` when uncapped.",
            "example": 500
          },
          "inputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that reshapes the harvested input, or `null` when the task does not use one.",
            "example": "<TRANSFORMER-ID>"
          },
          "outputTransformerId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the transformer that reshapes the harvested output, or `null` when the task does not use one.",
            "example": null
          },
          "includeInput": {
            "type": "boolean",
            "description": "Whether the golden's `input` is populated from the harvested item.",
            "example": true
          },
          "includeActualOutput": {
            "type": "boolean",
            "description": "Whether the golden's `actualOutput` is populated from the harvested item.",
            "example": true
          },
          "includeExpectedOutput": {
            "type": "boolean",
            "description": "Whether the golden's `expectedOutput` is populated from the harvested item.",
            "example": false
          },
          "includeRetrievalContext": {
            "type": "boolean",
            "description": "Whether the golden's `retrievalContext` is populated from the harvested item.",
            "example": false
          },
          "includeContext": {
            "type": "boolean",
            "description": "Whether the golden's `context` is populated from the harvested item.",
            "example": false
          },
          "includeToolsCalled": {
            "type": "boolean",
            "description": "Whether the golden's `toolsCalled` is populated from the harvested item.",
            "example": false
          },
          "includeExpectedTools": {
            "type": "boolean",
            "description": "Whether the golden's `expectedTools` is populated from the harvested item.",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was created, as an ISO 8601 timestamp.",
            "example": "2026-05-28T13:05:24.777Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was last updated, as an ISO 8601 timestamp.",
            "example": "2026-05-28T13:35:16.268Z"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "enabled",
          "sampleRate",
          "dataModel",
          "filters",
          "maxGoldens",
          "inputTransformerId",
          "outputTransformerId",
          "includeInput",
          "includeActualOutput",
          "includeExpectedOutput",
          "includeRetrievalContext",
          "includeContext",
          "includeToolsCalled",
          "includeExpectedTools",
          "createdAt",
          "updatedAt"
        ],
        "description": "An ingestion task: which production items it harvests into the dataset, how it samples them, and which golden fields it fills."
      },
      "DatasetIngestionTaskList": {
        "type": "object",
        "properties": {
          "datasetIngestionTasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetIngestionTaskSummary"
            },
            "description": "This is the list of ingestion tasks on the dataset, newest first, as summary rows."
          }
        },
        "required": [
          "datasetIngestionTasks"
        ]
      },
      "DatasetIngestionTaskRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique id of the ingestion task.",
            "example": "<DATASET-INGESTION-TASK-ID>"
          }
        },
        "required": [
          "id"
        ]
      },
      "DatasetIngestionTaskSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique id of the ingestion task.",
            "example": "<DATASET-INGESTION-TASK-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the ingestion task, unique within the dataset.",
            "example": "Harvest failed lookups"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the task is currently harvesting.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/IngestionDataModel"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "dataModel"
        ],
        "description": "A row in the dataset's ingestion task list. Its full configuration comes from the get endpoint."
      },
      "DatasetList": {
        "type": "object",
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetSummary"
            },
            "description": "This is the list of datasets in your project, newest first."
          }
        },
        "required": [
          "datasets"
        ]
      },
      "DatasetRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the dataset.",
            "example": "<DATASET-ID>"
          }
        },
        "required": [
          "id"
        ]
      },
      "DatasetSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique id of the dataset.",
            "example": "<DATASET-ID>"
          },
          "alias": {
            "type": "string",
            "description": "This is the alias of the dataset, which is unique within your project.",
            "example": "capitals"
          },
          "multiTurn": {
            "type": "boolean",
            "description": "This is `true` if the dataset is multi-turn, which contains multi-turn goldens. Single-turn datasets have `multiTurn` set to `false` and contain single-turn goldens.",
            "example": false
          }
        },
        "required": [
          "id",
          "alias",
          "multiTurn"
        ],
        "description": "A dataset as it appears in your project's dataset list, without any goldens."
      },
      "DatasetVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the dataset version assigned by Confident AI, not to be confused with the version number.",
            "example": "<DATASET-VERSION-ID>"
          },
          "version": {
            "type": "string",
            "description": "The version number of the dataset version.",
            "example": "00.00.01"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the version was created, as an ISO 8601 timestamp.",
            "example": "2026-05-28T13:05:24.777Z"
          }
        },
        "required": [
          "id",
