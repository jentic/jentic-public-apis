  "paths": {
    "/v2/ai-connections": {
      "get": {
        "operationId": "listAIConnections",
        "summary": "List AI Connections",
        "description": "Lists the AI connections in your Confident AI project one page at a time, ordered by name. Each connection is returned with just its endpoint and whether it is active; retrieve one by id for its full configuration. Requires the Starter plan or above.",
        "tags": [
          "ai-connections"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of results per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List AI Connections succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnectionList"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/ai-connections"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "operationId": "createAIConnection",
        "summary": "Create AI Connection",
        "description": "Registers your LLM application with Confident AI and returns the id of the connection. The endpoint is called once as the connection is created to work out whether it is `active`, which you read back by retrieving the connection or pinging it. Requires the Starter plan or above.",
        "tags": [
          "ai-connections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAIConnectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Create AI Connection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnectionRef"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/ai-connections/<AI-CONNECTION-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/ai-connections/{aiConnectionId}": {
      "get": {
        "operationId": "getAIConnection",
        "summary": "Get AI Connection",
        "description": "Retrieves an AI connection by id with its full configuration. The stored `headers`, `queryParams`, `authentication` and `cloudProvider` are returned exactly as they were saved, so treat the response as carrying credentials.",
        "tags": [
          "ai-connections"
        ],
        "parameters": [
          {
            "name": "aiConnectionId",
            "in": "path",
            "required": true,
            "description": "The id of the AI connection.",
            "example": "<AI-CONNECTION-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get AI Connection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnection"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/ai-connections/<AI-CONNECTION-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "put": {
        "operationId": "updateAIConnection",
        "summary": "Update AI Connection",
        "description": "Changes an AI connection and returns it. Only the fields you send are touched, and `headers`, `queryParams` and `prompts` each replace the stored collection rather than merging into it. Changing anything that affects how your application is called re-tests the connection, so `active` in the response is the fresh verdict.",
        "tags": [
          "ai-connections"
        ],
        "parameters": [
          {
            "name": "aiConnectionId",
            "in": "path",
            "required": true,
            "description": "The id of the AI connection.",
            "example": "<AI-CONNECTION-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAIConnectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update AI Connection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnection"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/ai-connections/<AI-CONNECTION-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "operationId": "deleteAIConnection",
        "summary": "Delete AI Connection",
        "description": "Permanently deletes an AI connection. Anything scheduled against it, such as a dataset run or a risk assessment, stops running.",
        "tags": [
          "ai-connections"
        ],
        "parameters": [
          {
            "name": "aiConnectionId",
            "in": "path",
            "required": true,
            "description": "The id of the AI connection.",
            "example": "<AI-CONNECTION-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete AI Connection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnectionRef"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/ai-connections/{aiConnectionId}/ping": {
      "post": {
        "operationId": "pingAIConnection",
        "summary": "Ping AI Connection",
        "description": "Calls your LLM application once with a sample test case and reports what came back, including what each configured key path or transformer managed to extract. A ping that fails is still a `200`: read `active` and `error` in the body rather than the status code.",
        "tags": [
          "ai-connections"
        ],
        "parameters": [
          {
            "name": "aiConnectionId",
            "in": "path",
            "required": true,
            "description": "The id of the AI connection.",
            "example": "<AI-CONNECTION-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PingAIConnectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ping AI Connection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AIConnectionPingResult"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/ai-connections/<AI-CONNECTION-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/annotation-queues": {
      "get": {
        "operationId": "listAnnotationQueues",
        "summary": "List Annotation Queues",
        "description": "Lists the annotation queues in your Confident AI project one page at a time, newest first. Each queue is returned as a summary with its progress; retrieve a queue by id for the per-reviewer breakdown.",
        "tags": [
          "annotation-queues"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page of queues to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of queues per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Returns only queues holding this kind of item.",
            "schema": {
              "type": "string",
              "enum": [
                "TRACE",
                "SPAN",
                "THREAD",
                "GOLDEN",
                "TEST_CASE"
              ]
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "description": "Returns only queues whose name contains this text.",
            "example": "geography",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Annotation Queues succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AnnotationQueueList"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "operationId": "createAnnotationQueue",
        "summary": "Create Annotation Queue",
        "description": "Creates an annotation queue in your Confident AI project and returns its id. The `type` you give it decides what can be added to it and cannot be changed afterwards.",
        "tags": [
          "annotation-queues"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAnnotationQueueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Create Annotation Queue succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AnnotationQueueRef"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/annotation-queues/<ANNOTATION-QUEUE-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/annotation-queues/{annotationQueueId}": {
      "get": {
        "operationId": "getAnnotationQueue",
        "summary": "Get Annotation Queue",
        "description": "Retrieves an annotation queue by id from your Confident AI project, with how far through it your team is and how many items each reviewer holds.",
        "tags": [
          "annotation-queues"
        ],
        "parameters": [
          {
            "name": "annotationQueueId",
            "in": "path",
            "required": true,
            "description": "The id of the annotation queue.",
            "example": "<ANNOTATION-QUEUE-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get Annotation Queue succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AnnotationQueue"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/annotation-queues/<ANNOTATION-QUEUE-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "put": {
        "operationId": "updateAnnotationQueue",
        "summary": "Update Annotation Queue",
        "description": "Renames an annotation queue, replaces its tags, or attaches a different annotation form to it, and returns the queue. Send `formId: null` to detach the current form.",
        "tags": [
          "annotation-queues"
        ],
        "parameters": [
          {
            "name": "annotationQueueId",
            "in": "path",
            "required": true,
            "description": "The id of the annotation queue.",
            "example": "<ANNOTATION-QUEUE-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAnnotationQueueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update Annotation Queue succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AnnotationQueue"
                    },
                    "link": {
                      "type": "string",
                      "description": "This is the URL of the resource on the Confident AI platform.",
                      "example": "https://app.confident-ai.com/project/<PROJECT-ID>/annotation-queues/<ANNOTATION-QUEUE-ID>"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "link",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "operationId": "deleteAnnotationQueue",
        "summary": "Delete Annotation Queue",
        "description": "Permanently deletes an annotation queue and the items waiting in it. Annotations your team already recorded are kept.",
        "tags": [
          "annotation-queues"
        ],
        "parameters": [
          {
            "name": "annotationQueueId",
            "in": "path",
            "required": true,
            "description": "The id of the annotation queue.",
            "example": "<ANNOTATION-QUEUE-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete Annotation Queue succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
