    "/v2/scheduled-alerts": {
      "get": {
        "operationId": "listScheduledAlerts",
        "summary": "List Scheduled Alerts",
        "description": "Lists the scheduled alerts in your Confident AI project one page at a time, ordered by name, as summary rows.",
        "tags": [
          "scheduled-alerts"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page of scheduled alerts to return. Defaults to 1.",
            "example": 1,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of scheduled alerts per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "dataModel",
            "in": "query",
            "required": false,
            "description": "Returns only alerts measuring this kind of item. Omit to return all of them.",
            "schema": {
              "$ref": "#/components/schemas/AlertDataModel"
            }
          },
          {
            "name": "enabled",
            "in": "query",
            "required": false,
            "description": "Returns only alerts whose schedule is running when `true`, or only the paused ones when `false`. Omit to return both.",
            "example": "true",
