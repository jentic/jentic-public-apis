    "/v2/classifiers/{classifierId}/versions": {
      "get": {
        "operationId": "listClassifierVersions",
        "summary": "List Classifier Versions",
        "description": "Lists a classifier's version history, newest first, so the first entry is what the classifying model is shown today. A version is appended whenever the description or the set of labels the model can apply changes, which includes RECOMMENDED labels added by a generation run or by the model itself while the classifier classifies automatically. A version can be restored in the app, not through this API. Requires the Starter plan or above.",
        "tags": [
          "classifiers"
        ],
        "parameters": [
          {
            "name": "classifierId",
            "in": "path",
