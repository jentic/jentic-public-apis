      "put": {
        "operationId": "updateGovernancePolicySkill",
        "summary": "Update Governance Policy Skill",
        "description": "Sets the Agent Skill served to coding agents working on the projects this governance policy governs, creating it when the policy has none and replacing it outright otherwise. Both `description` and `body` are required, so there is no way to patch one and leave the other. The new text reaches an agent the next time it clones the project's Agent Skills repository.",
        "tags": [
          "organization"
        ],
        "parameters": [
          {
            "name": "policyId",
            "in": "path",
            "required": true,
            "description": "The id of the governance policy.",
            "example": "<GOVERNANCE-POLICY-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
