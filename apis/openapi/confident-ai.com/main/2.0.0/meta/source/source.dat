    "/v2/widgets/query": {
      "post": {
        "operationId": "queryAdHocWidget",
        "summary": "Query Ad Hoc Widget",
        "description": "Computes the data for a widget you define inline, without saving it to a dashboard. Branch on `data.kind` to read the result: the widget's `type` and `mode` say how it is drawn, not how the payload is shaped. A query accepts at most 20 lines, a `topK.limit` of at most 100, and a range no longer than 366 days.",
        "tags": [
          "widgets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdHocWidgetQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query Ad Hoc Widget succeeded.",
