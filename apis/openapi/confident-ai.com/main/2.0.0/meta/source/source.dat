    "/v2/organization/governance-policies/{policyId}/skill": {
      "get": {
        "operationId": "getGovernancePolicySkill",
        "summary": "Get Governance Policy Skill",
        "description": "Retrieves the Agent Skill attached to a governance policy — not a control, and nothing about it is assessed: it is the instructions Confident AI serves to coding agents working on the projects this policy governs. A project enrolled in this policy finds it in its Agent Skills git repository as `skills/governance/SKILL.md`. Answers with `null` when the policy has none, in which case agents receive no governance skill.",
        "tags": [
          "organization"
        ],
        "parameters": [
          {
            "name": "policyId",
            "in": "path",
            "required": true,
            "description": "The id of the governance policy.",
            "example": "<GOVERNANCE-POLICY-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get Governance Policy Skill succeeded.",
