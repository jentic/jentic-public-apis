          "totalTestRuns",
          "page",
          "pageSize"
        ]
      },
      "TestRunMultiTurnTestCase": {
        "type": "object",
        "properties": {
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "description": "The list of turns in the conversation.",
            "example": [
              {
                "id": "<TURN-ID>",
                "role": "user",
                "content": "How tall is Mount Everest?"
              },
              {
                "id": "<TURN-ID>",
                "role": "assistant",
                "content": "Mount Everest is 8,848 metres tall."
              }
            ]
          },
          "scenario": {
            "type": [
              "string",
              "null"
            ],
            "description": "A description of the conversation context.",
            "example": "A traveller asking about mountain heights."
          },
          "expectedOutcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "The expected outcome or ideal conversation flow.",
            "example": "The assistant states Everest's height."
          },
          "userDescription": {
            "type": [
              "string",
              "null"
            ],
            "description": "A description of the user in the conversation.",
            "example": "A traveller planning a trek."
          },
          "context": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "The context provided for the conversation.",
            "example": [
              "Everest is 8,848 metres tall."
            ]
          },
          "id": {
            "type": "string",
            "description": "This is the id of the test case generated by Confident AI.",
            "example": "<TEST-CASE-ID>"
          },
          "name": {
            "type": "string",
            "description": "This is the name of the test case.",
            "example": "everest-height"
          },
          "success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether this test case passed all metric thresholds and met its expectations, or `null` while it is still being evaluated.",
            "example": true
          },
          "runDuration": {
            "type": [
              "number",
              "null"
            ],
            "description": "The duration of the test case evaluation in seconds.",
            "example": 1.2
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of evaluating this test case.",
            "example": 0.001
          },
          "comments": {
            "type": [
              "string",
              "null"
            ],
            "description": "Any comments associated with this test case.",
            "example": "Reviewed by the geography team."
          },
          "additionalMetadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Additional metadata associated with this test case.",
            "example": {
              "region": "Nepal"
            }
          },
          "metricsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestCaseMetricData"
            },
            "description": "The metric evaluation results for this test case."
          },
          "expectationsData": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectationsData"
              },
              {
                "type": "null"
              }
            ],
            "description": "The result of judging this test case against its golden's expectations, or `null` when it had none."
          }
        },
        "required": [
          "turns",
          "scenario",
          "expectedOutcome",
          "userDescription",
          "context",
          "id",
          "name",
          "success",
          "runDuration",
          "evaluationCost",
          "comments",
          "additionalMetadata",
          "metricsData",
          "expectationsData"
        ],
        "additionalProperties": false,
        "description": "A test case evaluated as a conversation with your LLM application.",
        "title": "Multi-Turn Test Case"
      },
