        ]
      },
      "DeleteGovernancePolicyControlsRequest": {
        "type": "object",
        "properties": {
          "controlIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The controls to detach from the policy. Send at least one. An inherited control cannot be detached here — it is managed on the base policy that owns it.",
            "example": [
              "<GOVERNANCE-CONTROL-ID>"
            ]
          }
        },
        "required": [
          "controlIds"
        ],
        "additionalProperties": false,
        "description": "The controls to stop applying through this governance policy. The controls themselves are not deleted and stay available to other policies.",
        "title": "Delete Governance Policy Controls Request"
      },
      "Environment": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "This is the environment where your trace was posted, which helps with separating and debugging traces from different environments on the Confident AI platform. Any name up to 64 characters is accepted, for example production, staging or eu-prod."
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "description": "Indicates if the request was successful."
          },
          "error": {
            "type": "string",
            "description": "Describes what went wrong."
          },
          "link": {
            "type": "string",
            "description": "This is the URL of the resource on the Confident AI platform, when one applies."
          },
          "deprecated": {
            "type": "boolean",
            "description": "Indicates if this endpoint is deprecated."
          },
          "details": {
            "type": "object",
            "description": "Machine-readable fields for denials a client acts on, such as a quota's usage and limit. Present only on the errors that carry them.",
            "properties": {
              "usage": {
                "type": "string",
                "description": "How much of the quota has been consumed."
              },
              "limit": {
                "type": "string",
                "description": "The quota's limit."
              }
            }
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "EvalMode": {
        "type": "string",
        "enum": [
          "LLM",
          "HYBRID",
          "DECISION"
        ],
        "description": "Who decides in an LLM-as-a-judge metric. `LLM`: the evaluation model runs the whole metric. `HYBRID`: the evaluation model extracts and explains, and the decision model answers each decision, falling back to the evaluation model if a decision fails. `DECISION`: the decision model runs the whole metric in one request, with no evaluation model.",
        "title": "Eval Mode"
      },
      "EvaluateRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "description": "The name of the metric collection you wish to use for evaluation.",
            "example": "Collection Name"
          },
          "testCases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestCase"
            },
            "minItems": 1,
            "description": "This is the list of test cases to evaluate. Every test case in one request must be of the same kind — all single-turn, or all multi-turn."
          },
          "hyperparameters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HyperparameterValue"
            },
            "description": "This is any hyperparameters like model or prompt you wish to associate with the test run.",
            "example": {
              "model": "gpt-4o-mini"
            }
          },
          "identifier": {
            "type": "string",
            "description": "A unique identifier for the test run.",
            "example": "run-399-102"
          }
        },
        "required": [
          "metricCollection",
          "testCases"
        ]
      },
      "EvaluateResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the unique ID for the test run. This ID is generated by Confident AI and is not to be confused with the identifier provided by the user.",
            "example": "<TEST-RUN-ID>"
          }
        },
        "required": [
          "id"
        ]
      },
      "EvaluateSpanRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "description": "The name of the single-turn metric collection you wish to use for evaluation.",
            "example": "Collection Name"
          },
          "overwriteMetrics": {
            "type": "boolean",
            "description": "Set this to `true` to re-run every metric in the collection and replace the results already stored, and omit this field to keep those results and only run the metrics that have none yet.",
            "example": false
          }
        },
        "required": [
          "metricCollection"
        ],
        "description": "The metric collection to evaluate a span against.",
        "title": "Evaluate Span Request"
      },
      "EvaluateSpanResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the uuid of the span the evaluation was queued for.",
            "example": "<SPAN-UUID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "The span whose evaluation was queued.",
        "title": "Evaluate Span Result"
      },
      "EvaluateThreadRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "description": "The name of the multi-turn metric collection you wish to use for evaluation.",
            "example": "Collection Name"
          },
          "chatbotRole": {
            "type": "string",
            "description": "This is the role of the chatbot in the thread, which the multi-turn metrics that judge role adherence evaluate the thread against.",
            "example": "A helpful geography assistant."
          },
          "overwriteMetrics": {
            "type": "boolean",
            "description": "Set this to `true` to re-run every metric in the collection and replace the results already stored, and omit this field to keep those results and only run the metrics that have none yet.",
            "example": false
          }
        },
        "required": [
          "metricCollection"
        ],
        "description": "The metric collection to evaluate a thread against, and the role its chatbot was playing.",
        "title": "Evaluate Thread Request"
      },
      "EvaluateThreadResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the id of the thread the evaluation was queued for.",
            "example": "thread-42"
          }
        },
        "required": [
          "id"
        ],
        "description": "The thread whose evaluation was queued.",
        "title": "Evaluate Thread Result"
      },
      "EvaluateTraceRequest": {
        "type": "object",
        "properties": {
          "metricCollection": {
            "type": "string",
            "description": "The name of the single-turn metric collection you wish to use for evaluation.",
            "example": "Collection Name"
          },
          "overwriteMetrics": {
            "type": "boolean",
            "description": "Set this to `true` to re-run every metric in the collection and replace the results already stored, and omit this field to keep those results and only run the metrics that have none yet.",
            "example": false
          }
        },
        "required": [
          "metricCollection"
        ],
        "description": "The metric collection to evaluate a trace against.",
        "title": "Evaluate Trace Request"
      },
      "EvaluateTraceResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "This is the uuid of the trace the evaluation was queued for.",
            "example": "<TRACE-UUID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "The trace whose evaluation was queued.",
        "title": "Evaluate Trace Result"
      },
      "EvaluationErrorType": {
        "type": "string",
        "enum": [
          "AI_CONNECTION_ERROR",
          "TRANSFORMER_ERROR",
          "EVALUATION_MODEL_ERROR",
          "INVALID_TEST_CASE_PARAMETERS",
          "INTERNAL_ERROR"
        ],
        "description": "Why an evaluation errored: the AI connection or a transformer failed, the evaluation model failed, the test case lacked the parameters the metric needs, or an internal error occurred.",
        "title": "Evaluation Error Type"
      },
      "EvaluationRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the rule, generated by Confident AI.",
            "example": "<EVALUATION-RULE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the rule.",
            "example": "Score production answers"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "A note about what the rule checks, or `null` when unset.",
            "example": "Scores answers we serve to end users."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule is currently evaluating.",
            "example": true
          },
          "sampleRate": {
            "type": "number",
            "description": "The fraction of matching items the rule evaluates, between 0 and 1.",
            "example": 0.2
          },
          "dataModel": {
            "$ref": "#/components/schemas/EvaluationRuleDataModel"
          },
          "spanType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpanType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind of span the rule is narrowed to, or `null` when it evaluates every span or is not a `SPAN` rule."
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilterSet"
              },
              {
                "type": "null"
              }
            ],
            "description": "The filters an item must match to be evaluated, or `null` when the rule evaluates everything its `dataModel` covers.",
            "example": {
              "operator": "AND",
              "groups": [
                {
                  "operator": "AND",
                  "filters": [
                    {
                      "category": "Name",
                      "condition": "Is",
                      "value": "capital-lookup"
                    }
                  ]
                }
              ]
            }
          },
          "threadTimelimit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "For `THREAD` rules, the seconds of inactivity waited before a thread is evaluated, or `null` when the rule uses the project's thread timelimit.",
            "example": 300
          },
          "overwriteEvals": {
            "type": "boolean",
            "description": "Whether items that already have results for this metric collection are re-evaluated.",
            "example": false
          },
          "metricCollectionId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the metric collection the rule runs, or null when the rule runs individual metrics picked in the app. Retrieve it from the metric collections endpoint to see the metrics it holds.",
            "example": "<METRIC-COLLECTION-ID>"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the rule was created, as an ISO 8601 datetime.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the rule was last changed, as an ISO 8601 datetime.",
            "example": "2025-01-20T08:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "enabled",
          "sampleRate",
          "dataModel",
          "spanType",
          "filters",
          "threadTimelimit",
          "overwriteEvals",
          "metricCollectionId",
          "createdAt",
          "updatedAt"
        ],
        "description": "A standing rule that runs a metric collection against matching production traces, spans or threads as they arrive.",
        "title": "Evaluation Rule"
      },
      "EvaluationRuleDataModel": {
        "type": "string",
        "enum": [
          "TRACE",
          "SPAN",
          "THREAD"
        ],
        "description": "What kind of production item a rule evaluates: `TRACE` for a whole trace, `SPAN` for a single step within one, `THREAD` for a finished conversation.",
        "title": "Evaluation Rule Data Model"
      },
      "EvaluationRuleList": {
        "type": "object",
        "properties": {
          "evaluationRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationRuleSummary"
            },
            "description": "The rules for the current page, newest first."
          },
          "totalEvaluationRules": {
            "type": "integer",
            "description": "The total number of rules matching the query, across all pages.",
            "example": 4
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of rules per page.",
            "example": 25
          }
        },
        "required": [
          "evaluationRules",
          "totalEvaluationRules",
          "page",
          "pageSize"
        ],
        "description": "One page of evaluation rules, with the total across all pages.",
        "title": "Evaluation Rule List"
      },
      "EvaluationRuleRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the rule, generated by Confident AI.",
            "example": "<EVALUATION-RULE-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an evaluation rule by its id.",
        "title": "Evaluation Rule Ref"
      },
      "EvaluationRuleSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the rule, generated by Confident AI.",
            "example": "<EVALUATION-RULE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the rule.",
            "example": "Score production answers"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule is currently evaluating.",
            "example": true
          },
          "dataModel": {
            "$ref": "#/components/schemas/EvaluationRuleDataModel"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "dataModel"
        ],
        "description": "A rule as it appears in a list: enough to pick one. Its full configuration and the metric collection it runs come from retrieving it by id.",
        "title": "Evaluation Rule Summary"
      },
      "ExpectationKind": {
        "type": "string",
        "enum": [
          "MUST",
          "MUST_NOT"
        ],
        "description": "`MUST` for something the LLM system must do, `MUST_NOT` for something it must not do."
      },
      "ExpectationVerdict": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ExpectationKind"
          },
          "condition": {
            "type": "string",
            "description": "The condition as written on the golden.",
            "example": "Cite a source"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectationVerdictStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "The verdict, or `null` while the condition is being judged."
          },
          "reason": {
            "type": "string",
            "description": "Why the condition held or not.",
            "example": "The answer links to the Nepal tourism board."
          },
          "evidence": {
            "type": "string",
            "description": "The part of the test case the verdict is based on.",
            "example": "actual_output: \"Source: nepal.gov.np\""
          }
        },
        "required": [
          "kind",
          "condition",
          "status",
          "reason",
          "evidence"
        ],
        "description": "The verdict on one of a golden's expectations."
      },
      "ExpectationVerdictStatus": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "unable_to_evaluate"
        ],
        "description": "`pass` when the condition held, `fail` when it did not, and `unable_to_evaluate` when the test case gave too little to judge it."
      },
      "ExpectationsData": {
        "type": "object",
        "properties": {
          "success": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether every condition held.",
            "example": true
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "1 when every condition held, otherwise 0.",
            "example": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the test case met or missed its expectations.",
            "example": "The answer cited a source and named no competitors."
          },
          "verdicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpectationVerdict"
            },
            "description": "One verdict per condition."
          },
          "evaluationModel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model that judged the expectations.",
            "example": "gpt-4.1"
          },
          "evaluationCost": {
            "type": [
              "number",
              "null"
            ],
            "description": "The cost of judging the expectations.",
            "example": 0.0004
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The error raised while judging the expectations, if any.",
            "example": null
          }
        },
        "required": [
          "success",
          "score",
          "reason",
          "verdicts",
          "evaluationModel",
          "evaluationCost",
          "error"
        ],
        "description": "The result of judging a test case against its golden's expectations."
      },
      "ExpectationsScores": {
        "type": "object",
        "properties": {
          "scores": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "The expectations score of each test case judged against expectations: 1 when every condition held, otherwise 0.",
            "example": [
              1,
              1,
              0
            ]
          },
          "passes": {
            "type": "integer",
            "description": "The number of test cases that met every expectation.",
            "example": 2
          },
          "fails": {
            "type": "integer",
            "description": "The number of test cases that missed at least one expectation.",
            "example": 1
          },
          "errors": {
            "type": "integer",
            "description": "The number of test cases whose expectations errored during evaluation.",
            "example": 0
          }
        },
        "required": [
          "scores",
          "passes",
          "fails",
          "errors"
        ],
        "description": "The expectations results aggregated across the test cases in a test run."
      },
      "ExportDestination": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the destination, generated by Confident AI.",
            "example": "<EXPORT-DESTINATION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the destination.",
            "example": "Nightly S3 exports"
          },
          "type": {
            "$ref": "#/components/schemas/ExportDestinationType"
          },
          "bucket": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the bucket exports are uploaded to, or `null` for a `SNOWFLAKE` destination.",
            "example": "acme-llm-exports"
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "description": "The region the bucket lives in, or `null` for a `SNOWFLAKE` destination.",
            "example": "us-east-1"
          },
          "accessKeyId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null for a `SNOWFLAKE` destination. Otherwise the stored access key id, masked: fifteen asterisks followed by its last six characters. The real key id is never returned. Send this value back on an update to leave the stored key id alone, or omit the field entirely.",
            "example": "***************XAMPLE"
          },
          "secretAccessKey": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null for a `SNOWFLAKE` destination. Otherwise the stored secret access key, masked: fifteen asterisks followed by its last six characters. The real secret is never returned. Send this value back on an update to leave the stored secret alone, or omit the field entirely.",
            "example": "***************PLEKEY"
          },
          "pathPrefix": {
            "type": [
              "string",
              "null"
            ],
            "description": "The folder inside the bucket exports are written under, always ending in a slash, or `null` when they are written to the root of the bucket or the destination is `SNOWFLAKE`.",
            "example": "confident-ai/"
          },
          "snowflakeConfig": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SnowflakeExportDestinationMaskedConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Snowflake settings with secrets masked, or `null` for an `S3` destination."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether export schedules may upload to this destination.",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the destination was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the destination was last updated.",
            "example": "2025-01-20T08:15:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "bucket",
          "region",
          "accessKeyId",
          "secretAccessKey",
          "pathPrefix",
          "snowflakeConfig",
          "enabled",
          "createdAt",
          "updatedAt"
        ],
        "description": "A destination export schedules send exports to, with its credentials masked. Confident AI returns the last six characters of each credential so you can tell which one is stored, never the credential itself.",
        "title": "Export Destination"
      },
      "ExportDestinationList": {
        "type": "object",
        "properties": {
          "exportDestinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportDestinationSummary"
            },
            "description": "The destinations for the current page, newest first."
          },
          "totalExportDestinations": {
            "type": "integer",
            "description": "The total number of destinations in this project.",
            "example": 2
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of destinations per page.",
            "example": 25
          }
        },
        "required": [
          "exportDestinations",
          "totalExportDestinations",
          "page",
          "pageSize"
        ],
        "description": "One page of destinations, with the total across all pages.",
        "title": "Export Destination List"
      },
      "ExportDestinationRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the destination, generated by Confident AI.",
            "example": "<EXPORT-DESTINATION-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an export destination by its id.",
        "title": "Export Destination Ref"
      },
      "ExportDestinationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the destination, generated by Confident AI.",
            "example": "<EXPORT-DESTINATION-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the destination.",
            "example": "Nightly S3 exports"
          },
          "type": {
            "$ref": "#/components/schemas/ExportDestinationType"
          },
          "bucket": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of the bucket exports are uploaded to, or `null` for a `SNOWFLAKE` destination.",
            "example": "acme-llm-exports"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether export schedules may upload to this destination.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "bucket",
          "enabled"
        ],
        "description": "A destination as it appears in a list: enough to pick one, without its credentials. Retrieve it by id for the full record.",
        "title": "Export Destination Summary"
      },
      "ExportDestinationType": {
        "type": "string",
        "enum": [
          "S3",
          "GCS",
          "AZURE_BLOB",
          "SNOWFLAKE"
        ],
        "description": "Where exports go. `S3` uploads files to a bucket and `SNOWFLAKE` loads rows into tables; any other member is rejected on create. A destination's type can't be changed after it is created.",
        "title": "Export Destination Type"
      },
      "ExportSchedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the schedule, generated by Confident AI.",
            "example": "<EXPORT-SCHEDULE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the schedule.",
            "example": "Weekly checkout conversations"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the schedule exports, or `null` when it has no description.",
            "example": "Last week's checkout conversations for the data team."
          },
          "exportType": {
            "$ref": "#/components/schemas/SchedulableExportType"
          },
          "filters": {
            "$ref": "#/components/schemas/FilterSet"
          },
          "environment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Environment"
              },
              {
                "type": "null"
              }
            ],
            "description": "The environment each run exports data from, or `null` when it exports data from every environment.",
            "example": "production"
          },
          "annotationSelectionType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnnotationSelectionType"
              },
              {
                "type": "null"
              }
            ],
            "description": "The annotation source for each `ANNOTATIONS` export run, or `null` when it exports annotations from every source.",
            "example": "Traces"
          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of the export destination each run delivers its file to, or `null` when the schedule has none.",
            "example": "<EXPORT-DESTINATION-ID>"
          },
          "scheduleSettings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExportScheduleSettings"
              },
              {
                "type": "null"
              }
            ],
            "description": "The cadence the schedule runs on, or `null` when its settings were deleted and it no longer runs."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the schedule was created.",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the schedule was last changed.",
            "example": "2025-02-24T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "exportType",
          "filters",
          "environment",
          "annotationSelectionType",
          "destinationId",
          "scheduleSettings",
          "createdAt",
          "updatedAt"
        ],
        "description": "A recurring export of this project's data. Each run covers the window since the previous run and narrows it by `filters`, where an empty `groups` list exports everything in that window.",
        "title": "Export Schedule"
      },
      "ExportScheduleList": {
        "type": "object",
        "properties": {
          "exportSchedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportScheduleSummary"
            },
            "description": "The schedules for the current page, newest first."
          },
          "totalExportSchedules": {
            "type": "integer",
            "description": "The total number of schedules matching the query.",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "The page this response covers.",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of schedules per page.",
            "example": 25
          }
        },
        "required": [
          "exportSchedules",
          "totalExportSchedules",
          "page",
          "pageSize"
        ],
        "description": "One page of export schedules, with the total across all pages.",
        "title": "Export Schedule List"
      },
      "ExportScheduleRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the schedule, generated by Confident AI.",
            "example": "<EXPORT-SCHEDULE-ID>"
          }
        },
        "required": [
          "id"
        ],
        "description": "A reference to an export schedule by its id.",
        "title": "Export Schedule Ref"
      },
      "ExportScheduleSettings": {
        "type": "object",
        "properties": {
          "recurrence": {
            "$ref": "#/components/schemas/ScheduleRecurrenceType"
          },
          "repeatEvery": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many `repeatUnit`s apart the runs are, or `null` for a schedule that does not repeat.",
            "example": 1
          },
          "repeatUnit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleIntervalUnit"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unit `repeatEvery` counts, or `null` for a schedule that does not repeat."
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule first runs, or `null` when it started immediately.",
            "example": "2025-02-01T09:00:00.000Z"
          },
          "endAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule stops running, or `null` when it is open-ended.",
            "example": "2025-12-31T23:59:59.000Z"
          },
          "maxRuns": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many times the schedule runs before it stops, or `null` when it runs indefinitely.",
            "example": 12
          },
          "runCount": {
            "type": "integer",
            "description": "How many times the schedule has run so far.",
            "example": 6
          },
          "lastRunAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the schedule last ran, or `null` when it has never run.",
            "example": "2025-02-24T09:00:00.000Z"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the schedule is currently running.",
            "example": true
          }
        },
        "required": [
          "recurrence",
          "repeatEvery",
          "repeatUnit",
          "startAt",
          "endAt",
          "maxRuns",
          "runCount",
          "lastRunAt",
          "enabled"
        ],
        "description": "The cadence an export schedule runs on, together with how far through that cadence it is.",
        "title": "Export Schedule Settings"
      },
      "ExportScheduleSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the schedule, generated by Confident AI.",
            "example": "<EXPORT-SCHEDULE-ID>"
          },
          "name": {
            "type": "string",
            "description": "The name of the schedule.",
            "example": "Weekly checkout conversations"
          },
          "exportType": {
            "$ref": "#/components/schemas/SchedulableExportType"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the schedule is currently running.",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "exportType",
          "enabled"
        ],
        "description": "An export schedule as it appears in a list: what it exports and whether it is running, without its cadence or filters.",
        "title": "Export Schedule Summary"
      },
