    "/v2/datasets/{datasetId}": {
      "get": {
        "operationId": "pullDataset",
        "summary": "Pull Dataset",
        "description": "Retrieves the dataset with its goldens, oldest first. Pass `version` to pull a specific version, and `finalized=false` to pull the goldens still awaiting review instead of the finalized ones. Requires an active trial or paid plan, and the Team plan or above to pull a version.",
        "tags": [
          "datasets"
        ],
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "The unique id of the dataset.",
            "example": "<DATASET-ID>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "The version to pull. Defaults to the latest version, or to the unversioned goldens when the dataset has no versions. Requires the Team plan or above.",
            "example": "00.00.01",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "finalized",
            "in": "query",
            "required": false,
            "description": "Whether to pull the finalized goldens, or with `false` the goldens still awaiting review. Defaults to `true`.",
            "example": "true",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pull Dataset succeeded.",
