      "get": {
        "operationId": "listOrganizationApiKeys",
        "summary": "List Organization API Keys",
        "description": "Lists every organization-scoped API key in your organization, newest first. Each key's `value` is masked — the full value is only ever returned once, by the response that issues it. A rotation whose grace period has already run out is completed before the list is read, so a `shadowValue` here is always still in flight.",
        "tags": [
          "organization"
        ],
        "responses": {
          "200": {
            "description": "List Organization API Keys succeeded.",
