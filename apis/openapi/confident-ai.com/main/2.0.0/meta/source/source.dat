          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "operationId": "createVulnerability",
        "summary": "Create Vulnerability",
        "description": "Creates a vulnerability in your Confident AI project and returns its id. Give it at least one type: a risk category selects types, not vulnerabilities. The name cannot match one Confident AI ships — update that one instead to customise it for this project.",
