      "put": {
        "operationId": "updateVulnerability",
        "summary": "Update Vulnerability",
        "description": "Updates a vulnerability and returns it. Updating one Confident AI ships makes this project its own copy of it, leaving every other project untouched, and a built-in cannot be renamed.",
        "tags": [
          "vulnerabilities"
        ],
        "parameters": [
