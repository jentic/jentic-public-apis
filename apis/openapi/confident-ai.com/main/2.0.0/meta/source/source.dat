          "createdAt"
        ]
      },
      "DatasetVersionList": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetVersion"
            },
            "description": "This is the list of versions of the dataset, newest first."
          }
        },
        "required": [
