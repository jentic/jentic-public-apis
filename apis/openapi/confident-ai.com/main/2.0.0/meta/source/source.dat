    "/v2/organization/models": {
      "get": {
        "operationId": "getOrganizationModel",
        "summary": "Get Organization Model",
        "description": "Returns one of your organization's default models, selected by the required `type` query parameter. Each default applies to every project with no override of its own; read a single project's effective model with the project models endpoint. Reading never creates configuration, so this answers with `null` until the organization sets one.",
