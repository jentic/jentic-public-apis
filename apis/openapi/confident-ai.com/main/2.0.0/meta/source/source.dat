    "/v2/threads": {
      "get": {
        "operationId": "listThreads",
        "summary": "List Threads",
        "description": "Lists the threads in your Confident AI project one page at a time, most recently active first by default. Each thread is returned as a summary; retrieve a thread by id for its traces, evaluation results and annotations.",
        "tags": [
          "threads"
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of results per page, at most 100. Defaults to 25.",
            "example": 25,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "This is used for pagination, and should be set to the `nextCursor` value returned in the previous response to get the next page of results.",
            "example": "<NEXT-CURSOR>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "This filters for results created at or after the specified start datetime, in ISO 8601 format. Defaults to 60 days ago.",
            "example": "2025-01-01T00:00:00Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "This filters for results created before the specified end datetime, in ISO 8601 format. Defaults to the current time.",
            "example": "2025-01-31T23:59:59Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "ascending",
            "in": "query",
            "required": false,
            "description": "This determines if the field specified in `sortBy` should be in ascending order. Defaults to `false`, which returns the newest results first.",
            "example": "false",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "This determines the field to sort by. Defaults to `lastActivity`.",
            "schema": {
              "$ref": "#/components/schemas/ThreadSortBy",
              "default": "lastActivity"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "This filters the threads by the environment where their traces were created, and returns threads from all environments if not specified.",
            "schema": {
              "$ref": "#/components/schemas/Environment"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Threads succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ThreadList"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
