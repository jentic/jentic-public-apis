    "/v2/projects/{projectId}/audit-logs/exports": {
      "post": {
        "operationId": "createProjectAuditLogExport",
        "summary": "Create Project Audit Log Export",
        "description": "Starts a background export of one project's audit logs — every audited action recorded against that project — as a gzipped CSV, and responds `202` with the export to poll. Use the organization endpoint to cover every project at once.\n\nPoll `GET /v2/projects/{projectId}/audit-logs/exports/{exportId}` until `status` is `COMPLETED`, then call `GET /v2/projects/{projectId}/audit-logs/exports/{exportId}/download` for the file; `ERRORED` is terminal. One export runs at a time per project and caller, so starting a second returns `409`, and a period matching no audit logs, or more than 10,000,000 audit logs, is rejected with `400`.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The id of the project whose audit logs are exported. It must belong to the organization the API key belongs to.",
            "example": "<PROJECT-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuditLogExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Create Project Audit Log Export succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuditLogExport"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/projects/{projectId}/audit-logs/exports/{exportId}": {
      "get": {
        "operationId": "getProjectAuditLogExport",
        "summary": "Get Project Audit Log Export",
        "description": "Retrieves a project audit log export, so you can poll one you started — poll here rather than at the download endpoint, which has nothing to serve until `status` is `COMPLETED`. An export is kept for 24 hours, or 5 minutes once it has failed, after which this returns `404`. The lookup is not restricted to audit log exports, so another kind of export id comes back with its own `exportType`.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The id of the project whose audit logs are exported. It must belong to the organization the API key belongs to.",
            "example": "<PROJECT-ID>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exportId",
            "in": "path",
            "required": true,
            "description": "The id of the audit log export, as returned when it was created.",
            "example": "<AUDIT-LOG-EXPORT-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get Project Audit Log Export succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful.",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuditLogExport"
                    },
                    "deprecated": {
                      "type": "boolean",
                      "description": "Indicates if this endpoint is deprecated.",
                      "example": false
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/projects/{projectId}/audit-logs/exports/{exportId}/download": {
      "get": {
        "operationId": "downloadProjectAuditLogExport",
        "summary": "Download Project Audit Log Export",
        "description": "Downloads the file of a completed project audit log export. Responds `302` with a `Location` header pointing at a pre-signed URL, valid for 15 minutes, serving the gzipped CSV — follow the redirect (with curl, `-L`). A fresh signature is minted per call, so call this again rather than storing the URL. Returns `404` while the export is `IN_PROGRESS` or `ERRORED`, once the file is cleaned up, or for a non-audit-log export id.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The id of the project whose audit logs are exported. It must belong to the organization the API key belongs to.",
            "example": "<PROJECT-ID>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exportId",
            "in": "path",
            "required": true,
            "description": "The id of the audit log export, as returned when it was created.",
            "example": "<AUDIT-LOG-EXPORT-ID>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A pre-signed object storage URL for the export's audit logs as a gzipped CSV, served as a file attachment and valid for 15 minutes.",
            "headers": {
              "Location": {
                "description": "A pre-signed object storage URL for the export's audit logs as a gzipped CSV, served as a file attachment and valid for 15 minutes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v2/projects/{projectId}/invitations": {
      "get": {
        "operationId": "listProjectInvitations",
        "summary": "List Project Invitations",
        "description": "Lists the invitations to this project that are still outstanding — those the invitee has not answered, and those they declined. An invitation drops off this list once it is accepted or revoked, and invitations do not expire on their own. Every entry carries the token from the invitee's invite link, so treat the response as sensitive. Invitations to the organization as a whole are listed separately.",
        "tags": [
          "projects"
        ],
        "parameters": [
          {
