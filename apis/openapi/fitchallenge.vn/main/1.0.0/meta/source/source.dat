    "/workouts/upload": {
      "post": {
        "tags": [
          "Workout"
        ],
        "summary": "Tải video tập luyện lên S3",
        "description": "Tải video tập luyện lên S3 và trả về URL video",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Video tập luyện định dạng mp4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tải video thành công, trả về URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "videoUrl": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://s3.amazonaws.com/fitchallenge/videos/workout-7890.mp4"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ hoặc file không hợp lệ"
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      }
    },
