{
  "openapi": "3.0.0",
  "info": {
    "title": "FitChallenge – AI Gym Challenge cho Người Dùng Việt Nam",
    "version": "1.0.0",
    "description": "FitChallenge là nền tảng thử thách thể hình sử dụng AI cho người dùng Việt Nam, cho phép tham gia thử thách, tải video tập luyện, nhận điểm AI và xem bảng xếp hạng.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/fpt-18c/Fit-AI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.fitchallenge.vn/v1",
      "description": "Máy chủ sản xuất"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Các API xác thực và quản lý người dùng"
    },
    {
      "name": "User",
      "description": "Thông tin và quản lý người dùng"
    },
    {
      "name": "Challenge",
      "description": "Quản lý thử thách thể hình"
    },
    {
      "name": "Workout",
      "description": "Quản lý video tập luyện và phân tích AI"
    },
    {
      "name": "Leaderboard",
      "description": "Bảng xếp hạng người dùng"
    },
    {
      "name": "Admin",
      "description": "API dành cho quản trị viên hệ thống"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "Thông tin người dùng",
        "required": [
          "id",
          "username",
          "email",
          "password",
          "role",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Mã định danh người dùng",
            "example": "user-123456"
          },
          "username": {
            "type": "string",
            "description": "Tên đăng nhập",
            "example": "nguyenvana"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Địa chỉ email",
            "example": "nguyenvana@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu (đã mã hóa)",
            "example": "P@ssw0rd123"
          },
          "role": {
            "type": "string",
            "description": "Vai trò người dùng",
            "enum": [
              "user",
              "admin"
            ],
            "example": "user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời gian tạo tài khoản",
            "example": "2024-05-01T08:30:00Z"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "description": "Thông tin thử thách thể hình",
        "required": [
          "id",
          "title",
          "description",
          "startDate",
          "endDate",
          "difficulty",
          "participants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Mã thử thách",
            "example": "challenge-001"
          },
          "title": {
            "type": "string",
            "description": "Tiêu đề thử thách",
            "example": "Thử thách 30 ngày Squat"
          },
          "description": {
            "type": "string",
            "description": "Mô tả chi tiết thử thách",
            "example": "Tham gia thử thách squat mỗi ngày trong 30 ngày để cải thiện sức mạnh chân."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Ngày bắt đầu thử thách",
            "example": "2024-06-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Ngày kết thúc thử thách",
            "example": "2024-06-30"
          },
          "difficulty": {
            "type": "string",
            "description": "Mức độ thử thách",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ],
            "example": "beginner"
          },
          "participants": {
            "type": "array",
            "description": "Danh sách người tham gia thử thách",
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "example": [
              {
                "id": "user-123456",
                "username": "nguyenvana",
                "email": "nguyenvana@example.com",
                "password": "P@ssw0rd123",
                "role": "user",
                "createdAt": "2024-05-01T08:30:00Z"
              }
            ]
          }
        }
      },
      "Workout": {
        "type": "object",
        "description": "Thông tin video tập luyện và điểm AI",
        "required": [
          "id",
          "userId",
          "challengeId",
          "videoUrl",
          "uploadTime",
          "aiScore",
          "aiFeedback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Mã video tập luyện",
            "example": "workout-7890"
          },
          "userId": {
            "type": "string",
            "description": "Mã người dùng tải video",
            "example": "user-123456"
          },
          "challengeId": {
            "type": "string",
            "description": "Mã thử thách liên quan",
            "example": "challenge-001"
          },
          "videoUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL video lưu trên S3",
            "example": "https://s3.amazonaws.com/fitchallenge/videos/workout-7890.mp4"
          },
          "uploadTime": {
            "type": "string",
            "format": "date-time",
            "description": "Thời gian tải video lên",
            "example": "2024-06-10T14:20:00Z"
          },
          "aiScore": {
            "type": "number",
            "description": "Điểm đánh giá AI",
            "example": 87.5
          },
          "aiFeedback": {
            "type": "string",
            "description": "Phản hồi chi tiết từ AI",
            "example": "Tư thế squat tốt, cần cải thiện độ sâu."
          }
        }
      },
      "Leaderboard": {
        "type": "object",
        "description": "Thông tin bảng xếp hạng người dùng",
        "required": [
          "userId",
          "username",
          "totalScore",
          "rank"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "Mã người dùng",
            "example": "user-123456"
          },
          "username": {
            "type": "string",
            "description": "Tên đăng nhập người dùng",
            "example": "nguyenvana"
          },
          "totalScore": {
            "type": "number",
            "description": "Tổng điểm tích lũy",
            "example": 950.75
          },
          "rank": {
            "type": "integer",
            "description": "Xếp hạng hiện tại",
            "example": 12
          }
        }
      },
      "AIAnalysisResult": {
        "type": "object",
        "description": "Kết quả phân tích AI cho video tập luyện",
        "required": [
          "postureAccuracy",
          "repetitionCount",
          "formFeedback",
          "improvementTips"
        ],
        "properties": {
          "postureAccuracy": {
            "type": "number",
            "description": "Độ chính xác tư thế (%)",
            "example": 92.3
          },
          "repetitionCount": {
            "type": "integer",
            "description": "Số lần lặp lại bài tập",
            "example": 15
          },
          "formFeedback": {
            "type": "string",
            "description": "Phản hồi về kỹ thuật tập luyện",
            "example": "Tư thế lưng hơi cong, cần giữ thẳng hơn."
          },
          "improvementTips": {
            "type": "string",
            "description": "Gợi ý cải thiện",
            "example": "Tập trung vào giữ thẳng lưng và hạ thấp hông hơn."
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng ký người dùng mới",
        "description": "Tạo tài khoản người dùng mới trên hệ thống",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "nguyenvana"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "nguyenvana@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "P@ssw0rd123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Người dùng được tạo thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": "user-123456",
                  "username": "nguyenvana",
                  "email": "nguyenvana@example.com",
                  "password": "P@ssw0rd123",
                  "role": "user",
                  "createdAt": "2024-05-01T08:30:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng nhập và nhận JWT",
        "description": "Xác thực người dùng và trả về token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "nguyenvana"
                  },
                  "password": {
                    "type": "string",
                    "example": "P@ssw0rd123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, trả về token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string",
                      "description": "Token truy cập JWT",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "Token làm mới",
                      "example": "dGhpc2lzYXJlZnJlc2h0b2tlbg=="
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "401": {
            "description": "Xác thực thất bại"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        },
        "security": []
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Làm mới token JWT",
        "description": "Cấp lại token truy cập mới dựa trên refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "example": "dGhpc2lzYXJlZnJlc2h0b2tlbg=="
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cấp token mới thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "401": {
            "description": "Token làm mới không hợp lệ hoặc hết hạn"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        },
        "security": []
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Lấy thông tin hồ sơ người dùng hiện tại",
        "description": "Trả về thông tin chi tiết người dùng đã đăng nhập",
        "responses": {
          "200": {
            "description": "Thông tin người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": "user-123456",
                  "username": "nguyenvana",
                  "email": "nguyenvana@example.com",
                  "password": "P@ssw0rd123",
                  "role": "user",
                  "createdAt": "2024-05-01T08:30:00Z"
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      },
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Cập nhật thông tin người dùng hiện tại",
        "description": "Cho phép người dùng cập nhật thông tin cá nhân",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "nguyenvana"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "nguyenvana@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "NewP@ssw0rd123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công, trả về thông tin mới",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": "user-123456",
                  "username": "nguyenvana",
                  "email": "nguyenvana@example.com",
                  "password": "NewP@ssw0rd123",
                  "role": "user",
                  "createdAt": "2024-05-01T08:30:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      }
    },
    "/challenges": {
      "get": {
        "tags": [
          "Challenge"
        ],
        "summary": "Lấy danh sách tất cả thử thách",
        "description": "Trả về danh sách thử thách hiện có",
        "responses": {
          "200": {
            "description": "Danh sách thử thách",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Challenge"
                  }
                },
                "example": [
                  {
                    "id": "challenge-001",
                    "title": "Thử thách 30 ngày Squat",
                    "description": "Tham gia thử thách squat mỗi ngày trong 30 ngày để cải thiện sức mạnh chân.",
                    "startDate": "2024-06-01",
                    "endDate": "2024-06-30",
                    "difficulty": "beginner",
                    "participants": []
                  },
                  {
                    "id": "challenge-002",
                    "title": "Thử thách Plank 7 ngày",
                    "description": "Giữ plank mỗi ngày để tăng sức bền cơ core.",
                    "startDate": "2024-07-01",
                    "endDate": "2024-07-07",
                    "difficulty": "intermediate",
                    "participants": []
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      },
      "post": {
        "tags": [
          "Challenge"
        ],
        "summary": "Tạo thử thách mới (chỉ admin)",
        "description": "Tạo một thử thách thể hình mới trong hệ thống",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "startDate",
                  "endDate",
                  "difficulty"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Thử thách 10 ngày Chạy bộ"
                  },
                  "description": {
                    "type": "string",
                    "example": "Chạy bộ mỗi ngày 5km trong 10 ngày."
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-08-01"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-08-10"
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": [
                      "beginner",
                      "intermediate",
                      "advanced"
                    ],
                    "example": "beginner"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thử thách được tạo thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                },
                "example": {
                  "id": "challenge-003",
                  "title": "Thử thách 10 ngày Chạy bộ",
                  "description": "Chạy bộ mỗi ngày 5km trong 10 ngày.",
                  "startDate": "2024-08-01",
                  "endDate": "2024-08-10",
                  "difficulty": "beginner",
                  "participants": []
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "401": {
            "description": "Không có quyền truy cập"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      }
    },
    "/challenges/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Mã thử thách",
          "required": true,
          "schema": {
            "type": "string",
            "example": "challenge-001"
          }
        }
      ],
      "get": {
        "tags": [
          "Challenge"
        ],
        "summary": "Lấy chi tiết thử thách theo ID",
        "description": "Trả về thông tin chi tiết của thử thách",
        "responses": {
          "200": {
            "description": "Thông tin thử thách",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                },
                "example": {
                  "id": "challenge-001",
                  "title": "Thử thách 30 ngày Squat",
                  "description": "Tham gia thử thách squat mỗi ngày trong 30 ngày để cải thiện sức mạnh chân.",
                  "startDate": "2024-06-01",
                  "endDate": "2024-06-30",
                  "difficulty": "beginner",
                  "participants": []
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực hoặc token không hợp lệ"
          },
          "404": {
            "description": "Không tìm thấy thử thách"
          },
          "500": {
            "description": "Lỗi máy chủ nội bộ"
          }
        }
      },
      "put": {
        "tags": [
          "Challenge"
        ],
        "summary": "Cập nhật thử thách theo ID",
        "description": "Cập nhật thông tin thử thách hiện có",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Thử thách 30 ngày Squat nâng cao"
                  },
                  "description": {
                    "type": "string",
                    "example": "Phiên bản nâng cao của thử thách squat 30 ngày."
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-06-01"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-06-30"
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": [
                      "beginner",
                      "intermediate",
                      "advanced"
                    ],
                    "example": "intermediate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công, trả về thử thách mới",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                },
                "example": {
                  "id": "challenge-001",
