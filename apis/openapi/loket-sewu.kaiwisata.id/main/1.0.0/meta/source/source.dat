{
  "openapi": "3.0.3",
  "info": {
    "title": "KAI Wisata B2B Ticketing API (Lawang Sewu)",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/IRHAMRZDY/api_lawang_sewu/1.0.0"
  },
  "servers": [
    {
      "url": "https://loket-sewu.kaiwisata.id/api/b2b/v1"
    }
  ],
  "tags": [
    {
      "name": "Holds"
    },
    {
      "name": "Orders"
    }
  ],
  "components": {
    "securitySchemes": {
      "PartnerCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-PARTNER-CODE"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "string"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Optional internal error string."
          }
        }
      },
      "HoldCreateRequest": {
        "type": "object",
        "required": [
          "type_ticket_id",
          "visit_date",
          "qty"
        ],
        "properties": {
          "type_ticket_id": {
            "type": "integer",
            "example": 1
          },
          "visit_date": {
            "type": "string",
            "format": "date",
            "example": "2026-02-10"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "HoldResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Hold dibuat"
          },
          "data": {
            "type": "object",
            "required": [
              "hold_code",
              "type_ticket_id",
              "visit_date",
              "qty",
              "price",
              "expires_at"
            ],
            "properties": {
              "hold_code": {
                "type": "string",
                "example": "B2BH260210000001"
              },
              "type_ticket_id": {
                "type": "integer",
                "example": 1
              },
              "visit_date": {
                "type": "string",
                "format": "date",
                "example": "2026-02-10"
              },
              "qty": {
                "type": "integer",
                "example": 2
              },
              "price": {
                "type": "number",
                "format": "float",
                "example": 30000
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "example": "2026-02-08T12:10:45+07:00"
              }
            }
          }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": [
          "hold_code",
          "external_order_id"
        ],
        "properties": {
          "hold_code": {
            "type": "string",
            "example": "B2BH260210000001"
          },
          "external_order_id": {
            "type": "string",
            "maxLength": 64,
            "example": "TRVLK-ORDER-0001"
          }
        }
      },
      "OrderCreateResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Order dibuat"
          },
          "data": {
            "type": "object",
            "required": [
              "order_id",
              "order_code",
              "external_order_id",
              "status",
              "total_amount"
            ],
            "properties": {
              "order_id": {
                "type": "integer",
                "example": 10
              },
              "order_code": {
                "type": "string",
                "example": "B2BO260210000001"
              },
              "external_order_id": {
                "type": "string",
                "example": "TRVLK-ORDER-0001"
              },
              "status": {
                "type": "string",
                "enum": [
                  "UNPAID",
                  "PAID",
                  "ISSUED"
                ],
                "example": "UNPAID"
              },
              "total_amount": {
                "type": "number",
                "format": "float",
                "example": 60000
              }
            }
          }
        }
      },
      "MarkPaidResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Order di-set PAID"
          },
          "data": {
            "type": "object",
            "required": [
              "status",
              "order_code",
              "external_order_id"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "PAID",
                  "ISSUED"
                ],
                "example": "PAID"
              },
              "order_code": {
                "type": "string",
                "example": "B2BO260210000001"
              },
              "external_order_id": {
                "type": "string",
                "example": "TRVLK-ORDER-0001"
              }
            }
          }
        }
      },
      "TicketItem": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "example": 100
          },
          "no_ticket": {
            "type": "string",
            "example": "LW260210000001"
          },
          "status": {
            "type": "integer",
            "example": 0
          },
          "tgl_expire": {
            "type": "string",
            "format": "date-time",
            "example": "2026-02-10T23:59:59+07:00"
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Issued"
          },
          "data": {
            "type": "object",
            "required": [
              "booking_id",
              "kode_booking",
              "tickets"
            ],
            "properties": {
              "booking_id": {
                "type": "integer",
                "example": 1234
              },
              "kode_booking": {
                "type": "string",
                "example": "LW2602000001"
              },
              "tickets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TicketItem"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "PartnerCode": []
    }
  ],
  "paths": {
    "/holds": {
      "post": {
        "tags": [
          "Holds"
        ],
        "summary": "Create Hold",
        "security": [
          {
            "PartnerCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hold created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation rule error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ticket nonaktif / not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create Order from Hold",
        "security": [
          {
            "PartnerCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreateResponse"
                }
              }
            }
          },
          "403": {
            "description": "Hold bukan milik partner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Hold tidak ditemukan / ticket nonaktif",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Hold expired / tidak aktif / validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_code}/mark-paid": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Mark Order as PAID",
        "security": [
          {
            "PartnerCode": []
          }
        ],
        "parameters": [
          {
            "name": "order_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "B2BO260210000001"
          }
        ],
        "responses": {
          "200": {
            "description": "Mark paid OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkPaidResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (order bukan milik partner)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_code}/issue": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Issue Tickets",
        "description": "Issue hanya bisa jika status PAID/ISSUED. Expire mengikuti visit_date (23:59:59).",
        "security": [
          {
            "PartnerCode": []
          }
        ],
        "parameters": [
          {
            "name": "order_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "B2BO260210000001"
          }
        ],
        "responses": {
          "200": {
            "description": "Issue OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (order bukan milik partner)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Order belum PAID / invalid state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
