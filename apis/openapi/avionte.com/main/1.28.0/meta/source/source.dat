          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "405": {
            "$ref": "#/components/responses/405UnsupportedMethod"
          },
          "406": {
            "$ref": "#/components/responses/406UnsupportedAccessHeader"
          },
          "415": {
            "$ref": "#/components/responses/415UnsupportedContentType"
          },
          "429": {
