          },
          "tues": {
            "type": "number",
            "description": "Tuesday hours worked.",
            "format": "decimal"
          },
          "wed": {
            "type": "number",
            "description": "Wednesday hours worked.",
            "format": "decimal"
          },
          "thurs": {
            "type": "number",
            "description": "Thursday hours worked.",
            "format": "decimal"
          },
          "fri": {
            "type": "number",
            "description": "Friday hours worked.",
