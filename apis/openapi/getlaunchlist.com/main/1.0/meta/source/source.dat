{"openapi":"3.1.0","info":{"title":"LaunchList API","version":"1.0","summary":"Capture signups, read your audience and run early access from code.","description":"The LaunchList REST API. Every write rides the same submit pipeline the hosted page uses, so\ncanonicalization, dedupe, referral credit, events, webhooks and automations all fire exactly as\nthey do for a signup typed into a page.\n\nConventions worth knowing before your first call:\n\n* **Auth** is a bearer key: `Authorization: Bearer llk_live_…`. Keys belong to the workspace,\n  never to the person who made one.\n* **Ids are handles**, not UUIDs: `con_…` (contact), `prj_…` (project), `frm_…` (form).\n* **Lists are cursor-paginated** with `starting_after` / `ending_before` and answer a\n  `{ object: \"list\", has_more, data }` envelope. There is no page count and no total.\n* **Every error is the same envelope**, from a validation failure to a 500.\n* **Every response carries `Request-Id`.** Quote it in a support request and we can find the\n  exact call.\n","contact":{"name":"LaunchList support","url":"https://app.getlaunchlist.com/help/docs/api/authentication"},"license":{"name":"Proprietary","url":"https://getlaunchlist.com/terms"}},"externalDocs":{"description":"API reference and guides","url":"https://app.getlaunchlist.com/help/docs/api"},"servers":[{"url":"https://api.getlaunchlist.com/v1","description":"This installation"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Contacts","description":"The audience. Create, read, update, remove, and the lifecycle verbs around them."},{"name":"Invitations","description":"Early access. Mint codes, revoke them, redeem them, and reconcile what happened."},{"name":"Imports","description":"Silent bulk import — add an existing list without the signup pipeline."},{"name":"Tags","description":"Ad-hoc labels on contacts. Create, list, and apply or remove in bulk."},{"name":"Segments","description":"Saved dynamic filters. List, read, count an unsaved filter, and create."},{"name":"Broadcasts","description":"Email the audience. Draft, test, prepare and send, in batches if you like, then read the results."},{"name":"Automations","description":"Read-only. Canvas-authored flows and where a contact stands in them. No manual enrollment."},{"name":"Projects","description":"Read-only discovery of the projects a key covers."},{"name":"Forms","description":"Read-only discovery of the capture targets a signup can name."},{"name":"Workspace","description":"Token introspection. Who am I, what may I do, how fast may I call."}],"paths":{"/":{"get":{"tags":["Workspace"],"operationId":"getServiceIndex","summary":"Service index","description":"Unauthenticated discovery and health. The one endpoint that takes no key, IP-throttled\nrather than workspace-throttled.\n","security":[],"responses":{"200":{"description":"The service is up.","content":{"application/json":{"schema":{"type":"object","properties":{"service":{"type":"string","examples":["LaunchList"]},"version":{"type":"string","examples":["v1"]},"status":{"type":"string","examples":["ok"]},"authentication":{"type":"string"},"endpoints":{"type":"array","items":{"type":"string"}},"docs":{"type":"string","format":"uri"},"openapi":{"type":"string","description":"Where this document lives. Advertised from the one endpoint that\nneeds no key, so a developer can point Postman at the API before\nthey have created one.\n","examples":["/v1/openapi.json"]}}}}}}}}},"/openapi.json":{"get":{"tags":["Workspace"],"operationId":"getOpenApiDocument","summary":"This document","description":"The OpenAPI document, served with `servers` rewritten to the host that answered. Import this\nURL into Postman, Insomnia, Bruno or a code generator. No key needed.\n","security":[],"responses":{"200":{"description":"The OpenAPI 3.1 document.","content":{"application/json":{"schema":{"type":"object","properties":{"openapi":{"type":"string","examples":["3.1.0"]}}}}}}}}},"/workspace":{"get":{"tags":["Workspace"],"operationId":"getWorkspace","summary":"Retrieve the calling workspace","description":"Token introspection: the plan, the limits, the current usage and the key's own scopes. This\nis the request to write first, because it proves the key works without touching data.\n","x-required-scope":"projects:read","responses":{"200":{"description":"The workspace behind the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts":{"get":{"tags":["Contacts"],"operationId":"listContacts","summary":"List contacts","description":"Newest first, cursor-paginated. Filters compose.","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"name":"status","in":"query","description":"Subscription status. `verified` means subscribed, which is what campaign sending reads.","schema":{"$ref":"#/components/schemas/ContactStatus"}},{"name":"stage","in":"query","description":"A pipeline stage key configured on the project, for example `waitlist`.","schema":{"type":"string"}},{"name":"identifier","in":"query","description":"Exact identity match. Email addresses are canonicalized the same way the write path\ncanonicalizes them, so the address a person typed finds the row we stored.\n","schema":{"type":"string"}},{"name":"email","in":"query","description":"Exact match on the address a contact is mailed at, canonicalized like `identifier`.\nFinds a contact identified by a phone number or a username by their email.\n","schema":{"type":"string"}},{"name":"external_id","in":"query","description":"Your own id for this person, if you set one.","schema":{"type":"string"}},{"name":"created","in":"query","style":"deepObject","explode":true,"description":"Bound by creation time, for example `created[gte]=2026-01-01`.","schema":{"$ref":"#/components/schemas/TimeRange"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of contacts.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Contact"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Contacts"],"operationId":"createContact","summary":"Create a contact","description":"Capture a signup through the real submit pipeline, as an authenticated caller. The target\nform's own schema rules still apply, so its required fields are still required.\n\nA brand new signup answers **201**. An identity we already hold answers **200** with the\nexisting contact, which makes this endpoint safe to call from a retry loop even without an\nidempotency key.\n\nCapture is unconditional: a workspace over its plan cap still accepts the signup and\nreturns it with `locked: true`.\n","x-required-scope":"contacts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactCreate"},"examples":{"email":{"summary":"An email signup with attributes and a referrer","value":{"project":"prj_8fk2xr7pqmvd","email":"ada@example.com","attributes":{"company":"Analytical Engines","plan_interest":"pro"},"referred_by":"7Kd93m"}}}}}},"responses":{"200":{"description":"The identity already existed. The existing contact is returned unchanged.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"201":{"description":"A new contact was captured.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"description":"The request was refused. `code` says why: `no_capture_form` (the project has no active\nwaitlist form and none was named), `form_without_identity`, `submission_rejected` (the\nspam guard held it), `contact_not_created` (the submission was accepted but resolved to\nno contact, which means the form's identity configuration is wrong),\n`external_id_taken`, or `parameter_invalid`.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Two different limits answer here, told apart by `code`.\n\n* `rate_limit_exceeded` is the per-workspace API limit every other operation carries.\n* `submission_rate_limited` is the submit pipeline's own per-signup guard, the same one\n  the hosted page is behind. It carries its own `Retry-After` and says nothing about\n  your API budget.\n","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/contacts/count":{"get":{"tags":["Contacts"],"operationId":"countContacts","summary":"Count contacts","description":"Totals by status and by stage, read from the audience counters rather than scanned. Cheap\nat any list size, which is why it is a separate endpoint instead of a field on the list.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"}],"responses":{"200":{"description":"The counts.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactCount"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"getContact","summary":"Retrieve a contact","x-required-scope":"contacts:read","responses":{"200":{"description":"The contact.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"patch":{"tags":["Contacts"],"operationId":"updateContact","summary":"Update a contact","description":"Identity is deliberately not editable. It is resolved, not assigned, so changing it would\nmean changing who a row is about.\n\nMoving `stage` to your invited stage mints a real invitation code as a side effect, exactly\nas the dashboard does, so the invite email that fires next has a working link.\n\nA contact hidden past the plan's contact size is refused with a **403**, `code:\ncontact_hidden`, `param: contact`, and nothing is written. It is saved, and editing works\nagain once the workspace moves up a size. Deleting it still works.\n","x-required-scope":"contacts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactUpdate"}}}},"responses":{"200":{"description":"The updated contact.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"description":"Either the key lacks the scope, or `contact_hidden`: the contact is past the plan's\ncontact size and cannot be edited until the workspace moves up a size.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}},"delete":{"tags":["Contacts"],"operationId":"deleteContact","summary":"Remove or erase a contact","description":"By default this is a recoverable removal that frees the billable count and keeps the shape\nof the referral graph, so nobody's position moves.\n\nWith `?erase=true` it is the GDPR Article 17 erasure instead: identity is overwritten in\nplace across the contact, its submissions and its campaign sends, and it cannot be undone.\n","x-required-scope":"contacts:write","parameters":[{"name":"erase","in":"query","description":"Perform an irreversible erasure rather than a recoverable removal.","schema":{"type":"boolean","default":false}},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Removed.","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"contact"},"id":{"$ref":"#/components/schemas/ContactHandle"},"deleted":{"const":true},"erased":{"type":"boolean"}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/submissions":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"listContactSubmissions","summary":"List a contact's submissions","description":"Every form response this person has sent, newest first. Submissions carry no public handle\nyet, so cursor anchors on this one list are raw submission ids.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of submissions.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Submission"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/emails":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"listContactEmails","summary":"List a contact's emails","description":"Every email this person was sent or is queued to get, newest first: broadcasts, automation\nsteps and system emails such as the confirmation or an invitation. Each row says where it\ncame from, its subject, its delivery status and when it was sent and delivered.\n\nOpens and clicks are not included. Tracking is off by default, so an empty value would\nread as \"never opened\" when the truth is \"never measured\". Page with the `msg_…` id of a\nrow as `starting_after` or `ending_before`.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of emails.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Email"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/referrals":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"listContactReferrals","summary":"List the people a contact referred","description":"Direct referees only, one level down, newest first.","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of referred contacts.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Contact"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/position":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"getContactPosition","summary":"Retrieve live leaderboard standing","description":"Rank, how many referrals it would take to reach first, and how many places one more\nreferral moves them right now. Read live from the leaderboard, so treat every value as a\nsnapshot rather than something to store.\n","x-required-scope":"contacts:read","responses":{"200":{"description":"The standing. Every value is null when the contact is not on the board. On a project\nthat scores a referral at zero points, `position` is a real rank while `to_first` and\n`next_jump` are both null: they answer \"what does one more referral buy\", and there the\nhonest answer is nothing.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Position"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/automations":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"get":{"tags":["Contacts"],"operationId":"listContactAutomations","summary":"List a contact's automation enrollments","description":"Every automation this contact is, or has been, enrolled in: its state, a human label for\nthe step they are currently on, and when a waiting step resumes. Rides `automations:read`,\nnot `contacts:read` — a key that can read the audience does not automatically get to see\nwhat marketing flows a person is inside.\n","x-required-scope":"automations:read","responses":{"200":{"description":"This contact's enrollments, newest first. Unpaginated — a contact is realistically\nin a handful of automations, never thousands.\n","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AutomationEnrollment"}}}}]}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/resend_verification":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"post":{"tags":["Contacts"],"operationId":"resendContactVerification","summary":"Resend the opt-in email","description":"Only meaningful while verification is pending. The action's own cooldown still applies, and\na send suppressed by that cooldown answers `sent: false` rather than pretending.\n","x-required-scope":"contacts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Handled.","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"verification_resend"},"contact":{"$ref":"#/components/schemas/ContactHandle"},"sent":{"type":"boolean","description":"False when a guard declined this send."},"reason":{"type":"string","description":"Why the send was declined, or `sent` when it went out.","enum":["sent","already_verified","no_email_channel","cooldown","mail_cap","undeliverable","suppressed"]}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"description":"`contact_not_pending`: this contact has nothing to verify.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/unsubscribe":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"post":{"tags":["Contacts"],"operationId":"unsubscribeContact","summary":"Unsubscribe a contact","description":"Suppresses campaign mail. The contact, their submissions and their place in the referral\ngraph are all kept.\n","x-required-scope":"contacts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"The updated contact.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/contacts/{contact}/resubscribe":{"parameters":[{"$ref":"#/components/parameters/ContactPath"}],"post":{"tags":["Contacts"],"operationId":"resubscribeContact","summary":"Resubscribe a contact","description":"Only ever call this on a request the person made themselves. Re-subscribing someone who\nopted out is the fastest way to lose a sending domain.\n","x-required-scope":"contacts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"The updated contact.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Contact"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations":{"get":{"tags":["Invitations"],"operationId":"listInvitations","summary":"List invitations","description":"The reconcile channel. Backfill a webhook delivery you missed, migrate in, or audit what\nwas handed out. `updated[gte]` is the sync cursor: everything that changed since last time.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"name":"status","in":"query","description":"Matches the stored status column. Unlike the contacts filter this one is not validated\nagainst the enum: an unknown value answers an empty list rather than a 400.\n","schema":{"$ref":"#/components/schemas/InvitationStatus"}},{"name":"kind","in":"query","schema":{"$ref":"#/components/schemas/InvitationKind"}},{"name":"source","in":"query","description":"How the invitation came into existence, for example `api` or `manual`.","schema":{"$ref":"#/components/schemas/InvitationSource"}},{"name":"batch","in":"query","description":"Restrict to one batch, by its public handle.","schema":{"type":"string"}},{"name":"contact","in":"query","description":"Restrict to one contact, by their `con_…` handle.","schema":{"$ref":"#/components/schemas/ContactHandle"}},{"name":"updated","in":"query","style":"deepObject","explode":true,"description":"Bound by last change, for example `updated[gte]=2026-08-01T00:00:00Z`.","schema":{"$ref":"#/components/schemas/TimeRange"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of invitations.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Invitation"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Invitations"],"operationId":"createInvitation","summary":"Mint an invitation","description":"A `personal` invitation names one contact and is exactly equivalent to moving that contact\nto your invited stage. Calling it twice for the same person reuses the live invitation\nrather than minting a second, so retries are safe.\n\n⚠️ **What each `kind` additionally requires**, because sending only `project` is not enough:\n\n* `personal` (the default) needs **`contact` or `identity`**. A request carrying neither\n  answers `422` with `param: contact`.\n* `shared` needs **`seats`**.\n* `open` needs **`expires_at`**, unless the project sets a default invite expiry. An open\n  link that never expires is refused outright.\n\nPersonal invites work on every plan. Shared codes, open links, bring-your-own code strings\nand domain restriction need a plan with branded invite codes (Launch or Grow).\n","x-required-scope":"invites:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvitationCreate"},"examples":{"personal":{"summary":"Invite one known contact","value":{"project":"prj_8fk2xr7pqmvd","kind":"personal","contact":"con_7kq3mxrz9dnp"}},"shared":{"summary":"A shared code with 500 seats, expiring","value":{"project":"prj_8fk2xr7pqmvd","kind":"shared","seats":500,"expires_at":"2026-09-01T00:00:00Z","allowed_domains":["example.com"]}}}}}},"responses":{"201":{"description":"The invitation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Invitation"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"description":"Either the key lacks the scope, or `plan_required`: this invitation shape needs a plan\nwith branded invite codes (Launch or Grow).\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"`invitation_not_issued` on the **personal** path: that contact cannot be invited from\ntheir current stage. Also the idempotency conflict.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A validation failure, with `errors` carrying the per-field detail, **or**\n`invitation_not_issued` on the **shared/open** path: a shared code with no seat limit,\nan open link with no expiry, or a bring-your-own `code` already in use on the project.\nNote the status split: the same `code` is a 409 for a personal invitation and a 422\nfor a standing one.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations/{invitation}":{"parameters":[{"name":"invitation","in":"path","required":true,"description":"The invitation's public handle.","schema":{"type":"string"}}],"get":{"tags":["Invitations"],"operationId":"getInvitation","summary":"Retrieve an invitation","x-required-scope":"contacts:read","responses":{"200":{"description":"The invitation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Invitation"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations/{invitation}/revoke":{"parameters":[{"name":"invitation","in":"path","required":true,"description":"The invitation's public handle.","schema":{"type":"string"}}],"post":{"tags":["Invitations"],"operationId":"revokeInvitation","summary":"Revoke an invitation","description":"Runs the same action the dashboard runs, so a personal code taken back here also steps its\ncontact back to the waitlist. This is the rollback path when one of your own downstream\nsteps fails after a redemption.\n\nGive a `reason` when you have one. It is stored and echoed back, which is the difference\nbetween answering your own support question in six weeks and guessing.\n","x-required-scope":"invites:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"reason":{"type":"string","maxLength":200,"examples":["payment reversed"]}}}}}},"responses":{"200":{"description":"The revoked invitation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Invitation"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations/redeem":{"post":{"tags":["Invitations"],"operationId":"redeemInvitation","summary":"Redeem a code","description":"Check and redeem in one call. This is what your signup form calls when somebody types a\ncode.\n\n**Idempotent.** Replaying the same code and identity returns the original redemption with\n`replayed: true` and a 200, rather than refusing as already redeemed. That property is what\nmakes a single call safe: without it, your server crashing between our commit and your user\ninsert would lock that person out permanently.\n\n`?dry_run=true` validates without consuming and records nothing. Use it to check a field as\nit is typed, then call again without the flag to actually let the person in.\n\nCarries its own limiter on top of the per-workspace one, because this is the endpoint where\nguessing pays.\n","x-required-scope":"contacts:read","parameters":[{"name":"dry_run","in":"query","description":"Validate only. Consumes no seat and records no redemption.","schema":{"type":"boolean","default":false}},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvitationRedeem"}}}},"responses":{"200":{"description":"Redeemed, or replayed. With `dry_run=true` the answer is an `invitation_check` instead.\n","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/InvitationRedemption"},{"$ref":"#/components/schemas/InvitationCheck"}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"The code could not be redeemed. `code` names which of expired, revoked, exhausted,\nwrong identity or disallowed domain applied.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations/confirm":{"post":{"tags":["Invitations"],"operationId":"confirmInvitation","summary":"Confirm access without a code","description":"Record that a person on your list got in, with no code presented.\n\n⚠️ **We authenticate your project, not your user.** Establish who the person is yourself,\nwith a signed-in session, a verified address, an OTP or trusted SSO, before calling this. A\n200 from us is not an authentication result and must never by itself create or sign in an\naccount.\n\nIdempotent on the invitation and identity pair, exactly like redeem, and recorded as a\nconfirmation so the dashboard never presents your assertion as something we checked. If you\nhave the code, use `redeem` instead: it is strictly better evidence.\n","x-required-scope":"invites:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvitationConfirm"}}}},"responses":{"200":{"description":"Confirmed, or replayed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvitationConfirmation"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"The identity has no admissible invitation on that project.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/invitations/exchange":{"post":{"tags":["Invitations"],"operationId":"exchangeInvitationHandoff","summary":"Exchange a claim reference","description":"Swap the opaque reference our claim page redirected with for the identity behind it.\n\nThis is what makes the redirect safe to put in a query string: what travels in the URL is a\nsingle-use reference valid for 120 seconds that means nothing to anyone who intercepts it,\nand the identity only ever moves over this authenticated call.\n\nUnknown, expired and already-consumed references all answer the same 404, because\ndistinguishing them would tell a caller which guess was close.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["project","handoff"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"handoff":{"type":"string","description":"The reference our claim page redirected with."}}}}}},"responses":{"200":{"description":"The claims behind the reference.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvitationHandoff"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"description":"The reference is unknown, expired or already used.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/imports":{"get":{"tags":["Imports"],"operationId":"listImports","summary":"List imports","description":"Every silent bulk import queued for a project, newest first — whether it was started here,\nby `import_contacts`, or from the dashboard's own CSV upload.\n","x-required-scope":"imports:write","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of imports.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Import"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Imports"],"operationId":"createImport","summary":"Bulk-import contacts silently","description":"Add an existing list to the audience WITHOUT the signup pipeline — exactly the dashboard's\nCSV import, by API. No `signup.created`, no confirmation or welcome email, no automation\nenrollment. One `audience.imported` event/webhook fires when the whole run finishes.\n\nThis only QUEUES the import: it answers `202` with the record in `processing`, before a\nsingle row has landed. Poll `GET /v1/imports/{import}` for counts and any rejected rows.\n\nEvery contact needs an `email`, a `phone`, or `identifier` + `identifier_type` (`email` or\n`phone` — the pipeline has no other identity kinds). `status: \"subscribed\"` is an explicit\nattestation that this list already opted in, matching the dashboard mapping step's own\n\"these contacts already opted in\" checkbox and its default; leave it `unconfirmed` for a\nlist you cannot attest to.\n\nCapped at 10,000 contacts per call. A larger list is a job for the dashboard's own\nchunked-upload wizard, not one request.\n","x-required-scope":"imports:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImportCreate"},"examples":{"basic":{"summary":"Two contacts, one new tag","value":{"project":"prj_8fk2xr7pqmvd","contacts":[{"email":"ada@example.com","name":"Ada Lovelace","attributes":{"company":"Analytical Engines"}},{"identifier":"+15551234567","identifier_type":"phone","name":"Grace Hopper"}],"duplicates":"skip","status":"unconfirmed","tags":["imported-2026-q3"]}}}}}},"responses":{"201":{"description":"The queued import.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Import"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/imports/{import}":{"parameters":[{"name":"import","in":"path","required":true,"description":"An `imp_…` handle, or the import's uuid.","schema":{"$ref":"#/components/schemas/ImportRef"}}],"get":{"tags":["Imports"],"operationId":"getImport","summary":"Check an import","description":"Status and outcome: still `processing`, or `completed` with counts for imported, updated,\nskipped-as-duplicate and invalid rows. When rows were rejected, up to 100 of them come back\nparsed as `{ row, identifier, reason }`, plus a short-lived signed `report_url` for the full\nCSV. Deliberately never reports anything from the deliverability screening a large import\ntriggers afterward — only the validation/dedupe reasons the row was actually rejected for.\n","x-required-scope":"imports:write","responses":{"200":{"description":"The import.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Import"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/automations":{"get":{"tags":["Automations"],"operationId":"listAutomations","summary":"List automations","description":"Every automation in a project, newest first — trigger, live status and its counter-cache\n(enrolled, completed, sent, delivered, bounced). Read-only: manual enrollment does not\nexist, by design.\n","x-required-scope":"automations:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of automations.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Automation"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/automations/{automation}":{"parameters":[{"name":"automation","in":"path","required":true,"description":"An `aut_…` handle, or the automation's uuid.","schema":{"$ref":"#/components/schemas/AutomationRef"}}],"get":{"tags":["Automations"],"operationId":"getAutomation","summary":"Retrieve an automation","description":"Everything `listAutomations` returns, plus a readable step list: each node's type and a\nhuman label, with any tag/segment/template/broadcast a step references named by its own\npublic handle, never the internal id the canvas doc actually stores.\n","x-required-scope":"automations:read","responses":{"200":{"description":"The automation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Automation"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/projects":{"get":{"tags":["Projects"],"operationId":"listProjects","summary":"List projects","description":"A key pinned to one project lists exactly that project. The pin is a boundary, not a\ndefault.\n","x-required-scope":"projects:read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of projects.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Project"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/projects/{project}":{"parameters":[{"name":"project","in":"path","required":true,"description":"A `prj_…` handle, or the project's uuid.","schema":{"$ref":"#/components/schemas/ProjectRef"}}],"get":{"tags":["Projects"],"operationId":"getProject","summary":"Retrieve a project","x-required-scope":"projects:read","responses":{"200":{"description":"The project.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Project"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/forms":{"get":{"tags":["Forms"],"operationId":"listForms","summary":"List forms","description":"The capture targets a create call can name. `project` narrows to one project, and a pinned\nkey is always narrowed to its own.\n","x-required-scope":"projects:read","parameters":[{"name":"project","in":"query","description":"Restrict to one project.","schema":{"$ref":"#/components/schemas/ProjectRef"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of forms.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Form"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/forms/{form}":{"parameters":[{"name":"form","in":"path","required":true,"description":"A `frm_…` handle, or the form's uuid.","schema":{"type":"string"}}],"get":{"tags":["Forms"],"operationId":"getForm","summary":"Retrieve a form","x-required-scope":"projects:read","responses":{"200":{"description":"The form.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Form"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/tags":{"get":{"tags":["Tags"],"operationId":"listTags","summary":"List tags","description":"Newest first, cursor-paginated. Each carries `contacts_count` — an index-backed count,\nnever a scan of the audience.\n","x-required-scope":"contacts:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of tags.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Tag"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Tags"],"operationId":"createTag","summary":"Create a tag","description":"Idempotent by name within the project: creating a tag that already exists by that name\nreturns the existing one (**200**) instead of a duplicate. A brand new tag answers **201**.\n","x-required-scope":"contacts:write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagCreate"},"examples":{"default":{"value":{"project":"prj_8fk2xr7pqmvd","name":"high-intent","color":"#22c563"}}}}}},"responses":{"200":{"description":"A tag with this name already existed. It is returned unchanged.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Tag"}}}},"201":{"description":"A new tag was created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Tag"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/tags/{tag}/contacts":{"parameters":[{"name":"tag","in":"path","required":true,"description":"A `tag_…` handle, or the tag's uuid.","schema":{"$ref":"#/components/schemas/TagRef"}}],"post":{"tags":["Tags"],"operationId":"addTagToContacts","summary":"Add this tag to contacts","description":"Either an explicit list of contact handles, or everyone a saved segment matches — pass\none of `contacts` / `segment`, never both. With `segment`, `limit` (1-1000) takes the\n**oldest matching contacts first**, which is what makes \"tag the next 20\" possible: pass\na segment that already excludes contacts carrying this tag, and a limit. Omitting `limit`\ntags everyone the segment matches, capped at 1000 per call either way.\n\nA contact that already carries the tag is left alone, and contacts held past the plan\nlimit are never touched. No email or automation fires from tagging.\n","x-required-scope":"contacts:write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagContactsRequest"},"examples":{"byHandles":{"summary":"An explicit list","value":{"contacts":["con_4mkp9wq2rx","con_2bn8vd5lk"]}},"bySegment":{"summary":"The oldest 20 of a saved segment","value":{"segment":"seg_7qk2mn4pr8","limit":20}}}}}},"responses":{"200":{"description":"Applied. `attached` is how many newly gained the tag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagApplyResult"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"description":"No such tag, or `segment` names one that does not exist. A key that does not cover\nthe tag's project also answers here, never a 403.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}},"delete":{"tags":["Tags"],"operationId":"removeTagFromContacts","summary":"Remove this tag from contacts","description":"The reverse of adding it, with the identical `contacts` / `segment` (+ `limit`) body. A\ncontact that never carried the tag is left untouched. Nothing is deleted: only the\nassociation between the tag and these contacts.\n","x-required-scope":"contacts:write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagContactsRequest"}}}},"responses":{"200":{"description":"Applied. `detached` is how many lost the tag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagApplyResult"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/segments":{"get":{"tags":["Segments"],"operationId":"listSegments","summary":"List segments","description":"Every saved segment in a project, each with its live matching count.","x-required-scope":"segments:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"}],"responses":{"200":{"description":"Every segment. There is no pagination: a project holds at most a few dozen, so this\nanswers the whole set in one call (`has_more` is always `false`).\n","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Segment"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Segments"],"operationId":"createSegment","summary":"Create a segment","description":"Save a rules tree as a named, reusable dynamic segment — the same `rules` grammar\n`POST /segments/preview` counts. Creating a segment of your own is available on plans\nwith saved segments (Launch and Grow); on a plan without it this is a **422** naming the entitlement, not a silent no-op.\n","x-required-scope":"segments:write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SegmentCreate"},"examples":{"default":{"value":{"project":"prj_8fk2xr7pqmvd","name":"Engaged referrers","rules":{"match":"and","conditions":[{"field":"is_referrer","operator":"is_true"},{"field":"status","operator":"eq","value":"verified"}]}}}}}}},"responses":{"201":{"description":"The saved segment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Segment"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/segments/preview":{"post":{"tags":["Segments"],"operationId":"previewSegment","summary":"Count who a filter matches","description":"The live count for a `rules` tree that is not saved anywhere — check a filter before\n`POST /segments`, or before capping a tag call with `limit`. An omitted or empty tree\ncounts everyone.\n","x-required-scope":"segments:read","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SegmentPreviewRequest"}}}},"responses":{"200":{"description":"The match count.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SegmentPreviewResult"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/segments/{segment}":{"parameters":[{"name":"segment","in":"path","required":true,"description":"A `seg_…` handle, or the segment's uuid.","schema":{"$ref":"#/components/schemas/SegmentRef"}}],"get":{"tags":["Segments"],"operationId":"getSegment","summary":"Retrieve a segment","description":"Includes its live matching count, computed fresh — never the stale stored figure.","x-required-scope":"segments:read","responses":{"200":{"description":"The segment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Segment"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts":{"get":{"tags":["Broadcasts"],"operationId":"listBroadcasts","summary":"List broadcasts","description":"A project's broadcasts, newest first, each with its results.","x-required-scope":"broadcasts:read","parameters":[{"$ref":"#/components/parameters/ProjectQuery"},{"name":"status","in":"query","description":"Only broadcasts in this status.","schema":{"$ref":"#/components/schemas/BroadcastStatus"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of broadcasts.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Broadcast"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"tags":["Broadcasts"],"operationId":"createBroadcast","summary":"Create a broadcast draft","description":"A draft, never a send. Sender fields left out inherit the project's saved sender, exactly as\nin the composer. Audience handles are resolved inside the project: a handle from another\nproject is a 422 naming it, never silently dropped.\n","x-required-scope":"broadcasts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BroadcastCreate"},"examples":{"personal":{"summary":"A plain-text note to a tag","value":{"project":"prj_8fk2xr7pqmvd","subject":"Quick question, {{first_name|there}}","content":{"format":"text","body":"Hi {{first_name|there}},\n\nWhat made you sign up? Just hit reply.\n\nAda"},"audience":{"type":"tag","tag":"tag_9mvd4rq2ph7k","exclude":{"tags":["tag_3hx8kq2mvp4r"]}}}}}}}},"responses":{"201":{"description":"The draft.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"get":{"tags":["Broadcasts"],"operationId":"getBroadcast","summary":"Retrieve a broadcast","description":"The broadcast with its content, audience, delivery and results.","x-required-scope":"broadcasts:read","responses":{"200":{"description":"The broadcast.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}},"patch":{"tags":["Broadcasts"],"operationId":"updateBroadcast","summary":"Update a broadcast","description":"Changes only the fields sent. Only a `draft`, `scheduled` or `failed` broadcast can be edited;\nanything else is a 409. Editing a broadcast after `prepare` voids its confirmation token.\n","x-required-scope":"broadcasts:write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BroadcastUpdate"}}}},"responses":{"200":{"description":"The updated broadcast.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}},"delete":{"tags":["Broadcasts"],"operationId":"deleteBroadcast","summary":"Delete a draft","description":"Only a `draft` or `failed` broadcast can be deleted. A broadcast that went out stays as the\nrecord of what the audience received; cancel a scheduled one first.\n","x-required-scope":"broadcasts:write","responses":{"200":{"description":"Deleted.","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"broadcast"},"id":{"$ref":"#/components/schemas/BroadcastRef"},"deleted":{"const":true}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/recipients":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"get":{"tags":["Broadcasts"],"operationId":"listBroadcastRecipients","summary":"List a broadcast's recipients","description":"Everyone the broadcast was sent or queued to, newest first, from the send ledger. `status`\nuses the same values as a contact's email history.\n","x-required-scope":"broadcasts:read","parameters":[{"name":"status","in":"query","description":"Only recipients in this status.","schema":{"type":"string","enum":["queued","sent","delivered","bounced","complained","suppressed","failed","canceled"]}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/StartingAfter"},{"$ref":"#/components/parameters/EndingBefore"}],"responses":{"200":{"description":"A page of recipients.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ListEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/BroadcastRecipient"}}}}]}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/test":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"sendBroadcastTest","summary":"Send a test to your team","description":"One copy, `[TEST]`-prefixed, to a member of the workspace. Any other address is a 422: a test\nis for the people building the broadcast. Merge tags are filled with sample values. Needs a\nplan that includes broadcasts. Limited to 12 a minute per workspace.\n","x-required-scope":"broadcasts:write","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email"],"properties":{"email":{"type":"string","format":"email","description":"A workspace member's address."}}}}}},"responses":{"200":{"description":"The test was handed to the email provider.","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"broadcast_test"},"broadcast":{"$ref":"#/components/schemas/BroadcastRef"},"sent_to":{"type":"string","format":"email"}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/IdempotencyConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/prepare":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"prepareBroadcast","summary":"Prepare to send","description":"Runs the same checks as the dashboard's send screen and says who it would reach. Writes\nnothing. When `ready`, it returns a `confirmation_token` that `send` accepts for 15 minutes,\nand only while the broadcast is unedited and in the same status, the `send_at` matches\n(none for sending now), and the recipient count has not moved past `tolerance`: exact for a\nlist under 100 people, within 1% above that. To schedule, pass the `send_at` you will send\nwith. Limited to 10 a minute per workspace, shared with `send`.\n","x-required-scope":"broadcasts:send","requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"send_at":{"type":"string","format":"date-time","description":"Only when scheduling: the time you will pass to `send`. The token is bound\nto it. ISO 8601; without an offset it is read as UTC.\n"}}}}}},"responses":{"200":{"description":"The preparation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BroadcastPreparation"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/send":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"sendBroadcast","summary":"Send or schedule","description":"Sends now (**202**, `status` shows how far it got) or, with `send_at`, schedules it (**200**,\n`status: scheduled`). Emails real people and cannot be undone.\n\nWith a `confirmation_token` from `prepare`, nothing goes out unless the broadcast, its status,\nthe `send_at` (or its absence) and its recipient count (within the token's `tolerance`) still\nmatch what was prepared, and the same key prepared it: otherwise a 422 on\n`confirmation_token` says what changed. The token is optional here so an integration with\nits own review step can send directly; MCP always requires it.\n\nPreflight runs again either way: a 422 on `campaign` lists what would stop the send. That\nincludes a send larger than what is left of this month's email allowance: extra emails are a\ncharge the founder approves in the dashboard before sending, so the API never buys them.\n","x-required-scope":"broadcasts:send","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BroadcastSend"}}}},"responses":{"200":{"description":"Scheduled.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"202":{"description":"Sending. Queued, not yet delivered.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"422":{"$ref":"#/components/responses/ValidationFailed"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/pause":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"pauseBroadcast","summary":"Pause","description":"Stops a sending broadcast where it is. Already-sent emails stand; a batched broadcast keeps\nits schedule for `resume`. A broadcast that is not sending is a 409 and nothing changes.\n","x-required-scope":"broadcasts:send","responses":{"200":{"description":"The paused broadcast.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/resume":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"resumeBroadcast","summary":"Resume","description":"Picks a paused broadcast back up, sending to everyone who has not had it yet. Nobody is sent\nit twice. A broadcast that is not paused is a 409 and nothing changes.\n","x-required-scope":"broadcasts:send","responses":{"200":{"description":"The resumed broadcast.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/broadcasts/{broadcast}/cancel":{"parameters":[{"$ref":"#/components/parameters/BroadcastPath"}],"post":{"tags":["Broadcasts"],"operationId":"cancelBroadcast","summary":"Cancel","description":"Stops a scheduled, sending or paused broadcast for good. Already-sent emails stand. Anything\nelse is a 409 and nothing changes.\n","x-required-scope":"broadcasts:send","responses":{"200":{"description":"The canceled broadcast.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Broadcast"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/StateConflict"},"429":{"$ref":"#/components/responses/RateLimited"}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Your secret key, sent as `Authorization: Bearer llk_live_…`. Keys are created in\nEmbed & API → Developers → API keys and are owned by the workspace, not by the person who made one.\n\nNever put a live key in client-side code. To capture signups from a web page, use the\nembed, which is designed to be public.\n"}},"parameters":{"Limit":{"name":"limit","in":"query","description":"Page size, 1 to 100.","schema":{"type":"integer","minimum":1,"maximum":100,"default":25}},"StartingAfter":{"name":"starting_after","in":"query","description":"Continue after this object handle, walking backwards in time. Page depth costs nothing,\nbecause the cursor is a row position rather than an offset.\n","schema":{"type":"string"}},"EndingBefore":{"name":"ending_before","in":"query","description":"Continue before this object handle, walking forwards in time. Pass one cursor or the other,\nnever both.\n","schema":{"type":"string"}},"ProjectQuery":{"name":"project","in":"query","required":true,"description":"The project to read, as a `prj_…` handle or its uuid.","schema":{"$ref":"#/components/schemas/ProjectRef"}},"ContactPath":{"name":"contact","in":"path","required":true,"description":"A `con_…` handle, or the contact's uuid.","schema":{"$ref":"#/components/schemas/ContactRef"}},"BroadcastPath":{"name":"broadcast","in":"path","required":true,"description":"A `bcd_…` handle, or the broadcast's uuid.","schema":{"$ref":"#/components/schemas/BroadcastRef"}},"IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":false,"description":"Makes a retry safe. The first use stores the response for 24 hours. A replay with the same\nbody returns that stored response verbatim plus `Idempotent-Replayed: true`. The same key\nwith a different body is a 409, because answering a different request from cache is exactly\nthe bug this header exists to prevent. A key longer than 255 characters is a 400\n(`idempotency_key_too_long`).\n\n**Only a 2xx is ever stored.** Every error stays retryable with the same key, not just a\n5xx: a 429 carries its own `Retry-After`, and a `403 insufficient_scope` reflects the key's\nmutable configuration. Freezing either for 24 hours would turn a transient refusal into a\npermanent one.\n\nThe query string is part of the fingerprint, so `DELETE /contacts/{id}` and\n`DELETE /contacts/{id}?erase=true` are two different requests.\n","schema":{"type":"string","maxLength":255}}},"responses":{"BadRequest":{"description":"A parameter was missing or malformed. Every operation can answer this, not only the ones\nthat take filters: passing an array where a scalar belongs (`?status[]=x`) and an\nover-long `Idempotency-Key` are both refused here rather than becoming a 500.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"Unauthorized":{"description":"No key, or a key we do not recognise.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"Forbidden":{"description":"The key is valid but is not allowed to do this, usually a missing scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"NotFound":{"description":"No such object. A key that does not cover a project answers 404 rather than 403 for\neverything inside it, because a 403 would confirm the id exists.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"IdempotencyConflict":{"description":"The `Idempotency-Key` was reused with a different request body, or a request carrying it is\nstill in flight.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"StateConflict":{"description":"The object is not in a state that allows this, `code: broadcast_state_conflict`. The message\nnames its current state. Nothing was changed.\n","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"ValidationFailed":{"description":"The body did not validate. `errors` carries the per-field detail.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"RateLimited":{"description":"Too many requests, `code: rate_limit_exceeded`. Limits are per workspace, per minute, and\nset by plan: 60 on Free, 300 on Collect and Launch, 1000 on Grow. Wait the number of\nseconds in `Retry-After` rather than retrying on a fixed delay.\n","headers":{"Retry-After":{"description":"Seconds to wait before retrying. This is the one to sleep on. Sent only on a 429.\n","schema":{"type":"integer"}},"RateLimit-Limit":{"description":"Requests allowed in the window. Sent on every response.","schema":{"type":"integer"}},"RateLimit-Remaining":{"description":"Requests left in the window. Sent on every response.","schema":{"type":"integer"}},"RateLimit-Reset":{"description":"⚠️ An **absolute Unix timestamp** (seconds since the epoch) for when the window\nrolls over, not a duration. Sent only on a 429. Sleeping for this value rather\nthan for `Retry-After` waits decades.\n","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"schemas":{"ContactHandle":{"type":"string","description":"A contact's public handle: the type prefix plus 12 characters drawn from an unambiguous\nalphabet (`23456789abcdefghjkmnpqrstuvwxyz`), so `0`, `1`, `o`, `l` and `i` never appear in\none and a handle survives being read aloud.\n","pattern":"^con_[23456789abcdefghjkmnpqrstuvwxyz]+$","examples":["con_7kq3mxrz9dnp"]},"ContactRef":{"type":"string","description":"A `con_…` handle, or the contact's uuid. Path lookups accept either. Note that the\ninvitation `contact` query filter is narrower and matches the handle only.\n","examples":["con_7kq3mxrz9dnp"]},"ProjectRef":{"type":"string","description":"A `prj_…` handle, or the project's uuid.","examples":["prj_8fk2xr7pqmvd"]},"TimeRange":{"type":"object","description":"An inclusive lower and upper bound. Any format PHP can parse, ISO 8601 preferred.","properties":{"gte":{"type":"string"},"lte":{"type":"string"}},"additionalProperties":false},"ListEnvelope":{"type":"object","description":"Every list answers this shape. There is deliberately no total and no page count: both cost\na scan, and this API is built to stay fast at a million rows.\n","required":["object","url","has_more","data"],"properties":{"object":{"const":"list"},"url":{"type":"string","description":"The path this page came from."},"has_more":{"type":"boolean","description":"Whether another page exists in the direction you were walking."},"data":{"type":"array","items":{"type":"object"}}}},"ErrorEnvelope":{"type":"object","description":"The one error shape for the whole surface, from a validation failure to a 500. Parse this\nand you have parsed every failure mode.\n","required":["error"],"properties":{"error":{"type":"object","required":["type","code","message"],"properties":{"type":{"type":"string","enum":["invalid_request_error","authentication_error","permission_error","not_found_error","rate_limit_error","idempotency_error","api_error"]},"code":{"type":"string","description":"The machine-readable reason, for example `parameter_invalid`."},"message":{"type":"string","description":"A sentence you can show a developer. Never show it to an end user."},"param":{"type":"string","description":"Which parameter caused it, when one did."},"errors":{"type":"object","description":"Per-field validation messages, when the failure was a validation failure.","additionalProperties":{"type":"array","items":{"type":"string"}}},"request_id":{"type":"string","description":"Also on the `Request-Id` header of every response. Quote it in support.","examples":["req_01k2p8w3q6z9y0abcdefghijk"]}}}}},"ContactStatus":{"type":"string","description":"⚠️ `verified` means **subscribed**, and it is what campaign sending reads. Proof of the\nidentity is the separate `verified_at` timestamp. `blocked` is set by the fraud and trust\nmachinery, not by anything a caller sends.\n","enum":["pending","verified","bounced","unsubscribed","blocked"]},"Contact":{"type":"object","description":"A person in the audience.\n\nTwo rules this shape enforces, both deliberate. `trust_tier` is published but the score and\nthe signals behind it never are, because publishing the scoring detail teaches spam what to\ncalibrate against. And when a workspace is over its plan cap the overflow lock withholds\nidentity from the payload here exactly as it does in the dashboard, with `locked: true`\nsaying so. Nothing is deleted, and it all returns the moment the plan covers it.\n","properties":{"object":{"const":"contact"},"id":{"$ref":"#/components/schemas/ContactHandle"},"livemode":{"type":"boolean","description":"False for a contact captured in the Test Audience sandbox, which is test mode on the\nlive page. This is not `api_key.mode`, which has only a live plane: a test contact is\ncaptured by an ordinary live key like any other.\n"},"project":{"$ref":"#/components/schemas/ProjectRef"},"identifier":{"type":["string","null"],"description":"The identity itself. Null while locked."},"identifier_type":{"type":["string","null"],"description":"Which identity axis this contact is deduped on. Email is never special-cased:\nphone-only, username-only and wallet-only lists are all first-class.\n","enum":["email","phone","username","wallet","custom",null]},"email":{"type":["string","null"],"format":"email","description":"The address this contact is mailed at, whatever identifies them. Equal to\n`identifier` when `identifier_type` is `email`. For any other identity it is the\naddress the form collected beside it, or null when none was collected. Null while\nlocked.\n"},"external_id":{"type":["string","null"],"description":"Your own id for this person. Unique within a project."},"attributes":{"type":"object","description":"Everything the form collected, plus anything you have merged since.","additionalProperties":true},"status":{"$ref":"#/components/schemas/ContactStatus"},"stage":{"type":["string","null"],"description":"A pipeline stage key configured on the project."},"deliverability":{"type":["string","null"],"description":"What address validation established, and it is **null until the verdict has been\nrevealed** for that contact. Expect null on most reads.\n\nWe run the paid check ourselves on every address we are about to mail, on every tier\nincluding Free, because our shared sending reputation should not depend on a\ncustomer's billing choice. What a credit buys is the reveal, not the check, so this\nfield carries a value only where one has been unlocked.\n\nA verdict we did not establish is `unknown`, never `deliverable`. Only\n`undeliverable` and `disposable` ever withhold a send.\n","enum":["unknown","deliverable","risky","undeliverable","disposable","role",null]},"trust_tier":{"type":["string","null"],"description":"The real-versus-fake verdict. The score and the signals behind it are never\npublished: printing the scoring detail teaches spam what to calibrate against.\n","enum":["verified","valid","unknown","risky","fake",null]},"position":{"type":["integer","null"],"description":"Live leaderboard rank including the founder's head start. Null when unranked."},"referral":{"type":["object","null"],"description":"Null while locked.","properties":{"code":{"type":["string","null"]},"url":{"type":["string","null"],"format":"uri"},"count":{"type":"integer"},"referred_by":{"type":["string","null"]},"state":{"type":["string","null"],"description":"Whether the referral that brought this person in has been credited. Null when\nnobody referred them. Otherwise `pending_verification`, `credited`, or a\n`skipped:` value carrying the reason the credit was withheld, for example\n`skipped:self_referral`. Match on the prefix, not the whole string.\n","examples":["credited"]}}},"tags":{"type":"array","description":"Tag names currently applied to this contact, on `GET /contacts` and `GET /contacts/{id}`\nonly (other Contact-shaped responses omit this field rather than paying for the join).\n","items":{"type":"string"}},"unsubscribed":{"type":"boolean"},"locked":{"type":"boolean","description":"True when the workspace is over its plan's contact cap and this contact falls in the\noverflow. Capture is never refused, so this is what over-cap looks like instead.\n"},"verified_at":{"type":["string","null"],"format":"date-time","description":"Proof of the identity only. Whether they are subscribed is `status`, and that is what\ncampaign sending reads.\n"},"opt_in_confirmed_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":["string","null"],"format":"date-time"},"url":{"type":"string"}}},"ContactCreate":{"type":"object","required":["project"],"description":"Give an identity: `email`, `phone`, or the generic `identifier` with its\n`identifier_type`. The first two are sugar over the third.\n\nAt least one is required. Send more than one and they are not refused: `email` wins, then\n`phone`, then `identifier`. Send exactly one and there is nothing to reason about.\n\nThe one exception is a form identified by something other than an email. There, `email`\nsent beside `phone` or `identifier` is not an identity: it is the address the contact is\nmailed at, stored as the contact's `email` when they have none. It never replaces an\naddress already on file, so retrying the call changes nothing: use\n`PATCH /v1/contacts/{contact}` to change one. On a form identified by an email, the\ncontact's `email` always equals its identifier.\n","properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"form":{"type":"string","description":"The capture target. Defaults to the project's oldest active waitlist form.\n","maxLength":64},"email":{"type":"string","format":"email","maxLength":255},"phone":{"type":"string","maxLength":32},"identifier":{"type":"string","maxLength":255},"identifier_type":{"type":"string","enum":["email","phone","username","wallet","custom"],"description":"Required whenever you send `identifier`, and rejected if it is not one of these.\n\n⚠️ It validates your input but does not choose the stored type: the identity value is\nfed to the target form's own identity field, so the `identifier_type` that comes back\non the contact is the one that field implies. Send an `identifier` the form can\naccept rather than expecting this to convert it.\n"},"attributes":{"type":"object","maxProperties":50,"description":"Keys that match the form's own schema ride through its validation. Everything else is\nmerged onto the contact afterwards, so nothing you send is silently dropped.\n","additionalProperties":true},"referred_by":{"type":"string","maxLength":64,"description":"The referral code that sent them, so credit lands where it belongs."},"external_id":{"type":"string","maxLength":255}}},"ContactUpdate":{"type":"object","properties":{"stage":{"type":"string","maxLength":64,"description":"Must be one of the project's own configured pipeline stages."},"attributes":{"type":"object","maxProperties":50,"description":"Merged by key. Send a key with `null` to delete it.","additionalProperties":true},"email":{"type":["string","null"],"format":"email","maxLength":255,"description":"The address this contact is mailed at. Set, change or clear it (null) on a contact\nidentified by something other than an email. Stored canonicalized. Ignored when\n`identifier_type` is `email`: there the address is the identifier, and identity is\nnot edited here.\n\nChanging or clearing an address the contact already has resets what was known\nabout the old one: `verified_at` becomes null and `deliverability` returns to\n`unknown`. `status` is left as it is. Setting an address for the first time resets\nnothing.\n"},"external_id":{"type":["string","null"],"maxLength":255,"description":"Null clears it."},"trust_override":{"type":["string","null"],"description":"Pin the trust verdict by hand. Null returns it to the derived value. Anything outside\nthis set is a 422.\n","enum":["verified","valid","unknown","risky","fake",null]}}},"ContactCount":{"type":"object","properties":{"object":{"const":"contact_count"},"project":{"$ref":"#/components/schemas/ProjectRef"},"total":{"type":"integer"},"flagged":{"type":"integer"},"status":{"type":"object","description":"Count per status.","additionalProperties":{"type":"integer"}},"stage":{"type":"object","description":"Count per pipeline stage key.","additionalProperties":{"type":"integer"}}}},"Position":{"type":"object","properties":{"object":{"const":"position"},"contact":{"$ref":"#/components/schemas/ContactHandle"},"position":{"type":["integer","null"]},"to_first":{"type":["integer","null"],"description":"Referrals needed to reach first place. Zero when already first."},"next_jump":{"type":["integer","null"],"description":"How many places one more referral moves them right now."}}},"Submission":{"type":"object","description":"One append-only form response. It carries no id: submissions have no public handle in this\nversion of the API, and emitting the raw uuid would break the ids-are-handles rule.\n","properties":{"object":{"const":"submission"},"form":{"type":["string","null"]},"data":{"type":"object","description":"What was submitted. Empty while the owning contact is locked.","additionalProperties":true},"source":{"type":["string","null"]},"locked":{"type":"boolean"},"created_at":{"type":["string","null"],"format":"date-time"}}},"Email":{"type":"object","description":"One email sent, or queued, to one contact.","properties":{"object":{"const":"email"},"id":{"type":"string","description":"The `msg_…` handle. Use it to page this list."},"source":{"type":"object","description":"What sent it.","properties":{"type":{"type":"string","enum":["broadcast","automation","lifecycle","reward"],"description":"`lifecycle` is a system email (a confirmation, an invitation, a welcome). `reward` announces\na referral reward they earned.\n"},"id":{"type":["string","null"],"description":"The `bcd_…` broadcast or `aut_…` automation handle. Null for other sources."},"name":{"type":["string","null"],"description":"The broadcast or automation name, or the system email's name."},"kind":{"type":["string","null"],"enum":["verification","invitation","welcome","status_link",null],"description":"Which system email, for a `lifecycle` source. Null otherwise."}}},"subject":{"type":["string","null"],"description":"The subject as this person received it. Null until the email is rendered for sending,\nand while the contact is locked.\n"},"status":{"type":"string","enum":["queued","sent","delivered","bounced","complained","suppressed","failed","canceled"],"description":"`sent` means the email provider accepted it and `delivered` that the receiving server did.\n`suppressed` means we held it back (they unsubscribed or bounced before it went out).\n`failed` means it could not be handed to the provider. `canceled` means the broadcast\nwas canceled before it reached them.\n"},"unsubscribed":{"type":["boolean","null"],"description":"Whether they unsubscribed using this email's link and are still unsubscribed. Only known\nfor broadcasts; null for every other source.\n"},"created_at":{"type":["string","null"],"format":"date-time","description":"When it was queued."},"sent_at":{"type":["string","null"],"format":"date-time"},"delivered_at":{"type":["string","null"],"format":"date-time"}}},"InvitationStatus":{"type":"string","description":"⚠️ This is a stored column, and lapsing is not instant: expiry is decided from `expires_at`\nat the moment a code is presented, while the column is moved to `expired` by a sweep that\nruns on a schedule. So an invitation past its `expires_at` can still read `pending` for a\nwhile, and it will already be refused if anyone tries to redeem it.\n\nTreat `expires_at` as the truth about whether a code is still good, and this field as the\nbookkeeping. Filtering `status=expired` under-counts by exactly that window.\n","enum":["pending","redeemed","expired","revoked","exhausted"]},"InvitationSource":{"type":"string","description":"How the invitation came into existence. Dashboard-issued invitations are `manual`; there is\nno `dashboard` value.\n","enum":["manual","bulk","automation","api","rule","import"]},"InvitationDeliveryStatus":{"type":"string","description":"What happened to the invitation email, when one was sent.","enum":["sent","bounced","complained"]},"InvitationKind":{"type":"string","enum":["personal","shared","open"],"description":"`personal` is bound to one contact. `shared` is one code with seats. `open` is a link\nanyone holding it can use.\n"},"Invitation":{"type":"object","description":"The code is included on purpose. It is the whole point of the push and reconcile channels:\nyour server writes it to your own allowlist and then never has to ask us anything at signup\ntime.\n","properties":{"object":{"const":"invitation"},"id":{"type":"string","description":"The invitation's public handle.","examples":["inv_9phm4rtx2kqd"]},"code":{"type":["string","null"]},"kind":{"$ref":"#/components/schemas/InvitationKind"},"status":{"$ref":"#/components/schemas/InvitationStatus"},"project":{"$ref":"#/components/schemas/ProjectRef"},"contact":{"type":["string","null"]},"batch":{"type":["string","null"]},"max_uses":{"type":["integer","null"]},"used_count":{"type":"integer"},"seats_remaining":{"type":["integer","null"]},"allowed_domains":{"type":["array","null"],"items":{"type":"string"}},"delivery_status":{"oneOf":[{"$ref":"#/components/schemas/InvitationDeliveryStatus"},{"type":"null"}]},"source":{"$ref":"#/components/schemas/InvitationSource"},"metadata":{"type":["object","null"],"additionalProperties":true},"expires_at":{"type":["string","null"],"format":"date-time"},"revoked_at":{"type":["string","null"],"format":"date-time"},"revoked_reason":{"type":["string","null"]},"first_redeemed_at":{"type":["string","null"],"format":"date-time"},"last_redeemed_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":["string","null"],"format":"date-time"},"updated_at":{"type":["string","null"],"format":"date-time"}}},"InvitationCreate":{"type":"object","required":["project"],"description":"`project` is the only field required on every request. What else you must send depends on\n`kind`, and the API does not express that as a schema constraint:\n\n* `personal` (the default) needs **`contact` or `identity`**. A request carrying neither\n  answers `422` with `param: contact`.\n* `shared` needs **`seats`**, or it is a 422.\n* `open` needs **`expires_at`**, unless the project carries a default invite expiry. An open\n  link that never expires is refused: that URL ends up in a Slack channel and a screenshot.\n","properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"kind":{"$ref":"#/components/schemas/InvitationKind"},"contact":{"type":"string","description":"For a personal invitation, the contact's handle. Send this or `identity`.\n","maxLength":255},"identity":{"type":"string","description":"For a personal invitation, the contact's identity instead of their handle. The\ncontact must already exist on the project; this does not create one.\n","maxLength":255},"seats":{"type":["integer","null"],"minimum":1,"maximum":100000,"description":"Required for `kind: shared`, and meaningless on the other kinds."},"expires_at":{"type":["string","null"],"format":"date-time","description":"Required for `kind: open` unless the project sets a default invite expiry.\n"},"allowed_domains":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":253},"description":"Lower-cased and trimmed on the way in. Needs Launch or Grow."},"code":{"type":"string","description":"Bring your own code string. It has to clear the entropy floor, and a code that does not\nis refused with the reason rather than quietly accepted. A string already in use on the\nproject is a 422. Needs Launch or Grow.\n"},"metadata":{"type":"object","maxProperties":50,"description":"Passthrough, under 4 KB. It rides in every lookup and every webhook payload.","additionalProperties":true}}},"InvitationRedeem":{"type":"object","required":["project","code","identity"],"description":"Code and identity are required together. The code is the credential, and the identity is\nboth who is being let in and the idempotency key, which is what stops a leaked code being\nredeemed on somebody else's behalf.\n","properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"code":{"type":"string"},"identity":{"type":"string","maxLength":255,"description":"`email` is accepted as a synonym."},"external_id":{"type":["string","null"],"maxLength":255},"metadata":{"type":"object","maxProperties":50,"additionalProperties":true}}},"InvitationConfirm":{"type":"object","required":["project","identity"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"identity":{"type":"string","maxLength":255,"description":"`email` is accepted as a synonym."},"external_id":{"type":["string","null"],"maxLength":255},"metadata":{"type":"object","maxProperties":50,"additionalProperties":true}}},"InvitationRedemption":{"type":"object","properties":{"object":{"const":"invitation_redemption"},"id":{"type":"string","description":"The redemption's id. ⚠️ This one is a raw uuid, not a `…_` handle: redemptions have no\npublic handle in this version. Store it as an opaque string and do not parse it.\n"},"replayed":{"type":"boolean","description":"True when this call replayed an earlier redemption rather than making one."},"invitation":{"$ref":"#/components/schemas/Invitation"},"contact":{"type":["string","null"]},"identity":{"type":["string","null"]},"external_id":{"type":["string","null"]},"seats_remaining":{"type":["integer","null"]},"metadata":{"type":["object","null"],"additionalProperties":true},"redeemed_at":{"type":["string","null"],"format":"date-time"}}},"InvitationConfirmation":{"type":"object","properties":{"object":{"const":"invitation_confirmation"},"id":{"type":"string","description":"The redemption's id. ⚠️ A raw uuid, not a `…_` handle, for the same reason as on\n`invitation_redemption`. Opaque string; do not parse it.\n"},"replayed":{"type":"boolean"},"channel":{"type":["string","null"],"description":"Always the confirmed channel, so your assertion is never shown as our check."},"invitation":{"$ref":"#/components/schemas/Invitation"},"contact":{"type":["string","null"]},"identity":{"type":["string","null"]},"external_id":{"type":["string","null"]},"metadata":{"type":["object","null"],"additionalProperties":true},"confirmed_at":{"type":["string","null"],"format":"date-time"}}},"InvitationCheck":{"type":"object","description":"The answer to a dry run. Nothing was consumed and nothing was recorded.","properties":{"object":{"const":"invitation_check"},"redeemable":{"type":"boolean"},"invitation":{"oneOf":[{"$ref":"#/components/schemas/Invitation"},{"type":"null"}]}}},"InvitationHandoff":{"type":"object","description":"The claims behind a claim reference.","properties":{"object":{"const":"invitation_handoff"},"v":{"type":"integer"},"iss":{"type":"string"},"aud":{"type":["string","null"]},"jti":{"type":"string"},"iat":{"type":"integer"},"exp":{"type":"integer"},"project":{"type":["string","null"]},"invitation":{"type":["string","null"]},"code":{"type":["string","null"]},"contact":{"type":["string","null"]},"identity":{"type":["string","null"]},"external_id":{"type":["string","null"]}}},"ImportRef":{"type":"string","description":"An `imp_…` handle, or the import's uuid.","examples":["imp_9phm4rtx2kqd"]},"ImportStatus":{"type":"string","description":"`mapping` never appears here — only a CSV upload through the dashboard wizard passes\nthrough it. An API-created import starts at `processing`.\n","enum":["mapping","processing","completed","failed"]},"ImportContact":{"type":"object","description":"One row to import. Needs `email`, `phone`, or `identifier` + `identifier_type`.","properties":{"email":{"type":["string","null"],"format":"email","maxLength":255},"phone":{"type":["string","null"],"maxLength":32},"identifier":{"type":["string","null"],"description":"An identity value when you are not sending `email`/`phone` directly.","maxLength":255},"identifier_type":{"type":["string","null"],"description":"Required when `identifier` is sent. The importer has no identity kinds beyond these two.","enum":["email","phone",null]},"name":{"type":["string","null"],"maxLength":255},"stage":{"type":["string","null"],"description":"A stage key from this project's own pipeline. Blank lands on the entry stage; the invited stage is refused (it needs a real invitation code this path cannot mint)."},"attributes":{"type":["object","null"],"description":"Custom fields, up to 50 keys. Anything not recognized as a core field lands here.","additionalProperties":true}}},"ImportCreate":{"type":"object","required":["project","contacts"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"contacts":{"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/components/schemas/ImportContact"}},"duplicates":{"type":"string","description":"`skip` (default) leaves a matching existing contact untouched; `update` merges the row onto them.","enum":["skip","update"]},"status":{"type":"string","description":"`subscribed` (default, matching the dashboard mapping step) attests this list already\nopted in and marks every row reachable by email. `unconfirmed` stores the rows without\nthat attestation — nothing is mailed until they are verified some other way.\n","enum":["subscribed","unconfirmed"]},"tags":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":60},"description":"Tag names to apply to every row this call creates or updates. Created in the project by name if missing."}}},"ImportRejectedRow":{"type":"object","description":"One row the import could not use.","properties":{"row":{"type":["integer","null"],"description":"The row's 1-based position in the `contacts` array you sent. Null for a CSV-originated import."},"identifier":{"type":["string","null"]},"reason":{"type":["string","null"]}}},"Import":{"type":"object","description":"Never carries anything from the deliverability screening a large import triggers\nafterward — only validation/dedupe outcomes, the same ones the dashboard's own failure\nreport shows.\n","properties":{"object":{"const":"import"},"id":{"$ref":"#/components/schemas/ImportRef"},"project":{"$ref":"#/components/schemas/ProjectRef"},"status":{"$ref":"#/components/schemas/ImportStatus"},"row_count":{"type":["integer","null"]},"imported_count":{"type":"integer"},"updated_count":{"type":"integer"},"skipped_count":{"type":"integer"},"invalid_count":{"type":"integer"},"error":{"type":["string","null"]},"rejected":{"type":"array","description":"Only present on `GET /v1/imports/{import}` — up to 100 rejected rows.","items":{"$ref":"#/components/schemas/ImportRejectedRow"}},"report_url":{"type":["string","null"],"format":"uri","description":"Only present on `GET /v1/imports/{import}`. A signed link to the full reject CSV, valid for 15 minutes. Null when nothing was rejected."},"completed_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":["string","null"],"format":"date-time"}}},"AutomationRef":{"type":"string","description":"An `aut_…` handle, or the automation's uuid.","examples":["aut_4kq2mrpxv9nd"]},"AutomationStep":{"type":"object","description":"One node in the canvas graph — read-only, human-labelled.","properties":{"node_id":{"type":"string"},"type":{"type":"string","enum":["trigger","wait","send_email","add_tag","change_stage","add_to_segment","webhook","branch","split","goal"]},"label":{"type":"string","description":"A human summary, e.g. \"Send: Welcome email\" or \"If Has a tag: VIP\" — never the raw\ninternal id a tag/segment/template/broadcast reference is actually stored as.\n"},"refs":{"type":["object","null"],"description":"The public handle(s) of anything this step references, keyed by kind (`tag`,\n`segment`, `template`, `broadcasts`). Only present when the step references\nsomething that still exists.\n","additionalProperties":true}}},"Automation":{"type":"object","properties":{"object":{"const":"automation"},"id":{"$ref":"#/components/schemas/AutomationRef"},"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string"},"status":{"type":"string","enum":["draft","active","paused","archived"]},"display_status":{"type":"string","description":"The stored status, except a live launch-day flow still waiting for its moment reads\nas `scheduled`.\n","enum":["draft","active","paused","archived","scheduled"]},"trigger_label":{"type":"string"},"enrolled_count":{"type":"integer"},"completed_count":{"type":"integer"},"sent_count":{"type":"integer"},"delivered_count":{"type":"integer"},"bounced_count":{"type":"integer"},"steps":{"type":"array","description":"Only present on `GET /v1/automations/{automation}`.","items":{"$ref":"#/components/schemas/AutomationStep"}},"created_at":{"type":["string","null"],"format":"date-time"}}},"AutomationEnrollment":{"type":"object","description":"One contact's run through one automation.","properties":{"object":{"const":"automation_enrollment"},"automation":{"type":["object","null"],"properties":{"id":{"$ref":"#/components/schemas/AutomationRef"},"name":{"type":"string"}}},"state":{"type":"string","enum":["active","waiting","completed","exited","failed"]},"current_step":{"type":["string","null"],"description":"A human label for the step the contact is on. Null once nothing is in flight."},"resume_at":{"type":["string","null"],"format":"date-time","description":"When a waiting step resumes. Null unless `state` is `waiting`."},"enrolled_at":{"type":["string","null"],"format":"date-time"}}},"Project":{"type":"object","properties":{"object":{"const":"project"},"id":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string"},"slug":{"type":["string","null"]},"status":{"type":["string","null"],"description":"Where the project is in its own launch arc.","enum":["building","ready","launched","post_launch",null]},"archived":{"type":"boolean","description":"True once the project is archived, which closes it to signups and mail."},"page_url":{"type":["string","null"],"format":"uri"},"created_at":{"type":["string","null"],"format":"date-time"},"url":{"type":"string"}}},"Form":{"type":"object","properties":{"object":{"const":"form"},"id":{"type":"string","examples":["frm_2b7ctgd4aejh"]},"name":{"type":"string"},"type":{"type":["string","null"],"description":"Only a `waitlist` form is a capture target for `POST /contacts`, and the default one\nis the project's oldest active form of that type.\n","enum":["waitlist","survey","marketing",null]},"status":{"type":["string","null"],"enum":["draft","active","archived",null]},"project":{"$ref":"#/components/schemas/ProjectRef"},"submit_url":{"type":"string","format":"uri","description":"The public endpoint the embed posts to. Unauthenticated on purpose, and safe to call\nfrom a browser.\n"},"created_at":{"type":["string","null"],"format":"date-time"},"url":{"type":"string"}}},"TagRef":{"type":"string","description":"A `tag_…` handle, or the tag's uuid.","examples":["tag_9mvd4rq2ph7k"]},"SegmentRef":{"type":"string","description":"A `seg_…` handle, or the segment's uuid.","examples":["seg_7qk2mn4pr8vx"]},"Tag":{"type":"object","properties":{"object":{"const":"tag"},"id":{"$ref":"#/components/schemas/TagRef"},"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string"},"color":{"type":["string","null"]},"contacts_count":{"type":"integer","description":"How many contacts currently carry this tag. Index-backed, never a scan."},"created_at":{"type":["string","null"],"format":"date-time"},"url":{"type":"string"}}},"TagCreate":{"type":"object","required":["project","name"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string","maxLength":60},"color":{"type":"string","maxLength":32}}},"TagContactsRequest":{"type":"object","description":"Exactly one of `contacts` / `segment`. Sending both, or neither, is a 422.\n","properties":{"contacts":{"type":"array","description":"Contact handles (`con_…`) or uuids, 1 to 1000. Mutually exclusive with `segment`.","items":{"type":"string"},"minItems":1,"maxItems":1000},"segment":{"$ref":"#/components/schemas/SegmentRef"},"limit":{"type":"integer","description":"With `segment`, apply to only the oldest N matches, ordered by signup date. Omit to\napply to everyone the segment currently matches (still capped at 1000).\n","minimum":1,"maximum":1000}}},"TagApplyResult":{"type":"object","properties":{"object":{"const":"tag_apply_result"},"tag":{"$ref":"#/components/schemas/Tag"},"matched":{"type":"integer","description":"How many contacts the request resolved to, before applying anything."},"attached":{"type":"integer","description":"Present on the add call. How many newly gained the tag."},"detached":{"type":"integer","description":"Present on the remove call. How many lost the tag."}}},"SegmentRules":{"type":"object","description":"A condition tree: `{ match: \"and\"|\"or\", conditions: [...] }`. Each condition is either a\nnested group (the same shape, up to 5 levels deep) or a leaf\n`{ field, operator, value }` (the `attribute` field also carries `key`; `received_broadcast`\nalso carries an optional `days`). An empty or omitted tree matches everyone.\n\n`POST /segments` and `POST /segments/preview` both validate the tree and refuse (`422`)\non an unknown field, an operator illegal for its field, or a malformed value — a typo\nnever silently widens the match.\n\nFields and their legal operators, as of this document (the source of truth is\n`App\\Enums\\SegmentField`, which may grow):\n\n* `status`, `trust_tier`, `deliverability`, `stage`, `invite_state`, `identifier_type`,\n  `first_source`, `country`, `device`, `browser`, `os`, `intent_cluster` — `eq`, `neq`,\n  `in`, `not_in`. `value` is a string (`eq`/`neq`) or a string array (`in`/`not_in`).\n* `referral_count`, `quality_score` — `gt`, `gte`, `lt`, `lte` (numeric `value`), or\n  `between` (`value` is `[min, max]`).\n* `created_at`, `verified_at` — the same comparisons, plus `within_last_days` (integer\n  `value`) and `exists` (no `value`). Dates are any format PHP can parse, ISO 8601\n  preferred.\n* `submission_count` — `eq`, `gt`, `gte`, `lt`, `lte` (numeric `value`).\n* `tag` — `in` / `not_in`, where `value` is an array of `tag_…` handles (from\n  `GET /v1/tags`), or `exists` (has any tag at all, no `value`).\n* `received_broadcast` — `in` / `not_in`, where `value` is an array of 1-50 `bcd_…`\n  broadcast handles (all must belong to this project) and an optional `days` (integer,\n  1-3650) means \"sent at least that many days ago\". `in` matches someone who received\n  any of them; `not_in` matches someone who received none. \"Received\" excludes a send\n  that was suppressed or never reached the provider.\n* `is_referrer`, `is_referred` — `is_true` / `is_false`, no `value`.\n* `utm_source`, `utm_medium`, `utm_campaign` — `eq`, `neq`, `in`, `contains`, `exists`.\n* `attribute` — a captured custom field. Needs `key` (letters, digits, `_`, `.` only)\n  alongside `field`/`operator`/`value`. Operators: `eq`, `neq`, `contains`, `exists`,\n  `not_exists`, `in`.\n\nA `deliverability` condition only ever sees verdicts the workspace has paid to reveal —\nsee `Contact.deliverability`. Every id-shaped `value` in this document is always a\nhandle, never a raw uuid, including inside `tag` and `received_broadcast` — a segment\nyou read back never carries an internal id either.\n","properties":{"match":{"type":"string","enum":["and","or"]},"conditions":{"type":"array","items":{"type":"object"}}},"required":["match","conditions"]},"Segment":{"type":"object","properties":{"object":{"const":"segment"},"id":{"$ref":"#/components/schemas/SegmentRef"},"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string"},"description":{"type":["string","null"]},"type":{"type":"string","enum":["dynamic","static","ai"]},"is_system":{"type":"boolean","description":"A built-in segment (Everyone, Verified, …). Cannot be edited or deleted."},"pinned":{"type":"boolean"},"icon":{"type":["string","null"]},"color":{"type":["string","null"]},"rules":{"$ref":"#/components/schemas/SegmentRules"},"count":{"type":["integer","null"],"description":"The live matching count, computed fresh. `null` only when it genuinely could not be\ncomputed — never a false zero.\n"},"created_at":{"type":["string","null"],"format":"date-time"},"url":{"type":"string"}}},"SegmentCreate":{"type":"object","required":["project","name","rules"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string","maxLength":120},"description":{"type":"string","maxLength":500},"pinned":{"type":"boolean"},"icon":{"type":"string","maxLength":64},"color":{"type":"string","maxLength":32},"rules":{"$ref":"#/components/schemas/SegmentRules"}}},"SegmentPreviewRequest":{"type":"object","required":["project"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"},"rules":{"$ref":"#/components/schemas/SegmentRules"}}},"SegmentPreviewResult":{"type":"object","properties":{"object":{"const":"segment_preview"},"count":{"type":"integer"}}},"BroadcastRef":{"type":"string","description":"A `bcd_…` handle, or the broadcast's uuid.","examples":["bcd_4kq8mx2rvn7p"]},"BroadcastStatus":{"type":"string","enum":["draft","scheduled","queuing","sending","sent","paused","canceled","failed"],"description":"`queuing` is the moment between send and the first emails leaving. `failed` never sent\nanything and can be edited and sent again.\n"},"BroadcastContent":{"type":"object","description":"`text` is a plain-text email with no HTML and no tracking, the way a person writes.\n`markdown` is rendered with the project's email design. `html` is sent as given. `blocks`\nis an email designed in the dashboard: readable here as a format but not writable, and its\n`body` is null. Merge tags such as `{{first_name|there}}` work in every format.\n","required":["format","body"],"properties":{"format":{"type":"string","enum":["markdown","text","html","blocks"]},"body":{"type":["string","null"]}}},"BroadcastAudience":{"type":"object","description":"Who gets it. Only subscribed contacts are ever emailed; unsubscribed, bounced and\nunconfirmed people are skipped whatever the audience says.\n","required":["type"],"properties":{"type":{"type":"string","enum":["all","segment","tag"]},"segment":{"oneOf":[{"$ref":"#/components/schemas/SegmentRef"},{"type":"null"}],"description":"With `type` `segment`."},"tag":{"oneOf":[{"$ref":"#/components/schemas/TagRef"},{"type":"null"}],"description":"With `type` `tag`."},"exclude":{"type":"object","properties":{"segments":{"type":"array","maxItems":20,"items":{"$ref":"#/components/schemas/SegmentRef"}},"tags":{"type":"array","maxItems":20,"items":{"$ref":"#/components/schemas/TagRef"}},"broadcasts":{"type":"array","maxItems":50,"description":"Leave out anyone who received any of these broadcasts.","items":{"$ref":"#/components/schemas/BroadcastRef"}}}}}},"BroadcastDelivery":{"type":"object","description":"`all` sends to everyone at once. `batches` sends to `batch_size` people, oldest signups\nfirst, every `interval`, until everyone has it. Batches never send to anyone twice.\n","properties":{"mode":{"type":"string","enum":["all","batches"]},"batch_size":{"type":["integer","null"],"minimum":1,"maximum":10000},"interval":{"type":["string","null"],"enum":["hour","day",null]}}},"BroadcastStats":{"type":"object","description":"Counts from the send ledger. `recipients` grows batch by batch for a batched broadcast.\nOpens and clicks are not tracked and are not reported.\n","properties":{"recipients":{"type":"integer"},"sent":{"type":"integer"},"delivered":{"type":"integer"},"bounced":{"type":"integer"},"complained":{"type":"integer"},"unsubscribed":{"type":"integer"},"pending":{"type":"integer"},"failed":{"type":"integer"},"suppressed":{"type":"integer"},"canceled":{"type":"integer","description":"People a canceled broadcast never reached."},"batches":{"type":["object","null"],"description":"Null for a broadcast sent all at once.","properties":{"size":{"type":["integer","null"]},"interval":{"type":["string","null"]},"released":{"type":"integer"},"remaining":{"type":["integer","null"],"description":"People still to get it. Only while it is sending, and only when you retrieve the\nbroadcast: it is a live count of the audience, so a list of broadcasts leaves it null.\n"},"next_batch_at":{"type":["string","null"],"format":"date-time"}}}}},"Broadcast":{"type":"object","properties":{"object":{"const":"broadcast"},"id":{"$ref":"#/components/schemas/BroadcastRef"},"project":{"$ref":"#/components/schemas/ProjectRef"},"name":{"type":"string"},"status":{"$ref":"#/components/schemas/BroadcastStatus"},"subject":{"type":["string","null"]},"preheader":{"type":["string","null"]},"from_name":{"type":["string","null"]},"reply_to":{"type":["string","null"],"format":"email"},"content":{"$ref":"#/components/schemas/BroadcastContent"},"audience":{"$ref":"#/components/schemas/BroadcastAudience"},"delivery":{"$ref":"#/components/schemas/BroadcastDelivery"},"scheduled_at":{"type":["string","null"],"format":"date-time"},"sent_at":{"type":["string","null"],"format":"date-time"},"failure_reason":{"type":["string","null"],"description":"Why it failed or was paused automatically, in plain words."},"stats":{"$ref":"#/components/schemas/BroadcastStats"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"url":{"type":"string"}}},"BroadcastUpdate":{"type":"object","properties":{"name":{"type":"string","maxLength":120},"subject":{"type":["string","null"],"maxLength":200},"preheader":{"type":["string","null"],"maxLength":200},"from_name":{"type":["string","null"],"maxLength":100},"reply_to":{"type":["string","null"],"format":"email"},"content":{"type":"object","required":["format"],"properties":{"format":{"type":"string","enum":["markdown","text","html"]},"body":{"type":["string","null"]}}},"audience":{"$ref":"#/components/schemas/BroadcastAudience"},"delivery":{"$ref":"#/components/schemas/BroadcastDelivery"}}},"BroadcastCreate":{"allOf":[{"type":"object","required":["project"],"properties":{"project":{"$ref":"#/components/schemas/ProjectRef"}}},{"$ref":"#/components/schemas/BroadcastUpdate"}]},"BroadcastPreparation":{"type":"object","properties":{"object":{"const":"broadcast_preparation"},"broadcast":{"$ref":"#/components/schemas/BroadcastRef"},"ready":{"type":"boolean"},"problems":{"type":"array","items":{"type":"string"},"description":"What would stop the send, in plain words. Empty when `ready`."},"recipients":{"type":"integer","description":"Everyone it would go to."},"first_batch":{"type":["integer","null"],"description":"For a batched broadcast, how many go out the moment it is sent."},"delivery":{"$ref":"#/components/schemas/BroadcastDelivery"},"skipped":{"type":"object","description":"Who in the audience will not get it and why. `audience` equals `recipients` plus the\nother five.\n","properties":{"audience":{"type":"integer"},"unsubscribed":{"type":"integer"},"cannot_receive":{"type":"integer","description":"Bounced, complained or undeliverable, merged into one number."},"unconfirmed":{"type":"integer"},"excluded":{"type":"integer","description":"Left out by the broadcast's own exclusions."},"shared_address":{"type":"integer","description":"Contacts who share an email address with an earlier recipient. The broadcast goes to each address once."}}},"name_fallback":{"type":["object","null"],"description":"How many recipients get the fallback for each name merge tag the email uses. On a list over\n10,000 people only the first 10,000 (by signup) are counted, and `capped` says so.\n","properties":{"first_name":{"$ref":"#/components/schemas/NameFallbackCount"},"name":{"$ref":"#/components/schemas/NameFallbackCount"}}},"send_at":{"type":["string","null"],"format":"date-time","description":"The time the token is for, in UTC. Null means sending now."},"quota":{"type":"object","properties":{"limit":{"type":["integer","null"]},"used":{"type":"integer"},"remaining":{"type":["integer","null"]}}},"sample":{"type":"array","maxItems":5,"description":"The first recipients, oldest signup first, with masked addresses.","items":{"type":"object","properties":{"id":{"$ref":"#/components/schemas/ContactHandle"},"identifier":{"type":["string","null"],"examples":["ad***@example.com"]},"name":{"type":["string","null"]}}}},"confirmation_token":{"type":["string","null"],"description":"Pass to `send`. Null when not `ready`."},"tolerance":{"type":"integer","description":"How many people the audience may gain or lose before `send` refuses the token: 0 (exact)\nunder 100 recipients, 1% of them above that.\n"},"expires_at":{"type":["string","null"],"format":"date-time"}}},"NameFallbackCount":{"type":"object","properties":{"count":{"type":"integer"},"capped":{"type":"boolean","description":"True when only the first 10,000 recipients were counted."}}},"BroadcastSend":{"type":"object","properties":{"confirmation_token":{"type":"string","description":"From `prepare`. Optional here; when present it must still hold."},"send_at":{"type":"string","format":"date-time","description":"Schedule instead of sending now. ISO 8601; without an offset it is read as UTC."}}},"BroadcastRecipient":{"type":"object","properties":{"object":{"const":"broadcast_recipient"},"id":{"type":"string","description":"The `msg_…` handle. Use it to page this list."},"contact":{"$ref":"#/components/schemas/ContactHandle"},"identifier":{"type":["string","null"],"description":"The contact's address. Null while the contact is locked."},"status":{"type":"string","enum":["queued","sent","delivered","bounced","complained","suppressed","failed","canceled"]},"sent_at":{"type":["string","null"],"format":"date-time"},"delivered_at":{"type":["string","null"],"format":"date-time"}}},"Workspace":{"type":"object","description":"No workspace id is published. The key is the addressing, and a caller can never address\nanother workspace anyway.\n","properties":{"object":{"const":"workspace"},"name":{"type":"string"},"plan":{"type":"string","description":"The plan tier.","examples":["launch"]},"plan_size":{"type":"integer","description":"The number of contacts the plan holds. Paid plans are bought at a size; Free reports its\nfixed size.\n","examples":[10000]},"billing_interval":{"type":["string","null"],"enum":["monthly","yearly",null],"description":"How the subscription is billed. Null when there is no paid subscription.","examples":["monthly"]},"complimentary":{"type":"boolean","description":"True when the plan is given rather than sold. A complimentary plan has no subscription,\nso its `billing_interval` is null.\n","examples":[false]},"limits":{"type":"object","properties":{"contacts":{"type":["integer","null"]},"api_rate":{"type":"integer","description":"Requests per minute, per workspace rather than per key."}}},"usage":{"type":"object","properties":{"contacts":{"type":"integer"}}},"api_key":{"type":"object","properties":{"name":{"type":"string"},"mode":{"type":"string","description":"The data plane this key operates on. There is only a live plane, so the value\nis always `live`. It stays an enum rather than being dropped because a real\ntest plane can be added later without a client that already reads this field\nneeding to change.\n","enum":["live"]},"scopes":{"type":"array","items":{"type":"string","enum":["contacts:read","contacts:write","projects:read","pages:read","pages:write","invites:write","broadcasts:read","broadcasts:write","broadcasts:send","segments:read","segments:write","imports:write","automations:read"]}},"project":{"type":["string","null"]},"created_at":{"type":["string","null"],"format":"date-time"}}}}}}}}