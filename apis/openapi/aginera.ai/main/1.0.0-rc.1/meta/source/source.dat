:["trade","label","confidence"]},"access":{"type":"string","enum":["purchased","unlocked","free"],"description":"purchased = the $2 CAD file was bought for this document; unlocked = a paid plan (no gate); free = free tier (DXF watermarked, DWG needs the purchase)."},"paid":{"type":"boolean","description":"The cad_dwg purchase exists for this document."},"pricing":{"type":"object","properties":{"mode":{"type":"string","enum":["dwg_paid","first_sheet_free"]},"dxf":{"type":"object","properties":{"price_usd":{"type":"number"},"watermarked":{"type":"boolean"},"note":{"type":"string"}},"required":["price_usd","watermarked","note"]},"dwg":{"type":"object","properties":{"usd_cents":{"type":"integer"},"price_usd":{"type":"number"},"credits":{"type":"integer"},"purchase_required":{"type":"boolean"},"note":{"type":"string"}},"required":["usd_cents","price_usd","credits","purchase_required","note"]},"local_currency_note":{"type":"string"}},"required":["mode","dxf","dwg","local_currency_note"]},"size":{"type":"object","properties":{"min_dxf_mb":{"type":["number","null"]},"free_size_exceeded":{"type":"boolean"}},"required":["min_dxf_mb","free_size_exceeded"]},"next_step":{"type":"string"}},"required":["document_id","filename","convertible","reason","page_count","scan_traced","trade_hint","access","paid","pricing","size","next_step"]},"CadFormat":{"type":"string","enum":["dxf","dwg"],"description":"Format actually delivered (a DWG may fall back to DXF if the DWG writer is unavailable)."},"CadFileResult":{"oneOf":[{"type":"object","properties":{"status":{"type":"string","enum":["ready"]},"document_id":{"$ref":"#/components/schemas/DocumentId"},"format":{"$ref":"#/components/schemas/CadFormat"},"requested_format":{"$ref":"#/components/schemas/CadFormat"},"filename":{"type":"string"},"bytes":{"type":"integer"},"watermarked":{"type":["boolean","null"],"description":"The free file carries an aginera.ai watermark; null when the server did not say."},"paid_with_credits":{"type":"object",