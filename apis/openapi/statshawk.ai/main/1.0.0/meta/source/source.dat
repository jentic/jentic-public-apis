    "/v1/competitions/{comp}/editions/{year}/standings/{table}": {
      "get": {
        "tags": [
          "Competitions"
        ],
        "summary": "GET /v1/competitions/{comp}/editions/{year}/standings/{table} — one standings table,\nuniform across the MatchRecord and PointsRank kinds (standings registry spec §6). The\ntwo legacy endpoints above stay byte-identical; this is additive. table is a registered\nslug from GET.../capabilities's standings list (\"league\" for a Match-shaped sport,\n\"drivers\" / \"constructors\" for racing) — a slug the sport doesn't register 404s.",
        "operationId": "get_v1_competitions_comp_editions_year_standings_table",
        "parameters": [
          {
            "name": "comp",
            "in": "path",
            "description": "Competition slug (`nba`, `mlb`, `epl`, …)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "description": "Season start year (e.g. `2026`) — cross-year leagues (NBA/NHL/NCAA) use the year the season STARTS in (2025 = the 2025-26 season)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "description": "Registered standings table slug (`league` | `drivers` | `constructors` — see `GET.../capabilities`'s `standings` list)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The standings table, kind-tagged: `match_record` (byte-identical rows to the legacy standings endpoints) or `points_rank` (an accumulated-points ranking — racing's drivers'/constructors' championships)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStandingsTable"
