            ]
          },
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OddsPeriod"
            }
          },
          "subject": {
            "$ref": "#/components/schemas/OddsSubjectKind"
          }
        }
      },
      "OddsMarketKind": {
        "type": "string",
        "description": "The shape of a posted market. Sport catalogs declare which of these\na sport can carry; a book adapter maps wire types onto this set.",
        "enum": [
          "h2h",
          "spreads",
          "totals",
          "team_total",
          "player_prop"
        ]
      },
