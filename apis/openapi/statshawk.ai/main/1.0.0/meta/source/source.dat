      "InjuryEventKind": {
        "type": "string",
        "description": "What an injury event records (spec: Injury History 2026-08-27).",
        "enum": [
          "snapshot_baseline",
          "snapshot_listed",
          "snapshot_changed",
          "snapshot_unlisted",
          "il_placed",
          "il_transferred",
          "il_activated",
          "roster_returned"
        ]
      },
      "InjuryEventView": {
        "type": "object",
        "description": "One attached injury event, the user-relevant stored facts a \"full\nhistory\" must carry (spec: Injury History PR C amendment 2).",
        "required": [
          "kind",
          "observed_at"
        ],
        "properties": {
          "changed_fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Which fields changed (`snapshot_changed`) — exposes estimated-return\nmoves."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Official transaction-record text — present ONLY on events from the\nleague-transaction source. Media-report prose is never served."
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "il_tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "injury_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InjuryType"
              }
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/InjuryEventKind"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolution_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "return_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source's own event identifier — distinguishes two same-day\nfilings for the same person."
          },
          "source_reported_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InjuryStatus"
              }
            ]
          }
        }
      },
      "InjuryStatus": {
        "type": "string",
        "description": "Source-reported injury status token. Source-owned vocabulary (`Out`, `Day-To-Day`, `10-Day-IL`, source noise tokens, …) — not a closed enum.",
        "example": "Day-To-Day"
      },
      "InjuryStatusView": {
        "type": "object",
        "description": "The single current-injury slot served on person detail / roster / prop\ncard. Route-specific view — the shared `Person` type is untouched.",
        "required": [
          "status",
          "source",
          "source_observed_at",
          "summary"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Official transaction-record text, served ONLY for the\nleague-transaction source (formulaic filings like \"X placed Y on the\n10-day injured list. Right flexor strain.\"). Media-report prose is\nnever served (#352 Phase 1; ruling refined 2026-09-06)."
          },
          "injury_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InjuryType"
              }
            ]
          },
          "return_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source": {
            "$ref": "#/components/schemas/Source",
            "description": "Which source this slot came from (official league transactions take\nprecedence over media reports)."
          },
          "source_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_reported_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/InjuryStatus"
          },
          "summary": {
            "type": "string",
            "description": "House-generated one-liner derived purely from the structured fields\n(status, injury type, expected return) — safe for display everywhere."
          }
        }
      },
      "InjuryType": {
        "type": "string",
        "description": "Source-reported injury type/classification token. Source-owned vocabulary (`Hamstring`, `Knee`, …) — not a closed enum.",
        "example": "Hamstring"
      },
      "InjuryWindowFlags": {
        "type": "object",
        "description": "Annotation-only: no game leaves any window or denominator. Present only\nwhen the sampled game log overlaps or brackets an injury interval.",
        "required": [
          "games_before_latest_interval",
          "latest_interval_days",
          "window_spans_interval",
          "interval"
        ],
        "properties": {
          "games_before_latest_interval": {
            "type": "integer",
            "format": "int32",
            "description": "Games in the served game_log_detail whose kickoff precedes the most\nrecent interval's start (stale-form signal: \"7 of last 10 predate the\nstint\").",
            "minimum": 0
          },
          "interval": {
            "$ref": "#/components/schemas/DerivedInterval",
            "description": "The interval driving the flags (preferred source's derivation)."
          },
          "latest_interval_days": {
            "type": "integer",
            "format": "int64",
            "description": "Days spanned by the most recent interval overlapping/preceding the log\nwindow (end-or-today minus start)."
          },
          "window_spans_interval": {
            "type": "boolean",
            "description": "True when consecutive sampled games bracket an interval (a gap the\nnaive log reader would never see)."
          }
        }
      },
      "IntervalCloseKind": {
        "type": "string",
        "description": "How it closed (or didn't).",
        "enum": [
          "activated",
          "unlisted",
          "roster_move",
          "game_appearance",
          "open"
        ]
      },
      "IntervalStartKind": {
        "type": "string",
        "description": "How a derived interval opened.",
        "enum": [
          "reported",
          "listed",
          "unknown",
          "tolerant_open"
        ]
      },
      "LineupSlot": {
        "type": "object",
        "description": "One batting-order slot on a [`MatchupCard`]'s lineup, from\n`entity.matchup_lineup_slots`. `batting_order`/`position`/`bat_side` are\nnullable in the schema (a slot can be named before the full lineup detail\nis confirmed), so they stay `Option` on the wire rather than being\ndefaulted.",
        "required": [
          "person_id",
          "name",
          "confirmed"
        ],
        "properties": {
          "bat_side": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HandednessCode",
                "description": "`L`/`R`/`S` (switch) batting side, when known."
              }
            ]
          },
          "batting_order": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "confirmed": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "person_id": {
            "$ref": "#/components/schemas/PersonId"
          },
          "position": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PositionCode"
              }
            ]
          }
        }
      },
      "MatchSummary": {
        "type": "object",
        "description": "The team-Match read view of a [`Contest`](crate::domain::contest::Contest):\na two-entrant `Match` between team-backed entrants, projected onto the\nhome/away/score shape team-sport clients consume.\n\n`id` is the underlying [`ContestId`]; `home_team`/`away_team` and the optional\n[`Score`] are reconstructed by the store from the contest's two\n[`ContestEntrant`](crate::domain::contest_entrant::ContestEntrant) edges\n(ordered by `start_slot`: 0 = home, 1 = away) and their per-entrant\n[`Result`](crate::domain::result::Result) rows. It is intentionally\nteam-sport-shaped — a field contest (golf, racing) has no home/away and is not\nprojected here.",
        "required": [
          "id",
          "edition",
          "competition",
          "home_team",
          "away_team",
          "kickoff",
          "status"
        ],
        "properties": {
          "away_team": {
            "$ref": "#/components/schemas/TeamId"
          },
          "away_team_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Server-resolved away team name; see `home_team_name`."
          },
          "competition": {
            "$ref": "#/components/schemas/CompetitionId"
          },
          "edition": {
            "$ref": "#/components/schemas/EditionId"
          },
          "event": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventSummary"
              }
            ]
          },
          "home_team": {
            "$ref": "#/components/schemas/TeamId"
          },
          "home_team_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Server-resolved home team name (one `teams` join on the list read — a\nconsumer should never need N follow-up team lookups to label a\nslate). `None` only on reads that predate the field."
          },
          "id": {
            "$ref": "#/components/schemas/ContestId"
          },
          "kickoff": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ContestLocationSummary"
              }
            ]
          },
          "score": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Score"
              }
            ]
          },
          "stage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ContestStage",
                "description": "Competitive stage within the edition. `None` means the source did not\nclassify the contest (or the competition has no stage concept)."
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ContestStatus"
          }
        }
      },
      "MatchupCard": {
        "type": "object",
        "description": "MLB pregame matchup card: probable pitchers + lineups for one contest,\nassembled from `entity.matchups` ⨝ `entity.matchup_lineup_slots` (spec §1 /\nplan Task 2). `status`/`game_time` mirror the nullable `matchups` columns\n(a matchup row can exist before the contest's own schedule detail is\nfully populated).",
        "required": [
          "contest",
          "home_lineup",
          "away_lineup",
          "lineups_available"
        ],
        "properties": {
          "away_lineup": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineupSlot"
            }
          },
          "away_probable_pitcher": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PitcherRef"
              }
            ]
          },
          "away_team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TeamRef"
              }
            ]
          },
          "contest": {
            "$ref": "#/components/schemas/ContestId"
          },
          "game_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "home_lineup": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineupSlot"
            }
          },
          "home_probable_pitcher": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PitcherRef"
              }
            ]
          },
          "home_team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TeamRef"
              }
            ]
          },
          "lineups_available": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MatchupListResponse": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
