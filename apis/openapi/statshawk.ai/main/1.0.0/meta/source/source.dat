    "/v1/contests/{contest_id}/play-by-play": {
      "get": {
        "tags": [
          "Contests"
        ],
        "summary": "GET /v1/contests/{contest_id}/play-by-play — the Statcast play-by-play\nsequence, tier-projected by detail and optionally narrowed to one\npitcher/batter (or their head-to-head intersection).",
        "operationId": "get_v1_contests_contest_id_play_by_play",
        "parameters": [
          {
            "name": "contest_id",
            "in": "path",
            "description": "Minted contest id (`cst_…`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "detail",
            "in": "query",
            "description": "Projection tier. Defaults are SPORT-SPECIFIC: baseball `full`\n(existing-client compatibility), football `standard`.",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/Detail"
                }
              ]
            }
          },
          {
            "name": "pitcher_id",
            "in": "query",
            "description": "Baseball only: narrow to plate appearances this person pitched.",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/PersonId"
                }
              ]
            }
          },
          {
            "name": "batter_id",
            "in": "query",
            "description": "Baseball only: narrow to plate appearances this person batted.\nCombined with `pitcher_id`, both narrow (the head-to-head\nintersection).",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/PersonId"
                }
              ]
            }
          },
          {
            "name": "quarter",
            "in": "query",
            "description": "Football only: quarter filter, `>= 1` (values `5+` are overtime\nperiods — NFL postseason can exceed 5).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            }
          },
          {
            "name": "down",
            "in": "query",
            "description": "Football only: down filter, 1–4.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            }
          },
          {
            "name": "red_zone",
            "in": "query",
            "description": "Football only: plays snapped inside the red zone\n(`start_yards_to_endzone <= 20`).",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "scoring_only",
            "in": "query",
            "description": "Football only: scoring plays only.",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "description": "Football only: drives by this offense (`team_…` id).",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/TeamId"
                }
              ]
            }
          },
          {
            "name": "player_id",
            "in": "query",
            "description": "Rejected until the enrichment slice lands (spec §6): player\nattribution is not yet populated, and silently ignoring the filter\nwould return unfiltered plays as if it had applied.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The play-by-play sequence — one plate appearance per at-bat, each carrying its tier-projected pitches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePlayByPlay"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
