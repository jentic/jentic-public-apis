            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "per_page": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MembershipView": {
        "type": "object",
        "description": "One team affiliation on the wire — the response DTO for\n`GET /v1/persons/{person_id}/memberships`: every [`Membership`] field\nEXCEPT the internal `source` provenance stamp, which stays on the domain\nedge (and in storage) as the evidence base but is not serialized.",
        "required": [
