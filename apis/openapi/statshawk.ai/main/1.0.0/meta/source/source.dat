      "BaseballAnalysisContext": {
        "type": "object",
        "description": "Baseball analysis context. Each fact group is optional (different markets\npopulate different groups: the slate board serves the opposing starter, the\nprop card serves platoon splits) but a produced context always carries at\nleast one.",
        "properties": {
          "opposing_probable_pitcher": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PitcherRef",
                "description": "The opposing probable starter this batter faces (the OTHER side's\nannounced pitcher, with throwing hand when known). Slate-board rows."
              }
            ]
          },
          "platoon": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlatoonSplits",
                "description": "The batter's per-game splits by opposing starter handedness. Prop\ncards, when both sides of the split have at least one game."
              }
            ]
          }
        }
      },
      "BaseballLineupLine": {
        "type": "object",
        "description": "A baseball appearance's as-played lineup facts:\n`batting_slot`/`batting_entry` decode MLB's 3-digit wire `battingOrder`\ncode at the adapter boundary (never stored raw) and are `None` together\nfor a player with no batting order at all (e.g. an NL pitcher with no DH),\nwho may still carry a `position`. Exposed ONLY on\n[`BoxscoreLine::baseball`] — every other sport's line never has this key.",
        "properties": {
          "batting_entry": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Substitution entry order within the slot (0 = starter); `None` iff\n`batting_slot` is `None`."
          },
          "batting_slot": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "1-9 lineup slot; `None` when the person had no batting order."
          },
          "position": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PositionCode",
                "description": "As-played fielded position (e.g. `\"SS\"`)."
              }
            ]
          }
        }
      },
