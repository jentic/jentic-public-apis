    "/v1/persons/{person_id}/overview": {
      "get": {
        "tags": [
          "Persons"
        ],
        "summary": "GET /v1/persons/{per_id}/overview — the composed player overview: identity, current team, capabilities, season stats, and a capped\ncontext-rich game log, in one read.",
        "description": "**CDN-friendly by design**: the successful response carries\n[`PERSON_OVERVIEW_CACHE_CONTROL`] (`public, max-age=300, s-maxage=900,\nstale-while-revalidate=3600`) because the statshawk-web public marketing\npages and consumer popups sit behind a CDN — the overview is deliberately\ncache-friendly and slightly stale-tolerant, unlike the rest of the read\nsurface. The header is attached to the built [`Response`] here (the same\nhandler-owned-header pattern as the team-logo asset proxy); the\n`ApiResponse` envelope is untouched.",
        "operationId": "get_v1_persons_person_id_overview",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "description": "Minted person id (`per_…`)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "competition",
            "in": "query",
            "description": "Competition slug (e.g. `mlb`) or minted `comp_…` id.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "season",
            "in": "query",
            "description": "Season start year — cross-year leagues (NBA/NHL/NCAA) use the year the\nseason STARTS in (2025 = the 2025-26 season). Omitted ⇒ the latest\nseason with data for this person in the competition.",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/SeasonYear"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The composed player overview: identity, current team, season capabilities, materialized season stats, and the most recent 30 game-log entries. Served with `Cache-Control: public, max-age=300, s-maxage=900, stale-while-revalidate=3600` for CDN caching.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePersonOverview"
