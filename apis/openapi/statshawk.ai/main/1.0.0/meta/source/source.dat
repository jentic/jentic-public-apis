          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max price observations to return (default 50, max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Exclusive ISO8601 upper bound on observed_at (window filter; not tie-safe)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Tie-safe older-page cursor from `next_cursor` (`raw|{observed_at}|{id}` or `bucket|{start}`). Prefer this over `before` when paging.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Inclusive ISO8601 lower bound on observed_at",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "`raw` | `15m` | `1h` | `auto` (default auto)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest-first page of pregame ticks for one market/measure on this person. Weight 10. Unscoped reads default to the last 24h.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOddsHistory"
                }
              }
            },
