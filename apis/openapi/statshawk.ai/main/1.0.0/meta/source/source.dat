      "OddsHistoryFilterHints": {
        "type": "object",
        "required": [
          "paging"
        ],
        "properties": {
          "default_window": {
            "type": [
              "string",
              "null"
            ],
            "description": "Applied when person history has no `?contest=` and no `?since=`."
          },
          "paging": {
            "type": "string",
            "description": "Newest-first paging: pass `cursor=next_cursor` for older ticks."
          }
        }
      },
      "OddsHistoryInterval": {
        "type": "string",
        "description": "Resolved history sample interval. `auto` never appears on the wire after\nthe handler picks raw / 15m / 1h from the window.",
        "enum": [
          "raw",
          "15m",
          "1h",
          "auto"
        ]
      },
      "OddsHistoryPage": {
        "type": "object",
        "required": [
          "items",
          "truncated",
          "returned_ticks",
          "limit"
        ],
        "properties": {
          "filter_hints": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OddsHistoryFilterHints"
              }
            ]
          },
          "interval_applied": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OddsHistoryInterval"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OddsQuote"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "next_before": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp half of [`Self::next_cursor`]. Prefer `next_cursor` — this\nfield alone is not tie-safe."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tie-safe older-page cursor. Pass as `?cursor=`."
          },
          "returned_ticks": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "OddsMarketCapability": {
        "type": "object",
        "description": "One catalog market advertised on `/capabilities` — legal for the sport,\nindependent of whether a book currently has a line posted.",
        "required": [
          "subject",
          "market",
          "periods"
        ],
        "properties": {
          "market": {
            "$ref": "#/components/schemas/OddsMarketKind"
          },
