              "type": "string"
            }
          },
          {
            "name": "measure",
            "in": "query",
            "description": "Required unless `markets` is set. Qualified measure id or alias",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "books",
            "in": "query",
            "description": "Comma-separated sportsbooks (`pinnacle,draftkings`)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "`full` | `first_half` | `first_5_innings`",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max price observations to return (default 50, max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Exclusive ISO8601 upper bound on observed_at (window filter; not tie-safe)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Tie-safe older-page cursor from `next_cursor` (`raw|{observed_at}|{id}` or `bucket|{start}`). Prefer this over `before` when paging.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Inclusive ISO8601 lower bound on observed_at",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "`raw` | `15m` | `1h` | `auto` (default auto)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest-first page of pregame ticks for one market/measure on this contest. Weight 10. Tape stops at contest start.",
