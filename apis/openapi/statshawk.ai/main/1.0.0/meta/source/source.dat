              "null"
            ],
            "format": "int32"
          }
        }
      },
      "FootballPbpFilters": {
        "type": "object",
        "description": "The filters applied to a football read, echoed back (spec §6 pins these as\nplain nullable fields, unlike baseball's omitted-when-absent shape).",
