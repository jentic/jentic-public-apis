            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/HardwareWithStatus"
                      },
                      "type": "array"
                    },
                    "object": {
                      "const": "list",
                      "description": "The object type, which is always `list`."
