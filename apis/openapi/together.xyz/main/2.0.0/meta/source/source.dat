          },
          "target_tokens": {
            "$ref": "#/components/schemas/RL.LossTargetTokens",
            "description": "Target tokens for loss computation (optional, defaults to shifted input_ids)"
          }
        },
        "type": "object"
      },
      "RL.LossLogprobs": {
        "properties": {
          "data": {
            "description": "Float array of per-token log probabilities",
