            "format": "int64",
            "type": "integer"
          },
          "dropout": {
            "default": "0.05",
            "description": "Dropout of the LoRA adapter",
            "example": 0.05,
            "format": "float",
            "type": "number"
          },
          "rank": {
            "default": "8",
            "description": "Rank of the LoRA adapter",
            "example": 8,
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "RL.LossAdvantages": {
        "properties": {
          "data": {
            "description": "Float array of per-token advantages",
