            "example": "D_TYPE_FLOAT32"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "RL.LossMask": {
        "description": "Per-token loss mask (1=compute loss, 0=ignore)",
        "properties": {
