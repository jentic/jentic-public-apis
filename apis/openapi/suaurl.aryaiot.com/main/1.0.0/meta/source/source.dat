{
  "openapi": "3.0.3",
  "info": {
    "title": "Documentação - Árya M2M",
    "version": "1.0.0",
    "contact": {},
    "description": "## Seja bem vindo a API da Árya!\n\nAqui você vai encontrar tudo o que precisa para integrar a nossa plataforma com o seu software!\n\nAo ler a documentação, você perceberá que todas as requisições são feitas para a mesma URL base: https://suaUrl.aryaiot.com.br. Essa é uma URL de exemplo, para testar a API, você deve utilizar a URL fornecida para você.\n\nA API da Arya utiliza autenticação baseada em Bearer Token.\n\nTodas as requisições devem incluir um cabeçalho HTTP contendo o token de acesso obtido no momento da autenticaçao.\n\n`Authorization: Bearer {seu_token_de_acesso}`\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Arya-M2M/Documentacao-Arya-M2M-Clientes/1.0.0"
  },
  "servers": [
    {
      "url": "https://suaUrl.aryaiot.com"
    }
  ],
  "paths": {
    "/v2/auth": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autenticação",
        "description": "Este endpoint é responsável pela autenticação do cliente na API.\n\nA partir de credenciais válidas, a API retorna um Access Token no padrão Bearer Token, que deverá ser enviado no header Authorization em todas as requisições protegidas.\n\nO token gerado possui validade de 3 dias (72 horas). Após esse período, será necessário realizar uma nova autenticação para obter um novo token.\n",
        "operationId": "autenticaO",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "clientedemo@aryam2m.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Demo@20242"
                  }
                }
              },
              "examples": {
                "Autenticação": {
                  "value": {
                    "email": "clientedemo@aryam2m.com",
                    "password": "Demo@20242"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticação bem sucedida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "token": {
                      "type": "string",
                      "example": "eyJpdiI6Ik4rdFU1YjZiSXcvNlY2VEdaOTlaY1E9PSIsInZhbHVlIjoiejJjUWludGRpTmlUVVlGWlZhZHFDRnh6bUFpa295UCs3N1FlQW1NZm9EMTk4VGp6aE9LdTQ3LzZqN1pVRnVtL25DMFlodm82MG1xQ0FhTHRHMysrQktUSi8vNGc3Q0U0YTdiam4rbUhCRlY5K3g2MUppTzZNa21HeFY3OTRNZkdNQmNBd1Q1cWh3OWtTVTZnTmR1ZjhHN0VGZGtFemlPdnRVRHBUVFVB..."
                    },
                    "userInfo": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "example": "clientedemo@aryam2m.com"
                        },
                        "name": {
                          "type": "string",
                          "example": "Usuário de demonstração"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Autenticação bem sucedida": {
                    "value": {
                      "status": true,
                      "token": "eyJpdiI6Ik4rdFU1YjZiSXcvNlY2VEdaOTlaY1E9PSIsInZhbHVlIjoiejJjUWludGRpTmlUVVlGWlZhZHFDRnh6bUFpa295UCs3N1FlQW1NZm9EMTk4VGp6aE9LdTQ3LzZqN1pVRnVtL25DMFlodm82MG1xQ0FhTHRHMysrQktUSi8vNGc3Q0U0YTdiam4rbUhCRlY5K3g2MUppTzZNa21HeFY3OTRNZkdNQmNBd...",
                      "userInfo": {
                        "email": "clientedemo@aryam2m.com",
                        "name": "Usuário de demonstração"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "O email e a senha são obrigatórios."
                    },
                    "status": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                },
                "examples": {
                  "Dados inválidos fornecidos.": {
                    "value": {
                      "message": "O email e a senha são obrigatórios.",
                      "status": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Login mal sucedido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Email e/ou senha inválidos."
                    },
                    "status": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                },
                "examples": {
                  "Login mal sucedido.": {
                    "value": {
                      "message": "Email e/ou senha inválidos.",
                      "status": false
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/customer/inventary": {
      "post": {
        "tags": [
          "Inventário de SIM Cards"
        ],
        "summary": "Inventário de SIM Cards",
        "description": "Retorna o inventário de SIM Cards com suporte a paginação, ordenação e múltiplos filtros.\n\nPara refinar os resultados, utilize o objeto **`filters`** no corpo da requisição.\n\n**Importante:**  \nVerifique o schema do objeto **`filters`** para consultar todas as opções de filtros disponíveis.\n",
        "operationId": "inventRioDeSimCards",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "example": 1,
                    "description": "Página atual da listagem."
                  },
                  "per_page": {
                    "type": "integer",
                    "example": 10,
                    "description": "Quantidade de registros por página."
                  },
                  "sort": {
                    "type": "string",
                    "example": "",
                    "description": "Campo utilizado para ordenação dos resultados."
                  },
                  "filters": {
                    "type": "object",
                    "description": "Conjunto de filtros aplicáveis ao inventário de SIM Cards.\nTodos os campos são opcionais e podem ser combinados.\n",
                    "properties": {
                      "massiveSearch": {
                        "type": "string",
                        "description": "Busca massiva por **ICCID, MSISDN ou IMEI**.\n- Apenas um tipo por vez\n- Busca precisa por campo completo\n- Caracteres permitidos: espaço em branco, quebra de linha, ponto e vírgula (;), pipe (|) e vírgula (,)\n",
                        "example": "8955680000000000001;8955680000000000002"
                      },
                      "accountId": {
                        "type": "string",
                        "example": "Cliente X",
                        "description": "Nome da conta de faturamento."
                      },
                      "apn": {
                        "type": "string",
                        "example": "arya.br",
                        "description": "APN associada ao SIM Card."
                      },
                      "iccid": {
                        "type": "string",
                        "example": "895568",
                        "description": "Busca parcial ou completa por ICCID."
                      },
                      "msisdn": {
                        "type": "string",
                        "example": "5511999999999",
                        "description": "Busca parcial ou completa por MSISDN."
                      },
                      "imei": {
                        "type": "string",
                        "example": "356938035643809",
                        "description": "Busca parcial ou completa por IMEI."
                      },
                      "orderId": {
                        "type": "string",
                        "example": "12345",
                        "description": "Número do pedido associado ao SIM Card."
                      },
                      "provider": {
                        "type": "integer",
                        "example": 12,
                        "description": "Código da operadora.\nExemplo: \n  1 = VIVO\n  2 = CLARO\n  3 = ALGAR 5 OP\n  4 = ALGAR 3 OP\n  5 = VIVO INDIVIDUAL\n  6 = ARQIA M2M\n  7 = VIVO N\n  8 = ARQIA\n  9 = TIM\n  10 = ARQIA DUAL C\n  12 = 1NCE\n  13 = CONNECT ONE CLARO\n"
                      },
                      "status": {
                        "type": "string",
                        "example": "2",
                        "description": "Status do ciclo de vida do SIM Card.\n- 2: ATIVO\n- 0: PENDENTE\n"
                      },
                      "section": {
                        "type": "string",
                        "example": "1",
                        "description": "Conectividade atual.\n- 1: Online\n- 0: Offline\n"
                      },
                      "connection": {
                        "type": "string",
                        "example": "0",
                        "description": "Configuração da conexão.\n- 1: Bloqueada\n- 0: Liberada\n"
                      },
                      "ratType": {
                        "type": "string",
                        "example": "6",
                        "description": "Tecnologia conectada.\n- 2: 2G\n- 1: 3G\n- 5: 3.5G\n- 6: 4G\n- 8: NB-IoT\n"
                      },
                      "customField1": {
                        "type": "string",
                        "example": "Projeto X",
                        "description": "Busca nos campos personalizados do SIM Card."
                      },
                      "customField2": {
                        "type": "string"
                      },
                      "customField3": {
                        "type": "string"
                      },
                      "customField4": {
                        "type": "string"
                      },
                      "remainingQuotaBytes": {
                        "type": "string",
                        "example": "above_75",
                        "description": "Filtro por volume de dados restante.\n- above_75: Maior que 75%\n- between_50_75: Entre 75% e 50%\n- between_25_50: Entre 50% e 25%\n- below_25: Menor que 25%\n"
                      }
                    }
                  }
                }
              },
              "examples": {
                "Inventário de SIM Cards": {
                  "value": {
                    "page": 1,
                    "per_page": 10,
                    "sort": "",
                    "filters": {
                      "provider": 12,
                      "status": "2",
                      "remainingQuotaBytes": "above_75"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inventário de SIM Cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current_page": {
                      "type": "number",
                      "example": 1
                    },
                    "data": {
                      "type": "array",
