    "/sim/informations/{msisdn}": {
      "get": {
        "tags": [
          "Inventário de SIM Cards"
        ],
        "summary": "Informações de Conectividade",
        "description": "Este endpoint fornece informações de conectividade do SIM Card.\n\n⚠️ **Limitação importante:**  \nEste endpoint **não é compatível com SIM Cards da operadora 1NCE**. Para esses SIM Cards, os dados retornados podem ser incompletos, inconsistentes ou indisponíveis.\n\nCaso esteja utilizando SIM Cards da 1NCE, utilize os endpoints específicos da seção **\"Gestão de SIM Cards 1nce\"**.\n",
        "operationId": "informaEsDeConectividade",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connection_block_reason": {
                      "type": "number",
                      "example": 0
                    },
                    "inserted": {
                      "type": "string",
                      "example": "08/11/2021 20:49:02"
                    },
                    "is_active": {
                      "type": "number",
                      "example": 1
                    },
                    "msisdn": {
                      "type": "string",
                      "example": "5517936201627"
                    }
                  }
                },
                "examples": {
                  "Informações - Sucesso": {
                    "value": {
                      "connection_block_reason": 0,
                      "inserted": "08/11/2021 20:49:02",
                      "is_active": 1,
                      "msisdn": "5517936201627"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "MSISDN não encontrado."
                    }
                  }
                },
                "examples": {
                  "Informações - Não encontrado": {
                    "value": {
                      "message": "MSISDN não encontrado."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "msisdn",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "example": "5517936201459"
          }
        }
      ]
    },
