    "/identity_verification/get": {
      "post": {
        "description": "Retrieve a previously created Identity Verification.",
        "externalDocs": {
          "url": "/api/products/identity-verification/#identity_verificationget"
        },
        "operationId": "identityVerificationGet",
        "requestBody": {
