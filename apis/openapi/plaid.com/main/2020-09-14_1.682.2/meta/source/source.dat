          "end_date",
          "starting_balance",
          "ending_balance"
        ],
        "title": "CreditBankStatementUploadBankAccountPeriod",
        "type": "object"
      },
      "CreditBankStatementUploadItem": {
        "description": "An object containing information about the bank statement upload Item.",
