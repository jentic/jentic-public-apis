          "reason_codes": {
            "description": "The reasons for an individual having risk according to the LendScore. For a full list of possible reason codes, contact your Plaid Account Manager. Different LendScore versions will use different sets of reason codes.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "score": {
            "description": "The score returned by the LendScore model. Will be an integer in the range 1 to 99. Higher scores indicate lower credit risk.",
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
