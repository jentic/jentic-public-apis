                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/SignalReturnReportResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaidError"
                }
              }
            },
            "description": "Error response."
          }
        },
        "summary": "Report a return for an ACH transaction",
        "tags": [
          "plaid"
        ]
      }
    },
    "/signal/schedule": {
      "post": {
        "description": "Use `/signal/schedule` to schedule a planned ACH transaction.",
        "externalDocs": {
          "url": "none"
        },
        "operationId": "signalSchedule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignalScheduleRequest"
              }
            }
          },
          "required": true
        },
