        "required": [
          "entity_watchlist_program_id",
          "legal_name",
          "document_number",
          "email_address",
          "country",
          "phone_number",
          "url",
          "version"
        ],
        "type": "object"
      },
      "EntityWatchlistSearchTerms": {
        "description": "Search inputs for creating an entity watchlist screening",
        "properties": {
