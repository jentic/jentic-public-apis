        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "example-1": {
                    "value": {
                      "network_status": "RETURNING_USER",
                      "request_id": "m8MDnv9okwxFNBV"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/NetworkStatusGetResponse"
                }
              }
            },
            "description": "success"
          },
          "default": {
