            "type": "boolean"
          },
          "transactions": {
            "default": true,
            "description": "Allow access to transaction details. Only used by certain partners. If relevant to the partner and unset, defaults to `true`.",
            "nullable": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
