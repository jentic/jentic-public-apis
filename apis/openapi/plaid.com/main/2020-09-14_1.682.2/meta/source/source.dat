            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "origination_principal_amount": {
            "description": "The original principal balance of the mortgage.",
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "past_due_amount": {
            "description": "Amount of loan (principal + interest) past due for payment.",
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "property_address": {
