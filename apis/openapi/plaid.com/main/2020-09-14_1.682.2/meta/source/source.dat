          },
          "item_id": {
            "description": "The `item_id` associated with the Item related to this incident.",
            "nullable": true,
            "type": "string"
          },
          "link_session_id": {
            "description": "A unique identifier for a Link session that may be associated with this incident.",
            "nullable": true,
            "type": "string"
          },
          "protect_event_id": {
            "description": "A globally unique identifier representing a Protect event that may be associated with this incident.",
            "nullable": true,
