            "type": "array"
          }
        },
        "required": [
          "watchlist_screenings",
          "next_cursor",
          "request_id"
        ],
        "type": "object"
      },
      "WatchlistScreeningIndividualName": {
        "description": "The legal name of the individual being screened. Must have at least one alphabetical character, have a maximum length of 100 characters, and not include leading or trailing spaces.",
