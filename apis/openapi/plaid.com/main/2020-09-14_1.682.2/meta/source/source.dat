                      },
                      "created_at": "2021-10-30T15:26:48Z",
                      "recipient_id": "recipient-id-production-9b6b4679-914b-445b-9450-efbdb80296f6",
                      "reference": "ref-00001",
                      "request_id": "4ciYuuesdqSiUAB",
                      "status": "AUTHORISED",
                      "type": "SWEEPING"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/PaymentInitiationConsentGetResponse"
