                              "street": "123 Main St."
                            },
                            "email_address": "acharleston@email.com",
                            "legal_name": "Anne Charleston",
                            "phone_number": "510-555-0128"
                          }
                        }
                      },
                      "request_id": "saKrIBuEB9qJZno"
                    }
                  }
                },
                "schema": {
