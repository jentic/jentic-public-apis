                        {
                          "highest_amount": 25,
                          "lowest_amount": 0,
                          "score": 75
                        },
                        {
                          "highest_amount": 40,
                          "lowest_amount": 25,
                          "score": 72
                        },
                        {
                          "highest_amount": 100,
