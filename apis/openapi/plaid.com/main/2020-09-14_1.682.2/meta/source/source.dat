        "properties": {
          "created_at": {
            "description": "Timestamp in [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format (`YYYY-MM-DDTHH:mm:ssZ`) indicating the time the given Payment Profile was created at",
            "format": "date-time",
            "type": "string"
          },
