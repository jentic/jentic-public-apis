            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "AccountsGetResponse": {
        "additionalProperties": true,
        "description": "AccountsGetResponse defines the response schema for `/accounts/get` and `/accounts/balance/get`.",
        "properties": {
