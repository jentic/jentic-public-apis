          },
          "webhook_code": {
            "description": "`RETRIED`",
            "type": "string"
          },
          "webhook_type": {
            "description": "`IDENTITY_VERIFICATION`",
            "type": "string"
          }
        },
        "required": [
          "webhook_type",
