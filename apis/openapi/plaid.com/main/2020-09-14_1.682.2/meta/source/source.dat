      "SandboxTransferLedgerWithdrawSimulateResponse": {
        "additionalProperties": true,
        "description": "Defines the response schema for `/sandbox/transfer/ledger/withdraw/simulate`",
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestID"
