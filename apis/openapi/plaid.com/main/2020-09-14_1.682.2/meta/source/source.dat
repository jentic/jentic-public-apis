            "type": "boolean"
          },
          "nsf_overdraft_transactions_count": {
            "description": "The number of net NSF fee transactions for a given account within the report time range (not counting any fees that were reversed within the time range).",
            "type": "integer"
          },
          "nsf_overdraft_transactions_count_30d": {
            "description": "The number of net NSF fee transactions within the last 30 days for a given account (not counting any fees that were reversed within the time range).",
            "type": "integer"
          },
          "nsf_overdraft_transactions_count_60d": {
