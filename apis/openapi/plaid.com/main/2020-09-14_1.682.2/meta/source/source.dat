    "/protect/compute": {
      "post": {
        "description": "Use this endpoint to compute a Protect Trust Index score and retrieve fraud attributes.\n\nFor link-session models, if the Link session is not yet complete, the endpoint returns HTTP 400 with `error_type` = `INVALID_REQUEST` and `error_code` = `FAILED_PRECONDITION`.",
        "externalDocs": {
          "url": "/api/products/protect/#protectcompute"
        },
        "operationId": "protectCompute",
