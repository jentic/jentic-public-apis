          "institution_id": {
            "description": "The unique identifier of the financial institution involved.",
            "type": "string"
          },
          "institution_name": {
            "description": "The name of the financial institution involved.",
            "type": "string"
          },
          "issue_description": {
            "description": "A simple description of the error for the end user.",
            "type": "string"
          },
          "issue_id": {
            "description": "The unique identifier of the connectivity issue.",
            "type": "string"
          },
          "issue_resolved_at": {
            "description": "The time when the issue was marked as resolved.",
            "format": "date-time",
            "type": "string"
          },
          "webhook_code": {
            "description": "`ISSUE_RESOLVED`",
            "type": "string"
          },
          "webhook_type": {
            "description": "`ISSUES`",
            "type": "string"
          }
        },
        "required": [
