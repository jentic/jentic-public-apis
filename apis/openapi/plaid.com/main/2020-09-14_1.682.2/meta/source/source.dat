            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "next_payment_due_date": {
            "description": "The due date for the next payment. Dates are returned in an [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format (YYYY-MM-DD).",
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "origination_date": {
