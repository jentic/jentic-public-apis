              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaidError"
                }
              }
            },
            "description": "Error response"
          }
        },
        "summary": "Remove relay token",
        "tags": [
          "plaid"
        ]
      }
    },
    "/credit/sessions/get": {
      "post": {
        "description": "This endpoint can be used for your end users after they complete the Link flow. This endpoint returns a list of Link sessions that your user completed, where each session includes the results from the Link flow.\n\nThese results include details about the Item that was created and some product related metadata (showing, for example, whether the user finished the bank income verification step).",
