        },
        "required": [
          "request_id"
        ],
        "type": "object"
      },
      "IdentityUpdateTypes": {
        "description": "The possible types of identity data that may have changed.",
        "enum": [
          "PHONES",
          "ADDRESSES",
          "EMAILS",
          "NAMES"
        ],
        "type": "string"
      },
      "IdentityVerification": {
        "additionalProperties": true,
