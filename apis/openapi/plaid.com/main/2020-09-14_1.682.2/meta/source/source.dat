      "BeaconReport": {
        "additionalProperties": true,
        "description": "A Beacon Report describes the type of fraud committed by a user as well as the date the fraud was committed and the total amount of money lost due to the fraud incident.\n\nThis information is used to block similar fraud attempts on your platform as well as alert other companies who screen a user with matching identity information.\nOther companies will not receive any new identity information, just what matched, plus information such as industry, type of fraud, and date of fraud.\n\nYou can manage your fraud reports by adding, deleting, or editing reports as you get additional information on fraudulent users.",
        "properties": {
          "audit_trail": {
            "$ref": "#/components/schemas/BeaconAuditTrail"
          },
          "beacon_user_id": {
            "$ref": "#/components/schemas/BeaconUserID"
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "event_date": {
            "$ref": "#/components/schemas/ISO8601Date"
          },
          "fraud_amount": {
            "$ref": "#/components/schemas/FraudAmount"
          },
          "fraud_date": {
            "$ref": "#/components/schemas/ISO8601DateNullable"
          },
          "id": {
            "$ref": "#/components/schemas/BeaconReportID"
          },
          "type": {
            "$ref": "#/components/schemas/BeaconReportType"
          }
        },
        "required": [
          "id",
          "beacon_user_id",
          "created_at",
          "type",
          "fraud_date",
          "event_date",
          "fraud_amount",
          "audit_trail"
        ],
        "title": "BeaconReport",
        "type": "object"
      },
