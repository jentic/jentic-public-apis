                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CreditBankIncomeWebhookUpdateResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaidError"
                }
              }
            },
            "description": "Error response"
          }
        },
        "summary": "Subscribe and unsubscribe to proactive notifications for a user's income profile",
        "tags": [
          "plaid"
        ]
      }
    },
