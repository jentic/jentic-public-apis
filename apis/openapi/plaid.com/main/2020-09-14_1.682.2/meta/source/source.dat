      "BankTransferSweepListRequest": {
        "description": "BankTransferSweepListRequest defines the request schema for `/bank_transfer/sweep/list`",
        "properties": {
          "client_id": {
            "$ref": "#/components/schemas/APIClientID"
          },
          "count": {
            "default": 25,
