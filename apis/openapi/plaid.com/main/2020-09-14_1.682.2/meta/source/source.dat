                          "subtype": "401k",
                          "type": "investment"
                        },
                        {
                          "account_id": "XMBvvyMGQ1UoLbKByoMqH3nXMj84ALSdE5B58",
                          "balances": {
                            "available": null,
                            "current": 65262,
                            "iso_currency_code": "USD",
                            "limit": null,
                            "unofficial_currency_code": null
