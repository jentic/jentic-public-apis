        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "example-1": {
                    "value": {
                      "products": [
                        "auth",
                        "balance",
                        "identity"
                      ],
                      "request_id": "xrQNYZ7Zoh6R7gV"
