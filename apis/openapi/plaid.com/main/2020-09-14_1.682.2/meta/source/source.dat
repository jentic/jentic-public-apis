            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "origination_account_id": {
            "description": "If multiple origination accounts are available, `origination_account_id` must be used to specify the account that the sweeps belong to.",
            "nullable": true,
            "type": "string"
          },
          "secret": {
            "$ref": "#/components/schemas/APISecret"
          },
          "start_time": {
