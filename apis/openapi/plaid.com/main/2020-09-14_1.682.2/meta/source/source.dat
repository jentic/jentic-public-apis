    "/dashboard_user/get": {
      "post": {
        "description": "The `/dashboard_user/get` endpoint provides details (such as email address) about a specific Dashboard user based on the `dashboard_user_id` field, which is returned in the `audit_trail` object of certain Monitor and Beacon endpoints. This can be used to identify the specific reviewer who performed a Dashboard action.",
        "externalDocs": {
          "url": "/api/kyc-aml-users/#dashboard_userget"
        },
        "operationId": "dashboardUserGet",
        "requestBody": {
