                },
                "last_status_change": "2019-02-15T15:53:00Z",
                "status": "HEALTHY"
              },
              "liabilities": {
                "breakdown": {
                  "error_institution": 0.09,
                  "error_plaid": 0.02,
                  "success": 0.89
                },
                "last_status_change": "2019-02-15T15:53:00Z",
                "status": "HEALTHY"
              },
              "liabilities_updates": {
                "breakdown": {
                  "error_institution": 0.03,
                  "error_plaid": 0.02,
                  "refresh_interval": "NORMAL",
                  "success": 0.95
                },
                "last_status_change": "2019-02-12T08:22:00Z",
