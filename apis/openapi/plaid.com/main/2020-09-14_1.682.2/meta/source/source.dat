            "type": "number"
          },
          "updated_holdings": {
            "description": "The number of updated holdings reported since the last time this webhook was fired.",
            "type": "number"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          },
          "webhook_code": {
            "description": "`DEFAULT_UPDATE`",
            "type": "string"
          },
          "webhook_type": {
            "description": "`HOLDINGS`",
            "type": "string"
          }
        },
        "required": [
          "webhook_type",
          "webhook_code",
          "item_id",
          "new_holdings",
