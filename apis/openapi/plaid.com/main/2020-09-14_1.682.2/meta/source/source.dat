            "nullable": true,
            "type": "string"
          },
          "webhook": {
            "description": "The webhook URL to which a `TRANSFER_EVENTS_UPDATE` webhook should be sent.",
            "format": "url",
            "type": "string"
          }
        },
        "title": "SandboxTransferLedgerSimulateAvailableRequest",
