    "/network/status/get": {
      "post": {
        "description": "The `/network/status/get` endpoint can be used to check whether Plaid has a matching profile for the user.\nThis is useful for determining if a user is eligible for a streamlined experience, such as Layer.\n\nNote: it is strongly recommended to check for Layer eligibility in the frontend. `/network/status/get` should only be used for checking Layer eligibility if a frontend check is not possible for your use case.\nFor instructions on performing a frontend eligibility check, see the [Layer documentation](https://plaid.com/docs/layer/#integration-overview).",
        "externalDocs": {
          "url": "/api/network/#networkstatusget"
        },
        "operationId": "networkStatusGet",
        "requestBody": {
          "content": {
