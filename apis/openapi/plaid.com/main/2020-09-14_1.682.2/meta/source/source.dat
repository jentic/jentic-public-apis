      "IncomeInsights": {
        "additionalProperties": true,
        "description": "Comprehensive income analysis including total income, income excluding transfers, and inbound transfer amounts.",
        "nullable": true,
        "properties": {
          "income_excluding_transfers": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AmountWithCurrencyWithMonthlyAverage"
              }
            ],
            "description": "Income excluding account transfer transactions for the period, including a monthly average."
