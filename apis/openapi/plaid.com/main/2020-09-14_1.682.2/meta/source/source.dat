      },
      "TransferRecurringGetRequest": {
        "description": "Defines the request schema for `/transfer/recurring/get`",
        "properties": {
          "client_id": {
            "$ref": "#/components/schemas/APIClientID"
          },
          "recurring_transfer_id": {
