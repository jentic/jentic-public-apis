      "LinkTokenCreateRequestRedirectUri": {
        "description": "A URI indicating the destination where a user should be forwarded after completing the Link flow; used to support OAuth authentication flows when launching Link in the browser or another app. The `redirect_uri` should not contain any query parameters. When used in Production, must be an https URI. To specify any subdomain, use `*` as a wildcard character, e.g. `https://*.example.com/oauth.html`. Note that any redirect URI must also be added to the Allowed redirect URIs list in the [developer dashboard](https://dashboard.plaid.com/team/api). If initializing on Android, `android_package_name` must be specified instead and `redirect_uri` should be left blank.",
        "type": "string"
      },
      "LinkTokenCreateRequestStatements": {
        "description": "Specifies options for initializing Link for use with the Statements product. This field is required for the statements product.",
