    "/user/third_party_token/create": {
      "post": {
        "description": "This endpoint is used to create a third-party user token. This token can be shared with and used by a specified third-party client to access data associated with the user through supported endpoints.\n\nEnsure you store the `third_party_user_token` along with the `user_token` and `third_party_client_id`, as it is not possible to retrieve a previously created `third_party_user_token`.",
        "externalDocs": {
          "url": "/api/users/#userthirdpartytokencreate"
        },
        "operationId": "userThirdPartyTokenCreate",
        "requestBody": {
          "content": {
