                    "value": {
                      "request_id": "mdqfuVxeoza6mhu",
                      "sweep": {
                        "amount": "12.34",
                        "created": "2020-08-06T17:27:15Z",
                        "funding_account_id": "8945fedc-e703-463d-86b1-dc0607b55460",
                        "id": "d5394a4d-0b04-4a02-9f4a-7ca5c0f52f9d",
                        "iso_currency_code": "USD",
                        "network_trace_id": null,
                        "settled": "2020-08-07"
                      }
                    }
