{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Recherche d'Adresse de RC",
    "description": "Cette API permet d’interroger le SQL Warehouse de Databricks afin de rechercher des adresses de RC situées à proximité d’une adresse fournie, d’un point X/Y ou une RC directement avec immatriculation, à l'aide de 3 fonctions distinctes :\n  - recherche_RC_adresse(adresse, perimetre) : Recherche les résidences collectives situées dans un rayon donné autour d’une adresse textuelle.\n  Retourne : toutes les RC trouvées, avec leurs caractéristiques complètes et la distance en mètres par rapport à l’adresse fournie.\n  - recherche_RC_XY(x, y, perimetre) : Recherche les RC autour d’un point géographique précis (x,y) dans un périmètre donné.\n  Retourne : toutes les RC trouvées, avec leurs caractéristiques complètes et la distance en mètres par rapport au point (x,y) fournit.\n  - rechercher_RC_immatriculation(immatriculation) : Recherche une RC directement par son identifiant unique (immatriculation).\n  Retourne : une seule RC, mêmes informations mais sans distance, car il n’y a pas de calcul géographique.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/enedis-a6e/FRC/1.0.0"
  },
  "servers": [
    {
      "url": "https://enedis-auxo-relec01-build.cloud.databricks.com/api/2.0/sql/statements",
      "description": "Databricks SQL Warehouse"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "summary": "Exécuter une requête SQL de recherche RC",
        "operationId": "executeRechercheRC",
        "tags": [
          "SQL Warehouse"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "warehouse_id": {
                    "type": "string"
                  },
                  "wait_timeout": {
                    "type": "string"
                  },
                  "catalog": {
                    "type": "string"
                  },
                  "schema": {
                    "type": "string"
                  },
                  "statement": {
                    "type": "string"
                  },
                  "parameters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "adresse_perimetre": {
                  "summary": "CAS 1 – Recherche par adresse + périmètre",
                  "value": {
                    "warehouse_id": "d5a1cf468d9cd594",
                    "wait_timeout": "30s",
                    "catalog": "foncier_resid_collective_dev",
                    "schema": "gold",
                    "statement": "SELECT * FROM recherche_RC_adresse(:adresse, :perimetre)",
                    "parameters": [
                      {
                        "name": "adresse",
                        "value": "155 Boulevard Heurteloup 37000 Tours"
                      },
                      {
                        "name": "perimetre",
                        "value": 10
                      }
                    ]
                  }
                },
                "xy_perimetre": {
                  "summary": "CAS 2 – Recherche par X/Y + périmètre",
                  "value": {
                    "warehouse_id": "d5a1cf468d9cd594",
                    "wait_timeout": "30s",
                    "catalog": "foncier_resid_collective_dev",
                    "schema": "gold",
                    "statement": "SELECT * FROM recherche_RC_xy(:x, :y, :perimetre)",
                    "parameters": [
                      {
                        "name": "perimetre",
                        "value": 50
                      },
                      {
                        "name": "x",
                        "value": 641861.39
                      },
                      {
                        "name": "y",
                        "value": 6869552.31
                      }
                    ]
                  }
                },
                "immatriculation": {
                  "summary": "CAS 3 – Recherche par immatriculation",
                  "value": {
                    "warehouse_id": "d5a1cf468d9cd594",
                    "wait_timeout": "30s",
                    "catalog": "foncier_resid_collective_dev",
                    "schema": "gold",
                    "statement": "SELECT * FROM recherche_RC_immatriculation(:immatriculation)",
                    "parameters": [
                      {
                        "name": "immatriculation",
                        "value": "AB9723073"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
