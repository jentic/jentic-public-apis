{
  "openapi": "3.0.1",
  "info": {
    "title": "MQ-2-Json Banking Api (Search Summary)",
    "description": "<p class='revBox'><b><font color='red'>Latest Revision 2.0.0.7940 </font></b></p><p> Rest API Exposing Teiresias MQ Services.Authentication of this API is based on OAUTH2 Credential Flow.For Authentication you will need your created ClientId and ClientSecret which can be obtained from https://auth.teiresias.gr Authentication Server.<br><p> Authentication Server for TEST Env can be invoked using curl like below: </p><code> curl --request POST <br> --url 'https://auth.teiresias.gr/connect/token' <br>--header 'content-type: application/x-www-form-urlencoded' <br> --data grant_type=client_credentials <br> --data client_id=YOUR_CLIENT_ID <br>--data client_secret=YOUR_CLIENT_SECRET <br>--data scope=qanda_api_test </code><br><br><p><b> Sample Output </b></p> <code> { <br>'access_token': eyJhbGciOiJBMjU2S1ciLCJlbmMiOiJBMjU2Q0JDLUhTNTEyIiwidHlwIjoiYXQrand0In02sda0dj12ea <br> 'token_type' : Bearer <br>'expires_in' : 86399 <br>}</code> <br><br><p><b> Test Data is  given from Tiresias via email per request. The Data isn't for any kind of regression or business tests. This Sandbox is only for integration testing. </b></p>",
    "termsOfService": "http://tiresias.gr",
    "contact": {
      "name": "Tiresias Dev Team for any questions regarding this specific API",
      "email": "webdevs@TIRESIAS.gr"
    },
    "version": "2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/PAULOSILVA_1/mq-2-json-banking-api-search-summary/2.0"
  },
  "servers": [
    {
      "url": "https://bapi.teiresias.gr/SearchSummary",
      "description": "Production server (uses live data)"
    }
  ],
  "paths": {
    "/api/v2": {
      "post": {
        "tags": [
          "Banking Api - Search Summary"
        ],
        "summary": "Search for Financial data.",
        "description": "GR: Το απαντητικό μήνυμα της Τειρεσίας περιέχει τα στοιχεία των πέντε (5) πρώτων οικονομικών μονάδων που εμφανίζουν: α) στοιχεία Αθέτησης Υποχρεώσεων(ΣΑΥ),στοιχεία Υποθηκών / Προσημειώσεων(ΣΥΠ)  ή/και β) στοιχεία Συγκέντρωσης Χορηγήσεων(ΣΣΧ), ή γ) απαγόρευση δημοσίευσης των στοιχείων και που πληρούν τα κριτήρια αναζήτησης του μηνύματος της Τράπεζας.Επίσης, εάν οι οικονομικές μονάδες είναι περισσότερες από πέντε εμφανίζεται κατάλληλη ένδειξη που ενημερώνει τον χρήστη. \r\n            \r\nEN: The response message of Tiresias contains the data of the first five (5) financial units that show: (a) Liabilities data(MRLs), Mortgage / Notes data(MRLs) and / or (b) Loan Concentration Data(SBS); or c) a ban on the publication of the data that meet the search criteria of the Bank's message. Also, if the financial units are more than five, an appropriate indication is displayed that informs the user.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchSummaryRequest"
              },
              "examples": {
                "An api call request which can either return that no financial unit is found in Tiresias DB or a valid business response. In either case the status code is 200OK": {
                  "value": {
                    "AFM": "121314171",
                    "AR_TAYT": "",
                    "EPWN": "",
                    "ONOM": "",
                    "PATR": "",
                    "FYS_NOM": "2",
                    "ODOS": "",
                    "ARIT": "",
                    "POLH": "",
                    "TITLE": "",
                    "SSKANAKL": "",
                    "SCORE": "1",
                    "SALESORASSIGNMENT": "",
                    "FUNDCODE": "",
                    "WORK": "3",
                    "USERID": "TESTCLIENTUSERID",
                    "AA_REC": 1,
                    "COD_TRAP": "YOUR ASSIGNED COD_TRAP",
                    "COD_YPOK": 1
                  }
                }
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchSummaryRequest"
              },
              "examples": {
                "An api call request which can either return that no financial unit is found in Tiresias DB or a valid business response. In either case the status code is 200OK": {
                  "value": {
                    "AFM": "121314171",
                    "AR_TAYT": "",
                    "EPWN": "",
                    "ONOM": "",
                    "PATR": "",
                    "FYS_NOM": "2",
                    "ODOS": "",
                    "ARIT": "",
                    "POLH": "",
                    "TITLE": "",
                    "SSKANAKL": "",
                    "SCORE": "1",
                    "SALESORASSIGNMENT": "",
                    "FUNDCODE": "",
                    "WORK": "3",
                    "USERID": "TESTCLIENTUSERID",
                    "AA_REC": 1,
                    "COD_TRAP": "YOUR ASSIGNED COD_TRAP",
                    "COD_YPOK": 1
                  }
                }
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SearchSummaryRequest"
              },
              "examples": {
                "An api call request which can either return that no financial unit is found in Tiresias DB or a valid business response. In either case the status code is 200OK": {
                  "value": {
                    "AFM": "121314171",
                    "AR_TAYT": "",
                    "EPWN": "",
                    "ONOM": "",
                    "PATR": "",
                    "FYS_NOM": "2",
                    "ODOS": "",
                    "ARIT": "",
                    "POLH": "",
                    "TITLE": "",
                    "SSKANAKL": "",
                    "SCORE": "1",
                    "SALESORASSIGNMENT": "",
                    "FUNDCODE": "",
                    "WORK": "3",
                    "USERID": "TESTCLIENTUSERID",
                    "AA_REC": 1,
                    "COD_TRAP": "YOUR ASSIGNED COD_TRAP",
                    "COD_YPOK": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchSummaryResponse"
                },
                "examples": {
                  "An Example of a valid request that returns results for 1 Financial Unit": {
                    "value": {
                      "WON_OIK_MONADES": [
                        {
                          "WON_OIK_MON": "00024043",
                          "WON_EPWN": "TESTEPWN",
                          "WON_ONOM": "TESTONOM",
                          "WON_PATR": "TESTPATRON",
                          "WON_EPWNYMIA": "",
                          "WON_A_F_M": [
                            {
                              "AFM": "121314171"
                            }
                          ],
                          "WON_ADT": [
                            {
                              "AR_TAYT": "Α2255",
                              "KL_TAYT": ""
                            }
                          ],
                          "WON_ADDRESS": [
                            {
                              "ODOS": "ΑΛΑΜΑΝΑΣ",
                              "ARIT": "10",
                              "POLH": "ΜΑΡΟΥΣΙ",
                              "TK": "15126"
                            },
                            {
                              "ODOS": "ΑΛΑΜΑΝΑΣ",
                              "ARIT": "10",
                              "POLH": "ΜΑΡΟΥΣΙ",
                              "TK": "15126"
                            }
                          ],
                          "WON_APAGOR": "",
                          "WON_OTHER_ODOS": "",
