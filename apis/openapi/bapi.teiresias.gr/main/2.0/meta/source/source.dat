                          "WON_APF": "1"
                        }
                      ],
                      "WON_CURRENT_UPDATE_DATE": "2023-10-31",
                      "WON_AA_REC": "000237",
                      "WON_COD_TRAP": "YOURASSIGNEDCODTRAP",
                      "WON_COD_YPOK": "0001",
                      "WON_5NUM_OM_Y_N": "0",
                      "RESULT": "",
                      "SEND_DATE": "2024-04-10",
