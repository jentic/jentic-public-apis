                                  "WON_ENDEIKSH_RYTHMISHS": "",
                                  "WON_MEGISTH_TREX_XORISN": "00",
                                  "WON_MEGISTH_6MHN_XORISN": "00",
                                  "WON_MEGISTH_12MHN_XORISN": "00",
                                  "WON_MEGISTH_OLIKH_XORISN": "00",
                                  "WON_HMER_MEGIS_OLIKHS": "",
                                  "WON_DEIKTHS_ORISTIKHS_KATH": "",
                                  "WON_YPOLOIPO_KATH_BUCK3": "0000000000",
                                  "WON_YPOLOIPO_KATH_BUCK4": "0000000000",
                                  "WON_YPOLOIPO_KATH_BUCK5P": "0000000000",
                                  "WON_YPOLOIPO_KATH_BUCK1": "0000000000",
                                  "WON_YPOLOIPO_KATH_BUCK2": "0000000000"
                                }
                              ]
                            }
                          ],
                          "WON_FINAL_MIN_DATE": "2023-01-06",
                          "WON_FINAL_MAX_DATE": "2023-01-06",
                          "WON_S_EXEI_ANAKL": "",
                          "WON_SUM_DY": "0000000000",
                          "WON_SUM_DY_SYN": "0000000000",
                          "WON_LHX_MIN_DATE": "",
                          "WON_LHX_MAX_DATE": "",
                          "WON_LHX_SUM_6M": "0000000000",
                          "WON_S_EXEI_EPIXEIR": "0",
                          "WON_S_EXEI_SCORE": "Y",
                          "WON_SCORE_INFO": [
                            {
                              "SCORE": "120",
                              "SEGMENT": "S3",
                              "SCORE_DATE": "2024-04-03",
                              "VERSION": "V/4.0",
                              "REASON1": "",
                              "REASON2": "",
                              "REASON3": ""
                            }
                          ],
                          "WON_V55_MME_DEIK_METABASH": "",
                          "WON_V55_MME_KATHGORIES": [
                            {
                              "WON_V55_MME_CHAR_DIK": "",
                              "WON_V55_MME_PISTOTIKO_ORIO": "",
                              "WON_V55_MME_MAP": "",
                              "WON_V55_SUBTABLE_MME": []
                            }
                          ],
                          "WON_END_RYTHMISHS_N3869": "N",
                          "WON_EXEI_KOINO_ORIO": "N",
