                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "examples": {
                  "Response when a validation rules is thrown because a field or fields is/are required ": {
                    "value": {
                      "ModelState": [
                        {
                          "AFM": "The AFM field is required."
                        }
                      ],
                      "Message": "The request is invalid"
                    }
                  },
                  "Response when a field is client validatable but server invalid ": {
                    "value": {
                      "Message": "COD_TRAP has invalid value!"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "examples": {
                  "An example of 401 Unauthorized where the token isn't passed in the headers": {
                    "value": {
                      "Error": "missing_token",
                      "Error_description": "The security token is missing.",
                      "Error_uri": "https://documentation.openiddict.com/errors/ID2000"
                    }
                  },
                  "An example of 401 Unauthorized where the client_id representing the request is wrong. Check _test / _prod to match environment": {
                    "value": {
                      "Error": "invalid client",
                      "Error_description": "The specified 'client_id' is invalid",
                      "Error_uri": "https://documentation.openiddict.com/error/ID2052"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "Error": "invalid_request",
                  "Error_description": "This client application is not allowed to use the specified scope.",
                  "Error_uri": "https://documentation.openiddict.com/errors/ID2051"
                }
              }
            }
          },
          "500": {
            "description": "An Error Has Occured. Contact Teiresias for further investigation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ADTInfo": {
        "type": "object",
        "properties": {
          "AR_TAYT": {
            "type": "string",
            "description": "GR: ΑΡΙΘΜΟΣ ΔΕΛΤΙΟΥ ΤΑΥΤΟΤΗΤΑΣ | EN: PERSONAL IDENTIFICATION NUMBER",
            "nullable": true
          },
          "KL_TAYT": {
            "type": "string",
            "description": "GR: ΕΝΔΕΙΞΗ ΕΑΝ Η ΤΑΥΤΟΤΗΤΑ ΕΧΕΙ ΔΗΛΩΘΕΙ ΩΣ ΑΠΟΛΕΣΘΕΙΣΑ / ΚΛΑΠΕΙΣΑ / ΑΝΕΝΕΡΓΗ | EN: NDICATION IF IDENTITY HAS BEEN DECLARED AS LOST / STOLEN / INACTIVE",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddressInfo": {
        "type": "object",
        "properties": {
          "ODOS": {
            "type": "string",
            "description": "GR: ΟΔΟΣ | EN: STREET",
            "nullable": true
          },
          "ARIT": {
            "type": "string",
            "description": "GR: ΑΡΙΘΜΟΣ | EN: STREET NUMBER",
            "nullable": true
          },
          "POLH": {
            "type": "string",
            "description": "GR: ΠΟΛΗ | EN: CITY",
            "nullable": true
          },
          "TK": {
            "type": "string",
            "description": "GR: ΤΚ | EN: POSTCODE",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "SaySypData": {
        "type": "object",
        "properties": {
          "CATEGORY_CODE": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΛΗΡΟΦΟΡΙΑΣ | EN: CODE CATEGORY",
            "nullable": true
          },
          "PIECES1": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 1 | EN: CATEGORY PIECE 1",
            "nullable": true
          },
          "PIECES2": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 2 | EN: CATEGORY PIECE 2",
            "nullable": true
          },
          "PIECES3": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 3 | EN: CATEGORY PIECE 3",
            "nullable": true
          },
          "PIECES4": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 4 | EN: CATEGORY PIECE 4",
            "nullable": true
          },
          "PIECES5": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 5 | EN: CATEGORY PIECE 5",
            "nullable": true
          },
          "PIECES6": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΤΕΜΑΧΙΟ 6 | EN: CATEGORY PIECE 6",
            "nullable": true
          },
          "AMOUNT1": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 1 | EN: CATEGORY AMOUNT 1",
            "nullable": true
          },
          "AMOUNT2": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 2 | EN: CATEGORY AMOUNT 2",
            "nullable": true
          },
          "AMOUNT3": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 3 | EN: CATEGORY AMOUNT 3",
            "nullable": true
          },
          "AMOUNT4": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 4 | EN: CATEGORY AMOUNT 4",
            "nullable": true
          },
          "AMOUNT5": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 5 | EN: CATEGORY AMOUNT 5",
            "nullable": true
          },
          "AMOUNT6": {
            "type": "string",
            "description": "GR: ΚΑΤΗΓΟΡΙΑ ΠΟΣΟ 6 | EN: CATEGORY AMOUNT 6",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ScoreData": {
        "type": "object",
        "properties": {
          "SCORE": {
            "type": "string",
            "description": "GR: Score | EN: Score",
            "nullable": true
          },
          "SEGMENT": {
            "type": "string",
            "description": "GR: Τμήμα (Segment) | EN: Segment",
            "nullable": true
          },
          "SCORE_DATE": {
            "type": "string",
            "description": "GR: Score Date | EN: Date of Score Issuing",
            "nullable": true
          },
          "VERSION": {
            "type": "string",
            "description": "GR: Έκδοση του Score | EN: Score Version",
            "nullable": true
          },
          "REASON1": {
            "type": "string",
            "description": "GR: Reason Code 1 | EN: Reason Code 1",
            "nullable": true
          },
          "REASON2": {
            "type": "string",
            "description": "GR: Reason Code 2 | EN: Reason Code 2",
            "nullable": true
          },
          "REASON3": {
            "type": "string",
            "description": "GR: Reason Code 3 | EN: Reason Code 3",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SearchSummaryRequest": {
        "required": [
          "AA_REC",
          "COD_TRAP",
          "COD_YPOK",
          "USERID"
        ],
        "type": "object",
        "properties": {
          "USERID": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string",
            "description": "GR: ΧΡΗΣΤΗΣ | EN: USERID"
          },
          "AA_REC": {
            "maximum": 999999,
            "minimum": 0,
            "type": "integer",
            "description": "GR: ΑΥΞΩΝ ΑΡΙΘΜOΣ | EN: AUTO INCREMENTAL NUMBER",
            "format": "int32"
          },
          "COD_TRAP": {
            "maxLength": 3,
            "minLength": 0,
            "type": "string",
            "description": "GR: ΚΩΔΙΚΟΣ ΤΡΑΠΕΖΑΣ | EN: BANK CODE"
          },
          "COD_YPOK": {
            "maximum": 9999,
            "minimum": 0,
            "type": "integer",
            "description": "GR: ΚΩΔΙΚΟΣ ΤΡΑΠΕΖΑΣ | EN: BANK STORE CODE",
            "format": "int32"
          },
          "AFM": {
            "maxLength": 9,
            "minLength": 0,
            "type": "string",
            "description": "GR: Α.Φ.Μ | EN: VAT NUMBER",
            "nullable": true
          },
          "AR_TAYT": {
            "type": "string",
            "description": "GR: ΑΡΙΘΜΟΣ ΔΕΛΤΙΟΥ ΤΑΥΤΟΤΗΤΑΣ | EN: IDENTIFICATION NUMBER",
            "nullable": true
          },
          "EPWN": {
            "type": "string",
            "description": "GR: ΕΠΩΝΥΜΟ/ΕΠΩΝΥΜΙΑ.  | EN: LASTNAME/COMPANYS NAME",
            "nullable": true
          },
          "ONOM": {
            "type": "string",
            "description": "GR: ΟΝΟΜA | EN: FIRSTNAME",
            "nullable": true
          },
          "PATR": {
            "type": "string",
