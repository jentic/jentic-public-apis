                    }
                  },
                  "An Example of an invalid request that returns a valid response that describes in the Error field that the VAT is invalid": {
                    "value": {
                      "WON_OIK_MONADES": [],
                      "WON_CURRENT_UPDATE_DATE": "",
                      "WON_AA_REC": "",
                      "WON_COD_TRAP": "",
                      "WON_COD_YPOK": "",
