                          "WON_SEARCH_TIMES": "0006",
                          "WON_KATHGORIES_SOS": [
                            {
                              "CATEGORY_CODE": "",
                              "PIECES1": "",
                              "PIECES2": "",
                              "PIECES3": "",
                              "PIECES4": "",
                              "PIECES5": "",
                              "PIECES6": "",
                              "AMOUNT1": "",
                              "AMOUNT2": "",
                              "AMOUNT3": "",
                              "AMOUNT4": "",
                              "AMOUNT5": "",
                              "AMOUNT6": ""
                            }
                          ],
                          "WON_TAKTOP": [
                            {
                              "CATEGORY_CODE": "",
