    },
    "/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "summary": "Create a quote",
        "description": "The exact price of a run, without running it or holding credit. It takes the same body as `POST /v1/generations`, checks the input against the model's schema and fills in its defaults, so an input the schema refuses gets the same `400`. It can't tell whether the model will accept the prompt itself.\n\nNeeds an API key with the `generations:read` scope.",
        "tags": [
          "Quotes"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The price and the input as it would run.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "Deprecation": {
                "schema": {
                  "type": "string",
                  "description": "Present when the model or preset is deprecated: when it was, as `@` and a Unix time (RFC 9745)."
                }
              },
              "Sunset": {
                "schema": {
                  "type": "string",
                  "description": "Present when the model or preset is deprecated: the date it stops running, as an HTTP date (RFC 8594)."
                }
              },
              "Link": {
                "schema": {
                  "type": "string",
                  "description": "For a deprecated model with a replacement: `</v1/models/{id}>; rel=\"successor-version\"`."
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "object": "quote",
                  "model": "google/veo-3.1-fast",
                  "revision": "2026-10-02",
                  "input": {
                    "prompt": "A heron lands on a still lake at dawn",
                    "aspect_ratio": "16:9",
                    "n": 1,
                    "duration": 4,
                    "resolution": "1080p",
                    "audio": true
                  },
                  "cost_usd": "0.80",
                  "hold_usd": "0.80"
                },
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameterOrConflictingCredentials"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/generations": {
      "get": {
        "operationId": "listGenerations",
        "summary": "List generations",
        "description": "Your workspace's generations, newest first, 50 to a page by default. Filter by model, status or where they were started. To read the next page, send `next_cursor` as `cursor` with the same filters.\n\nNeeds an API key with the `generations:read` scope.",
        "tags": [
          "Generations"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of rows to return: 1 to 100; default 50.",
              "type": "string",
              "pattern": "^\\d{1,3}$"
            },
            "description": "Maximum number of rows to return: 1 to 100; default 50."
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Send next_cursor as cursor; omit it for the first page.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
            },
            "description": "Send next_cursor as cursor; omit it for the first page."
          },
          {
            "in": "query",
            "name": "model",
            "schema": {
              "description": "Only runs of this model or preset. A preset's ID without a version, such as leap/headshot, takes in every version.",
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9.-]*(@[1-9][0-9]{0,3})?$"
            },
            "description": "Only runs of this model or preset. A preset's ID without a version, such as leap/headshot, takes in every version."
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "description": "Only runs started from these places, comma-separated: api, mcp or studio, such as api,mcp.",
              "type": "string"
            },
            "description": "Only runs started from these places, comma-separated: api, mcp or studio, such as api,mcp."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "description": "Only runs in these states, comma-separated, such as queued,running.",
              "type": "string"
            },
            "description": "Only runs in these states, comma-separated, such as queued,running."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of generations.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "object": "list",
                  "url": "/v1/generations",
                  "data": [
                    {
                      "id": "gen_7Hq2mVx9Lr4Kp8Tn3Wc6Yb1D",
                      "object": "generation",
                      "model": "google/veo-3.1-fast",
                      "modality": "video",
                      "status": "succeeded",
                      "provider": "gateway",
                      "revision": "2026-10-02",
                      "input": {
                        "prompt": "A heron lands on a still lake at dawn",
                        "aspect_ratio": "16:9",
                        "n": 1,
                        "duration": 4,
                        "resolution": "1080p",
                        "audio": true
                      },
                      "output": [
                        {
                          "type": "video",
                          "url": "https://api.tryleap.ai/files/eyJrIjoibWVkaWEvb3V0cHV0cy9nZW5fN0hxMm1WeDlMcjRLcDhUbjNXYzZZYjFEIn0",
                          "expires_at": "2026-10-05T18:24:12.004Z",
                          "content_type": "video/mp4",
                          "width": 1920,
                          "height": 1080,
                          "poster": {
                            "url": "https://api.tryleap.ai/files/eyJrIjoibWVkaWEvb3V0cHV0cy9nZW5fN0hxMm1WeDlMcjRLcDhUbjNXYzZZYjFEIn0",
                            "expires_at": "2026-10-05T18:24:12.004Z",
                            "width": 720,
                            "height": 405
                          }
                        }
                      ],
                      "error": null,
                      "failure_cause": null,
                      "usage": {
                        "cost_usd": "0.80"
                      },
                      "source": "api",
                      "batch_id": null,
                      "created_at": "2026-10-04T18:22:41.512Z",
                      "started_at": "2026-10-04T18:22:42.090Z",
                      "completed_at": "2026-10-04T18:24:11.877Z",
                      "slow_at": null,
                      "deadline_at": null
                    }
                  ],
                  "has_more": true,
                  "next_cursor": "eyJpZCI6Imdlbl83SHEybVZ4OUxyNEtwOFRuM1djNlliMUQifQ.2b4Kx9Qm7Lr1Tn5Wc3Yb8Df6Gh0Jk2Mn4Pq6Rs8Tv0X"
                },
                "schema": {
                  "$ref": "#/components/schemas/GenerationList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameterOrConflictingCredentials"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      },
      "post": {
        "operationId": "createGeneration",
        "summary": "Create a generation",
        "description": "Starts a run of any model or preset. Every model takes this same shape; only `input` differs, as the model's `input_schema` says. The price is held from your balance first, and charged only if the run succeeds.\n\nWithout `Prefer`, the answer comes at once with the generation `queued`. With `Prefer: wait=60`, it comes when the run finishes or after 60 seconds, whichever is first: most images finish inside the wait, and video doesn't. Send an `Idempotency-Key` so a retry never starts a second run.\n\nA run that would sexualise a real person from a photo you uploaded is refused with `422 sexualized_real_person` before anything is held: words that ask to undress them or show them in a sexual way, on the photo or on an image Leap made from it, or a face swap or a recast into a sexual picture or clip.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Generations"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "description": "A key you generate for this request, such as a UUID, so a retry never starts a second run. A retry with the same key and body returns the same generation as it is now, marked `Idempotent-Replayed: true`. The same key with a different body is a `409`. A key belongs to your workspace and doesn't expire, so use a new one for each new request.",
              "example": "7f1c2a9e-3b4d-4e8a-9c21-5d0f6a7b8c90",
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            "description": "A key you generate for this request, such as a UUID, so a retry never starts a second run. A retry with the same key and body returns the same generation as it is now, marked `Idempotent-Replayed: true`. The same key with a different body is a `409`. A key belongs to your workspace and doesn't expire, so use a new one for each new request."
          },
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "description": "`wait=N` holds the request open for up to N seconds (at most 60) until the generation finishes, and `Preference-Applied` echoes the wait used. Most images finish inside the wait. If the run is still going when it ends, you get it back `queued` or `running`; poll it from there. Without this header the generation comes back queued at once.",
              "example": "wait=60",
              "type": "string"
            },
            "description": "`wait=N` holds the request open for up to N seconds (at most 60) until the generation finishes, and `Preference-Applied` echoes the wait used. Most images finish inside the wait. If the run is still going when it ends, you get it back `queued` or `running`; poll it from there. Without this header the generation comes back queued at once."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The generation: `queued` at once, or as it is when the wait ends.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "description": "The new resource's path, such as `/v1/generations/gen_...`."
                }
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "const": "true",
                  "description": "Present when this answer replays the first request sent with the same `Idempotency-Key`."
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string",
                  "description": "The wait that was applied, such as `wait=60`."
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "While a run is still `queued` or `running`: seconds to wait before you read it again, 2 for images and audio, 5 for video and 3D. A final answer has none.",
                  "example": 5
                }
              },
              "Deprecation": {
                "schema": {
                  "type": "string",
                  "description": "Present when the model or preset is deprecated: when it was, as `@` and a Unix time (RFC 9745)."
                }
              },
              "Sunset": {
                "schema": {
                  "type": "string",
                  "description": "Present when the model or preset is deprecated: the date it stops running, as an HTTP date (RFC 8594)."
                }
              },
              "Link": {
                "schema": {
                  "type": "string",
                  "description": "For a deprecated model with a replacement: `</v1/models/{id}>; rel=\"successor-version\"`."
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "id": "gen_7Hq2mVx9Lr4Kp8Tn3Wc6Yb1D",
                  "object": "generation",
                  "model": "google/veo-3.1-fast",
                  "modality": "video",
                  "status": "queued",
                  "provider": null,
                  "revision": "2026-10-02",
                  "input": {
                    "prompt": "A heron lands on a still lake at dawn",
                    "aspect_ratio": "16:9",
                    "n": 1,
                    "duration": 4,
                    "resolution": "1080p",
                    "audio": true
                  },
                  "output": [],
                  "error": null,
                  "failure_cause": null,
                  "usage": {
                    "cost_usd": null
                  },
                  "source": "api",
                  "batch_id": null,
                  "created_at": "2026-10-04T18:22:41.512Z",
                  "started_at": null,
                  "completed_at": null,
                  "slow_at": null,
                  "deadline_at": null
                },
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameterOrConflictingCredentials"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "402": {
