    "/v1/generations/{id}/outputs/{index}/file": {
      "post": {
        "operationId": "keepGenerationOutput",
        "summary": "Keep an output as a file",
        "description": "Turns an image output of a succeeded generation into a file of your workspace, so you can pass its ID to the next run without downloading and uploading it. Calling it again returns the same file. Other outputs answer `400`.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Generations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The generation's ID, `gen_...`."
            },
            "required": true,
            "description": "The generation's ID, `gen_...`."
          },
          {
            "in": "path",
            "name": "index",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63,
              "description": "The output's position in `output`, from 0."
