    "/v1/events/{id}/redeliver": {
      "post": {
        "operationId": "redeliverEvent",
        "summary": "Redeliver an event",
        "description": "Sends the event again: to one endpoint with `{\"endpoint\": \"we_...\"}`, or else to every enabled endpoint that subscribes to its type and to the webhook URL its request named. It keeps the event's `webhook-id`, so a receiver that skips duplicates handles it once. A disabled endpoint, or nowhere to send, answers `409`. Tests and redeliveries share a budget of 100 an hour per workspace.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The event's ID, `evt_...`."
            },
            "required": true,
            "description": "The event's ID, `evt_...`."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "default": {},
                "type": "object",
                "properties": {
                  "endpoint": {
                    "description": "Send only to this endpoint. Without it, the event goes to every enabled endpoint that subscribes to its type, and to the webhook URL its request named.",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The deliveries it queued.",
