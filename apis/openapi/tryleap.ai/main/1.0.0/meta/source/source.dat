    "/v1/generations/{id}": {
      "get": {
        "operationId": "retrieveGeneration",
        "summary": "Retrieve a generation",
        "description": "A generation's status, outputs and cost. Each read signs fresh output links, valid for 24 hours.\n\nTo wait for the result, send `Prefer: wait=60`: the read holds until `status` is `succeeded`, `failed` or `canceled`, or 60 seconds pass, so a loop of these reads long-polls a video in a few requests. Without it the read answers at once; while the run isn't final, `Retry-After` says how many seconds to wait before the next read.\n\nNeeds an API key with the `generations:read` scope.",
        "tags": [
          "Generations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The generation's ID, `gen_...`."
            },
            "required": true,
            "description": "The generation's ID, `gen_...`."
          },
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "description": "`wait=N` holds the request open for up to N seconds (at most 60) until the generation finishes, and `Preference-Applied` echoes the wait used. Most images finish inside the wait. If the run is still going when it ends, you get it back `queued` or `running`; poll it from there. Without this header the generation comes back queued at once.",
              "example": "wait=60",
              "type": "string"
            },
            "description": "`wait=N` holds the request open for up to N seconds (at most 60) until the generation finishes, and `Preference-Applied` echoes the wait used. Most images finish inside the wait. If the run is still going when it ends, you get it back `queued` or `running`; poll it from there. Without this header the generation comes back queued at once."
          }
        ],
        "responses": {
          "200": {
            "description": "The generation, as it is now or when the wait ends.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string",
                  "description": "The wait that was applied, such as `wait=60`."
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "While a run is still `queued` or `running`: seconds to wait before you read it again, 2 for images and audio, 5 for video and 3D. A final answer has none.",
                  "example": 5
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "id": "gen_7Hq2mVx9Lr4Kp8Tn3Wc6Yb1D",
                  "object": "generation",
                  "model": "google/veo-3.1-fast",
                  "modality": "video",
                  "status": "succeeded",
                  "provider": "gateway",
                  "revision": "2026-10-02",
                  "input": {
