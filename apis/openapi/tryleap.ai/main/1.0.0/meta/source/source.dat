      "post": {
        "operationId": "createCharacter",
        "summary": "Create a character",
        "description": "Keeps a character from 1 to 4 pictures you uploaded (`POST /v1/files`) or made (`POST /v1/generations/{id}/outputs/{index}/file`). Leap reads its look from them once. From then on, pass its `chr_...` ID wherever a model or recipe takes an image file: a list such as `images` gets all its pictures, a single image input its first. Free; a workspace keeps up to 200.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Characters"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The character.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "description": "The new resource's path, such as `/v1/generations/gen_...`."
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "id": "chr_7Hq2Lm9Xc4Vb1Nz8Rt5Kw3Ys",
                  "object": "character",
                  "beta": true,
                  "name": "Rook",
                  "images": [
                    {
                      "file": "file_5Tn8Xc2Lq7Vm4Hb9Rz1Kw6Pd",
                      "url": "https://api.tryleap.ai/files/eyJrIjoibWVkaWEvb3V0cHV0cy9nZW5fN0hxMm1WeDlMcjRLcDhUbjNXYzZZYjFEIn0",
                      "width": 1024,
                      "height": 1536
                    }
                  ],
                  "created_at": "2026-10-17T14:02:11.204Z",
                  "updated_at": "2026-10-17T14:02:11.204Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/Character"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameterOrConflictingCredentials"
