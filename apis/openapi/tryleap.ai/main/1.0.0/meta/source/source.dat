    "/v1/generations/{id}/cancel": {
      "post": {
        "operationId": "cancelGeneration",
        "summary": "Cancel a generation",
        "description": "Stops a queued or running generation and releases its hold; if the provider finishes it anyway, the result is thrown away and nothing is charged. A generation that already ended comes back as it is. Two kinds can't be stopped once started and answer `409`: a run at a provider that bills it either way, and a preset run that has already shown its `preview`. Each runs to its end and is charged only if it succeeds.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Generations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The generation's ID, `gen_...`."
            },
            "required": true,
            "description": "The generation's ID, `gen_...`."
          }
        ],
        "responses": {
          "200": {
            "description": "The generation, `canceled`, or as it was if it had already ended.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              }
            },
