                "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$",
                "description": "Opaque next_cursor from the previous page. It works only for the list and filters it came from."
              },
              {
                "type": "null"
              }
            ],
            "description": "Send as cursor to read the next page; null on the last page."
          }
        },
        "required": [
          "object",
          "url",
          "data",
          "has_more",
          "next_cursor"
        ],
        "additionalProperties": false,
        "description": "Forward list envelope. Live lists are not snapshots; totals are not promised."
      },
      "DeletedFile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The deleted file's ID."
          },
          "object": {
            "type": "string",
            "const": "file"
          },
          "deleted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "object",
          "deleted"
        ],
        "additionalProperties": false
      },
      "Upload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The upload's ID, `file_...`. Completing it makes a file with the same ID."
          },
          "object": {
            "type": "string",
            "const": "upload"
          },
          "content_type": {
            "type": "string",
            "description": "The type you declared."
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "The size you declared, in bytes."
          },
          "filename": {
            "description": "The name you gave, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "upload_url": {
            "type": "string",
            "description": "Where to send the file's bytes."
          },
          "upload_method": {
            "type": "string",
            "const": "PUT",
            "description": "The method to send them with."
          },
          "upload_headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers to send with the bytes, exactly as given."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When `upload_url` stops working, an hour after it was made."
          }
        },
        "required": [
          "id",
          "object",
          "content_type",
          "bytes",
          "filename",
          "upload_url",
          "upload_method",
          "upload_headers",
          "expires_at"
        ],
        "additionalProperties": false,
        "description": "Where to send a video's or a sound's bytes before you complete the upload."
      },
      "CharacterList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list",
            "description": "The list object discriminator."
          },
          "url": {
            "type": "string",
            "description": "The list's resource path, such as /v1/records."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            },
            "description": "Resource objects in this page, in the requested order."
          },
          "has_more": {
            "type": "boolean",
            "description": "Whether another page is available using next_cursor."
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$",
                "description": "Opaque next_cursor from the previous page. It works only for the list and filters it came from."
              },
              {
                "type": "null"
              }
            ],
            "description": "Send as cursor to read the next page; null on the last page."
          }
        },
        "required": [
          "object",
          "url",
          "data",
          "has_more",
          "next_cursor"
        ],
        "additionalProperties": false,
        "description": "Forward list envelope. Live lists are not snapshots; totals are not promised."
      },
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The character's ID, `chr_...`. Pass it wherever a model or recipe takes an image file."
          },
          "object": {
            "type": "string",
            "const": "character"
          },
          "beta": {
            "type": "boolean",
            "const": true,
            "description": "This endpoint is in beta: its shape can change, or it can go away, without the 180-day notice stable endpoints get."
          },
          "name": {
            "type": "string",
            "description": "The character's name."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "The picture's file, `file_...`."
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "A signed link to the picture, valid for 24 hours. Read the character again for a fresh one."
                },
                "width": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "height": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "file",
                "url",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "description": "Its pictures, first picture first."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When it was made."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When its name or pictures last changed."
          }
        },
        "required": [
          "id",
          "object",
          "beta",
          "name",
          "images",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "description": "A character your workspace keeps. Put its ID in a run's input in place of an image file, and the run gets its pictures and a description of its look, so it comes out the same every time."
      },
      "DeletedCharacter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The deleted character's ID."
          },
          "object": {
            "type": "string",
            "const": "character"
          },
          "beta": {
            "type": "boolean",
            "const": true,
            "description": "This endpoint is in beta: its shape can change, or it can go away, without the 180-day notice stable endpoints get."
          },
          "deleted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "object",
          "beta",
          "deleted"
        ],
        "additionalProperties": false
      },
      "Credits": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "credits"
          },
          "available_usd": {
            "type": "string",
            "description": "What you can spend now: your balance minus what running generations hold, as an exact decimal string in US dollars."
          },
          "held_usd": {
            "type": "string",
            "description": "What generations still running hold."
          },
          "welcome": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "granted",
                  "withheld",
                  "none"
                ],
                "description": "`granted` when your workspace got the welcome credit; `withheld` when it was due one but its sign-up went past the limits that stop sign-up farms, so none will come; `none` when it isn't a workspace that gets one. Workspaces made since 2026-10-14 get no welcome credit and read `none`."
              },
              "amount_usd": {
                "type": "string",
                "description": "How much was granted, as an exact decimal string in US dollars; `0.000000` unless `granted`."
              }
            },
            "required": [
              "status",
              "amount_usd"
            ],
            "additionalProperties": false,
            "description": "The one-time welcome credit that workspaces made before 2026-10-14 could get."
          },
          "auto_top_up": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Whether auto top-up is on: when the balance falls below `threshold_usd`, it adds `amount_usd` from the card your last top-up saved."
              },
              "threshold_usd": {
                "description": "The balance it tops up below, as an exact decimal string in US dollars; null until it is set.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount_usd": {
                "description": "What each automatic top-up adds, as an exact decimal string in US dollars; null until it is set. From $20 there is no card fee.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "enabled",
              "threshold_usd",
              "amount_usd"
            ],
            "additionalProperties": false,
            "description": "Auto top-up, which keeps your keys running when the balance runs low. Turn it on at `add_credits_url`."
          },
          "add_credits_url": {
            "type": "string",
            "description": "Where a person adds credit and turns on auto top-up, in the studio."
          }
        },
        "required": [
          "object",
          "available_usd",
          "held_usd",
          "welcome",
          "auto_top_up",
          "add_credits_url"
        ],
        "additionalProperties": false,
        "description": "Your workspace's balance."
      }
    },
    "headers": {
      "X-Request-Id": {
        "required": true,
        "description": "This request's ID. Include it when you contact support; it's also `request_id` in an error.",
        "schema": {
          "type": "string",
          "description": "This request's ID. Include it when you contact support; it's also `request_id` in an error.",
          "example": "req_01J9Z8Q4N2K7T5V3X6Y8B0C1D2"
        }
      },
      "RateLimit-Limit": {
        "required": true,
        "description": "Requests allowed per window from your client.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Requests allowed per window from your client.",
          "example": 300
        }
      },
      "RateLimit-Remaining": {
        "required": true,
        "description": "Requests left in the current window.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Requests left in the current window.",
          "example": 299
        }
      },
      "RateLimit-Reset": {
        "required": true,
        "description": "Seconds until the window resets.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seconds until the window resets.",
          "example": 42
        }
      },
      "Retry-After": {
        "required": true,
        "description": "Seconds to wait before you retry.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seconds to wait before you retry.",
          "example": 42
        }
      }
    },
