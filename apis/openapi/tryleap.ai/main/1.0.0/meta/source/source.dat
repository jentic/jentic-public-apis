                      "type": "null"
                    }
                  ],
                  "description": "Your server's HTTP status; null when it never answered."
                },
                "error": {
                  "description": "Why the try failed, when your server did not answer 2xx, such as a timeout.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "How long the try took."
                }
