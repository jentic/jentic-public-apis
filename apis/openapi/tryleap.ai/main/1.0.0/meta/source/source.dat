    "/v1/characters": {
      "get": {
        "operationId": "listCharacters",
        "summary": "List characters",
        "description": "Your workspace's characters, newest first, the ones made in the studio included.\n\nNeeds an API key with the `generations:read` scope.",
        "tags": [
          "Characters"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of rows to return: 1 to 100; default 50.",
              "type": "string",
              "pattern": "^\\d{1,3}$"
            },
            "description": "Maximum number of rows to return: 1 to 100; default 50."
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Send next_cursor as cursor; omit it for the first page.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
            },
            "description": "Send next_cursor as cursor; omit it for the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of characters.",
            "headers": {
