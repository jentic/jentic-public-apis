    "/v1/batches": {
      "post": {
        "operationId": "createBatch",
        "summary": "Create a batch",
        "description": "Starts up to 50 generations in one request. They're priced and held together, so either all start or none do, and each then runs as its own generation with this batch's `batch_id`. Read each one with `GET /v1/generations/{id}`. One request that would sexualise a real person from a photo you uploaded refuses the whole batch with `422 sexualized_real_person`.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Batches"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "description": "A key you generate for this request, such as a UUID, so a retry never starts a second run. A retry with the same key and body returns the same generation as it is now, marked `Idempotent-Replayed: true`. The same key with a different body is a `409`. A key belongs to your workspace and doesn't expire, so use a new one for each new request.",
              "example": "7f1c2a9e-3b4d-4e8a-9c21-5d0f6a7b8c90",
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            "description": "A key you generate for this request, such as a UUID, so a retry never starts a second run. A retry with the same key and body returns the same generation as it is now, marked `Idempotent-Replayed: true`. The same key with a different body is a `409`. A key belongs to your workspace and doesn't expire, so use a new one for each new request."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requests": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9.-]*(@[1-9][0-9]{0,3})?$",
                          "description": "The model to call, as creator/name. GET /v1/models lists them."
                        },
                        "input": {
                          "default": {},
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "webhook": {
                          "description": "An https URL to POST the generation.succeeded, generation.failed or generation.canceled event to when the run ends, signed with your workspace's default secret (GET /v1/webhooks/default/secret).",
                          "type": "string",
                          "maxLength": 2048,
                          "format": "uri"
                        }
                      },
                      "required": [
                        "model"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Up to 50 generations, each a model and its input. All are priced and held together."
                  }
                },
                "required": [
                  "requests"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The batch, with each generation queued.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "const": "true",
                  "description": "Present when this answer replays the first request sent with the same `Idempotency-Key`."
                }
              }
            },
            "content": {
