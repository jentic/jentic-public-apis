    "/v1/webhook_endpoints/{id}/rotate_secret": {
      "post": {
        "operationId": "rotateWebhookSecret",
        "summary": "Rotate a webhook secret",
        "description": "Makes a new signing secret and returns it, shown only here. For 24 hours the old secret signs too, as a second signature in `webhook-signature`, so you can deploy the new one without dropping events. Rotating again within those 24 hours drops the oldest.\n\nNeeds an API key with the `generations:write` scope.",
        "tags": [
          "Webhooks"
        ],
