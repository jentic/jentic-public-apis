    "/v1/credits": {
      "get": {
        "operationId": "retrieveCredits",
        "summary": "Retrieve your balance",
        "description": "What your workspace can spend now, what running generations hold, whether auto top-up will add more when it runs low, and whether it got the welcome credit, which workspaces made since 2026-10-14 don't get. Add credits and turn on auto top-up at `add_credits_url`; your first top-up has no card fee, and none from $20.\n\nNeeds an API key with the `generations:read` scope.",
        "tags": [
          "Credits"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "The balance.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "object": "credits",
                  "available_usd": "4.670000",
                  "held_usd": "0.800000",
                  "welcome": {
                    "status": "none",
                    "amount_usd": "0.000000"
                  },
                  "auto_top_up": {
                    "enabled": true,
                    "threshold_usd": "5.000000",
                    "amount_usd": "20.000000"
                  },
                  "add_credits_url": "https://app.tryleap.ai/go/settings/credits"
                },
                "schema": {
                  "$ref": "#/components/schemas/Credits"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ConflictingCredentials"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerationRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9.-]*(@[1-9][0-9]{0,3})?$",
            "description": "The model or preset to run, such as `black-forest-labs/flux-2-pro` or `leap/restore-photo@1`. A preset ID without `@N` runs its latest version."
          },
          "input": {
            "default": {},
            "description": "The model's input, as its `input_schema` from `GET /v1/models/{creator}/{name}` describes it. Fields you leave out take their defaults; unknown fields are refused. Files are `file_...` IDs.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "webhook": {
            "description": "An https URL to POST the generation.succeeded, generation.failed or generation.canceled event to when the run ends, signed with your workspace's default secret (GET /v1/webhooks/default/secret).",
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "model"
        ],
        "additionalProperties": false
      },
      "WebhookEndpointRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Where Leap POSTs events: an https URL that answers 2xx within 15 seconds."
          },
          "events": {
            "description": "The event types to send. [\"*\"], the default, sends every type, including types added later.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "*",
                "generation.succeeded",
                "generation.failed",
                "generation.canceled",
                "batch.completed"
              ]
            }
          },
          "description": {
            "default": null,
            "description": "A note for people, such as which app this is.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "WebhookEndpointUpdate": {
        "type": "object",
        "properties": {
          "url": {
            "description": "A new https URL for the endpoint.",
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "events": {
            "description": "The event types to send, replacing the current list. [\"*\"] sends every type.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "*",
                "generation.succeeded",
                "generation.failed",
                "generation.canceled",
                "batch.completed"
              ]
            }
          },
          "description": {
            "description": "A new note; null clears it.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "disabled": {
            "description": "true stops deliveries to the endpoint; false starts them again and clears disabled_reason.",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/webm",
              "audio/mpeg",
              "audio/mp3",
              "audio/wav",
              "audio/x-wav",
              "audio/wave",
              "audio/mp4",
              "audio/x-m4a"
            ],
            "description": "The file's type: MP4, MOV or WebM video; MP3, WAV or M4A audio."
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1073741824,
            "description": "The file's exact size in bytes."
          },
          "filename": {
            "description": "A name to keep with the file, such as `interview.mp4`.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "content_type",
          "bytes"
        ],
        "additionalProperties": false
      },
      "CharacterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "What you call the character, up to 40 characters. Leap never puts it in a picture unless your prompt does."
          },
          "images": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "1 to 4 pictures of the character, by file ID (`file_...`, from POST /v1/files or a run's result). The first one shows it; more angles keep it closer."
          }
        },
        "required": [
          "name",
          "images"
        ],
        "additionalProperties": false
      },
      "CharacterUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "description": "A new name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "images": {
            "description": "New pictures, in place of all the old ones. Leap reads its look again from them.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            },
            "description": "Every model and preset at once. The catalog isn't paginated."
          }
        },
        "required": [
          "object",
          "data"
        ],
        "additionalProperties": false
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9.-]*(@[1-9][0-9]{0,3})?$",
            "description": "The ID to run it by: `creator/name` for a model, `leap/name@N` for a preset."
          },
          "object": {
            "type": "string",
            "const": "model"
          },
          "type": {
            "type": "string",
            "enum": [
              "model",
              "preset"
            ],
            "description": "`model` for a raw model, `preset` for a ready-made recipe built on one."
          },
          "name": {
            "type": "string",
            "description": "Its display name."
          },
          "creator": {
            "type": "string",
            "description": "Who made it."
          },
          "modality": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "3d",
              "text"
            ],
            "description": "What it makes: `image`, `video`, `audio`, `3d` or `text`."
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "text-to-image",
                "image-edit",
                "outpaint",
                "upscale-image",
                "remove-background",
                "try-on",
                "text-to-video",
                "image-to-video",
                "video-to-video",
                "upscale-video",
                "lip-sync",
                "talking-avatar",
                "text-to-speech",
                "voice-clone",
                "text-to-music",
                "sound-effects",
                "image-to-3d",
                "text-to-3d",
                "video-to-audio",
                "speech-to-speech",
                "motion-transfer",
                "speech-to-text",
                "captions"
              ]
            },
            "description": "What it does, main task first, such as `text-to-image` or `image-to-video`."
          },
