          "photo": {
            "description": "For an effect: what its photo must show. `framing` is the least of the person it needs, `full` (head to toe), `waist` (waist up) or `face`; `setting` is `outdoor` when it needs sky or open ground around them, `any` otherwise. Check a photo against it with `POST /v1/photo-checks`.",
            "type": "object",
            "properties": {
              "framing": {
                "type": "string",
                "enum": [
                  "full",
                  "waist",
                  "face"
                ]
              },
              "setting": {
                "type": "string",
                "enum": [
                  "outdoor",
                  "any"
                ]
              }
            },
            "required": [
              "framing",
              "setting"
            ],
            "additionalProperties": false
          },
          "still": {
            "description": "For a video recipe that makes a still from the photo first: the frame of the clip it becomes (`first_frame` or `last_frame`, or `images` for a storyboard sheet the clip follows as its first reference image, or `character_image` for the performer a reference clip moves), and whether it shows as the generation's `preview` while the clip renders (never for `images`). Absent for a recipe that makes none.",
            "type": "object",
            "properties": {
              "becomes": {
                "type": "string",
                "enum": [
                  "first_frame",
                  "last_frame",
                  "images",
                  "character_image"
                ]
              },
              "preview": {
                "type": "boolean"
              }
            },
            "required": [
              "becomes",
              "preview"
            ],
            "additionalProperties": false
          },
          "expected_seconds": {
            "description": "How long Leap's own runs of it took at its defaults, in seconds, from the request to the stored file. A hint for how long to wait, not a promise. Absent until Leap has timed one.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "first_image_free": {
            "description": "`true` for a picture whose first run, at its defaults, is free for a new person in the Leap studio: one image, once per person. A run started with an API key or over MCP is never free. Absent for everything else.",
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "name",
          "creator",
          "modality",
          "tasks",
          "description",
          "revision",
          "version",
          "latest",
          "status",
