{
  "openapi": "3.0.3",
  "info": {
    "title": "Robust Intelligence API",
    "description": "Robust Intelligence (RIME) AI security platform API. Manage AI firewall rules, run stress tests, create projects, monitor model performance, and manage data security for ML models.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.robustintelligence.com/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://{instance}.robustintelligence.com/api",
      "description": "Robust Intelligence instance API",
      "variables": {
        "instance": {
          "default": "app",
          "description": "Your Robust Intelligence instance subdomain"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List Projects",
        "description": "List all projects in the workspace.",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of results per page"
          },
          {
            "name": "page_token",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pagination token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "next_page_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create Project",
        "description": "Create a new project for organizing tests and firewalls.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Project name"
                  },
                  "description": {
                    "type": "string"
                  },
                  "model_task": {
                    "type": "string",
                    "enum": [
                      "MODEL_TASK_BINARY_CLASSIFICATION",
                      "MODEL_TASK_MULTI_CLASS_CLASSIFICATION",
                      "MODEL_TASK_REGRESSION",
                      "MODEL_TASK_NAMED_ENTITY_RECOGNITION",
                      "MODEL_TASK_TEXT_GENERATION",
                      "MODEL_TASK_FILL_MASK",
                      "MODEL_TASK_OBJECT_DETECTION"
                    ],
                    "description": "The ML model task type"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project_id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Get Project",
        "description": "Get project details by ID.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete Project",
        "description": "Delete a project.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project deleted"
          }
        }
      }
    },
    "/v1/test-runs": {
      "get": {
        "operationId": "listTestRuns",
        "summary": "List Test Runs",
        "description": "List all stress test runs.",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by project ID"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of test runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "test_runs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TestRun"
                      }
                    },
                    "next_page_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "startTestRun",
        "summary": "Start Test Run",
        "description": "Start a new stress test run against a model.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "test_config"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "test_config": {
                    "type": "object",
                    "description": "Test configuration including model and data info"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test run started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestRun"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test-runs/{test_run_id}": {
      "get": {
        "operationId": "getTestRun",
        "summary": "Get Test Run",
        "description": "Get details and results of a specific test run.",
        "parameters": [
          {
            "name": "test_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test run details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestRun"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test-runs/{test_run_id}/results": {
      "get": {
        "operationId": "getTestRunResults",
        "summary": "Get Test Run Results",
        "description": "Get detailed results for a completed test run.",
        "parameters": [
          {
            "name": "test_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test run results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/firewall-rules": {
      "get": {
        "operationId": "listFirewallRules",
        "summary": "List Firewall Rules",
        "description": "List all AI firewall rules.",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of firewall rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "firewall_rules": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createFirewallRule",
        "summary": "Create Firewall Rule",
        "description": "Create a new AI firewall rule.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "rule_config": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firewall rule created"
          }
        }
      }
    },
    "/v1/firewall/validate": {
      "post": {
        "operationId": "validateInput",
        "summary": "Validate Input",
        "description": "Validate an input against AI firewall rules. Returns whether the input passes or fails the configured rules.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "input"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "input": {
                    "type": "object",
                    "description": "The input data to validate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "ALLOW",
                        "BLOCK",
                        "FLAG"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/datasets": {
      "get": {
        "operationId": "listDatasets",
        "summary": "List Datasets",
        "description": "List registered datasets.",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of datasets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerDataset",
        "summary": "Register Dataset",
        "description": "Register a dataset for testing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "data_info": {
                    "type": "object"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dataset registered"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List Models",
        "description": "List registered models.",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerModel",
        "summary": "Register Model",
        "description": "Register a model for testing and monitoring.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "model_info": {
                    "type": "object"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model registered"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "rime-api-key",
        "description": "Robust Intelligence API key"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "model_task": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TestRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "test_config": {
            "type": "object"
          }
        }
      }
    }
  }
}
