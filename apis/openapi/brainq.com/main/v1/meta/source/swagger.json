            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/domain.AppError"
            }
          },
          "500": {
            "description": "Internal error",
            "schema": {
              "$ref": "#/definitions/domain.AppError"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
