{
  "openapi": "3.0.3",
  "info": {
    "title": "Education API",
    "description": "Образовательная платформа с элементами геймификации.\n\n**Основные возможности:**\n- Рейтинг и достижения студентов\n- Внутренняя валюта за активность\n- Мгновенная публикация материалов\n- Обратная связь в реальном времени\n- Опросы и викторины\n- Отметка о присутствии\n- Анкетирование после пар\n\n**Роли пользователей:**\n- student - студент\n- teacher - преподаватель  \n- admin - администратор\n",
    "version": "1.0.0",
    "contact": {
      "name": "Education Team",
      "email": "support@education.ru"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/valentinpotapov3/education-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.education.ru",
      "description": "Продакшен сервер"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Аутентификация и авторизация"
    },
    {
      "name": "Users",
      "description": "Управление пользователями"
    },
    {
      "name": "Courses",
      "description": "Курсы и прогресс обучения"
    },
    {
      "name": "Materials",
      "description": "Учебные материалы"
    },
    {
      "name": "Polls",
      "description": "Опросы и голосования"
    },
    {
      "name": "Achievements",
      "description": "Достижения и награды"
    },
    {
      "name": "Feedback",
      "description": "Обратная связь"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Вход в систему",
        "description": "Аутентификация пользователя по логину и паролю",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "student1"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный вход",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неверные учетные данные"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Регистрация нового пользователя",
        "description": "Создание новой учетной записи студента",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "example": "Иван Иванов"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "ivan@edu.ru"
                  },
                  "username": {
                    "type": "string",
                    "example": "ivanov"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "confirm_password": {
                    "type": "string",
                    "example": "password123"
                  }
                },
                "required": [
                  "full_name",
                  "email",
                  "username",
                  "password",
                  "confirm_password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь успешно зарегистрирован"
          },
          "400": {
            "description": "Ошибка валидации или пользователь уже существует"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Выход из системы",
        "responses": {
          "200": {
            "description": "Успешный выход"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получить данные текущего пользователя",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Данные пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/User"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "achievements_count": {
                          "type": "integer",
                          "example": 3
                        },
                        "courses_count": {
                          "type": "integer",
                          "example": 2
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получить данные пользователя по ID",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Пользователь не найден"
          }
        }
      }
    },
    "/api/courses": {
      "get": {
        "tags": [
          "Courses"
        ],
        "summary": "Получить список курсов",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список курсов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/my": {
      "get": {
        "tags": [
          "Courses"
        ],
        "summary": "Получить курсы текущего пользователя",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Курсы пользователя с прогрессом",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Course"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "progress": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100,
                            "example": 75
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/{id}/materials": {
      "get": {
        "tags": [
          "Courses",
          "Materials"
        ],
        "summary": "Получить материалы курса",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Материалы курса",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Material"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/materials": {
      "post": {
        "tags": [
          "Materials"
        ],
        "summary": "Загрузить учебный материал (только для преподавателей)",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "course_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "Лекция 1: Введение"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "lecture",
                      "presentation",
                      "homework",
                      "methodology"
                    ],
                    "example": "lecture"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "course_id",
                  "title",
                  "type",
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Материал успешно загружен"
          },
          "403": {
            "description": "Недостаточно прав"
          },
          "500": {
            "description": "Ошибка загрузки"
          }
        }
      }
    },
    "/api/polls": {
      "get": {
        "tags": [
          "Polls"
        ],
        "summary": "Получить активные опросы",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список активных опросов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Poll"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Polls"
        ],
        "summary": "Создать опрос (только для преподавателей)",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Оценка понимания материала"
                  },
                  "course_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question_text": {
                          "type": "string",
                          "example": "Насколько вы поняли материал?"
                        },
                        "question_type": {
                          "type": "string",
                          "enum": [
                            "single_choice",
                            "multiple_choice",
                            "text"
                          ],
                          "example": "single_choice"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "Полностью понял",
                            "В основном понял",
                            "Понял частично",
                            "Почти ничего не понял"
                          ]
                        }
                      },
                      "required": [
                        "question_text",
                        "question_type"
                      ]
                    }
                  }
                },
                "required": [
                  "title",
                  "course_id",
                  "questions"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Опрос создан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "title": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Недостаточно прав"
          }
        }
      }
    },
    "/api/polls/{id}/vote": {
      "post": {
        "tags": [
          "Polls"
        ],
        "summary": "Проголосовать в опросе",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "selected_options": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "example": [
                            2
                          ]
                        },
                        "text_answer": {
                          "type": "string",
                          "example": "Мой ответ..."
                        }
                      }
                    }
                  }
                },
                "required": [
                  "answers"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Голос принят"
          },
          "400": {
            "description": "Уже голосовал в этом опросе или неверные данные"
          },
          "404": {
            "description": "Опрос или вопрос не найден"
          }
        }
      }
    },
    "/api/achievements": {
      "get": {
        "tags": [
          "Achievements"
        ],
        "summary": "Получить все достижения системы",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список достижений",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Achievement"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/achievements/my": {
      "get": {
        "tags": [
          "Achievements"
        ],
        "summary": "Получить достижения текущего пользователя",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Достижения пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Achievement"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Отправить обратную связь",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "enum": [
                      "Вопрос по материалу",
                      "Техническая проблема",
                      "Предложение по улучшению",
                      "Другое"
                    ],
                    "example": "Вопрос по материалу"
                  },
                  "message": {
                    "type": "string",
                    "example": "Не понял тему про базы данных"
                  },
                  "anonymous": {
                    "type": "boolean",
                    "example": true
                  }
                },
                "required": [
                  "topic",
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Обратная связь отправлена"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получить рейтинг студентов",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Количество студентов на странице"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Номер страницы"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Смещение (альтернатива page)"
          }
        ],
        "responses": {
          "200": {
            "description": "Топ студентов по рейтингу с пагинацией",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "students": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rank": {
                            "type": "integer",
                            "example": 1
                          },
                          "username": {
                            "type": "string",
                            "example": "student1"
                          },
                          "full_name": {
                            "type": "string",
                            "example": "Иван Петров"
                          },
                          "rating": {
                            "type": "integer",
                            "example": 1850
                          },
                          "currency": {
                            "type": "integer",
                            "example": 1250
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "example": 150
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "limit": {
                          "type": "integer",
                          "example": 10
                        },
                        "pages": {
                          "type": "integer",
                          "example": 15
                        },
                        "has_next": {
                          "type": "boolean",
                          "example": true
                        },
                        "has_prev": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PHPSESSID",
        "description": "Сессия PHP аутентификации"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "student1"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "student1@edu.ru"
          },
          "full_name": {
            "type": "string",
            "example": "Иван Петров"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "admin"
            ],
            "example": "student"
          },
          "currency": {
            "type": "integer",
            "minimum": 0,
            "example": 1250
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "example": 1850
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-15T10:30:00Z"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Веб-разработка"
          },
          "description": {
            "type": "string",
            "example": "HTML, CSS, JavaScript и фреймворки"
          },
          "teacher_id": {
            "type": "integer",
            "example": 3
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-15T10:30:00Z"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "Material": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "course_id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Лекция 1: Введение в HTML"
          },
          "file_path": {
            "type": "string",
            "example": "/materials/web_lecture1.pdf"
          },
          "type": {
            "type": "string",
            "enum": [
              "lecture",
              "presentation",
              "homework",
              "methodology"
            ],
            "example": "lecture"
          },
          "uploaded_by": {
            "type": "integer",
            "example": 3
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-15T10:30:00Z"
          }
        },
        "required": [
          "id",
          "course_id",
          "title"
        ]
      },
      "Poll": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Оценка курса \"Веб-разработка\""
          },
          "course_id": {
            "type": "integer",
            "example": 1
          },
          "created_by": {
            "type": "integer",
            "example": 3
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
