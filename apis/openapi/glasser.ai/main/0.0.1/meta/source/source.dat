        "description": "US property values, rent estimates, property records, for-sale and rental listings, ZIP-code market statistics, and stock quotes. Providers: RentCast, SerpApi. Routes to one Endpoint per action; provider auto picks the first preferred Provider this key may run, a named provider forces it. The response is exactly the Run that POST /v1/runs returns — provider-native output, exact charge_usd, run_url; its provider, endpoint and input say which Endpoint served the call. Under auto, a Provider error, timeout or rate limit falls back to the next preferred Provider; a no-result answer does not. Each fallback hop is its own Run, visible in the runs list. Idempotency-Key is required and behaves exactly as on POST /v1/runs.",
        "summary": "Market data",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "property_value",
                      "property_rent",
                      "property_search",
                      "listings_sale",
                      "listings_rental",
                      "market_stats",
                      "stock_quote"
                    ],
                    "description": "property_value and property_rent take address. property_search, listings_sale and listings_rental take address, or city plus state, or zip. market_stats takes zip. stock_quote takes symbol."
                  },
                  "provider": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "auto",
                          "rentcast",
                          "serpapi"
                        ],
                        "description": "Data provider: auto (default) or one of rentcast, serpapi. Name one only when the caller asks for that vendor."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "address": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "city": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z]{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "zip": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "symbol": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100,
                        "description": "Rows to return. Keep it small: the routed Endpoint's charge rule may read it. Each capability caps it further."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "task_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "The task this call belongs to. Reuse one value across the calls you make for one piece of work; under provider auto each fallback hop is its own run, and this is what records them as one task. Any stable string is accepted."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "metadata": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "maxProperties": 20,
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{0,39}$"
                            }
                          },
                          {}
                        ],
                        "description": "Your own key-value strings for this call, for your records: up to 20 keys (lowercase letters, digits and underscores, starting with a letter, at most 40 characters), string values of 1–500 characters. An entry that breaks these rules is dropped whole, never truncated, and the call goes ahead; the run returns the metadata that was stored. Glasser returns it on the Run and lets you filter runs by it; it never goes to a provider and never affects routing, price or idempotency. Put the id of your own end user in user_id. Use an opaque id, never an email address or a name."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "x-mint": {
          "href": "/api-reference/solutions/gtm/market_data"
        }
      }
    },
    "/v1/endpoints/search": {
      "post": {
        "tags": [
          "Endpoints"
        ],
        "operationId": "endpoints-search",
        "parameters": [],
