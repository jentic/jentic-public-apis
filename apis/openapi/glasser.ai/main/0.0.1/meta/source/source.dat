            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedEncoded"
                }
              }
            }
          }
        },
        "description": "Returns the balance triple: balance (settled funds), held (reservations for in-flight runs), and available (balance minus held — the number a new run is admitted against). This is also the cheapest authentication probe.",
        "summary": "Get balance, held and available",
        "x-mint": {
          "href": "/api-reference/balance/get"
        }
      }
    },
    "/v1/balance/history": {
      "get": {
        "tags": [
          "Balance"
        ],
        "operationId": "balance-history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "charge",
                    "refund",
                    "topup",
                    "grant",
                    "adjustment"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "charge",
                              "refund",
                              "topup",
                              "grant",
                              "adjustment"
                            ]
                          },
                          "amount_usd": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9]\\d*)\\.(\\d{2}|\\d{2}\\d{0,3}[1-9])$"
                          },
                          "balance_after_usd": {
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)\\.(\\d{2}|\\d{2}\\d{0,3}[1-9])$",
                            "description": "Exact USD decimal string (min 2, max 6 decimals, one canonical spelling). Sum with decimal arithmetic or scale by 10^6 — never floats."
                          },
                          "run_id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "description": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "description": "ISO-8601 UTC timestamp",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "amount_usd",
                          "balance_after_usd",
                          "run_id",
                          "description",
                          "created_at"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next_cursor": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "client": {
                      "type": "object",
                      "properties": {
                        "client_version": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "minimum_version": {
                          "type": "string"
                        },
                        "latest_version": {
                          "type": "string"
                        },
                        "upgrade_command": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "client_version",
                        "minimum_version",
                        "latest_version",
                        "upgrade_command",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data",
                    "next_cursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "ValidationFailed",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationFailedEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationFailedEncoded"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "429": {
            "description": "RateLimited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedEncoded"
                }
              }
            }
          }
        },
        "description": "Lists every balance movement in reverse time order: charge, refund, topup, grant, and adjustment. Amounts are exact USD decimal strings, signed (a charge is negative): summing them with decimal arithmetic — not floats — reconciles the balance, and each entry carries balance_after_usd. This endpoint uses cursor pagination.",
        "summary": "List every balance movement",
        "x-mint": {
          "href": "/api-reference/balance/history"
        }
      }
    }
  },
