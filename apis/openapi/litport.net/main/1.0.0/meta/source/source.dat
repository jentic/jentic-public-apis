    "/api/v1/tokens/{tokenId}/rotation": {
      "put": {
        "operationId": "changeTokenRotation",
        "summary": "Change a rotating token's rotation interval",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "No precondition header is required or honored. The latest committed, successful write becomes the new state; the latest write always wins. `409 CONCURRENT_CHANGE` means another write to the same token or package landed at the same moment -- retry the same request. A Multi-location token always answers `409 NOT_SUPPORTED`: the phone the proxy is on sets its interval.",
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "intervalSec"
                ],
                "properties": {
                  "intervalSec": {
                    "type": "integer",
                    "description": "Must be one of the token's own rotation.options."
                  }
                }
              }
            }
          }
        },
        "responses": {
