      "put": {
        "operationId": "setPackageAllowedIps",
        "summary": "Set a package's whole allowed-IP list",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "No precondition header is required or honored. The latest committed, successful write becomes the new state; the latest write always wins. `409 CONCURRENT_CHANGE` means another write to the same token or package landed at the same moment -- retry the same request. All-or-nothing: one invalid IP rejects the whole request. Send {\"ips\": []} to clear the list. Limited to 20 writes per 60 seconds per package, in addition to the account-wide key limit.",
        "parameters": [
          {
            "name": "packageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ips"
                ],
                "properties": {
                  "ips": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Exact public IPv4 literal. IPv6 is unsupported; contact support."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageAllowedIpsResponse"
                }
              }
            }
          },
