            "required": true,
            "description": "Required, non-empty. Each value is a customer-selectable pay-per-GB pool's authKey. An unknown or non-selectable key returns INVALID_POOL.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": true,
            "description": "Required. One of country, region, or city.",
            "schema": {
              "type": "string",
              "enum": [
                "country",
                "region",
                "city"
              ]
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Lowercase geo slug. Required when level is region or city.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Lowercase geo slug. Optional; with level city, narrows the list to one state.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Optional search text, trimmed and capped at 80 characters.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Integer 1-100; default 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The previous page's page.nextCursor, sent back unchanged.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Geo options available to every requested pool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayPerGbGeoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pay-per-gb/balance": {
      "get": {
        "operationId": "getPayPerGbBalance",
        "summary": "Read account balance and plan",
        "description": "Returns the authenticated account's current billing balance and plan, to explain an insufficient-balance proxy error.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Account balance and plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayPerGbBalanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lit_<secret>",
        "description": "API key created in /users/settings."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId",
              "docsUrl"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "docsUrl": {
                "type": "string",
                "format": "uri"
              },
              "nextChangeAt": {
                "type": "string",
                "format": "date-time",
                "description": "Present only on a 409 CHANGE_LIMIT."
              }
            }
          }
        }
      },
      "FreeProxy": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "externalIp": {
            "type": [
              "string",
              "null"
            ]
          },
          "geoCountry": {
            "type": [
              "string",
              "null"
            ]
          },
          "geoCountryFlagEmoji": {
            "type": [
              "string",
              "null"
            ]
          },
          "geoRegion": {
            "type": [
              "string",
              "null"
            ]
          },
          "geoCity": {
            "type": [
              "string",
              "null"
            ]
          },
          "geoTimezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "asn": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "asnOrgName": {
            "type": [
              "string",
              "null"
            ]
          },
          "https": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "anonymity": {
            "type": [
              "string",
              "null"
            ]
          },
          "anonymityRating": {
            "type": [
              "integer",
              "null"
            ]
          },
          "anonymityLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "anonymityLevelRating": {
            "type": [
              "integer",
              "null"
            ]
          },
          "responseTimeMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "responseTimeRating": {
            "type": [
              "integer",
              "null"
            ]
          },
          "uptimeRating": {
            "type": [
              "integer",
              "null"
            ]
          },
          "uptime7d": {
            "type": [
              "number",
              "null"
            ]
          },
          "checks7d": {
            "type": [
              "integer",
              "null"
            ]
          },
          "uptime24h": {
            "type": [
              "number",
              "null"
            ]
          },
          "checks24h": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sourcesCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "responseTimeMedianMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "lastAliveAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pingAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "createdAt",
          "ingress",
          "packageId",
          "ipAuth",
          "username",
          "password"
        ],
        "example": {
          "id": 12345,
          "type": "unlimited",
          "status": "active",
          "label": "Production crawler",
          "createdAt": "2026-08-01T10:15:00.000Z",
          "expiresAt": "2026-12-01T00:00:00.000Z",
          "ingress": {
            "hub": "us-11",
            "protocol": "http",
            "mode": "assigned",
            "host": "hub-us-11-1.litport.net",
            "port": 31337,
            "status": "available"
          },
          "packageId": 45,
          "ipAuth": {
            "host": "hub-us-11-1.litport.net",
            "port": 31338
          },
          "location": {
            "country": "us",
            "region": "new-york",
            "city": "new-york-city"
          },
          "rotation": {
            "intervalSec": 600,
            "options": [
              600,
              1800,
              3600
            ],
            "changeable": true
          },
          "username": "proxy-username",
          "password": "proxy-password"
        },
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "unlimited",
              "ppg"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "disabled"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ingress": {
            "type": "object",
            "required": [
              "hub",
              "protocol",
              "mode"
            ],
            "description": "A ppg token is request-selected: hub, protocol and pool are chosen per request, and the ports come from GET /pay-per-gb/pools. An unlimited token is assigned exactly one endpoint and always reports its resolved host and port.",
            "properties": {
              "hub": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "socks5"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "request-selected",
                  "assigned"
                ]
              },
              "supportedProtocols": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "request-selected tokens only."
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "assigned tokens only. null when status is hub-unavailable."
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "assigned tokens only. null when status is hub-unavailable."
              },
              "status": {
                "type": "string",
                "enum": [
                  "available",
                  "hub-unavailable"
                ],
                "description": "assigned tokens only. hub-unavailable means the token names a hub that is no longer in service; contact support to move it."
              }
            }
          },
          "poolSelection": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "auth-parameter",
                  "fixed"
                ]
              },
              "pool": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "authKey",
                      "name"
                    ],
                    "properties": {
                      "authKey": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "packageId": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Public numeric package ID when this token belongs to an owned package, otherwise null."
          },
          "ipAuth": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "host",
                  "port"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The token's passwordless endpoint, or null when it has none right now. It accepts connections only from the package's allowed IPs."
          },
          "location": {
            "description": "Present only on a token whose location can move. See Tokens: Location.",
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "country",
                  "region",
                  "city"
                ],
                "properties": {
                  "country": {
                    "const": "us"
                  },
                  "region": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "country",
                  "city",
                  "carrier"
                ],
                "properties": {
                  "country": {
                    "const": "us"
                  },
                  "city": {
                    "type": "string"
                  },
                  "carrier": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "rotation": {
            "type": "object",
            "description": "Present on every token that rotates on a timer. See Tokens: Rotation.",
            "required": [
              "intervalSec",
              "options",
              "changeable"
            ],
            "properties": {
              "intervalSec": {
                "type": "integer"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "changeable": {
                "type": "boolean"
              }
            }
          },
          "rotateUrl": {
            "type": "string",
            "format": "uri",
            "description": "Private Device only. As secret as the password next to it."
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "TokenList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Token"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "TokenLocationResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tokenId",
              "kind",
              "mode",
              "target",
              "effective",
              "status",
              "canChangeNow",
              "nextChangeAt"
            ],
            "properties": {
              "tokenId": {
                "type": "integer"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "datacenter",
                  "isp",
                  "mobile"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "rotating",
                  "static"
                ]
              },
              "target": {
                "type": "object",
                "description": "Datacenter/ISP: {country, region, city}, either \"any\". Mobile: {country, city, carrier}."
              },
              "effective": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The current IP's actual location, or null when not yet known."
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "ready",
                  "unavailable",
                  "package-inactive",
                  "allowance-exhausted"
                ]
              },
              "canChangeNow": {
                "type": "boolean"
              },
              "nextChangeAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "When a used-up change allowance resets, if it is currently used up."
              }
            }
          }
        }
      },
      "TokenLocationOptionsResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoOption"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "const": null
              }
            }
          }
        }
      },
      "TokenRotationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tokenId",
              "intervalSec",
              "options",
              "changeable"
            ],
            "properties": {
              "tokenId": {
                "type": "integer"
              },
              "intervalSec": {
                "type": "integer"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "changeable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Package": {
        "type": "object",
        "required": [
          "id",
          "status",
          "product",
          "country",
          "quantity",
          "addOns",
          "limits",
          "renewsAt",
          "endsAt",
          "tokenIds"
        ],
        "example": {
          "id": 45,
          "status": "active",
          "product": {
            "key": "dc-shared-rotating",
            "name": "DC Shared Rotating"
          },
          "country": "us",
          "quantity": 2,
          "addOns": [
            "high-speed"
          ],
          "limits": {
            "speedMbps": 20,
            "connections": 300,
            "requestsPerSec": 25
          },
          "renewsAt": "2027-01-01T00:00:00.000Z",
          "endsAt": null,
          "tokenIds": [
            12345,
            12346
          ]
        },
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting-payment",
              "active",
              "suspended",
              "ended",
              "setup-failed"
            ]
          },
          "product": {
            "type": "object",
            "properties": {
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "addOns": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "high-speed",
                "more-allowed-ips",
                "multi-location"
              ]
            }
          },
          "limits": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "speedMbps": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "connections": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "requestsPerSec": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "renewsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "tokenIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "PackageList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Package"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "PackageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Package"
          }
        }
      },
      "PackageAllowedIpsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "packageId",
              "limit",
              "ips",
              "available",
              "unavailableCode"
            ],
            "properties": {
              "packageId": {
                "type": "integer"
              },
              "limit": {
                "type": "integer",
                "enum": [
                  1,
                  50
                ]
              },
              "ips": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "available": {
                "type": "boolean"
              },
              "unavailableCode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "UsageCache": {
        "type": "object",
        "description": "Cache outcomes and successfully served free cached bytes for the period. Byte and saved-cost values are base-10 decimal strings so clients do not lose precision. `savedCostUnits` is present only for PPG tokens and is omitted for unlimited tokens.",
        "required": [
          "hits",
          "misses",
          "bypasses",
          "hitRate",
          "freeUploadedBytes",
          "freeDownloadedBytes",
          "freeTotalBytes"
        ],
        "properties": {
          "hits": {
            "type": "integer",
            "minimum": 0,
            "description": "Eligible requests served from the cache."
          },
          "misses": {
            "type": "integer",
            "minimum": 0,
            "description": "Eligible requests fetched from the origin because no usable entry was present."
          },
          "bypasses": {
            "type": "integer",
            "minimum": 0,
            "description": "Requests that did not use the cache."
          },
          "hitRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "hits divided by hits plus misses; zero when there are no hits or misses."
          },
          "freeUploadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Base-10 decimal string of cached bytes uploaded by the customer."
          },
          "freeDownloadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Base-10 decimal string of cached bytes downloaded by the customer."
          },
          "freeTotalBytes": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Base-10 decimal string equal to freeUploadedBytes plus freeDownloadedBytes."
          },
          "savedCostUnits": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.\\d+)?$",
            "description": "Base-10 decimal string of the PPG charge avoided at the historical price. Omitted for unlimited tokens."
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "required": [
          "requests",
          "uploadedBytes",
          "downloadedBytes",
          "totalBytes",
          "cache"
        ],
        "properties": {
          "requests": {
            "type": "integer"
          },
          "uploadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "downloadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "totalBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "cache": {
            "$ref": "#/components/schemas/UsageCache"
          }
        }
      },
      "UsageDomainItem": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "tcp",
              "udp",
              null
            ]
          },
          "destination": {
            "type": "string"
          },
          "port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "requests": {
            "type": "integer"
          },
          "uploadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "downloadedBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "totalBytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "lastSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "firstSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "UsageDomainBreakdown": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "const": 150
          },
          "totalDestinationCount": {
            "type": "integer"
          },
          "displayedCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "range": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              },
              "timezone": {
                "type": "string",
                "const": "UTC"
              },
              "periodClamped": {
                "type": "boolean"
              },
              "endClamped": {
                "type": "boolean"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageDomainItem"
            }
          },
          "other": {
            "$ref": "#/components/schemas/UsageDomainItem"
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tokenId": {
                "type": "integer"
              },
              "range": {
                "type": "object"
              },
              "trafficBasis": {
                "type": "string",
                "enum": [
                  "customer_chargeable",
                  "observed"
                ],
                "description": "`customer_chargeable` for PPG tokens and `observed` for unlimited tokens."
              },
              "summary": {
                "$ref": "#/components/schemas/UsageTotals"
              },
              "buckets": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/UsageTotals"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              },
              "domainBreakdown": {
                "$ref": "#/components/schemas/UsageDomainBreakdown"
              }
            }
          }
        }
      },
      "PayPerGbHub": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hostname"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          }
        }
      },
      "PayPerGbPool": {
        "type": "object",
        "required": [
          "name",
          "proxiesType",
          "authKey",
          "pricePerGb",
          "httpPort",
          "socks5Port",
          "hubs",
          "geoLevels"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "proxiesType": {
            "type": "string"
          },
          "authKey": {
            "type": "string",
            "description": "The pool-<auth-key> value for the PPG proxy username."
          },
          "pricePerGb": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.\\d+)?$",
            "description": "Base-10 decimal string, already adjusted for the account's plan discount."
          },
          "httpPort": {
            "type": "integer"
          },
          "socks5Port": {
            "type": "integer"
          },
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayPerGbHub"
            }
          },
          "geoLevels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "country",
                "region",
                "city"
              ]
            },
            "description": "Broadest first. Empty when this pool has no geo targeting."
          }
        }
      },
      "PayPerGbPoolsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayPerGbPool"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "const": null
              }
            }
          }
        }
      },
      "GeoOption": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": "string",
            "description": "The exact lowercase slug to send as the matching country, region, or city proxy-username parameter."
          },
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string",
            "description": "Present only for some country-level options."
          },
          "region": {
            "type": "string",
            "description": "Present on city options: the slug of the city's parent state. Send it as the region proxy-username parameter together with the city, because city slugs repeat across states."
          },
          "regionLabel": {
            "type": "string",
            "description": "Present on city options: the display name of the parent state."
          }
        }
      },
      "PayPerGbGeoResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoOption"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "PayPerGbBalanceResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "balance",
              "plan"
            ],
            "properties": {
              "balance": {
                "type": "object",
                "required": [
                  "unitsActive",
                  "unitsReserved",
                  "unitsAvailable",
                  "unitsExpireAt"
                ],
                "properties": {
                  "unitsActive": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(?:\\.\\d+)?$"
                  },
                  "unitsReserved": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.\\d+)?$"
                  },
                  "unitsAvailable": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(?:\\.\\d+)?$"
                  },
                  "unitsExpireAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              },
              "plan": {
                "type": "object",
                "required": [
                  "id",
                  "expiresAt"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
