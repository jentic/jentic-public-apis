{
  "openapi": "3.1.0",
  "info": {
    "title": "Litport API",
    "version": "1.0.0",
    "description": "Public free-proxy retrieval and authenticated account operations (tokens, packages, and pay-per-GB). No endpoint creates or deletes proxy tokens."
  },
  "servers": [
    {
      "url": "https://litport.net"
    }
  ],
  "paths": {
    "/api/free-proxy": {
      "get": {
        "operationId": "listFreeProxies",
        "summary": "List public free proxies",
        "description": "Returns a bare array. Invalid numeric and sort inputs currently fall back to defaults instead of returning 400.",
        "security": [],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Case-insensitive ISO-2 code. The value is uppercased; no aliases are applied.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Accepted range 10–1000. Invalid or out-of-range values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000,
              "default": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Accepted range 1–1000. Invalid or out-of-range values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "Field: pingAt, responseTimeMs, or createdAt. Direction: asc or desc. Invalid values are ignored.",
            "schema": {
              "type": "string",
              "enum": [
                "pingAt_asc",
                "pingAt_desc",
                "responseTimeMs_asc",
                "responseTimeMs_desc",
                "createdAt_asc",
                "createdAt_desc"
              ]
            }
          },
          {
            "name": "anonymity",
            "in": "query",
            "required": false,
            "description": "Exact filter: transparent, anonymous, elite, or unknown. Unknown values usually return an empty array.",
            "schema": {
              "type": "string",
              "enum": [
                "transparent",
                "anonymous",
                "elite",
                "unknown"
              ]
            }
          },
          {
            "name": "anonymityLevel",
            "in": "query",
            "required": false,
            "description": "Deprecated alias: high = anonymous or elite, low = transparent. Exact filter. Unknown values usually return an empty array.",
            "schema": {
              "type": "string",
              "enum": [
                "high",
                "low"
              ],
              "deprecated": true
            }
          },
          {
            "name": "protocol",
            "in": "query",
            "required": false,
            "description": "Exact filter such as http, https, or socks5. Unknown values usually return an empty array.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "list",
            "in": "query",
            "required": false,
            "description": "Named generated-list preset: https (HTTPS-capable), fast (rounded latency below 1000 ms), stable (rounded seven-day uptime at least 90% with at least 50 checks), or anonymous (anonymous or elite). Unknown values are ignored."
          },
          {
            "name": "uptimeRating",
            "in": "query",
            "required": false,
            "description": "Minimum 24-hour uptime percentage, 1–100. Invalid values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "responseTimeMs",
            "in": "query",
            "required": false,
            "description": "Maximum HTTP response time in milliseconds, 1–10000. Invalid values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "checkedWithinMin",
            "in": "query",
            "required": false,
            "description": "Maximum age of pingAt in minutes, 1–1440. Snapshot defaults to 30; timestamps later than request time are excluded by this freshness filter.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "json, csv, txt, or txt-proto. Unknown values fall back to JSON.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "txt",
                "txt-proto"
              ],
              "default": "json"
            }
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "description": "When present for a supported format, returns an attachment.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Free proxies in the requested format.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FreeProxy"
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/free-proxy/snapshot": {
      "get": {
        "operationId": "snapshotFreeProxies",
        "summary": "Retrieve one consistent fresh free-proxy snapshot",
        "description": "Returns the whole matching live dataset in one response. checkedWithinMin defaults to 30 and invalid values return 400.",
        "security": [],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Case-insensitive ISO-2 code. The value is uppercased; no aliases are applied.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "name": "anonymity",
            "in": "query",
            "required": false,
            "description": "Exact filter: transparent, anonymous, elite, or unknown. Unknown values usually return an empty array.",
            "schema": {
              "type": "string",
              "enum": [
                "transparent",
                "anonymous",
                "elite",
                "unknown"
              ]
            }
          },
          {
            "name": "anonymityLevel",
            "in": "query",
            "required": false,
            "description": "Deprecated alias: high = anonymous or elite, low = transparent. Exact filter. Unknown values usually return an empty array.",
            "schema": {
              "type": "string",
              "enum": [
                "high",
                "low"
              ],
              "deprecated": true
            }
          },
          {
            "name": "protocol",
            "in": "query",
            "required": false,
            "description": "Exact filter such as http, https, or socks5. Unknown values usually return an empty array.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "list",
            "in": "query",
            "required": false,
            "description": "Named generated-list preset: https (HTTPS-capable), fast (rounded latency below 1000 ms), stable (rounded seven-day uptime at least 90% with at least 50 checks), or anonymous (anonymous or elite). Unknown values are ignored.",
            "schema": {}
          },
          {
            "name": "uptimeRating",
            "in": "query",
            "required": false,
            "description": "Minimum 24-hour uptime percentage, 1–100. Invalid values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "responseTimeMs",
            "in": "query",
            "required": false,
            "description": "Maximum HTTP response time in milliseconds, 1–10000. Invalid values are ignored.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "checkedWithinMin",
            "in": "query",
            "required": false,
            "description": "Maximum age of pingAt in minutes, 1–1440. Snapshot defaults to 30; timestamps later than request time are excluded by this freshness filter.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A consistent matching snapshot, capped at 20,000 rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "generatedAt",
                    "count",
                    "totalCount",
                    "truncated",
                    "maxAgeMin",
                    "proxies"
                  ],
                  "properties": {
                    "generatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "totalCount": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "maxAgeMin": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440
                    },
                    "proxies": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FreeProxy"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens": {
      "get": {
        "operationId": "listTokens",
        "summary": "List the caller's existing tokens",
        "description": "Returns customer-visible metadata and credentials for the caller's existing tokens. A paged list; see the packageId filter and the shared pagination rule.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Integer 1-100; default 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The previous page's page.nextCursor, sent back unchanged.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "unlimited or ppg.",
            "schema": {
              "type": "string",
              "enum": [
                "unlimited",
                "ppg"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "active, expired, or disabled.",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "expired",
                "disabled"
              ]
            }
          },
          {
            "name": "packageId",
            "in": "query",
            "required": false,
            "description": "An owned package's public numeric ID. An unknown or foreign value returns an empty list. A malformed value is INVALID_PACKAGE_ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned token metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenList"
                }
              }
            }
          },
          "400": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}": {
      "get": {
        "operationId": "getToken",
        "summary": "Read one owned token",
        "description": "Returns the identical customer-visible shape as a matching element of GET /tokens, including proxy credentials.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The owned token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Token"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}/usage": {
      "get": {
        "operationId": "getTokenUsage",
        "summary": "Read usage for one owned token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "month"
              ],
              "default": "day"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated optional expansions. Use `domains` for destinations, or `charges` with a PPG token and `groupBy=hour` for persisted charge components.",
            "schema": {
              "type": "string",
              "example": "domains,charges"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-visible traffic summary and sparse ascending buckets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}/location": {
      "get": {
        "operationId": "getTokenLocation",
        "summary": "Read one token's saved and effective location",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved target, current effective location, and change status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenLocationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "changeTokenLocation",
        "summary": "Choose a movable token's location (datacenter/ISP region+city, or mobile city+carrier)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "No precondition header is required or honored. The latest committed, successful write becomes the new state; the latest write always wins. `409 CONCURRENT_CHANGE` means another write to the same token or package landed at the same moment -- retry the same request. A rotating datacenter/ISP or Multi-location token moves at once, with no waiting period. A static datacenter/ISP token, or a standard US Shared Mobile token, uses its once-a-week or once-per-48-hour allowance; a repeat inside that window is `409 CHANGE_LIMIT` with `nextChangeAt`. A PUT identical to the currently saved target succeeds without a new change. For any mobile token, a carrier with no working phone in the chosen city falls back to another carrier in the same city; `effective` reports which one.",
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "region",
                      "city"
                    ],
                    "properties": {
                      "region": {
                        "type": "string",
                        "description": "A canonical US state slug from location/options, or \"any\"."
                      },
                      "city": {
                        "type": "string",
                        "description": "A canonical city slug from location/options, or \"any\"."
                      },
                      "country": {
                        "type": "string",
                        "const": "us"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "city",
                      "carrier"
                    ],
                    "properties": {
                      "city": {
                        "type": "string"
                      },
                      "carrier": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string",
                        "const": "us"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated location state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenLocationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A method this path does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}/location/options": {
      "get": {
        "operationId": "listTokenLocationOptions",
        "summary": "List the values currently usable for a token's next location field",
        "description": "A complete list: every currently usable option, always with page.nextCursor: null.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "region",
                "city",
                "carrier"
              ]
            },
            "description": "Datacenter/ISP: region, then city. Mobile: city, then carrier."
          },
          {
            "name": "region",
            "in": "query",
            "description": "Required when level=city for a datacenter/ISP token.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Required when level=carrier for a mobile token.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usable values for this token, right now.",
