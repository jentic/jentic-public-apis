    "/api/v1/tokens/{tokenId}/new-ip": {
      "post": {
        "operationId": "replaceTokenIp",
        "summary": "Get a new IP in the same location (static datacenter/ISP only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "No request body. Reuses the token's own saved location on every attempt, including a retry. Uses the once-a-week replacement allowance; a repeat inside that week is `409 CHANGE_LIMIT` with `nextChangeAt`. This is the one write that is not safe to repeat blindly: on an ambiguous result, read GET .../location first and retry only when `nextChangeAt` is not already later than the current time.",
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated location state, with a new effective IP.",
