{
  "openapi": "3.0.3",
  "info": {
    "title": "Unstructured API",
    "description": "API for document parsing, partitioning, chunking, and embedding. Supports on-demand processing jobs for extracting structured data from unstructured documents.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.unstructured.io/api-reference/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.unstructuredapp.io",
      "description": "Unstructured Platform API"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/general/v0/general": {
      "post": {
        "operationId": "partitionDocument",
        "summary": "Partition a document into structured elements",
        "description": "Accepts a document file and returns structured elements extracted from the content including text, tables, images, and metadata.",
        "tags": [
          "Partition"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "string",
                    "format": "binary",
                    "description": "The document file to partition"
                  },
                  "strategy": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "fast",
                      "hi_res",
                      "ocr_only"
                    ],
                    "default": "auto",
                    "description": "Partitioning strategy"
                  },
                  "hi_res_model_name": {
                    "type": "string",
                    "description": "Model name for hi_res strategy"
                  },
                  "coordinates": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include element coordinates in response"
                  },
                  "encoding": {
                    "type": "string",
                    "description": "File encoding"
                  },
                  "ocr_languages": {
                    "type": "string",
                    "description": "OCR languages (comma-separated)"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "application/json",
                      "text/csv"
                    ],
                    "default": "application/json",
                    "description": "Output format"
                  },
                  "include_page_breaks": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include page break elements"
                  },
                  "chunking_strategy": {
                    "type": "string",
                    "enum": [
                      "basic",
                      "by_title",
                      "by_page",
                      "by_similarity"
                    ],
                    "description": "Chunking strategy to apply"
                  },
                  "max_characters": {
                    "type": "integer",
                    "description": "Maximum characters per chunk"
                  },
                  "new_after_n_chars": {
                    "type": "integer",
                    "description": "Soft maximum for chunk size"
                  },
                  "combine_under_n_chars": {
                    "type": "integer",
                    "description": "Combine small elements under this character count"
                  },
                  "overlap": {
                    "type": "integer",
                    "description": "Number of characters to overlap between chunks"
                  },
                  "overlap_all": {
                    "type": "boolean",
                    "description": "Apply overlap between all chunks"
                  },
                  "xml_keep_tags": {
                    "type": "boolean",
                    "description": "Keep XML tags in output"
                  },
                  "skip_infer_table_types": {
                    "type": "string",
                    "description": "Comma-separated file types to skip table inference"
                  },
                  "pdf_infer_table_structure": {
                    "type": "boolean",
                    "default": true,
                    "description": "Infer table structure from PDFs"
                  },
                  "languages": {
                    "type": "string",
                    "description": "Document languages (comma-separated ISO 639-1)"
                  },
                  "extract_image_block_types": {
                    "type": "string",
                    "description": "Element types to extract as image blocks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Partitioned document elements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Element"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/jobs": {
      "post": {
        "operationId": "createJob",
        "summary": "Create an on-demand processing job",
        "tags": [
          "Jobs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template_id": {
                    "type": "string",
                    "description": "Workflow template ID"
                  },
                  "job_nodes": {
                    "type": "array",
                    "description": "Job node configurations",
                    "items": {
                      "type": "object",
                      "properties": {
                        "node_type": {
                          "type": "string"
                        },
                        "settings": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "input_files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "File IDs to process"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "operationId": "listJobs",
        "summary": "List processing jobs",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed"
              ]
            },
            "description": "Filter by job status"
          }
        ],
        "responses": {
          "200": {
            "description": "List of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get job status and details",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/jobs/{job_id}/output": {
      "get": {
        "operationId": "downloadJobOutput",
        "summary": "Download processed job output",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job ID"
          },
          {
            "name": "file_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Specific file ID to download"
          }
        ],
        "responses": {
          "200": {
            "description": "Processed output",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Element"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Job or file not found"
          }
        }
      }
    },
    "/files": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a file for processing",
        "tags": [
          "Files"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_id": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "unstructured-api-key",
        "description": "Unstructured API key"
      }
    },
    "schemas": {
      "Element": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Element type (e.g., Title, NarrativeText, Table, ListItem, Image)"
          },
          "element_id": {
            "type": "string",
            "description": "Unique element identifier"
          },
          "text": {
            "type": "string",
            "description": "Extracted text content"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string"
              },
              "filetype": {
                "type": "string"
              },
              "page_number": {
                "type": "integer"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coordinates": {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "system": {
                    "type": "string"
                  },
                  "layout_width": {
                    "type": "number"
                  },
                  "layout_height": {
                    "type": "number"
                  }
                }
              },
              "parent_id": {
                "type": "string",
                "nullable": true
              },
              "category_depth": {
                "type": "integer"
              },
              "text_as_html": {
                "type": "string"
              }
            }
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
