                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "An unexpected error response."
          }
        },
        "tags": [
          "Operations"
        ],
        "description": "Respects PATCH semantics. Only the fields that are provided in\nthe JSON body are updated when using HTTP. Other fields are unaffected.\n\nWhen using gRPC, specify which fields to update by using the\n`update_mask` field mask.\n\nThe device ID should always be specified in the request path and not\nin the request body.",
        "operationId": "PublicAPI_UpdateDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "autoDim": {
                    "description": "Whether the device will automatically dim at sunset.",
                    "type": "boolean"
                  },
                  "brightness": {
                    "description": "The brightness level for the device, from 1 to 100.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "displayName": {
                    "description": "The user-provided name for the device.",
                    "type": "string"
                  },
                  "lastSeen": {
                    "description": "When the device was last seen (Unix timestamp). Read-only.",
                    "format": "int64",
                    "type": "string"
                  }
                },
                "title": "Required. The device to update.",
                "type": "object"
              }
            }
          },
          "description": "Required. The device to update.",
          "required": true
        },
        "summary": "Update device details"
      }
    },
