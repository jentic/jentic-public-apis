{"openapi":"3.1.0","info":{"title":"Bizmoon API","version":"1.1.0","description":"Regulatory intelligence for a business, as plain JSON: analyses, deadlines, watchlists, reports, funding, license checklists, and the actions behind them. The same tools are available to AI agents over MCP at https://bizmoon.ai/api/mcp."},"servers":[{"url":"https://bizmoon.ai","description":"Production"}],"security":[{"bearerAuth":[]}],"paths":{"/api/v1/analyses/search":{"post":{"operationId":"search_analyses","summary":"Search policy analyses","description":"Search the AI-generated relevance analyses Bizmoon produced for your organization: severity, urgency, affected business areas, recommended actions. Filters by document publication date. Every response carries totalMatching alongside the page. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}}}},"/api/v1/stats":{"get":{"operationId":"get_regulatory_stats","summary":"Aggregate regulatory stats","description":"Counts over your organization's analyses grouped by agency, area, severity, urgency, category, jurisdiction or month: the numbers behind the dashboard charts. Set compare_to_previous for the prior window and deltas. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/analyses/{id}":{"get":{"operationId":"get_document_details","summary":"Get analysis details","description":"Full analysis for one of your organization's analyses by analysisId, including key provisions, deadlines, and funding details. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/documents/{id}/text":{"get":{"operationId":"get_document_text","summary":"Read document text","description":"The stored full text of a source document by documentId, paged with offset_chars. Returns the canonical URL instead when no text is stored. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/deadlines":{"get":{"operationId":"get_compliance_deadlines","summary":"Get compliance deadlines","description":"Compliance deadlines extracted from analyses for your organization, with days remaining and overdue flags. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/organization":{"get":{"operationId":"get_organization_profile","summary":"Get organization profile","description":"Industry, NAICS codes, description, operations, geography, regulatory concerns, size and plan for your organization. Use it to ground relevance judgments. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/watchlist/matches":{"get":{"operationId":"get_watchlist_matches","summary":"Get watchlist matches","description":"Documents that matched your organization's watchlists recently. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/watchlists":{"get":{"operationId":"list_watchlists","summary":"List watchlists","description":"Your organization's keyword watchlists with their keywords, notification settings and recent match counts. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}},"post":{"operationId":"create_watchlist","summary":"Create a watchlist","description":"Create a keyword watchlist that flags new regulations matching its keywords. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}}}},"/api/v1/reports":{"get":{"operationId":"list_reports","summary":"List reports","description":"Generated compliance and analysis reports for your organization: title, type, status, period. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}},"post":{"operationId":"generate_report","summary":"Generate a report","description":"Queue a compliance report PDF for your organization (weekly, monthly or a custom period). Runs in the background and appears under reports when ready. Requires PDF reports to be enabled for the organization. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}}}},"/api/v1/reports/{id}":{"get":{"operationId":"get_report_details","summary":"Get report details","description":"One report by id: type, status, period, parameters, and whether the PDF is ready. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/funding":{"get":{"operationId":"get_funding_opportunities","summary":"Get funding opportunities","description":"Grant and funding analyses relevant to your organization, with deadlines and funding details. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/action-items":{"get":{"operationId":"get_action_items","summary":"List action items","description":"Pending action items for your organization: task, priority, deadline, status and source document. Costs 1 credit on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}},"post":{"operationId":"create_action_item","summary":"Create an action item","description":"Add a to-do for your organization: task text, priority, optional deadline. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}}}},"/api/v1/licenses":{"get":{"operationId":"get_license_checklist","summary":"License checklist for a business","description":"Every license, permit and registration a business needs for a US state, business type and legal structure, grouped federal, state, local and industry, with the issuing agency, cost, timeline and how to apply. Cached combinations cost 1 credit; a first-time combination is generated on the spot (two model passes, 20 to 40 seconds) and costs 5. Costs 5 credits at most on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}}}},"/api/v1/documents/{id}/analyze":{"post":{"operationId":"analyze_document","summary":"Analyze a document","description":"What a regulatory or funding document requires, extracted once and cached: plain-English summary, key provisions, obligations with deadlines, compliance dates, and funding details for funding documents. Pass a business profile (state, industry, employees, description) to also get relevance, severity, urgency and why it matters for that business. 2 credits when the extraction is cached, 10 when this call computes it. Costs 10 credits at most on the prepaid tier.","tags":["Read"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/action-items/{id}":{"patch":{"operationId":"update_action_item","summary":"Update an action item","description":"Change an action item's text, priority or deadline. Reversible; confirm with your user when the change was not explicitly requested. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"delete_action_item","summary":"Delete an action item","description":"Permanently delete one or more action items. This cannot be undone. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/action-items/{id}/complete":{"post":{"operationId":"complete_action_item","summary":"Complete an action item","description":"Mark one or more pending action items done. Reversible in the app; confirm with your user when they did not clearly ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/action-items/{id}/snooze":{"post":{"operationId":"snooze_action_item","summary":"Snooze an action item","description":"Hide an action item from pending lists until a future date. Reversible; confirm with your user when they did not clearly ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/watchlists/{id}":{"patch":{"operationId":"update_watchlist","summary":"Update a watchlist","description":"Rename a watchlist, add or remove keywords, or toggle notifications. Reversible; confirm with your user when the change was not explicitly requested. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"delete_watchlist","summary":"Delete a watchlist","description":"Permanently delete a watchlist and stop its monitoring. This cannot be undone. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/applications":{"post":{"operationId":"start_application","summary":"Start a grant application","description":"Start a grant application for a funding document. Queues the NOFO analysis, which takes several minutes; returns the existing application if one is already active for the document. Requires application drafting to be enabled for the organization. Confirm with your user before calling this; the server does not ask. Costs 1 credit on the prepaid tier.","tags":["Write"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Validation error"},"401":{"description":"Invalid or missing API key"},"402":{"description":"Not enough prepaid credits"},"403":{"description":"Plan or credits required"},"429":{"description":"Rate limit exceeded"}},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{},"required":[]}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"API Key (bm_sk_...)"}}}}