{
  "openapi": "3.1.0",
  "info": {
    "title": "Buska Public API",
    "version": "1.0.0",
    "description": "Buska's public REST API for social-listening + B2B lead generation. Search mentions across 19 platforms, score posts for buyer intent with Buska AI, and retrieve qualified buying signals detected for your team.\n\nAll endpoints require an `x-api-key` header. Get yours from https://app.buska.io/settings (API tab). Rate limit: 60 requests per minute per API key. A two-tier billing applies: monthly subscription quota first, pay-as-you-go credits as fallback.",
    "termsOfService": "https://www.buska.io/terms",
    "contact": {
      "name": "Buska Support",
      "url": "https://www.buska.io/contact",
      "email": "support@buska.io"
    },
    "license": {
      "name": "Commercial",
      "url": "https://www.buska.io/terms"
    },
    "x-jentic-source-url": "https://www.buska.io/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.buska.io/api/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/mentions/search": {
      "post": {
        "tags": [
          "mentions"
        ],
        "summary": "Search social media mentions",
        "description": "Search posts mentioning a keyword on a specific platform. Returns up to `limit` posts with author, content, URL, date, and engagement metrics. Costs 1 API credit per call. The platform must be available on your plan.",
        "operationId": "searchMentions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchMentionsRequest"
              },
              "example": {
                "keyword": "social listening tool",
                "platform": "reddit",
                "limit": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mentions found (may be empty array)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchMentionsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/PlatformNotAvailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ScraperUnavailable"
          }
        }
      }
    },
    "/leads/score": {
      "post": {
        "tags": [
          "leads"
        ],
        "summary": "Score a post for B2B lead qualification",
        "description": "Run Buska AI on raw post content to determine if it represents a qualified buying signal. Returns a 1-10 score, intent type (ACTIVE, COMPETITOR, PAIN, QUESTION, MENTION), ICP match, and reasoning. The AI uses your team's company description, ICP definitions, and competitors as context. Costs 1 API credit per call.",
        "operationId": "scoreLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreLeadRequest"
              },
              "example": {
                "content": "Looking for a tool that monitors Reddit and Twitter for mentions of our brand. Any recommendations?",
                "keyword": "social listening",
                "context": "We sell a B2B social listening platform"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoring result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreLeadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/signals": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "List qualified buying signals",
        "description": "Retrieve recent qualified leads (signals) detected by Buska for your team. Filterable by keyword, intent, platform, minimum score, and date. Paginated. Costs 1 API credit per call.",
        "operationId": "listSignals",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by exact keyword"
          },
          {
            "name": "intent",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "COMPETITOR",
                "PAIN",
                "QUESTION",
                "MENTION"
              ]
            },
            "description": "Filter by detected intent type"
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by platform (e.g. reddit, twitter, linkedin)"
          },
          {
            "name": "minScore",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "description": "Minimum AI score (1-10)"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "ISO date — only signals detected after this date"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Max results to return (1-100)"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Pagination offset"
          },
          {
            "name": "content",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "preview",
                "full"
              ],
              "default": "preview"
            },
            "description": "Set to `full` to also receive `contentFull`, the complete original post text (up to 4000 characters) instead of the 150-character preview alone. Omitted by default so existing integrations keep the exact same payload. Any other value returns 400 INVALID_CONTENT_MODE."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated signals list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "usage"
        ],
        "summary": "Get current API usage and quota",
        "description": "Returns the calling team's monthly API usage, plan limits, available credits, and the list of platforms enabled on their plan. Free of charge — does NOT count against your quota.",
        "operationId": "getUsage",
        "responses": {
          "200": {
            "description": "Usage information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key issued from https://app.buska.io/settings (API tab). Keep secret."
      }
    },
    "schemas": {
      "Platform": {
        "type": "string",
        "enum": [
          "twitter",
          "reddit",
          "linkedin",
          "youtube",
          "hackernews",
          "bluesky",
          "stackoverflow",
          "medium",
          "substack",
          "github",
          "devto",
          "mastodon",
          "quora",
          "pinterest",
          "facebook",
          "instagram",
          "tiktok",
          "producthunt",
          "g2"
        ]
      },
      "Intent": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "COMPETITOR",
          "PAIN",
          "QUESTION",
          "MENTION"
        ],
        "description": "Detected buyer-intent type. ACTIVE=explicit purchase request, COMPETITOR=switching from competitor, PAIN=frustration, QUESTION=open question, MENTION=passive reference."
      },
      "SearchMentionsRequest": {
        "type": "object",
        "required": [
          "keyword",
          "platform"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "description": "Keyword or phrase to search for"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        }
      },
      "Mention": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "profileUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Original publication date (raw, scraper-dependent)"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "engagement": {
            "type": "object",
            "properties": {
              "likes": {
                "type": "integer"
              },
              "comments": {
                "type": "integer"
              },
              "shares": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SearchMentionsResponse": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "count": {
            "type": "integer"
          },
          "mentions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mention"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInline"
          }
        }
      },
      "ScoreLeadRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10000,
            "description": "Post content to evaluate"
          },
          "keyword": {
            "type": "string",
            "description": "Optional team keyword for context"
          },
          "context": {
            "type": "string",
            "description": "Optional free-form context (e.g. 'We sell CRM software')"
          }
        }
      },
      "ScoreLeadResponse": {
        "type": "object",
        "properties": {
          "qualified": {
            "type": "boolean"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "icpMatch": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the matched ICP, or null"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInline"
          }
        }
      },
      "Signal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Content preview, truncated to 150 characters. Use `?content=full` for the complete text."
          },
          "contentFull": {
            "type": [
              "string",
              "null"
            ],
            "description": "Complete original post text, up to 4000 characters. Only present when the request sets `content=full`. Null for MENTION signals, which carry no full text."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "platform": {
            "type": "string"
          },
          "keyword": {
            "type": "string"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "icpMatch": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignalsResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInline"
          }
        }
      },
      "UsageInline": {
        "type": "object",
        "properties": {
          "used": {
            "type": "integer"
          },
          "limit": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "enum": [
                  "unlimited"
                ]
              }
            ]
          },
          "month": {
            "type": "string",
            "example": "2026-04"
          },
          "credits": {
            "type": "integer"
          },
          "quotaRemaining": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "team": {
            "type": "string",
            "description": "Team display name"
          },
          "plan": {
            "type": "string",
            "example": "growth"
          },
          "usage": {
            "type": "object",
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "unlimited"
                    ]
                  }
                ]
              },
              "remaining": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "unlimited"
                    ]
                  }
                ]
              },
              "month": {
                "type": "string"
              },
              "resetsAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "credits": {
            "type": "integer"
          },
          "availablePlatforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_KEYWORD"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request payload (missing fields, wrong types, bad values)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid `x-api-key` header",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PlatformNotAvailable": {
        "description": "Platform not enabled on the caller's plan, or API access not enabled",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded (60 req/min) OR monthly quota exhausted with no credits",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error. Credits are refunded on failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ScraperUnavailable": {
        "description": "Underlying scraping service temporarily unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "mentions",
      "description": "Search social media mentions across platforms"
    },
    {
      "name": "leads",
      "description": "AI-powered lead qualification"
    },
    {
      "name": "signals",
      "description": "Retrieve qualified buying signals detected for your team"
    },
    {
      "name": "usage",
      "description": "API usage and quota introspection"
    }
  ],
  "externalDocs": {
    "description": "Buska documentation",
    "url": "https://www.buska.io/docs"
  }
}