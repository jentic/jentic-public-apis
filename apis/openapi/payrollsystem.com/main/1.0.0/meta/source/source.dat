  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Items per page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "description": "Sort by field. Prefix with '-' for descending order.\nExample: `sort=-created_at` or `sort=name`\n",
        "schema": {
          "type": "string",
          "example": "-created_at"
        }
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation successful"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Invalid input data"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 50
          },
          "total": {
            "type": "integer",
            "example": 150
          },
          "last_page": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "example": "/api/v1/employees?page=1"
          },
          "prev": {
            "type": "string",
            "nullable": true
          },
          "next": {
            "type": "string",
            "example": "/api/v1/employees?page=2"
          },
          "last": {
            "type": "string",
            "example": "/api/v1/employees?page=3"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "agus.setiawan"
          },
          "email": {
            "type": "string",
            "example": "agus.setiawan@teknologi.com"
          },
          "role": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string",
                "example": "Company Admin"
              }
            }
          },
          "company": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "employee_id": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          },
          "last_login_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee_code": {
            "type": "string"
          },
          "fullname": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "department": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "position": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "employment_status": {
            "type": "string"
          },
          "employee_status": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "mobile_phone": {
            "type": "string"
          },
          "corporate_email": {
            "type": "string"
          }
        }
      },
      "EmployeeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Employee"
          },
          {
            "type": "object",
            "properties": {
              "place_of_birth": {
                "type": "string"
              },
              "religion": {
                "type": "string"
              },
              "marital_status": {
                "type": "string"
              },
              "number_of_children": {
                "type": "integer"
              },
              "last_education": {
                "type": "string"
              },
              "date_of_hire": {
                "type": "string",
                "format": "date"
              },
              "current_salary": {
                "type": "integer"
              },
              "bank_account": {
                "type": "object",
                "properties": {
                  "bank_name": {
                    "type": "string"
                  },
                  "account_number": {
                    "type": "string"
                  },
                  "account_holder": {
                    "type": "string"
                  }
                }
              },
              "tax_info": {
                "type": "object",
                "properties": {
                  "npwp": {
                    "type": "string"
                  },
                  "tax_status": {
                    "type": "string"
                  }
                }
              },
              "bpjs_info": {
                "type": "object",
                "properties": {
                  "bpjs_tk_number": {
                    "type": "string"
                  },
                  "bpjs_kes_number": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "EmployeeCreate": {
        "type": "object",
        "required": [
          "employee_code",
          "fullname",
          "gender",
          "date_of_hire",
          "join_date"
        ],
        "properties": {
          "employee_code": {
            "type": "string"
          },
          "fullname": {
            "type": "string"
          },
          "place_of_birth": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "religion": {
            "type": "string"
          },
          "marital_status": {
            "type": "string"
          },
          "number_of_children": {
            "type": "integer"
          },
          "last_education": {
            "type": "string"
          },
          "date_of_hire": {
            "type": "string",
            "format": "date"
          },
          "join_date": {
            "type": "string",
            "format": "date"
          },
          "employment_status": {
            "type": "string"
          },
          "branch_id": {
            "type": "integer"
          },
          "department_id": {
            "type": "integer"
          },
          "division_id": {
            "type": "integer"
          },
          "position_id": {
            "type": "integer"
          },
          "working_time_id": {
            "type": "integer"
          },
          "mobile_phone": {
            "type": "string"
          },
          "corporate_email": {
            "type": "string"
          },
          "personal_email": {
            "type": "string"
          },
          "bank_name": {
            "type": "string"
          },
          "bank_account_number": {
            "type": "string"
          },
          "bank_account_holder": {
            "type": "string"
          }
        }
      },
      "EmployeeUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EmployeeCreate"
          }
        ]
      },
      "SalaryHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "basic_salary": {
            "type": "integer"
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "payment_method": {
            "type": "string"
          }
        }
      },
      "PayrollPeriod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "period_name": {
            "type": "string"
          },
          "month": {
            "type": "integer"
          },
          "year": {
            "type": "integer"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "payment_date": {
            "type": "string",
            "format": "date"
          },
          "cutoff_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "calculated",
              "approved",
              "paid",
              "closed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PayrollPeriodDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PayrollPeriod"
          },
          {
            "type": "object",
            "properties": {
              "statistics": {
                "type": "object",
                "properties": {
                  "total_employees": {
                    "type": "integer"
                  },
                  "total_gross": {
                    "type": "integer"
                  },
                  "total_deductions": {
                    "type": "integer"
                  },
                  "total_net": {
                    "type": "integer"
                  },
                  "total_tax": {
                    "type": "integer"
                  },
                  "total_bpjs": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
      },
      "PayrollDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "employee_code": {
                "type": "string"
              },
              "fullname": {
                "type": "string"
              }
            }
          },
          "basic_salary": {
            "type": "integer"
          },
          "total_allowances": {
            "type": "integer"
          },
          "total_overtime": {
            "type": "integer"
          },
          "total_bonus": {
            "type": "integer"
          },
          "gross_salary": {
            "type": "integer"
          },
          "bpjs_tk_employee": {
            "type": "integer"
          },
          "bpjs_kes_employee": {
            "type": "integer"
          },
          "pph21": {
            "type": "integer"
          },
          "total_deductions": {
            "type": "integer"
          },
          "loan_installment": {
            "type": "integer"
          },
          "net_salary": {
            "type": "integer"
          },
          "working_days": {
            "type": "integer"
          },
          "present_days": {
            "type": "integer"
          },
          "absent_days": {
            "type": "integer"
          },
          "leave_days": {
            "type": "integer"
          },
          "overtime_hours": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
