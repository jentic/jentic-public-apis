{
  "openapi": "3.0.3",
  "info": {
    "title": "Chess.com Published-Data API",
    "version": "1.0.0",
    "description": "Read-only REST API for Chess.com player data, game archives, clubs, tournaments, and more. Returns JSON-LD formatted data. No authentication required.",
    "x-jentic-source-url": "https://www.chess.com/news/view/published-data-api",
    "contact": {
      "url": "https://www.chess.com"
    },
    "x-jentic-no-auth-reason": "Genuinely public API - no signup or authentication required. Read-only access to public chess data."
  },
  "servers": [
    {
      "url": "https://api.chess.com/pub",
      "description": "Chess.com Public API"
    }
  ],
  "paths": {
    "/player/{username}": {
      "get": {
        "operationId": "getPlayer",
        "summary": "Get player profile",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player profile data"
          }
        }
      }
    },
    "/player/{username}/stats": {
      "get": {
        "operationId": "getPlayerStats",
        "summary": "Get player statistics",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player statistics"
          }
        }
      }
    },
    "/player/{username}/is-online": {
      "get": {
        "operationId": "getPlayerOnline",
        "summary": "Check if player is online",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Online status"
          }
        }
      }
    },
    "/player/{username}/games": {
      "get": {
        "operationId": "getPlayerGames",
        "summary": "Get current daily games",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current daily chess games"
          }
        }
      }
    },
    "/player/{username}/games/to-move": {
      "get": {
        "operationId": "getPlayerGamesToMove",
        "summary": "Games awaiting player's move",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Games where it's the player's turn"
          }
        }
      }
    },
    "/player/{username}/games/archives": {
      "get": {
        "operationId": "getPlayerArchives",
        "summary": "List monthly archives",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available monthly archive URLs"
          }
        }
      }
    },
    "/player/{username}/games/{year}/{month}": {
      "get": {
        "operationId": "getPlayerMonthlyArchive",
        "summary": "Monthly game archive",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Games from the specified month"
          }
        }
      }
    },
    "/player/{username}/clubs": {
      "get": {
        "operationId": "getPlayerClubs",
        "summary": "Player's club memberships",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Club memberships"
          }
        }
      }
    },
    "/player/{username}/matches": {
      "get": {
        "operationId": "getPlayerMatches",
        "summary": "Player's team matches",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team matches"
          }
        }
      }
    },
    "/player/{username}/tournaments": {
      "get": {
        "operationId": "getPlayerTournaments",
        "summary": "Player's tournaments",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tournament history"
          }
        }
      }
    },
    "/titled/{title}": {
      "get": {
        "operationId": "getTitledPlayers",
        "summary": "List titled players",
        "description": "Get players with a specific title (GM, WGM, IM, WIM, FM, WFM, NM, WNM, CM, WCM).",
        "parameters": [
          {
            "name": "title",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "GM",
                "WGM",
                "IM",
                "WIM",
                "FM",
                "WFM",
                "NM",
                "WNM",
                "CM",
                "WCM"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of titled players"
          }
        }
      }
    },
    "/club/{urlId}": {
      "get": {
        "operationId": "getClub",
        "summary": "Get club profile",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Club profile"
          }
        }
      }
    },
    "/club/{urlId}/members": {
      "get": {
        "operationId": "getClubMembers",
        "summary": "Get club members",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Club members by activity level"
          }
        }
      }
    },
    "/club/{urlId}/matches": {
      "get": {
        "operationId": "getClubMatches",
        "summary": "Get club team matches",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Club team matches"
          }
        }
      }
    },
    "/tournament/{urlId}": {
      "get": {
        "operationId": "getTournament",
        "summary": "Get tournament details",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tournament details"
          }
        }
      }
    },
    "/tournament/{urlId}/{round}": {
      "get": {
        "operationId": "getTournamentRound",
        "summary": "Get tournament round",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "round",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tournament round details"
          }
        }
      }
    },
    "/tournament/{urlId}/{round}/{group}": {
      "get": {
        "operationId": "getTournamentGroup",
        "summary": "Get tournament round group",
        "parameters": [
          {
            "name": "urlId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "round",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tournament round group details"
          }
        }
      }
    },
    "/match/{id}": {
      "get": {
        "operationId": "getMatch",
        "summary": "Get daily team match",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team match details"
          }
        }
      }
    },
    "/match/{id}/{board}": {
      "get": {
        "operationId": "getMatchBoard",
        "summary": "Get team match board",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "board",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Board games in team match"
          }
        }
      }
    },
    "/match/live/{id}": {
      "get": {
        "operationId": "getLiveMatch",
        "summary": "Get live team match",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live team match details"
          }
        }
      }
    },
    "/match/live/{id}/{board}": {
      "get": {
        "operationId": "getLiveMatchBoard",
        "summary": "Get live team match board",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "board",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Board games in live team match"
          }
        }
      }
    },
    "/country/{iso}": {
      "get": {
        "operationId": "getCountry",
        "summary": "Get country profile",
        "parameters": [
          {
            "name": "iso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Country profile"
          }
        }
      }
    },
    "/country/{iso}/players": {
      "get": {
        "operationId": "getCountryPlayers",
        "summary": "Get country's players",
        "parameters": [
          {
            "name": "iso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Players from the country"
          }
        }
      }
    },
    "/country/{iso}/clubs": {
      "get": {
        "operationId": "getCountryClubs",
        "summary": "Get country's clubs",
        "parameters": [
          {
            "name": "iso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Clubs from the country"
          }
        }
      }
    },
    "/puzzle": {
      "get": {
        "operationId": "getDailyPuzzle",
        "summary": "Get daily puzzle",
        "responses": {
          "200": {
            "description": "Daily puzzle"
          }
        }
      }
    },
    "/puzzle/random": {
      "get": {
        "operationId": "getRandomPuzzle",
        "summary": "Get random daily puzzle",
        "responses": {
          "200": {
            "description": "Random puzzle"
          }
        }
      }
    },
    "/streamers": {
      "get": {
        "operationId": "getStreamers",
        "summary": "List Chess.com streamers",
        "responses": {
          "200": {
            "description": "List of streamers"
          }
        }
      }
    },
    "/leaderboards": {
      "get": {
        "operationId": "getLeaderboards",
        "summary": "Get leaderboards",
        "description": "Top 50 players in live and daily chess, plus top 50 in puzzles.",
        "responses": {
          "200": {
            "description": "Leaderboards across all game types"
          }
        }
      }
    }
  },
  "components": {},
  "security": []
}
