    "/v1/tasks/{taskId}/attachments": {
      "post": {
        "operationId": "tasks.attachments.create",
        "summary": "Attach a file",
        "description": "A reference file on the task — a brief, a spec, a screenshot. `multipart/form-data`.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
