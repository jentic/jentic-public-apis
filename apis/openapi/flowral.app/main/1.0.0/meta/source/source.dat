      "post": {
        "operationId": "brainstorms.create",
        "summary": "Create a brainstorm",
        "description": "Creates a brainstorm and, optionally, its whole starting idea tree in one call. An idea's `parent` references another idea **by index in this request**, so a shape arrives with the board rather than in follow-up calls.",
        "tags": [
          "brainstorms"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "ideas": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "description": "Ideas to create, in order. Each: `{ title, notes?, parent?: index }`, where `parent` is an index into this same array — omit it for a root idea."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CREATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brainstorm"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED · INVALID_BOX_TREE",
