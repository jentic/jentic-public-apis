        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Images, video, PDF and Word, up to 50 MB."
                  }
                },
                "required": [
                  "file"
                ]
              }
