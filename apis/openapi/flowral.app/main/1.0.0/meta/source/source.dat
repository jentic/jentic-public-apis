      "post": {
        "operationId": "tasks.create",
        "summary": "Add a task to a flow",
        "description": "Creates a task and links it in the same call. `after` are the tasks that must finish first; `before` are the tasks that now wait on this one — use it to insert a step into an existing chain.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "after": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Task ids this depends on."
                  },
                  "before": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Task ids that should depend on this."
                  },
                  "estimateHours": {
                    "type": "number"
                  },
                  "assigneeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CREATED",
            "content": {
              "application/json": {
                "schema": {
