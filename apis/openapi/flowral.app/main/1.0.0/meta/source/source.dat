      "delete": {
        "operationId": "ideas.remove",
        "summary": "Delete an idea",
        "description": "Bridges the gap it leaves: this idea's children are re-parented onto its own parent (or promoted to root ideas, if it had none), so removing a box from the middle of a branch doesn't orphan what nested under it. This cannot be undone.",
