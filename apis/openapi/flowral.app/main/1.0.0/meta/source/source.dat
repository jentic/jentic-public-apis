    "/v1/work/available": {
      "get": {
        "operationId": "work.available",
        "summary": "What is ready to start",
        "description": "Every unblocked, unstarted task across the workspace, critical-path work first. The single most useful call in this API.",
        "tags": [
          "work"
        ],
