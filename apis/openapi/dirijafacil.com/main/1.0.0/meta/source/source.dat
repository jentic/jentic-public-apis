{
  "openapi": "3.0.3",
  "info": {
    "title": "DirijaFácil API",
    "version": "1.0.0",
    "description": "API for DirijaFácil - Student and Instructor endpoints",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/autofacil/autofacil-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.dirijafacil.com/v1"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Student"
    },
    {
      "name": "Instructor"
    },
    {
      "name": "Scheduling"
    },
    {
      "name": "Payments"
    },
    {
      "name": "Chat"
    },
    {
      "name": "Detran"
    },
    {
      "name": "Admin"
    }
  ],
  "paths": {
    "/auth/register/student": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new student",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/register/instructor": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new instructor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstructorRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Instructor registered (pending approval)"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login (student or instructor)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/students/me": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Get current student profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Student profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentProfile"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Student"
        ],
        "summary": "Update student profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/instructors/me": {
      "get": {
        "tags": [
          "Instructor"
        ],
        "summary": "Get current instructor profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Instructor profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstructorProfile"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Instructor"
        ],
        "summary": "Update instructor profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstructorProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/instructors": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Search instructors",
        "parameters": [
          {
            "in": "query",
            "name": "location",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "radius",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "priceMin",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "priceMax",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "ratingMin",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "availability",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of instructors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstructorSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/instructors/{id}": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Get instructor details",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Instructor details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstructorProfile"
                }
              }
            }
          }
        }
      }
    },
    "/scheduling": {
      "post": {
        "tags": [
          "Scheduling"
        ],
        "summary": "Create a new lesson booking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created"
          }
        }
      },
      "get": {
        "tags": [
          "Scheduling"
        ],
        "summary": "List my bookings (student or instructor)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/scheduling/{id}": {
      "get": {
        "tags": [
          "Scheduling"
        ],
        "summary": "Get booking details",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Scheduling"
        ],
        "summary": "Update booking (confirm, cancel, mark as completed)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Initiate payment for a booking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment initiated"
          }
        }
      }
    },
    "/wallet": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get instructor wallet info",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Request withdrawal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Withdrawal requested"
          }
        }
      }
    },
    "/chat/{bookingId}": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Get chat messages for a booking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "bookingId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessage"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Send a chat message",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "bookingId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatMessageSend"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message sent"
          }
        }
      }
    },
    "/detran/validate-lesson": {
      "post": {
        "tags": [
          "Detran"
        ],
        "summary": "Validate lesson with Detran",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetranValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lesson validated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetranValidationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/students/me/progress": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Get student progress",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Progress dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentProgress"
                }
              }
            }
          }
        }
      }
    },
    "/instructors/me/rating": {
      "get": {
        "tags": [
          "Instructor"
        ],
        "summary": "Get instructor rating and badges",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rating and badges",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstructorRating"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "StudentRegistration": {
        "type": "object",
        "required": [
          "cpf",
          "name",
          "birthDate",
          "phone",
          "email",
          "password",
          "documents"
        ],
        "properties": {
          "cpf": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "documents": {
            "type": "object",
            "properties": {
              "rg": {
                "type": "string",
                "format": "binary"
              },
              "cnh": {
                "type": "string",
                "format": "binary"
              },
              "proofOfAddress": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "acceptLGPD": {
            "type": "boolean"
          }
        }
      },
      "InstructorRegistration": {
        "type": "object",
        "required": [
          "cpf",
          "name",
          "birthDate",
          "phone",
          "email",
          "password",
          "cnh",
          "detranCertificate",
          "vehicle"
        ],
        "properties": {
          "cpf": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "cnh": {
            "type": "string",
            "format": "binary"
          },
          "detranCertificate": {
            "type": "string",
            "format": "binary"
          },
          "criminalRecord": {
            "type": "string",
            "format": "binary"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "pricePerHour": {
            "type": "number",
            "default": 80
          },
          "acceptLGPD": {
            "type": "boolean"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "cpf",
          "password"
        ],
        "properties": {
          "cpf": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "StudentProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "budget": {
                "type": "number"
              },
              "schedule": {
                "type": "string"
              }
            }
          },
          "progress": {
            "$ref": "#/components/schemas/StudentProgress"
          }
        }
      },
      "StudentProfileUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "budget": {
                "type": "number"
              },
              "schedule": {
                "type": "string"
              }
            }
          }
        }
      },
      "InstructorProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experienceYears": {
            "type": "integer"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "pricePerHour": {
            "type": "number"
          },
          "calendar": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "InstructorProfileUpdate": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "pricePerHour": {
            "type": "number"
          },
          "calendar": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "plate": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "manual",
              "automatic"
            ]
          },
          "photo": {
            "type": "string"
          }
        }
      },
      "InstructorSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricePerHour": {
            "type": "number"
          },
          "distance": {
            "type": "number"
          },
          "vehicleType": {
            "type": "string"
          }
        }
      },
      "ScheduleRequest": {
        "type": "object",
        "required": [
          "instructorId",
          "date",
          "duration",
          "location",
          "category",
          "focus"
        ],
        "properties": {
          "instructorId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "type": "integer"
          },
          "location": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "studentId": {
            "type": "string"
          },
          "instructorId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "type": "integer"
          },
          "location": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "paymentStatus": {
            "type": "string"
          },
          "detranProtocol": {
            "type": "string"
          }
        }
      },
      "BookingUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "rescheduleDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": [
          "bookingId",
          "method"
        ],
        "properties": {
          "bookingId": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "pix",
              "card",
              "boleto"
            ]
          }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number"
          },
          "blocked": {
            "type": "number"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletTransaction"
            }
          }
        }
      },
      "WalletTransaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "WithdrawalRequest": {
        "type": "object",
        "required": [
          "amount",
          "method"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "pix",
              "ted"
            ]
