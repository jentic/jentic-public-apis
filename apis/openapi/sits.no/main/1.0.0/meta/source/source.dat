{
  "openapi": "3.1.0",
  "info": {
    "title": "Betjeningskartet API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/skatteetaten/utleggsbegjaering-betjeningskartet-api/1.0.0"
  },
  "externalDocs": {
    "description": "OpenAPI-dokumentasjon for betjeningskartet",
    "url": "https://skatteetaten.github.io/beta-apier/utleggsbegjaering"
  },
  "servers": [
    {
      "url": "https://api-test.sits.no",
      "description": "Eksternt testmiljø for Skatteetaten"
    }
  ],
  "security": [
    {
      "STS_SECURITY_SCHEME": []
    }
  ],
  "tags": [
    {
      "name": "Betjeningskartet",
      "description": "API for betjeningskartet"
    }
  ],
  "paths": {
    "/api/utleggsbegjaering/v2/betjeningskartet": {
      "post": {
        "tags": [
          "Betjeningskartet"
        ],
        "summary": "Sjekker om saksøkte skal behandles etter tidligere eller nytt regelverk. Resultat er en liste med de samme saksøkte som ble sendt inn. Dersom saksøkte er på ulike regelverk, må de sendes inn i separate forespørsler (utleggsbegjæringer). Digitale utleggsbegjæringer for saksøkte på nytt regelverk må sendes til nytt API (ELAN), mens saksøkte på gammelt regelverk må sendes til ELSA.",
        "operationId": "finnRegelverkForSkyldnere",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetjeningskartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetjeningskartResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Feil"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Feil"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Feil"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Feil"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Feil"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Feil": {
        "properties": {
          "kode": {
            "type": "string",
            "description": "Feilkode, for maskinell haandtering",
            "example": "TKL-0xx"
          },
          "melding": {
            "type": "string",
            "description": "Beskrivelse av feilen som har oppstaatt",
            "example": "Fant ikke gitt personidentifikator"
          },
          "korrelasjonsid": {
            "type": "string",
            "description": "Korrelasjonsid",
            "example": "123e4567-e89b-12d3-a456-426655440000"
          },
          "feilid": {
            "type": "string",
            "description": "Feilid",
            "example": "I2ABHt"
          }
        }
      },
      "BetjeningskartRequest": {
        "type": "object",
        "properties": {
          "saksoekt": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartsidentifikatorForEksternBruk"
            }
          }
        },
        "required": [
          "saksoekt"
        ]
      },
      "PartsidentifikatorForEksternBruk": {
        "type": "object",
        "properties": {
          "taxIdentificationNumber": {
            "type": "string"
          },
          "annenOffisiellIdentifikator": {
            "type": "string"
          },
          "landkodeIdentifikator": {
            "type": "string"
          }
        },
        "required": [
          "landkodeIdentifikator"
        ]
      },
      "BetjeningskartResponse": {
        "type": "object",
        "properties": {
          "saksoekt": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BetjeningskartSaksoekt"
            }
          }
        },
        "required": [
          "saksoekt"
        ]
      },
      "BetjeningskartSaksoekt": {
        "type": "object",
        "properties": {
          "partsreferanse": {
            "$ref": "#/components/schemas/PartsidentifikatorForEksternBruk"
          },
          "regelverk": {
            "type": "string",
            "enum": [
              "tidligereRegelverk",
              "nyttRegelverk",
              "ukjentPart"
            ]
          }
        },
        "required": [
          "partsreferanse",
          "regelverk"
        ]
      }
    },
    "securitySchemes": {
      "STS_SECURITY_SCHEME": {
        "type": "http",
        "description": "Token for autorisering med STS.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
