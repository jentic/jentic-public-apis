                            "additionalProperties": true
                          }
                        }
                      }
                    },
                    "total": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "True match count on the first page; null on every cursor page, where the upstream does not count."
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Send back as `cursor` with the same filter source for the next page; null on the last page."
                    },
                    "filters": {
                      "type": "object",
