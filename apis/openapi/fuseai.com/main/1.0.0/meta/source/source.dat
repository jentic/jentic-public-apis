                        "channel": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "type": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "enum": [
                            "manual",
                            "ai_generated",
                            "ai_reply",
                            null
                          ]
                        },
                        "contact": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "email": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "jobTitle": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "companyName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "jobTitle",
                            "companyName"
                          ]
                        }
                      },
                      "required": [
                        "subject",
                        "body",
                        "channel",
                        "type",
                        "contact"
                      ]
                    }
                  },
                  "required": [
                    "stepId",
                    "preview"
                  ]
                },
                "example": {
                  "stepId": "6a8dce156dc0b3d9029c22d7",
