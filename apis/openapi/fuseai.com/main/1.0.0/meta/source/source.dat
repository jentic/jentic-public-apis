                                            "status": {
                                              "type": [
                                                "string",
                                                "null"
                                              ]
                                            }
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "contacts": {
                                    "type": "array",
                                    "description": "Preview of the first 25 members (contactIds carries every member).",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "contactId": {
                                          "type": "string"
                                        },
                                        "firstName": {
                                          "type": [
                                            "string",
                                            "null"
                                          ]
                                        },
                                        "lastName": {
                                          "type": [
