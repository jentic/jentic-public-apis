                          "personal_email",
                          "phone"
                        ],
                        "inputs": {
                          "anyOf": [
                            [
                              "linkedin_url"
                            ],
                            [
                              "first_name",
                              "last_name",
                              "company_name"
                            ],
                            [
                              "first_name",
                              "last_name",
                              "domain"
                            ]
                          ]
                        },
                        "keyMode": "platform"
                      }
                    },
                    {
                      "id": "zerobounce",
                      "label": "ZeroBounce",
                      "category": "contact-verification",
                      "description": "Verify/validate email deliverability.",
                      "iconUrl": "https://www.google.com/s2/favicons?sz=128&domain=zerobounce.net",
                      "docsUrl": "https://tryfuse.ai/providers/zerobounce",
                      "keyMode": "platform",
                      "hasUserKey": false,
                      "allowedInRuns": true,
                      "source": "platform",
                      "enrichment": null
                    }
                  ]
                }
              }
