                              "null"
                            ],
                            "description": "The column's value type (for example text, number, enum, date)."
                          },
                          "listId": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "The list that defines the column."
                          },
                          "listName": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
