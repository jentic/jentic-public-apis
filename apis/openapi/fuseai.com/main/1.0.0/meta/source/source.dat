                                      "type": "string",
                                      "maxLength": 500,
                                      "description": "Optional display label as returned by GET /prospects/filter-options; accepted and ignored."
                                    }
                                  },
                                  "required": [
                                    "status",
                                    "value"
                                  ]
                                }
                              ]
                            },
                            "maxItems": 1000
                          }
                        ],
                        "description": "Website domain of the current employer (e.g. stripe.com — scheme, www and trailing slash are stripped); same value shapes as `job_company_name`; resolve with GET /prospects/autocomplete?field=website."
                      },
                      "linkedin_url": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 500
                          },
