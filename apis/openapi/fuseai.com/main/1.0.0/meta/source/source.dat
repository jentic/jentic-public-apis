                        "name",
                        "type",
                        "status",
                        "initializationStatus",
                        "initializationError",
                        "listIds"
                      ]
                    }
                  },
                  "required": [
                    "campaign"
                  ]
                },
                "example": {
                  "campaign": {
                    "id": "6a8dc78c8d28fe4014b4e502",
                    "name": "Q3 fintech outreach",
                    "type": "manual",
                    "status": "initializing",
                    "initializationStatus": "completed",
                    "initializationError": null,
                    "listIds": [
                      "6a1edba88936e0fe1b20287c"
                    ]
                  }
                }
