                        ],
                        "description": "Exact lower-case current job title (e.g. chief financial officer); a string or an array of titles — use `keywords` for partial matches and GET /prospects/autocomplete?field=title for suggestions."
                      },
                      "job_company_location_name": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
