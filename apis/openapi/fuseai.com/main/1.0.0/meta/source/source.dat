                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "New folder name (1-120 characters); a name already used by another folder of the same kind answers 409 FOLDER_NAME_TAKEN."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
