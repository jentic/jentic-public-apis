            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "page"
                  ],
                  "properties": {
                    "page": {
                      "type": "object",
                      "required": [
                        "id",
                        "title",
                        "content",
                        "origin",
                        "updatedAt"
                      ],
                      "description": "The fields the update reports. Read the page back with GET /business/knowledge-hubs/{hubId}/pages for its category and createdAt.",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "content": {
