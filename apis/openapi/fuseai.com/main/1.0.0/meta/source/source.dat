              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the current window resets."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "agent"
                  ],
                  "properties": {
                    "agent": {
                      "type": "object",
                      "required": [
                        "id",
                        "type",
                        "name",
                        "status",
                        "started"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "The new agent's id — pass it as `{agentId}` to every other agent operation."
                        },
                        "type": {
                          "type": "string",
