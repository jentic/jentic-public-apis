                  ],
                  "properties": {
                    "companies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "isSaved"
                        ],
                        "properties": {
                          "isSaved": {
                            "type": "boolean",
                            "description": "Whether this company is already in one of your company lists."
                          },
