                          "id": {
                            "type": "string"
                          },
                          "firstName": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Contact rows only."
                          },
                          "lastName": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Contact rows only."
