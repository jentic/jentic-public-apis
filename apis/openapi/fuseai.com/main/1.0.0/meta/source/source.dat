                        ],
                        "description": "Free text, but matched as an EXACT lower-case term against the stored full name (e.g. ada nwosu): there is no partial matching, so a differently cased or partial name is accepted and silently matches nothing. A string, or an array of names that are OR-joined (the provider caps a terms list at 1000)."
                      },
                      "first_name": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
