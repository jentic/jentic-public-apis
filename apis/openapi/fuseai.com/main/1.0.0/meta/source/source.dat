            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approved": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids that moved from approval_required to scheduled."
                    },
                    "ignored": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Your sends that approval cannot move in their current state."
                    },
