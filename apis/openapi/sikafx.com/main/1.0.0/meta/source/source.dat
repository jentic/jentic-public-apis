{
  "openapi": "3.1.0",
  "info": {
    "title": "SikaFX Payment API",
    "version": "1.0.0",
    "description": "The SikaFX Payment API provides a unified interface for sending payments across Africa.\nIntegrate once to access bank transfers and mobile money payouts in multiple countries.\n\n## Authentication\n\nAll requests require a Bearer token using your API key:\n\n```\nAuthorization: Bearer sk_test_abc123...\n```\n\n| Environment | Key prefix | Base URL |\n|-------------|-----------|----------|\n| Sandbox | `sk_test_` | `https://sandbox.sikafx.com` |\n| Production | `sk_live_` | `https://api.sikafx.com` |\n\n## Conventions\n\n- All request and response bodies use **snake_case** field names.\n- Monetary amounts are strings with up to 4 decimal places (e.g. `\"1500.0000\"`).\n- Timestamps are ISO 8601 in UTC (e.g. `\"2026-01-15T09:30:00Z\"`).\n- Paginated endpoints return a standard envelope with `data` and `pagination` fields.\n",
    "contact": {
      "name": "SikaFX Developer Support",
      "email": "developers@sikafx.com",
      "url": "https://sikafx.com"
    },
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-scancode-proprietary-license"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/sikapay/sikafx-payment-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sikafx.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Transactions",
      "description": "Create, list, and retrieve payment transactions."
    },
    {
      "name": "Wallets",
      "description": "View wallet balances and transaction history."
    },
    {
      "name": "Fees",
      "description": "Preview transaction fees before submission."
    },
    {
      "name": "Institutions",
      "description": "List supported banks and mobile money operators."
    },
    {
      "name": "Account Verification",
      "description": "Verify recipient account details before sending a payment."
    },
    {
      "name": "Business",
      "description": "View business profile and dashboard metrics."
    }
  ],
  "paths": {
    "/api/v1/transactions": {
      "post": {
        "operationId": "createTransaction",
        "summary": "Create a transaction",
        "description": "Submit a payment to a recipient's bank account or mobile money wallet.\nThe transaction amount is debited from your wallet along with applicable fees.\n\nUse the `external_reference` field to provide your own unique identifier. If a\ntransaction with the same `external_reference` already exists, the existing\ntransaction is returned (idempotent). You may also pass an `Idempotency-Key`\nheader for additional deduplication.\n",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              },
              "examples": {
                "bank_transfer": {
                  "summary": "Bank transfer (NGN)",
                  "value": {
                    "external_reference": "pay-inv-20260115-001",
                    "amount": "50000.00",
                    "currency": "NGN",
                    "payment_method": "bank",
                    "country_code": "NG",
                    "institution_id": 12,
                    "recipient_account_number": "0123456789",
                    "recipient_account_name": "Adebayo Okonkwo",
                    "narration": "Invoice #1042 payment",
                    "callback_url": "https://example.com/webhooks/sikafx",
                    "metadata": {
                      "invoice_id": "INV-1042"
                    }
                  }
                },
                "mobile_money": {
                  "summary": "Mobile money (GHS)",
                  "value": {
                    "external_reference": "pay-inv-20260115-002",
                    "amount": "500.00",
                    "currency": "GHS",
                    "payment_method": "mobile_money",
                    "country_code": "GH",
                    "institution_id": 45,
                    "recipient_account_number": "0241234567",
                    "recipient_account_name": "Kwame Asante"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "200": {
            "description": "Duplicate `external_reference` — existing transaction returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Insufficient wallet balance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "insufficient_balance",
                    "message": "Wallet balance is insufficient for this transaction."
                  },
                  "request_id": "req_7d3a1c9e4b6f"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "get": {
        "operationId": "listTransactions",
        "summary": "List transactions",
        "description": "Retrieve a paginated list of transactions for your business.\nResults are sorted by creation date in descending order by default.\n",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "name": "external_reference",
            "in": "query",
            "description": "Filter by your external reference.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated list of statuses to filter by.\nValid values: `pending`, `processing`, `completed`, `failed`, `expired`, `cancelled`, `refunded`.\n",
            "schema": {
              "type": "string"
            },
            "example": "pending,processing"
          },
          {
            "name": "payment_method",
            "in": "query",
            "description": "Filter by payment method: `bank` or `mobile_money`.",
            "schema": {
              "type": "string",
              "enum": [
                "bank",
                "mobile_money"
              ]
            }
          },
          {
            "name": "country_code",
            "in": "query",
            "description": "Filter by two-letter ISO country code.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "NG"
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Filter by three-letter ISO currency code.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "example": "NGN"
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Return transactions created after this timestamp (ISO 8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Return transactions created before this timestamp (ISO 8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Free-text search across reference, account name, and narration.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated list of sub-resources to embed.\nValid values: `attempts`, `events`.\n",
            "schema": {
              "type": "string"
            },
            "example": "attempts,events"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of transactions.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginationEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/transactions/{transaction_id}": {
      "get": {
        "operationId": "getTransaction",
        "summary": "Retrieve a transaction",
        "description": "Fetch a single transaction by its ID. Optionally include attempts and events.",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "description": "The transaction ID (ULID format).",
            "schema": {
              "type": "string"
            },
            "example": "01HXYZ9ABC3DEF4GH5JK6LM7NP"
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated list of sub-resources to embed.\nValid values: `attempts`, `events`.\n",
            "schema": {
              "type": "string"
            },
            "example": "attempts,events"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/wallets": {
      "get": {
        "operationId": "listWallets",
        "summary": "List wallets",
        "description": "Retrieve all wallets for your business, one per active currency.",
        "tags": [
          "Wallets"
        ],
        "responses": {
          "200": {
            "description": "List of wallets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Wallet"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/wallets/{currency}": {
      "get": {
        "operationId": "getWallet",
        "summary": "Get wallet by currency",
        "description": "Retrieve a single wallet by its currency code.",
        "tags": [
          "Wallets"
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "description": "Three-letter ISO currency code.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "example": "NGN"
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/wallets/{currency}/transactions": {
      "get": {
        "operationId": "listWalletTransactions",
        "summary": "List wallet transactions",
        "description": "Retrieve a paginated ledger of credits, debits, and reservations for a wallet.",
        "tags": [
          "Wallets"
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "description": "Three-letter ISO currency code.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "example": "NGN"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated wallet transaction history.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginationEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/WalletTransaction"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/fees/preview": {
      "post": {
        "operationId": "previewFee",
        "summary": "Preview transaction fee",
        "description": "Calculate the fee that would be charged for a transaction with the given parameters.\nUse this before creating a transaction to show the user the total cost.\n",
        "tags": [
          "Fees"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeePreviewRequest"
              },
              "example": {
                "amount": "50000.00",
                "currency": "NGN",
                "payment_method": "bank",
                "country_code": "NG"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fee breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeePreview"
                },
                "example": {
                  "amount": "50000.00",
                  "fee_amount": "150.00",
                  "total_debit": "50150.00",
                  "fee_type": "flat"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No fee schedule found for the given parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "No fee schedule found for the specified corridor."
                  },
                  "request_id": "req_8c2b5e1d4a3f"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/institutions": {
      "get": {
        "operationId": "listInstitutions",
        "summary": "List institutions",
        "description": "Retrieve supported banks and mobile money operators.\nFilter by country and type to get the institutions relevant to your payment corridor.\n",
        "tags": [
          "Institutions"
        ],
        "parameters": [
          {
            "name": "country_code",
            "in": "query",
            "description": "Filter by two-letter ISO country code.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "NG"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by institution type: `bank` or `mobile_money`.",
            "schema": {
              "type": "string",
              "enum": [
                "bank",
                "mobile_money"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of institutions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Institution"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of matching institutions."
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 12,
                      "code": "ACCESS_NG",
                      "name": "Access Bank",
                      "short_name": "Access",
                      "type": "bank",
                      "country_code": "NG",
                      "account_number_min_length": 10,
                      "account_number_max_length": 10
                    },
                    {
                      "id": 45,
                      "code": "MTN_GH",
                      "name": "MTN Mobile Money",
                      "short_name": "MTN MoMo",
                      "type": "mobile_money",
                      "country_code": "GH",
                      "account_number_min_length": 10,
                      "account_number_max_length": 10
                    }
                  ],
                  "total": 2
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/institutions/{code}": {
      "get": {
        "operationId": "getInstitution",
        "summary": "Get institution by code",
        "description": "Retrieve details for a single institution including account number validation rules.",
        "tags": [
          "Institutions"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "The institution code.",
            "schema": {
              "type": "string"
            },
            "example": "ACCESS_NG"
          }
        ],
        "responses": {
          "200": {
            "description": "Institution details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/accounts/verify": {
      "post": {
        "operationId": "verifyAccount",
        "summary": "Verify a recipient account",
        "description": "Perform a name check on a recipient's bank account or mobile money number.\nUse this to confirm the account holder's name before creating a transaction.\n",
        "tags": [
          "Account Verification"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountVerifyRequest"
              },
              "example": {
                "account_number": "0123456789",
                "institution_code": "ACCESS_NG",
                "payment_method": "bank",
                "currency": "NGN"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountVerifyResult"
                },
                "examples": {
                  "success": {
                    "summary": "Account found",
                    "value": {
                      "account_name": "Adebayo Okonkwo",
                      "status": "success"
                    }
                  },
                  "failed": {
                    "summary": "Account not found",
                    "value": {
                      "account_name": null,
                      "status": "failed"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Get business profile",
        "description": "Retrieve the authenticated business's profile, including KYB status and account details.",
        "tags": [
          "Business"
        ],
        "responses": {
          "200": {
            "description": "Business profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessProfile"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "operationId": "getDashboardSummary",
        "summary": "Get dashboard summary",
        "description": "Retrieve aggregate transaction metrics and recent transaction activity.",
        "tags": [
          "Business"
        ],
        "responses": {
          "200": {
            "description": "Dashboard summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummary"
                },
                "example": {
                  "total_transactions": 1284,
                  "success_count": 1150,
                  "pending_count": 42,
                  "failed_count": 92,
                  "recent_transactions": [
                    {
                      "id": "01HXYZ9ABC3DEF4GH5JK6LM7NP",
                      "external_reference": "pay-inv-20260115-001",
                      "status": "completed",
                      "amount": "50000.00",
                      "currency": "NGN",
                      "payment_method": "bank",
                      "created_at": "2026-01-15T09:30:00Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "webhooks": {
    "transaction.completed": {
      "post": {
        "operationId": "webhookTransactionCompleted",
        "summary": "Transaction completed",
        "description": "Sent when a transaction reaches a terminal state.",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "name": "X-Sikafx-Signature",
            "in": "header",
            "required": true,
            "description": "HMAC-SHA256 signature of the payload.\nFormat: `sha256=<hex_digest>`.\nComputed as `HMAC-SHA256(timestamp + \".\" + body, webhook_secret)`.\n",
            "schema": {
              "type": "string"
            },
            "example": "sha256=d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592"
          },
          {
            "name": "X-Sikafx-Event",
            "in": "header",
            "required": true,
            "description": "The event type.",
            "schema": {
              "type": "string"
            },
            "example": "transaction.completed"
          },
          {
            "name": "X-Sikafx-Delivery-Id",
            "in": "header",
            "required": true,
            "description": "Unique delivery ID for deduplication.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Sikafx-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix epoch seconds when the webhook was sent.",
            "schema": {
              "type": "string"
            },
            "example": "1737012600"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              },
              "example": {
                "event": "transaction.completed",
                "delivery_id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                "timestamp": "2026-01-15T10:30:00Z",
                "data": {
                  "id": "01HXYZ9ABC3DEF4GH5JK6LM7NP",
                  "external_reference": "pay-inv-20260115-001",
                  "status": "completed",
                  "amount": "50000.00",
                  "currency": "NGN",
                  "fee_amount": "150.00",
                  "total_debit": "50150.00",
                  "payment_method": "bank",
                  "country_code": "NG",
                  "recipient_account_number": "0123456789",
                  "recipient_account_name": "Adebayo Okonkwo",
                  "completed_at": "2026-01-15T10:30:00Z",
                  "created_at": "2026-01-15T09:30:00Z"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received. Any 2xx response is treated as successful delivery."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Pass your API key as a Bearer token. Sandbox keys start with `sk_test_`,\nproduction keys with `sk_live_`.\n"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-indexed).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Number of items per page (max 100).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "Unique key to ensure idempotent request processing. Keys expire after 24 hours.\nIf a request with the same key has already been processed, the original response is returned.\n",
        "schema": {
          "type": "string"
        },
        "example": "idk_a1b2c3d4e5f6"
      }
    },
    "schemas": {
      "CreateTransactionRequest": {
        "type": "object",
        "required": [
          "external_reference",
          "amount",
          "currency",
          "payment_method",
          "country_code",
          "institution_id",
          "recipient_account_number",
          "recipient_account_name"
        ],
        "properties": {
          "external_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Your unique reference for this transaction. Must be alphanumeric with dashes and underscores.",
            "example": "pay-inv-20260115-001"
          },
          "amount": {
            "type": "string",
            "description": "Payment amount. Up to 15 integer digits and 4 decimal places.",
            "example": "50000.00"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "Three-letter ISO 4217 currency code.",
            "example": "NGN"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "bank",
              "mobile_money"
            ],
            "description": "Payment method."
          },
          "country_code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Two-letter ISO 3166-1 country code.",
            "example": "NG"
          },
          "institution_id": {
            "type": "integer",
            "description": "ID of the recipient's institution (from the Institutions endpoint).",
            "example": 12
          },
          "recipient_account_number": {
            "type": "string",
            "description": "Recipient's account number or mobile money number.",
            "example": "0123456789"
          },
          "recipient_account_name": {
            "type": "string",
            "description": "Recipient's full name as registered with the institution.",
            "example": "Adebayo Okonkwo"
          },
          "narration": {
            "type": "string",
            "maxLength": 500,
            "description": "Payment description or memo.",
            "example": "Invoice #1042 payment"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "description": "URL to receive webhook notifications for this transaction. Overrides your default webhook URL.",
            "example": "https://example.com/webhooks/sikafx"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary key-value pairs attached to the transaction. Returned in responses and webhooks.",
            "example": {
              "invoice_id": "INV-1042"
            }
          }
        }
      },
      "FeePreviewRequest": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "payment_method",
          "country_code"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Transaction amount to calculate fees for.",
            "example": "50000.00"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "Three-letter ISO 4217 currency code.",
            "example": "NGN"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "bank",
              "mobile_money"
            ],
            "description": "Payment method."
          },
          "country_code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Two-letter ISO 3166-1 country code.",
            "example": "NG"
          }
        }
      },
      "AccountVerifyRequest": {
        "type": "object",
        "required": [
          "account_number",
          "institution_code",
          "payment_method",
          "currency"
        ],
        "properties": {
          "account_number": {
            "type": "string",
            "description": "Account number or mobile money number to verify.",
            "example": "0123456789"
          },
          "institution_code": {
            "type": "string",
            "description": "Institution code (from the Institutions endpoint).",
            "example": "ACCESS_NG"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "bank",
              "mobile_money"
            ],
            "description": "Payment method."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "Three-letter ISO 4217 currency code.",
            "example": "NGN"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique transaction ID (ULID format).",
            "example": "01HXYZ9ABC3DEF4GH5JK6LM7NP"
          },
          "external_reference": {
            "type": "string",
            "description": "Your external reference.",
            "example": "pay-inv-20260115-001"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed",
              "expired",
              "cancelled",
              "refunded"
            ],
            "description": "Current transaction status.\n- `pending` — Transaction received and being validated.\n- `processing` — Submitted to the payment provider.\n- `completed` — Payment delivered successfully.\n- `failed` — Payment could not be completed.\n- `expired` — Transaction timed out before completion.\n- `cancelled` — Transaction was cancelled.\n- `refunded` — Payment was refunded to your wallet.\n"
          },
          "amount": {
            "type": "string",
            "description": "Payment amount.",
            "example": "50000.00"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "example": "NGN"
          },
          "fee_amount": {
            "type": "string",
            "description": "Fee charged for this transaction.",
            "example": "150.00"
          },
          "total_debit": {
            "type": "string",
            "description": "Total amount debited from your wallet (`amount` + `fee_amount`).",
            "example": "50150.00"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "bank",
              "mobile_money"
            ],
            "description": "Payment method used."
          },
          "country_code": {
            "type": "string",
            "description": "ISO 3166-1 country code.",
            "example": "NG"
          },
          "institution_id": {
            "type": "integer",
            "description": "Institution ID.",
            "example": 12
          },
          "recipient_account_number": {
            "type": "string",
            "description": "Recipient's account number.",
            "example": "0123456789"
          },
          "recipient_account_name": {
            "type": "string",
            "description": "Recipient's name.",
            "example": "Adebayo Okonkwo"
          },
          "narration": {
            "type": [
              "string",
              "null"
            ],
            "description": "Payment description.",
            "example": "Invoice #1042 payment"
          },
          "callback_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Webhook URL for this transaction."
          },
          "provider_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference returned by the payment provider."
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ],
            "description": "Environment this transaction was created in."
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "description": "Custom metadata attached to the transaction."
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the transaction was submitted to the provider."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the transaction reached a terminal state."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the transaction was created."
          },
          "attempts": {
            "type": [
              "array",
              "null"
            ],
            "description": "Provider delivery attempts. Only included when `?include=attempts`.",
            "items": {
              "$ref": "#/components/schemas/TransactionAttempt"
            }
          },
          "events": {
            "type": [
              "array",
              "null"
            ],
            "description": "Status change history. Only included when `?include=events`.",
            "items": {
              "$ref": "#/components/schemas/TransactionEvent"
            }
          }
        }
      },
      "TransactionAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "attempt_number": {
            "type": "integer",
            "description": "Sequential attempt number (1-based)."
          },
          "provider_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "success",
              "failed",
              "timeout",
              "network_error"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ],
            "description": "HTTP status code returned by the provider."
          },
          "is_fallback": {
            "type": "boolean",
            "description": "Whether this attempt used a fallback provider."
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Round-trip time in milliseconds."
          }
        }
      },
      "TransactionEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "event_type": {
            "type": "string",
            "description": "Type of event (e.g. `status_change`, `provider_callback`)."
          },
          "old_status": {
            "type": [
              "string",
              "null"
            ],
            "description": "Previous transaction status."
          },
          "new_status": {
            "type": "string",
            "description": "New transaction status."
          },
          "triggered_by": {
            "type": "string",
            "description": "What triggered this event (e.g. `system`, `provider`, `admin`)."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "example": "NGN"
          },
          "available_balance": {
            "type": "string",
            "description": "Balance available for transactions.",
            "example": "1250000.00"
          },
          "reserved_balance": {
            "type": "string",
            "description": "Balance reserved for pending transactions.",
            "example": "50150.00"
          },
          "total_balance": {
            "type": "string",
            "description": "Total balance (`available_balance` + `reserved_balance`).",
            "example": "1300150.00"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "frozen",
              "closed"
            ],
            "description": "Wallet status."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_transaction_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the last wallet transaction occurred."
          }
        }
      },
      "WalletTransaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "credit",
              "debit",
              "reserve",
              "release",
              "refund"
            ],
            "description": "Transaction type."
          },
          "amount": {
            "type": "string",
            "description": "Transaction amount.",
            "example": "50150.00"
          },
          "balance_before": {
            "type": "string",
            "description": "Wallet balance before this transaction.",
            "example": "1300150.00"
          },
          "balance_after": {
            "type": "string",
            "description": "Wallet balance after this transaction.",
            "example": "1250000.00"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description.",
            "example": "Payment to Adebayo Okonkwo - pay-inv-20260115-001"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Associated reference."
          },
          "transaction_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Associated payment transaction ID, if applicable."
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Institution": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "Unique institution code. Use this when verifying accounts.",
            "example": "ACCESS_NG"
          },
          "name": {
            "type": "string",
            "description": "Full institution name.",
            "example": "Access Bank"
          },
          "short_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Abbreviated name.",
            "example": "Access"
          },
          "type": {
            "type": "string",
            "enum": [
              "bank",
              "mobile_money"
            ],
            "description": "Institution type."
          },
          "country_code": {
            "type": "string",
            "description": "Two-letter ISO country code.",
            "example": "NG"
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL to the institution's logo."
          },
          "account_number_pattern": {
            "type": [
              "string",
              "null"
            ],
            "description": "Regex pattern for validating account numbers.",
            "example": "^\\d{10}$"
          },
          "account_number_min_length": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Minimum account number length.",
            "example": 10
          },
          "account_number_max_length": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Maximum account number length.",
            "example": 10
          }
        }
      },
      "FeePreview": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Original transaction amount.",
            "example": "50000.00"
          },
          "fee_amount": {
            "type": "string",
            "description": "Calculated fee.",
            "example": "150.00"
          },
          "total_debit": {
            "type": "string",
            "description": "Total debit (`amount` + `fee_amount`).",
            "example": "50150.00"
          },
          "fee_type": {
            "type": "string",
            "enum": [
              "flat",
              "percentage",
              "flat_plus_percentage",
              "tiered"
            ],
            "description": "Type of fee schedule applied."
          }
        }
      },
      "AccountVerifyResult": {
        "type": "object",
        "properties": {
          "account_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The registered account holder's name, or null if verification failed.",
            "example": "Adebayo Okonkwo"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ],
            "description": "Whether the account was found and verified."
          }
        }
      },
      "BusinessProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "SikaFX Ltd"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@sikafx.com"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "website": {
            "type": [
              "string",
              "null"
            ]
          },
          "business_type": {
            "type": "string",
            "example": "remittance"
          },
          "registration_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_code": {
            "type": "string",
            "example": "GH"
          },
          "address": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "street": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "postal_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "kyb_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "description": "Know Your Business verification status."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_activation",
              "active",
              "suspended",
              "terminated"
            ],
            "description": "Account status."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "total_transactions": {
            "type": "integer",
            "description": "Total number of transactions.",
            "example": 1284
          },
          "success_count": {
            "type": "integer",
            "description": "Number of completed transactions.",
            "example": 1150
          },
          "pending_count": {
            "type": "integer",
            "description": "Number of pending and processing transactions.",
            "example": 42
          },
          "failed_count": {
            "type": "integer",
            "description": "Number of failed transactions.",
            "example": 92
          },
          "recent_transactions": {
            "type": "array",
            "description": "Most recent transactions.",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Current page number (1-indexed).",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "description": "Items per page.",
            "example": 20
          },
          "total_items": {
            "type": "integer",
            "description": "Total number of matching items.",
            "example": 95
          },
          "total_pages": {
            "type": "integer",
            "description": "Total number of pages.",
            "example": 5
          },
          "has_next": {
            "type": "boolean",
            "description": "Whether there is a next page.",
            "example": true
          },
          "has_previous": {
            "type": "boolean",
            "description": "Whether there is a previous page.",
            "example": false
          }
        }
      },
      "PaginationEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code.",
                "example": "validation_error"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message.",
                "example": "Invalid request parameters."
              },
              "details": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field-level error details (for validation errors).",
                "example": {
                  "amount": "must be greater than 0"
                }
              }
            }
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier for support reference.",
            "example": "req_4c8a3b1e5d2f"
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "description": "Payload delivered to your webhook URL when a transaction reaches a terminal state.\n",
        "properties": {
          "event": {
            "type": "string",
            "description": "Event type. One of:\n- `transaction.completed`\n- `transaction.failed`\n- `transaction.expired`\n- `transaction.cancelled`\n- `transaction.refunded`\n",
            "example": "transaction.completed"
          },
          "delivery_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique delivery ID. Use for deduplication.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the event was generated.",
            "example": "2026-01-15T10:30:00Z"
          },
          "data": {
            "$ref": "#/components/schemas/Transaction"
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid request parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "validation_error",
                "message": "Invalid request parameters.",
                "details": {
                  "amount": "must be greater than 0",
