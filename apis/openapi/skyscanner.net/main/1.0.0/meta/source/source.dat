      "rpcflightsliveQuery": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "description": "Market for which the search is for. e.g. `UK`. We provide a Culture API to get all the markets we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api)."
          },
          "locale": {
            "type": "string",
            "description": "Locale that the results are returned in. e.g. `en-GB`. We provide a Culture API to get all the locales we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api)."
          },
          "currency": {
            "type": "string",
            "description": "Currency that the search results are returned in. e.g. `GBP`. We provide a Culture API to get all the currencies we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api)."
          },
          "queryLegs": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/liveQueryLeg"
            },
            "description": "List of legs to search for."
          },
          "cabinClass": {
            "$ref": "#/definitions/liveCabinClass",
            "description": "Cabin class object to specify search. E.g.: `economy`, `business`, `first`."
          },
          "adults": {
            "type": "integer",
            "format": "int32",
            "description": "Number of adults. Should be greater than or equal to 1."
          },
          "childrenAges": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "List of children ages."
          },
          "includedCarriersIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of included carriers."
          },
          "excludedCarriersIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of excluded carriers."
          },
          "includedAgentsIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of included agents."
          },
          "excludedAgentsIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of excluded agents."
          },
          "includeSustainabilityData": {
            "type": "boolean",
            "description": "Option to include sustainability data."
          },
          "nearbyAirports": {
            "type": "boolean",
            "description": "Option to include nearby airports\nPlease note that this option relates only for the origin.\nNearby airports for the destination is not supported at the moment."
          },
          "includeBaggageData": {
            "type": "boolean",
            "description": "DEPRECATED: This is not functional at the moment, please ignore this field.\nOption to include baggage and other additional attribute fields as part of the response.\nPlease note that the baggage and other additional attribute will not be returned\nunless you've onboarded into the Baggage and Additional Attributes feature by speaking to your Skyscanner account manager.",
            "title": "Include Baggage Data flag"
          }
        },
        "description": "Query object for request."
      },
