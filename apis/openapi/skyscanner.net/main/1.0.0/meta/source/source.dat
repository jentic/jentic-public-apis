          "excessInsurance": {
            "$ref": "#/definitions/typesPrice"
          },
          "fuel": {
            "$ref": "#/definitions/liveFuel",
            "description": "Any information about anything fuel-related for the quote",
            "title": "Fuel"
          },
          "includedMileage": {
            "$ref": "#/definitions/liveIncludedMileage",
            "description": "Mileage included for the quote",
            "title": "Included mileage"
          }
        },
        "description": "Message for storing additional services as part of the quote",
        "title": "Additions"
      },
      "liveFreeDrivers": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
