          "minAge": {
            "type": "integer",
            "format": "int32",
            "description": "The minimum age for the free additional drivers",
            "title": "Minimum age"
          }
        },
        "description": "Nested message for free additional driver of the quote",
        "title": "Free drivers"
      },
      "liveFuel": {
        "type": "object",
        "properties": {
          "policy": {
            "$ref": "#/definitions/liveFuelPolicy",
            "description": "Fuel policy for the quote",
            "title": "Fuel policy"
          },
          "fair": {
            "type": "boolean",
            "description": "Whether fuel policy is fair",
            "title": "Fair"
          },
          "type": {
            "$ref": "#/definitions/carhireFuelType",
            "description": "The type of fuel for the quote",
            "title": "Fuel type"
          }
        },
        "description": "Message containing fuel information",
        "title": "Fuel"
      },
      "liveFuelPolicy": {
        "type": "string",
        "enum": [
          "FUEL_POLICY_UNSPECIFIED",
          "FUEL_POLICY_FULL_TO_FULL",
          "FUEL_POLICY_FULL_TO_EMPTY",
          "FUEL_POLICY_SAME_TO_SAME",
          "FUEL_POLICY_HALF_TO_HALF",
          "FUEL_POLICY_HALF_TO_EMPTY",
          "FUEL_POLICY_QUARTER_TO_QUARTER",
          "FUEL_POLICY_QUARTER_TO_EMPTY",
          "FUEL_POLICY_EMPTY_TO_EMPTY",
          "FUEL_POLICY_FREE_FULL_TANK"
        ],
        "default": "FUEL_POLICY_UNSPECIFIED",
        "description": "Enum for fuel policy values\n\n - FUEL_POLICY_UNSPECIFIED: Unspecified\n\nThe fuel policy is unspecified or unknown\n - FUEL_POLICY_FULL_TO_FULL: Full to full\n\nFuel policy is full to full\n - FUEL_POLICY_FULL_TO_EMPTY: Full to empty\n\nFuel policy is full to empty\n - FUEL_POLICY_SAME_TO_SAME: Same to same\n\nFuel policy is same to same\n - FUEL_POLICY_HALF_TO_HALF: Half to half\n\nFuel policy is half to half\n - FUEL_POLICY_HALF_TO_EMPTY: Half to empty\n\nFuel policy is half to empty\n - FUEL_POLICY_QUARTER_TO_QUARTER: Quarter to quarter\n\nFuel policy is quarter to quarter\n - FUEL_POLICY_QUARTER_TO_EMPTY: Quarter to empty\n\nFuel policy is quarter to empty\n - FUEL_POLICY_EMPTY_TO_EMPTY: Empty to empty\n\nFuel policy is empty to empty\n - FUEL_POLICY_FREE_FULL_TANK: Free full tank\n\nFuel policy is free full tank",
        "title": "Fuel Policy"
      },
      "liveIncludedMileage": {
        "type": "object",
        "properties": {
          "distance": {
            "type": "string",
            "description": "Distance limit",
            "title": "Distance"
          },
          "unit": {
            "$ref": "#/definitions/carhireliveDistanceUnit",
            "description": "Unit of distance",
            "title": "Distance unit"
          }
        },
        "description": "Object to represent mileage included for the quote",
        "title": "IncludedMileage"
      },
      "liveInsurance": {
        "type": "object",
        "properties": {
          "theftProtection": {
            "type": "boolean",
            "description": "Whether theft protection is included",
            "title": "Theft protection"
          },
          "freeCollisionWaiver": {
            "type": "boolean",
            "description": "Whether free collision waiver is included",
            "title": "Free collision waiver"
          },
          "thirdPartyCover": {
            "type": "boolean",
            "description": "Whether third-party cover is included",
            "title": "Third-party cover"
          }
        },
        "description": "Message for insurance information of the quote",
        "title": "Insurance"
      },
      "liveLivePricesVendor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the vendor",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "description": "The name of the vendor. The value is not localised.",
            "title": "Name"
          },
          "logoUrl": {
            "type": "string",
            "description": "URL of the agent's logo",
            "title": "Logo URL"
          }
        },
        "description": "Message containing information for a specific vendor\nVendors are actual car companies that rent cars.\nNote that vendors can also be both an agent and a vendor at the same time.",
        "title": "Vendor"
      },
      "livePayType": {
        "type": "string",
        "enum": [
          "PAY_TYPE_UNSPECIFIED",
          "PAY_TYPE_ARRIVAL_PAY",
          "PAY_TYPE_MIX_PAY",
          "PAY_TYPE_PRE_PAY"
        ],
        "default": "PAY_TYPE_UNSPECIFIED",
        "description": "The type of payment values for a quote\n~60% of quotes have this value specified\n\n - PAY_TYPE_UNSPECIFIED: Unspecified\n\nThe pay type is unspecified or unknown\n - PAY_TYPE_ARRIVAL_PAY: Arrival pay\n\nPay at the counter, popular in US\n - PAY_TYPE_MIX_PAY: Mix Pay\n\nOTA charges upfront, travellers pays the rest at counter\n - PAY_TYPE_PRE_PAY: Pre-apy\n\nTraveller pays full rental rate to the broker",
        "title": "Pay type"
      },
      "livePickupDropOff": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Specify location using an entity id that represents one of: city, airport, district or train station",
            "title": "Entity id"
          },
          "coordinates": {
            "$ref": "#/definitions/rpcCoordinates",
            "description": "Specify location using coordinates",
            "title": "Coordinates"
          }
        },
        "description": "You can specify it as an entity id or lat/long coordinates",
        "title": "Car Hire Location"
      },
      "livePickupMethod": {
        "type": "string",
        "enum": [
          "PICKUP_METHOD_UNSPECIFIED",
          "PICKUP_METHOD_KEYLESS",
          "PICKUP_METHOD_KEY_AND_GO",
          "PICKUP_METHOD_NORMAL"
        ],
        "default": "PICKUP_METHOD_UNSPECIFIED",
        "description": "Enum for pickup method values\n\n - PICKUP_METHOD_UNSPECIFIED: Unspecified\n\nThe pick-up method is unspecified or unknown\n - PICKUP_METHOD_KEYLESS: Keyless\n\nKeyless pickup method\n - PICKUP_METHOD_KEY_AND_GO: Key and go\n\nKey and go pickup method\n - PICKUP_METHOD_NORMAL: Normal\n\nNormal pickup method",
        "title": "Pick-up method"
      },
      "livePickupType": {
        "type": "string",
        "enum": [
          "PICKUP_TYPE_UNSPECIFIED",
          "PICKUP_TYPE_DESK_IN_TERMINAL",
          "PICKUP_TYPE_MEET_AND_GREET",
          "PICKUP_TYPE_SHUTTLE"
        ],
        "default": "PICKUP_TYPE_UNSPECIFIED",
        "description": "Enum for pickup type values\n\n - PICKUP_TYPE_UNSPECIFIED: Unspecified\n\nThe pick-up type is unspecified or unknown\n - PICKUP_TYPE_DESK_IN_TERMINAL: Desk in terminal\n\nThe pick-up is at desk in terminal\n - PICKUP_TYPE_MEET_AND_GREET: Meet and greet\n\nThe pick-up is by meet and greet\n - PICKUP_TYPE_SHUTTLE: Shuttle\n\nThe pick-up is by shuttle",
        "title": "Pick-up type"
      },
      "car-hire-live-pricing_protobufAny": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          }
