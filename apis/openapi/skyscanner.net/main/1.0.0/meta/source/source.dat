            "title": "Free cancellation"
          },
          "freeBreakdownAssistance": {
            "type": "boolean",
            "description": "Whether free breakdown assistance is available",
            "title": "Free breakdown assistance"
          },
          "unlimitedMileage": {
            "type": "boolean",
            "description": "Whether unlimited mileage is available",
            "title": "Unlimited mileage"
          },
          "additionalDriversFee": {
            "$ref": "#/definitions/liveAdditionalDrivers",
            "description": "Information for any free and/ or paid additional drivers policies for the quote",
