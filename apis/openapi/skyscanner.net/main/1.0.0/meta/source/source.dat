      "typesBaggagePrice": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "int64 price value amount serialised as a string. It could be an empty string if the value is missing."
          },
          "unit": {
            "$ref": "#/definitions/typesPriceUnit",
            "description": "Price amount multiplier used to turn the amount int value into a value with a decimal point. For example, if the unit is `PRICE_UNIT_CENTI` and the amount is `2100` you can represent it as `21.00`."
          }
        },
        "description": "Price object."
      },
      "typesLocalDate": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year in YYYY format. E.g. `2022`.",
            "title": "Year"
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month in int value. E.g. `1` is January or `10` is October.",
            "title": "Month"
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "description": "Day in int value. E.g. `5` or `28`.",
            "title": "Day"
          }
        },
        "description": "Local Date object for dates input without timezone.",
        "title": "Local Date"
      },
      "typesLocalDateTime": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year in YYYY format. E.g. `2022`.",
            "title": "Year"
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month in int value. E.g. `1` is January or `10` is October.",
            "title": "Month"
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "description": "Day in int value. E.g. `5` or `28`.",
            "title": "Day"
          },
          "hour": {
            "type": "integer",
            "format": "int32",
            "description": "Hour in int value. E.g. `3` or `12`.",
            "title": "Hour"
          },
          "minute": {
            "type": "integer",
            "format": "int32",
            "description": "Minute in int value. E.g. `2` or `52`.",
            "title": "Minute"
          },
          "second": {
            "type": "integer",
            "format": "int32",
            "description": "Second in int value. E.g. `1` or `46`.",
            "title": "Second"
          }
        },
        "description": "Local Date Time object for inputing times without timezone.",
        "title": "LocalDateTime"
      },
      "typesPrice": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "int64 price value amount serialised as a string. It could be an empty string if the value is missing."
          },
          "unit": {
            "$ref": "#/definitions/typesPriceUnit",
            "description": "Price amount multiplier used to turn the amount int value into a value with a decimal point. For example, if the unit is `PRICE_UNIT_CENTI` and the amount is `2100` you can represent it as `21.00`."
          },
          "updateStatus": {
            "$ref": "#/definitions/typesPriceUpdateStatus",
            "description": "A status indicating if the price returned is current or still updating. It will only be set for itinerary refresh calls."
          }
        },
        "description": "Price object."
      },
      "typesPriceUnit": {
        "type": "string",
        "enum": [
          "PRICE_UNIT_UNSPECIFIED",
          "PRICE_UNIT_WHOLE",
          "PRICE_UNIT_CENTI",
          "PRICE_UNIT_MILLI",
          "PRICE_UNIT_MICRO"
        ],
        "default": "PRICE_UNIT_UNSPECIFIED",
        "title": "- PRICE_UNIT_UNSPECIFIED: Unit is not specified\n - PRICE_UNIT_WHOLE: unit relation: 1. eg: A whole pound, euro, etc.\n - PRICE_UNIT_CENTI: unit relation: 100; eg: cents\n - PRICE_UNIT_MILLI: unit relation: 1000\n - PRICE_UNIT_MICRO: unit relation: 1000000"
      },
      "typesPriceUpdateStatus": {
        "type": "string",
        "enum": [
          "PRICE_UPDATE_STATUS_UNSPECIFIED",
          "PRICE_UPDATE_STATUS_PENDING",
          "PRICE_UPDATE_STATUS_CURRENT"
        ],
        "default": "PRICE_UPDATE_STATUS_UNSPECIFIED",
        "description": " - PRICE_UPDATE_STATUS_UNSPECIFIED: The update status is not set.\n - PRICE_UPDATE_STATUS_PENDING: The price is still updating.\n - PRICE_UPDATE_STATUS_CURRENT: The price is current."
      },
