      "rpccarhireindicativeDateTimeGroupingType": {
        "type": "string",
        "enum": [
          "DATE_TIME_GROUPING_TYPE_UNSPECIFIED",
          "DATE_TIME_GROUPING_TYPE_BY_DATE",
          "DATE_TIME_GROUPING_TYPE_BY_MONTH",
          "DATE_TIME_GROUPING_TYPE_BY_WEEK"
        ],
        "default": "DATE_TIME_GROUPING_TYPE_UNSPECIFIED",
        "description": "All date grouping type values you can pass in the query.\n\n - DATE_TIME_GROUPING_TYPE_UNSPECIFIED: Unspecified\n\nThe date grouping is not specified or unknown.\nUsing this value will result in a validation error.\n - DATE_TIME_GROUPING_TYPE_BY_DATE: By date\n\nGroup the quotes by day\nImportant: If you use this value then the pick-up and drop-off dates can be only up to 1 month after the current date\n - DATE_TIME_GROUPING_TYPE_BY_MONTH: By month\n\nGroup the quotes by month\n - DATE_TIME_GROUPING_TYPE_BY_WEEK: By week\n\nGroup the quotes by week",
        "title": "DateTimeGroupingType"
      },
      "rpccarhireindicativeIndicativeQuery": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "description": "Market for which the search is for. e.g. `UK`\nWe provide a Culture API to get all the markets we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Market"
          },
          "locale": {
            "type": "string",
            "description": "Locale that the results are returned in. e.g. `en-GB`\nWe provide a Culture API to get all the locales we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "description": "Currency that the search results are returned in. e.g. `GBP`\nWe provide a Culture API to get all the currencies we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Currency"
          },
          "pickUpDate": {
            "$ref": "#/definitions/typesLocalDateTime",
            "description": "Required to be specified\nPick-up time must be in the future and also must be before drop-off time",
            "title": "Date and time of the pick-up"
          },
          "dropOffDate": {
            "$ref": "#/definitions/typesLocalDateTime",
            "description": "Required to be specified\nDrop-off time must be in the future and also must be after pick-up time",
            "title": "Date and time of the drop-off"
          },
          "dateTimeGroupingType": {
            "$ref": "#/definitions/rpccarhireindicativeDateTimeGroupingType",
            "description": "Specifies how the results should be grouped in regards to datetime\nFor example results can be grouped by day, week, month, etc",
            "title": "Date time grouping type"
          },
          "pickUpDropOffLocationEntityId": {
            "type": "string",
            "description": "Specify location using an entity id that represents one of: city, airport, district or train station",
            "title": "Pick-up/ Drop-off location"
          }
        },
        "description": "Object containing fields required for search",
        "title": "IndicativeQuery"
      },
