          },
          "503": {
            "description": "Service Unavailable."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlightsServiceCreateItineraryRefreshBody": {
        "type": "object",
        "properties": {
          "itineraryId": {
            "type": "string",
            "description": "The itinerary id for the price refresh."
          }
        },
        "description": "Create itinerary refresh request object."
      },
      "PricingOptionFareAdvanceChange": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/definitions/PricingOptionFareAssessment",
            "description": "Advance change assessment",
            "title": "Assessment"
          }
        }
      },
      "PricingOptionFareAssessment": {
        "type": "string",
        "enum": [
          "ASSESSMENT_UNKNOWN",
          "ASSESSMENT_INCLUDED",
          "ASSESSMENT_FEE",
          "ASSESSMENT_UNAVAILABLE"
        ],
        "default": "ASSESSMENT_UNKNOWN",
        "description": "Assessment enums for additional flight attributes like baggage, seat prereservation, etc.\n\n - ASSESSMENT_UNKNOWN: Unknown\n\nNo fare attribute information\n - ASSESSMENT_INCLUDED: Included\n\nIncluded in the fare\n - ASSESSMENT_FEE: Fee\n\nAvailable for an additional fee\n - ASSESSMENT_UNAVAILABLE: Unavailable\n\nNot included in the fare at all.",
        "title": "Assessment"
      },
      "PricingOptionFareBaggageFare": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/definitions/PricingOptionFareAssessment",
            "description": "Whether the bag is included for free in the flight ticket, available for a fee or not available",
            "title": "Assessment"
          },
          "pieces": {
            "type": "integer",
            "format": "int32",
            "description": "Number of included pieces of baggage.\nValue is 0 if there are no included items of baggage.",
            "title": "Pieces"
          },
          "fee": {
            "$ref": "#/definitions/typesBaggagePrice",
            "description": "Additional fee for each extra piece of baggage.\nThe price field of this message will be empty if the value of pieces is more than 0.",
            "title": "Additional fee"
          },
          "weight": {
            "type": "string",
            "description": "Weight of the baggage.\nIt can be `lbs` or `kg` and that will depend on the market.\nFor example `lbs` is used for US market.",
            "title": "Weight"
          }
        },
        "description": "A message containing per-leg breakdown of all additional flight attributes, e.g. baggage.",
        "title": "Baggage Fare"
      },
      "PricingOptionFareCancellation": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/definitions/PricingOptionFareAssessment",
            "description": "Cancellation assessment",
            "title": "Assessment"
          }
        }
      },
      "PricingOptionFareFareDetails": {
        "type": "object",
        "properties": {
          "cabinBaggage": {
            "$ref": "#/definitions/PricingOptionFareBaggageFare",
            "description": "Leg cabin baggage information",
            "title": "Cabin baggage"
          },
          "checkedBaggage": {
            "$ref": "#/definitions/PricingOptionFareBaggageFare",
            "description": "Leg checked baggage information",
            "title": "Checked baggage"
          },
          "brandNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Each value in the `brandNames` array is the brand name provided by the agent itself and associates itself with a specific segment in the itinerary.\nThis is why the field is an array instead of a string.\nThe values are not localised.\nExample values are `ECONOMY CLASSIC`, `ECONOMY STANDARD`, etc.",
            "title": "Brand names"
          },
          "seatPreReservation": {
            "$ref": "#/definitions/PricingOptionFareSeatPreReservation",
            "description": "Whether you can pre-select your seat",
            "title": "Seat selection"
          },
          "upgradeEligibility": {
            "$ref": "#/definitions/PricingOptionFareUpgradeEligibility",
            "description": "Whether you can request an upgraded cabin selection",
            "title": "Upgrade Eligibility"
          }
        }
      },
      "PricingOptionFareSeatPreReservation": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/definitions/PricingOptionFareAssessment",
            "description": "Seat selection assessment",
            "title": "Assessment"
          }
        }
      },
      "PricingOptionFareUpgradeEligibility": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/definitions/PricingOptionFareAssessment",
            "description": "Upgrade eligibility assessment",
            "title": "Assessment"
          }
        }
      },
      "flightsliveAgent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the agent. E.g. `easyJet`, `Ryanair`, `Air France`."
          },
          "type": {
            "$ref": "#/definitions/flightsliveAgentType",
            "description": "Agent type."
          },
          "imageUrl": {
            "type": "string",
            "description": "Agent image url."
          },
          "feedbackCount": {
            "type": "integer",
            "format": "int32",
            "description": "Number of users who gave feedback."
          },
          "rating": {
            "type": "number",
            "format": "double",
            "description": "Agent rating."
          },
          "isOptimisedForMobile": {
            "type": "boolean",
            "description": "Indicates if partner website is optimized for mobile."
          }
        },
        "description": "Agent object contains data for agent."
      },
      "flightsliveAgentType": {
        "type": "string",
        "enum": [
          "AGENT_TYPE_UNSPECIFIED",
          "AGENT_TYPE_TRAVEL_AGENT",
          "AGENT_TYPE_AIRLINE"
        ],
        "default": "AGENT_TYPE_UNSPECIFIED",
        "description": "Enum for agent type.\n\n - AGENT_TYPE_UNSPECIFIED: Unspecified agent type.\n - AGENT_TYPE_TRAVEL_AGENT: Agent is a travel agent.\n - AGENT_TYPE_AIRLINE: Agent is a airline."
      },
      "liveAlliance": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Alliance name. E.g. `Star Alliance`."
          }
        },
        "description": "Alliance details. An airline alliance is an aviation industry arrangement between two or more airlines agreeing to cooperate on a substantial level. For example`Star Alliance`."
      },
      "liveCabinClass": {
        "type": "string",
        "enum": [
          "CABIN_CLASS_UNSPECIFIED",
          "CABIN_CLASS_ECONOMY",
          "CABIN_CLASS_PREMIUM_ECONOMY",
          "CABIN_CLASS_BUSINESS",
          "CABIN_CLASS_FIRST"
        ],
        "default": "CABIN_CLASS_UNSPECIFIED",
        "description": "Cabin class Enum to specify class. E.g.: `economy`, `business`, `first`.\n\n - CABIN_CLASS_UNSPECIFIED: cabin class is not specified.\n - CABIN_CLASS_ECONOMY: cabin class is economy.\n - CABIN_CLASS_PREMIUM_ECONOMY: cabin class is premium economy.\n - CABIN_CLASS_BUSINESS: cabin class is business.\n - CABIN_CLASS_FIRST: cabin class is first class."
      },
      "liveCarrier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Carrier name e.g. `British Airways`."
          },
          "allianceId": {
            "type": "string",
            "description": "Alliance id."
          },
          "imageUrl": {
            "type": "string",
            "description": "Carrier image url."
          },
          "iata": {
            "type": "string",
            "description": "IATA code of carrier."
          },
          "icao": {
            "type": "string",
            "description": "ICAO code of the carrier."
          },
          "displayCode": {
            "type": "string",
            "description": "Code that should prefix flight number."
          }
        },
        "description": "Carrier object contains data for carrier."
      },
      "liveCreateItineraryRefreshResponse": {
        "type": "object",
        "properties": {
          "refreshSessionToken": {
            "type": "string",
            "description": "A refresh session token used to poll the itinerary refresh."
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Status of request for polling."
          },
          "content": {
            "$ref": "#/definitions/liveItineraryRefreshSearchContent",
            "description": "Search response object."
          },
          "degradationReasons": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/liveDegradationReason"
            },
            "title": "Degradation within the response, e.g. for missing data\nWill be empty if no degradation is present"
          }
        },
        "description": "Object with itinerary refresh response."
      },
      "liveDegradationReason": {
        "type": "string",
        "enum": [
          "DEGRADATION_REASON_UNSPECIFIED",
          "DEGRADATION_REASON_FARE_ATTRIBUTE_DATA"
        ],
        "default": "DEGRADATION_REASON_UNSPECIFIED",
        "description": "- DEGRADATION_REASON_UNSPECIFIED: Degradation reason is not specified\n - DEGRADATION_REASON_FARE_ATTRIBUTE_DATA: Data about fare attributes (checked baggage, cabin baggage, etc.) might not be full due to an internal error or upstream error\nNote that data can still potentially be populated if it had been for example cached before the error occurred\nWill only appear if Baggage Attributes are enabled",
        "title": "Degradation reason Enum to specify whether the response has degraded"
      },
      "liveFareAttribute": {
        "type": "string",
        "enum": [
          "FARE_ATTRIBUTE_UNSPECIFIED",
          "FARE_ATTRIBUTE_CABIN_BAGGAGE",
          "FARE_ATTRIBUTE_CHECKED_BAGGAGE"
        ],
        "default": "FARE_ATTRIBUTE_UNSPECIFIED",
        "description": "- FARE_ATTRIBUTE_UNSPECIFIED: Fare attribute is not specified\n - FARE_ATTRIBUTE_CABIN_BAGGAGE: Fare attribute for cabin baggage\n - FARE_ATTRIBUTE_CHECKED_BAGGAGE: Fare attribute for checked baggage",
        "title": "Fare attribute enum to specify fare attribute. E.g. `CHECKED_BAGGAGE`, `CABIN_BAGGAGE`"
      },
      "liveFareAttributeFilter": {
        "type": "object",
        "properties": {
          "fareAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/liveFareAttribute"
            },
            "title": "The fare attributes related to this filter"
          },
          "pricingOptionIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "The pricing option ids related to this filter"
          }
        },
        "description": "Fare attribute filter. Represents the pricing options that contain all of the specified fare attributes."
      },
      "liveFareAttributeFilterList": {
        "type": "object",
        "properties": {
          "fareAttributeFilters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/liveFareAttributeFilter"
            },
            "title": "The list of fare attribute filters"
          }
        },
        "description": "List of fare attribute filters."
      },
      "liveItinerary": {
        "type": "object",
        "properties": {
          "pricingOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/livePricingOption"
            },
            "description": "List of pricing options for given itinerary."
          },
          "legIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of leg IDs."
          },
          "sustainabilityData": {
            "$ref": "#/definitions/liveSustainabilityData",
            "description": "Sustainability data for the current itinerary."
          }
        },
        "description": "Itinerary object contains data for itinerary."
      },
      "liveItineraryRefreshSearchContent": {
        "type": "object",
        "properties": {
          "results": {
            "$ref": "#/definitions/rpcflightsliveSearchResults",
            "description": "Results from search."
          }
        },
        "description": "Itinerary refresh search content object."
      },
      "liveItineraryStats": {
        "type": "object",
        "properties": {
          "minDuration": {
            "type": "integer",
            "format": "int32",
            "description": "Time of shortest itinerary."
          },
          "maxDuration": {
            "type": "integer",
            "format": "int32",
            "description": "Time of longest itinerary."
          },
          "total": {
            "$ref": "#/definitions/liveItinerarySummary",
            "description": "Total number of itineraries for search."
          },
          "stops": {
            "$ref": "#/definitions/liveItineraryStopStats",
            "description": "Itineraries stats split by number of stops each itinerary has."
          },
          "hasChangeAirportTransfer": {
            "type": "boolean",
            "description": "Indicates if response contains itineraries with airport transfers."
          }
        },
        "description": "Object containing statistics for itineraries."
      },
      "liveItineraryStopStats": {
        "type": "object",
        "properties": {
          "direct": {
            "$ref": "#/definitions/liveItineraryStopSummaryStats",
            "description": "Itineraries with no stops."
          },
          "oneStop": {
            "$ref": "#/definitions/liveItineraryStopSummaryStats",
            "description": "Itineraries with one stop."
          },
          "twoPlusStops": {
            "$ref": "#/definitions/liveItineraryStopSummaryStats",
            "description": "Itineraries with two stops or more."
          }
        },
        "description": "Itinerary stats based on number of stops."
      },
      "liveItineraryStopSummaryStats": {
        "type": "object",
        "properties": {
          "total": {
            "$ref": "#/definitions/liveItinerarySummary",
            "description": "Number of itineraries."
          },
          "ticketTypes": {
            "$ref": "#/definitions/liveItineraryStopTicketStats",
            "description": "Ticket types stats."
          }
        },
        "description": "Itinerary stats based on stops."
      },
      "liveItineraryStopTicketStats": {
        "type": "object",
        "properties": {
          "singleTicket": {
            "$ref": "#/definitions/liveItinerarySummary",
            "description": "Itineraries that can be booked on a single ticket i.e.: no transfers."
          },
          "multiTicketNonNpt": {
            "$ref": "#/definitions/liveItinerarySummary",
            "description": "Itineraries that have multiple tickets (i.e.: multi stop) but are protected transfers."
          },
          "multiTicketNpt": {
            "$ref": "#/definitions/liveItinerarySummary",
            "description": "Itineraries that have multiple tickets (i.e.: multi stop) but are not protected transfers."
          }
        },
        "description": "Itinerary stats based on type of ticket."
      },
      "liveItinerarySummary": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of itineraries for a given category i.e.: direct, has one stop, has two or more stops etc."
          },
          "minPrice": {
            "$ref": "#/definitions/typesPrice",
            "description": "Minimal price of itinerary for a given category."
          }
        },
        "description": "Itinerary summary for a category."
      },
      "livePollItineraryRefreshResponse": {
        "type": "object",
        "properties": {
          "refreshSessionToken": {
            "type": "string",
            "description": "A refresh session token used to poll the prices refresh."
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Status of request for polling."
          },
          "content": {
            "$ref": "#/definitions/liveItineraryRefreshSearchContent",
            "description": "Search response object."
          },
          "degradationReasons": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/liveDegradationReason"
            },
            "title": "Degradation within the response, e.g. for missing data\nWill be empty if no degradation is present"
          }
        },
        "description": "Object with itinerary refresh response."
      },
      "livePricingOption": {
        "type": "object",
        "properties": {
          "price": {
            "$ref": "#/definitions/typesPrice",
            "description": "The price of the option (sum of the item prices), unless unpriced."
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of agent ids of all pricing items."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/livePricingOptionItem"
            },
            "description": "List of all pricing items."
          },
          "transferType": {
            "$ref": "#/definitions/liveTransferType",
            "description": "The type of transfer when there are multiple segments on an itinerary (more than one flight to get to a destination). More details [here](https://help.skyscanner.net/hc/en-gb/articles/206028971-What-does-it-mean-when-I-see-Non-protected-transfers-or-Self-transfer-flight-on-Skyscanner-)."
          },
          "id": {
            "type": "string",
            "description": "The ID of the pricing option."
          },
          "pricingOptionFare": {
            "$ref": "#/definitions/livePricingOptionFare",
            "description": "Fare attributes aggregated for the pricing option.\nThe attributes data at this level represents the most restrictive option across all legs of the specific pricing option.",
            "title": "Pricing Option Fare"
          }
        },
        "description": "Pricing option object."
      },
      "livePricingOptionFare": {
        "type": "object",
        "properties": {
          "cabinBaggage": {
            "$ref": "#/definitions/PricingOptionFareBaggageFare",
            "description": "Fare cabin baggage information.",
            "title": "Cabin baggage"
          },
          "checkedBaggage": {
            "$ref": "#/definitions/PricingOptionFareBaggageFare",
            "description": "Fare checked baggage information.",
            "title": "Checked Baggage"
          },
          "legDetails": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/PricingOptionFareFareDetails"
            },
            "description": "Per-leg breakdown of flight attributes.\nFor some small % of fares the per-leg attributes can differ from the summarised pricing option attributes.",
            "title": "Leg details"
          },
          "brandNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Each value in the `brandNames` array is the brand name provided by the agent itself and associates itself with a specific segment in the itinerary.\nThis is why the field is an array instead of a string.\nThe values are not localised.\nExample values are `ECONOMY CLASSIC`, `ECONOMY STANDARD`, etc.",
            "title": "Brand names"
          },
          "advanceChange": {
            "$ref": "#/definitions/PricingOptionFareAdvanceChange",
            "description": "Whether you can make changes to your flight before the departure date.",
            "title": "Advance Change"
          },
          "cancellation": {
            "$ref": "#/definitions/PricingOptionFareCancellation",
            "description": "Whether you can cancel",
            "title": "Cancellation"
          },
          "seatPreReservation": {
            "$ref": "#/definitions/PricingOptionFareSeatPreReservation",
            "description": "Whether you can pre-select your seat",
            "title": "Seat selection"
          },
          "upgradeEligibility": {
            "$ref": "#/definitions/PricingOptionFareUpgradeEligibility",
            "description": "Whether you can request an upgraded cabin selection",
            "title": "Upgrade Eligibility"
          }
        },
        "description": "A message containing per-pricing-option breakdown of all additional flight attributes, e.g. baggage.",
        "title": "Pricing Option Fare"
      },
      "livePricingOptionItem": {
        "type": "object",
        "properties": {
          "price": {
            "$ref": "#/definitions/typesPrice",
            "description": "The price of the pricing option item."
          },
          "agentId": {
            "type": "string",
            "description": "ID of the agent selling this pricing option item."
          },
          "deepLink": {
            "type": "string",
            "description": "Deeplink for the partner's booking page."
          },
          "fares": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/livePricingOptionItemFares"
            },
            "description": "List of fares for each segment of this pricing option item."
          }
        },
        "description": "Pricing option item object."
      },
      "livePricingOptionItemFares": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "description": "Segment Id for a specific fare."
          },
          "bookingCode": {
            "type": "string",
            "description": "Booking code. Currently not all airlines / providers provide booking code data so these are expected to be empty in some cases."
          },
          "fareBasisCode": {
            "type": "string",
            "description": "Code used to identify the fare family E.g. `ORTVY`, `OXM0V2H`, `LEOGHT`. Currently not all airlines / providers provide fare data so these are expected to be empty in some cases."
          }
        },
        "description": "Pricing option item fares object."
      },
      "liveQueryLeg": {
        "type": "object",
        "properties": {
          "originPlaceId": {
            "$ref": "#/definitions/rpcQueryPlace",
            "description": "Id of origin for leg."
          },
          "destinationPlaceId": {
            "$ref": "#/definitions/rpcQueryPlace",
            "description": "Id of destination for leg."
          },
          "date": {
            "$ref": "#/definitions/typesLocalDate",
            "description": "Search date of the leg."
          }
        },
        "description": "Query leg object containing request data for origin, destination and date."
      },
      "liveSegment": {
        "type": "object",
        "properties": {
          "originPlaceId": {
            "type": "string",
            "description": "Segment origin place id."
          },
          "destinationPlaceId": {
            "type": "string",
            "description": "Segment destination place id."
          },
          "departureDateTime": {
            "$ref": "#/definitions/typesLocalDateTime",
            "description": "Departure date and time."
          },
          "arrivalDateTime": {
            "$ref": "#/definitions/typesLocalDateTime",
            "description": "Arrival date and time."
          },
          "durationInMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "Duration of flight in minutes."
          },
          "marketingFlightNumber": {
            "type": "string",
            "description": "Flight number. E.g. `146`, `1712`."
          },
          "marketingCarrierId": {
            "type": "string",
            "description": "The carrier id selling the flight."
          },
          "operatingCarrierId": {
            "type": "string",
            "description": "The carrier id operating the flight."
          }
        },
        "description": "Segment object contains data for segment."
      },
      "liveStats": {
        "type": "object",
        "properties": {
          "itineraries": {
            "$ref": "#/definitions/liveItineraryStats",
            "description": "Overview of stats for all itineraries."
          }
        },
        "description": "Stats object."
      },
      "liveSustainabilityData": {
        "type": "object",
        "properties": {
          "isEcoContender": {
            "type": "boolean",
            "description": "Indicates if a flight is a eco contender."
          },
          "ecoContenderDelta": {
            "type": "number",
            "format": "float",
            "description": "Eco contender delta percentage."
          }
        },
        "description": "Sustainability data object."
      },
      "liveTransferType": {
        "type": "string",
        "enum": [
          "TRANSFER_TYPE_UNSPECIFIED",
          "TRANSFER_TYPE_MANAGED",
          "TRANSFER_TYPE_SELF_TRANSFER",
          "TRANSFER_TYPE_PROTECTED_SELF_TRANSFER"
        ],
        "default": "TRANSFER_TYPE_UNSPECIFIED",
        "description": "The type of transfer when there are multiple segments on an itinerary (more than one flight to get from the a destination). More details [here](https://help.skyscanner.net/hc/en-gb/articles/206028971-What-does-it-mean-when-I-see-Non-protected-transfers-or-Self-transfer-flight-on-Skyscanner-).\n\n - TRANSFER_TYPE_UNSPECIFIED: The transfer type is not specified.\n - TRANSFER_TYPE_MANAGED: A protected transfer, managed by the agent. If a flights is delayed and the travellers miss their connection, the agent will find alternatives an no extra cost.\n - TRANSFER_TYPE_SELF_TRANSFER: A non-protected transfer. The travellers will have multiple booking references. If a flights is delayed and the travellers miss their connection they will have to buy a whole new ticket.\n - TRANSFER_TYPE_PROTECTED_SELF_TRANSFER: Self transfer flights that are protected by the online travel agent rather than the airline. If a flights is delayed and the travellers miss their connection they can contact the travel agent to help with the rebooking."
      },
      "placesPlace": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "A unique ID for the place. It's an internal ID and it doesn't have any meaning outside of our APIs."
          },
          "parentId": {
            "type": "string",
            "description": "A reference to another place, i.e. an airport can have a parent place which is a city.\nPlease note that in Skyscanner Geo model an airport can only have one parent city id.\nFor example for Baltimore-Washington International Airport (BWI) is linked to only Washington, D.C. instead of  both Baltimore and Washington."
          },
          "name": {
            "type": "string",
            "description": "The localised name of the place."
          },
          "type": {
            "$ref": "#/definitions/placesPlaceType",
            "description": "The type of the place."
          },
          "iata": {
            "type": "string",
            "description": "The IATA code of the place. It will only be set for airports and cities."
          },
          "coordinates": {
            "$ref": "#/definitions/rpcCoordinates",
            "description": "Coordinates of the place."
          }
        },
        "description": "The place details."
      },
      "placesPlaceType": {
        "type": "string",
        "enum": [
          "PLACE_TYPE_UNSPECIFIED",
          "PLACE_TYPE_AIRPORT",
          "PLACE_TYPE_CITY",
          "PLACE_TYPE_COUNTRY",
          "PLACE_TYPE_CONTINENT",
          "PLACE_TYPE_ISLAND"
        ],
        "default": "PLACE_TYPE_UNSPECIFIED",
        "description": "The type of the place."
      },
      "protobufAny": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "rpcCoordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "The coordinates latitude",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "The coordinates longitude",
            "title": "Longitude"
          }
        }
      },
      "rpcQueryPlace": {
        "type": "object",
        "properties": {
          "iata": {
            "type": "string",
            "description": "IATA code."
          },
          "entityId": {
            "type": "string",
            "description": "entity id."
          }
        },
        "description": "Place query object."
      },
      "rpcResultAction": {
        "type": "string",
        "enum": [
          "RESULT_ACTION_UNSPECIFIED",
          "RESULT_ACTION_REPLACED",
          "RESULT_ACTION_NOT_MODIFIED",
          "RESULT_ACTION_OMITTED"
        ],
        "default": "RESULT_ACTION_UNSPECIFIED",
        "description": "Instructs clients on how to treat the SearchResults contained in a `SearchContent`.\nPrior results should only be replaced if the action is explicitly `RESULT_ACTION_REPLACED`.\n\n - RESULT_ACTION_UNSPECIFIED: Result action is not specified.\n - RESULT_ACTION_REPLACED: Result action is to replace, as the results have been changed.\n - RESULT_ACTION_NOT_MODIFIED: Result action is not to modify, as no changes have occurred.\n - RESULT_ACTION_OMITTED: Results for this vertical have been omitted."
      },
      "rpcResultStatus": {
        "type": "string",
        "enum": [
          "RESULT_STATUS_UNSPECIFIED",
          "RESULT_STATUS_COMPLETE",
          "RESULT_STATUS_INCOMPLETE",
          "RESULT_STATUS_FAILED"
        ],
        "default": "RESULT_STATUS_UNSPECIFIED",
        "description": "Results status Enum.\n\n - RESULT_STATUS_UNSPECIFIED: Results status not specified.\n - RESULT_STATUS_COMPLETE: Results are now complete.\n - RESULT_STATUS_INCOMPLETE: Results are not complete yet.\n - RESULT_STATUS_FAILED: Search has failed."
      },
      "rpcStatus": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/protobufAny"
            }
          }
        }
      },
