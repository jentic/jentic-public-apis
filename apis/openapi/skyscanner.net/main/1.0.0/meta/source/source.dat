            "items": {
              "type": "object",
              "$ref": "#/definitions/v1HotelImage"
            },
            "description": "The list of images of the hotel",
            "title": "Hotel Images"
          },
          "guestRating": {
            "$ref": "#/definitions/v1GuestRating",
            "description": "Aggregated summary of guest reviews for the hotel.\nThe rating is sourced from a guest rating supply partner selected\nbased on an internal priority order, choosing the highest-priority\navailable provider.\nThe selected supply partner may vary depending on availability.",
            "title": "Guest rating"
          }
        },
        "description": "Static information about a hotel",
        "title": "Hotel content"
      },
      "hotelslivev1HotelsFilter": {
        "type": "object",
        "properties": {
          "starsFilter": {
            "$ref": "#/definitions/v1StarsFilter",
            "description": "Will filter out any hotels that aren't equal to the values provided inside.\nE.g. if the filter is: [THREE, FOUR] then pricing options for only hotels that have exactly 3 OR 4 stars will be returned as part of the results.",
            "title": "Stars Filter"
          },
          "chainIdFilter": {
            "$ref": "#/definitions/v1ChainFilter",
            "description": "Will filter out any offers for hotels whose chain id isn't equal to any values inside the filter message.\nE.g. if the filter is: [ID_1, ID_2] then pricing options for hotels that have exactly ID_1 OR ID_2 as their chain id values will be returned as part of the results.",
            "title": "Chain Id Filter"
          },
          "hotelGroupFilter": {
            "$ref": "#/definitions/v1GroupFilter",
            "description": "Will filter out any offers for hotels whose group id isn't equal to any values inside the filter message.\nE.g. if the filter is: [ID_1, ID_2] then pricing options for hotels that have exactly ID_1 OR ID_2 as their group id values will be returned as part of the results.",
            "title": "Hotel Group Filter"
          },
          "priceRangeFilter": {
            "$ref": "#/definitions/v1PriceRangeFilter",
            "description": "Will filter out any offers whose price isn't in the specific range.",
            "title": "Price Range Filter"
          },
          "hotelAmenitiesFilter": {
            "$ref": "#/definitions/v1HotelAmenitiesFilter",
            "description": "Will filter out any offers for hotels which do not provide ALL values inside the filter message.\nE.g. each of the amenities filter values is a filter on their own unlike other filters.",
            "title": "Hotel Amenities Filter"
          },
          "hotelGuestTypeFilter": {
            "$ref": "#/definitions/v1HotelGuestTypeFilter",
            "description": "Will filter out any offers for hotels whose guest type classification is not any of the values inside the filter message.",
            "title": "Guest Type Filter"
          },
          "accommodationTypeFilter": {
            "$ref": "#/definitions/v1AccommodationTypeFilter",
            "description": "Will filter out any offers for hotels whose accommodation type classification is not any of the values inside the filter message.",
            "title": "Accommodation Type Filter"
          },
          "mealPlanFilter": {
            "$ref": "#/definitions/v1MealPlanFilter",
            "description": "Will filter out any offers that don't provide ANY of the meal plan values inside the filter message.",
            "title": "Meal Plan Filter"
          },
          "cancellationTypeFilter": {
            "$ref": "#/definitions/v1CancellationPolicyTypeFilter",
            "description": "Will filter out any offers that don't provide ANY of the cancellation values inside the filter message.",
            "title": "Cancellation Type Filter"
          },
          "paymentTypeFilter": {
            "$ref": "#/definitions/v1PaymentTypeFilter",
            "description": "Will filter out any offers that don't provide ANY of the payment type values inside the filter message.",
            "title": "Payment Type Filter"
          },
          "geoAreaFilter": {
            "$ref": "#/definitions/v1GeoAreaFilter",
            "description": "Will filter out any offers for hotels that are located OUTSIDE of the specific geo area filter.\nFor a geo area filter to be valid at least 2 coordinate values have to be specified.",
            "title": "Geo Area Filter"
          },
          "agentFilter": {
            "$ref": "#/definitions/v1AgentsFilter",
            "description": "Includes only hotel offers where the agent ID matches one of the IDs specified in this filter.\nFor example, if the filter contains [ID_1, ID_2], only pricing options from agents with these IDs will be included.",
            "title": "Agents Filter"
          }
        },
        "description": "A message encapsulating all possible filter types to add to the query.",
        "title": "Hotels Filter"
      },
      "hotelslivev1SearchResults": {
        "type": "object",
        "properties": {
          "hotelsPricingOptions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/v1HotelPricingOption"
            },
            "description": "Contains the search results with offers from different agents.\nThe key is in the format of {hotel_id}_{pricing_option_id}",
            "title": "Hotel Pricing Options"
          },
          "agents": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/livev1Agent"
            },
            "description": "A map where the key is the agent id and the value is the actual agent information.",
            "title": "Agents"
          },
          "hotelInfo": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/v1HotelInfo"
            },
            "description": "Hotel information related to the search.\nFor example it will contain how far the hotel is to the location from the request.\nThe key is the hotel id and the value is the hotel information.",
            "title": "Hotel Info"
          },
          "hotelContent": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/hotelslivev1HotelContent"
            },
            "description": "Static information about a specific hotel such as name, star rating, etc.\nThe key is the hotel id and the value is static hotel information.",
            "title": "Hotel Content"
          },
          "sortOptions": {
            "$ref": "#/definitions/v1SortOptions",
            "description": "Information related to the sorting applied as well as the sort scores in the response.",
            "title": "Sort Options"
          }
        },
        "title": "Search results object"
      },
      "hotelslivev1SortOrderType": {
        "type": "string",
        "enum": [
          "SORT_ORDER_TYPE_UNSPECIFIED",
          "SORT_ORDER_TYPE_PRICE",
          "SORT_ORDER_TYPE_HOTEL_PROXIMITY",
          "SORT_ORDER_TYPE_HOTEL_STAR_RATING",
          "SORT_ORDER_TYPE_HOTEL_DISCOUNT",
          "SORT_ORDER_TYPE_BEST"
        ],
        "default": "SORT_ORDER_TYPE_UNSPECIFIED",
        "description": "- SORT_ORDER_TYPE_UNSPECIFIED: Default value when not specified\n - SORT_ORDER_TYPE_PRICE: Order by price\n - SORT_ORDER_TYPE_HOTEL_PROXIMITY: Order by hotel proximity\n - SORT_ORDER_TYPE_HOTEL_STAR_RATING: Order by hotel star rating\n - SORT_ORDER_TYPE_HOTEL_DISCOUNT: Order by hotel discount\n - SORT_ORDER_TYPE_BEST: Order by \"best\" score, this score can be computed differently across inventories",
        "title": "Sorting type"
      },
      "livev1Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the agent",
            "title": "Id"
          },
          "logoUrl": {
            "type": "string",
            "description": "Agent logo url",
            "title": "Logo URL"
          },
          "agentType": {
            "$ref": "#/definitions/livev1AgentType",
            "description": "The type of agent",
            "title": "Agent type"
          },
          "name": {
            "type": "string",
            "description": "The name of the agent. Not a localised value.",
            "title": "Name"
          }
        },
        "description": "A message containing Agent information in the context of Hotels Live Pricing API",
        "title": "Agent"
      },
      "livev1AgentType": {
        "type": "string",
        "enum": [
          "AGENT_TYPE_UNSPECIFIED",
          "AGENT_TYPE_OTA",
          "AGENT_TYPE_CHAIN",
          "AGENT_TYPE_GROUP",
          "AGENT_TYPE_CRS",
          "AGENT_TYPE_IBE"
        ],
        "default": "AGENT_TYPE_UNSPECIFIED",
        "description": "- AGENT_TYPE_UNSPECIFIED: Default value when not specified\n - AGENT_TYPE_OTA: OTA\n\nAgent is an Online Travel Agency\n - AGENT_TYPE_CHAIN: Chain\n\nAgent is a hotels chain\n - AGENT_TYPE_GROUP: Group\n\nAgent ia a hotels group\n - AGENT_TYPE_CRS: Computer Reservation System\n\nAgent is a Computer Reservation System\n - AGENT_TYPE_IBE: Internet Booking Engine\n\nAgent is a Internet Booking Engine",
        "title": "Agent type"
      },
      "livev1CreateSearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "$ref": "#/definitions/livev1Query",
            "description": "The actual query of the request",
            "title": "Query"
          },
          "initialPageSize": {
            "type": "integer",
            "format": "int32",
            "description": "The number of results to return, e.g. the amount of results that each page should have.\nThe number is required to be specified and should be less or equal to 50.",
            "title": "Initial Page Size"
          }
        },
        "title": "The request body for Hotels Search Request method"
      },
      "livev1CreateSearchResponse": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "Session token that is used to poll",
            "title": "Session Token"
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Status of the current search session",
            "title": "Status"
          },
          "content": {
            "$ref": "#/definitions/livev1SearchContent",
            "description": "Search response object",
            "title": "Content"
          }
        },
        "description": "The response body for Hotels Search Request method",
        "title": "Create Search Response"
      },
      "livev1DistanceUnit": {
        "type": "string",
        "enum": [
          "DISTANCE_UNIT_UNSPECIFIED",
          "DISTANCE_UNIT_METER",
          "DISTANCE_UNIT_MILE",
          "DISTANCE_UNIT_KILOMETER"
        ],
        "default": "DISTANCE_UNIT_UNSPECIFIED",
        "description": "- DISTANCE_UNIT_UNSPECIFIED: Default value when not specified\n - DISTANCE_UNIT_METER: Distance is in meters\n - DISTANCE_UNIT_MILE: Distance is in miles\n - DISTANCE_UNIT_KILOMETER: Distance is in kilometers",
        "title": "Distance unit"
      },
      "livev1PollSearchResponse": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "Session token that was used for the current poll",
            "title": "Session Token"
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Status of the current search session",
            "title": "Status"
          },
          "content": {
            "$ref": "#/definitions/livev1SearchContent",
            "description": "Search response object",
            "title": "Content"
          }
        },
        "description": "The response body for Hotels Search Request method",
        "title": "Poll Search Response"
      },
      "livev1Query": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "description": "Market for which the search is for. e.g. `UK`\nWe provide a Culture API to get all the markets we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Market"
          },
          "locale": {
            "type": "string",
            "description": "Locale that the results are returned in. e.g. `en-GB`\nWe provide a Culture API to get all the locales we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "description": "Currency that the search results are returned in. e.g. `GBP`\nWe provide a Culture API to get all the currencies we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Currency"
          },
          "entityId": {
            "type": "string",
            "description": "Place entity id(i.e. Hotel, City, Nation, etc.)",
            "title": "Entity ID"
          },
          "checkinDate": {
            "$ref": "#/definitions/typesLocalDate",
            "description": "Date of the check-in",
            "title": "Check-in date"
          },
          "checkoutDate": {
            "$ref": "#/definitions/typesLocalDate",
            "description": "Date of the check-out",
            "title": "Check-out date"
          },
          "adults": {
            "type": "integer",
            "format": "int32",
            "description": "Number of adults. Should be greater than or equal to 1",
            "title": "Number of adults"
          },
          "childrenAges": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "List of children ages",
            "title": "Children ages"
          },
          "rooms": {
            "type": "integer",
            "format": "int32",
            "description": "Number of rooms to book",
            "title": "Number of rooms"
          },
          "includedAgentsIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of included agents\nA maximum of 200 agent ids can be specified in a single request.",
            "title": "Included agent IDs"
          },
          "excludedAgentsIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of excluded agents\nA maximum of 200 agent ids can be specified in a single request.",
            "title": "Excluded agent IDs"
          }
        },
        "title": "Query object for request"
      },
      "livev1SearchContent": {
        "type": "object",
        "properties": {
          "totalHotelResultCount": {
            "type": "integer",
            "format": "int32",
            "description": "The total hotel count for the current session.\nYou can use this parameter to guide on how many hotels pages are available.\nThe value is reliable only if the \"status\" in the response is \"RESULT_STATUS_COMPLETE\"",
            "title": "Total Hotel Count"
          },
          "results": {
            "$ref": "#/definitions/hotelslivev1SearchResults",
            "description": "The actual result content of the current search results.\nThis will include results for the current page only.\nE.g. if the limit in the request was set to 15 then this object will contain results for only the 15 hotels of the current page.",
            "title": "Results"
          }
        },
        "description": "Content for all current results",
        "title": "Search Content"
      },
      "hotels-live_protobufAny": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "hotels-live_rpcCoordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "The coordinates latitude",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "The coordinates longitude",
            "title": "Longitude"
          }
        }
      },
      "hotels-live_rpcResultStatus": {
        "type": "string",
        "enum": [
          "RESULT_STATUS_UNSPECIFIED",
          "RESULT_STATUS_COMPLETE",
          "RESULT_STATUS_INCOMPLETE",
          "RESULT_STATUS_FAILED"
        ],
        "default": "RESULT_STATUS_UNSPECIFIED",
        "description": "Results status Enum.\n\n - RESULT_STATUS_UNSPECIFIED: Results status not specified.\n - RESULT_STATUS_COMPLETE: Results are now complete.\n - RESULT_STATUS_INCOMPLETE: Results are not complete yet.\n - RESULT_STATUS_FAILED: Search has failed."
      },
      "hotels-live_rpcStatus": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/protobufAny"
            }
          }
        }
      },
      "hotels-live_typesLocalDate": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year in YYYY format. E.g. `2022`.",
            "title": "Year"
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month in int value. E.g. `1` is January or `10` is October.",
            "title": "Month"
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "description": "Day in int value. E.g. `5` or `28`.",
            "title": "Day"
          }
        },
        "description": "Local Date object for dates input without timezone.",
        "title": "Local Date"
      },
      "v1AccommodationType": {
        "type": "string",
        "enum": [
          "ACCOM_TYPE_UNSPECIFIED",
          "ACCOM_TYPE_HOTEL",
          "ACCOM_TYPE_APARTMENT",
          "ACCOM_TYPE_HOLIDAY_RENTALS",
          "ACCOM_TYPE_GUESTHOUSE",
          "ACCOM_TYPE_HOSTEL",
          "ACCOM_TYPE_UNIQUE_STAYS",
          "ACCOM_TYPE_RESORT",
          "ACCOM_TYPE_RESIDENCE_HOTEL",
          "ACCOM_TYPE_PRIVATE_HOME"
        ],
        "default": "ACCOM_TYPE_UNSPECIFIED",
        "description": "Type of the accommodation\n\n - ACCOM_TYPE_UNSPECIFIED: Default value when not specified\n - ACCOM_TYPE_HOTEL: Accommodation is a hotel\n - ACCOM_TYPE_APARTMENT: Accommodation is an apartment\n - ACCOM_TYPE_HOLIDAY_RENTALS: Accommodation is a holiday rental\n - ACCOM_TYPE_GUESTHOUSE: Accommodation is a guesthouse\n - ACCOM_TYPE_HOSTEL: Accommodation is a hostel\n - ACCOM_TYPE_UNIQUE_STAYS: Accommodation is a unique stay\n - ACCOM_TYPE_RESORT: Accommodation is a resort\n - ACCOM_TYPE_RESIDENCE_HOTEL: Accommodation is a residence hotel\n - ACCOM_TYPE_PRIVATE_HOME: Accommodation is a private home",
        "title": "Accommodation Type"
      },
      "v1AccommodationTypeFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/v1AccommodationType"
            },
            "description": "Accommodation types to filter by",
            "title": "Values"
          }
        },
        "description": "Message containing a accommodation-type-based filter",
        "title": "Accommodation Type Filter"
      },
      "v1AgentsFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A collection of agent ids to filter by.",
            "title": "Values"
          }
        },
        "description": "Message containing a agents-based filter",
        "title": "Agents Filter"
      },
      "v1CancellationPolicyType": {
        "type": "string",
        "enum": [
          "CANCELLATION_POLICY_TYPE_UNSPECIFIED",
          "CANCELLATION_POLICY_TYPE_NON_REFUNDABLE",
          "CANCELLATION_POLICY_TYPE_FREE_CANCELLATION",
          "CANCELLATION_POLICY_TYPE_REFUNDABLE"
        ],
        "default": "CANCELLATION_POLICY_TYPE_UNSPECIFIED",
        "description": "Enum values for all possible types of cancellation policies\n\n - CANCELLATION_POLICY_TYPE_UNSPECIFIED: Unspecified\n\nDefault value for enum. Shouldn't be returned\n - CANCELLATION_POLICY_TYPE_NON_REFUNDABLE: Non refundable\n\nIndicates that the booking cannot be refunded after it has been made\n - CANCELLATION_POLICY_TYPE_FREE_CANCELLATION: Free cancellation\n\nIndicates that the booking can be cancelled without incurring a fee within a specific time window.\nPolicies may vary by provider.\n - CANCELLATION_POLICY_TYPE_REFUNDABLE: Refundable\n\nIndicates that the booking is fully refundable after it has been made potentially within a specific time window.",
        "title": "Cancellation Policy Type"
      },
      "v1CancellationPolicyTypeFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/v1CancellationPolicyType"
            },
            "description": "Cancellation policy types to filter by",
            "title": "Values"
          }
        },
        "description": "Message containing a cancellation-policy-based filter",
        "title": "Cancellation Policy Filter"
      },
      "v1ChainFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A collection of chain entity ids to filter by.",
            "title": "Values"
          }
        },
        "description": "Message containing a hotels-chains-based filter",
        "title": "Chain Filter"
      },
      "v1ChainGroup": {
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer",
            "format": "int32",
            "description": "An entity ID for the specific chain the hotel is associated with",
            "title": "Chain id"
          },
          "chainName": {
            "type": "string",
            "description": "The name for the specific chain the hotel is associated with. Not localised.",
            "title": "Chain name"
          },
          "groupId": {
            "type": "integer",
            "format": "int32",
            "description": "An entity ID for the specific group the hotel is associated with",
            "title": "Group id"
          },
          "groupName": {
            "type": "string",
            "description": "The name for the specific group the hotel is associated with. Not localised.",
            "title": "Group name"
          }
        },
        "description": "Message encapsulating chain and group information for specific hotel.",
        "title": "Chain and Group"
      },
      "v1Distance": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "format": "int32",
            "title": "The value of the distance"
          },
          "unit": {
            "$ref": "#/definitions/livev1DistanceUnit",
            "title": "What unit this distance is represented in"
          }
        },
        "title": "Object to represent distance and unit of measure"
      },
      "v1GeoAreaFilter": {
        "type": "object",
        "properties": {
          "coordinates": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/rpcCoordinates"
            },
            "description": "Map points defining the area (2 must\nbe provided, which would represent a rectangular\narea with the first coordinate north-west and the\nsecond the south-east of the rectangle).\nOther polygons are currently not supported",
            "title": "Coordinates"
          }
        },
        "description": "Represents a map area (polygon) within the given\ncoordinates (vertices). Used in filters.",
        "title": "Geo Area Filter"
      },
      "v1GroupFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A collection of group entity ids to filter by.",
            "title": "Values"
          }
        },
        "description": "Message containing a hotels-group-based filter",
        "title": "Group Filter"
      },
      "v1GuestRating": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "format": "double",
            "description": "The average guest rating score.\nThe value is a float between 0.5 and 5\nThe higher the value is, the better rated the hotel is.",
            "title": "Score"
          },
          "reviewCount": {
            "type": "integer",
            "format": "int32",
            "description": "The amount of guests that have provided rating for their stay",
            "title": "Review count"
          }
        },
        "description": "Message for holding guest rating values for particular hotel",
        "title": "Guest rating"
      },
      "v1HotelAmenitiesFilter": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/v1HotelAmenity"
            },
            "description": "Amenity values to filter by",
            "title": "Values"
          }
        },
        "description": "Message containing a hotel-amenities-based filter",
        "title": "Hotel Amenities Filter"
      },
