        "description": "Message containing a geo location information for a location",
        "title": "Geo location"
      },
      "carhireliveDistanceUnit": {
        "type": "string",
        "enum": [
          "DISTANCE_UNIT_UNSPECIFIED",
          "DISTANCE_UNIT_KILOMETERS",
          "DISTANCE_UNIT_MILES"
        ],
        "default": "DISTANCE_UNIT_UNSPECIFIED",
        "description": "Specifies units of distance\n\n - DISTANCE_UNIT_UNSPECIFIED: Unspecified\n\nThe distance unit is unspecified or unknown\n - DISTANCE_UNIT_KILOMETERS: Kilometers\n\nThe distance unit is kilometers\n - DISTANCE_UNIT_MILES: Kilometers\n\nThe distance unit is miles",
        "title": "Distance Unit"
      },
      "carhireliveQuote": {
        "type": "object",
        "properties": {
          "sippCode": {
            "type": "string",
            "description": "A 4-character code which an industry-standard used to group vehicles based on their characteristics\nYou can use this code provided through our API response to map out the features of a car as defined by ACRISS\nFor more information - https://www.acriss.org/car-codes/",
            "title": "SIPP"
          },
          "vendorId": {
            "type": "string",
            "description": "Id of the vendor for that quote",
            "title": "Vendor id"
          },
          "agentId": {
            "type": "string",
            "description": "Id of the agent providing that quote",
            "title": "Agent id"
          },
          "price": {
            "$ref": "#/definitions/typesPrice",
            "description": "Price of the quote",
            "title": "Price"
          },
          "pricePerDay": {
            "$ref": "#/definitions/typesPrice",
            "description": "Price per day of the quote",
            "title": "Price per day"
          },
          "deeplinkUrl": {
            "type": "string",
            "description": "The URL is a redirect to the agent for the specified quote",
            "title": "Deeplink URL"
          },
          "pickupMethod": {
            "$ref": "#/definitions/livePickupMethod",
            "description": "Pick-up method of the vechile for the quote",
            "title": "Pick-up method"
          },
          "payType": {
            "$ref": "#/definitions/livePayType",
            "description": "The type of payment for the quote",
            "title": "Pay type"
          },
          "additions": {
            "$ref": "#/definitions/liveAdditions",
            "description": "Any additional services for the quote (e.g. insurance, mileage, etc)",
            "title": "Additions"
          },
          "pickupLocation": {
            "$ref": "#/definitions/carhireGeolocation",
            "description": "Location information for the pick-up",
            "title": "Pick-up location"
          },
          "dropoffLocation": {
            "$ref": "#/definitions/carhireGeolocation",
            "description": "Location information for the drop-off.\nNote: This information is often not available, and the field may frequently be empty.\nIn Skyscanner’s own implementation, this field is ignored and not shown in the UI.\nWe recommend following a similar approach to avoid relying on incomplete or inconsistent data.",
            "title": "Drop-off location"
          },
          "pickupType": {
            "$ref": "#/definitions/livePickupType",
            "description": "Information about the physical pick-up for the quote",
            "title": "Pick-up type"
          },
          "vehicleName": {
            "type": "string",
            "description": "The name of the vehicle for the quote",
            "title": "Vehicle name"
          },
          "imageUrl": {
            "type": "string",
            "description": "The image URL for the vehicle for the quote",
            "title": "Image URL"
          }
        },
        "description": "Message containing information about a quote.",
        "title": "Quote"
      },
      "liveAdditionalDrivers": {
        "type": "object",
