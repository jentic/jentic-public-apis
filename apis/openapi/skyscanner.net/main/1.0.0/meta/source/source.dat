          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/protobufAny"
            }
          }
        }
      },
      "rpccarhireAgent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the agent. The value is not localised.",
            "title": "Name"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "description": "The rating of the overall experience for the agent using data from Skyscanner",
            "title": "Rating"
          },
          "logoUrl": {
            "type": "string",
            "description": "URL of the agent's logo",
            "title": "Logo URL"
          }
        },
        "description": "Message containing information for a specific agent\nAn agent is a supply partners that Skyscanner gets quotes from",
        "title": "Agent"
      },
      "rpccarhireliveCreateSearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "$ref": "#/definitions/rpccarhireliveQuery",
            "description": "The actual query of the request",
            "title": "Query"
          },
          "userIp": {
            "type": "string",
            "description": "Optional field\nIp of the caller",
            "title": "User Ip"
          }
        },
        "description": "The request body for Car Hire Search Request method",
        "title": "CreateSearchRequest"
      },
      "rpccarhireliveCreateSearchResponse": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "Token generated for the specific search session.\nToken should re-used as part of the Poll Search method if you want to get full set of quotes",
            "title": "Session token"
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Indicates the status of the current search session",
            "title": "Status"
          },
          "content": {
            "$ref": "#/definitions/rpccarhireliveSearchContent",
            "description": "The content for all current results",
            "title": "Content"
          }
        },
        "description": "The response body for Car Hire Search Request method",
        "title": "CreateSearchResponse"
      },
      "rpccarhirelivePollSearchResponse": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "Token for the specific search session.\nToken should be the same as the one provided in the Poll request.\nToken should re-used as part of further Poll Search method if you want to get full set of quotes",
            "title": "Session token"
          },
          "status": {
            "$ref": "#/definitions/rpcResultStatus",
            "description": "Indicates the status of the current search session",
            "title": "Status"
          },
          "content": {
            "$ref": "#/definitions/rpccarhireliveSearchContent",
            "description": "The content for all current results",
            "title": "Content"
          }
        },
        "description": "The response body for Car Hire Poll Request method",
        "title": "CreateSearchResponse"
      },
      "rpccarhireliveQuery": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "description": "Market for which the search is for. e.g. `UK`\nWe provide a Culture API to get all the markets we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Market"
          },
          "locale": {
            "type": "string",
            "description": "Locale that the results are returned in. e.g. `en-GB`\nWe provide a Culture API to get all the locales we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Locale"
          },
          "currency": {
            "type": "string",
            "description": "Currency that the search results are returned in. e.g. `GBP`\nWe provide a Culture API to get all the currencies we support. [See Culture API Documentation](https://developers.skyscanner.net/docs/category/culture-api).",
            "title": "Currency"
          },
          "pickUpLocation": {
            "$ref": "#/definitions/livePickupDropOff",
            "description": "Required to be specified",
            "title": "Pick up location"
          },
          "dropOffLocation": {
            "$ref": "#/definitions/livePickupDropOff",
            "description": "Drop off location of the car hire query\nOptional - if left empty it will default to the pick up location",
            "title": "Drop off location"
          },
          "pickUpDate": {
            "$ref": "#/definitions/typesLocalDateTimeEmptyDefaults",
            "description": "Required to be specified\nPick-up time must be in the future and also must be before drop-off time",
            "title": "Date and time of the pick-up"
          },
          "dropOffDate": {
            "$ref": "#/definitions/typesLocalDateTimeEmptyDefaults",
            "description": "Required to be specified\nDrop-off time must be in the future and also must be after pick-up time",
            "title": "Date and time of the drop-off"
          },
          "includedAgentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional field\nSpecifies a concrete list of agents that quotes should be returned for\nAny quotes from agents which are not part of this list will not be provided in the response\nIf empty then quotes for all agents will be provided in the response\nAll ids need to be valid for given market\nThe list can't be more than 200 items",
            "title": "Included agent ids"
          },
          "excludedAgentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional field\nSpecifies a concrete list of agents whose quotes will be excluded in the response\nAll ids need to be valid for given market\nThe list can't be more than 200 items",
            "title": "Excluded agent ids"
          },
          "driverAge": {
            "type": "integer",
            "format": "int32",
            "description": "Value must be between 21 and 99.\nThe default value is 30 if not specified.",
            "title": "Age of the designated driver"
          }
        }
      },
      "rpccarhireliveSearchContent": {
        "type": "object",
        "properties": {
          "results": {
            "$ref": "#/definitions/rpccarhireliveSearchResults",
            "description": "The actual result content of the current search results",
            "title": "Results"
          },
          "sortingOptions": {
            "$ref": "#/definitions/rpccarhireliveSortingOptions",
            "description": "Contains data for sorting quotes by a specific criteria",
            "title": "Sorting options"
          }
        },
        "description": "The content for all current results",
        "title": "Content"
      },
      "rpccarhireliveSearchResults": {
        "type": "object",
        "properties": {
          "quotes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/carhireliveQuote"
            },
            "description": "A map with a key that is the quote id and the value is the actual quote",
            "title": "Quotes map"
          },
          "agents": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/rpccarhireAgent"
            },
            "description": "A map with a key that is the agent id and the value is the actual data of an agent",
            "title": "Agents map"
          },
          "vendors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/liveLivePricesVendor"
            },
            "description": "A map with a key that is the vendor id and the value is the actual data of a vendor",
            "title": "Vendors map"
          }
        },
        "description": "Message for storing quote result data",
        "title": "SearchResults"
      },
      "rpccarhireliveSortingOptions": {
        "type": "object",
        "properties": {
          "cheapest": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/rpccarhireliveSortingOptionsSortingOptionItem"
            },
            "description": "Data for sorting quotes by \"cheapest\" criteria",
            "title": "Option items for cheapest criteria"
          }
        },
        "description": "Object to store data for sorting quotes by a specific criteria.",
        "title": "SortingOptions"
      },
      "rpccarhireliveSortingOptionsSortingOptionItem": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "format": "float",
            "description": "Score value of a quote for a criteria.",
            "title": "Score"
          },
          "quoteId": {
            "type": "string",
            "description": "Id of a specific quote.",
            "title": "Quote id"
          }
        },
        "description": "An item object contains data for sorting.",
        "title": "SortingOptionItem"
      },
      "typesLocalDateTimeEmptyDefaults": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year in YYYY format. E.g. `2022`.",
            "title": "Year"
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month in int value. E.g. `1` is January or `10` is October.",
            "title": "Month"
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "description": "Day in int value. E.g. `5` or `28`.",
            "title": "Day"
          },
          "hour": {
            "type": "integer",
            "format": "int32",
            "description": "Hour in int value. E.g. `3` or `12`.",
            "title": "Hour"
          },
          "minute": {
            "type": "integer",
            "format": "int32",
            "description": "Minute in int value. E.g. `2` or `52`.",
            "title": "Minute"
          },
          "second": {
            "type": "integer",
            "format": "int32",
            "description": "Second in int value. E.g. `1` or `46`.",
            "title": "Second"
          }
        },
        "description": "This type allows the hour, minutes and the seconds to be omitted or left empty on the request.\nOmitting those parameters will make the values be defaulted to values specific for the vertical.\nFor example in CarHire the time will default to 12:00:00 if all time parameters are unspecified.",
        "title": "LocalDateTimeEmptyDefaults"
      },
      "car-hire-live-pricing_typesPrice": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "int64 price value amount serialised as a string. It could be an empty string if the value is missing."
          },
          "unit": {
            "$ref": "#/definitions/typesPriceUnit",
            "description": "Price amount multiplier used to turn the amount int value into a value with a decimal point. For example, if the unit is `PRICE_UNIT_CENTI` and the amount is `2100` you can represent it as `21.00`."
          },
          "updateStatus": {
            "$ref": "#/definitions/typesPriceUpdateStatus",
            "description": "A status indicating if the price returned is current or still updating. It will only be set for itinerary refresh calls."
          }
        },
        "description": "Price object."
      },
      "car-hire-live-pricing_typesPriceUnit": {
        "type": "string",
        "enum": [
          "PRICE_UNIT_UNSPECIFIED",
          "PRICE_UNIT_WHOLE",
          "PRICE_UNIT_CENTI",
          "PRICE_UNIT_MILLI",
          "PRICE_UNIT_MICRO"
        ],
        "default": "PRICE_UNIT_UNSPECIFIED",
        "title": "- PRICE_UNIT_UNSPECIFIED: Unit is not specified\n - PRICE_UNIT_WHOLE: unit relation: 1. eg: A whole pound, euro, etc.\n - PRICE_UNIT_CENTI: unit relation: 100; eg: cents\n - PRICE_UNIT_MILLI: unit relation: 1000\n - PRICE_UNIT_MICRO: unit relation: 1000000"
      },
      "car-hire-live-pricing_typesPriceUpdateStatus": {
        "type": "string",
        "enum": [
          "PRICE_UPDATE_STATUS_UNSPECIFIED",
          "PRICE_UPDATE_STATUS_PENDING",
          "PRICE_UPDATE_STATUS_CURRENT"
        ],
        "default": "PRICE_UPDATE_STATUS_UNSPECIFIED",
        "description": " - PRICE_UPDATE_STATUS_UNSPECIFIED: The update status is not set.\n - PRICE_UPDATE_STATUS_PENDING: The price is still updating.\n - PRICE_UPDATE_STATUS_CURRENT: The price is current."
      },
      "carhireindicativeSearchResults": {
        "type": "object",
        "properties": {
          "quotes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/rpccarhireindicativeQuote"
            },
            "description": "A map with a key that is the quote id and the value is the actual quote",
            "title": "Quotes map"
          },
          "vendors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/indicativeIndicativePricesVendor"
            },
            "description": "A map with a key that is the vendor id and the value is the actual data of a vendor",
            "title": "Vendors map"
          }
        },
        "description": "Message for storing indicative results data",
        "title": "SearchResults"
      },
      "indicativeAggregateType": {
        "type": "string",
        "enum": [
          "AGGREGATE_TYPE_UNSPECIFIED",
          "AGGREGATE_TYPE_CHEAPEST",
          "AGGREGATE_TYPE_AVERAGE",
          "AGGREGATE_TYPE_TOTAL_CHEAPEST",
          "AGGREGATE_TYPE_TOTAL_AVERAGE",
          "AGGREGATE_TYPE_COUNTRY_AVERAGE"
        ],
        "default": "AGGREGATE_TYPE_UNSPECIFIED",
        "description": "All price aggregate type values\n\n - AGGREGATE_TYPE_UNSPECIFIED: Unspecified\n\nThe aggregate type is unspecified or unknown. Should never be returned.\n - AGGREGATE_TYPE_CHEAPEST: Cheapest\n\nAggregate type is cheapest price per day\n - AGGREGATE_TYPE_AVERAGE: Average\n\nAggregate type is an average price per day\n - AGGREGATE_TYPE_TOTAL_CHEAPEST: Total cheapest\n\nAggregate type is cheapest price for the total requested period.\nUnlike `AGGREGATE_TYPE_CHEAPEST`, this calculates the lowest price over the entire period rather than for individual days.\n - AGGREGATE_TYPE_TOTAL_AVERAGE: Total average\n\nAggregate type is average price for the total requested period.\nUnlike `AGGREGATE_TYPE_AVERAGE`, this calculates the average price over the entire period rather than for individual days.\n - AGGREGATE_TYPE_COUNTRY_AVERAGE: Country average\n\nAggregate type is price per day of the country where the pickup location is located in.",
        "title": "Aggregate type"
      },
      "indicativeIndicativePricesVendor": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the vendor. The value is not localised.",
            "title": "Name"
          },
          "logoUrl": {
            "type": "string",
            "description": "URL of the agent's logo",
            "title": "Logo URL"
          }
        },
        "description": "Message containing information for a specific vendor\nVendors are actual car companies that rent cars.\nNote that vendors can also be both an agent and a vendor at the same time.",
        "title": "Vendor"
      },
      "indicativePriceMap": {
        "type": "object",
        "properties": {
          "aggregateType": {
            "$ref": "#/definitions/indicativeAggregateType",
            "description": "The aggregation type for the price. E.g. average, cheapest, etc.",
            "title": "Aggregate type"
          },
          "price": {
            "$ref": "#/definitions/typesPrice",
            "description": "The actual price value for the specific aggregate type",
            "title": "Price"
          }
        },
        "description": "Contains data about different price types",
        "title": "Price Map"
      },
      "indicativeVehicleType": {
        "type": "string",
        "enum": [
          "VEHICLE_TYPE_UNSPECIFIED",
          "VEHICLE_TYPE_SMALL",
          "VEHICLE_TYPE_MEDIUM",
          "VEHICLE_TYPE_LARGE",
          "VEHICLE_TYPE_LUXURY",
          "VEHICLE_TYPE_SUV",
          "VEHICLE_TYPE_VAN"
        ],
        "default": "VEHICLE_TYPE_UNSPECIFIED",
        "description": "Vehicle type values used for grouping in indicative prices\n\n - VEHICLE_TYPE_UNSPECIFIED: Unspecified\n\nThe vehicle type is unspecified or unknown. This is an unexpected value and it shouldn't be returned as part of the response ever.\n - VEHICLE_TYPE_SMALL: Small\n\nVehicle size is one of:\n- (M) Mini\n- (N) Mini Elite\n- (E) Economy\n- (H) Economy Elite\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information\n - VEHICLE_TYPE_MEDIUM: Medium\n\nVehicle size is one of:\n- (C) Compact\n- (D) Compact Elite\n- (I) Intermediate\n- (J) Intermediate Elite\n- (S) Standard\n- (R) Standard Elite\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information\n - VEHICLE_TYPE_LARGE: Large\n\n\nVehicle size is one of:\n- (F) Fullsize\n- (G) Fullsize Elite\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information\n - VEHICLE_TYPE_LUXURY: Luxury\n\nVehicle size is one of:\n- (P) Premium\n- (U) Premium Elite\n- (L) Luxury\n- (W) Luxury Elite\n- (O) Oversize\n- (X) Special\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information\n - VEHICLE_TYPE_SUV: SUV\n\nNumber of doors for vehicle is (F) SUV\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information\n - VEHICLE_TYPE_VAN: VAN\n\nNumber of doors for vehicle is (K) Commercial Van/ Truck\nCheck Classification Codes in https://www.acriss.org/car-codes/ for more information",
        "title": "Vehicle type"
      },
      "car-hire-indicative_protobufAny": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
