      "hotelslivev1HotelContent": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "string",
            "description": "ID of the hotel",
            "title": "Id"
          },
          "hotelName": {
            "type": "string",
            "description": "Name of the hotel",
            "title": "Name"
          },
          "stars": {
            "$ref": "#/definitions/v1Stars",
            "description": "Star rating of the hotel",
            "title": "Stars"
          },
          "accommodationType": {
            "$ref": "#/definitions/v1AccommodationType",
            "description": "The type of the accommodation",
            "title": "Accommodation Type"
          },
          "chainGroup": {
            "$ref": "#/definitions/v1ChainGroup",
            "description": "The group and chain information for the specific hotel",
            "title": "Chain and group"
          },
          "coordinates": {
            "$ref": "#/definitions/rpcCoordinates",
