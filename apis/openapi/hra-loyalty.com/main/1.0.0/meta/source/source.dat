{
  "openapi": "3.1.0",
  "info": {
    "title": "HRA Loyalty – Customer App API",
    "description": "Customer-facing APIs for HRA Loyalty Platform. Phone-only OTP authentication, receipt OCR, points ledger, rewards and redemption.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/OneVentureStudio/CustomerApp_API/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.hra-loyalty.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Member"
    },
    {
      "name": "Receipt"
    },
    {
      "name": "Ledger"
    },
    {
      "name": "Rewards"
    },
    {
      "name": "Redemption"
    },
    {
      "name": "Activity"
    }
  ],
  "paths": {
    "/v1/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request OTP (Signup / Login)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "consent"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+919876543210"
                  },
                  "consent": {
                    "type": "object",
                    "required": [
                      "termsVersion",
                      "privacyVersion"
                    ],
                    "properties": {
                      "termsVersion": {
                        "type": "string",
                        "example": "v1.0"
                      },
                      "privacyVersion": {
                        "type": "string",
                        "example": "v1.0"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "txnId": {
                      "type": "string",
                      "example": "otp_txn_123"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "example": 300
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify OTP and login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "txnId",
                  "otp"
                ],
                "properties": {
                  "txnId": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    },
                    "memberId": {
                      "type": "string"
                    },
                    "isNewMember": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/me": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "Get logged-in member profile",
        "responses": {
          "200": {
            "description": "Member profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberProfile"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/me/qr": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "Get member QR code",
        "responses": {
          "200": {
            "description": "QR code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qrValue": {
                      "type": "string",
                      "example": "HRA|MEM|001"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipts": {
      "post": {
        "tags": [
          "Receipt"
        ],
        "summary": "Upload receipt for OCR",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Receipt accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptUploadResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Receipt"
        ],
        "summary": "List receipts",
        "responses": {
          "200": {
            "description": "Receipt list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Receipt"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipts/{id}": {
      "get": {
        "tags": [
          "Receipt"
        ],
        "summary": "Get receipt OCR status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/balance": {
      "get": {
        "tags": [
          "Ledger"
        ],
        "summary": "Get points balance",
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PointsBalance"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/transactions": {
      "get": {
        "tags": [
          "Ledger"
        ],
        "summary": "Points transaction history",
        "responses": {
          "200": {
            "description": "Transactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LedgerTransaction"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/rewards": {
      "get": {
        "tags": [
          "Rewards"
        ],
        "summary": "Rewards catalog",
        "responses": {
          "200": {
            "description": "Rewards list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reward"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/redeem/token": {
      "post": {
        "tags": [
          "Redemption"
        ],
        "summary": "Generate redemption token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rewardId"
                ],
                "properties": {
                  "rewardId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedemptionToken"
                }
              }
            }
          }
        }
      }
    },
    "/v1/activity": {
      "get": {
        "tags": [
          "Activity"
        ],
        "summary": "Activity timeline",
        "responses": {
          "200": {
            "description": "Activity list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MemberProfile": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "pointsBalance": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "receiptId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "pointsEarned": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReceiptUploadResponse": {
        "type": "object",
        "properties": {
          "receiptId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PointsBalance": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "number"
          }
        }
      },
      "LedgerTransaction": {
        "type": "object",
        "properties": {
          "txnId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Reward": {
        "type": "object",
        "properties": {
          "rewardId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "pointsRequired": {
            "type": "number"
          }
        }
      },
      "RedemptionToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActivityItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
