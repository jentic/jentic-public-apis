{
  "openapi": "3.1.0",
  "info": {
    "title": "Framekeep Public API",
    "version": "1.2.0",
    "description": "Versioned, read-only public product discovery for Framekeep. The v1 contract is backward compatible; breaking changes use a new major path. Deprecations are announced with Deprecation, Sunset, and successor-version Link headers at least 90 days before removal. Private and mutating gallery routes are deliberately excluded.",
    "termsOfService": "https://framekeep.com/terms",
    "license": {
      "name": "Framekeep Terms of Service",
      "url": "https://framekeep.com/terms"
    },
    "contact": {
      "name": "Framekeep developer support",
      "url": "https://framekeep.com/contact"
    }
  },
  "servers": [
    {
      "url": "https://framekeep.com",
      "description": "Framekeep production API"
    }
  ],
  "externalDocs": {
    "description": "Framekeep developer portal, versioning policy, and error guidance",
    "url": "https://framekeep.com/developers"
  },
  "tags": [
    {
      "name": "Public discovery",
      "description": "Read-only endpoints that require no authentication."
    }
  ],
  "x-framekeep-permissions": {
    "public:read": "Read public product and service metadata without authentication.",
    "gallery:client:read": "View one private gallery through its client capability link.",
    "gallery:edit:write": "Modify one private gallery through its edit capability link after explicit user approval.",
    "studio:admin": "Administer one studio through a human-established secure browser session."
  },
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "getFramekeepPublicApiIndexV1",
        "summary": "Get the Framekeep public API index",
        "description": "Lists the stable public discovery endpoints, OpenAPI description, developer portal, and MCP transport. This read-only operation requires no authentication.",
        "security": [],
        "tags": [
          "Public discovery"
        ],
        "responses": {
          "200": {
            "description": "Public API index",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit": {
                "description": "Current remaining quota and reset time in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIndex"
                }
              }
            }
          },
          "405": {
            "description": "Use GET for this read-only endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Public API rate limit exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The API index is temporarily unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getFramekeepHealthV1",
        "summary": "Check Framekeep service health",
        "description": "Returns a small typed health response. This read-only operation requires no authentication.",
        "security": [],
        "tags": [
          "Public discovery"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit": {
                "description": "Current remaining quota and reset time in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "405": {
            "description": "Use GET for this read-only endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Public API rate limit exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/product": {
      "get": {
        "operationId": "getFramekeepProductV1",
        "summary": "Get Framekeep public product metadata",
        "description": "Returns the reviewed public product overview and canonical documentation links. It never returns gallery, account, client, or token-bearing data.",
        "security": [],
        "tags": [
          "Public discovery"
        ],
        "responses": {
          "200": {
            "description": "Public product metadata",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit": {
                "description": "Current remaining quota and reset time in the current IETF RateLimit format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "405": {
            "description": "Use GET for this read-only endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Public API rate limit exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Public product metadata is temporarily unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StudioSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "framekeep_admin_session",
        "description": "Human-established secure browser session for studio administration. It is not accepted by the public v1 endpoints."
      }
    },
    "schemas": {
      "ApiIndex": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "documentation": {
            "type": "string",
            "format": "uri"
          },
          "openapi": {
            "type": "string",
            "format": "uri"
          },
          "mcp": {
            "type": "string",
            "format": "uri"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "name",
          "version",
          "documentation",
          "openapi",
          "mcp",
          "endpoints"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "service": {
            "type": "string",
            "const": "framekeep"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "version"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "const": "Framekeep"
          },
          "overview": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "url"
              ]
            }
          }
        },
        "required": [
          "name",
          "overview",
          "reviewedAt",
          "resources"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "resolution"
        ]
      }
    }
  }
}
