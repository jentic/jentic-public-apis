{
  "openapi": "3.0.3",
  "info": {
    "title": "Iniciadora CAIXA para Parceiros",
    "description": "Os endpoints permitem que o parceiro CAIXA Inicie um Pagamento PIX através de sua jornada. Exemplo: Uma loja de ecommerce, um aplicativo que realize cobrança, uma Smart TV e etc.\n\nO sistema receberá as informações necessárias para a realização do PIX do cliente cadastrado no sistema do Parceiro (uma companhia elétrica, por exemplo). As informações necessárias estão descritas no decorrer deste swagger. De qualquer forma, é necessário o recebimento dos dados do pagador (nome, CPF e etc), do recebedor (exemplo: a conta que vai receber o pagamento da fatura de energia), valor da transação entre outros.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/caixa-7df/iniciadora-caixa-para-parceiros/1.0.0"
  },
  "servers": [
    {
      "url": "https://siinp-jornada-des.apps.nprd.caixa",
      "description": "Ambiente de desenvolvimento"
    },
    {
      "url": "https://siinp-jornada-tqs.apps.nprd.caixa",
      "description": "Ambiente de TQS"
    }
  ],
  "paths": {
    "/inic-pagto/nucleo/v1/jornada": {
      "post": {
        "tags": [
          "Jornada SIINP"
        ],
        "description": "Endpoint responsável por enviar as informações necessárias para criação da intenção de pagamento através de um Convênio PJ.",
        "operationId": "JornadaSIINP#createIntent",
        "requestBody": {
          "description": "Dados necessários para criação da intenção de pagamento via SIINP.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JornadaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Intenção de pagamento criada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uriAutorizacao": {
                      "type": "string"
                    },
                    "idJornada": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "uriAutorizacao": "https://siinp-nucleo-web-des2-des.apps.nprd.caixa/authorize?jornadaId=74f6ab58-0701-40a4-9d33-9e02d505d202",
                  "idJornada": "74f6ab58-0701-40a4-9d33-9e02d505d202"
                }
              }
            }
          },
          "400": {
            "description": "Requisição mal formada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "statusCode": 400,
                  "message": "Requisição mal formada."
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "statusCode": 404,
                  "message": "Recurso não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro Interno de Servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "statusCode": 500,
                  "message": "Erro Interno de Servidor."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "statusCode": {
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "JornadaRequest": {
        "required": [
          "empresa",
          "idConvenioParceiro",
          "usuarioLogado",
          "recebedor",
          "valor",
          "urlRedirectConvenioParceiro"
        ],
        "type": "object",
        "properties": {
          "idConvenioParceiro": {
            "type": "integer",
            "description": "Id do convenio parceiro que está iniciando a transação",
            "example": 12
          },
          "usuarioLogado": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LoggedUserRequest"
              },
              {
                "description": "Usuário (pessoa natural) que encontra-se logado na instituição Iniciadora de Pagamento."
              }
            ]
          },
          "empresa": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BusinessEntity"
              },
              {
                "description": "Empresa logada para realização da iniciação de pagamento"
              }
            ]
          },
          "recebedor": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreditorRequest"
              },
              {
                "description": "Objeto que contém a identificação da conta de destino do beneficiário/recebedor."
              }
            ]
          },
          "valor": {
            "maxLength": 19,
            "minLength": 4,
            "pattern": "^((\\d{1,16}\\.\\d{2}))$",
            "type": "string",
            "description": "Valor da transação com 2 casas decimais",
            "example": "100000.12"
          },
          "urlRedirectConvenioParceiro": {
            "type": "string",
            "description": "Url de redirecionando para o convenio parceiro. Essa URL define para onde o usuário vai ser redirecionado após o processo da jornada.",
            "example": "https://urlParceiro.com.br",
            "format": "uri"
          }
        }
      },
      "LoggedUserRequest": {
        "type": "object",
        "properties": {
          "documento": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DocumentRequest"
              },
              {
                "description": "Documento do usuário logado"
              }
            ]
          }
        }
      },
      "BusinessEntity": {
        "type": "object",
        "properties": {
          "documento": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Document"
              },
              {
                "description": "Documento da empresa logada"
              }
            ]
          }
        }
      },
      "CreditorRequest": {
        "required": [
          "cpfCnpj",
          "nome",
          "tipoPessoa",
          "ispb",
          "numero",
          "tipoConta",
          "chavePix"
        ],
        "type": "object",
        "properties": {
          "tipoPessoa": {
            "pattern": "^(PESSOA_NATURAL|PESSOA_JURIDICA)$",
            "type": "string",
            "description": "Titular, pessoa natural ou juridica a quem se referem os dados de recebedor (creditor).",
            "example": "PESSOA_JURIDICA",
            "enum": [
              "PESSOA_NATURAL",
              "PESSOA_JURIDICA"
            ]
          },
          "cpfCnpj": {
            "maxLength": 14,
            "minLength": 11,
            "pattern": "^\\d{11}$|^[A-Z0-9]{12}\\d{2}$",
            "type": "string",
            "description": "Identificação da pessoa envolvida na transação.",
            "example": "24590464000163"
          },
          "nome": {
            "maxLength": 150,
            "pattern": "^([A-Za-zÀ-ÖØ-öø-ÿ,.@:&*+_<>()!?/\\\\$%\\d' -]+)$",
            "type": "string",
            "description": "Em caso de pessoa natural deve ser informado o nome completo do titular da conta do recebedor. Em caso de pessoa jurídica deve ser informada a razão social ou o nome fantasia da conta do recebedor.",
            "example": "Marco Antonio de Brito"
          },
          "ispb": {
            "description": "ISPB do participante do SPI somente com números.",
            "maxLength": 8,
            "minLength": 8,
            "pattern": "^[0-9]{8}$",
            "type": "string",
            "example": "12345678"
          },
          "agencia": {
            "description": "Código da Agência emissora da conta sem dígito.",
            "maxLength": 4,
            "minLength": 1,
            "pattern": "^[0-9]{1,4}$",
            "type": "string",
            "example": "1774"
          },
          "numero": {
            "description": "Número da conta do recebedor, com dígito verificador se existir.",
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]{1,20}$",
            "type": "string",
            "example": "1234567890"
          },
          "tipoConta": {
            "description": "Tipos de contas usadas para pagamento.",
            "pattern": "^(CACC|SVGS|TRAN)$",
            "enum": [
              "CACC",
              "SVGS",
              "TRAN"
            ],
            "type": "string",
            "example": "CACC"
          },
          "chavePix": {
            "description": "Chave cadastrada no DICT pertencente ao recebedor.",
            "maxLength": 77,
            "pattern": "[\\w\\W\\s]*",
            "type": "string",
            "example": "cliente-a00001@pix.bcb.gov.br"
          }
        }
      },
      "AccountRequest": {
        "required": [
          "ispb",
          "numero",
          "tipoConta"
        ],
        "type": "object",
        "properties": {
          "ispb": {
            "description": "Deve ser preenchido com o ISPB (Identificador do Sistema de Pagamentos Brasileiros) do participante do SPI (Sistema de pagamentos instantâneos) somente com números.",
            "maxLength": 8,
            "minLength": 8,
            "pattern": "^[0-9]{8}$",
            "type": "string",
            "example": "12345678"
          },
          "agencia": {
            "description": "Código da Agência emissora da conta sem dígito.",
            "maxLength": 4,
            "minLength": 1,
            "pattern": "^[0-9]{1,4}$",
            "type": "string",
            "example": "1774"
          },
          "numero": {
            "description": "Deve ser preenchido com o número da conta do usuário recebedor, com dígito verificador (se este existir), se houver valor alfanumérico, este deve ser convertido para 0.",
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]{1,20}$",
            "type": "string",
            "example": "1234567890"
          },
          "tipoConta": {
            "description": "Tipos de contas usadas para pagamento.",
            "pattern": "^(CACC|SVGS|TRAN)$",
            "enum": [
              "CACC",
              "SVGS",
              "TRAN"
            ],
            "type": "string",
            "example": "CACC"
          }
        }
      },
      "DocumentRequest": {
        "required": [
          "identificacao",
          "tipoDocumento"
        ],
        "type": "object",
        "properties": {
          "identificacao": {
            "maxLength": 11,
            "pattern": "^\\d{11}$",
            "type": "string",
            "description": "Número do documento de identificação oficial do usuário.",
            "example": "11111111111"
          },
          "tipoDocumento": {
            "maxLength": 3,
            "pattern": "^CPF$",
            "type": "string",
            "description": "Tipo do documento de identificação oficial do usuário.",
            "example": "CPF"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "identificacao": {
            "maxLength": 14,
            "pattern": "^\\d{14}$",
            "type": "string",
            "description": "Número do documento de identificação oficial da empresa.",
            "example": "11111111111111"
          },
          "rel": {
            "maxLength": 4,
            "pattern": "^CNPJ$",
            "type": "string",
            "description": "Tipo do documento de identificação oficial da empresa.",
            "example": "CNPJ"
          }
        }
      },
      "inline_response_201": {
        "type": "object",
        "description": "Resposta provisória sem campos definidos."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
