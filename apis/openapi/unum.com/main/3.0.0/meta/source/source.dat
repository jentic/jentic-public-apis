                                  "description": "The risk class assigned by the underwriters    "
                                },
                                "coveragePremiums": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "premiumType": {
                                        "type": "string",
                                        "enum": [
                                          "Bill",
                                          "Annualized",
                                          "PayFrequency",
                                          "PremiumDue"
                                        ],
                                        "description": "The type of premium such as Billed premium, total premium due etc"
                                      },
                                      "premiumAmount": {
                                        "type": "number",
                                        "format": "double",
                                        "description": "The Total premium amount."
                                      },
                                      "EEpremiumAmount": {
                                        "type": "number",
                                        "format": "double",
                                        "description": "The Employee contributed premium."
                                      },
                                      "ERpremiumAmount": {
                                        "type": "number",
                                        "format": "double",
                                        "description": "The Employer contributed premium.        "
                                      },
                                      "premiumFrequency": {
                                        "type": "string",
                                        "enum": [
                                          "Monthly",
                                          "Quarterly",
                                          "Semi-Annual",
                                          "Annual",
                                          "Weekly",
                                          "Bi-Weekly"
                                        ],
                                        "description": "The frequency of premium such as monthly, quarterly etc"
                                      },
                                      "premiumDescription": {
                                        "type": "string",
                                        "enum": [
                                          "Total"
                                        ],
                                        "description": "The description of premium such as total premium etc"
                                      }
                                    }
                                  }
                                },
                                "coveragePersonRelationships": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "description": "The relationship between the person and the coverage ",
                                    "properties": {
                                      "personSequenceNumber": {
                                        "type": "integer",
                                        "description": "The sequence number assigned to the current instance of the person object. "
                                      },
                                      "individualPartyIdentifier": {
                                        "type": "string",
                                        "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                                      },
                                      "coverageRelationshipText": {
                                        "type": "string",
                                        "enum": [
                                          "Insured",
                                          "Owner",
                                          "Sponsor",
                                          "Payor"
                                        ],
                                        "description": "The type of relationship pertaining to the coverage."
                                      }
                                    }
                                  }
                                },
                                "beneficiaryGroupId": {
                                  "type": "string",
                                  "description": "Id of group where benefit percentage are allocated"
                                },
                                "homeCarePercentage": {
                                  "type": "integer",
                                  "description": "The percentage of home care coverage"
                                },
                                "tobaccoIndicatorAtIssue": {
                                  "type": "string",
                                  "enum": [
                                    "Yes",
                                    "No"
