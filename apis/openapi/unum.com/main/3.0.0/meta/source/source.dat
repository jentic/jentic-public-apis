                                  "type": "string",
                                  "format": "date",
                                  "description": "The date on which the coverage was issued."
                                },
                                "coverageTerminationDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date on which the coverage expired or ceased to be inforce."
                                },
                                "coverageTerminatedDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date on which the coverage was terminated."
                                },
                                "coverageAmount": {
                                  "type": "number",
                                  "format": "double",
                                  "description": "The Amount of Coverages purchased at the time of the issue such as 10,000 Life Coverage"
                                },
                                "requestedFaceAmount": {
                                  "type": "number",
                                  "format": "double"
                                },
                                "benefitAmount": {
                                  "type": "number",
                                  "format": "double",
                                  "description": "The Benefit Amount calculated based on the election such as 2x Time salary"
                                },
                                "benefitEligibilityClassCode": {
                                  "type": "string",
                                  "description": "Identifies a group of employees as assigned by an employer who are eligible to purchase a product."
                                },
