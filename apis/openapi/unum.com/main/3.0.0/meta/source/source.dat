    "/enterprise-information/individual-agreements/v1/{individualAgreementIdentifier}": {
      "get": {
        "tags": [
          "Individual Agreement"
        ],
        "summary": "Get Individual Agreement by individualAgreementIdentifier",
        "operationId": "getIndividualAgreement",
        "parameters": [
          {
            "name": "individualAgreementIdentifier",
            "in": "path",
            "description": "The full agreement identifier as defined in an insurance contract. This is not a member ID or tax identification number as defined for Merlin Individual Agreements. Merlin should use search by passing the member id/tax identification number in the header.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/x-unum-correlation-id"
          },
          {
            "name": "sourceSystemText",
            "in": "query",
            "description": "The source system name associated with this object. If an unrecognized source system name is supplied, a '400' error may be issued in response.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CCP",
                "BEST",
                "MERLN"
              ],
              "default": "CCP"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Individual Agreement which matched the input.",
            "headers": {
              "Cache-control": {
                "description": "private, max-age=1800",
                "schema": {
                  "type": "string"
                }
              },
              "x-unum-correlation-id": {
                "description": "A uuid to audit this request for the purposes of correlating audit entries across various technologies.",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "persons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "personSequenceNumber": {
                            "type": "integer",
                            "description": "The sequence number assigned to the current instance of the person object. "
                          },
                          "individualPartyIdentifier": {
                            "type": "string",
                            "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                          },
                          "coverageRelationshipText": {
                            "type": "string",
                            "enum": [
                              "Insured",
                              "Owner",
                              "Sponsor",
                              "Payor"
                            ],
                            "description": "The type of relationship pertaining to the coverage."
                          },
                          "personDisplayName": {
                            "type": "string",
                            "description": "The name of the person to be displayed and it is in the form of last name, first name Middle name"
                          },
                          "firstName": {
                            "type": "string",
                            "description": "The first name of the person."
                          },
                          "lastName": {
                            "type": "string",
                            "description": "The last name of the person."
                          },
                          "middleName": {
                            "type": "string",
                            "description": "Optional The middle name of the person. "
                          },
                          "prefixTitle": {
                            "type": "string",
                            "description": "Optional The prefix of the person."
                          },
                          "suffixTitle": {
                            "type": "string",
                            "description": "Optional The suffix that follows the Last Name which provides additional information such as Jr."
                          },
                          "taxIdentificationNumber": {
                            "type": "string",
                            "description": "The tax identification number assigned to the Person by the USA federal government."
                          },
                          "taxIdentificationType": {
                            "type": "string",
                            "description": "The type of tax identification number assigned to the Person by the USA federal government such as SSN or TIN"
                          },
                          "dateOfBirth": {
                            "type": "string",
                            "format": "date",
                            "description": "The day on which Person was born."
                          },
                          "genderAtBirth": {
                            "type": "string",
                            "enum": [
                              "Male",
                              "Female",
                              "Intersex"
                            ],
                            "description": "Biological status at the time of birth. Male, Female, Intersex (This is not commonly used)"
                          },
                          "genderIdentity": {
                            "type": "string",
                            "description": "Optional Personal and internal sense of oneself as male, female or other. This is for future use and currently it will not be populated"
                          },
                          "smokerIndicator": {
                            "type": "string",
                            "enum": [
                              "Yes",
                              "No"
                            ],
                            "description": "Indicator to identify if the person is a smoker or not.            "
                          },
                          "smokerIndicatorEffectiveDate": {
                            "type": "string",
                            "description": "Optional Effective date of Smoker usage. It will not be populated if the person has never smoked"
                          },
                          "tobaccoIndicator": {
                            "type": "string",
                            "description": "Optional Indicator to identify if the person is a tobacco user or not."
                          },
                          "tobaccoIndicatorEffectiveDate": {
                            "type": "string",
                            "description": "Optional Effective date of Tobacco usage. It will not be populated if the person has never used any form of tobacco"
                          },
                          "employerIdentifier": {
                            "type": "string",
                            "description": "Organizations unique identifiers called \"Employer Party ID\".                            "
                          },
                          "postalAddresses": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "addressType": {
                                  "type": "string",
                                  "enum": [
                                    "Primary Residence",
                                    "Alternate Home Address",
                                    "Mailing Address"
                                  ],
                                  "description": "The type of address such as primary residence or alternate home address."
                                },
                                "addressLineOne": {
                                  "type": "string",
                                  "description": "The first line of the address."
                                },
                                "addressLineTwo": {
                                  "type": "string",
                                  "description": "Optional The second line of the address."
                                },
                                "addressLineThree": {
                                  "type": "string",
                                  "description": "Optional The third line of the address."
                                },
                                "city": {
                                  "type": "string",
                                  "description": "The city of the address."
                                },
                                "jurisdictionCode": {
                                  "type": "string",
                                  "description": "The jurisdiction of the address such as state or province."
                                },
                                "postalCode": {
                                  "type": "string",
                                  "description": "The postal code of the address."
                                },
                                "country": {
                                  "type": "string",
                                  "description": "The country of the address."
                                },
                                "beginDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became effective."
                                },
                                "endDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became ineffective.        "
                                }
                              }
                            }
                          },
                          "digitalAddresses": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "digitalAddressesType": {
                                  "type": "string",
                                  "enum": [
                                    "Email",
                                    "SMS",
                                    "SocialMedia",
                                    "Fax",
                                    "HomePhone",
                                    "MobilePhone",
                                    "Other"
                                  ],
                                  "description": "The means of digital communication."
                                },
                                "digitalAddressText": {
                                  "type": "string",
                                  "description": "The digital address text."
                                }
                              }
                            }
                          },
                          "beneficiaryInfo": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "dependentRelationshipType": {
                                  "type": "string",
                                  "description": "Spouse/child/grandchild etc -- N/A for other party org"
                                },
                                "partyOrganizationName": {
                                  "type": "string",
                                  "description": "This is the OrganisationName --- N/A for dependent beneficiaries"
                                },
                                "partyType": {
                                  "type": "string",
                                  "description": "charity etc --- N/A for dependent beneficiaries"
                                },
                                "beneficiaryRelationshipType": {
                                  "type": "string",
                                  "description": "charity"
                                },
                                "beneficiaryGroupId": {
                                  "type": "string"
                                },
                                "beneficiaryType": {
                                  "type": "string"
                                },
                                "beneficiaryPercentage": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "rationalized": {
                            "type": "boolean",
                            "description": "Optional Indicator to identify if the person record has been rationalized or not."
                          },
                          "clientEmployeeIdentifier": {
                            "type": "string",
                            "description": "Organizations often assign unique identifiers to individuals. These identifiers, often called \"Employee ID\".  "
                          },
                          "sourceSystemIndividualPartyIdentifications": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "sourceIndividualPartyIdentifier": {
                                  "type": "string",
                                  "description": "Source system assigned identifier for the individual. "
                                },
                                "sourceSystemText": {
                                  "type": "string",
                                  "description": "The name of the source system.",
                                  "enum": [
                                    "OPAL",
                                    "MERLN",
                                    "LF70",
                                    "CIA",
                                    "NVLNK",
                                    "ACHIEVE"
                                  ]
                                }
                              }
                            }
                          },
                          "SensitivityLevel": {
                            "type": "string",
                            "enum": [
                              "Confidential",
                              "Internal"
                            ],
                            "description": "The SensitivityLevel is based on  Importance & Confidentiality  of the data. Only two values are supported at this time - Confidential, Internal. Internal - Data that is not intended for public release and is only available to authorized Clients, Consumers, employees and contractors of the organization.  Confidential - Data that is not intended for public release and is only available for selected authorized Unum employees and contractors of the organization. As of the current implementation, Confidential is set if the data is for Unum employee"
                          },
                          "employment": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "originalHireDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional The first day an individual officially starts working for an organization."
                              },
                              "mostRecentHireDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional The first day an individual officially starts working for an organization after a previous termination.                "
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "Active",
                                  "Inactive",
                                  "Sabbatical",
                                  "Furlough",
                                  "FMLA",
                                  "Terminated",
                                  "New"
                                ],
                                "description": "Optional This field reflects current employment status of the employee."
                              },
                              "terminationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional This field reflects the date of termination of employment."
                              },
                              "terminationReason": {
                                "type": "string",
                                "enum": [
                                  "Death",
                                  "Layoff",
                                  "Leave Of Absence",
                                  "Long Term Disability",
                                  "Retirement",
                                  "Decline Coverage",
                                  "Termination",
                                  "Other"
                                ],
                                "description": "Optional This field reflects the reason of termination of employment."
                              }
                            }
                          }
                        }
                      }
                    },
                    "individualAgreement": {
                      "type": "object",
                      "properties": {
                        "individualAgreementID": {
                          "type": "string",
                          "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                        },
                        "policyNumber": {
                          "type": "string",
                          "description": "The policy number associated with the individual agreement.                        "
                        },
                        "sourceSystemText": {
                          "type": "string",
                          "description": "The source system that created the individual agreement."
                        },
                        "subSourceSystem": {
                          "type": "string",
                          "description": "The sub source system which contributes to primary source System."
                        },
                        "productGroupText": {
                          "type": "string",
                          "description": "The product group of the individual agreement."
                        },
                        "shortProductName": {
                          "type": "string",
                          "description": "The short product name"
                        },
                        "longProductName": {
                          "type": "string",
                          "description": "The long product name."
                        },
                        "agreementStatus": {
                          "type": "string",
                          "enum": [
                            "Active",
                            "Inactive",
                            "Cancelled",
                            "Pending",
                            "Terminated"
                          ],
                          "description": "The status of the individual agreement. "
                        },
                        "agreementStatusEffectiveDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement status changed to the current status."
                        },
                        "agreementStatusReason": {
                          "type": "string",
                          "description": "The reason for the status of the individual agreement.\n "
                        },
                        "agreementInforceDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement became inforce."
                        },
                        "agreementIssueDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement was issued."
                        },
                        "agreementTerminationDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement expired or ceased to be inforce."
                        },
                        "agreementTerminatedDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement was terminated."
                        },
                        "agreementExpiryDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement was expired."
                        },
                        "agreementTerminationReason": {
                          "type": "string",
                          "description": "The reason for termination of the individual agreement."
                        },
                        "agreementTerminationReasonDescription": {
                          "type": "string",
                          "description": "The description of the reason for termination of the individual agreement."
                        },
                        "agreementLastChangeDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement was last changed.    "
                        },
                        "groupAgreementID": {
                          "type": "string",
                          "description": "The unique identifier assigned to the group agreement by source system such as CCP, Merlin etc.\n          "
                        },
                        "productEligibilityClassID": {
                          "type": "string",
                          "description": "The Product Eligibility Class assigned by an Employer for group of employees"
                        },
                        "productEligibilityClassText": {
                          "type": "string",
                          "description": "The Product Eligibility Class name assigned by an Employer for group of employees"
                        },
                        "benefitEligibilityClassID": {
                          "type": "string",
                          "description": "The Benefit Class assigned by an Employer for group of employees for Benefit enrollment"
                        },
                        "benefitEligibilityText": {
                          "type": "string",
                          "description": "The Benefit Class name assigned by an Employer for group of employees for Benefit enrollment"
                        },
                        "insuringCompanyCode": {
                          "type": "string",
                          "description": "The Underwriting company code under which Individual Agreement was issued.                       "
                        },
                        "agreementIssueJurisdictionCode": {
                          "type": "string",
                          "description": "The jurisdiction of the individual agreement at the time of issue."
                        },
                        "applicationSignedDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the application was signed."
                        },
                        "applicationSignedJurisdictionCode": {
                          "type": "string",
                          "description": "The jurisdiction in which the Application  was signed. This can be different from the issue jurisdiction of the individual agreement.        "
                        },
                        "agreementType": {
                          "type": "string",
                          "enum": [
                            "PayrollDeducted",
                            "DirectBilled"
                          ],
                          "description": "An individual agreement as salary deducted (billed part of group) , direct billed (directly billed to the person)"
                        },
                        "portedIndicator": {
                          "type": "string",
                          "enum": [
                            "Yes",
                            "No"
                          ],
                          "description": "Indicator to identify if the individual agreement is ported or not."
                        },
                        "portedDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date on which the individual agreement was ported.        "
                        },
                        "sourceProductPackageID": {
                          "type": "string",
                          "description": "The unique identifier assigned to the product package."
                        },
                        "sourceProductID": {
                          "type": "string",
                          "description": "The unique identifier assigned to the product. For Merlin & CCP, this is the Offering Product ID For OPAL, the values - ID, I2, IP "
                        },
                        "agreementName": {
                          "type": "string",
                          "description": "The name of the agreement associated with the product. \n"
                        },
                        "paidToDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date until which the individual agreement is paid."
                        },
                        "billingDetail": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "originalBillingDivisionID": {
                              "type": "string",
                              "description": "The billing division under which the Individual Agreement was originally billed when they were list bill. currently this is applicable only for CCP"
                            },
                            "billingDivisionID": {
                              "type": "string",
                              "description": "The billing division under which the Individual Agreement is billed."
                            },
                            "billingDivisionName": {
                              "type": "string",
                              "description": "The billing division name under which the Individual Agreement is billed. "
                            },
                            "billingDiscounts": {
                              "type": "string",
                              "description": "The billing discounts applied to the individual agreement as applicable. Currently this is applicable only for OPAL  OPAL Example:- FB (Flex bill 5%), ES (Employer Sponsored 5%), None (Default) etc. "
                            },
                            "billingMode": {
                              "type": "string",
                              "enum": [
                                "Manual",
                                "Automated"
                              ],
                              "description": "The billing mode of the individual agreement such as Manual or Automated  "
                            },
                            "billingType": {
                              "type": "string",
                              "enum": [
                                "ACH1",
                                "ListBill",
                                "DirectBill",
                                "SelfAccounting",
                                "DirectBills",
                                "Pre-AuthorizedCheck",
                                "CollectivelyBilled",
                                "GovernmentAllotment",
                                "UnusualBilling",
                                "PostdatedCheck",
                                "DiscountedPremium",
                                "PacketCoupon"
                              ],
                              "description": "The billing type of the individual agreement such as  ACH1 (Automatic withdrawal from bank account), List Bill (Group List Billed/MultiLife), Individual Bill (Direct Billed), Self Accounting, Individual Bills (More than 1 Individual Agreement Direct Billed) etc Values are based on source system"
                            },
                            "billingFrequency": {
                              "type": "string",
                              "enum": [
                                "Monthly",
                                "Quarterly",
                                "Semi-Annual",
                                "Annual"
                              ],
                              "description": "The billing frequency of the individual agreement such as Monthly, Quarterly, Semi-Annual, Annual, Weekly, Bi-Weekly etc Values are based on source system"
                            },
                            "billingStatus": {
                              "type": "string",
                              "enum": [
                                "Active",
                                "Inactive",
                                "Cancelled",
                                "Pending",
                                "ReadyBill",
                                "Terminated",
                                "NeverActive"
                              ],
                              "description": "The billing status of the individual agreement such as Active, Inactive, Cancelled, Pending, Ready Bill, Terminated, Never Active etc Values are based on source system"
                            },
                            "billingStatusDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the billing status changed to the current status."
                            },
                            "currentBillGenerationDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the current bill was generated."
                            },
                            "nextBillGenerationDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the next bill will be generated."
                            },
                            "leadDays": {
                              "type": "integer",
                              "description": "The number of days before the Next bill generation."
                            },
                            "nextBillPeriodBeginDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the next bill period begins."
                            },
                            "nextBillPeriodEndDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the next bill period ends.                    "
                            },
                            "lastBillPeriodEndDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the last bill period ended."
                            },
                            "lastBillPeriodBeginDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the last bill period began.    "
                            },
                            "lockBoxCode": {
                              "type": "string",
                              "description": "The lock box code to which the payment is sent."
                            },
                            "billedThroughDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date through which the individual agreement is billed."
                            },
                            "billingStartDay": {
                              "type": "integer",
                              "description": "Day on which billing should begin in each Calendar year."
                            },
                            "numberOfNonBillingMonths": {
                              "type": "integer",
                              "description": "The number of months for which there is no billing.  If the policy is billed nine months of the year, this field will contain 03."
                            },
                            "billingDueText": {
                              "type": "string",
                              "description": "The billing due text such as 1st of the month, 15th of the month etc"
                            },
                            "totalPremiumCredit": {
                              "type": "number",
                              "format": "double",
                              "description": "The total premium credit amount."
                            },
                            "premiumAdjustment": {
                              "type": "number",
                              "format": "double",
                              "description": "The premium adjustment amount."
                            },
                            "premiumDifference": {
                              "type": "number",
                              "format": "double",
                              "description": "The premium difference amount."
                            },
                            "lastAccountingDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the last accounting was done."
                            },
                            "lastPolicyChangeDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the last policy change was done.        "
                            },
                            "lastBillingDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the last premium billing activity was done."
                            },
                            "semiMonthlyBillingDays": {
                              "type": "integer",
                              "description": "The two days in each month on which a semi-monthly policy bills."
                            },
                            "employeeNumber": {
                              "type": "string",
                              "description": "The employee number assigned to the individual agreement. - On Individual Pay Group policies, it is used to carry the group number. - On Salary Deduction, Pension Trust, and Government Allotment cases, it will carry an Employee or Service ID \n  Number (if one is furnished).\n- For Collectively Bill cases, this field is not used (account number is carried in the Billing Information) - For Conversions after March, 1977 (BCN prefix A or J), this field will contain the 'conversion date' with a\n  prefix identifying the type conversion; i.e. ICV = voluntary; ICA = Agent; ICD = direct."
                            },
                            "paidToDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date until which the individual agreement is paid."
                            },
                            "systemCalculatedPremiumAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The premium amount calculated outside the billing cycle which differs from the amount calculated by the billing cycle."
                            },
                            "modePremiumAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The amount of mode premium for the current Standard Frequency (monthly, quarterly, semi-annaul, annual).   It is the mode premium amount for the due date on or after the Last Contractual Change Date. For Special Frequency Billing policies, this field will contain the monthly mode premium amount."
                            },
                            "lapseDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the individual agreement lapsed due to various reasons."
                            },
                            "agreementTerminationDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the individual agreement expired or ceased to be inforce."
                            },
                            "agreementTerminatedDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the individual agreement was terminated.    "
                            },
                            "agreementIssueDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the individual agreement was issued. This field is sometime known as Premium Effective Date."
                            },
                            "agreementTerminationReason": {
                              "type": "string",
                              "description": "The reason for termination of the individual agreement."
                            },
                            "agreementTerminationReasonDescription": {
                              "type": "string",
                              "description": "The description of the reason for termination of the individual agreement.    "
                            }
                          }
                        },
                        "individualAgreementDiscounts": {
                          "type": "string",
                          "description": "Discounts applied to the Individual Agreement.  Currently OPAL is the system which offers following discounts - None, Spouse, Couples       "
                        },
                        "fieldOfficeName": {
                          "type": "string",
                          "description": "The name of the field office under which the Individual Agreement was sold."
                        },
                        "individualAgreementCoverages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "sourceCoverageSequenceNumber": {
                                "type": "string",
                                "description": "The unique identifier assigned to the coverage by source system such as CCP (This is equivalent to CCP Phase code)."
                              },
                              "coverageIdentifier": {
                                "type": "string",
                                "description": "The unique identifier assigned to the coverage within ODS."
                              },
                              "insuredTypeText": {
                                "type": "string",
                                "enum": [
                                  "Employee",
                                  "Spouse",
                                  "Child",
                                  "DomesticPartner",
                                  "EmployeePlusSpouse",
                                  "EmployeePlusChild",
                                  "Family",
                                  "SpousePlusChild",
                                  "Children",
                                  "EmployeePlusDomesticPartner",
                                  "Other"
                                ],
                                "description": "The type of insured such as Employee, Spouse, Child etc"
                              },
                              "coverageTypeText": {
                                "type": "string",
                                "enum": [
                                  "Base",
                                  "Rider"
                                ],
                                "description": "Base or Rider coverage type"
                              },
                              "formNumber": {
                                "type": "string",
                                "description": "The form number of the coverage."
                              },
                              "planSummaryID": {
                                "type": "string",
                                "description": "The source assigned Plan Number for the coverages. Basically the Plan describes the Benefit Coverages.        "
                              },
                              "coverageText": {
                                "type": "string",
                                "description": "The name of the coverage such as BASESONOFJOB, RDSCKHOSP etc"
                              },
                              "shortCoverageName": {
                                "type": "string",
                                "description": "The short name of the coverage which will be equivalent to product short name for most of the instances."
                              },
                              "longCoverageName": {
                                "type": "string",
                                "description": "The long name of the coverage which will be equivalent to product short name for most of the instances.    "
                              },
                              "coverageStatus": {
                                "type": "string",
                                "enum": [
                                  "Active",
                                  "Inactive",
                                  "Cancelled",
                                  "Pending",
                                  "Issued",
                                  "Terminated",
                                  "Surrendered",
                                  "Reduced Paid Up",
                                  "Declined",
                                  "Pre Lapse",
                                  "Lapsed",
                                  "On Waiver",
                                  "Expired",
                                  "Matured",
                                  "Death Claim Pending",
                                  "Death Claim",
                                  "Extended Term Insurance",
                                  "Paid Up",
                                  "Deceased",
                                  "Rescinded",
                                  "Accelerated Claim",
                                  "Nonforfeiture",
                                  "Contingent Nonforfeiture",
                                  "Survivorship Waiver"
                                ],
                                "description": "The status of the coverage."
                              },
                              "coverageStatusDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the coverage status changed to the current status.    "
                              },
                              "coverageInforceDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the coverage became inforce."
                              },
                              "coverageIssueDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the coverage was issued."
                              },
                              "coverageTerminationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the coverage expired or ceased to be inforce."
                              },
                              "coverageTerminatedDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the coverage was terminated."
                              },
                              "coverageAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The Amount of Coverages purchased at the time of the issue such as 10,000 Life Coverage"
                              },
                              "requestedFaceAmount": {
                                "type": "number",
                                "format": "double"
                              },
                              "benefitAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The Benefit Amount calculated based on the election such as 2x Time salary"
                              },
                              "benefitEligibilityClassCode": {
                                "type": "string",
                                "description": "Identifies a group of employees as assigned by an employer who are eligible to purchase a product."
                              },
                              "productCoverageCode": {
                                "type": "string",
                                "description": "The product Coverage Code assigned to Coverage. CCP doesn't have a concept of Product Coverage Code. Basically this will  be applicable for Merlin (Benefit Id)"
                              },
                              "benefitPlanCode": {
                                "type": "string",
                                "description": "The Benefit Plan Code assigned to the coverage."
                              },
                              "coverageCode": {
                                "type": "string",
                                "description": "The Coverage Code assigned to Coverage by Merlin (Plan Code), CCP (Plan Code) etc"
                              },
                              "genderAtBirth": {
                                "type": "string",
                                "enum": [
                                  "Male",
                                  "Female",
                                  "Intersex"
                                ],
                                "description": "Biological status at the time of birth. Male, Female, Intersex (This is not commonly used)"
                              },
                              "coverageIssueAge": {
                                "type": "integer",
                                "description": "The age of the person at the time of coverage issue."
                              },
                              "underwritingRiskClassCode": {
                                "type": "string",
                                "description": "The risk class assigned by the underwriters    "
                              },
                              "coveragePremiums": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "premiumType": {
                                      "type": "string",
                                      "enum": [
                                        "Bill",
                                        "Annualized",
                                        "PayFrequency",
                                        "PremiumDue"
                                      ],
                                      "description": "The type of premium such as Billed premium, total premium due etc"
                                    },
                                    "premiumAmount": {
                                      "type": "number",
                                      "format": "double",
                                      "description": "The Total premium amount."
                                    },
                                    "EEpremiumAmount": {
                                      "type": "number",
                                      "format": "double",
                                      "description": "The Employee contributed premium."
                                    },
                                    "ERpremiumAmount": {
                                      "type": "number",
                                      "format": "double",
                                      "description": "The Employer contributed premium.        "
                                    },
                                    "premiumFrequency": {
                                      "type": "string",
                                      "enum": [
                                        "Monthly",
                                        "Quarterly",
                                        "Semi-Annual",
                                        "Annual",
                                        "Weekly",
                                        "Bi-Weekly"
                                      ],
                                      "description": "The frequency of premium such as monthly, quarterly etc"
                                    },
                                    "premiumDescription": {
                                      "type": "string",
                                      "enum": [
                                        "Total"
                                      ],
                                      "description": "The description of premium such as total premium etc"
                                    }
                                  }
                                }
                              },
                              "coveragePersonRelationships": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "description": "The relationship between the person and the coverage ",
                                  "properties": {
                                    "personSequenceNumber": {
                                      "type": "integer",
                                      "description": "The sequence number assigned to the current instance of the person object. "
                                    },
                                    "individualPartyIdentifier": {
                                      "type": "string",
                                      "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                                    },
                                    "coverageRelationshipText": {
                                      "type": "string",
                                      "enum": [
                                        "Insured",
                                        "Owner",
                                        "Sponsor",
                                        "Payor"
                                      ],
                                      "description": "The type of relationship pertaining to the coverage."
                                    }
                                  }
                                }
                              },
                              "beneficiaryGroupId": {
                                "type": "string",
                                "description": "Id of group where benefit percentage are allocated"
                              },
                              "homeCarePercentage": {
                                "type": "integer",
                                "description": "The percentage of home care coverage"
                              },
                              "tobaccoIndicatorAtIssue": {
                                "type": "string",
                                "enum": [
                                  "Yes",
                                  "No"
                                ],
                                "description": "Optional Indicator to identify if the person was a tobacco user or not at the time of issuing the coverage. If the person tobacco use status changes, the original tobacco value will be retained at the coverage level         "
                              }
                            }
                          }
                        },
                        "individualAgreementPremiums": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "premiumType": {
                                "type": "string",
                                "enum": [
                                  "Bill",
                                  "Annualized",
                                  "PayFrequency",
                                  "PremiumDue"
                                ],
                                "description": "The type of premium such as Billed premium, total premium due etc"
                              },
                              "premiumAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The Total premium amount."
                              },
                              "EEpremiumAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The Employee contributed premium."
                              },
                              "ERpremiumAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The Employer contributed premium.        "
                              },
                              "premiumFrequency": {
                                "type": "string",
                                "enum": [
                                  "Monthly",
                                  "Quarterly",
                                  "Semi-Annual",
                                  "Annual",
                                  "Weekly",
                                  "Bi-Weekly"
                                ],
                                "description": "The frequency of premium such as monthly, quarterly etc"
                              },
                              "premiumDescription": {
                                "type": "string",
                                "enum": [
                                  "Total"
                                ],
                                "description": "The description of premium such as total premium etc"
                              }
                            }
                          }
                        },
                        "agreementRoles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "roleRelationshipText": {
                                "type": "string",
                                "enum": [
                                  "Owner",
                                  "Insured",
                                  "Sponsor"
                                ]
                              },
                              "partyIdentifier": {
                                "type": "string",
                                "description": "The unique identifier assigned to a party. The party might be a person or an organization."
                              },
                              "partyDisplayName": {
                                "type": "string",
                                "description": "The display name of the party. The party might be a person or an organization. Person -  Last Name, First Name Middle Name Organization - Organization Name   "
                              }
                            }
                          }
                        },
                        "individualAgreementLife": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "loanDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the loan was taken."
                            },
                            "loanBalanceAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The balance amount of the loan."
                            },
                            "endowmentDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The date on which the endowment was taken."
                            },
                            "loanInterestAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The interest amount of the loan."
                            },
                            "netCashValueAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The net cash value amount of the individual agreement."
                            },
                            "grossCashValueAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The gross cash value amount of the individual agreement."
                            },
                            "surrenderValueAmount": {
                              "type": "number",
                              "format": "double",
                              "description": "The surrender value amount of the individual agreement.    "
                            }
                          }
                        },
                        "organization": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "organizationName": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "organizationName": {
                                  "type": "string",
                                  "description": "The name of the organization."
                                },
                                "nameType": {
                                  "type": "string",
                                  "enum": [
                                    "LegalName",
                                    "PreferredName"
                                  ]
                                }
                              }
                            },
                            "postalAddress": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "addressType": {
                                  "type": "string",
                                  "enum": [
                                    "Primary Residence",
                                    "Alternate Home Address",
                                    "Mailing Address"
                                  ],
                                  "description": "The type of address such as primary residence or alternate home address."
                                },
                                "addressLineOne": {
                                  "type": "string",
                                  "description": "The first line of the address."
                                },
                                "addressLineTwo": {
                                  "type": "string",
                                  "description": "Optional The second line of the address."
                                },
                                "addressLineThree": {
                                  "type": "string",
                                  "description": "Optional The third line of the address."
                                },
                                "city": {
                                  "type": "string",
                                  "description": "The city of the address."
                                },
                                "jurisdictionCode": {
                                  "type": "string",
                                  "description": "The jurisdiction of the address such as state or province."
                                },
                                "postalCode": {
                                  "type": "string",
                                  "description": "The postal code of the address."
                                },
                                "country": {
                                  "type": "string",
                                  "description": "The country of the address."
                                },
                                "beginDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became effective."
                                },
                                "endDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became ineffective.        "
                                }
                              }
                            },
                            "externalOrganizationIdentifiers": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "description": "Identification Number assigned to an organization entity either by the US government or third party.",
                                "properties": {
                                  "identifierType": {
                                    "type": "string",
                                    "enum": [
                                      "EmployerIdentificationNumber"
                                    ]
                                  },
                                  "identificationNumber": {
                                    "minLength": 1,
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "planSummaries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "coverageCode": {
                            "type": "string",
                            "description": "The Coverage Code assigned to Coverage by Merlin (Plan Code), CCP (Plan Code) etc"
                          },
                          "planSummaryID": {
                            "type": "string",
                            "description": "The plan number assigned to the plan by source system such as CCP, Merlin etc."
                          },
                          "planName": {
                            "type": "string",
                            "description": "The name of the plan."
                          },
                          "planProvisions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "planProvisionID": {
                                  "type": "string",
                                  "description": "The unique identifier assigned to the plan provision by source system such as CCP, Merlin, OPAL etc."
                                },
                                "planProvisionName": {
                                  "type": "string",
                                  "description": "The name of the plan provision."
                                },
                                "provisionValueID": {
                                  "type": "string",
                                  "description": "The unique identifier assigned to the provision value by source system such as CCP, Merlin, OPAL etc.    "
                                },
                                "provisionValueText": {
                                  "type": "string",
                                  "description": "The value of the plan provision value"
                                },
                                "unitOfMeasureValue": {
                                  "type": "string",
                                  "description": "The unit of measure of the plan provision value such as $, %, text etc    "
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request malformed or in violation of business rules.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not authorized to access this Individual Agreement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "x-unum-correlation-id": {
        "name": "x-unum-correlation-id",
        "description": "A uuid to audit this request for the purposes of correlating audit entries across various technologies.",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "unum_api_key": {
        "type": "apiKey",
        "name": "apikey",
        "in": "header",
        "description": "Api_key assigned to the application"
      }
    },
    "schemas": {
      "errorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "guid",
                  "description": "A unique identifier for the specific instance of the error. (Please note that this is not the status code or an application-specific identifier.)",
                  "example": "fdf1d410-b08f-41a8-b56e-a08dec7339be"
                },
                "href": {
                  "type": "string",
                  "description": "A URL that the developer can use to learn more about the issue (for example, a link to documentation on the issue).",
                  "example": "http://api.unum.com/docs/?article-id=1"
                },
                "status": {
                  "type": "string",
                  "description": "The HTTP status code related to this specific error, if applicable (Usually 400 for application errors).",
                  "example": "400"
                },
                "code": {
                  "type": "string",
                  "description": "An application-specific code that identifies the error for logging or support purposes. This number may be presented to the user to use as a reference when calling in.",
                  "example": "100"
                },
                "timeStamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The precise date & time the error occurred.",
                  "example": "2018-04-01T12:00:00-05:00"
                },
                "title": {
                  "type": "string",
                  "description": "A short, human-readable message that briefly describes the error.",
                  "example": "Request malformed or in violation of business rules."
                },
                "detail": {
                  "type": "string",
                  "description": "A more in-depth, human-readable description of the error and how to resolve it.",
                  "example": "An enterprise identifier is required but was not supplied with the request."
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "unum_api_key": []
    }
  ]
}
