{
  "openapi": "3.0.1",
  "info": {
    "title": "Unum Customer Resources",
    "description": "Aggregated contract for APIs supporting Unum's CRM/MDM capability. ",
    "version": "3.0.0",
    "x-unum-api-type": "command & query",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/unum-42a/unum-customer-resources/3.0.0"
  },
  "servers": [
    {
      "url": "https://api.acpt.unum.com",
      "description": "Development Environment without mutual SSL"
    },
    {
      "url": "https://api2.acpt.unum.com",
      "description": "Development Environment with mutual SSL"
    },
    {
      "url": "https://api.acpt.unum.com",
      "description": "Integration Test Environment without mutual SSL"
    },
    {
      "url": "https://api2.acpt.unum.com",
      "description": "Integration Test Environment with mutual SSL"
    },
    {
      "url": "https://api.acpt.unum.com",
      "description": "Acceptance Environment without mutual SSL"
    },
    {
      "url": "https://api2.acpt.unum.com",
      "description": "Acceptance Environment with mutual SSL"
    },
    {
      "url": "https://api.unum.com",
      "description": "Production Environment without mutual SSL"
    },
    {
      "url": "https://api2.unum.com",
      "description": "Production Environment with mutual SSL"
    }
  ],
  "paths": {
    "/enterprise-information/individual-agreements/v1": {
      "get": {
        "tags": [
          "Individual Agreement"
        ],
        "summary": "Search Individual Agreement by various criteria",
        "description": "The divisions collection supports information and processes relating to divisions, products, provisions and eligibility classes as applicable. A listing of a client's current divisions is provided under the /clients resource collection. Added at v1.0.0.\n### Combined Search criteria fields Supported by the Operation\n- Source System ConsumerId, Social Security Number, Birth Date and Source System Text\n- Social Security Number, Birth Date and Source System Text\n- Source System ConsumerId and Source System Text\n- Policy Number, Last Name and Source System Text \n### Combined Search criteria fields not supported by the Operation\n- Social Security Number and Source System Text\n- First Name, Last Name, Birth Date and Source System Text\n- First Name, Last Name, Postal Code and Source System Text\n\n### Search criteria fields not supported by the Operation\n- Exclude Individual Agreement Coverage\n- First Name\n- Last Name\n- Postal Code",
        "operationId": "searchIndividualAgreement",
        "parameters": [
          {
            "name": "x-unum-param-socialSecurityNumber",
            "in": "header",
            "description": "The social security number of the person.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-unum-param-birthDate",
            "in": "header",
            "description": "The date of birth of the person.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourceSystemText",
            "in": "query",
            "description": "The source system name associated with this object. If an unrecognized source system name is supplied, a '400' error may be issued in response.",
            "required": true,
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "OPAL",
                  "CCP",
                  "ACHIEVE",
                  "BEST",
                  "MERLIN-HRC"
                ]
              }
            }
          },
          {
            "name": "excludeIndividualAgreementCoverage",
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "boolean"
            },
            "description": "> #### Optional\n> - If the excludeIndividualAgreementCoverage is not provided or the value is false, individualAgreement and its Coverages are returned . \n> - If the excludeIndividualAgreementCoverage is provided with a value of true, individualAgreements without Coverages are returned."
          },
          {
            "name": "personData",
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "string",
              "enum": [
                "Rationalized",
                "Source",
                "Both"
              ]
            },
            "description": "> #### Optional\n> - If the personData is not provided, person object will not be returned and coveragePersonRelationships object will not include personSequenceNumber field. \n> - If the personData is provided, persons array will be returned based on the requested data.  "
          },
          {
            "name": "startIndex",
            "in": "query",
            "description": "The index of the first result desired by the searchIndividualAgreement operation client.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "startPage",
            "in": "query",
            "description": "The page number of the set of results desired by the consuming applications. If unspecified, returns the first page.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "The number of IndividualAgreements per page desired by the consuming applications.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "asOfDate",
            "in": "query",
            "description": "asOf date of the individual agreement",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2023-03-31"
            },
            "required": false
          },
          {
            "name": "firstName",
            "in": "query",
            "description": "A partial string to match against individual agreement insured first name. Wildcards can be used.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 20
            },
            "required": false
          },
          {
            "name": "lastName",
            "in": "query",
            "description": "A partial string to match against individual agreement insured last name. Wildcards can be used.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 20
            },
            "required": false
          },
          {
            "name": "postalCode",
            "in": "query",
            "description": "A first 5 digits of postal code to match against the individual agreement insured postal code Example: 37421",
            "schema": {
              "type": "string",
              "minLength": 5,
              "maxLength": 5
            },
            "required": false
          },
          {
            "name": "productCode",
            "in": "query",
            "description": "The product code of the individual agreement.  This attribute has to be used in conjunction with the sourceSystemConsumerId and sourceSystemText. Currently we support only GWL. All has been added as a place holder for future use. If \"All\" passed,  ensure the application can handle future individual agreements with different products as EDI  loads other products in near future",
            "schema": {
              "type": "string",
              "enum": [
                "GWL",
                "All"
              ]
            }
          },
          {
            "name": "sourceSystemConsumerId",
            "in": "query",
            "description": "The unique identifier assigned to the consumer by the source system.  ",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "policyNumber",
            "in": "query",
            "description": "The policy number associated with the individual agreement. If provided, the search will include filtering by this policy number.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/x-unum-correlation-id"
          }
        ],
        "responses": {
          "200": {
            "description": "Individual Agreement which matched the search criteria.",
            "headers": {
              "Cache-control": {
                "description": "private, max-age=1800",
                "schema": {
                  "type": "string"
                }
              },
              "x-unum-correlation-id": {
                "description": "A uuid to audit this request for the purposes of correlating audit entries across various technologies.",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "searchResultMetadata": {
                      "type": "object",
                      "required": [
                        "totalResults"
                      ],
                      "description": "An optional collection of standard metadata to be provided with a search operation. Based on OpenSearch 1.1.6.",
                      "properties": {
                        "query": {
                          "type": "object",
                          "required": [
                            "searchTerms"
                          ],
                          "description": "The search request as interpreted and understood by the search provider. These attributes should be used by search operations to help ensure consistency across the API portfolio.",
                          "properties": {
                            "searchTerms": {
                              "type": "string",
                              "description": "The user-supplied search string(s), as normalized if applicable by the query parser.",
                              "example": "12345678,23456789-0001"
                            }
                          }
                        },
                        "startIndex": {
                          "type": "integer",
                          "format": "int32",
                          "minimum": 0,
                          "description": "The index of the first search result, relative to totalResults. May be zero if no results were found.",
                          "example": 1
                        },
                        "totalResults": {
                          "type": "integer",
                          "format": "int32",
                          "minimum": 0,
                          "description": "The expected number of search results available to be found, exclusive of results the user does not have access to.",
                          "example": 1
                        },
                        "itemsPerPage": {
                          "type": "integer",
                          "format": "int32",
                          "minimum": 0,
                          "description": "The number of search results returned per page (if the totalResults returned are larger than the requested query count per page). May be zero if no results were found.",
                          "example": 50
                        },
                        "resultMetadata": {
                          "type": "object",
                          "description": "An optional collection of standard metadata to be provided with an operation. Based loosely on HAL-08 and OpenSearch 1.1.6.",
                          "properties": {
                            "timeTaken": {
                              "type": "integer",
                              "description": "The non-zero server time taken (in milliseconds) to establish a response to the request, inclusive of all compute resources used, but not inclusive of time taken to stream the response to the client.",
                              "example": 161
                            },
                            "_links": {
                              "type": "array",
                              "description": "See description for 'link'. As this conceptually mirrors the purpose of HTTP links, and 'links' is a reserved word per the OAS specification, this attribute is prefixed with an underscore. Links provided here can also be used in building HTTP links at the discretion of the service implementation.",
                              "items": {
                                "type": "object",
                                "description": "Provides basic HATEOAS support for an API response. Based loosely on the OpenSearch 1.1.6 'Url' element.",
                                "required": [
                                  "rel",
                                  "href"
                                ],
                                "properties": {
                                  "rel": {
                                    "type": "string",
                                    "description": "The role of the resource being described in relation to the description document. Rel attribute strings can contain a space-delimited list of one or more semantically meaningful rel value tokens. An empty rel attribute value should be treated by the client as if the rel attribute was not present at all. If a client does not recognize the semantic meaning of any rel value token, then the containing Url should be ignored by the client. Allowable values are lowercase and documented at https://www.iana.org/assignments/link-relations/link-relations.xhtml.",
                                    "enum": [
                                      "self",
                                      "prev",
                                      "next",
                                      "last",
                                      "first"
                                    ]
                                  },
                                  "type": {
                                    "type": "string",
                                    "description": "The optional MIME type of the resource being described.",
                                    "example": "application/json"
                                  },
                                  "href": {
                                    "type": "string",
                                    "format": "uri",
                                    "description": "The URI of the resource represented by a link relation.",
                                    "example": "https://api.unum.com/organizations/v1/?agreements=12345678,23456789&startIndex=1&count=50"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "persons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "personSequenceNumber": {
                            "type": "integer",
                            "description": "The sequence number assigned to the current instance of the person object. "
                          },
                          "individualPartyIdentifier": {
                            "type": "string",
                            "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                          },
                          "coverageRelationshipText": {
                            "type": "string",
                            "enum": [
                              "Insured",
                              "Owner",
                              "Sponsor",
                              "Payor"
                            ],
                            "description": "The type of relationship pertaining to the coverage."
                          },
                          "personDisplayName": {
                            "type": "string",
                            "description": "The name of the person to be displayed and it is in the form of last name, first name Middle name"
                          },
                          "firstName": {
                            "type": "string",
                            "description": "The first name of the person."
                          },
                          "lastName": {
                            "type": "string",
                            "description": "The last name of the person."
                          },
                          "middleName": {
                            "type": "string",
                            "description": "Optional The middle name of the person. "
                          },
                          "prefixTitle": {
                            "type": "string",
                            "description": "Optional The prefix of the person."
                          },
                          "suffixTitle": {
                            "type": "string",
                            "description": "Optional The suffix that follows the Last Name which provides additional information such as Jr."
                          },
                          "taxIdentificationNumber": {
                            "type": "string",
                            "description": "The tax identification number assigned to the Person by the USA federal government."
                          },
                          "taxIdentificationType": {
                            "type": "string",
                            "description": "The type of tax identification number assigned to the Person by the USA federal government such as SSN or TIN"
                          },
                          "dateOfBirth": {
                            "type": "string",
                            "format": "date",
                            "description": "The day on which Person was born."
                          },
                          "genderAtBirth": {
                            "type": "string",
                            "enum": [
                              "Male",
                              "Female",
                              "Intersex"
                            ],
                            "description": "Biological status at the time of birth. Male, Female, Intersex (This is not commonly used)"
                          },
                          "genderIdentity": {
                            "type": "string",
                            "description": "Optional Personal and internal sense of oneself as male, female or other. This is for future use and currently it will not be populated"
                          },
                          "smokerIndicator": {
                            "type": "string",
                            "enum": [
                              "Yes",
                              "No"
                            ],
                            "description": "Indicator to identify if the person is a smoker or not.            "
                          },
                          "smokerIndicatorEffectiveDate": {
                            "type": "string",
                            "description": "Optional Effective date of Smoker usage. It will not be populated if the person has never smoked"
                          },
                          "tobaccoIndicator": {
                            "type": "string",
                            "description": "Optional Indicator to identify if the person is a tobacco user or not."
                          },
                          "tobaccoIndicatorEffectiveDate": {
                            "type": "string",
                            "description": "Optional Effective date of Tobacco usage. It will not be populated if the person has never used any form of tobacco"
                          },
                          "employerIdentifier": {
                            "type": "string",
                            "description": "Organizations unique identifiers called \"Employer Party ID\".    "
                          },
                          "postalAddresses": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "addressType": {
                                  "type": "string",
                                  "enum": [
                                    "Primary Residence",
                                    "Alternate Home Address",
                                    "Mailing Address"
                                  ],
                                  "description": "The type of address such as primary residence or alternate home address."
                                },
                                "addressLineOne": {
                                  "type": "string",
                                  "description": "The first line of the address."
                                },
                                "addressLineTwo": {
                                  "type": "string",
                                  "description": "Optional The second line of the address."
                                },
                                "addressLineThree": {
                                  "type": "string",
                                  "description": "Optional The third line of the address."
                                },
                                "city": {
                                  "type": "string",
                                  "description": "The city of the address."
                                },
                                "jurisdictionCode": {
                                  "type": "string",
                                  "description": "The jurisdiction of the address such as state or province."
                                },
                                "postalCode": {
                                  "type": "string",
                                  "description": "The postal code of the address."
                                },
                                "country": {
                                  "type": "string",
                                  "description": "The country of the address."
                                },
                                "beginDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became effective."
                                },
                                "endDate": {
                                  "type": "string",
                                  "format": "date",
                                  "description": "The date the address became ineffective.        "
                                }
                              }
                            }
                          },
                          "digitalAddresses": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "digitalAddressesType": {
                                  "type": "string",
                                  "enum": [
                                    "Email",
                                    "SMS",
                                    "SocialMedia",
                                    "Fax",
                                    "HomePhone",
                                    "MobilePhone",
                                    "Other"
                                  ],
                                  "description": "The means of digital communication."
                                },
                                "digitalAddressText": {
                                  "type": "string",
                                  "description": "The digital address text."
                                }
                              }
                            }
                          },
                          "beneficiaryInfo": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "dependentRelationshipType": {
                                  "type": "string",
                                  "description": "Spouse/child/grandchild etc -- N/A for other party org"
                                },
                                "partyOrganizationName": {
                                  "type": "string",
                                  "description": "This is the OrganisationName --- N/A for dependent beneficiaries"
                                },
                                "partyType": {
                                  "type": "string",
                                  "description": "charity etc --- N/A for dependent beneficiaries"
                                },
                                "beneficiaryRelationshipType": {
                                  "type": "string",
                                  "description": "charity"
                                },
                                "beneficiaryGroupId": {
                                  "type": "string"
                                },
                                "beneficiaryType": {
                                  "type": "string"
                                },
                                "beneficiaryPercentage": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "rationalized": {
                            "type": "boolean",
                            "description": "Optional Indicator to identify if the person record has been rationalized or not."
                          },
                          "clientEmployeeIdentifier": {
                            "type": "string",
                            "description": "Organizations often assign unique identifiers to individuals. These identifiers, often called \"Employee ID\".  "
                          },
                          "sourceSystemIndividualPartyIdentifications": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "sourceIndividualPartyIdentifier": {
                                  "type": "string",
                                  "description": "Source system assigned identifier for the individual. "
                                },
                                "sourceSystemText": {
                                  "type": "string",
                                  "description": "The name of the source system.",
                                  "enum": [
                                    "OPAL",
                                    "MERLN",
                                    "LF70",
                                    "CIA",
                                    "NVLNK",
                                    "ACHIEVE"
                                  ]
                                }
                              }
                            }
                          },
                          "SensitivityLevel": {
                            "type": "string",
                            "enum": [
                              "Confidential",
                              "Internal"
                            ],
                            "description": "The SensitivityLevel is based on  Importance & Confidentiality  of the data. Only two values are supported at this time - Confidential, Internal. Internal - Data that is not intended for public release and is only available to authorized Clients, Consumers, employees and contractors of the organization.  Confidential - Data that is not intended for public release and is only available for selected authorized Unum employees and contractors of the organization. As of the current implementation, Confidential is set if the data is for Unum employee"
                          },
                          "employment": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "originalHireDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional The first day an individual officially starts working for an organization."
                              },
                              "mostRecentHireDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional The first day an individual officially starts working for an organization after a previous termination.                "
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "Active",
                                  "Inactive",
                                  "Sabbatical",
                                  "Furlough",
                                  "FMLA",
                                  "Terminated",
                                  "New"
                                ],
                                "description": "Optional This field reflects current employment status of the employee."
                              },
                              "terminationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "Optional This field reflects the date of termination of employment."
                              },
                              "terminationReason": {
                                "type": "string",
                                "enum": [
                                  "Death",
                                  "Layoff",
                                  "Leave Of Absence",
                                  "Long Term Disability",
                                  "Retirement",
                                  "Decline Coverage",
                                  "Termination",
                                  "Other"
                                ],
                                "description": "Optional This field reflects the reason of termination of employment."
                              }
                            }
                          }
                        }
                      }
                    },
                    "individualAgreements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "individualAgreementID": {
                            "type": "string",
                            "description": "The unique identifier assigned to the individual agreement by source system such as CCP, Opal etc."
                          },
                          "policyNumber": {
                            "type": "string",
                            "description": "The policy number associated with the individual agreement."
                          },
                          "sourceSystemText": {
                            "type": "string",
                            "description": "The source system that created the individual agreement."
                          },
                          "subSourceSystem": {
                            "type": "string",
                            "description": "The sub source system which contributes to primary source System."
                          },
                          "productGroupText": {
                            "type": "string",
                            "description": "The product group of the individual agreement."
                          },
                          "shortProductName": {
                            "type": "string",
                            "description": "The short product name"
                          },
                          "longProductName": {
                            "type": "string",
                            "description": "The long product name."
                          },
                          "businessUnitCode": {
                            "type": "string",
                            "description": "The code representing the business unit associated with the individual agreement."
                          },
                          "businessUnitName": {
                            "type": "string",
                            "description": "The name of the business unit associated with the individual agreement."
                          },
                          "agreementStatus": {
                            "type": "string",
                            "enum": [
                              "Active",
                              "Inactive",
                              "Cancelled",
                              "Pending",
                              "Terminated"
                            ],
                            "description": "The status of the individual agreement. "
                          },
                          "agreementStatusEffectiveDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement status changed to the current status."
                          },
                          "agreementStatusReason": {
                            "type": "string",
                            "description": "The reason for the status of the individual agreement.\n "
                          },
                          "agreementInforceDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement became inforce."
                          },
                          "agreementIssueDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement was issued."
                          },
                          "agreementTerminationDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement expired or ceased to be inforce."
                          },
                          "agreementTerminatedDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement was terminated."
                          },
                          "agreementExpiryDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement was expired."
                          },
                          "agreementTerminationReason": {
                            "type": "string",
                            "description": "The reason for termination of the individual agreement."
                          },
                          "agreementTerminationReasonDescription": {
                            "type": "string",
                            "description": "The description of the reason for termination of the individual agreement."
                          },
                          "agreementLastChangeDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement was last changed.    "
                          },
                          "groupAgreementID": {
                            "type": "string",
                            "description": "The unique identifier assigned to the group agreement by source system such as CCP, Merlin etc.\n          "
                          },
                          "productEligibilityClassID": {
                            "type": "string",
                            "description": "The Product Eligibility Class assigned by an Employer for group of employees"
                          },
                          "productEligibilityClassText": {
                            "type": "string",
                            "description": "The Product Eligibility Class name assigned by an Employer for group of employees"
                          },
                          "benefitEligibilityClassID": {
                            "type": "string",
                            "description": "The Benefit Class assigned by an Employer for group of employees for Benefit enrollment"
                          },
                          "benefitEligibilityText": {
                            "type": "string",
                            "description": "The Benefit Class name assigned by an Employer for group of employees for Benefit enrollment"
                          },
                          "insuringCompanyCode": {
                            "type": "string",
                            "description": "The Underwriting company code under which Individual Agreement was issued.                       "
                          },
                          "agreementIssueJurisdictionCode": {
                            "type": "string",
                            "description": "The jurisdiction of the individual agreement at the time of issue."
                          },
                          "applicationSignedDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the application was signed."
                          },
                          "applicationSignedJurisdictionCode": {
                            "type": "string",
                            "description": "The jurisdiction in which the Application  was signed. This can be different from the issue jurisdiction of the individual agreement.        "
                          },
                          "agreementType": {
                            "type": "string",
                            "enum": [
                              "PayrollDeducted",
                              "DirectBilled"
                            ],
                            "description": "An individual agreement as salary deducted (billed part of group) , direct billed (directly billed to the person)"
                          },
                          "portedIndicator": {
                            "type": "string",
                            "enum": [
                              "Yes",
                              "No"
                            ],
                            "description": "Indicator to identify if the individual agreement is ported or not."
                          },
                          "portedDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date on which the individual agreement was ported.        "
                          },
                          "sourceProductPackageID": {
                            "type": "string",
                            "description": "The unique identifier assigned to the product package."
                          },
                          "sourceProductID": {
                            "type": "string",
                            "description": "The unique identifier assigned to the product. For Merlin & CCP, this is the Offering Product ID For OPAL, the values - ID, I2, IP"
                          },
                          "agreementName": {
                            "type": "string",
                            "description": "The name of the agreement associated with the product. \n"
                          },
                          "paidToDate": {
                            "type": "string",
                            "format": "date",
                            "description": "The date until which the individual agreement is paid."
                          },
                          "billingDetail": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "originalBillingDivisionID": {
                                "type": "string",
                                "description": "The billing division under which the Individual Agreement was originally billed when they were list bill. currently this is applicable only for CCP"
                              },
                              "billingDivisionID": {
                                "type": "string",
                                "description": "The billing division under which the Individual Agreement is billed."
                              },
                              "billingDivisionName": {
                                "type": "string",
                                "description": "The billing division name under which the Individual Agreement is billed. "
                              },
                              "billingDiscounts": {
                                "type": "string",
                                "description": "The billing discounts applied to the individual agreement as applicable. Currently this is applicable only for OPAL  OPAL Example:- FB (Flex bill 5%), ES (Employer Sponsored 5%), None (Default) etc. "
                              },
                              "billingMode": {
                                "type": "string",
                                "enum": [
                                  "Manual",
                                  "Automated"
                                ],
                                "description": "The billing mode of the individual agreement such as Manual or Automated  "
                              },
                              "billingType": {
                                "type": "string",
                                "enum": [
                                  "ACH1",
                                  "ListBill",
                                  "DirectBill",
                                  "SelfAccounting",
                                  "DirectBills",
                                  "Pre-AuthorizedCheck",
                                  "CollectivelyBilled",
                                  "GovernmentAllotment",
                                  "UnusualBilling",
                                  "PostdatedCheck",
                                  "DiscountedPremium",
                                  "PacketCoupon"
                                ],
                                "description": "The billing type of the individual agreement such as  ACH1 (Automatic withdrawal from bank account), List Bill (Group List Billed/MultiLife), Individual Bill (Direct Billed), Self Accounting, Individual Bills (More than 1 Individual Agreement Direct Billed) etc Values are based on source system"
                              },
                              "billingFrequency": {
                                "type": "string",
                                "enum": [
                                  "Monthly",
                                  "Quarterly",
                                  "Semi-Annual",
                                  "Annual"
                                ],
                                "description": "The billing frequency of the individual agreement such as Monthly, Quarterly, Semi-Annual, Annual, Weekly, Bi-Weekly etc Values are based on source system"
                              },
                              "billingStatus": {
                                "type": "string",
                                "enum": [
                                  "Active",
                                  "Inactive",
                                  "Cancelled",
                                  "Pending",
                                  "ReadyBill",
                                  "Terminated",
                                  "NeverActive"
                                ],
                                "description": "The billing status of the individual agreement such as Active, Inactive, Cancelled, Pending, Ready Bill, Terminated, Never Active etc Values are based on source system"
                              },
                              "billingStatusDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the billing status changed to the current status."
                              },
                              "currentBillGenerationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the current bill was generated."
                              },
                              "nextBillGenerationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the next bill will be generated."
                              },
                              "leadDays": {
                                "type": "integer",
                                "description": "The number of days before the Next bill generation."
                              },
                              "nextBillPeriodBeginDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the next bill period begins."
                              },
                              "nextBillPeriodEndDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the next bill period ends.                    "
                              },
                              "lastBillPeriodEndDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the last bill period ended."
                              },
                              "lastBillPeriodBeginDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the last bill period began.    "
                              },
                              "lockBoxCode": {
                                "type": "string",
                                "description": "The lock box code to which the payment is sent."
                              },
                              "billedThroughDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date through which the individual agreement is billed."
                              },
                              "billingStartDay": {
                                "type": "integer",
                                "description": "Day on which billing should begin in each Calendar year."
                              },
                              "numberOfNonBillingMonths": {
                                "type": "integer",
                                "description": "The number of months for which there is no billing.  If the policy is billed nine months of the year, this field will contain 03."
                              },
                              "billingDueText": {
                                "type": "string",
                                "description": "The billing due text such as 1st of the month, 15th of the month etc"
                              },
                              "totalPremiumCredit": {
                                "type": "number",
                                "format": "double",
                                "description": "The total premium credit amount."
                              },
                              "premiumAdjustment": {
                                "type": "number",
                                "format": "double",
                                "description": "The premium adjustment amount."
                              },
                              "premiumDifference": {
                                "type": "number",
                                "format": "double",
                                "description": "The premium difference amount."
                              },
                              "lastAccountingDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the last accounting was done."
                              },
                              "lastPolicyChangeDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the last policy change was done.        "
                              },
                              "lastBillingDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the last premium billing activity was done."
                              },
                              "semiMonthlyBillingDays": {
                                "type": "integer",
                                "description": "The two days in each month on which a semi-monthly policy bills."
                              },
                              "employeeNumber": {
                                "type": "string",
                                "description": "The employee number assigned to the individual agreement. - On Individual Pay Group policies, it is used to carry the group number. - On Salary Deduction, Pension Trust, and Government Allotment cases, it will carry an Employee or Service ID \n  Number (if one is furnished).\n- For Collectively Bill cases, this field is not used (account number is carried in the Billing Information) - For Conversions after March, 1977 (BCN prefix A or J), this field will contain the 'conversion date' with a\n  prefix identifying the type conversion; i.e. ICV = voluntary; ICA = Agent; ICD = direct."
                              },
                              "paidToDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date until which the individual agreement is paid."
                              },
                              "systemCalculatedPremiumAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The premium amount calculated outside the billing cycle which differs from the amount calculated by the billing cycle."
                              },
                              "modePremiumAmount": {
                                "type": "number",
                                "format": "double",
                                "description": "The amount of mode premium for the current Standard Frequency (monthly, quarterly, semi-annaul, annual).   It is the mode premium amount for the due date on or after the Last Contractual Change Date. For Special Frequency Billing policies, this field will contain the monthly mode premium amount."
                              },
                              "lapseDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the individual agreement lapsed due to various reasons."
                              },
                              "agreementTerminationDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the individual agreement expired or ceased to be inforce."
                              },
                              "agreementTerminatedDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the individual agreement was terminated.    "
                              },
                              "agreementIssueDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The date on which the individual agreement was issued. This field is sometime known as Premium Effective Date."
                              },
                              "agreementTerminationReason": {
                                "type": "string",
                                "description": "The reason for termination of the individual agreement."
                              },
                              "agreementTerminationReasonDescription": {
                                "type": "string",
                                "description": "The description of the reason for termination of the individual agreement.    "
                              }
                            }
                          },
                          "individualAgreementDiscounts": {
                            "type": "string",
                            "description": "Discounts applied to the Individual Agreement.  Currently OPAL is the system which offers following discounts - None, Spouse, Couples       "
                          },
                          "fieldOfficeName": {
                            "type": "string",
                            "description": "The name of the field office under which the Individual Agreement was sold."
                          },
                          "individualAgreementCoverages": {
                            "type": "array",
                            "items": {
                              "type": "object",
