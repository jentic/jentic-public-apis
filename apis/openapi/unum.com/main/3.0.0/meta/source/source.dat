                                "coverageIdentifier": {
                                  "type": "string",
                                  "description": "The unique identifier assigned to the coverage within ODS."
                                },
                                "insuredTypeText": {
                                  "type": "string",
                                  "enum": [
                                    "Employee",
                                    "Spouse",
                                    "Child",
                                    "DomesticPartner",
                                    "EmployeePlusSpouse",
                                    "EmployeePlusChild",
                                    "Family",
                                    "SpousePlusChild",
                                    "Children",
                                    "EmployeePlusDomesticPartner",
                                    "Other"
                                  ],
                                  "description": "The type of insured such as Employee, Spouse, Child etc"
                                },
                                "coverageTypeText": {
                                  "type": "string",
                                  "enum": [
                                    "Base",
                                    "Rider"
                                  ],
                                  "description": "Base or Rider coverage type"
