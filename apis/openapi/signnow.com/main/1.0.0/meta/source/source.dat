                      {
                        "auth_method": "email",
                        "email": "{{signer1}}",
                        "order": 1,
                        "role_id": "{{role_id_1}}"
                      },
                      {
                        "auth_method": "email",
                        "email": "{{signer2}}",
                        "order": 1,
                        "role_id": "{{role_id_2}}"
                      }
                    ]
                  }
                }
              },
              "examples": {
                "Create embedded signing invites": {
                  "value": {
                    "invites": [
                      {
                        "auth_method": "email",
                        "email": "{{signer1}}",
                        "order": 1,
                        "role_id": "{{role_id_1}}"
                      },
                      {
                        "auth_method": "email",
                        "email": "{{signer2}}",
                        "order": 1,
                        "role_id": "{{role_id_2}}"
                      }
                    ]
                  }
                },
                "Send embedded invite": {
                  "value": {
                    "invites": [
                      {
                        "auth_method": "email",
                        "email": "{{signer_email}}",
                        "first_name": "qwerty",
                        "last_name": "qwerty",
                        "order": 1,
                        "required_preset_signature_name": "signature test",
                        "role_id": "{{role_id}}"
                      }
                    ]
                  }
                },
                "Send embedded invite (password protected)": {
                  "value": {
                    "invites": [
                      {
                        "auth_method": "social",
                        "authentication": {
                          "password": "{{doc_password}}",
                          "type": "password"
                        },
                        "email": "{{signer_email}}",
                        "first_name": "EMBEDDED",
                        "last_name": "TEST",
                        "order": 1,
                        "redirect_uri": "https://www.signnow.com",
                        "role_id": "{{role_id}}"
                      }
                    ]
                  }
                },
                "Send embedded invite (phone call)": {
                  "value": {
                    "invites": [
                      {
                        "auth_method": "biometric",
                        "authentication": {
                          "method": "phone_call",
                          "phone": "{{Phone_number}}",
                          "type": "phone"
                        },
                        "email": "{{signer_email}}",
                        "first_name": "first_name",
                        "force_new_signature": 1,
                        "last_name": "last_name",
                        "order": 1,
                        "prefill_signature_name": "test prefill_signature_name",
                        "role_id": "{{role_id}}",
                        "signing_instructions": "test signing_instruction"
                      }
                    ]
                  }
                },
                "Send embedded invite (phone sms)": {
                  "value": {
                    "invites": [
                      {
                        "auth_method": "password",
                        "authentication": {
                          "method": "sms",
                          "phone": "{{Phone_number}}",
                          "sms_message": "Custom test message",
                          "type": "phone"
                        },
                        "email": "{{signer_email}}",
                        "first_name": "first_name",
                        "force_new_signature": 1,
                        "last_name": "last_name",
                        "order": 1,
                        "prefill_signature_name": "test prefill_signature_name",
                        "redirect_uri": "https://www.youtube.com/",
                        "role_id": "{{role_id}}",
                        "signing_instructions": "test signing_instruction"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      },
