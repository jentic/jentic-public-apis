          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_timestamp": {
                    "type": "string",
                    "example": "UTC time stamp"
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field_name1": {
                          "type": "string",
                          "example": "value1"
                        },
                        "field_name2": {
                          "type": "string",
                          "example": "value2"
                        }
                      }
                    },
                    "example": [
                      {
                        "field_name1": "value1"
                      },
                      {
                        "field_name2": "value2"
                      }
                    ]
                  }
                }
              },
              "examples": {
                "Prefill smart fields": {
                  "value": {
                    "client_timestamp": "UTC time stamp",
                    "data": [
                      {
                        "field_name1": "value1"
                      },
                      {
                        "field_name2": "value2"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      },
      "parameters": [
        {
          "name": "document_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
