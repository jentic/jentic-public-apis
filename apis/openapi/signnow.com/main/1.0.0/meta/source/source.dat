      "post": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Authentication",
        "description": "Authentication",
        "operationId": "authentication",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "password"
                  },
                  "password": {
                    "type": "string",
                    "example": "{{password}}"
                  },
                  "scope": {
                    "type": "string",
                    "example": "*"
                  },
                  "username": {
                    "type": "string",
                    "example": "{{user}}"
                  }
                }
              },
              "examples": {
                "1. Authentication": {
                  "value": {
                    "grant_type": "password",
                    "password": "{{password}}",
                    "username": "{{user}}"
                  }
                },
                "1. Authorization": {
                  "value": {
                    "grant_type": "password",
                    "password": "{{password}}",
                    "username": "{{user}}"
                  }
                },
                "Authentication": {
                  "value": {
                    "grant_type": "password",
                    "password": "{{password}}",
                    "scope": "*",
                    "username": "{{user}}"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiration_time": {
                    "type": "string",
                    "example": "604800"
                  },
                  "grant_type": {
                    "type": "string",
                    "example": "password"
                  },
                  "password": {
                    "type": "string",
                    "example": "{{password}}"
                  },
                  "scope": {
                    "type": "string",
                    "example": "*"
                  },
                  "username": {
                    "type": "string",
                    "example": "{{user}}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      }
    },
