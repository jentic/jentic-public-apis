    "/documentgroup/{documentgroup_id}/groupinvite": {
      "post": {
        "tags": [
          "Document Group"
        ],
        "summary": "Group invite",
        "description": "Group invite",
        "operationId": "groupInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "completion_emails": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "disabled": {
                          "type": "number",
                          "example": 0
                        },
                        "email": {
                          "type": "string",
                          "example": "{{signer3}}"
                        },
                        "message": {
                          "type": "string",
                          "example": " message COMPLETED"
                        },
                        "subject": {
                          "type": "string",
                          "example": "COMPLETED subject "
                        }
                      }
                    },
                    "example": [
                      {
                        "disabled": 0,
                        "email": "{{signer3}}",
                        "message": " message COMPLETED",
                        "subject": "COMPLETED subject "
                      }
                    ]
                  },
                  "invite_steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "invite_actions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "action": {
                                "type": "string",
                                "example": "sign"
                              },
                              "allow_reassign": {
                                "type": "number",
                                "example": 0
                              },
                              "authentication": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "example": "password"
                                  },
                                  "value": {
                                    "type": "string",
                                    "example": "abc123"
                                  }
                                }
                              },
                              "document_id": {
                                "type": "string",
                                "example": "{{document_id}}"
                              },
                              "email": {
                                "type": "string",
                                "example": "{{signer1}}"
                              },
                              "role_name": {
                                "type": "string",
                                "example": "role6"
                              }
                            }
                          },
                          "example": [
                            {
                              "action": "sign",
                              "allow_reassign": 0,
                              "authentication": {
                                "type": "password",
                                "value": "abc123"
                              },
                              "document_id": "{{document_id}}",
                              "email": "{{signer1}}",
                              "role_name": "role6"
                            },
                            {
                              "action": "sign",
                              "allow_reassign": 0,
                              "document_id": "{{document_id_1}}",
                              "email": "{{signer3}}",
                              "role_name": "role2"
                            }
                          ]
                        },
                        "invite_emails": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "disabled": {
                                "type": "number",
                                "example": 0
                              },
                              "email": {
                                "type": "string",
                                "example": "{{signer1}}"
                              },
                              "message": {
                                "type": "string",
                                "example": "The message for step1"
                              },
                              "subject": {
