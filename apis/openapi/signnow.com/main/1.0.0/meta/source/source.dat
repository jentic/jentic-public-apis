    "/document/{document_id}/invite": {
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Field Invite",
        "description": "Field Invite",
        "operationId": "fieldInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cc": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "cc_email@gmail.com"
                    },
                    "example": [
                      "cc_email@gmail.com",
                      "abnother_cc@gmail.com"
                    ]
                  },
                  "document_id": {
                    "type": "string",
                    "example": "{{document_id}}"
                  },
                  "from": {
                    "type": "string",
                    "example": "sender@email.com"
                  },
                  "message": {
                    "type": "string",
                    "example": "generic message"
                  },
                  "subject": {
                    "type": "string",
                    "example": "generic subject"
                  },
                  "to": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "authentication_type": {
                          "type": "string",
                          "example": "password"
                        },
                        "decline_by_signature": {
                          "type": "string",
                          "example": "0"
                        },
                        "email": {
                          "type": "string",
                          "example": "signer@signnow.com"
                        },
                        "expiration_days": {
                          "type": "number",
                          "example": 30
                        },
                        "message": {
                          "type": "string",
                          "example": "personalized message"
                        },
                        "order": {
                          "type": "number",
                          "example": 1
                        },
                        "password": {
                          "type": "string",
                          "example": "123456"
                        },
                        "reassign": {
                          "type": "string",
                          "example": "0"
                        },
                        "reminder": {
                          "type": "number",
                          "example": 0
                        },
                        "role": {
                          "type": "string",
                          "example": "Signer 1"
                        },
                        "role_id": {
                          "type": "string",
                          "example": "488d73a3efab032511f144af3a2572a8aae20162"
                        },
                        "subject": {
                          "type": "string",
                          "example": "personalized subject"
                        }
                      }
                    },
                    "example": [
                      {
                        "authentication_type": "password",
                        "decline_by_signature": "0",
                        "email": "signer@signnow.com",
                        "expiration_days": 30,
                        "message": "personalized message",
                        "order": 1,
                        "password": "123456",
                        "reassign": "0",
                        "reminder": 0,
                        "role": "Signer 1",
                        "role_id": "488d73a3efab032511f144af3a2572a8aae20162",
                        "subject": "personalized subject"
                      },
                      {
                        "decline_by_signature": "1",
                        "email": "signer2@signnow.com",
                        "expiration_days": 30,
                        "order": 2,
                        "reassign": "1",
                        "reminder": 0,
                        "role": "Signer 2",
                        "role_id": ""
                      }
                    ]
                  }
                }
              },
              "examples": {
                "3. Send a free form invite": {
                  "value": {
                    "cc": [
                      "{{signer2}}"
                    ],
                    "document_id": "{{document_id}}",
                    "from": "{{user}}",
                    "message": "Message {{$timestamp}}",
                    "on_complete": "document_and_attachments",
                    "subject": "Subj {{$timestamp}}",
                    "to": "{{signer1}}"
                  }
                },
                "Field Invite": {
                  "value": {
                    "cc": [],
                    "document_id": "{{document_id}}",
                    "email": "disabled",
                    "from": "{{user}}",
                    "message": "New message!",
                    "subject": "Field invite with after_reminder",
                    "to": [
                      {
                        "decline_by_signature": "1",
                        "email": "{{signer1}}",
                        "expiration_days": 30,
                        "message": "Field invite Signer1",
                        "order": 1,
                        "reassign": "1",
                        "reminder": 12,
                        "role": "Signer 1",
                        "role_id": "{{role_id_1}}",
                        "subject": "Field invite Signer1"
                      },
                      {
                        "decline_by_signature": "1",
                        "email": "{{signer2}}",
                        "expiration_days": 30,
                        "message": "Field invite Signer1",
                        "order": 2,
                        "reassign": "1",
                        "reminder": 12,
                        "role": "Signer 2",
                        "role_id": "{{role_id_2}}",
                        "subject": "Field invite Signer1"
                      }
                    ]
                  }
                },
                "Send an invite to sign": {
                  "value": {
                    "cc": [
                      "cc_email@gmail.com",
                      "abnother_cc@gmail.com"
                    ],
                    "document_id": "{{document_id}}",
                    "from": "sender@email.com",
                    "message": "generic message",
                    "subject": "generic subject",
                    "to": [
                      {
                        "authentication_type": "password",
                        "decline_by_signature": "0",
                        "email": "signer@signnow.com",
                        "expiration_days": 30,
                        "message": "personalized message",
                        "order": 1,
                        "password": "123456",
                        "reassign": "0",
                        "reminder": 0,
                        "role": "Signer 1",
                        "role_id": "488d73a3efab032511f144af3a2572a8aae20162",
                        "subject": "personalized subject"
                      },
                      {
                        "decline_by_signature": "1",
                        "email": "signer2@signnow.com",
                        "expiration_days": 30,
                        "order": 2,
                        "reassign": "1",
                        "reminder": 0,
                        "role": "Signer 2",
                        "role_id": ""
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      },
