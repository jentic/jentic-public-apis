{
  "openapi": "3.0.0",
  "info": {
    "title": "Vehicle Management System API",
    "version": "1.0.0",
    "description": "This API specification defines the contract for a Vehicle Management System\n(Parking Guidance System) designed for mid-to-large commercial buildings.\n\nThe API surface is intentionally split into:\n1. Vendor-owned, read-only data APIs (sensor occupancy and device health)\n2. Product-owned decision APIs (vehicle verification, parking allocation, lifecycle management)\n\nThis document is intended for:\n- Product review\n- Engineering alignment\n- Vendor integration planning\n- API contract documentation\n\n⚠️ IMPORTANT\nThese are just dummy apis and won't work, it's only for information purspose.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/academicallyglobal/PGSassignement/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vendor-platform.com",
      "description": "Vendor Platform APIs (External, Read-only)"
    },
    {
      "url": "https://api.vehicle-management.internal",
      "description": "Product-Owned APIs (Internal / Mock)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Vendor Occupancy",
      "description": "Vendor-provided per-space occupancy data"
    },
    {
      "name": "Vendor Devices",
      "description": "Vendor-provided sensor and gateway health data"
    },
    {
      "name": "Vehicle Verification",
      "description": "Vehicle entry validation and guest handling"
    },
    {
      "name": "Parking Allocation",
      "description": "Parking availability, allocation, and release logic"
    },
    {
      "name": "Vehicle Events",
      "description": "Entry and exit lifecycle events"
    },
    {
      "name": "Admin Configuration",
      "description": "Parking layout and rule configuration"
    },
    {
      "name": "Admin Monitoring",
      "description": "Health, analytics, and reporting APIs"
    },
    {
      "name": "Interfaces",
      "description": "Data APIs for entry displays and wayfinding systems"
    },
    {
      "name": "UI Data",
      "description": "APIs powering admin and operations dashboards"
    }
  ],
  "paths": {
    "/vehicle/verify": {
      "post": {
        "tags": [
          "Vehicle Verification"
        ],
        "operationId": "verifyVehicle",
        "summary": "Verify vehicle entry and determine access status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleVerificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle verification response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleVerificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/guest/register": {
      "post": {
        "tags": [
          "Vehicle Verification"
        ],
        "operationId": "registerGuestVehicle",
        "summary": "Register a guest vehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestVehicleRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest vehicle registration response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestVehicleRegistrationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parking/allocate": {
      "post": {
        "tags": [
          "Parking Allocation"
        ],
        "operationId": "allocateParking",
        "summary": "Allocate a parking spot to a vehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingAllocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parking allocation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingAllocationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parking/availability": {
      "get": {
        "tags": [
          "Parking Allocation"
        ],
        "operationId": "getParkingAvailability",
        "summary": "Get current parking availability status",
        "responses": {
          "200": {
            "description": "Parking availability data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingAvailability"
                }
              }
            }
          }
        }
      }
    },
    "/parking/release": {
      "post": {
        "tags": [
          "Parking Allocation"
        ],
        "operationId": "releaseParking",
        "summary": "Release a parking spot for a vehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parking release acknowledged"
          }
        }
      }
    },
    "/vendor/occupancy": {
      "get": {
        "tags": [
          "Vendor Occupancy"
        ],
        "operationId": "getOccupancyData",
        "summary": "Get per-space occupancy data from vendor sensors",
        "responses": {
          "200": {
            "description": "List of occupancy data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OccupancyData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/sensors/health": {
      "get": {
        "tags": [
          "Vendor Devices"
        ],
        "operationId": "getSensorHealth",
        "summary": "Get health status of sensors",
        "responses": {
          "200": {
            "description": "List of sensor health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensorHealth"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/gateways/health": {
      "get": {
        "tags": [
          "Vendor Devices"
        ],
        "operationId": "getGatewayHealth",
        "summary": "Get health status of gateways",
        "responses": {
          "200": {
            "description": "List of gateway health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GatewayHealth"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/sensors/metadata": {
      "get": {
        "tags": [
          "Vendor Devices"
        ],
        "operationId": "getSensorMetadata",
        "summary": "Get metadata for sensors",
        "responses": {
          "200": {
            "description": "List of sensor metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensorMetadata"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/entry": {
      "post": {
        "tags": [
          "Vehicle Events"
        ],
        "operationId": "recordVehicleEntry",
        "summary": "Record a vehicle entry event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleEntryEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle entry event recorded"
          }
        }
      }
    },
    "/events/exit": {
      "post": {
        "tags": [
          "Vehicle Events"
        ],
        "operationId": "recordVehicleExit",
        "summary": "Record a vehicle exit event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleExitEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle exit event recorded"
          }
        }
      }
    },
    "/admin/parking/layout": {
      "get": {
        "tags": [
          "Admin Configuration"
        ],
        "operationId": "getParkingLayout",
        "summary": "Get parking layout configuration",
        "responses": {
          "200": {
            "description": "Parking layout configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingLayoutConfiguration"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Admin Configuration"
        ],
        "operationId": "updateParkingLayout",
        "summary": "Update parking layout configuration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingLayoutConfiguration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parking layout updated"
          }
        }
      }
    },
    "/admin/parking/rules": {
      "get": {
        "tags": [
          "Admin Configuration"
        ],
        "operationId": "getParkingRules",
        "summary": "Get parking rules configuration",
        "responses": {
          "200": {
            "description": "Parking rules configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingRulesConfiguration"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Admin Configuration"
        ],
        "operationId": "updateParkingRules",
        "summary": "Update parking rules configuration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingRulesConfiguration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parking rules updated"
          }
        }
      }
    },
    "/admin/monitoring/health": {
      "get": {
        "tags": [
          "Admin Monitoring"
        ],
        "operationId": "getSystemHealthOverview",
        "summary": "Get system health overview",
        "responses": {
          "200": {
            "description": "System health overview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemHealthOverview"
                }
              }
            }
          }
        }
      }
    },
    "/admin/monitoring/usage-report": {
      "get": {
        "tags": [
          "Admin Monitoring"
        ],
        "operationId": "getParkingUsageReport",
        "summary": "Get parking usage report",
        "responses": {
          "200": {
            "description": "Parking usage report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingUsageReport"
                }
              }
            }
          }
        }
      }
    },
    "/interfaces/entry-display": {
      "get": {
        "tags": [
          "Interfaces"
        ],
        "operationId": "getEntryDisplayData",
        "summary": "Get data for entry displays",
        "responses": {
          "200": {
            "description": "Entry display data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryDisplayData"
                }
              }
            }
          }
        }
      }
    },
    "/interfaces/wayfinding-map": {
      "get": {
        "tags": [
          "Interfaces"
        ],
        "operationId": "getWayfindingMap",
        "summary": "Get wayfinding map data",
        "responses": {
          "200": {
            "description": "Wayfinding map data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WayfindingMap"
                }
              }
            }
          }
        }
      }
    },
    "/ui/live-occupancy": {
      "get": {
        "tags": [
          "UI Data"
        ],
        "operationId": "getLiveOccupancyView",
        "summary": "Get live occupancy view data",
        "responses": {
          "200": {
            "description": "Live occupancy data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LiveOccupancyView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ui/mis-parking-incidents": {
      "get": {
        "tags": [
          "UI Data"
        ],
        "operationId": "getMisParkingIncidents",
        "summary": "Get mis-parking incidents",
        "responses": {
          "200": {
            "description": "List of mis-parking incidents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MisParkingIncident"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "VehicleVerificationRequest": {
        "type": "object",
        "required": [
          "vehicleNumber",
          "entryPointId"
        ],
        "properties": {
          "vehicleNumber": {
            "type": "string",
            "example": "KA01AB1234"
          },
          "entryPointId": {
            "type": "string",
            "example": "GATE_A"
          },
          "vehicleType": {
            "type": "string",
            "enum": [
              "CAR",
              "TWO_WHEELER"
            ]
          }
        }
      },
      "VehicleVerificationResponse": {
        "type": "object",
        "properties": {
          "verificationStatus": {
            "type": "string",
            "enum": [
              "APPROVED",
              "DENIED",
              "GUEST_REQUIRED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "requiresGuestRegistration": {
            "type": "boolean"
          }
        }
      },
      "GuestVehicleRegistrationRequest": {
        "type": "object",
        "required": [
          "vehicleNumber"
        ],
        "properties": {
          "vehicleNumber": {
            "type": "string"
          },
          "visitorName": {
            "type": "string"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GuestVehicleRegistrationResponse": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "REGISTERED"
          }
        }
      },
      "ParkingAllocationRequest": {
        "type": "object",
        "required": [
          "vehicleId"
        ],
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "entryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ParkingAllocationResponse": {
        "type": "object",
        "properties": {
          "allocationId": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "parkingSpotId": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          },
          "guidanceText": {
            "type": "string",
            "example": "Proceed to Basement B2, Spots 20–30"
          },
          "allocationTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ParkingAvailability": {
        "type": "object",
        "properties": {
          "totalSpots": {
            "type": "integer"
          },
          "availableSpots": {
            "type": "integer"
          },
          "unavailableSpots": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "LIMITED",
              "FULL"
            ]
          }
        }
      },
      "ParkingReleaseRequest": {
        "type": "object",
        "required": [
          "vehicleId"
        ],
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "exitTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OccupancyData": {
        "type": "object",
        "properties": {
          "spotId": {
            "type": "string"
          },
          "occupied": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SensorHealth": {
        "type": "object",
        "properties": {
          "sensorId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DEGRADED",
              "OFFLINE"
            ]
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GatewayHealth": {
        "type": "object",
        "properties": {
          "gatewayId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lastHeartbeat": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SensorMetadata": {
        "type": "object",
        "properties": {
          "sensorId": {
            "type": "string"
          },
          "spotId": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          }
        }
      },
      "VehicleEntryEvent": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "entryTime": {
            "type": "string",
            "format": "date-time"
          },
          "gateId": {
            "type": "string"
          }
        }
      },
      "VehicleExitEvent": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "exitTime": {
            "type": "string",
            "format": "date-time"
          },
          "gateId": {
            "type": "string"
          }
        }
      },
      "ParkingLayoutConfiguration": {
        "type": "object",
        "properties": {
          "buildingId": {
            "type": "string"
          },
          "spots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParkingSpot"
            }
          }
        }
      },
      "ParkingSpot": {
        "type": "object",
        "properties": {
          "spotId": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CAR",
              "TWO_WHEELER"
            ]
          }
        }
      },
      "ParkingRulesConfiguration": {
        "type": "object",
        "properties": {
          "ruleSetId": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParkingRule"
            }
          }
        }
      },
      "ParkingRule": {
        "type": "object",
        "properties": {
          "ruleType": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SystemHealthOverview": {
        "type": "object",
        "properties": {
          "sensorsOnline": {
            "type": "integer"
          },
          "gatewaysOnline": {
            "type": "integer"
          },
          "backendStatus": {
            "type": "string"
          }
        }
      },
      "ParkingUsageReport": {
        "type": "object",
        "properties": {
          "peakHourUtilization": {
            "type": "number"
          },
          "averageSearchTimeSeconds": {
            "type": "integer"
          }
        }
      },
      "EntryDisplayData": {
        "type": "object",
        "properties": {
          "availabilityStatus": {
            "type": "string"
          },
          "guidanceMessage": {
            "type": "string"
          }
        }
      },
      "WayfindingMap": {
        "type": "object",
        "properties": {
          "floor": {
            "type": "string"
          },
          "ranges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WayfindingMapping"
            }
          }
        }
      },
      "WayfindingMapping": {
        "type": "object",
        "properties": {
          "rangeLabel": {
            "type": "string"
          },
          "directionHint": {
            "type": "string"
          }
        }
      },
      "LiveOccupancyView": {
        "type": "object",
        "properties": {
          "spotId": {
            "type": "string"
          },
          "occupied": {
            "type": "boolean"
          }
        }
      },
      "MisParkingIncident": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "expectedSpot": {
            "type": "string"
          },
          "actualSpot": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
