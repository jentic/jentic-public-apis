                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "stripeSPT": []
          }
        ]
      }
    },
    "/v1/research/chat": {
      "post": {
        "summary": "Research chat turn",
        "description": "Persist chat state and get next turn response.\n\nPrice: $1.50 (billed as research_chat)",
        "operationId": "research_chat_turn",
        "x-fodda-price-usd": 1.5,
        "x-fodda-billing-type": "research_chat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "message"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "stripeSPT": []
          }
        ]
      }
    },
    "/v1/research/stream": {
      "get": {
        "summary": "Streaming research search",
