    "/v1/human-agents/consult": {
      "post": {
        "summary": "Consult Human Agent digital twin",
        "description": "Consult an authorized living industry figure's digital twin with grounded graph evidence.\n\nPrice: $2.50 (billed as human_agent_consult)",
        "operationId": "consult_human_agent",
        "x-fodda-price-usd": 2.5,
        "x-fodda-billing-type": "human_agent_consult",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "analyst_id",
                  "query"
                ],
                "properties": {
                  "analyst_id": {
                    "type": "string",
                    "description": "Human agent ID (e.g. piers-fawkes, ben-dietz)"
                  },
                  "query": {
                    "type": "string",
                    "description": "Question or research brief"
                  },
                  "session_id": {
                    "type": "string",
                    "description": "Optional thread ID to continue multi-turn consultation"
                  },
                  "deep": {
                    "type": "boolean",
                    "description": "Trigger deep background homework mode"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consultation answer with sources and next moves",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "stripeSPT": []
          }
        ]
      }
    },
