    "/v1/catalog.okf": {
      "get": {
        "summary": "Download Open Knowledge Format bundle",
        "description": "Full machine-readable Open Knowledge Format bundle (.tar.gz or JSON format) mapping the 250+ knowledge graph catalog for autonomous agents.\n\nPrice: Free ($0)",
        "operationId": "get_catalog_okf",
        "x-fodda-price-usd": 0,
        "x-fodda-billing-type": "free",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "tar.gz",
                "json"
              ],
              "default": "tar.gz"
            },
            "description": "Output format: tar.gz (default) or json"
          }
        ],
        "responses": {
          "200": {
            "description": "OKF bundle payload or archive",
            "content": {
              "application/gzip": {},
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/experts/search": {
      "get": {
        "summary": "Search expert and analyst roster",
        "description": "Search 4,150+ specialist roster by query, returning ranked candidate experts with match rationale.\n\nPrice: Free ($0)",
        "operationId": "search_experts_roster",
        "x-fodda-price-usd": 0,
        "x-fodda-billing-type": "free",
        "parameters": [
          {
            "name": "q",
            "in": "query",
