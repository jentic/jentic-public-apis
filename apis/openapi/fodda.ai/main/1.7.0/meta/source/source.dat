                  },
                  "graph_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Target knowledge graphs"
                  },
                  "include_briefing": {
                    "type": "boolean",
                    "description": "Whether to include an executive editorial narrative"
                  }
                }
