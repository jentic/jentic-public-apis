    "/api/token": {
      "post": {
        "summary": "login",
        "description": "login",
        "operationId": "login",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "password"
                  },
                  "hostName": {
                    "type": "string",
                    "example": ""
                  },
                  "iPAddress": {
                    "type": "string",
                    "example": ""
                  },
                  "isOverrideExistingSession": {
                    "type": "string",
                    "example": "false"
                  },
                  "location": {
                    "type": "string",
                    "example": ""
                  },
                  "mACAddress": {
                    "type": "string",
                    "example": ""
                  },
                  "organisation": {
                    "type": "string",
                    "example": ""
                  },
                  "password": {
                    "type": "string",
                    "example": "ChakDeIndia"
                  },
                  "postalAddress": {
                    "type": "string",
                    "example": ""
                  },
                  "userCity": {
                    "type": "string",
                    "example": ""
                  },
                  "userCountry": {
                    "type": "string",
                    "example": ""
                  },
                  "userRegion": {
                    "type": "string",
                    "example": ""
                  },
                  "username": {
                    "type": "string",
                    "example": "abhishek@vskout.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
