  "paths": {
    "/spoe/api/Doc/AddUpdateLeasePartiesS2": {
      "post": {
        "summary": "BulkPartiesUpload",
        "description": "BulkPartiesUpload",
        "operationId": "bulkpartiesupload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "example": "{{assetId}}"
                  },
                  "assetType": {
                    "type": "string",
                    "example": "1"
                  },
                  "cityId": {
                    "type": "string",
                    "example": "GGN"
                  },
                  "documentId": {
                    "type": "string",
                    "example": "{{documentId}}"
                  },
                  "firstParties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "Incuspaze|gurugram|||||false||||||||"
                    },
                    "example": [
                      "Incuspaze|gurugram|||||false||||||||"
                    ]
                  },
                  "isFlag": {
                    "type": "string",
                    "example": "0"
                  },
                  "leaseId": {
                    "type": "string",
                    "example": "LEASE-1579"
                  },
                  "partiesId": {
                    "type": "string",
                    "example": "PARTY-796"
                  },
                  "secondParties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "{{Client Name as per GST/Legal Entity}}|gurugram|||||false||||||||"
                    },
                    "example": [
                      "{{Client Name as per GST/Legal Entity}}|gurugram|||||false||||||||"
                    ]
                  },
                  "unitId": {
                    "type": "string",
                    "example": "{{unitId}}"
                  }
                }
              },
              "examples": {
                "BulkPartiesUpload": {
                  "value": {
                    "assetId": "{{assetId}}",
                    "assetType": "1",
                    "cityId": "GGN",
                    "documentId": "{{documentId}}",
                    "firstParties": [
                      "Incuspaze|gurugram|||||false||||||||"
                    ],
                    "isFlag": "0",
                    "leaseId": "LEASE-1579",
                    "partiesId": "PARTY-796",
                    "secondParties": [
                      "{{Client Name as per GST/Legal Entity}}|gurugram|||||false||||||||"
                    ],
                    "unitId": "{{unitId}}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
