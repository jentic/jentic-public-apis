      },
      "activity-id": {
        "description": "Unique alphanumeric ID generated by the consumer of the API which is unique for each order request. This is used to track end-to-end journey of order life cycle.",
        "in": "header",
        "name": "activity-id",
        "required": true,
        "example": "c34e7acd-384b-4c22-8b02-ba3963682508",
        "schema": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "interaction-id": {
        "description": "Unique alphanumeric ID generated by the consumer of the API which could be unique/same depending on the use-case. Eg :- Multiple orders created form UI in one session, can have same interaction-id.",
        "in": "header",
        "name": "interaction-id",
        "required": false,
        "example": "cc688d54-50d1-49d4-8c5d-95459d1172e8",
        "schema": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "Authorization": {
        "name": "Authorization",
        "in": "header",
        "description": "OAuth 2.0 access token with the authentication type set as Bearer.",
        "required": true,
        "schema": {
          "pattern": "^[\\S ]+$",
          "type": "string"
        },
        "example": "Bearer mF_9.B5f-4.1JqM"
      },
      "x-authorization": {
        "description": "Proof of Possession POP token, signed JWT object using client Private Key",
        "in": "header",
        "name": "x-authorization",
        "required": false,
        "example": "c34e7acd-384b-4c22-8b02-ba3963682508",
        "schema": {
          "pattern": "^[\\S ]*$",
          "type": "string"
        }
      },
      "x-auth-originator": {
        "description": "OAuth 2.0 access token (id token)",
        "in": "header",
        "name": "x-auth-originator",
        "required": false,
        "example": "c34e7acd-384b-4c22-8b02-ba3963682508",
        "schema": {
          "pattern": "^[\\S]*$",
          "type": "string"
        }
      },
      "sender-id": {
        "name": "sender-id",
        "in": "header",
        "description": "The related business partner or T-Mobile organization",
        "example": "QVXP",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "channel-id": {
        "name": "channel-id",
        "in": "header",
        "description": "Categorization of access or business stream",
        "example": "IVR",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "Date": {
        "name": "Date",
        "in": "header",
        "description": "The Date general HTTP header contains the date and time at which the message was originated.",
        "example": "Mon, 05 Mar 2018 16:38:08 GMT",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "If-Unmodified-Since": {
        "name": "If-Unmodified-Since",
        "in": "header",
        "description": "The If-Unmodified-Since request-header field is used with a method to make it conditional. If the requested resource has not been modified since the time specified in this field, the server SHOULD perform the requested operation as if the If-Unmodified-Since header were not present.If the requested variant has been modified since the specified time, the server MUST NOT perform the requested operation, and MUST return a 412 (Precondition Failed).",
        "example": "Mon, 05 Mar 2018 16:38:08 GMT",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "Prefer": {
        "name": "Prefer",
        "in": "header",
        "description": "The Prefer request-header field is used to indicate that particular server behaviors are preferred by the client, but not required for successful completion of the request. Prefer is similar in nature to the Expect header field defined by Section 9.3 of [I-D.ietf-httpbis-p2-semantics] with the exception that servers are allowed to ignore stated preferences.",
        "example": "token",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S ]*$"
        }
      },
      "service-transaction-id": {
        "name": "service-transaction-id",
        "in": "header",
        "description": "Request ID echoed back by server",
        "example": "23409209723",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "session-id": {
        "name": "session-id",
        "in": "header",
        "description": "A value populated by the sender used  to track the transactions that occur during a session, a long-lasting interaction that ismaintained by the sender.",
        "example": "350b91ec-4a64-4b10-a3f3-a78c8db3924a",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "If-Match": {
        "name": "If-Match",
        "in": "header",
        "description": "The If-Match header specifies an ETag-related condition to be placed on the execution of a request.  The request will only be executed if the ETag of the requested resource matches one of those specified in the If-Match header.  Because the behavior is complex, the details for usage are provided at http://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html .",
        "example": "*",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "timestamp": {
        "name": "timestamp",
        "in": "header",
        "description": "ms since 1/1/70 adjusted to GMT",
        "example": "1524599536",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "application-id": {
        "name": "application-id",
        "in": "header",
        "description": "Uniquely identifies the originating application for the order",
        "required": false,
        "example": "DIGITAL",
        "schema": {
          "pattern": "^[\\S ]{3,32}$",
          "type": "string"
        }
      },
      "workflow-id": {
        "name": "workflow-id",
        "description": "Business Use Case",
        "required": false,
        "in": "header",
        "example": "ACTIVATION",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S]*$"
        }
      },
      "origin-application-id": {
        "name": "origin-application-id",
        "in": "header",
        "description": "Unique code to identify the dealer/rep user.",
        "example": "34234322",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S ]*$"
        }
      },
      "sub-workflow-id": {
        "name": "sub-workflow-id",
        "in": "header",
        "description": "Unique code to identify the dealer/rep user.",
        "example": "34234322",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\S ]*$"
        }
      }
    },
    "schemas": {
      "StatusCountRequest": {
        "type": "object",
        "required": [
          "financialAccountNumbers"
        ],
        "description": "financial Account Numbers",
        "properties": {
          "financialAccountNumbers": {
            "description": "List of Financial Account Number",
            "type": "array",
            "items": {
              "type": "string",
              "example": "123456",
              "description": "financial Account",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^(\\d{9})$"
            }
          },
          "solutionType": {
            "type": "string",
            "description": "solution Type for which status needs to be fetched. Valid Values for the same SASE, WIRELESS, IOT, GSM",
            "minLength": 0,
            "maxLength": 256
          }
        }
      },
      "StatusCountResponse": {
        "type": "object",
        "description": "financial Account Numbers",
        "properties": {
          "statusCountDetails": {
            "description": "List of Status Count Array",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusCountDetails"
            }
          }
        }
      },
      "LineStatusCountRequest": {
        "type": "object",
        "required": [
          "financialAccountNumbers"
        ],
        "description": "Request body for lines status count.",
        "properties": {
          "financialAccountNumbers": {
            "description": "List of Financial Account Number",
            "type": "array",
            "items": {
              "type": "string",
              "example": "123456",
              "description": "Financial Account Number",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^(\\d{9})$"
            }
          },
          "solutionType": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Solution Type for which status needs to be fetched. Valid Values for the same SASE, WIRELESS, IOT, GSM",
              "minLength": 0,
              "maxLength": 256
            }
          },
          "partner": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Partner type for each solution type",
              "example": "GSM",
              "minLength": 0,
              "maxLength": 256
            }
          },
          "aggregatedResponse": {
            "type": "boolean",
            "description": "To see if the response is aggregated or not.",
            "default": true,
            "example": true
          }
        }
      },
      "LineStatusCountResponse": {
        "type": "object",
        "description": "Response object.",
        "properties": {
          "lineDetails": {
            "description": "List of Status Count Array",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineDetails"
            }
          }
        }
      },
      "ConnectivityCountRequest": {
        "type": "object",
        "required": [
          "financialAccountNumbers"
        ],
        "description": "financial Account Numbers",
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "List of financial Account Number",
            "items": {
              "type": "string",
              "example": "123456789",
              "description": "financial Account Number",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^(\\d{9})$"
            }
          },
          "solutionType": {
            "type": "string",
            "example": "IOT",
            "description": "solution Type for which status needs to be fetched. Valid Values for the same SASE, WIRELESS, IOT, GSM",
            "minLength": 0,
            "maxLength": 256
          }
        }
      },
      "ConnectivityCountResponse": {
        "type": "object",
        "description": "financial Account Numbers",
        "properties": {
          "connectivityCountDetails": {
            "type": "array",
            "description": "List of Connectivity Response",
            "items": {
              "$ref": "#/components/schemas/StatusCountDetails"
            }
          }
        }
      },
      "LineConnectivityCountRequest": {
        "type": "object",
        "required": [
          "financialAccountNumbers"
        ],
        "description": "financial Account Numbers",
        "properties": {
          "financialAccountNumbers": {
            "description": "List of Financial Account Number",
            "type": "array",
            "items": {
              "type": "string",
              "example": "123456",
              "description": "financial Account",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^(\\d{9})$"
            }
          },
          "solutionType": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "solution Type for which status needs to be fetched. Valid Values for the same SASE, WIRELESS, IOT, GSM",
              "minLength": 0,
              "maxLength": 256
            }
          },
          "partner": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "partner type for each solution type",
              "example": "GSM",
              "minLength": 0,
              "maxLength": 256
            }
          },
          "aggregatedResponse": {
            "type": "boolean",
            "description": "To see if the response is aggregated or not.",
            "default": true,
            "example": true
          }
        }
      },
      "LineConnectivityCountResponse": {
        "type": "object",
        "description": "financial Account Numbers",
        "properties": {
          "lineDetails": {
            "description": "List of Status Count Array",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineDetails"
            }
          }
        }
      },
      "StatusCountDetails": {
        "type": "object",
        "properties": {
          "solutionType": {
            "type": "string",
            "example": "IOT",
            "description": "This field indicats the type of product is being fetched.",
            "minLength": 0,
            "maxLength": 256
          },
          "countPerSolution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountPerProduct"
            },
            "description": "The response of values of simconnectivity count and update time"
          }
        }
      },
      "LineDetails": {
        "type": "object",
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "List of financial Account Number",
            "items": {
              "type": "string",
              "example": "123456789",
              "description": "financial Account Number",
              "minLength": 9,
              "maxLength": 9,
              "pattern": "^(\\d{9})$"
            }
          },
          "solutionData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SolutionData"
            },
            "description": "The response of values of simconnectivity count and update time"
          }
        }
      },
      "SolutionData": {
        "type": "object",
        "properties": {
          "solutionType": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "GSM"
            }
          },
          "partnerData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartnerData"
            }
          }
        }
      },
      "PartnerData": {
        "type": "object",
        "properties": {
          "partner": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "GSM"
            }
          },
          "counts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Counts"
            }
          },
          "updateDateTime": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16,
            "description": "update time of sim connection",
            "example": "2022-04-22 10:34:53-07:00"
          },
          "totalDeviceCount": {
            "type": "integer",
            "description": "total device count",
            "nullable": true,
            "example": 200
          }
        }
      },
      "CountPerProduct": {
        "type": "object",
        "description": "Sim connectivity and status response",
        "properties": {
          "financialAccountNumber": {
            "type": "string",
            "description": "Financial Number",
            "example": 12345678,
            "minLength": 9,
            "maxLength": 9,
            "pattern": "^(\\d{9})$"
          },
          "counts": {
            "type": "array",
            "description": "Array of simcount to have count against each status",
            "items": {
              "$ref": "#/components/schemas/Counts"
            }
          },
          "updateDateTime": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16,
            "description": "update time of sim connection",
            "example": 12345678
          }
        }
      },
      "Counts": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Active",
            "description": "The status of device with above FiancialAccount as Active/Suspended/Cancelled/Connected/Disconnected",
            "maxLength": 256
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "example": 200,
            "description": "The count of connections with this status"
          }
        }
      },
      "DevicesInfoRequest": {
        "type": "object",
        "required": [
          "financialAccountNumbers"
        ],
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "array of bans",
            "items": {
              "type": "string",
              "example": "987969798",
              "minLength": 1,
              "maxLength": 9,
              "description": "value of a ban"
            }
          },
          "solutionType": {
            "type": "array",
            "description": "array of solution type, the valid values could be GSM.",
            "items": {
              "type": "string",
              "example": "GSM",
              "description": "value of solution type."
            }
          },
          "partner": {
            "type": "array",
            "description": "array of partner, the valid values could be GSM.",
            "items": {
              "type": "string",
              "example": "T-Mobile",
              "description": "value of partner."
            }
          },
          "aggregatedResponse": {
            "type": "boolean",
            "example": true,
            "description": "flag for aggregation requirement."
          }
        }
      },
      "DevicesInfoResponse": {
        "type": "object",
        "properties": {
          "deviceInfoDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceDetails"
            }
          }
        }
      },
      "DeviceDetails": {
        "type": "object",
        "description": "Details of device",
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "array of bans",
            "items": {
              "type": "string",
              "example": "987969798",
              "minLength": 1,
              "maxLength": 9,
              "description": "value of a ban"
            }
          },
          "solutionData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SolutionDetails"
            }
          }
        }
      },
      "SolutionDetails": {
        "type": "object",
        "description": "solution details",
        "properties": {
          "solutionType": {
            "type": "array",
            "description": "array of solution type, the valid values could be GSM.",
            "items": {
              "type": "string",
              "example": "GSM",
              "description": "value of solution type."
            }
          },
          "partnerData": {
            "type": "array",
            "description": "partner data details.",
            "items": {
              "$ref": "#/components/schemas/PartnerDetails"
            }
          }
        }
      },
      "PartnerDetails": {
        "type": "object",
        "description": "solution details",
        "properties": {
          "partner": {
            "type": "array",
            "description": "array of partner, the valid values could be GSM.",
            "items": {
              "type": "string",
              "example": "T-Mobile",
              "description": "value of partner."
            }
          },
          "deviceDetails": {
            "type": "object",
            "description": "device type details.",
            "properties": {
              "updateTime": {
                "type": "string",
                "description": "update timestamp",
                "example": "2022-03-01T13:00:00Z"
              },
              "deviceTypeList": {
                "type": "array",
                "description": "Device type details",
                "items": {
                  "$ref": "#/components/schemas/DeviceTypeDetails"
                }
              },
              "othersDeviceTypeList": {
                "type": "array",
                "description": "Other device type details.",
                "items": {
                  "$ref": "#/components/schemas/OthersDeviceTypeDetails"
                }
              },
              "deviceModelsList": {
                "type": "array",
                "description": "List of device models with their counts and percentages",
                "items": {
                  "$ref": "#/components/schemas/DeviceModel"
                }
              },
              "deviceManufacturersList": {
                "type": "array",
                "description": "List of device manufacturers with their counts and percentages",
                "items": {
                  "$ref": "#/components/schemas/DeviceManufacturer"
                }
              }
            }
          }
        }
      },
      "DeviceTypeDetails": {
        "type": "object",
        "description": "Device type details",
        "properties": {
          "deviceTypeGroup": {
            "type": "string",
            "example": "Other",
            "description": "device type group"
          },
          "deviceTypeGroupCount": {
            "description": "device type group count",
            "type": "number",
            "example": 90000
          },
          "percentage": {
            "type": "number",
            "description": "Percentage of device type",
            "example": 10
          }
        }
      },
      "OthersDeviceTypeDetails": {
        "type": "object",
        "description": "Other device type details.",
        "properties": {
          "deviceType": {
            "description": "Device type",
            "type": "string",
            "example": "Connected Car"
          },
          "deviceTypeCount": {
            "type": "number",
            "description": "Device type count",
            "example": 1000
          },
          "percentage": {
            "type": "number",
            "description": "Percentage of device type",
            "example": 10
          }
        }
      },
      "DeviceModel": {
        "type": "object",
        "description": "Device model details",
        "properties": {
          "model": {
            "type": "string",
            "description": "Device model name",
            "example": "Apple Iphone 16"
          },
          "count": {
            "type": "number",
            "description": "Count of devices with this model",
            "example": 90000
          },
          "percentage": {
            "type": "number",
            "description": "Percentage of devices with this model",
            "example": 10
          }
        }
      },
      "DeviceManufacturer": {
        "type": "object",
        "description": "Device manufacturer details",
        "properties": {
          "manufacturer": {
            "type": "string",
            "description": "Device manufacturer name",
            "example": "Apple"
          },
          "count": {
            "type": "number",
            "description": "Count of devices from this manufacturer",
            "example": 90000
          },
          "percentage": {
            "type": "number",
            "description": "Percentage of devices from this manufacturer",
            "example": 10
          }
        }
      },
      "LineDeviceDetailsRequest": {
        "type": "object",
        "description": "Request object to retrieve line level device details",
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "Financial Account Number List",
            "items": {
              "type": "string",
              "description": "Financial Account Number",
              "example": "12345678"
            }
          },
          "startDate": {
            "type": "string",
            "description": "Start Date",
            "example": "12/04/2024"
          },
          "endDate": {
            "type": "string",
            "description": "End Date",
            "example": "12/08/2024"
          },
          "solutionType": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "GSM",
              "description": "Solution Type"
            }
          },
          "partner": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Partner",
              "example": "GSM"
            }
          },
          "aggregated": {
            "type": "boolean",
            "description": "Flag for the type response expected",
            "default": true
          },
          "phoneNumber": {
            "type": "string",
            "description": "MSISDN/ Mobile Number",
            "example": 12012066350
          }
        }
      },
      "LineDeviceDetailsResponse": {
        "type": "object",
        "description": "Response object for retrieving line level device details.",
        "properties": {
          "deviceDetails": {
            "type": "array",
            "description": "Array for retrieving line level device details.",
            "items": {
              "$ref": "#/components/schemas/LineDeviceDetails"
            }
          }
        }
      },
      "LineDeviceDetails": {
        "type": "object",
        "description": "Line level device details.",
        "properties": {
          "financialAccountNumbers": {
            "type": "array",
            "description": "array of bans",
            "items": {
              "type": "string",
              "example": "987969798",
