      "Error": {
        "required": [
          "code",
          "userMessage"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\S ]+$",
            "type": "string",
            "description": "A succinct, domain-specific, human-readable text string to identify the type of error for the given status code",
            "example": "ProductNotFound"
          },
          "userMessage": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\S ]+$",
            "type": "string",
            "description": "A human-readable message describing the error.",
            "example": "Failed to find product."
          },
          "systemMessage": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
            "description": "Text that provides a more detailed technical explanation of the error",
            "example": "PRODUCT_NOT_FOUND"
          },
          "detailLink": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
            "description": "link to custom information providing greater detail on error or errors",
            "example": "https://aaa.bbb.ccc/"
          }
        },
        "description": "As defined in https://api-standards.apps.px-npe01.cf.t-mobile.com/http/status-codes/error-response-format/"
      }
    },
