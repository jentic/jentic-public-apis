            "type": "string",
            "description": "Tracking the pages. The string will be encrypted.",
            "example": "[{'tenants': ['Tenant 1'], 'page': 4, 'hasMore': true} ,{'tenants': ['Tenant 2'], 'page': 2, 'hasMore': 'false'} ,{'tenants': ['Tenant 3', 'Tenant 4'], 'page': 4, 'hasMore': 'false'}]"
          },
          "identifier": {
            "$ref": "#/components/schemas/Identifier"
