          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          },
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Repetition criteria deactivated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Repetition criteria deactivated successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/evidences": {
      "post": {
        "tags": [
          "Evidence"
        ],
        "summary": "Upload evidence for a completed task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceStorage"
              },
              "example": {
                "DSC_EVIDENCE_PATH_URL": "https://storage.leveluplife.com/evidence/photo_123.jpg",
                "DSC_HEALTH_DATA_JSON": "{\"steps\": 8500, \"calories\": 320}",
                "FEC_UPLOADED": "2026-03-13T09:15:00"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evidence uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceStorage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "get": {
        "tags": [
          "Evidence"
        ],
        "summary": "List all evidences of a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "List of evidences",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvidenceStorage"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/evidences/{id}": {
      "get": {
        "tags": [
          "Evidence"
        ],
        "summary": "Get a specific evidence by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          },
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceStorage"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Evidence"
        ],
        "summary": "Hard delete an evidence",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          },
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Evidence deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "PathTaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      }
    },
    "schemas": {
      "HabitTask": {
        "type": "object",
        "description": "Representa una tarea concreta dentro de un hábito (LULM_HABIT_TASK)",
        "required": [
          "ID_HABIT",
          "DSC_HABIT_TASK_TITLE",
          "TYPE_HABIT_TASK_DIFFICULTY",
          "TYPE_HABIT_TASK_FREQUENCY",
          "TYPE_COMPLETION_CRITERIA"
        ],
        "properties": {
          "ID_HABIT_TASK": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "ID_HABIT": {
            "type": "integer",
            "example": 3
          },
          "ID_HABIT_DISCIPLINE": {
            "type": "integer",
            "example": 1
          },
          "DSC_HABIT_TASK_TITLE": {
            "type": "string",
            "maxLength": 20,
            "example": "Morning Run"
          },
          "DSC_HABIT_TASK_DESCRIPTION": {
            "type": "string",
            "example": "Run 5km every morning"
          },
          "NUM_HABIT_TASK_XP_VALUE": {
            "type": "integer",
            "example": 50
          },
          "NUM_HABIT_TASK_PERIOD_LENGTH": {
            "type": "integer",
            "example": 7
          },
          "NUM_HABIT_TASK_LONG": {
            "type": "integer",
            "example": 30
          },
          "FEC_HABIT_TASK_START_DATE": {
            "type": "string",
            "format": "date",
            "example": "2026-03-13"
          },
          "STATUS_HABIT_TASK_IS_COMPLETED": {
            "type": "boolean",
            "default": false,
            "readOnly": true
          },
          "STATUS_HABIT_TASK_IS_ACTIVE": {
            "type": "boolean",
            "default": true
          },
          "DSC_HABIT_TASK_WEEK_DAYS": {
            "type": "string",
            "description": "Días de la semana activos, separados por coma",
            "example": "MON,WED,FRI"
          },
          "TYPE_HABIT_TASK_DIFFICULTY": {
            "type": "string",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD",
              "EPIC"
            ],
            "example": "MEDIUM"
          },
          "TYPE_HABIT_TASK_FREQUENCY": {
            "type": "string",
            "enum": [
              "DAILY",
              "WEEKLY",
              "MONTHLY"
            ],
            "example": "DAILY"
          },
          "TYPE_HABIT_TASK_PERIOD_UNIT": {
            "type": "string",
            "enum": [
              "DAYS",
              "WEEKS",
              "MONTHS"
            ],
            "example": "DAYS"
          },
          "TYPE_COMPLETION_CRITERIA": {
            "type": "string",
            "enum": [
              "TIMER",
              "REPETITIONS",
              "EVIDENCE"
            ],
            "example": "REPETITIONS"
          },
          "TYPE_HABIT_TASK_EVIDENCE": {
            "type": "string",
            "enum": [
              "PHOTO",
              "VIDEO",
              "HEALTH_CONNECT"
            ],
            "example": "HEALTH_CONNECT"
          }
        }
      },
      "TimerCriteria": {
        "type": "object",
        "description": "Criterio de completitud por tiempo estilo Pomodoro (LULT_HABIT_TASK_TIMER)",
        "required": [
          "NUM_SECONDS_DEFINED",
          "TYPE_PAUSE_IS_ALLOWED"
        ],
        "properties": {
          "ID_HABIT_TASK_TIMER_CRITERIA": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "ID_HABIT_TASK": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "NUM_SECONDS_DEFINED": {
            "type": "integer",
            "description": "Duración del bloque de trabajo en segundos",
            "example": 1800
          },
          "NUM_SECONDS_LONG": {
            "type": "integer",
            "description": "Duración del descanso largo en segundos",
            "example": 300
          },
          "TYPE_PAUSE_IS_ALLOWED": {
            "type": "boolean",
            "example": true
          },
          "STATUS_TIMER_CRITERIA_IS_ACTIVE": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "RepetitionCriteria": {
        "type": "object",
        "description": "Criterio de completitud por repeticiones (LULT_HABIT_TASK_REPETITIONS)",
        "required": [
          "NUM_REPETITIONS_OBJECTIVE",
          "TYPE_UNITY_MEASUREMENT_UNIT"
        ],
        "properties": {
          "ID_HABIT_TASK_REPETITIONS_CRITERIA": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "ID_HABIT_TASK": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "NUM_REPETITIONS_OBJECTIVE": {
            "type": "integer",
            "example": 15
          },
          "STATUS_IS_PARTIAL_ALLOWED": {
            "type": "boolean",
            "example": true
          },
          "STATUS_REPETITIONS_CRITERIA_IS_ACTIVE": {
            "type": "boolean",
            "default": true
          },
          "TYPE_UNITY_MEASUREMENT_UNIT": {
            "type": "string",
            "enum": [
              "REPS",
              "SERIES",
              "KMS",
              "CALS"
            ],
            "example": "REPS"
          }
        }
      },
      "EvidenceStorage": {
        "type": "object",
        "description": "Evidencia multimedia o de salud de una tarea completada (LULT_HABIT_TASK_EVIDENCE_STORAGE)",
        "required": [
          "FEC_UPLOADED"
        ],
        "properties": {
          "ID_EVIDENCE": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "ID_HABIT_TASK": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "DSC_EVIDENCE_PATH_URL": {
            "type": "string",
            "description": "URL del archivo de evidencia (foto o video)",
            "example": "https://storage.leveluplife.com/evidence/photo_123.jpg"
          },
          "DSC_HEALTH_DATA_JSON": {
            "type": "string",
            "description": "Datos de salud en formato JSON (pasos, calorías, etc.)",
            "example": "{\"steps\": 8500, \"calories\": 320}"
          },
          "FEC_UPLOADED": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-13T09:15:00"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Bad request"
          },
          "details": {
            "type": "string",
            "example": "Invalid input data"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 400,
              "message": "Bad request",
              "details": "Invalid input data"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 404,
              "message": "Resource not found",
              "details": "No resource found with the given id"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 500,
              "message": "Internal server error",
              "details": "Unexpected error occurred"
            }
          }
        }
      }
    }
  }
}
