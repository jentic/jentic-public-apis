          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimerCriteria"
              },
              "example": {
                "NUM_SECONDS_DEFINED": 2400,
                "NUM_SECONDS_LONG": 600,
                "TYPE_PAUSE_IS_ALLOWED": false,
                "STATUS_TIMER_CRITERIA_IS_ACTIVE": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Timer criteria updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimerCriteria"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Timer Criteria"
        ],
        "summary": "Deactivate timer criteria (logical delete)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          },
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Timer criteria deactivated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Timer criteria deactivated successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/repetition-criteria": {
      "post": {
        "tags": [
          "Repetition Criteria"
        ],
        "summary": "Create repetition criteria for a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepetitionCriteria"
              },
              "example": {
                "NUM_REPETITIONS_OBJECTIVE": 15,
                "STATUS_IS_PARTIAL_ALLOWED": true,
                "STATUS_REPETITIONS_CRITERIA_IS_ACTIVE": true,
                "TYPE_UNITY_MEASUREMENT_UNIT": "REPS"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repetition criteria created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepetitionCriteria"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Repetition criteria already exists for this task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "message": "Conflict",
                  "details": "Repetition criteria already exists for this task"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "get": {
        "tags": [
          "Repetition Criteria"
        ],
        "summary": "Get repetition criteria of a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "Repetition criteria found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepetitionCriteria"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/repetition-criteria/{id}": {
      "put": {
        "tags": [
          "Repetition Criteria"
        ],
        "summary": "Update repetition criteria",
        "security": [
          {
            "bearerAuth": []
          }
        ],
