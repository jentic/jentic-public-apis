{
  "openapi": "3.0.3",
  "info": {
    "title": "LevelUp Life - Habit Tasks API",
    "version": "1.0.0",
    "description": "Endpoints para gestión de tareas de hábitos y sus criterios de éxito",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/una-0e1/GestionTareasCriterios/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.leveluplife.com/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Habit Tasks"
    },
    {
      "name": "Timer Criteria"
    },
    {
      "name": "Repetition Criteria"
    },
    {
      "name": "Evidence"
    }
  ],
  "paths": {
    "/habit-tasks": {
      "get": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "List all habit tasks with filters",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "habitId",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1
            },
            "required": false
          },
          {
            "name": "disciplineId",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 2
            },
            "required": false
          },
          {
            "name": "difficulty",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD",
                "EPIC"
              ],
              "example": "MEDIUM"
            },
            "required": false
          },
          {
            "name": "frequency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DAILY",
                "WEEKLY",
                "MONTHLY"
              ],
              "example": "DAILY"
            },
            "required": false
          },
          {
            "name": "isActive",
            "in": "query",
            "schema": {
              "type": "boolean",
              "example": true
            },
            "required": false
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "example": 0
            },
            "required": false
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 10
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of habit tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HabitTask"
                      }
                    },
                    "page": {
                      "type": "integer",
                      "example": 0
                    },
                    "size": {
                      "type": "integer",
                      "example": 10
                    },
                    "total": {
                      "type": "integer",
                      "example": 25
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "Create a new habit task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitTask"
              },
              "example": {
                "ID_HABIT": 3,
                "ID_HABIT_DISCIPLINE": 1,
                "DSC_HABIT_TASK_TITLE": "Morning Run",
                "DSC_HABIT_TASK_DESCRIPTION": "Run 5km every morning",
                "NUM_HABIT_TASK_XP_VALUE": 50,
                "NUM_HABIT_TASK_PERIOD_LENGTH": 7,
                "FEC_HABIT_TASK_START_DATE": "2026-03-13",
                "STATUS_HABIT_TASK_IS_ACTIVE": true,
                "DSC_HABIT_TASK_WEEK_DAYS": "MON,WED,FRI",
                "TYPE_HABIT_TASK_DIFFICULTY": "MEDIUM",
                "TYPE_HABIT_TASK_FREQUENCY": "DAILY",
                "TYPE_HABIT_TASK_PERIOD_UNIT": "DAYS",
                "TYPE_COMPLETION_CRITERIA": "REPETITIONS",
                "TYPE_HABIT_TASK_EVIDENCE": "HEALTH_CONNECT"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Habit task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitTask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Habit task already exists for this habit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "message": "Conflict",
                  "details": "Habit task already exists for this habit"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{id}": {
      "get": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "Get a habit task by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Habit task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitTask"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "Update a habit task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitTask"
              },
              "example": {
                "ID_HABIT": 3,
                "ID_HABIT_DISCIPLINE": 1,
                "DSC_HABIT_TASK_TITLE": "Evening Run",
                "DSC_HABIT_TASK_DESCRIPTION": "Run 3km every evening",
                "NUM_HABIT_TASK_XP_VALUE": 30,
                "NUM_HABIT_TASK_PERIOD_LENGTH": 5,
                "FEC_HABIT_TASK_START_DATE": "2026-03-13",
                "STATUS_HABIT_TASK_IS_ACTIVE": true,
                "DSC_HABIT_TASK_WEEK_DAYS": "TUE,THU,SAT",
                "TYPE_HABIT_TASK_DIFFICULTY": "EASY",
                "TYPE_HABIT_TASK_FREQUENCY": "DAILY",
                "TYPE_HABIT_TASK_PERIOD_UNIT": "DAYS",
                "TYPE_COMPLETION_CRITERIA": "TIMER",
                "TYPE_HABIT_TASK_EVIDENCE": "PHOTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Habit task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitTask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "Deactivate a habit task (logical delete)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "Task deactivated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Task deactivated successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{id}/complete": {
      "patch": {
        "tags": [
          "Habit Tasks"
        ],
        "summary": "Mark task as completed and trigger XP and streak logic",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "completedAt"
                ],
                "properties": {
                  "completedAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-03-13T08:30:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task completed, XP and streak updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "xpEarned": {
                      "type": "integer",
                      "example": 50
                    },
                    "newLevel": {
                      "type": "integer",
                      "example": 5
                    },
                    "streakUpdated": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/timer-criteria": {
      "post": {
        "tags": [
          "Timer Criteria"
        ],
        "summary": "Create timer criteria (Pomodoro style) for a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimerCriteria"
              },
              "example": {
                "NUM_SECONDS_DEFINED": 1800,
                "NUM_SECONDS_LONG": 300,
                "TYPE_PAUSE_IS_ALLOWED": true,
                "STATUS_TIMER_CRITERIA_IS_ACTIVE": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Timer criteria created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimerCriteria"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Timer criteria already exists for this task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "message": "Conflict",
                  "details": "Timer criteria already exists for this task"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "get": {
        "tags": [
          "Timer Criteria"
        ],
        "summary": "Get timer criteria of a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "Timer criteria found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimerCriteria"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/habit-tasks/{taskId}/timer-criteria/{id}": {
      "put": {
        "tags": [
          "Timer Criteria"
        ],
        "summary": "Update timer criteria",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathTaskId"
          },
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
