est_id":{"type":"string"}},"additionalProperties":false,"required":["id","rule_id","rule_name","rule_type","advertiser_domain","affiliate_id","status","owner_user_id","owner_email","first_seen_at","last_seen_at","match_count","reopen_count","timeline"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"update_policy_case","summary":"Change a case's status or owner","description":"Sets a case's status (open, investigating, contacted, resolved, dismissed) and/or owner (a member's user id, or null to unassign). Each actual change is added to the timeline; repeating the same values changes nothing. A resolved case reopens by itself when a new matching ad is observed later; a dismissed case stays dismissed. This records your team's follow-up only: it contacts no one. Requires the write scope.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"case_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The case id from list_policy_cases."},"description":"The case id from list_policy_cases."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_policy_case","responses":{"200":{"description":"Change a case's status or owner","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"rule_id":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"null when the rule was deleted; rule_name is kept."},"rule_name":{"type":"string"},"rule_type":{"type":"string","enum":["forbidden_terms","brand_term","direct_linking","promo_code","position_limit","affiliate_id"]},"advertiser_domain":{"type":"string"},"affiliate_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","enum":["open","investigating","contacted","resolved","dismissed"]},"owner_user_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"owner_email":{"anyOf":[{"type":"string"},{"type":"null"}]},"first_seen_at":{"type":"string"},"last_seen_at":{"type":"string"},"match_count":{"type":"integer","description":"Every finding recorded on the case."},"reopen_count":{"type":"integer","description":"Times a new match reopened it after it was resolved."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["id","rule_id","rule_name","rule_type","advertiser_domain","affiliate_id","status","owner_user_id","owner_email","first_seen_at","last_seen_at","match_count","reopen_count"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["open","investigating","contacted","resolved","dismissed"]},"owner_user_id":{"anyOf":[{"type":"string","maxLength":200},{"type":"null"}]}},"additionalProperties":false}}}}}},"/projects/{project_id}/policy-cases/{case_id}/evidence":{"get":{"operationId":"list_policy_case_evidence","summary":"The saved ads that matched a case's rule","description":"Lists the saved ads recorded on a case, newest first, with when and where each was observed (search term, engine, device, operating system, country, location), the ad copy, destination URL and what matched. Check the observation context and matched value as part of human review; a matching saved ad does not establish that a platform policy was violated. A match is a lead to review: an observation shows an ad was displayed for a search at a moment, not proof of a violation, spend or a purchased keyword.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"case_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The case id from list_policy_cases."},"description":"The case id from list_policy_cases."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_policy_case_evidence","responses":{"200":{"description":"The saved ads that matched a case's rule","content":{"application/json":{"schema":{"type":"object","properties":{"total":{"type":"integer"},"data":{"type":"array","items":{"type":"object","properties":{"observed_at":{"type":"string"},"query":{"type":"string"},"engine":{"type":"string","enum":["google","bing"]},"device":{"type":"string","enum":["desktop","mobile"]},"os":{"anyOf":[{"type":"string"},{"type":"null"}]},"country":{"type":"string"},"location":{"anyOf":[{"type":"string"},{"type":"null"}]},"position":{"type":"integer"},"advertiser_domain":{"type":"string"},"title":{"anyOf":[{"type":"string"},{"type":"null"}]},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"display_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"matched":{"type":"string","description":"What matched: terms, a code, a destination host, a position or an affiliate ID."},"paid_results_path":{"type":"string","description":"App path of the saved ads for this advertiser, market and day."},"screenshot":{"anyOf":[{"type":"object","properties":{"id":{"type":"string","description":"Download it over REST from /projects/{project_id}/screenshots/{id}."},"exact":{"type":"boolean","description":"true: the results page this ad was found on. false: only on older pictures, taken from a new load of the same search moments later, which may show different ads."},"captured_at":{"type":"string"},"app_url":{"type":"string","description":"Opens the picture in the app for a signed-in member of the project's account."}},"additionalProperties":false,"required":["id","exact","captured_at","app_url"]},{"type":"null"}],"description":"Picture of the results page where this ad (same domain, title and description) first appeared in the project; null when none was stored. Evidence of that page, not proof of spend."}},"additionalProperties":false,"required":["observed_at","query","engine","device","os","country","location","position","advertiser_domain","title","description","display_url","url","matched","paid_results_path","screenshot"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["total","data","next_cursor"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/policy-cases/{case_id}/notes":{"post":{"operationId":"add_policy_case_note","summary":"Add a note to a case's timeline","description":"Adds a note (up to 4000 characters) to a case's timeline, for example who was contacted and when. Requires the write scope and an idempotency key; a retry with the same key returns the same note instead of adding it twice.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"case_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The case id from list_policy_cases."},"description":"The case id from list_policy_cases."},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"add_policy_case_note","responses":{"201":{"description":"Add a note to a case's timeline","content":{"application/json":{"schema":{"type":"object","properties":{"note_id":{"type":"string"},"created":{"type":"boolean"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["note_id","created"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"note":{"type":"string","minLength":1,"maxLength":4000}},"additionalProperties":false,"required":["note"]}}}}}},"/projects/{project_id}/reports":{"post":{"operationId":"create_report","summary":"Request a project PDF report for a window and filters","description":"Requests a PDF report of a project's saved observations: executive summary with period-over-period change, coverage and methodology, trends, top advertisers with presence and share, new and returning advertisers, brand mentions, affiliate findings, advertiser deep dives, ad copy, Shopping when enabled, and keyword and evidence appendices. Choose comparable windows with the same filters and time zone for a period comparison. It is generated in the background: poll get_report_status, then use get_report_download_link. Idempotent by selection: while a report for the same project, window, time zone and filters is queued, running or ready, the same report is returned (created is false). Each account can create 20 new reports per UTC day. The report states that observations are not proof of spend or infringement; repeat that when you share it. Defaults to the last 30 days.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"create_report","responses":{"202":{"description":"Request a project PDF report for a window and filters","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean","description":"False when an existing report for this selection was returned."},"report":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"type":"string"},"status":{"type":"string","enum":["queued","running","ready","failed","expired"],"description":"queued and running: still generating. ready: download it. failed: see error. expired: the file was deleted; request it again."},"error":{"anyOf":[{"type":"object","properties":{"code":{"type":"string","enum":["too_large","unavailable","generation_failed"]},"message":{"type":"string"}},"additionalProperties":false,"required":["code","message"]},{"type":"null"}]},"window":{"anyOf":[{"type":"object","properties":{"from":{"type":"string"},"to":{"type":"string"},"time_zone":{"type":"string"}},"additionalProperties":false,"required":["from","to","time_zone"]},{"type":"null"}],"description":"The local calendar days the report covers, in its time zone."},"filters":{"type":"object","properties":{"engine":{"type":"array","items":{"type":"string"}},"device":{"type":"array","items":{"type":"string"}},"os":{"type":"array","items":{"type":"string"}},"country":{"type":"array","items":{"type":"string"}},"location":{"type":"array","items":{"type":"string"}}},"additionalProperties":false,"description":"Applied filters by dimension; empty when every observation is included."},"requested_at":{"type":"string"},"completed_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"expires_at":{"type":"string","description":"When a ready report's file is deleted, 7 days after it was generated."},"page_count":{"anyOf":[{"type":"integer"},{"type":"null"}]},"size_bytes":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["id","project_id","status","error","window","filters","requested_at","completed_at","expires_at","page_count","size_bytes"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","report"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"range":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"time_zone":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"engine":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"d