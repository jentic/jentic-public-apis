_id"]},"params":{"type":"object","properties":{"terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":50,"description":"Forbidden words or phrases."},"fields":{"type":"array","items":{"type":"string","enum":["headline","description","display_url"]},"maxItems":3,"description":"Ad parts to check for terms."},"applies_to":{"type":"string","enum":["unauthorized","all_non_owned"]},"authorized_domains":{"type":"array","items":{"type":"string","maxLength":253},"maxItems":50},"extra_terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":20,"description":"Extra brand terms."},"codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50,"description":"Forbidden promo codes."},"any_explicit_code":{"type":"boolean","description":"Also flag any other code written after the word code."},"allowed_codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50},"top_positions":{"type":"integer","minimum":1,"maximum":10},"authorized_ids":{"type":"array","items":{"type":"string","maxLength":256},"maxItems":200}},"additionalProperties":false,"description":"Parameters for the rule type; send only the ones that type uses."},"scope":{"type":"object","properties":{"engine":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"device":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"os":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"country":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"location":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}},"additionalProperties":false,"description":"Observations to check: engine, device, os, country and location, each one value or a list. Omit for every observation."}},"additionalProperties":false,"required":["name","type"]}}}}}},"/projects/{project_id}/policy-rules/{rule_id}":{"get":{"operationId":"get_policy_rule","summary":"One policy rule","description":"Returns one policy rule of the project with its parameters and scope.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The policy rule id from list_policy_rules."},"description":"The policy rule id from list_policy_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_policy_rule","responses":{"200":{"description":"One policy rule","content":{"application/json":{"schema":{"type"