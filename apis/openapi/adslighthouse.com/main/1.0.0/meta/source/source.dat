chema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"keyword","in":"query","required":false,"schema":{"type":"string","minLength":1,"maxLength":500,"description":"Only checks of this exact keyword text, as list_keywords returns it."},"description":"Only checks of this exact keyword text, as list_keywords returns it."},{"name":"gap_days","in":"query","required":false,"schema":{"type":"integer","description":"Minimum days away for a return: 3, 7, 14, 30.","default":7},"description":"Minimum days away for a return: 3, 7, 14, 30."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_advertiser_history","responses":{"200":{"description":"When and where one advertiser appeared, with the observation schedule","content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string"},"keyword":{"anyOf":[{"type":"string"},{"type":"null"}]},"presence":{"type":"object","properties":{"checks":{"type":"integer","description":"Saved monitoring checks in the group: the denominator."},"checks_with_advertiser":{"type":"integer","description":"Checks where the advertiser showed at least one ad: the numerator."},"ads":{"type":"integer","description":"Paid ad occurrences; one check can hold more than one."},"presence_rate":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"checks_with_advertiser / checks, 0 to 1; null when the group had no checks."}},"additionalProperties":false,"required":["checks","checks_with_advertiser","ads","presence_rate"]},"fi