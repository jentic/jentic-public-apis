00"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","maxLength":200,"description":"A name your team recognizes, up to 120 characters."},"enabled":{"type":"boolean","description":"false saves the rule paused. Defaults to true."},"type":{"type":"string","enum":["forbidden_terms","brand_term","direct_linking","promo_code","position_limit","affiliate_id"]},"params":{"type":"object","properties":{"terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":50,"description":"Forbidden words or phrases."},"fields":{"type":"array","items":{"type":"string","enum":["headline","description","display_url"]},"maxItems":3,"description":"Ad parts to check for terms."},"applies_to":{"type":"string","enum":["unauthorized","all_non_owned"]},"authorized_domains":{"type":"array","items":{"type":"string","maxLength":253},"maxItems":50},"extra_terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":20,"description":"Extra brand terms."},"codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50,"description":"Forbidden promo codes."},"any_explicit_code":{"type":"boolean","description":"Also flag any other code written after the word code."},"allowed_codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50},"top_positions":{"type":"integer","minimum":1,"maximum":10},"authorized_ids":{"type":"array","items":{"type":"string","maxLength":256},"maxItems":200}},"additionalProperties":false,"description":"Parameters for the rule type; send only the ones that type uses."},"scope":{"type":"object","properties":{"engine":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"device":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"os":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"country":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"location":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}},"additionalProperties":false,"description":"Observations to check: engine, device, os, country and location, each one value or a list. Omit for every observation."}},"additionalProperties":false}}}}},"delete":{"operationId":"delete_policy_rule","summary":"Delete a policy rule and keep its cases","description":"Deletes a policy rule. Its cases, findings and timelines are kept and still show the rule's name. To stop it temporarily, use update_policy_rule with enabled false instead. Requires the write scope; confirm with the user first.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The policy rule id from list_policy_rules."},"description":"The policy rule id from list_policy_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"delete_policy_rule","responses":{"200":{"description":"Delete a policy rule and keep its cases","content":{"application/json":{"schema":{"type":"object","properties":{"deleted":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string","enum":["forbidden_terms","brand_term","direct_linking","promo_code","position_limit","affiliate_id"]},"enabled":{"type":"boolean"},"readable":{"type":"boolean","description":"False when the stored configuration no longer parses; such a rule is skipped."},"params":{"anyOf":[{"type":"object","properties":{"terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":50,"description":"Forbidden words or phrases."},"fields":{"type":"array","items":{"type":"string","enum":["headline","description","display_url"]},"maxItems":3,"description":"Ad parts to check for terms."},"applies_to":{"type":"string","enum":["unauthorized","all_non_owned"]},"authorized_domains":{"type":"array","items":{"type":"string","maxLength":253},"maxItems":50},"extra_terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":20,"description":"Extra brand terms."},"codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50,"description":"Forbidden promo codes."},"any_explicit_code":{"type":"boolean","description":"Also flag any other code written after the word code."},"allowed_codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50},"top_positions":{"type":"integer","minimum":1,"maximum":10},"authorized_ids":{"type":"array","items":{"type":"string","maxLength":256},"maxItems":200}},"additionalProperties":false,"description":"Parameters for the rule type; send only the ones that type uses."},{"type":"null"}],"description":"Parameters for the rule type; send only the ones that type uses."},"scope":{"anyOf":[{"type":"object","properties":{"engine":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"device":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"os":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"country":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"location":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engine","device","os","country","location"],"description":"Which observations the rule checks. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"Which observations the rule checks. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},"open_cases":{"type":"integer"},"created_at":{"type":"string"},"updated_at":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","name","type","enabled","readable","params","scope","open_cases","created_at","updated_at"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["deleted"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/policy-rule-preview":{"post":{"operationId":"preview_policy_rule","summary":"What a draft rule would match, without saving it","description":"Evaluates a draft rule against the project's saved checks over a date range (last 30 days by default, at most 92 days) and returns how many ads, advertisers and cases it would match, with up to 20 recent examples. Use this to check whether the rule is scoped as intended before create_policy_rule; nothing is saved and no case is opened. No matches means none in the saved checks, not that none happened. Types and params: forbidden_terms {terms, fields: headline|description|display_url, applies_to, authorized_domains}; brand_term {extra_terms, authorized_domains}; direct_linking {authorized_domains}; promo_code {codes, any_explicit_code, allowed_codes, applies_to, authorized_domains}; position_limit {top_positions 1-10, applies_to, authorized_domains}; affiliate_id {authorized_ids}. applies_to is unauthorized (default for position limits) or all_non_owned (default for terms and codes). Your own domains never match, except for affiliate_id; advertisers classified as authorized retailers and authorized_domains count as authorized. A match is a lead to review: an observation shows an ad was displayed for a search at a moment, not proof of a violation, spend or a purchased keyword.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"preview_policy_rule","responses":{"200":{"description":"What a draft rule would match, without saving it","content":{"application/json":{"schema":{"type":"object","properties":{"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"matched_ads":{"type":"integer"},"advertisers":{"type":"integer"},"cases":{"type":"integer","description":"Cases the rule would open or update."},"truncated":{"type":"boolean","description":"True when only the first 20,000 saved ads were read."},"examples":{"type":"array","items":{"type":"object","properties":{"observed_at":{"type":"string"},"query":{"type":"string"},"engine":{"type":"string","enum":["google","bing"]},"device":{"type":"string","enum":["desktop","mobile"]},"os":{"anyOf":[{"type":"string"},{"type":"null"}]},"country":{"type":"string"},"location":{"anyOf":[{"type":"string"},{"type":"null"}]},"position":{"type":"integer"},"advertiser_domain":{"type":"string"},"title":{"anyOf":[{"type":"string"},{"type":"null"}]},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"display_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"matched":{"type":"string","description":"What matched: terms, a code, a destination host, a position or an affiliate ID."},"paid_results_path":{"type":"string","description":"App path of the saved ads for this advertiser, market and day."}},"additionalProperties":false,"required":["observed_at","query","engine","device","os","country","location","position","advertiser_domain","title","description","display_url","url","matched","paid_results_path"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["window","matched_ads","advertisers","cases","truncated","examples"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","maxLength":200,"description":"A name your team recognizes, up to 120 characters."},"type":{"type":"string","enum":["forbidden_terms","brand_term","direct_linking","promo_code","position_limit","affiliate_id"]},"params":{"type":"object","properties":{"terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":50,"description":"Forbidden words or phrases."},"fields":{"type":"array","items":{"type":"string","enum":["headline","description","display_url"]},"maxItems":3,"description":"Ad parts to check for terms."},"applies_to":{"type":"string","enum":["unauthorized","all_non_owned"]},"authorized_domains":{"type":"array","items":{"type":"string","maxLength":253},"maxItems":50},"extra_terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":20,"description":"Extra brand terms."},"codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50,"description":"Forbidden promo codes."},"any_explicit_code":{"type":"boolean","description":"Also flag any other code written after the word code."},"allowed_codes":{"type":"array","items":{"type":"string","maxLength":20},"maxItems":50},"top_positions":{"type":"integer","minimum":1,"maximum":10},"authorized_ids":{"type":"array","items":{"type":"string","maxLength":256},"maxItems":200}},"additionalProperties":false,"description":"Parameters for the rule type; send only the ones that type uses."},"scope":{"type":"object","properties":{"engine":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"device":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"os":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"country":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"location":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}},"additionalProperties":false,"description":"Observations to check: engine, device, os, country and location, each one value or a list. Omit for every observation."},"range":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"time_zone":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."}},"additionalProperties":false,"required":["type"]}}}}}},"/projects/{project_id}/policy-rule-evaluation":{"post":{"operationId":"evaluate_policy_rules","summary":"Check saved ads against the enabled rules and record cases","description":"Evaluates every enabled policy rule of the project against the saved checks in a date range (last 30 days by default, at most 92 days), like \"Evaluate saved ads\" in the app. New matches are recorded as findings and open or update cases; a resolved case reopens only for an ad observed after it was resolved. Review matches with list_policy_cases and list_policy_case_evidence before deciding what they mean. Repeating the call records nothing twice. New captures are evaluated automatically; use this after adding or changing a rule to review older checks. A match is a lead to review: an observation shows an ad was displayed for a search at a moment, not proof of a violation, spend or a purchased keyword. Requires the write scope.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"evaluate_policy_rules","responses":{"200":{"description":"Check saved ads against the enabled rules and record cases","content":{"application/json":{"schema":{"type":"object","properties":{"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"findings":{"type":"integer","description":"New findings recorded by this call."},"opened":{"type":"integer","description":"Cases opened by this call."},"reopened":{"type":"integer","description":"Resolved cases reopened by a newer match."},"truncated":{"type":"boolean","description":"True when a rule read only the first 20,000 saved ads of the range."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["window","findings","opened","reopened","truncated"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"range":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"time_zone":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."}},"additionalProperties":false}}}}}},"/projects/{project_id}/policy-cases":{"get":{"operationId":"list_policy_cases","summary":"Cases opened by policy rules","description":"Lists the project's cases with at least one matching ad observed in the window (last 30 days by default) and the observation filters, most recent first. Cases are leads for human review, not confirmed policy violations. Use get_policy_case and list_policy_case_evidence to inspect the rule, timeline and saved ads before deciding how to handle a case. view: active (open, investigating, contacted; default), one status, or all. Filter by owner_user_id (or unassigned), rule_id and advertiser (part of the domain). status_counts counts every status under the same filters. A match is a lead to review: an observation shows an ad was displayed for a search at a moment, not proof of a violation, spend or a purchased keyword.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"view","in":"query","required":false,"schema":{"type":"string","enum":["active","open","investigating","contacted","resolved","dismissed","all"]}},{"name":"owner_user_id","in":"query","required":false,"schema":{"type":"string","maxLength":200,"description":"A member's user id, or unassigned."},"description":"A member's user id, or unassigned."},{"name":"rule_id","in":"query","required":false,"schema":{"type":"string","maxLength":200}},{"name":"advertiser","in":"query","required":false,"schema":{"type":"string","maxLength":253}},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_policy_cases","responses":{"200":{"description":"Cases opened by policy rules","content":{"