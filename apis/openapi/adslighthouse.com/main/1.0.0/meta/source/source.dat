ame","rule_type","advertiser_domain","affiliate_id","status","owner_user_id","owner_email","first_seen_at","last_seen_at","match_count","reopen_count","matches_in_range"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["window","status_counts","data","next_cursor"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/policy-cases/{case_id}":{"get":{"operationId":"get_policy_case","summary":"One case with its timeline","description":"Returns one case: rule, advertiser, affiliate ID, status, owner, first and last seen, match and reopen counts, and the timeline of every status change, owner change and note, oldest first. The case records that saved ads matched an internal rule; it is not a confirmed policy finding. Use list_policy_case_evidence to review the matching ads. A match is a lead to review: an observation shows an ad was displayed for a search at a moment, not proof of a violation, spend or a purchased keyword.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"case_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The case id from list_