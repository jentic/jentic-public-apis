it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_alert_events","responses":{"200":{"description":"Alerts fired for the account","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"title":{"type":"string"},"text":{"type":"string"},"facts":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"value":{"type":"string"}},"additionalProperties":false,"required":["label","value"]}},"fired_at":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"delivery_status":{"type":"string","enum":["pending","delivered","failed"]},"evidence_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The saved observation behind the alert, opened in the app after sign-in."}},"additionalProperties":false,"required":["id","project_id","brand_name","type","title","text","facts","fired_at","channel","delivery_status","evidence_url"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data","next_cursor","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/checks":{"post":{"operationId":"run_realtime_check","summary":"Start an on-demand check of a project's keywords","description":"Queues an on-demand check of the project's active keywords, or one keyword, across its locations, devices and search engines, using the on-demand allowance (one check per keyword × location × device × source). The searches run in the background; poll get_check_status. Requires the write scope and an idempotency key: a retry with the same key never reserves or runs the checks again. Confirm with the user before calling.","tags":["Checks"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"run_realtime_check","responses":{"202":{"description":"Start an on-demand check of a project's keywords","content":{"application/json":{"schema":{"type":"object","properties":{"run_id":{"type":"string"},"project_id":{"type":"string"},"reused":{"type":"boolean","description":"True when this answer repeats an earlier request with the same key, or joins an identical check that is still running. No checks were reserved again."},"total":{"type":"integer","description":"Searches in the run: keyword × location × device × source."},"completed":{"type":"integer"},"failed":{"type":"integer"},"pending":{"type":"integer"},"expired":{"type":"boolean","description":"True when some of the run's job records were already cleaned up."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["run_id","project_id","reused","total","completed","failed","pending","expired"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"keyword_id":{"type":"string","minLength":1,"maxLength":100,"description":"Check only this keyword."},"device":{"type":"string","enum":["desktop","mobile"],"description":"Check only this device."},"os":{"type":"string","enum":["windows","macos","android","ios"],"description":"Pin an operating system that fits the device."}},"additionalProperties":false}}}}},"get":{"operationId":"list_check_activity","summary":"A project's recent background activity and queued searches","description":"Lists a project's background activity newest first: search checks, page captures and reviews with status running, completed or failed, plus rows for scheduled runs that were skipped because the check allowance was used up (Search check capacity) or billing was paused. searches counts search checks waiting in the queue or running now. latest_on_demand_run summarizes the most recent run_realtime_check run; poll get_check_status for a specific run. next_scheduled_check_at is when the next scheduled check starts, the moment the app's header counts down to; it is null when nothing is scheduled (manual monitoring, no monitored keyword, or a plan that cannot run checks). Failure details are not exposed; a failed search is retried by the system when that is safe.","tags":["Checks"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_check_activity","responses":{"200":{"description":"A project's recent background activity and queued searches","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"activity":{"type":"string","description":"What ran: Search checks, Page captures, Search check capacity (a scheduled run skipped because the allowance was used up), Billing paused, and others."},"status":{"type":"string","enum":["running","completed","failed"]},"results_saved":{"type":"integer","description":"Rows saved by this job, such as one checked page."},"started_at":{"type":"string"},"ended_at":{"anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false,"required":["id","activity","status","results_saved","started_at","ended_at"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"searches":{"type":"object","properties":{"queued":{"type":"integer","description":"Search checks waiting to run."},"running":{"type":"integer","description":"Search checks running now."}},"additionalProperties":false,"required":["queued","running"]},"latest_on_demand_run":{"anyOf":[{"type":"object","properties":{"run_id":{"type":"string"},"total":{"type":"integer"},"completed":{"type":"integer"},"failed":{"type":"integer"},"pending":{"type":"integer"},"expired":{"type":"boolean"}},"additionalProperties":false,"required":["run_id","total","completed","failed","pending","expired"]},{"type":"null"}]},"next_scheduled_check_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"ISO 8601 start of the next scheduled check; null when none is scheduled."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data","next_cursor","searches","latest_on_demand_run","next_scheduled_check_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/checks/{run_id}":{"get":{"operationId":"get_check_status","summary":"Progress of an on-demand check","description":"Returns how many searches of an on-demand check run are completed, failed or pending. Results appear in list_observations as searches complete.","tags":["Checks"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"run_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"run_id from run_realtime_check."},"description":"run_id from run_realtime_check."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_check_status","responses":{"200":{"description":"Progress of an on-demand check","content":{"application/json":{"schema":{"type":"object","properties":{"run_id":{"type":"string"},"project_id":{"type":"string"},"reused":{"type":"boolean","description":"True when this answer repeats an earlier request with the same key, or joins an identical check that is still running. No checks were reserved again."},"total":{"type":"integer","description":"Searches in the run: keyword × location × device × source."},"completed":{"type":"integer"},"failed":{"type":"integer"},"pending":{"type":"integer"},"expired":{"type":"boolean","description":"True when some of the run's job records were already cleaned up."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["run_id","project_id","reused","total","completed","failed","pending","expired"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/analytics":{"get":{"operationId":"get_analytics","summary":"Chart-ready paid-search and Shopping aggregates for one project","description":"Returns chart-ready aggregates for one authorized project and date window, using the same observation filters as the app. Use these metrics to find changes in monitored search results, then inspect the matching observations before drawing a conclusion. Paid-search charts include saved checks and eligible imported studies; studies are excluded when engine or ISO-country filters are selected because they do not record those dimensions. Shopping aggregates are null when the account's plan does not include Shopping. Counts are grouped before any chart display limit; unavailable dimensions are omitted rather than represented as zero. Connected Google Ads and Search Console reports are separate live data and are not historical chart inputs. The window defaults to the last 30 days in the person's time zone.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_analytics","responses":{"200":{"description":"Chart-ready paid-search and Shopping aggregates for one project","content":{"application/json":{"schema":{"type":"object","properties":{"project":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false,"required":["id","name"]},"data_state":{"type":"string","enum":["no_observations","no_ads","ads_found"]},"observations":{"type":"integer"},"ads_observed":{"type":"integer"},"advertiser_domains":{"type":"integer"},"active_keywords":{"type":"integer","minimum":0,"description":"Keywords currently monitored for paid search in this project; this count is independent of the selected date window and observation filters."},"imported_studies":{"type":"object","properties":{"available":{"type":"boolean"},"included":{"type":"boolean"},"observations":{"type":"integer"}},"additionalProperties":false,"required":["available","included","observations"]},"analytics":{"type":"object","properties":{"byDate":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["date","checks","ads","advertisers"]}},"byEngine":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byCountry":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byDevice":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byOperatingSystem":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byLocation":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byKeyword":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byAdvertiser":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"checks":{"type":"integer"},"ads":{"type":"integer"},"advertisers":{"type":"integer"}},"additionalProperties":false,"required":["label","checks","ads","advertisers"]}},"byPosition":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"checkOutcomes":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"adsPerCheck":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"advertisersPerKeyword":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}}},"additionalProperties":false,"required":["byDate","byEngine","byCountry","byDevice","byOperatingSystem","byLocation","byKeyword","byAdvertiser","byPosition","checkOutcomes","adsPerCheck","advertisersPerKeyword"]},"shopping":{"anyOf":[{"type":"object","properties":{"captures":{"type":"integer"},"unavailable":{"type":"integer"},"captured":{"type":"integer"},"products":{"type":"integer"},"state":{"type":"string","enum":["no_data","unavailable","no_products","available"]},"outcomes":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"byMerchant":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"byPosition":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"byLanguage":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"byKeyword":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":false,"required":["label","count"]}},"byDate":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string"},"captures":{"type":"integer"},"unavailable":{"type":"integer"},"products":{"type":"integer"}},"additionalProperties":false,"required":["date","captures","unavailable","products"]}}},"additionalProperties":false,"required":["captures","unavailable","captured","products","state","outcomes","byMerchant","byPosition","byLanguage","byKeyword","byDate"]},{"type":"null"}],"description":"Null when the account plan does not include Shopping."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["project","data_state","observations","ads_observed","advertiser_domains","active_keywords","imported_studies","analytics","shopping","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/summary":{"get":{"operationId":"get_summary","summary":"Headline numbers for a project and window","description":"Returns the headline numbers of one project for a window and filters, in three blocks that match three app pages. overview (the Overview page) counts saved monitoring checks: checks_saved = search result pages saved; ads_observed = paid ad occurrences in them (one advertiser seen in ten checks counts ten times); advertiser_domains = distinct advertiser domains; active_keywords = keywords with paid monitoring on. paid_results (the Paid results page) also includes imported studies unless engine or country filters are set: observations = saved checks (the visibility denominator); each own domain's visibility = observations where it showed at least one ad / observations, not impression share; segments count advertiser domains tagged affiliate, brand_mention (the ad copy names the brand), coupon or lookalike, which are signals to review. affiliate_cases (the Non-compliant affiliates page) counts your affiliate IDs seen behind ads that used the brand, by review status. data_state says whether nothing was saved yet, nothing matched the selection, or checks found no ads: zero ads is a result only when checks were saved. Use this for triage; to compare periods, request the same filters for a previous comparable window, then inspect notable changes with get_timeseries or get_advertiser before recommending action. Defaults to the last 30 days in the person's time zone.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_summary","responses":{"200":{"description":"Headline numbers for a project and window","content":{"application/json":{"schema":{"type":"object","properties":{"project":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false,"required":["id","name"]},"data_state":{"type":"string","enum":["no_checks_saved","no_checks_in_selection","no_ads_found","ads_found"],"description":"no_checks_saved: the project has never saved a check. no_checks_in_selection: nothing matches this window and filters (no data, not zero). no_ads_found: checks were saved and none showed a paid ad. ads_found: at least one ad was observed."},"overview":{"type":"object","properties":{"checks_saved":{"type":"integer"},"ads_observed":{"type":"integer"},"advertiser_domains":{"type":"integer"},"active_keywords":{"type":"integer","description":"Keywords with paid monitoring on, unfiltered."},"top_advertisers":{"type":"array","items":{"type":"object","properties":{"domain":{"type":"string"},"ads_observed":{"type":"integer"}},"additionalProperties":false,"required":["domain","ads_observed"]},"description":"Up to five advertiser domains with the most ad occurrences."}},"additionalProperties":false,"required":["checks_saved","ads_observed","advertiser_domains","active_keywords","top_advertisers"]},"paid_results":{"type":"object","properties":{"observations":{"type":"integer"},"ads_observed":{"type":"integer"},"advertiser_domains":{"type":"integer"},"other_advertisers":{"type":"integer","description":"Advertiser domains that are not your own."},"segments":{"type":"object","properties":{"affiliate":{"type":"integer"},"brand_mention":{"type":"integer"},"coupon":{"type":"integer"},"lookalike":{"type":"integer"}},"additionalProperties":false,"required":["affiliate","brand_mention","coupon","lookalike"]},"own_domains":{"type":"array","items":{"type":"object","properties":{"domain":{"type":"string"},"visibility":{"type":"number","minimum":0,"maximum":1},"observations_with_ads":{"type":"integer"},"ads_observed":{"type":"integer"}},"additionalProperties":false,"required":["domain","visibility","observations_with_ads","ads_observed"]}},"policy_reviews":{"type":"object","properties":{"reviewed_ads":{"type":"integer","description":"Saved Google ads with an automated policy review."},"likely_policy_concern":{"type":"integer"},"needs_review":{"type":"integer"},"likely_allowed":{"type":"integer"},"insufficient_evidence":{"type":"integer"},"pending":{"type":"integer","description":"Queued, not reviewed yet."},"unavailable":{"type":"integer","description":"The review could not be completed."}},"additionalProperties":false,"required":["reviewed_ads","likely_policy_concern","needs_review","likely_allowed","insufficient_evidence","pending","unavailable"],"description":"Automated first reading of ads that use the brand in their copy, against the advertising policy on trademarks and misrepresentation. It is a triage aid, not a legal finding."}},"additionalProperties":false,"required":["observations","ads_observed","advertiser_domains","other_advertisers","segments","own_domains","policy_reviews"]},"affiliate_cases":{"type":"object","properties":{"configured":{"type":"boolean","description":"False when no affiliate URL parameter is set, so nothing can be detected."},"total":{"type":"integer"},"new":{"type":"integer"},"in_progress":{"type":"integer"},"resolved":{"type":"integer"},"ignored":{"type":"integer"}},"additionalProperties":false,"required":["configured","total","new","in_progress","resolved","ignored"]},"note":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A caution about sample size or configuration to repeat when reporting results."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["project","data_state","overview","paid_results","affiliate_cases","note","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/timeseries":{"get":{"operationId":"get_timeseries","summary":"Checks, ads and advertisers by local day, week or month","description":"Returns one row per local day, week (starting Monday) or month with saved monitoring checks, in the person's time zone or time_zone: checks_saved, ads_observed (ad occurrences) and advertiser_domains (distinct domains in that period). A period without saved checks is absent: nothing was measured, which is not the same as zero ads. Pass advertiser to add that domain's visibility per period = checks where it showed at least one ad / checks_saved; it is not impression share. Compare like-for-like windows and filters, and check changes in checks_saved before attributing a change in observed presence to the market. Imported studies are not included, as on the Overview chart. The default granularity matches the Overview chart: days, or months for windows longer than 62 days.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"granularity","in":"query","required":false,"schema":{"type":"string","enum":["day","week","month"],"description":"Period length. Defaults to day, or month for windows longer than 62 days."},"description":"Period length. Defaults to day, or month for windows longer than 62 days."},{"name":"advertiser","in":"query","required":false,"schema":{"type":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_timeseries","responses":{"200":{"description":"Checks, ads and advertisers by local day, week or month","content":{"application/json":{"schema":{"type":"object","properties":{"granularity":{"type":"string","enum":["day","week","month"]},"advertiser":{"anyOf":[{"type":"string"},{"type":"null"}]},"data":{"type":"array","items":{"type":"object","properties":{"period":{"type":"string","description":"YYYY-MM-DD for a day or the Monday that starts a week; YYYY-MM for a month."},"checks_saved":{"type":"integer"},"ads_observed":{"type":"integer"},"advertiser_domains":{"type":"integer"},"advertiser_checks_with_ads":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Checks where the requested advertiser showed an ad; null without advertiser."},"advertiser_visibility":{"anyOf":[{"type":"number","minimum":0,"maximum":1},{"type":"null"}],"description":"advertiser_checks_with_ads / checks_saved; null without advertiser."}},"additionalProperties":false,"required":["period","checks_saved","ads_observed","advertiser_domains","advertiser_checks_with_ads","advertiser_visibility"]}},"note":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A caution about sample size or configuration to repeat when reporting results."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["granularity","advertiser","data","note","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/advertisers/{domain}":{"get":{"operationId":"get_advertiser","summary":"One advertiser's metrics, category and saved ads","description":"Returns one advertiser domain on the project's monitored searches: its Paid results row (visibility = observations where it showed at least one ad / observations, ad occurrences, keywords, markets, signals), the category and name your team saved for it, its automated policy review counts, and its saved ads newest first, 25 per page, each with the results-page screenshot of its first appearance when one was stored. observed_in_selection is false when the domain showed no ad in this window and filters; that is not proof it stopped advertising. Use get_advertiser_history to check how often the project measured the advertiser and where its presence changed. Metrics describe this saved sample and do not establish market share, spend, or whether a competitor stopped advertising. Includes imported studies unless engine or country filters are set. When a saved landing-page preview is available, each ad also has landing_screenshot metadata with an app_url; it is null when no preview was saved. MCP returns metadata and the app link, while REST serves the private JPEG rendered from saved HTML. New previews may include selected static styles, images and fonts fetched at render time; scripts and nested documents remain disabled, and fetched assets may differ from the original capture time.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"domain","in":"path","required":true,"schema":{"type":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d"