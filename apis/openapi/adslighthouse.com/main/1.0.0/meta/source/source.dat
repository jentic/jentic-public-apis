ins never match, except for affiliate_id; advertisers classified as authorized retailers and authorized_domains count as authorized. Requires the write scope.","tags":["Policy"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The policy rule id from list_policy_rules."},"description":"The policy rule id from list_policy_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_policy_rule","responses":{"200":{"description":"Rename, pause, reconfigure or rescope a policy rule","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string","enum":["forbidden_terms","brand_term","direct_linking","promo_code","position_limit","affiliate_id"]},"enabled":{"type":"boolean"},"readable":{"type":"boolean","description":"False when the stored configuration no longer parses; such a rule is skipped."},"params":{"anyOf":[{"type":"object","properties":{"terms":{"type":"array","items":{"type":"string","maxLength":100},"maxItems":50,"description":"Forbidden words or phrases."},"fields":{"type":"array","items":{"type":"string","enum":["headline","description","display_url"]},"maxItems":3,"description":"Ad parts to check for terms."},"applies_to":{"type":"string","enum":["unauthorized","all_non_owned"]},"authorized_domains":{"type":"array","items":{"type":"string","maxLength":253},"max