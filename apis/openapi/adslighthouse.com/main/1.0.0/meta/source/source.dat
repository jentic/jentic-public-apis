:["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_keyword_ads","responses":{"200":{"description":"Advertisers or distinct ads seen for one keyword","content":{"application/json":{"schema":{"type":"object","properties":{"view":{"type":"string","enum":["advertisers","ads"]},"sort":{"type":"string","enum":["most-observed","newest","oldest","name","top-position