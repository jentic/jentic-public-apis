sence_rate = checks_with_advertiser / checks over saved monitoring checks, the same calculation as visibility in list_advertisers. It describes this sample, not impression share, spend, or proof that a keyword was bought. Hours or days without checks are not evidence of absence. Breakdown lists hold the 50 busiest rows each; *_total gives the full count. Imported studies are not included.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"domain","in":"path","required":true,"schema":{"type":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"L