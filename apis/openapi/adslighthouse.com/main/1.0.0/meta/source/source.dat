l"}],"description":"Private REST endpoint for the saved product image. Fetch it with a credential authorized for the REST API; an OAuth token scoped to MCP cannot access this URL. Null when no image was saved."},"image_app_url":{"anyOf":[{"type":"string","format":"uri"},{"type":"null"}],"description":"Signed-in app link to view the private saved product image. Available to account members when an image was saved; otherwise null."},"serp_url":{"type":"string","format":"uri","description":"Current Google Shopping search for this observed keyword and market."},"keyword":{"type":"string"},"observed_at":{"type":"string"},"country":{"type":"string"},"location":{"anyOf":[{"type":"string"},{"type":"null"}]},"device":{"type":"string"},"os":{"anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false,"required":["title","merchant","price","position","url","image_url","image_app_url","serp_url","keyword","observed_at","country","location","device","os"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["shopping_enabled","data_state","captures","captures_unavailable","products","data","next_cursor","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"42