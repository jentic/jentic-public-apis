{id}."},"exact":{"type":"boolean","description":"true: the results page this ad was found on. false: only on older pictures, taken from a new load of the same search moments later, which may show different ads."},"captured_at":{"type":"string"},"app_url":{"type":"string","description":"Opens the picture in the app for a signed-in member of the project's account."}},"additionalProperties":false,"required":["id","exact","captured_at","app_url"]},{"type":"null"}],"description":"Picture of the results page where this ad (same domain, title and description) first appeared in the project; null when none was stored. Evidence of that page, not proof of spend."},"landing_screenshot":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"captured_at":{"type":"string"},"app_url":{"type":"string"},"rendering":{"type":"string","enum":["saved_html_offline","saved_html_static_assets"]}},"additionalProperties":false,"required":["id","captured_at","app_url","rendering"]},{"type":"null"}],"description":"Preview of saved HTML with scripts disabled. Static-assets previews fetch images, styles and fonts at render time; offline previews block external resources. Null when no preview exists."}},"additionalProperties":false,"required":["advertiser_name","title","description","display_url","url","position","best_observation","latest_observation","screenshot","landing_screenshot"]},{"type":"null"}],"description":"The ad itself; null in view=advertisers."},"policy_review":{"anyOf":[{"type":"object","properties":{"status":{"type":"string","enum":["pending","complete","failed"]},"verdict":{"anyOf":[{"type":"string","enum":["likely_policy_concern","needs_review","likely_allowed","insufficient_evidence"]},{"type":"null"}]},"confidence":{"anyOf":[{"type":"string","enum":["low","medium","high"]},{"type":"null"}]},"summary":{"anyOf":[{"type":"string"},{"type":"null"}]},"reasons":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}},"reviewed_at