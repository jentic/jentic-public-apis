pe":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"keyword","in":"query","required":false,"schema":{"type":"string","minLength":1,"maxLength":500,"description":"Only checks of this exact keyword text, as list_keywords returns it."},"description":"Only checks of this exact keyword text, as list_keywords returns it."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_advertiser_heatmap","responses":{"200":{"description":"Presence by local hour and weekday","content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string"},"time_zone":{"type":"string"},"cells":{"type":"array","items":{"type":"object","properties":{"checks":{"type":"integer","description":"Saved monitoring checks in the group: the denominator."},"checks_with_advertiser":{"type":"integer","description":"Checks where the advertiser showed at least one ad: the numerator."},"ads":{"type":"integer","description":"Paid ad occurrences; one check can hold more than one."},"presence_rate":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"checks_with_advertiser / checks, 0 to 1; null when the group had no checks."},"weekday":{"type":"integer","description":"ISO weekday, 1 = Monday."},"hour":{"type":"integer"}},"additionalProperties":false,"required":["checks","checks_with_advertiser","ads","presence_rate","weekday","hour"]}},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["domain","time_zone","cells","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/advertisers/{domain}/ad-copy":{"get":{"operationId":"list_ad_copy_versions","summary":"One advertiser's distinct ad copy, newest first","description":"Lists the distinct ad copy versions (headline, description and display URL, with spacing and URL spelling differences ignored) one advertiser showed on the project's monitored searches in the window, newest first observed version first. Each version has its first and last seen time, ad occurrences in the window, keywords, and, when it replaced an earlier version, previous_version_id and a word-level diff. Use the diff to brief the SEM team on messaging changes seen in the monitored results. Observed creative changes do not show which version performed better; the tool measures what appeared in saved checks, not clicks or conversions. first_seen is when monitoring first observed the copy, not when the advertiser launched it. To tell a new version from an old one, up to 90 days before the window are also read. A copy change is not evidence of a policy issue.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"domain","in":"path","required":true,"schema":{"type":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"keyword","in":"query","required":false,"schema":{"type":"string","minLength":1,"maxLength":500,"description":"Only checks of this exact keyword text, as list_keywords returns it."},"description":"Only checks of this exact keyword text, as list_keywords returns it."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_ad_copy_versions","responses":{"200":{"description":"One advertiser's distinct ad copy, newest first","content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"