":{"schema":{"type":"object","properties":{"url":{"type":"string","description":"The signed download link."},"expires_at":{"type":"string","description":"When the link stops working, ISO 8601."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["url","expires_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/reports/{report_id}/pdf":{"get":{"operationId":"download_report_pdf","summary":"Download a ready PDF report","description":"Returns the PDF file of a ready report as application/pdf. Errors use the JSON envelope. REST only: MCP clients use get_report_download_link, which returns a short-lived signed link instead of the file.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","description":"The project id, brand domain or exact name."}},{"name":"report_id","in":"path","required":true,"schema":{"type":"string","description":"The report id."}}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","responses":{"200":{"description":"The PDF file.","content":{"application/pdf":{"schema":{"type":"string","format":"binary"}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/screenshots/{screenshot_id}":{"get":{"operationId":"download_screenshot","summary":"Download a results-page screenshot","description":"Returns the stored picture of the results page where a saved ad first appeared, as image/png or image/jpeg. Its id comes from the screenshot of an ad in get_advertiser. Errors use the JSON envelope; 503 unavailable means the stored picture cannot be read right now. REST only: MCP clients get the picture's app link from get_advertiser instead of the file.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","description":"The project id, brand domain or exact name."}},{"name":"screenshot_id","in":"path","required":true,"schema":{"type":"string","description":"The screenshot id from get_advertiser."}}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","responses":{"200":{"description":"The image file.","content":{"image/png":{"schema":{"type":"string","format":"binary"}},"image/jpeg":{"schema":{"type":"string","format":"binary"}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/shopping-products/{product_id}/image":{"get":{"operationId":"download_shopping_image","summary":"Fetch a saved Shopping product image","description":"Returns the private image saved for this product as JPEG or PNG. Requires the read scope and a plan that includes Shopping. MCP tools return image_url metadata; they do not return image bytes.","tags":["Reports"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","description":"The project id, brand domain or exact name."}},{"name":"product_id","in":"path","required":true,"schema":{"type":"string","description":"ID of the saved Shopping product whose image_url was returned by list_shopping_products."}}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","responses":{"200":{"description":"The image file.","content":{"image/png":{"schema":{"type":"string","format":"binary"}},"image/jpeg":{"schema":{"type":"string","format":"binary"}}}},"401":{"$ref":"#/componen