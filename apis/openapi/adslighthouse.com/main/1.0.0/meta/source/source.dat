ious page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_ad_copy_changes","responses":{"200":{"description":"Recent ad copy changes across advertisers","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"domain":{"type":"string"},"version":{"type":"object","properties":{"version_id":{"type":"string","description":"Stable id of this copy: headline, description and display URL."},"headline":{"type":"string"},"description":{"type":"string"},"display_url":{"type":"string"},"first_seen":{"type":"string","description":"First saved check with this copy; not its launch date."},"last_seen":{"type":"string"},"ads":{"type":"integer","description":"Ad occurrences with this copy in the window."},"keywords":{"type":"array","items":{"type":"string"}}},"additionalProperties":false,"required":["version_id","headline","description","display_url","first_seen","last_seen","ads","keywords"]},"previous_version":{"type":"object","properties":{"version_id":{"type":"string","description":"Stable id of this copy: headline, description and display URL."},"headline":{"type":"string"},"description":{"type":"string"},"display_url":{"type":"string"},"first_seen":{"type":"string","description":"First saved check with this copy; not its launch date."},"last_seen":{"type":"string"},"ads":{"type":"integer","description":"Ad occurrences with this copy in the window."},"keywords":{"type":"array","items":{"type":"string"}}},"additionalProperties":false,"required":["version_id","headline","description","display_url","first_seen","last_seen","ads","keywords"]},"previous_still_seen":{"type":"boolean","description":"The earlier copy was still observed after the new one first appeared."},"diff":{"type":"object","properties":{"headline":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["same","added","removed"]},"text":{"type":"string"}},"additionalProperties":false,"required":["type","text"]}},"description":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["same","added","removed"]},"text":{"type":"string"}},"additionalProperties":false,"required":["type","text"]}},"display_url":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["same","added","removed"]},"text":{"type":"string"}},"additionalProperties":false,"required":["type","text"]}}},"additionalProperties":false,"required":["headline","description","display_url"],"description":"Word-level changes from previous_version to version."}},"additionalProperties":false,"required":["domain","version","previous_version","previous_still_seen","diff"]}},"total":{"type":"integer"},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"truncated":{"type":"boolean"},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data","total","next_cursor","truncated","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/check-demand":{"post":{"operationId":"preview_check_demand","summary":"Forecast the monthly checks and allowance for a proposed change","description":"Previews, without saving anything, whether a proposed configuration fits the account's plan, with the same calculation the New project, Edit monitoring plan and Add keywords forms and the server use. Compare the proposed keyword, location, device and search-engine coverage with the account's full-month check allowance before choosing a monitoring plan. change=new_project needs country and keywords (other fields default as in create_project); change=update_project needs project_id plus the fields to change, as in update_project; change=add_keywords needs project_id and keywords (country and language default to the project's). One check is one search: keyword × location × device × source (Google, Bing, Shopping). scheduled_checks.full_month is account-wide for a 31-day month; the plan must cover both it and projected_this_month. Periods are UTC months. Use it to explain projected check usage and plan fit before calling create_project, update_project or add_keywords.","tags":["Projects"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"preview_check_demand","responses":{"200":{"description":"Forecast the monthly checks and allowance for a proposed change","content":{"application/json":{"schema":{"type":"object","properties":{"fits":{"type":"boolean","description":"True when the account's plan can carry the change: projects, keywords, full-month scheduled checks and any first run."},"blocked_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Why it does not fit, as the app would say it; null when it fits."},"period":{"type":"string","description":"Usage month, YYYY-MM in UTC."},"scheduled_checks":{"type":"object","properties":{"full_month":{"type":"integer","description":"Scheduled checks the whole account would need in a 31-day month with this change: sum over projects of keywords × locations × devices × sources × runs per day × 31."},"projected_this_month":{"type":"integer","description":"Scheduled checks already used this month plus those still due before the month ends (UTC)."},"monthly_limit":{"type":"integer"}},"additionalProperties":false,"required":["full_month","projected_this_month","monthly_limit"]},"first_run_checks":{"type":"integer","description":"On-demand checks a new project's first run would use (keywords × locations × devices × sources). 0 for other changes."},"realtime_remaining":{"type":"integer","description":"On-demand checks left this month."},"keywords":{"type":"object","properties":{"activated_this_month":{"type":"integer","description":"Distinct keyword, country and language identities used this month, including removed ones, plus the new keywords."},"monthly_limit":{"type":"integer"}},"additionalProperties":false,"required":["activated_this_month","monthly_limit"]},"trial":{"anyOf":[{"type":"object","properties":{"ends_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"scheduled_remaining":{"anyOf":[{"type":"integer"},{"type":"null"}]},"realtime_remaining":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["ends_at","scheduled_remaining","realtime_remaining"]},{"type":"null"}],"description":"Trial allowances when the account is on a trial; null otherwise."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["fits","blocked_reason","period","scheduled_checks","first_run_checks","realtime_remaining","keywords","trial"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"change":{"type":"string","enum":["new_project","update_project","add_keywords"],"description":"What to preview."},"project_id":{"type":"string","minLength":1,"maxLength":253,"description":"Required for update_project and add_keywords."},"name":{"type":"string","minLength":1,"maxLength":120,"description":"Project name, such as Nike US."},"country":{"type":"string","pattern":"^[A-Za-z]{2}$","description":"Market, ISO 3166-1 alpha-2 such as US. Changing it without locations monitors the whole new country."},"language":{"type":"string","pattern":"^[a-z]{2,3}$","description":"Search language, such as en."},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","exclusiveMinimum":0,"description":"Location code from search_locations."},"name":{"type":"string","minLength":1,"maxLength":200}},"additionalProperties":false,"required":["code","name"]},"minItems":1,"maxItems":100,"description":"The full list of locations inside the country, replacing the current list. Use search_locations to find codes. The plan limits how many a project may have."},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":2,"description":"The full list of devices to check."},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]},"maxItems":2,"description":"The full list of search engines. May be empty only when shopping_enabled is true. The market must offer each engine (get_monitoring_options)."},"shopping_enabled":{"type":"boolean","description":"Also check Google Shopping ads. Needs a plan that includes Shopping and a market with Google."},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"],"description":"How often scheduled checks run. manual pauses scheduled monitoring (on-demand checks still work); any other value resumes it. The plan limits the most frequent schedule."},"keywords":{"type":"array","items":{"type":"string","minLength":1,"maxLength":200},"minItems":1,"maxItems":20,"description":"Search terms, up to 20, such as nike running shoes."}},"additionalProperties":false,"required":["change"]}}}}}},"/monitoring-options":{"get":{"operationId":"get_monitoring_options","summary":"Markets, search engines, devices and schedules you can configure","description":"Lists what a project can be configured with: each market (country) with its default language, the search engines available there and its whole-country location, the devices and the operating systems an on-demand check can pin, and the schedules with whether the account's plan allows them. It also returns the plan's limits on locations per project, runs per day, projects, keywords and Shopping. Pass country to get one market. Use search_locations for cities and regions.","tags":["Projects"],"parameters":[{"name":"country","in":"query","required":false,"schema":{"type":"string","pattern":"^[A-Za-z]{2}$","description":"Only this market, ISO 3166-1 alpha-2 such as US."},"description":"Only this market, ISO 3166-1 alpha-2 such as US."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_monitoring_options","responses":{"200":{"description":"Markets, search engines, devices and schedules you can configure","content":{"application/json":{"schema":{"type":"object","properties":{"plan":{"type":"object","properties":{"id":{"type":"string","enum":["starter","growth","scale","business","enterprise"]},"name":{"type":"string"},"shopping":{"type":"boolean","description":"Whether the plan includes Google Shopping checks."},"locations_per_project":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when unlimited."},"max_runs_per_day":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when unlimited."},"projects":{"anyOf":[{"type":"integer"},{"type":"null"}]},"keywords":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["id","name","shopping","locations_per_project","max_runs_per_day","projects","keywords"]},"countries":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string","description":"ISO 3166-1 alpha-2."},"name":{"type":"string"},"default_language":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"shopping_available":{"type":"boolean","description":"Shopping needs Google in the market."},"whole_country_location":{"type":"object","properties":{"code":{"type":"integer"},"name":{"type":"string"}},"additionalProperties":false,"required":["code","name"]}},"additionalProperties":false,"required":["code","name","default_language","search_engines","shopping_available","whole_country_location"]}},"devices":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","enum":["desktop","mobile"]},"operating_systems":{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios"]},"description":"Operating systems an on-demand check may pin for this device."}},"additionalProperties":false,"required":["value","operating_systems"]}},"frequencies":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"]},"label":{"type":"string"},"runs_per_day":{"type":"integer"},"allowed_on_plan":{"type":"boolean"}},"additionalProperties":false,"required":["value","label","runs_per_day","allowed_on_plan"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["plan","countries","devices","frequencies"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/locations":{"get":{"operationId":"search_locations","summary":"Find cities and regions available for monitoring in a market","description":"Searches the locations that can be monitored inside one country, such as states, regions and cities, for the chosen search engines (a location must be supported by every engine selected). Without query it returns the country and the most common locations. Pass the returned code and name in locations to create_project or update_project.","tags":["Projects"],"parameters":[{"name":"country","in":"query","required":true,"schema":{"type":"string","pattern":"^[A-Za-z]{2}$","description":"ISO 3166-1 alpha-2, such as US."},"description":"ISO 3166-1 alpha-2, such as US."},{"name":"query","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"Part of a name, such as new york."},"description":"Part of a name, such as new york."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":2}],"description":"Search engines the locations must support. Defaults to every engine the market offers."},"description":"Search engines the locations must support. Defaults to every engine the market offers."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"description":"Locations to return, 1 to 100.","default":20},"description":"Locations to return, 1 to 100."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"search_locations","responses":{"200":{"description":"Find cities and regions available for monitoring in a market","content":{"application/json":{"schema":{"type":"object","properties":{"country":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"total_matches":{"type":"integer"},"data":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","description":"Pass as locations[].code to update_project or create_project."},"name":{"type":"string","description":"Full name, such as New York,New York,United States."},"label":{"type":"string","description":"The name the app shows."},"type":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Such as Country, State or City."}},"additionalProperties":false,"required":["code","name","label","type"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["country","search_engines","total_matches","data"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/account/time-zone":{"get":{"operationId":"get_time_zone","summary":"Your personal time zone preference","description":"Returns the time zone of the person the credential acts for. It sets the local day boundaries of every date range and how times are shown; it is personal, not shared with the team. Usage periods stay UTC months.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_time_zone","responses":{"200":{"description":"Your personal time zone preference","content":{"application/json":{"schema":{"type":"object","properties":{"time_zone":{"type":"string","description":"IANA time zone used for your date ranges, reports and schedules, such as America/New_York."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["time_zone"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"patch":{"operationId":"update_time_zone","summary":"Change your personal time zone preference","description":"Sets the time zone of the person the credential acts for, like Settings > Account. Saved data is not changed; later date ranges and displayed times use the new zone. Requires the write scope.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_time_zone","responses":{"200":{"description":"Change your personal time zone preference","content":{"application/json":{"schema":{"type":"object","properties":{"time_zone":{"type":"string","description":"IANA time zone used for your date ranges, reports and schedules, such as America/New_York."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["time_zone"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"time_zone":{"type":"string","minLength":1,"maxLength":100,"description":"IANA time zone name, such as America/Los_Angeles."}},"additionalProperties":false,"required":["time_zone"]}}}}}},"/account/theme":{"get":{"operationId":"get_theme","summary":"Your personal appearance preference","description":"Returns the app appearance of the person the credential acts for: system, light or dark. It is personal, not shared with the team, and changes nothing in API responses or reports.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_theme","responses":{"200":{"description":"Your personal appearance preference","content":{"application/json":{"schema":{"type":"object","properties":{"theme":{"type":"string","enum":["system","light","dark"],"description":"Appearance of the app: system follows the device's light or dark setting."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["theme"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"patch":{"operationId":"update_theme","summary":"Change your personal appearance preference","description":"Sets the app appearance of the person the credential acts for, like Settings > Account: system (follow the device), light or dark. It applies on the next page the person opens. Requires the write scope.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_theme","responses":{"200":{"description":"Change your personal appearance preference","content":{"application/json":{"schema":{"type":"object","properties":{"theme":{"type":"string","enum":["system","light","dark"],"description":"Appearance of the app: system follows the device's light or dark setting."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["theme"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"theme":{"type":"string","enum":["system","light","dark"]}},"additionalProperties":false,"required":["theme"]}}}}}},"/alert-rules":{"get":{"operationId":"list_alert_rules","summary":"Alert rules configured in the account","description":"Lists the account's alert rules, oldest first, optionally for one project: what each watches (type and engine, device and country restrictions), where it sends (email address, or only the host of a webhook or Slack URL) and whether it is enabled. This is the equivalent of webhook subscriptions: a webhook rule POSTs each alert, signed with the rule's secret, to your HTTPS endpoint. Signing secrets are never listed.","tags":["Alerts"],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_alert_rules","responses":{"200":{"description":"Alert rules configured in the account","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"create_alert_rule","summary":"Create an alert rule (email, Slack or webhook)","description":"Creates an alert rule for a project, exactly like Settings > Alert rules. Types: competitor_new (a domain the project does not own shows an ad for the first time), competitor_returning (an advertiser returns after at least 30 days away), hijack_detected (an ad from another domain mentions the brand in its copy), affiliate_detected (one of your affiliate IDs appears in an ad's destination URL; needs the project's affiliate parameter). Channels: email (target is an address, or omit it to notify the account owner), slack (target must be an https://hooks.slack.com/services/ URL) or webhook (target must be a public HTTPS URL; each delivery is signed with HMAC-SHA256 in x-ads-lighthouse-signature). Optional engines, devices and countries restrict which observations fire the rule. Alerts are leads to review: an observation is not proof of a purchased keyword, spend or a violation. Requires the write scope and an idempotency key; a retry with the same key returns the same rule. For webhook rules the response carries the signing secret once.","tags":["Alerts"],"parameters":[{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"create_alert_rule","responses":{"201":{"description":"Create an alert rule (email, Slack or webhook)","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean","description":"False when this key already created the rule."},"rule":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]},"signing_secret":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The webhook signing secret (whsec_...). Returned only here and by rotate_webhook_secret, only for webhook rules and only to owners and account admins. Store it now: list and get never return it."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","rule","signing_secret"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"project_id":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected"],"description":"What fires the rule."},"channel":{"type":"string","enum":["email","webhook","slack"],"description":"How alerts are delivered."},"target":{"type":"string","maxLength":2048,"description":"For email, the confirmed address of a person in this account (empty sends to the account owner); otherwise a Slack incoming webhook URL or your HTTPS webhook URL."},"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":2},{"type":"null"}],"description":"Only observations from these search engines. Omit or null for every engine."},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":2},{"type":"null"}],"description":"Only observations on these devices. Omit or null for every device."},"countries":{"anyOf":[{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":50},{"type":"null"}],"description":"Only observations in these ISO 3166-1 alpha-2 countries, such as US."}},"additionalProperties":false,"required":["project_id","type","channel"]}}}}}},"/alert-rules/{rule_id}":{"get":{"operationId":"get_alert_rule","summary":"One alert rule","description":"Returns one alert rule: type, channel, destination (email address or URL host only), restrictions and whether it is enabled. The signing secret is not returned; rotate_webhook_secret issues a new one.","tags":["Alerts"],"parameters":[{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The alert rule id from list_alert_rules."},"description":"The alert rule id from list_alert_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_alert_rule","responses":{"200":{"description":"One alert rule","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"update_alert_rule","summary":"Enable, disable or change an alert rule","description":"Changes an alert rule: enabled (false pauses it: it creates no new alerts and undelivered ones are not sent), its destination (validated for the rule's channel) or its restrictions. For engines, devices and countries, a list replaces that restriction, null removes it and an omitted field keeps it. Type and channel cannot change; create a new rule instead. Requires the write scope.","tags":["Alerts"],"parameters":[{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The alert rule id from list_alert_rules."},"description":"The alert rule id from list_alert_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_alert_rule","responses":{"200":{"description":"Enable, disable or change an alert rule","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"enabled":{"type":"boolean","description":"false pauses the rule; true resumes it."},"target":{"type":"string","maxLength":2048,"description":"New destination for the rule's channel. An empty string on an email rule notifies the account owner."},"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":2},{"type":"null"}],"description":"Only observations from these search engines. Omit or null for every engine."},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":2},{"type":"null"}],"description":"Only observations on these devices. Omit or null for every device."},"countries":{"anyOf":[{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":50},{"type":"null"}],"description":"Only observations in these ISO 3166-1 alpha-2 countries, such as US."}},"additionalProperties":false}}}}},"delete":{"operationId":"delete_alert_rule","summary":"Delete an alert rule and its alert history","description":"Permanently deletes an alert rule. Its alert history is deleted with it and a webhook receiver stops getting its alerts. To stop alerts temporarily, use update_alert_rule with enabled false instead. Requires the write scope; confirm with the user first.","tags":["Alerts"],"parameters":[{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The alert rule id from list_alert_rules."},"description":"The alert rule id from list_alert_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"delete_alert_rule","responses":{"200":{"description":"Delete an alert rule and its alert history","content":{"application/json":{"schema":{"type":"object","properties":{"deleted":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["deleted"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/alert-rules/{rule_id}/test":{"post":{"operationId":"send_test_alert","summary":"Queue a synthetic alert through a rule's channel","description":"Queues a synthetic test event for a rule, like the Test action in the app, so you can verify the email address, Slack channel or webhook endpoint (including its signature check) without waiting for a real finding. The alert dispatcher sends it within about 15 minutes; follow it with get_alert_event. It is marked as a test and never counts as a finding. Requires the write scope and an idempotency key; a retry with the same key returns the same event without queueing another. Limited to 5 tests per rule per hour and 20 per account per day (rate_limited with Retry-After beyond).","tags":["Alerts"],"parameters":[{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The alert rule id from list_alert_rules."},"description":"The alert rule id from list_alert_rules."},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"send_test_alert","responses":{"202":{"description":"Queue a synthetic alert through a rule's channel","content":{"application/json":{"schema":{"type":"object","properties":{"event_id":{"type":"string"},"created":{"type":"boolean","description":"False when this key already queued the event."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["event_id","created"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{},"additionalProperties":false}}}}}},"/alert-rules/{rule_id}/rotate-secret":{"post":{"operationId":"rotate_webhook_secret","summary":"Replace a webhook rule's signing secret","description":"Replaces a webhook rule's signing secret and returns the new one, once. The old secret stops working from the next delivery, with no overlap, and a receiver that rejects the new signature with a 4xx is not retried, so update your receiver right away. Only owners and account admins may rotate, as in the app. Requires the write scope; confirm with the user first.","tags":["Alerts"],"parameters":[{"name":"rule_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The alert rule id from list_alert_rules."},"description":"The alert rule id from list_alert_rules."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"rotate_webhook_secret","responses":{"200":{"description":"Replace a webhook rule's signing secret","content":{"application/json":{"schema":{"type":"object","properties":{"rule":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"project_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"type_label":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"destination":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Email address, or the host of a webhook or Slack URL (the full URL is never returned). null for an email rule that goes to the account owner."},"enabled":{"type":"boolean"},"filters":{"anyOf":[{"type":"object","properties":{"engines":{"anyOf":[{"type":"array","items":{"type":"string","enum":["google","bing"]}},{"type":"null"}]},"devices":{"anyOf":[{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},{"type":"null"}]},"countries":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"additionalProperties":false,"required":["engines","devices","countries"],"description":"Which observations the rule watches. null in a dimension means every value; values within a dimension combine with OR, dimensions with AND."},{"type":"null"}],"description":"null when the stored restrictions cannot be read; such a rule is skipped, never widened."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","project_name","brand_name","type","type_label","channel","destination","enabled","filters","created_at"]},"signing_secret":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["rule","signing_secret"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{},"additionalProperties":false}}}}}},"/alert-events/{event_id}":{"get":{"operationId":"get_alert_event","summary":"One alert with its delivery record","description":"Returns one fired alert (message, facts, evidence link) with its delivery record: status (pending, delivered or failed), attempts so far out of the maximum, the last and next attempt times, when it was delivered and the last failure as shown in the app. The app stores the latest attempt, not a separate row per attempt. A finding covered by a digest is delivered only inside that digest and shares its outcome.","tags":["Alerts"],"parameters":[{"name":"event_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,100}$","description":"The alert event id from list_alert_events or send_test_alert."},"description":"The alert event id from list_alert_events or send_test_alert."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_alert_event","responses":{"200":{"description":"One alert with its delivery record","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"project_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"brand_name":{"type":"string"},"type":{"type":"string","enum":["competitor_new","competitor_returning","hijack_detected","affiliate_detected","ranking_drop","nklg_re_enable","ingestion_failed"]},"title":{"type":"string"},"text":{"type":"string"},"facts":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"value":{"type":"string"}},"additionalProperties":false,"required":["label","value"]}},"fired_at":{"type":"string"},"channel":{"type":"string","enum":["email","webhook","slack"]},"delivery_status":{"type":"string","enum":["pending","delivered","failed"]},"evidence_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The saved observation behind the alert, opened in the app after sign-in."},"rule_id":{"type":"string"},"test":{"type":"boolean","description":"True for a synthetic event requested with send_test_alert."},"delivery":{"type":"object","properties":{"status":{"type":"string","enum":["pending","delivered","failed"]},"attempts":{"type":"integer","description":"Delivery attempts started so far, including one still running."},"max_attempts":{"type":"integer"},"last_attempt_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"next_attempt_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"While pending: when the running attempt's lease ends or the retry is due."},"delivered_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"last_error":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The last failure as shown in the app's alert history. Unrecognized errors appear as a neutral message."},"delivered_by_digest_id":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When set, this finding is delivered only inside that digest event and shares its outcome."}},"additionalProperties":false,"required":["status","attempts","max_attempts","last_attempt_at","next_attempt_at","delivered_at","last_error","delivered_by_digest_id"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["id","project_id","brand_name","type","title","text","facts","fired_at","channel","delivery_status","evidence_url","rule_id","test","delivery"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/team":{"get":{"operationId":"list_team","summary":"Members, roles and open invitations","description":"Lists the account's members with their roles (owner, admin, member) and the open invitations with their status and email delivery status. Everyone on the team sees this list in the app. Roles: the owner manages everything, including admins and the plan; an admin invites and manages ordinary members; a member uses the shared projects but manages nobody. All members share the account's projects, history and plan.","tags":["Team"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_team","responses":{"200":{"description":"Members, roles and open invitations","content":{"application/json":{"schema":{"type":"object","properties":{"your_role":{"type":"string","enum":["owner","admin","member"],"description":"Role of the person the credential acts for."},"members":{"type":"array","items":{"type":"object","properties":{"user_id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["owner","admin","member"]},"joined_at":{"type":"string"},"you":{"type":"boolean","description":"True for the person the credential acts for."}},"additionalProperties":false,"required":["user_id","email","role","joined_at","you"]}},"invitations":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]},"status":{"type":"string","enum":["pending","expired","accepted","canceled"],"description":"pending invitations can still be accepted until expires_at."},"delivery_status":{"type":"string","enum":["pending","sent","failed"],"description":"Whether the invitation email was handed to the mail service."},"invited_by_email":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string"},"expires_at":{"type":"string"}},"additionalProperties":false,"required":["id","email","role","status","delivery_status","invited_by_email","created_at","expires_at"]},"description":"Open invitations, newest first, including expired ones that were not replaced."},"seat_limit":{"type":"integer","description":"Members plus open, unexpired invitations may not exceed this."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["your_role","members","invitations","seat_limit"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/team/invitations":{"post":{"operationId":"invite_team_member","summary":"Email an invitation to join the account","description":"Invites a person by email with the role member (default) or admin, and sends the same invitation email as the app; the link expires in 7 days. Same rules as Settings > Team: owners and admins may invite, only the owner may invite an admin, the inviter must have confirmed their email address, the team (members plus open invitations) is limited to the seat limit, the same address can be invited again only after a minute and an account can send 20 invitations a day. Inviting an address with an open invitation replaces it. Requires the write scope and an idempotency key: a retry with the same key returns the first invitation without emailing again. Confirm the address with the user first.","tags":["Team"],"parameters":[{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"invite_team_member","responses":{"201":{"description":"Email an invitation to join the account","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean"},"invitation":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]},"status":{"type":"string","enum":["pending","expired","accepted","canceled"],"description":"pending invitations can still be accepted until expires_at."},"delivery_status":{"type":"string","enum":["pending","sent","failed"],"description":"Whether the invitation email was handed to the mail service."},"invited_by_email":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string"},"expires_at":{"type":"string"}},"additionalProperties":false,"required":["id","email","role","status","delivery_status","invited_by_email","created_at","expires_at"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","invitation"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","minLength":3,"maxLength":254,"description":"The address to invite."},"role":{"type":"string","enum":["member","admin"],"default":"member"}},"additionalProperties":false,"required":["email"]}}}}}},"/team/invitations/{invitation_id}/resend":{"post":{"operationId":"resend_invitation","summary":"Send an open invitation again with a new link","description":"Sends an open invitation again with the same role. The earlier link stops working and the new one expires in 7 days. Same permissions and limits as invite_team_member, including the one-minute wait per address. Requires the write scope and an idempotency key: a retry with the same key does not email again.","tags":["Team"],"parameters":[{"name":"invitation_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":200,"description":"The invitation id from list_team."},"description":"The invitation id from list_team."},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"resend_invitation","responses":{"200":{"description":"Send an open invitation again with a new link","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean"},"invitation":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]},"status":{"type":"string","enum":["pending","expired","accepted","canceled"],"description":"pending invitations can still be accepted until expires_at."},"delivery_status":{"type":"string","enum":["pending","sent","failed"],"description":"Whether the invitation email was handed to the mail service."},"invited_by_email":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string"},"expires_at":{"type":"string"}},"additionalProperties":false,"required":["id","email","role","status","delivery_status","invited_by_email","created_at","expires_at"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","invitation"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{},"additionalProperties":false}}}}}},"/team/invitations/{invitation_id}":{"delete":{"operationId":"cancel_invitation","summary":"Revoke an open invitation","description":"Cancels an open invitation so its link can no longer be used. Owners may cancel any invitation; admins only invitations for the member role. Canceling one that was already accepted or canceled changes nothing. Requires the write scope; confirm with the user first.","tags":["Team"],"parameters":[{"name":"invitation_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":200,"description":"The invitation id from list_team."},"description":"The invitation id from list_team."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"cancel_invitation","responses":{"200":{"description":"Revoke an open invitation","content":{"application/json":{"schema":{"type":"object","properties":{"invitation":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]},"status":{"type":"string","enum":["pending","expired","accepted","canceled"],"description":"pending invitations can still be accepted until expires_at."},"delivery_status":{"type":"string","enum":["pending","sent","failed"],"description":"Whether the invitation email was handed to the mail service."},"invited_by_email":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string"},"expires_at":{"type":"string"}},"additionalProperties":false,"required":["id","email","role","status","delivery_status","invited_by_email","created_at","expires_at"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["invitation"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/team/members/{user_id}":{"post":{"operationId":"change_member_role","summary":"Make a member an admin or an admin a member","description":"Changes a team member's role between member and admin. Only the account owner can grant or remove the admin role, and must have confirmed their email address; the owner's own role never changes. Demoting an admin also cancels the invitations they sent. Requires the write scope; confirm with the user first.","tags":["Team"],"parameters":[{"name":"user_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":200,"description":"The member's user_id from list_team."},"description":"The member's user_id from list_team."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"change_member_role","responses":{"200":{"description":"Make a member an admin or an admin a member","content":{"application/json":{"schema":{"type":"object","properties":{"member":{"type":"object","properties":{"user_id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]}},"additionalProperties":false,"required":["user_id","email","role"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["member"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"role":{"type":"string","enum":["member","admin"]}},"additionalProperties":false,"required":["role"]}}}}},"delete":{"operationId":"remove_team_member","summary":"Remove a person from the account","description":"Removes a person from the account: they lose access to its projects at once, and their API keys and connected apps for this account stop working. Shared projects and history stay. Owners may remove admins and members; admins may remove members only; nobody can remove the owner. Requires the write scope; confirm with the user first.","tags":["Team"],"parameters":[{"name":"user_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":200,"description":"The member's user_id from list_team."},"description":"The member's user_id from list_team."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"remove_team_member","responses":{"200":{"description":"Remove a person from the account","content":{"application/json":{"schema":{"type":"object","properties":{"removed":{"type":"object","properties":{"user_id":{"type":"string"},"email":{"type":"string"}},"additionalProperties":false,"required":["user_id","email"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["removed"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/accounts":{"get":{"operationId":"list_accounts","summary":"The account this credential can use","description":"Lists the accounts this credential can use. An API key or a connected app is bound to one account, so the list has exactly that account, even when the person belongs to other accounts; each other account needs its own key or connection.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_accounts","responses":{"200":{"description":"The account this credential can use","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"account_id":{"type":"string"},"label":{"type":"string","description":"The account's name in the app: its owner's email address."},"your_role":{"type":"string","enum":["owner","admin","member"]},"current":{"type":"boolean","description":"True for the account this credential is bound to."}},"additionalProperties":false,"required":["account_id","label","your_role","current"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/account/overview":{"get":{"operationId":"get_account_overview","summary":"Plan limits, subscription dates, meters and forecast","description":"Read-only overview of the account: plan and its limits, subscription status, trial allowance and end, current billing period end and any scheduled cancellation, this month's scheduled and on-demand check meters (a check is one keyword × location × device × source search), and the forecast of scheduled checks at the current configuration. Usage months are UTC. Plan changes, checkout and payment methods are only available to the owner in the app.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_account_overview","responses":{"200":{"description":"Plan limits, subscription dates, meters and forecast","content":{"application/json":{"schema":{"type":"object","properties":{"account_id":{"type":"string"},"label":{"type":"string"},"your_role":{"type":"string","enum":["owner","admin","member"]},"can_change_plan_in_app":{"type":"boolean","description":"Only the owner can change the plan, in Settings > Billing. Not available through the API."},"plan":{"type":"object","properties":{"id":{"type":"string","enum":["starter","growth","scale","business","enterprise"]},"name":{"type":"string"},"monthly_price_usd":{"anyOf":[{"type":"number"},{"type":"null"}]},"limits":{"type":"object","properties":{"projects":{"anyOf":[{"type":"integer"},{"type":"null"}]},"keywords":{"anyOf":[{"type":"integer"},{"type":"null"}]},"locations_per_project":{"anyOf":[{"type":"integer"},{"type":"null"}]},"scheduled_checks_per_month":{"anyOf":[{"type":"integer"},{"type":"null"}]},"realtime_checks_per_month":{"anyOf":[{"type":"integer"},{"type":"null"}]},"max_runs_per_day":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["projects","keywords","locations_per_project","scheduled_checks_per_month","realtime_checks_per_month","max_runs_per_day"]},"includes":{"type":"object","properties":{"rest_api":{"type":"boolean"},"mcp":{"type":"boolean"},"shopping":{"type":"boolean"}},"additionalProperties":false,"required":["rest_api","mcp","shopping"]}},"additionalProperties":false,"required":["id","name","monthly_price_usd","limits","includes"]},"status":{"type":"string","enum":["preview","trialing","active","past_due","canceled","unpaid","paused","incomplete","incomplete_expired"],"description":"Subscription status."},"trial":{"anyOf":[{"type":"object","properties":{"ends_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"scheduled_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit"]},"realtime_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit"]}},"additionalProperties":false,"required":["ends_at","scheduled_checks","realtime_checks"]},{"type":"null"}],"description":"Present while trialing: the trial allowance caps checks until the trial ends."},"billing_period":{"type":"object","properties":{"current_period_end":{"anyOf":[{"type":"string"},{"type":"null"}]},"cancel_scheduled":{"type":"boolean"},"access_ends_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When a scheduled cancellation takes effect; null when none is scheduled."}},"additionalProperties":false,"required":["current_period_end","cancel_scheduled","access_ends_at"]},"usage_period":{"type":"string","description":"Usage month, YYYY-MM in UTC. Allowances reset each month."},"scheduled_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when the plan sets no fixed limit."},"remaining":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"What can still be reserved, including any trial allowance. Null when unlimited."}},"additionalProperties":false,"required":["used","limit","remaining"]},"realtime_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when the plan sets no fixed limit."},"remaining":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"What can still be reserved, including any trial allowance. Null when unlimited."}},"additionalProperties":false,"required":["used","limit","remaining"]},"forecast":{"type":"object","properties":{"daily_scheduled_checks":{"type":"integer","description":"Scheduled checks per day at the current configuration: keywords × locations × devices × sources × runs per day."},"full_month_scheduled_checks":{"type":"integer","description":"daily_scheduled_checks × 31."},"projected_scheduled_checks":{"type":"integer","description":"Used this month plus the runs still due before the month ends (UTC)."},"fits_plan":{"type":"boolean","description":"True when both the full-month demand and the projection fit the monthly allowance."}},"additionalProperties":false,"required":["daily_scheduled_checks","full_month_scheduled_checks","projected_scheduled_checks","fits_plan"],"description":"The same forecast the app uses before accepting coverage changes."},"projects":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit"]},"keywords":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]},"activated_this_month":{"type":"integer","description":"Distinct keywords activated this month; deleting keywords does not lower it."}},"additionalProperties":false,"required":["used","limit","activated_this_month"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["account_id","label","your_role","can_change_plan_in_app","plan","status","trial","billing_period","usage_period","scheduled_checks","realtime_checks","forecast","projects","keywords"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/me/email-preferences":{"get":{"operationId":"get_email_preferences","summary":"Your product email and newsletter preferences","description":"Returns the email preferences of the person the credential acts for: optional product emails (tips, first-results and 80% usage notices) and the newsletter. Security, account, billing, service and alert emails are not optional. These preferences belong to the person, not the account.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_email_preferences","responses":{"200":{"description":"Your product email and newsletter preferences","content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","description":"The address these preferences apply to."},"product_emails":{"type":"boolean","description":"Optional product emails: getting-started tips, the first-results notice and the 80% usage notice."},"newsletter":{"type":"string","enum":["subscribed","pending","unsubscribed","none"],"description":"Newsletter status. pending waits for the confirmation email; none means never subscribed."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["email","product_emails","newsletter"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"update_email_preferences","summary":"Turn product emails or the newsletter on or off","description":"Turns optional product emails and the newsletter on or off for the person the credential acts for, with the same services as Settings > Email preferences. newsletter true records an explicit newsletter subscription: only set it when that person asked to subscribe. Omitted fields keep their value. Requires the write scope.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_email_preferences","responses":{"200":{"description":"Turn product emails or the newsletter on or off","content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","description":"The address these preferences apply to."},"product_emails":{"type":"boolean","description":"Optional product emails: getting-started tips, the first-results notice and the 80% usage notice."},"newsletter":{"type":"string","enum":["subscribed","pending","unsubscribed","none"],"description":"Newsletter status. pending waits for the confirmation email; none means never subscribed."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["email","product_emails","newsletter"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"product_emails":{"type":"boolean"},"newsletter":{"type":"boolean"}},"additionalProperties":false}}}}}},"/projects/{project_id}/google-connections":{"get":{"operationId":"list_google_connections","summary":"Your Google Ads and Search Console connections in a project","description":"Lists the Google Ads and Search Console connections that the person the credential acts for made in this project, as in the app: other people's connections are not visible to you. Connecting needs Google sign-in in the app (Settings > Connections); it cannot be done through the API. No tokens are returned.","tags":["Google"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_google_connections","responses":{"200":{"description":"Your Google Ads and Search Console connections in a project","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string","enum":["google_ads","search_console"]},"status":{"type":"string","enum":["active","error","disabled"],"description":"Only active connections can run reports; reconnect others in the app."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","type","status","created_at"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/google-connections/{connection_id}/accounts":{"get":{"operationId":"list_google_accounts","summary":"Google Ads customers or Search Console sites a connection can read","description":"Lists the Google Ads customer ids (for a google_ads connection) or Search Console properties (for a search_console connection) the connection can read, to pass to the report tools. Reads Google's data live with the connection of the person the credential acts for; nothing is saved and it uses no check allowance. Connecting or reconnecting needs Google sign-in in the app (Settings > Connections).","tags":["Google"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"connection_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The connection id from list_google_connections."},"description":"The connection id from list_google_connections."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_google_accounts","responses":{"200":{"description":"Google Ads customers or Search Console sites a connection can read","content":{"application/json":{"schema":{"type":"object","properties":{"customers":{"type":"array","items":{"type":"object","properties":{"customer_id":{"type":"string"}},"additionalProperties":false,"required":["customer_id"]}},"sites":{"type":"array","items":{"type":"object","properties":{"site_url":{"type":"string"},"permission_level":{"type":"string"}},"additionalProperties":false,"required":["site_url","permission_level"]}},"request_id":{"type":"string"}},"additionalProperties":false,"required":["customers","sites"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/google-connections/{connection_id}/ads-report":{"get":{"operationId":"run_google_ads_report","summary":"Keyword or search term performance from Google Ads","description":"Fetches a Google Ads keyword performance or search terms report for one customer and up to 31 days (from and to included). Use the keyword report to review the account's selected terms and the search-terms report to review queries recorded in that account. Rows carry clicks, impressions, cost in micros of the Google Ads account currency (divide by 1,000,000), conversions and conversion value. This is the connected customer's own advertising data; it reports that account's costs and conversions, and competitor spend cannot be inferred from it. Interpret conversions in light of the account's configured conversion actions and attribution. It is separate from saved ad observations. Page with next_page_token. Reads Google's data live with the connection of the person the credential acts for; nothing is saved and it uses no check allowance. Connecting or reconnecting needs Google sign-in in the app (Settings > Connections).","tags":["Google"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"connection_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The connection id from list_google_connections."},"description":"The connection id from list_google_connections."},{"name":"customer_id","in":"query","required":true,"schema":{"type":"string","pattern":"^(?:\\d{10}|\\d{3}-\\d{3}-\\d{4})$","description":"Customer id from list_google_accounts, such as 1234567890."},"description":"Customer id from list_google_accounts, such as 1234567890."},{"name":"login_customer_id","in":"query","required":false,"schema":{"type":"string","pattern":"^(?:\\d{10}|\\d{3}-\\d{3}-\\d{4})$","description":"Manager account id when the customer is reached through a manager."},"description":"Manager account id when the customer is reached through a manager."},{"name":"from","in":"query","required":true,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First day, YYYY-MM-DD."},"description":"First day, YYYY-MM-DD."},{"name":"to","in":"query","required":true,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last day, YYYY-MM-DD, at most 30 days after from."},"description":"Last day, YYYY-MM-DD, at most 30 days after from."},{"name":"report","in":"query","required":false,"schema":{"type":"string","enum":["keywords","search-terms"],"default":"keywords"}},{"name":"page_token","in":"query","required":false,"schema":{"type":"string","minLength":1,"maxLength":8192}}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"run_google_ads_report","responses":{"200":{"description":"Keyword or search term performance from Google Ads","content":{"application/json":{"schema":{"type":"object","properties":{"rows":{"type":"array","items":{"type":"object","properties":{"date":{"anyOf":[{"type":"string"},{"type":"null"}]},"campaign_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"campaign_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"ad_group_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"ad_group_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"keyword":{"anyOf":[{"type":"string"},{"type":"null"}]},"match_type":{"anyOf":[{"type":"string"},{"type":"null"}]},"search_term":{"anyOf":[{"type":"string"},{"type":"null"}]},"clicks":{"anyOf":[{"type":"number"},{"type":"null"}]},"impressions":{"anyOf":[{"type":"number"},{"type":"null"}]},"cost_micros":{"anyOf":[{"type":"string"},{"type":"null"}]},"conversions":{"anyOf":[{"type":"number"},{"type":"null"}]},"conversions_value":{"anyOf":[{"type":"number"},{"type":"null"}]}},"additionalProperties":false,"required":["date","campaign_id","campaign_name","ad_group_id","ad_group_name","keyword","match_type","search_term","clicks","impressions","cost_micros","conversions","conversions_value"]}},"next_page_token":{"anyOf":[{"type":"string"},{"type":"null"}]},"fetched_at":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["rows","next_page_token","fetched_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/google-connections/{connection_id}/search-console-report":{"get":{"operationId":"run_search_console_report","summary":"Search Console clicks, impressions, CTR and position","description":"Fetches Search Console performance for one property and up to 31 days (from and to included), by date, query, page, country and device. Use clicks, impressions and CTR to assess organic Google Search visibility and find queries or pages to investigate. This is organic performance, separate from paid ads and the Google Ads report. ctr = clicks / impressions (0 to 1); position is Google's average position, so read it with clicks and impressions rather than as a fixed rank. Search Console returns top rows and may omit some data even when a request succeeds. Page with start_row (next_start_row). Reads Google's data live with the connection of the person the credential acts for; nothing is saved and it uses no check allowance. Connecting or reconnecting needs Google sign-in in the app (Settings > Connections).","tags":["Google"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"connection_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"The connection id from list_google_connections."},"description":"The connection id from list_google_connections."},{"name":"site_url","in":"query","required":true,"schema":{"type":"string","minLength":1,"maxLength":2048,"description":"Property from list_google_accounts, such as https://example.com/ or sc-domain:example.com."},"description":"Property from list_google_accounts, such as https://example.com/ or sc-domain:example.com."},{"name":"from","in":"query","required":true,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First day, YYYY-MM-DD."},"description":"First day, YYYY-MM-DD."},{"name":"to","in":"query","required":true,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last day, YYYY-MM-DD, at most 30 days after from."},"description":"Last day, YYYY-MM-DD, at most 30 days after from."},{"name":"start_row","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":1000000,"default":0}},{"name":"row_limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":25000,"default":1000}}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"run_search_console_report","responses":{"200":{"description":"Search Console clicks, impressions, CTR and position","content":{"application/json":{"schema":{"type":"object","properties":{"rows":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string"},"query":{"type":"string"},"page":{"type":"string"},"country":{"type":"string"},"device":{"type":"string"},"clicks":{"type":"number"},"impressions":{"type":"number"},"ctr":{"type":"number"},"position":{"type":"number"}},"additionalProperties":false,"required":["date","query","page","country","device","clicks","impressions","ctr","position"]}},"next_start_row":{"anyOf":[{"type":"integer"},{"type":"null"}]},"fetched_at":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false,"required":["rows","next_start_row","fetched_at"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/redirect-traces":{"post":{"operationId":"trace_redirects","summary":"Queue a server-side trace of a saved ad destination","description":"Queues a trace of one destination URL that a saved ad of the project pointed to (use the url from list_keyword_ads or the observations list; other URLs are refused). Use it to inspect the recorded destination path and any affiliate IDs in that path. Our servers follow it hop by hop with a clear user agent and no cookies, recording each status code, the redirect mechanism, the final URL and any affiliate IDs present. It runs from our servers, not the searcher's country or device, so a location- or device-dependent redirect may differ. Script redirects are read from page source without running it. Each new trace uses one of the account's daily traces (resets 00:00 UTC); repeating the call for the same URL within the same UTC hour returns the same trace and uses nothing. The trace usually finishes within a minute: read it with get_redirect_chain. Requires the write scope and explicit user authorization.","tags":["Redirect chains"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"trace_redirects","responses":{"202":{"description":"Queue a server-side trace of a saved ad destination","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean","description":"False when a trace of this URL was already requested this hour."},"chain":{"type":"object","properties":{"id":{"type":"string"},"destination_url":{"type":"string","description":"The saved ad destination that was traced."},"status":{"type":"string","enum":["queued","complete","failed"]},"outcome":{"anyOf":[{"type":"string","enum":["landed","http_error","blocked","timeout","too_many_hops","loop","network_error","rate_limited","invalid_destination"]},{"type":"null"}]},"final_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The last URL requested."},"final_status":{"anyOf":[{"type":"integer"},{"type":"null"}]},"hops":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"status":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"HTTP status; null when no response arrived."},"content_type":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration_ms":{"type":"number"},"redirect":{"anyOf":[{"type":"object","properties":{"mechanism":{"type":"string","enum":["http_redirect","refresh_header","meta_refresh","script"],"description":"script means a literal location assignment read from page source without running it."},"target":{"type":"string"}},"additionalProperties":false,"required":["mechanism","target"]},{"type":"null"}],"description":"How this hop sent the visit on, and where. Null on the last hop."},"failure":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Why the hop was not requested or did not answer: unsafe_scheme, unsafe_port, credentials_in_url, private_address, unresolvable, invalid_url, timeout, network_error or rate_limited."}},"additionalProperties":false,"required":["url","status","content_type","duration_ms","redirect","failure"]}},"affiliate_signals":{"type":"array","items":{"type":"object","properties":{"hop":{"type":"integer","description":"Zero-based index of the hop whose URL carried the value."},"source":{"type":"string","enum":["project_parameter","network_pattern"],"description":"project_parameter: your configured affiliate parameter. network_pattern: a documented link format of a public affiliate network (the attribution to that network is inferred from the host and parameter)."},"network":{"anyOf":[{"type":"string"},{"type":"null"}]},"parameter":{"type":"string"},"meaning":{"anyOf":[{"type":"string"},{"type":"null"}]},"value":{"type":"string","description":"Exactly as observed, case preserved."}},"additionalProperties":false,"required":["hop","source","network","parameter","meaning","value"]},"description":"Observed values, one per hop and parameter."},"observed_flags":{"type":"array","items":{"type":"string"},"description":"Facts about the visit that limit it: script_redirect_followed, script_redirect_unrecognized, non_html, body_truncated, access_denied, varies_by_device."},"inferences":{"type":"array","items":{"type":"string"},"description":"Interpretations to review, not findings: destination_differs, cloaking_suspected, geo_or_device_dependent."},"trigger":{"type":"string","enum":["automatic","manual","api"]},"requested_at":{"type":"string"},"traced_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"total_ms":{"anyOf":[{"type":"integer"},{"type":"null"}]},"vantage":{"const":"server","description":"Traced from Ads Lighthouse servers, not from the searcher's country or device; a location- or device-dependent redirect may differ."}},"additionalProperties":false,"required":["id","destination_url","status","outcome","final_url","final_status","hops","affiliate_signals","observed_flags","inferences","trigger","requested_at","traced_at","total_ms","vantage"]},"usage":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"type":"integer"},"day":{"type":"string"}},"additionalProperties":false,"required":["used","limit","day"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","chain","usage"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","minLength":1,"maxLength":4096,"description":"The saved ad destination URL, exactly."}},"additionalProperties":false,"required":["url"]}}}}},"get":{"operationId":"list_redirect_chains","summary":"Traced redirect chains of a project","description":"Lists the project's redirect traces requested in the window, newest first, with the same fields as get_redirect_chain. Use outcome and affiliate-ID filters to find chains for follow-up review. Engine, device, system, country and location filters apply to the saved check of the ad that asked for the trace. with_affiliate_ids keeps chains where an affiliate ID was observed. A trace is one visit from our servers; any inference is a prompt to review, not proof of who placed an ad or broke a rule. Defaults to the last 30 days in the person's time zone.","tags":["Redirect chains"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"First local day, YYYY-MM-DD (custom range)."},"description":"First local day, YYYY-MM-DD (custom range)."},{"name":"to","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Last local day, YYYY-MM-DD, included in full (custom range)."},"description":"Last local day, YYYY-MM-DD, included in full (custom range)."},{"name":"time_zone","in":"query","required":false,"schema":{"type":"string","maxLength":100,"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},"description":"IANA time zone for day boundaries, such as America/New_York. Defaults to the time zone of the person the credential acts for."},{"name":"engine","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":100}],"description":"Search engine, or a list of engines combined with OR."},"description":"Search engine, or a list of engines combined with OR."},{"name":"device","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["desktop","mobile"]},{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":100}],"description":"Device, or a list combined with OR."},"description":"Device, or a list combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"outcome","in":"query","required":false,"schema":{"type":"string","enum":["landed","http_error","blocked","timeout","too_many_hops","loop","network_error","rate_limited","invalid_destination"]}},{"name":"with_affiliate_ids","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"string","enum":["true","false"]}]}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_redirect_chains","responses":{"200":{"description":"Traced redirect chains of a project","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"destination_url":{"type":"string","description":"The saved ad destination that was traced."},"status":{"type":"string","enum":["queued","complete","failed"]},"outcome":{"anyOf":[{"type":"string","enum":["landed","http_error","blocked","timeout","too_many_hops","loop","network_error","rate_limited","invalid_destination"]},{"type":"null"}]},"final_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The last URL requested."},"final_status":{"anyOf":[{"type":"integer"},{"type":"null"}]},"hops":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"status":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"HTTP status; null when no response arrived."},"content_type":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration_ms":{"type":"number"},"redirect":{"anyOf":[{"type":"object","properties":{"mechanism":{"type":"string","enum":["http_redirect","refresh_header","meta_refresh","script"],"description":"script means a literal location assignment read from page source without running it."},"target":{"type":"string"}},"additionalProperties":false,"required":["mechanism","target"]},{"type":"null"}],"description":"How this hop sent the visit on, and where. Null on the last hop."},"failure":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Why the hop was not requested or did not answer: unsafe_scheme, unsafe_port, credentials_in_url, private_address, unresolvable, invalid_url, timeout, network_error or rate_limited."}},"additionalProperties":false,"required":["url","status","content_type","duration_ms","redirect","failure"]}},"affiliate_signals":{"type":"array","items":{"type":"object","properties":{"hop":{"type":"integer","description":"Zero-based index of the hop whose URL carried the value."},"source":{"type":"string","enum":["project_parameter","network_pattern"],"description":"project_parameter: your configured affiliate parameter. network_pattern: a documented link format of a public affiliate network (the attribution to that network is inferred from the host and parameter)."},"network":{"anyOf":[{"type":"string"},{"type":"null"}]},"parameter":{"type":"string"},"meaning":{"anyOf":[{"type":"string"},{"type":"null"}]},"value":{"type":"string","description":"Exactly as observed, case preserved."}},"additionalProperties":false,"required":["hop","source","network","parameter","meaning","value"]},"description":"Observed values, one per hop and parameter."},"observed_flags":{"type":"array","items":{"type":"string"},"description":"Facts about the visit that limit it: script_redirect_followed, script_redirect_unrecognized, non_html, body_truncated, access_denied, varies_by_device."},"inferences":{"type":"array","items":{"type":"string"},"description":"Interpretations to review, not findings: destination_differs, cloaking_suspected, geo_or_device_dependent."},"trigger":{"type":"string","enum":["automatic","manual","api"]},"requested_at":{"type":"string"},"traced_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"total_ms":{"anyOf":[{"type":"integer"},{"type":"null"}]},"vantage":{"const":"server","des