sponses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"classification":{"type":"string","enum":["unclassified","competitor","authorized_retailer","affiliate","reseller","marketplace","publisher","coupon_site","other"]}},"additionalProperties":false,"required":["classification"]}}}}}},"/projects/{project_id}/keywords/{keyword_id}/report":{"get":{"operationId":"get_keyword_report","summary":"One keyword's saved checks, ads and advertisers in a window","description":"Returns one keyword's numbers for the window and filters, as in its detail page: checks_saved (search result pages saved), ads_observed (paid ad occurrences, not unique advertisers), advertiser_domains (distinct domains), and the first and last saved check. Use a brand query to review which advertisers appeared beside that monitored search, then inspect their ad messages with list_keyword_ads. checks_saved_all_time is unfiltered context, not part of the selection. Treat a small checks_saved count as limited coverage when comparing markets or periods. locations lists every location with saved checks for this keyword, with the key to pass as the location filter. Use list_observations with keyword_id for each saved check.","tags":["Keywords"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"keyword_id","in":"path","required":true,"schema":{"t