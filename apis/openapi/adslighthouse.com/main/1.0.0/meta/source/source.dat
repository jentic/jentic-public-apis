 combined with OR."},{"name":"os","in":"query","required":false,"schema":{"anyOf":[{"type":"string","enum":["windows","macos","android","ios","unspecified"]},{"type":"array","items":{"type":"string","enum":["windows","macos","android","ios","unspecified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_keyword_report","responses":{"200":{"description":"One keyword's saved checks, ads and advertisers in a window","content":{"application/json":{"schema":{"type":"object","properties":{"keyword":{"type":"object","properties":{"id":{"type":"string"},"keyword":{"type":"string"},"country":{"type":"string"},"language":{"type":"string"},"monitored":{"type":"boolean"}},"additionalProperties":false,"required":["id","keyword","country","language","monitored"]},"checks_saved":{"type":"integer"},"checks_saved_all_time":{"type":"integer"},"ads_observed":{"type":"integer"},"advertiser_domains":{"type":"integer"},"first_observed_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"last_observed_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"locations":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"name":{"type":"string"},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Null when one legacy name was saved in several countries."}},"additionalProperties":false,"required":["key","name","country"]}},"note":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A caution about sample size or configuration to repeat when reporting results."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["keyword","checks_saved","checks_saved_all_time","ads_observed","advertiser_domains","first_observed_at","last_observed_at","locations","note","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/keywords/{keyword_id}/ads":{"get":{"operationId":"list_keyword_ads","summary":"Advertisers or distinct ads seen for one keyword","description":"Lists what one keyword's saved checks found in the window and filters, 10 per page, grouped like the keyword page. view=advertisers (default): one row per advertiser domain. view=ads: one row per distinct ad (same domain, copy, display URL and full destination URL), with the ad copy, where it was seen first and last, and its automated policy review when there is one. ads_observed counts occurrences; checks_with_ads counts saved checks where the row appeared; best_position is the highest paid slot reached (1 is first). These are observations of search results, not competitor spend or proof of a policy violation. Sorts: most-observed (default), newest, oldest, name (advertisers only), top-position or lowest-position (ads only). advertiser narrows view=ads to one domain.","tags":["Keywords"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"keyword_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":100,"description":"The keyword id from list_keywords."},"description":"The keyword id from list_keywords."},{"name":"view","in":"query","required":false,"schema":{"type":"string","enum":["advertisers","ads"],"default":"advertisers"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","enum":["most-observed","newest","oldest","name","top-position","lowest-position"]}},{"name":"advertiser","in":"query","required":false,"schema":{"type":"string","minLength":3,"maxLength":253,"pattern":"^[A-Za-z0-9.-]+$","description":"Advertiser domain as it appears in list_advertisers, such as rival.example."},"description":"Advertiser domain as it appears in l