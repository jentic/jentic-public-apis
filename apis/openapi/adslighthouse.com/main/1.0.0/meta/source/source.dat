specified"]},"minItems":1,"maxItems":100}],"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},"description":"Operating system. unspecified matches checks that did not pin one. Must fit the chosen device."},{"name":"country","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^[A-Za-z]{2}$"},{"type":"array","items":{"type":"string","pattern":"^[A-Za-z]{2}$"},"minItems":1,"maxItems":100}],"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},"description":"ISO 3166-1 alpha-2 country code such as US, or a list."},{"name":"location","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},{"type":"array","items":{"type":"string","maxLength":512,"pattern":"^(code:\\d+|name:.+|country:[A-Z]{2})$"},"minItems":1,"maxItems":100}],"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},"description":"Saved location key: code:<location code>, name:<label> or country:<ISO code>. get_project_details lists the keys that have data."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_advertiser","responses":{"200":{"description":"One advertiser's metrics, category and saved ads","content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The label your team saved; not a verified company."},"classification":{"type":"string","enum":["unclassified","competitor","authorized_retailer","affiliate","reseller","marketplace","publisher","coupon_site","other"],"description":"The category your team chose on the Advertisers page; unclassified when none."},"observed_in_selection":{"type":"boolean"},"metrics":{"anyOf":[{"type":"object","properties":{"domain":{"type":"string","description":"Advertiser domain as shown in ads; not a verified company."},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The label your team saved for this domain, if any."},"is_own_domain":{"type":"boolean","description":"True for the brand's own domains."},"visibility":{"type":"number","minimum":0,"maximum":1,"description":"Share of the saved observations in the selection where this domain showed at least one ad (observations_with_ads / observations). It is not impression share, spend or proof of a purchased keyword."},"observations_with_ads":{"type":"integer"},"ads_observed":{"type":"integer","description":"Paid ad occurrences for this domain."},"keywords":{"type":"array","items":{"type":"string"}},"countries":{"type":"array","items":{"type":"string"}},"locations":{"type":"array","items":{"type":"string"}},"operating_systems":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string","enum":["affiliate","brand_mention","coupon","lookalike"]},"description":"Signals seen in the ads: affiliate markers in links, the brand named in ad copy, coupon sites or lookalike domains. Signals to review, not conclusions."},"affiliate_ids":{"type":"array","items":{"type":"string"},"description":"Your affiliate IDs seen in this domain's links."},"first_seen":{"type":"string"},"last_seen":{"type":"string"}},"additionalProperties":false,"required":["domain","name","is_own_domain","visibility","observations_with_ads","ads_observed","keywords","countries","locations","operating_systems","tags","affiliate_ids","first_seen","last_seen"]},{"type":"null"}]},"policy_reviews":{"anyOf":[{"type":"object","properties":{"reviewed_ads":{"type":"integer","description":"Saved Google ads with an automated policy review."},"likely_policy_concern":{"type":"integer"},"needs_review":{"type":"integer"},"likely_allowed":{"type":"integer"},"insufficient_evidence":{"type":"integer"},"pending":{"type":"integer","description":"Queued, not reviewed yet."},"unavailable":{"type":"integer","description":"The review could not be completed."}},"additionalProperties":false,"required":["reviewed_ads","likely_policy_concern","needs_review","likely_allowed","insufficient_evidence","pending","unavailable"],"description":"Automated first reading of ads that use the brand in their copy, against the advertising policy on trademarks and misrepresentation. It is a triage aid, not a legal finding."},{"type":"null"}],"description":"Automated policy review of this domain's saved Google ads that name the brand; null when none was reviewed. A triage aid, not a legal finding."},"observations":{"type":"integer","description":"Saved observations: the visibility denominator."},"ads":{"type":"array","items":{"type":"object","properties":{"keyword":{"type":"string"},"observed_at":{"type":"string"},"engine":{"anyOf":[{"type":"string","enum":["google","bing"]},{"type":"null"}],"description":"Null for imported studies."},"device":{"anyOf":[{"type":"string"},{"type":"null"}]},"os":{"anyOf":[{"type":"string"},{"type":"null"}]},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Null for imported studies, which record no country."},"location":{"anyOf":[{"type":"string"},{"type":"null"}]},"position":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Paid slot, 1 is the first ad; null if unknown."},"title":{"anyOf":[{"type":"string"},{"type":"null"}]},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"display_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Destination URL exactly as observed, parameters included."},"screenshot":{"anyOf":[{"type":"object","properties":{"id":{"type":"string","description":