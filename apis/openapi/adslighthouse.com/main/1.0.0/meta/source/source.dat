{"openapi":"3.1.0","jsonSchemaDialect":"https://json-schema.org/draft/2020-12/schema","info":{"title":"Ads Lighthouse API","version":"1.0.0","description":"Read account-scoped monitoring data and reports, and update project, team, alert and review workflows through the same services and limits as the app. Paid checks and redirect traces use the account's allowances. Authenticate with an API key (Authorization: Bearer als_...). The REST API is available on Scale plans and above. Each credential may make 120 requests per minute. An observation shows an ad was displayed for a search at a moment; it is not proof of a purchased keyword, spend or infringement. The same JSON operations are available as MCP tools at https://adslighthouse.com/api/v1/mcp, included in every plan. File downloads are REST endpoints. Guide: https://adslighthouse.com/api","contact":{"name":"Ads Lighthouse","url":"https://adslighthouse.com/api","email":"info@adslighthouse.com"}},"servers":[{"url":"https://adslighthouse.com/api/v1"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Account"},{"name":"Projects"},{"name":"Keywords"},{"name":"Observations"},{"name":"Reports"},{"name":"Alerts"},{"name":"Checks"}],"paths":{"/account":{"get":{"operationId":"get_account","summary":"Plan, monthly allowances, usage and rate limit","description":"Returns the plan, this month's scheduled and on-demand check usage against the allowance, project and keyword counts against the plan limits, and the API rate limit. Periods are UTC months. Use it before starting checks to confirm there is allowance left.","tags":["Account"],"parameters":[],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_account","responses":{"200":{"description":"Plan, monthly allowances, usage and rate limit","content":{"application/json":{"schema":{"type":"object","properties":{"account_id":{"type":"string"},"role":{"type":"string","enum":["owner","admin","member"],"description":"Role of the person the credential acts for."},"credential":{"type":"string","enum":["api_key","oauth"]},"scopes":{"type":"array","items":{"type":"string","enum":["read","write"]}},"plan":{"type":"object","properties":{"id":{"type":"string","enum":["starter","growth","scale","business","enterprise"]},"name":{"type":"string"},"status":{"type":"string","description":"Subscription status, such as active or trialing."},"trial_ends_at":{"anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false,"required":["id","name","status","trial_ends_at"]},"period":{"type":"string","description":"Usage month, YYYY-MM in UTC. Allowances reset each month."},"scheduled_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when the plan sets no fixed limit."},"remaining":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit","remaining"],"description":"Checks run by monitoring schedules this month."},"realtime_checks":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Null when the plan sets no fixed limit."},"remaining":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit","remaining"],"description":"On-demand checks this month, including first project runs."},"projects":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit"]},"keywords":{"type":"object","properties":{"used":{"type":"integer"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}]}},"additionalProperties":false,"required":["used","limit"]},"rate_limit":{"type":"object","properties":{"requests_per_minute":{"type":"integer"},"per":{"const":"credential"}},"additionalProperties":false,"required":["requests_per_minute","per"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["account_id","role","credential","scopes","plan","period","scheduled_checks","realtime_checks","projects","keywords","rate_limit"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects":{"get":{"operationId":"list_projects","summary":"Projects in the account","description":"Lists the account's projects. Each project is for one brand; country and language are its default market, and keywords in the project may use different markets. Search engines, devices and schedule are project settings. Other tools also accept a project's domain or exact name, so you can skip this call when you already know the brand.","tags":["Projects"],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"description":"Items per page, 1 to 200.","default":50},"description":"Items per page, 1 to 200."},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":1000,"description":"The next_cursor value from the previous page. Omit it for the first page."},"description":"The next_cursor value from the previous page. Omit it for the first page."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"list_projects","responses":{"200":{"description":"Projects in the account","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"brand":{"type":"object","properties":{"name":{"type":"string"},"domain":{"type":"string"}},"additionalProperties":false,"required":["name","domain"]},"country":{"type":"string","description":"ISO 3166-1 alpha-2 market code."},"language":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},"shopping_enabled":{"type":"boolean"},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"]},"runs_per_day":{"type":"integer"},"status":{"type":"string","enum":["active","paused"],"description":"active runs scheduled checks; paused is set to manual checks only or has no active keyword, as on the Overview projects table."},"created_at":{"type":"string"}},"additionalProperties":false,"required":["id","name","brand","country","language","search_engines","devices","shopping_enabled","monitoring_frequency","runs_per_day","status","created_at"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data","next_cursor"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"create_project","summary":"Create a project and start its first checks","description":"Creates a project for one brand with the supplied default market and immediately queues its first checks, which use the on-demand allowance: keywords × locations × devices × search engines. The initial keywords use that market; later keyword batches can use another country and language. Plan limits on projects, keywords, locations and schedule apply, exactly as in the app. Requires the write scope and an idempotency key; repeating the key returns the same project without new checks. Confirm the details with the user before calling.","tags":["Projects"],"parameters":[{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200,"pattern":"^[\\x21-\\x7e]+$","description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."},"description":"A unique value you choose for this request, such as a UUID. Repeating the same key returns the first result instead of starting paid work again."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"create_project","responses":{"201":{"description":"Create a project and start its first checks","content":{"application/json":{"schema":{"type":"object","properties":{"created":{"type":"boolean"},"project":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"brand":{"type":"object","properties":{"name":{"type":"string"},"domain":{"type":"string"}},"additionalProperties":false,"required":["name","domain"]},"country":{"type":"string","description":"ISO 3166-1 alpha-2 market code."},"language":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},"shopping_enabled":{"type":"boolean"},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"]},"runs_per_day":{"type":"integer"},"status":{"type":"string","enum":["active","paused"],"description":"active runs scheduled checks; paused is set to manual checks only or has no active keyword, as on the Overview projects table."},"created_at":{"type":"string"},"owned_domains":{"type":"array","items":{"type":"string"}},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","description":"Location code used by the location filter as code:<n>."},"name":{"type":"string"}},"additionalProperties":false,"required":["code","name"]}},"keyword_count":{"type":"integer"},"active_keyword_count":{"type":"integer"},"affiliate_tracking":{"type":"object","properties":{"configured":{"type":"boolean","description":"True when at least one affiliate URL parameter is set."},"parameter":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The first tracked parameter's name. Kept for older clients; read parameters."},"parameters":{"type":"array","items":{"type":"string"},"description":"Every tracked rule: a name (fpr, any value is the affiliate ID) or name=value (utm_source=partners, only that exact value)."},"registered_ids":{"type":"integer"}},"additionalProperties":false,"required":["configured","parameter","parameters","registered_ids"]},"data":{"type":"object","properties":{"observations":{"type":"integer","description":"Saved monitoring checks (search result pages) for this project, all time."},"latest_observation_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"engines":{"type":"array","items":{"type":"string"},"description":"Search engines with saved observations."},"devices":{"type":"array","items":{"type":"string"},"description":"Devices with saved observations."},"countries":{"type":"array","items":{"type":"string"},"description":"Countries with saved observations."},"locations":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"name":{"type":"string"},"country":{"type":"string"}},"additionalProperties":false,"required":["key","name","country"]},"description":"Location filter keys with saved observations."}},"additionalProperties":false,"required":["observations","latest_observation_at","engines","devices","countries","locations"],"description":"What actually has data, so filters can be chosen without guessing."}},"additionalProperties":false,"required":["id","name","brand","country","language","search_engines","devices","shopping_enabled","monitoring_frequency","runs_per_day","status","created_at","owned_domains","locations","keyword_count","active_keyword_count","affiliate_tracking","data"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["created","project"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":120,"description":"Project name, such as Nike US."},"brand_name":{"type":"string","minLength":1,"maxLength":120,"description":"The brand to monitor, such as Nike."},"brand_domains":{"type":"array","items":{"type":"string","minLength":1,"maxLength":253},"minItems":1,"maxItems":50,"description":"The brand's own domains. The first is the primary domain; ads from them count as yours."},"country":{"type":"string","pattern":"^[A-Za-z]{2}$","description":"Market to monitor, ISO 3166-1 alpha-2, such as US."},"language":{"type":"string","pattern":"^[a-z]{2,3}$","description":"Search language, such as en.","default":"en"},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","exclusiveMinimum":0},"name":{"type":"string","minLength":1,"maxLength":200}},"additionalProperties":false,"required":["code","name"]},"minItems":1,"maxItems":100,"description":"Locations inside the country, by location code. Omit to monitor the whole country. The plan limits how many a project may have."},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":2},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]},"minItems":1,"maxItems":2},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"],"description":"How often scheduled checks run. The plan limits the most frequent schedule.","default":"daily"},"keywords":{"type":"array","items":{"type":"string","minLength":1,"maxLength":200},"minItems":1,"maxItems":20,"description":"Search terms to monitor, such as nike running shoes."}},"additionalProperties":false,"required":["name","brand_name","brand_domains","country","keywords"]}}}}}},"/projects/{project_id}":{"get":{"operationId":"get_project_details","summary":"One project's configuration and data coverage","description":"Returns one project's brand, owned domains, default market, locations, devices, search engines, schedule and keyword counts, plus which engines, devices, countries and location keys actually have saved observations. Individual keywords may use other country and language pairs; use list_keywords to see each keyword's market. Use the data section to choose filters that can return results.","tags":["Projects"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"read","x-mcp-tool":"get_project_details","responses":{"200":{"description":"One project's configuration and data coverage","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"brand":{"type":"object","properties":{"name":{"type":"string"},"domain":{"type":"string"}},"additionalProperties":false,"required":["name","domain"]},"country":{"type":"string","description":"ISO 3166-1 alpha-2 market code."},"language":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},"shopping_enabled":{"type":"boolean"},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"]},"runs_per_day":{"type":"integer"},"status":{"type":"string","enum":["active","paused"],"description":"active runs scheduled checks; paused is set to manual checks only or has no active keyword, as on the Overview projects table."},"created_at":{"type":"string"},"owned_domains":{"type":"array","items":{"type":"string"}},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","description":"Location code used by the location filter as code:<n>."},"name":{"type":"string"}},"additionalProperties":false,"required":["code","name"]}},"keyword_count":{"type":"integer"},"active_keyword_count":{"type":"integer"},"affiliate_tracking":{"type":"object","properties":{"configured":{"type":"boolean","description":"True when at least one affiliate URL parameter is set."},"parameter":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The first tracked parameter's name. Kept for older clients; read parameters."},"parameters":{"type":"array","items":{"type":"string"},"description":"Every tracked rule: a name (fpr, any value is the affiliate ID) or name=value (utm_source=partners, only that exact value)."},"registered_ids":{"type":"integer"}},"additionalProperties":false,"required":["configured","parameter","parameters","registered_ids"]},"data":{"type":"object","properties":{"observations":{"type":"integer","description":"Saved monitoring checks (search result pages) for this project, all time."},"latest_observation_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"engines":{"type":"array","items":{"type":"string"},"description":"Search engines with saved observations."},"devices":{"type":"array","items":{"type":"string"},"description":"Devices with saved observations."},"countries":{"type":"array","items":{"type":"string"},"description":"Countries with saved observations."},"locations":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"name":{"type":"string"},"country":{"type":"string"}},"additionalProperties":false,"required":["key","name","country"]},"description":"Location filter keys with saved observations."}},"additionalProperties":false,"required":["observations","latest_observation_at","engines","devices","countries","locations"],"description":"What actually has data, so filters can be chosen without guessing."},"request_id":{"type":"string"}},"additionalProperties":false,"required":["id","name","brand","country","language","search_engines","devices","shopping_enabled","monitoring_frequency","runs_per_day","status","created_at","owned_domains","locations","keyword_count","active_keyword_count","affiliate_tracking","data"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"patch":{"operationId":"update_project","summary":"Change a project's monitoring plan, brand or affiliate settings","description":"Changes any of a project's settings, like Settings > Project: name, market (country and language), locations, devices, search engines, Shopping, schedule (monitoring_frequency; manual pauses scheduled monitoring, another value resumes it), brand name and owned domains, and the affiliate URL parameter with its registered affiliate IDs. Omitted fields keep their value; list fields replace the whole list. Coverage changes (keywords × locations × devices × sources × runs per day) are checked against the plan's limits and the account's full-month scheduled check allowance before they are saved; a change that does not fit returns quota_exceeded and nothing changes. Call preview_check_demand first to show the user the effect. No check starts now: new coverage applies to the next scheduled runs. Saved observations are never rewritten. Requires the write scope.","tags":["Projects"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"update_project","responses":{"200":{"description":"Change a project's monitoring plan, brand or affiliate settings","content":{"application/json":{"schema":{"type":"object","properties":{"updated":{"type":"array","items":{"type":"string","enum":["monitoring_plan","brand","affiliates"]},"description":"Which settings groups were saved."},"project":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"brand":{"type":"object","properties":{"name":{"type":"string"},"domain":{"type":"string"}},"additionalProperties":false,"required":["name","domain"]},"country":{"type":"string","description":"ISO 3166-1 alpha-2 market code."},"language":{"type":"string"},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]}},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]}},"shopping_enabled":{"type":"boolean"},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"]},"runs_per_day":{"type":"integer"},"status":{"type":"string","enum":["active","paused"],"description":"active runs scheduled checks; paused is set to manual checks only or has no active keyword, as on the Overview projects table."},"created_at":{"type":"string"},"owned_domains":{"type":"array","items":{"type":"string"}},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","description":"Location code used by the location filter as code:<n>."},"name":{"type":"string"}},"additionalProperties":false,"required":["code","name"]}},"keyword_count":{"type":"integer"},"active_keyword_count":{"type":"integer"},"affiliate_tracking":{"type":"object","properties":{"configured":{"type":"boolean","description":"True when at least one affiliate URL parameter is set."},"parameter":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The first tracked parameter's name. Kept for older clients; read parameters."},"parameters":{"type":"array","items":{"type":"string"},"description":"Every tracked rule: a name (fpr, any value is the affiliate ID) or name=value (utm_source=partners, only that exact value)."},"registered_ids":{"type":"integer"}},"additionalProperties":false,"required":["configured","parameter","parameters","registered_ids"]},"data":{"type":"object","properties":{"observations":{"type":"integer","description":"Saved monitoring checks (search result pages) for this project, all time."},"latest_observation_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"engines":{"type":"array","items":{"type":"string"},"description":"Search engines with saved observations."},"devices":{"type":"array","items":{"type":"string"},"description":"Devices with saved observations."},"countries":{"type":"array","items":{"type":"string"},"description":"Countries with saved observations."},"locations":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"name":{"type":"string"},"country":{"type":"string"}},"additionalProperties":false,"required":["key","name","country"]},"description":"Location filter keys with saved observations."}},"additionalProperties":false,"required":["observations","latest_observation_at","engines","devices","countries","locations"],"description":"What actually has data, so filters can be chosen without guessing."}},"additionalProperties":false,"required":["id","name","brand","country","language","search_engines","devices","shopping_enabled","monitoring_frequency","runs_per_day","status","created_at","owned_domains","locations","keyword_count","active_keyword_count","affiliate_tracking","data"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["updated","project"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":120,"description":"Project name, such as Nike US."},"country":{"type":"string","pattern":"^[A-Za-z]{2}$","description":"Market, ISO 3166-1 alpha-2 such as US. Changing it without locations monitors the whole new country."},"language":{"type":"string","pattern":"^[a-z]{2,3}$","description":"Search language, such as en."},"locations":{"type":"array","items":{"type":"object","properties":{"code":{"type":"integer","exclusiveMinimum":0,"description":"Location code from search_locations."},"name":{"type":"string","minLength":1,"maxLength":200}},"additionalProperties":false,"required":["code","name"]},"minItems":1,"maxItems":100,"description":"The full list of locations inside the country, replacing the current list. Use search_locations to find codes. The plan limits how many a project may have."},"devices":{"type":"array","items":{"type":"string","enum":["desktop","mobile"]},"minItems":1,"maxItems":2,"description":"The full list of devices to check."},"search_engines":{"type":"array","items":{"type":"string","enum":["google","bing"]},"maxItems":2,"description":"The full list of search engines. May be empty only when shopping_enabled is true. The market must offer each engine (get_monitoring_options)."},"shopping_enabled":{"type":"boolean","description":"Also check Google Shopping ads. Needs a plan that includes Shopping and a market with Google."},"monitoring_frequency":{"type":"string","enum":["manual","daily","twice_daily","four_times_daily","six_times_daily","twelve_times_daily"],"description":"How often scheduled checks run. manual pauses scheduled monitoring (on-demand checks still work); any other value resumes it. The plan limits the most frequent schedule."},"brand_name":{"type":"string","minLength":1,"maxLength":120,"description":"The brand to monitor, such as Nike."},"owned_domains":{"type":"array","items":{"type":"string","minLength":1,"maxLength":253},"minItems":1,"maxItems":50,"description":"The full list of the brand's own domains; the first is the primary domain. Ads from these domains and their subdomains count as the brand's own."},"affiliate_parameter":{"anyOf":[{"type":"string","maxLength":64},{"type":"null"}],"description":"Older single-parameter form: one parameter name, such as affiliate_id, replacing every tracked parameter. null or an empty string turns affiliate identification off. Prefer affiliate_parameters."},"affiliate_parameters":{"type":"array","items":{"type":"string","maxLength":321},"maxItems":20,"description":"The full list of tracked affiliate parameters, replacing the current list. Each is a name, such as fpr (any value in the URL is the affiliate ID), or name=value, such as utm_source=partners (only that exact value). An empty list turns affiliate identification off. Do not send full URLs."},"affiliate_ids":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":256,"description":"The affiliate ID as it appears in URLs."},"name":{"type":"string","minLength":1,"maxLength":120,"description":"Who the ID belongs to."}},"additionalProperties":false,"required":["id","name"]},"maxItems":200,"description":"The full list of your registered affiliate IDs, replacing the current list."}},"additionalProperties":false}}}}},"delete":{"operationId":"delete_project","summary":"Permanently delete a project and its saved data","description":"Permanently deletes a project with its brand, keywords, queued checks and saved observations, exactly like Delete project in Settings > Project. It cannot be undone. It does not return this month's keyword allowance or checks already used. confirm_name must be the project's exact name, as in the app's confirmation. Requires the write scope; always confirm with the user first.","tags":["Projects"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"confirm_name","in":"query","required":true,"schema":{"type":"string","minLength":1,"maxLength":120,"description":"The project's exact name, to confirm the deletion."},"description":"The project's exact name, to confirm the deletion."}],"security":[{"bearerAuth":[]}],"x-required-scope":"write","x-mcp-tool":"delete_project","responses":{"200":{"description":"Permanently delete a project and its saved data","content":{"application/json":{"schema":{"type":"object","properties":{"deleted":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false,"required":["id","name"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["deleted"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}}},"/projects/{project_id}/keywords":{"get":{"operationId":"list_keywords","summary":"Monitored keywords with saved checks and ads in a window","description":"Lists a project's keywords with their own country and language, which may differ from the project's default market. For each, checks_saved counts saved search result pages and ads_observed counts paid ad occurrences in the window and filters. ads_observed is not a count of unique advertisers. Defaults to the last 30 days.","tags":["Keywords"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":253,"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},"description":"The project: its id, its brand domain (for example nike.example) or its exact project or brand name. Unknown or ambiguous references return not_found; call list_projects then."},{"name":"range","in":"query","required":false,"schema":{"type":"string","enum":["7d","14d","30d","12m","custom"],"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},"description":"Window ending today: 7d, 14d, 30d (default) or 12m. Use custom with from and to for fixed dates."},{"name":"from","in":"query","required":false,"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}