 and filters."},"ads_observed":{"type":"integer","description":"Paid ad occurrences saved for this keyword in the window and filters. One advertiser seen in ten checks counts ten times; this is not a count of unique advertisers."}},"additionalProperties":false,"required":["id","keyword","country","language","monitored","created_at","checks_saved","ads_observed"]}},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass as cursor to get the next page; null on the last page."},"window":{"type":"object","properties":{"from":{"type":"string","description":"First local day included, YYYY-MM-DD."},"to":{"type":"string","description":"Last local day included, YYYY-MM-DD."},"time_zone":{"type":"string"},"start":{"type":"string","description":"Inclusive start instant, ISO 8601."},"end":{"type":"string","description":"Exclusive end instant, ISO 8601."}},"additionalProperties":false,"required":["from","to","time_zone","start","end"]},"request_id":{"type":"string"}},"additionalProperties":false,"required":["data","next_cursor","window"]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"503":{"$ref":"#/components/responses/Error503"}}},"post":{"operationId":"add_keywords","summary":"Add keywords to a project","description":"Adds up to 20 search terms to a project. The optional country and language apply to every new keyword in this call and default to the project's market; existing terms are skipped and keep their saved market. New keywords count toward the plan's keyword limit and this month's keyword allowance, and are checked on the project's schedule; no check starts immediately. Requires the write scope.","tags":["Keywords"],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"st