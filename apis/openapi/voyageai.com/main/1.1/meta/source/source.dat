              "language": "shell",
              "code": "curl -X POST https://api.voyageai.com/v1/files/delete \\\n  -H \"Authorization: Bearer $VOYAGE_API_KEY\" \\\n  -H \"content-type: application/json\" \\\n  -d ' \n  {\n    \"file_ids\": [\n      \"file-abc123\",\n      \"file-def456\",\n      \"file-ghi789\"\n    ]\n  }"
