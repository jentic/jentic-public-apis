{
  "openapi": "3.1.0",
  "info": {
    "title": "Золотые пески — Booking & Chat API",
    "version": "1.0.0",
    "description": "Полная спецификация v1.0 (ноябрь 2025)",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/justproject174/bazaturgoyak/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.zolotye-peski.ru/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ClientInput": {
        "type": "object",
        "required": [
          "fullName",
          "phone"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Иванов Иван Иванович"
          },
          "phone": {
            "type": "string",
            "example": "+79991234567"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "example": "ivan@example.com"
          },
          "telegramId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "RentalObjectType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Мангальная зона"
          },
          "slug": {
            "type": "string",
            "example": "bbq"
          },
          "isAccommodations": {
            "type": "boolean"
          }
        }
      },
      "RentalObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Мангальная зона №8"
          },
          "internalCode": {
            "type": "string",
            "example": "BBQ-8"
          },
          "type": {
            "$ref": "#/components/schemas/RentalObjectType"
          },
          "capacity": {
            "type": "integer",
            "example": 12
          },
          "basePricePerDay": {
            "type": "number",
            "format": "float",
            "example": 2500.0
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "objectId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "isFree": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "HoldResponse": {
        "type": "object",
        "properties": {
          "holdId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string",
            "example": "Объект зарезервирован на 20 минут"
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "hold",
              "pending",
              "confirmed",
              "paid"
            ]
          },
          "object": {
            "$ref": "#/components/schemas/RentalObject"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "guestsCount": {
            "type": "integer"
          },
          "totalAmount": {
            "type": "number",
            "example": 15000.0
          },
          "discountAmount": {
            "type": "number",
            "example": 1500.0
          },
          "finalAmount": {
            "type": "number",
            "example": 13500.0
          },
          "bonusesUsed": {
            "type": "integer",
            "example": 500
          },
          "paymentUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentCreateResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "paymentUrl": {
            "type": "string",
            "example": "https://yoomoney.ru/to/41001..."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientName": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "telegram",
              "vk",
              "avito",
              "web"
            ]
          },
          "lastMessage": {
            "type": "string"
          },
          "lastMessageAt": {
            "type": "string",
            "format": "date-time"
          },
          "unreadCount": {
            "type": "integer"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "isFromClient": {
            "type": "boolean"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/objects/types": {
      "get": {
        "summary": "Все типы объектов (домики, бани, мангалы и т.д.)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RentalObjectType"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/objects/availability": {
      "get": {
        "summary": "Календарь доступности (для виджета и бота)",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "typeSlug",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Массив по дням",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AvailabilityResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bookings/hold": {
      "post": {
        "summary": "Временный резерв объекта (20 минут)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "objectId",
                  "startDate",
                  "endDate"
                ],
                "properties": {
                  "objectId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "client": {
                    "$ref": "#/components/schemas/ClientInput"
                  },
                  "sessionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/schemas/HoldResponse"
          },
          "409": {
            "description": "Объект уже зарезервирован/занят"
          }
        }
      }
    },
    "/bookings/create": {
      "post": {
        "summary": "Финальное создание брони (с расчётом цены и оплатой)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "objectId",
                  "startDate",
                  "endDate",
                  "client"
                ],
                "properties": {
                  "holdId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "objectId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "guestsCount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "promoCode": {
                    "type": "string",
                    "nullable": true
                  },
                  "useBonuses": {
                    "type": "boolean",
                    "default": false
                  },
                  "client": {
                    "$ref": "#/components/schemas/ClientInput"
                  },
                  "comment": {
                    "type": "string",
                    "nullable": true
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "site",
                      "telegram",
                      "vk",
                      "avito",
                      "admin"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Бронь создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/yoomoney/create": {
      "post": {
        "summary": "Создать платёж ЮKassa",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookingId"
                ],
                "properties": {
                  "bookingId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "returnUrl": {
                    "type": "string",
                    "example": "https://zolotye-peski.ru/thanks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/schemas/PaymentCreateResponse"
          }
        }
      }
    },
    "/payments/yoomoney/webhook": {
      "post": {
        "summary": "Webhook от ЮKassa",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/chats/conversations": {
      "get": {
        "summary": "Все активные диалоги",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Conversation"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chats/{conversationId}/messages": {
      "get": {
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Message"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chats/{conversationId}/send": {
      "post": {
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сообщение отправлено"
          }
        }
      }
    },
    "/webhook/telegram": {
      "post": {
        "summary": "Telegram Bot",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/webhook/vk": {
      "post": {
        "summary": "VK Messages",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/webhook/avito": {
      "post": {
        "summary": "Avito",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
