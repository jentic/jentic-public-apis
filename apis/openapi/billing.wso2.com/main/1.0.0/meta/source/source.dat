{
  "openapi": "3.0.3",
  "info": {
    "title": "WSO2 Cloud Billing API - User Portal",
    "version": "1.0.0",
    "description": "User-facing API for WSO2 Cloud Billing Portal. This API enables customers to manage\ntheir subscriptions, billing accounts, payment methods, and view invoices.\n\n## Authentication Flow\nAll API requests are routed through an API Gateway:\n1. Client sends request with `Authorization: Bearer <user-token>` header\n2. API Gateway validates user token and scope authorization\n3. Gateway passes backend JWT via `X-JWT-Assertion` header to Billing Service\n4. Billing Service validates backend JWT and extracts user/organization context\n5. All operations automatically scoped to organization from JWT token\n\n## Products Supported\n- **Devant** - API Management Platform\n- **Bijira** - Integration Platform\n- **Agent** - AI Agent Platform\n\n## Subscription Channels\n- **Direct** - Direct billing through Stripe\n- **AWS Marketplace** - Billing through AWS\n- **Azure Marketplace** - Billing through Azure\n- **GCP Marketplace** - Billing through GCP\n\n## Billing Periods\nPlans support monthly or annual billing cycles.\n",
    "contact": {
      "name": "WSO2 Cloud Billing Team",
      "email": "cloud-billing@wso2.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/sumedha/CloudBilling/1.0.0"
  },
  "servers": [
    {
      "url": "https://billing.wso2.com/api/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Plans",
      "description": "View available subscription plans"
    },
    {
      "name": "Subscriptions",
      "description": "Manage organization subscriptions"
    },
    {
      "name": "Billing Accounts",
      "description": "Manage billing accounts"
    },
    {
      "name": "Payment Methods",
      "description": "Manage payment methods"
    },
    {
      "name": "Invoices",
      "description": "View and download invoices"
    },
    {
      "name": "Usage",
      "description": "View usage and cost data"
    },
    {
      "name": "Entitlements",
      "description": "Check entitlements and quotas"
    },
    {
      "name": "Promo Codes",
      "description": "Validate promotional codes"
    }
  ],
  "paths": {
    "/plans": {
      "get": {
        "tags": [
          "Plans"
        ],
        "summary": "List available subscription plans",
        "description": "Retrieve available subscription plans for WSO2 Cloud products.\nPlans include pricing, entitlements, and feature details.\n",
        "operationId": "listPlans",
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "description": "Filter plans by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          {
            "name": "billing_period",
            "in": "query",
            "description": "Filter plans by billing period",
            "schema": {
              "type": "string",
              "enum": [
                "monthly",
                "annual"
              ],
              "default": "monthly"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of available plans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plans": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Plan"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/plans/{plan_code}": {
      "get": {
        "tags": [
          "Plans"
        ],
        "summary": "Get plan details",
        "description": "Retrieve detailed information about a specific plan",
        "operationId": "getPlan",
        "parameters": [
          {
            "name": "plan_code",
            "in": "path",
            "required": true,
            "description": "Plan code (e.g., 'free', 'payg', 'enterprise')",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plan details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/subscriptions": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "List organization subscriptions",
        "description": "Retrieve all subscriptions for the authenticated organization.\n\nEvery organization has at least one default free subscription per product,\ncreated automatically when the organization is created. Additional subscriptions\nare created when upgrading to paid plans.\n",
        "operationId": "listSubscriptions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by subscription status",
            "schema": {
              "type": "string",
              "enum": [
                "inactive",
                "active",
                "trial",
                "past_due",
                "suspended",
                "cancelled"
              ]
            }
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Filter by subscription channel",
            "schema": {
              "type": "string",
              "enum": [
                "internal",
                "stripe",
                "aws_marketplace",
                "azure_marketplace",
                "gcp_marketplace",
                "wire"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subscriptions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Subscription"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Upgrade to a paid plan",
        "description": "Upgrade the organization's subscription to a paid plan.\n\n**Default Free Subscription:**\nEvery organization automatically gets a default free subscription when created.\nThis subscription becomes active on first login to the product. The free plan\nhas default entitlements and quotas.\n\n**Trial Period:**\nWhen upgrading to a paid plan, a trial period may be available (product-specific):\n- Trial duration is determined by product configuration\n- Some products may not offer trials\n- Some products allow free tier usage indefinitely\n- Trial status included in subscription response\n\n**Upgrading:**\n- Use this endpoint to upgrade from free to a paid plan\n- Payment method required for paid plans (unless trial offered)\n- Subscription transitions: `active` (free) → `trial` (if offered) → `active` (paid)\n\n**After Trial:**\n- If payment method added: Automatically converts to paid `active`\n- If no payment method: Subscription becomes `suspended`\n- Use PATCH /subscriptions/{id} to add payment method during/after trial\n\n**Marketplace Subscriptions:**\nFor marketplace channels, subscriptions are activated via marketplace\nwebhooks. This endpoint is only for Stripe subscriptions.\n",
        "operationId": "createSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/subscriptions/{subscription_id}": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Get subscription details",
        "description": "Retrieve detailed information about a specific subscription",
        "operationId": "getSubscription",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Update subscription",
        "description": "Update a subscription. Supports:\n- **Plan change**: Upgrade or downgrade to a different plan\n- **Billing period change**: Switch between monthly and annual\n- **Payment method change**: Update the payment method\n\nPlan changes may trigger prorated charges or credits.\n",
        "operationId": "updateSubscription",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Cancel subscription",
        "description": "Cancel a subscription. The subscription will remain active until the\nend of the current billing period unless immediate cancellation is requested.\n",
        "operationId": "cancelSubscription",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/billing-accounts": {
      "get": {
        "tags": [
          "Billing Accounts"
        ],
        "summary": "List billing accounts",
        "description": "Retrieve all billing accounts for the organization",
        "operationId": "listBillingAccounts",
        "responses": {
          "200": {
            "description": "List of billing accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BillingAccount"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Billing Accounts"
        ],
        "summary": "Create billing account",
        "description": "Create a new billing account for the organization.\nRequired for Stripe and wire transfer subscriptions.\n",
        "operationId": "createBillingAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBillingAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Billing account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/billing-accounts/{billing_account_id}": {
      "get": {
        "tags": [
          "Billing Accounts"
        ],
        "summary": "Get billing account details",
        "operationId": "getBillingAccount",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Billing account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingAccount"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Billing Accounts"
        ],
        "summary": "Update billing account",
        "operationId": "updateBillingAccount",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBillingAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Billing account updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Billing Accounts"
        ],
        "summary": "Delete billing account",
        "description": "Delete a billing account and all associated payment methods.\n\n**Deletion Rules:**\n- ✅ Payment methods will be automatically detached and removed from Stripe\n- ❌ Cannot delete if there are active subscriptions using this billing account\n- ❌ Cannot delete if there are pending/unpaid invoices for this billing account\n\n**Workflow:**\n1. Check for blocking resources (active subscriptions, pending invoices)\n2. If found, return 409 Conflict with details\n3. If checks pass, detach all payment methods from Stripe\n4. Delete all payment method records\n5. Delete the billing account\n6. Return 204 No Content\n\nIf the billing account cannot be deleted, the response will include details\nabout which resources are blocking the deletion.\n",
        "operationId": "deleteBillingAccount",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Billing account and associated payment methods deleted successfully"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - billing account cannot be deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Cannot delete billing account"
                    },
                    "message": {
                      "type": "string",
                      "example": "Billing account has 2 active subscriptions and 1 pending invoice"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "active_subscriptions": {
                          "type": "integer",
                          "example": 2,
                          "description": "Number of active subscriptions using this billing account"
                        },
                        "pending_invoices": {
                          "type": "integer",
                          "example": 1,
                          "description": "Number of unpaid invoices for this billing account"
                        },
                        "payment_methods_count": {
                          "type": "integer",
                          "example": 3,
                          "description": "Number of payment methods that will be deleted (informational)"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/billing-accounts/{billing_account_id}/payment-methods": {
      "get": {
        "tags": [
          "Payment Methods"
        ],
        "summary": "List payment methods",
        "description": "Get all payment methods for a billing account",
        "operationId": "listPaymentMethods",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of payment methods",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment_methods": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PaymentMethod"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Payment Methods"
        ],
        "summary": "Attach payment method",
        "description": "Attach a payment method to a billing account.\nThe payment method must be created through Stripe first.\n",
        "operationId": "attachPaymentMethod",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttachPaymentMethodRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment method attached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethod"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/billing-accounts/{billing_account_id}/payment-methods/{payment_method_id}": {
      "patch": {
        "tags": [
          "Payment Methods"
        ],
        "summary": "Update payment method",
        "description": "Update payment method settings (e.g., set as default)",
        "operationId": "updatePaymentMethod",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "payment_method_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment method updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethod"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Payment Methods"
        ],
        "summary": "Detach payment method",
        "description": "Remove a payment method from a billing account.\n\n**Deletion Rules:**\n- ❌ Cannot detach if this is the default payment method\n- ❌ Cannot detach if being used for any active subscription payments\n- ✅ Can detach if not default and not in use\n\n**Workflow:**\n1. Check if payment method is the default for the billing account\n2. Check if payment method is being used for any active subscriptions\n3. If either check fails, return 409 Conflict with details\n4. If checks pass, detach from Stripe and delete record\n5. Return 204 No Content\n",
        "operationId": "detachPaymentMethod",
        "parameters": [
          {
            "name": "billing_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "payment_method_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Payment method detached successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - payment method cannot be detached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "payment_method_in_use"
                    },
                    "message": {
                      "type": "string",
                      "example": "Cannot detach payment method"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "is_default": {
                          "type": "boolean",
                          "description": "Whether this is the default payment method"
                        },
                        "active_subscriptions_count": {
                          "type": "integer",
                          "description": "Number of active subscriptions using this payment method"
                        },
                        "subscription_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "description": "IDs of subscriptions using this payment method"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "List invoices",
        "description": "Retrieve invoices for the organization",
        "operationId": "listInvoices",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by invoice status",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "pending",
                "paid",
                "void",
                "uncollectible"
              ]
            }
          },
          {
            "name": "from_date",
            "in": "query",
            "description": "Filter invoices from this date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "description": "Filter invoices up to this date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-based)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of invoices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/invoices/{invoice_id}": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Get invoice details",
        "operationId": "getInvoice",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/invoices/{invoice_id}/download": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Download invoice PDF",
        "operationId": "downloadInvoice",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/usage/current": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get current period usage",
        "description": "Get usage data for the current billing period",
        "operationId": "getCurrentUsage",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "query",
            "description": "Filter by subscription ID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current usage data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/usage/history": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get usage history",
        "description": "Get historical usage data",
        "operationId": "getUsageHistory",
        "parameters": [
          {
            "name": "months",
            "in": "query",
            "description": "Number of months of history (default 12)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "months": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MonthlyUsage"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/cost/summary": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get cost summary",
        "description": "Get cost summary for the current or specified month",
        "operationId": "getCostSummary",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "description": "Month in YYYY-MM format (default current month)",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cost summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/cost/breakdown": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get cost breakdown by project",
        "description": "Get cost breakdown by project for the organization",
        "operationId": "getCostBreakdown",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "description": "Month in YYYY-MM format (default current month)",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max number of projects to return",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cost breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostBreakdown"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/entitlements": {
      "get": {
        "tags": [
          "Entitlements"
        ],
        "summary": "Get current entitlements",
        "description": "Get entitlements for the organization based on active subscriptions",
        "operationId": "getEntitlements",
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "description": "Filter by product",
            "schema": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current entitlements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/entitlements/check": {
      "post": {
        "tags": [
          "Entitlements"
        ],
        "summary": "Check entitlement",
        "description": "Check if an action is allowed based on current entitlements",
        "operationId": "checkEntitlement",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntitlementCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entitlement check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/promo-codes/validate": {
      "post": {
        "tags": [
          "Promo Codes"
        ],
        "summary": "Validate promo code",
        "description": "Check if a promotional code is valid and get discount details",
        "operationId": "validatePromoCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromoCodeValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Promo code validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromoCodeValidationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/credits": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get credit balance",
        "description": "Get current credit balance for the organization",
        "operationId": "getCreditBalance",
        "responses": {
          "200": {
            "description": "Credit balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditBalance"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from WSO2 Identity Server. User sends this token in Authorization header.\nAPI Gateway validates this token, then passes a backend JWT via X-JWT-Assertion header\nto the Billing Service with user/organization context.\n\n**Note**: The Billing Service receives the X-JWT-Assertion header from API Gateway,\nnot the original Authorization header. This spec documents the user-facing API.\n"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          },
          "has_next": {
            "type": "boolean"
          },
          "has_previous": {
            "type": "boolean"
          }
        }
      },
      "Plan": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "products",
          "billing_period",
          "base_price",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "payg"
          },
          "name": {
            "type": "string",
            "example": "Pay As You Go"
          },
          "description": {
            "type": "string"
          },
          "display_order": {
            "type": "integer",
            "description": "Order for UI display (lower numbers appear first)",
            "example": 1
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          "billing_period": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ]
          },
          "base_price": {
            "type": "string",
            "example": 0.0
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "entitlements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanEntitlement"
            }
          },
          "metered_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeteredItem"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanFeature"
            }
          }
        }
      },
      "PlanEntitlement": {
        "type": "object",
        "properties": {
          "resource_type": {
            "type": "string",
            "example": "component"
          },
          "limit": {
            "type": "integer",
            "nullable": true,
            "description": "Null means unlimited",
            "example": 10
          },
          "description": {
            "type": "string",
            "example": "Maximum number of components"
          }
        }
      },
      "MeteredItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "API Requests"
          },
          "unit": {
            "type": "string",
            "example": "requests"
          },
          "included_quantity": {
            "type": "integer",
            "example": 100000
          },
          "price_per_unit": {
            "type": "string",
            "example": 0.001
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PricingTier"
            }
          }
        }
      },
      "PricingTier": {
        "type": "object",
        "properties": {
          "up_to": {
            "type": "integer",
            "nullable": true
          },
          "price_per_unit": {
            "type": "string"
          }
        }
      },
      "PlanFeature": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "plan",
          "status",
          "channel",
          "billing_period"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "org_id": {
            "type": "string",
            "format": "uuid"
          },
          "billing_account_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Billing account for this subscription.\n- Null for free tier subscriptions\n- Set when upgrading to a paid plan\n- Multiple subscriptions can share the same billing account\n"
          },
          "billing_account": {
            "$ref": "#/components/schemas/BillingAccountSummary"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanSummary"
          },
          "status": {
            "type": "string",
            "enum": [
              "inactive",
              "active",
              "trial",
              "past_due",
              "suspended",
              "cancelled"
            ],
            "description": "Subscription status:\n- `inactive`: Default subscription created, not yet activated (before first login)\n- `active`: Active subscription (free or paid)\n- `trial`: Trial period active (product-specific trial days)\n- `past_due`: Payment failed, grace period active\n- `suspended`: Trial ended without payment, or payment failed beyond grace period\n- `cancelled`: User cancelled subscription\n"
          },
          "channel": {
            "type": "string",
            "enum": [
              "internal",
              "stripe",
              "aws_marketplace",
              "azure_marketplace",
              "gcp_marketplace",
              "wire"
            ]
          },
          "billing_period": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ]
          },
          "current_period_start": {
            "type": "string",
            "format": "date-time"
          },
          "current_period_end": {
            "type": "string",
            "format": "date-time"
          },
          "trial": {
            "$ref": "#/components/schemas/TrialInfo"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethodSummary"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlanSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "TrialInfo": {
        "type": "object",
        "properties": {
          "trial_end": {
            "type": "string",
            "format": "date-time"
          },
          "days_remaining": {
            "type": "integer"
          },
          "auto_convert_to_paid": {
            "type": "boolean"
          },
          "requires_payment_method": {
            "type": "boolean"
          }
        }
      },
      "CreateSubscriptionRequest": {
        "type": "object",
        "required": [
          "plan_code",
          "products"
        ],
        "properties": {
          "plan_code": {
            "type": "string",
            "example": "payg"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "devant",
                "bijira",
                "agent"
              ]
            }
          },
          "billing_period": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ],
            "default": "monthly"
          },
          "payment_method_id": {
            "type": "string",
            "description": "Stripe payment method ID for paid plans.\nOptional if product offers trial period - can be added later via PATCH.\nRequired if product does not offer trials.\n"
          },
          "promo_code": {
            "type": "string",
            "description": "Promotional code to apply"
          }
        }
      },
      "UpdateSubscriptionRequest": {
        "type": "object",
        "properties": {
          "plan_code": {
            "type": "string"
          },
          "billing_period": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ]
          },
          "billing_account_id": {
            "type": "string",
            "format": "uuid",
            "description": "Billing account to use for this subscription.\nRequired when upgrading from free to paid plan.\nCan use an existing billing account or create a new one first.\n"
          },
          "payment_method_id": {
            "type": "string",
            "description": "Stripe payment method ID (deprecated - use billing account instead)"
          }
        }
      },
      "CancelSubscriptionRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Reason for cancellation"
          },
          "feedback": {
            "type": "string",
            "description": "Additional feedback"
          },
          "cancel_immediately": {
            "type": "boolean",
            "default": false,
            "description": "Cancel immediately instead of at period end"
          }
        }
      },
      "BillingAccount": {
        "type": "object",
        "description": "Billing account for an organization. Customer PII (name, email, address)\nis NOT stored here - it's only stored in Stripe.\n",
        "required": [
          "id",
          "org_id",
          "channel",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "org_id": {
            "type": "string",
            "format": "uuid",
            "description": "Organization this billing account belongs to"
          },
          "channel": {
            "type": "string",
            "enum": [
              "internal",
              "stripe",
              "aws_marketplace",
              "azure_marketplace",
              "gcp_marketplace",
              "wire"
            ],
            "description": "Payment channel for this billing account:\n- `stripe`: Stripe billing (credit card)\n- `aws_marketplace`, `azure_marketplace`, `gcp_marketplace`: Marketplace billing\n- `wire`: Wire transfer billing (enterprise)\n"
          },
          "external_customer_id": {
            "type": "string",
            "description": "External customer identifier for the payment channel:\n- Stripe: Stripe customer ID (e.g., `cus_xxx`)\n- AWS Marketplace: AWS customer identifier\n- Azure Marketplace: Azure subscription ID\n- GCP Marketplace: GCP account ID\n- Wire: Internal reference (optional)\n"
          },
          "is_default": {
            "type": "boolean",
            "description": "Whether this is the default billing account for the org"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "closed"
            ]
          },
          "default_payment_method_id": {
            "type": "string",
            "description": "Default payment method for this billing account (Stripe channel only)"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-defined metadata (e.g., department, cost center)",
            "example": {
              "department": "Engineering",
              "cost_center": "CC-1234"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BillingAccountSummary": {
        "type": "object",
        "description": "Summary of billing account (embedded in subscription response)",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "internal",
              "stripe",
              "aws_marketplace",
              "azure_marketplace",
              "gcp_marketplace",
              "wire"
            ]
          },
          "is_default": {
            "type": "boolean"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "country_code"
        ],
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      },
      "CreateBillingAccountRequest": {
        "type": "object",
        "description": "Request to create a billing account. For 'stripe' channel, customer details\n(name, email) are required and will be passed to Stripe to create a customer.\nThese details are NOT stored locally. For marketplace channels, these fields\nare optional as billing is handled by the marketplace.\n",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Customer name for Stripe. Required for 'stripe' channel."
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com",
            "description": "Customer email for Stripe. Required for 'stripe' channel."
          },
          "phone": {
            "type": "string",
            "example": "+1-555-123-4567",
            "description": "Customer phone number for Stripe. Optional."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "department": "Engineering",
              "cost_center": "CC-1234"
            },
            "description": "User-defined metadata stored with the billing account (e.g., department, cost center). This is stored in the billing database for organizational purposes."
          },
          "is_default": {
            "type": "boolean",
            "default": false,
            "description": "Whether to set this as the default billing account"
          }
        }
      },
      "UpdateBillingAccountRequest": {
        "type": "object",
        "description": "Update billing account details. All fields are optional - only provided fields will be updated.\nFor 'stripe' channel accounts, name, email, phone, and address updates will also sync to Stripe.\n",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Customer name. Will be synced to Stripe for 'stripe' channel accounts."
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com",
            "description": "Customer email. Will be synced to Stripe for 'stripe' channel accounts."
          },
          "phone": {
            "type": "string",
            "example": "+1-555-123-4567",
            "description": "Customer phone number. Will be synced to Stripe for 'stripe' channel accounts."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "is_default": {
            "type": "boolean",
            "description": "Whether to set this as the default billing account"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-defined metadata to merge with existing metadata. Existing keys will be replaced, new keys will be added.",
            "example": {
              "department": "Engineering",
              "cost_center": "CC-1234"
            }
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "card",
              "bank_account"
            ]
          },
          "is_default": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "requires_action"
            ]
          },
          "card": {
            "$ref": "#/components/schemas/CardDetails"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CardDetails": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "example": "visa"
          },
          "last_four": {
            "type": "string",
            "example": "4242"
          },
          "exp_month": {
            "type": "integer"
          },
          "exp_year": {
            "type": "integer"
          }
        }
      },
      "PaymentMethodSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "last_four": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          }
        }
      },
      "AttachPaymentMethodRequest": {
        "type": "object",
        "required": [
          "payment_method_id"
        ],
        "properties": {
          "payment_method_id": {
            "type": "string",
            "description": "Stripe payment method ID"
          },
          "is_default": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "number",
          "status",
          "amount_due",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string",
            "example": "INV-2025-0001"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "paid",
              "void",
              "uncollectible"
            ]
          },
          "amount_due": {
            "type": "string"
          },
          "amount_paid": {
            "type": "string"
          },
          "subtotal": {
            "type": "string"
          },
          "tax": {
            "type": "string"
          },
          "discount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "period_start": {
            "type": "string",
            "format": "date-time"
          },
          "period_end": {
            "type": "string",
            "format": "date-time"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          },
          "paid_at": {
            "type": "string",
            "format": "date-time"
          },
          "line_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLineItem"
            }
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "InvoiceLineItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit_price": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "UsageSummary": {
        "type": "object",
        "properties": {
          "period_start": {
            "type": "string",
            "format": "date-time"
          },
          "period_end": {
            "type": "string",
            "format": "date-time"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageMetric"
            }
          },
          "estimated_cost": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "UsageMetric": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "API Requests"
          },
          "product": {
            "type": "string",
            "enum": [
              "devant",
              "bijira",
              "agent"
            ]
          },
          "used": {
            "type": "integer"
          },
          "included": {
            "type": "integer"
          },
          "overage": {
            "type": "integer"
          },
          "unit": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          }
        }
      },
      "MonthlyUsage": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "total_cost": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageMetric"
            }
          }
        }
      },
      "CostSummary": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "total_spend": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "percentage": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CostBreakdown": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "total_cost": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectCost"
            }
          }
        }
      },
      "ProjectCost": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "percentage": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Entitlement": {
        "type": "object",
        "description": "Unified entitlement representing either a feature or quota",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Entitlement identifier (e.g., \"integrations\", \"API Management\")"
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "quota"
            ],
            "description": "Type of entitlement"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the feature is enabled (only for type=feature)"
          },
          "limit": {
            "type": "integer",
            "nullable": true,
            "description": "Maximum allowed (null means unlimited, only for type=quota)"
          },
          "used": {
            "type": "integer",
            "description": "Current usage count (only for type=quota)"
          },
          "remaining": {
            "type": "integer",
            "nullable": true,
            "description": "Remaining quota (null means unlimited, only for type=quota)"
          },
          "period": {
            "type": "string",
            "description": "Reset period (e.g., \"monthly\", only for type=quota)"
          }
        }
      },
      "EntitlementSummary": {
        "type": "object",
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductEntitlement"
            }
          }
        }
      },
      "ProductEntitlement": {
        "type": "object",
        "description": "Entitlements for a specific product subscription",
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "devant",
              "bijira",
              "agent"
            ],
            "description": "Product code"
          },
          "plan": {
            "type": "string",
            "description": "Plan display name (e.g., \"Starter\", \"Pro Plan\")"
          },
          "plan_code": {
            "type": "string",
            "description": "Plan code (e.g., \"starter\", \"pro\")"
          },
          "entitlements": {
            "type": "array",
            "description": "Unified list of features and quotas",
            "items": {
              "$ref": "#/components/schemas/Entitlement"
            }
          }
        }
      },
      "EntitlementCheckRequest": {
        "type": "object",
        "required": [
          "action",
          "resource_type",
          "product"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "resource_type": {
            "type": "string",
            "example": "component"
          },
          "product": {
            "type": "string",
            "enum": [
              "devant",
              "bijira",
              "agent"
            ]
          },
          "quantity": {
            "type": "integer",
            "default": 1
          }
        }
      },
      "EntitlementCheckResponse": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "Whether the requested action is allowed"
          },
          "reason": {
            "type": "string",
            "description": "Human-readable explanation of the result"
          },
          "current_count": {
            "type": "integer",
            "description": "Current usage count for this entitlement"
          },
          "limit": {
            "type": "integer",
            "nullable": true,
            "description": "Maximum allowed (null means unlimited)"
          },
          "remaining": {
            "type": "integer",
            "nullable": true,
            "description": "Remaining quota (null means unlimited)"
          },
          "upgrade_options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "plan_code": {
                  "type": "string"
                },
                "plan_name": {
                  "type": "string"
                },
                "new_limit": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "PromoCodeValidationRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "plan_code": {
            "type": "string"
          }
        }
      },
      "PromoCodeValidationResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "discount_type": {
            "type": "string",
            "enum": [
              "percentage",
              "fixed_amount",
              "free_trial"
            ]
          },
          "discount_value": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "max_discount_amount": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "eligible_plans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error_message": {
            "type": "string",
            "description": "Reason if invalid"
          }
        }
      },
      "CreditBalance": {
        "type": "object",
        "properties": {
          "total_balance": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "credits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "amount": {
                  "type": "string"
                },
                "remaining": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
