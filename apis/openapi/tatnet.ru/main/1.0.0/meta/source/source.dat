 Talos не\nпринимает `machine.files` в immediate-режиме, и попытка доставить их так\nроняет ЛЮБУЮ конвергенцию конфига живой ноды. Поэтому связка — ЗАПРОС по\nадресу, а не снимок, розданный заранее: ноды добавляются и уезжают, и ответ\nобязан пересчитываться.","operationId":"kubernetes_list_cluster_nodes","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/V1K8sNode"},"title":"Response Kubernetes List Cluster Nodes"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/kubernetes-clusters/{cluster_id}/kubeconfig":{"get":{"tags":["kubernetes"],"summary":"Download the cluster-admin kubeconfig","operationId":"kubernetes_get_kubeconfig","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Kubeconfig"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/kubernetes-clusters/{cluster_id}/node-pools/{pool_id}/scale":{"post":{"tags":["kubernetes"],"summary":"Scale a worker node pool","operationId":"kubernetes_scale_node_pool","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"pool_id","in":"path","required":true,"schema":{"type":"string","title":"Pool Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sScale"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sNodePool"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/kubernetes-clusters/{cluster_id}/upgrade":{"post":{"tags":["kubernetes"],"summary":"Upgrade the Kubernetes version","description":"Bump the desired Kubernetes version; nodes are rolled one at a time\n(control plane first) by the platform. Track progress via ``upgrading``\non the cluster resource.","operationId":"kubernetes_upgrade_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sUpgrade"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sCluster"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/kubernetes/regions":{"get":{"tags":["kubernetes"],"summary":"Kubernetes regions and offered versions","operationId":"kubernetes_list_regions","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sRegions"}}}}},"security":[{"TatNetAPIKey":[]}]}},"/projects/{project_id}/load-balancers":{"get":{"tags":["load-balancers"],"summary":"List load balancers","opera