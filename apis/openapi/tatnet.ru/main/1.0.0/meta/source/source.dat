","name","type","mac"],"title":"V1VMInterfaceOut","description":"A VM interface as attached. Without `id` here a key holder could not\nattach a floating IP at all — the attach endpoint takes an interface, and\nno other v1 route exposes one."},"V1Volume":{"properties":{"id":{"type":"string","title":"Id"},"name":{"type":"string","title":"Name"},"region_id":{"type":"string","title":"Region Id"},"size_gb":{"type":"integer","title":"Size Gb"},"actual_size_gb":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Actual Size Gb"},"status":{"type":"string","title":"Status"},"desired_state":{"type":"string","title":"Desired State"},"managed_by":{"type":"string","title":"Managed By"},"k8s_cluster_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"K8S Cluster Id"},"device_serial":{"type":"string","title":"Device Serial"},"error_detail":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error Detail"},"attachment":{"anyOf":[{"$ref":"#/components/schemas/V1VolumeAttachment"},{"type":"null"}]}},"type":"object","required":["id","name","region_id","size_gb","status","desired_state","managed_by","device_serial"],"title":"V1Volume"},"V1VolumeAttach":{"properties":{"vm_id":{"type":"string","title":"Vm Id"}},"type":"object","required":["vm_id"],"title":"V1VolumeAttach"},"V1VolumeAttachment":{"properties":{"vm_id":{"type":"string","title":"Vm Id"},"status":{"type":"string","title":"Status"},"target_dev":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Target Dev"}},"type":"object","required":["vm_id","status"],"title":"V1VolumeAttachment"},"V1VolumeCreate":{"properties":{"name":{"type":"string","maxLength":255,"minLength":1,"title":"Name"},"size_gb":{"type":"integer","minimum":1.0,"title":"Size Gb"},"region_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Region Id"},"k8s_cluster_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"K8S Cluster Id"}},"type":"object","required":["name","size_gb"],"title":"V1VolumeCreate"},"V1VolumeDetach":{"properties":{"for