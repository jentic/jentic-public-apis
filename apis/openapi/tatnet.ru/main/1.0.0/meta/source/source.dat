":{"$ref":"#/components/schemas/V1Bucket"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/buckets/{bucket_id}":{"get":{"tags":["object-storage"],"summary":"Get a bucket","operationId":"object_storage_get_bucket","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Bucket"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["object-storage"],"summary":"Update a bucket","operationId":"object_storage_update_bucket","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BucketUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Bucket"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["object-storage"],"summary":"Delete a bucket","operationId":"object_storage_delete_bucket","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}},{"name":"force","in":"query","required":false,"schema":{"type":"boolean","description":"Also purge every object, version and delete marker. Without it a non-empty bucket is refused (409). Irreversible","default":false,"title":"Force"},"description":"Also purge every object, version and delete marker. Without it a non-empty bucket is refused (409). Irreversible"}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/buckets/{bucket_id}/objects":{"get":{"tags":["object-storage"],"summary":"List objects","operationId":"object_storage_list_objects","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}},{"name":"prefix","in":"query","required":false,"schema":{"type":"string","description":"Only keys under this prefix","default":"","title":"Prefix"},"description":"Only keys under this prefix"},{"name":"continuation_token","in":"query","required":false,"schema":{"type":"string","description":"`next_continuation_token` from the previous page","default":"","title":"Continuation Token"},"description":"`next_continuation_token` from the previous page"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ObjectList"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/buckets/{bucket_id}/objects/presign":{"post":{"tags":["object-storage"],"summary":"Pre-sign an object URL","description":"Download (GET) or upload (PUT) a single object without an S3 access key.\n\nGET needs ``bucket:read``, PUT needs ``bucket:update`` — the URL carries the\nplatform's own credential, so the action gate is the only thing standing\nbetween the caller and the object.","operationId":"object_storage_presign_object","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Presign"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PresignResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/buckets/{bucket_id}/objects/delete":{"post":{"tags":["object-storage"],"summary":"Delete an object","operationId":"object_storage_delete_object","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ObjectKey"}}}},"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/buckets/{bucket_id}/folders":{"post":{"tags":["object-storage"],"summary":"Create a folder","description":"S3 has no directories; this writes the empty marker object browsers and\nthe dashboard's file manager render as a folder.","operationId":"object_storage_create_folder","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"bucket_id","in":"path","required":true,"schema":{"type":"string","title":"Bucket Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FolderCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FolderCreated"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/usage":{"get":{"tags":["object-storage"],"summary":"Storage usage per bucket","description":"Last measured size of each bucket. ``snapshot_at`` is null for a bucket\nthe platform has not measured yet — that is \"not known\", not \"empty\".","operationId":"object_storage_get_usage","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Usage"}}}}},"security":[{"TatNetAPIKey":[]}]}},"/object-storage/connection-info":{"get":{"tags":["object-storage"],"summary":"S3 endpoint and region","description":"What to put in an S3 client's configuration. Pair it with an access key.","operationId":"object_storage_get_connection_info","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConnectionInfo"}}}}},"security":[{"TatNetAPIKey":[]}]}},"/object-storage/access-keys":{"get":{"tags":["object-storage"],"summary":"List S3 access keys","operationId":"object_storage_list_access_keys","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1AccessKey_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["object-storage"],"summary":"Create an S3 access key","description":"Mint a SigV4 credential for S3 clients.\n\n``secret_access_key`` is in this response and nowhere else — only a hash is\nkept. The key is an independent credential: revoking the ``tn_live_`` key\nthat created it does **not** revoke it.\n\nA new key starts in ``provisioning`` and flips to ``active`` once the secret\nreaches the keystore (seconds). Requests signed with it fail until then.","operationId":"object_storage_create_access_key","security":[{"TatNetAPIKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1AccessKeyCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1AccessKeyCreated"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/object-storage/access-keys/{key_id}":{"patch":{"tags":["object-storage"],"summary":"Replace an access key's bucket scope","description":"The new scope replaces the old one; it takes effect after replication to\nthe gateway's read replica plus its key-cache TTL, not instantly.","operationId":"object_storage_update_access_key","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"key_id","in":"path","required":true,"schema":{"type":"string","title":"Key Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1AccessKeyScope"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1AccessKey"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["object-storage"],"summary":"Delete an S3 access key","operationId":"object_storage_delete_access_key","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"key_id","in":"path","required":true,"schema":{"type":"string","title":"Key Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/domains":{"get":{"tags":["domains"],"summary":"List registered domains","operationId":"domains_list_domains","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1RegisteredDomain_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/domains/{domain_id}":{"get":{"tags":["domains"],"summary":"Get a registered domain","operationId":"domains_get_domain","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"domain_id","in":"path","required":true,"schema":{"type":"string","title":"Domain Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1RegisteredDomain"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters":{"get":{"tags":["postgres"],"summary":"List Postgres clusters in a project","operationId":"postgres_list_clusters","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_PgClusterResponse_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["postgres"],"summary":"Create a Postgres cluster","description":"``role_password`` in this response is the only time the starter role's\npassword is visible: api does not store it (the keystore does, written by\ncontrol-plane) and no endpoint can return it again. Use\n``POST …/roles/{role}/password`` to issue a new one.\n\nThe cluster comes back in ``provisioning``; the region builds it over the\nnext minutes. Restoring into a new cluster is part of *this* call —\n``restore_from`` — not a separate endpoint, because a restore always\nproduces a new cluster.","operationId":"postgres_create_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePgClusterRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterCreatedResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}":{"get":{"tags":["postgres"],"summary":"Get a Postgres cluster","operationId":"postgres_get_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["postgres"],"summary":"Delete a Postgres cluster","description":"202: the row goes to ``deleting`` and the region tears the cluster down.\nThe backup repository outlives it by 14 days, so a restore is still possible\nafter this call.","operationId":"postgres_delete_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/allowlist":{"put":{"tags":["postgres"],"summary":"Replace the allowed IP list","description":"Public clusters only — a cluster in a VPC has no public address (422).\nFor a public cluster the allowlist is the whole network filter: an empty\nlist means nobody can connect.","operationId":"postgres_update_allowlist","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdatePgAllowlistRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/plan":{"put":{"tags":["postgres"],"summary":"Change the node plan","description":"Upwards only: memory, vCPU and disk of the new plan must be at least the\ncurrent ones. Nodes are resized one at a time, replicas first and the leader\nlast — a single-node cluster is down for about a minute, an ha one fails\nover once. Watch ``plan_change_pending``.","operationId":"postgres_change_plan","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePgPlanRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/topology":{"put":{"tags":["postgres"],"summary":"Change the topology (single ↔ ha)","description":"Growing to ha adds nodes without downtime; shrinking switches the leader\noff any node being removed first. Price follows immediately (plan × nodes).\nWatch ``topology_change_pending``.","operationId":"postgres_change_topology","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePgTopologyRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/replace-nodes":{"post":{"tags":["postgres"],"summary":"Replace outdated nodes with the newest image","description":"Marks every live node whose VM is not on the newest ready image build in\nthe region. Replacements run one at a time — replicas, leader, witness — and\nthe database stays reachable throughout. ``requested: 0`` means every node\nis already current.","operationId":"postgres_replace_outdated_nodes","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/nodes/{ordinal}/replace":{"post":{"tags":["postgres"],"summary":"Replace one node","description":"Re-create one node, current image or not — the ops escape hatch.","operationId":"postgres_replace_node","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"ordinal","in":"path","required":true,"schema":{"type":"integer","title":"Ordinal"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/parameters":{"get":{"tags":["postgres"],"summary":"Server parameters and their catalog","description":"``parameters`` is the intent, ``applied_parameters`` is what the region\nconfirmed reached the cluster, and ``catalog`` carries the allowed range of\neach parameter already computed for this cluster's plan.","operationId":"postgres_get_parameters","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["postgres"],"summary":"Replace server parameters","description":"A full replacement, not a merge: a parameter absent from the request is\ncleared. Parameters marked ``restart`` in the catalog only take effect after\n``POST …/restart``.","operationId":"postgres_update_parameters","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdatePgParametersRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/restart":{"post":{"tags":["postgres"],"summary":"Request a restart","description":"Restarts nodes to apply postmaster-level parameters — replicas first,\nleader last. ``restart_pending_ack`` stays true until the region confirms.","operationId":"postgres_restart_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/roles/{role}/password":{"post":{"tags":["postgres"],"summary":"Issue a new password for a role","description":"The new password is in this response and nowhere else.\n\n``applied: false`` means the region has not run ``ALTER ROLE`` yet — **the\ndatabase still accepts the old password until it does.** Do not treat the\n200 as the moment the old one stopped working.","operationId":"postgres_reset_role_password","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"role","in":"path","required":true,"schema":{"type":"string","title":"Role"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgRolePasswordResetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/ca":{"get":{"tags":["postgres"],"summary":"Download the cluster CA certificate","description":"Per-cluster CA, for connecting with ``sslmode=verify-full``.\n``ready: false`` while the region has not issued it yet.","operationId":"postgres_get_cluster_ca","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgCaResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/backups":{"get":{"tags":["postgres"],"summary":"List backups and the PITR window","description":"``pitr_window`` spans the oldest completed backup to the last archived\nWAL. Either bound being null means there is no window — restore is not\npossible yet, which is not the same as \"no backups\".","operationId":"postgres_list_backups","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgBackupsListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["postgres"],"summary":"Request a manual backup","description":"Manual backups never expire, so at most 5 live ones per cluster — they\nwould otherwise eat the repository quota the nightly automatic backups need.\nThe row starts ``requested``; the node takes it from there.","operationId":"postgres_create_backup","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePgBackupRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgBackupsListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/pg-clusters/{cluster_id}/backups/{backup_id}":{"delete":{"tags":["postgres"],"summary":"Delete a backup","description":"202: the row goes to ``deleting`` and the region expires it. The newest\ncompleted backup cannot be deleted — the region never expires it, so the\nrequest would hang forever.","operationId":"postgres_delete_backup","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"backup_id","in":"path","required":true,"schema":{"type":"string","title":"Backup Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/postgres/regions":{"get":{"tags":["postgres"],"summary":"Postgres regions, versions, plans and topologies","description":"Everything a create call needs to pick from. Versions are per-region: a\nversion appears only where a ready node image is laid out on every node of\nthat region, so the same list is not valid everywhere.","operationId":"postgres_list_regions","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgRegionsListResponse"}}}}},"security":[{"TatNetAPIKey":[]}]}},"/projects/{project_id}/valkey-clusters":{"get":{"tags":["valkey"],"summary":"List Valkey clusters in a project","operationId":"valkey_list_clusters","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_ValkeyClusterResponse_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["valkey"],"summary":"Create a Valkey cluster","description":"``password`` in this response is the only time the ``default`` user's\npassword is visible — api does not store it, the keystore does. Issue a new\none with ``POST …/password``.\n\nThe cluster is TLS-only: connect with ``rediss://`` and the per-cluster CA\nfrom ``GET …/ca``.","operationId":"valkey_create_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateValkeyClusterRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterCreatedResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}":{"get":{"tags":["valkey"],"summary":"Get a Valkey cluster","operationId":"valkey_get_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["valkey"],"summary":"Delete a Valkey cluster","description":"202: the row goes to ``deleting`` and the region tears it down. A cache\nhas no backups — the data is gone.","operationId":"valkey_delete_cluster","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/allowlist":{"put":{"tags":["valkey"],"summary":"Replace the allowed IP list","description":"For a public cluster this list **is** the network filter — there is no\nsecond layer behind it. An empty list means no client can connect.","operationId":"valkey_update_allowlist","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateValkeyAllowlistRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/plan":{"put":{"tags":["valkey"],"summary":"Change the node plan","description":"Upgrade only: memory, vCPU and disk of the new plan must not be below\nthe current ones. Nodes are resized one at a time (each reboots); the\nmemory and connection limits rise once every node is on the new plan.\n`plan_change_pending` on the cluster shows the change is still in\nprogress.","operationId":"valkey_change_plan","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeValkeyPlanRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/topology":{"put":{"tags":["valkey"],"summary":"Change the topology","description":"single ↔ ha. Growing adds a replica and a read endpoint without\ndowntime; shrinking removes the replica and the read endpoint at once\n(a switchover happens if the primary is on the replica).\n`topology_change_pending` on the cluster shows the change is still in\nprogress.","operationId":"valkey_change_topology","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeValkeyTopologyRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/params":{"put":{"tags":["valkey"],"summary":"Update cache parameters","description":"maxmemory, eviction policy, max clients and persistence. The region\napplies them to the running server, so no restart is needed.","operationId":"valkey_update_params","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateValkeyParamsRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/password":{"post":{"tags":["valkey"],"summary":"Issue a new password","description":"The new password is in this response and nowhere else. ``applied:\nfalse`` means the region has not pushed it to the server yet — **the old\npassword still works until it does.**","operationId":"valkey_reset_password","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyPasswordResetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/ca":{"get":{"tags":["valkey"],"summary":"Download the cluster CA certificate","description":"The cluster is TLS-only; this CA is what a ``rediss://`` client verifies\nagainst. ``ready: false`` while the region has not issued it — the same\nshape as the Postgres CA and the Kubernetes kubeconfig.","operationId":"valkey_get_cluster_ca","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyCaResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/replace-nodes":{"post":{"tags":["valkey"],"summary":"Replace outdated nodes with the newest image","description":"One node at a time, replicas before the leader. ``requested: 0`` means\nevery node is already on the newest image build in the region.","operationId":"valkey_replace_outdated_nodes","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/projects/{project_id}/valkey-clusters/{cluster_id}/nodes/{ordinal}/replace":{"post":{"tags":["valkey"],"summary":"Replace one node","description":"Re-create one node, current image or not — the ops escape hatch.","operationId":"valkey_replace_node","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","title":"Project Id"}},{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"ordinal","in":"path","required":true,"schema":{"type":"integer","title":"Ordinal"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey/regions":{"get":{"tags":["valkey"],"summary":"Valkey regions, versions, plans and cache modes","description":"Versions are per-region: one is offered only where a ready node image is\nlaid out on every node of that region.","operationId":"valkey_list_regions","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyRegionsListResponse"}}}}},"security":[{"TatNetAPIKey":[]}]}},"/vms/{vm_id}":{"get":{"tags":["vms"],"summary":"Get a VM","operationId":"vms_get_vm_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1VM"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["vms"],"summary":"Delete a VM","description":"202, and the body says which of the two things happened.\n\nA VM that was never provisioned is gone when this returns (``deleted``).\nA provisioned one is moved to ``deleting`` and a region tears it down over\nthe following minutes — it stays visible in ``GET …/vms`` until then, so a\nscript that deletes and immediately re-creates by name has to wait.\n\nThis used to answer 204, which could not express the difference; the\nservice's own return value cannot either (it reports ``success`` for both\nand puts the distinction in a human-readable message).","operationId":"vms_delete_vm_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms/{vm_id}/start":{"post":{"tags":["vms"],"summary":"Start a VM","operationId":"vms_start_vm_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/VMStartRequest"},{"type":"null"}],"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PowerActionResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms/{vm_id}/stop":{"post":{"tags":["vms"],"summary":"Stop a VM","operationId":"vms_stop_vm_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PowerActionResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms/{vm_id}/restart":{"post":{"tags":["vms"],"summary":"Restart a VM","operationId":"vms_restart_vm_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PowerActionResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms/{vm_id}/backups":{"get":{"tags":["vms"],"summary":"List VM backups","operationId":"vms_list_backups_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1Backup_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["vms"],"summary":"Create a VM backup","operationId":"vms_create_backup_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BackupCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Backup"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms/{vm_id}/backups/{backup_id}":{"delete":{"tags":["vms"],"summary":"Delete a VM backup","operationId":"vms_delete_backup_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vm_id","in":"path","required":true,"schema":{"type":"string","title":"Vm Id"}},{"name":"backup_id","in":"path","required":true,"schema":{"type":"string","title":"Backup Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vms":{"get":{"tags":["vms"],"summary":"List VMs in a project","operationId":"vms_list_vms_by_account","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Only resources of this project (optional)","title":"Project Id"},"description":"Only resources of this project (optional)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1VM_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/functions/{function_id}":{"get":{"tags":["functions"],"summary":"Get a function","operationId":"functions_get_function_route_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Function"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["functions"],"summary":"Update a function (code and/or configuration)","description":"AWS-parity update (UpdateFunctionCode + UpdateFunctionConfiguration):\nPATCH the file map / handler / runtime / name / vpc_id, then POST\n…/deploy to build and roll the new code (the \"publish\" analogue).","operationId":"functions_update_function_route_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FunctionUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Function"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["functions"],"summary":"Delete a function","operationId":"functions_delete_function_route_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/functions/{function_id}/deploy":{"post":{"tags":["functions"],"summary":"Build & deploy a function","operationId":"functions_deploy_function_route_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FunctionDeployResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/functions/{function_id}/env":{"get":{"tags":["functions"],"summary":"List environment variables","operationId":"functions_list_env_vars_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1EnvVar_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["functions"],"summary":"Create or set an environment variable","operationId":"functions_add_env_var_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1EnvVarCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1EnvVar"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/functions/{function_id}/env/{env_var_id}":{"delete":{"tags":["functions"],"summary":"Delete an environment variable","operationId":"functions_delete_env_var_route_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"function_id","in":"path","required":true,"schema":{"type":"string","title":"Function Id"}},{"name":"env_var_id","in":"path","required":true,"schema":{"type":"string","title":"Env Var Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/functions":{"get":{"tags":["functions"],"summary":"List functions","operationId":"functions_list_functions_by_account","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Only resources of this project (optional)","title":"Project Id"},"description":"Only resources of this project (optional)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1Function_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/volumes/{volume_id}":{"get":{"tags":["volumes"],"summary":"Get a block volume","operationId":"volumes_get_volume_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"volume_id","in":"path","required":true,"schema":{"type":"string","title":"Volume Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Volume"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["volumes"],"summary":"Grow a block volume","operationId":"volumes_resize_volume_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"volume_id","in":"path","required":true,"schema":{"type":"string","title":"Volume Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1VolumeResize"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Volume"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["volumes"],"summary":"Delete a block volume","operationId":"volumes_delete_volume_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"volume_id","in":"path","required":true,"schema":{"type":"string","title":"Volume Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/volumes/{volume_id}/attach":{"post":{"tags":["volumes"],"summary":"Attach a volume to a VM","operationId":"volumes_attach_volume_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"volume_id","in":"path","required":true,"schema":{"type":"string","title":"Volume Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1VolumeAttach"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Volume"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/volumes/{volume_id}/detach":{"post":{"tags":["volumes"],"summary":"Detach a volume from its VM","operationId":"volumes_detach_volume_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"volume_id","in":"path","required":true,"schema":{"type":"string","title":"Volume Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/V1VolumeDetach"},{"type":"null"}],"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Volume"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/volumes":{"get":{"tags":["volumes"],"summary":"List block volumes in a project","operationId":"volumes_list_volumes_by_account","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Only resources of this project (optional)","title":"Project Id"},"description":"Only resources of this project (optional)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1Volume_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}":{"get":{"tags":["postgres"],"summary":"Get a Postgres cluster","operationId":"postgres_get_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["postgres"],"summary":"Delete a Postgres cluster","description":"202: the row goes to ``deleting`` and the region tears the cluster down.\nThe backup repository outlives it by 14 days, so a restore is still possible\nafter this call.","operationId":"postgres_delete_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/allowlist":{"put":{"tags":["postgres"],"summary":"Replace the allowed IP list","description":"Public clusters only — a cluster in a VPC has no public address (422).\nFor a public cluster the allowlist is the whole network filter: an empty\nlist means nobody can connect.","operationId":"postgres_update_allowlist_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdatePgAllowlistRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/plan":{"put":{"tags":["postgres"],"summary":"Change the node plan","description":"Upwards only: memory, vCPU and disk of the new plan must be at least the\ncurrent ones. Nodes are resized one at a time, replicas first and the leader\nlast — a single-node cluster is down for about a minute, an ha one fails\nover once. Watch ``plan_change_pending``.","operationId":"postgres_change_plan_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePgPlanRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/topology":{"put":{"tags":["postgres"],"summary":"Change the topology (single ↔ ha)","description":"Growing to ha adds nodes without downtime; shrinking switches the leader\noff any node being removed first. Price follows immediately (plan × nodes).\nWatch ``topology_change_pending``.","operationId":"postgres_change_topology_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePgTopologyRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/replace-nodes":{"post":{"tags":["postgres"],"summary":"Replace outdated nodes with the newest image","description":"Marks every live node whose VM is not on the newest ready image build in\nthe region. Replacements run one at a time — replicas, leader, witness — and\nthe database stays reachable throughout. ``requested: 0`` means every node\nis already current.","operationId":"postgres_replace_outdated_nodes_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/nodes/{ordinal}/replace":{"post":{"tags":["postgres"],"summary":"Replace one node","description":"Re-create one node, current image or not — the ops escape hatch.","operationId":"postgres_replace_node_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"ordinal","in":"path","required":true,"schema":{"type":"integer","title":"Ordinal"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/parameters":{"get":{"tags":["postgres"],"summary":"Server parameters and their catalog","description":"``parameters`` is the intent, ``applied_parameters`` is what the region\nconfirmed reached the cluster, and ``catalog`` carries the allowed range of\neach parameter already computed for this cluster's plan.","operationId":"postgres_get_parameters_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["postgres"],"summary":"Replace server parameters","description":"A full replacement, not a merge: a parameter absent from the request is\ncleared. Parameters marked ``restart`` in the catalog only take effect after\n``POST …/restart``.","operationId":"postgres_update_parameters_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdatePgParametersRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/restart":{"post":{"tags":["postgres"],"summary":"Request a restart","description":"Restarts nodes to apply postmaster-level parameters — replicas first,\nleader last. ``restart_pending_ack`` stays true until the region confirms.","operationId":"postgres_restart_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgParametersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/roles/{role}/password":{"post":{"tags":["postgres"],"summary":"Issue a new password for a role","description":"The new password is in this response and nowhere else.\n\n``applied: false`` means the region has not run ``ALTER ROLE`` yet — **the\ndatabase still accepts the old password until it does.** Do not treat the\n200 as the moment the old one stopped working.","operationId":"postgres_reset_role_password_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"role","in":"path","required":true,"schema":{"type":"string","title":"Role"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgRolePasswordResetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/ca":{"get":{"tags":["postgres"],"summary":"Download the cluster CA certificate","description":"Per-cluster CA, for connecting with ``sslmode=verify-full``.\n``ready: false`` while the region has not issued it yet.","operationId":"postgres_get_cluster_ca_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgCaResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/backups":{"get":{"tags":["postgres"],"summary":"List backups and the PITR window","description":"``pitr_window`` spans the oldest completed backup to the last archived\nWAL. Either bound being null means there is no window — restore is not\npossible yet, which is not the same as \"no backups\".","operationId":"postgres_list_backups_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgBackupsListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["postgres"],"summary":"Request a manual backup","description":"Manual backups never expire, so at most 5 live ones per cluster — they\nwould otherwise eat the repository quota the nightly automatic backups need.\nThe row starts ``requested``; the node takes it from there.","operationId":"postgres_create_backup_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePgBackupRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PgBackupsListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters/{cluster_id}/backups/{backup_id}":{"delete":{"tags":["postgres"],"summary":"Delete a backup","description":"202: the row goes to ``deleting`` and the region expires it. The newest\ncompleted backup cannot be deleted — the region never expires it, so the\nrequest would hang forever.","operationId":"postgres_delete_backup_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"backup_id","in":"path","required":true,"schema":{"type":"string","title":"Backup Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/pg-clusters":{"get":{"tags":["postgres"],"summary":"List Postgres clusters in a project","operationId":"postgres_list_clusters_by_account","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Only resources of this project (optional)","title":"Project Id"},"description":"Only resources of this project (optional)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_PgClusterResponse_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}":{"get":{"tags":["valkey"],"summary":"Get a Valkey cluster","operationId":"valkey_get_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["valkey"],"summary":"Delete a Valkey cluster","description":"202: the row goes to ``deleting`` and the region tears it down. A cache\nhas no backups — the data is gone.","operationId":"valkey_delete_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/allowlist":{"put":{"tags":["valkey"],"summary":"Replace the allowed IP list","description":"For a public cluster this list **is** the network filter — there is no\nsecond layer behind it. An empty list means no client can connect.","operationId":"valkey_update_allowlist_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateValkeyAllowlistRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/plan":{"put":{"tags":["valkey"],"summary":"Change the node plan","description":"Upgrade only: memory, vCPU and disk of the new plan must not be below\nthe current ones. Nodes are resized one at a time (each reboots); the\nmemory and connection limits rise once every node is on the new plan.\n`plan_change_pending` on the cluster shows the change is still in\nprogress.","operationId":"valkey_change_plan_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeValkeyPlanRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/topology":{"put":{"tags":["valkey"],"summary":"Change the topology","description":"single ↔ ha. Growing adds a replica and a read endpoint without\ndowntime; shrinking removes the replica and the read endpoint at once\n(a switchover happens if the primary is on the replica).\n`topology_change_pending` on the cluster shows the change is still in\nprogress.","operationId":"valkey_change_topology_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeValkeyTopologyRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/params":{"put":{"tags":["valkey"],"summary":"Update cache parameters","description":"maxmemory, eviction policy, max clients and persistence. The region\napplies them to the running server, so no restart is needed.","operationId":"valkey_update_params_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateValkeyParamsRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyClusterDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/password":{"post":{"tags":["valkey"],"summary":"Issue a new password","description":"The new password is in this response and nowhere else. ``applied:\nfalse`` means the region has not pushed it to the server yet — **the old\npassword still works until it does.**","operationId":"valkey_reset_password_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyPasswordResetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/ca":{"get":{"tags":["valkey"],"summary":"Download the cluster CA certificate","description":"The cluster is TLS-only; this CA is what a ``rediss://`` client verifies\nagainst. ``ready: false`` while the region has not issued it — the same\nshape as the Postgres CA and the Kubernetes kubeconfig.","operationId":"valkey_get_cluster_ca_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyCaResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/replace-nodes":{"post":{"tags":["valkey"],"summary":"Replace outdated nodes with the newest image","description":"One node at a time, replicas before the leader. ``requested: 0`` means\nevery node is already on the newest image build in the region.","operationId":"valkey_replace_outdated_nodes_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters/{cluster_id}/nodes/{ordinal}/replace":{"post":{"tags":["valkey"],"summary":"Replace one node","description":"Re-create one node, current image or not — the ops escape hatch.","operationId":"valkey_replace_node_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}},{"name":"ordinal","in":"path","required":true,"schema":{"type":"integer","title":"Ordinal"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValkeyReplaceNodesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/valkey-clusters":{"get":{"tags":["valkey"],"summary":"List Valkey clusters in a project","operationId":"valkey_list_clusters_by_account","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"project_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Only resources of this project (optional)","title":"Project Id"},"description":"Only resources of this project (optional)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_ValkeyClusterResponse_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/kubernetes-clusters/{cluster_id}":{"get":{"tags":["kubernetes"],"summary":"Get a Kubernetes cluster","operationId":"kubernetes_get_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1K8sCluster"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["kubernetes"],"summary":"Delete a Kubernetes cluster","operationId":"kubernetes_delete_cluster_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteAccepted"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/kubernetes-clusters/{cluster_id}/nodes":{"get":{"tags":["kubernetes"],"summary":"List the cluster's nodes and their backing VMs","description":"Кто есть кто: нода Kubernetes ↔ машина TatNet.\n\nНужен CSI-драйверу, у которого нет другого способа это узнать. Общего имени\nу ноды и машины нет (Kubernetes зовёт ноду `talos-b25-9uq`, мы — своим\nhostname), а положить идентичность в машинный конфиг нельзя: Talos не\nпринимает `machine.files` в immediate-режиме, и попытка доставить их так\nроняет ЛЮБУЮ конвергенцию конфига живой ноды. Поэтому связка — ЗАПРОС по\nадресу, а не снимок, розданный заранее: ноды добавляются и уезжают, и ответ\nобязан пересчитываться.","operationId":"kubernetes_list_cluster_nodes_by_id","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"path","required":true,"schema":{"type":"string","title":"Cluster Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/V1K8sNode"},"title":"Response Kubernetes List Cluster Nodes By Id"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/kubernetes-clusters/{cluster_id}/kube