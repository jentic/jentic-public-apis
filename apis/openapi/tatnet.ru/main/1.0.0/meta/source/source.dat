ummary":"Delete a DNS zone","operationId":"dns_delete_zone","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/dns/zones/{zone_id}/verify":{"post":{"tags":["dns"],"summary":"Verify NS delegation","operationId":"dns_verify_zone","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Zone"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/dns/zones/{zone_id}/dns_records":{"get":{"tags":["dns"],"summary":"List DNS records","operationId":"dns_list_dns_records","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}},{"name":"name","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"}},{"name":"type","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Type"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1DNSRecord_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["dns"],"summary":"Create a DNS record","operationId":"dns_create_dns_record","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1DNSRecordCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1DNSRecord"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/dns/zones/{zone_id}/dns_records/{record_id}":{"get":{"tags":["dns"],"summary":"Get a DNS record","operationId":"dns_get_dns_record","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}},{"name":"record_id","in":"path","required":true,"schema":{"type":"string","title":"Record Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1DNSRecord"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["dns"],"summary":"Update a DNS record","operationId":"dns_update_dns_record","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}},{"name":"record_id","in":"path","required":true,"schema":{"type":"string","title":"Record Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1DNSRecordUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1DNSRecord"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["dns"],"summary":"Delete a DNS record","operationId":"dns_delete_dns_record","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"zone_id","in":"path","required":true,"schema":{"type":"string","title":"Zone Id"}},{"name":"record_id","in":"path","required":true,"schema":{"type":"string","title":"Record Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vpcs":{"get":{"tags":["networking"],"summary":"List VPCs","operationId":"networking_list_vpcs","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cluster Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1Vpc_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["networking"],"summary":"Create a VPC","operationId":"networking_create_vpc","security":[{"TatNetAPIKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1VpcCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Vpc"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vpcs/{vpc_id}":{"get":{"tags":["networking"],"summary":"Get a VPC","operationId":"networking_get_vpc","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1Vpc"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["networking"],"summary":"Delete a VPC","operationId":"networking_delete_vpc","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vpcs/{vpc_id}/nat-gateway":{"post":{"tags":["networking"],"summary":"Enable the VPC's NAT gateway","description":"Allocate (or reuse) a floating IP and SNAT the whole VPC subnet through\nit, so VMs without an address of their own reach the internet. One gateway\nper VPC (`409 nat_gateway_exists`). Asynchronous: poll the VPC's\n`nat_gateway.status` until `attached`.\n\nWithout `fip_id` this orders a NEW address and goes through the same\nbalance check as allocating one (`402 insufficient_balance`,\n`503 billing_unavailable`); reusing an address you already hold does not.","operationId":"networking_enable_nat_gateway","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/V1NatGatewayEnable"},{"type":"null"}],"title":"Body"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NatGateway"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["networking"],"summary":"Disable the VPC's NAT gateway","description":"Remove the SNAT; the gateway's address is released automatically once\nthe region confirms (`202`, `status: detaching`).","operationId":"networking_disable_nat_gateway","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}},{"name":"expected_fip_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"description":"Disable only this floating IP allocation; a replaced gateway returns 409 nat_gateway_changed.","title":"Expected Fip Id"},"description":"Disable only this floating IP allocation; a replaced gateway returns 409 nat_gateway_changed."}],"responses":{"202":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NatGateway"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vpcs/{vpc_id}/reserved-ips":{"post":{"tags":["networking"],"summary":"Reserve an IP in a VPC","operationId":"networking_create_reserved_ip","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ReservedIpCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ReservedIp"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/vpcs/{vpc_id}/reserved-ips/{ip_id}":{"delete":{"tags":["networking"],"summary":"Release a reserved IP","operationId":"networking_delete_reserved_ip","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"vpc_id","in":"path","required":true,"schema":{"type":"string","title":"Vpc Id"}},{"name":"ip_id","in":"path","required":true,"schema":{"type":"string","title":"Ip Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/floating-ips":{"get":{"tags":["networking"],"summary":"List floating IPs","operationId":"networking_list_floating_ips","security":[{"TatNetAPIKey":[]}],"parameters":[{"name":"cluster_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cluster Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page_V1FloatingIP_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["networking"],"summary":"Allocate a floating IP","description":"Allocating an address needs a funded balance, the same as creating a VM:\n402 ``insufficient_balance`` when the balance is below the address's monthly\nprice, 503 ``billing_unavailable`` when the balance could not be read.","operationId":"networking_create_floating_ip","security":[{"TatNetAPIKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FloatingIPCreate"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1FloatingIP"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/floating-ips/{fip_id}":{"get":{"tags":["networking"],"summary":"Get a floating IP","operationId":"n