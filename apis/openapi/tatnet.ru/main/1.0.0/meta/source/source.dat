e intent, this is the fact."},"guest_agent_checked_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Guest Agent Checked At","description":"When the guest agent was last probed (RFC 3339)"},"ipv4_addresses":{"items":{"type":"string"},"type":"array","title":"Ipv4 Addresses"},"interfaces":{"items":{"$ref":"#/components/schemas/V1VMInterfaceOut"},"type":"array","title":"Interfaces","description":"Network interfaces as attached; an interface `id` is what `POST /v1/floating-ips/{id}/attach` takes"},"floating_ips":{"items":{"$ref":"#/components/schemas/V1VMFloatingIP"},"type":"array","title":"Floating Ips","description":"Floating IPs attached to the VM's interfaces, with their computed status"},"ephemeral":{"type":"boolean","title":"Ephemeral","description":"Ephemeral VM: billed per second of lifetime at the plan's hourly rate, no prepaid period or subscription; cannot be resized","default":false}},"type":"object","required":["id","name","hostname","status","vcpu","mem","disk_size","project_id"],"title":"V1VM"},"V1VMCreate":{"properties":{"vcpu":{"anyOf":[{"type":"integer","exclusiveMinimum":0.0},{"type":"null"}],"title":"Vcpu"},"mem":{"anyOf":[{"type":"integer","exclusiveMinimum":0.0},{"type":"null"}],"title":"Mem"},"name":{"type":"string","maxLength":255,"minLength":1,"title":"Name","description":"VM display name"},"hostname":{"type":"string","maxLength":63,"minLength":1,"title":"Hostname","description":"VM hostname (lowercase letters, digits, hyphens)"},"image_id":{"type":"string","title":"Image Id","description":"Image UUID"},"vm_plan_id":{"type":"string","title":"Vm Plan Id","description":"VM plan UUID"},"cluster_id":{"type":"string","title":"Cluster Id","description":"Cluster UUID"},"default_user":{"type":"string","minLength":1,"title":"Default User","description":"Default login user for the VM"},"disk_size_gb":{"anyOf":[{"type":"integer","exclusiveMinimum":0.0},{"type":"null"}],"title":"Disk Size Gb","description":"Custom disk size in G