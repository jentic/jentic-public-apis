{
  "openapi": "3.0.3",
  "info": {
    "title": "CryptoKeyhole API",
    "version": "1.0.0",
    "description": "On-chain and market analytics for Bitcoin, Ethereum and a growing list of coins, calculated from CryptoKeyhole's own nodes and collectors: every chart's history as exact values, the metric catalogue, the Fear & Greed Index, perpetual futures screens and an MCP server for AI assistants.\n\nWithout a key you read the Free view: the Free charts at daily, weekly, monthly and yearly resolution with full history, plus the free tools' endpoints. A chart above your plan answers a fixed historical sample or a plan lock, never a current reading. With an API key from your account page (Plus and higher plans) you read what your plan includes: Plus adds hourly data, the Plus charts and downloads; Pro adds ten-minute data, every premium chart and full-history downloads; API & Team adds commercial use and unmetered calls. Keys are read-only and go in the Authorization header. Each client (key or address) may make 240 requests a minute; Plus includes 1,000 API calls a day and Pro 100,000 a month.\n\nFree charts and free API data are licensed CC BY 4.0 (credit CryptoKeyhole with a link); their answers, JSON and CSV, carry a Link header with rel=\"license\". Paid-plan data, the samples of paid charts and raw exchange or other third-party data are not covered and carry no such header.\n\nTimes are UTC Unix seconds; a range's start is included and its end is not. Values are exact decimal strings (null where there is no observation, never zero), each with its finality: final, provisional, or partial for the open period, which is updated hourly until it closes.",
    "termsOfService": "https://cryptokeyhole.com/terms/",
    "contact": {
      "name": "CryptoKeyhole",
      "url": "https://cryptokeyhole.com/data-access/"
    },
    "license": {
      "name": "CC BY 4.0 (free data; paid-plan data under the terms of service)",
      "url": "https://cryptokeyhole.com/methodology/#licence-title"
    },
    "x-logo": {
      "url": "https://cryptokeyhole.com/favicon.svg"
    },
    "x-jentic-source-url": "https://cryptokeyhole.com/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://cryptokeyhole.com/api/v1"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "Platform"
        ],
        "operationId": "getStatus",
        "summary": "Platform status",
        "description": "Each data source's processed frontier and freshness, as the site reports them.",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "Status document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/assets": {
      "get": {
        "tags": [
          "Charts"
        ],
        "operationId": "listAssets",
        "summary": "Assets",
        "description": "The public assets, Bitcoin first. Every other asset's chart ids start with its prefix (for example eth.).",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "The assets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assets"
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "tags": [
          "Charts"
        ],
        "operationId": "getCatalog",
        "summary": "Metric catalogue",
        "description": "Every chart of one asset with its id, name, unit, description, method, intervals, coverage and status. A planned chart that has not published carries status held and its reason.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "description": "An asset code from /assets. Default BTC, or the asset of the first of ids.",
            "schema": {
              "type": "string",
              "example": "ETH"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated chart ids of one asset: only these charts.",
            "schema": {
              "type": "string",
              "example": "eth.PriceUSD"
            }
          },
          {
            "name": "view",
            "in": "query",
            "description": "directory: the chart directory's tree instead of the flat list (not with ids).",
            "schema": {
              "type": "string",
              "enum": [
                "directory"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/series": {
      "get": {
        "tags": [
          "Charts"
        ],
        "operationId": "getSeries",
        "summary": "Chart series",
        "description": "One chart's observations, one point per period, and for charts with several lines their components. Free charts at 24h, 1w, 1M and 1Y need no key. A chart or interval above the plan answers 200 with state locked and the plan it needs, or a fixed historical sample named by the X-CKH-Preview header. Price-distribution charts (catalogue distribution.type price_histogram) take one UTC day: start at midnight and end exactly one day later.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/metric"
          },
          {
            "$ref": "#/components/parameters/interval"
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Most points returned (12 to 20,000, default 3,000); a longer range is reduced to it.",
            "schema": {
              "type": "integer",
              "minimum": 12,
              "maximum": 20000,
              "default": 3000
            }
          },
          {
            "$ref": "#/components/parameters/sma"
          },
          {
            "$ref": "#/components/parameters/smoothing"
          },
          {
            "$ref": "#/components/parameters/publication"
          }
        ],
        "responses": {
          "200": {
            "description": "The series, or its plan lock",
            "headers": {
              "X-CKH-Preview": {
                "description": "Set when the answer is a fixed sample of a chart above the plan: plan, name, from, through (UTC seconds) and sample=1.",
                "schema": {
                  "type": "string"
                }
              },
              "Link": {
                "description": "Set on a free chart's answer at a free resolution when the data is ours to license: <https://creativecommons.org/licenses/by/4.0/>; rel=\"license\".",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/formula": {
      "get": {
        "tags": [
          "Charts"
        ],
        "operationId": "getFormula",
        "summary": "Saved formula as a series",
        "description": "A saved formula read like a chart. Anyone can read a formula by the share id of its public link; with your key you can also read your own saved formulas by their id. Every input chart and the interval must be in the requester's plan. Without interval, start and end the formula's saved interval and range apply.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A share id, or the id of one of your own saved formulas.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "10m",
                "1h",
                "24h",
                "1w",
                "1M"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 12,
              "maximum": 20000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The formula's series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/export": {
      "get": {
        "tags": [
          "Charts"
        ],
        "operationId": "exportSeries",
        "summary": "Chart download (Plus and higher)",
        "description": "The chart pages' CSV or JSON download of one chart, with every provenance column, the source, licence and attribution of each series. Included with Plus and higher plans.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/metric"
          },
          {
            "$ref": "#/components/parameters/interval"
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "$ref": "#/components/parameters/sma"
          },
          {
            "$ref": "#/components/parameters/smoothing"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "json"
              ],
              "default": "csv"
            }
          },
          {
            "$ref": "#/components/parameters/publication"
          }
        ],
        "responses": {
          "200": {
            "description": "The download, as an attachment",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/fear-and-greed": {
      "get": {
        "tags": [
          "Indices"
        ],
        "operationId": "getFearAndGreed",
        "summary": "Fear & Greed Index",
        "description": "The crypto market's Fear & Greed Index, or one coin's: the latest reading (0 to 100 and exact), its band, the time it is as of and whether its UTC day is still open, today's components with their weights, the readings a day, a week, a month and a year before, and the daily history, newest first. Free, keyless and open to other origins (CORS). Guide: https://cryptokeyhole.com/fear-and-greed-index/api/",
        "security": [
          {}
        ],
        "parameters": [
          {
            "name": "coin",
            "in": "query",
            "description": "market (the default) or a coin code that has its own index (see /fear-and-greed/coins).",
            "schema": {
              "type": "string",
              "example": "btc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Days of history, newest first (default 30; 0 for all).",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 30
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "csv gives the history rows only.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The index",
            "headers": {
              "Link": {
                "description": "The free data's licence: <https://creativecommons.org/licenses/by/4.0/>; rel=\"license\".",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/fear-and-greed/coins": {
      "get": {
        "tags": [
          "Indices"
        ],
        "operationId": "listFearAndGreedCoins",
        "summary": "Fear & Greed Index of every coin",
        "description": "Today's reading of the market's index and of every coin with its own. Free and keyless (CORS).",
        "security": [
          {}
        ],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Today's readings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/leverage": {
      "get": {
        "tags": [
          "Indices"
        ],
        "operationId": "getLeverageGauge",
        "summary": "Leverage gauge",
        "description": "How stretched leverage is in a coin, 0 to 100, hourly: open interest against market cap, funding, the futures basis, the long/short account ratio, Hyperliquid's large accounts and the nearest liquidation cluster, each ranked against the coin's own past year. With asset, every viewer gets the current value and band (keyless; CC BY 4.0); Plus and higher plans also get the components (reading, rank, score), the history (history=1h or 24h, with start and end) and, without asset, every coin ranked. page= answers the leverage pages' plan-dependent parts. Method: https://cryptokeyhole.com/crypto-leverage/",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "description": "A coin code (BTC, ETH, SOL, ...). Without it: every coin ranked (Plus).",
            "schema": {
              "type": "string",
              "example": "BTC"
            }
          },
          {
            "name": "history",
            "in": "query",
            "description": "1h (at most 90 days a request) or 24h: the gauge's history (Plus).",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "24h"
              ]
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "UTC seconds (history).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "UTC seconds, exclusive (history).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The gauge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tools/closes": {
      "get": {
        "tags": [
          "Tools"
        ],
        "operationId": "getDailyCloses",
        "summary": "Daily closes",
        "description": "One coin's daily USD closes from its first day, as its free price chart shows them: a (the coin), n (days), t0 (the first day, UTC seconds), v (one close or null per UTC day from t0) and now ([time, latest hourly price]). Free and keyless; the DCA and profit calculators use it.",
        "security": [
          {}
        ],
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "description": "A coin code, for example BTC.",
            "schema": {
              "type": "string",
              "example": "BTC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The closes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Closes"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/perps": {
