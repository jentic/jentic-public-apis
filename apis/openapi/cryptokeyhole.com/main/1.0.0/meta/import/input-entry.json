          "402": {
            "$ref": "#/components/responses/PlanRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/carry/funding": {
      "get": {
        "tags": [
          "Markets"
        ],
        "operationId": "getSettledFunding",
        "summary": "One contract's settled funding (Pro and higher)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contract",
            "in": "query",
            "required": true,
            "description": "A contract id from /perps.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The settled funding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/moves/latest": {
      "get": {
        "tags": [
          "Markets"
        ],
        "operationId": "getLatestMove",
        "summary": "The latest sharp price move of a coin, explained",
        "description": "The latest sharp move (a fall or rise within 15 minutes, 1 hour or 4 hours of at least four times the coin's own recent volatility, and at least 1%, 1.5% or 2.5%), found every minute, with what our own data saw during it and a card in plain English. Free (no key): BTC and ETH, built only from readings the free pages show (liquidations by side, open interest and funding, options expiry, ETF flows, transfers of $100M or more, dormant-coin moves of 1,000 BTC or more); the other parts are named in `locked`. Plus: every coin, venue detail, taker flow, the Coinbase premium, Hyperliquid large accounts, hourly exchange flows from our nodes and the base rates (what followed similar moves an hour and a day later). Sizes are exact fractions.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "BTC"
            },
            "description": "A coin code (BTC, ETH, SOL, ...) or ALL."
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "down",
                "up"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest move of each coin asked for",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          }
        }
      }
    },
    "/moves": {
      "get": {
        "tags": [
          "Markets"
        ],
        "operationId": "listMoves",
        "summary": "The archive of sharp price moves",
        "description": "Every sharp move of a coin (or ALL) detected between `from` and `to` (Unix seconds), newest first, with its card, what our data saw, the base rates and what followed it an hour and a day later. Coverage: five-minute prices from 2020 for the longest histories, one-minute prices since mid-October 2026. Plus.",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "BTC"
            },
            "description": "A coin code (BTC, ETH, SOL, ...) or ALL."
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The moves",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": [
          "Platform"
        ],
        "operationId": "mcp",
        "summary": "MCP server for AI assistants",
        "description": "A Model Context Protocol server (JSON-RPC 2.0 over Streamable HTTP): initialize, tools/list and tools/call, with tools to list assets, find charts and read their data. It is read-only and needs no account or key: it serves what the Free plan includes, and a chart on a higher plan answers with the plan that includes it. Send no credentials; a request with an Authorization or X-Api-Key header is refused. Guide: https://cryptokeyhole.com/mcp/",
        "security": [
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ]
                  },
                  "id": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "example": "tools/list"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The JSON-RPC answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "A notification was accepted"
          },
          "400": {
            "description": "An invalid JSON-RPC request, or one sent with credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API key from your account page (Plus and higher plans): Authorization: Bearer <key>. Keys are read-only."
      }
    },
    "parameters": {
      "metric": {
        "name": "metric",
        "in": "query",
        "required": true,
        "description": "The chart id, as in its address (/charts/eth/?metric=eth.PriceUSD) or the catalogue.",
        "schema": {
          "type": "string",
          "example": "eth.PriceUSD"
        }
      },
      "interval": {
        "name": "interval",
        "in": "query",
        "description": "Resolution, as the chart offers it: Free 24h, 1w, 1M and 1Y; Plus also 1h; Pro also 10m.",
        "schema": {
          "type": "string",
          "enum": [
            "10m",
            "1h",
            "24h",
            "1w",
            "1M",
            "1Y"
          ],
          "default": "24h"
        }
      },
      "start": {
        "name": "start",
        "in": "query",
        "description": "UTC Unix seconds, included. Without it the chart's default window applies.",
        "schema": {
          "type": "integer"
        }
      },
      "end": {
        "name": "end",
        "in": "query",
        "description": "UTC Unix seconds, not included. Without it the data runs to the latest value.",
        "schema": {
          "type": "integer"
        }
      },
      "sma": {
        "name": "sma",
        "in": "query",
        "description": "Smoothing window in observations (0 for none).",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "smoothing": {
        "name": "smoothing",
        "in": "query",
        "description": "Smoothing method, as on the charts.",
        "schema": {
          "type": "string",
          "enum": [
            "sma",
            "ema",
            "median"
          ],
          "default": "sma"
        }
      },
      "publication": {
        "name": "publication",
        "in": "query",
        "description": "A retained publication id, for the charts that keep them; omit for current data.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request's parameters are invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The API key is invalid or revoked, or was sent to a route keys do not read",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PlanRequired": {
        "description": "Included with a higher plan; locked names it",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown chart, asset, id or API route",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Request limit reached; try again in a minute",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "locked": {
            "$ref": "#/components/schemas/Locked"
          }
        }
      },
      "Locked": {
        "type": "object",
        "description": "What a higher plan would include.",
        "properties": {
          "feature": {
            "type": "string",
            "example": "interval"
          },
          "requiredPlan": {
            "type": "string",
            "enum": [
              "plus",
              "pro",
              "team"
            ]
          },
          "requiredPlanName": {
            "type": "string",
            "example": "Plus"
          },
          "currentPlan": {
            "type": "string",
            "example": "free"
          },
          "currentPlanName": {
            "type": "string",
            "example": "Free"
          },
          "upgradePath": {
            "type": "string",
            "example": "/pricing/"
          },
          "allowedIntervals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Assets": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "example": "ETH"
                },
                "name": {
                  "type": "string",
                  "example": "Ethereum"
                },
                "route": {
                  "type": "string",
                  "example": "eth"
                },
                "prefix": {
                  "type": "string",
                  "example": "eth.",
                  "description": "The asset's chart ids start with it (not for BTC)."
                }
              }
            }
          }
        }
      },
      "Metric": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "eth.PriceUSD"
          },
          "name": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "example": "USD/ETH"
          },
          "description": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "intervals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "description": "held: planned but not published (see reason)."
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "historyStart": {
            "type": "integer",
            "nullable": true,
            "description": "UTC seconds, the first period."
          },
          "historyEnd": {
            "type": "integer",
            "nullable": true,
            "description": "UTC seconds, the end of the last period (not included)."
          }
        }
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Metric"
            }
          }
        }
      },
      "Point": {
        "type": "object",
        "required": [
          "t",
          "v",
          "finality"
        ],
        "properties": {
          "t": {
            "type": "integer",
            "description": "The period's start, UTC seconds."
          },
          "v": {
            "type": "string",
            "nullable": true,
            "description": "Exact decimal; null where there is no observation."
          },
          "finality": {
            "type": "string",
            "enum": [
              "final",
              "provisional",
              "partial"
            ]
          }
        }
      },
      "Series": {
        "type": "object",
        "properties": {
          "metric": {
            "$ref": "#/components/schemas/Metric"
          },
          "interval": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "current; delayed (the source is late, with its delay); held (not published); locked (above the plan, see locked)."
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          },
          "components": {
            "type": "array",
            "description": "The lines of a chart with several, each with its points.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Point"
                  }
                }
              }
            }
          },
          "historyStart": {
            "type": "integer",
            "nullable": true
          },
          "historyEnd": {
            "type": "integer",
            "nullable": true
          },
          "generatedAt": {
            "type": "integer"
          },
          "sourceObservedAt": {
            "type": "integer",
            "nullable": true
          },
          "locked": {
            "$ref": "#/components/schemas/Locked"
          }
        }
      },
      "Closes": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "example": "BTC"
          },
          "n": {
            "type": "integer"
          },
          "t0": {
            "type": "integer"
          },
          "v": {
            "type": "array",
            "items": {
              "type": "number",
              "nullable": true
            }
          },
          "now": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Charts",
      "description": "Chart data, the catalogue and downloads"
    },
    {
      "name": "Indices",
      "description": "The Fear & Greed Index"
    },
    {
      "name": "Markets",
      "description": "Perpetual futures screener and funding carry"
    },
    {
      "name": "Tools",
      "description": "Data behind the free calculators"
    },
    {
      "name": "Platform",
      "description": "Status and the MCP server"
    }
  ],
  "externalDocs": {
    "description": "API keys, plans, Google Sheets, Excel and Python",
    "url": "https://cryptokeyhole.com/data-access/"
  }
}