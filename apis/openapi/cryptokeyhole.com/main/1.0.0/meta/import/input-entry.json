        "operationId": "getPerpsScreener",
        "summary": "Perpetual futures screener",
        "description": "One row per coin across the venues we collect, at the hour. Free (no key): the coins with the highest 24-hour volume, without open-interest, funding, liquidation or long/short values. Plus: every coin and contract with those values, and CSV. Pro: the five-minute view.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "5m"
              ],
              "default": "1h"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The screener",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PlanRequired"
          }
        }
      }
    },
