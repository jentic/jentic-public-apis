                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "classification": {
                  "type": "string",
                  "description": "Recorded epoch comparison classification."
                },
                "at": {
                  "type": "string",
                  "description": "Source observation time."
                }
              },
              "required": [
