                  "type": "string",
                  "const": "dataforseo"
                },
                "metric": {
                  "type": "string",
                  "const": "rank"
                },
                "rank_scale": {
                  "type": "string",
                  "const": "one_thousand"
                },
                "previous_run_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                },
                "current_run_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                },
                "previous_rank": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "current_rank": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "change": {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "observed_at": {
                  "type": "null",
                  "description": "UTC timestamp of the observation used here."
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                },
