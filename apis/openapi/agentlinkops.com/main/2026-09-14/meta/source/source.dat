        "description": "Send rowIds and idempotencyKey in the JSON body. Imports selected saved Bing rows as unchecked discovery candidates; repeat the same request key when retrying.",
        "parameters": [
          {
            "name": "connectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
