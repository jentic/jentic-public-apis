                      "SAR",
                      "ILS",
                      "THB",
                      "TRY",
                      "IDR",
                      "MYR",
                      "PHP",
                      "VND",
                      "KWD",
                      "BHD",
                      "OMR"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
