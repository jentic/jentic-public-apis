                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "contactRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
                  },
                  {
                    "type": "null"
