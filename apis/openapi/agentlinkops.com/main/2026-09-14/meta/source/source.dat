            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "The weekday value; allowed values and bounds are specified in this schema."
          },
          "categories": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "placements",
                "destinations",
                "competitors",
                "workspace"
              ]
