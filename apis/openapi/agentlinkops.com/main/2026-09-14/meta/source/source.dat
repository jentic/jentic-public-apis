    "/v1/baseline-interactions": {
      "post": {
        "operationId": "resource_post__v1_baseline_interactions",
        "summary": "Development-only consented client capture; default off",
        "description": "Development-only consented client capture; default off. When enabled requires a human session, exact PUBLIC_ORIGIN, current selected baseline and browser consent token. Successful export/copy hashes are client byte claims, not independent execution evidence. candidateId is only for source_inspected; artifactSha256 is only for portable_export_completed or agent_task_copied. Returns typed disabled/consent/ineligible/capacity receipts without supplier work.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match configured PUBLIC_ORIGIN."
          },
          {
            "name": "X-Workspace-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Development-only consented client capture; default off. When enabled requires a human session, exact PUBLIC_ORIGIN, current selected baseline and browser consent token. Successful export/copy hashes are client byte claims, not independent execution evidence. candidateId is only for source_inspected; artifactSha256 is only for portable_export_completed or agent_task_copied. Returns typed disabled/consent/ineligible/capacity receipts without supplier work.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "type": "number",
                      "const": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "recorded",
                        "deduplicated",
                        "disabled",
                        "consent_required",
                        "unavailable",
                        "ineligible",
                        "daily_capacity_reached",
                        "subject_capacity_reached"
                      ]
                    },
                    "event_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "cohort": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "fixture",
                            "internal",
                            "pilot",
                            "customer"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "schema_version",
                    "status",
                    "event_id",
                    "cohort"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error envelope with code, message and optional recovery details."
          }
        },
        "x-command": null,
        "security": [
          {
            "humanSession": []
          }
        ],
        "externalDocs": {
          "url": "https://docs.agentlinkops.com/reference/http/account-access"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "schema_version": {
                    "type": "number",
                    "const": 1
                  },
                  "runId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "useful_result_viewed",
                      "source_inspected",
                      "portable_export_completed",
                      "agent_task_copied"
                    ]
                  },
                  "consentToken": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 256
                  },
                  "candidateId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "artifactSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "schema_version",
                  "runId",
                  "event",
                  "consentToken"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/link-review/artifacts": {
      "post": {
        "operationId": "resource_post__v1_link_review_artifacts",
        "summary": "Development-only held review preparation; default off with LINK_REVIEW_DISABLED",
        "description": "Development-only held review preparation; default off with LINK_REVIEW_DISABLED. Requires events:read and exact accessible project; accepts agent API keys or human session (human workspace selection uses X-Workspace-ID). Explicit intent prepares a bounded immutable server artifact, digest and confirmation; does not complete a review or call a supplier.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Development-only held review preparation; default off with LINK_REVIEW_DISABLED. Requires events:read and exact accessible project; accepts agent API keys or human session (human workspace selection uses X-Workspace-ID). Explicit intent prepares a bounded immutable server artifact, digest and confirmation; does not complete a review or call a supplier.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "type": "number",
                      "const": 1
                    },
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "review": {
                      "type": "object",
                      "properties": {
                        "schema_version": {
                          "type": "number",
                          "const": 1
                        },
                        "kind": {
                          "type": "string",
                          "const": "agentlinkops_retained_change_review"
                        },
                        "raw": {
                          "type": "object",
                          "properties": {
                            "schema_version": {
                              "type": "number",
                              "const": 1
                            },
                            "workspace_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "project_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "coverage_scope": {
                              "type": "string",
                              "const": "retained_event_feed"
                            },
                            "from": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "as_of": {
                              "type": "string",
                              "maxLength": 256
                            },
                            "through_sequence": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 500
                            },
                            "limit": {
                              "type": "number",
                              "const": 500
                            },
                            "truncated": {
                              "type": "boolean"
                            },
                            "complete": {
                              "type": "boolean"
                            },
                            "scan_limited": {
                              "type": "boolean"
                            },
                            "scan_limit": {
                              "type": "number",
                              "const": 10000
                            },
                            "retention_limited": {
                              "type": "boolean"
                            },
                            "events": {
                              "maxItems": 500,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                  },
                                  "workspace_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                  },
                                  "project_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                  },
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "placement_acquired",
                                      "placement_recovered",
                                      "placement_lost"
                                    ]
                                  },
                                  "created_at": {
                                    "type": "string",
                                    "maxLength": 256
                                  }
                                },
                                "required": [
                                  "id",
                                  "workspace_id",
                                  "project_id",
                                  "type",
                                  "created_at"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "schema_version",
                            "workspace_id",
                            "project_id",
                            "coverage_scope",
                            "from",
                            "as_of",
                            "through_sequence",
                            "count",
                            "limit",
                            "truncated",
                            "complete",
                            "scan_limited",
                            "scan_limit",
                            "retention_limited",
                            "events"
                          ],
                          "additionalProperties": false
                        },
                        "counts": {
                          "type": "object",
                          "properties": {
                            "first_observed_events": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "recovered_events": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "recorded_lost_events": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "first_observed_events",
                            "recovered_events",
                            "recorded_lost_events"
                          ],
                          "additionalProperties": false
                        },
                        "coverage_gaps": {
                          "maxItems": 4,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 256
                          }
                        },
                        "proposed_review_actions": {
                          "maxItems": 2,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 256
                          }
                        }
                      },
                      "required": [
                        "schema_version",
                        "kind",
                        "raw",
                        "counts",
                        "coverage_gaps",
                        "proposed_review_actions"
                      ],
                      "additionalProperties": false
                    },
                    "expires_at": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "confirmation": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "schema_version",
                    "artifact_id",
                    "sha256",
                    "review",
                    "expires_at",
                    "confirmation"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error envelope with code, message and optional recovery details."
          }
        },
        "x-command": null,
        "externalDocs": {
          "url": "https://docs.agentlinkops.com/reference/http/account-access"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "projectId",
                  "from"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
