    "/v1/link-review/complete": {
      "post": {
        "operationId": "resource_post__v1_link_review_complete",
        "summary": "Development-only explicit human review completion; default off with LINK_REVIEW_DISABLED",
        "description": "Development-only explicit human review completion; default off with LINK_REVIEW_DISABLED. Requires exact PUBLIC_ORIGIN, human session, current write-capable member and events:read. Exact held artifact/digest/sequence/confirmation is required. Optional browser consent capture does not gate the acknowledgment. Replays retain the original receipt; older acknowledgments cannot lower the current checkpoint or resolve incomplete history.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match configured PUBLIC_ORIGIN."
          },
          {
            "name": "X-Workspace-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Development-only explicit human review completion; default off with LINK_REVIEW_DISABLED. Requires exact PUBLIC_ORIGIN, human session, current write-capable member and events:read. Exact held artifact/digest/sequence/confirmation is required. Optional browser consent capture does not gate the acknowledgment. Replays retain the original receipt; older acknowledgments cannot lower the current checkpoint or resolve incomplete history.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
