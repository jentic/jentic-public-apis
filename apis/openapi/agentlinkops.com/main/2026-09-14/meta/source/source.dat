          },
          "cursor": {
            "description": "Opaque continuation returned by this same listing with the same filters; omit for the first page.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "limit": {
            "description": "Maximum records in this page, 1 to 100; defaults to 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        "additionalProperties": false
