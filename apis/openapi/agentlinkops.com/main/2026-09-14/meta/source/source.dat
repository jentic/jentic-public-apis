          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "default": "My workspace"
                  }
                },
                "required": [],
                "additionalProperties": true
              }
            }
          }
        }
      }
