                              "EUR",
                              "GBP",
                              "JPY",
                              "CAD",
                              "AUD",
                              "NZD",
                              "CHF",
                              "CNY",
                              "HKD",
                              "SGD",
                              "INR",
                              "KRW",
                              "BRL",
                              "MXN",
                              "SEK",
                              "NOK",
                              "DKK",
                              "PLN",
                              "CZK",
                              "HUF",
                              "ZAR",
                              "AED",
                              "SAR",
                              "ILS",
                              "THB",
                              "TRY",
                              "IDR",
                              "MYR",
                              "PHP",
                              "VND",
                              "KWD",
                              "BHD",
                              "OMR"
