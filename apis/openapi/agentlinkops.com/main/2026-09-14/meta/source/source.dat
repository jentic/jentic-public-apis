            "type": "string",
            "enum": [
              "live",
              "lost",
              "all"
            ],
            "description": "Supplier-reported backlink status filter; this is not AgentLinkOps verification."
          },
          "rows": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "anyOf": [
                {},
                {
                  "type": "object",
                  "properties": {
                    "source_url": {
