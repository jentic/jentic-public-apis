{
  "openapi": "3.0.3",
  "info": {
    "title": "Serper Web Search API",
    "description": "Google Search API that provides structured search results including web, images, news, places, videos, shopping, scholar, patents, and autocomplete. Popular in AI agent frameworks like LangChain and CrewAI for web search tool integration.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://serper.dev"
  },
  "servers": [
    {
      "url": "https://google.serper.dev",
      "description": "Serper production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "operationId": "webSearch",
        "summary": "Google Web Search",
        "description": "Perform a Google web search and get structured results including organic results, knowledge graph, people also ask, and related searches.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/images": {
      "post": {
        "operationId": "imageSearch",
        "summary": "Google Image Search",
        "description": "Search for images on Google and get structured image results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/news": {
      "post": {
        "operationId": "newsSearch",
        "summary": "Google News Search",
        "description": "Search for news articles on Google News.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "News search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "post": {
        "operationId": "placesSearch",
        "summary": "Google Places Search",
        "description": "Search for places and local businesses on Google Maps.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Places search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/videos": {
      "post": {
        "operationId": "videoSearch",
        "summary": "Google Video Search",
        "description": "Search for videos on Google.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/shopping": {
      "post": {
        "operationId": "shoppingSearch",
        "summary": "Google Shopping Search",
        "description": "Search for products on Google Shopping.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shopping search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/scholar": {
      "post": {
        "operationId": "scholarSearch",
        "summary": "Google Scholar Search",
        "description": "Search for academic papers and citations on Google Scholar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scholar search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScholarSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patents": {
      "post": {
        "operationId": "patentSearch",
        "summary": "Google Patent Search",
        "description": "Search for patents on Google Patents.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patent search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatentSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/autocomplete": {
      "post": {
        "operationId": "autocomplete",
        "summary": "Google Autocomplete",
        "description": "Get Google autocomplete suggestions for a query.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AutocompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autocomplete suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutocompleteResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "Serper API key"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query"
          },
          "gl": {
            "type": "string",
            "description": "Country code for Google search (e.g., 'us', 'uk')"
          },
          "hl": {
            "type": "string",
            "description": "Language code (e.g., 'en', 'fr')"
          },
          "num": {
            "type": "integer",
            "description": "Number of results to return (default 10, max 100)",
            "default": 10
          },
          "page": {
            "type": "integer",
            "description": "Page number for pagination",
            "default": 1
          },
          "tbs": {
            "type": "string",
            "description": "Time-based search filter (e.g., 'qdr:d' for past day)"
          },
          "location": {
            "type": "string",
            "description": "Location for localized results"
          }
        }
      },
      "AutocompleteRequest": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Query for autocomplete suggestions"
          },
          "gl": {
            "type": "string",
            "description": "Country code"
          },
          "hl": {
            "type": "string",
            "description": "Language code"
          }
        }
      },
      "WebSearchResponse": {
        "type": "object",
        "properties": {
          "searchParameters": {
            "type": "object",
            "properties": {
              "q": { "type": "string" },
              "gl": { "type": "string" },
              "hl": { "type": "string" },
              "type": { "type": "string" }
            }
          },
          "organic": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganicResult"
            }
          },
          "knowledgeGraph": {
            "$ref": "#/components/schemas/KnowledgeGraph"
          },
          "peopleAlsoAsk": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": { "type": "string" },
                "snippet": { "type": "string" },
                "title": { "type": "string" },
                "link": { "type": "string" }
              }
            }
          },
          "relatedSearches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "query": { "type": "string" }
              }
            }
          }
        }
      },
      "OrganicResult": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "link": { "type": "string" },
          "snippet": { "type": "string" },
          "position": { "type": "integer" },
          "date": { "type": "string" },
          "sitelinks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "link": { "type": "string" }
              }
            }
          }
        }
      },
      "KnowledgeGraph": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "imageUrl": { "type": "string" },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "ImageSearchResponse": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "imageUrl": { "type": "string" },
                "imageWidth": { "type": "integer" },
                "imageHeight": { "type": "integer" },
                "thumbnailUrl": { "type": "string" },
                "source": { "type": "string" },
                "domain": { "type": "string" },
                "link": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "NewsSearchResponse": {
        "type": "object",
        "properties": {
          "news": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "link": { "type": "string" },
                "snippet": { "type": "string" },
                "date": { "type": "string" },
                "source": { "type": "string" },
                "imageUrl": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "PlacesSearchResponse": {
        "type": "object",
        "properties": {
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "address": { "type": "string" },
                "latitude": { "type": "number" },
                "longitude": { "type": "number" },
                "rating": { "type": "number" },
                "ratingCount": { "type": "integer" },
                "category": { "type": "string" },
                "phoneNumber": { "type": "string" },
                "website": { "type": "string" },
                "cid": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "VideoSearchResponse": {
        "type": "object",
        "properties": {
          "videos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "link": { "type": "string" },
                "snippet": { "type": "string" },
                "date": { "type": "string" },
                "imageUrl": { "type": "string" },
                "duration": { "type": "string" },
                "source": { "type": "string" },
                "channel": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "ShoppingSearchResponse": {
        "type": "object",
        "properties": {
          "shopping": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "source": { "type": "string" },
                "link": { "type": "string" },
                "price": { "type": "string" },
                "imageUrl": { "type": "string" },
                "rating": { "type": "number" },
                "ratingCount": { "type": "integer" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "ScholarSearchResponse": {
        "type": "object",
        "properties": {
          "organic": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "link": { "type": "string" },
                "snippet": { "type": "string" },
                "year": { "type": "integer" },
                "citedBy": { "type": "integer" },
                "publicationInfo": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "PatentSearchResponse": {
        "type": "object",
        "properties": {
          "organic": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "link": { "type": "string" },
                "snippet": { "type": "string" },
                "patentId": { "type": "string" },
                "date": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          }
        }
      },
      "AutocompleteResponse": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
