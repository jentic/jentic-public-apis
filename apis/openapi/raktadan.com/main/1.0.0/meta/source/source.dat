                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "donations": {
                                "type": "integer"
                              },
                              "consumptions": {
                                "type": "integer"
                              },
                              "netChange": {
                                "type": "integer"
                              },
                              "availableUnits": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "statistics": {
                          "type": "object",
                          "properties": {
                            "totalDonations": {
                              "type": "integer"
                            },
                            "totalConsumptions": {
                              "type": "integer"
                            },
                            "averageDailyDonations": {
                              "type": "number"
                            },
                            "averageDailyConsumptions": {
                              "type": "number"
                            },
                            "peakDonationDay": {
                              "type": "string"
                            },
                            "peakConsumptionDay": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
