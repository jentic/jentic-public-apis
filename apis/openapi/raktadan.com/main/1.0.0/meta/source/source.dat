            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "newRole"
                ],
                "properties": {
                  "newRole": {
                    "type": "string",
                    "enum": [
                      "DONOR",
                      "RECIPIENT"
                    ],
                    "description": "New role to switch to"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role toggled successfully",
