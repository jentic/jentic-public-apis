  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "required": [
          "status",
          "profile"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "gone",
              "unavailable"
            ]
          },
          "profile": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "total",
          "credits_used",
          "counts",
          "results"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "completed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "type": "integer"
          },
          "credits_used": {
            "type": "integer"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "status",
                "profile"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "gone",
                    "unavailable",
                    "failed",
                    "pending",
                    "invalid_url",
                    "duplicate"
                  ]
                },
                "profile": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Profile"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "public_id",
          "profile_url",
          "full_name",
          "first_name",
          "last_name",
          "photo_url",
          "headline",
          "about",
          "location",
          "country",
          "experience",
          "education",
          "languages",
          "followers",
          "connections",
          "creator",
          "badges",
          "last_post_at",
          "recent_posts",
          "recent_articles",
          "last_reaction_at",
          "recent_reactions",
          "last_comment_at",
          "recent_comments",
          "last_active_at",
          "scraped_at"
        ],
        "properties": {
          "public_id": {
            "type": "string"
          },
          "profile_url": {
            "type": "string"
          },
          "full_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "photo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "description": "Two-letter country code."
          },
          "experience": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Position"
            }
          },
          "education": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/School"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "followers": {
            "type": [
              "integer",
              "null"
            ]
          },
          "connections": {
            "type": [
              "integer",
              "null"
            ],
            "description": "500 means 500 or more."
          },
          "creator": {
            "type": "boolean"
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_post_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "recent_posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "recent_articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Article"
            }
          },
          "last_reaction_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "recent_reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reaction"
            }
          },
          "last_comment_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Approximate: LinkedIn shows only a relative age for comments."
          },
          "recent_comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "last_active_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The newest of last_post_at, last_reaction_at and last_comment_at."
          },
          "scraped_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "The public view of a LinkedIn profile. Every key is always present."
      },
      "Position": {
        "type": "object",
        "required": [
          "company",
          "company_url",
          "title",
          "location",
          "description",
          "start_date",
          "end_date"
        ],
        "properties": {
          "company": {
            "type": "string"
          },
          "company_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Current roles only."
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "\"2014\" or \"2014-02\"."
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "null for a current role."
          }
        }
      },
      "School": {
        "type": "object",
        "required": [
          "school",
          "school_url",
          "start_date",
          "end_date"
        ],
        "properties": {
          "school": {
            "type": "string"
          },
          "school_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "url",
          "posted_at",
          "text",
          "likes"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "likes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Article": {
        "type": "object",
        "required": [
          "url",
          "headline",
          "image_url",
          "published_at",
          "likes"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "headline": {
            "type": [
