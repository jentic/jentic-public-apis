                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Batch created; every result starts as pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyBatch"
                }
              }
            }
          },
          "401": {
