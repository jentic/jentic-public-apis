,"in":"query","required":true,"description":"Comma-separated skill slugs, 10 to 200, each once. Order does not matter; wildcards are refused.","schema":{"type":"string"}},{"name":"x402Version","in":"query","required":false,"description":"Force the older protocol version. Only for clients that speak x402 v1.","schema":{"type":"integer","enum":[1,2],"default":2}}],"responses":{"200":{"description":"Payment settled. JSON with complete, receipt and skills[]: each with file.content (or file: null and a message when it could not be read now) and its own redownload token (shown once)."},"400":{"description":"skills_required, invalid_slug, duplicate_slug, pack_too_small or pack_too_large: fix skills= and ask again."},"402":{"description":"Payment required: the pack price in the PAYMENT-REQUIRED header and body (body.pack: count, sum, discount, price, and buyer_cap_note above $1). Nothing is charged by a 402."},"404":{"description":"skill_not_found: body.skills lists the slugs that are not for sale."},"409":{"description":"already_paid or payment_in_progress, exactly as for a single skill: do NOT sign a new authorization."},"429":{"description":"rate_limited: a pack counts as one attempt. Wait retry_after_seconds and resend the identical header."},"503":{"description":"not_selling, facilitator_unavailable or temporarily_unavailable: nothing was settled; retry later."}}}},"/v1/skills":{"get":{"operationId":"list_skills","summary":"List the skills for sale, with prices and buy URLs","tags":["public"],"security":[],"responses":{"200":{"description":"OK"}},"parameters":[{"name":"limit","in":"query","required":false,"description":"Page size, at most 24.","schema":{"type":"integer","minimum":1,"maximum":24}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"q","in":"query","required":false,"description":"Text search (ranked by relevance, no cursor).","schema":{"type":"string"}},{"name":"category","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag","in":"query","required":false,"schema":{"type":"string"}},{"name":"language","in":"query","required":false,"schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","enum":["new","price","popular","featured"]}}]}},"/v1/skills/{slug}":{"get":{"operationId":"get_skill","summary":"One skill card: price, tests, outline, versions","tags":["public"],"security":[],"responses":{"200":{"description":"OK"},"404":{"description":"skill_not_found"}},"parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}]}},"/v1/purchases/{token}":{"get":{"operationId":"redownload","summary":"Re-download a purchased file (and new versions) for free with the token","tags":["public"],"security":[],"responses":{"200":{"description":"OK"},"404":{"description":"not_found"}},"parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string"}}]}},"/health":{"get":{"operationId":"health","summary":"Is the guard alive, and are we selling right now","tags":["public"],"security":[],"responses":{"200":{"description":"OK"}}}},"/a2a":{"post":{"operationId":"a2a","summary":"A2A 1.0 JSON-RPC receptionist: every message is answered with the catalogue guide (no payment taken)","tags":["public"],"security":[],"responses":{"200":{"description":"OK"}}}}}}