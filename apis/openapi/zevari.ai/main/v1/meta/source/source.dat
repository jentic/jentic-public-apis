t when confirmation_id refers to a bulk_actions parent (from confirmations.requestAction). Identifies the per-item child to consume — e.g. 'itm_03'. Omit for single-action confirmations."}},"required":["postId","text"],"additionalProperties":false},"examples":{"default":{"value":{"postId":"example_id","text":"string"}}}}}}}},"/v1/linkedin/getPost":{"get":{"tags":["linkedin"],"operationId":"linkedin_getPost","summary":"Get LinkedIn post","description":"Transport: call this endpoint with HTTP GET and query parameters. Fetch a LinkedIn post's details, engagement stats, and metadata by post reference. For /posts/...-share-<id> use urn:li:share:<id>; for /posts/...-ugcPost-<id> use urn:li:ugcPost:<id>; activity ids may be passed as the numeric id. Use the returned social_id for comments, reactions, and comment listing.","x-zevari-http-method":"GET","x-zevari-tool":"linkedin_get_post","x-zevari-method":{"method":"linkedin.getPost","http_method":"GET","namespace":"linkedin","operation":"getPost","path":"/v1/linkedin/getPost","api_version":"v1","tool_name":"linkedin_get_post","docs_url":"https://docs.zevari.ai/api/reference#linkedin-getPost","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-getPost"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"linkedin.getPost","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for linkedin.ge