tent":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-getReplies","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"campaign_id","in":"query","required":true,"description":"Campaign ID","schema":{"type":"string","description":"Campaign ID"}},{"name":"limit","in":"query","required":false,"description":"Max replies to return","schema":{"type":"number","minimum":1,"maximum":200,"default":50,"description":"Max replies to return"}},{"name":"before","in":"query","required":false,"description":"ISO-8601 occurred_at cursor from a previous page's next_before","schema":{"type":"string","description":"ISO-8601 occurred_at cursor from a previous page's next_before"}},{"name":"before_id","in":"query","required":false,"description":"Reply id cursor from a previous page's next_before_id; pairs with before for stable keyset pagination","schema":{"type":"string","description":"Reply id cursor from a previous page's next_before_id; pairs with before for stable keyset pagination"}},{"name":"include_ignored","in":"query","required":false,"description":"Include replies marked ignored (auto-replies, bounces, delivery notifications)","schema":{"type":"boolean","default":false,"description":"Include replies marked ignored (auto-replies, bounces, delivery notifications)"}}]}},"/v1/campaigns/delete":{"delete":{"tags":["campaigns"],"operationId":"campaigns_delete","summary":"Delete campaigns","description":"Transport: call this endpoint with HTTP DELETE and a JSON request body. Delete (archive) one or more campaigns in the active workspace/account. This is valid for any campaign status. The campaign disappears from the workspace and all execution stops: pending execution jobs and queued LinkedIn actions are cancelled and stale activation approvals expire. The campaign row and all historical action/audit rows are retained with their campaign attribution for audit purposes; deletion cannot be undone from the workspace. Destructive: only call after the user explicitly confirms the exact campaign IDs and sets confirm_delete=true.","x-zevari-http-method":"DELETE","x-zevari-tool":"campaigns_delete","x-zevari-method":{"method":"campaigns.delete","http_method":"DELETE","namespace":"campaigns","operation":"delete","path":"/v1/campaigns/delete","api_version":"v1","tool_name":"campaigns_delete","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Campaign deletion is a destructive workspace archive: execution stops and the campaign disappears from customer-facing views, while the row and attributed audit history are retained. Only call after the user confirms exact campaign IDs; include campaign_id or campaign_ids plus confirm_delete=true. Do not infer broad delete-all intent, and handle partial failures from the frozen deleted/failed response arrays.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-delete"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"All requested campaigns were archived and removed from customer-facing campaign views; audit history remains attributable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"success":{"value":{"ok":true,"method":"campaigns.delete","data":{"ok":true,"deleted":[{"ok":true,"campaign_id":"campaign_uuid_1","name":"Q2 founder outreach","status":"draft","cancelled_jobs":0,"detached_safety_logs":0,"detached_reconciliation_logs":0,"expired_confirmations":0,"expired_confirmation_items":0}],"failed":[]},"request_id":"req_example"}}}}}},"207":{"description":"Partial failure. At least one campaign was archived and at least one failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"partial_failure":{"value":{"ok":false,"method":"campaigns.delete","data":{"ok":false,"deleted":[{"ok":true,"campaign_id":"campaign_uuid_1","name":"Q2 founder outreach","status":"draft","cancelled_jobs":1,"detached_safety_logs":0,"detached_reconciliation_logs":0,"expired_confirmations":1,"expired_confirmation_items":3}],"failed":[{"ok":false,"campaign_id":"campaign_uuid_2","error":"not_found_or_not_accessible"}]},"request_id":"req_example"}}}}}},"400":{"description":"Invalid delete request or complete delete failure.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.delete.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Include campaign_id or campaign_ids and confirm_delete=true only after the user confirms the exact campaign IDs.","details":[{"code":"invalid_literal","path":["confirm_delete"],"message":"Invalid literal value, expected true"}]},"request_id":"req_example"}},"missing_confirmation":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.delete.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Set confirm_delete=true only after the user confirms the exact campaign IDs to archive from the workspace.","details":[{"code":"invalid_literal","path":["confirm_delete"],"message":"Invalid literal value, expected true"}]},"request_id":"req_example"}},"missing_campaign_ids":{"value":{"error":{"code":"invalid_arguments","message":"campaign_id or campaign_ids is required","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Include exactly the campaign_id or campaign_ids the user confirmed, then retry with confirm_delete=true."},"request_id":"req_example"}},"too_many_campaign_ids":{"value":{"error":{"code":"invalid_arguments","message":"campaigns.delete supports at most 100 campaign IDs.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Split the delete request into batches of 100 or fewer exact campaign IDs.","details":[{"code":"too_big","path":["campaign_ids"],"message":"Array must contain at most 100 element(s)"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-delete","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"campaign_id":{"type":"string","description":"Single campaign ID to delete"},"campaign_ids":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":100,"description":"Campaign IDs to delete in one request"},"confirm_delete":{"type":"boolean","enum":[true],"description":"Required destructive confirmation. Set to true only after the user explicitly confirms the exact campaign ID(s) to delete (the campaign is archived out of the workspace and cannot be restored from it)."}},"required":["confirm_delete"],"additionalProperties":false},"examples":{"default":{"value":{"confirm_delete":true}}}}}}}},"/v1/confirmations/requestAction":{"post":{"tags":["confirmations"],"operationId":"confirmations_requestAction","summary":"Request action approval","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Stage an approval-gated action for the public REST API. Call this before outbound LinkedIn/email writes and campaign activation. Personalized campaign enrollment is intentionally excluded: call campaigns.addTargets with personalized_steps so the idempotency receipt is reserved before its internal campaign_enroll_personalized_targets approval is staged. Campaign activation can be staged only while the campaign is draft or paused. Terminal, processing, active, and archived campaign activation is rejected before a confirmation is created or Autopilot is evaluated with CAMPAIGN_INVALID_STATUS_TRANSITION. Automated flow: if the response data includes autopilot.approved=true, immediately retry the gated write with the returned confirmation_id. If Autopilot is not approved, show or store approval_url, wait for browser approval in Zevari, then retry the gated write with the same confirmation_id. For linkedin_send_connection_request payloads, note length is tier-limited before approval: free LinkedIn senders support up to 200 characters; paid/Premium/Sales Navigator senders support up to 300. Over-limit notes return HTTP 400 with ok=false and data.error='connection_note_too_long'. REST clients do not have access to MCP-only chat approval tools.","x-zevari-http-method":"POST","x-zevari-tool":"actions_request_confirmation","x-zevari-method":{"method":"confirmations.requestAction","http_method":"POST","namespace":"confirmations","operation":"requestAction","path":"/v1/confirmations/requestAction","api_version":"v1","tool_name":"actions_request_confirmation","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Stage the exact executable payload for an action_type in this endpoint's schema. Personalized campaign enrollment is unsupported here: start with campaigns.addTargets and include the stable idempotency key plus each target's complete personalized_steps. campaigns.addTargets reserves the receipt, stages its internal approval, and returns the exact retry when manual approval is required.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#confirmations-requestAction"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"confirmations.requestAction","data":{},"request_id":"req_example"}}}}}},"400":{"description":"CAMPAIGN_INVALID_STATUS_TRANSITION is returned when campaign activation is staged outside draft/paused; other invalid staged payloads or arguments return their documented errors.","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ZevariErrorEnvelope"},{"$ref":"#/components/schemas/ZevariResponseEnvelope"}]},"examples":{"invalid_campaign_transition":{"value":{"ok":false,"method":"confirmations.requestAction","data":{"error_code":"CAMPAIGN_INVALID_STATUS_TRANSITION","campaign_id":"campaign_uuid","current_status":"completed","requested_status":"active","message":"The requested campaign lifecycle transition is not allowed.","recovery_action":"Create a new campaign; terminal campaigns cannot be reactivated."},"request_id":"req_example"}},"personalized_snapshot_invalid":{"value":{"ok":false,"method":"confirmations.requestAction","data":{"error_code":"CAMPAIGN_PERSONALIZED_SNAPSHOT_INVALID","campaign_id":"campaign_uuid","message":"Cannot stage campaign activation because personalized target snapshots no longer match the current campaign steps.","errors":["Personalized target target_uuid is missing snapshot for step 3 (message)."],"recovery_action":"Restore the approved step structure or create a new campaign, then validate and stage fresh activation approval."},"request_id":"req_example"}},"connection_note_too_long_free":{"value":{"ok":false,"method":"confirmations.requestAction","data":{"error":"connection_note_too_long","message":"Connection request note is 230 characters, exceeding the LinkedIn free account limit of 200.","details":{"note_length":230,"max_length":200,"tier":"free"}},"request_id":"req_example"}},"invalid_arguments":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for confirmations.requestAction.","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["action_type"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#confirmations-requestAction","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"action_type":{"type":"string","enum":["linkedin_send_message","linkedin_send_inmail","linkedin_send_connection_request","linkedin_cancel_invitation","linkedin_respond_invitation","linkedin_create_post","linkedin_comment_on_post","linkedin_react_to_post","linkedin_react_post_comment","email_send_message","campaign_activate","campaign_update_target_set","campaign_update_step_config","bulk_delete","bulk_export","agents_enrich_email_batch","account_reparent"],"description":"The exact allowlisted action family this confirmation gates. Valid values are LinkedIn/email sends/InMails/posts/comments/reactions, campaign_activate, campaign_update_target_set, campaign_update_step_config, bulk_delete, bulk_export, and agents_enrich_email_batch. For campaign activation, use 'campaign_activate' with payload={campaign_id: <id>}. Personalized enrollment must use campaigns.addTargets, which stages its receipt-bound confirmation internally. Entity saves such as targets_save are not valid action_types and do not need confirmation."},"payload":{"type":"object","additionalProperties":{},"description":"The COMPLETE action payload. LinkedIn writes are validated at stage time; connection requests accept saved lead/provider/public/profile URL aliases and are stored as canonical provider-ID payloads, while linkedin_comment_on_post/linkedin_react_to_post postId values are resolved to the post's social_id before approval. After approval, execution uses this stored approved payload as the source of truth."},"cost_estimate_cents":{"type":"integer","minimum":0,"description":"Estimated external cost in cents (e.g. email enrichment reveals). Shown to the user on the approval page."},"content_policy_override":{"type":"array","items":{"type":"object","properties":{"kind":{"type":"string","enum":["literal","token","rule"]},"value":{"type":"string","minLength":1,"maxLength":200}},"required":["kind","value"],"additionalProperties":false},"maxItems":50,"description":"Send despite these content-policy entries. Pass the refusal's override_entries exactly, and only after the user explicitly agreed to send anyway. Entries not listed still block. A message sent this way waits for the user's approval unless the workspace runs Autopilot Unattended."}},"required":["action_type","payload"],"additionalProperties":false},"examples":{"default":{"value":{"action_type":"campaign_activate","payload":{"campaign_id":"campaign_uuid"}}}}}}}}},"/v1/safety/getStatus":{"get":{"tags":["safety"],"operationId":"safety_getStatus","summary":"Get safety status","description":"Transport: call this endpoint with HTTP GET and query parameters. Get unified safety status for the active organization and LinkedIn account: current pause state, tier, LinkedIn weeklyUsage/dailyCap/burst caps, delays, and recent safety events. weeklyUsage covers LinkedIn actions only — it never includes send_email. Email is gated by per-mailbox caps (not this table); do not invent an org email weekly quota from weeklyUsage.","x-zevari-http-method":"GET","x-zevari-tool":"safety_get_status","x-zevari-method":{"method":"safety.getStatus","http_method":"GET","namespace":"safety","operation":"getStatus","path":"/v1/safety/getStatus","api_version":"v1","tool_name":"safety_get_status","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Use these read-only endpoints to inspect current safety posture, limits, usage, and blockers. Do not infer permission to bypass safety checks or resume paused automation.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#safety-getStatus"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"safety.getStatus","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for safety.getStatus.","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#safety-getStatus","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[]}},"/v1/linkedin/getSafetyStatus":{"get":{"tags":["linkedin"],"operationId":"linkedin_getSafetyStatus","summary":"Get LinkedIn safety status","description":"Transport: call this endpoint with HTTP GET and query parameters. Check current LinkedIn safety status: rate limits, daily caps, circuit breaker state, pause status, and recent safety events. weeklyUsage is LinkedIn-only (no send_email row); email uses mailbox caps, not LinkedIn weekly quotas.","x-zevari-http-method":"GET","x-zevari-tool":"linkedin_get_safety_status","x-zevari-method":{"method":"linkedin.getSafetyStatus","http_method":"GET","namespace":"linkedin","operation":"getSafetyStatus","path":"/v1/linkedin/getSafetyStatus","api_version":"v1","tool_name":"linkedin_get_safety_status","docs_url":"https://docs.zevari.ai/api/reference#linkedin-getSafetyStatus","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Use these read-only endpoints to inspect current safety posture, limits, usage, and blockers. Do not infer permission to bypass safety checks or resume paused automation.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-getSafetyStatus"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":