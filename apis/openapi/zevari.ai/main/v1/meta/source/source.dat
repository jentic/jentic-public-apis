ConnectionRequest":{"post":{"tags":["linkedin"],"operationId":"linkedin_sendConnectionRequest","summary":"Send connection request","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Send a LinkedIn connection request with optional note. REQUIRES confirmations.requestAction first. Recipient identity may be the canonical identifier or a saved lead/provider/public/profile URL alias; Zevari executes the approved canonical payload. Public REST flow: first call confirmations.requestAction with the exact payload you intend to execute. If Autopilot returns approved=true, retry this endpoint immediately with confirmation_id. Otherwise wait for approval_url to be approved in Zevari, then retry with confirmation_id. Connection request notes are tier-limited: free LinkedIn senders support up to 200 characters; paid/Premium/Sales Navigator senders support up to 300. Over-limit notes return HTTP 400 with ok=false and data.error='connection_note_too_long'. If LinkedIn reports already_invited_recently, treat the recipient as pending invite: do not auto-withdraw, remove/re-add, or send another invite; wait for acceptance before follow-up DMs.","x-zevari-http-method":"POST","x-zevari-tool":"linkedin_send_connection_request","x-zevari-method":{"method":"linkedin.sendConnectionRequest","http_method":"POST","namespace":"linkedin","operation":"sendConnectionRequest","path":"/v1/linkedin/sendConnectionRequest","api_version":"v1","tool_name":"linkedin_send_connection_request","docs_url":"https://docs.zevari.ai/api/reference#linkedin-sendConnectionRequest","sensitive":true},"x-sensitive":true,"x-agent-guidance":"This endpoint can stage or execute a write action. Preserve confirmation IDs exactly. For REST automation, execute immediately only when confirmations.requestAction returns autopilot.approved=true; otherwise wait for approval_url browser approval.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-sendConnectionRequest"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"linkedin.sendConnectionRequest","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments, over-limit connection note, or method execution error.","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ZevariErrorEnvelope"},{"$ref":"#/components/schemas/ZevariResponseEnvelope"}]},"examples":{"connection_note_too_long_free":{"value":{"ok":false,"method":"linkedin.sendConnectionRequest","data":{"error":"connection_note_too_long","message":"Connection request note must be 200 characters or less for this LinkedIn free account; received 230.","request_id":"req_example"},"request_id":"req_example"}},"invalid_arguments":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for linkedin.sendConnectionRequest.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-sendConnectionRequest","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["identifier"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-sendConnectionRequest","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"applica