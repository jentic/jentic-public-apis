ent":{"application/json":{"schema":{"type":"object","properties":{"lead_id":{"type":"string","description":"Target ID to update"},"pipeline_status":{"type":"string","enum":["discovered","researched","qualified","warming","connected","replied","converted","disqualified"],"description":"New pipeline status"},"icp_score":{"type":"number","minimum":1,"maximum":5,"description":"ICP score 1-5"},"icp_fit":{"type":"string","description":"ICP fit description"},"connection_status":{"type":"string","enum":["none","pending","connected"]}},"required":["lead_id","pipeline_status"],"additionalProperties":false},"examples":{"default":{"value":{"lead_id":"example_id","pipeline_status":"discovered"}}}}}}}},"/v1/targets/saveResearch":{"post":{"tags":["targets"],"operationId":"targets_saveResearch","summary":"Save target research","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Store research output (ICP score, behavioral profile, company intel) against an existing lead record.","x-zevari-http-method":"POST","x-zevari-tool":"targets_save_research","x-zevari-method":{"method":"targets.saveResearch","http_method":"POST","namespace":"targets","operation":"saveResearch","path":"/v1/targets/saveResearch","api_version":"v1","tool_name":"targets_save_research","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#targets-saveResearch"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"targets.saveResearch","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for targets.saveResearch.","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#targets-saveResearch","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"lead_id":{"type":"string","description":"Target ID"},"research_type":{"type":"string","enum":["profile","behavioral","communication_blueprint","icp_scoring","company_intelligence","personalization"],"description":"Type of research"},"summary":{"type":"string","description":"Human-readable summary"},"data":{"type":"object","additionalProperties":{},"description":"Full structured research output"},"icp_score":{"type":"number","minimum":1,"maximum":5,"description":"ICP score if this is ICP research"},"icp_fit":{"type":"string","description":"ICP fit description"}},"required":["lead_id","research_type","data"],"additionalProperties":false},"examples":{"default":{"value":{"lead_id":"example_id","research_type":"profile","data":{}}}}}}}}},"/v1/targets/getPipeline":{"get":{"tags":["targets"],"operationId":"targets_getPipeline","summary":"Get target pipeline","description":"Transport: call this endpoint with HTTP GET and query parameters. Query leads by pipeline status with pagination.","x-zevari-http-method":"GET","x-zevari-tool":"targets_get_pipeline","x-zevari-method":{"method":"targets.getPipeline","http_method":"GET","namespace":"targets","operation":"getPipeline","path":"/v1/targets/getPipeline","api_version":"v1","tool_name":"targets_get_pipeline","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#targets-getPipeline"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"targets.getPipeline","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for targets.getPipeline.","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#targets-getPipeline","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"status","in":"query","required":false,"description":"Filter by pipeline status","schema":{"type":"string","enum":["discovered","researched","qualified","warming","connected","replied","converted","disqualified"],"description":"Filter by pipeline status"}},{"name":"limit","in":"query","required":false,"schema":{"type":"number","minimum":1,"maximum":100,"default":50}},{"name":"offset","in":"query","required":false,"schema":{"type":"number","minimum":0,"default":0}}]}},"/v1/campaigns/create":{"post":{"tags":["campaigns"],"operationId":"campaigns_create","summary":"Create campaign","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Create a draft campaign. This does not start outbound sending. Public REST campaign creation does not require a launch-campaign skill_run_id; the skill receipt remains an MCP creation requirement. Enrollment defaults to enrollment_mode='fixed'. Explicitly set enrollment_mode='continuous' when the campaign must accept future targets while active. Send enrollment_mode as a TOP-LEVEL field, not inside settings — a nested value is ignored, the campaign silently defaults to fixed, and the response returns a warning. A continuous campaign still needs executable shared campaign-level content at creation; after activation, campaigns.addTargets can admit new recipients with their own approval-bound personalized_steps snapshots. enrollment_mode='continuous' is now supported together with settings.personalization_mode='personalized': later recipients can each carry their own per-lead sequence (a distinct ordered set of steps) in addition to per-lead copy. This is additive and backward-compatible. The response returns status='draft', effective enrollment_mode, targets_editable, add_targets_method='campaigns.addTargets', and next_action so a human or agent can continue without relying on external docs. To launch the draft, call confirmations.requestAction with action_type='campaign_activate' and payload={campaign_id}, then call campaigns.updateStatus with status='active' and the approved confirmation_id.","x-zevari-http-method":"POST","x-zevari-tool":"campaigns_create","x-zevari-method":{"method":"campaigns.create","http_method":"POST","namespace":"campaigns","operation":"create","path":"/v1/campaigns/create","api_version":"v1","tool_name":"campaigns_create","docs_url":"https://docs.zevari.ai/api/reference#campaigns-create","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Resolve and persist every target's linkedin_provider_id before creating a campaign. Enrollment defaults to fixed. Choose enrollment_mode='continuous' when the active campaign should accept later recipients. Continuous creation needs executable shared campaign-level content, but later campaigns.addTargets calls may attach approval-bound personalized_steps snapshots. Creation returns status, effective enrollment_mode, targets_editable, add_targets_method, and next_action; saving a target does not update campaign_targets automatically.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-create"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Draft campaign created. The response describes how to add targets and what to do next.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"continuous_draft":{"value":{"ok":true,"method":"campaigns.create","data":{"campaignId":"campaign_uuid","campaign_id":"campaign_uuid","name":"Q3 founder outreach","type":"outreach","steps":2,"targets":25,"submitted_targets":25,"skipped_targets":0,"suppressed_targets":0,"status":"draft","enrollment_mode":"continuous","enrollment_policy":{"max_batch_size":100,"max_total_targets":5000,"content_mode":"generic"},"targets_editable":true,"add_targets_method":"campaigns.addTargets","add_targets_before_activation":true,"after_activation":"Call campaigns.addTargets with a stable idempotency_key. Supply personalized_steps per target when each new recipient needs exact custom copy; accepted targets are scheduled without pausing.","next_action":"Stage activation approval with actions_request_confirmation, return its approval_url to the user, then activate with campaigns_update_status after approval."},"request_id":"req_example"}}}}}},"400":{"description":"Invalid campaign definition, including missing executable shared content for a continuous campaign at creation, or another method execution error.","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ZevariErrorEnvelope"},{"$ref":"#/components/schemas/ZevariResponseEnvelope"}]},"examples":{"continuous_missing_shared_content":{"value":{"ok":false,"method":"campaigns.create","data":{"error_code":"CONTINUOUS_ENROLLMENT_REQUIRES_GENERIC_CONTENT","message":"Continuous campaign creation requires executable shared campaign-level content.","reason":"Initial per-target content cannot substitute for the campaign's shared executable definition.","fix":"Create the continuous campaign with executable shared step content, then use campaigns.addTargets with approval-bound personalized_steps for each later recipient. Use fixed only when the campaign should not accept later recipients."},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-create","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-create","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-create","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-create","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"Campaign name"},"campaign_type":{"type":"string","enum":["warm_up","outreach","content","custom"],"description":"Campaign type"},"goal":{"type":"string","description":"Campaign goal (e.g. book_meeting, start_conversation). Falls back to user's default CTA goal."},"goal_custom":{"type":"string","description":"Custom goal text when goal is 'other'"},"resource_url":{"type":"string","description":"Resource URL for campaign CTA (e.g., calendar link)"},"settings":{"type":"object","additionalProperties":{},"description":"Campaign settings (working_hours, timezone, stop_on_reply, etc.)"},"skill_run_id":{"type":"string","description":"Required for MCP-created campaigns. Call skills_get with slug='launch-campaign' first and pass the returned skill_run_id."},"enrollment_mode":{"type":"string","enum":["fixed","continuous"],"description":"Recipient policy. Send this as a TOP-LEVEL parameter — a value nested inside `settings` is ignored and the campaign silently defaults to 'fixed'. Omit for the default 'fixed', which preserves the approved target set. 'continuous' authorizes one-call additions while active; new targets are validated and scheduled without pausing existing execution."},"steps":{"type":"array","items":{"type":"object","properties":{"action_type":{"type":"string","enum":["view_profile","like_post","comment","connect","message","react_to_post","email_send"]},"delay_hours":{"type":"number","minimum":0,"default":0},"config":{"type":"object","additionalProperties":{},"description":"Step config. Outbound fields per action_type: connect→message (optional, ≤300 chars) or messages{slug:text}; message→body (required) or messages{slug:text}; comment→comment_text (required) or messages{slug:text}. For new campaigns, LinkedIn per-target maps MUST be keyed by exact linkedin_provider_id (ACoAAA...), and email per-target maps MUST be keyed by exact lead_email. POST DESTINATIONS (canonical): for like_post / react_to_post / comment, set config.post_refs as { \"<linkedin_provider_id>\": { \"id\": \"<numeric_activity_id>\" } }. Use { \"*\": { \"id\": \"...\" } } for one global post across all targets. For connect/message that reference a post, use config.context_post_refs with the same shape. Without post_refs, set config.post_resolution = \"dynamic\" to opt into most-recent-post resolution. For a threaded reply on a specific post, set config.comment_id (requires the post_refs entry to be that post). DO NOT submit config.post_id, config.post_url, config.context_post_id, or config.context_post_url as object maps — the server returns an invalid_post_destination_shape error pointing to post_refs. email_send→subject/subjects + body/messages. Omit from_address unless the user explicitly provided one; Zevari resolves the verified sender. Use config.instruction for internal notes — NEVER config.note (rejected)."}},"required":["action_type"],"additionalProperties":false},"minItems":1,"description":"Ordered list of campaign steps"},"targets":{"type":"array","items":{"type":"object","properties":{"identity":{"type":"string","description":"Who to add: a LinkedIn profile URL, public slug (e.g. 'satyanadella'), provider id (ACoAA...), or email address. Zevari classifies and resolves it server-side — preferred over the legacy per-type fields."},"lead_id":{"type":"string"},"linkedin_provider_id":{"type":"string"},"name":{"type":"string"},"lead_name":{"type":"string"},"url":{"type":"string"},"lead_url":{"type":"string"},"linkedin_profile_url":{"type":"string"},"profile_url":{"type":"string"},"email":{"type":"string","format":"email"},"lead_email":{"type":"string","format":"email"},"work_email":{"type":"string","format":"email"},"template_slug":{"type":"string"},"template_variant":{"type":"string"},"sequence":{"type":"array","items":{"type":"object","properties":{"action_type":{"type":"string","enum":["view_profile","like_post","comment","connect","message","react_to_post","email_send"]},"delay_hours":{"type":"number","minimum":0,"default":0},"config":{"type":"object","additionalProperties":{},"description":"Literal step config for this lead. Outbound copy goes here directly: connect->message (optional, <=300 chars); message->body (required); comment->comment_text (required); email_send->subject + body. Post destinations use config.post_refs (see campaign step config). config.instruction for internal notes; config.note is rejected."}},"required":["action_type"],"additionalProperties":false},"minItems":1,"description":"Optional per-lead sequence. When set, this lead runs these steps instead of the campaign-global steps."}},"additionalProperties":false},"minItems":1,"description":"Targets to enroll in the campaign"}},"required":["name","campaign_type","steps","targets"],"additionalProperties":false},"examples":{"default":{"value":{"name":"Founder outreach","campaign_type":"outreach","goal":"book_meeting","enrollment_mode":"continuous","settings":{"personalization_mode":"generic"},"targets":[{"lead_id":"lead_uuid","linkedin_provider_id":"ACoAAAexample","name":"Jane Founder"}],"steps":[{"action_type":"view_profile","delay_hours":0,"config":{}}]}}}}}}}},"/v1/campaigns/list":{"get":{"tags":["campaigns"],"operationId":"campaigns_list","summary":"List campaigns","description":"Transport: call this endpoint with HTTP GET and query parameters. List campaigns with execution_presentation. Use presentation_status, safe_customer_summary, operator_summary, and blockers when explaining campaign health; do not turn raw status or last_error into customer-facing copy.","x-zevari-http-method":"GET","x-zevari-tool":"campaigns_list","x-zevari-method":{"method":"campaigns.list","http_method":"GET","namespace":"campaigns","operation":"list","path":"/v1/campaigns/list","api_version":"v1","tool_name":"campaigns_list","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-list"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaigns.list","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.list.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-list","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["draft","active","paused","completed","failed"]}},{"name":"campaign_type","in":"query","required":false,"schema":{"type":"string","enum":["warm_up","outreach","content","custom"]}},{"name":"limit","in":"query","required":false,"schema":{"type":"number","minimum":1,"maximum":50,"default":20}}]}},"/v1/campaigns/get":{"get":{"tags":["campaigns"],"operationId":"campaigns_get","summary":"Get campaign","description":"Transport: call this endpoint with HTTP GET and query parameters. Get campaign steps and targets plus customer-safe execution context. For user-facing answers, rely on presentation_status, safe_customer_summary, connection_acceptance_status, and blockers; keep operator_summary for diagnosis and never expose approval IDs, job IDs, internal_detail, or raw provider errors.","x-zevari-http-method":"GET","x-zevari-tool":"campaigns_get","x-zevari-method":{"method":"campaigns.get","http_method":"GET","namespace":"campaigns","operation":"get","path":"/v1/campaigns/get","api_version":"v1","tool_name":"campaigns_get","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-get"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaigns.get","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.get.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-get","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"campaign_id","in":"query","required":true,"description":"Campaign ID","schema":{"type":"string","description":"Campaign ID"}}]}},"/v1/campaignPlaybook/get":{"get":{"tags":["campaignPlaybook"],"operationId":"campaignPlaybook_get","summary":"Get campaign playbook","description":"Transport: call this endpoint with HTTP GET and query parameters. Read the shared campaign playbook for one campaign. Returns only the saved playbook fields and a plain summary string. The response is limited to campaign_id, goal, framework, framework_rationale, proof_asset, sender_voice, sequence_notes, cta, notes, and summary. This endpoint stores campaign strategy context only; it does not compile packages, create targets, create confirmations, enqueue jobs, schedule touches, or send messages.","x-zevari-http-method":"GET","x-zevari-tool":"campaign_playbook_get","x-zevari-method":{"method":"campaignPlaybook.get","http_method":"GET","namespace":"campaignPlaybook","operation":"get","path":"/v1/campaignPlaybook/get","api_version":"v1","tool_name":"campaign_playbook_get","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Use campaign playbooks as read/write campaign context for why the campaign exists and how copy should behave. Treat the summary as display context only; do not infer that a playbook update changed executable campaign steps, approvals, queues, or sent messages.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaignPlaybook.get","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaignPlaybook.get.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-get","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"campaign_id","in":"query","required":true,"schema":{"type":"string","minLength":1,"maxLength":120}}]}},"/v1/campaignPlaybook/upsert":{"patch":{"tags":["campaignPlaybook"],"operationId":"campaignPlaybook_upsert","summary":"Upsert campaign playbook","description":"Transport: call this endpoint with HTTP PATCH and a JSON request body. Create or update one shared campaign playbook. Stores only campaign_id, goal, framework, framework_rationale, proof_asset, sender_voice, sequence_notes, cta, and notes. Does not create leads, handoffs, packages, activation, sends, replies, proof assets, metrics, or drafts. The response is limited to campaign_id, goal, framework, framework_rationale, proof_asset, sender_voice, sequence_notes, cta, notes, and summary. This endpoint stores campaign strategy context only; it does not compile packages, create targets, create confirmations, enqueue jobs, schedule touches, or send messages.","x-zevari-http-method":"PATCH","x-zevari-tool":"campaign_playbook_upsert","x-zevari-method":{"method":"campaignPlaybook.upsert","http_method":"PATCH","namespace":"campaignPlaybook","operation":"upsert","path":"/v1/campaignPlaybook/upsert","api_version":"v1","tool_name":"campaign_playbook_upsert","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Use campaign playbooks as read/write campaign context for why the campaign exists and how copy should behave. Treat the summary as display context only; do not infer that a playbook update changed executable campaign steps, approvals, queues, or sent messages.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaignPlaybook.upsert","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaignPlaybook.upsert.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaignPlaybook-upsert","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"campaign_id":{"type":"string","minLength":1,"maxLength":120},"goal":{"type":"string","maxLength":4000,"nullable":true},"framework":{"type":"string","enum":["occams_razor","offer_led_first_message","agitational_bump","softened_breakup_pitch"],"nullable":true},"framework_rationale":{"type":"string","maxLength":4000,"nullable":true},"proof_asset":{"type":"string","maxLength":4000,"nullable":true},"sender_voice":{"type":"string","maxLength":4000,"nullable":true},"sequence_notes":{"type":"string","maxLength":8000,"nullable":true},"cta":{"type":"string","maxLength":1000,"nullable":true},"notes":{"type":"string","maxLength":4000,"nullable":true}},"required":["campaign_id"],"additionalProperties":false},"examples":{"default":{"value":{"campaign_id":"campaign_uuid","goal":"Book qualified founder meetings","framework":"offer_led_first_message","framework_rationale":"Lead with the offer because this audience already understands the problem and needs a fast reason to care.","proof_asset":"Customer quote showing 31 percent more qualified replies after switching from generic outreach.","sender_voice":"Concise, direct, operator-to-operator.","sequence_notes":"Start useful, follow up with one proof point, exit softly if there is no signal.","cta":"Worth comparing notes next week?","notes":"Do not push calendar links in the first touch."}}}}}}}},"/v1/campaigns/validate":{"post":{"tags":["campaigns"],"operationId":"campaigns_validate","summary":"Validate campaign","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Invoke Zevari method campaigns.validate.","x-zevari-http-method":"POST","x-zevari-tool":"campaigns_validate","x-zevari-method":{"method":"campaigns.validate","http_method":"POST","namespace":"campaigns","operation":"validate","path":"/v1/campaigns/validate","api_version":"v1","tool_name":"campaigns_validate","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-validate"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaigns.validate","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.validate.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-validate","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"campaign_id":{"type":"string","description":"Campaign ID to validate before activation"}},"required":["campaign_id"],"additionalProperties":false},"examples":{"default":{"value":{"campaign_id":"example_id"}}}}}}}},"/v1/campaigns/addTargets":{"post":{"tags":["campaigns"],"operationId":"campaigns_addTargets","summary":"Add campaign targets","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Add recipients to an existing campaign. Active fixed and continuous campaigns can admit new recipients with personalized_steps without pausing or reactivation. Existing recipients and shared campaign steps remain unchanged.\n\nRequired for personalized enrollment: a stable idempotency_key (match the Idempotency-Key header when used) and complete personalized_steps covering every content-bearing step_order.\n\nApproval: stages campaign_enroll_personalized_targets. Eligible Autopilot applies and schedules in the same call; otherwise show approval_url, wait, then repeat the identical request with confirmation_id.\n\nIdempotency: Same key and same payload replays; Same key with changed recipients or copy returns IDEMPOTENCY_KEY_CONFLICT; PERSONALIZED_ENROLLMENT_CONFIRMATION_REJECTED is terminal and a new key requires a new user request.\n\nResponse: approved copy is stored as immutable personalized_snapshot_v1 snapshots; read content_mode, scheduling_occurred, and each disposition's scheduled, schedule_deferred, and schedule_defer_reason.\n\nRecovery: PERSONALIZED_SEQUENCE_INCOMPLETE (missing step copy); CAMPAIGN_PERSONALIZED_SNAPSHOT_INVALID (a draft/paused campaign's approved step structure drifted); active fixed generic additions require pause, add, validate, fresh campaign_activate approval, and reactivation; terminal campaigns require a new campaign.","x-zevari-http-method":"POST","x-zevari-tool":"campaigns_add_targets","x-zevari-method":{"method":"campaigns.addTargets","http_method":"POST","namespace":"campaigns","operation":"addTargets","path":"/v1/campaigns/addTargets","api_version":"v1","tool_name":"campaigns_add_targets","docs_url":"https://docs.zevari.ai/api/reference#campaigns-addTargets","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Use one call with a stable body idempotency_key or the Idempotency-Key header; both must match. Attach a complete personalized_steps array per target. Active fixed and continuous campaigns work without pausing; draft/paused additions stay unscheduled. PERSONALIZED_SEQUENCE_INCOMPLETE means copy is missing. Eligible Autopilot applies immediately; for manual approval, show approval_url and repeat the identical payload with confirmation_id after approval. Same payload replays; changed content conflicts; rejection terminates the key. A new key requires a new user request. Omit personalized_steps only for shared-copy behavior. Read content_mode, snapshot provenance, dispositions, scheduling fields, error_code, and next_action.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-addTargets"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Enrollment accepted, scheduled, or replayed idempotently. Inspect next_action and per-target dispositions.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"scheduled_personalized_active":{"value":{"ok":true,"method":"campaigns.addTargets","data":{"campaign_id":"campaign_uuid","enrollment_id":"enrollment_uuid","enrollment_mode":"fixed","content_mode":"personalized_snapshot_v1","status":"active","enrollment_status":"applied","targets_editable":true,"scheduling_occurred":true,"scheduled_targets":1,"schedule_deferred":false,"next_action":"The personalized recipient is enrolled and scheduled. Keep the campaign active; no pause, validation, or reactivation is required.","added":1,"skipped":0,"suppressed_targets":0,"total_submitted":1,"dispositions":[{"campaign_target_id":"campaign_target_uuid","linkedin_provider_id":"ACoAAAexample","lead_email":null,"status":"accepted","scheduled":true,"content_mode":"personalized_snapshot_v1","personalized_steps_snapshotted":2,"content_hash":"sha256:example-approved-snapshot-hash"}]},"request_id":"req_example"}},"pending_personalized_approval":{"value":{"ok":true,"method":"campaigns.addTargets","data":{"campaign_id":"campaign_uuid","confirmation_id":"pac_pending_confirmation_id","approval_url":"https://zevari.ai/confirm/pac_pending_confirmation_id","action_type":"campaign_enroll_personalized_targets","enrollment_status":"pending_confirmation","content_mode":"personalized_snapshot_v1","scheduling_occurred":false,"retry_tool":"campaigns.addTargets","retry_payload":{"campaign_id":"campaign_uuid","idempotency_key":"crm-sync-2026-07-19-batch-0042","targets":[{"lead_id":"lead_uuid","linkedin_provider_id":"ACoAAAexample","personalized_steps":[{"step_order":1,"message":"Jane, your approach to revenue operations stood out. Open to connecting?"},{"step_order":2,"body":"Thanks for connecting, Jane. Your founder-led sales system mirrors what we see with AI teams."}]}],"confirmation_id":"pac_pending_confirmation_id"},"instruction_for_assistant":"Present the returned approval channel. After approval, call campaigns.addTargets with retry_payload unchanged.","next_action":"Approve this exact recipient sequence, then retry campaigns.addTargets with the returned confirmation_id and unchanged idempotency key."},"request_id":"req_example"}},"scheduled_active_continuous":{"value":{"ok":true,"method":"campaigns.addTargets","data":{"campaign_id":"campaign_uuid","enrollment_id":"enrollment_uuid","enrollment_mode":"continuous","enrollment_policy":{"max_batch_size":100,"max_total_targets":5000,"content_mode":"generic"},"status":"active","enrollment_status":"applied","targets_editable":true,"add_targets_method":"campaigns.addTargets","scheduling_occurred":true,"scheduled_targets":1,"schedule_deferred":true,"schedule_defer_reason":"explicit_delay","next_action_at":"2026-07-20T09:15:00.000Z","next_action":"Accepted targets are scheduled; keep the campaign active. No pause or reactivation call is required.","added":1,"skipped":0,"suppressed_targets":0,"total_submitted":1,"dispositions":[{"campaign_target_id":"campaign_target_uuid","linkedin_provider_id":"ACoAAAexample","lead_email":null,"status":"accepted","scheduled":true}]},"request_id":"req_example"}},"idempotent_replay":{"value":{"ok":true,"method":"campaigns.addTargets","data":{"campaign_id":"campaign_uuid","enrollment_id":"enrollment_uuid","enrollment_mode":"continuous","status":"active","enrollment_status":"applied","scheduling_occurred":true,"scheduled_targets":1,"schedule_deferred":true,"schedule_defer_reason":"explicit_delay","added":1,"skipped":0,"suppressed_targets":0,"total_submitted":1,"idempotent_replay":true,"dispositions":[{"campaign_target_id":"campaign_target_uuid","linkedin_provider_id":"ACoAAAexample","lead_email":null,"status":"accepted","scheduled":true}],"next_action":"Accepted targets are scheduled; keep the campaign active. No pause or reactivation call is required."},"request_id":"req_example"}}}}}},"400":{"description":"Invalid enrollment, personalized content or approval failure, idempotency conflict, terminal campaign, or other method execution error.","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ZevariErrorEnvelope"},{"$ref":"#/components/schemas/ZevariResponseEnvelope"}]},"examples":{"idempotency_conflict":{"value":{"ok":false,"method":"campaigns.addTargets","data":{"error_code":"IDEMPOTENCY_KEY_CONFLICT","campaign_id":"campaign_uuid","idempotency_key":"enroll_batch_2026_07_20_01","message":"This idempotency key was already used with a different campaigns.addTargets payload.","fix":"Retry the original payload with this key, or use a new idempotency key for a different enrollment."},"request_id":"req_example"}},"personalized_sequence_incomplete":{"value":{"ok":false,"method":"campaigns.addTargets","data":{"error_code":"PERSONALIZED_SEQUENCE_INCOMPLETE","campaign_id":"campaign_uuid","current_status":"active","message":"Every content-bearing campaign step needs exact executable content for this target.","recovery_action":"Add the missing step_order and its documented outbound content field to this target's personalized_steps, then retry with the same stable idempotency key."},"request_id":"req_example"}},"personalized_approval_required":{"value":{"ok":false,"method":"campaigns.addTargets","data":{"error_code":"CONFIRMATION_REQUIRED","campaign_id":"campaign_uuid","action_type":"campaign_enroll_personalized_targets","message":"The exact recipients and personalized sequence require approval before enrollment.","recovery_action":"Approve the returned confirmation, then repeat the exact campaigns.addTargets payload with confirmation_id."},"request_id":"req_example"}},"personalized_approval_rejected":{"value":{"ok":false,"method":"campaigns.addTargets","data":{"error_code":"PERSONALIZED_ENROLLMENT_CONFIRMATION_REJECTED","campaign_id":"campaign_uuid","idempotency_key":"crm-sync-2026-07-19-batch-0042","confirmation_id":"pac_rejected_confirmation_id","enrollment_status":"rejected","message":"The personalized enrollment approval was explicitly rejected. This idempotency key is terminal and will not stage another approval.","recovery_action":"Use a new idempotency key only if the user makes a new enrollment request."},"request_id":"req_example"}},"terminal_campaign":{"value":{"ok":false,"method":"campaigns.addTargets","data":{"error_code":"CAMPAIGN_TERMINAL","campaign_id":"campaign_uuid","current_status":"completed","enrollment_mode":"continuous","message":"Terminal campaigns are immutable and cannot accept new targets.","recovery_action":"Create a new campaign for these leads."},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-addTargets","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-addTargets","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-addTargets","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-addTargets","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Optional REST transport for the enrollment idempotency key (8-200 characters). Active enrollment and every personalized enrollment require a key in this header or body idempotency_key. When both are sent they must match. Existing draft/paused generic body-only requests remain compatible.","schema":{"type":"string","minLength":8,"maxLength":200}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"campaign_id":{"type":"string","description":"Campaign ID to enroll targets into"},"targets":{"type":"array","items":{"type":"object","properties":{"identity":{"type":"string","description":"Who to add: a LinkedIn profile URL, public slug (e.g. 'satyanadella'), provider id (ACoAA...), or email address. Zevari classifies and resolves it server-side — preferred over the legacy per-type fields."},"lead_id":{"type":"string"},"linkedin_provider_id":{"type":"string"},"name":{"type":"string"},"lead_name":{"type":"string"},"url":{"type":"string"},"lead_url":{"type":"string"},"linkedin_profile_url":{"type":"string"},"profile_url":{"type":"string"},"email":{"type":"string","format":"email"},"lead_email":{"type":"string","format":"email"},"work_email":{"type":"string","format":"email"},"template_slug":{"type":"string"},"template_variant":{"type":"string"},"sequence":{"type":"array","items":{"type":"object","properties":{"action_type":{"type":"string","enum":["view_profile","like_post","comment","connect","message","react_to_post","email_send"]},"delay_hours":{"type":"number","minimum":0,"default":0},"config":{"type":"object","additionalProperties":{},"description":"Literal step config for this lead. Outbound copy goes here directly: connect->message (optional, <=300 chars); message->body (required); comment->comment_text (required); email_send->subject + body. Post destinations use config.post_refs (see campaign step config). config.instruction for internal notes; config.note is rejected."}},"required":["action_type"],"additionalProperties":false},"minItems":1,"description":"Optional per-lead sequence. When set, this lead runs these steps instead of the campaign-global steps."},"personalized_steps":{"type":"array","items":{"type":"object","properties":{"step_order":{"type":"integer","exclusiveMinimum":true,"minimum":0,"description":"Existing campaign step order"},"message":{"type":"string","maxLength":300,"nullable":true,"description":"Exact connection note; null means an intentional no-note invite"},"body":{"type":"string","minLength":1,"description":"Exact LinkedIn message or email body"},"subject":{"type":"string","minLength":1,"description":"Exact email subject"},"comment_text":{"type":"string","minLength":1,"description":"Exact LinkedIn comment"}},"required":["step_order"],"additionalProperties":false},"minItems":1,"description":"DEPRECATED — use `sequence` instead. Legacy per-step copy keyed by the campaign's existing step_order; still accepted for older callers."}},"additionalProperties":false},"description":"Leads to add — identify each with `identity` (URL, slug, provider id, or email). Active campaigns accept one-call additions; unresolved or duplicate leads come back itemized instead of failing the batch. Add an optional per-lead `sequence` for custom steps/copy. Omit targets entirely when retrying with a confirmation_id: Zevari executes the approved batch it already stored."},"idempotency_key":{"type":"string","minLength":8,"maxLength":200,"description":"Stable caller-generated key for safe retries. Reusing the key with the same batch returns the original result; a key whose previous attempt was REJECTED may be reused with corrected content."},"confirmation_id":{"type":"string","description":"Approval for action_type='campaign_enroll_personalized_targets'. Omit on the first personalized call: Zevari stages the approval. After approval, retry with this ID and the same idempotency_key — targets may be omitted; the stored approved batch is executed."}},"required":["campaign_id"],"additionalProperties":false},"examples":{"personalized_sequence":{"value":{"campaign_id":"campaign_uuid","idempotency_key":"crm-sync-2026-07-19-batch-0042","targets":[{"lead_id":"lead_uuid","linkedin_provider_id":"ACoAAAexample","name":"Jane Founder","personalized_steps":[{"step_order":1,"message":"Jane, your approach to revenue operations stood out. Open to connecting?"},{"step_order":2,"body":"Thanks for connecting, Jane. Your work on operationalizing founder-led sales mirrors a pattern we are seeing with AI teams."}]}]}},"shared_campaign_copy":{"value":{"campaign_id":"campaign_uuid","idempotency_key":"crm-sync-2026-07-19-batch-0043","targets":[{"lead_id":"lead_uuid_2","linkedin_provider_id":"ACoAAAexample2","name":"Alex Operator"}]}}}}}}}},"/v1/campaigns/updateStatus":{"patch":{"tags":["campaigns"],"operationId":"campaigns_updateStatus","summary":"Update campaign status","description":"Transport: call this endpoint with HTTP PATCH and a JSON request body. Update campaign status. Activating a campaign requires an approved campaign_activate confirmation_id. Draft and paused campaigns may activate after validation and approval. Active campaigns may pause or enter supported terminal states. Completed, failed, canceled/cancelled, rejected, and processing campaigns cannot be activated and return CAMPAIGN_INVALID_STATUS_TRANSITION. For API automation, stage that confirmation with confirmations.requestAction. If Autopilot approves it, activate immediately with the returned confirmation_id; otherwise wait for browser approval.","x-zevari-http-method":"PATCH","x-zevari-tool":"campaigns_update_status","x-zevari-method":{"method":"campaigns.updateStatus","http_method":"PATCH","namespace":"campaigns","operation":"updateStatus","path":"/v1/campaigns/updateStatus","api_version":"v1","tool_name":"campaigns_update_status","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Activate only draft or paused campaigns after validation and campaign_activate approval. Approval does not inline-activate: after approval, retry campaigns.updateStatus with status='active' so the transaction-capable runtime revalidates and consumes it under the campaign lifecycle lock. Active campaigns may pause or enter supported terminal states. Never try to reactivate completed, failed, canceled/cancelled, rejected, or processing campaigns; use returned next_action guidance.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaigns.updateStatus","data":{},"request_id":"req_example"}}}}}},"400":{"description":"CAMPAIGN_INVALID_STATUS_TRANSITION is returned for unsupported lifecycle changes, including terminal or processing campaign activation.","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ZevariErrorEnvelope"},{"$ref":"#/components/schemas/ZevariResponseEnvelope"}]},"examples":{"invalid_campaign_transition":{"value":{"ok":false,"method":"campaigns.updateStatus","data":{"error_code":"CAMPAIGN_INVALID_STATUS_TRANSITION","campaign_id":"campaign_uuid","current_status":"completed","requested_status":"active","message":"The requested campaign lifecycle transition is not allowed.","recovery_action":"Create a new campaign; terminal campaigns cannot be reactivated."},"request_id":"req_example"}},"personalized_snapshot_invalid":{"value":{"ok":false,"method":"campaigns.updateStatus","data":{"error_code":"CAMPAIGN_PERSONALIZED_SNAPSHOT_INVALID","campaign_id":"campaign_uuid","message":"Cannot activate because personalized target snapshots no longer match the current campaign steps.","errors":["Personalized target target_uuid snapshot step_2 does not match current step 2 (email_send)."],"recovery_action":"Restore the approved step structure or create a new campaign, then validate and stage fresh activation approval."},"request_id":"req_example"}},"invalid_arguments":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.updateStatus.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","suggested_action":"Provide a documented campaign_id, supported status, and confirmation_id when activating."},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStatus","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"campaign_id":{"type":"string","description":"Campaign ID"},"status":{"type":"string","enum":["active","paused","completed","failed"],"description":"New status"},"fail_reason":{"type":"string","description":"Reason for failure (when status=failed)"},"confirmation_id":{"type":"string","description":"Required when status='active'. First call confirmations.requestAction with action_type='campaign_activate' and payload={campaign_id}. If the response includes data.autopilot.approved=true, retry campaigns.updateStatus immediately with this confirmation_id. Otherwise use data.approval_url for browser approval, then retry with the same confirmation_id."}},"required":["campaign_id","status"],"additionalProperties":false},"examples":{"default":{"value":{"campaign_id":"campaign_uuid","status":"active","confirmation_id":"pac_approved_confirmation_id"}}}}}}}},"/v1/campaigns/updateStep":{"patch":{"tags":["campaigns"],"operationId":"campaigns_updateStep","summary":"Update campaign step","description":"Transport: call this endpoint with HTTP PATCH and a JSON request body. Invoke Zevari method campaigns.updateStep.","x-zevari-http-method":"PATCH","x-zevari-tool":"campaigns_update_step","x-zevari-method":{"method":"campaigns.updateStep","http_method":"PATCH","namespace":"campaigns","operation":"updateStep","path":"/v1/campaigns/updateStep","api_version":"v1","tool_name":"campaigns_update_step","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","sensitive":true},"x-sensitive":true,"x-agent-guidance":"This endpoint can stage or execute a write action. Preserve confirmation IDs exactly. For REST automation, execute immediately only when confirmations.requestAction returns autopilot.approved=true; otherwise wait for approval_url browser approval.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-updateStep"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"campaigns.updateStep","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for campaigns.updateStep.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateStep","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"step_id":{"type":"string","description":"Campaign step ID (from campaigns_get)"},"config":{"type":"object","additionalProperties":{},"description":"New step config. Canonical outbound fields per action_type: connect→message (optional, ≤300 chars) or messages{slug:text}; message→body (required) or messages{slug:text}; comment→comment_text (required) or messages{slug:text}. For new LinkedIn campaign maps, use exact linkedin_provider_id (ACoAAA...) keys only; for email maps, use exact lead_email keys only. Omit from_address unless the user explicitly provided one; Zevari resolves the verified sender. POST DESTINATIONS (canonical): set config.post_refs = { \"<target_key>\": { \"id\": \"<numeric_activity_id>\" } } for like_post / react_to_post / comment, or { \"*\": { \"id\": \"...\" } } for a global post. For connect/message contextual references, use config.context_post_refs with the same shape. To allow most-recent dynamic resolution, set config.post_resolution = \"dynamic\". For threaded replies, also set config.comment_id. Submitting config.post_id / post_url / context_post_id / context_post_url as object maps is rejected with invalid_post_destination_shape — use post_refs instead. Use config.instruction for internal notes. config.note is REJECTED."},"delay_hours":{"type":"number","minimum":0,"description":"New delay in hours (optional)"}},"required":["step_id","config"],"additionalProperties":false},"examples":{"default":{"value":{"step_id":"example_id","config":{}}}}}}}}},"/v1/campaigns/updateTarget":{"patch":{"tags":["campaigns"],"operationId":"campaigns_updateTarget","summary":"Update campaign target","description":"Transport: call this endpoint with HTTP PATCH and a JSON request body. Invoke Zevari method campaigns.updateTarget.","x-zevari-http-method":"PATCH","x-zevari-tool":"campaigns_update_target","x-zevari-method":{"method":"campaigns.updateTarget","http_method":"PATCH","namespace":"campaigns","operation":"updateTarget","path":"/v1/campaigns/updateTarget","api_version":"v1","tool_name":"campaigns_update_target","docs_url":"https://docs.zevari.ai/api/reference#campaigns-updateTarget","sensitive":true},"x-sensitive":true,"x-agent-guidance":"This endpoint can stage or execute a write action. Preserve confirmation IDs exactly. For REST automation, execute immediately only when confirmations.requestAction returns autopilot.approved=true; otherwise wait for approval_url browser approval.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#campaigns-updateTarget"},"security