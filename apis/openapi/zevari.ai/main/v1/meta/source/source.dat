tive":false},"x-sensitive":false,"x-agent-guidance":"Approval policy controls confirmation behavior for the active workspace/user/account. Use mode='autopilot' with autopilot_campaigns_enabled=true (legacy mode='autopilot_expanded', still accepted) for eligible hands-off API automation; the Safety Center still paces what reaches LinkedIn. Responses keep `mode` as the legacy value and add `canonical_mode` and `autopilot_campaigns_enabled`. The daily_autopilot_action_limit and hourly_autopilot_action_limit parameters are deprecated and ignored (551.0). Updates are owner/admin-only and do not approve already-staged actions.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#approvalPolicy-get"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"approvalPolicy.get","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for approvalPolicy.get.","docs_url":"https://docs.zevari.ai/api/reference#approvalPolicy-get","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/ap