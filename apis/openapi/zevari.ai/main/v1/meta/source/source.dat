tion":"LinkedIn provider ID alias."},"lead_id":{"type":"string","description":"Saved lead ID in the active workspace and active LinkedIn account."},"leadId":{"type":"string","description":"Saved lead ID alias in the active workspace and active LinkedIn account."},"linkedin_public_identifier":{"type":"string","description":"LinkedIn public identifier/vanity slug alias."},"public_identifier":{"type":"string","description":"LinkedIn public identifier/vanity slug alias."},"publicIdentifier":{"type":"string","description":"LinkedIn public identifier/vanity slug alias."},"linkedin_profile_url":{"type":"string","description":"LinkedIn profile URL alias."},"linkedin_url":{"type":"string","description":"LinkedIn profile URL alias."},"linkedinUrl":{"type":"string","description":"LinkedIn profile URL alias."},"profile_url":{"type":"string","description":"LinkedIn profile URL alias."},"profileUrl":{"type":"string","description":"LinkedIn profile URL alias."},"url":{"type":"string","description":"LinkedIn profile URL alias."},"note":{"type":"string","description":"Connection request note. Free LinkedIn senders support up to 200 characters; paid/Premium/Sales Navigator senders support up to 300. Over-limit notes return data.error='connection_note_too_long'."},"confirmation_id":{"type":"string","description":"REQUIRED. ID from confirmations.requestAction. You MUST call confirmations.requestAction FIRST with the exact payload you intend to send, return the data.approval_url to the user, and wait for them to approve. Only then call this tool with the confirmation_id. Without it, this tool returns an error."},"bulk_item_id":{"type":"string","description":"Set when confirmation_id refers to a bulk_actions parent (from confirmations.requestAction). Identifies the per-item child to consume — e.g. 'itm_03'. Omit for single-action confirmations."}},"additionalProperties":false},"examples":{"default":{"value":{"identifier":"jane-prospect-123","note":"Saw your work on revenue operations. Wo