 asks for a phone number. Combined email+phone is not supported — call email and phone separately."}},"additionalProperties":false},"examples":{"default":{"value":{"linkedin_profile_url":"https://www.linkedin.com/in/example/","linkedin_url":"https://www.linkedin.com/in/example/"}}}}}}}},"/v1/agents/enrichEmail":{"post":{"tags":["agents"],"operationId":"agents_enrichEmail","summary":"Enrich email address","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Find verified work and personal email addresses for a target using the email enrichment service. Requires the target's LinkedIn URL.","x-zevari-http-method":"POST","x-zevari-tool":"agents_enrich_email","x-zevari-method":{"method":"agents.enrichEmail","http_method":"POST","namespace":"agents","operation":"enrichEmail","path":"/v1/agents/enrichEmail","api_version":"v1","tool_name":"agents_enrich_email","docs_url":"https://docs.zevari.ai/api/reference#agents-enrichEmail","sensitive":true},"x-sensitive":true,"x-agent-guidance":"Use only when the workflow requires email enrichment. Preserve provider and confidence fields from the response, and do not invent missing email addresses.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#agents-enrichEmail"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"agents.enrichEmail","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for agents.enrichEmail.","docs_url":"https://docs.zevari.ai/api/reference#agents-enrichEmail","suggested_action":"Compare the request body to this endpoint's OpenAPI schema 