ndar link, landing page)"}},"required":["identifier"],"additionalProperties":false},"examples":{"default":{"value":{"identifier":"example_id"}}}}}}}},"/v1/agents/companyIntelligence":{"post":{"tags":["agents"],"operationId":"agents_companyIntelligence","summary":"Research company intelligence","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Research a company server-side and return structured firmographics (industry, size, funding, products). Uses LinkedIn company data when available, then a web research fallback. Optionally persist to target_research with lead_id + persist=true for generation context.","x-zevari-http-method":"POST","x-zevari-tool":"agents_company_intelligence","x-zevari-method":{"method":"agents.companyIntelligence","http_method":"POST","namespace":"agents","operation":"companyIntelligence","path":"/v1/agents/companyIntelligence","api_version":"v1","tool_name":"agents_company_intelligence","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Ground analysis in the supplied profile, company, and ICP inputs. Do not fill missing facts with guesses; surface uncertainty in the response data.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"agents.companyIntelligence","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for agents.companyIntelligence.","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#agents-companyIntelligence","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"company_identifier":{"type":"string","description":"LinkedIn company slug when known (e.g. acme-corp). Optional when lead_id supplies company context."},"employee_identifier":{"type":"string","description":"An employee's LinkedIn identifier for additional infer-when-company-missing context"},"lead_id":{"type":"string","description":"global_leads id — loads company_name/headline and enables persist + cache skip"},"persist":{"type":"boolean","description":"When true with lead_id, saves company_intelligence to target_research (default false)"},"force":{"type":"boolean","description":"When true with lead_id, bypass fresh cached research and re-enrich"}},"additionalProperties":false},"examples":{"default":{"value":{"company_identifier":"example_id","employee_identifier":"example_id"}}}}}}}},"/v1/agents/generateConnectionNote":{"post":{"tags":["agents"],"operationId":"agents_generateConnectionNote","summary":"Generate connection note","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Generate a personalized LinkedIn connection request note based on the prospect's profile and your business context. Max length depends on sender tier: 200 chars for free accounts, 300 for paid. Before using this for real outreach, call library_context_get(skill_slug='craft-outreach', include_examples=true) and apply the returned Outreach template plus Brand context. Generated connection notes are capped by the active sender tier: 200 characters for free LinkedIn senders and 300 for paid/Premium/Sales Navigator senders. For API automation, include sender_name, sender_company, and product_offering unless those values are already saved on the Zevari profile. If any are missing, the response data includes error='missing_required_fields' and missing_fields.","x-zevari-http-method":"POST","x-zevari-tool":"agents_generate_connection_note","x-zevari-method":{"method":"agents.generateConnectionNote","http_method":"POST","namespace":"agents","operation":"generateConnectionNote","path":"/v1/agents/generateConnectionNote","api_version":"v1","tool_name":"agents_generate_connection_note","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Load profile and library context before generating customer-facing copy so outreach uses the user's stored voice, positioning, and templates.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"agents.generateConnectionNote","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for agents.generateConnectionNote.","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#agents-generateConnectionNote","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"identifier":{"type":"string","description":"LinkedIn public identifier or provider ID"},"sender_name":{"type":"string","description":"Your name. Required unless the active Zevari profile has full_name saved."},"sender_company":{"type":"string","description":"Your company. Required unless the active Zevari profile has company_name saved."},"product_offering":{"type":"string","description":"What you sell. Required unless the active Zevari profile has product_offering saved."},"language":{"type":"string","default":"English","description":"Language for the note"},"template_slug":{"type":"string","description":"Outreach template slug (e.g. 'hook-starter-active'). Prefer the primary_outreach_templates value returned by library_context_get. Falls back to the built-in connection-note instructions when omitted."},"template_variant":{"type":"string","description":"Variant within the template's framework (e.g. 'active' or 'inactive' for hook-starter). Ignored when the slug already encodes the variant."},"custom_prompt":{"type":"string","description":"One-shot prompt override. Replaces the template prompt for this call only."}},"required":["identifier"],"additionalProperties":false},"examples":{"default":{"value":{"identifier":"jane-prospect-123","sender_name":"Alex Morgan","sender_company":"Acme AI","product_offering":"AI search visibility reporting for agencies"}}}}}}}},"/v1/agents/enrichContact":{"post":{"tags":["agents"],"operationId":"agents_enrichContact","summary":"Enrich contact details","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Find verified contact data for a target using Contact Intelligence. Defaults to email; set requested_fields to phone only when a phone number was explicitly requested.","x-zevari-http-method":"POST","x-zevari-tool":"agents_enrich_contact","x-zevari-method":{"method":"agents.enrichContact","http_method":"POST","namespace":"agents","operation":"enrichContact","path":"/v1/agents/enrichContact","api_version":"v1","tool_name":"agents_enrich_contact","docs_url":"https://docs.zevari.ai/api/reference#agents-enrichContact","sensitive":true},"x-sensitive":true,"x-agent-guidance":"This endpoint can stage or execute a write action. Preserve confirmation IDs exactly. For REST automation, execute immediately only when confirmations.requestAction returns autopilot.approved=true; otherwise wait for approval_url browser approval.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#agents-enrichContact"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"agents.enrichContact","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for agents.enrichContact.","docs_url":"https://docs.zevari.ai/api/reference#agents-enrichContact","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#agents-enrichContact","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"