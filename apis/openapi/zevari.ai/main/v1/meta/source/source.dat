":"https://docs.zevari.ai/api/reference#linkedin-getSafetyStatus","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-getSafetyStatus","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"parameters":[]}},"/v1/linkedin/getConnectionLimits":{"get":{"tags":["linkedin"],"operationId":"linkedin_getConnectionLimits","summary":"Get connection limits","description":"Transport: call this endpoint with HTTP GET and query parameters. Get account-global LinkedIn capacity, workspace-safe attribution, scanner capacity, and remaining connection request quota.","x-zevari-http-method":"GET","x-zevari-tool":"linkedin_get_connection_limits","x-zevari-method":{"method":"linkedin.getConnectionLimits","http_method":"GET","namespace":"linkedin","operation":"getConnectionLimits","path":"/v1/linkedin/getConnectionLimits","api_version":"v1","tool_name":"linkedin_get_connection_limits","docs_url":"https://docs.zevari.ai/api/reference#linkedin-getConnectionLimits","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Use these read-only endpoints to inspect current safety posture, limits, usage, and blockers. Do not infer permission to bypass safety checks or resume paused automation.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-getConnectionLimits"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"val