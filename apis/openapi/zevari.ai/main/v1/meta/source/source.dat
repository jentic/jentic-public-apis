"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#targets-save","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#targets-save","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#targets-save","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"targets":{"type":"array","items":{"type":"object","properties":{"linkedin_profile_url":{"type":"string"},"linkedin_url":{"type":"string","description":"Alias for linkedin_profile_url."},"linkedinUrl":{"type":"string","description":"camelCase alias for linkedin_profile_url."},"url":{"type":"string","description":"Alias for linkedin_profile_url."},"profile_url":{"type":"string","description":"Alias returned by some LinkedIn APIs."},"profileUrl":{"type":"string","description":"camelCase profile URL alias returned by Zevari search."},"linkedin_provider_id":{"type":"string"},"provider_id":{"type":"string","description":"Alias for linkedin_provider_id."},"providerId":{"type":"string","description":"camelCase alias for linkedin_provider_id."},"id":{"type":"string","description":"LinkedIn provider id from linkedin_search_profiles results."},"linkedin_public_identifier":{"type":"string"},"public_identifier":{"type":"string","description":"LinkedIn profile slug from /in/{slug}."},"publicIdentifier":{"type":"string","description":"camelCase LinkedIn profile slug from /in/{slug}."},"name":{"type":"string"},"headline":{"type":"string"},"company_name":{"type":"string"},"location":{"type":"string"},"work_email":{"type":"string"},"connection_status":{"type":"string","enum":["none","pending","connected"]},"network_distance":{"type":"string","description":"LinkedIn network distance from search/profile results; DISTANCE_1 is saved as connected."},"networkDistance":{"type":"string","description":"camelCase alias for network_distance."}},"additionalProperties":true},"description":"Array of target profiles to save"},"source":{"type":"string","description":"How these targets were found. Prefer a canonical value: own_post_engagement, creator_engagement, linkedin_message, linkedin_comment, saved_search, linkedin_search, buying_signal, profile_capture, campaign, manual, imported. Free text is accepted and preserved, but displays as \"Agent saved\"."}},"required":["targets"],"additionalProperties":false},"examples":{"default":{"value":{"targets":[{"linkedin_profile_url":"https://www.linkedin.com/in/example/","linkedin_url":"https://www.linkedin.com/in/example/"}]}}}}}}}},"/v1/targets/createList":{"post":{"tags":["targets"],"operationId":"targets_createList","summary":"Create target list","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Create a named list and optionally add leads to it.","x-zevari-http-method":"POST","x-zevari-tool":"targets_create_list","x-zevari-method":{"method":"targets.createList","http_method":"POST","namespace":"targets","operation":"createList","path":"/v1/targets/createList","api_version":"v1","tool_name":"targets_create_list","docs_url":"https://docs.zevari.ai/api/reference#targets-createList","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#targets-createList"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"targets.createList","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for targets.createList.","docs_url":"https://docs.zevari.ai/api/reference#targets-createList","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#targets-createList","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404"