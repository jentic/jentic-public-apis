n is not in this workspace."}},"required":["name"],"additionalProperties":false},"examples":{"default":{"value":{"name":"string"}}}}}}}},"/v1/targets/updateStatus":{"patch":{"tags":["targets"],"operationId":"targets_updateStatus","summary":"Update target status","description":"Transport: call this endpoint with HTTP PATCH and a JSON request body. Update a lead's pipeline status (discovered, contacted, qualified, converted, disqualified).","x-zevari-http-method":"PATCH","x-zevari-tool":"targets_update_status","x-zevari-method":{"method":"targets.updateStatus","http_method":"PATCH","namespace":"targets","operation":"updateStatus","path":"/v1/targets/updateStatus","api_version":"v1","tool_name":"targets_update_status","docs_url":"https://docs.zevari.ai/api/reference#targets-updateStatus","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#targets-updateStatus"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"targets.updateStatus","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for targets.updateStatus.","docs_url":"https://docs.zevari.ai/api/reference#targets-updateStatus","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Miss