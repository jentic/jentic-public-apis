hod":"POST","x-zevari-tool":"linkedin_search_profiles","x-zevari-method":{"method":"linkedin.searchProfiles","http_method":"POST","namespace":"linkedin","operation":"searchProfiles","path":"/v1/linkedin/searchProfiles","api_version":"v1","tool_name":"linkedin_search_profiles","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","sensitive":false},"x-sensitive":false,"x-agent-guidance":"Validate arguments against this schema before calling. If the API returns a docs_url, read that endpoint section before retrying.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"linkedin.searchProfiles","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for linkedin.searchProfiles.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API method: requested.method","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","suggested_action":"Fetch /v1/methods or /v1/openapi.json and retry with a documented endpoint."},"request_id":"req_example"}}}}}},"429":{"description":"API key rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"rate_limited","message":"API key rate limit exceeded.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","suggested_action":"Wait for the current hourly API-key rate-limit window to reset, then retry."},"request_id":"req_example"}}}}}},"500":{"description":"Unhandled server error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"api_handler_error","message":"Zevari API request failed while executing the method.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-searchProfiles","suggested_action":"Read the endpoint docs_url, verify the request body and active Zevari context, then retry."},"request_id":"req_example"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string","description":"Search query — can be keywords, job title, company, etc."},"keywords":{"type":"array","items":{"type":"string"},"description":"Keyword filters"},"job_titles":{"type":"array","items":{"type":"string"},"description":"Job title filters, matched against profile titles as keywords (OR-combined)"},"industries":{"type":"array","items":{"type":"string"},"description":"Industry filters — plain names (auto-resolved to LinkedIn parameter IDs) or numeric IDs from linkedin_lookup_search_params"},"locations":{"type":"array","items":{"type":"string"},"description":"Location filters — plain names like \"United States\" (auto-resolved to LinkedIn parameter IDs) or numeric IDs from linkedin_lookup_search_params"},"seniority_levels":{"type":"array","items":{"type":"string"},"description":"Seniority filters, e.g. \"C-Level\", \"VP\", \"Director\", \"Manager\", \"Owner\". Applied via Sales Navigator when the connected LinkedIn account includes it; otherwise ignored with a note (express seniority in job_titles/keywords instead)."},"company_sizes":{"type":"array","items":{"type":"string"},"description":"Company headcount buckets: 1-10, 11-50, 51-200, 201-500, 501-1000, 1001-5000, 5001-10000, 10001+. Applied via Sales Navigator when the connected LinkedIn account includes it; otherwise ignored with a note."},"search_url":{"type":"string","description":"A copied LinkedIn people-search URL to run directly instead of filters. Standard URLs (linkedin.com/search/results/people/...) work for every account; Sales Navigator URLs (linkedin.com/sales/...) require the connected account to include Sales Navigator."},"limit":{"type":"integer","minimum":1,"maximum":100,"default":25,"description":"Page size. Sales Navigator routes allow up to 100; standard LinkedIn search is capped at 10 per page."},"cursor":{"type":"string","description":"Opaque pagination cursor from the previous response's next_cursor"}},"required":["query"],"additionalProperties":false},"examples":{"default":{"value":{"query":"founder hiring sales"}}}}}}}},"/v1/linkedin/searchPosts":{"post":{"tags":["linkedin"],"operationId":"linkedin_searchPosts","summary":"Search LinkedIn posts","description":"Transport: call this endpoint with HTTP POST and a JSON request body. Search LinkedIn POSTS (content) by keyword with date and relevance filtering. U