}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"content":{"type":"string","description":"Post content (text)"},"confirmation_id":{"type":"string","description":"REQUIRED. ID from confirmations.requestAction. You MUST call confirmations.requestAction FIRST with the exact payload you intend to send, return the data.approval_url to the user, and wait for them to approve. Only then call this tool with the confirmation_id. Without it, this tool returns an error."},"bulk_item_id":{"type":"string","description":"Set when confirmation_id refers to a bulk_actions parent (from confirmations.requestAction). Identifies the per-item child to consume — e.g. 'itm_03'. Omit for single-action confirmations."}},"required":["content"],"additionalProperties":false},"examples":{"default":{"value":{"content":"string"}}}}}}}},"/v1/linkedin/reactToPost":{"post":{"tags":["linkedin"],"operationId":"linkedin_reactToPost","summary":"React to LinkedIn post","description":"Transport: call this endpoint with HTTP POST and a JSON request body. React to a LinkedIn post (like, celebrate, support, etc.). REQUIRES confirmations.requestAction first. For postId, use the post's resolved social_id when available; Zevari resolves URL activity/share/ugcPost ids to social_id before approval. Public REST flow: first call confirmations.requestAction with the exact payload you intend to execute. If Autopilot returns approved=true, retry this endpoint immediately with confirmation_id. Otherwise wait for approval_url to be approved in Zevari, then retry with confirmation_id.","x-zevari-http-method":"POST","x-zevari-tool":"linkedin_react_to_post","x-zevari-method":{"method":"linkedin.reactToPost","http_method":"POST","namespace":"linkedin","operation":"reactToPost","path":"/v1/linkedin/reactToPost","api_version":"v1","tool_name":"linkedin_react_to_post","docs_url":"https://docs.zevari.ai/api/reference#linkedin-reactToPost","sensitive":true},"x-sensitive":true,"x-agent-guidance":"LinkedIn share, UGC post, and activity identifiers are not interchangeable. Resolve URLs with linkedin.getPost and use the returned social_id for write actions.","externalDocs":{"url":"https://docs.zevari.ai/api/reference#linkedin-reactToPost"},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Successful Zevari API response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariResponseEnvelope"},"examples":{"default":{"value":{"ok":true,"method":"linkedin.reactToPost","data":{},"request_id":"req_example"}}}}}},"400":{"description":"Invalid arguments or method execution error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_arguments","message":"Invalid arguments for linkedin.reactToPost.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-reactToPost","suggested_action":"Compare the request body to this endpoint's OpenAPI schema and retry with only documented parameters.","details":[{"code":"invalid_type","path":["example_field"],"message":"Required"}]},"request_id":"req_example"}}}}}},"401":{"description":"Missing, invalid, expired, revoked, or unauthorized API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"invalid_api_key","message":"The supplied Zevari API key is invalid, expired, revoked, or not authorized for this organization.","docs_url":"https://docs.zevari.ai/api/reference#linkedin-reactToPost","suggested_action":"Create a fresh Zevari API key for the target organization and LinkedIn sender, then retry."},"request_id":"req_example"}}}}}},"404":{"description":"Unknown or non-public Zevari API method.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ZevariErrorEnvelope"},"examples":{"default":{"value":{"error":{"code":"unknown_method","message":"Unknown Zevari API metho