quest_id":"req_example"}}}}}}},"parameters":[{"name":"keyword","in":"query","required":false,"description":"Deprecated: matched a field that is no longer stored; a non-empty value returns no rows. Use search or headline_filter.","schema":{"type":"string","description":"Deprecated: matched a field that is no longer stored; a non-empty value returns no rows. Use search or headline_filter."}},{"name":"headline_filter","in":"query","required":false,"description":"Case-insensitive search on headline","schema":{"type":"string","description":"Case-insensitive search on headline"}},{"name":"source","in":"query","required":false,"description":"Filter by where the lead came from: a LinkedIn comment, a LinkedIn message (or any reply), a buying signal / own-post engagement (or a marked intent), or a LinkedIn / saved search","schema":{"type":"string","enum":["comments","dms","intent","search"],"description":"Filter by where the lead came from: a LinkedIn comment, a LinkedIn message (or any reply), a buying signal / own-post engagement (or a marked intent), or a LinkedIn / saved search"}},{"name":"has_email","in":"query","required":false,"description":"Filter leads that have email","schema":{"type":"boolean","description":"Filter leads that have email"}},{"name":"has_intent","in":"query","required":false,"description":"Filter leads with intent signals","schema":{"type":"boolean","description":"Filter leads with intent signals"}},{"name":"has_ever_replied","in":"query","required":false,"description":"Filter leads by whether they have ever replied","schema":{"type":"boolean","description":"Filter leads by whether they have ever replied"}},{"name":"has_active_campaign_target","in":"query","required":false,"description":"Filter leads by active pending or in-progress campaign target membership","schema":{"type":"boolean","description":"Filter leads by active pending or in-progress campaign target membership"}},{"name":"quiet_since_days","in":"query","required":false,"description":"Ret