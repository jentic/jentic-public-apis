{
  "openapi": "3.0.3",
  "info": {
    "title": "Gearsnakes Review-Only Inquiry API",
    "version": "1.0.0",
    "description": "Unverified inquiries only. No payments, agent enrollment, assignment acceptance or dispatch. Not an A2A/MCP endpoint.",
    "x-jentic-source-url": "https://gearsnakes-field-ops-public.netlify.app/openapi.json"
  },
  "servers": [
    {
      "url": "https://gearsnakes-field-ops-public.netlify.app"
    }
  ],
  "paths": {
    "/api/requests": {
      "get": {
        "operationId": "checkInquiryAvailability",
        "summary": "Check runtime inquiry availability",
        "responses": {
          "200": {
            "description": "intakeAvailable indicates whether review-only inquiries can be submitted"
          }
        }
      },
      "post": {
        "operationId": "submitInquiryForReview",
        "summary": "Submit an inquiry for owner review",
        "description": "8 KB maximum. Five requests per minute per IP/domain and 100 unique inquiries per UTC day. Keep personal credentials, payment information, attachments and sensitive site access details out of requests. Retry an uncertain result with the identical body and Idempotency-Key.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "description": "Use a fresh unpredictable key, persist it for the original request, and reuse it only for identical retries."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "category",
                  "city",
                  "details",
                  "contactEmail",
                  "requester",
                  "authorizedToRequest",
                  "reviewOnly"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 120
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "Courier pickup and delivery",
                      "Field verification",
                      "Document transfer",
                      "Equipment assistance",
                      "Photo and video documentation",
                      "Other lawful task"
                    ]
                  },
                  "city": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "details": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2000
                  },
                  "contactEmail": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "requester": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "authorizedToRequest": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "reviewOnly": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original receipt replayed"
          },
          "202": {
            "description": "Durably stored for review; no work accepted"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Cross-origin browser denied"
          },
          "409": {
            "description": "Key reused for different inquiry"
          },
          "413": {
            "description": "Body too large"
          },
          "415": {
            "description": "JSON required"
          },
          "429": {
            "description": "Review queue or request limit reached"
          },
          "503": {
            "description": "Intake disabled or outcome uncertain; retry original key/body"
          }
        }
      }
    }
  },
  "components": {},
  "security": []
}