{
  "openapi": "3.0.0",
  "info": {
    "title": "NIDAgateway Auth API",
    "description": "API for authenticaion and authorization against NIDAgateway",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "info@meddv.de",
      "url": "https://meddv.de"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ztm/nidagateway-auth-api/1.0.0"
  },
  "externalDocs": {
    "description": "Find out more about medDV",
    "url": "https://meddv.de"
  },
  "servers": [
    {
      "url": "https://{host}/{basePath}",
      "variables": {
        "host": {
          "default": "localhost:1443"
        },
        "basePath": {
          "default": "gateway-auth"
        }
      },
      "description": "NIDAgateway on localhost with basePath"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "operationId": "authUsingApiKey",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "jwt"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "authLogout",
        "summary": "Logout the client currently logged in",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "The client was logged out",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "getCurrentUser",
        "summary": "Current registration",
        "description": "Current registration endpoint returns information about the client that has authorized with the server.",
        "tags": [
          "User"
        ],
        "responses": {
          "200": {
            "description": "Profile information for a user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userName": {
            "type": "string"
          },
          "mandant": {
            "type": "integer"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
