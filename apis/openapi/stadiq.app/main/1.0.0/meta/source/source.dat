{"openapi":"3.1.0","info":{"title":"Stadiq API","version":"1.0.0","summary":"Road works, De Lijn transit disruptions, air quality and operations briefings for a point in Flanders or Brussels.","description":"Read-only JSON API over public Belgian data sources (GIPOD, De Lijn, IRCELINE, Open-Meteo, the Antwerp low-emission zone). Output is deterministic: the same coordinates return the same computed numbers, with no language model in the loop.\n\nAuthenticate with an API key sent as `Authorization: Bearer sq_live_…`. Get a free developer key with `POST /api/v1/signup`. Each key has a daily call quota set by the account's plan (developer: 100, api and pro: 10,000, enterprise: unlimited); the count resets at 00:00 UTC. Every authenticated response carries `X-RateLimit-Limit` and, unless the quota is unlimited, `X-RateLimit-Remaining`.\n\nThe same endpoints are available as an MCP server (`npx -y stadiq-mcp`, see https://stadiq.app/developers/mcp) and as a CLI (https://stadiq.app/developers/cli).","contact":{"name":"Stadiq","url":"https://stadiq.app/developers","email":"team@stadiq.app"}},"externalDocs":{"description":"API reference and plans","url":"https://stadiq.app/api-docs"},"servers":[{"url":"https://stadiq.app/api/v1"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Locations","description":"The monitored locations on the caller's account."},{"name":"Situation","description":"What is happening at one point: works, transit, air quality, briefing."},{"name":"Access","description":"Self-serve API sign-up."}],"paths":{"/locations":{"get":{"operationId":"listLocations","tags":["Locations"],"summary":"List monitored locations","description":"The monitored locations on the account behind the key. Pass a returned `id` as `locationId` to the other endpoints.","responses":{"200":{"description":"The account's locations, primary location first.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"}},"content":{"application/json":{"schema":{"type":"object","required":["locations"],"properties":{"locations":{"type":"array","items":{"$ref":"#/components/schemas/Location"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/PlanRequired"},"429":{"$ref":"#/components/responses/QuotaExceeded"},"502":{"$ref":"#/components/responses/UpstreamError"}}}},"/disruptions":{"get":{"operationId":"getDisruptions","tags":["Situation"],"summary":"Road works and transit disruptions","description":"Road works (GIPOD) within 2 km of the point and De Lijn transit disruptions affecting it, plus summary counts.","parameters":[{"$ref":"#/components/parameters/locationId"},{"$ref":"#/components/parameters/lat"},{"$ref":"#/components/parameters/lng"}],"responses":{"200":{"description":"Works and disruptions for the point.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"}},"content":{"application/json":{"schema":{"type":"object","required":["location","radiusKm","summary","construction","transit","retrievedAt"],"properties":{"location":{"$ref":"#/components/schemas/TargetLocation"},"radiusKm":{"type":"number","const":2,"description":"Search radius for road works."},"summary":{"type":"object","required":["activeWorks","plannedWorks","upcomingWorks14d","transitDisruptions","highSeverityTransit"],"properties":{"activeWorks":{"type":"integer","description":"Works with status \"In uitvoering\" (in progress)."},"plannedWorks":{"type":"integer","description":"All other works in the radius."},"upcomingWorks14d":{"type":"integer","description":"Works not yet in progress that start within the next 14 days."},"transitDisruptions":{"type":"integer"},"highSeverityTransit":{"type":"integer","description":"Transit disruptions with severity \"high\"."}}},"construction":{"type":"array","items":{"$ref":"#/components/schemas/ConstructionWork"}},"transit":{"type":"array","items":{"$ref":"#/components/schemas/TransitDisruption"}},"retrievedAt":{"type":"string","format":"date-time"}}}}}},"400":{"$ref":"#/components/responses/BadTarget"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/PlanRequired"},"404":{"$ref":"#/components/responses/LocationNotFound"},"422":{"$ref":"#/components/responses/OutsideServiceArea"},"429":{"$ref":"#/components/responses/QuotaExceeded"},"502":{"$ref":"#/components/responses/UpstreamError"}}}},"/air-quality":{"get":{"operationId":"getAirQuality","tags":["Situation"],"summary":"Air quality and low-emission-zone status","description":"Latest NO₂ and PM reading from the nearest IRCELINE station (within 8 km), how NO₂ compares to the WHO and EU annual limits, and whether the point is inside the Antwerp low-emission zone. Measured values only.","parameters":[{"$ref":"#/components/parameters/locationId"},{"$ref":"#/components/parameters/lat"},{"$ref":"#/components/parameters/lng"}],"responses":{"200":{"description":"Air quality for the point.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"}},"content":{"application/json":{"schema":{"type":"object","required":["location","reading","thresholds","compliance","lez","retrievedAt"],"properties":{"location":{"$ref":"#/components/schemas/TargetLocation"},"reading":{"description":"Null when no station with an NO₂ value is in range.","oneOf":[{"$ref":"#/components/schemas/AirQualityReading"},{"type":"null"}]},"thresholds":{"type":"object","required":["whoNo2Annual","euNo2Annual"],"properties":{"whoNo2Annual":{"type":"number","const":10,"description":"WHO 2021 annual NO₂ guideline, µg/m³."},"euNo2Annual":{"type":"number","const":40,"description":"EU annual NO₂ limit, µg/m³."}}},"compliance":{"type":"object","required":["no2VsWhoPct","no2VsEuPct","exceedsWho","exceedsEu"],"properties":{"no2VsWhoPct":{"type":"integer","description":"Current NO₂ as a percentage of the WHO limit. 0 when there is no reading."},"no2VsEuPct":{"type":"integer","description":"Current NO₂ as a percentage of the EU limit. 0 when there is no reading."},"exceedsWho":{"type":"boolean"},"exceedsEu":{"type":"boolean"}}},"lez":{"type":"object","required":["inside","distanceM"],"properties":{"inside":{"type":"boolean","description":"Whether the point is inside the Antwerp low-emission zone."},"distanceM":{"type":"number","description":"Distance to the zone boundary in metres. 0 when inside."}}},"retrievedAt":{"type":"string","format":"date-time"}}}}}},"400":{"$ref":"#/components/responses/BadTarget"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/PlanRequired"},"404":{"$ref":"#/components/responses/LocationNotFound"},"422":{"$ref":"#/components/responses/OutsideServiceArea"},"429":{"$ref":"#/components/responses/QuotaExceeded"},"502":{"$ref":"#/components/responses/UpstreamError"}}}},"/briefing":{"get":{"operationId":"getBriefing","tags":["Situation"],"summary":"Operations briefing","description":"Risk level, headline, key facts, the best and worst windows in the next 24 hours, and the next rush-hour NO₂ peak. Framed for the account's persona, the same as the dashboard. Computed, not generated by a language model.","parameters":[{"$ref":"#/components/parameters/locationId"},{"$ref":"#/components/parameters/lat"},{"$ref":"#/components/parameters/lng"}],"responses":{"200":{"description":"Briefing for the point.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/X-RateLimit-Limit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/X-RateLimit-Remaining"}},"content":{"application/json":{"schema":{"type":"object","required":["location","persona","briefing","retrievedAt"],"properties":{"location":{"$ref":"#/components/schemas/TargetLocation"},"persona":{"type":"string","enum":["horeca","logistics","property","retail","event","general"],"description":"The account's persona. Defaults to \"property\" when none is set."},"briefing":{"type":"object","required":["risk","riskLabel","headline","keyFacts","bestWindow","worstWindow","nextRushPeak"],"properties":{"risk":{"type":"string","enum":["low","moderate","elevated","high"]},"riskLabel":{"type":"string"},"headline":{"type":"string","description":"One-sentence summary."},"keyFacts":{"type":"array","items":{"type":"string"}},"bestWindow":{"oneOf":[{"$ref":"#/components/schemas/TimeWindow"},{"type":"null"}]},"worstWindow":{"oneOf":[{"$ref":"#/components/schemas/TimeWindow"},{"type":"null"}]},"nextRushPeak":{"oneOf":[{"type":"object","required":["start","no2"],"properties":{"start":{"type":"string"},"no2":{"type":"number","description":"Forecast NO₂, µg/m³."}}},{"type":"null"}]}}},"retrievedAt":{"type":"string","format":"date-time"}}}}}},"400":{"$ref":"#/components/responses/BadTarget"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/PlanRequired"},"404":{"$ref":"#/components/responses/LocationNotFound"},"422":{"$ref":"#/components/responses/OutsideServiceArea"},"429":{"$ref":"#/components/responses/QuotaExceeded"},"502":{"$ref":"#/components/responses/UpstreamError"}}}},"/signup":{"post":{"operationId":"signup","tags":["Access"],"summary":"Request a free developer API key","description":"Emails a one-time link (valid 15 minutes). Opening it creates a free developer account (100 calls per day) and leads to https://stadiq.app/developers, where the key is created. The response does not reveal whether the address is already registered. One email per address per 60 seconds.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email"],"properties":{"email":{"type":"string","format":"email"}}}}}},"responses":{"200":{"description":"The link was sent.","content":{"application/json":{"schema":{"type":"object","required":["ok","message"],"properties":{"ok":{"type":"boolean","const":true},"message":{"type":"string"}}}}}},"400":{"description":"`invalid_email`: the address failed validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"`too_many_requests`: a link was sent to this address in the last 60 seconds.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"API key of the form `sq_live_` followed by 32 hex characters."}},"parameters":{"locationId":{"name":"locationId","in":"query","required":false,"description":"Id of one of the account's locations (from `/locations`). When present, `lat` and `lng` are ignored. Give either this, or both `lat` and `lng`.","schema":{"type":"string"}},"lat":{"name":"lat","in":"query","required":false,"description":"Latitude, inside the service area (Flanders and Brussels). Pair with `lng`.","schema":{"type":"number","minimum":50.6,"maximum":51.55},"example":51.2194},"lng":{"name":"lng","in":"query","required":false,"description":"Longitude, inside the service area. Pair with `lat`.","schema":{"type":"number","minimum":2.5,"maximum":5.95},"example":4.4025}},"headers":{"X-RateLimit-Limit":{"description":"Daily call quota for the key, or `unlimited`.","schema":{"type":"string"}},"X-RateLimit-Remaining":{"description":"Calls left today. Absent when the quota is unlimited.","schema":{"type":"string"}}},"responses":{"BadTarget":{"description":"`missing_target`: neither `locationId` nor both `lat` and `lng` were given. `invalid_coordinates`: `lat` or `lng` is not a number.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unauthorized":{"description":"`missing_key`: no Bearer token. `invalid_key`: the key is malformed, unknown or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"PlanRequired":{"description":"`plan_required`: the account's plan does not include API access.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/Error"},{"type":"object","properties":{"currentPlan":{"type":"string"},"requiredPlan":{"type":"string","const":"pro"}}}]}}}},"LocationNotFound":{"description":"`location_not_found`: no location with that id on this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"OutsideServiceArea":{"description":"`outside_service_area`: the coordinates are outside Flanders and Brussels (latitude 50.6 to 51.55, longitude 2.5 to 5.95).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"QuotaExceeded":{"description":"`quota_exceeded`: the key's daily quota is used up. Resets at 00:00 UTC.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/Error"},{"type":"object","properties":{"quota":{"type":"integer"},"callsToday":{"type":"integer"}}}]}}}},"UpstreamError":{"description":"`upstream_error`: an upstream data source failed. Retry shortly.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"schemas":{"Error":{"type":"object","required":["error","message"],"properties":{"error":{"type":"string","description":"Machine-readable error code."},"message":{"type":"string","description":"What went wrong and what to do about it."}}},"Location":{"type":"object","required":["id","name","address","lat","lng","label","isPrimary"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"address":{"type":"string"},"lat":{"type":"number"},"lng":{"type":"number"},"label":{"type":["string","null"]},"isPrimary":{"type":"boolean"}}},"TargetLocation":{"type":"object","description":"The point the response is about. `id`, `name` and `address` are present only when the request used `locationId`.","required":["lat","lng"],"properties":{"lat":{"type":"number"},"lng":{"type":"number"},"id":{"type":"string"},"name":{"type":"string"},"address":{"type":"string"}}},"ConstructionWork":{"type":"object","required":["id","description","status","lat","lng","distanceKm","startDate","endDate"],"properties":{"id":{"type":"string"},"description":{"type":"string"},"status":{"type":"string","description":"GIPOD status as published, in Dutch, e.g. \"In uitvoering\" (in progress)."},"lat":{"type":"number"},"lng":{"type":"number"},"distanceKm":{"type":"number","description":"Distance from the point, two decimals."},"startDate":{"type":["string","null"]},"endDate":{"type":["string","null"]}}},"TransitDisruption":{"type":"object","required":["id","title","lines","severity","estimatedDelayMin","endDate"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"lines":{"type":"array","items":{"type":"string"},"description":"Affected De Lijn line codes."},"severity":{"type":"string","enum":["low","medium","high"]},"estimatedDelayMin":{"type":"number","description":"Always 0: De Lijn publishes no delay estimate."},"endDate":{"type":["string","null"]}}},"AirQualityReading":{"type":"object","required":["no2","no2TrendPct","pm10","pm25","observedAt","station"],"properties":{"no2":{"type":["number","null"],"description":"µg/m³."},"no2TrendPct":{"type":["number","null"],"description":"Change over the last 2 hours, in percent. Positive means rising."},"pm10":{"type":["number","null"],"description":"µg/m³."},"pm25":{"type":["number","null"],"description":"µg/m³."},"observedAt":{"type":"string","format":"date-time"},"station":{"type":"object","required":["id","label","distanceKm"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"distanceKm":{"type":"number"}}}}},"TimeWindow":{"type":"object","required":["startHour","endHour","clockStart","clockEnd","avgNo2","avgTemp","totalRain","reason"],"properties":{"startHour":{"type":"number","description":"Hours from now."},"endHour":{"type":"number","description":"Hours from now."},"clockStart":{"type":"string","description":"Clock time, e.g. \"10:00\"."},"clockEnd":{"type":"string"},"avgNo2":{"type":"number"},"avgTemp":{"type":"number"},"totalRain":{"type":"number"},"reason":{"type":"string","description":"Why this is the best or worst window."}}}}}}