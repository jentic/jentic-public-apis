{
  "openapi": "3.0.0",
  "components": {
    "securitySchemes": {
      "authToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "authToken": []
    }
  ],
  "info": {
    "title": "Meesho Delivery Boy",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/alpinetechnologies/meesho-delivery-boy/1.0.0"
  },
  "servers": [
    {
      "url": "https://meesho.alpinetechnologies.site"
    }
  ],
  "paths": {
    "/Api/delivery_boy_login": {
      "post": {
        "summary": "delivery_boy_login",
        "description": "delivery_boy_login",
        "operationId": "deliveryBoyLogin",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone_no": {
                    "type": "string",
                    "example": "9632654125"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/delivery_boy_verify_otp": {
      "post": {
        "summary": "delivery_boy_verify_otp",
        "description": "delivery_boy_verify_otp",
        "operationId": "deliveryBoyVerifyOtp",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "otp": {
                    "type": "string",
                    "example": "1234"
                  },
                  "phone_no": {
                    "type": "string",
                    "example": "9632654125"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/new_delivery_boy_registration": {
      "post": {
        "summary": "new_delivery_boy_registration",
        "description": "new_delivery_boy_registration",
        "operationId": "newDeliveryBoyRegistration",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "aadhar_no": {
                    "type": "string",
                    "example": " 123412341234"
                  },
                  "aadhar_pic[]": {
                    "type": "string",
                    "format": "binary"
                  },
                  "address": {
                    "type": "string",
                    "example": " 12, MG Road"
                  },
                  "bank_acc_no": {
                    "type": "string",
                    "example": " 123456789012"
                  },
                  "delivery_area": {
                    "type": "string",
                    "example": " Indiranagar"
                  },
                  "dl_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driver_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driving_licence_no": {
                    "type": "string",
                    "example": " DL-0123456789"
                  },
                  "email_id": {
                    "type": "string",
                    "example": " ravi.kumar@example.com"
                  },
                  "emergency_contact": {
                    "type": "string",
                    "example": " 9876543210"
                  },
                  "ifsc": {
                    "type": "string",
                    "example": " SBIN0001234"
                  },
                  "name": {
                    "type": "string",
                    "example": " Ravi Kumar"
                  },
                  "pan_no": {
                    "type": "string",
                    "example": " ABCDE1234F"
                  },
                  "pan_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "upi_id": {
                    "type": "string",
                    "example": " ravi@upi"
                  },
                  "vehicle_no": {
                    "type": "string",
                    "example": " KA05AB1234"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "example": " Bike"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/view_delivery_boy_profile": {
      "get": {
        "summary": "view_delivery_boy_profile",
        "description": "view_delivery_boy_profile",
        "operationId": "viewDeliveryBoyProfile",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/update_delivery_boy_profile": {
      "post": {
        "summary": "update_delivery_boy_profile",
        "description": "update_delivery_boy_profile",
        "operationId": "updateDeliveryBoyProfile",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "aadhar_no": {
                    "type": "string",
                    "example": " 123412341234"
                  },
                  "address": {
                    "type": "string",
                    "example": " 12, MG Road"
                  },
                  "bank_acc_no": {
                    "type": "string",
                    "example": " 123456789012"
                  },
                  "delivery_area": {
                    "type": "string",
                    "example": " Indiranagar"
                  },
                  "driving_licence_no": {
                    "type": "string",
                    "example": " DL-0123456789"
                  },
                  "email_id": {
                    "type": "string",
                    "example": " ravi.kumar@example.com"
                  },
                  "emergency_contact": {
                    "type": "string",
                    "example": " 9876543210"
                  },
                  "ifsc": {
                    "type": "string",
                    "example": " SBIN0001234"
                  },
                  "name": {
                    "type": "string",
                    "example": " Ravi Kumar"
                  },
                  "pan_no": {
                    "type": "string",
                    "example": " ABCDE1234F"
                  },
                  "upi_id": {
                    "type": "string",
                    "example": " ravi@upi"
                  },
                  "vehicle_no": {
                    "type": "string",
                    "example": " KA05AB1234"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "example": " Bike"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/delivery_boy_view_order": {
      "get": {
        "summary": "delivery_boy_view_order",
        "description": "delivery_boy_view_order",
        "operationId": "deliveryBoyViewOrder",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/delivery_boy_change_order_status_by_order_id": {
      "post": {
        "summary": "delivery_boy_change_order_status",
        "description": "delivery_boy_change_order_status",
        "operationId": "deliveryBoyChangeOrderStatus",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "example": "1765649894"
                  },
                  "otp": {
                    "type": "string",
                    "example": "1234"
                  },
                  "status": {
                    "type": "string",
                    "example": "2"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    }
  },
  "tags": []
}
