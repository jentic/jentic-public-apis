{
  "openapi": "3.0.3",
  "info": {
    "title": "AI21 Studio API",
    "description": "AI21 Labs API for Jamba language models, Maestro planning system, and file management. Provides chat completions, autonomous task execution, and document processing capabilities.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.ai21.com/reference",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.ai21.com/studio/v1",
      "description": "AI21 Studio API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion",
        "description": "Generates a chat completion using the Jamba family of models. Supports tool use, document context, JSON mode, and streaming.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful chat completion response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key"
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/maestro/runs": {
      "post": {
        "operationId": "createMaestroRun",
        "summary": "Create a Maestro run",
        "description": "Creates a new Maestro run that dynamically plans and executes a sequence of actions to solve a task. Supports tools, requirements validation, and configurable resource budgets.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaestroRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Maestro run created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaestroRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/maestro/runs/{run_id}": {
      "get": {
        "operationId": "getMaestroRun",
        "summary": "Retrieve a Maestro run",
        "description": "Retrieves the status and result of a Maestro run by its unique identifier.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the Maestro run",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Maestro run details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaestroRunStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/library/files": {
      "get": {
        "operationId": "listFiles",
        "summary": "List library files",
        "description": "Lists files in the AI21 library with optional filtering by name, status, or labels.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Filter by exact filename match",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by file processing status",
            "schema": {
              "type": "string",
              "enum": [
                "DB_RECORD_CREATED",
                "UPLOADED",
                "UPLOAD_FAILED",
                "PROCESSED",
                "PROCESSING_FAILED"
              ]
            }
          },
          {
            "name": "label",
            "in": "query",
            "description": "Filter by label (case-sensitive). Multiple labels act as AND conditions.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of files to skip for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of files to return",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of file metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileMetadata"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a file to the library",
        "description": "Uploads a file to the AI21 library. Supported formats: PDF, DocX, HTML, TXT, Markdown. Maximum file size: 5 MB. Maximum library size: 1 GB.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Raw file bytes. Every uploaded file must have a unique file name."
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Arbitrary descriptive tags (case-sensitive) for organizing file content"
                  },
                  "publicUrl": {
                    "type": "string",
                    "description": "Metadata field indicating the source file location for reference"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier for the uploaded file"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Invalid file type or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/library/files/{file_id}": {
      "get": {
        "operationId": "getFile",
        "summary": "Get file details",
        "description": "Retrieves metadata for a specific file by its unique identifier.",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the file",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileMetadata"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "File not found"
          }
        }
      },
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "description": "Deletes a file from the library. Files in PROCESSING status cannot be deleted.",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the file to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File deleted successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "File not found or file is in PROCESSING status"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key used as Bearer token. Obtain from AI21 Studio platform."
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model to use for completion",
            "enum": [
              "jamba-large",
              "jamba-mini"
            ]
          },
          "messages": {
            "type": "array",
            "description": "Conversation history",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "tools": {
            "type": "array",
            "description": "Function-type tools available for the model to call",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "documents": {
            "type": "array",
            "description": "Context documents with content and metadata",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "response_format": {
            "type": "object",
            "description": "Set to {\"type\": \"json_object\"} for JSON mode",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object"
                ]
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "Maximum tokens to generate",
            "minimum": 1,
            "maximum": 4096
          },
          "temperature": {
            "type": "number",
            "description": "Controls response diversity",
            "minimum": 0.0,
            "maximum": 2.0,
            "default": 0.4
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus sampling threshold",
            "minimum": 0,
            "maximum": 1.0,
            "default": 1.0
          },
          "stop": {
            "type": "array",
            "description": "Stop sequences (up to 64K characters each)",
            "items": {
              "type": "string"
            }
          },
          "n": {
            "type": "integer",
            "description": "Number of responses to generate",
            "minimum": 1,
            "maximum": 16,
            "default": 1
          },
          "stream": {
            "type": "boolean",
            "description": "Enable server-sent event streaming. Requires n=1.",
            "default": false
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "description": "Role of the message sender"
          },
          "content": {
            "type": "string",
            "description": "Message content"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool calls made by assistant (assistant role only)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "arguments": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID of the tool call this message responds to (tool role only)"
          }
        }
      },
      "Tool": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "required": [
              "name",
              "description",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "description": "JSON Schema describing the function parameters"
              }
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Document text content"
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata about the document"
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "completion_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "model": {
            "type": "string"
          }
        }
      },
      "MaestroRunRequest": {
        "type": "object",
        "required": [
          "system_prompt"
        ],
        "properties": {
          "input": {
            "description": "Conversational turns or instruction string",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            ]
          },
          "system_prompt": {
            "type": "string",
            "description": "High-level behavioral instruction for Maestro"
          },
          "requirements": {
            "type": "array",
            "description": "Up to 10 explicit output conditions (max 128 words each)",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "External service integrations (MCP, HTTP, file search, web search)",
            "items": {
              "type": "object"
            }
          },
          "models": {
            "type": "array",
            "description": "Specify model(s) to use",
            "items": {
              "type": "string"
            }
          },
          "budget": {
            "type": "string",
            "description": "Resource allocation level",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "include": {
            "type": "array",
            "description": "Extra output fields to include",
            "items": {
              "type": "string",
              "enum": [
                "data_sources",
                "requirements_result"
              ]
            }
          },
          "response_language": {
            "type": "string",
            "description": "Output language specification"
          }
        }
      },
      "MaestroRunResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique run identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "in_progress"
            ]
          },
          "result": {
            "type": "string",
            "description": "Generated content or analysis"
          },
          "requirements_result": {
            "type": "array",
            "description": "Scoring for each requirement (if included)",
            "items": {
              "type": "object"
            }
          },
          "data_sources": {
            "type": "array",
            "description": "Citation sources used (if included)",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "MaestroRunStatusResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "in_progress"
            ]
          },
          "result": {
            "type": "string"
          }
        }
      },
      "FileMetadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "File identifier"
          },
          "name": {
            "type": "string",
            "description": "File name"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Assigned labels"
          },
          "status": {
            "type": "string",
            "enum": [
              "DB_RECORD_CREATED",
              "UPLOADED",
              "UPLOAD_FAILED",
              "PROCESSED",
              "PROCESSING_FAILED"
            ]
          },
          "errorCode": {
            "type": "integer",
            "description": "Error code if present"
          },
          "errorMessage": {
            "type": "string",
            "description": "Error details if present"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  }
}
