    "/check/drain": {
      "get": {
        "operationId": "check_drain",
        "summary": "AI agent wallet drain check: the public drain rule applied to one agent's payments, and whether it tripped",
        "description": "The public drain rule (a counted payment at least 5× the wallet's previous largest, at least $250, to an address it had never paid, after at least 3 earlier payments) applied to this wallet's payments, and whether it tripped. The pack is built before the payment settles; a failure on our side costs nothing. Bought from a signed-in wallet it is also listed under Your purchases on the Desk.",
        "tags": [
          "Evidence packs (paid, x402)"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The registration: an ERC-8004 token id on Base (e.g. 53008), the agent slug (8004-base-53008) or a bound wallet address.",
            "schema": {
              "type": "string"
            },
            "example": "53008"
          }
        ],
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.02"
          },
          "protocols": [
            {
