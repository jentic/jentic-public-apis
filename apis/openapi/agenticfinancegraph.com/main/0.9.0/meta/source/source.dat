    "/check/peer": {
      "get": {
        "operationId": "check_peer",
        "summary": "Peer agents: up to 10 ranked AI agents that pay the same top counterparty as this one",
        "description": "Up to 10 ranked agents that pay the same top counterparty as this one. The pack is built before the payment settles; a failure on our side costs nothing. Bought from a signed-in wallet it is also listed under Your purchases on the Desk.",
        "tags": [
          "Evidence packs (paid, x402)"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The registration: an ERC-8004 token id on Base (e.g. 53008), the agent slug (8004-base-53008) or a bound wallet address.",
            "schema": {
              "type": "string"
            },
            "example": "53008"
          }
        ],
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          },
          "protocols": [
            {
              "x402": {
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0xb25c17e26054bf34e507185dd8981888c9e044fd"
              }
            }
          ]
        },
        "responses": {
          "200": {
            "description": "The pack, with x402.receipt (transaction, network, payer), as_of, definition_ids, license (CC BY 4.0) and what it does not assert.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or an id that names no registration we have a record for."
          },
          "402": {
            "description": "Payment required. x402 v2 requirements in the PAYMENT-REQUIRED header and the JSON body: accepts[] (scheme exact, network eip155:8453, USDC, amount in atomic units, payTo, maxTimeoutSeconds) and extensions.bazaar (input schema).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
