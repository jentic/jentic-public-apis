    "/api/since": {
      "get": {
        "operationId": "getSince",
        "summary": "A figure beside its previous stored sample",
        "description": "since_last: current, prior, delta, delta_ratio, current_as_of, prior_as_of, definition_id, unit, and material (under the published thresholds, for the headline set). window=sweep is the previous stored sample of the metric; 24h, 7d and 30d take the newest stored sample at least that old, inside a stated tolerance. No prior sample means gap: true and no delta; nothing is interpolated. id accepts a metric key or a definition id (409 when a definition covers several metrics).",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Metric key (actors_l7_plus) or definition id (rank.l7plus.v1)",
            "schema": {
              "type": "string"
            },
            "example": "actors_l7_plus"
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "sweep (default), 24h, 7d or 30d",
            "schema": {
              "type": "string",
              "enum": [
                "sweep",
                "24h",
                "7d",
                "30d"
              ]
            },
            "example": "24h"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON (CC BY 4.0)."
          },
          "404": {
            "description": "Nothing stored for this input; nothing is estimated in its place."
          }
        },
        "security": []
      }
    },
