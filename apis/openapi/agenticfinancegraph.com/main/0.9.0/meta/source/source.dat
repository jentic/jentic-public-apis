{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Finance Graph — public state API",
    "version": "0.9.0",
    "description": "The machine-readable tape of the AI-agent economy. Free, unauthenticated, CC BY 4.0 with attribution to https://agenticfinancegraph.com. Live values are read from public APIs and on-chain eth_call; cited values are imported research and are labeled kind=cited. Registration counts are never a live-agent count. Paid evidence packs (/check/{kind}) are sold per call over x402 v2 on Base in USDC: a bare GET answers 402 with the requirements; retry with a signed PAYMENT-SIGNATURE header.",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "contact": {
      "email": "agenticfinancegraph@proton.me",
      "url": "https://agenticfinancegraph.com"
    },
    "x-guidance": "Free routes (/api/*) need no key and no payment; read /api/state first for every current figure with its definition id and as_of. Paid evidence packs: GET /check/{kind}?id=<ERC-8004 token id on Base> answers 402 with x402 v2 requirements (USDC on Base, exact scheme, amount in atomic units, payTo); sign the payment and retry with the PAYMENT-SIGNATURE header; the 200 body is the pack with its receipt. Kinds and prices in USDC: liveness 0.01, paygraph 0.05, drain 0.02, incidents 0.01, peer 0.01, bundle 0.10, reval 0.25; the 402 states the exact amount before anything is charged. MCP clients can read the same free data at https://agenticfinancegraph.com/mcp. Every figure is a measurement with a time, never an estimate; quote the counted total only beside the top-wallet share and the median."
  },
  "x-agentcash-guidance": {
    "llmsTxtUrl": "https://agenticfinancegraph.com/llms.txt"
  },
  "servers": [
    {
      "url": "https://agenticfinancegraph.com"
    }
  ],
  "paths": {
    "/api/state": {
      "get": {
        "operationId": "getState",
        "summary": "Current machine-money tape: live and cited metrics with provenance",
        "description": "Returns stablecoin float, USDC circulating and share, native USDC on Base (eth_call totalSupply), agent vault cash (ERC-4626 totalAssets), DeFi TVL, plus cited ERC-8004 liveness and x402 payment statistics. Cached 5 minutes at the edge.",
        "responses": {
          "200": {
            "description": "The tape",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "live": {
                      "type": "object",
                      "description": "First-party or directly-read values",
                      "properties": {
                        "stablecoin_float_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "usdc_circulating_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "usdt_circulating_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "usdc_share_of_float": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "native_usdc_on_base_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "total_agent_vault_cash_usdc": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "defi_tvl_total_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "defi_tvl_base_usd": {
                          "$ref": "#/components/schemas/Metric"
                        }
                      }
                    },
                    "cited": {
                      "type": "object",
                      "description": "Imported research, labeled with its producer and window",
                      "properties": {
                        "erc8004_registrations_total": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "erc8004_working_service_rate": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "base_strict_liveness_rate": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "agent_payments_settled_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "agent_payment_avg_ticket_usd": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "usdc_settlement_share_agent_rails": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "agentfi_tvl_labeled_usd": {
                          "$ref": "#/components/schemas/Metric"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/series": {
      "get": {
        "operationId": "getSeries",
        "summary": "Historical archive of the tape at two resolutions",
        "description": "Two-resolution history. daily[] keeps one point per UTC day for two years and is never evicted by live traffic; recent[] keeps 5-minute points for 48 hours. The response stitches them for the requested window. Points marked source=defillama-historical are daily backfill, source=live are our own snapshots, source=live-close is the last snapshot of a completed day. A gap means nobody visited during that bucket — gaps are visible in coverage rather than interpolated away.",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Window to return. Defaults to 90d. An unrecognised value falls back to 90d rather than returning everything.",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d",
                "90d",
                "1y",
                "all"
              ],
              "default": "90d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The archive for the requested window",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "range": {
                      "type": "string"
                    },
                    "resolution": {
                      "type": "string",
                      "examples": [
                        "5min",
                        "daily + 5min tail"
                      ]
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "bucket_minutes": {
                      "type": "number"
                    },
                    "coverage": {
                      "type": "object",
                      "description": "What the archive actually holds, so a consumer can tell a gap from a zero",
                      "properties": {
                        "daily_points": {
                          "type": "integer"
                        },
                        "recent_points": {
                          "type": "integer"
                        },
                        "oldest": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "newest": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "retention": {
                          "type": "object"
                        }
                      }
                    },
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "t": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "source": {
                            "type": "string",
                            "enum": [
                              "defillama-historical",
                              "live",
                              "live-close"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/flags": {
      "get": {
        "operationId": "getFlags",
        "summary": "Sourced event markers drawn over the series",
        "description": "Timestamped markers answering 'what happened here' on the chart. Every flag carries an https source; a flag without one cannot be stored. Authoring is key-gated and not public. kind is one of launch|incident|regulation|rail|vault|market; severity is one of info|notable|major.",
        "responses": {
          "200": {
            "description": "All stored flags, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "kinds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "severities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Flag"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/partners": {
      "get": {
        "operationId": "getPartnerGravity",
        "summary": "Third-party agent catalogs joined to our own qualifier",
        "description": "Marketplaces and registries each publish a census of themselves; none of those counts answer whether the listed names are economic actors. This endpoint runs our qualifier over their catalogs and reports the result against OUR denominator.\n\nRead three things before quoting any figure here.\n\n1. `attempted` is the identities WE ingested and checked — never the partner's own published census. A rate over somebody else's marketing total cannot be reproduced.\n2. `moved_usdc` is NOT L7. It means the declared wallet sent USDC to a different address after the identity existed. From a raw wallet read a token launch, a bonding-curve buy and a DEX swap are indistinguishable from a payment for work, so L7 is withheld on catalogs where we cannot yet see job state, and the blocker is named in the response.\n3. Each partner block carries a `caveats` array. The caveats are part of the number.\n\nA measured zero and a withheld value are different things and are represented differently: 0 is a finding, `null` means we have not earned the figure yet. Worked examples are desk-only and are stripped from anonymous responses, with the count of what was withheld reported rather than silently omitted. Cached 5 minutes at the edge.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Partner gravity report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "tier": {
                      "type": "string",
                      "enum": [
                        "public",
                        "desk"
                      ]
                    },
                    "evidence_withheld": {
                      "type": "integer",
                      "description": "Worked examples removed from this response."
                    },
                    "denominator_rule": {
                      "type": "string"
                    },
                    "partners": {
                      "type": "object",
                      "description": "One block per partner: fetch, virtuals, olas, x402, wallets_7702, circle, bankr.",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "attempted": {
                            "type": "integer",
                            "description": "Identities we ingested and ran the qualifier on. The denominator for every rate in this block."
                          },
                          "declared_a_wallet": {
                            "type": "integer"
                          },
                          "distinct_wallets": {
                            "type": "integer",
                            "description": "Distinct addresses behind those declarations. Lower than declared_a_wallet wherever operators reuse one wallet across many identities."
                          },
                          "on_shared_wallet": {
                            "type": "integer",
                            "description": "Identities declaring a wallet another identity in the same catalog also declares. Excluded from `bound`."
                          },
                          "bound": {
                            "type": "integer",
                            "description": "Identities bound to a sole-declarant wallet."
                          },
                          "bind_rate": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "qualified": {
                            "type": "integer",
                            "description": "Bound wallets we have actually read on-chain."
                          },
                          "moved_usdc": {
                            "type": "integer",
                            "description": "Qualified wallets that sent USDC to a different address after the identity existed. NOT L7."
                          },
                          "had_history_before_launch": {
                            "type": "integer",
                            "description": "Wallets whose USDC history predates their identity. That history is excluded from every figure here."
                          },
                          "l7": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "description": "Null where withheld; see l7_blocker."
                          },
                          "l7_blocker": {
                            "type": "string"
                          },
                          "blocker": {
                            "type": "string",
                            "description": "Present when a whole partner block is empty because we have measured nothing."
                          },
                          "caveats": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The collector's partner document could not be read or did not verify. No substitute value is served."
          }
        },
        "security": []
      }
    },
    "/api/x402flow": {
      "get": {
        "operationId": "getX402Flow",
        "summary": "What x402 Bazaar sellers receive, read from the chains",
        "description": "Every stablecoin transfer INTO the payTo addresses sellers declare in the Coinbase x402 Bazaar: Base, Polygon, Arbitrum, OP Mainnet, Ethereum (eth_getLogs, every three hours) and Solana (token-account signatures). Upper bound on settlement for listed sellers, floor for x402 overall. agent_* fields: the payer wallet is bound to an ERC-8004 registration.",
        "responses": {
          "200": {
            "description": "A box-signed JSON document (CC BY 4.0)."
          },
          "503": {
            "description": "The document is not available yet; nothing is invented in its place."
          }
        },
        "security": []
      }
    },
    "/api/xchain": {
      "get": {
        "operationId": "getXchain",
        "summary": "ERC-8004 beyond Base",
        "description": "Registrations, owner wallets and stablecoins sent by owners on Ethereum, Arbitrum One, OP Mainnet and Polygon PoS, after each owner's first registration. Transfers, not agent spending: the routing-hop receipt check has not run on them. Never added to Base figures.",
        "responses": {
          "200": {
            "description": "A box-signed JSON document (CC BY 4.0)."
          },
          "503": {
            "description": "The document is not available yet; nothing is invented in its place."
          }
        },
        "security": []
      }
    },
    "/api/treasury": {
      "get": {
        "operationId": "getTreasury",
        "summary": "What ranked agents hold",
        "description": "Priced holdings of wallets bound to L7+ agents on Base, split into cash (stablecoins), ETH, DeFi positions net of debt, and other tokens. Unpriced tokens are counted, never valued.",
        "responses": {
          "200": {
            "description": "A box-signed JSON document (CC BY 4.0)."
          },
          "503": {
            "description": "The document is not available yet; nothing is invented in its place."
          }
        },
        "security": []
      }
    },
    "/api/bazaar": {
      "get": {
        "operationId": "getBazaar",
        "summary": "The x402 Bazaar as a census",
        "description": "Resources and distinct seller addresses per network in the Coinbase x402 Bazaar. An offer to sell is not a payment.",
        "responses": {
          "200": {
            "description": "A box-signed JSON document (CC BY 4.0)."
          },
          "503": {
            "description": "The document is not available yet; nothing is invented in its place."
          }
        },
        "security": []
      }
    },
    "/api/chains": {
      "get": {
        "operationId": "getChains",
        "summary": "ERC-8004 issuance on other chains",
        "description": "Registry mints watched live on Ethereum, Arbitrum, OP Mainnet and Polygon. Issuance, never agents.",
        "responses": {
          "200": {
            "description": "A box-signed JSON document (CC BY 4.0)."
          },
          "503": {
            "description": "The document is not available yet; nothing is invented in its place."
          }
        },
        "security": []
      }
    },
    "/check/liveness": {
      "get": {
        "operationId": "check_liveness",
        "summary": "AI agent liveness check: is this ERC-8004 agent on Base alive and paying? L0–L9 rank with evidence",
        "description": "L0–L9 rank with the evidence behind it: bindings (method, confidence, validity), first and last observed payment, stablecoin float, delegation. Dated, with a receipt. The pack is built before the payment settles; a failure on our side costs nothing. Bought from a signed-in wallet it is also listed under Your purchases on the Desk.",
        "tags": [
          "Evidence packs (paid, x402)"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The registration: an ERC-8004 token id on Base (e.g. 53008), the agent slug (8004-base-53008) or a bound wallet address.",
            "schema": {
              "type": "string"
            },
            "example": "53008"
          }
        ],
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          },
          "protocols": [
            {
              "x402": {
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0xb25c17e26054bf34e507185dd8981888c9e044fd"
              }
            }
          ]
        },
        "responses": {
          "200": {
            "description": "The pack, with x402.receipt (transaction, network, payer), as_of, definition_ids, license (CC BY 4.0) and what it does not assert.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or an id that names no registration we have a record for."
          },
          "402": {
            "description": "Payment required. x402 v2 requirements in the PAYMENT-REQUIRED header and the JSON body: accepts[] (scheme exact, network eip155:8453, USDC, amount in atomic units, payTo, maxTimeoutSeconds) and extensions.bazaar (input schema).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
