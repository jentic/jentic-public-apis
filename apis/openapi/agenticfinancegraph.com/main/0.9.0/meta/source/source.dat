            "in": "query",
            "required": true,
            "description": "The registration: an ERC-8004 token id on Base (e.g. 53008), the agent slug (8004-base-53008) or a bound wallet address.",
            "schema": {
              "type": "string"
            },
            "example": "53008"
          }
        ],
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          },
          "protocols": [
            {
              "x402": {
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0xb25c17e26054bf34e507185dd8981888c9e044fd"
              }
            }
          ]
        },
        "responses": {
          "200": {
            "description": "The pack, with x402.receipt (transaction, network, payer), as_of, definition_ids, license (CC BY 4.0) and what it does not assert.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or an id that names no registration we have a record for."
          },
          "402": {
            "description": "Payment required. x402 v2 requirements in the PAYMENT-REQUIRED header and the JSON body: accepts[] (scheme exact, network eip155:8453, USDC, amount in atomic units, payTo, maxTimeoutSeconds) and extensions.bazaar (input schema).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Flag": {
        "type": "object",
        "required": [
          "id",
          "t",
          "kind",
          "severity",
          "title",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "The x position on the chart"
          },
          "kind": {
            "type": "string",
            "enum": [
              "launch",
              "incident",
              "regulation",
              "rail",
              "vault",
              "market"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "notable",
              "major"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "body": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 400
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Required https URL. No flag exists without a source."
          },
          "producer": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which series the event is about"
          }
        }
      },
      "Metric": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "producer",
          "kind"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "examples": [
              "USD",
              "USDC",
              "ratio",
              "agents"
            ]
          },
          "producer": {
            "type": "string",
            "description": "self | DefiLlama | Keyrock | 8004scan | ...",
            "examples": [
              "self",
              "DefiLlama"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "live",
              "cited"
            ]
          },
          "window": {
            "type": "string",
            "description": "Time window the value describes"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "description": "How a live value was produced, e.g. eth_call totalAssets()"
          },
          "caveat": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-discovery": {
    "compat": "https://agenticfinancegraph.com/.well-known/x402",
    "catalog": "https://agenticfinancegraph.com/.well-known/agent-card.json"
  }
}
