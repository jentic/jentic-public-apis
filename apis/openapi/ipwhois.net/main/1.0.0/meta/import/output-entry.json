                "type": "number"
              },
              "accuracy_radius_km": {
                "type": "integer"
              },
              "is_eu": {
                "type": "boolean"
              }
            }
          },
          "timezone": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "utc_offset": {
                "type": "string",
                "description": "Paid plans."
              },
              "is_dst": {
                "type": "boolean"
              },
              "current_time": {
                "type": "string"
              }
            }
          },
          "network": {
            "type": "object",
            "properties": {
              "asn": {
                "type": "integer"
              },
              "isp": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "connection_type": {
                "type": "string",
                "description": "isp, cable, mobile, hosting, business, backbone, vpn, education, government and others."
              },
              "asn_name": {
                "type": "string",
                "description": "Paid plans, like every field below."
              },
              "org_domain": {
                "type": "string"
              },
              "holding": {
                "type": "string",
                "description": "Parent company of the operator."
              },
              "holding_domain": {
                "type": "string"
              },
              "usage": {
                "type": "string",
                "description": "Network detail, for example FTTH Residential."
              },
              "hostname": {
                "type": "string"
              },
              "range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer"
                  }
                }
              },
              "rpki": {
                "type": "string"
              },
              "speed_mbps": {
                "type": "object",
                "properties": {
                  "download": {
                    "type": "number"
                  },
                  "upload": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "country_info": {
            "type": "object",
            "description": "Paid plans.",
            "properties": {
              "calling_code": {
                "type": "string"
              },
              "tld": {
                "type": "string"
              },
              "currency": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "symbol": {
                    "type": "string"
                  }
                }
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "security": {
            "type": "object",
            "description": "Paid plans.",
            "properties": {
              "is_vpn": {
                "type": "boolean"
              },
              "vpn_provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_proxy": {
                "type": "boolean"
              },
              "is_tor": {
                "type": "boolean"
              },
              "is_hosting": {
                "type": "boolean"
              },
              "is_threat": {
                "type": "boolean"
              },
              "threat_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "threat_confidence": {
                "type": "integer"
              },
              "threat_reports": {
                "type": "integer"
              },
              "threat_last_seen": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "abuse": {
            "type": "object",
            "description": "Paid plans.",
            "properties": {
              "email": {
                "type": "string"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "IpBatch": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IpResult"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "BlacklistResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "ip": {
            "type": "string"
          },
          "listed": {
            "type": "boolean"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "additionalProperties": true,
        "description": "Paid plans add the per-list detail."
      },
      "BlacklistBatch": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlacklistResult"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "MacResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "mac": {
            "type": "string"
          },
          "found": {
            "type": "boolean"
          },
          "oui": {
            "type": "string"
          },
          "normalized": {
            "type": "string"
          },
          "is_multicast": {
            "type": "boolean"
          },
          "is_local": {
            "type": "boolean"
          },
          "is_randomized": {
            "type": "boolean"
          },
          "vendor": {
            "type": "object",
            "properties": {
              "company": {
                "type": "string"
              },
              "country_code": {
                "type": "string"
              },
              "short_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "website": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "industry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "founded": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "headquarters": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "total_ouis": {
                "type": "integer"
              }
            }
          },
          "block": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "MA-L, MA-M, MA-S or CID."
              },
