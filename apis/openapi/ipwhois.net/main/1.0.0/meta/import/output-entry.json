                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              }
            }
          },
          "device": {
            "type": "object",
            "properties": {
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interface": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_virtual_machine": {
                "type": "boolean"
              },
              "vm_platform": {
                "type": [
                  "string",
                  "null"
