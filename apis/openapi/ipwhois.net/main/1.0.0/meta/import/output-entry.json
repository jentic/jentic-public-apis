{
  "openapi": "3.1.0",
  "info": {
    "title": "IPWhois.net API",
    "version": "1.0.0",
    "summary": "IP geolocation, network and ISP data, IP blacklist status and MAC vendor lookup.",
    "description": "One key works for all three services. Every call needs an API key; a free key (1,000 IP, 1,000 blacklist and 1,000 MAC lookups a day, 1 request per second, basic fields) is created at https://ipwhois.net/account/api. Paid plans return the full field set, allow batch calls and are metered per month: Starter 250,000 requests at 5 per second, Pro 1,500,000 at 15 per second, Business 6,000,000 at 30 per second. Prices are on https://ipwhois.net/pricing. The key goes in the X-API-Key header, in Authorization: Bearer, or in the key query parameter.",
    "termsOfService": "https://ipwhois.net/terms-of-use",
    "contact": {
      "name": "IPWhois.net",
      "url": "https://ipwhois.net/contact",
      "email": "info@ipwhois.net"
    },
    "x-jentic-source-url": "https://ipwhois.net/openapi.json"
  },
  "servers": [
    {
      "url": "https://ipwhois.net/api/v1"
    }
  ],
  "paths": {
    "/ip": {
      "get": {
        "tags": [
          "IP"
        ],
        "operationId": "lookupOwnIp",
        "summary": "Look up the caller's own IP address",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated paths to keep, for example location,network.isp"
          },
          {
            "name": "pretty",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Indented JSON."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ip/{ip}": {
      "get": {
        "tags": [
          "IP"
        ],
        "operationId": "lookupIp",
        "summary": "Geolocation, ISP, ASN and connection type of an IPv4 or IPv6 address",
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "8.8.8.8"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated paths to keep, for example location,network.isp"
          },
          {
            "name": "pretty",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Indented JSON."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ip/batch": {
      "post": {
        "tags": [
          "IP"
        ],
        "operationId": "lookupIpBatch",
        "summary": "Look up many IP addresses in one call (paid plans)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ips"
                ],
                "properties": {
                  "ips": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "ips": [
                  "8.8.8.8",
                  "1.1.1.1"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpBatch"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
