    "/api/purchases/create": {
      "post": {
        "tags": [
          "Procurement"
        ],
        "summary": "Create a purchase order",
        "operationId": "createPurchaseOrder",
        "description": "Creates a new Purchase Order (PO) in SOMA Software.\n\nLinks suppliers, buyers, payment terms, and a detailed list of required items or components, allowing for full tracking from the initial request to the approval stage.\n\n## Request Body Fields\n\n| Field | Type | Description | Required |\n|-------|------|-------------|----------|\n| `creationDate` | Date | Record creation date (YYYY-MM-DD) | Yes |\n| `number` | String | Unique alphanumeric PO code | No |\n| `providerId` | Integer | Supplier ID | Yes |\n| `purchasedById` | Integer | Buyer person ID | Yes |\n| `currencyId` | Integer | Currency ID | No |\n| `trackingNumber` | String | Logistic tracking reference | No |\n| `requiredDate` | Date | Required delivery date | No |\n| `paymentTermsId` | Integer | Payment terms ID | No |\n| `approved` | Boolean | Initial approval status | No |\n| `items` | Array | Products/services to acquire | Yes |\n\n## Items Array Fields\n\n| Field | Type | Description | Required |\n|-------|------|-------------|----------|\n| `requisitionId` | Integer | Source requisition ID | Yes |\n| `catalogId` | Integer | Product catalog ID | Yes |\n| `quantity` | Integer | Units to purchase | Yes |\n| `unitCost` | Float | Unit cost | No |\n| `conditionComponentMovId` | Integer | Component condition ID | No |\n| `observations` | String | Item notes | No |\n| `remarksPn` | String | Part Number remarks | No |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePurchaseOrderRequest"
              },
              "example": {
                "creationDate": "2025-12-18",
                "number": "PO-25120001",
                "providerId": 123456,
                "purchasedById": 15423,
                "currencyId": 64001,
                "trackingNumber": "TRACK-001",
                "requiredDate": "2025-12-25",
                "paymentTermsId": 64010,
                "requiredPurchaseDate": "2026-01-25",
                "approved": false,
                "approvedByPersonId": null,
                "items": [
                  {
                    "requisitionId": 555001,
                    "catalogId": 777100,
                    "quantity": 10,
                    "unitCost": 20.5,
                    "conditionComponentMovId": 64020,
                    "observations": "Urgent",
                    "remarksPn": "N/A"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
