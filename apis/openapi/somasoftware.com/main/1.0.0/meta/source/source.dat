      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer",
            "example": 1703123456789
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "exception": {
            "type": "string",
            "example": "MethodArgumentNotValidException"
          },
          "errors": {
            "type": "array",
            "items": {
