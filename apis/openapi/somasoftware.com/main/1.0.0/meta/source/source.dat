        ],
        "summary": "Get catalog by ID",
        "operationId": "getCatalogById",
        "description": "Retrieves detailed information for a specific catalog component by its unique identifier.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
