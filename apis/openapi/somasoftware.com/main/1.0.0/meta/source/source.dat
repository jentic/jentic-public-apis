                "typeId": 63655,
                "clasificationId": 126720,
                "address": "123 Aviation Way, Hangar 8B",
                "url": "www.aviationparts.com",
                "remarks": "Certified FAA/EASA supplier",
                "countryId": 1704,
                "stateId": 1750,
                "cityId": 39133
              }
