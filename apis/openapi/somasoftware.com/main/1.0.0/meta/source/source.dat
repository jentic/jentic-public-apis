  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic Authentication for API access.\n\n**Credentials:**\n- **Username**: `public_soma_api`\n- **Password**: `HIDDEN`\n"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer Token obtained from the login endpoint.\n\nInclude in header: `Authorization: Bearer <token>`\n"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required or token invalid/expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnauthorizedError"
            },
            "example": {
              "timestamp": 1703123456789,
              "status": 401,
              "error": "Unauthorized",
              "message": "Full authentication is required to access this resource",
              "path": "/api/catalog/company"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Request validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "format": "email",
            "description": "User email address registered in SOMA",
            "example": "YOUR_ACCOUNT@somasoftware.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "User password",
            "example": "YOUR_PASSWORD"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token for API authorization",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "username": {
            "type": "string",
            "description": "Authenticated user's email",
            "example": "user@company.com"
          }
        }
      },
      "ListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier",
            "example": 63655
          },
          "code": {
            "type": "string",
            "description": null,
            "example": "PROVIDER_TYPES_WORKSHOP"
          },
          "lable": {
            "type": "string",
            "description": "Short code (if applicable)",
            "example": "Proveedor de Servicios"
          },
          "description": {
            "type": "string",
            "description": "Short code (if applicable)",
            "example": null
          }
        }
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Person ID"
          },
          "name": {
            "type": "string",
            "description": "First name"
          },
          "lastName": {
            "type": "string",
            "description": "Last name"
          },
          "email": {
            "type": "string",
            "description": "Email address"
          },
          "department": {
            "type": "string",
            "description": "Department name"
          },
          "position": {
            "type": "string",
            "description": "Job position"
          }
        }
      },
      "CreatePersonRequest": {
        "type": "object",
        "required": [
          "name",
          "lastName",
          "occupationId",
          "positionId",
          "countryId",
          "stateId",
          "cityId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "First name(s)",
            "example": "Andres"
          },
          "lastName": {
            "type": "string",
            "description": "Last name(s)",
            "example": "Luna"
          },
          "documentType": {
            "type": "string",
            "description": "Document type (DNI, Passport, etc.)",
            "example": "DNI"
          },
          "documentNumber": {
            "type": "string",
            "description": "Document number",
            "example": "12345"
          },
          "admissionDate": {
            "type": "string",
            "format": "date",
            "description": "Hire date",
            "example": "2020-04-15"
          },
          "departmentId": {
            "type": "integer",
            "description": "Department ID",
            "example": 232544
          },
          "occupationId": {
            "type": "integer",
            "description": "Occupation ID",
            "example": 63366
          },
          "positionId": {
            "type": "integer",
            "description": "Position ID",
            "example": 128314
          },
          "birthdate": {
            "type": "string",
            "format": "date",
            "description": "Birth date",
            "example": "1990-03-18"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address",
            "example": "andres.luna@company.com"
          },
          "phone": {
            "type": "string",
            "description": "Phone number",
            "example": "9876543"
          },
          "address": {
            "type": "string",
            "description": "Address",
            "example": "Calle 1 casa A"
          },
          "countryId": {
            "type": "integer",
            "description": "Country ID",
            "example": 1704
          },
          "stateId": {
            "type": "integer",
            "description": "State ID",
            "example": 1750
          },
          "cityId": {
            "type": "integer",
            "description": "City ID",
            "example": 39133
          }
        }
      },
      "CreateComponentRequest": {
        "type": "object",
        "required": [
          "partNumber",
          "description",
          "ataId",
          "typeId"
        ],
        "properties": {
          "partNumber": {
            "type": "string",
            "description": "Unique Part Number",
            "example": "TP1000-10"
          },
          "description": {
            "type": "string",
            "description": "Component description",
            "example": "Turbine Pump Assembly"
          },
          "ataId": {
            "type": "integer",
            "description": "ATA chapter code ID",
            "example": 64055
          },
          "maintenanceControlId": {
            "type": "integer",
            "nullable": true,
            "description": "Maintenance control type ID",
            "example": 77565
          },
          "manufacturer": {
            "type": "string",
            "description": "Manufacturer name",
            "example": "Honeywell"
          },
          "typeId": {
            "type": "integer",
            "description": "Component type ID",
            "example": 63459
          },
          "fleetId": {
            "type": "integer",
            "nullable": true,
            "description": "Fleet ID (required for serialized components)",
            "example": 128209
          },
          "maxPosition": {
            "type": "integer",
            "nullable": true,
            "description": "Maximum installation positions",
            "example": 2
          },
          "unitMeasure": {
            "type": "string",
            "description": "Unit of measure",
            "example": "Unid"
          },
          "remarks": {
            "type": "string",
            "nullable": true,
            "description": "Additional notes",
            "example": "Critical component"
          },
          "classificationService": {
            "type": "string",
            "nullable": true,
            "description": "Service classification (for Service type)",
            "example": "Nuevo"
          },
          "parameterControlId": {
            "type": "integer",
            "nullable": true,
            "description": "Parameter control ID (for Engines)",
            "example": 136388
          },
          "limitControlCycle": {
            "type": "integer",
            "nullable": true,
            "description": "Cycle limit control (for Disks)",
            "example": 10
          },
          "limitControlHours": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "Hours limit control (for Disks)",
            "example": 10.5
          }
        }
      },
