        ],
        "summary": "Create a new supplier",
        "operationId": "createSupplier",
        "description": "Registers a new supplier in SOMA Software.\n\nThe created supplier will be available for:\n- Quotation requests\n- Purchase order generation\n- Supplier performance tracking\n\n## Supplier Types\n\n- Manufacturers\n- Distributors\n- Repair workshops\n- Logistics services\n- Other aeronautical goods and services providers\n",
        "security": [
