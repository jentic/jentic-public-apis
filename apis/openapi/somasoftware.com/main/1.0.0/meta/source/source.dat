    "/api/catalog/{catalogId}/fleets": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get fleets associated with a catalog component",
        "operationId": "getCatalogFleets",
        "description": "Retrieves the aircraft fleets associated with a specific component catalog.\n\nLinked fleets determine which aircraft types the defined components apply to, facilitating proper inventory management, maintenance, and technical control.\n\n## Common Use Cases\n\n- Validate catalog applicability to specific fleets\n- External integrations requiring catalog-fleet relationship information\n- Support technical and maintenance rules by aircraft type\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "description": "Unique component catalog identifier",
            "schema": {
              "type": "integer"
            },
            "example": 970210
          }
        ],
        "responses": {
          "200": {
            "description": "Associated fleet list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FleetProfile"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Catalog not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/{catalogId}/equivalents": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get equivalent components",
        "operationId": "getCatalogEquivalents",
        "description": "Retrieves the list of equivalent (alternative) Part Numbers for a specific catalog component.\n\nEquivalent components are interchangeable parts that can be validly used in Inventory, Procurement, and Maintenance processes.\n\n## Use Cases\n\n- Identify alternative Part Numbers for substitution\n- Support procurement decisions when primary parts are unavailable\n- Technical analysis and material control\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "description": "Unique component catalog identifier",
            "schema": {
              "type": "integer"
            },
            "example": 970214
          }
        ],
        "responses": {
          "200": {
            "description": "Equivalent components list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EquivalentComponent"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Catalog not found or no equivalents available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/components/warehouse": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Query components in warehouse",
        "operationId": "getWarehouseComponents",
        "description": "Retrieves components stored in a specific warehouse with various filtering options.\n\n## Available Filters\n\nAll parameters are optional and can be combined:\n- **warehouseId**: Filter by specific warehouse\n- **zone**: Filter by warehouse zone\n- **partNumber**: Filter by component Part Number\n- **componentTypeId**: Filter by component type\n- **statusId**: Filter by component status (available, reserved, quarantine, etc.)\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "warehouseId",
            "in": "query",
            "description": "Warehouse identifier",
            "schema": {
              "type": "integer"
            },
            "example": 973432
          },
          {
            "name": "zone",
            "in": "query",
            "description": "Specific zone within the warehouse",
            "schema": {
              "type": "string"
            },
            "example": "Zone A"
          },
          {
            "name": "partNumber",
            "in": "query",
            "description": "Component Part Number",
            "schema": {
              "type": "string"
            },
            "example": "TP1000-10"
          },
          {
            "name": "componentTypeId",
            "in": "query",
            "description": "Component type identifier.\n\n**Valid values:**\n- `63459` - Rotable\n- `63460` - Tools\n- `63461` - Equipment\n- `63462` - Engine\n- `63463` - Propeller\n- `63505` - Consumable\n- `81641` - Serialized Consumable\n- `107858` - Landing Gear\n- `136387` - Disk\n- `241455` - Service\n",
            "schema": {
              "type": "integer"
            },
            "example": 63505
          },
          {
            "name": "statusId",
            "in": "query",
            "description": "Component status identifier (available, reserved, quarantine)",
            "schema": {
              "type": "integer"
            },
            "example": 77939
          }
        ],
        "responses": {
          "200": {
            "description": "Warehouse components list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WarehouseComponent"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/components/installed": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Query installed aircraft components",
        "operationId": "getInstalledComponents",
        "description": "Retrieves components currently installed on a specific aircraft.\n\nProvides visibility into the aircraft's technical configuration, essential for:\n- Maintenance planning\n- Component control and traceability\n- Configuration management\n- Technical audits\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "airshipId",
            "in": "query",
            "required": true,
            "description": "Aircraft identifier",
            "schema": {
              "type": "integer"
            },
            "example": 968687
          },
          {
            "name": "partNumber",
            "in": "query",
            "description": "Filter by specific Part Number",
            "schema": {
              "type": "string"
            },
            "example": "A947-2"
          },
          {
            "name": "componentTypeId",
            "in": "query",
            "description": "Filter by component type",
            "schema": {
              "type": "integer"
            },
            "example": 63459
          }
        ],
        "responses": {
          "200": {
            "description": "Installed components list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstalledComponent"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/components/workshop": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Query components in workshop",
        "operationId": "getWorkshopComponents",
        "description": "Retrieves components currently in a workshop for repair, overhaul, or maintenance.\n\nProvides traceability for components under maintenance processes including repair orders and service status.\n",
