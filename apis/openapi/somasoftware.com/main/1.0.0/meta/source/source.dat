        "summary": "Get service catalogs",
        "operationId": "getServiceCatalogs",
        "description": "Retrieves the list of service catalogs available in SOMA Software.\n\nService catalogs group and define technical, operational, and maintenance services used by the company.\n\n## Common Use Cases\n\n- Maintenance and work order management\n- Internal and external service registration\n- External system integrations (ERP, billing, BI)\n- Cost analysis and operational control\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Service catalogs list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogSearchResult"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/catalog/{catalogId}": {
      "get": {
        "tags": [
