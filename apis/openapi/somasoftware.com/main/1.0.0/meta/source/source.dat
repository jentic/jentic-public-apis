    "/api/list/component/type": {
      "get": {
        "tags": [
          "Reference Lists"
        ],
        "summary": "Get component types",
        "operationId": "getComponentTypes",
        "description": "Retrieves the list of available component types in SOMA.\n\n## Common Component Types\n\n| ID | Type | Description |\n|---|---|---|\n| `63459` | Rotable | Repairable serialized components |\n| `63460` | Tools | Maintenance and repair tools |\n| `63461` | Equipment | Ground support and test equipment |\n| `63462` | Engine | Aircraft engines |\n| `63463` | Propeller | Propeller assemblies |\n| `63505` | Consumable | Non-serialized expendable parts |\n| `81641` | Serialized Consumable | Tracked expendable parts |\n| `107858` | Landing Gear | Landing gear assemblies |\n| `136387` | Disk | Life-limited rotating parts |\n| `241455` | Service | Maintenance services |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of component types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListItem"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
