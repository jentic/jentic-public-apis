                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Personnel"
        ],
        "summary": "Create a new person",
        "operationId": "createPerson",
        "description": "Creates a new person record within the SOMA system.\n\nUsed to record personal, professional, and location data linked to master records.\n\n## Required Fields\n\n| Field | Description |\n|-------|-------------|\n| `name` | First name(s) |\n| `lastName` | Last name(s) |\n| `occupationId` | Occupation ID from reference list |\n| `positionId` | Position ID from reference list |\n| `countryId` | Country ID from reference list |\n| `stateId` | State ID from reference list |\n| `cityId` | City ID from reference list |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePersonRequest"
              },
              "example": {
                "name": "Andres",
                "lastName": "Luna",
                "documentType": "DNI",
                "documentNumber": "12345",
                "admissionDate": "2020-04-15",
                "departmentId": 232544,
                "occupationId": 63366,
                "positionId": 128314,
                "birthdate": "1990-03-18",
                "email": "andres.luna@company.com",
                "phone": "9876543",
                "address": "Calle 1 casa A",
                "countryId": 1704,
                "stateId": 1750,
                "cityId": 39133
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Person created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/catalog/components": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Create a new component in the catalog",
        "operationId": "createComponent",
        "description": "Creates a new component record within the SOMA Software catalog.\n\nThe created component will be available for:\n- Inventory entry processes\n- Purchase order associations\n- Maintenance task usage\n- External system integrations (ERP, BI, etc.)\n\n## Required Fields by Component Type\n\n### 1. Expendable (`typeId: 63505`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 2. Serialized Expendable (`typeId: 81641`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 3. Disk (`typeId: 136387`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u26a0\ufe0f Only for Life Limit Part (LLP) - use `id=93809` |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `limitControlCycle` | \u2705 Yes |\n| `limitControlHours` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 4. Equipment (`typeId: 63461`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 5. Tools (`typeId: 63460`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 6. Engine (`typeId: 63462`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `parameterControlId` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 7. Propeller (`typeId: 63463`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 8. Rotable (`typeId: 63459`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 9. Service (`typeId: 241455`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `classificationService` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n### 10. Gear / Landing Gear (`typeId: 107858`)\n| Field | Required |\n|-------|----------|\n| `partNumber` | \u2705 Yes |\n| `description` | \u2705 Yes |\n| `ataId` | \u2705 Yes |\n| `maintenanceControlId` | \u2705 Yes |\n| `manufacturer` | \u2705 Yes |\n| `typeId` | \u2705 Yes |\n| `fleetId` | \u2705 Yes |\n| `maxPosition` | \u2705 Yes |\n| `unitMeasure` | \u2705 Yes |\n| `remarks` | \u274c Optional |\n\n## Considerations\n\n- Validates required information before creating the record\n- Applies company rules, roles, and permissions of the authenticated user\n- Prevents component duplication based on defined criteria (e.g., Part Number)\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateComponentRequest"
              },
              "examples": {
                "rotable": {
                  "summary": "Create a Rotable Component",
                  "value": {
                    "partNumber": "TP1000-10",
                    "description": "Turbine Pump Assembly",
                    "ataId": 64055,
                    "maintenanceControlId": 77565,
                    "manufacturer": "Honeywell",
                    "typeId": 63459,
                    "fleetId": 128209,
                    "maxPosition": 2,
                    "unitMeasure": "Unid",
                    "remarks": "Critical component"
                  }
                },
                "consumable": {
                  "summary": "Create a Consumable Component",
                  "value": {
                    "partNumber": "MS20002-4",
                    "description": "Washer, Flat",
                    "ataId": 64055,
                    "maintenanceControlId": null,
                    "manufacturer": "AN Hardware",
                    "typeId": 63505,
                    "unitMeasure": "Unid",
                    "remarks": "Standard hardware"
                  }
                },
                "service": {
                  "summary": "Create a Service",
                  "value": {
                    "partNumber": "SVC-NDT-001",
                    "description": "Non-Destructive Testing Service",
                    "ataId": 64055,
                    "typeId": 241455,
                    "classificationService": "Nuevo",
                    "remarks": "External NDT inspection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Component created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResponse"
                },
                "example": {
                  "message": "Catalog created with id = 10001"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/catalog/search": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Search catalog by Part Number",
        "operationId": "searchCatalogByPartNumber",
        "description": "Searches and retrieves component information using the Part Number (P/N) as the search criterion.\n\nIdeal for external integrations that need to validate, synchronize, or retrieve specific component data based on its technical identifier.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "partNumber",
            "in": "query",
            "required": true,
            "description": "Part number of the component to search",
            "schema": {
              "type": "string"
            },
            "example": "ALS30A223DB025"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogSearchResult"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Catalog not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/services": {
      "get": {
        "tags": [
          "Catalog"
