      "CreateRequisitionRequest": {
        "type": "object",
        "required": [
          "creationDate",
          "warehouseId",
          "items"
        ],
        "properties": {
          "creationDate": {
            "type": "string",
            "format": "date",
            "description": "Creation date",
            "example": "2025-12-15"
          },
          "requisitionNumber": {
            "type": "string",
            "description": "Optional custom requisition number",
            "example": ""
          },
          "warehouseId": {
            "type": "integer",
            "description": "Destination warehouse ID",
            "example": 973432
          },
          "workOrderId": {
            "type": "integer",
            "description": "Related work order ID",
            "example": 3415283
          },
          "airshipId": {
            "type": "integer",
            "description": "Related aircraft ID",
            "example": 966265
          },
          "discrepancyId": {
            "type": "integer",
            "description": "Related discrepancy ID",
            "example": 2323473
          },
          "relatedTo": {
            "type": "string",
            "description": "Requisition purpose",
            "example": "Spare parts for scheduled maintenance"
          },
          "requiredByPersonId": {
            "type": "integer",
            "description": "Requesting person ID",
            "example": 970144
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ],
            "description": "Priority level",
            "example": "High"
          },
          "approved": {
            "type": "boolean",
            "description": "Auto-approve requisition",
            "example": true
          },
          "approvedByPersonId": {
            "type": "integer",
            "description": "Approving person ID",
            "example": 970144
          },
          "items": {
            "type": "array",
            "description": "Requisition line items",
            "items": {
              "$ref": "#/components/schemas/RequisitionItem"
            }
          }
        }
      },
