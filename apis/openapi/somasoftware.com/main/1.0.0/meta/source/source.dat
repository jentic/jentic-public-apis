    "/api/components/dispatch": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Query dispatched components",
        "operationId": "getDispatchedComponents",
        "description": "Retrieves components that have been dispatched from inventory.\n\nProvides traceability for outbound component movements including dispatch destination and movement references.\n\n## Dispatch Destinations\n\n| Value | Description |\n|-------|-------------|\n| `AIRSHIP` | Dispatched to aircraft for installation |\n| `WORKSHOP` | Dispatched to workshop for repair/overhaul |\n| `WAREHOUSE` | Transferred to another warehouse |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "dispatchTo",
            "in": "query",
            "required": true,
            "description": "Component dispatch destination",
            "schema": {
              "type": "string",
              "enum": [
                "AIRSHIP",
                "WORKSHOP",
                "WAREHOUSE"
              ]
            },
            "example": "AIRSHIP"
          },
          {
            "name": "airshipId",
            "in": "query",
            "description": "Destination aircraft ID (required when dispatchTo = AIRSHIP)",
            "schema": {
              "type": "integer"
            },
            "example": 966265
          },
          {
            "name": "partNumber",
            "in": "query",
            "description": "Filter by Part Number",
            "schema": {
              "type": "string"
            },
            "example": "1128-12B6"
          },
          {
            "name": "componentTypeId",
            "in": "query",
            "description": "Filter by component type",
            "schema": {
              "type": "integer"
            },
            "example": 63459
          }
        ],
        "responses": {
          "200": {
            "description": "Dispatched components list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DispatchedComponent"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/dispatch": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Create a component dispatch",
        "operationId": "createDispatch",
        "description": "Registers the dispatch of components to a specific aircraft.\n\nThis endpoint facilitates inventory control by linking the sender, receiver, and the specific items being mobilized from warehouse to aircraft.\n\n## Request Body Fields\n\n| Field | Type | Description | Required |\n|-------|------|-------------|----------|\n| `dispatchDate` | String | Dispatch date (Format: `DD-MM-YYYY`) | Yes |\n| `airshipId` | Integer | Destination aircraft ID | Yes |\n| `sendPersonId` | Integer | Sender person ID | Yes |\n| `reciviedPersonId` | Integer | Receiver person ID | Yes |\n| `componentsToSend` | Array | Components to dispatch | Yes |\n\n## componentsToSend Array Fields\n\n| Field | Type | Description | Required |\n|-------|------|-------------|----------|\n| `id` | Integer | Component ID in inventory | Yes |\n| `observation` | String | Notes about the item | No |\n| `quantityToDispatch` | Integer | Units to dispatch | Yes |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDispatchRequest"
              },
              "example": {
                "dispatchDate": "22-12-2025",
                "airshipId": 966265,
                "sendPersonId": 955446,
                "reciviedPersonId": 955446,
                "componentsToSend": [
                  {
                    "id": 975722,
                    "observation": "Scheduled replacement",
                    "quantityToDispatch": 1
                  },
                  {
                    "id": 2689715,
                    "observation": "",
                    "quantityToDispatch": 1
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispatch created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/components/required-purchased": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Query required and purchased components",
        "operationId": "getRequiredPurchasedComponents",
        "description": "Retrieves components that are in the procurement pipeline - either required, quoted, or ordered.\n\nProvides visibility into pending procurement activities for inventory planning.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "description": "Location or operational base identifier",
            "schema": {
              "type": "integer"
            },
            "example": 973432
          },
          {
            "name": "partNumber",
            "in": "query",
            "description": "Component Part Number",
            "schema": {
              "type": "string"
            },
            "example": "C2400 L4P"
          },
          {
            "name": "componentTypeId",
            "in": "query",
            "description": "Component type identifier",
            "schema": {
              "type": "integer"
            },
            "example": 63459
          },
          {
            "name": "statusId",
            "in": "query",
            "description": "Procurement process status.\n\nExamples: required, quoted, ordered, approved\n",
            "schema": {
              "type": "integer"
            },
            "example": 81750
          }
        ],
        "responses": {
          "200": {
            "description": "Components in procurement process list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RequiredPurchasedComponent"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/airship": {
      "get": {
        "tags": [
          "Fleet Management"
        ],
        "summary": "Get aircraft list",
        "operationId": "getAircraft",
        "description": "Retrieves the list of aircraft registered in SOMA Software that the authenticated user has access to.\n\nSupports multiple filter parameters for targeted searches.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "description": "Filter by aircraft model",
            "schema": {
              "type": "string"
            },
            "example": "Airbus A320"
          },
          {
            "name": "plate",
            "in": "query",
            "description": "Filter by registration number",
            "schema": {
              "type": "string"
            },
            "example": "HK5092G"
          },
          {
            "name": "fleet",
            "in": "query",
            "description": "Filter by fleet",
            "schema": {
              "type": "string"
            },
            "example": "Cessna 172"
          },
          {
            "name": "serial",
            "in": "query",
            "description": "Filter by serial number",
            "schema": {
              "type": "string"
            },
            "example": "172S9391"
          },
          {
            "name": "country",
            "in": "query",
            "description": "Filter by registration country",
            "schema": {
              "type": "string"
            },
            "example": "Colombia"
          }
        ],
        "responses": {
          "200": {
            "description": "Aircraft list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Aircraft"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No aircraft found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Fleet Management"
        ],
        "summary": "Create a new aircraft",
        "operationId": "createAircraft",
        "description": "Registers a new aircraft in SOMA Software.\n\nThe created aircraft will be available for:\n- Component installation tracking\n- Maintenance scheduling\n- Flight operations\n- Technical documentation\n\n## Required Fields\n\n| Field | Description |\n|-------|-------------|\n| `plate` | Aircraft registration number (must be unique) |\n| `serial` | Aircraft serial number |\n| `countryId` | Registration country ID |\n| `manufactureDate` | Manufacturing date |\n| `isRotaryWing` | Helicopter indicator |\n| `modelId` | Aircraft model ID (or model name) |\n| `fleetId` | Fleet ID (or fleet name) |\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAircraftRequest"
              },
              "example": {
                "plate": "HK-6667",
                "serial": "abc123",
                "countryId": 1704,
                "manufactureDate": "2024-01-15",
                "isRotaryWing": false,
                "model": "Airbus A320",
                "modelId": 254847,
                "fleet": "Cessna 172",
                "fleetId": 128216
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aircraft created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                },
                "example": 3495231
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Aircraft already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "The object is not saved because it already exists"
                }
              }
            }
          }
        }
      }
    },
    "/api/warehouse": {
