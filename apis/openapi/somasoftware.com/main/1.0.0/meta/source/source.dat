    "/api/requisitions/create": {
      "post": {
        "tags": [
          "Requisitions"
        ],
        "summary": "Create a new requisition",
        "operationId": "createRequisition",
        "description": "Creates a new component or service requisition in SOMA Software.\n\n## Requisition Workflow\n\n1. Requisition is created with required items\n2. If `approved: true`, the requisition is automatically approved\n3. Items become available for quotation or purchase order generation\n\n## Multiple Items\n\nA single requisition can include multiple items with different part numbers, quantities, and observations.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequisitionRequest"
              },
              "example": {
                "creationDate": "2025-12-15",
                "requisitionNumber": "",
                "warehouseId": 973432,
                "workOrderId": 3415283,
                "airshipId": 966265,
                "discrepancyId": 2323473,
                "relatedTo": "Spare parts needed for scheduled maintenance",
                "requiredByPersonId": 970144,
                "priority": "High",
                "approved": true,
                "approvedByPersonId": 970144,
                "items": [
                  {
                    "partNumber": "92-8-200-1",
                    "quantity": 1,
                    "observations": "Urgent",
                    "remarksPn": "Replacement due to critical failure",
                    "catalogId": 970212
                  },
                  {
                    "partNumber": "MS20002-4+",
                    "quantity": 5,
                    "observations": "Required for aircraft inspection",
                    "remarksPn": "Standard supply",
                    "catalogId": 974310
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requisition created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequisitionResponse"
                },
                "example": {
                  "requisitionId": "3498941",
                  "requisitionNumber": "REQ-25120506",
                  "status": "Approved",
                  "approved": true,
                  "items": 2
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
