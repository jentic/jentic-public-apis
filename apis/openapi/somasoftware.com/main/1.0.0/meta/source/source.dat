      "FieldError": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "NotNull.partNumber",
              "NotNull"
            ]
          },
          "defaultMessage": {
            "type": "string",
            "example": "must not be null"
          },
          "field": {
            "type": "string",
            "example": "partNumber"
          },
          "rejectedValue": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "bindingFailure": {
            "type": "boolean",
            "example": false
          },
          "code": {
            "type": "string",
            "example": "NotNull"
          }
        }
      }
    }
  }
