  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication and JWT token management.\n\nAll API operations require a valid JWT token obtained through the login endpoint.\n"
    },
    {
      "name": "Reference Lists",
      "description": "Reference data and lookup tables for the SOMA system.\n\nThese endpoints provide master data used throughout the API including:\n- Geographic data (countries, states, cities)\n- Component classifications (types, manufacturers, ATA codes)\n- Aircraft configurations (models, fleets)\n- Personnel attributes (departments, positions, occupations)\n- Supplier classifications\n"
    },
    {
      "name": "Personnel",
      "description": "Personnel management for organizational staff.\n\nRegister and query personnel records including contact information, roles, and departmental assignments.\n"
    },
    {
      "name": "Catalog",
      "description": "Component catalog management for aviation parts and services.\n\nThe catalog is the master registry of all components available for:\n- Inventory tracking\n- Procurement processes\n- Maintenance task assignments\n- Technical documentation\n"
    },
    {
      "name": "Inventory",
      "description": "Component inventory tracking across all locations.\n\nMonitor and query components in:\n- **Warehouses**: Available stock for dispatch\n- **Aircraft**: Installed components\n- **Workshops**: Components under repair/overhaul\n- **In Transit**: Dispatched components\n- **Procurement**: Required and ordered components\n"
    },
    {
      "name": "Fleet Management",
      "description": "Aircraft fleet administration and configuration.\n\nManage aircraft records including registration, technical specifications, and operational data.\n"
    },
    {
      "name": "Warehouses",
      "description": "Warehouse and storage location management.\n\nCreate and query warehouse information for inventory distribution and logistics control.\n"
    },
    {
      "name": "Suppliers",
      "description": "Supplier and vendor management.\n\nRegister and manage suppliers for procurement operations including contact information, classifications, and certifications.\n"
    },
    {
      "name": "Requisitions",
      "description": "Material and service requisition management.\n\nCreate and track requisitions for components and services required for maintenance and operations.\n"
    },
    {
      "name": "Procurement",
      "description": "Procurement operations and purchase order management.\n\nCreate purchase orders and access procurement reference data including currencies, payment terms, and component conditions.\n"
    },
    {
      "name": "Maintenance",
      "description": "Maintenance operations including discrepancies and work orders.\n\nTrack maintenance activities, discrepancies (logbook entries), and work order status.\n"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate user and obtain JWT token",
        "operationId": "authenticateUser",
        "description": "Authenticates a user and returns a JWT token for API access.\n\n## Authentication Flow\n\n1. Send a POST request with valid user credentials in the request body\n2. Include Basic Authentication headers with the public API credentials\n3. Receive a JWT token in the response\n4. Use the token in the `Authorization: Bearer <token>` header for all subsequent requests\n\n## Basic Authentication Credentials\n\n| Parameter | Value |\n|-----------|-------|\n| Username | `public_soma_api` |\n| Password | `hidden` |\n\nFor security purposes, the public API key is not published in this documentation. To obtain your API credentials, please submit a request to SOMA Software Technical Support at technicalsupport@somasoftware.com.\n\n## Token Management\n\n- Store the token securely\n- Tokens expire after a configured period\n- Implement automatic refresh logic before expiration\n- Never expose tokens in client-side code or logs\n",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "YOUR_ACCOUNT@somasoftware.com",
                "password": "YOUR_PASSWORD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "username": "user@company.com"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Invalid username or password"
                }
              }
            }
          }
        }
      }
    },
