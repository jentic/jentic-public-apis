{
  "openapi": "3.0.1",
  "info": {
    "title": "iptor-base-erp-tables",
    "description": "Iptor base ERP API - tables. This API set is grouping together most configuration tables of DC1.",
    "contact": {
      "name": "Iptor",
      "url": "https://iptor.com"
    },
    "version": "v1.17.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/iptor-293/iptor-base-erp-tables/v1.17.0"
  },
  "tags": [
    {
      "name": "Item Extended Descriptions",
      "description": "Set of APIs for managing item extended descriptions (SRBPRX table). These APIs allow creation, retrieval, updating, and deletion of multilingual item descriptions with configurable print settings for sales and purchase documents."
    }
  ],
  "paths": {
    "/extendedItemDescription": {
      "description": "Primary endpoint for item extended descriptions. This API set (GET, POST, PUT and DELETE) is intended to be used with the IDC file SRBPRX (Item Extended Description).",
      "parameters": [
        {
          "$ref": "#/components/parameters/header-Env-Company"
        }
      ],
      "get": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "GET - Retrieves ALL extended item descriptions with filtering capabilities from the SRBPRX table.",
        "description": "Returns extended item descriptions in a flat list format with comprehensive filtering options. Each record represents a single description line for an item in a specific language, including all print flag settings for sales and purchase documents.\n\nVALIDATION NOTE:\n- Item must exist and be active in the item file SROPRG\n- Language must exist in the ERP languages table\n- Line number must be unique per (item, language) combination\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "parameters": [
          {
            "name": "item",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Item Number",
              "maxLength": 35,
              "type": "string",
              "description": "Filter by specific item number (e.g., 5801301)"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Language Code",
              "maxLength": 2,
              "type": "string",
              "description": "Filter by language code (e.g., EN, SP, FR)"
            }
          },
          {
            "name": "printFlag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter by specific print flag (e.g., 'printOnQuotation=Y', 'printOnInvoice=N')"
            }
          },
          {
            "$ref": "#/components/parameters/control-limit"
          },
          {
            "$ref": "#/components/parameters/control-offset"
          },
          {
            "$ref": "#/components/parameters/control-orderBy"
          },
          {
            "$ref": "#/components/parameters/control-freeTextSearch"
          },
          {
            "$ref": "#/components/parameters/control-where"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Extended item descriptions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/extendedItemDescription"
                          }
                        }
                      }
                    },
                    "control": {
                      "title": "Total records",
                      "type": "object",
                      "properties": {
                        "total": {
                          "$ref": "#/components/schemas/control-total"
                        },
                        "more": {
                          "$ref": "#/components/schemas/control-more"
                        }
                      },
                      "description": "Pagination and total count information"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.getAll",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      },
      "post": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "POST - Creates one or more extended item description records in the SRBPRX table.",
        "description": "Adds new extended description lines for items in specific languages. Supports bulk creation of multiple description lines in a single request. Each description line includes configurable print flags for sales documents (quotation, order confirmation, pick list, transport note, invoice, request for quote) and purchase documents (delivery schedule, purchase order, reception note, quality control note).\n\nVALIDATION RULES:\n1. Item must exist and be active in the item file SROPRG\n2. Language must exist in the ERP languages table\n3. Line number must be unique per (item, language) combination\n4. All print flags must be either 'Y' or 'N'\n5. Text description is required and must not exceed maximum length\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/extendedItemDescriptionRequest"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/extendedItemDescriptionRequest"
                    },
                    "minItems": 1,
                    "maxItems": 100,
                    "description": "Array of extended item description records for bulk creation"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created - Extended item description(s) created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "recordsCreated": {
                          "type": "integer",
                          "description": "Number of records successfully created",
                          "example": 1
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/extendedItemDescription"
                          }
                        },
                        "recordTimeStampCustomerUse": {
                          "title": "Record time stamp customer use",
                          "maxLength": 26,
                          "type": "string",
                          "description": "Timestamp when records were created",
                          "example": "2024-01-15-14.30.45.123456"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed (e.g., invalid item, language not found, duplicate line number)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Record already exists (duplicate item, language, line number combination)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.create",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      }
    },
    "/extendedItemDescription/{item}/{language}/{lineNumber}": {
      "description": "APIs for a specific extended item description record identified by composite key (item, language, line number).",
      "parameters": [
        {
          "$ref": "#/components/parameters/header-Env-Company"
        },
        {
          "name": "item",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Item Number",
            "maxLength": 35,
            "type": "string",
            "description": "Item number identifier",
            "example": "5801301"
          }
        },
        {
          "name": "language",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Language Code",
            "maxLength": 2,
            "type": "string",
            "description": "Language code (e.g., EN, SP, FR)",
            "example": "SP"
          }
        },
        {
          "name": "lineNumber",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Line Number",
            "type": "integer",
            "minimum": 1,
            "maximum": 99999,
            "description": "Line number for the description (unique per item+language)",
            "example": 2
          }
        }
      ],
      "get": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "GET - Retrieves a specific extended item description record from the SRBPRX table.",
        "description": "Returns a single extended description line identified by the composite key (item, language, line number). Includes all print flag settings for both sales and purchase documents.\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "responses": {
          "200": {
            "description": "OK - Extended item description retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/extendedItemDescription"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Extended item description record not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.getSingle",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      },
      "put": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "PUT - Updates a specific extended item description record in the SRBPRX table.",
        "description": "Fully replaces an existing extended description line. The primary key fields (item, language, lineNumber) cannot be modified. Only text description and print flag settings can be updated.\n\nVALIDATION RULES:\n1. Item must remain active in the item file SROPRG\n2. All print flags must be either 'Y' or 'N'\n3. Text description is required and must not exceed maximum length\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/extendedItemDescriptionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK - Extended item description updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/extendedItemDescription"
                    },
                    "message": {
                      "type": "string",
                      "example": "Extended item description updated successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed (e.g., invalid print flags, missing text description)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Extended item description record not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.update",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      },
      "delete": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "DELETE - Deletes a specific extended item description record from the SRBPRX table.",
        "description": "Removes a single extended description line identified by the composite key (item, language, line number). This operation is irreversible and only affects the specific line, not other descriptions for the same item or language.\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "responses": {
          "200": {
            "description": "OK - Extended item description deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "deleted": {
                          "type": "boolean",
                          "description": "Indicates if the deletion was successful",
                          "example": true
                        },
                        "item": {
                          "type": "string",
                          "description": "Item number that was deleted",
                          "example": "5801301"
                        },
                        "language": {
                          "type": "string",
                          "description": "Language code that was deleted",
                          "example": "SP"
                        },
                        "lineNumber": {
                          "type": "integer",
                          "description": "Line number that was deleted",
                          "example": 2
                        },
                        "recordTimeStampCustomerUse": {
                          "title": "Record time stamp of deletion",
                          "maxLength": 26,
                          "type": "string",
                          "description": "Timestamp when the deletion occurred",
                          "example": "2024-01-15-14.35.20.654321"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Extended item description record not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.delete",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      }
    },
    "/extendedItemDescription/byItem/{item}": {
      "description": "APIs for retrieving all extended descriptions for a specific item across all languages.",
      "parameters": [
        {
          "$ref": "#/components/parameters/header-Env-Company"
        },
        {
          "name": "item",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Item Number",
            "maxLength": 35,
            "type": "string",
            "description": "Item number identifier",
            "example": "5801301"
          }
        }
      ],
      "get": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "GET - Retrieves ALL extended descriptions for a specific item from the SRBPRX table.",
        "description": "Returns all extended description lines for a given item, organized by language. Useful for viewing complete multilingual descriptions for an item, including all print settings across different languages.\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "parameters": [
          {
            "$ref": "#/components/parameters/control-limit"
          },
          {
            "$ref": "#/components/parameters/control-offset"
          },
          {
            "$ref": "#/components/parameters/control-orderBy"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Item descriptions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "item": {
                          "type": "string",
                          "description": "Item number",
                          "example": "5801301"
                        },
                        "languages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "language": {
                                "type": "string",
                                "description": "Language code",
                                "example": "EN"
                              },
                              "descriptionCount": {
                                "type": "integer",
                                "description": "Number of description lines in this language",
                                "example": 2
                              },
                              "descriptions": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/components/schemas/extendedItemDescription"
                                }
                              }
                            }
                          }
                        },
                        "totalDescriptions": {
                          "type": "integer",
                          "description": "Total number of description lines across all languages",
                          "example": 4
                        },
                        "availableLanguages": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "List of languages available for this item",
                          "example": [
                            "EN",
                            "SP"
                          ]
                        }
                      }
                    },
                    "control": {
                      "title": "Total records",
                      "type": "object",
                      "properties": {
                        "total": {
                          "$ref": "#/components/schemas/control-total"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No descriptions found for the specified item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.getByItem",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      }
    },
    "/extendedItemDescription/byItem/{item}/{language}": {
      "description": "APIs for retrieving all extended descriptions for a specific item in a specific language.",
      "parameters": [
        {
          "$ref": "#/components/parameters/header-Env-Company"
        },
        {
          "name": "item",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Item Number",
            "maxLength": 35,
            "type": "string",
            "description": "Item number identifier",
            "example": "5801301"
          }
        },
        {
          "name": "language",
          "in": "path",
          "required": true,
          "schema": {
            "title": "Language Code",
            "maxLength": 2,
            "type": "string",
            "description": "Language code (e.g., EN, SP, FR)",
            "example": "EN"
          }
        }
      ],
      "get": {
        "tags": [
          "Item Extended Descriptions"
        ],
        "summary": "GET - Retrieves ALL extended descriptions for a specific item and language from the SRBPRX table.",
        "description": "Returns all extended description lines for a given item in a specific language, sorted by line number. Useful for viewing the complete description sequence for an item in a particular language, including all print settings.\n\nDEPENDENCY NOTE:\n- DC1 build 22.0.24 or later required for SRBPRX table access",
        "parameters": [
          {
            "$ref": "#/components/parameters/control-orderBy"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Item language descriptions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "item": {
                          "type": "string",
                          "description": "Item number",
                          "example": "5801301"
                        },
                        "language": {
                          "type": "string",
                          "description": "Language code",
                          "example": "EN"
                        },
                        "descriptions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/extendedItemDescription"
                          }
                        },
                        "descriptionCount": {
                          "type": "integer",
                          "description": "Number of description lines",
                          "example": 2
                        },
                        "salesPrintFlags": {
                          "type": "object",
                          "description": "Summary of sales document print settings",
                          "properties": {
                            "printOnQuotation": {
                              "type": "integer",
                              "description": "Number of lines set to print on quotation"
                            },
                            "printOnInvoice": {
                              "type": "integer",
                              "description": "Number of lines set to print on invoice"
                            }
                          }
                        },
                        "purchasePrintFlags": {
                          "type": "object",
                          "description": "Summary of purchase document print settings",
                          "properties": {
                            "printOnPurchaseOrder": {
                              "type": "integer",
                              "description": "Number of lines set to print on purchase order"
                            },
                            "printOnReceptionNote": {
                              "type": "integer",
                              "description": "Number of lines set to print on reception note"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No descriptions found for the specified item and language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/default-error"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "$ref": "#/components/responses/default-error"
          }
        },
        "x-aperio": {
          "control-parameters": {
            "method": "extendedItemDescription.getByItemLanguage",
            "openCrossRef": true,
            "program": "MGRR0XXXX"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api-tst.tech.iptor.com/base-tables/v1",
      "description": "Test environment"
    },
    {
      "url": "https://api.tech.iptor.com/base-tables/v1",
      "description": "Production environment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "default-error": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Error code",
                  "example": "ITEM_NOT_ACTIVE"
                },
                "message": {
                  "type": "string",
                  "description": "Error message",
                  "example": "Item '5801301' is not active in the item file SROPRG"
                },
                "field": {
                  "type": "string",
                  "description": "Field causing the error",
                  "example": "item"
                }
              }
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP status code",
                "example": 400
              },
              "message": {
                "type": "string",
                "description": "General error description",
                "example": "Validation failed"
              }
            }
          }
        }
      },
      "extendedItemDescription": {
        "title": "Extended Item Description",
        "type": "object",
        "properties": {
          "item": {
            "title": "Item Number",
            "maxLength": 35,
            "type": "string",
            "description": "Item number identifier",
            "example": "5801301"
          },
          "language": {
            "title": "Language Code",
            "maxLength": 2,
            "type": "string",
            "description": "Language code (must exist in ERP languages table)",
            "example": "EN"
          },
          "lineNumber": {
            "title": "Line Number",
            "type": "integer",
            "minimum": 1,
            "maximum": 99999,
            "description": "Line number for the description (unique per item+language)",
            "example": 1
          },
          "textDescription": {
            "title": "Text Description",
            "maxLength": 60,
            "type": "string",
            "description": "Extended description text",
            "example": "TOILET BOWL, EVAC-90, FLOOR INCL.FLUSHING RING"
          },
          "printOnQuotation": {
            "title": "Print on Quotation",
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": "Print this line on quotation documents",
            "example": "N"
          },
          "printOnOrderConfirmation": {
            "title": "Print on Order Confirmation",
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": "Print this line on order confirmation documents",
            "example": "N"
          },
          "printOnPickList": {
            "title": "Print on Pick List",
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": "Print this line on pick list documents",
            "example": "N"
          },
          "printOnTransportNote": {
            "title": "Print on Transport Note",
            "type": "string",
