{
  "openapi": "3.1.0",
  "info": {
    "version": "0.0.1",
    "title": "Sutro Public API",
    "description": "The API through which apps can be generated, deployed, monitored and updated.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/sutro-c06/SpecsAPI/0.0.1"
  },
  "servers": [
    {
      "description": "DEV",
      "url": "https://local.withsutro.com"
    }
  ],
  "security": [
    {
      "sutroApiKey": []
    }
  ],
  "tags": [
    {
      "name": "projects",
      "description": "Projects are where it all happens with Sutro. A project contains all of the assets and information used to generate your application. In addition, this is \nwhere you can manage versions, deployments and monitoring of your application. It's also where you can access the generated assets that make up\nyour application.\n"
    },
    {
      "name": "attachments",
      "description": "These are files, Figma project, prompts and other assets that you upload to Sutro to help with the application generation process.\n"
    },
    {
      "name": "applications",
      "description": "The application that you are building"
    },
    {
      "name": "assets",
      "description": "Bundles and other files that can be downloaded"
    },
    {
      "name": "specs",
      "description": "Specifications describing an application"
    }
  ],
  "components": {
    "securitySchemes": {
      "sutroApiKey": {
        "description": "API key provided in console",
        "type": "apiKey",
        "name": "x-sutro-api-key",
        "in": "header"
      }
    },
    "schemas": {
      "VersionString": {
        "description": "A version string for an Application",
        "type": "string",
        "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,6}$",
        "examples": [
          "1.2.34"
        ]
      },
      "Application": {
        "description": "An application",
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "examples": [
              "b08631ad-a4ec-4c27-9995-01287e83d565"
            ]
          },
          "name": {
            "type": "string",
            "description": "The name of the Application",
            "examples": [
              "My Cool App"
            ]
          }
        }
      },
      "ApplicationVersion": {
        "description": "A snapshot of an Application",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "examples": [
              "b08631ad-a4ec-4c27-9995-01287e83d565"
            ]
          },
          "versionNumber": {
            "$ref": "#/components/schemas/VersionString"
          }
        }
      },
      "PageMeta": {
        "description": "Metadata for a paginated response",
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "examples": [
              10
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "ProjectName": {
        "description": "A short name for a Project`",
        "type": "string",
        "maxLength": 128,
        "examples": [
          "My Cool Project"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "description": "A unique id for your Project",
            "type": "string",
            "format": "uuid",
            "examples": [
              "b08631ad-a4ec-4c27-9995-01287e83d565"
            ]
          },
          "name": {
            "description": "A short name for your Project",
            "$ref": "#/components/schemas/ProjectName"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ApplicationStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "examples": [
              "Archived",
              "Generating"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SiteMap": {
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "route",
                "content"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "description"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "type"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Persona": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Admin User"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "AppOverview": {
        "type": "object",
        "required": [
          "name",
          "jobToBeDone",
          "unsupportedUserJourneys",
          "draftUserJourneys"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "jobToBeDone": {
            "type": "string"
          },
          "unsupportedUserJourneys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "description",
                "reason",
                "steps"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "draftUserJourneys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "outcome",
                "steps"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "SimpleRequirement": {
        "type": "object",
        "required": [
          "id",
          "description",
          "parentId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AppDraft": {
        "type": "object",
        "required": [
          "sitemap",
          "requirements"
        ],
        "properties": {
          "sitemap": {
            "$ref": "#/components/schemas/SiteMap"
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimpleRequirement"
            }
          }
        }
      },
      "AppViews": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "rootComponent"
            ],
            "properties": {
              "rootComponent": {
                "type": "string"
              },
              "state": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "string"
                  }
                }
              },
              "props": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                }
              },
              "hideIf": {
                "type": "string"
              },
              "referencesRequirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "DomainModel": {
        "type": "object",
        "required": [
          "models"
        ],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "fields",
                "requirements",
                "isUserModel"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "relationshipType": {
                        "enum": [
                          "hasOne",
                          "hasMany",
                          "belongsToOne",
                          "belongsToMany",
                          "manyToMany"
                        ]
                      }
                    }
                  }
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "description",
                      "parentId"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "parentId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "isUserModel": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "DesignSystemElement": {
        "type": "object",
        "description": "An element of the design system, such as colors, typography, spacing, components, effects, or layout.\nThe `context` field will contain additional information relevant to that element. For Enterprise Figma users, this is where information about design variables and styles will be included.",
        "properties": {
          "description": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            }
          }
        }
      },
      "NamedDesignSystemElement": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DesignSystemElement"
          }
        ],
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "FigmaAnalysisReport": {
        "examples": [
          "```json\n{\n  \"metadata\": {\n    \"figmaFileKey\": \"PAY123FLOW\",\n    \"figmaFileName\": \"Payflow - Banking App\",\n    \"analyzedAt\": \"2025-10-24T14:23:11Z\",\n    \"accessLevel\": \"standard\",\n    \"analysisModes\": [\"design_system\", \"information_architecture\", \"user_flows\"]\n  },\n\n  \"summary\": \"Payflow is a mobile banking application with a clean, minimal layout and a structured design system centered on clarity, trust, and accessibility.\",\n\n  \"designSystem\": {\n    \"overview\": \"Consistent design language, clear type scale, and strong color contrast. Minor padding inconsistencies on some cards.\",\n\n    \"colors\": {\n      \"description\": \"A blue primary palette with teal accents and neutral grays for background. Reds for alerts and success greens for confirmation.\",\n      \"context\": {\n        \"source\": \"styles_api\",\n        \"tokens\": [\n          { \"name\": \"primary\", \"value\": \"#2563EB\", \"role\": \"action\" },\n          { \"name\": \"accent\", \"value\": \"#14B8A6\", \"role\": \"positive\" },\n          { \"name\": \"error\", \"value\": \"#DC2626\", \"role\": \"error\" }\n        ],\n        \"palette\": {\n          \"primary\": [\"#1E3A8A\", \"#2563EB\", \"#3B82F6\"],\n          \"neutral\": [\"#FFFFFF\", \"#F9FAFB\", \"#E5E7EB\", \"#1F2937\"]\n        }\n      }\n    },\n\n    \"typography\": {\n      \"description\": \"Uses Inter and SF Pro fonts. Clear hierarchy with 34px titles, 20px headlines, and 16px body text.\",\n      \"context\": {\n        \"typeScale\": [\n          { \"name\": \"Title\", \"fontSize\": 34, \"weight\": 600 },\n          { \"name\": \"Body\", \"fontSize\": 16, \"weight\": 400 }\n        ],\n        \"fontFamilies\": [\n          { \"name\": \"Inter\", \"weights\": [400, 500, 600] },\n          { \"name\": \"SF Pro\", \"weights\": [400, 500, 600] }\n        ]\n      }\n    },\n\n    \"spacing\": {\n      \"description\": \"4px base grid with common gaps of 8, 16, and 24px. Cards use 20px padding.\",\n      \"context\": {\n        \"baseUnit\": 4,\n        \"scale\": [4, 8, 16, 24, 32],\n        \"commonPatterns\": { \"cardPadding\": 20, \"screenMargin\": 16 }\n      }\n    },\n\n    \"components\": {\n      \"description\": \"Includes buttons, inputs, and cards with consistent states and variants.\",\n      \"context\": {\n        \"categories\": {\n          \"buttons\": [\n            {\n              \"name\": \"Button/Primary\",\n              \"variants\": [\"default\", \"disabled\"],\n              \"usageCount\": 52\n            }\n          ],\n          \"inputs\": [\n            {\n              \"name\": \"Input/Text\",\n              \"variants\": [\"default\", \"focused\", \"error\"],\n              \"usageCount\": 36\n            }\n          ]\n        },\n        \"totalCount\": 28\n      }\n    },\n\n    \"effects\": {\n      \"description\": \"Subtle shadows for elevation. Rounded corners (8–12px) across components.\",\n      \"context\": {\n        \"shadows\": [\n          { \"name\": \"card\", \"blur\": 8, \"color\": \"rgba(0,0,0,0.08)\" }\n        ],\n        \"borderRadius\": { \"buttons\": 8, \"cards\": 12 }\n      }\n    },\n\n    \"layout\": {\n      \"description\": \"Optimized for mobile (375x812). Fixed header, scrollable content, bottom navigation.\",\n      \"context\": {\n        \"dimensions\": { \"mobile\": { \"width\": 375, \"height\": 812 } },\n        \"safeAreas\": { \"top\": 44, \"bottom\": 34 }\n      }\n    }\n  },\n\n  \"informationArchitecture\": {\n    \"description\": \"Five main sections accessible via a bottom tab bar: Home, Transfers, Budget, Cards, and Profile.\",\n    \"pages\": [\n      {\n        \"name\": \"Main Screens\",\n        \"description\": \"Core navigation tabs of the app\",\n        \"screens\": [\n          {\n            \"name\": \"Home\",\n            \"description\": \"Shows account balance, quick actions, and recent transactions.\",\n            \"context\": {\n              \"id\": \"1:234\",\n              \"dimensions\": { \"width\": 375, \"height\": 812 },\n              \"sections\": [\"Balance Header\", \"Quick Actions\", \"Transaction List\"]\n            }\n          },\n          {\n            \"name\": \"Transfers\",\n            \"description\": \"Send and request money via contacts.\",\n            \"context\": {\n              \"tabs\": [\"Send\", \"Request\"],\n              \"defaultTab\": \"Send\"\n            }\n          }\n        ]\n      }\n    ],\n    \"navigation\": \"Bottom tab navigation with modal bottom sheets for details.\"\n  },\n\n  \"userFlows\": [\n    {\n      \"name\": \"Send Money\",\n      \"description\": \"From Home → Transfers → Contact → Amount → Confirm → Success.\",\n      \"context\": {\n        \"steps\": [\n          { \"screen\": \"Home\", \"action\": \"Tap 'Pay'\" },\n          { \"screen\": \"Transfers\", \"action\": \"Select contact\" },\n          { \"screen\": \"Confirmation\", \"action\": \"Confirm amount\" },\n          { \"screen\": \"Success\", \"action\": \"View confirmation\" }\n        ],\n        \"estimatedSteps\": 4\n      }\n    }\n  ],\n\n  \"notes\": [\n    \"Variables API not available (non-enterprise file).\",\n    \"Minor layout inconsistency detected on Settings screen.\"\n  ]\n}\n\n```\n"
        ],
        "type": "object",
        "required": [
          "metadata",
          "summary"
        ],
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "figmaFileKey": {
                "type": "string"
              },
              "figmaFileName": {
                "type": "string"
              },
              "analyzedAt": {
                "type": "string",
                "format": "date-time"
              },
              "accessLevel": {
                "type": "string",
                "enum": [
                  "enterprise",
                  "standard"
                ]
              },
              "analysisModes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "string"
          },
          "designSystem": {
            "type": "object",
            "required": [
              "overview"
            ],
            "properties": {
              "overview": {
                "type": "string"
              },
              "colors": {
                "$ref": "#/components/schemas/DesignSystemElement"
              },
              "typography": {
                "$ref": "#/components/schemas/DesignSystemElement"
              },
              "spacing": {
                "$ref": "#/components/schemas/DesignSystemElement"
              },
              "components": {
                "$ref": "#/components/schemas/DesignSystemElement"
              },
              "effects": {
                "$ref": "#/components/schemas/DesignSystemElement"
              },
              "layout": {
                "$ref": "#/components/schemas/DesignSystemElement"
              }
            }
          },
          "informationArchitecture": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "screens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DesignSystemElement"
                      }
                    }
                  }
                }
              },
              "navigation": {
                "type": "string"
              }
            }
          },
          "userFlows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedDesignSystemElement"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requestBodies": {
      "CreateProject": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/ProjectName"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        }
      },
      "AttachFigma": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "fileKey"
                      ],
                      "properties": {
                        "fileKey": {
                          "type": "string",
                          "description": "The Figma file key of the project to attach",
                          "examples": [
                            "PAY123FLOW"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "projectLink"
                      ],
                      "properties": {
                        "projectLink": {
                          "type": "string",
                          "format": "url",
                          "description": "A URL pointing to a Figma project",
                          "examples": [
                            "https://figma.example.com/12345"
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "pat": {
                      "type": "string",
                      "description": "A Personal Access Token that has permission to access the given Figma project.\n\nThis will require the following scopes:\n  - `file_content:read`\n  - `file_variables:read`\n  - `file_metadata:read`\n",
                      "examples": [
                        "b08631ad-a4ec-4c27-9995-01287e83d565"
                      ]
                    }
                  },
                  "required": [
                    "projectLink",
                    "pat"
                  ]
                }
              ]
            }
          }
        }
      },
      "AttachOpenAPI": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "application/yaml": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "AttachFile": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Attach": {
        "description": "The ID of the generated attachment",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "attachmentId": {
                  "type": "string",
                  "format": "uuid",
                  "examples": [
                    "b08631ad-a4ec-4c27-9995-01287e83d565"
                  ]
                }
              },
              "required": [
                "attachmentId"
              ]
            }
          }
        }
      },
      "ApplicationStatus": {
        "description": "The current status of an Application",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApplicationStatus"
            }
          },
          "text/event-stream": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "examples": [
                    "b08631ad-a4ec-4c27-9995-01287e83d565"
                  ]
                },
                "event": {
                  "type": "string",
                  "const": "application_update",
                  "examples": [
                    "application_update"
                  ]
                },
                "data": {
                  "$ref": "#/components/schemas/ApplicationStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/projects": {
      "post": {
        "operationId": "createProject",
        "summary": "Create a new project",
        "tags": [
          "projects"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateProject"
        },
        "responses": {
          "200": {
            "description": "The newly created Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Invalid project"
          }
        }
      },
      "get": {
        "operationId": "getProjects",
        "summary": "Get a list of projects",
        "tags": [
          "projects"
        ],
        "responses": {
          "200": {
            "description": "A list of the Projects that the current user can see",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The requested Projects",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/PageMeta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "get": {
        "operationId": "getProject",
        "summary": "Get details about a specific project",
        "tags": [
          "projects"
        ],
        "responses": {
          "404": {
            "description": "Project not found"
          },
          "200": {
            "description": "The requested Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "archiveProject",
        "summary": "Archive a project",
        "tags": [
          "projects"
        ],
        "responses": {
          "409": {
            "description": "Project cannot be archived in its current state"
          },
          "201": {
            "description": "Project archived"
          }
        }
      }
    },
    "/projects/{projectId}/figma": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "attachFigma",
        "summary": "Attach a Figma project to this project",
        "tags": [
          "projects",
          "attachments"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/AttachFigma"
        },
        "responses": {
          "404": {
            "description": "Project not found"
          },
          "200": {
            "$ref": "#/components/responses/Attach"
          }
        }
      }
    },
    "/projects/{projectId}/openApi": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "attachOpenApi",
        "summary": "Attach an OpenAPI document",
        "tags": [
          "projects",
          "attachments"
        ],
        "requestBody": {
          "description": "A valid OpenAPI document",
          "$ref": "#/components/requestBodies/AttachOpenAPI"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Attach"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projects/{projectId}/file": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "attachFile",
        "summary": "Attach a file",
        "tags": [
          "projects",
          "attachments"
        ],
        "requestBody": {
          "description": "A file",
          "$ref": "#/components/requestBodies/AttachFile"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Attach"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projects/{projectId}/webhooks": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "addWebhook",
        "summary": "Add a Webhook for monitoring project changes",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{projectId}/webhooks/{webhookId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        },
        {
          "name": "webhookId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "delete": {
        "operationId": "removeWebhook",
        "summary": "Remove a Webhook",
        "tags": [
          "projects"
        ]
      }
    },
    "/attachments/{attachmentId}": {
      "parameters": [
        {
          "name": "attachmentId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "delete": {
        "operationId": "removeAttachment",
        "summary": "Remove an attachment from a Project",
        "tags": [
          "attachments"
        ],
        "responses": {
          "201": {
            "description": "Attachment removed"
          },
          "404": {
            "description": "Attachment not found"
          }
        }
      }
    },
    "/projects/{projectId}/application": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "generateApplication",
        "summary": "Generate Application",
        "tags": [
          "applications"
        ],
        "responses": {
          "404": {
            "description": "Project not found"
          },
          "202": {
            "description": "Application generation started",
            "headers": {
              "location": {
                "schema": {
                  "description": "The URL that provides access to the state of application generation",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/application/{applicationId}/spec": {
      "parameters": [
        {
          "name": "applicationId",
          "in": "path",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "required": true
        }
      ],
      "get": {
        "operationId": "getApplicationSpec",
        "summary": "Get the Sutro Spec for the Application",
        "tags": [
          "applications",
          "assets"
        ],
        "responses": {
          "404": {
            "description": "Application not found"
          },
          "200": {
            "description": "The Sutro spec for the Application",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sitemap",
                    "appOverview",
                    "personas",
                    "domainModel",
                    "appDraft",
                    "requirements",
                    "views"
                  ],
                  "properties": {
                    "sitemap": {
                      "$ref": "#/components/schemas/SiteMap"
                    },
                    "appOverview": {
                      "$ref": "#/components/schemas/AppOverview"
                    },
                    "personas": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Persona"
                      }
                    },
                    "domainModel": {
                      "$ref": "#/components/schemas/DomainModel"
                    },
                    "appDraft": {
                      "$ref": "#/components/schemas/AppDraft"
                    },
                    "requirements": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SimpleRequirement"
                      }
                    },
                    "views": {
                      "$ref": "#/components/schemas/AppViews"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/application/{applicationId}/status": {
      "parameters": [
        {
          "name": "applicationId",
          "in": "path",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "required": true
        }
      ],
      "get": {
        "operationId": "getApplicationStatus",
        "summary": "Gets the current status of the Application",
        "tags": [
          "applications"
        ],
        "responses": {
          "404": {
            "description": "Application not found"
          },
          "200": {
            "$ref": "#/components/responses/ApplicationStatus"
          }
        }
      }
    },
    "/projects/{projectId}/analysis": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "post": {
        "operationId": "generateSpecs",
        "summary": "Generate specifications for the Project",
        "tags": [
          "specs"
        ],
        "responses": {
          "404": {
            "description": "Project not found"
          },
          "409": {
            "description": "No Figma assets have been attached to this Project"
          },
          "303": {
            "description": "Generation is already in progress",
            "headers": {
              "location": {
                "schema": {
                  "description": "The URL that provides access to the state of specification generation",
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "Specification generation started",
            "headers": {
              "location": {
                "schema": {
                  "description": "The URL that provides access to the state of specification generation",
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "description": "The set of analysis modes to run",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "modes"
                ],
                "properties": {
                  "modes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "The analysis modes to run when generating specifications.\n\nOne or more of the following can be selected:\n  - `design_system`: extract design tokens, components, spacing, typography\n  - `information_architecture`: extract pages, screens, structure\n  - `user_flows`: extract user flows and journeys\n",
                      "enum": [
                        "design_system",
                        "information_architecture",
                        "user_flows"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getSpecs",
        "summary": "Get the generated specifications for the Project",
        "tags": [
          "specs"
        ],
        "responses": {
          "404": {
            "description": "Project not found or specifications not yet generated"
          },
          "303": {
            "description": "Specifications are still being generated",
            "headers": {
              "location": {
                "schema": {
                  "description": "The URL that provides access to the state of specification generation",
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "The generated specifications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FigmaAnalysisReport"
                }
              }
            }
          }
        }
      }
    }
  }
}
