{
  "openapi": "3.0.3",
  "info": {
    "title": "Councillor App API",
    "description": "APIs for Ward Admin and Super Admin",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/selvaprakashdev/councillor-app-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.councillorapp.com/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login (Ward Admin / Super Admin)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Dashboard Summary",
        "responses": {
          "200": {
            "description": "Summary data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummary"
                }
              }
            }
          }
        }
      }
    },
    "/complaints": {
      "get": {
        "tags": [
          "Complaints"
        ],
        "summary": "Get Complaints List",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complaint list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          }
        }
      }
    },
    "/complaints/{complaintId}": {
      "get": {
        "tags": [
          "Complaints"
        ],
        "summary": "Get Complaint Detail",
        "parameters": [
          {
            "name": "complaintId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complaint detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintDetail"
                }
              }
            }
          }
        }
      }
    },
    "/complaints/{complaintId}/status": {
      "put": {
        "tags": [
          "Complaints"
        ],
        "summary": "Update Complaint Status",
        "parameters": [
          {
            "name": "complaintId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                }
              }
            }
          }
        }
      }
    },
    "/wards": {
      "get": {
        "tags": [
          "Wards"
        ],
        "summary": "Get Wards (Super Admin)",
        "responses": {
          "200": {
            "description": "Ward list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ward"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Wards"
        ],
        "summary": "Create Ward (Super Admin)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ward"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Ward created"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get Users (Super Admin)",
        "responses": {
          "200": {
            "description": "User list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create Ward Admin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "WARD_ADMIN",
              "SUPER_ADMIN"
            ]
          },
          "userId": {
            "type": "string"
          },
          "wardId": {
            "type": "string"
          }
        }
      },
      "Complaint": {
        "type": "object",
        "properties": {
          "complaintId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "CLOSED"
            ]
          },
          "wardId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ComplaintDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Complaint"
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ComplaintDetail_attachments"
                }
              }
            }
          }
        ]
      },
      "StatusUpdateRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "CLOSED"
            ]
          },
          "remarks": {
            "type": "string"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "totalComplaints": {
            "type": "integer"
          },
          "open": {
            "type": "integer"
          },
          "inProgress": {
            "type": "integer"
          },
          "closed": {
            "type": "integer"
          }
        }
      },
      "Ward": {
        "type": "object",
        "properties": {
          "wardId": {
            "type": "string"
          },
          "wardName": {
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "wardId": {
            "type": "string"
          }
        }
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Complaint"
            }
          },
          "totalRecords": {
            "type": "integer"
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ComplaintDetail_attachments": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "IMAGE",
              "AUDIO"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
