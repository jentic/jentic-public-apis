{
  "openapi": "3.0.3",
  "info": {
    "title": "gstinapi.in — GSTIN Verification API",
    "version": "1.2.0",
    "description": "Look up an Indian GSTIN (GST Identification Number) and get its legal name, trade name, registration status, taxpayer type and registered address, sourced live from India's official GSP network. Free integration: the test GSTIN 00AAAAA0000A1ZT and the test PAN AAAAA0000A answer every GSTIN and PAN endpoint with a sample in the live response shape, never charged; no setup or annual fee. Not affiliated with the Government of India or the GST Network.",
    "termsOfService": "https://www.gstinapi.in/terms",
    "contact": {
      "name": "gstinapi.in support",
      "email": "help@gstinapi.in",
      "url": "https://www.gstinapi.in/contact"
    },
    "license": { "name": "Proprietary — commercial use requires a gstinapi.in account", "url": "https://www.gstinapi.in/terms" }
  },
  "servers": [{ "url": "https://gstinapi.in", "description": "Production" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/v1/gstin/{gstin}": {
      "get": {
        "operationId": "lookupGstin",
        "summary": "Look up a GSTIN",
        "description": "Returns the current registration record for the given GSTIN. Charges 1 credit on success; malformed GSTINs are not charged.",
        "parameters": [
          {
            "name": "gstin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
              "example": "33AAACC1206D1ZN"
            },
            "description": "15-character Indian GSTIN, uppercase."
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["profile"] },
            "description": "Pass `profile` to additionally return the taxpayer's profile from the GST network at no extra credit cost: fills business_constitution, state_jurisdiction and nature_of_business, and adds einvoice_status, state_jurisdiction_code, centre_jurisdiction, centre_jurisdiction_code, last_updated and additional_addresses. The response then carries a top-level profile_complete boolean; if the profile source is momentarily unavailable the lookup still succeeds with profile_complete=false and those extra keys null."
          }
        ],
        "responses": {
          "200": {
            "description": "Lookup succeeded.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LookupSuccess" } } }
          },
          "400": { "description": "Invalid GSTIN format. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "The account has no credits left (free signup credits and purchased credits are both spent).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN is well-formed but not registered in the GST database.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded. Safe to retry with backoff.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Upstream GST provider temporarily unavailable. Safe to retry with backoff.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/{gstin}/returns": {
      "get": {
        "operationId": "gstinReturnFilingStatus",
        "summary": "Return filing status",
        "description": "Every return filed by a GSTIN in one financial year: period, type, status, filing date and ARN. Same auth, credits and rate limit as the main lookup endpoint.",
        "parameters": [
          { "name": "gstin", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "example": "33AAAAA0000A1Z5" }, "description": "15-character Indian GSTIN, uppercase." },
          { "name": "fy", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "example": "2025-26" }, "description": "Financial year, format YYYY-YY." },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Optional filter to one return type, passed through to the upstream provider unmodified." }
        ],
        "responses": {
          "200": { "description": "Lookup succeeded (an empty `returns` array means no return was filed for that GSTIN in that financial year).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReturnsSuccess" } } } },
          "400": { "description": "Invalid GSTIN format, or missing/malformed `fy`. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN not found in GST database.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Return status provider temporarily unavailable (including provider not configured).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/{gstin}/filing-preference": {
      "get": {
        "operationId": "gstinFilingPreference",
        "summary": "Return filing frequency — Monthly vs Quarterly/QRMP",
        "description": "Whether a GSTIN is on Monthly or Quarterly (QRMP) return filing, one entry per quarter of the financial year — a taxpayer can switch quarter to quarter, so this is not a single fixed value. Same auth, credits and rate limit as the main lookup endpoint.",
        "parameters": [
          { "name": "gstin", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "example": "33AAAAA0000A1Z5" }, "description": "15-character Indian GSTIN, uppercase." },
          { "name": "fy", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "example": "2025-26" }, "description": "Financial year, format YYYY-YY. Financial years before QRMP existed return an empty array rather than an error." }
        ],
        "responses": {
          "200": { "description": "Lookup succeeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FilingPreferenceSuccess" } } } },
          "400": { "description": "Invalid GSTIN format, or missing/malformed `fy`. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN not found in GST database.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Filing preference provider temporarily unavailable (including provider not configured).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/{gstin}/complete": {
      "get": {
        "operationId": "gstinCompleteProfile",
        "summary": "Complete profile (bundle) — verify + returns + filing frequency",
        "description": "Verification, return filing history and filing frequency in one call, for 2 credits — cheaper than calling the lookup, /returns and /filing-preference endpoints separately (3 credits total). Return history and filing frequency are best-effort: if either cannot be fetched, those fields come back null rather than failing the call, `partial` is true and `unavailable` names them, and you are only charged once verification itself succeeds. The price does not change when a piece is unavailable.",
        "parameters": [
          { "name": "gstin", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "example": "33AAAAA0000A1Z5" }, "description": "15-character Indian GSTIN, uppercase." }
        ],
        "responses": {
          "200": { "description": "Lookup succeeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompleteProfileSuccess" } } } },
          "400": { "description": "Invalid GSTIN format. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "The account has no credits left (free signup credits and purchased credits are both spent).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN is well-formed but not registered in the GST database.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded. Safe to retry with backoff.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Upstream GST provider temporarily unavailable. Safe to retry with backoff.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/{gstin}/contact": {
      "get": {
        "operationId": "gstinContact",
        "summary": "Registered mobile and email for a GSTIN",
        "description": "The mobile number and email on a GSTIN's registration record, with its legal name, trade name, registration date, status, taxpayer type and address read live from the GST network. Paid accounts only (any credit pack or invoice order); every account can call the test GSTIN 00AAAAA0000A1ZT for a free sample. Priced by the account's best pack: 4 credits on Scale, 5 on Growth, 6 on Starter (credits_charged in the response). A GSTIN with no contact on record is charged (contact_found false, note says so); bad format, not-found GSTINs and provider errors are free. Up to 500 charged lookups per account per India-time day. Use the contact for the business purpose it was looked up for (vendor onboarding, KYB, collections), not for unsolicited marketing.",
        "parameters": [
          { "name": "gstin", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "example": "24AAAAA0000A1Z5" }, "description": "15-character Indian GSTIN, uppercase." }
        ],
        "responses": {
          "200": { "description": "Lookup ran (charged), whether or not a contact was on record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContactSuccess" } } } },
          "400": { "description": "Invalid GSTIN format. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Not enough credits for this account's contact price (code insufficient_credits).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account has never bought a pack (code paid_account_required), or is deactivated. Not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN not found in the GST database, or rejected by the contact source. Not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Daily limit of charged contact lookups reached (code daily_limit, resets at midnight India time), or the per-minute rate limit. Not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Contact provider temporarily unavailable. Safe to retry with backoff; not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Contact lookup not available right now. Not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/{gstin}/compliance": {
      "get": {
        "operationId": "gstinComplianceSummary",
        "summary": "Filing compliance summary",
        "description": "The filing history summarised per return type: how many returns were filed in the financial year, the last period filed, how many months ago that was, and the average gap between a period's end and its filing date. Facts only — no on-time percentage (that needs the statutory due date, which varies by type, turnover and QRMP state group) and no defaulter flag (a quarterly QRMP filer legitimately shows multi-month gaps). Same auth, credits and rate limit as the main lookup endpoint.",
        "parameters": [
          { "name": "gstin", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "example": "33AAAAA0000A1Z5" }, "description": "15-character Indian GSTIN, uppercase." },
          { "name": "fy", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "example": "2025-26" }, "description": "Financial year, format YYYY-YY." }
        ],
        "responses": {
          "200": { "description": "Summary computed (total_filed of 0 with an empty by_type means no return was filed for that GSTIN in that financial year).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComplianceSuccess" } } } },
          "400": { "description": "Invalid GSTIN format, or missing/malformed `fy`. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "GSTIN not found in GST database.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Return status provider temporarily unavailable. Safe to retry with backoff.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/hsn/{code}": {
      "get": {
        "operationId": "lookupHsnCode",
        "summary": "Look up an HSN or SAC code",
        "description": "The official description for a 2 to 8 digit HSN (goods) or SAC (services) code, plus the broader codes it sits under. Served from a local copy of the GST portal's published master (tutorial.gst.gov.in/downloads/HSN_SAC.xlsx), refreshed on demand, so responses are typically under 50 ms. NO GST RATE IS RETURNED: a rate is not a function of the code alone (the same HSN attracts different rates by condition under different notifications) and the government's own master publishes no rate column.",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{2,8}$", "example": "01011010" }, "description": "HSN or SAC code, 2 to 8 digits." }
        ],
        "responses": {
          "200": { "description": "Code found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HsnLookupSuccess" } } } },
          "400": { "description": "Malformed code (not 2-8 digits). No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Code is well-formed but not present in the HSN/SAC master. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/hsn/search": {
      "get": {
        "operationId": "searchHsnCodes",
        "summary": "Search HSN / SAC codes by description",
        "description": "Find a code from a description. Ranking is exact code match, then descriptions beginning with the term, then descriptions containing it.",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "example": "cotton" }, "description": "At least 2 characters. Matched against both code and description." },
          { "name": "kind", "in": "query", "required": false, "schema": { "type": "string", "enum": ["hsn", "sac"] }, "description": "Narrow to goods (hsn) or services (sac)." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } }
        ],
        "responses": {
          "200": { "description": "Search completed (an empty results array is a valid answer).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HsnSearchSuccess" } } } },
          "400": { "description": "q shorter than 2 characters, or an invalid kind. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstin/stats/me": {
      "get": {
        "operationId": "gstinUsageStatsMe",
        "summary": "Today's usage for the calling API key",
        "description": "Aggregate counts across all of the caller’s API calls today. Does not consume a credit.",
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsageStats" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/pan/{pan}/verify": {
      "get": {
        "operationId": "verifyPan",
        "summary": "Verify a PAN and get the holder's registered name",
        "description": "Checks that a PAN exists and returns the registered name of its holder. Pass the optional `name` query parameter to also get `name_match`: a word-set comparison that ignores titles (Mr, M/S) and company suffixes (Pvt Ltd) and lets an initial match a full name; `matched` is true at a score of 80 or more. It is a hint for your own decision, not a legal identity check. Credits depend on `level` and your pack (basic 4 / 5 / 6, verified 6 / 8 / 10, details 12 / 15 / 18 for Scale / Growth / Starter) and come from the regular credit balance; the masked Aadhaar number is never returned; a PAN with no record is a billed answer, while an invalid format, a rejected value and any upstream failure are never charged. Paid accounts only; the test PAN AAAAA0000A returns a free sample for every key. Not cached.",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "pan", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "example": "AAPFU0939F" }, "description": "10-character Indian PAN." },
          { "name": "level", "in": "query", "required": false, "schema": { "type": "string", "enum": ["basic", "verified", "details"], "default": "basic" }, "description": "basic: the registered name. verified: also date of birth, holder category and Aadhaar-linked yes/no. details: also address and contact as the source returns them. Credits by pack (Scale / Growth / Starter): basic 4 / 5 / 6, verified 6 / 8 / 10, details 12 / 15 / 18." },
          { "name": "name", "in": "query", "required": false, "schema": { "type": "string", "example": "Ramesh Kumar Shah" }, "description": "The name you hold for this PAN; adds name_match to the response." }
        ],
        "responses": {
          "200": { "description": "Answered. verified is false with name null when no record exists (billed).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PanVerifySuccess" } } } },
          "400": { "description": "Invalid PAN format. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Paid account required (bought no credit pack yet), or account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "The PAN was rejected as not valid. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/pan/{pan}/gstins": {
      "get": {
        "operationId": "panToGstins",
        "summary": "Find every GSTIN registered under a PAN",
        "description": "There is no official GSTN/GSP “search by PAN” endpoint, so this checks every mathematically possible GSTIN the PAN could hold (one per state code) the same way GET /v1/gstin/{gstin} does. Billed from a separate wallet (users.pan_credits, bought on its own packs) — 1 credit per search regardless of how many states are checked, not per underlying GSTIN. A missing state is the normal case, not an error.",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "pan", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "example": "AAPFU0939F" }, "description": "10-character Indian PAN, uppercase." }
        ],
        "responses": {
          "200": { "description": "Scan completed (an empty results array is a valid answer — no GSTIN found for this PAN).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PanGstinsSuccess" } } } },
          "400": { "description": "Invalid PAN format. No credit charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "No PAN search credits on this account — billed separately from GSTIN lookup credits.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded (a PAN search is 36 upstream calls, so this endpoint has a tighter limit than a single GSTIN lookup).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Every one of the 36 candidate checks failed to reach the provider — the scan never actually ran. Not charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill": {
      "post": {
        "operationId": "generateEwaybill",
        "summary": "Generate an e-way bill",
        "description": "Files a real e-way bill against the government network and returns the e-way bill number. Costs the current price for capability `ewaybill.generate` on success (3 credits by default) — never charged on a rejection or an upstream failure. Set `test_mode: true` to skip the credit check and the real government network call entirely and get a synthetic TEST-prefixed response, for building and testing an integration for free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillGenerateRequest" } } }
        },
        "responses": {
          "200": { "description": "E-way bill generated (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillGenerateSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the payload (expired registration, malformed field). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable — a network/timeout failure, distinct from a rejection. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/lookup": {
      "post": {
        "operationId": "lookupEwaybill",
        "summary": "Look up an e-way bill by document type and number",
        "description": "Direct lookup against the government network for an e-way bill already generated for this GSTIN, by the exact docType and docNo it was filed under. Not date-scoped \u2014 works regardless of when the document was generated. Useful when a generate call answered \u2018already generated\u2019 (or you simply need to look one up) and you want the real ewaybill_no back without guessing a date to search. Costs the current price for capability `ewaybill.lookup` per call that reaches the government network (1 credit by default, well under a generate call) \u2014 unlike every other endpoint here, a clean \u2018no matching document\u2019 answer (400) IS charged, since it is still a real completed call, not a validation failure. Only a request that never reaches the government network (missing fields, insufficient credits) is free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillLookupRequest" } } }
        },
        "responses": {
          "200": { "description": "Matching e-way bill found (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillLookupSuccess" } } } },
          "400": { "description": "Missing required fields (not charged), or no e-way bill found for this docType/docNo (charged the same as a match \u2014 see the summary above).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillLookupMiss" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/consolidated": {
      "post": {
        "operationId": "generateConsolidatedEwaybill",
        "summary": "Generate a consolidated e-way bill (trip sheet)",
        "description": "Combines several e-way bills moving on one vehicle into a single consolidated e-way bill. You must be the generator or the assigned transporter of every e-way bill on it, and each must still be active. Costs the current price for capability `ewaybill.generate` on success (3 credits by default, one charge however many e-way bills it carries) \u2014 never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedRequest" } } }
        },
        "responses": {
          "200": { "description": "Consolidated e-way bill generated (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedSuccess" } } } },
          "400": { "description": "Missing or invalid fields, or the government network rejected the request (e.g. an e-way bill number it does not recognise). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/consolidated/details": {
      "post": {
        "operationId": "getConsolidatedEwaybill",
        "summary": "Get a consolidated e-way bill and the e-way bills on it",
        "description": "Reads one consolidated e-way bill (trip sheet) by its 10-digit number. Only its generator can read it. Costs the current price for capability `ewaybill.lookup` per call that reaches the government network (1 credit by default) \u2014 a clean \u2018could not retrieve\u2019 answer (400) IS charged, like POST /v1/ewaybill/details. Only a request that never reaches the government network is free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedDetailsRequest" } } }
        },
        "responses": {
          "200": { "description": "Consolidated e-way bill found (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedDetailsSuccess" } } } },
          "400": { "description": "Missing or malformed fields (not charged), or no consolidated e-way bill found for this number (charged the same as a match).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillLookupMiss" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/consolidated/regenerate": {
      "post": {
        "operationId": "regenerateConsolidatedEwaybill",
        "summary": "Regenerate a consolidated e-way bill after a vehicle change",
        "description": "Re-issues a consolidated e-way bill with new vehicle details. This is NOT an in-place edit: the response carries a NEW consolidated e-way bill number and the previous one is cancelled. Only the generator or the current transporter can regenerate, and only active, unexpired e-way bills carry across. Costs the current price for capability `ewaybill.generate` on success (3 credits by default) \u2014 never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedRegenerateRequest" } } }
        },
        "responses": {
          "200": { "description": "Consolidated e-way bill regenerated under a new number (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillConsolidatedRegenerateSuccess" } } } },
          "400": { "description": "Missing or invalid fields, or the government network rejected the request (e.g. an unknown consolidated e-way bill). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/transporter/list": {
      "post": {
        "operationId": "listEwaybillsForTransporter",
        "summary": "List the e-way bills assigned to a transporter GSTIN by date",
        "description": "Lists the e-way bills assigned to your GSTIN as transporter for a generated date, optionally narrowed to one generator GSTIN or one generator state (one filter, not both). An empty list is a normal 200 answer: the government network answers \u2018nothing assigned\u2019 and \u2018this GSTIN is not set up as a transporter\u2019 the same way, so it can mean either. The by-state variant is limited upstream to 50 calls per 15 minutes (error 658). Costs the current price for capability `ewaybill.lookup` per call that reaches the government network (1 credit by default), including one that returns an empty list \u2014 never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillTransporterListRequest" } } }
        },
        "responses": {
          "200": { "description": "List returned, possibly empty (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillTransporterListSuccess" } } } },
          "400": { "description": "Missing or invalid fields, or the government network rejected the request (e.g. rate limit 658). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/other-party/list": {
      "post": {
        "operationId": "listEwaybillsOfOtherParty",
        "summary": "List the e-way bills other parties generated against your GSTIN by date",
        "description": "Lists the e-way bills other parties (for example your suppliers) generated against your GSTIN for a generated date — NIC's GetEwayBillsofOtherParty. Poll it to learn that a bill was raised in your name. An empty list is a normal 200 answer. Costs the current price for capability `ewaybill.lookup` per call that reaches the government network (1 credit by default), including one that returns an empty list — never charged on a rejection or an upstream failure. Paid accounts only; test_mode is free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillOtherPartyListRequest" } } }
        },
        "responses": {
          "200": { "description": "List returned, possibly empty (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillOtherPartyListSuccess" } } } },
          "400": { "description": "Missing or invalid fields, or the government network rejected the request (e.g. rate limit 658). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/gstr1/save": {
      "post": {
        "operationId": "saveGstr1",
        "summary": "GSTR-1: save and preview",
        "description": "Saves the GSTR-1 JSON, moves it to proceed-to-file, reads the summary (with its checksum) and asks the GST portal to send the filing OTP to the signatory. Nothing is filed. Free.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "gstin",
                  "ret_period",
                  "pan",
                  "payload"
                ],
                "properties": {
                  "gstin": {
                    "type": "string",
                    "description": "The GSTIN being filed for. It must be connected in the dashboard first."
                  },
                  "ret_period": {
                    "type": "string",
                    "description": "Return period, MMYYYY.",
                    "example": "042024"
                  },
                  "pan": {
                    "type": "string",
                    "description": "PAN of the authorised signatory who receives the OTP.",
                    "example": "ABCDE1234F"
                  },
                  "payload": {
                    "type": "object",
                    "description": "GSTR-1 JSON in the GST network's schema."
                  },
                  "test_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Synthetic response, nothing reaches the GST network, free."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved. Returns summary, ref_id and awaiting_evc_otp.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or the GST network rejected the call. Never charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid x-api-key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid account required, or account deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The GSTIN is not connected for filing, or (GSTR-3B file) the return changed after review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Live filing is not switched on yet (file and offset only). test_mode is unaffected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gstr1/file": {
      "post": {
        "operationId": "fileGstr1",
        "summary": "GSTR-1: file with the OTP",
        "description": "Files the GSTR-1 return. Irreversible. Charged only when it succeeds. Refused with 503 until live filing is switched on.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "gstin",
                  "ret_period",
                  "pan",
                  "evc_otp",
                  "summary"
                ],
                "properties": {
                  "gstin": {
                    "type": "string",
                    "description": "The GSTIN being filed for. It must be connected in the dashboard first."
                  },
                  "ret_period": {
                    "type": "string",
                    "description": "Return period, MMYYYY.",
                    "example": "042024"
                  },
                  "pan": {
                    "type": "string",
                    "description": "PAN of the authorised signatory who receives the OTP.",
                    "example": "ABCDE1234F"
                  },
                  "evc_otp": {
                    "type": "string",
                    "pattern": "^\\d{6}$",
                    "description": "The six-digit filing OTP."
                  },
                  "summary": {
                    "type": "object",
                    "description": "The summary /v1/gstr1/save returned, unchanged."
                  },
                  "test_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Synthetic response, nothing reaches the GST network, free."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filed. Returns filed, ref_id and the billing fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or the GST network rejected the call. Never charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid x-api-key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid account required, or account deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The GSTIN is not connected for filing, or (GSTR-3B file) the return changed after review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Live filing is not switched on yet (file and offset only). test_mode is unaffected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gstr3b/save": {
      "post": {
        "operationId": "saveGstr3b",
        "summary": "GSTR-3B: save and preview",
