                }
              }
            }
          }
        }
      }
    },
    "/v1/gstr3b/offset": {
      "post": {
        "operationId": "offsetGstr3b",
        "summary": "GSTR-3B: pay the liability",
        "description": "Pays the liability from the taxpayer's cash and credit ledgers. Real money, irreversible. Free. Returns a fresh checksum. Refused with 503 until live filing is switched on.",
