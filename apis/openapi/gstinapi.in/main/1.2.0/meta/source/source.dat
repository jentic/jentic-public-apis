          "note": { "type": "string", "description": "Present only when the list is empty." },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillUpdateVehicleRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_no", "vehicle_no", "from_place", "from_state", "reason_code"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "ewaybill_no": { "type": "string", "description": "The e-way bill number to update." },
          "vehicle_no": { "type": "string" },
          "from_place": { "type": "string" },
          "from_state": { "type": "integer", "description": "NIC state code." },
          "reason_code": { "type": "string", "description": "NIC's own reason code, e.g. 1 Break Down, 2 Transhipment, 4 Others." },
          "reason_remark": { "type": "string" },
          "trans_doc_no": { "type": "string" },
          "trans_doc_date": { "type": "string" },
          "trans_mode": { "type": "string", "description": "NIC transport mode code (1 Road, 2 Rail, 3 Air, 4 Ship)." },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillUpdateVehicleSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string", "example": "351000000123" },
          "vehicle_update_date": { "type": "string", "example": "15/09/2026 11:28:00 AM" },
          "valid_upto": { "type": "string", "example": "15/09/2026 11:59:00 PM" },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillRejectRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_no"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "ewaybill_no": { "type": "string", "description": "The e-way bill number to reject \u2014 must have been generated by someone else, against your GSTIN." },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillRejectSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string", "example": "351000000123" },
          "rejected_date": { "type": "string", "example": "15/09/2026 10:24:00 AM" },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillDetailsRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_no"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "ewaybill_no": { "type": "string", "description": "The e-way bill number to fetch." },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillDetailsSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "details": { "type": "object", "description": "The full document as NIC returned it \u2014 parties, item list, vehicle-update history \u2014 passed through unshaped, not reshaped by this API." },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillCancelRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_no"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "ewaybill_no": { "type": "string", "description": "The e-way bill number to cancel." },
          "cancel_reason_code": { "type": "string", "description": "Defaults to the government network's own default reason if omitted." },
          "cancel_remark": { "type": "string" },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillCancelSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string" },
          "cancel_date": { "type": "string", "example": "13/09/2026" },
          "test_mode": { "type": "boolean" },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillCloseRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_no", "closure_date"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "ewaybill_no": { "type": "string", "description": "The e-way bill number to close." },
          "closure_date": { "type": "string", "example": "13/09/2026", "description": "Format dd/MM/yyyy." },
          "remarks": { "type": "string" },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillCloseSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string" },
          "close_date": { "type": "string", "example": "13/09/2026" },
          "test_mode": { "type": "boolean" },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "ContactSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string" },
          "test": { "type": "boolean", "description": "Present and true only for the test GSTIN's free sample." },
          "data": {
            "type": "object",
            "properties": {
              "legal_name": { "type": "string", "nullable": true },
              "trade_name": { "type": "string", "nullable": true },
              "registration_date": { "type": "string", "nullable": true },
              "status": { "type": "string", "nullable": true },
              "taxpayer_type": { "type": "string", "nullable": true },
              "address": { "type": "string", "nullable": true },
              "city": { "type": "string", "nullable": true, "description": "Locality of the principal place of business as the GST network records it; can be an area plus the city (e.g. \"Saidapet, Chennai\")." },
              "state_code": { "type": "string", "nullable": true, "description": "2-digit GST state code (the first two digits of the GSTIN)." },
              "state": { "type": "string", "nullable": true, "description": "State or union territory of registration, from the state code." },
              "pincode": { "type": "string", "nullable": true, "description": "PIN code of the principal place of business." },
              "mobile": { "type": "string", "nullable": true },
              "email": { "type": "string", "nullable": true }
            }
          },
          "contact_found": { "type": "boolean", "description": "true when a mobile or email came back." },
          "note": { "type": "string", "nullable": true, "description": "Why something is empty: 'No contact on record', 'GST details temporarily unavailable', or both joined by '; '. Null when everything came back." },
          "gst_details_available": { "type": "boolean", "description": "false when the GST network lookup failed and the registration fields are null." },
          "credits_charged": { "type": "integer", "description": "What this call cost: the account's pack rate (4, 5 or 6), or 0 for the sample." },
          "daily_limit": { "type": "object", "properties": { "limit": { "type": "integer" }, "used": { "type": "integer" }, "remaining": { "type": "integer" } } },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" },
          "response_ms": { "type": "integer" }
        }
      },
      "EinvoiceGenerateRequest": {
        "type": "object",
        "required": ["gstin", "einv_username", "password", "payload"],
        "properties": {
          "gstin": { "type": "string", "description": "Your GSTIN, with e-invoice API access already set up through a GSP (a one-time step outside this API)." },
          "einv_username": { "type": "string", "description": "API username from that setup. Never stored — forwarded once per call." },
          "password": { "type": "string", "description": "API password from that setup. Never stored." },
          "payload": { "type": "object", "description": "One NIC e-invoice (INV-01) JSON payload (DocDtls, SellerDtls, BuyerDtls, ItemList, ValDtls, etc.), in NIC's own field-name casing. Include EwbDtls to also generate the e-way bill in the same call." },
          "txn_type": { "type": "string", "enum": ["INV", "CDN", "DBN"], "default": "INV" },
          "test_mode": { "type": "boolean", "default": false, "description": "Skip the credit check and the real government network call, and return a synthetic TEST-prefixed response instead. Never charged." },
          "test_scenario": { "type": "string", "enum": ["ewaybill_failed"], "description": "With test_mode only, and a payload that has EwbDtls: return the IRN-issued, e-way-bill-refused response (ewaybill_status: failed) so that branch can be tested." }
        }
      },
      "EinvoiceGenerateSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "irn": { "type": "string" },
          "ack_no": { "type": "string" },
          "ack_date": { "type": "string", "example": "2026-09-08 10:00:00" },
          "doc_no": { "type": "string", "description": "Your invoice number, as the signed invoice records it." },
          "qr_code_image": { "type": "string", "description": "The filing system's SignedQRCode, passed through as-is — the QR payload meant for printing on the invoice. Not a rendered image; a QR-rendering library is needed to turn it into a scannable one." },
          "signed_invoice": { "type": "string", "description": "The filing system's SignedInvoice — the full tamper-evident signed invoice record (a JWS string), for audit and reconciliation. Distinct from qr_code_image." },
          "ewaybill_status": { "type": "string", "enum": ["generated", "failed", "not_requested"], "description": "What happened to the e-way bill asked for through EwbDtls. failed means the IRN was issued (and charged) but the e-way bill was refused; the reason is in ewaybill_error, and the e-way bill is then generated with POST /v1/ewaybill. not_requested means the payload had no EwbDtls." },
          "ewaybill_no": { "type": "string", "nullable": true, "description": "The e-way bill number when ewaybill_status is generated; otherwise null." },
          "ewaybill_date": { "type": "string", "nullable": true },
          "ewaybill_valid_upto": { "type": "string", "nullable": true },
          "ewaybill_error": {
            "type": "object", "nullable": true,
            "description": "Set only when ewaybill_status is failed: why the government system refused the e-way bill.",
            "properties": {
              "code": { "type": "string", "nullable": true, "example": "702" },
              "message": { "type": "string", "example": "The distance between the pincodes given is too high or low" },
              "details": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string", "nullable": true }, "message": { "type": "string" } } } }
            }
          },
          "ewaybill_distance_km": { "type": "integer", "description": "Present only when EwbDtls.Distance was 0 and the system worked the distance out from the pincodes." },
          "fix": { "type": "string", "description": "Present only when ewaybill_status is failed: what to do next." },
          "notices": { "type": "array", "description": "Present only when the e-invoice system sent extra advisories with the IRN.", "items": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } },
          "already_existed": { "type": "boolean", "description": "true if this response came from retrying an invoice number that was already generated (a DUPIRN recovery), rather than a fresh filing." },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EinvoiceCancelRequest": {
        "type": "object",
        "required": ["gstin", "einv_username", "password", "irn"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "einv_username": { "type": "string", "description": "Same e-invoice API username as generate. Never stored." },
          "gstin_username": { "type": "string", "deprecated": true, "description": "Older name for einv_username, still accepted. Used only when einv_username is absent or blank." },
          "password": { "type": "string" },
          "irn": { "type": "string", "description": "The invoice reference number to cancel." },
          "cancel_reason": { "type": "string", "description": "NIC's own reason code." },
          "cancel_remark": { "type": "string" },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EinvoiceCancelSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "irn": { "type": "string" },
          "cancel_date": { "type": "string", "example": "13/09/2026" },
          "test_mode": { "type": "boolean" },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      }
    }
  }
}
