    "/v1/gstr3b/evc-otp": {
      "post": {
        "operationId": "requestGstr3bOtp",
        "summary": "GSTR-3B: request the filing OTP",
        "description": "Asks the GST portal to send the filing OTP to the authorised signatory. Free.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "gstin",
                  "pan"
                ],
                "properties": {
                  "gstin": {
                    "type": "string",
                    "description": "The GSTIN being filed for. It must be connected in the dashboard first."
                  },
                  "pan": {
                    "type": "string",
                    "description": "PAN of the authorised signatory who receives the OTP.",
                    "example": "ABCDE1234F"
                  },
                  "test_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Synthetic response, nothing reaches the GST network, free."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP requested.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or the GST network rejected the call. Never charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid x-api-key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid account required, or account deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The GSTIN is not connected for filing, or (GSTR-3B file) the return changed after review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Live filing is not switched on yet (file and offset only). test_mode is unaffected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gstr3b/file": {
      "post": {
        "operationId": "fileGstr3b",
        "summary": "GSTR-3B: file with the OTP",
        "description": "Files the GSTR-3B return. Irreversible. The saved return is read again first and the call is refused with 409 CHECKSUM_CHANGED if it no longer matches chksum. Charged only when it succeeds. Refused with 503 until live filing is switched on.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "gstin",
                  "ret_period",
                  "pan",
                  "evc_otp",
                  "chksum"
                ],
                "properties": {
                  "gstin": {
                    "type": "string",
                    "description": "The GSTIN being filed for. It must be connected in the dashboard first."
                  },
                  "ret_period": {
                    "type": "string",
                    "description": "Return period, MMYYYY.",
                    "example": "042024"
                  },
                  "pan": {
                    "type": "string",
                    "description": "PAN of the authorised signatory who receives the OTP.",
                    "example": "ABCDE1234F"
                  },
                  "evc_otp": {
                    "type": "string",
                    "pattern": "^\\d{6}$",
                    "description": "The six-digit filing OTP."
                  },
                  "chksum": {
                    "type": "string",
                    "description": "The checksum from /save (or /offset) that the taxpayer reviewed."
                  },
                  "test_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Synthetic response, nothing reaches the GST network, free."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filed. Returns filed, ref_id and the billing fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or the GST network rejected the call. Never charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid x-api-key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid account required, or account deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The GSTIN is not connected for filing, or (GSTR-3B file) the return changed after review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Live filing is not switched on yet (file and offset only). test_mode is unaffected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ewaybill/update-vehicle": {
      "post": {
        "operationId": "updateEwaybillVehicle",
        "summary": "Update the vehicle/Part-B details on an e-way bill",
        "description": "Updates the vehicle number (and related transit details) on an e-way bill already in transit \u2014 NIC's action=VEHEWB. Same credentials as generate, plus the e-way bill number. Costs the current price for capability `ewaybill.generate` on success (3 credits by default, same as generate/cancel/close) \u2014 never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillUpdateVehicleRequest" } } }
        },
        "responses": {
          "200": { "description": "Vehicle updated (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillUpdateVehicleSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the update. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/update-transporter": {
      "post": {
        "operationId": "updateEwaybillTransporter",
        "summary": "Assign or change the transporter on an e-way bill",
        "description": "Changes the transporter (by transporter GSTIN) on an e-way bill — NIC's action=UPDATETRANSPORTER. Only the generator of the e-way bill can do this (enforced upstream). Costs the current price for capability `ewaybill.generate` on success — never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["gstin_username", "password", "gstin", "ewaybill_no", "transporter_id"],
            "properties": {
              "gstin_username": { "type": "string" }, "password": { "type": "string" }, "gstin": { "type": "string" },
              "ewaybill_no": { "type": "string" }, "transporter_id": { "type": "string", "description": "New transporter's GSTIN." },
              "test_mode": { "type": "boolean" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "Transporter updated (or a synthetic test_mode response).", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "ewaybill_no": { "type": "string" }, "transporter_id": { "type": "string" }, "transporter_update_date": { "type": "string" } } } } } },
          "400": { "description": "Missing fields, or the government network rejected the update. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "402": { "description": "Insufficient credits.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/extend-validity": {
      "post": {
        "operationId": "extendEwaybillValidity",
        "summary": "Extend the validity of an e-way bill",
        "description": "Extends an e-way bill's validity — NIC's action=EXTENDVALIDITY. NIC's extension window and Part-B (vehicle) prerequisite are enforced upstream. Costs the current price for capability `ewaybill.generate` on success — never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["gstin_username", "password", "gstin", "ewaybill_no", "from_place", "from_state", "from_pincode", "remaining_distance", "extension_reason_code", "extension_remark", "consignment_status"],
            "properties": {
              "gstin_username": { "type": "string" }, "password": { "type": "string" }, "gstin": { "type": "string" },
              "ewaybill_no": { "type": "string" }, "vehicle_no": { "type": "string", "description": "Required when consignment_status is M." },
              "from_place": { "type": "string" }, "from_state": { "type": "integer", "description": "NIC state code." }, "from_pincode": { "type": "integer" },
              "remaining_distance": { "type": "integer", "description": "Km still to travel." },
              "extension_reason_code": { "type": "integer", "description": "1 Natural Calamity, 2 Law & Order, 4 Transshipment, 5 Accident, 99 Others." },
              "extension_remark": { "type": "string" },
              "consignment_status": { "type": "string", "enum": ["M", "T"], "description": "M in movement, T in transit." },
              "transit_type": { "type": "string", "enum": ["R", "W", "O"], "description": "Only when consignment_status is T." },
              "trans_doc_no": { "type": "string" }, "trans_doc_date": { "type": "string" }, "trans_mode": { "type": "string" },
              "address_line1": { "type": "string" }, "address_line2": { "type": "string" }, "address_line3": { "type": "string" },
              "test_mode": { "type": "boolean" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "Validity extended (or a synthetic test_mode response).", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "ewaybill_no": { "type": "string" }, "updated_date": { "type": "string" }, "valid_upto": { "type": "string" } } } } } },
          "400": { "description": "Missing fields, or the government network rejected the extension. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "402": { "description": "Insufficient credits.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/reject": {
      "post": {
        "operationId": "rejectEwaybill",
        "summary": "Reject an e-way bill raised against you",
        "description": "Rejects an e-way bill another party generated against your GSTIN \u2014 NIC's action=REJEWB. Only the recipient of a document (never its own generator) can reject it, and only within the government network's own rejection window \u2014 both enforced upstream. Costs the current price for capability `ewaybill.generate` on success (3 credits by default) \u2014 never charged on a rejection (e.g. attempting to reject your own document) or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejectRequest" } } }
        },
        "responses": {
          "200": { "description": "E-way bill rejected (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejectSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the request (e.g. you generated this document yourself). Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/details": {
      "post": {
        "operationId": "getEwaybillDetails",
        "summary": "Get the full details of an e-way bill by its number",
        "description": "Direct lookup against the government network for the full document \u2014 parties, item list, vehicle-update history \u2014 by e-way bill number. NIC's action=GetEwayBill; distinct from POST /v1/ewaybill/lookup above, which looks up by doc_type+doc_no instead of an already-known ewaybill_no. Costs the current price for capability `ewaybill.lookup` per call that reaches the government network (1 credit by default) \u2014 unlike every other endpoint here except /lookup, a clean \u2018no such e-way bill\u2019 answer (400) IS charged, since it is still a real completed call, not a validation failure. Only a request that never reaches the government network (missing fields, insufficient credits) is free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillDetailsRequest" } } }
        },
        "responses": {
          "200": { "description": "E-way bill found (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillDetailsSuccess" } } } },
          "400": { "description": "Missing required fields (not charged), or no e-way bill found for this number (charged the same as a match \u2014 see the summary above).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillLookupMiss" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/cancel": {
      "post": {
        "operationId": "cancelEwaybill",
        "summary": "Cancel an e-way bill",
        "description": "Cancels a previously generated e-way bill on the government network. Same credentials as generate, plus the e-way bill number. Costs the current price for capability `ewaybill.generate` on success (3 credits by default, same as generating one) — never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillCancelRequest" } } }
        },
        "responses": {
          "200": { "description": "E-way bill cancelled (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillCancelSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the cancellation. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/ewaybill/close": {
      "post": {
        "operationId": "closeEwaybill",
        "summary": "Close an e-way bill",
        "description": "Marks an e-way bill as closed once the goods movement it covers has actually happened — different from cancelling one that should never have existed. Same credentials as generate, plus the e-way bill number and closure date. Costs the current price for capability `ewaybill.generate` on success (3 credits by default) — never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillCloseRequest" } } }
        },
        "responses": {
          "200": { "description": "E-way bill closed (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillCloseSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the close. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/einvoice": {
      "post": {
        "operationId": "generateEinvoice",
        "summary": "Generate an e-invoice",
        "description": "Files an e-invoice (IRN) against the government network. When the payload's EwbDtls (vehicle number, transport mode, distance) is populated, NIC issues the e-way bill in the same call — the response then also carries ewaybill_no alongside the irn, billed once. The two can come apart: the IRN can be issued while the e-way bill is refused, which returns 200 with ewaybill_status: failed and the reason in ewaybill_error. Costs the current price for capability `einvoice.generate` on success (3 credits by default) — never charged on a rejection or an upstream failure. Set `test_mode: true` to skip the credit check and the real government network call entirely.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EinvoiceGenerateRequest" } } }
        },
        "responses": {
          "200": { "description": "E-invoice generated (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EinvoiceGenerateSuccess" } } } },
          "400": { "description": "Missing required fields, an invalid txn_type, or the government network rejected the payload. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable — a network/timeout failure, distinct from a rejection. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/einvoice/cancel": {
      "post": {
        "operationId": "cancelEinvoice",
        "summary": "Cancel an e-invoice",
        "description": "Cancels a previously generated e-invoice by its IRN. Same credentials as generate, plus the IRN. Costs the current price for capability `einvoice.generate` on success (3 credits by default) — never charged on a rejection or an upstream failure.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EinvoiceCancelRequest" } } }
        },
        "responses": {
          "200": { "description": "E-invoice cancelled (or, with test_mode, a synthetic response).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EinvoiceCancelSuccess" } } } },
          "400": { "description": "Missing required fields, or the government network rejected the cancellation. Never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EwaybillRejected" } } } },
          "401": { "description": "Missing or invalid x-api-key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Insufficient credits for this call's cost.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Account deactivated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "GST network temporarily unavailable. Safe to retry, never charged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/watchlists": {
      "get": {
        "operationId": "listWatchlists",
        "summary": "List the caller's watchlists",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Watchlist" } } } } },
          "401": { "description": "Missing/invalid credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      },
      "post": {
        "operationId": "createWatchlist",
        "summary": "Create a watchlist",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"], "default": "daily" }
          }
        } } } },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Watchlist" } } } },
          "400": { "description": "Missing name, or invalid frequency.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "401": { "description": "Missing/invalid credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}": {
      "get": {
        "operationId": "getWatchlist",
        "summary": "Get one watchlist with its entries",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": {
            "allOf": [ { "$ref": "#/components/schemas/Watchlist" }, { "type": "object", "properties": { "entries": { "type": "array", "items": { "$ref": "#/components/schemas/WatchlistEntry" } } } } ]
          } } } },
          "404": { "description": "Watchlist not found (also returned for another account's watchlist — scoped by owner, never a 403).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      },
      "patch": {
        "operationId": "updateWatchlist",
        "summary": "Rename, reschedule, pause or resume a watchlist",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
            "is_active": { "type": "integer", "enum": [0, 1], "description": "Resuming (0 -> 1) re-checks the account's monitoring entitlement and is rejected with 402 if the vendor count now exceeds the plan quota." }
          }
        } } } },
        "responses": {
          "200": { "description": "Updated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Watchlist" } } } },
          "400": { "description": "Invalid frequency.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "402": { "description": "Resuming would exceed the account's monitoring plan quota.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      },
      "delete": {
        "operationId": "deleteWatchlist",
        "summary": "Delete a watchlist and its entries",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": {
          "200": { "description": "Deleted.", "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" } } } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}/entries": {
      "get": {
        "operationId": "listWatchlistEntries",
        "summary": "List entries in a watchlist",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 500, "maximum": 2000 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WatchlistEntry" } } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      },
      "post": {
        "operationId": "addWatchlistEntries",
        "summary": "Add vendor GSTINs to a watchlist",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "array", "items": { "type": "object", "required": ["gstin"], "properties": {
            "gstin": { "type": "string" }, "vendor_code": { "type": "string", "nullable": true }, "label": { "type": "string", "nullable": true }
          } } }
        } } },
        "responses": {
          "201": { "description": "Import attempted (partial success is possible — see `failed`/`errors`).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } },
          "400": { "description": "Body is not an array, more than 5000 rows, or the vendor quota would be exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}/entries/import": {
      "post": {
        "operationId": "importWatchlistEntriesCsv",
        "summary": "Bulk-import vendor GSTINs from CSV",
        "description": "Accepts a raw text/csv or text/plain body, or JSON `{ \"csv\": \"...\" }`. A partially valid file still imports its good rows; the response reports exactly which lines were rejected and why. Max 5,000 rows per request.",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": {
          "text/csv": { "schema": { "type": "string" } },
          "application/json": { "schema": { "type": "object", "properties": { "csv": { "type": "string" } } } }
        } },
        "responses": {
          "201": { "description": "Import attempted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } },
          "400": { "description": "Empty CSV, too many rows, or vendor quota exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}/entries/{entryId}": {
      "delete": {
        "operationId": "removeWatchlistEntry",
        "summary": "Remove one vendor GSTIN from a watchlist",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "entryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Removed.", "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" } } } } } },
          "404": { "description": "Watchlist or entry not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}/events": {
      "get": {
        "operationId": "listWatchlistEvents",
        "summary": "Change-event timeline for a watchlist",
        "description": "Vendor GSTIN change events (cancellation, suspension, name change, etc.) joined against this watchlist's entries, most recent first.",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "severity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["critical", "high", "medium", "info"] } },
          { "name": "since", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 200, "maximum": 2000 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ChangeEvent" } } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/watchlists/{id}/events.csv": {
      "get": {
        "operationId": "exportWatchlistEventsCsv",
        "summary": "Export the change-event timeline as CSV",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "severity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["critical", "high", "medium", "info"] } },
          { "name": "since", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": { "description": "CSV file, Content-Disposition attachment. Cells starting with =/+/-/@ are prefixed with an apostrophe to prevent formula injection when opened in Excel.", "content": { "text/csv": { "schema": { "type": "string" } } } },
          "404": { "description": "Watchlist not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "operationId": "listWebhooks",
        "summary": "List the caller's webhook endpoints",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "properties": { "endpoints": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookEndpoint" } }, "max_endpoints": { "type": "integer", "example": 3 } } } } } },
          "401": { "description": "Missing/invalid credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      },
      "post": {
        "operationId": "createWebhook",
        "summary": "Register a webhook endpoint",
        "description": "Up to 3 endpoints per account. The response's `secret` signs every delivery to this URL (X-Gstinapi-Signature: sha256=HMAC_SHA256(secret, `${timestamp}.${body}`)) — it is shown again on every subsequent read, since the owner needs it wherever their receiver runs. A URL that keeps failing gets disabled automatically rather than retried forever.",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri", "example": "https://your-endpoint.example.com/gstin-changes", "description": "Must be a publicly reachable https URL — localhost/private/internal hosts are rejected." } } } } }
        },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookEndpoint" } } } },
          "400": { "description": "Missing/invalid URL, or the account already has 3 endpoints.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } },
          "401": { "description": "Missing/invalid credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "delete": {
        "operationId": "deleteWebhook",
        "summary": "Remove a webhook endpoint",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": {
          "200": { "description": "Deleted.", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean", "example": true } } } } } },
          "404": { "description": "Webhook endpoint not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    },
    "/v1/webhooks/{id}/test": {
      "post": {
        "operationId": "testWebhook",
        "summary": "Send one signed sample event right now",
        "description": "Fires a single sample event at the endpoint for debugging a receiver. Always returns 200 with what actually happened — never recorded as a real delivery, never counts toward the auto-disable threshold.",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": {
          "200": { "description": "The test delivery's own result.", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "status": { "type": "integer", "nullable": true }, "error": { "type": "string", "nullable": true } } } } } },
          "404": { "description": "Webhook endpoint not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericError" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Generated in the dashboard after a free signup at https://www.gstinapi.in/register. Every account gets up to 75 free lookups that never expire. Accepted on every /v1 route, including /v1/watchlists/*."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Dashboard session token. Accepted ONLY on /v1/watchlists/* — the GSTIN endpoints require an API key."
      }
    },
    "schemas": {
      "GstinRecord": {
        "type": "object",
        "properties": {
          "gstin": { "type": "string", "example": "33AAACC1206D1ZN" },
          "legal_name": { "type": "string", "example": "CENTRAL WAREHOUSING CORPORATION" },
          "trade_name": { "type": "string", "example": "CENTRAL WAREHOUSING CORPORATION" },
          "status": { "type": "string", "example": "Active" },
          "taxpayer_type": { "type": "string", "example": "Regular" },
          "business_constitution": { "type": "string", "nullable": true, "example": "Proprietorship", "description": "Null on the basic lookup; populated when ?include=profile is passed." },
          "registration_date": { "type": "string", "format": "date", "example": "2017-07-01" },
          "cancellation_date": { "type": "string", "format": "date", "nullable": true },
          "state_code": { "type": "string", "example": "33" },
          "state_jurisdiction": { "type": "string", "nullable": true, "example": "Ghatak 68 (Surat)", "description": "Null on the basic lookup; populated when ?include=profile is passed." },
          "address": { "type": "string", "example": "No.4, North Avenue, Saidapet, Chennai", "description": "Principal place of business only. Additional registered addresses under the same GSTIN are not returned." },
          "city": { "type": "string", "nullable": true, "example": "Saidapet, Chennai", "description": "Locality of the principal place of business as the GST network records it, not a normalized city name. For a metro address it is often a locality within the city rather than the metro name alone, and can itself contain more than one comma-separated part." },
          "address_details": {
            "type": "object",
            "description": "The same principal place of business, split into the parts the GST network itself stores, for populating a structured address form. `address` remains the primary field and is unchanged. Every key is always present; a null part means the GST network holds no value for it — floor, landmark and district are frequently blank in the source data. district and city are null on the basic lookup and are filled when ?include=profile is passed (same credit cost). No latitude/longitude: the GST network does not publish coordinates for a registered address.",
            "properties": {
              "building_number": { "type": "string", "nullable": true, "example": "4" },
              "building_name": { "type": "string", "nullable": true, "example": "Thiruvalar Illam" },
              "floor": { "type": "string", "nullable": true, "example": "1ST FLOOR" },
              "street": { "type": "string", "nullable": true, "example": "North Avenue" },
              "locality": { "type": "string", "nullable": true, "example": "Srinagar Colony, Saidapet" },
              "district": { "type": "string", "nullable": true, "example": "Chennai", "description": "Null on the basic lookup; populated when ?include=profile is passed, when the GST network holds one." },
              "city": { "type": "string", "nullable": true, "example": "Chennai", "description": "Null on the basic lookup; populated when ?include=profile is passed. Unlike the top-level city field, this is only set when the source has a distinct city field rather than a locality." },
              "state": { "type": "string", "nullable": true, "example": "Tamil Nadu", "description": "Full state name, when the source supplies one. state_code is always available at the top level." },
              "landmark": { "type": "string", "nullable": true, "example": null },
              "pincode": { "type": "string", "nullable": true, "example": "600015" }
            }
          },
          "pincode": { "type": "string", "example": "600015" },
          "nature_of_business": { "type": "array", "items": { "type": "string" }, "nullable": true, "example": ["Supplier of Services"], "description": "Null on the basic lookup; populated when ?include=profile is passed." },
          "block_status": { "type": "string", "example": "Unblocked" },
          "einvoice_status": { "type": "string", "nullable": true, "enum": ["Yes", "No", null], "description": "Only present when ?include=profile is passed. Whether this taxpayer is enabled for e-invoicing." },
          "state_jurisdiction_code": { "type": "string", "nullable": true, "example": "GJ068", "description": "Only present when ?include=profile is passed." },
          "centre_jurisdiction": { "type": "string", "nullable": true, "example": "RANGE-IV", "description": "Only present when ?include=profile is passed." },
          "centre_jurisdiction_code": { "type": "string", "nullable": true, "example": "VC0104", "description": "Only present when ?include=profile is passed." },
          "last_updated": { "type": "string", "format": "date", "nullable": true, "description": "Only present when ?include=profile is passed. When the GST network last updated this registration record." },
          "additional_addresses": { "type": "array", "nullable": true, "description": "Only present when ?include=profile is passed. Additional places of business, when registered.", "items": { "type": "object", "properties": { "address": { "type": "string", "nullable": true }, "city": { "type": "string", "nullable": true }, "pincode": { "type": "string", "nullable": true }, "nature": { "type": "string", "nullable": true } } } }
        }
      },
      "LookupSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string", "example": "33AAACC1206D1ZN" },
          "data": { "$ref": "#/components/schemas/GstinRecord" },
          "profile_complete": { "type": "boolean", "description": "Only present when ?include=profile was requested. True when the profile source answered; false means the lookup succeeded but the profile keys are null." },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer", "example": 487 },
          "free_remaining": { "type": "integer", "example": 97 },
          "response_ms": { "type": "integer", "example": 312 }
        }
      },
      "ReturnEntry": {
        "type": "object",
        "properties": {
          "return_type": { "type": "string", "example": "GSTR-3B" },
          "return_period": { "type": "string", "example": "2025-06", "description": "YYYY-MM, the month the return covers." },
          "filing_status": { "type": "string", "example": "Filed" },
          "filing_date": { "type": "string", "format": "date", "nullable": true },
          "arn": { "type": "string", "nullable": true }
        }
      },
      "ReturnsSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string" },
          "fy": { "type": "string", "example": "2025-26" },
          "returns": { "type": "array", "items": { "$ref": "#/components/schemas/ReturnEntry" } },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" },
          "response_ms": { "type": "integer" }
        }
      },
      "ComplianceTypeSummary": {
        "type": "object",
        "description": "Summary for one return type (GSTR1, GSTR3B, ...) in the requested financial year.",
        "properties": {
          "filed_count": { "type": "integer", "example": 12 },
          "last_period": { "type": "string", "description": "Latest return period filed, YYYY-MM (by period, not by filing date).", "example": "2026-03" },
          "last_filing_date": { "type": "string", "nullable": true, "example": "2026-04-18" },
          "months_since_last_period": { "type": "integer", "nullable": true, "example": 6 },
          "avg_filing_lag_days": { "type": "integer", "nullable": true, "description": "Average days between the end of a period and its filing date; null when no filing date is known.", "example": 9 }
        }
      },
      "ComplianceSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string" },
          "fy": { "type": "string", "example": "2025-26" },
          "compliance": {
            "type": "object",
            "properties": {
              "total_filed": { "type": "integer", "example": 24 },
              "by_type": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/ComplianceTypeSummary" } }
            }
          },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" },
          "response_ms": { "type": "integer" }
        }
      },
      "FilingPreferenceEntry": {
        "type": "object",
        "properties": {
          "quarter": { "type": "string", "example": "Q1" },
          "preference": { "type": "string", "enum": ["Monthly", "Quarterly"] }
        }
      },
      "FilingPreferenceSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string" },
          "fy": { "type": "string", "example": "2025-26" },
          "filing_preference": { "type": "array", "items": { "$ref": "#/components/schemas/FilingPreferenceEntry" } },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" },
          "response_ms": { "type": "integer" }
        }
      },
      "CompleteProfile": {
        "type": "object",
        "properties": {
          "legal_name": { "type": "string", "nullable": true },
          "trade_name": { "type": "string", "nullable": true },
          "registration_date": { "type": "string", "format": "date", "nullable": true },
          "business_constitution": { "type": "string", "nullable": true },
          "status": { "type": "string", "nullable": true },
          "taxpayer_type": { "type": "string", "nullable": true },
          "address": { "type": "string", "nullable": true },
          "filing_frequency": { "type": "string", "enum": ["Monthly", "Quarterly"], "nullable": true, "description": "Best-effort — the latest quarter's QRMP preference, or null if it could not be fetched." },
          "gstr3b_filed_till": { "type": "string", "example": "2025-08", "nullable": true, "description": "Best-effort — YYYY-MM of the latest GSTR-3B filed, across the current and previous financial year." },
          "gstr1_filed_till": { "type": "string", "example": "2025-08", "nullable": true, "description": "Best-effort — YYYY-MM of the latest GSTR-1 filed, across the current and previous financial year." }
        }
      },
      "CompleteProfileSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "gstin": { "type": "string" },
          "profile": { "$ref": "#/components/schemas/CompleteProfile" },
          "partial": { "type": "boolean", "description": "True when a best-effort piece (business constitution, filing frequency, last filed GSTR-1 / GSTR-3B period) could not be fetched. The registration fields are always present." },
          "unavailable": { "type": "array", "items": { "type": "string", "enum": ["business_constitution", "filing_frequency", "gstr3b_filed_till", "gstr1_filed_till"] }, "description": "The profile fields that are null because their source failed, meaning unknown. A null field NOT listed here is null because the source answered with nothing, meaning none." },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" },
          "response_ms": { "type": "integer" }
        }
      },
      "UsageStats": {
        "type": "object",
        "description": "Counts across all of the account’s API calls today.",
        "properties": {
          "total_calls": { "type": "integer", "example": 42 },
          "success": { "type": "integer", "example": 40 },
          "errors": { "type": "integer", "example": 2 },
          "credits_used": { "type": "integer", "example": 40 }
        }
      },
      "HsnCode": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "01011010" },
          "kind": { "type": "string", "enum": ["hsn", "sac"], "description": "hsn = goods, sac = services." },
          "description": { "type": "string", "description": "The GST portal's own text for this code, whitespace-collapsed but otherwise unedited." },
          "digits": { "type": "integer", "example": 8, "description": "Length of the code — 2 chapter, 4 heading, 6 subheading, 8 tariff item." }
        }
      },
      "HsnSource": {
        "type": "object",
        "description": "Provenance of the local master, returned on every HSN response.",
        "properties": {
          "name": { "type": "string", "example": "GST portal HSN/SAC master" },
          "url": { "type": "string", "example": "https://tutorial.gst.gov.in/downloads/HSN_SAC.xlsx" },
          "refreshed_at": { "type": "string", "nullable": true, "example": "2026-08-19 05:04:31" },
          "codes": { "type": "integer", "example": 22614 }
        }
      },
      "HsnLookupSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "string", "example": "01011010" },
          "kind": { "type": "string", "enum": ["hsn", "sac"] },
          "description": { "type": "string" },
          "digits": { "type": "integer", "example": 8 },
          "hierarchy": { "type": "array", "description": "Broader codes containing this one, shortest first. Empty for a 2-digit chapter.", "items": { "$ref": "#/components/schemas/HsnCode" } },
          "source": { "$ref": "#/components/schemas/HsnSource" },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer", "example": 486 },
          "free_remaining": { "type": "integer", "example": 96 },
          "response_ms": { "type": "integer", "example": 12 }
        }
      },
      "HsnSearchSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "query": { "type": "object", "properties": { "q": { "type": "string" }, "kind": { "type": "string", "nullable": true }, "limit": { "type": "integer" } } },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/HsnCode" } },
          "source": { "$ref": "#/components/schemas/HsnSource" },
          "billed_to": { "type": "string", "enum": ["free", "paid"] },
          "credits_remaining": { "type": "integer", "example": 485 },
          "free_remaining": { "type": "integer", "example": 95 },
          "response_ms": { "type": "integer", "example": 9 }
        }
      },
      "PanVerifySuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "pan": { "type": "string", "example": "AAPFU0939F" },
          "verified": { "type": "boolean" },
          "level": { "type": "string", "enum": ["basic", "verified", "details"] },
          "name": { "type": ["string", "null"], "description": "Registered holder name; null when no record exists." },
          "dob": { "type": "string", "description": "Date of birth, DD/MM/YYYY. level verified only." },
          "category": { "type": "string", "description": "Holder category. level verified only." },
          "aadhaar_linked": { "type": ["boolean", "null"], "description": "Whether an Aadhaar is linked to the PAN. level verified only." },
          "details": { "type": "object", "description": "Extra profile fields (address, contact and so on) as the source returns them. level details only." },
          "name_match": { "type": "object", "description": "Present only when `name` was sent and the PAN was found.", "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "matched": { "type": "boolean" } } },
          "status": { "type": "string", "description": "PAN status, for example Active. level basic only." },
          "note": { "type": ["string", "null"] },
          "test": { "type": "boolean", "description": "Present and true only for the test PAN." },
          "credits_charged": { "type": "integer" },
          "billed_to": { "type": "string", "enum": ["paid", "free"] },
          "credits_remaining": { "type": "integer" }
        }
      },
      "PanGstinsResult": {
        "type": "object",
        "properties": {
          "gstin": { "type": "string", "example": "24AAPFU0939F1ZV" },
          "state_code": { "type": "string", "example": "24" },
          "data": { "$ref": "#/components/schemas/GstinRecord" }
        }
      },
      "PanGstinsSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "pan": { "type": "string", "example": "AAPFU0939F" },
          "checked": { "type": "integer", "example": 36, "description": "Number of state codes checked — one possible GSTIN per state." },
          "found": { "type": "integer", "example": 1 },
          "active": { "type": "integer", "example": 1, "description": "Of the found GSTINs, how many currently show status Active." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/PanGstinsResult" } },
          "incomplete": { "type": "boolean", "description": "Present only when at least one state's check failed to reach the provider while the rest of the scan succeeded." },
          "unavailable_states": { "type": "array", "items": { "type": "string" }, "description": "Present only alongside incomplete:true." },
          "billed": { "type": "boolean" },
          "pan_credits_remaining": { "type": "integer", "example": 24 },
          "response_ms": { "type": "integer" }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "url": { "type": "string", "format": "uri" },
          "secret": { "type": "string", "example": "whsec_3f1a9c...", "description": "Signs every delivery to this endpoint. Shown on every read, not just at creation — the owner needs it wherever their receiver runs." },
          "is_active": { "type": "integer", "enum": [0, 1] },
          "disabled_reason": { "type": "string", "nullable": true },
          "failure_count": { "type": "integer" },
          "last_success_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_failure_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_error": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "GSTIN not found in GST database" }
        }
      },
      "GenericError": {
        "type": "object",
        "description": "The /v1/watchlists/* error shape — a bare { error } with no success field, distinct from the flat { success:false, error } shape every other /v1 route uses. entitlement is present only on a 402 from resuming a paused watchlist past the account's monitoring quota.",
        "properties": {
          "error": { "type": "string" },
          "entitlement": { "type": "object", "nullable": true }
        }
      },
      "Watchlist": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "name": { "type": "string" },
          "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
          "is_active": { "type": "integer", "enum": [0, 1] },
          "paused_reason": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "entry_count": { "type": "integer", "description": "Present on the list endpoint only." },
          "critical_30d": { "type": "integer", "description": "Present on the list endpoint only — count of critical-severity change events in the last 30 days across this watchlist's entries." }
        }
      },
      "WatchlistEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "watchlist_id": { "type": "integer" },
          "gstin": { "type": "string" },
          "vendor_code": { "type": "string", "nullable": true },
          "label": { "type": "string", "nullable": true },
          "next_check_at": { "type": "string", "format": "date-time" },
          "last_check_at": { "type": "string", "format": "date-time", "nullable": true },
          "is_active": { "type": "integer", "enum": [0, 1] },
          "status": { "type": "string", "nullable": true, "description": "From the most recent snapshot, if any." },
          "legal_name": { "type": "string", "nullable": true },
          "trade_name": { "type": "string", "nullable": true },
          "status_as_of": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "added": { "type": "integer" },
          "duplicates": { "type": "integer" },
          "failed": { "type": "integer" },
          "errors": { "type": "array", "items": { "type": "object", "properties": {
            "row": { "type": "integer" }, "gstin": { "type": "string", "nullable": true }, "error": { "type": "string" }
          } }, "description": "Capped at the first 100." }
        }
      },
      "ChangeEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "gstin": { "type": "string" },
          "event_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "info"] },
          "old_value": { "type": "string", "nullable": true },
          "new_value": { "type": "string", "nullable": true },
          "detected_at": { "type": "string", "format": "date-time" },
          "vendor_code": { "type": "string", "nullable": true },
          "label": { "type": "string", "nullable": true }
        }
      },
      "EwaybillRejected": {
        "type": "object",
        "description": "A genuine rejection from the filing system (bad payload, expired registration, wrong portal credentials) — distinct from a 502, which is a network/timeout failure talking to the filing system. Never charged.",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "Invalid HSN Code" },
          "error_code": { "type": "string", "nullable": true, "description": "The exact error code from the filing system, when one was returned." }
        }
      },
      "EwaybillGenerateRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "payload"],
        "properties": {
          "gstin": { "type": "string", "description": "Your GSTIN, with e-way bill API access already set up through a GSP (a one-time step outside this API)." },
          "gstin_username": { "type": "string", "description": "API username from that setup. Never stored — forwarded once per call." },
          "password": { "type": "string", "description": "API password from that setup. Never stored." },
          "payload": { "type": "object", "description": "One NIC e-way bill JSON payload (supplyType, docType, docNo, fromGstin, toGstin, itemList, etc.), in NIC's own field-name casing. Not validated or translated by this API — that is NIC's job." },
          "test_mode": { "type": "boolean", "default": false, "description": "Skip the credit check and the real government network call, and return a synthetic TEST-prefixed response instead. Never charged." }
        }
      },
      "EwaybillGenerateSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string", "example": "351000000123" },
          "ewaybill_date": { "type": "string", "example": "08/09/2026" },
          "valid_upto": { "type": "string", "example": "10/09/2026" },
          "doc_no": { "type": "string" },
          "distance_km": { "type": "string", "nullable": true },
          "already_existed": { "type": "boolean", "description": "true if this response came from retrying a docNo that was already filed, rather than a fresh filing." },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillLookupRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "doc_type", "doc_no"],
        "properties": {
          "gstin": { "type": "string", "description": "Same GSTIN as generate." },
          "gstin_username": { "type": "string", "description": "Same credentials as generate." },
          "password": { "type": "string" },
          "doc_type": { "type": "string", "description": "NIC document type exactly as submitted at generation (e.g. INV, CHL, BIL, BOE)." },
          "doc_no": { "type": "string", "description": "Document number exactly as submitted at generation." },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillLookupSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ewaybill_no": { "type": "string", "example": "351000000123" },
          "ewaybill_date": { "type": "string", "example": "08/09/2026" },
          "valid_upto": { "type": "string", "example": "10/09/2026" },
          "doc_no": { "type": "string" },
          "test_mode": { "type": "boolean", "description": "Present and true only when the request had test_mode: true." },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"] },
          "credits_remaining": { "type": "integer" },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillLookupMiss": {
        "type": "object",
        "description": "Two distinct 400 causes on POST /v1/ewaybill/lookup, both this shape but only one billed: missing required fields never reaches the government network and is free (billed_to/credits_remaining absent); a clean \u2018no matching document\u2019 answer (error_code 418) DID reach the government network and is billed the same as a match \u2014 unlike a rejection everywhere else in this API.",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "No e-way bill found for this document type and number." },
          "error_code": { "type": "string", "nullable": true, "example": "418" },
          "billed_to": { "type": "string", "enum": ["paid", "free", "test_mode"], "description": "Present only when this was a genuine \u2018no match\u2019 that reached the government network; absent on a missing-fields 400." },
          "credits_remaining": { "type": "integer", "description": "Present only when this was a genuine \u2018no match\u2019 that reached the government network; absent on a missing-fields 400." },
          "free_remaining": { "type": "integer" }
        }
      },
      "EwaybillConsolidatedRequest": {
        "type": "object",
        "required": ["gstin", "gstin_username", "password", "ewaybill_nos", "from_place", "from_state", "trans_mode"],
        "properties": {
          "gstin": { "type": "string", "description": "The GSTIN you act as, with e-way bill API access set up." },
          "gstin_username": { "type": "string", "description": "The e-way bill API username for that GSTIN. Never stored \u2014 forwarded once per call." },
          "password": { "type": "string", "description": "The matching API password. Never stored." },
          "ewaybill_nos": { "type": "array", "items": { "type": "string", "pattern": "^\\d{12}$" }, "minItems": 1, "description": "The 12-digit e-way bill numbers to combine. You must be the generator or assigned transporter of each, and each must be active." },
          "from_place": { "type": "string", "description": "Where the vehicle is now." },
          "from_state": { "type": "integer", "description": "NIC state code of that place." },
          "trans_mode": { "type": "string", "description": "1 Road, 2 Rail, 3 Air, 4 Ship." },
          "vehicle_no": { "type": "string", "description": "Vehicle number \u2014 for road." },
          "trans_doc_no": { "type": "string", "description": "Transport document number \u2014 for rail, air or ship." },
          "trans_doc_date": { "type": "string", "description": "Transport document date, dd/MM/yyyy." },
          "test_mode": { "type": "boolean", "default": false }
        }
      },
      "EwaybillConsolidatedSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
