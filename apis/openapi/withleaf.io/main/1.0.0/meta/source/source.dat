{
  "openapi": "3.0.3",
  "info": {
    "title": "Leaf Agriculture API",
    "description": "Leaf's API provides clean, standardized, and aggregated farm data from all major agricultural data sources. It covers field management, machine data operations, satellite imagery, weather data, irrigation, and integrations with major agriculture equipment providers.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.withleaf.io/docs/introduction"
  },
  "servers": [
    {
      "url": "https://api.withleaf.io",
      "description": "Leaf Agriculture Production API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/authenticate": {
      "post": {
        "operationId": "authenticate",
        "summary": "Authenticate and get access token",
        "description": "Authenticates a user and returns an access token for API calls.",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id_token": { "type": "string" },
                    "access_token": { "type": "string" },
                    "refresh_token": { "type": "string" },
                    "token_type": { "type": "string" },
                    "expires_in": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/usermanagement/api/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List all Leaf users",
        "description": "Returns a list of all Leaf users in the account.",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LeafUser" }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create a Leaf user",
        "description": "Creates a new Leaf user.",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LeafUserCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "User created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LeafUser" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/usermanagement/api/users/{leafUserId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get a Leaf user",
        "description": "Returns details of a specific Leaf user.",
        "tags": ["Users"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "User details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LeafUser" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "operationId": "updateUser",
        "summary": "Update a Leaf user",
        "description": "Updates an existing Leaf user.",
        "tags": ["Users"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LeafUserCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "User updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LeafUser" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteUser",
        "summary": "Delete a Leaf user",
        "description": "Deletes a specific Leaf user.",
        "tags": ["Users"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "User deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/fields/api/fields": {
      "get": {
        "operationId": "listFields",
        "summary": "List all fields",
        "description": "Returns all fields with optional filtering.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } },
          { "name": "leafUserId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "provider", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Field" }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/fields/api/users/{leafUserId}/fields": {
      "get": {
        "operationId": "listUserFields",
        "summary": "List fields for a user",
        "description": "Returns all fields belonging to a specific Leaf user.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of fields", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Field" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createField",
        "summary": "Create a field",
        "description": "Creates a new field for a specific Leaf user.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FieldCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Field created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Field" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/fields/api/users/{leafUserId}/fields/{fieldId}": {
      "get": {
        "operationId": "getField",
        "summary": "Get a specific field",
        "description": "Returns details of a specific field.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "fieldId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Field details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Field" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "patch": {
        "operationId": "updateField",
        "summary": "Update a field",
        "description": "Updates a specific field.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "fieldId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FieldCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Field updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Field" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteField",
        "summary": "Delete a field",
        "description": "Deletes a specific field.",
        "tags": ["Fields"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "fieldId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Field deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/fields/api/fields/query/intersects": {
      "post": {
        "operationId": "queryFieldsIntersects",
        "summary": "Query fields by spatial intersection",
        "description": "Returns fields that intersect with the provided GeoJSON geometry.",
        "tags": ["Fields"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeoJsonGeometry" }
            }
          }
        },
        "responses": {
          "200": { "description": "Matching fields", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Field" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/files": {
      "get": {
        "operationId": "listMachineFiles",
        "summary": "List machine files",
        "description": "Returns all machine data files with extensive filtering options.",
        "tags": ["Machine Files"],
        "parameters": [
          { "name": "leafUserId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "provider", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of machine files",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MachineFile" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/files/{fileId}/summary": {
      "get": {
        "operationId": "getMachineFileSummary",
        "summary": "Get machine file summary",
        "description": "Returns the summary of a specific machine data file.",
        "tags": ["Machine Files"],
        "parameters": [
          { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "File summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileSummary" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/operations": {
      "get": {
        "operationId": "listOperations",
        "summary": "List field operations",
        "description": "Returns all field operations with optional filtering.",
        "tags": ["Operations"],
        "parameters": [
          { "name": "leafUserId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "fieldId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "operationType", "in": "query", "required": false, "schema": { "type": "string", "enum": ["harvested", "planted", "applied", "tillage", "other"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of operations",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Operation" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/operations/{operationId}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Get a specific operation",
        "description": "Returns details of a specific field operation.",
        "tags": ["Operations"],
        "parameters": [
          { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Operation details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Operation" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/operations/{operationId}/summary": {
      "get": {
        "operationId": "getOperationSummary",
        "summary": "Get operation summary",
        "description": "Returns summary data for a specific operation.",
        "tags": ["Operations"],
        "parameters": [
          { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Operation summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationSummary" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/operations/api/operations/{operationId}/standardGeojson": {
      "get": {
        "operationId": "getOperationStandardGeojson",
        "summary": "Get operation standard GeoJSON",
        "description": "Returns standardized GeoJSON data for a specific operation.",
        "tags": ["Operations"],
        "parameters": [
          { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "GeoJSON data", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/satellite/api/fields": {
      "get": {
        "operationId": "listSatelliteFields",
        "summary": "List satellite monitoring fields",
        "description": "Returns all fields registered for satellite crop monitoring.",
        "tags": ["Satellite"],
        "responses": {
          "200": { "description": "List of satellite fields", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SatelliteField" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createSatelliteField",
        "summary": "Register a field for satellite monitoring",
        "description": "Registers a field for satellite imagery crop monitoring.",
        "tags": ["Satellite"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SatelliteFieldCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Field registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SatelliteField" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/satellite/api/fields/{externalId}": {
      "get": {
        "operationId": "getSatelliteField",
        "summary": "Get a satellite monitoring field",
        "description": "Returns details of a specific satellite monitoring field.",
        "tags": ["Satellite"],
        "parameters": [
          { "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Satellite field details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SatelliteField" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteSatelliteField",
        "summary": "Delete a satellite monitoring field",
        "description": "Removes a field from satellite monitoring.",
        "tags": ["Satellite"],
        "parameters": [
          { "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Field deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/satellite/api/fields/{externalId}/processes": {
      "get": {
        "operationId": "listSatelliteProcesses",
        "summary": "List satellite imagery processes",
        "description": "Returns satellite imagery processes for a specific field.",
        "tags": ["Satellite"],
        "parameters": [
          { "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of processes", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SatelliteProcess" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/weather/api/weather/forecast/daily/{lat},{lon}": {
      "get": {
        "operationId": "getWeatherForecastDaily",
        "summary": "Get daily weather forecast by coordinates",
        "description": "Returns daily weather forecast data for the specified coordinates.",
        "tags": ["Weather"],
        "parameters": [
          { "name": "lat", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } },
          { "name": "lon", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } }
        ],
        "responses": {
          "200": { "description": "Daily forecast data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherForecast" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/weather/api/weather/forecast/hourly/{lat},{lon}": {
      "get": {
        "operationId": "getWeatherForecastHourly",
        "summary": "Get hourly weather forecast by coordinates",
        "description": "Returns hourly weather forecast data for the specified coordinates.",
        "tags": ["Weather"],
        "parameters": [
          { "name": "lat", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } },
          { "name": "lon", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } }
        ],
        "responses": {
          "200": { "description": "Hourly forecast data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherForecast" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/weather/api/weather/historical/daily/{lat},{lon}": {
      "get": {
        "operationId": "getWeatherHistoricalDaily",
        "summary": "Get daily historical weather by coordinates",
        "description": "Returns daily historical weather data for the specified coordinates.",
        "tags": ["Weather"],
        "parameters": [
          { "name": "lat", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } },
          { "name": "lon", "in": "path", "required": true, "schema": { "type": "number", "format": "double" } }
        ],
        "responses": {
          "200": { "description": "Daily historical weather data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherForecast" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/alerts/api/alerts/webhooks": {
      "get": {
        "operationId": "listWebhooks",
        "summary": "List webhooks",
        "description": "Returns all registered webhook endpoints.",
        "tags": ["Alerts"],
        "responses": {
          "200": { "description": "List of webhooks", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Webhook" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createWebhook",
        "summary": "Create a webhook",
        "description": "Registers a new webhook endpoint for event notifications.",
        "tags": ["Alerts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Webhook" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/alerts/api/alerts/webhooks/{webhookId}": {
      "get": {
        "operationId": "getWebhook",
        "summary": "Get a specific webhook",
        "description": "Returns details of a specific webhook.",
        "tags": ["Alerts"],
        "parameters": [
          { "name": "webhookId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Webhook details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Webhook" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteWebhook",
        "summary": "Delete a webhook",
        "description": "Deletes a specific webhook.",
        "tags": ["Alerts"],
        "parameters": [
          { "name": "webhookId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Webhook deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/fields/api/growers": {
      "get": {
        "operationId": "listGrowers",
        "summary": "List growers",
        "description": "Returns all growers.",
        "tags": ["Growers"],
        "responses": {
          "200": { "description": "List of growers", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Grower" } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createGrower",
        "summary": "Create a grower",
        "description": "Creates a new grower.",
        "tags": ["Growers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GrowerCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Grower created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Grower" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/config/api/configs/{leafUserId}": {
      "get": {
        "operationId": "getUserConfiguration",
        "summary": "Get user configuration",
        "description": "Returns the configuration settings for a specific user.",
        "tags": ["Configuration"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "User configuration", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Configuration" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "patch": {
        "operationId": "updateUserConfiguration",
        "summary": "Update user configuration",
        "description": "Updates configuration settings for a specific user.",
        "tags": ["Configuration"],
        "parameters": [
          { "name": "leafUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Configuration" }
            }
          }
        },
        "responses": {
          "200": { "description": "Configuration updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Configuration" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/services/uploadservice/api/upload": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a machine data file",
        "description": "Uploads a machine data file for processing.",
        "tags": ["File Upload"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "leafUserId": { "type": "string", "format": "uuid" },
                  "provider": { "type": "string" }
                },
                "required": ["file", "leafUserId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "File uploaded", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" } } } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token obtained from the /api/authenticate endpoint."
      }
    },
    "schemas": {
      "LeafUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "LeafUserCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "Field": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "leafUserId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "boundary": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "providerFieldId": { "type": "string" },
          "providerFieldName": { "type": "string" },
          "providerName": { "type": "string" },
          "organizationId": { "type": "string" },
          "area": { "type": "object", "properties": { "value": { "type": "number" }, "unit": { "type": "string" } } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FieldCreate": {
        "type": "object",
        "required": ["boundary"],
        "properties": {
          "name": { "type": "string" },
          "boundary": { "$ref": "#/components/schemas/GeoJsonGeometry" }
        }
      },
      "GeoJsonGeometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Polygon", "MultiPolygon", "Point"] },
          "coordinates": { "type": "array", "items": {} }
        }
      },
      "MachineFile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "leafUserId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string" },
          "provider": { "type": "string" },
          "status": { "type": "string" },
          "operationType": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "FileSummary": {
        "type": "object",
        "properties": {
          "fileId": { "type": "string", "format": "uuid" },
          "totalArea": { "type": "number" },
          "totalDistance": { "type": "number" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "leafUserId": { "type": "string", "format": "uuid" },
          "fieldId": { "type": "string", "format": "uuid" },
          "operationType": { "type": "string", "enum": ["harvested", "planted", "applied", "tillage", "other"] },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" },
          "crop": { "type": "string" },
          "varieties": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "OperationSummary": {
        "type": "object",
        "properties": {
          "operationId": { "type": "string", "format": "uuid" },
          "totalArea": { "type": "number" },
          "totalDistance": { "type": "number" },
          "avgSpeed": { "type": "number" },
          "totalYield": { "type": "number" }
        }
      },
      "SatelliteField": {
        "type": "object",
        "properties": {
          "externalId": { "type": "string" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SatelliteFieldCreate": {
        "type": "object",
        "required": ["externalId", "geometry"],
        "properties": {
          "externalId": { "type": "string" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" }
        }
      },
      "SatelliteProcess": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "type": { "type": "string" },
          "provider": { "type": "string" },
          "status": { "type": "string" },
          "images": { "type": "array", "items": { "type": "object", "properties": { "url": { "type": "string" }, "type": { "type": "string" } } } }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "format": "date" },
                "temperatureMax": { "type": "number" },
                "temperatureMin": { "type": "number" },
                "humidity": { "type": "number" },
                "precipitation": { "type": "number" },
                "windSpeed": { "type": "number" }
              }
            }
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "secret": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WebhookCreate": {
        "type": "object",
        "required": ["name", "url", "events"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "secret": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Grower": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "leafUserId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "GrowerCreate": {
        "type": "object",
        "required": ["name", "leafUserId"],
        "properties": {
          "name": { "type": "string" },
          "leafUserId": { "type": "string", "format": "uuid" }
        }
      },
      "Configuration": {
        "type": "object",
        "properties": {
          "operationsImageCreation": { "type": "boolean" },
          "geoimagesResolution": { "type": "number" },
          "geoimagesShape": { "type": "string" },
          "geoimagesProjection": { "type": "string" },
          "geoimagesColorRamp": { "type": "object" },
          "fieldsAutoSync": { "type": "boolean" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "statusCode": { "type": "integer" }
        }
      }
    }
  }
}