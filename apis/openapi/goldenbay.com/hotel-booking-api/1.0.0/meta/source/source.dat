{
  "openapi": "3.0.0",
  "info": {
    "title": "Hotel Booking API",
    "version": "1.0.0",
    "description": "Complete hotel booking system with:\n- Verification code system for check-in\n- Email notifications after payment\n- Public review system (no authentication)\n- Admin front desk operations\n- Room inventory management\n- Payment processing\n",
    "contact": {
      "name": "API Support",
      "email": "api@goldenbay.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/none-9c5-8fd/hotel-booking-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.goldenbay.com/api",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for user authentication"
      },
      "adminAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for admin authentication"
      }
    },
    "schemas": {
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "booking_reference": {
            "type": "string",
            "example": "BK001234"
          },
          "verification_code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit code sent to guest via email after payment"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "guest_first_name": {
            "type": "string"
          },
          "guest_last_name": {
            "type": "string"
          },
          "guest_email": {
            "type": "string",
            "format": "email"
          },
          "guest_phone": {
            "type": "string"
          },
          "check_in_date": {
            "type": "string",
            "format": "date"
          },
          "check_out_date": {
            "type": "string",
            "format": "date"
          },
          "number_of_nights": {
            "type": "integer"
          },
          "number_of_guests": {
            "type": "integer"
          },
          "room_rate": {
            "type": "number",
            "format": "decimal"
          },
          "subtotal": {
            "type": "number",
            "format": "decimal"
          },
          "tax_amount": {
            "type": "number",
            "format": "decimal"
          },
          "service_fee": {
            "type": "number",
            "format": "decimal"
          },
          "total_amount": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "checked_in",
              "checked_out",
              "cancelled",
              "no_show"
            ]
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "partially_paid",
              "refunded",
              "failed"
            ]
          },
          "special_requests": {
            "type": "string"
          },
          "arrival_time": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "checked_in_at": {
            "type": "string",
            "format": "date-time"
          },
          "checked_out_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateBooking": {
        "type": "object",
        "required": [
          "roomTypeId",
          "checkIn",
          "checkOut",
          "numberOfGuests",
          "guestInfo"
        ],
        "properties": {
          "roomTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2025-02-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2025-02-05"
          },
          "numberOfGuests": {
            "type": "integer",
            "minimum": 1
          },
          "numberOfAdults": {
            "type": "integer"
          },
          "numberOfChildren": {
            "type": "integer"
          },
          "guestInfo": {
            "type": "object",
            "required": [
              "firstName",
              "lastName",
              "email",
              "phone"
            ],
            "properties": {
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "specialRequests": {
            "type": "string"
          },
          "arrivalTime": {
            "type": "string",
            "example": "14:00"
          },
          "discountCode": {
            "type": "string"
          }
        }
      },
      "RoomType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "base_price": {
            "type": "number",
            "format": "decimal"
          },
          "max_occupancy": {
            "type": "integer"
          },
          "bed_type": {
            "type": "string"
          },
          "size_sqm": {
            "type": "number"
          },
          "view_type": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                }
              }
            }
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "room_number": {
            "type": "string"
          },
          "floor": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "occupied",
              "maintenance",
              "cleaning",
              "out_of_service"
            ]
          },
          "room_type": {
            "$ref": "#/components/schemas/RoomType"
          }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "guest_name": {
            "type": "string",
            "example": "John Doe"
          },
          "overall_rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "cleanliness_rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "service_rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "location_rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "value_rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "is_approved": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateReview": {
        "type": "object",
        "required": [
          "roomTypeId",
          "guestName",
          "overallRating",
          "cleanlinessRating",
          "serviceRating"
        ],
        "properties": {
          "roomTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "guestName": {
            "type": "string",
            "example": "John Doe"
          },
          "overallRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "cleanlinessRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "serviceRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "locationRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "valueRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "ReviewStats": {
        "type": "object",
        "properties": {
          "total_reviews": {
            "type": "integer"
          },
          "average_rating": {
            "type": "number"
          },
          "average_cleanliness": {
            "type": "number"
          },
          "average_service": {
            "type": "number"
          },
          "average_location": {
            "type": "number"
          },
          "average_value": {
            "type": "number"
          },
          "rating_distribution": {
            "type": "object",
            "properties": {
              "5": {
                "type": "integer"
              },
              "4": {
                "type": "integer"
              },
              "3": {
                "type": "integer"
              },
              "2": {
                "type": "integer"
              },
              "1": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "booking_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "NGN"
          },
          "payment_method": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "refunded"
            ]
          },
          "paid_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "loyalty_tier": {
            "type": "string",
            "enum": [
              "bronze",
              "silver",
              "gold",
              "platinum"
            ]
          },
          "loyalty_points": {
            "type": "integer"
          }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "manager",
              "staff"
            ]
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/admin/auth/register": {
      "post": {
        "tags": [
          "Admin - Authentication"
        ],
        "summary": "Register new admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "firstName",
                  "lastName"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "manager"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin registered successfully"
          }
        }
      }
    },
    "/admin/auth/login": {
      "post": {
        "tags": [
          "Admin - Authentication"
        ],
        "summary": "Admin login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "admin": {
                          "$ref": "#/components/schemas/Admin"
                        },
                        "accessToken": {
                          "type": "string"
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/me": {
      "get": {
        "tags": [
          "Admin - Authentication"
        ],
        "summary": "Get current admin",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Admin details"
          }
        }
      }
    },
    "/admin/verify-booking": {
      "post": {
        "tags": [
          "Admin - Front Desk"
        ],
        "summary": "Verify guest booking code",
        "description": "Admin verifies guest's booking reference and 6-digit verification code at check-in.\nGuest shows email with verification code.\n",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookingReference",
                  "verificationCode"
                ],
                "properties": {
                  "bookingReference": {
                    "type": "string",
                    "example": "BK001234"
                  },
                  "verificationCode": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "example": "Booking verified"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "booking": {
                          "$ref": "#/components/schemas/Booking"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification code"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/confirm-payment": {
      "post": {
        "tags": [
          "Admin - Front Desk"
        ],
        "summary": "Confirm payment and send email",
        "description": "Admin confirms guest payment (cash/card) at front desk.\nSystem automatically sends email with verification code to guest.\n",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookingId"
                ],
                "properties": {
                  "bookingId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "paymentMethod": {
                    "type": "string",
                    "enum": [
                      "cash",
                      "card",
                      "transfer"
                    ],
                    "default": "cash",
                    "example": "cash"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment confirmed, email sent to guest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "example": "Payment confirmed. Email sent to guest."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "booking": {
                          "$ref": "#/components/schemas/Booking"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/check-in": {
      "post": {
        "tags": [
          "Admin - Front Desk"
        ],
        "summary": "Check-in guest",
        "description": "Admin checks in guest after verifying code",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookingId"
                ],
                "properties": {
                  "bookingId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest checked in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/check-out": {
      "post": {
        "tags": [
          "Admin - Front Desk"
        ],
        "summary": "Check-out guest",
        "description": "Admin checks out guest",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookingId"
                ],
                "properties": {
                  "bookingId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest checked out successfully"
          }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "tags": [
          "Admin - Dashboard"
        ],
        "summary": "Get dashboard statistics",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "stats": {
                          "type": "object"
                        },
                        "recentBookings": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Booking"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/stats/bookings": {
      "get": {
        "tags": [
          "Admin - Dashboard"
        ],
        "summary": "Get booking statistics",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Booking statistics"
          }
        }
      }
    },
    "/admin/reports/revenue": {
      "get": {
        "tags": [
          "Admin - Reports"
        ],
        "summary": "Get revenue report",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revenue report"
          }
        }
      }
    },
    "/admin/reports/occupancy": {
      "get": {
        "tags": [
          "Admin - Reports"
        ],
        "summary": "Get occupancy report",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Occupancy report"
          }
        }
      }
    },
    "/admin/inventory": {
      "get": {
        "tags": [
          "Admin - Inventory"
        ],
        "summary": "Get room inventory",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "roomTypeId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory data"
          }
        }
      }
    },
    "/admin/inventory/availability": {
      "put": {
