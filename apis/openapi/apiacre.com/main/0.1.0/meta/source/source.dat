th":42,"title":"Address","description":"A 20-byte EVM address on Base mainnet"},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag resolved once and reused for every account read","default":"safe"}},"type":"object","required":["address"],"title":"BaseAccountStatusInput"},"BaseBlockInspectInput":{"properties":{"block_number":{"anyOf":[{"type":"integer","maximum":9007199254740991.0,"minimum":0.0},{"type":"null"}],"title":"Block Number","description":"Optional Base block number as a JSON-safe integer. When provided it takes precedence over block_tag.","examples":[34600000]},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag used only when block_number is omitted","default":"safe"}},"type":"object","title":"BaseBlockInspectInput"},"BaseContractInspectInput":{"properties":{"contract":{"type":"string","maxLength":42,"minLength":42,"title":"Contract","description":"The 20-byte Base mainnet contract address to inspect"},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag resolved once and reused for every inspection read","default":"safe"}},"type":"object","required":["contract"],"title":"BaseContractInspectInput"},"BaseContractReadInput":{"properties":{"contract":{"type":"string","maxLength":42,"minLength":42,"title":"Contract","description":"The 20-byte Base mainnet contract address to read"},"call_data":{"type":"string","maxLength":16386,"minLength":2,"title":"Call Data","description":"ABI-encoded eth_call data, including the function selector","examples":["0x313ce567"]},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag resolved once before executing the read","default":"safe"},"from_address":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"From Address","description":"Optional msg.sender context; no private key or transaction is used"},"gas_limit":{"type":"integer","maximum":5000000.0,"minimum":21000.0,"title":"Gas Limit","description":"Bounded execution allowance for the read-only call","default":2000000},"output_types":{"items":{"type":"string"},"type":"array","maxItems":16,"title":"Output Types","description":"Optional primitive ABI output types used to decode a successful result; arrays and tuples are intentionally excluded","examples":[["uint8"]]}},"type":"object","required":["contract","call_data"],"title":"BaseContractReadInput"},"BaseEventLogsInput":{"properties":{"contract":{"type":"string","maxLength":42,"minLength":42,"title":"Contract","description":"The 20-byte Base mainnet contract whose event logs are queried"},"topics":{"items":{"anyOf":[{"type":"string"},{"type":"null"}]},"type":"array","maxItems":4,"minItems":1,"title":"Topics","description":"One required event-signature topic followed by optional indexed topic values or null wildcards. Signature-only scans are limited to 100 resolved blocks; adding an indexed value permits up to 2,000.","examples":[["0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"],["0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef",null,"0x0000000000000000000000001111111111111111111111111111111111111111"]]},"lookback_blocks":{"type":"integer","maximum":2000.0,"minimum":1.0,"title":"Lookback Blocks","description":"Inclusive resolved Base blocks to scan; defaults to the 100-block signature-only ceiling and may be raised to 2,000 with an indexed topic value","default":100},"limit":{"type":"integer","maximum":100.0,"minimum":1.0,"title":"Limit","description":"Maximum newest-first validated logs returned","default":50},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag resolved once as the inclusive upper bound","default":"safe"}},"type":"object","required":["contract","topics"],"title":"BaseEventLogsInput"},"BaseGasEstimateInput":{"properties":{"from_address":{"type":"string","maxLength":42,"minLength":42,"title":"From Address","description":"The 20-byte Base mainnet sender context; no private key is used"},"to":{"type":"string","maxLength":42,"minLength":42,"title":"To","description":"The 20-byte Base mainnet transaction destination"},"value_wei":{"type":"string","maxLength":78,"minLength":1,"title":"Value Wei","description":"Unsigned ETH value in wei as a canonical decimal string","default":"0","examples":["0"]},"call_data":{"type":"string","maxLength":32770,"minLength":2,"title":"Call Data","description":"Optional even-length hexadecimal transaction calldata","default":"0x","examples":["0x313ce567"]},"block_tag":{"type":"string","enum":["latest","safe","finalized"],"title":"Block Tag","description":"Base block tag resolved once before estimation","default":"safe"},"buffer_percent":{"type":"integer","maximum":50.0,"minimum":0.0,"title":"Buffer Percent","description":"Bounded percentage added to the RPC estimate for a suggested gas limit","default":20}},"type":"object","required":["from_address","to"],"title":"BaseGasEstimateInput"},"BaseNetworkStatusInput":{"properties":{"fee_history_blocks":{"type":"integer","maximum":20.0,"minimum":1.0,"title":"Fee History Blocks","description":"Number of recent Base blocks included in the EIP-1559 fee history","default":5},"reward_percentiles":{"items":{"type":"number"},"type":"array","maxItems":5,"minItems":1,"title":"Reward Percentiles","description":"Strictly increasing gas-tip percentiles requested from eth_feeHistory"}},"type":"object","title":"BaseNetworkStatusInput"},"BaseTransactionInspectInput":{"properties":{"transaction_hash":{"type":"string","title":"Transaction Hash","description":"A 32-byte Base mainnet transaction hash","examples":["0x1212121212121212121212121212121212121212121212121212121212121212"]}},"type":"object","required":["transaction_hash"],"title":"BaseTransactionInspectInput"},"BaseUsdcTransfersInput":{"properties":{"address":{"type":