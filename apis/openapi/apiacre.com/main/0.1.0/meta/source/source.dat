{"openapi":"3.1.0","info":{"title":"API Acre","summary":"74 pay-per-call services for autonomous agents","description":"Machine-discoverable web, document, data, developer, research, and EVM utilities. Every paid POST returns structured JSON and uses x402 v2 exact USDC settlement on Base and Solana. Start with GET /.well-known/x402 or GET /catalog.","contact":{"name":"API Acre","email":"hello@apiacre.com"},"license":{"name":"Proprietary"},"version":"0.1.0","x-guidance":"Start with GET /recommend?task=<intent>&max_price=<USDC> to get compact rankings without loading every schema; follow service.purchase.fullHandoffUrl for one chosen service, or use GET /catalog for every complete contract. Intent map: public-site research -> web metadata, audits, or business due diligence; supplied documents and data -> extract, redact, profile, or schema tools; code and API changes -> code-change review, OpenAPI audit, test generation, or x402 preflight; official public records -> SEC, OFAC, GLEIF, VIN, World Bank, US address geocoding, or US weather; Base read-only evidence -> address, account, transaction, or contract tools. Paid POST routes use x402 v2 exact USDC on Base: inspect PAYMENT-REQUIRED, obtain explicit buyer authorization, then retry with PAYMENT-SIGNATURE. Samples are free over HTTP and the MCP resource template at /samples/<service-slug>?format=json. One bounded live developer.code-metrics trial is free at /trials/developer.code-metrics; it rejects payment headers; no endpoint signs or broadcasts transactions.","x-apiacre-custom-work":{"requestUrl":"https://apiacre.com/request-api","proofUrl":"https://apiacre.com/request-api#proof-case","contactEmail":"hello@apiacre.com","scope":["custom_api","evidence_audit","volume_integration","structured_json_workflow"],"requestCreatesOrder":false,"requestCreatesCharge":false,"marketplaceOffers":[],"deliveryProof":{"platform":"Taskmarket","completedOn":"2026-08-14","taskId":"0xe9fb8fe4e6f83b54d4850efd1c5b6aef6d1bbd7f9f91921d4329f404e64c5682","taskUrl":"https://taskmarket.dev/tasks/0xe9fb8fe4e6f83b54d4850efd1c5b6aef6d1bbd7f9f91921d4329f404e64c5682","result":{"role":"primary","rank":1,"requesterRating":99},"workerPayment":{"amount":"4.625","currency":"USDC","network":"eip155:8453","transactionHash":"0xe580591abe9df357abf20f1d45b3ad26381583719a3bcac7d9297fb9c2e81e7d","transactionUrl":"https://basescan.org/tx/0xe580591abe9df357abf20f1d45b3ad26381583719a3bcac7d9297fb9c2e81e7d"},"claimBoundary":"One completed commission evidences delivery, not future outcomes."}},"x-apiacre-customer-evidence":{"evidenceType":"minimum-independent-production-settlement-aggregate","observedThrough":"2026-09-01T11:24:57.584032Z","settlementNetwork":"eip155:8453","minimumIndependentSettlements":34,"minimumUniquePayers":17,"minimumRevenueUsdc":"0.331","operatorValidationExcluded":true,"buyerDataPublished":false,"settlementIdentifiersPublished":false,"humanReadableUrl":"https://apiacre.com/use-cases#customer-evidenced","claimBoundary":"Each listed service had at least one independently attributed production settlement by observedThrough. Totals are minimum aggregate evidence, exclude operator validation, and do not establish per-service unique buyers, endorsement, repeat demand, a forecast, or a guarantee.","services":[{"slug":"web.metadata","title":"Webpage metadata extraction","method":"POST","endpointUrl":"https://apiacre.com/v1/web/metadata","priceUsdc":"0.002","serviceDocumentationUrl":"https://apiacre.com/services/web.metadata","sampleUrl":"https://apiacre.com/samples/web.metadata","minimumIndependentSettlements":1},{"slug":"crypto.base-network-status","title":"Base network and fee status","method":"POST","endpointUrl":"https://apiacre.com/v1/crypto/base-network-status","priceUsdc":"0.001","serviceDocumentationUrl":"https://apiacre.com/services/crypto.base-network-status","sampleUrl":"https://apiacre.com/samples/crypto.base-network-status","minimumIndependentSettlements":1},{"slug":"data.schema","title":"JSON Sche