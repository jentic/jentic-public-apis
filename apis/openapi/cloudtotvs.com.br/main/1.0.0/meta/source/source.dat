{
  "openapi": "3.0.0",
  "info": {
    "title": "API Sbacem - Protheus",
    "description": "Documentação gerada a partir de coleção Postman para integração com o sistema TOTVS Protheus.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MARCELOAMARALSILVA_1/api-sbacem-protheus/1.0.0"
  },
  "servers": [
    {
      "url": "https://socbras134212.protheus.cloudtotvs.com.br:1107/rest",
      "description": "Servidor Principal (Porta 1107)"
    },
    {
      "url": "https://socbras134211.protheus.cloudtotvs.com.br:2256/rest",
      "description": "Servidor Secundário (Porta 2256)"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/sblogin": {
      "post": {
        "summary": "Login de Usuário",
        "tags": [
          "Autenticação"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "CPFCNPJ": {
                    "type": "string",
                    "example": "05629797948"
                  },
                  "SENHA": {
                    "type": "string",
                    "example": "239997"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso na autenticação"
          }
        }
      }
    },
    "/sbnewextr": {
      "post": {
        "summary": "Gerar Novo Extrato",
        "tags": [
          "Relatórios"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "CPFCNPJ": {
                    "type": "string",
                    "example": "60622366319"
                  },
                  "COMPET_INI": {
                    "type": "string",
                    "example": "202501"
                  },
                  "COMPET_FIM": {
                    "type": "string",
                    "example": "202512"
                  },
                  "ORIGEM": {
                    "type": "string",
                    "example": "ADM"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extrato processado"
          }
        }
      }
    },
    "/sbDADOS": {
      "post": {
        "summary": "Consulta de Dados Cadastrais",
        "tags": [
          "Usuários"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "COMSENHA": {
                    "type": "string",
                    "example": "S"
                  },
                  "CPFCNPJ": {
                    "type": "string",
                    "example": "05696100600"
                  },
                  "SENHA": {
                    "type": "string",
                    "example": "190305"
                  },
                  "CODIGO": {
                    "type": "string",
                    "example": "0000000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dados retornados com sucesso"
          }
        }
      }
    },
    "/sbassfil": {
      "post": {
        "summary": "Filtro de Associados",
        "tags": [
          "Filtros"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "FILTRO": {
                    "type": "string",
                    "example": "55302983000102"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filtro aplicado"
          }
        }
      }
    },
    "/apigetgen": {
      "post": {
        "summary": "Execução de Query Genérica (BI)",
        "tags": [
          "BI / SQL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Empresa": {
                    "type": "string",
                    "example": "01"
                  },
                  "Filial": {
                    "type": "string",
                    "example": "0101"
                  },
                  "Query": {
                    "type": "string",
                    "example": "SELECT A1_COD,A1_NOME FROM SA1010 SA1 WHERE SA1.D_E_L_E_T_ = ' '"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da query retornado"
          }
        }
      }
    }
  }
}
