{
  "openapi": "3.0.0",
  "info": {
    "title": "Jiadi Property API",
    "description": "Backend API for Jiadi (Property) personal asset management application.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/lamodaExt/Jiadi/1.0.0"
  },
  "servers": [
    {
      "url": "https://apil.qmlm.work/jiadi",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "mainCurrency": {
            "type": "string"
          },
          "monthlySnapshotDay": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer"
          }
        }
      },
      "UpdateUserInput": {
        "type": "object",
        "properties": {
          "mainCurrency": {
            "type": "string"
          },
          "monthlySnapshotDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        }
      },
      "ChangePasswordInput": {
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "properties": {
          "oldPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "asset",
              "liability"
            ]
          },
          "category": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "deletedAt": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "SnapshotCommit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "Standard",
              "Milestone"
            ],
            "description": "Standard (Manual) or Milestone (Scheduled)"
          },
          "note": {
            "type": "string"
          },
          "totalNetWorth": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          }
        }
      },
      "SnapshotDetailItem": {
        "type": "object",
        "properties": {
          "accountName": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          }
        }
      },
      "WorkspaceItem": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer"
          }
        }
      },
      "WorkspaceResponse": {
        "type": "object",
        "properties": {
          "totalAssets": {
            "type": "string"
          },
          "totalLiabilities": {
            "type": "string"
          },
          "netWorth": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceItem"
            }
          }
        }
      },
      "AssetRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "amount": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "occurredAt": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer"
          }
        }
      },
      "DiffItem": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "accountName": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "fromBalance": {
            "type": "string"
          },
          "toBalance": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          }
        }
      },
      "DiffResponse": {
        "type": "object",
        "properties": {
          "fromId": {
            "type": "integer"
          },
          "toId": {
            "type": "integer"
          },
          "totalAssetDiff": {
            "type": "string"
          },
          "totalLiabDiff": {
            "type": "string"
          },
          "netWorthDiff": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffItem"
            }
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetRecord"
            }
          }
        }
      },
      "NetWorthPoint": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer"
          },
          "netWorth": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "summary": "Register a new user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/user": {
      "get": {
        "summary": "Get current user info",
        "responses": {
          "200": {
            "description": "User info retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update user info/settings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/user/password": {
      "put": {
        "summary": "Change user password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed successfully"
          },
          "401": {
            "description": "Incorrect old password"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/ping": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "Get all accounts",
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "asset",
                      "liability"
                    ]
                  },
                  "category": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}": {
      "put": {
        "summary": "Update an account",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "asset",
                      "liability"
                    ]
                  },
                  "category": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an account (soft delete & remove from workspace)",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account deleted"
          }
        }
      }
    },
    "/api/workspace": {
      "get": {
        "summary": "Get workspace (balances & net worth)",
        "responses": {
          "200": {
            "description": "Workspace data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/balance/{id}": {
      "post": {
        "summary": "Update account balance in workspace",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "balance"
                ],
                "properties": {
                  "balance": {
                    "type": "string",
                    "description": "Decimal string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Balance updated"
          }
        }
      }
    },
    "/api/snapshots": {
      "get": {
        "summary": "Get snapshot history",
        "responses": {
          "200": {
            "description": "List of snapshots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SnapshotCommit"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new snapshot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Snapshot created"
          }
        }
      }
    },
    "/api/snapshots/amend": {
      "put": {
        "summary": "Amend the latest snapshot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snapshot amended"
          }
        }
      }
    },
    "/api/snapshots/diff": {
      "get": {
        "summary": "Get difference between two snapshots",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "To snapshot ID. If omitted or 0, compares against current Workspace."
          }
        ],
        "responses": {
          "200": {
            "description": "Diff data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiffResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/snapshots/{id}": {
      "get": {
        "summary": "Get snapshot details (account balances)",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "snapshot": {
                      "$ref": "#/components/schemas/SnapshotCommit"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SnapshotDetailItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a snapshot",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot deleted"
          }
        }
      }
    },
    "/api/records": {
      "get": {
        "summary": "Get asset records (transactions)",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "schema": {
              "type": "integer"
            },
            "description": "Start timestamp"
          },
          {
            "in": "query",
            "name": "end",
            "schema": {
              "type": "integer"
            },
            "description": "End timestamp"
          }
        ],
        "responses": {
          "200": {
            "description": "List of records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetRecord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new asset record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount",
                  "description",
                  "occurredAt"
                ],
                "properties": {
                  "amount": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "occurredAt": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetRecord"
                }
              }
            }
          }
        }
      }
    },
    "/api/records/{id}": {
      "put": {
        "summary": "Update an asset record",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "occurredAt": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetRecord"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an asset record",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record deleted"
          }
        }
      }
    },
    "/api/reports/net-worth-history": {
      "get": {
        "summary": "Get net worth history for chart",
        "responses": {
          "200": {
            "description": "History points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NetWorthPoint"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
