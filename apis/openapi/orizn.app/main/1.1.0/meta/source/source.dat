              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AffiliateRegisterResponse"
                }
              }
            }
          },
          "201": {
            "description": "Affiliate created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AffiliateRegisterResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
