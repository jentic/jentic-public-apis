    "/api/v1/visa/register": {
      "post": {
        "tags": [
          "Account & billing"
        ],
        "operationId": "signup",
        "summary": "Sign up (get a free API key)",
        "description": "Self-serve signup. Returns a free-plan API key (100 req/month).\nIdempotent on email — re-registering returns the existing key.\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ada Lovelace"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "ada@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key created or returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api_key": {
                      "type": "string",
                      "example": "orizn_visa_a06113a2e4f0..."
                    },
                    "plan": {
                      "type": "string",
                      "example": "free"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
