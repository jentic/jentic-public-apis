    "/v1/spray": {
      "post": {
        "tags": [
          "Spraying"
        ],
        "summary": "Spray money",
        "description": "Spray money at an event",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "eventId",
                  "amount"
                ],
                "properties": {
                  "eventId": {
                    "type": "string",
                    "example": "6983681e09461b662a74f929"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 100,
                    "example": 5000
                  },
                  "isAnonymous": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Money sprayed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "transaction": {
                          "$ref": "#/components/schemas/Transaction"
                        },
                        "newBalance": {
                          "type": "number",
                          "example": 20000
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Insufficient balance"
          }
        }
      }
    },
