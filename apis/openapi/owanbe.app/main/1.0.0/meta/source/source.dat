        "responses": {
          "200": {
            "description": "User analytics retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "totalSpent": {
                          "type": "number"
                        },
                        "totalReceived": {
                          "type": "number"
                        },
                        "eventsJoined": {
                          "type": "integer"
                        },
                        "eventsHosted": {
                          "type": "integer"
                        },
                        "topEvent": {
                          "type": "object",
                          "properties": {
                            "eventId": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "amountSpent": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/rank": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get my global rank",
        "description": "Get current user's position in global leaderboard",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
