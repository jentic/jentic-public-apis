                "weekly"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User rank retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "rank": {
                          "type": "integer",
                          "example": 42
                        },
                        "totalSpent": {
                          "type": "number",
                          "example": 45000
                        },
                        "period": {
                          "type": "string",
                          "example": "all-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/user/{userId}": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get user analytics",
        "description": "Get specific user's analytics",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all-time",
                "monthly",
                "weekly"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User analytics retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "userId": {
                          "type": "string"
                        },
                        "fullName": {
                          "type": "string"
                        },
                        "totalSpent": {
                          "type": "number"
                        },
                        "rank": {
                          "type": "integer"
                        },
                        "eventsJoined": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/event/{eventId}": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get event statistics",
        "description": "Get comprehensive statistics for an event",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event statistics retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "eventId": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "totalSprayed": {
                          "type": "number",
                          "example": 156000
                        },
                        "participantsCount": {
                          "type": "integer",
                          "example": 24
                        },
                        "topSprayers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "userId": {
                                "type": "string"
                              },
                              "fullName": {
                                "type": "string"
                              },
                              "amount": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/platform": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get platform statistics",
        "description": "Get platform-wide statistics (Admin only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Platform statistics retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "totalUsers": {
                          "type": "integer",
                          "example": 1523
                        },
                        "totalEvents": {
                          "type": "integer",
                          "example": 342
                        },
                        "totalMoneySpread": {
                          "type": "number",
                          "example": 15420000
                        },
                        "activeEvents": {
                          "type": "integer",
                          "example": 12
                        },
                        "transactionsCount": {
                          "type": "integer",
                          "example": 8976
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhook/paystack": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Paystack webhook",
        "description": "Handle Paystack payment notifications",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "example": "charge.success"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "reference": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Webhook processed successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from login/register. Format: Bearer <token>"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6983680409461b662a74f920"
          },
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "example": "08012345678"
          },
          "avatar": {
            "type": "string",
            "example": "👨‍💼"
          },
          "bio": {
            "type": "string",
            "example": "Party lover and top sprayer!"
          },
          "walletBalance": {
            "type": "number",
            "example": 25000
          },
          "referralCode": {
            "type": "string",
            "example": "JOHN123"
          },
          "stats": {
            "type": "object",
            "properties": {
              "totalSpent": {
                "type": "number",
                "example": 45000
              },
              "totalReceived": {
                "type": "number",
                "example": 12000
              },
              "eventsJoined": {
                "type": "integer",
                "example": 12
              },
              "eventsHosted": {
                "type": "integer",
                "example": 3
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-02-05T12:32:26.000Z"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6983681e09461b662a74f929"
          },
          "name": {
            "type": "string",
            "example": "Birthday Bash 2026"
          },
          "code": {
            "type": "string",
            "example": "PARTY6"
          },
          "hostId": {
            "type": "string",
            "example": "6983680409461b662a74f920"
          },
          "hostName": {
            "type": "string",
            "example": "John Doe"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "time": {
            "type": "string",
            "example": "18:00"
          },
          "location": {
            "type": "string",
            "example": "Victoria Island, Lagos"
          },
          "isPrivate": {
            "type": "boolean",
            "example": false
          },
          "realMoney": {
            "type": "boolean",
            "example": false
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "live",
              "ended",
              "cancelled"
            ],
            "example": "live"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "fullName": {
                  "type": "string"
                },
                "avatar": {
                  "type": "string"
                },
                "joinedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "totalSpent": {
                  "type": "number"
                }
              }
            }
          },
          "participantsCount": {
            "type": "integer",
            "example": 24
          },
          "totalSprayed": {
            "type": "number",
            "example": 156000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "698368a009461b662a74f945"
          },
          "userId": {
            "type": "string",
            "example": "6983680409461b662a74f920"
          },
          "type": {
            "type": "string",
            "enum": [
              "spray",
              "topup",
              "withdrawal",
              "refund",
              "referral_bonus"
            ],
            "example": "spray"
          },
          "amount": {
            "type": "number",
            "example": -5000
          },
          "eventId": {
            "type": "string",
            "example": "6983681e09461b662a74f929"
          },
          "eventName": {
            "type": "string",
            "example": "Birthday Bash 2026"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "refunded"
            ],
            "example": "completed"
          },
          "balanceBefore": {
            "type": "number",
            "example": 25000
          },
          "balanceAfter": {
            "type": "number",
            "example": 20000
          },
          "reference": {
            "type": "string",
            "example": "TXN_1738748746_abc123"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "isAnonymous": {
                "type": "boolean",
                "example": false
              },
              "paymentMethod": {
                "type": "string",
                "example": "paystack"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-02-05T13:15:46.000Z"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Login successful"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              },
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2OTgzNjgwNDA5NDYxYjY2MmE3NGY5MjAiLCJpYXQiOjE3Mzg3NDg3NDYsImV4cCI6MTczOTM1MzU0Nn0.0K2b_mNPK_H0ZuOdMjEVaNlMnAJYFfZGfBa_-8JtJII"
              },
              "refreshToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Error message"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "email"
                },
                "message": {
                  "type": "string",
                  "example": "Please enter a valid email address"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "message": "Invalid or expired token. Please login again."
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "message": "Validation failed",
              "errors": [
                {
                  "field": "email",
                  "message": "Please enter a valid email address"
                },
                {
                  "field": "password",
                  "message": "Password must be at least 8 characters"
                }
              ]
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "message": "Resource not found"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
