culate Not-Self Deck","description":"Calculates the Not-Self Deck using birth activations.","operationId":"not_self_deck_v2_not_self_deck_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V2BodygraphRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotSelfDeckResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-requiredTier":1,"x-requiredPlan":"Basic","x-creditCost":0.5}},"/v2/composite":{"post":{"tags":["composite-v2"],"summary":"Calculate Composite Compatibility Chart","description":"Calculates a two-person composite compatibility chart from birth datetimes. Chiron is retained in raw positions but does not activate Gates, Channels, Centers, or relationship channel classifications.","operationId":"composite_chart_v2_composite_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V2CompositeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompositeResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-requiredTier":2,"x-requiredPlan":"Standard","x-creditCost":2.0}},"/v2/dreamrave":{"post":{"tags":["dreamrave-v2"],"summary":"Calculate DreamRave Chart","description":"Calculates a DreamRave sleep chart using a birth datetime.","operationId":"dreamrave_v2_dreamrave_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V2DreamRaveRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DreamRaveResponse"}}}},"422":{"description":"Validation Error","content":{"a