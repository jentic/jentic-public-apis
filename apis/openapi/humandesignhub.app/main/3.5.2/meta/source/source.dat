ates"},"birth_gate_and_line":{"$ref":"#/components/schemas/PersonalityDesignGateAndLine"},"base_transit":{"$ref":"#/components/schemas/TransitResponse"},"events_by_body":{"additionalProperties":{"items":{"$ref":"#/components/schemas/TransitOverlayWindowEventItem"},"type":"array"},"type":"object","title":"Events By Body"}},"type":"object","required":["birth_datetime","base_datetime","window_days","range","birth_gates","birth_gate_and_line","base_transit","events_by_body"],"title":"TransitOverlayWindowResponse","description":"Response for POST /v1/transit-overlay-window"},"TimezoneResolveRequest":{"properties":{"timezone":{"type":"string","title":"Timezone","description":"IANA timezone ID (예: Asia/Seoul)"},"date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Date","description":"로컬 날짜 YYYY-MM-DD"},"time":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Time","description":"로컬 시간 HH:MM 또는 HH:MM:SS"},"local_datetime":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Local Datetime","description":"오프셋 없는 로컬 ISO datetime (예: 1990-05-12T14:30:00)"},"disambiguation":{"type":"string","enum":["earlier","later","reject"],"title":"Disambiguation","description":"DST fall-back처럼 같은 local time이 두 번 존재할 때 선택할 offset","default":"earlier"}},"type":"object","required":["timezone"],"title":"TimezoneResolveRequest"},"TimezoneResolveResponse":{"properties":{"datetime":{"type":"string","title":"Datetime","description":"차트 API에 바로 전달 가능한 ISO datetime"},"local_datetime":{"type":"string","title":"Local Datetime","description":"입력 로컬 datetime"},"timezone":{"type":"string","title":"Timezone","description":"IANA timezone ID"},"utc_offset":{"type":"string","title":"Utc Offset","description":"UTC offset 문자열"},"offset_minutes":{"type":"integer","title":"Offset Minutes","description":"UTC offset 분 단위"},"ambiguous":{"type":"boolean","title":"Ambiguous","description":"DST fall-back 등으로 local time이 중복되는지 여부","default":false},"disambiguation_used":{"anyOf":[{"type":"string","enum":["earlier","later"]},{"type":"null"}],"title":"Disambiguation Used"},"alternatives":{"items":{"$ref":"#/components/schemas/TimezoneAlternative"},"type":"array","title":"Alternatives"}},"type":"object","required":["datetime","local_datetime","timezone","utc_offset","offset_minutes"],"title":"TimezoneResolveResponse"},"VariablesData":{"properties":{"label":{"type":"string","title":"Label"},"personal":{"$ref":"#/components/schemas/VariableSide"},"design":{"$ref":"#/components/schemas/VariableSide"}},"type":"object","required":["label","personal","design"],"title":"VariablesData","description":"Full Variables data."},"NotSelfDeckResponse":{"properties":{"centers":{"additionalProperties":{"$ref":"#/components/schemas/NotSelfDeckCenter"},"type":"object","title":"Centers"},"personality_sun_center":{"type":"string","title":"Personality Sun Center"},"personality_north_node_center":{"type":"string","title":"Personality North Node Center"},"personality_south_node_center":{"type":"string","title":"Personality South Node Center"}},"type":"object","required":["centers","personality_sun_center","personality_north_node_center","personality_south_node_center"],"title":"NotSelfDeckResponse","description":"Response for POST /v1/not-self-deck"},"TransitOverlayBirthSection":{"properties":{"datetime":{"type":"string","title":"Datetime"},"positions":{"$ref":"#/components/schemas/PersonalityDesignPositions"},"gate_and_line":{"$ref":"#/components/schemas/PersonalityDesignGateAndLine"},"gates":{"items":{"type":"integer"},"type":"array","title":"Gates"},"channels":{"items":{"type":"string"},"type":"array","title":"Channels"}},"type":"object","required":["datetime","positions","gate_and_line","gates","channels"],"title":"TransitOverlayBirthSection","description":"Birth (natal) section of a transit overlay."},"CircuitChannelEntry":{"properties":{"channel":{"type":"string","title":"Channel"},"gates":{"anyOf":[{"items":{"type":"integer"},"type":"array"},{"type":"null"}],"title":"Gates"}},"type":"object","required":["channel"],"title":"CircuitChannelEntry","description":"A single channel entry within a circuit."},"ChannelLong":{"properties":{"name":{"type":"string","title":"Name"},"gates":{"items":{"type":"integer"},"type":"array","title":"Gates"}},"type":"object","required":["name","gates"],"title":"ChannelLong","description":"A channel with its name and gate pair."},"V2SimpleBodygraphRequest":{"properties":{"datetime":{"type":"string","title":"Datetime","description":"YYYY-MM-DDTHH:MM[:SS][+/-HH:MM] (ISO 8601 with UTC offset, e.g. 1990-01-01T12:34+09:00)"}},"type":"object","required":["datetime"],"title":"V2SimpleBodygraphRequest"},"V2NextGateTransitionsRequest":{"properties":{"datetime":{"type":"string","title":"Datetime","description":"Base datetime in ISO 8601 format"},"max_days":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Max Days","description":"Maximum search days. Null uses the endpoint default."}},"type":"object","required":["datetime"],"title":"V2NextGateTransitionsRequest"},"TransitionEvent":{"properties":{"jd":{"type":"number","title":"Jd"},"datetime":{"type":"string","title":"Datetime"},"from_gate":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"From Gate"},"to_gate":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"To Gate"},"from_line":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"From Line"},"to_line":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"To Line"},"current_line":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Current Line"},"status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Status"}},"type":"object","required":["jd","datetime"],"title":"TransitionEvent","description":"A gate transition event for a planet.\n\nThis is a single permissive model covering all three shapes:\n- Shape A (normal): jd, datetime, from_gate, to_gate (others absent)\n- Shape B (no_transition_found): jd, datetime, current_line, status (from_gate/to_gate absent)\n- Shape C (calculation_error): jd, datetime, from_gate=None, to_gate=None, current_line=None, status\n\nCombined with response_model_exclude_none=True on the endpoint, the serialized\nJSON matches the original dict output for Shapes A and B exactly.\n\nFor Shape C, exclude_none will drop from_gate/to_gate/current_line (all None),\nleaving only {jd, datetime, status}. This slightly differs from the original\n{jd, datetime, from_gate: null, to_gate: null, current_line: null, status} but\nis acceptable because clients already branch on the presence of ``status``."},"GroupPentaResponse":{"properties":{"members":{"items":{"$ref":"#/components/schemas/PentaMemberSummary"},"type":"array","title":"Members"},"penta":{"$ref":"#/components/schemas/PentaAnalysis"}},"type":"object","required":["members","penta"],"title":"GroupPentaResponse","description":"Response for POST /v1/group/penta"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"V2BodygraphRequest":{"properties":{"datetime":{"type":"string","title":"Datetime","description":"YYYY-MM-DDTHH:MM[:SS][+/-HH:MM] (ISO 8601 with UTC offset, e.g. 1990-01-01T12:34+09:00)"},"verbose":{"type":"boolean","title":"Verbose","default":false}},"type":"object","required":["datetime"],"title":"V2BodygraphRequest"},"PentaAnalysis":{"properties":{"gates":{"items":{"type":"integer"},"type":"array","title":"Gates"},"channels":{"items":{"type":"string"},"type":"array","title":"Channels"},"upper_channels":{"items":{"type":"string"},"type":"array","title":"Upper Channels"},"lower_channels":{"items":{"type":"string"},"type":"array","title":"Lower Channels"},"skills":{"$ref":"#/components/schemas/PentaSkills"}},"type":"object","required":["gates","channels","upper_channels","lower_channels","skills"],"title":"PentaAnalysis","description":"The penta analysis section."},"DreamRaveCalculationBasis":{"properties":{"design_planet":{"type":"string","title":"Design P