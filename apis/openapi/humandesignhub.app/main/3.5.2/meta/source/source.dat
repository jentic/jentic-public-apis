{"openapi":"3.1.0","info":{"title":"Human Design Hub Pro API","version":"3.5.2","termsOfService":"https://humandesignhub.app/en/terms","x-privacyPolicy":"https://humandesignhub.app/en/privacy","description":"Tier-filtered Human Design Hub API spec for building developer tooling, AI agents, and internal integrations.","x-planCode":"pro","x-tierLevel":3},"paths":{"/v2/simple-bodygraph":{"post":{"tags":["charts-v2"],"summary":"Calculate Simple Bodygraph","description":"Calculates a lightweight Human Design bodygraph from a birth datetime.","operationId":"simple_bodygraph_v2_simple_bodygraph_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V2SimpleBodygraphRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimpleBodygraphResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-requiredTier":0,"x-requiredPlan":"Free","x-creditCost":0.5}},"/v2/bodygraph":{"post":{"tags":["charts-v2"],"summary":"Calculate Bodygraph Chart","description":"Calculates a complete Human Design bodygraph from a birth datetime. Set verbose=true for planetary ephemeris data.","operationId":"bodygraph_v2_bodygraph_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/V2BodygraphRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BodygraphResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-requiredTier":2,"x-requiredPlan":"Standard","x-creditCost":1.0}},"/v2/cycle-analysis":{"post":{"tags":["charts-v2"],"summary":"Calculate Cycle Analysis","description":"Calculates major Human Design life-cycle events for a birth datetime.","o