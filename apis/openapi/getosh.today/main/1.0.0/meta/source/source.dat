{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Production API",
      "url": "https://app.getosh.today/api"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/oleg-kh/getosh.today/1.0.0"
    }
  ],
  "info": {
    "description": "Getosh API",
    "version": "1.0.0",
    "title": "Getosh API",
    "contact": {
      "email": "enquiries@getosh.today"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/oleg-kh/getosh.today/1.0.0"
  },
  "tags": [
    {
      "name": "admins",
      "description": "Secured Admin-only calls"
    },
    {
      "name": "developers",
      "description": "Operations available to regular developers"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "summary": "get tasks",
        "operationId": "searchTasks",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "description": "filter tasks by status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "failed"
              ]
            }
          },
          {
            "in": "query",
            "name": "offset",
            "description": "number of records to skip for pagination",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "maximum number of records to return",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "search results matching criteria",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/tasks/{id}": {
      "put": {
        "summary": "update task with scraped data",
        "operationId": "updateTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Task ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed",
                      "failed"
                    ],
                    "description": "Optional task status update"
                  },
                  "data": {
                    "$ref": "#/components/schemas/TaskUpdateData"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          },
          "404": {
            "description": "task not found"
          }
        }
      }
    },
    "/tasks/{id}/log": {
      "post": {
        "summary": "add log entry to task",
        "operationId": "addTaskLog",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Task ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskLogEntry"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "log entry created successfully"
          },
          "400": {
            "description": "bad input parameter"
          },
          "404": {
            "description": "task not found"
          }
        }
      }
    },
    "/tasks/{id}/files": {
      "post": {
        "summary": "add file to task",
        "description": "Upload a file to a task. Only works for scrape_ticket type.",
        "operationId": "addTaskFile",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Task ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskFileUpload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "file uploaded successfully"
          },
          "400": {
            "description": "bad input parameter"
          },
          "404": {
            "description": "task not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token provided by admin"
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "organization",
          "pcn",
          "vrm"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "scrape_ticket",
              "update_status",
              "pay",
              "appeal"
            ],
            "example": "scrape_ticket"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "organization": {
            "type": "string",
            "example": "brent.gov.uk"
          },
          "pcn": {
            "type": "string",
            "example": "BT26105179"
          },
          "vrm": {
            "type": "string",
            "example": "RY21TWM"
          },
          "appealText": {
            "type": "string",
            "description": "Email body text for appeal. Used only when type is 'appeal'.",
            "example": "I was not the driver at the time of the alleged offence..."
          },
          "amountToPay": {
            "type": "number",
            "format": "float",
            "description": "Amount to pay in GBP. Used only when type is 'pay'.",
            "example": 65.0
          }
        }
      },
      "TaskUpdateData": {
        "type": "object",
        "properties": {
          "pcnStatus": {
            "type": "string",
            "example": "Outstanding"
          },
          "amountToPay": {
            "type": "number",
            "format": "float",
            "example": 65.0
          },
          "dateOfIssue": {
            "type": "string",
            "format": "date",
            "example": "2026-01-15"
          },
          "pcnNumber": {
            "type": "string",
            "example": "BT26105179"
          },
          "vehicleRegistration": {
            "type": "string",
            "example": "RY21TWM"
          },
          "vehicleMake": {
            "type": "string",
            "example": "Toyota"
          },
          "contraventionCode": {
            "type": "string",
            "example": "01"
          },
          "contraventionDescription": {
            "type": "string",
            "example": "Parked in a restricted street during prescribed hours"
          },
          "contraventionDate": {
            "type": "string",
            "format": "date",
            "example": "2026-01-10"
          },
          "contraventionTime": {
            "type": "string",
            "example": "14:30"
          },
          "location": {
            "type": "string",
            "example": "High Road, Brent"
          },
          "noticeDate": {
            "type": "string",
            "format": "date",
            "example": "2026-01-15"
          },
          "observationDate": {
            "type": "string",
            "format": "date",
            "example": "2026-01-10"
          },
          "observationStart": {
            "type": "string",
            "example": "14:25"
          },
          "observationEnd": {
            "type": "string",
            "example": "14:35"
          },
          "keyEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "example": "2026-01-12"
                },
                "description": {
                  "type": "string",
                  "example": "PCN issued"
                }
              }
            }
          }
        }
      },
      "TaskLogEntry": {
        "type": "object",
        "required": [
          "message",
          "level"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Started scraping ticket data"
          },
          "image": {
            "type": "string",
            "format": "byte",
            "description": "Base64 encoded image (optional)",
            "example": "iVBORw0KGgoAAAANSUhEUgAAAAUA..."
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ],
            "example": "info"
          }
        }
      },
      "TaskFileUpload": {
        "type": "object",
        "required": [
          "name",
          "content",
          "type",
          "level"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "pcn_screenshot.png"
          },
          "description": {
            "type": "string",
            "example": "Screenshot of PCN details page"
          },
          "content": {
            "type": "string",
            "format": "byte",
            "description": "Base64 encoded file content",
            "example": "iVBORw0KGgoAAAANSUhEUgAAAAUA..."
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "pdf"
            ],
            "example": "image"
          }
        }
      }
    }
  }
}
