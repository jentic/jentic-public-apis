ocking":{"const":true},"non_certification":{"const":true},"non_ranking_input":{"const":true},"non_payout_input":{"const":true},"non_eligibility_input":{"const":true},"descriptors":{"type":"array","items":{"type":"object","required":["kind","applies_to","description","posture"],"properties":{"kind":{"type":"string"},"applies_to":{"type":"string"},"description":{"type":"string"},"posture":{"type":"string","enum":["DISCLOSE_ONLY"]}}}}}},"participation":{"type":"object"},"search_and_discovery":{"type":"object"},"posture_notes":{"type":"object"}}},"MetaAgentSurfaceResponse":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/MetaAgentSurfaceData"}}},"MetaAgentParticipationData":{"type":"object","required":["schema_version","positioning","participation","posture_notes"],"properties":{"schema_version":{"type":"integer","enum":[1]},"positioning":{"type":"string"},"participation":{"type":"object","required":["summary","seller_payout_path","org_level_beneficiary","allocation_ledger_status","reward_kinds_available_today","compensated_recommendation_disclosure_required","roles","allocation_role_kind_enum","agent_profile_role_kind_enum"],"properties":{"summary":{"type":"string"},"seller_payout_path":{"type":"string"},"org_level_beneficiary":{"const":true},"allocation_ledger_status":{"type":"string","enum":["LIVE_SELLER_AND_PLATFORM"]},"reward_kinds_available_today":{"type":"array","items":{"type":"string"}},"compensated_recommendation_disclosure_required":{"const":true},"roles":{"type":"array","items":{"type":"object"}},"allocation_role_kind_enum":{"type":"array","items":{"type":"string"}},"agent_profile_role_kind_enum":{"type":"array","items":{"type":"string"}}}},"posture_notes":{"type":"object"}}},"MetaAgentParticipationResponse":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/MetaAgentParticipationData"}}},"MetaScannerSignalsData":{"type":"object","required":["schema_version","ceiling","non_blocking","non_certification","non_ranking_input","non_payout_input","non_eligibility_input","descriptors","forbidden_in_automated_outputs"],"properties":{"schema_version":{"type":"integer","enum":[1]},"ceiling":{"type":"string","enum":["DISCLOSE_ONLY"]},"non_blocking":{"const":true},"non_certification":{"const":true},"non_ranking_input":{"const":true},"non_payout_input":{"const":true},"non_eligibility_input":{"const":true},"descriptors":{"type":"array","items":{"type":"object"}},"forbidden_in_automated_outputs":{"type":"array","items":{"type":"string"}}}},"MetaScannerSignalsResponse":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/MetaScannerSignalsData"}}},"MetaSearchContractData":{"type":"object","required":["schema_version","search_endpoint","ranking_formula_summary","filters","malformed_value_behavior","unknown_filter_value_behavior","invariants"],"properties":{"schema_version":{"type":"integer","enum":[1]},"search_endpoint":{"type":"string","enum":["/v1/listings"]},"ranking_formula_summary":{"type":"string"},"filters":{"type":"array","items":{"type":"object","required":["param","kind","description","ranking_role"],"properties":{"param":{"type":"string"},"kind":{"type":"string","enum":["literal_string","enum","integer","boolean","list"]},"description":{"type":"string"},"ranking_role":{"type":"string","enum":["HARD_FILTER_ONLY"]}}}},"malformed_value_behavior":{"type":"string"},"unknown_filter_value_behavior":{"type":"string"},"invariants":{"type":"object","required":["no_hidden_ranking_inputs","no_composite_trust_score","no_agent_reputation_multiplier","no_seller_prestige_relevance_boost","no_quality_coefficient"],"properties":{"no_hidden_ranking_inputs":{"const":true},"no_composite_trust_score":{"const":true},"no_agent_reputation_multiplier":{"const":true},"no_seller_prestige_relevance_boost":{"const":true},"no_quality_coefficient":{"const":true}}}}},"MetaSearchContractResponse":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/MetaSearchContractData"}}}}},"paths":{"/v1/agents/drafts":{"get":{"operationId":"listAgentPacketDrafts","tags":["Authenticated retrieval"],"summary":"List the calling organization's packet drafts with stage and next action.","description":"Returns every packet draft the agent's organization owns, with the same stage the seller surface derives (NEEDS_YOU, CHECKS_RUNNING, DONE), the listing the draft became when one exists, and a machine-actionable `next_action` (CONTINUE_DRAFT, AWAIT_CHECKS, MANAGE_LISTING, RETRY_PUBLISH, NO_ACTION) with the resource it refers to. CONTINUE_DRAFT is emitted only when the draft is genuinely editable; a handed-off draft that produced no listing reports RETRY_PUBLISH, and a closed draft the resume path would refuse reports NO_ACTION. Every value is an action the write side accepts. A draft whose packet is already published reports DONE and points at the listing: the refinery draft status alone is terminal at handoff and never reports publication, so an agent reading it in isolation will keep re-editing a packet that is already for sale. Requires a `grnt_agent_*` bearer with the `sell:submit` scope. Org-scoped — another organization's drafts can never appear. Read-only; it does not publish, submit, or change any state.","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}],"responses":{"200":{"description":"Packet drafts with stage, linked listing, and next action.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid agent bearer token.","content":{"application/json":{"schema":{"type":"object"}}}},"403":{"description":"INSUFFICIENT_RIGHTS — non-agent auth path, or missing `sell:submit` scope.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/refinery/drafts/{id}/imports/hub":{"post":{"operationId":"importRefineryHubDataset","tags":["Seller"],"summary":"Import a public Hugging Face dataset into a Refinery draft.","description":"Seller-authenticated, organization-scoped. Body {source_url}: a huggingface.co dataset link or its owner/name id. Graunt resolves the dataset at its current commit, fetches up to 20 files the Refinery accepts (README first, then data files in path order; 256 MB per file, 512 MB per import), streams a sha256 over every byte, and adds each file to the draft as an uploaded source with a provenance row naming the repo and the pinned revision. Dataset-card metadata fills only EMPTY draft fields, as proposals the seller confirms; the rights attestation is never written by this route. Public, ungated datasets only. Cross-organization draft ids return 404. The response never includes storage coordinates or a presigned URL. Ten imports per organization per day; 503 while the limiter is unavailable.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["source_url"],"properties":{"source_url":{"type":"string","maxLength":2048}}}}}},"responses":{"201":{"description":"Import envelope: draft_id, autosave_revision, source{repo_id, revision, author, url, license_tags, pretty_name}, imported[{member_id, path, size_bytes, content_sha256, mime_type}], skipped[{path, reason}], proposals_applied[], total_bytes.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid body, or source_url is not a Hugging Face dataset reference.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"type":"object"}}}},"403":{"description":"Not a seller-capable organization, or the organization email is unverified.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Draft not found for this organization.","content":{"application/json":{"schema":{"type":"object"}}}},"422":{"description":"DATASET_NOT_FOUND, DATASET_NOT_PUBLIC, or NO_IMPORTABLE_FILES.","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"Daily import limit reached.","content":{"application/json":{"schema":{"type":"object"}}}},"502":{"description":"The Hub did not answer.","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"The import limiter is unavailable; imports are paused.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/health":{"get":{"operationId":"metaHealth","tags":["Public discovery"],"summary":"Liveness probe — always HTTP 200.","description":"Returns HTTP 200 regardless of dependency state; the JSON body's `ok` flag reflects actual health. External uptime monitors body-match on `\"ok\":true`. Do not use this probe for load-balancer draining — use /v1/meta/ready for that.","security":[],"responses":{"200":{"description":"Liveness envelope. `ok` is a boolean; HTTP status is always 200.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthCheck"}}}}}}},"/v1/meta/ready":{"get":{"operationId":"metaReady","tags":["Public discovery"],"summary":"Readiness probe — HTTP 503 when a required dependency is unreachable.","description":"Returns HTTP 200 with `ready: true` when Postgres and Redis are reachable. Returns HTTP 503 with `ready: false` and a failing dependency name when any required dependency is unhealthy. This is the ALB target-group and ECS container health probe.","security":[],"responses":{"200":{"description":"All required dependencies are healthy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Readiness"}}}},"503":{"description":"One or more required dependencies are unreachable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Readiness"}}}}}}},"/v1/meta/pricing":{"get":{"operationId":"metaPricing","tags":["Public discovery"],"summary":"Platform pricing schedule.","description":"Returns the current policy-derived commission rate, processing-fee formula, delivery-fee schedule, current marketplace checkout constraints, and a worked example. Effective rate is resolved per purchase from the pricing_policies substrate (account/listing/license/promotion-scoped) and captured immutably in purchases.commercial_terms.pricing_policy_ref; default rate is 25%. All monetary values are integer cents.","security":[],"responses":{"200":{"description":"Pricing data envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/PricingInfo"}}}}}}}}},"/v1/meta/stripe-publishable-key":{"get":{"operationId":"metaStripePublishableKey","tags":["Public discovery"],"summary":"Stripe publishable key for browser checkout.","description":"Returns the Stripe publishable key (pk_live_* / pk_test_*) the buyer-facing checkout page uses to initialize Stripe Elements client-side. Browser-safe by Stripe's design — publishable keys can be exposed on the client. The response also returns a `mode` discriminator (LIVE / TEST / UNKNOWN / ABSENT) so callers can sanity-check the deployment environment. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Publishable key envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["publishable_key","mode"],"properties":{"publishable_key":{"type":"string","description":"Stripe publishable key (pk_live_* or pk_test_*); empty string when ABSENT."},"mode":{"type":"string","enum":["LIVE","TEST","UNKNOWN","ABSENT"],"description":"Discriminator for the publishable-key environment. ABSENT means no key is configured on the deployment."}}}}}}}}}}},"/v1/listing-drafts":{"get":{"operationId":"listListingDrafts","tags":["Seller"],"summary":"List server-backed listing drafts for the caller's workspace.","description":"Returns up to `limit` (default 100, max 100) of the calling org's listing drafts, optionally filtered by `status` (IN_PROGRESS / SUBMITTED / ABANDONED). The draft payload follows the legacy 5-step listing-draft layout (the manual wizard UI is retired — sellers create listings through the Refinery).","security":[{"bearerAuth":[]}],"parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["IN_PROGRESS","SUBMITTED","ABANDONED"]}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100}}],"responses":{"200":{"description":"Listing drafts envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["drafts"],"properties":{"drafts":{"type":"array","items":{"$ref":"#/components/schemas/ListingDraft"}}}}}}}}},"401":{"description":"Missing or invalid Authorization header."}}},"post":{"operationId":"createListingDraft","tags":["Seller"],"summary":"Create a new listing draft.","description":"Creates a draft owned by the caller's org. Optional `payload` seeds the draft with partial step data; absent payload starts a blank draft.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"payload":{"type":"object","additionalProperties":true,"description":"Optional seed payload; strict per-step shape follows the legacy listing-draft 5-step layout."}}}}}},"responses":{"201":{"description":"Listing draft created.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["draft"],"properties":{"draft":{"$ref":"#/components/schemas/ListingDraft"}}}}}}}},"401":{"description":"Missing or invalid Authorization header."},"422":{"description":"Validation error on the draft payload."}}}},"/v1/listing-drafts/{id}":{"get":{"operationId":"getListingDraft","tags":["Seller"],"summary":"Get one listing draft.","description":"Returns the draft if owned by the caller's org; 404 otherwise. Cross-org access intentionally returns 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Listing draft envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["draft"],"properties":{"draft":{"$ref":"#/components/schemas/ListingDraft"}}}}}}}},"401":{"description":"Missing or invalid Authorization header."},"404":{"description":"Draft not found or not owned by caller's org."}}},"patch":{"operationId":"patchListingDraft","tags":["Seller"],"summary":"Patch a listing draft (autosave).","description":"Optimistic-locking autosave. Body carries partial per-step state plus the `autosave_revision` value from the last GET; mismatched revisions return 409 DRAFT_AUTOSAVE_CONFLICT so the client can reload.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"payload":{"type":"object","additionalProperties":true,"description":"Partial step state; strict per-step shape follows the legacy listing-draft 5-step layout."},"autosave_revision":{"type":"integer","minimum":0}}}}}},"responses":{"200":{"description":"Updated draft envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["draft"],"properties":{"draft":{"$ref":"#/components/schemas/ListingDraft"}}}}}}}},"401":{"description":"Missing or invalid Authorization header."},"404":{"description":"Draft not found or not owned by caller's org."},"409":{"description":"Autosave revision conflict."},"422":{"description":"Validation error."}}},"delete":{"operationId":"deleteListingDraft","tags":["Seller"],"summary":"Abandon a listing draft.","description":"Transitions the draft to ABANDONED. The row is preserved (no hard delete) so existing references remain valid.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Abandoned draft envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["draft"],"properties":{"draft":{"$ref":"#/components/schemas/ListingDraft"}}}}}}}},"401":{"description":"Missing or invalid Authorization header."},"404":{"description":"Draft not found or not owned by caller's org."},"409":{"description":"Draft is already in a terminal status."}}}},"/v1/pricing/preview":{"post":{"operationId":"previewPricing","tags":["Seller"],"summary":"Display-time pricing preview for seller pricing surfaces.","description":"Returns the seller-net + platform-fee breakdown for a given `gross_amount_cents` (and optional `listing_id` / `license_type` / `promo_code`). Resolved against the pricing_policies substrate; server enforces seller-scope via the JWT (BUYER orgs are rejected with 403). Preview-only — the response is NEVER persisted; purchase-time snapshots remain immutable.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["gross_amount_cents"],"properties":{"gross_amount_cents":{"type":"integer","minimum":0},"listing_id":{"type":"string","format":"uuid"},"license_type":{"type":"string"},"promo_code":{"type":"string"}}}}}},"responses":{"200":{"description":"Pricing preview envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["gross_amount_cents","effective_commission_bps","platform_fee_cents","seller_net_cents","pricing_basis","preview_only","resolved_at"],"properties":{"gross_amount_cents":{"type":"integer","minimum":0},"effective_commission_bps":{"type":"integer","minimum":0,"maximum":10000},"platform_fee_cents":{"type":"integer","minimum":0},"seller_net_cents":{"type":"integer","minimum":0},"pricing_basis":{"type":"string","enum":["standard","custom","promotion","free"],"description":"Bounded public basis; never leaks raw policy IDs or funding source."},"preview_only":{"const":true},"resolved_at":{"type":"string","format":"date-time"}}}}}}}},"401":{"description":"Missing or invalid Authorization header."},"403":{"description":"BUYER orgs are not allowed to preview seller pricing."},"422":{"description":"Validation error."}}}},"/v1/access-codes/redeem":{"post":{"operationId":"redeemAccessCode","tags":["Authenticated purchase"],"summary":"Redeem an access code to obtain a commerce access grant.","description":"Authenticated org redeems a raw access code (8-128 chars). On success, the response carries the redemption id and the resulting `commerce_access_grant_id`. The raw code is NEVER logged (only prefix/last4 in audit).","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["code"],"properties":{"code":{"type":"string","minLength":8,"maxLength":128}}}}}},"responses":{"200":{"description":"Redemption envelope.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["redemption_id","commerce_access_grant_id"],"properties":{"redemption_id":{"type":"string","format":"uuid"},"commerce_access_grant_id":{"type":"string","format":"uuid"}}}}}}}},"400":{"description":"Invalid redeem body."},"401":{"description":"Missing or invalid Authorization header."},"403":{"description":"Caller org type is not eligible to redeem."},"404":{"description":"Access code not found."},"409":{"description":"One of: CODE_REVOKED, CODE_EXPIRED, CODE_EXHAUSTED, ALREADY_REDEEMED, PER_ORG_LIMIT_EXCEEDED."}}}},"/v1/meta/seller-standards":{"get":{"operationId":"metaSellerStandards","tags":["Public discovery"],"summary":"Machine-readable seller and agent acceptance standards.","description":"Returns the canonical acceptance-standards contract: packet families, packet kinds, validation statuses, manifest delivery-format vocabulary (`accepted_formats`, scope=`manifest_delivery_format`), per-asset upload-format vocabulary (`bundle.accepted_asset_formats`), bundle limits, rights / publication vocabularies, eight requirement groups with 28 stable requirement IDs, a submission checklist, and the evaluated-not-verified review posture. Public, no auth, no DB. Deterministic: two sequential requests return byte-identical JSON. cache-control: public, max-age=300. Requirement IDs are submission-checklist identifiers, not reject reasons. Schema version + requirement set version are pinned at 1.","security":[],"responses":{"200":{"description":"Acceptance-standards contract envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetaSellerStandardsResponse"}}}}}}},"/v1/meta/agent-surface":{"get":{"operationId":"metaAgentSurface","tags":["Public discovery"],"summary":"Omnibus agent-readable surface contract.","description":"Returns the canonical agent-readable surface contract: brand line + positioning, current human + machine surfaces, trust primitives (rights_block / rights_passport / publication_metadata / packet_manifest / content_sha256 / packet_manifest_hash / signed manifest endpoint / packet_checks / admin review gate), scanner-signal posture (DISCLOSE_ONLY ceiling + bounded language descriptors for every scanner kind), participation contract (live seller + platform allocation, reward kinds available today, compensated-recommendation-disclosure requirement), search-and-discovery contract (ranking formula summary, filter list, ranking invariants). Public, no auth, no DB. Deterministic: two sequential requests return byte-identical JSON. cache-control: public, max-age=300. Schema version pinned at 1.","security":[],"responses":{"200":{"description":"Agent-readable surface contract envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetaAgentSurfaceResponse"}}}}}}},"/v1/meta/agent-participation":{"get":{"operationId":"metaAgentParticipation","tags":["Public discovery"],"summary":"Machine-readable participation contract.","description":"Returns the participation focus of the agent-readable surface contract: allocation-ledger status (LIVE_SELLER_AND_PLATFORM), reserved contributor role kinds (BUILDER / VALIDATOR / CURATOR / REFERRAL / DEMAND_SCOUT / RECRUITER / UPDATE_MAINTAINER / BUYER_CREDIT) with substrate status, reward kinds available today (CASH, ATTRIBUTION_ONLY), and compensated_recommendation_disclosure_required=true. Public, no auth, no DB. Deterministic. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Participation contract envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetaAgentParticipationResponse"}}}}}}},"/v1/meta/scanner-signals":{"get":{"operationId":"metaScannerSignals","tags":["Public discovery"],"summary":"Machine-readable scanner-signal catalog.","description":"Returns the scanner-signal focus of the agent-readable surface contract: the DISCLOSE_ONLY ceiling, every scanner kind (LLM_ORIGIN, BENCHMARK_OVERLAP, DUPLICATE_DIVERSITY, PROMPT_INJECTION_SIGNAL, SECRET_LEAK_SIGNAL) with bounded-language descriptors + substrate status, and the forbidden-in-automated-outputs vocabulary. Scanner outputs never act as automatic publication blockers, ranking multipliers, payout gates, or eligibility filters. Public, no auth, no DB. Deterministic. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Scanner-signal catalog envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetaScannerSignalsResponse"}}}}}}},"/v1/meta/search-contract":{"get":{"operationId":"metaSearchContract","tags":["Public discovery"],"summary":"Machine-readable search / discovery contract.","description":"Returns the search-and-discovery focus of the agent-readable surface contract: the `/v1/listings` search endpoint reference, ranking-formula summary, the live listing-search hard-filter set (every filter described as HARD_FILTER_ONLY), the malformed-value and unknown-filter-value behavior, and the ranking invariants (`no_hidden_ranking_inputs`, `no_composite_trust_score`, `no_agent_reputation_multiplier`, `no_seller_prestige_relevance_boost`, `no_quality_coefficient` — all true). Public, no auth, no DB. Deterministic. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Search contract envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetaSearchContractResponse"}}}}}}},"/v1/listings":{"get":{"operationId":"listListings","tags":["Public discovery"],"summary":"Search active listings (public).","description":"Paginated search over ACTIVE listings. Supports filters: category, asset_class, file_format, data_purpose, min_price, max_price, tag, industry, rights_block fields, publication_status, jurisdiction, has_doi, max_publication_date_age_days, and free-text `q`. There is no public quality filter or quality sort. Unauthenticated. Responses do not include buyer- or seller-specific state.","security":[],"parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"category","in":"query","schema":{"type":"string"}},{"name":"asset_class","in":"query","description":"Matches the projected listing asset_class, including PACKET_BUNDLE for bundle-backed listings.","schema":{"type":"string","enum":["DATASET","TEXT_ASSET","PACKET_BUNDLE"]}},{"name":"file_format","in":"query","schema":{"type":"string"}},{"name":"data_purpose","in":"query","schema":{"type":"string"}},{"name":"min_price","in":"query","schema":{"type":"integer","minimum":0}},{"name":"max_price","in":"query","schema":{"type":"integer","minimum":0}},{"name":"free_only","in":"query","description":"Friendly agent-side filter; 'true' restricts to price_cents=0. 'false' is accepted and disables the filter (no-op). Hard filter only.","schema":{"type":"string","enum":["true","false"]}},{"name":"packet_only","in":"query","description":"Friendly agent-side filter; 'true' restricts to packet-overlay listings (packet_manifest IS NOT NULL). 'false' is accepted and disables the filter (no-op). Hard filter only.","schema":{"type":"string","enum":["true","false"]}},{"name":"tag","in":"query","description":"canonical taxonomy tag (kebab-case). Aliases (e.g., `rag` → `rag-corpus`) are rewritten transparently. Unknown / non-canonical tokens return HTTP 400. Filter only — never a relevance boost. See /v1/meta/search-contract → tag_taxonomy for the canonical set.","schema":{"type":"string"}},{"name":"industry_tag","in":"query","description":"Hierarchical industry tag (taxonomy boundary on `.`). Equality + LIKE 'val.%' descendant match.","schema":{"type":"string"}},{"name":"q","in":"query","schema":{"type":"string"},"description":"Free-text search over name, description, and tags."},{"name":"sort","in":"query","schema":{"type":"string","enum":["relevance","price_asc","price_desc","newest"]}},{"name":"has_bundle_assets","in":"query","description":"literal 'true' restricts to bundle-backed listings (listings.packet_bundle_revision_id IS NOT NULL). Filter only.","schema":{"type":"string","enum":["true"]}},{"name":"min_bundle_asset_count","in":"query","description":"minimum bundle asset count. 1..1024. The value filtered on is returned as bundle_asset_count on every result.","schema":{"type":"integer","minimum":1,"maximum":1024}},{"name":"max_bundle_asset_count","in":"query","description":"maximum bundle asset count. 1..1024. The value filtered on is returned as bundle_asset_count on every result.","schema":{"type":"integer","minimum":1,"maximum":1024}},{"name":"has_manifest_hash","in":"query","description":"literal 'true' restricts to listings with a populated packet_manifest_hash. Filter only.","schema":{"type":"string","enum":["true"]}},{"name":"has_packet_merkle_root","in":"query","description":"literal 'true' restricts to listings with a populated packet_merkle_root. Filter only.","schema":{"type":"string","enum":["true"]}},{"name":"has_publication_metadata","in":"query","description":"literal 'true' restricts to listings with a listing_publication_metadata row. Filter only.","schema":{"type":"string","enum":["true"]}},{"name":"has_source_url","in":"query","description":"literal 'true' restricts to listings whose underlying dataset declares a source_url. Filter only.","schema":{"type":"string","enum":["true"]}},{"name":"has_evaluated_evidence","in":"query","description":"literal 'true' restricts to listings whose packet_manifest.evidence_refs is a populated object. Disclosure-only — the bucket being declared does not certify quality.","schema":{"type":"string","enum":["true"]}},{"name":"tag_class","in":"query","description":"tag class id (kebab-case). Matches listings whose tags[] OR system discovery projection overlap the canonical set for that class. Hard filter only — never affects rank.","schema":{"type":"string","enum":["model-use","asset-type","domain","modality","format-family","structure","evaluation","integrity","rights","provenance","language","jurisdiction","freshness","standards","buyer-use","safety-posture"]}},{"name":"starter_supply_slug","in":"query","description":"Starter-supply category slug. Hard filter only — never multiplies rank, never enters sort or tiebreaker. Matches listings whose tags[] OR system discovery projection contain the slug. Invalid slug returns HTTP 400 with a structured validation error.","schema":{"type":"string","enum":["project-governance","claude-md-agent-instructions","repo-playbooks","agent-workflows","evaluation-rubrics","prompt-policy-references","mcp-openapi-integration","public-source-digests","source-backed-research"]}}],"responses":{"200":{"description":"Paginated listing envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListListingsResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"createListing","tags":["Seller"],"summary":"Create a listing (seller).","description":"Requires an authenticated seller org (type SELLER or BOTH). The body must supply EXACTLY ONE delivery target: `dataset_id` for a single-file dataset listing OR `packet_bundle_revision_id` for a finalized packet bundle revision (multi-file). Single-file listings remain the default path; bundle-backed listings carry the same rights / passport / publication-metadata validators. New listings enter PENDING_REVIEW and are only visible to the owning seller and admins until published. Publication checks run automatically on entry and eligible listings publish through the canonical publication gate; escalations route to manual review. entitled buyers fetch them via GET /v1/entitlements/{id}/packet-bundle. Listing price must meet the current marketplace checkout minimum. Rate-limited per organization; a legitimate retry with the same Idempotency-Key + body replays the cached response without consuming an additional rate-limit slot.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateListingRequest"}}}},"responses":{"201":{"description":"Listing created in PENDING_REVIEW.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateListingResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Error envelope — `ok` is false and `error` carries a stable code + message.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Service temporarily unavailable — the rate-limit substrate could not confirm capacity safely and the request was held back rather than processed. `Retry-After` carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"SERVICE_TEMPORARILY_UNAVAILABLE\"` and a bounded `retry_after_seconds` field.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getListing","tags":["Public discovery"],"summary":"Fetch a public listing detail (public).","description":"Returns the public listing detail with declared rights, provenance metadata, intended uses, packet_checks, and evaluation_summary. Public responses do not include a composite quality score or per-dimension quality scores. Listings in ACTIVE status are visible to the public, plus direct-link early listings (held listings from a seller who has not finished registering — carrying the early_listing block; never in catalog or search); callers with the owning seller's auth additionally see their own non-public listings.","security":[],"responses":{"200":{"description":"Listing detail envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListingDetailResponse"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"patch":{"operationId":"updateListing","tags":["Seller"],"summary":"Update an owned listing (seller).","description":"Partial update. Sellers may change price (0 for free, or at least the marketplace paid-order minimum), title, description, tags, usage_restrictions, content_kind, rights_block, rights_passport, and publication_metadata while the listing is ACTIVE, PAUSED, PENDING_REVIEW, or NEEDS_REFINEMENT — a submission held in review is editable so publication-review findings can be fixed in place. Packet fields (packet_kind, packet_manifest, version_identifier), intended_uses, and packet_bundle_revision_id (re-point a held bundle-backed listing at a fixed frozen revision owned by the same org) are editable only while PENDING_REVIEW or NEEDS_REFINEMENT. After edits, re-run the checks with resubmitListingPublicationReview. Agent bearer credentials require the sell:submit scope. Sellers cannot toggle public_free_access in v0; that field is admin-flip-only via the operator runbook.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateListingRequest"}}}},"responses":{"200":{"description":"Updated listing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateListingResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/access-grants":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"createListingAccessGrant","tags":["Public discovery"],"summary":"Mint a public free-access grant (anonymous, rate-limited).","description":"PUBLIC_TOKEN_GRANT_FREE listings only: the listing detail carries registration_required=false, and its links.free_access_grant_route and purchase_handoff.free_access_grant_url name this route. The listing must be ACTIVE, price_cents = 0, and public_free_access = true. Anonymous; no Bearer required. Per-IP-per-window, per-IP-per-day, and per-listing-global-per-day caps enforced via Redis. Failure-closed on Redis outage (HTTP 503 FREE_ACCESS_TEMPORARILY_UNAVAILABLE). Returns a short-lived grant token, shown once (only its sha256 hash is stored), and the download_url that redeems it at GET /v1/listings/{id}/free-download. The response carries Cache-Control: no-store, private and Referrer-Policy: no-referrer; do not log the token or download_url.","security":[],"responses":{"200":{"description":"Grant minted. `data.token` is the raw grant token (returned once) and `data.download_url` the relative redeem path that already carries it.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["grant_id","token","expires_at","download_url","terms_notice","rights_notice","rate_limit"],"properties":{"grant_id":{"type":"string","format":"uuid"},"token":{"type":"string","minLength":1,"description":"The raw grant token. Returned once in this body; Graunt stores only its sha256 hash. Supply it as the `grant` query parameter of GET /v1/listings/{id}/free-download (download_url already carries it). Do not log it."},"expires_at":{"type":"string","format":"date-time"},"download_url":{"type":"string","pattern":"^\\/v1\\/listings\\/[0-9a-f-]{36}\\/free-download\\?grant=.+$","description":"Relative redeem path with the token already in its query string. GET it on the API host: a single-file listing answers 302 to a short-lived presigned URL; a bundle-backed listing answers 200 JSON with one presigned URL per asset."},"terms_notice":{"type":"string","minLength":1},"rights_notice":{"type":"string","minLength":1,"description":"The listing's declared license family and its training, redistribution and citation terms."},"rate_limit":{"type":"object","required":["per_ip_per_window","window_seconds","per_ip_per_day","global_per_day"],"properties":{"per_ip_per_window":{"type":"integer","minimum":1},"window_seconds":{"type":"integer","minimum":1},"per_ip_per_day":{"type":"integer","minimum":1},"global_per_day":{"type":"integer","minimum":1}}}}}}}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"FREE_ACQUISITION_NOT_AVAILABLE: the listing is sold by subscription only.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"The listing is not active, not free, or not open to public free access.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A grant cap was reached. The `Retry-After` header carries the integer seconds to wait.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Free access is temporarily unavailable (rate-limit infrastructure unreachable).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/free-download":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"grant","in":"query","required":true,"schema":{"type":"string"}}],"get":{"operationId":"redeemListingFreeDownload","tags":["Public discovery"],"summary":"Redeem a public free-access grant for short-lived download URLs.","description":"Validates the grant token, performs a live listing-eligibility re-check (status, price, public_free_access, file or bundle resolvable), and enforces a per-IP-per-minute download rate limit (FAIL CLOSED on Redis outage). The response shape follows the listing's delivery_kind: a SINGLE_FILE listing answers 302 with a Location header naming a fresh presigned URL; a PACKET_BUNDLE listing answers 200 JSON with the bundle's manifest_sha256, asset count, total bytes, and one presigned URL per asset. Every URL's TTL is capped by the grant's remaining TTL. Each redemption emits FREE_ACCESS_DOWNLOAD_URL_ISSUED; the first redemption transitions the grant ACTIVE → REDEEMED and emits FREE_ACCESS_GRANT_REDEEMED. Issuance is not proof of S3 byte delivery — Graunt does not proxy the file. Response carries Cache-Control: no-store, private and Referrer-Policy: no-referrer.","security":[],"responses":{"200":{"description":"PACKET_BUNDLE listing: the bundle manifest hash plus one short-lived presigned URL per asset.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["grant_id","listing_id","delivery_kind","packet_bundle_revision_id","bundle_id","revision_number","manifest_sha256","total_bytes","asset_count","expires_at","terms_notice","assets"],"properties":{"grant_id":{"type":"string","format":"uuid"},"listing_id":{"type":"string","format":"uuid"},"delivery_kind":{"const":"PACKET_BUNDLE"},"packet_bundle_revision_id":{"type":"string","format":"uuid"},"bundle_id":{"type":"string","format":"uuid"},"revision_number":{"type":"integer","minimum":1},"manifest_sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"total_bytes":{"type":"integer","minimum":0},"asset_count":{"type":"integer","minimum":1},"expires_at":{"type":"string","format":"date-time"},"terms_notice":{"type":"string","minLength":1},"assets":{"type":"array","minItems":1,"items":{"type":"object","required":["asset_id","ordering","asset_role","file_format","file_size_bytes","content_sha256","original_filename","download_url","expires_at"],"properties":{"asset_id":{"type":"string","format":"uuid"},"ordering":{"type":"integer","minimum":0},"asset_role":{"type":"string","enum":["PRIMARY","SUPPORTING","EVIDENCE","MANIFEST","LEGAL_NOTICE","BUNDLE_MANIFEST","FILE_INDEX","SEARCH_INDEX","USE_PLAN","RIGHTS_AND_PROVENANCE_SNAPSHOT","ARCHIVE_INDEX","DATA_CHECK_REPORT","SOURCE_ENRICHMENT","ORIGINAL_TEXT_PRESERVATION_RECEIPT","PROCESSING_RECEIPT","REVIEWER_QUALITY_RECEIPT","VERIFY_README","PACKET_GUIDE","PACKET_NAVIGATION","SPLICE_MANIFEST","DERIVED_OUTPUT"]},"file_format":{"type":"string","minLength":1},"file_size_bytes":{"type":"integer","minimum":0},"content_sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"original_filename":{"type":"string","minLength":1},"download_url":{"type":"string","format":"uri","description":"Short-lived presigned URL for this asset, named for download. Do not log it."},"expires_at":{"type":"string","format":"date-time"}}}}}}}}}}},"302":{"description":"SINGLE_FILE listing: redirect to a short-lived presigned download URL.","headers":{"Location":{"description":"The presigned download URL. Do not log it.","schema":{"type":"string","format":"uri"}}}},"400":{"description":"The `grant` query parameter is missing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"The grant is invalid, revoked, or expired.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"The listing is no longer eligible for public free access.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The download rate limit was reached. The `Retry-After` header carries the integer seconds to wait.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Free access is temporarily unavailable (rate-limit infrastructure unreachable).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/metadata-suggestions/preview":{"post":{"operationId":"previewMetadataSuggestions","tags":["Seller"],"summary":"Deterministic metadata-suggestion preview (Bearer-required).","description":"Reads draft listing metadata (name, description, source_url, asset_class, file_format, category, current_tags, current_industry_tag_codes) and returns deterministic tag / intended-use / industry-tag-code / content-kind suggestions with confidence + reason tokens, plus a bounded `readiness_signals` array (severity `info` or `recommended`) describing sparse fields that weaken agent discovery / hard-filter eligibility / publication review. No external network call. No persistence. NEVER auto-attests rights or legal fields. Sellers must review before applying. Suggestions and readiness signals are never input to search ranking and never block publication. Rate-limited per organization (fail-open: a brief rate-limit substrate outage does not interrupt this low-cost read).","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Suggestions bundle.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/auth/register":{"post":{"operationId":"authRegister","tags":["Seller"],"summary":"Register a new organization + initial user.","description":"Creates an org of type BUYER, SELLER, or BOTH. No token is returned — sign in at POST /v1/auth/login. Legal acceptance of the Terms of Service, Privacy Notice, Acceptable Use Policy, and electronic-records consent is recorded transactionally with the registration, each row keyed on its own required affirmation. The Seller Agreement is NOT accepted here — it is captured at the seller gate (POST /v1/legal/seller-gate), where the terms are actually rendered. THE RESPONSE IS IDENTICAL whether or not the address was already registered: the same 201 and the same body, because a differing status code, field set, or response time each answered whether an account exists. There is no 409 on this route. Rate-limited per source IP via the auth plugin (10 requests per minute by default). The bucket key is sourced through the edge / origin-auth helper so spoofed `cf-connecting-ip` / `x-forwarded-for` headers do not rotate the bucket unless a trusted-edge posture is enabled.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}}},"responses":{"201":{"description":"Registration accepted. Byte-identical for a new address and one already registered.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterResponse"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/auth/login":{"post":{"operationId":"authLogin","tags":["Seller"],"summary":"Authenticate an existing user and receive a JWT.","description":"Returns a short-lived JWT. Callers must pass the token as `Authorization: Bearer <token>` on subsequent authenticated requests. Rate-limited per source IP via the auth plugin (10 requests per minute by default). The bucket key is sourced through the edge / origin-auth helper so spoofed `cf-connecting-ip` / `x-forwarded-for` headers do not rotate the bucket unless a trusted-edge posture is enabled.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}}},"responses":{"200":{"description":"Authenticated; token returned.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/auth/stripe/connect":{"post":{"operationId":"startStripeConnect","tags":["Seller"],"summary":"Begin Stripe Connect onboarding for a seller org.","description":"Returns a Stripe-hosted onboarding URL. The caller must be a seller or BOTH org. Completion is required before the seller can receive payouts; listing creation does not require it. Stripe is the payment processor.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Stripe onboarding URL issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StripeConnectResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/purchases":{"post":{"operationId":"initiatePurchase","tags":["Authenticated purchase"],"summary":"Initiate a FULL purchase of an ACTIVE listing.","description":"Creates a PaymentIntent via Stripe and returns the client secret. Complete the intent via Stripe's client SDK; Graunt creates the entitlement on webhook confirmation. Idempotent on the caller-supplied `idempotency_key`. Order totals are subject to the current marketplace checkout minimum. Payment rails are same-rail only: the buyer rail must match an enabled seller payout rail; card payment is the only active rail today. A paid purchase proceeds whether or not the seller has finished payout setup: the buyer is charged and entitled now, and the seller's net is held and transferred automatically once their payout setup is complete. Rail-mismatch / unsupported-rail / split-tender requests are denied with PAYMENT_RAIL_NOT_ACCEPTED / PAYMENT_RAIL_NOT_SUPPORTED / SPLIT_PAYMENT_NOT_SUPPORTED. Denials never expose seller Stripe account ids or provider internals. Free acquisition (price_cents = 0) never requires seller payout setup.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InitiatePurchaseRequest"}}}},"responses":{"200":{"description":"Purchase intent created (or the prior intent for this idempotency_key was returned). For a free listing (price_cents = 0), the entitlement is granted without a Stripe call.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InitiatePurchaseResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Payment-rail denial (SAFE; no seller/provider internals). error.code is one of PAYMENT_RAIL_NOT_ACCEPTED, PAYMENT_RAIL_NOT_SUPPORTED, or SPLIT_PAYMENT_NOT_SUPPORTED. No PaymentIntent / session / purchase row is created.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/purchases/held":{"post":{"operationId":"initiateHeldPurchase","tags":["Authenticated purchase"],"summary":"Authorize early access to an early-listing packet without an immediate charge.","description":"Places a manual-capture card authorization (the card is authorized, not charged) and grants early access to the packet immediately. The authorization is captured only after the seller registers and the packet publishes; if the seller does not register within the capture window, the authorization is released, the card is never charged, and early access is retained. JWT buyer-organization auth only — an agent-bearer token receives 409 with code DENY_CAPABILITY_NOT_LIVE before any database work. The response returns a one-time Stripe client_secret and is sent with Cache-Control: no-store; the secret is never persisted, logged, or echoed on reads.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["listing_id","authorize_held_purchase"],"properties":{"listing_id":{"type":"string","format":"uuid"},"authorize_held_purchase":{"type":"boolean","enum":[true],"description":"Affirms the amount-specific held authorization block. Call once WITHOUT this field to receive 422 HELD_AUTHORIZATION_REQUIRED whose error.details.label is the exact disclosure block (amount, capture window, hold-not-charge, keep-access-on-release) to render beside your Authorize action; then retry with true."}}}}}},"responses":{"201":{"description":"Held authorization created. Body carries purchase_id, listing_id, status (AUTHORIZED_HELD once the authorization settles), amount_cents, currency, and a one-time client_secret."},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Capability not available for this caller (agent-bearer token), or the listing is not an early-listing eligible for a held authorization. No authorization is placed.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/purchases/{id}/release-held":{"post":{"operationId":"releaseHeldPurchase","tags":["Authenticated purchase"],"summary":"Voluntarily release a held authorization before capture.","description":"Releases the buyer's held card authorization before it is captured. The card is never charged. JWT buyer-organization auth only — an agent-bearer token receives 409. Org-scoped: a purchase that does not belong to the caller surfaces as 404. Idempotent — releasing an already-released authorization returns the released state. Sent with Cache-Control: no-store.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Authorization released (or already released). Body carries purchase_id, status, and released: true."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/purchases/{id}/request-refund":{"post":{"operationId":"requestRefund","tags":["Authenticated purchase"],"summary":"Submit a purchase-issue review request.","description":"Submit a purchase-issue review request. Purchases on Graunt are final; reversals are reviewed only for rights failure, fraud or unauthorized sale, or technical delivery failure. The required `reason_code` must be one of FRAUD, TECHNICAL_FAILURE, RIGHTS_REVOCATION — the qualifying_reversal_grounds the agent commerce manifest lists (the admin-only OTHER_OPERATOR_APPROVED value is rejected on this route). Idempotent on the body-level `idempotency_key`. One refund-request per purchase ever — re-requests after any terminal state return 422. Cross-org access surfaces as 404. Audit event REFUND_REQUESTED records only IDs + booleans (Hard Rule 7); the buyer's reason text stays in `refund_requests.buyer_reason` only.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["buyer_reason","idempotency_key","reason_code"],"properties":{"buyer_reason":{"type":"string","minLength":1,"maxLength":2000},"idempotency_key":{"type":"string","minLength":1,"maxLength":255},"reason_code":{"type":"string","enum":["FRAUD","TECHNICAL_FAILURE","RIGHTS_REVOCATION"],"description":"Qualifying reversal ground. Buyer-facing surface accepts these three values only; OTHER_OPERATOR_APPROVED is admin-only and rejected here."}}}}}},"responses":{"200":{"description":"Idempotent replay — same idempotency_key + same fingerprint returns the prior 201 body."},"201":{"description":"Refund request created."},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Idempotency-key conflict (same key + different fingerprint) or in-progress reservation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Purchase not eligible (status != COMPLETED, refund_status != NONE) or refund_request already exists.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/purchases/{id}/refund-request":{"get":{"operationId":"getRefundRequest","tags":["Authenticated purchase"],"summary":"Fetch the buyer-visible refund-request state for a purchase.","description":"Org-scoped lookup. Returns `{ refund_request: null }` when no request exists; otherwise the current state, buyer_reason, decision_note (admin-authored, may be shown to the buyer on DENIED), and timestamps.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Refund request state (or null when none)."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/packet-bundle":{"get":{"operationId":"getEntitlementPacketBundle","tags":["Authenticated retrieval"],"summary":"Fetch every asset in a bundle-backed entitlement as one short-lived signed-URL list (buyer / entitled agent).","description":"Buyer multi-asset bundle delivery. Returns the immutable packet bundle revision pinned on the entitlement plus a fresh presigned URL per asset (TTL 600 seconds). Each successful call atomically decrements `download_count` once (per-call semantics — bundle fanout does NOT multiply the counter). Per-asset audit events record IDs / counts / hashes only — never URLs. Cross-org access collapses to 404. Single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED with `details.redirect_path` pointing at /v1/entitlements/{id}/download. Response headers carry Cache-Control: no-store, private and Referrer-Policy: no-referrer.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Bundle revision manifest + per-asset presigned-URL list. All URLs share one expires_at moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EntitlementPacketBundleResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed (redirect to /:id/download), unsupported scope, or download limit reached.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Storage presign failure or missing bundle revision row. Counter NOT decremented; no audit emitted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/llm-ready-pack":{"get":{"operationId":"getEntitledLlmReadyPack","tags":["Authenticated retrieval"],"summary":"Export a deterministic LLM-ready pack for a bundle-backed entitlement (buyer / entitled agent).","description":"Key access is the default way to use a packet; this export is the portable fallback. Returns a presigned URL (TTL 600 seconds) to a generated, deterministic ZIP bundling the documentation an assistant needs (README_FOR_LLM, ROUTER, RIGHTS, PROVENANCE, EVALUATION, LIMITATIONS, USAGE_PROMPTS, DELIVERY_NOTES, and CITATION_MAP.json or SOURCES.md), the bundle MANIFEST.json, the original source files under originals/, and a checks/checksums.sha256 manifest. Re-exports of the same revision are byte-identical (same generated_sha256). State machine PENDING -> MATERIALIZING -> READY -> EXPIRED; a 202 with poll_after_seconds is returned while materializing. Zero download_count decrement. Cross-org access collapses to 404; single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED. Response headers carry Cache-Control: no-store, private and Referrer-Policy: no-referrer.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Presigned URL to the generated LLM-ready export ZIP + generated-artifact envelope."},"202":{"description":"Pack is materializing; retry after poll_after_seconds."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed, unsupported scope, or pack generation failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/source-archive":{"get":{"operationId":"getEntitledSourceArchive","tags":["Authenticated retrieval"],"summary":"Download the original source files of a bundle-backed entitlement as one archive (buyer / entitled agent).","description":"The original source archive is the secondary, raw-file delivery path (key access is the default usage path; the LLM-ready pack is the portable export). Returns a presigned URL (TTL 600 seconds) to a generated, deterministic ZIP of every source-original asset under the entitlement's bundle revision. State machine PENDING -> MATERIALIZING -> READY -> EXPIRED; a 202 with poll_after_seconds is returned while materializing. Zero download_count decrement. Cross-org access collapses to 404; single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED. Response headers carry Cache-Control: no-store, private and Referrer-Policy: no-referrer.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Presigned URL to the generated source archive ZIP + generated-artifact envelope."},"202":{"description":"Archive is materializing; retry after poll_after_seconds."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed, unsupported scope, or archive generation failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/machine-zip":{"get":{"operationId":"getEntitledMachinePacketZip","tags":["Authenticated retrieval"],"summary":"Download the machine packet ZIP for a bundle-backed entitlement (buyer / packet access key).","description":"Returns a presigned URL (TTL 600 seconds) to the generated MACHINE_PACKET_ZIP for the bundle revision pinned on the entitlement. Accepts a buyer JWT or a `gpak_live_*` packet access key; a key may only fetch the ZIP of its own bound entitlement — any other entitlement collapses to 404. State machine PENDING -> MATERIALIZING -> READY; a 202 with poll_after_seconds is returned while materializing. Cross-org access collapses to 404; single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED. Response headers carry Cache-Control: no-store, private and Referrer-Policy: no-referrer. The response never carries a raw key, token hash, or internal storage path.","security":[{"bearerAuth":[]},{"packetAccessKeyBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Presigned URL to the generated machine packet ZIP + generated-artifact envelope."},"202":{"description":"ZIP is materializing; retry after poll_after_seconds."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed or ZIP generation failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/packet-access-manifest":{"get":{"operationId":"getPacketAccessManifest","tags":["Authenticated retrieval"],"summary":"Machine-readable access manifest for a bundle-backed entitlement (buyer / packet access key).","description":"Returns the packet access manifest: allowed delivery modes, allowed asset scopes, and the delivery endpoints available for the entitlement's bundle revision. Accepts a buyer JWT or a `gpak_live_*` packet access key; a key may only read the manifest of its own bound entitlement — any other entitlement collapses to 404. The manifest never carries a raw key, token hash, presigned URL, or internal storage path. When the listing's Rights Passport declares metered agent access, the manifest additionally carries the OPTIONAL passthrough fields `agent_metered_access` (boolean) and `credit_unit_label` (string, 1..64 chars, e.g. `per_call`); both fields are absent otherwise (disclosure only, never an enforcement signal). Cross-org access collapses to 404; single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED. Cache-Control: no-store, private.","security":[{"bearerAuth":[]},{"packetAccessKeyBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Packet access manifest."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/packet-access-keys":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"createPacketAccessKey","tags":["Authenticated retrieval"],"summary":"Issue a durable packet access key for an entitlement (raw key returned ONCE).","description":"Issues a durable, revocable, read-only `gpak_live_*` packet access key bound to this entitlement. The raw key plaintext is returned EXACTLY ONCE in the response body and never stored on the server (only the sha256 token hash + a non-secret display prefix). Default: no expiration — the key works for as long as the entitlement does and always serves the entitlement's CURRENT bundle revision (a one-time purchase pins; a subscription rolls to new revisions with no key regeneration); a fixed TTL (>= 30 days) is the explicit opt-in via ttl_seconds. Buyer JWT only — a delegated pass or key can never mint another. Cross-org access collapses to 404. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Key issued; raw key in response body (once).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid issue body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listEntitlementPacketAccessKeys","tags":["Authenticated retrieval"],"summary":"List the packet access keys issued for an entitlement (key management).","description":"Org-scoped key-management projection for one entitlement: key id, display prefix, label, created_at, expires_at, revoked_at, last_used_at. NEVER returns the raw key or the token hash. Buyer JWT only. Cross-org access collapses to 404. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Non-secret key list (display prefix + lifecycle timestamps).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/packet-access-keys/{keyId}/revoke":{"post":{"operationId":"revokePacketAccessKey","tags":["Authenticated retrieval"],"summary":"Revoke a packet access key.","description":"Revokes a `gpak_live_*` packet access key by id. Idempotent — an already-revoked key returns success. Buyer JWT only. Cross-org / non-existent key collapses to 404. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"keyId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Key revoked (or already revoked).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/agent-access-links":{"post":{"operationId":"createAgentAccessLink","tags":["Authenticated retrieval"],"summary":"Create a browser Agent Access Link for an entitlement (access URL returned ONCE).","description":"Creates a scoped, revocable, read-only browser access link for the entitlement's bundle revision. The link verifier is embedded in the `access_url` returned EXACTLY ONCE in the response body; only its sha256 hash is stored. The link resolves to a no-JS, noindex page minting short-lived object URLs — never a raw provider secret or a long-lived presigned URL. Buyer JWT only — an access link can never mint or revoke another. Cross-org access collapses to 404. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Link created; access URL in response body (once).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid create body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/agent-access-links/{linkId}/revoke":{"post":{"operationId":"revokeAgentAccessLink","tags":["Authenticated retrieval"],"summary":"Revoke a browser Agent Access Link.","description":"Revokes an Agent Access Link by id. Idempotent — an already-revoked link returns success. Buyer JWT only. Cross-org / non-existent link collapses to 404. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"linkId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Link revoked (or already revoked).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/llm-access-profiles":{"post":{"operationId":"generateLlmAccessProfiles","tags":["Authenticated retrieval"],"summary":"Generate client-specific LLM access profiles for an entitlement.","description":"Generates setup instructions per selected LLM client/runtime from the compatibility registry: header API-key setup, OAuth/action setup, MCP connector setup, browser Agent Access Link, or machine ZIP delivery — chosen per client. The response carries setup guidance and endpoint references only; it never embeds a raw key or provider secret. Buyer JWT only. Cross-org access collapses to 404; single-file entitlements receive 422 ENTITLEMENT_NOT_BUNDLE_BACKED. Cache-Control: no-store, private.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Per-client access profiles.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid profile request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Entitlement not bundle-backed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/download":{"get":{"operationId":"downloadEntitlement","tags":["Authenticated retrieval"],"summary":"Fetch a presigned download URL for an owned entitlement (buyer).","description":"Returns a presigned URL the caller can fetch directly for a bounded TTL (currently 600 seconds; <= 15 minutes per platform rule). Each call atomically increments `download_count` and fails with 422 DOWNLOADS_EXHAUSTED when the max is reached. Only FULL-scope entitlements support download today. Bundle-backed entitlements receive 422 ENTITLEMENT_BUNDLE_BACKED here with `details.redirect_path` pointing at /v1/entitlements/{id}/packet-bundle. When the underlying packet listing is signed, the response carries six X-Graunt-* headers identical to those served by GET /v1/listings/{id}/manifest, enabling buyers to verify (manifest_hash, merkle_root, signed_at, signature, key_id, custody_tier) at download time.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Presigned download URL + remaining-quota envelope. Six X-Graunt-* headers present when the listing is signed.","headers":{"X-Graunt-Manifest-Hash":{"description":"sha256:<64hex> packet manifest hash (signed listings only).","schema":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"X-Graunt-Merkle-Root":{"description":"sha256:<64hex> packet Merkle root (signed listings only).","schema":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"X-Graunt-Signed-At":{"description":"ISO-8601 UTC millisecond timestamp from published_manifests.signed_at (signed listings only).","schema":{"type":"string","format":"date-time"}},"X-Graunt-Signature":{"description":"Base64 Ed25519 signature over manifest_hash || '|' || merkle_root || '|' || signed_at_iso (signed listings only).","schema":{"type":"string"}},"X-Graunt-Key-Id":{"description":"Signer key identifier (signed listings only).","schema":{"type":"string","pattern":"^skey_[A-Za-z0-9]{22}$"}},"X-Graunt-Custody-Tier":{"description":"Custody-tier disclosure (signed listings only).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DownloadResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Download limit reached or entitlement scope not supported.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Integrity data mismatch — signed listing is missing the matching published_manifests row. Counter NOT decremented.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{listingId}/splices/preflight":{"post":{"operationId":"preflightPacketSplice","tags":["Authenticated retrieval"],"summary":"Preview the source_requirement_set + delivery plan for a controlled splice (no write, no enqueue).","description":"Returns a PACKET_SPLICE_PREFLIGHT envelope carrying the resolved source_requirement_set (asset IDs + paths + content hashes + per-file sizes + required-reason) and a 'SPLICE_BUNDLE' delivery plan. Does NOT create a splice row, does NOT enqueue any work, does NOT expose pre-entitlement private fields. Caller must hold an ACTIVE FULL entitlement bound to the listing's packet_bundle_revision. Cross-org or non-entitled requests collapse to 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Preflight envelope with source_requirement_set + delivery plan.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"LISTING_NOT_BUNDLE_BACKED or UNSUPPORTED_SCOPE.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/splice-bundles":{"post":{"operationId":"createEntitledSpliceBundle","tags":["Authenticated retrieval"],"summary":"Create a controlled splice bundle build for an entitled listing.","description":"Creates an immutable splice requirement row, then creates or reuses a generated_artifacts row (kind=SPLICE_BUNDLE; parent_kind=PACKET_BUNDLE_REVISION). Enqueues an async build when Redis is available; otherwise runs inline. Returns an ENTITLED_SPLICE_BUNDLE envelope (200 READY / 202 PENDING or MATERIALIZING / 422 FAILED). Presigned URL only when state=READY. Cross-org access collapses to 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Splice bundle READY (presigned URL included).","content":{"application/json":{"schema":{"type":"object"}}}},"202":{"description":"Splice bundle PENDING / MATERIALIZING.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"FAILED build outcome, UNSUPPORTED_SCOPE, or ENTITLEMENT_NOT_BUNDLE_BACKED.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/splice-bundles/{spliceBundleId}":{"get":{"operationId":"getEntitledSpliceBundle","tags":["Authenticated retrieval"],"summary":"Fetch the latest state of an entitled splice bundle build.","description":"Returns the splice requirement row + the most-recent generated_artifacts envelope. Presigned URL only when state=READY (entitled delivery). Cross-org or non-entitled requests collapse to 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"spliceBundleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"ENTITLED_SPLICE_BUNDLE envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"SPLICE_BUNDLE_NOT_MATERIALIZED (no generated artifact yet).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/working-sets":{"post":{"operationId":"createEntitledWorkingSet","tags":["Authenticated retrieval"],"summary":"Create a bounded subscription working set for an entitled listing.","description":"Creates a subscription working-set row (caps: 32 files, 256 MiB total, 7-day default TTL), then creates or reuses a generated_artifacts row (kind=SUBSCRIPTION_WORKING_SET_BUILD; parent_kind=SUBSCRIPTION_WORKING_SET). Enqueues an async build when Redis is available; otherwise runs inline. Returns an ENTITLED_WORKING_SET envelope. Presigned URL only when state=READY. Subscription-pinned: revokes when the bound subscription transitions to CANCELED or EXPIRED. Cross-org access collapses to 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Working set READY (presigned URL included).","content":{"application/json":{"schema":{"type":"object"}}}},"202":{"description":"Working set PENDING / MATERIALIZING.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"FAILED build, UNSUPPORTED_SCOPE, ENTITLEMENT_NOT_BUNDLE_BACKED, or cap exceeded (WORKING_SET_CAP_*).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/entitlements/{id}/working-sets/{workingSetId}":{"get":{"operationId":"getEntitledWorkingSet","tags":["Authenticated retrieval"],"summary":"Fetch the latest state of an entitled subscription working set.","description":"Returns the working-set row + most-recent generated_artifacts envelope. Presigned URL only when state=READY. Cross-org or non-entitled requests collapse to 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"workingSetId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"ENTITLED_WORKING_SET envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"WORKING_SET_NOT_MATERIALIZED (no generated artifact yet).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/packet-bundles/assembly-sessions":{"post":{"operationId":"createAgentPacketAssemblySession","tags":["Authenticated retrieval"],"summary":"Create an agent-driven packet-bundle assembly session.","description":"Reuses the canonical packet upload-session substrate. The agent assembly_session_id IS the packet_upload_session.id. Requires `grnt_agent_*` bearer with the `bundle:assemble` scope. JWT and api_key callers are rejected with 403 BEFORE any DB call (bearer-prefix discrimination).","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"AGENT_PACKET_ASSEMBLY_SESSION created.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS (auth path or scope).","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"BUNDLE_ARCHIVED.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/packet-bundles/assembly-sessions/{id}/files":{"post":{"operationId":"addAgentPacketAssemblyFile","tags":["Authenticated retrieval"],"summary":"Register a file in an open assembly session and mint a presigned PUT URL.","description":"Reuses registerUploadSessionAsset. Returns AGENT_PACKET_ASSEMBLY_FILE_ACCEPTED with a presigned PUT URL that the agent uses to upload its own session's bytes (write contract, not pre-entitlement delivery). TTL is bounded by the canonical service.","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"AGENT_PACKET_ASSEMBLY_FILE_ACCEPTED.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"ASSEMBLY_SESSION_NOT_OPEN / ASSEMBLY_SESSION_MAX_ASSETS / ASSEMBLY_SESSION_DUPLICATE_ORDERING / ASSEMBLY_FILE_FILENAME_UNSAFE.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/packet-bundles/assembly-sessions/{id}/finalize":{"post":{"operationId":"finalizeAgentPacketAssemblySession","tags":["Authenticated retrieval"],"summary":"Finalize the assembly session (freezes the packet_bundle_revision; byte-equivalent with human-assembled bundles).","description":"Reuses finalizeUploadSession. Returns AGENT_PACKET_ASSEMBLY_FINALIZED carrying packet_bundle_revision_id, manifest_sha256, sidecar_manifest_sha256, and next_action='SUBMIT_LISTING_OR_REVIEW'. NEVER publishes a listing. Subsequent listing creation goes through the canonical marketplace publish review gate.","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"AGENT_PACKET_ASSEMBLY_FINALIZED.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"ASSEMBLY_SESSION_NOT_OPEN.","content":{"application/json":{"schema":{"type":"object"}}}},"422":{"description":"ASSEMBLY_VALIDATION_FAILED.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/packet-bundles/assembly-sessions/{id}":{"get":{"operationId":"getAgentPacketAssemblySession","tags":["Authenticated retrieval"],"summary":"Read the state of an agent-owned assembly session.","description":"Reuses getUploadSessionForOrg. Returns AGENT_PACKET_ASSEMBLY_SESSION with status, file_count, total_bytes, packet_bundle_revision_id (when finalized), and next_action. Cross-org access collapses to 404 (existence-leak guard).","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"AGENT_PACKET_ASSEMBLY_SESSION.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"delete":{"operationId":"abandonAgentPacketAssemblySession","tags":["Authenticated retrieval"],"summary":"Abandon an open assembly session (idempotent on terminal sessions).","description":"Reuses abandonUploadSession. Idempotent: terminal sessions return 200 (already abandoned). Finalized sessions return 409.","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"AGENT_PACKET_ASSEMBLY_ABANDONED.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"ASSEMBLY_SESSION_FINALIZED.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/listings/{listingId}/publication-readiness":{"get":{"operationId":"getAgentPublicationReadiness","tags":["Authenticated retrieval"],"summary":"Read the current publication-review readiness for an agent-visible listing (PREVIEW).","description":"Returns the agent-safe shape derived from the most recent publication-review run for the listing. Requires `grnt_agent_*` bearer with the `publish:review_read` scope. The response body NEVER exposes internal risk tier, recommended decision, routing outcome, deterministic gate results, raw LLM triage receipts, or any internal-only field. Cross-org or non-owned listings collapse to 404 (existence-leak guard). When the listing has no review run yet, returns 409 PUBLICATION_REVIEW_NOT_READY. Agent-initiated mutation endpoints on this surface are not available and return 409 DENY_CAPABILITY_NOT_LIVE.","security":[{"agentBearerAuth":[]}],"parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Agent-safe publication-readiness envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS (auth path or missing `publish:review_read` scope).","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"PUBLICATION_REVIEW_NOT_READY — no review run exists for this listing yet.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/datasets":{"post":{"operationId":"uploadDataset","tags":["Seller"],"summary":"Upload a dataset file with metadata (seller).","description":"Multipart upload. The asset is stored, the row count (for DATASET) or excerpt (for TEXT_ASSET) is extracted, and packet checks are recorded asynchronously. Poll GET /v1/datasets/{id} to track qc_status.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file","name","description","category","asset_class","data_purpose","intended_uses","rights_attestation"],"properties":{"file":{"type":"string","format":"binary"},"name":{"type":"string"},"description":{"type":"string","minLength":50},"category":{"type":"string"},"asset_class":{"type":"string","enum":["DATASET","TEXT_ASSET"]},"data_purpose":{"type":"string","description":"JSON-encoded array of declared purposes."},"intended_uses":{"type":"string","description":"JSON-encoded array of intended-use strings."},"rights_attestation":{"type":"string","enum":["true","false"]}}}}}},"responses":{"201":{"description":"Dataset accepted for QC.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadDatasetResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Too many multipart parts or form fields.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Error envelope — `ok` is false and `error` carries a stable code + message.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Service temporarily unavailable — the rate-limit substrate could not confirm capacity safely and the request was held back rather than processed. `Retry-After` carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"SERVICE_TEMPORARILY_UNAVAILABLE\"` and a bounded `retry_after_seconds` field.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listMyDatasets","tags":["Authenticated retrieval"],"summary":"List datasets owned by the caller's org (seller).","description":"Paginated list of the caller's own datasets. Includes lifecycle status, QC state, and file metadata. Does NOT include buyer data or other sellers' datasets.","security":[{"bearerAuth":[]}],"parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"status","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Paginated dataset envelope scoped to the caller's org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListDatasetsResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings":{"get":{"operationId":"listSellerListings","tags":["Seller"],"summary":"List the caller's listings (seller persona).","description":"Paginated, org-scoped inventory of listings owned by the caller. SELLER and BOTH only. Returns denormalized fields per row including delivery_kind (SINGLE_FILE | PACKET_BUNDLE) and packet_bundle_revision_id when applicable. Sorted by created_at DESC. Backs the seller-dashboard \"My Listings\" panel.","security":[{"bearerAuth":[]}],"parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},{"name":"per_page","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}}],"responses":{"200":{"description":"Paginated listing envelope scoped to the caller's org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListSellerListingsResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings/{id}":{"get":{"operationId":"getSellerListingDetail","tags":["Seller"],"summary":"Get seller-private listing detail (all owned statuses).","description":"Returns the full seller-private detail for a single listing owned by the caller's org, across ALL statuses (PENDING_REVIEW, ACTIVE, PAUSED, ARCHIVED, REJECTED, SUSPENDED, NEEDS_REFINEMENT). Distinct from public GET /v1/listings/{id} which is hard-gated to ACTIVE. Cross-org listings return 404 (no 403 leak). The response carries validation_findings (manifest-level findings projected from packet_validation_report), last_admin_review (bounded summary of the most-recent admin event in the closed allowlist; never carries actor identity or raw payload), and available_actions.can_resubmit_for_review.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Seller listing detail.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetSellerListingDetailResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Listing does not exist or is owned by another org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings/{id}/packet-bundle":{"get":{"operationId":"getSellerListingPacketBundle","tags":["Seller"],"summary":"Get seller-private packet-bundle detail for a listing.","description":"Returns the bundle's frozen-revision metadata + per-asset rows (sorted by ordering) for bundle-backed listings owned by the caller. Single-file listings, cross-org listings, and unknown listing ids all return 404 — existence is never leaked. NEVER includes s3_key, download_url, presigned URLs, or X-Amz-* artefacts. Mirrors the schema_version=2 logical/physical asset grouping used by the buyer-facing manifest endpoint.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Seller listing packet-bundle detail.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetSellerListingPacketBundleResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Listing not found, owned by another org, or single-file (no bundle).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings/{id}/resubmit":{"post":{"operationId":"resubmitSellerListing","tags":["Seller"],"summary":"Resubmit a NEEDS_REFINEMENT listing back to PENDING_REVIEW.","description":"Seller-driven NEEDS_REFINEMENT → PENDING_REVIEW transition. Runs the manifest-only publish-gate validators (structure + presence + coherence) on the listing's stored packet_manifest BEFORE flipping status. If any finding has blocks_publish=true, returns 409 with code LISTING_RESUBMIT_BLOCKED + bounded findings array; status stays NEEDS_REFINEMENT and no audit row is written. On success, emits LISTING_RESUBMITTED audit and returns the refreshed seller-detail. Idempotency-Key header (16-128 chars, [A-Za-z0-9_-]) routes through the existing reservation service; same key + same fingerprint replays.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9_-]+$"}}],"responses":{"200":{"description":"Status flipped to PENDING_REVIEW; refreshed seller-detail returned.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetSellerListingDetailResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Listing not found or owned by another org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Wrong status (not NEEDS_REFINEMENT) OR blocking validation findings remain (code: LISTING_RESUBMIT_BLOCKED) OR Idempotency-Key conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/validate-manifest":{"post":{"operationId":"validateListingManifestDryRun","tags":["Seller"],"summary":"Read-only dry-run of manifest validation for a seller-owned listing.","description":"Composes the same packet-manifest validators (structure + presence + coherence) used by the publish gate WITHOUT mutating the listing. NO listings.updated_at change. NO listings.validation_status change. NO audit_log INSERT. NO packet_bundle mutation. Body is optional; when provided, packet_manifest / version_identifier / packet_kind override the listing's stored values for the dry-run only. Empty body validates the listing as-is. Status gate accepts PENDING_REVIEW or NEEDS_REFINEMENT.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"packet_manifest":{},"packet_kind":{"type":["string","null"]},"version_identifier":{"type":["string","null"]}}}}}},"responses":{"200":{"description":"Dry-run completed (findings array may be empty or non-empty; would_block_publish indicates publish-gate outcome).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValidateListingManifestDryRunResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Listing not found or owned by another org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Wrong status (not PENDING_REVIEW or NEEDS_REFINEMENT).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/packet-bundles":{"get":{"operationId":"listSellerPacketBundles","tags":["Seller"],"summary":"List the caller's packet bundles (seller persona).","description":"Paginated, org-scoped list of packet bundles owned by the caller, with each bundle's latest revision metadata inline (revision_number, manifest_sha256, total_bytes, asset_count, frozen_at). Backs seller bundle-picker surfaces. SELLER and BOTH only. When `finalized=true` (the primary use case), only bundles that have at least one frozen revision are returned. Never returns presigned URLs or s3_keys.","security":[{"bearerAuth":[]}],"parameters":[{"name":"finalized","in":"query","schema":{"type":"string","enum":["true","false"]}},{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},{"name":"per_page","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],"responses":{"200":{"description":"Paginated packet bundle envelope scoped to the caller's org.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListSellerPacketBundlesResponse"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/payouts/{splitId}/retry":{"post":{"operationId":"retryMyPayout","tags":["Seller"],"summary":"Retry a failed payout for the caller's seller org.","description":"Seller-owned retry of a FAILED payout split. Re-arms the split to PENDING through the same locked, conditional transition the operator path uses, then runs the same transfer — there is one payout state machine, not two. A PENDING or HELD split returns 200 with outcome already_queued rather than an error, because it is already on its way. A split that has already paid, that was refunded to the buyer, or whose earlier attempt could not be confirmed with Stripe returns 409 and is never re-sent. A split belonging to another org returns 404, never 403. Failed payouts also retry automatically on a bounded schedule; this endpoint exists so a seller never has to wait for an operator. Idempotency-Key header (16-128 chars, [A-Za-z0-9_-]) routes through the existing reservation service; same key + same fingerprint replays the recorded response.","security":[{"bearerAuth":[]}],"parameters":[{"name":"splitId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9_-]+$"}}],"responses":{"200":{"description":"The retry was accepted. `outcome` reports what happened: TRANSFERRED, FAILED, WAITING_FUNDS, NEEDS_RECONCILIATION, SKIPPED, or already_queued.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"data":{"type":"object","additionalProperties":true}}}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Not retryable: already paid, refunded to the buyer, being reconciled with Stripe, or the connected account cannot currently receive payouts."},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/payouts":{"get":{"operationId":"listMyPayouts","tags":["Seller"],"summary":"List payout splits for the caller's seller org.","description":"Read-only view of per-purchase payout splits (PENDING, HELD, TRANSFERRED, FAILED). Payouts are individual Stripe Transfers; a 72-hour hold applies to first-time sellers.","security":[{"bearerAuth":[]}],"parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},{"name":"per_page","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}}],"responses":{"200":{"description":"Paginated payout envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListPayoutsResponse"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings/{id}/withdraw":{"post":{"operationId":"withdrawListing","tags":["Seller"],"summary":"Seller withdraw of an ACTIVE, PAUSED, or in-review listing.","description":"Transitions an ACTIVE, PAUSED, PENDING_REVIEW, or NEEDS_REFINEMENT listing to ARCHIVED with `archive_reason_code` stamped on the row. Pre-publication pullback requires (and is the only valid use of) reason SELLER_WITHDRAWN_FROM_REVIEW; a submission withdrawn that way can be returned to review with restoreWithdrawnListing — every other archived reason is final. A retry against a row this org already archived with the same reason replays 200. Cross-org access returns 404 (existence-leak guard). SELLER or BOTH org-type required.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["archive_reason_code","idempotency_key"],"properties":{"archive_reason_code":{"type":"string","enum":["SELLER_VOLUNTARY","SELLER_AUP_DISCOVERED","SELLER_RIGHTS_REVOKED","SELLER_QUALITY_ISSUE","OPERATOR_TAKEDOWN_PREP","SELLER_WITHDRAWN_FROM_REVIEW"]},"decision_note":{"type":"string","minLength":1,"maxLength":2000},"idempotency_key":{"type":"string","minLength":1,"maxLength":255}}}}}},"responses":{"200":{"description":"Withdraw applied."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Only SELLER or BOTH may withdraw.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"State conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/support":{"post":{"operationId":"createSupportIssue","tags":["Support"],"summary":"Open a support issue, question, or product feedback.","description":"Creates a tracked support issue. Signed-in orgs (JWT or api_key) submit under their org and read replies through their issue list; agent bearer credentials require the support:create scope. Anonymous callers may submit with a contact_email, which is salted-hashed immediately and never stored raw — anonymous reports are reviewed and acted on but cannot receive a direct reply (sign in for a tracked answer). An Idempotency-Key header is required — the same key replays the recorded outcome instead of opening a duplicate. Rate-limited per org (or per hashed contact). Read-only delegated credentials (access passes, packet access keys) are refused. issue_kind FEEDBACK is the product-feedback lane; subject_ref_kind/subject_ref_id optionally tie the issue to an order, listing, payout, or library item.","security":[],"parameters":[{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":1,"maxLength":200}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["requester_kind","issue_kind","body"],"properties":{"requester_kind":{"type":"string","enum":["BUYER","SELLER","RIGHTS","GENERAL"]},"issue_kind":{"type":"string","enum":["PURCHASE","ACCESS","LISTING","PACKET","PAYOUT","RIGHTS_REVIEW","GENERAL","FEEDBACK"]},"subject_ref_kind":{"type":"string","enum":["ORDER","LISTING","PAYOUT","LIBRARY_ITEM"],"nullable":true},"subject_ref_id":{"type":"string","format":"uuid","nullable":true},"body":{"type":"string","minLength":1,"maxLength":4000},"contact_email":{"type":"string","format":"email","maxLength":255,"description":"Required only for anonymous submissions; hashed server-side, never stored raw."}}}}}},"responses":{"200":{"description":"Idempotency replay of a previously-created issue."},"201":{"description":"Issue created. `data.support_issue_id` + `data.state` (OPEN)."},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"The Idempotency-Key is in flight, or was used with a different body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Per-org / per-contact rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/support/issues":{"get":{"operationId":"listMySupportIssues","tags":["Support"],"summary":"List the caller org's own support issues.","description":"Newest-first list of the authenticated org's support issues (id, kinds, state, timestamps — the message body is not echoed back). Cross-org rows are never returned.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Issue list envelope (`data.support_issues`)."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/support/issues/{id}":{"get":{"operationId":"getMySupportIssue","tags":["Support"],"summary":"Read one of the caller org's own support issues.","description":"Single-issue view, requester-org-scoped. A cross-org or unknown id returns 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Issue envelope (`data.support_issue`)."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/listings/{id}/restore-withdrawn":{"post":{"operationId":"restoreWithdrawnListing","tags":["Seller"],"summary":"Restore a submission withdrawn from review.","description":"Returns an ARCHIVED listing whose archive_reason_code is SELLER_WITHDRAWN_FROM_REVIEW to PENDING_REVIEW — same id, same lineage; edit what needs fixing, then re-run the publication checks. Every other archived reason is final and refuses with 409. Cross-org access returns 404 (existence-leak guard). SELLER or BOTH org-type required.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Restored to PENDING_REVIEW."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Not restorable: the listing is not ARCHIVED, or it was archived for a reason other than withdraw-from-review.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/listings/{listingId}/publication-review-runs":{"post":{"operationId":"agentResubmitPublicationReview","tags":["Authenticated retrieval"],"summary":"Re-run the publication review on the agent's own held listing.","description":"Agent bearer + sell:submit scope, under the same execution controls as agent listing creation (agent execution kill switch, execution-manifest authority, fail-closed SELL rate limit). Creates a fresh deterministic publication-review run for a PENDING_REVIEW listing the caller's org owns, evaluates any open fix contract against the new findings, and drives the same automatic publication flow a human resubmit drives — publication itself still transits only the canonical publication gate. Optional Idempotency-Key header (16-128 chars, [A-Za-z0-9_-]) replays the same run; a malformed key is a 400. Cross-org or unknown listings return 404; a listing in any other status returns 409.","security":[{"bearerAuth":[]}],"parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9_-]+$"}}],"responses":{"201":{"description":"The new run's agent-safe readiness envelope (findings, public_status, fix contract)."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"The listing is not awaiting publication review.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/held-sales":{"get":{"operationId":"listSellerHeldSales","tags":["Seller"],"summary":"List the seller's early-access (held) sales and the steps needed to collect them.","description":"Org-scoped, read-only. Returns held sales bucketed as waiting (an early-access authorization is held and can be collected once the seller's remaining steps clear), collected (captured and paid), and expired (the authorization lapsed; the buyer kept early access and the seller was not charged the buyer). Each waiting sale lists the concrete steps the seller must complete to collect — the packet publishing, accepting seller terms, completing the seller profile, and finishing payout setup — and a ready_to_collect flag. This surface is display only; capture and release run server-side.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Held-sales envelope: { waiting[], collected[], expired[] }."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/demand/summary":{"get":{"operationId":"getSellerDemandSummary","tags":["Seller"],"summary":"Recent weeks of marketplace search demand matched to the seller's private items.","description":"Org-scoped, read-only, JWT-only. Returns up to `weeks` (default 4, max 12) recent weeks. Each week lists the seller's own private items that matched marketplace search activity, with an aggregate matched-search count and the item's OWN matched topic tokens. Aggregate counts only — never the search-term text, never who searched, never a ranking or quality signal. Returns 404 when the demand feature is not enabled.","security":[{"bearerAuth":[]}],"parameters":[{"name":"weeks","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":12,"default":4}}],"responses":{"200":{"description":"Demand summary: { weeks_requested, weeks: [{ week_epoch, items: [{ private_item_id, item_display_name, matched_search_count, matched_topic_tokens }] }] }."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/demand/notifications":{"get":{"operationId":"getSellerDemandNotifications","tags":["Seller"],"summary":"The seller's weekly demand-notification digests, newest first.","description":"Org-scoped, read-only, JWT-only, paginated (`limit` default 20 / max 100, `offset`). Each digest summarises a closed week's matched search activity across the org's private items (item count, total matched-search count, and per-item entries). Aggregate counts only; never search-term text. Returns 404 when the demand feature is not enabled.","security":[{"bearerAuth":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"Digest list: { notifications: [{ id, week_epoch, item_count, total_matched_search_count, items, email_sent_at, created_at }], pagination }."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/demand/preferences":{"patch":{"operationId":"updateSellerDemandPreferences","tags":["Seller"],"summary":"Update the seller's demand-notification email preference.","description":"Org-scoped, JWT-only. Sets whether the org receives the weekly demand-digest EMAIL. Opting out suppresses the email only — the in-app digest surface remains available. Returns 404 when the demand feature is not enabled.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email_opt_out"],"additionalProperties":false,"properties":{"email_opt_out":{"type":"boolean"}}}}}},"responses":{"200":{"description":"Updated preference: { email_opt_out, updated_at }."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/signing-keys":{"post":{"operationId":"registerSigningKey","tags":["Seller"],"summary":"Register a server-generated Ed25519 signing key (seller).","description":"Server generates an Ed25519 keypair; the public key is exposed and the private key is stored encrypted at rest under the per-deploy KEK (server-assisted custody). Body is empty — caller-supplied keys are not accepted. Auth: orgType ∈ {SELLER, BOTH}.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Public view of the new key (no envelope fields).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listMySigningKeys","tags":["Seller"],"summary":"List the caller's signing keys (any status).","description":"Returns ACTIVE, ROTATED, and REVOKED entries owned by the caller. Envelope fields (encrypted_private_key_b64, IV, tag) are never returned.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Owner view envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/signing-keys/{keyId}/rotate":{"parameters":[{"name":"keyId","in":"path","required":true,"schema":{"type":"string","pattern":"^skey_[A-Za-z0-9]{22}$"}}],"post":{"operationId":"rotateSigningKey","tags":["Seller"],"summary":"Rotate the named signing key (atomic).","description":"Marks the named ACTIVE key as ROTATED and creates a new ACTIVE key in the same call (integrity-model §4). Old signatures continue to verify against the rotated public key.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Rotated + new active key views.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/signing-keys/{keyId}/revoke":{"parameters":[{"name":"keyId","in":"path","required":true,"schema":{"type":"string","pattern":"^skey_[A-Za-z0-9]{22}$"}}],"post":{"operationId":"revokeSigningKey","tags":["Seller"],"summary":"Revoke the named signing key (forward-only).","description":"Marks the key REVOKED. Signatures produced before revocation remain valid (integrity-model §4 forward-only revocation). Does not require KEK access.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"reason":{"type":"string","minLength":1,"maxLength":256}}}}}},"responses":{"200":{"description":"Public view of the revoked key.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/meta/signing-keys":{"get":{"operationId":"metaSigningKeys","tags":["Public discovery"],"summary":"Public registry of signing keys for buyer verification.","description":"Returns ACTIVE, ROTATED, and REVOKED public keys across all orgs. Buyers use this endpoint to obtain the public key referenced by `X-Graunt-Key-Id` on a signed response, then verify the tuple `manifest_hash || '|' || merkle_root || '|' || signed_at_iso`. Public — no auth.","security":[],"responses":{"200":{"description":"Signing-key catalog (no envelope fields).","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"Database unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-upload-sessions":{"post":{"operationId":"createPacketUploadSession","tags":["Seller"],"summary":"Create a packet upload session (seller).","description":"Creates a transient OPEN session that gathers asset uploads before freezing into a `packet_bundle_revision`. Either supply `name` (and optional `description`) to create a new bundle, or supply `bundle_id` to attach to an existing bundle in the caller's org. `idempotency_key` is required and replays an in-progress or completed call deterministically via the existing reservation/replay envelope shared with other write routes. Rate-limited per organization; a legitimate retry with the same Idempotency-Key + body replays the cached response without consuming an additional rate-limit slot. SELLER and BOTH only.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["idempotency_key"],"properties":{"idempotency_key":{"type":"string","minLength":32,"maxLength":128},"bundle_id":{"type":"string","format":"uuid"},"name":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","maxLength":4000},"max_asset_count":{"type":"integer","minimum":1,"maximum":10000},"max_total_bytes":{"type":"integer","minimum":1}}}}}},"responses":{"201":{"description":"Session created.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"idempotency_key conflict or bundle archived.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Service temporarily unavailable — the rate-limit substrate could not confirm capacity safely and the request was held back rather than processed. `Retry-After` carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"SERVICE_TEMPORARILY_UNAVAILABLE\"` and a bounded `retry_after_seconds` field.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-upload-sessions/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getPacketUploadSession","tags":["Authenticated retrieval"],"summary":"Read a packet upload session's state, asset list, and last_validation_result.","description":"Org-scoped read. Returns the session state machine value, the registered upload-session-asset rows (without presigned PUT URLs), the most recent finalize attempt's findings (when failed), and the bundle_revision_id (when finalized).","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Session view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"delete":{"operationId":"abandonPacketUploadSession","tags":["Seller"],"summary":"Abandon a packet upload session.","description":"Transitions an OPEN/FINALIZING session to ABANDONED. If the bundle has zero revisions and no other open sessions reference it, the session row and the empty bundle are deleted in the same transaction (no orphans).","security":[{"bearerAuth":[]}],"responses":{"204":{"description":"Session abandoned."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Session already finalized — abandon not permitted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-upload-sessions/{id}/assets":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"registerPacketUploadAsset","tags":["Seller"],"summary":"Register an asset in a packet upload session and receive a presigned PUT URL.","description":"Allocates a stable `asset_id` (preserved through finalize), constructs the transient S3 key, and returns a single-part presigned PUT URL with TTL ≤ 900 s. The seller PUTs object bytes directly to S3 over the URL's lifetime. Concurrent registers on the same `(session_id, ordering)` rejected with 422 DUPLICATE_ORDERING.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["original_filename","declared_size_bytes","declared_role","ordering","file_format"],"properties":{"original_filename":{"type":"string","minLength":1,"maxLength":255},"declared_size_bytes":{"type":"integer","minimum":0},"declared_content_sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"declared_role":{"type":"string","enum":["PRIMARY","SUPPORTING","EVIDENCE","MANIFEST","LEGAL_NOTICE"]},"ordering":{"type":"integer","minimum":0,"maximum":255},"file_format":{"type":"string","enum":["CSV","JSON","PARQUET","TEXT","JSONL","PDF"]}}}}}},"responses":{"201":{"description":"Asset registered; presigned PUT URL returned.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Session not in OPEN state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-upload-sessions/{id}/assets/{assetId}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"assetId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"delete":{"operationId":"deletePacketUploadAsset","tags":["Seller"],"summary":"Remove a registered asset from a packet upload session.","description":"Used to fix a failed-finalize finding (e.g., DELETE the offending asset, register a replacement at the same ordering, retry finalize). Already-deleted assets return 204 idempotently. The transient S3 object remains (lifecycle eventually cleans it up).","security":[{"bearerAuth":[]}],"responses":{"204":{"description":"Asset removed (or already absent)."},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Session not in OPEN state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-upload-sessions/{id}/finalize":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"finalizePacketUploadSession","tags":["Seller"],"summary":"Validate, hash, and freeze a packet bundle revision.","description":"Atomic OPEN→FINALIZING transition is the concurrency gate. Streams sha256 over each S3 object, runs eight deterministic checks (BUNDLE_EMPTY / BUNDLE_TOO_MANY_ASSETS / ASSET_FORMAT_DISALLOWED / ASSET_EMPTY / ASSET_TOO_LARGE / BUNDLE_OVERSIZE / BUNDLE_PRIMARY_INVARIANT / BUNDLE_DUPLICATE_CONTENT / ASSET_BYTE_SIZE_MISMATCH / ASSET_CONTENT_SHA_MISMATCH / ASSET_OBJECT_MISSING), copies objects to the frozen bundle prefix, and inserts the immutable revision under a SELECT FOR UPDATE on `packet_bundle`. On validation failure the session returns to OPEN with `last_validation_result` populated; the seller may DELETE/replace assets and retry. Rate-limited per organization; a legitimate retry with the same Idempotency-Key replays the cached response without consuming an additional rate-limit slot.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["idempotency_key"],"properties":{"idempotency_key":{"type":"string","minLength":32,"maxLength":128}}}}}},"responses":{"200":{"description":"Bundle revision frozen (or idempotent replay returned the existing revision).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Session is not OPEN (concurrent finalize race lost, or session already terminal).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"VALIDATION_FAILED — error.details.findings carries the failing check.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Service temporarily unavailable — the rate-limit substrate could not confirm capacity safely and the request was held back rather than processed. `Retry-After` carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"SERVICE_TEMPORARILY_UNAVAILABLE\"` and a bounded `retry_after_seconds` field.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/packet-bundles/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getPacketBundle","tags":["Authenticated retrieval"],"summary":"Read a packet bundle and its revision (seller / admin).","description":"Org-scoped read. Returns the bundle metadata and either the latest revision (default) or a specific `revision_number` when supplied as a query parameter. Each revision view includes the asset list (id, file_format, file_size_bytes, content_sha256, ordering, asset_role, original_filename) sorted by ordering.","security":[{"bearerAuth":[]}],"parameters":[{"name":"revision_number","in":"query","required":false,"schema":{"type":"integer","minimum":1}}],"responses":{"200":{"description":"Bundle + revision view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/manifest":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getListingManifest","tags":["Public discovery"],"summary":"Fetch the canonical packet manifest bytes (public).","description":"Returns the canonical UTF-8 bytes of `listings.packet_manifest`. The body's SHA-256 equals `X-Graunt-Manifest-Hash` (when signed) or can be recomputed by the buyer (always). When signed, six X-Graunt-* headers are emitted (Manifest-Hash, Merkle-Root, Signed-At, Signature, Key-Id, Custody-Tier). Public — no auth.","security":[],"responses":{"200":{"description":"Canonical manifest bytes.","headers":{"X-Graunt-Manifest-Hash":{"description":"sha256:<64hex> over the response body bytes (signed responses).","schema":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"X-Graunt-Merkle-Root":{"description":"sha256:<64hex> Merkle root over delivery artifact (signed responses).","schema":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"X-Graunt-Signed-At":{"description":"ISO-8601 UTC millisecond timestamp from published_manifests.signed_at (signed responses).","schema":{"type":"string","format":"date-time"}},"X-Graunt-Signature":{"description":"Base64 Ed25519 signature over manifest_hash || '|' || merkle_root || '|' || signed_at_iso (signed responses).","schema":{"type":"string"}},"X-Graunt-Key-Id":{"description":"Signer key identifier (skey_<22 base62>) — look up public key via /v1/meta/signing-keys.","schema":{"type":"string","pattern":"^skey_[A-Za-z0-9]{22}$"}},"X-Graunt-Custody-Tier":{"description":"Custody-tier disclosure. Always emits the server-assisted custody tier.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Integrity data mismatch — listing is signed but published_manifests row is missing or divergent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/bundle-manifest":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getListingBundleManifest","tags":["Public discovery"],"summary":"Fetch the per-asset bundle inventory (public).","description":"The packet bundle's public per-asset inventory: `kind: PACKET_BUNDLE_MANIFEST_PUBLIC`, `manifest_sha256`, `assets[]` (ordering, role, original_filename, file_format, file_size_bytes, content_sha256) and `asset_groups[]`. Every count names its population in `counts_basis`: `source_asset_count` / `source_total_bytes` cover the seller's originals; `generated_artifact_count` / `delivered_total_bytes` cover all delivered files including generated machine artifacts; `source_asset_count + generated_artifact_count == physical_asset_count`. Distinct from `/manifest`, which serves the structured packet manifest whose bytes hash to `X-Graunt-Manifest-Hash` — a listing may carry both, and each endpoint always returns its own shape. s3 keys and presigned URLs are never returned here. ACTIVE listings only. Public — no auth.","security":[],"responses":{"200":{"description":"Bundle inventory.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/mcp":{"post":{"operationId":"mcpConnector","tags":["Public discovery"],"summary":"MCP Streamable HTTP connector endpoint (credential optional).","description":"JSON-RPC 2.0 over Streamable HTTP. This is the endpoint an MCP client adds as a connector. With NO Authorization header the caller is an anonymous public principal and tools/list returns the public catalog tools only (search, fetch, search_assets, get_asset, get_agent_commerce_manifest, get_asset_manifest, meta_capabilities, meta_refinery_support_matrix) — the same ACTIVE-listing reads served by GET /v1/listings and GET /v1/listings/{id}, never entitled content. Sending a scoped grnt_agent_* credential widens the catalog to that credential's scopes; a credential that is present is always verified and never silently narrowed. Tool names are dot-free on the wire so clients can re-expose them as model function calls; the original dotted registry names are also accepted. Notifications (no id member, notifications/* only) return 202 with an empty body. GET and DELETE return 405 with Allow: POST — this server offers no server-initiated stream and holds no session. Response content type is negotiated from Accept and prefers application/json. Gated by FEATURE_P6_ARCI_MCP_LIVE — when disabled, returns JSON-RPC error code -32002 (CAPABILITY_NOT_LIVE) with HTTP 503.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"JSON-RPC 2.0 response envelope (success or domain error).","content":{"application/json":{"schema":{"type":"object"}}}},"202":{"description":"Notification accepted; no response body."},"400":{"description":"Malformed JSON-RPC envelope, or a request missing its id outside notifications/*.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"405":{"description":"GET/DELETE are not supported on this endpoint.","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"MCP transport not enabled in this environment.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/mcp/server-info":{"get":{"operationId":"mcpServerInfo","tags":["Public discovery"],"summary":"MCP server descriptor for the Graunt marketplace.","description":"Returns the Model Context Protocol server descriptor: server name, version, protocol_version, and capability summary (tools/resources/prompts). Public, no auth. cache-control: public, max-age=300. The MCP transport delegates to canonical Graunt services; agent identity is always the buyer organization or the scoped credential it issues — there is no standalone autonomous agent principal on this transport.","security":[],"responses":{"200":{"description":"MCP server descriptor.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/mcp/messages":{"post":{"operationId":"mcpMessages","tags":["Authenticated retrieval"],"summary":"MCP JSON-RPC 2.0 messages endpoint (agent bearer auth).","description":"JSON-RPC 2.0 over HTTP. Supported methods at v0: initialize, ping, tools/list, tools/call, resources/list, prompts/list. Bearer-prefix discrimination (HR-30) preserved — only grnt_agent_* bearer tokens are accepted; malformed prefixes return 401 with no JWT fall-through. Mutating tools require an idempotency_key argument. Gated by FEATURE_P6_ARCI_MCP_LIVE — when disabled, returns JSON-RPC error code -32002 (CAPABILITY_NOT_LIVE) with HTTP 503.","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"JSON-RPC 2.0 response envelope (success or domain error).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Malformed JSON-RPC envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"MCP transport not enabled in this environment.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/anonymous-drafts":{"post":{"operationId":"createAnonymousDraft","tags":["Anonymous drafts"],"summary":"Create a private packet draft owned by the discovery key.","description":"Requires `Authorization: Bearer gdk_live_*`. Body is an empty JSON object. Creates a private draft scoped to the key (gdk-scoped; drafts move to the account that claims the key). Per-IP daily create cap; 429 RATE_LIMITED when reached; 503 when drafts are disabled or the rate limiter is unreachable.","security":[],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"201":{"description":"Draft created; `data.draft` carries the draft view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"429":{"description":"Per-IP daily draft-create cap reached (code RATE_LIMITED)."}}},"get":{"operationId":"listAnonymousDrafts","tags":["Anonymous drafts"],"summary":"List the discovery key's drafts.","description":"Requires `Authorization: Bearer gdk_live_*`. Returns only drafts owned by this key (gdk-scoped; claim moves drafts to the claiming account).","security":[],"responses":{"200":{"description":"`data.drafts` array of draft views.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."}}}},"/v1/anonymous-drafts/{id}":{"get":{"operationId":"getAnonymousDraft","tags":["Anonymous drafts"],"summary":"Read one draft.","description":"Requires `Authorization: Bearer gdk_live_*`. Cross-key or unknown drafts return 404 (existence-leak guard). A submitted draft's view carries `heldSale` (null until a buyer authorizes): `state` AUTHORIZED_HELD means a sale is waiting and the responsible human must register and claim this key within the capture window to collect it; FORFEITED_RELEASED means the window passed and the buyer was not charged.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"`data.draft` view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}},"patch":{"operationId":"patchAnonymousDraft","tags":["Anonymous drafts"],"summary":"Set title, price, and draft state (autosave).","description":"Requires `Authorization: Bearer gdk_live_*`. Optional fields: `title` (1–256 chars), `priceCents` (integer; paid-order minimum through the held-sale cap), `state` (the draft state object: description, contentType, category, tags, intendedUses — the validate screen requires a title, description, contentType, category, and at least one intended use), `sellerDisplayName` (2–120 chars — the name buyers see; **required before submit**), `contactEmail` (**required before submit** — stored encrypted, never returned, and the only way you learn a sale happened), `autosaveRevision` (optimistic concurrency — must equal the current revision when present). Every field is optional HERE because a draft is partial by nature; submit refuses without a display name and a contact. gdk-scoped; claim moves drafts to the claiming account.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"title":{"type":"string","minLength":1,"maxLength":256},"priceCents":{"type":"integer"},"state":{"type":"object"},"sellerDisplayName":{"type":"string","minLength":2,"maxLength":120},"contactEmail":{"type":"string","format":"email","maxLength":254},"autosaveRevision":{"type":"integer","minimum":0}}}}}},"responses":{"200":{"description":"Updated `data.draft` view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}},"delete":{"operationId":"abandonAnonymousDraft","tags":["Anonymous drafts"],"summary":"Abandon a draft.","description":"Requires `Authorization: Bearer gdk_live_*`. Marks the draft abandoned; gdk-scoped, cross-key returns 404.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Abandoned `data.draft` view.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}}},"/v1/anonymous-drafts/{id}/uploads":{"post":{"operationId":"presignAnonymousDraftUpload","tags":["Anonymous drafts"],"summary":"Presign a source-file upload into the draft.","description":"Requires `Authorization: Bearer gdk_live_*`. Body: `filename` (1–256 chars), `contentType` (1–128 chars), `sizeBytes` (positive integer, capped). Returns a short-lived presigned PUT URL once — it is never logged and never reappears. Complete the upload with POST /v1/anonymous-drafts/{id}/uploads/complete. gdk-scoped; claim moves drafts to the claiming account.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["filename","contentType","sizeBytes"],"properties":{"filename":{"type":"string","minLength":1,"maxLength":256},"contentType":{"type":"string","minLength":1,"maxLength":128},"sizeBytes":{"type":"integer","minimum":1}}}}}},"responses":{"201":{"description":"Presigned upload issued (returned once).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}}},"/v1/anonymous-drafts/{id}/uploads/complete":{"post":{"operationId":"completeAnonymousDraftUpload","tags":["Anonymous drafts"],"summary":"Confirm an uploaded source file (upload identified in the body).","description":"Requires `Authorization: Bearer gdk_live_*`. Body: `memberId` (uuid from the presign response), `sizeBytes` (positive integer), `contentSha256` (64-hex). The upload is identified in the BODY — there is no upload-id path segment. gdk-scoped; claim moves drafts to the claiming account.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["memberId","sizeBytes","contentSha256"],"properties":{"memberId":{"type":"string","format":"uuid"},"sizeBytes":{"type":"integer","minimum":1},"contentSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}},"responses":{"200":{"description":"Updated `data.draft` view with the confirmed member.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}}},"/v1/anonymous-drafts/{id}/validate":{"post":{"operationId":"validateAnonymousDraft","tags":["Anonymous drafts"],"summary":"Deterministic completeness report for the draft.","description":"Requires `Authorization: Bearer gdk_live_*`. Runs the deterministic junk screen + completeness checks and returns `data.report` alongside the draft view — what the draft still needs before submit. No LLM, no external network. gdk-scoped.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"`data.draft` + `data.report`.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."}}}},"/v1/anonymous-drafts/{id}/submission-attestation":{"post":{"operationId":"attestAnonymousDraftSubmission","tags":["Anonymous drafts"],"summary":"Record the key-holder rights attestation for this draft.","description":"Requires `Authorization: Bearer gdk_live_*`. **Sending `acceptKeyHolderSubmissionAttestation: true` records an attestation binding you to the Key Holder Submission Attestation — read its exact text at `/legal/document/key-holder-attestation` and render the affirmation sentence to whoever is affirming BEFORE you send it.** The sentence is returned in the `label` field of a 400 from this endpoint, and is the same text Graunt records. Body: `acceptKeyHolderSubmissionAttestation` (literal true), optional `actingAsAgent` (boolean) and `principalClaimText` (≤ 2000 chars). Idempotent per (key, draft): a replay returns 200 with the existing attestation; first write returns 201. Required before submit. gdk-scoped.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["acceptKeyHolderSubmissionAttestation"],"properties":{"acceptKeyHolderSubmissionAttestation":{"type":"boolean","enum":[true],"description":"Affirms the Key Holder Submission Attestation. Read its exact text at /legal/document/key-holder-attestation; send true only after showing the sentence to whoever is affirming."},"actingAsAgent":{"type":"boolean"},"principalClaimText":{"type":"string","maxLength":2000}}}}}},"responses":{"200":{"description":"Idempotent replay — the existing attestation."},"201":{"description":"Attestation recorded (`data.attestation`).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."},"409":{"description":"Draft is no longer in a DRAFT state."}}}},"/v1/anonymous-drafts/{id}/submit":{"post":{"operationId":"submitAnonymousDraft","tags":["Anonymous drafts"],"summary":"Submit the attested draft for review.","description":"Requires `Authorization: Bearer gdk_live_*`. Re-runs the deterministic validation first: an incomplete draft returns 200 with `data.submitted: false` plus the honest report (no promotion). A complete, attested draft promotes to a held listing and returns 201 with `data.listing` (id, status, url) — the url is a shareable direct-link early-listing page where a signed-in buyer can authorize a held purchase (the listing never appears in catalog or search pre-claim). The listing is claimable at registration — when the human registers and claims the key, the lineage and any held sale move to their account. gdk-scoped.","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Not submitted — `data.report` lists what is still missing."},"201":{"description":"Submitted; `data.listing` carries the held-listing reference.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid discovery key."},"404":{"description":"Draft not found (including cross-key access)."},"503":{"description":"Submission temporarily unavailable."}}}},"/v1/agent-keys/starter":{"post":{"operationId":"mintAgentDiscoveryKey","tags":["Public discovery"],"summary":"Mint an agent discovery key (no account; raw key returned ONCE).","description":"Creates an agent discovery key with no account: the response carries the raw key exactly once plus a paste-ready instructions block for an agent. The server stores only a sha256 token hash and a non-secret display prefix. Send the key as `Authorization: Bearer gdk_live_*` on the public discovery reads — GET /v1/listings, GET /v1/listings/{id}, GET /v1/listings/{id}/manifest, and GET /v1/meta/* — for a tracked identity; the same reads also work with no key. The key also authorizes the anonymous packet-draft surface (/v1/anonymous-drafts: create, patch, upload, validate, attest, submit — drafts stay private to the key). It cannot purchase, cannot access entitled content, and is rejected with 401 outside the listed discovery and anonymous-draft routes. Rate limited per client IP, 500 mints per day. A registered organization can claim the key later via POST /v1/agent-keys/starter/claim; claiming binds identity, not permissions. Cache-Control: no-store.","security":[],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"201":{"description":"Key created; raw key + display_prefix + instructions in the response body (once).","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"Per-IP daily mint limit reached (code RATE_LIMITED).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Agent discovery keys temporarily unavailable (feature disabled or rate limiter unreachable).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agent-keys/starter/claim":{"post":{"operationId":"claimAgentDiscoveryKey","tags":["Authenticated retrieval"],"summary":"Bind an agent discovery key to your organization account.","description":"Claims a previously-minted agent discovery key for the authenticated organization (JWT only). Idempotent for the claiming organization; a key already claimed by another organization rejects 409 without revealing the owner. Claiming binds identity for continuity and usage visibility — it does NOT grant the key any additional permission — and any anonymous packet drafts prepared with the key move to the claiming account. Cache-Control: no-store.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["key"],"properties":{"key":{"type":"string","description":"The raw agent discovery key being claimed (gdk_live_ prefix + 64 hex). Submitted in the POST body only — never a URL parameter."}}}}}},"responses":{"200":{"description":"Key claimed (or already claimed by this organization). Non-secret summary only — never the raw key or hash.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid claim body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown agent discovery key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Key already claimed by another organization, or key revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/me/agent-keys":{"get":{"operationId":"listMyAgentDiscoveryKeys","tags":["Authenticated retrieval"],"summary":"List your organization's claimed agent discovery keys.","description":"Returns the authenticated organization's claimed agent discovery keys (JWT only): display prefix, use count, last-used and created timestamps, and revocation state. NEVER returns raw keys or token hashes. Cache-Control: no-store.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Claimed-key summaries (non-secret fields only).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/me/agent-keys/{id}/revoke":{"post":{"operationId":"revokeMyAgentDiscoveryKey","tags":["Authenticated retrieval"],"summary":"Turn off one of your organization's claimed discovery keys.","description":"Revokes a discovery key this organization has claimed. The path parameter is the key's row id, never the key itself. Immediately ends every read the key could make — bearer discovery reads, the /k/ link plane, the anonymous-draft surface, and any future claim. Idempotent: re-revoking returns 200 with newly_revoked false and the original revoked_at, never a new timestamp. A key claimed by another organization is indistinguishable from one that does not exist (404). Also returns stranded_draft_count: drafts this key is the only way to reach, which revocation makes permanently unreachable. JWT only. Cache-Control: no-store.","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Key revoked (or already was).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agent-keys/starter/revoke":{"post":{"operationId":"revokeAgentDiscoveryKeyByKey","tags":["Public discovery"],"summary":"Turn off an unclaimed discovery key you hold.","description":"Revokes an UNCLAIMED discovery key by presenting the key itself in the request body. No account required: an unclaimed key is not owned by any organization, so no credential can prove ownership of it, and possession of the key is the authority to destroy it. This is the path for a key that has leaked — pasted into an assistant, shared in a chat — before it was ever bound to an account. The key travels in the BODY only, never a URL. A key that has been claimed by an organization is revoked through the owner or admin route instead and returns 404 here, so this endpoint never confirms that someone else's key exists. Idempotent. Rate limited per client IP. Cache-Control: no-store.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["key"],"properties":{"key":{"type":"string","pattern":"^gdk_live_[0-9a-fA-F]{64}$"}}}}}},"responses":{"200":{"description":"Key revoked (or already was).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes":{"post":{"operationId":"createAccessPass","tags":["Authenticated retrieval"],"summary":"Create a Graunt Access Pass (raw token returned ONCE).","description":"Creates a revocable read-only access pass (an AI access key) scoped to the buyer's currently-active entitled library. ttl_seconds accepts 604800 / 2592000 / 7776000 or \"NO_EXPIRY\" (the default — the pass lives until revoked, lazily auto-revoking after 180 days without use). The raw token plaintext is returned EXACTLY ONCE in the response body and NEVER stored on the server (only sha256 token_hash + non-secret display_prefix). Subsequent reads NEVER re-emit the raw token. Cache-Control: no-store. Buyer JWT only.","security":[{"bearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Pass created; raw token in response body (once).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid create body.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/resolve":{"post":{"operationId":"resolveAccessPass","tags":["Authenticated retrieval"],"summary":"Resolve canonical pass metadata.","description":"Returns canonical pass metadata (scope_kind, status, expires_at, read_only) for an authenticated pass-bearer. Bearer gap_live_* required in the Authorization header — never in a URL or request body. Assistants that only fetch URLs use the read-only /p/<pass> link plane instead. Cache-Control: no-store. Cross-org / non-entitled probing collapses to safe denial.","security":[{"accessPassBearerAuth":[]}],"responses":{"200":{"description":"Canonical pass metadata.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/manifest":{"get":{"operationId":"getAccessPassManifest","tags":["Authenticated retrieval"],"summary":"Manifest of the pass-bearer's active entitled library.","description":"Returns a bounded strict-Zod manifest of the buyer's currently-active entitlements + subscriptions. Per-entitlement projection includes rights summary, provenance summary, supported access modes, and a manifest_view link. NEVER returns presigned URLs, S3 keys, Stripe IDs, customer emails, payout economics, internal seller/admin/provider fields, raw transcripts, internal_risk_tier, or LLM triage receipts. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"responses":{"200":{"description":"Access-pass manifest.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/resources":{"get":{"operationId":"listAccessPassResources","tags":["Authenticated retrieval"],"summary":"List entitled-resource IDs surfaced by this pass.","description":"Returns the resource_ids array projected from the same dynamic active-entitlement query the manifest uses. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"responses":{"200":{"description":"Resource ID list.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/resources/{resource_id}":{"parameters":[{"name":"resource_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"file_offset","in":"query","required":false,"schema":{"type":"integer","minimum":0}},{"name":"file_limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":500}}],"get":{"operationId":"getAccessPassResource","tags":["Authenticated retrieval"],"summary":"Per-resource bounded detail for the pass-bearer.","description":"Per-resource bounded detail mirroring the manifest entry shape, plus `file_inventory`: every file in the revision this holding owns (asset_id, asset_role, original_filename, file_format, file_size_bytes, content_sha256, inline_readable), packet guide first, paged by file_offset / file_limit (default 100, max 500; `next_offset` names the next page). Each asset_id is accepted by the content and records reads. Cross-org / non-entitled / non-existent → 404 (existence-leak guard). Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"responses":{"200":{"description":"Resource detail.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/resources/{resource_id}/content":{"get":{"operationId":"getAccessPassResourceContent","tags":["Authenticated retrieval"],"summary":"Inline byte-range read of one entitled asset (pass-bearer).","description":"Reads a bounded inline byte range (max 1 MiB per call) from a text-shaped asset within an entitled resource. Binary assets are rejected with a bounded denial; every read reserves bytes against the pass's daily byte budget. Response carries the asset sha256, total bytes, and the exact range served. Cross-org / out-of-scope probing collapses to 404. NEVER returns presigned URLs or storage keys. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"parameters":[{"name":"resource_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"asset_id","in":"query","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0}},{"name":"length","in":"query","required":false,"schema":{"type":"integer","minimum":1}},{"name":"format","in":"query","required":false,"schema":{"type":"string","enum":["raw","json"]}}],"responses":{"200":{"description":"Inline content range (JSON envelope or raw text).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid content query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Asset not inlineable (binary) or requested range too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily byte budget exceeded for this pass.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/resources/{resource_id}/records":{"get":{"operationId":"getAccessPassResourceRecords","tags":["Authenticated retrieval"],"summary":"Row-shaped read of one entitled tabular asset (pass-bearer).","description":"Returns parsed rows from a row-shaped asset (CSV / TSV / JSONL) within an entitled resource: row-range selection, optional field projection, and a next_cursor for continuation. Bytes read are charged to the pass's daily byte budget. Cross-org / out-of-scope probing collapses to 404. NEVER returns presigned URLs or storage keys. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"parameters":[{"name":"resource_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"asset_id","in":"query","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"row_start","in":"query","required":false,"schema":{"type":"integer","minimum":0}},{"name":"row_end","in":"query","required":false,"schema":{"type":"integer","minimum":1}},{"name":"fields","in":"query","required":false,"schema":{"type":"string","description":"Comma-separated field projection."}}],"responses":{"200":{"description":"Parsed row page + continuation cursor.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid records query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Asset not row-shaped.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily byte budget exceeded for this pass.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/content":{"get":{"operationId":"getAccessPassContent","tags":["Authenticated retrieval"],"summary":"Aggregate inline read of the pass-bearer's entitled content.","description":"The canonical broad read after /manifest. Cursor-paginates the entitled resources and chunk-scans each text-shaped asset in 64KB-aligned chunks (per-asset scan cap + per-response budget), returning one content unit per chunk with a byte-accurate citation (asset id + byte range). Scans that stop before end-of-asset carry an explicit per-asset truncation marker (per-asset cap, response budget, or daily budget) — truncation is never silent. Bytes read are charged to the pass's daily byte budget, which the response reports. Binary assets are omitted. NEVER returns presigned URLs or storage keys. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"parameters":[{"name":"cursor","in":"query","required":false,"schema":{"type":"string","maxLength":64}},{"name":"max_resources","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":50}}],"responses":{"200":{"description":"Entitled content units with citations, per-asset scan statuses, and the daily byte budget.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid content query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily byte budget exceeded for this pass.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/ask":{"post":{"operationId":"askAccessPassContent","tags":["Authenticated retrieval"],"summary":"Deterministic cited-passage retrieval over entitled content (pass-bearer).","description":"Deterministic keyword retrieval — answer_mode is always SOURCE_PASSAGES; Graunt does not synthesize a natural-language answer. Whole assets are scanned in 64KB-aligned chunks (deeper per-asset cap than /content); matches return the passage text, a relevance score, and a byte-accurate citation. Where the packet ships a content-units artifact, the citation is refined to the covering content unit (stable unit id + unit byte span into the source original). Scans that stop before end-of-asset carry explicit truncation markers — never silent. Bytes scanned are charged to the pass's daily byte budget. Cache-Control: no-store.","security":[{"accessPassBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["query"],"properties":{"query":{"type":"string","minLength":1,"maxLength":2000}}}}}},"responses":{"200":{"description":"Matching source passages with citations + explicit scan-truncation markers.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid ask body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily byte budget exceeded for this pass.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/revoke":{"post":{"operationId":"revokeAccessPass","tags":["Authenticated retrieval"],"summary":"Revoke a Graunt Access Pass.","description":"Revokes a pass. TWO auth arms: (1) Buyer JWT — `pass_id` is REQUIRED and may revoke ANY pass owned by the caller's org. (2) Access-pass bearer (Authorization: Bearer gap_live_*) — SELF-REVOKE only: the body is empty (or `pass_id` must equal the bearer's own pass). Idempotent — already-revoked passes return the existing revoked_at. Cross-org → 404. Cache-Control: no-store.","security":[{"bearerAuth":[]},{"accessPassBearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"pass_id":{"type":"string","format":"uuid","description":"Required for JWT (which pass to revoke); omitted for bearer self-revoke."}}}}}},"responses":{"200":{"description":"Pass revoked (or already revoked).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid revoke body.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/access-passes/audit-events":{"get":{"operationId":"listAccessPassAuditEvents","tags":["Authenticated retrieval"],"summary":"Buyer view of active access passes.","description":"Returns the buyer's currently-active passes (display_prefix, TTL, created_at, expires_at, last_used_at). NEVER returns the raw token. Buyer JWT only. Cache-Control: no-store.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Active-pass list.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/takedowns":{"post":{"operationId":"createTakedown","tags":["Public discovery"],"summary":"Submit a rights-review request for a published listing.","description":"Anonymous-eligible intake. No Authorization header required. Per-IP rate-limited. The submitter's contact email is hashed server-side; the raw email is NEVER persisted. The submitter's authored claim text is preserved verbatim. Cross-existence + non-existent listing returns 404 (existence-leak guard).","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["target_listing_id","claimant_kind","claimant_basis","claimant_contact_email","submitter_authored_claim_text","idempotency_key"],"properties":{"target_listing_id":{"type":"string","format":"uuid"},"target_purchase_id":{"type":"string","format":"uuid"},"claimant_kind":{"type":"string","enum":["ANONYMOUS_PUBLIC","AUTHENTICATED_GRAUNT_ORG","OPERATOR_INTERNAL"]},"claimant_basis":{"type":"string","enum":["RIGHTS_CONFLICT","RIGHTS_REVOKED_BY_AUTHORITY","AUP_VIOLATION","POLICY_VIOLATION_OTHER","FRAUD_SUSPECTED"]},"claimant_contact_email":{"type":"string","format":"email","maxLength":255},"submitter_authored_claim_text":{"type":"string","minLength":1,"maxLength":4000},"evidence_url":{"type":"string","format":"uri","maxLength":2048},"idempotency_key":{"type":"string","minLength":1,"maxLength":255}}}}}},"responses":{"201":{"description":"Takedown request accepted."},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate-limit exceeded (per-IP).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/agent-commerce-manifest":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getAgentCommerceManifest","tags":["Public discovery"],"summary":"Per-listing machine-readable commerce manifest.","description":"Returns a single strict-Zod machine-readable view of an ACTIVE listing's commerce surface: rights snapshot, eligible SKUs, the payment channels an agent can pay through, agent capability endpoints with rate limits, discovery_signals, publication metadata summary, freshness, refund policy summary, and terms/manifest/constitution versions. Public, no auth. cache-control: public, max-age=60. Cross-org, non-ACTIVE, or non-existent listings return a 404 envelope (existence-leak guard).","security":[],"responses":{"200":{"description":"Agent commerce manifest body.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/listings/{id}/seller-terms":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getListingSellerTerms","tags":["Public discovery"],"summary":"The seller's optional additional terms for a listing.","description":"Returns the seller's own additional terms attached to an ACTIVE listing (label, format, full body, content_sha256). Pre-purchase disclosure: these terms are shown alongside the marketplace terms before purchase, and the immutable purchase snapshot pins the same content_sha256 at purchase time (commercial_terms.additional_seller_terms). They never gate purchase, and the platform Terms of Service acceptance flow is separate and unchanged. Public, no auth. cache-control: no-store — this is mutable disclosure text at an unversioned URL; every read is origin-fresh so a seller edit can never race a purchase snapshot through a shared cache. Verify freshness with content_sha256. 404 when the listing is absent, non-ACTIVE, or has no attached terms.","security":[],"responses":{"200":{"description":"Seller additional-terms document.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"const":true},"data":{"type":"object","required":["listing_id","terms_doc_id","label","format","body","content_sha256","terms_updated_at","required_for_purchase"],"properties":{"listing_id":{"type":"string","format":"uuid"},"terms_doc_id":{"type":"string","format":"uuid"},"label":{"type":"string","maxLength":120},"format":{"type":"string","enum":["MARKDOWN","PLAIN"]},"body":{"type":"string","maxLength":20000},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$","description":"SHA-256 of the body (lowercase hex). Verify: sha256(body utf-8) === content_sha256; matches the hash pinned in commercial_terms and in purchase snapshots."},"terms_updated_at":{"type":"string","format":"date-time"},"required_for_purchase":{"const":false}}}}}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/meta/capabilities":{"get":{"operationId":"metaArciCapabilities","tags":["Public discovery"],"summary":"The capabilities Graunt offers.","description":"Returns the capabilities Graunt offers. A capability absent from this list is not offered. Public, no auth, no DB, deterministic. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Capability registry.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/arci-surfaces":{"get":{"operationId":"metaArciSurfaces","tags":["Public discovery"],"summary":"ARCI pages + machine operations index.","description":"Returns the ARCI page registry + operationId registry with capability state per entry. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"ARCI surface index.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/modals":{"get":{"operationId":"metaArciModals","tags":["Public discovery"],"summary":"22 modal kinds with truthful summaries.","description":"Returns the 22 ARCI modal kinds with title + body summary + capability key + capability state. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Modal registry.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/rights-model":{"get":{"operationId":"metaArciRightsModel","tags":["Public discovery"],"summary":"Output rights vocabulary.","description":"Returns the 6 posture enums + 15 rights-decline codes that back per-listing declarative output rights. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Rights model vocabulary.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/denial-codes":{"get":{"operationId":"metaArciDenialCodes","tags":["Public discovery"],"summary":"25 closed-enum denial codes.","description":"Returns the 25 closed-enum denial codes returned by entitled access denial paths, with descriptions. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Denial codes catalog.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/receipt-kinds":{"get":{"operationId":"metaArciReceiptKinds","tags":["Public discovery"],"summary":"14 receipt kinds + payload allowlists.","description":"Returns the 14 receipt kinds with per-kind payload field allowlists + 3 proof kinds + 2 statuses. The allowlist is the no-leak truth for what each receipt payload may carry. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Receipt kinds catalog.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/requirement-groups":{"get":{"operationId":"metaRequirementGroups","tags":["Public discovery"],"summary":"Composable packet requirement groups.","description":"Returns the public, SAFE-only projection of the composable packet requirement registry: constitution_version, the closed requirement group ids, and per-group public requirement summaries (id, label, description, severity). Protected and internal requirement fields (machine paths, dedupe keys, seller prompts, remediation templates, applicability internals) are never exposed. Public, no auth, no DB. Deterministic; registry-derived.","security":[],"responses":{"200":{"description":"Public requirement-groups projection.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/content-profiles":{"get":{"operationId":"metaContentProfiles","tags":["Public discovery"],"summary":"Registered content profiles / packet kinds.","description":"Returns the public projection of the registered content profiles: constitution_version and, per validator-passable packet kind, its family, buyer-facing description, and the SAFE required requirement groups. Registry/canon-derived. Public, no auth, no DB. Deterministic.","security":[],"responses":{"200":{"description":"Public content-profiles projection.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/constitution":{"get":{"operationId":"metaConstitution","tags":["Public discovery"],"summary":"Ratified Packet Constitution version.","description":"Returns the ratified Packet Constitution version (constitution_version), the structural manifest_version, a canon reference, and a public summary of Packet Constitution v1.1. Canon-derived. Public, no auth, no DB. Deterministic.","security":[],"responses":{"200":{"description":"Packet Constitution version projection.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/refinery-policy":{"get":{"operationId":"metaRefineryPolicy","tags":["Public discovery"],"summary":"Refinery access-policy disclosure (SAFE projection).","description":"Returns the public disclosure of the Refinery access posture: the launch free-usage seed (scope, amount, reset cadence, first-packet-free), the micro-free threshold, the available content-integrity profiles, the model-assist posture, and the charging state. Config-driven (single active policy row). SAFE projection only — abuse thresholds, provider internals, and per-account usage are never exposed. Live paid Refinery processing is not active; charging is reserved. Public, no auth.","security":[],"responses":{"200":{"description":"Refinery access-policy SAFE disclosure.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/refinery-support-matrix":{"get":{"operationId":"getMetaRefinerySupportMatrix","tags":["Public discovery"],"summary":"Public Refinery support matrix re-export.","description":"Thin re-export of the deterministic, registry-derived public Refinery support matrix. Returns the canonical artifact_upload_status, compiler_status, extractor_status, and model_assist_status per source type, plus the humanized STATUS_LEGEND and a current version stamp. Same body as the canonical refinery policies public support matrix endpoint; exposed under /v1/meta so agents discover the matrix alongside other agent-readable meta surfaces. Public, no auth, no DB. cache-control: public, max-age=300.","security":[],"responses":{"200":{"description":"Public Refinery support matrix.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/receipts":{"get":{"operationId":"listReceipts","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"List receipts for the auth org.","description":"Returns audit-grade receipts scoped to the auth org. Filterable by kind / status / delivery_id / entitlement_id. Pagination via page + per_page. Read-only — append-only invariant preserved.","parameters":[{"in":"query","name":"page","schema":{"type":"integer","minimum":1}},{"in":"query","name":"per_page","schema":{"type":"integer","minimum":1,"maximum":100}},{"in":"query","name":"kind","schema":{"type":"string"}},{"in":"query","name":"status","schema":{"type":"string"}},{"in":"query","name":"delivery_id","schema":{"type":"string","format":"uuid"}},{"in":"query","name":"entitlement_id","schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Receipt page.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/receipts/{id}":{"get":{"operationId":"getReceipt","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"Get a single receipt by id.","description":"Returns a single receipt scoped to the auth org. 404 on cross-org id or unknown id (no 403 leak).","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Receipt detail.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/query/quote":{"post":{"operationId":"quoteQuery","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"Quote a query class against a listing.","description":"Returns a budget quote (max cents, max calls, expires_at) for the given query class + listing. Emits a query_quote receipt as evidence. STUB_VERIFIER pricing at this slice; LIVE_VERIFIER gated by FEATURE_LIVE_VERIFIER (default OFF).","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["listing_id"],"properties":{"listing_id":{"type":"string","format":"uuid"},"query_class":{"type":"string","enum":["STANDARD","BURST","ENTERPRISE_DEDICATED","TRIAL"]}}}}}},"responses":{"200":{"description":"Quote envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/query/ask":{"post":{"operationId":"askQuery","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"Ask a sourced-answer query against an entitled packet.","description":"Answers a query from the listing's packet content and emits an answer receipt. Metered: each billed call decrements a pre-funded query license, admitted BEFORE any model work. Send Idempotency-Key (idempotency_key) on every call — a retry with the same key and the same body replays the settled response (replayed: true) without re-charging; the same key with a different body returns 409 idempotency_key_conflict; a key still in flight returns 409 QUERY_IN_PROGRESS. cost_cents is 0 and metering is null when the answer was not billable (degraded fallback — the reservation is refunded).","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["listing_id","query"],"properties":{"listing_id":{"type":"string","format":"uuid"},"query":{"type":"string","minLength":1,"maxLength":4096},"rights_basis_ref":{"type":"string"},"idempotency_key":{"type":"string","minLength":1,"maxLength":128,"description":"Retry token. Same key + same body replays the settled response without re-charging; same key + different body is rejected (409 idempotency_key_conflict)."}}}}}},"responses":{"200":{"description":"Answer envelope (replayed: true on an idempotent replay).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Query budget or call allowance exhausted (BUDGET_EXCEEDED / CALL_LIMIT_EXCEEDED).","content":{"application/json":{"schema":{"type":"object"}}}},"409":{"description":"No active query license, a call with this key is in flight (QUERY_IN_PROGRESS), or the key was reused with a different body (idempotency_key_conflict).","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"Daily query-charge limit reached.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/splices":{"get":{"operationId":"listSplices","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"List splices for the auth org.","description":"Returns the auth org's splices, ordered by creation time DESC, limited to the first 100 rows.","responses":{"200":{"description":"Splice list.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"createSplice","tags":["Authenticated retrieval"],"security":[{"bearerAuth":[]}],"summary":"Create a splice from a parent listing.","description":"Accepts the 3 LIVE splice kinds (ROW_SPLICE, JURISDICTION_SPLICE, ANSWER_CONTEXT_SPLICE). Rejects the 8 RESERVED kinds with 409 + CAPABILITY_NOT_LIVE. Writes a splice row in PREVIEW_NOT_LIVE status + emits a splice receipt as evidence.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["parent_listing_id","splice_kind","splice_hash","rights_basis_ref"],"properties":{"parent_listing_id":{"type":"string","format":"uuid"},"splice_kind":{"type":"string"},"splice_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"row_count":{"type":"integer","nullable":true},"size_bytes":{"type":"integer","nullable":true},"jurisdiction_scope":{"type":"array","items":{"type":"string"}},"rights_basis_ref":{"type":"string"},"notes":{"type":"string","nullable":true}}}}}},"responses":{"201":{"description":"Splice created.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"CAPABILITY_NOT_LIVE — splice_kind is RESERVED at this slice.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/principals":{"get":{"operationId":"listAgentPrincipals","tags":["Authenticated retrieval"],"summary":"List agent principals owned by the authenticated org.","description":"Returns the org's agent principals with default PREVIEW_NOT_LIVE status and HUMAN_APPROVAL_REQUIRED approval_policy. Agent identity is in PREVIEW; MCP transport is live at /v1/mcp/messages (see GET /v1/mcp/server-info).","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Array of agent principals + capability state metadata.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"createAgentPrincipal","tags":["Authenticated retrieval"],"summary":"Create an agent principal (PREVIEW_NOT_LIVE default).","description":"Creates a new agent principal owned by the authenticated org. Default status PREVIEW_NOT_LIVE; default approval_policy HUMAN_APPROVAL_REQUIRED per HUMAN_APPROVAL_REQUIRED policy. Slug must match ^[a-z0-9][a-z0-9-]{0,63}$. SLUG_TAKEN (400) returned on (org_id, slug) collision.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Created principal id + state.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/principals/{id}":{"get":{"operationId":"getAgentPrincipal","tags":["Authenticated retrieval"],"summary":"Get an agent principal by id (org-scoped).","description":"Returns the agent principal row with status + approval_policy + spend caps. Org-scoped: cross-org id returns 404 (no existence disclosure). Capability state PREVIEW.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Agent principal row + state.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/credentials":{"get":{"operationId":"listAgentCredentials","tags":["Authenticated retrieval"],"summary":"List agent credentials for the authenticated org (no plaintext).","description":"Returns sha256 keyHash-backed credentials with display-only keyPrefix. Plaintext is shown ONLY at issuance and never persisted.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Array of credentials (no plaintext).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"issueAgentCredential","tags":["Authenticated retrieval"],"summary":"Issue a new agent credential (plaintext returned ONCE).","description":"Mints a `grnt_agt_<48 hex>` plaintext key, persists sha256 keyHash + 12-char display keyPrefix, and returns the plaintext in the 201 response body. Plaintext is not retrievable afterwards. The agent_principal_id must belong to the authenticated org.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Issued credential with plaintext key (shown once).","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/credentials/{id}/revoke":{"post":{"operationId":"revokeAgentCredential","tags":["Authenticated retrieval"],"summary":"Revoke an ACTIVE agent credential.","description":"Transitions credential status to REVOKED with revoked_at + bounded revoked_reason ≤240 chars. Already-revoked / cross-org credentials return 404.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Revocation acknowledged.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/{agent_id}/manifest":{"get":{"operationId":"getAgentAccessManifest","tags":["Authenticated retrieval"],"summary":"Get the most-recent access manifest for an agent principal.","description":"Returns the latest (PREVIEW_NOT_LIVE / PLANNED_NOT_ACTIVE / ACTIVE) manifest for the agent. 404 when no manifest is set; the response message points the caller at PUT to create one.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"agent_id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Manifest row + capability state.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"put":{"operationId":"setAgentAccessManifest","tags":["Authenticated retrieval"],"summary":"Replace the access manifest for an agent principal (PREVIEW_NOT_LIVE).","description":"Appends a PREVIEW_NOT_LIVE row. Graunt derives its canonical manifest_hash and rejects a supplied mismatch. Execution requires audited operator activation plus FEATURE_AGENT_EXECUTION_LIVE=true.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"agent_id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Manifest row created.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/agents/purchases/preflight":{"post":{"operationId":"agentPurchasePreflight","tags":["Authenticated retrieval"],"summary":"Agent BUY preflight (dry-run quote; no Stripe call).","description":"Computes a quote without creating a Stripe or commerce object. Requires an ACTIVE hash-verified manifest plus `quote:read`. Free listings return EXECUTABLE; paid listings return HUMAN_CHECKOUT_REQUIRED with human_checkout_url. Held packets remain denied with DENY_CAPABILITY_NOT_LIVE.","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Preflight result envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS / HUMAN_CONFIRMATION_REQUIRED","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"DENY_CAPABILITY_NOT_LIVE — the listing is a held (early-listing) packet; agent BUY is reserved at v0. No purchase row, no entitlement, no payout split.","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"RATE_LIMITED or BUDGET_EXCEEDED.","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"STRIPE_UNAVAILABLE.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/purchases/execute":{"post":{"operationId":"agentExecutePurchase","tags":["Authenticated retrieval"],"summary":"Agent BUY execute (free acquisition; paid human handoff).","description":"Executes authenticated-free acquisition only through the canonical transaction, including atomic agent attribution. Requires an ACTIVE hash-verified manifest, `buy:execute`, FEATURE_AGENT_EXECUTION_LIVE, and a healthy fail-closed rate-limit control plane. Paid listings return PAID_AGENT_EXECUTION_NOT_LIVE with human_checkout_url and create no PaymentIntent or commerce row.","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Purchase completed envelope. After a free acquisition it also carries more_from_seller: up to three paid listings by the same seller that this principal does not already hold, shared-topic first then lowest price. Disclosure only - absent when there is nothing to offer, and never part of what was charged.","content":{"application/json":{"schema":{"type":"object","required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object","required":["kind","purchase_id","listing_id","status","entitlement_id","delivery","breakdown","commercial_terms_snapshot","completed_at"],"properties":{"kind":{"type":"string","enum":["AGENT_PURCHASE_EXECUTED"]},"purchase_id":{"type":"string","format":"uuid"},"listing_id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["COMPLETED"]},"entitlement_id":{"type":["string","null"],"format":"uuid"},"delivery":{"type":"object","required":["delivery_kind_snapshot","entitlement_url_v1"],"properties":{"delivery_kind_snapshot":{"type":["string","null"],"enum":["PACKET_BUNDLE","SINGLE_FILE",null]},"entitlement_url_v1":{"type":["string","null"]}}},"breakdown":{"type":"object","required":["gross_amount_cents","platform_fee_cents","seller_net_cents","processing_fee_cents","delivery_fee_cents","buyer_total_cents","currency"],"properties":{"gross_amount_cents":{"type":"integer","minimum":0},"platform_fee_cents":{"type":"integer","minimum":0},"seller_net_cents":{"type":"integer","minimum":0},"processing_fee_cents":{"type":"integer","minimum":0},"delivery_fee_cents":{"type":"integer","minimum":0},"buyer_total_cents":{"type":"integer","minimum":0},"currency":{"type":"string","enum":["usd"]}}},"commercial_terms_snapshot":{"type":["object","null"]},"completed_at":{"type":["string","null"],"format":"date-time"},"more_from_seller":{"type":"array","maxItems":3,"description":"Up to three paid listings by the same seller that this principal does not already hold, offered after a free acquisition. Ordered structurally: listings sharing a topic tag with the acquired packet first, then the lowest price, then the id. Disclosure, not a recommendation ranking - it never leaves this seller, nothing is scored, and a seller cannot pay to appear here; the order does follow the seller's own tags and prices. Each row carries the checkout URL where the principal completes the purchase. This does not assert that this credential can execute the purchase directly: paid agent execution, agent scope, spend caps, human confirmation and any seller additional terms are evaluated at execute time, and a refused paid execute hands off to that same URL. Absent (not an empty array) when there is nothing to offer, and never part of what was charged.","items":{"type":"object","required":["id","dataset_name","price_cents","delivery_kind","bundle_asset_count","shares_topic","human_checkout_url"],"properties":{"id":{"type":"string","format":"uuid"},"dataset_name":{"type":"string"},"price_cents":{"type":"integer","minimum":1,"description":"Always above zero - a free listing is never offered as a next step to someone who just acquired one free."},"delivery_kind":{"type":"string","enum":["PACKET_BUNDLE","SINGLE_FILE"]},"bundle_asset_count":{"type":["integer","null"],"minimum":1,"description":"Source files in that listing's published bundle revision; null when it is a single file."},"shares_topic":{"type":"boolean","description":"Whether it shares at least one topic tag with the packet just acquired. Explains the order; it is not a score."},"human_checkout_url":{"type":"string","format":"uri","description":"Where the principal completes this purchase. Present on every row, whether or not this credential could execute the buy itself."}}}}}}}}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS / HUMAN_CONFIRMATION_REQUIRED.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"PAID_AGENT_EXECUTION_NOT_LIVE human-checkout handoff, idempotency conflict, seller-terms drift, or a resource-specific capability denial. Paid handoff creates no commerce rows or Stripe object.","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"RATE_LIMITED or BUDGET_EXCEEDED.","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"CONTROL_PLANE_UNAVAILABLE.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/listings/preflight":{"post":{"operationId":"agentListingPreflight","tags":["Authenticated retrieval"],"summary":"Agent SELL preflight (field readiness; no write).","description":"Returns blocking and warning issues for an agent-submitted listing without creating any row. Requires `grnt_agent_*` bearer with the `quote:read` scope. Per-credential rate-limit applies.","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Preflight result envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"RATE_LIMITED.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/agents/listings/submit":{"post":{"operationId":"agentSubmitListing","tags":["Authenticated retrieval"],"summary":"Agent SELL submit (PENDING_REVIEW; human review gated).","description":"Submits through the canonical createListing transaction with atomic agent attribution. HUMAN_APPROVAL_REQUIRED leaves the result in PENDING_REVIEW and this route never queues auto-publication. Requires an ACTIVE hash-verified manifest, `sell:submit`, FEATURE_AGENT_EXECUTION_LIVE, and a healthy fail-closed rate-limit control plane.","security":[{"agentBearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Listing submitted envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"INSUFFICIENT_RIGHTS.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"LISTING_VALIDATION_FAILED / RIGHTS_INCOMPLETE / PACKET_MANIFEST_INVALID.","content":{"application/json":{"schema":{"type":"object"}}}},"429":{"description":"RATE_LIMITED.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/enterprise/accounts":{"get":{"operationId":"listEnterpriseAccounts","tags":["Authenticated retrieval"],"summary":"List enterprise accounts visible to the authenticated org.","description":"Visibility rule: the org is the enterprise_account.primary_org OR a workspace_org under it. Operator-onboarded only at this slice. No live SSO/SCIM/external-governance transport.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Array of enterprise accounts + capability state.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/enterprise/workspaces":{"get":{"operationId":"listEnterpriseWorkspaces","tags":["Authenticated retrieval"],"summary":"List enterprise workspaces visible to the authenticated org.","description":"Optional ?enterprise_account_id filter. Cross-account queries return an empty list (no existence disclosure). Joined with seat allocations (budget / allocated / active).","security":[{"bearerAuth":[]}],"parameters":[{"in":"query","name":"enterprise_account_id","required":false,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Array of workspaces + capability state.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/providers/{slug}":{"get":{"operationId":"getProvider","tags":["Public discovery"],"summary":"Public provider profile.","description":"Returns the operator-curated public provider profile for the given slug. Fields returned: slug, display_name, blurb, verification_tier, links[], accepted_provider_terms[] (provider_slug + display_name + version + commercial_posture + terms_document_url + accepted_at). Never returns email, stripe IDs, raw acceptance receipts, revoked_reason, or internal verification notes. cache-control public, max-age=300.","security":[],"parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","minLength":2,"maxLength":64,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}}],"responses":{"200":{"description":"Provider profile object.","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Provider slug not found.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/meta/provider-terms":{"get":{"operationId":"listProviderTerms","tags":["Public discovery"],"summary":"Public registry of premium provider terms.","description":"Returns non-superseded provider terms with provider_slug + display_name + version + sha256 doc hash + commercial_posture + machine_readable_defaults JSONB. PREVIEW today (operator-onboarded only). cache-control public, max-age=300.","security":[],"responses":{"200":{"description":"Provider terms array + capability state.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/seller/provider-terms/accept":{"post":{"operationId":"acceptProviderTerms","tags":["Seller"],"summary":"Accept a provider-terms version for the seller org.","description":"Records the acceptance as a `kind=terms_acceptance` receipt (sha256 document_hash) and inserts the acceptance row with FK to the receipt. Idempotent: repeated calls for the same (seller_org_id, provider_terms_id) return the prior acceptance row.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Existing acceptance (idempotent replay).","content":{"application/json":{"schema":{"type":"object"}}}},"201":{"description":"New acceptance row + receipt id.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/seller/provider-terms/{id}/revoke":{"post":{"operationId":"revokeProviderTermsAcceptance","tags":["Seller"],"summary":"Revoke a seller's acceptance of a provider-terms row.","description":"Marks the acceptance as revoked with `revoked_at` + bounded `revoked_reason` (1..240 chars). The original `kind=terms_acceptance` receipt remains in the append-only chain as historical evidence. Already-revoked / cross-org / non-existent acceptance ids return 404 (no existence disclosure).","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Revocation acknowledged.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/validate":{"post":{"operationId":"validatePacket","tags":["Public discovery"],"summary":"Deterministic packet manifest validator.","description":"Validates a packet manifest against the universal-packet-contract section 12 envelope. Returns a validation_report.json with status in {DRAFT, PASSED_WITH_NOTES, PASSED, PUBLISH_BLOCKED} at v0 (STRUCTURAL_VALID and EVIDENCE_INCOMPLETE are reserved statuses and are not emitted at v0). Allowed-public-machine endpoint. Deterministic: no LLM, no external network, no provider SDK. Request body is JSON limited to 256 KB; oversize bodies are rejected with 413.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Validation report envelope. Body shape: { ok: true, data: { validation_report: { report_version: 1, status, checked_at, presence, validation, coherence, findings[], deterministic: true, reserved_future_keys[] } } }. No candidate id, S3 key, restricted prefix, or presigned URL is ever returned.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request body exceeds 256 KB validator body cap.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/refinery/candidates":{"post":{"operationId":"createRefineryCandidate","tags":["Seller"],"summary":"Create a private refinery candidate.","description":"Seller-authenticated. Creates a private refinery candidate record and uploads the source bytes to a restricted refinery storage prefix scoped to the seller organization. The candidate is NEVER addressable from public catalog, search, /llms.txt, OpenAPI public-discovery surfaces, or agent catalog responses. The server recomputes content_sha256 over the decoded bytes; a client-supplied hash is verified for equality and rejected on mismatch. Same-bytes resubmission returns 409 with the existing envelope. Responses never include a presigned URL or raw storage coordinates.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Candidate envelope (id, candidateName, sourceFormat, sizeBytes, contentSha256, state, preflightSummary, presignedUrl: false). Org-scoped — only the authoring organization can read the row.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"DUPLICATE_CONTENT_SHA256 — a candidate already exists for the same org with the same bytes. Body carries the existing candidate envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"413":{"description":"Candidate body exceeds the v0 base64 size cap.","content":{"application/json":{"schema":{"type":"object"}}}}}},"get":{"operationId":"listRefineryCandidates","tags":["Seller"],"summary":"List the caller's own private refinery candidates.","description":"Seller-authenticated. Returns ONLY candidates belonging to the calling organization. Cross-org candidates never appear in the list. Response envelope never includes presigned URLs or raw storage coordinates.","security":[{"bearerAuth":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}],"responses":{"200":{"description":"Org-scoped candidate list envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/candidates/{id}":{"get":{"operationId":"getRefineryCandidate","tags":["Seller"],"summary":"Read one of the caller's own private refinery candidates by id.","description":"Seller-authenticated, organization-scoped. Cross-organization lookup returns 404 (existence-leak guard). Response envelope never includes a presigned URL or raw storage coordinates.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Candidate envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/import":{"post":{"operationId":"importValidatorPassingPacket","tags":["Seller"],"summary":"Import a validator-passing seller-ready packet.","description":"Seller-authenticated. Runs the deterministic validator against the supplied packet_manifest and, when status=PASSED, writes a typed refinery_imports record carrying refinery_floor_bypass=true with the closed-vocabulary reason 'validator_passed_seller_ready_d198'. When the supplied listing_metadata carries a bridgeable listing body, the import bridges through the canonical listing-create path and the listing enters PENDING_REVIEW; publication runs through the canonical publish gate. Same-candidate resubmission returns 409 with the existing record. Cross-organization candidate access returns 404.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Import record envelope with the typed refinery_floor_bypass record + validation_report envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"DUPLICATE_IMPORT_FOR_CANDIDATE or CANDIDATE_NOT_IMPORT_READY.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/refinery/artifacts":{"post":{"operationId":"createRefineryArtifact","tags":["Seller"],"summary":"Register a private source artifact.","description":"Seller-authenticated. Registers a private, content-addressed source artifact and uploads its bytes to a restricted refinery storage prefix scoped to the seller organization. The artifact is NEVER addressable from public catalog, search, /llms.txt, OpenAPI public-discovery surfaces, or agent catalog responses. The server recomputes content_sha256 over the decoded bytes; a client-supplied hash is verified for equality and rejected on mismatch. Same-bytes resubmission returns 409 with the existing envelope. Responses never include a presigned URL or raw storage coordinates.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Artifact envelope (id, originalFilename, mimeType, byteSize, contentSha256, status, presignedUrl: false). Org-scoped — only the registering organization can read the row.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"DUPLICATE_CONTENT_SHA256 — an artifact already exists for the same org with the same bytes. Body carries the existing artifact envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"413":{"description":"Artifact body exceeds the v0 base64 size cap.","content":{"application/json":{"schema":{"type":"object"}}}}}},"get":{"operationId":"listRefineryArtifacts","tags":["Seller"],"summary":"List the caller's own private source artifacts.","description":"Seller-authenticated. Returns ONLY artifacts belonging to the calling organization. Cross-org artifacts never appear in the list. Response envelope never includes presigned URLs or raw storage coordinates.","security":[{"bearerAuth":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}],"responses":{"200":{"description":"Org-scoped artifact list envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/artifacts/{id}":{"get":{"operationId":"getRefineryArtifact","tags":["Seller"],"summary":"Read one of the caller's own private artifacts by id.","description":"Seller-authenticated, organization-scoped. Cross-organization lookup returns 404 (existence-leak guard). Response envelope never includes a presigned URL or raw storage coordinates.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Artifact envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/uploads/presign":{"post":{"operationId":"createRefineryUploadSession","tags":["Seller"],"summary":"Start a browser presigned upload for bulk source material.","description":"Seller-authenticated. Returns a short-lived presigned PUT URL so the browser (or an authorized agent) uploads source bytes DIRECTLY to a restricted refinery storage prefix scoped to the seller organization, plus the size cap, the tombstone policy, and the finalize/remove endpoints for this member. The presigned URL is transient (<=15 min) and is never stored. Responses never include a bucket name, raw S3 key, or credential. The base64 server-proxied route remains as a fallback.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Upload-session contract: upload_member_id, presigned_put_url, presigned_put_expires_at, content_type, max_size_bytes, tombstone_policy, finalize{method,path,body}, declare_in_draft{method,path,body,note}, remove{method,path}. SAFE fields only.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"declared_size_bytes exceeds the upload size cap.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/refinery/uploads/{id}/finalize":{"post":{"operationId":"finalizeRefineryUploadSession","tags":["Seller"],"summary":"Finalize a presigned upload (verify size + streamed sha256).","description":"Seller-authenticated, organization-scoped. After the browser PUTs the bytes, the server HEADs the object to confirm presence + size and streams it to compute content_sha256 (never trusts a client hash). Idempotent: a finalized member returns its envelope. Cross-organization member ids return 404 (existence-leak guard). Emits the REFINERY_UPLOAD_FINALIZED audit event. Response never includes a presigned URL or raw storage coordinates.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Upload member envelope (status UPLOADED, byteSize, contentSha256).","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"OBJECT_MISSING (bytes never landed) or NOT_PENDING (member not in PENDING_UPLOAD).","content":{"application/json":{"schema":{"type":"object"}}}},"413":{"description":"Uploaded object exceeds the size cap.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/refinery/uploads/{id}":{"delete":{"operationId":"removeRefineryUploadSession","tags":["Seller"],"summary":"Tombstone (remove) an upload member before compile.","description":"Seller-authenticated, organization-scoped. Idempotently tombstones the upload member (status REMOVED) so it is excluded from the compile active set, inventory, manifest, and review submission. Cross-organization member ids return 404 (existence-leak guard).","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Tombstone confirmation { id, status: REMOVED }.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/jobs":{"post":{"operationId":"createRefineryJob","tags":["Seller"],"summary":"Create a private compiler job over one of your artifacts.","description":"Seller-authenticated. Creates a private compiler job that runs against one of the caller's own artifacts and records a step-by-step trace. The job runs a deterministic path (provider_mode deterministic or fake); no external model is called. A cross-organization artifact id returns 404 (existence-leak guard). The response includes the job envelope with its ordered step trace.","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Job envelope (id, artifactId, recipeId, providerMode, state, steps[]). Org-scoped — only the owning organization can read the row.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listRefineryJobs","tags":["Seller"],"summary":"List the caller's own private compiler jobs.","description":"Seller-authenticated. Returns ONLY jobs belonging to the calling organization. Cross-org jobs never appear in the list.","security":[{"bearerAuth":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}],"responses":{"200":{"description":"Org-scoped job list envelope.","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Request body or query failed schema validation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/jobs/{id}":{"get":{"operationId":"getRefineryJob","tags":["Seller"],"summary":"Read one of the caller's own compiler jobs by id.","description":"Seller-authenticated, organization-scoped. Cross-organization lookup returns 404 (existence-leak guard). The response includes the job envelope with its ordered step trace.","security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Job envelope with step trace.","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid bearer token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Authenticated, but the caller is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/refinery/policies/public-support-matrix":{"get":{"operationId":"getRefineryPublicSupportMatrix","tags":["Public discovery"],"summary":"Public Refinery Compiler support matrix.","description":"Returns the deterministic, public support matrix of accepted source types and how far each one is wired (artifact upload, compiler, extractor, and model-assist stage status). Allowed-public-machine endpoint: no auth, no DB, no LLM, no external network. Stable shape; ASCII-only. No private identifier, storage coordinate, or provider credential is ever returned.","security":[],"responses":{"200":{"description":"Support matrix envelope: { ok: true, data: { support_matrix: { version, generated_basis, status_legend, source_types[] } } }.","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/p/{pass}":{"get":{"operationId":"passLinkRoot","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Access-pass link plane root.","description":"Read-only summary of an access pass with links to its manifest, content, ask, and resource subpaths. Markdown by default; Accept: application/json for the JSON envelope. Unavailable/revoked/expired passes collapse to 404. Read-only — never mutates.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The canonical surface answered with something this plane cannot read. Returned instead of a page describing content that was not actually retrieved. Same media type as the request would have received.","content":{"text/markdown":{"schema":{"type":"string"}},"text/html":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}}}}},"/p/{pass}/index.html":{"get":{"operationId":"passLinkIndexHtml","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Access-pass link plane root, always HTML.","description":"The same page as /p/{pass}, with the response format pinned to HTML instead of negotiated. For clients that must be pointed at a guaranteed-HTML surface rather than relying on their own Accept header. Anchors carry absolute URLs. Read-only; unavailable passes collapse to 404.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The canonical surface answered with something this plane cannot read. Returned instead of a page describing content that was not actually retrieved. Same media type as the request would have received.","content":{"text/markdown":{"schema":{"type":"string"}},"text/html":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}}}}},"/p/{pass}/llms.txt":{"get":{"operationId":"passLinkLlmsTxt","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Bounded single-fetch aggregate of a pass, as plain text.","description":"One text/plain document holding the pass scope and a per-packet file map of absolute URLs. It does NOT inline packet content: a bounded sample could not be metered at what it emitted, so the map plus the /ask pointer is what a single fetch returns. Packet rows and file rows are capped so one fetch cannot exhaust the pass's shared rate-limit window or serialise an unbounded body; a capped listing carries the next-page URL. Every section declares whether it is complete, and a walk cut short by a refused read says so rather than calling itself truncated. 404 on unavailable pass; 429 when the shared budget is exhausted.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The canonical surface answered with something this plane cannot read. Returned instead of a page describing content that was not actually retrieved. Same media type as the request would have received.","content":{"text/markdown":{"schema":{"type":"string"}},"text/html":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}}}}},"/p/{pass}/map.json":{"get":{"operationId":"passLinkMapJson","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Machine-readable file map for a pass.","description":"JSON on an explicit path (never Accept-negotiated): packets, per-file label, declared format, byte size, change fingerprint, and an absolute href for each file, plus the ask template. Resolved live on every request, so a revoked or narrowed pass renders no stale inventory. Read-only; unavailable passes collapse to 404.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The canonical surface answered with something this plane cannot read. Returned instead of a page describing content that was not actually retrieved. Same media type as the request would have received.","content":{"text/markdown":{"schema":{"type":"string"}},"text/html":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}}}}},"/p/{pass}/manifest":{"get":{"operationId":"passLinkManifest","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Access-pass entitled-library manifest via link.","description":"Relays the canonical /v1/access-passes/manifest projection. Shares the pass's rate-limit + byte budgets. 404 on unavailable pass.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/p/{pass}/content":{"get":{"operationId":"passLinkContent","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Access-pass entitled content via link.","description":"Relays the canonical /v1/access-passes/content read (cited content units; daily byte budget shared with the header plane). 404 on unavailable pass; 429 when the shared budget is exhausted.","security":[],"parameters":[{"name":"pass","in":"path","required":true,"description":"Access-pass link token in the path (returned once at pass creation). Read-only; carried in the path on this plane only.","schema":{"type":"string"}}],"responses":{"200":{"description":"Markdown by default; the JSON envelope (same data as the canonical /v1 surface) when Accept: application/json. Headers: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex.","content":{"text/markdown":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object"}}}},"404":{"description":"Resource does not exist or is not visible to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests for this org/route in the current window. The `Retry-After` header carries the integer seconds to wait. Response body uses the shared error envelope with `error.code = \"RATE_LIMIT_EXCEEDED\"` and a bounded `retry_after_seconds` field. Legitimate retries with the same Idempotency-Key + body replay the cached response when this status clears.","headers":{"Retry-After":{"description":"Integer seconds the client should wait before retrying.","schema":{"type":"integer","minimum":0}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/p/{pass}/ask":{"get":{"operationId":"passLinkAsk","tags":["Graunt Links"],"x-graunt-token-in-path":true,"summary":"Access-pass cited-passage retrieval via link.","description":"Relays the canonical /v1/access-passes/ask retrieval (answer_mode SOURCE_PASSAGES — passages 