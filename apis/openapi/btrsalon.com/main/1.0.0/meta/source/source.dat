    "/salons/{salonId}/availability": {
      "get": {
        "tags": [
          "Booking"
        ],
        "summary": "Get available time slots for booking",
        "security": [],
        "parameters": [
          {
            "name": "salonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "service_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "staff_id",
            "in": "query",
            "description": "Optional - omit for \"any\" staff",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2024-06-20"
          }
        ],
        "responses": {
          "200": {
            "description": "Available slots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AvailabilityResponse"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Create a booking (client only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "salon_id",
                  "service_id",
                  "appointment_date",
                  "start_time"
                ],
                "properties": {
                  "salon_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "staff_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "description": "Optional - for \"any\" staff"
                  },
                  "service_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "appointment_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-06-20"
                  },
                  "start_time": {
                    "type": "string",
                    "example": "13:00"
                  },
                  "client_note": {
                    "type": "string",
                    "nullable": true,
                    "example": "Please use scissors only."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid date/time or service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "409": {
            "description": "Slot no longer available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
