    "/salons/search": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Search salons by location, category, name",
        "security": [],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude of center point",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            },
            "example": 37.9838
          },
          {
            "name": "lng",
            "in": "query",
            "description": "Longitude of center point",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            },
            "example": 23.7275
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Search radius in km",
            "schema": {
              "type": "number",
              "format": "float",
              "default": 5
            },
            "example": 5
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by category",
            "schema": {
              "type": "string"
            },
            "example": "hair"
          },
          {
            "name": "name",
            "in": "query",
            "description": "Search by salon name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of salons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SalonSearchResult"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
