{
  "openapi": "3.0.3",
  "info": {
    "title": "Pixabay API",
    "description": "Access over 4 million high-quality stock images, videos, and music shared by the Pixabay community. All content is released under the Pixabay License, making it safe to use without attribution.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://pixabay.com/api/docs/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://pixabay.com/api"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "searchImages",
        "summary": "Search for images",
        "description": "Search for images matching the given query. Returns image metadata including URLs for preview and download.",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "description": "Your Pixabay API key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "A URL-encoded search term. If omitted, all images are returned. Maximum 100 characters.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language code for the search term (e.g., en, de, fr, es, pt, it, ja, ko, zh).",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Retrieve individual images by ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "image_type",
            "in": "query",
            "required": false,
            "description": "Filter by image type.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "photo",
                "illustration",
                "vector"
              ],
              "default": "all"
            }
          },
          {
            "name": "orientation",
            "in": "query",
            "required": false,
            "description": "Filter by image orientation.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "horizontal",
                "vertical"
              ],
              "default": "all"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter by category.",
            "schema": {
              "type": "string",
              "enum": [
                "backgrounds",
                "fashion",
                "nature",
                "science",
                "education",
                "feelings",
                "health",
                "people",
                "religion",
                "places",
                "animals",
                "industry",
                "computer",
                "food",
                "sports",
                "transportation",
                "travel",
                "buildings",
                "business",
                "music"
              ]
            }
          },
          {
            "name": "min_width",
            "in": "query",
            "required": false,
            "description": "Minimum image width.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "min_height",
            "in": "query",
            "required": false,
            "description": "Minimum image height.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "colors",
            "in": "query",
            "required": false,
            "description": "Filter by color properties. Comma-separated values.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "editors_choice",
            "in": "query",
            "required": false,
            "description": "Select images that have received an Editor's Choice award.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "safesearch",
            "in": "query",
            "required": false,
            "description": "A flag indicating that only images suitable for all ages should be returned.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "How the results should be ordered.",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "latest"
              ],
              "default": "popular"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Returned search results are paginated. Use this parameter to select the page number.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Number of images per page. Values: 3-200.",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 3,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful image search response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "description": "Total number of hits."
                    },
                    "totalHits": {
                      "type": "integer",
                      "description": "Number of images accessible through the API (max 500)."
                    },
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "pageURL": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "string"
                          },
                          "previewURL": {
                            "type": "string"
                          },
                          "previewWidth": {
                            "type": "integer"
                          },
                          "previewHeight": {
                            "type": "integer"
                          },
                          "webformatURL": {
                            "type": "string"
                          },
                          "webformatWidth": {
                            "type": "integer"
                          },
                          "webformatHeight": {
                            "type": "integer"
                          },
                          "largeImageURL": {
                            "type": "string"
                          },
                          "imageWidth": {
                            "type": "integer"
                          },
                          "imageHeight": {
                            "type": "integer"
                          },
                          "imageSize": {
                            "type": "integer"
                          },
                          "views": {
                            "type": "integer"
                          },
                          "downloads": {
                            "type": "integer"
                          },
                          "collections": {
                            "type": "integer"
                          },
                          "likes": {
                            "type": "integer"
                          },
                          "comments": {
                            "type": "integer"
                          },
                          "user_id": {
                            "type": "integer"
                          },
                          "user": {
                            "type": "string"
                          },
                          "userImageURL": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        }
      }
    },
    "/videos/": {
      "get": {
        "operationId": "searchVideos",
        "summary": "Search for videos",
        "description": "Search for videos matching the given query. Returns video metadata including URLs for preview and download.",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "description": "Your Pixabay API key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "A URL-encoded search term. Maximum 100 characters.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language code for the search term.",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Retrieve individual videos by ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "video_type",
            "in": "query",
            "required": false,
            "description": "Filter by video type.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "film",
                "animation"
              ],
              "default": "all"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter by category.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_width",
            "in": "query",
            "required": false,
            "description": "Minimum video width.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "min_height",
            "in": "query",
            "required": false,
            "description": "Minimum video height.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "editors_choice",
            "in": "query",
            "required": false,
            "description": "Select videos that have received an Editor's Choice award.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "safesearch",
            "in": "query",
            "required": false,
            "description": "A flag indicating that only videos suitable for all ages should be returned.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "How the results should be ordered.",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "latest"
              ],
              "default": "popular"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Number of videos per page. Values: 3-200.",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 3,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful video search response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "totalHits": {
                      "type": "integer"
                    },
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "pageURL": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "string"
                          },
                          "duration": {
                            "type": "integer"
                          },
                          "picture_id": {
                            "type": "string"
                          },
                          "videos": {
                            "type": "object",
                            "properties": {
                              "large": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "width": {
                                    "type": "integer"
                                  },
                                  "height": {
                                    "type": "integer"
                                  },
                                  "size": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "medium": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "width": {
                                    "type": "integer"
                                  },
                                  "height": {
                                    "type": "integer"
                                  },
                                  "size": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "small": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "width": {
                                    "type": "integer"
                                  },
                                  "height": {
                                    "type": "integer"
                                  },
                                  "size": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "tiny": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "width": {
                                    "type": "integer"
                                  },
                                  "height": {
                                    "type": "integer"
                                  },
                                  "size": {
                                    "type": "integer"
                                  }
                                }
                              }
                            }
                          },
                          "views": {
                            "type": "integer"
                          },
                          "downloads": {
                            "type": "integer"
                          },
                          "likes": {
                            "type": "integer"
                          },
                          "comments": {
                            "type": "integer"
                          },
                          "user_id": {
                            "type": "integer"
                          },
                          "user": {
                            "type": "string"
                          },
                          "userImageURL": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "Pixabay API key passed as a query parameter. Obtain your free API key at https://pixabay.com/api/docs/"
      }
    }
  }
}
