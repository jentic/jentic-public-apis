{
  "openapi": "3.1.0",
  "info": {
    "title": "Real Market API",
    "version": "1.0.0",
    "description": "Realtime market data REST API — live OHLCV candles, technical indicators, and intelligence signals for 50+ symbols across forex, crypto, metals, stocks, indices and commodities.",
    "contact": {
      "name": "Real Market API Support",
      "url": "https://realmarketapi.com/en-US/contact",
      "email": "support@realmarketapi.com"
    },
    "license": {
      "name": "Commercial",
      "url": "https://realmarketapi.com/en-US/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.realmarketapi.com",
      "description": "Production REST API"
    }
  ],
  "externalDocs": {
    "description": "Full documentation",
    "url": "https://realmarketapi.com/en-US/docs"
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey"
      }
    },
    "schemas": {
      "Candle": {
        "type": "object",
        "properties": {
          "SymbolCode": { "type": "string", "example": "XAUUSD" },
          "OpenPrice":  { "type": "number", "example": 2348.12 },
          "ClosePrice": { "type": "number", "example": 2351.84 },
          "HighPrice":  { "type": "number", "example": 2354.00 },
          "LowPrice":   { "type": "number", "example": 2346.10 },
          "Bid":        { "type": "number", "example": 2351.70 },
          "Ask":        { "type": "number", "example": 2352.30 },
          "Volume":     { "type": "number", "example": 1284.47 },
          "OpenTime":   { "type": "string", "format": "date-time", "example": "2026-03-08T09:20:00Z" }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "Data":        { "type": "array", "items": { "$ref": "#/components/schemas/Candle" } },
          "TotalCount":  { "type": "integer", "example": 240 },
          "CurrentPage": { "type": "integer", "example": 1 },
          "TotalPages":  { "type": "integer", "example": 24 },
          "PageSize":    { "type": "integer", "example": 10 }
        }
      },
      "ScalarPoint": {
        "type": "object",
        "properties": {
          "openTime": { "type": "string", "format": "date-time" },
          "value":    { "type": "number" }
        }
      },
      "ScalarResponse": {
        "type": "object",
        "properties": {
          "data":       { "type": "array", "items": { "$ref": "#/components/schemas/ScalarPoint" } },
          "totalCount": { "type": "integer" }
        }
      },
      "MacdPoint": {
        "type": "object",
        "properties": {
          "openTime":  { "type": "string", "format": "date-time" },
          "macd":      { "type": "number" },
          "signal":    { "type": "number" },
          "histogram": { "type": "number" }
        }
      },
      "BollingerPoint": {
        "type": "object",
        "properties": {
          "openTime": { "type": "string", "format": "date-time" },
          "upper":    { "type": "number" },
          "middle":   { "type": "number" },
          "lower":    { "type": "number" }
        }
      },
      "StochasticPoint": {
        "type": "object",
        "properties": {
          "openTime": { "type": "string", "format": "date-time" },
          "k":        { "type": "number", "description": "%K line (0–100)" },
          "d":        { "type": "number", "description": "%D line (signal)" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status":    { "type": "string", "example": "ok" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "email":              { "type": "string" },
          "planCode":           { "type": "string", "example": "PRO" },
          "requestCount":       { "type": "integer" },
          "requestLimit":       { "type": "integer" },
          "wsConcurrentLimit":  { "type": "integer" }
        }
      }
    }
  },
  "security": [{ "apiKey": [] }],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "API Health",
        "description": "Liveness check. Returns 200 OK when the API is operating normally. No authentication required.",
        "security": [],
        "tags": ["Market Data"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getAccount",
        "summary": "My Account",
        "description": "Returns your current plan, request usage, WebSocket allowance, and account status.",
        "tags": ["Market Data"],
        "responses": {
          "200": {
            "description": "Account details",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AccountResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/symbol": {
      "get": {
        "operationId": "getSymbols",
        "summary": "Available Symbols",
        "description": "Lists all trading symbols accessible on your current API plan.",
        "tags": ["Market Data"],
        "responses": {
          "200": {
            "description": "Symbol list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Symbols": { "type": "array", "items": { "type": "string" }, "example": ["XAUUSD","EURUSD","BTCUSD"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/price": {
      "get": {
        "operationId": "getPrice",
        "summary": "Latest Price",
        "description": "Returns the latest completed OHLCV candle for the requested symbol and timeframe. Ideal for one-shot price queries.",
        "tags": ["Market Data"],
        "parameters": [
          { "name": "symbolCode", "in": "query", "required": true, "schema": { "type": "string" }, "example": "XAUUSD", "description": "Trading symbol (e.g. XAUUSD, EURUSD, BTCUSD)" },
          { "name": "timeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] }, "description": "Candle interval" }
        ],
        "responses": {
          "200": {
            "description": "Latest OHLCV candle",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Candle" } }
            }
          }
        }
      }
    },
    "/api/v1/price/market": {
      "get": {
        "operationId": "getMarket",
        "summary": "Market Overview",
        "description": "Returns the latest OHLCV candle for every symbol available on your plan in a single call.",
        "tags": ["Market Data"],
        "responses": {
          "200": {
            "description": "Latest candles for all accessible symbols",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Candle" } } }
            }
          }
        }
      }
    },
    "/api/v1/price/category": {
      "get": {
        "operationId": "getPriceCategory",
        "summary": "Category Snapshot",
        "description": "Returns the latest market snapshot for one asset category.",
        "tags": ["Market Data"],
        "parameters": [
          { "name": "category", "in": "query", "required": true, "schema": { "type": "string", "enum": ["Stock","Index","Commodity","Equity","Forex","Crypto"] } }
        ],
        "responses": {
          "200": {
            "description": "Category snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category":   { "type": "string" },
                    "totalCount": { "type": "integer" },
                    "data":       { "type": "array", "items": { "$ref": "#/components/schemas/Candle" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "operationId": "getHistory",
        "summary": "OHLCV History",
        "description": "Paginated historical OHLCV candles. Lookback range is capped by plan.",
        "tags": ["Market Data"],
        "parameters": [
          { "name": "symbolCode",  "in": "query", "required": true,  "schema": { "type": "string" } },
          { "name": "startTime",   "in": "query", "required": true,  "schema": { "type": "string", "format": "date-time" }, "description": "ISO 8601 start (inclusive)" },
          { "name": "endTime",     "in": "query", "required": true,  "schema": { "type": "string", "format": "date-time" }, "description": "ISO 8601 end (inclusive)" },
          { "name": "pageNumber",  "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize",    "in": "query", "required": false, "schema": { "type": "integer", "default": 100, "maximum": 1000 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated candle history",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HistoryResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/indicator/sma": {
      "get": {
        "operationId": "getSma",
        "summary": "SMA",
        "description": "Simple Moving Average — arithmetic mean of closing prices over the Period.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true,  "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true,  "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true,  "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "SMA data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    },
    "/api/v1/indicator/ema": {
      "get": {
        "operationId": "getEma",
        "summary": "EMA",
        "description": "Exponential Moving Average — weights recent prices higher than SMA.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "EMA data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    },
    "/api/v1/indicator/rsi": {
      "get": {
        "operationId": "getRsi",
        "summary": "RSI",
        "description": "Relative Strength Index (0–100). Above 70 → overbought; below 30 → oversold.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true, "schema": { "type": "integer", "default": 14 } }
        ],
        "responses": {
          "200": { "description": "RSI data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    },
    "/api/v1/indicator/macd": {
      "get": {
        "operationId": "getMacd",
        "summary": "MACD",
        "description": "Moving Average Convergence Divergence — returns MACD line, signal line, and histogram.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode",   "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",    "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "FastPeriod",   "in": "query", "required": true, "schema": { "type": "integer", "default": 12 } },
          { "name": "SlowPeriod",   "in": "query", "required": true, "schema": { "type": "integer", "default": 26 } },
          { "name": "SignalPeriod", "in": "query", "required": true, "schema": { "type": "integer", "default": 9 } }
        ],
        "responses": {
          "200": {
            "description": "MACD data points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data":       { "type": "array", "items": { "$ref": "#/components/schemas/MacdPoint" } },
                    "totalCount": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicator/bollinger-bands": {
      "get": {
        "operationId": "getBollingerBands",
        "summary": "Bollinger Bands",
        "description": "Volatility channels above and below a moving average. Band width expands in high volatility.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode",  "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",   "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",      "in": "query", "required": true, "schema": { "type": "integer", "default": 20 } },
          { "name": "Multiplier",  "in": "query", "required": true, "schema": { "type": "number",  "default": 2 } }
        ],
        "responses": {
          "200": {
            "description": "Bollinger Bands data points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data":       { "type": "array", "items": { "$ref": "#/components/schemas/BollingerPoint" } },
                    "totalCount": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicator/stochastic": {
      "get": {
        "operationId": "getStochastic",
        "summary": "Stochastic Oscillator",
        "description": "Compares closing price to its price range. Returns %K (main) and %D (signal) lines.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "KPeriod",    "in": "query", "required": true, "schema": { "type": "integer", "default": 14 } },
          { "name": "DPeriod",    "in": "query", "required": true, "schema": { "type": "integer", "default": 3 } }
        ],
        "responses": {
          "200": {
            "description": "Stochastic data points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data":       { "type": "array", "items": { "$ref": "#/components/schemas/StochasticPoint" } },
                    "totalCount": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicator/atr": {
      "get": {
        "operationId": "getAtr",
        "summary": "ATR",
        "description": "Average True Range — measures market volatility. Used for stop-loss sizing.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true, "schema": { "type": "integer", "default": 14 } }
        ],
        "responses": {
          "200": { "description": "ATR data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    },
    "/api/v1/indicator/wma": {
      "get": {
        "operationId": "getWma",
        "summary": "WMA",
        "description": "Weighted Moving Average — linearly weights recent prices higher.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "WMA data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    },
    "/api/v1/indicator/cci": {
      "get": {
        "operationId": "getCci",
        "summary": "CCI",
        "description": "Commodity Channel Index — identifies cyclical trends and overbought/oversold conditions.",
        "tags": ["Indicators"],
        "parameters": [
          { "name": "SymbolCode", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "TimeFrame",  "in": "query", "required": true, "schema": { "type": "string", "enum": ["M1","M5","M15","H1","H4","D1"] } },
          { "name": "Period",     "in": "query", "required": true, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "CCI data points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResponse" } } } }
        }
      }
    }
  }
}
