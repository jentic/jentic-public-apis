{
  "openapi": "3.1.0",
  "info": {
    "title": "App Fitness API",
    "description": "API para gerenciamento de academias, treinos e recomendações do App Fitness.   Todas as funções são hospedadas no Supabase Edge Functions.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/moon-113/MoonApi/1.0.0"
  },
  "servers": [
    {
      "url": "https://ydibowwfqszzyxuldlqj.supabase.co/functions/v1",
      "description": "Supabase Edge Functions"
    }
  ],
  "tags": [
    {
      "name": "Academias"
    },
    {
      "name": "Access Requests"
    },
    {
      "name": "Trainings"
    },
    {
      "name": "Recommendations"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Academia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "academia",
              "condominio"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Unidade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "academia_id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Training": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "diaSemana": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updateAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrainingExercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trainingId": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "grupoMuscular": {
            "type": "string"
          },
          "series": {
            "type": "integer"
          },
          "repeticoes": {
            "type": "string"
          },
          "ordem": {
            "type": "integer"
          },
          "machineId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Convite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "unidade_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "aprovado",
              "rejeitado"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/get-gyms": {
      "get": {
        "tags": [
          "Academias"
        ],
        "summary": "Lista todas as academias e condomínios cadastrados",
        "parameters": [
          {
            "in": "query",
            "name": "tipo",
            "schema": {
              "type": "string",
              "enum": [
                "academia",
                "condominio"
              ]
            },
            "required": false,
            "description": "Filtrar por tipo de unidade"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de academias e unidades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "nome": {
                        "type": "string"
                      },
                      "tipo": {
                        "type": "string",
                        "enum": [
                          "academia",
                          "condominio"
                        ]
                      },
                      "unidades": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Unidade"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/request-gym-access": {
      "post": {
        "tags": [
          "Access Requests"
        ],
        "summary": "Solicita acesso a uma unidade",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unidade_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitação criada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Solicitação duplicada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get-trainings": {
      "get": {
        "tags": [
          "Trainings"
        ],
        "summary": "Retorna todos os treinos do usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de treinos do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Training"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get-recommendations": {
      "get": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Retorna recomendações de horários para treino",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recomendações baseadas em perfil e ocupação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recommendations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "unidadeNome": {
                            "type": "string"
                          },
                          "unidadeEndereco": {
                            "type": "string"
                          },
                          "horario": {
                            "type": "string"
                          },
                          "ocupacaoEstimada": {
                            "type": "string",
                            "enum": [
                              "baixa",
                              "media",
                              "alta"
                            ]
                          },
                          "gruposMusculares": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/create-training": {
      "post": {
        "tags": [
          "Trainings"
        ],
        "summary": "Cria um novo treino com exercícios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "diaSemana",
                  "exercises"
                ],
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "diaSemana": {
                    "type": "string"
                  },
                  "exercises": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "training_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "nome": {
                          "type": "string"
                        },
                        "grupo_muscular": {
                          "type": "string"
                        },
                        "series": {
                          "type": "integer"
                        },
                        "repeticoes": {
                          "type": "string"
                        },
                        "ordem": {
                          "type": "integer"
                        },
                        "machine_id": {
                          "type": "string",
                          "format": "uuid",
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Treino criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "dia_seamana": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/update-training": {
      "put": {
        "tags": [
          "Trainings"
        ],
        "summary": "Atualiza um treino existente",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "trainingId",
                  "nome",
                  "diaSemana",
                  "exercises"
                ],
                "properties": {
                  "trainingId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "nome": {
                    "type": "string"
                  },
                  "diaSemana": {
                    "type": "string"
                  },
                  "exercises": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TrainingExercise"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Treino atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treino não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/delete-training": {
      "delete": {
        "tags": [
          "Trainings"
        ],
        "summary": "Deleta um treino e seus exercícios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trainingId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Treino deletado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treino não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
