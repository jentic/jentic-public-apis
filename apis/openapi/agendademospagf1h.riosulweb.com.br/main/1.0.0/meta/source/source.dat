          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ds-access-token": {
        "type": "apiKey",
        "name": "ds-access-token",
        "in": "header"
      }
    },
    "schemas": {
      "AgendaStatus": {
        "type": "integer",
        "description": "Status da agenda (conforme `STATUS_AGENDA`):\n- -2: ESTORNO\n- -1: FALTA\n- 0: CANCELADO\n- 1: AGENDADO\n- 3: ENCAMINHADO_CAIXA\n- 4: AGUARDANDO_ATENDIMENTO\n- 5: ATENDIDO\n- 6: PAGAMENTO_ANTECIPADO\n",
        "enum": [
          -2,
          -1,
          0,
          1,
          3,
          4,
          5,
          6
        ],
        "example": 1
      },
      "AgendamentoPerfilResponse": {
        "type": "object",
        "required": [
          "perfil"
        ],
        "properties": {
          "perfil": {
            "type": "integer",
            "description": "Código do perfil vinculado ao agendamento",
            "example": 7
          }
        }
      },
      "PacienteTeveAgendamentoWhatsapp": {
        "type": "object",
        "properties": {
          "jaTeveAgendamento": {
            "type": "boolean",
            "description": "Indica se já existe algum agendamento para o paciente."
          }
        },
        "required": [
          "jaTeveAgendamento"
        ],
        "example": {
          "jaTeveAgendamento": false
        }
      },
      "ClinicaRoboWhatsapp": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "endereco",
          "numero",
          "bairro",
          "cidade",
          "cep"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador da clínica"
          },
          "nome": {
            "type": "string",
            "description": "Nome da clínica"
          },
          "endereco": {
            "type": "string",
            "description": "Logradouro da clínica"
          },
          "numero": {
            "type": "string",
            "description": "Número do endereço"
          },
          "bairro": {
            "type": "string",
            "description": "Bairro"
          },
          "cidade": {
            "type": "string",
            "description": "Cidade"
          },
          "cep": {
            "type": "string",
            "description": "CEP"
          }
        }
      },
      "PerfilWhatsapp": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "procedimentos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador do perfil"
          },
          "nome": {
            "type": "string",
            "description": "Nome do perfil"
          },
          "procedimentos": {
            "type": "object",
            "required": [
              "id",
              "nome",
              "valorParticular",
              "valorAssociado"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "nome": {
                "type": "string"
              },
              "valorParticular": {
                "type": "number",
                "format": "double"
              },
              "valorAssociado": {
                "type": "number",
                "format": "double"
              }
            }
          }
        }
      },
      "PacienteRoboResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador do paciente"
          },
          "nome": {
            "type": "string"
          },
          "nomeSocial": {
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date-time"
          },
          "telefone1": {
            "type": "string"
          },
          "telefone2": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "cartao": {
            "type": "object",
            "properties": {
              "numero": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "nome"
        ]
      },
      "DisponibilidadePorPerfilWhatsappResponse": {
        "type": "object",
        "properties": {
          "periodo": {
            "type": "object",
            "properties": {
              "inicio": {
                "type": "string",
                "format": "date-time"
              },
              "fim": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "inicio",
              "fim"
            ]
          },
          "disponibilidadeGeral": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisponibilidadeClinicaWhatsapp"
            }
          }
        },
        "required": [
          "periodo",
          "disponibilidadeGeral"
        ]
      },
      "DisponibilidadeHorarioWhatsapp": {
        "type": "object",
        "properties": {
          "dataFormatada": {
            "type": "string",
            "description": "Data no formato 'dd/MM/yyyy'"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "hora": {
            "type": "integer"
          },
          "minuto": {
            "type": "integer"
          },
          "agendaId": {
            "type": "integer"
          },
          "clinicaId": {
            "type": "integer"
          }
        },
        "required": [
          "dataFormatada",
          "data",
          "hora",
          "minuto",
          "agendaId",
          "clinicaId"
        ]
      },
      "DisponibilidadeClinicaWhatsapp": {
        "type": "object",
        "properties": {
          "clinica": {
            "$ref": "#/components/schemas/ClinicaWhatsappSimplificada"
          },
          "disponibilidade": {
            "description": "Lista de dias, cada dia contendo seus horários disponíveis.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "string",
                  "description": "Data formatada dd/MM/yyyy"
                },
                "horarios": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisponibilidadeHorarioWhatsapp"
                  }
                }
              }
            },
            "nullable": true
          }
        },
        "required": [
          "clinica"
        ]
      },
      "RoboCadastroRequest": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 5
          },
          "nomeSocial": {
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date"
          },
          "cpf": {
            "type": "string",
            "description": "CPF com ou sem máscara"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "sexo": {
            "type": "string",
            "minLength": 9,
            "description": "Ex.: 'MASCULINO' ou 'FEMININO'"
          },
          "telefone1": {
            "type": "string"
          },
          "telefone2": {
            "type": "string"
          }
        },
        "required": [
          "nome",
          "dataNascimento",
          "cpf",
          "sexo",
          "telefone1"
        ]
      },
      "ProcedimentoValidacaoWhatsapp": {
        "type": "object",
        "properties": {
          "procedimentoId": {
            "type": "integer",
            "description": "Id do procedimento."
          },
          "valor": {
            "type": "number",
            "format": "float",
            "description": "Valor esperado/cobrado para o procedimento."
          },
          "msg": {
            "type": "string",
            "description": "Mensagem de validação; vazio quando válido."
          }
        },
        "required": [
          "procedimentoId",
          "valor",
          "msg"
        ],
        "example": {
          "procedimentoId": 123,
          "valor": 80.0,
          "msg": ""
        }
      },
      "ClinicaWhatsappSimplificada": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nome",
          "endereco",
          "numero",
          "bairro",
          "cidade",
          "cep"
        ]
      },
      "PlanoParcelasWhatsappResponse": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "integer",
            "description": "Número do cartão"
          },
          "emDia": {
            "type": "boolean",
            "description": "Situação atual do cartão (em dia)"
          },
          "titular": {
            "type": "object",
            "nullable": true,
            "properties": {
              "nome": {
                "type": "string"
              }
            }
          },
          "responsavel": {
            "type": "object",
            "nullable": true,
            "properties": {
              "nome": {
                "type": "string"
              }
            }
          },
          "mensalidade": {
            "type": "array",
            "description": "Lista de parcelas da mensalidade",
            "items": {
              "$ref": "#/components/schemas/MensalidadeParcelaWhatsapp"
            }
          }
        },
        "required": [
          "numero",
          "emDia",
          "mensalidade"
        ]
      },
      "MensalidadeParcelaWhatsapp": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Chave da parcela"
          },
          "dataVencimento": {
            "type": "string",
            "format": "date-time"
          },
          "descricao": {
            "type": "string"
          },
          "numero": {
            "type": "integer",
            "description": "Número da parcela"
          },
          "boleto": {
            "type": "string",
            "description": "Linha Digitável (quando existir)"
          },
          "pix": {
            "type": "string",
            "description": "Pix copia e cola (quando existir)"
          },
          "cartao": {
            "type": "string",
            "description": "Link de pagamento do cartão para a parcela no site"
          }
        },
        "required": [
          "id",
          "dataVencimento",
          "descricao",
          "numero"
        ]
      },
      "AgendamentoConfirmacaoWhatsapp": {
        "type": "object",
        "properties": {
          "celular": {
            "type": "string",
            "description": "Número do WhatsApp com DDI (ex. 55)"
          },
          "nome": {
            "type": "string",
            "description": "Nome do paciente"
          },
          "data": {
            "type": "string",
            "description": "Data do agendamento no formato dd/MM/yyyy"
          },
          "hora": {
            "type": "string",
            "description": "Hora do agendamento no formato HH:mm"
          },
          "especialidade": {
            "type": "string",
            "description": "Especialidade do perfil do agendamento"
          },
          "unidade": {
            "type": "string",
            "description": "Nome da clínica"
          },
          "endereco": {
            "type": "string",
            "description": "Endereço completo da clínica"
          },
          "id": {
            "type": "string",
            "description": "Id do agendamento"
          }
        },
        "required": [
          "celular",
          "nome",
          "data",
          "hora",
          "especialidade",
          "unidade",
          "endereco",
          "id"
        ]
      },
      "RoboCadastroResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador do paciente criado."
          }
        },
        "required": [
          "id"
        ],
        "example": {
          "id": "abc123"
        }
      },
      "ResultadoExameWhatsappResponse": {
        "type": "object",
        "properties": {
          "exameId": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "dataFormatada": {
            "type": "string"
          },
          "horaFormatada": {
            "type": "string"
          },
          "dataNasc": {
            "type": "string",
            "format": "date-time"
          },
          "dataNascFormatada": {
            "type": "string"
          },
          "OS": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        },
        "required": [
          "exameId",
          "nome",
          "data",
          "dataFormatada",
          "horaFormatada",
          "dataNasc",
          "dataNascFormatada",
          "OS",
          "link"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Erro interno"
          }
        }
      }
    }
  }
}
