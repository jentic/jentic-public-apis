{
  "openapi": "3.0.3",
  "info": {
    "title": "AgendaFacil API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/r4633/agendafacil-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://agendademospagf1h.riosulweb.com.br",
      "description": "Sandbox server (uses test data)"
    }
  ],
  "paths": {
    "/client/roboVerificaCpf": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Verifica CPF e retorna dados básicos do paciente.",
        "description": "Requer token de integração do robô via Header.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "query",
            "required": true,
            "description": "CPF do paciente (com ou sem máscara).",
            "schema": {
              "type": "string",
              "minLength": 11
            },
            "example": "12345678910"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do paciente localizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PacienteRoboResponse"
                },
                "examples": {
                  "exemplo": {
                    "value": {
                      "id": "abc123",
                      "nome": "João da Silva",
                      "nomeSocial": "",
                      "dataNascimento": "2000-01-01T00:00:00.000Z",
                      "telefone1": "11999999999",
                      "telefone2": "1122222222",
                      "email": "joao@example.com",
                      "cartao": {
                        "numero": 123456,
                        "status": "ativo"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CPF obrigatório ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "cpf_obrigatorio": {
                    "value": {
                      "message": "CPF é obrigatório"
                    }
                  },
                  "cpf_invalido": {
                    "value": {
                      "message": "CPF inválido"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado. Token ausente ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "token_faltando": {
                    "value": {
                      "message": "Token not provided"
                    }
                  },
                  "token_invalido": {
                    "value": {
                      "message": "Authentication Failed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "CPF não cadastrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "nao_cadastrado": {
                    "value": {
                      "message": "CPF não cadastrado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/client/roboCadastro": {
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Cadastra paciente via robô de WhatsApp.",
        "description": "Requer token de integração via Header.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoboCadastroRequest"
              },
              "examples": {
                "exemplo": {
                  "value": {
                    "nome": "João da Silva",
                    "nomeSocial": "",
                    "dataNascimento": "2000-01-01",
                    "cpf": "12345678910",
                    "email": "joao@example.com",
                    "sexo": "MASCULINO",
                    "telefone1": "11999999999",
                    "telefone2": "1122222222"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paciente criado (origem WhatsApp).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoboCadastroResponse"
                },
                "examples": {
                  "exemplo": {
                    "value": {
                      "id": "abc123"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "cpf_invalido": {
                    "value": {
                      "message": "CPF inválido"
                    }
                  },
                  "sexo_invalido": {
                    "value": {
                      "message": "Sexo não possui valor esperado!"
                    }
                  },
                  "email_duplicado": {
                    "value": {
                      "message": "E-mail já cadastrado"
                    }
                  },
                  "cpf_duplicado": {
                    "value": {
                      "message": "CPF já cadastrado para Nome, telefone 11 99999-9999."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado. Token ausente ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "token_faltando": {
                    "value": {
                      "message": "Token not provided"
                    }
                  },
                  "token_invalido": {
                    "value": {
                      "message": "Authentication Failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perfis/robowhatsapp": {
      "get": {
        "tags": [
          "Perfis"
        ],
        "summary": "Listar perfis online e seus procedimentos (WhatsApp)",
        "description": "Retorna perfis online com procedimento e respectivos valores para integração via WhatsApp. Protegido por header de integração do Robo WhatsApp.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de perfis online com procedimento",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PerfilWhatsapp"
                  }
                },
                "examples": {
                  "exemplo": {
                    "value": [
                      {
                        "id": 1,
                        "nome": "Perfil A",
                        "procedimentos": {
                          "id": 10,
                          "nome": "Consulta Clínica",
                          "valorParticular": 150.0,
                          "valorAssociado": 100.0
                        }
                      },
                      {
                        "id": 2,
                        "nome": "Perfil B",
                        "procedimentos": {
                          "id": 20,
                          "nome": "Exame X",
                          "valorParticular": 250.0,
                          "valorAssociado": 180.0
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado — token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "token_ausente": {
                    "value": {
                      "message": "token de autorização não informado",
                      "statusCode": 401
                    }
                  },
                  "token_invalido": {
                    "value": {
                      "message": "token de autorização inválido",
                      "statusCode": 401
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "erro_interno": {
                    "value": {
                      "message": "Erro interno ao listar perfis",
                      "statusCode": 500
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/clinicas/robowhatsapp": {
      "get": {
        "tags": [
          "Clinicas"
        ],
        "summary": "Listar clínicas ativas (WhatsApp)",
        "description": "Retorna clínicas ativas com dados essenciais para integração via WhatsApp. Protegido por header de integração do Robo WhatsApp.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clínicas ativas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClinicaRoboWhatsapp"
                  }
                },
                "examples": {
                  "exemplo": {
                    "value": [
                      {
                        "id": 1,
                        "nome": "Clínica Teste",
                        "endereco": "Rua Exemplo",
                        "numero": "100",
                        "bairro": "Centro",
                        "cidade": "Rio de Janeiro",
                        "cep": "20000000"
                      },
                      {
                        "id": 2,
                        "nome": "Clínica Teste 2",
                        "endereco": "Av Exemplo",
                        "numero": "200",
                        "bairro": "Bairro",
                        "cidade": "Rio de Janeiro",
                        "cep": "20000001"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado — token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "token_ausente": {
                    "value": {
                      "message": "token de autorização não informado",
                      "statusCode": 401
                    }
                  },
                  "token_invalido": {
                    "value": {
                      "message": "token de autorização inválido",
                      "statusCode": 401
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "erro_interno": {
                    "value": {
                      "message": "Erro interno ao listar clínicas",
                      "statusCode": 500
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exame/robowhatsapp/ResultadoExames": {
      "post": {
        "tags": [
          "Exames"
        ],
        "summary": "Lista resultados de exames (Robo WhatsApp)",
        "description": "Retorna a lista de exames e anexos de um paciente após validação de CPF e senha. Requer token do robô via Authorization: Bearer.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": {
                    "type": "string",
                    "description": "CPF do paciente."
                  },
                  "senha": {
                    "type": "string",
                    "description": "Senha do portal do paciente."
                  }
                },
                "required": [
                  "cpf",
                  "senha"
                ]
              },
              "examples": {
                "exemplo": {
                  "value": {
                    "cpf": "00000000000",
                    "senha": "123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lista de exames retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultadoExameWhatsappResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "CPF ou senha inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agendamentos/robowhatsapp/aconfirmar": {
      "get": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Lista agendamentos para confirmação (robô WhatsApp)",
        "description": "Retorna agendamentos pendentes de confirmação para envio via WhatsApp. Requer token do robô via Authorization: Bearer.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de agendamentos para confirmação.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgendamentoConfirmacaoWhatsapp"
                  }
                },
                "examples": {
                  "exemploSucesso": {
                    "value": [
                      {
                        "celular": "5511999999999",
                        "nome": "Maria Souza",
                        "data": "05/11/2025",
                        "hora": "14:30",
                        "especialidade": "Clínico Geral",
                        "unidade": "Clínica Centro",
                        "endereco": "Rua A, 123 - Centro, São Paulo/SP - CEP 01000-000",
                        "id": "AGECHAVE123"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "naoAutorizado": {
                    "value": {
                      "status": "error",
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agendas/disponibilidadeporperfilwhatsapp": {
      "get": {
        "tags": [
          "Agendas"
        ],
        "summary": "Disponibilidade por perfil (WhatsApp)",
        "description": "Lista disponibilidade agrupada por clínica, com período pesquisado.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "name": "perfilId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "data",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disponibilidade retornada com período e clínicas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisponibilidadePorPerfilWhatsappResponse"
                }
              },
              "examples": {
                "exemploSucesso": {
                  "summary": "Exemplo de retorno simplificado",
                  "value": {
                    "periodo": {
                      "inicio": "2025-11-03T00:00:00.000Z",
                      "fim": "2025-11-10T23:59:59.999Z"
                    },
                    "disponibilidadeGeral": [
                      {
                        "clinica": {
                          "id": 12,
                          "nome": "Clínica Centro",
                          "endereco": "Rua das Flores",
                          "numero": "123",
                          "bairro": "Centro",
                          "cidade": "São Paulo",
                          "cep": "01000-000"
                        },
                        "disponibilidade": [
                          {
                            "data": "03/11/2025",
                            "horarios": [
                              {
                                "dataFormatada": "03/11/2025",
                                "data": "2025-11-03T13:00:00.000Z",
                                "hora": 13,
                                "minuto": 0,
                                "agendaId": 345,
                                "clinicaId": 12
                              },
                              {
                                "dataFormatada": "03/11/2025",
                                "data": "2025-11-03T13:30:00.000Z",
                                "hora": 13,
                                "minuto": 30,
                                "agendaId": 345,
                                "clinicaId": 12
                              }
                            ]
                          },
                          {
                            "data": "04/11/2025",
                            "horarios": [
                              {
                                "dataFormatada": "04/11/2025",
                                "data": "2025-11-04T09:00:00.000Z",
                                "hora": 9,
                                "minuto": 0,
                                "agendaId": 346,
                                "clinicaId": 12
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "clinica": {
                          "id": 34,
                          "nome": "Clínica Norte",
                          "endereco": "Av. Brasil",
                          "numero": "500",
                          "bairro": "Jardim",
                          "cidade": "São Paulo",
                          "cep": "02000-000"
                        },
                        "disponibilidade": []
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (por exemplo, data ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "examples": {
                "erroData": {
                  "value": {
                    "status": "error",
                    "message": "Data não pode ser vazia"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "examples": {
                "naoAutorizado": {
                  "value": {
                    "status": "error",
                    "message": "Unauthorized"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agendas/robowhatsapp/transferir/{id}": {
      "get": {
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "tags": [
          "Agendas"
        ],
        "summary": "Opções de agendas para transferência (Robo WhatsApp)",
        "description": "Retorna o código do perfil associado ao agendamento online identificado pelo `id do agendamento`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "cha123456"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil vinculado ao agendamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgendamentoPerfilResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    },
    "/clientplan/robowhatsapp/listparcelasbycpf": {
      "get": {
        "tags": [
          "Planos"
        ],
        "summary": "Lista parcelas do cartão por CPF (WhatsApp)",
        "description": "Requer token do robô via Authorization: Bearer.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "query",
            "required": true,
            "description": "CPF do titular (com ou sem máscara).",
            "schema": {
              "type": "string",
              "minLength": 11
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parcelas e dados do cartão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoParcelasWhatsappResponse"
                },
                "examples": {
                  "exemploSucesso": {
                    "value": {
                      "numero": 123456,
                      "emDia": true,
                      "titular": {
                        "nome": "Maria Souza"
                      },
                      "responsavel": {
                        "nome": "José Almeida"
                      },
                      "mensalidade": [
                        {
                          "id": "CHV123",
                          "dataVencimento": "2025-11-05T00:00:00.000Z",
                          "descricao": "Mensalidade Cartão Saúde",
                          "numero": 1,
                          "boleto": "846100000018 123456789012 345678901234 567890123456",
                          "pix": "00020126600014BR.GOV.BCB.PIX0114+5511999999995204000053039865802BR5920CLINICA EXEMPLO DI6008SAO PAUL62070503***6304ABCD",
                          "cartao": "https://app.agendafacil.com.br/r/cartao/pagamento/CHV123"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Documento obrigatório ou inválido, ou cartão/parcelas não localizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "documentoObrigatorio": {
                    "value": {
                      "message": "Documento obrigatório"
                    }
                  },
                  "cartaoNaoLocalizado": {
                    "value": {
                      "message": "Não foi possivel localizar o cartão com o documento informado, por favor entre em contato com a unidade mais próxima."
                    }
                  },
                  "parcelasNaoLocalizadas": {
                    "value": {
                      "message": "Não foi possivel localizar as parcelas, por favor entre em contato com a unidade mais próxima."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "naoAutorizado": {
                    "value": {
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/onlineAppointment/robowhatsapp/confirmar/{id}": {
      "put": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Confirma agendamento via robô WhatsApp",
        "description": "Confirma um agendamento identificado por `id`. Requer token do robô via Authorization: Bearer.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "id do agendamento a confirmar.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmação realizada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "naoAutorizado": {
                    "value": {
                      "status": "error",
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Agendamento não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "naoEncontrado": {
                    "value": {
                      "status": "error",
                      "message": "Agendamento não encontrado"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/onlineAppointment/robowhatsapp/validaprocedimento": {
      "get": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Valida procedimento (Robo WhatsApp)",
        "description": "Valida o procedimento para pacientes associados via WhatsApp. Retorna `null` quando os valores estão corretos; caso contrário, retorna uma lista com os procedimentos e valores ajustados/mensagem de validação.\n",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "procedimentoId",
            "required": true,
            "description": "Id do procedimento.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "valor",
            "required": true,
            "description": "Valor informado do procedimento.",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "in": "query",
            "name": "nome",
            "required": true,
            "description": "Nome do procedimento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pacienteId",
            "required": true,
            "description": "Id do paciente.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "data",
            "required": true,
            "description": "Data do agendamento.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna null quando os valores estão corretos; caso contrário, lista de correções.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcedimentoValidacaoWhatsapp"
                  },
                  "nullable": true
                },
                "examples": {
                  "valoresCorrigidos": {
                    "summary": "Exemplo de correção de valores",
                    "value": [
                      {
                        "procedimentoId": 123,
                        "valor": 80.0,
                        "msg": "O valor do procedimento CONSULTA não é o esperado, devido ao limite de dias."
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação ou regra de negócio (ex.: \"Data não pode ser vazia\", \"Nome é obrigatório\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/onlineAppointment/robowhatsapp": {
      "post": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Criar agendamento (Robo WhatsApp)",
        "description": "Cria um agendamento via integração do Robo WhatsApp.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agendaId": {
                    "type": "integer",
                    "description": "Id da agenda."
                  },
                  "pacienteId": {
                    "type": "string",
                    "description": "Id do paciente."
                  },
                  "inicio": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Data/hora de início do agendamento."
                  },
                  "possuiPlano": {
                    "type": "boolean",
                    "description": "Indica se o paciente possui plano."
                  },
                  "procedimentos": {
                    "type": "array",
                    "description": "Lista de procedimentos do agendamento.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nome": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer",
                          "description": "Id do procedimento."
                        },
                        "valor": {
                          "type": "number",
                          "format": "float"
                        }
                      },
                      "required": [
                        "nome",
                        "id",
                        "valor"
                      ]
                    }
                  }
                },
                "required": [
                  "agendaId",
                  "pacienteId",
                  "inicio",
                  "possuiPlano",
                  "procedimentos"
                ]
              },
              "examples": {
                "exemplo": {
                  "summary": "Exemplo de criação",
                  "value": {
                    "agendaId": 123,
                    "pacienteId": "Pac-456",
                    "inicio": "2025-01-20T14:30:00Z",
                    "possuiPlano": true,
                    "procedimentos": [
                      {
                        "nome": "Consulta Cardiologista",
                        "id": 789,
                        "valor": 80.0
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agendamento criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "agendamentoId": {
                      "type": "string",
                      "description": "Id do agendamento."
                    },
                    "valor": {
                      "type": "number",
                      "format": "double",
                      "description": "Valor do procedimento a pagar."
                    },
                    "descricao": {
                      "type": "string",
                      "description": "Descrição do pagamento (ex.: '123-Consulta')."
                    },
                    "status": {
                      "$ref": "#/components/schemas/AgendaStatus"
                    }
                  },
                  "required": [
                    "agendamentoId",
                    "valor",
                    "descricao",
                    "status"
                  ]
                },
                "examples": {
                  "sucesso": {
                    "summary": "Exemplo de sucesso",
                    "value": {
                      "agendamentoId": "AGE-CHAVE-XYZ",
                      "valor": 150.0,
                      "descricao": "123-Consulta",
                      "status": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação dos parâmetros.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token do Robo WhatsApp inválido ou ausente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
