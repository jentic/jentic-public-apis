    "/caixa/pagamentoonline/pix/robowhatsapp/{pagamentoId}": {
      "put": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Gera PIX copia e cola para pagamento (Robo WhatsApp)",
        "description": "Gera PIX copia e cola para pagamento associado ao `pagamentoId` e retorna dados para cobrança via WhatsApp.",
        "security": [
          {
            "ds-access-token": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "pagamentoId",
            "required": true,
            "description": "Identificador da cobrança/pagamento.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transaction_amount": {
                    "type": "number",
                    "format": "double",
                    "description": "Valor da transação."
                  },
                  "description": {
                    "type": "string",
                    "description": "Descrição da transação."
                  },
                  "external_reference": {
                    "type": "string",
                    "description": "Referência externa do pagamento."
                  },
                  "payer": {
                    "type": "object",
                    "required": [
                      "name",
                      "identification"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "nullable": true
                      },
                      "identification": {
                        "type": "object",
                        "required": [
                          "type",
                          "number"
                        ],
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "number": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "required": [
                  "transaction_amount",
                  "description",
                  "external_reference",
                  "payer"
                ]
              },
              "examples": {
                "exemplo": {
                  "summary": "Exemplo de payload PIX",
                  "value": {
                    "transaction_amount": 150.0,
                    "description": "Consulta Clínica",
                    "external_reference": "EXT-REF-123",
                    "payer": {
                      "name": "João da Silva",
                      "email": "joao@example.com",
                      "identification": {
                        "type": "CPF",
                        "number": "12345678910"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "QR Code gerado com sucesso e dados para o pagamento.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pagamentoId": {
                      "type": "string",
                      "description": "Referência externa do pagamento."
                    },
                    "qrcode": {
                      "type": "string",
                      "description": "Payload do PIX copia e cola."
                    },
                    "expira": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Data/hora de expiração do QR Code."
                    }
                  },
                  "required": [
                    "pagamentoId",
                    "qrcode",
                    "expira"
                  ]
                },
                "examples": {
                  "sucesso": {
                    "summary": "Exemplo de retorno",
                    "value": {
                      "pagamentoId": "EXT-REF-123",
                      "qrcode": "0002010102122673...6304ABCD",
                      "expira": "2025-11-05T23:59:59Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (dados obrigatórios não informados).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "erroValidacao": {
                    "value": {
                      "message": "Dados obrigatórios não informados"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/caixa/pagamentoonline/cartaocredito/robowhatsapp/{pagamentoId}": {
      "put": {
