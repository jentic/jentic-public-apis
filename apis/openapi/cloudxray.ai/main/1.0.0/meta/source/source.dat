{"openapi":"3.1.0","info":{"title":"CloudXray FinOps Directory API","version":"1.0.0","description":"Search and read the CloudXray directory of FinOps vendors.\n\nAuthentication: `Authorization: Bearer cai_live_…`. Create a key at https://cloudxray.ai/profile (verified email required).\n\nEach account gets a free monthly allowance of calls; beyond it, calls use credits. Failed calls are not counted.\n\nUse is subject to the API & MCP Terms: https://cloudxray.ai/api-terms. Every vendor result includes its CloudXray profile URL; show it when you present the data."},"servers":[{"url":"https://cloudxray.ai"}],"security":[{"apiKey":[]}],"paths":{"/api/v1/companies":{"get":{"summary":"Search vendors","description":"Keyword search plus filters. Comma-separated filter values must ALL match (pricing: ANY). 25 results per page; without q or a filter, only the first 2 pages. Allowed filter values: GET /api/v1/taxonomy.","parameters":[{"name":"q","in":"query","schema":{"type":"string"},"description":"Keywords, e.g. `kubernetes allocation`."},{"name":"category","in":"query","schema":{"type":"string"},"description":"Solution category"},{"name":"capability","in":"query","schema":{"type":"string"},"description":"FinOps Foundation capability"},{"name":"technology","in":"query","schema":{"type":"string"},"description":"FinOps technology scope (FinOps for X)"},{"name":"cloud","in":"query","schema":{"type":"string"},"description":"Supported cloud provider"},{"name":"kubernetes","in":"query","schema":{"type":"string"},"description":"Kubernetes platform support"},{"name":"integration","in":"query","schema":{"type":"string"},"description":"Integration (data platforms, observability, AI providers, ITSM, ...)"},{"name":"segment","in":"query","schema":{"type":"string"},"description":"Target customer segment"},{"name":"deployment","in":"query","schema":{"type":"string"},"description":"Deployment model"},{"name":"focus","in":"query","schema":{"type":"string"},"description":"FOCUS (FinOps Open Cost and Usage Specification) support"},{"name":"pricing","in":"query","schema":{"type":"string"},"description":"Pricing model"},{"name":"ff_member","in":"query","schema":{"type":"boolean"},"description":"FinOps Foundation member."},{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}}],"responses":{"200":{"description":"{ data: VendorSummary[], page, pageSize, total, totalPages, hasMore }","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/companies/{slug}":{"get":{"summary":"Get a vendor profile","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"},"description":"Vendor slug, as returned by search (e.g. `vantage`)."}],"responses":{"200":{"description":"Full vendor profile","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/companies/{slug}/alternatives":{"get":{"summary":"Find similar vendors","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"},"description":"Vendor slug, as returned by search (e.g. `vantage`)."}],"responses":{"200":{"description":"{ data: VendorSummary[] }","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/companies/{slug}/analysis":{"get":{"summary":"Published CloudXray analysis of a vendor","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"},"description":"Vendor slug, as returned by search (e.g. `vantage`)."}],"responses":{"200":{"description":"Analysis text, sections and scores (when published)","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/compare":{"get":{"summary":"Compare 2 to 4 vendors","parameters":[{"name":"slugs","in":"query","required":true,"schema":{"type":"string"},"description":"Comma-separated slugs, e.g. `vantage,finout`."}],"responses":{"200":{"description":"{ data: VendorProfile[] }","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/taxonomy":{"get":{"summary":"Filter values and definitions","description":"Capabilities, categories, clouds, segments, pricing models and other allowed values.","responses":{"200":{"description":"Taxonomy","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/changes":{"get":{"summary":"Directory change feed","parameters":[{"name":"since","in":"query","schema":{"type":"string","format":"date"},"description":"ISO date; default 30 days ago."},{"name":"company","in":"query","schema":{"type":"string"},"description":"Limit to one vendor slug."}],"responses":{"200":{"description":"{ since, data: Change[] } (latest 200)","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/api/v1/me":{"get":{"summary":"Your account's usage","description":"Check a key works and see the remaining allowance and credits.","responses":{"200":{"description":"Usage","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}}},"components":{"securitySchemes":{"apiKey":{"type":"http","scheme":"bearer","description":"API key: cai_live_…"}},"responses":{"Error":{"description":"Error: { error: { code, message } }. Codes include unauthorized, email_unverified, terms_not_accepted, suspended, rate_limited, allowance_exceeded, coverage_cap, not_found, unknown_filter, unknown_value, add_a_filter, paused, api_not_configured.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}}}}}}}}}}}