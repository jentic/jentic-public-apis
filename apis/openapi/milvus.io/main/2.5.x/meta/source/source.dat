{
  "openapi": "3.0.3",
  "info": {
    "title": "Milvus Vector Database REST API",
    "description": "RESTful API for Milvus vector database. Provides endpoints for collection management, vector insertion, search, query, and deletion operations.",
    "version": "2.5.x",
    "x-jentic-source-url": "https://milvus.io/api-reference/restful/v2.5.x/About.md",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://{host}:{port}",
      "description": "Milvus instance",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "Milvus server host"
        },
        "port": {
          "default": "19530",
          "description": "Milvus server port"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v2/vectordb/collections/list": {
      "post": {
        "operationId": "listCollections",
        "summary": "List all collections in a database",
        "tags": [
          "Collections"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Name of the database",
                    "default": "_default"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/collections/create": {
      "post": {
        "operationId": "createCollection",
        "summary": "Create a new collection",
        "tags": [
          "Collections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Name for the new collection"
                  },
                  "dimension": {
                    "type": "integer",
                    "description": "Vector dimension (required for quick setup)"
                  },
                  "metricType": {
                    "type": "string",
                    "enum": [
                      "L2",
                      "IP",
                      "COSINE"
                    ],
                    "description": "Distance metric type"
                  },
                  "idType": {
                    "type": "string",
                    "description": "Primary field data type"
                  },
                  "autoID": {
                    "type": "boolean",
                    "description": "Whether to auto-generate primary key"
                  },
                  "primaryFieldName": {
                    "type": "string",
                    "description": "Name of the primary field"
                  },
                  "vectorFieldName": {
                    "type": "string",
                    "description": "Name of the vector field"
                  },
                  "schema": {
                    "type": "object",
                    "description": "Collection schema for custom setup",
                    "properties": {
                      "autoID": {
                        "type": "boolean"
                      },
                      "enableDynamicField": {
                        "type": "boolean"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "fieldName": {
                              "type": "string"
                            },
                            "dataType": {
                              "type": "string"
                            },
                            "isPrimary": {
                              "type": "boolean"
                            },
                            "elementTypeParams": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  },
                  "indexParams": {
                    "type": "array",
                    "description": "Index configuration parameters",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fieldName": {
                          "type": "string"
                        },
                        "indexName": {
                          "type": "string"
                        },
                        "metricType": {
                          "type": "string"
                        },
                        "params": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "params": {
                    "type": "object",
                    "description": "Collection parameters",
                    "properties": {
                      "shardsNum": {
                        "type": "integer"
                      },
                      "consistencyLevel": {
                        "type": "string"
                      },
                      "partitionsNum": {
                        "type": "integer"
                      },
                      "ttlSeconds": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/collections/describe": {
      "post": {
        "operationId": "describeCollection",
        "summary": "Get detailed information about a collection",
        "tags": [
          "Collections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Name of the collection to describe"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionDescribeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/collections/drop": {
      "post": {
        "operationId": "dropCollection",
        "summary": "Drop (delete) a collection",
        "tags": [
          "Collections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Name of the collection to drop"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/insert": {
      "post": {
        "operationId": "insertEntities",
        "summary": "Insert entities into a collection",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "data"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Target collection name"
                  },
                  "data": {
                    "description": "Entity object or array of entity objects matching the collection schema",
                    "oneOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "partitionName": {
                    "type": "string",
                    "description": "Target partition name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "insertCount": {
                          "type": "integer"
                        },
                        "insertIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/upsert": {
      "post": {
        "operationId": "upsertEntities",
        "summary": "Upsert entities into a collection (insert or update)",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "data"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Target collection name"
                  },
                  "data": {
                    "description": "Entity object or array of entity objects",
                    "oneOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "partitionName": {
                    "type": "string",
                    "description": "Target partition name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "upsertCount": {
                          "type": "integer"
                        },
                        "upsertIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/search": {
      "post": {
        "operationId": "searchEntities",
        "summary": "Perform vector similarity search",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "data"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Target collection name"
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Vector embeddings to search against"
                  },
                  "annsField": {
                    "type": "string",
                    "description": "Vector field name to search"
                  },
                  "filter": {
                    "type": "string",
                    "description": "Scalar filtering expression"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Maximum number of results to return"
                  },
                  "offset": {
                    "type": "integer",
                    "description": "Number of records to skip"
                  },
                  "groupingField": {
                    "type": "string",
                    "description": "Field for result grouping"
                  },
                  "outputFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Fields to include in results"
                  },
                  "partitionNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Partitions to search"
                  },
                  "consistencyLevel": {
                    "type": "string",
                    "enum": [
                      "Strong",
                      "Eventually",
                      "Session",
                      "Bounded"
                    ],
                    "description": "Consistency level"
                  },
                  "searchParams": {
                    "type": "object",
                    "description": "Search parameters",
                    "properties": {
                      "metricType": {
                        "type": "string",
                        "enum": [
                          "L2",
                          "IP",
                          "COSINE"
                        ]
                      },
                      "params": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/query": {
      "post": {
        "operationId": "queryEntities",
        "summary": "Query entities using scalar filtering",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "filter"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection to query"
                  },
                  "filter": {
                    "type": "string",
                    "description": "Boolean expression for filtering"
                  },
                  "outputFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Fields to return"
                  },
                  "partitionNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Partitions to query"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Maximum entities to return"
                  },
                  "offset": {
                    "type": "integer",
                    "description": "Records to skip"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/get": {
      "post": {
        "operationId": "getEntities",
        "summary": "Get entities by their IDs",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "id"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name"
                  },
                  "id": {
                    "description": "Entity ID or array of IDs",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "outputFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Fields to return"
                  },
                  "partitionNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Partitions to query"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/vectordb/entities/delete": {
      "post": {
        "operationId": "deleteEntities",
        "summary": "Delete entities from a collection",
        "tags": [
          "Vectors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionName",
                  "filter"
                ],
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "Database name"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name"
                  },
                  "filter": {
                    "type": "string",
                    "description": "Scalar filtering condition to match entities for deletion"
                  },
                  "partitionName": {
                    "type": "string",
                    "description": "Partition name for scoped deletion"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token using colon-joined username:password or API key"
      }
    },
    "schemas": {
      "BaseResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Response code (0 for success)"
          },
          "data": {
            "type": "object"
          },
          "message": {
            "type": "string",
            "description": "Error message (present on failure)"
          }
        }
      },
      "CollectionListResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of collection names"
          }
        }
      },
      "CollectionDescribeResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "collectionName": {
                "type": "string"
              },
              "collectionID": {
                "type": "integer",
                "format": "int64"
              },
              "autoId": {
                "type": "boolean"
              },
              "consistencyLevel": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "enableDynamicField": {
                "type": "boolean"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "primaryKey": {
                      "type": "boolean"
                    },
                    "autoId": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fieldName": {
                      "type": "string"
                    },
                    "indexName": {
                      "type": "string"
                    },
                    "metricType": {
                      "type": "string"
                    }
                  }
                }
              },
              "load": {
                "type": "string"
              },
              "partitionNum": {
                "type": "integer"
              },
              "shardsNum": {
                "type": "integer"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "distance": {
                  "type": "number",
                  "format": "float"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "cost": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
