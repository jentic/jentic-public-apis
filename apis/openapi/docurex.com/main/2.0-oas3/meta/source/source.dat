      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Name of the customer"
          },
          "realname": {
            "type": "string",
            "description": "The optional real customer name without name restrictions"
          },
          "contact_email": {
            "type": "string",
            "description": "contact email address for support questions. Only showed in customer administration"
          },
          "contact_name": {
            "type": "string",
            "description": "contact name, who supports the dataroom. Only showed in customer administration"
          },
          "created_at": {
            "type": "string",
            "description": "Creation time of the dataroom"
          },
          "created_by": {
            "type": "string",
            "description": "customer admin user, who created the dataroom"
          },
          "comment": {
            "type": "string",
            "description": "Optional description only showed in customer administration"
          },
          "country": {
            "type": "string",
            "description": "Country of the customer"
          },
          "language": {
            "type": "string",
            "description": "Language of the customer. Only de or en."
          },
          "max_user": {
            "type": "integer",
            "description": "Max number of users"
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Nobody can login, while inactive"
          },
          "available_bytes": {
            "type": "integer",
            "description": "max data space in bytes"
          },
          "modules": {
            "description": "the modules list with module ids or module codes",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_freezed": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Lock the dataroom. Only admin can login and have read rights only"
          },
          "freeze_description": {
            "type": "string",
            "description": "The optional error message, while dataroom is freezed"
          },
          "is_deleted": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "whene dataromm is created with errors, it will be deleted flagged"
          },
          "admin_email": {
            "type": "string",
            "description": "Email address of the new dataroom admin"
          },
          "admin_loginname": {
            "type": "string",
            "description": "Login of the new dataroom admin"
          },
          "admin_firstname": {
            "type": "string",
            "description": "First name of the new dataroom admin"
          },
          "admin_lastname": {
            "type": "string",
            "description": "last name of the new dataroom admin"
          }
        },
        "allOf": [
