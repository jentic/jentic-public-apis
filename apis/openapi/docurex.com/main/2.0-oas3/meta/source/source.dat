                    "type": "string",
                    "description": "the text to be rendered as waterkark"
                  },
                  "FONTWIDTH": {
                    "type": "integer",
                    "description": "the size of the text. 5-20"
                  },
                  "FONTALPHA": {
                    "type": "number",
