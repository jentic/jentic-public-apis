          }
        }
      },
      "post": {
        "tags": [
          "Customer"
        ],
        "summary": "Add a new customer",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/hal+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "realname": {
                    "type": "string"
                  },
                  "is_active": {
                    "type": "integer",
                    "description": "0 for inactive and 1 for active",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "active_from": {
                    "type": "string",
                    "example": "2020-10-10"
                  },
                  "active_until": {
                    "type": "string",
                    "example": "2022-10-10"
                  },
                  "max_users": {
                    "type": "integer"
                  },
                  "contact_name": {
                    "type": "string"
                  },
                  "contact_email": {
                    "type": "string"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "available_bytes": {
                    "type": "integer"
                  },
                  "is_freezed": {
                    "type": "integer"
                  },
                  "freezed_message": {
                    "type": "string"
                  },
                  "modules": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Module id or module name"
                    }
                  },
                  "send_admin_email": {
                    "type": "integer",
                    "description": "0 for inactive and 1 for active",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "admin_email": {
                    "type": "string"
                  },
                  "admin_loginname": {
                    "type": "string"
                  },
                  "admin_firstname": {
                    "type": "string"
                  },
                  "admin_lastname": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      }
    },
