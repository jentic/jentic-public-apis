            "description": "the default upload option"
          }
        },
        "example": {
          "VERSIONSACTIVE": "TODO",
          "VERSIONSUPLOADOPTION": "TODO"
        }
      },
      "Config_PATHLIMITATION": {
        "type": "object",
        "properties": {
