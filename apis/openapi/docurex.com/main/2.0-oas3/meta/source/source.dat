                    "enum": [
                      "Top",
                      "Middle",
                      "Bottom",
                      "Redo"
                    ]
                  }
                },
                "example": {
                  "WATERMARKTEXT": "the waterkark text with {placeholder}",
                  "FONTWIDTH": 12,
                  "FONTALPHA": 0.2,
                  "WATERMARKPLACE": "Top"
                }
              }
            }
          }
        }
      }
