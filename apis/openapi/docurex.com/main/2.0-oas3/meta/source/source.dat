{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://app.docurex.com/api"
    }
  ],
  "info": {
    "title": "docurex 3 RestApi v2.0",
    "version": "2.0-oas3",
    "contact": {
      "email": "support@docurex.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Biteno-GmbH/RestApi-v2.0/2.0-oas3"
  },
  "tags": [
    {
      "name": "Document"
    },
    {
      "name": "Folder"
    },
    {
      "name": "User"
    },
    {
      "name": "Group"
    },
    {
      "name": "QA"
    },
    {
      "name": "Shortcut"
    },
    {
      "name": "Customer"
    },
    {
      "name": "Config"
    },
    {
      "name": "Report"
    },
    {
      "name": "OrderExport"
    },
    {
      "name": "Info"
    },
    {
      "name": "Workflow"
    },
    {
      "name": "Contact"
    },
    {
      "name": "Job"
    }
  ],
  "paths": {
    "/document": {
      "get": {
        "summary": "Get document collection",
        "tags": [
          "Document"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "description": "Sort Order (+ = Ascending; - = Descending) id, name, created_at, created_by, size, folder_id, pages, extension, mimetype",
            "example": "-created_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page Number",
            "example": 1,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "description": "max files per page",
            "example": 25,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "folder_id",
            "description": "Parent Folder ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "name",
            "description": "Filter by document name",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "content",
            "description": "Filter by document content",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "metaContent",
            "description": "Filter by document meta content",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "is_viewed",
            "description": "filter by viewed status",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Collection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_embedded": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "description": "the list of the documents",
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Document"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Add a new document",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder_id": {
                    "type": "string",
                    "description": "the target folder_id"
                  },
                  "folder_path": {
                    "type": "string",
                    "description": "optional, use the folder path instead of folder_id"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "the file data to upload"
                  },
                  "name": {
                    "type": "string",
                    "description": "optional other name (instead using the filename)"
                  },
                  "part": {
                    "type": "integer",
                    "description": "for big files use a increasing part flag to upload the file in chunk parts. Use only part, file and folder_id. Other params after upload with no part and file param"
                  },
                  "rename": {
                    "type": "integer",
                    "description": "flag for handling with existing file names\\\n0 = no rename and exit with error\\\n1 = rename like windows\\\n2 = ignore file and return existing one with status 200\\\n3 = new version (only with version module)\n",
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ]
                  },
                  "tags": {
                    "type": "string",
                    "format": "json",
                    "description": "The document tags as string list with ',' as separator. Example:\\\ntag1, tag2\n"
                  },
                  "module_data": {
                    "type": "string",
                    "format": "json",
                    "description": "extra data for modules like meta data in json format. Example:\\\n{\\\"document_type name/id\\\": \\\"doctype 1\\\", \\\"meta_tags\\\": {\\\"meta_tag name/id\\\": \\\"metavalue\\\"}\n"
                  },
                  "permissions": {
                    "type": "string",
                    "format": "json",
                    "description": "optional the file rights by group in json format. Example:\\\n{\\\"groupID\\\": [\\\"FILE_VIEW\\\"]}\n"
                  }
                },
                "required": [
                  "folder_id",
                  "folder_path",
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "/document/{document_id}": {
      "get": {
        "tags": [
          "Document"
        ],
        "summary": "Find a document by ID",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "withPermissions",
            "description": "Includes all rights by group",
            "example": 1,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "in": "query",
            "name": "withVersions",
            "description": "Includes all older versions of the document",
            "example": 1,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "in": "query",
            "name": "version",
            "example": 2,
            "description": "load a specific version of a document",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "withLiveEdit",
            "example": 1,
            "description": "with the webUrl for live edit",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "put": {
        "tags": [
          "Document"
        ],
        "summary": "Update an existing document",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "the new document name",
                    "example": "new document name"
                  },
                  "locked": {
                    "type": "integer",
                    "example": 1,
                    "description": "lock(1) or unlock(0), no new versions for locked documents"
                  },
                  "tags": {
                    "type": "array",
                    "description": "overwrite the tag list (not add)",
                    "example": [
                      "tage1",
                      "tag3"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "document_type_id": {
                    "type": "string",
                    "description": "the document type name or id",
                    "example": "lGAEeX4Mj7mJyMkc"
                  },
                  "meta_tags": {
                    "type": "object",
                    "description": "overwrite the meta tags (not add)",
                    "example": {
                      "metaname/metaId": "value"
                    }
                  },
                  "permissions": {
                    "type": "object",
                    "example": {
                      "lGAEWX4Mj7mJyMkb": [
                        "FILE_VIEW"
                      ]
                    },
                    "description": "overwrite the file rights per group"
                  },
                  "live_edit": {
                    "type": "string",
                    "description": "start or stop edit office documents on onedrive",
                    "enum": [
                      "start",
                      "stop",
                      "edit"
                    ]
                  },
                  "summery": {
                    "description": "generate a summery for the document with given amount of words",
                    "type": "integer",
                    "enum": [
                      100,
                      200,
                      300,
                      400,
                      500
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Document"
        ],
        "summary": "Deletes a document",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_ids with , separated",
            "required": true,
            "example": "lGAEeX4Mj7mJyMkc, G5ef5hGMj7mJyMkc",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Deleted"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/document/{document_id}/download": {
      "get": {
        "tags": [
          "Document"
        ],
        "summary": "Download a document",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "example": "Text einer Datei"
              },
              "application/pdf": {
                "example": "%PDF..."
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/document/{document_id}/send": {
      "get": {
        "tags": [
          "Document"
        ],
        "summary": "Sends a document to user email",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                },
                "example": {
                  "id": "7DgLR32V0kPjV6Jw",
                  "name": "image.jpg,",
                  "created_at": "2018-09-24 15:01:57",
                  "created_by": "Hans Mustermann",
                  "created_user_id": "5467547hnru486",
                  "updated_user_id": "",
                  "size": 96640,
                  "extention": "jpg",
                  "folder_id": "lGAEWX4Mj7mJyMkb",
                  "mimetype": "image/jpeg",
                  "is_viewed": 0,
                  "locked": 0,
                  "info": {
                    "message": "sending document to xxx@xx.xx"
                  },
                  "_links": {
                    "document_send": {
                      "href": "/document/7DgLR32V0kPjV6Jw/send"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/document/{document_id}/copy": {
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Copies a document to another folder",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "folder_id"
                ]
              }
            }
          }
        }
      }
    },
    "/document/{document_id}/move": {
      "post": {
        "tags": [
