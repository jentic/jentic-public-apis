      "post": {
        "tags": [
          "User"
        ],
        "summary": "Add a new user",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "login_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  },
                  "active": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "config": {
                    "type": "object"
                  },
                  "send_email": {
                    "description": "send the E-Mail Notification to the users (default 1)",
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                },
                "required": [
                  "first_name",
                  "last_name",
                  "login_name",
                  "email",
                  "lang",
                  "active",
                  "password",
                  "groups"
                ]
              },
              "example": {
                "first_name": "Hans",
                "last_name": "Mustermann",
                "login_name": "hans.mustermann",
                "email": "hans.mustermann@example.org",
                "password": "Secure123#",
                "lang": "de",
                "active": 1,
                "groups": [
                  "OaRK1N9m59J4ome2"
                ]
              }
            }
          }
        }
      }
    },
