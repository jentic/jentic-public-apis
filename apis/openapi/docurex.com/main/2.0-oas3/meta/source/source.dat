                    "$ref": "#/components/schemas/Link"
                  }
                },
                "_embedded": {
                  "type": "array"
                },
                "page_count": {
                  "type": "integer",
                  "example": 3
                },
                "page_size": {
                  "type": "integer",
                  "example": 100
                },
                "total_items": {
                  "type": "integer",
                  "example": 246
                },
                "page": {
                  "type": "integer",
                  "example": 2
                }
              }
            }
          }
        }
