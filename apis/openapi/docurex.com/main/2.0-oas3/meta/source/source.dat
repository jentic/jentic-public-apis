    "/user": {
      "get": {
        "summary": "Get user collection",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "description": "Sort Order (+ = Ascending; - = Descending) id, name, created_at, created_by, email, login, active_from, active_untl",
            "example": "-created_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page Number",
            "example": 1,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "login_name",
            "description": "filter by login name",
            "example": "m.meier",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "first_name",
            "description": "filter by first name",
            "example": "Michael",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_name",
            "description": "filter by last name",
            "example": "Meier",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "active",
            "description": "filter by active flag",
            "example": 1,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "description": "filter by lang (iso)",
            "example": "de",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "email",
            "description": "filter by email",
            "example": "m.meier@email.de",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "active_from",
            "description": "filter by active from date",
            "example": "2022-01-01",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "active_until",
            "description": "filter by active until date",
            "example": "2023-01-01",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Collection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_embedded": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "description": "the list of the users",
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/User"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
