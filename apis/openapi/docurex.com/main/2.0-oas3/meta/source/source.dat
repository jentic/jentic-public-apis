                  "folder_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "folder_id"
                ]
              }
            }
          }
        }
      }
    },
    "/document/{document_id}/ai": {
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "ask a question on a document",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "the question with max 100 chars. The question \"summery\" generates a summey of the document",
                    "example": "summery"
                  }
                },
                "required": [
                  "question"
                ]
              }
            }
          }
        }
      }
    },
    "/document/{document_id}/view": {
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Generates a preview pdf or image",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                },
                "example": "%PDf..."
              },
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer"
                  },
                  "format": {
                    "type": "string",
                    "description": "the default format is pdf. In this case the other params are ignored",
                    "enum": [
                      "pdf",
                      "jpg",
                      "png",
                      "tif",
                      "gif"
                    ]
                  },
                  "quality": {
                    "type": "integer",
                    "description": "the image quality. Defaults to 60",
                    "minimum": 10,
                    "maximum": 100
                  },
                  "width": {
                    "type": "integer",
                    "description": "the image width"
                  },
                  "height": {
                    "type": "integer",
                    "description": "the image height"
                  },
                  "dpi": {
                    "type": "integer",
                    "description": "the image dpi. Defaults to 200"
                  }
                },
                "required": [
                  "document_id"
                ]
              },
              "example": {
                "page": 1,
                "format": "jpg",
                "height": 200,
                "quality": 70,
                "dpi": 72
              }
            }
          }
        }
      }
    },
