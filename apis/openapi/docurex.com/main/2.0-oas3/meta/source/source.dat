      "Config_placeholders": {
        "type": "object",
        "description": "the list of allowded placeholders for config textfields",
        "properties": {
          "date": {
            "type": "string",
            "description": "the actual date like 2023-01-01 in de or en format. For syscode WATERMARK, AUTHENTICATION, EMAIL"
          },
          "name": {
            "type": "string",
            "description": "the name (firstname lastname) of the logged in user. For syscode WATERMARK"
          },
          "email": {
            "type": "string",
            "description": "the email address of the logged in user. For syscode WATERMARK"
          },
          "username": {
            "type": "string",
            "description": "the name (firstname lastname) of target user. For syscode AUTHENTICATION, EMAIL"
          },
          "useremail": {
            "type": "string",
            "description": "the email adress of target user. For syscode EMAIL"
          },
          "link": {
            "type": "string",
            "description": "the one click download link for documents. For syscode EMAIL"
          },
          "adminname": {
            "type": "string",
            "description": "the name (firstname lastname) of the admin user. For syscode EMAIL"
          },
          "adminemail": {
            "type": "string",
            "description": "the email adress of the admin user. For syscode SMS, EMAIL"
          },
          "documentname": {
            "type": "string",
            "description": "the name of uploaded document(s). For syscode SMS, EMAIL"
          },
          "documentnameuploader": {
            "type": "string",
            "description": "the used, whom uploaded a document. For syscode EMAIL"
          },
          "documentcount": {
            "type": "string",
            "description": "the document count, wich was uploaded. For syscode EMAIL"
          },
          "foldername": {
            "type": "string",
            "description": "the name of the folder, where document was uploaded. For syscode EMAIL"
          },
          "folderpath": {
            "type": "string",
            "description": "the full folder path of the uploaded document. For syscode EMAIL"
          },
          "userLastName": {
            "type": "string",
            "description": "the lastname of target user. For syscode EMAIL, SUPPORT"
          },
          "userFirstName": {
            "type": "string",
            "description": "the first name of target user. For syscode EMAIL, SUPPORT"
          },
          "userPassword": {
            "type": "string",
            "description": "the password of target user. For syscode EMAIL"
          },
          "userLoginName": {
            "type": "string",
            "description": "the login name of tatget user. For syscode EMAIL"
          },
          "userActiveFrom": {
            "type": "string",
            "description": "the active from date of taeget user. For syscode EMAIL"
          },
          "userActiveUntil": {
            "type": "string",
            "description": "the active util date of target user. For syscode EMAIL"
          },
          "customerName": {
            "type": "string",
            "description": "the actual customer name. For syscode EMAIL, SUPPORT"
          },
          "question": {
            "type": "string",
            "description": "the question text. For syscode EMAIL"
          },
          "category": {
            "type": "string",
            "description": "the category of the question. For syscode EMAIL"
          },
          "answer": {
            "type": "string",
            "description": "the answer of the question. For syscode EMAIL"
          },
          "nr": {
            "type": "string",
            "description": "the number of the question. For syscode EMAIL"
          },
          "questionusergroups": {
            "type": "string",
            "description": "the groups, wich can see the question. For syscode EMAIL"
          },
          "questionuser": {
            "type": "string",
            "description": "the user, witch created/asked the question. For syscode EMAIL"
          },
          "questionuseremail": {
            "type": "string",
            "description": "the email of the user, witch created/asked the question. For syscode EMAIL"
          },
          "domainDescription": {
            "type": "string",
            "description": "the domain description of actual customer. For syscode EMAIL, SUPPORT"
          },
          "domainpublicURL": {
            "type": "string",
            "description": "the domain URL of the actual customer. For syscode EMAIL, SUPPORT"
          },
          "domainDomain": {
            "type": "string",
            "description": "the domain code of the actual customer. For syscode EMAIL, SUPPORT"
          },
          "callBack": {
            "type": "string",
            "description": "the telephone number for support. For syscode SUPPORT"
          },
          "code": {
            "type": "string",
            "description": "the authentication code for email, sms or authenticator. For syscode AUTHENTICATION"
          }
        }
      },
      "document_FILE_METADATA": {
        "type": "object",
        "properties": {
          "FILE_METADATA": {
            "type": "object",
            "description": "meta tag module for document type and meta data",
            "properties": {
              "document_type": {
                "type": "string",
                "description": "the name of the document type"
              },
              "document_type_id": {
                "type": "string",
                "description": "the id for the document type"
              },
              "meta_tags": {
                "type": "object"
              }
            },
            "example": {
              "document_type": "Rechnung",
              "document_type_id": "htr6464t3errhghr",
              "meta_tags": {
                "mtag1": 12345
              }
            }
          }
        }
      },
      "document_QA": {
        "type": "object",
        "properties": {
          "QA": {
            "type": "object",
            "description": "qa mudule for ask and answer questions on the document",
            "properties": {
              "category": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "allowed qa categories for questions"
              }
            },
            "example": {
              "category": [
                "gGGVB464gGS57hnj"
              ]
            }
          }
        }
      },
      "document_NUMBERING": {
        "type": "object",
        "properties": {
          "NUMBERING": {
            "type": "object",
            "description": "automatic numbering/position for document names (add number prefix to name)",
            "properties": {
              "position": {
                "type": "integer",
                "description": "position of the document"
              },
              "originalName": {
                "type": "string",
                "description": "the original name withpout numbering prefix"
              }
            },
            "example": {
              "position": 1,
              "originalName": "name.jpg"
            }
          }
        }
      },
      "document_VERSIONS": {
        "type": "object",
        "properties": {
          "VERSIONS": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "description": "the version of the file"
              },
              "file_id": {
                "type": "string",
                "description": "the internal file id of the newest file version"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            },
            "example": {
              "version": 2,
              "file_id": "32536yh45ijrt6"
            }
          }
        }
      },
      "document_PDF_PREVIEW": {
        "type": "object",
        "properties": {
          "PDF_PREVIEW": {
            "type": "object",
            "description": "preview module, create a pdf preview for the document",
            "properties": {
              "pages": {
                "type": "integer",
                "description": "the number of pages"
              },
              "status": {
                "type": "integer",
                "description": "the status of the conversion (-10 not convertable, -5 password protected, -3 convert failed, 0 not converted yet, 1 converted",
                "enum": [
                  -10,
                  -5,
                  -3,
                  0,
                  1
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            },
            "example": {
              "version": 2,
              "file_id": "32536yh45ijrt6"
            }
          }
        }
      },
      "document_DOCU_KI": {
        "type": "object",
        "properties": {
          "DOCU_KI": {
            "type": "object",
            "description": "shows document summery",
            "properties": {
              "summery": {
                "type": "integer",
                "description": "the AI generated document summery"
              }
            },
            "example": {
              "summery": "The documents summery text"
            }
          }
        }
      },
      "document_DOCUMENT_INDEX": {
        "type": "object",
        "properties": {
          "DOCUMENT_INDEX": {
            "type": "object",
            "description": "indexing module, index document content for searching",
            "properties": {
              "status": {
                "type": "integer",
                "description": "the status of the indextion ( -3 index failed, 0 not indexed yet, 1 indexed",
                "enum": [
                  -3,
                  0,
                  1
                ]
              }
            }
          }
        }
      },
      "document_LIVE_EDIT_FILES": {
        "type": "object",
        "properties": {
          "LIVE_EDIT_FILES": {
            "type": "object",
            "description": "live edit module, edit office documents on mircosoft onedrive",
            "properties": {
              "isCheckedOut": {
                "type": "integer",
                "description": "document is checked out to onedrive for live edit",
                "enum": [
                  0,
                  1
                ]
              },
              "name": {
                "type": "string",
                "description": "the document name on onedrive"
              },
              "size": {
                "type": "string",
                "description": "the documkent size on one drive"
              }
            },
            "example": {
              "isCheckedOut": 0
            }
          }
        }
      },
      "document_link": {
        "type": "object",
        "description": "the download link",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "the owner of the link"
          },
          "contact_id": {
            "type": "string",
            "description": "the reciever for the link"
          },
          "onetime": {
            "type": "integer",
            "description": "link can be used once(1) or multiple times(0)"
          },
          "created_at": {
            "type": "string",
            "description": "date of creation"
          },
          "expiration_date": {
            "type": "string",
            "description": "date of expiration"
          },
          "hash": {
            "type": "string",
            "description": "the download hash"
          },
          "file": {
            "type": "array",
            "description": "the documents in the download link",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "user_id": "ID50",
          "created_at": "2024-01-11 15:36:07",
          "onetime": 1,
          "expiration_date": "2024-12-12",
          "hash": "x_xWyMsnd0fZgdJ0PI9JhQSB0m3wFAv_w30spig9z6g",
          "file": {
            "Gd53577g5GDh": "00279_Datacenter_Export_Dokumente.zip"
          },
          "contact_id": 0,
          "_links": {
            "document_link": {
              "href": "https://...../link/download/link/x_xWyMsnd0fZgdJ0PI9JhQSB0m3wFAv_w30spig9z6g"
            }
          }
        }
      },
      "folder_NUMBERING": {
        "type": "object",
        "properties": {
          "NUMBERING": {
            "type": "object",
            "description": "automatic numbering/position for folder names (add number prefix to name)",
            "properties": {
              "position": {
                "type": "integer",
                "description": "position of the folder"
              },
              "originalName": {
                "type": "string",
                "description": "the original name withpout numbering prefix"
              }
            },
            "example": {
              "position": 1,
              "originalName": "folder 1"
            }
          }
        }
      },
      "folder_QA": {
        "type": "object",
        "properties": {
          "QA": {
            "type": "object",
            "description": "qa module for ask and answer question on the folder",
            "properties": {
              "category": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "allowed qa categories for questions"
              }
            },
            "example": {
              "category": [
                "gGGVB464gGS57hnj"
              ]
            }
          }
        }
      },
      "Auth": {
        "type": "object",
        "properties": {
          "disclaimer": {
            "type": "boolean",
            "description": "must accept the disclaimer"
          },
          "forcepwchange": {
            "type": "boolean",
            "description": "must change the password"
          },
          "ignoreMaintenance": {
            "type": "boolean",
            "description": "allowed to login, if maintenance mode is active"
          },
          "token": {
            "type": "string",
            "description": "the auth token"
          },
          "mustAuthenticate": {
            "type": "boolean",
            "description": "must do a further 2-factor authentication. Use /auth again\n- only with authcode and token from login\n- with login data again and authcode (generate new token)\n \n"
          }
        },
        "example": {
          "disclaimer": false,
          "forcepwchange": false,
          "ignoreMaintenance": false,
          "token": "xxxxxxxxxxxxxxxxxxxxxxxx",
          "mustAuthenticate": false
        }
      },
      "Hal": {
        "properties": {
          "_links": {
            "description": "Links to related resources or operations on this resource",
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "Link": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "type": "string",
            "format": "uri",
            "description": "The URI or URI template for the resource/operation this link refers to."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      }
