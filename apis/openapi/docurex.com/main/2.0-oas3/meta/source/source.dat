    "/config/ldap": {
      "post": {
        "tags": [
          "Config"
        ],
        "summary": "ldap test functions",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "test": {
                    "type": "string",
                    "description": "the test function (LDAP: connection, credentials, search)",
                    "enum": [
                      "connection",
                      "credentials",
                      "search"
                    ]
                  },
                  "host": {
                    "type": "string",
                    "description": "the ldap host name"
                  },
                  "port": {
                    "type": "integer",
                    "description": "the ldap server port"
                  },
                  "encryption": {
                    "type": "string",
                    "description": "the encryption (none, ssl(default), tsl)"
                  },
                  "credentials": {
                    "type": "string",
                    "description": "the ldap credetials/user"
                  },
                  "auth": {
                    "type": "string",
                    "description": "the ldap filter"
                  },
                  "password": {
                    "type": "string",
                    "description": "the ldap password"
                  }
                },
                "required": [
                  "test"
                ],
                "example": {
                  "test": "search",
                  "host": "localhost",
                  "port": 389,
                  "encryption": "ssl",
                  "credentials": "rene.kabisch@entwicklung.internal",
                  "password": "xxxx",
                  "auth": "CN=Rene Kabisch,OU=User,OU=Test01,DC=entwicklung,DC=internal"
                }
              }
            }
          }
        }
      }
    },
    "/group": {
      "get": {
