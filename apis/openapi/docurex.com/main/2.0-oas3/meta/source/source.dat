      "Config_EMAIL": {
        "type": "object",
        "properties": {
          "EMAILNAME": {
            "type": "string",
            "description": "The name for the email template"
          },
          "BODY": {
            "type": "string",
            "description": "The text for the email. Can contains placeholders and html tags: html, body, div, span, font, br, p, b, u, i,  h1, h2, h3, li, ol, ul, table, tr, td, tbody, a"
          },
          "SUBJECT": {
            "type": "string",
            "description": "the email subject. Can contains placeholders"
          },
          "RECIEVER": {
            "type": "integer",
            "description": "the reciever email address type  \n-1 = actual users;\n-2 = modified user;\n-3 = admin;\n-4 = support;\n",
            "enum": [
              -1,
              -2,
              -3,
              -4
            ]
          },
          "SENDER": {
            "type": "string",
            "description": "the sender email address. Must be a intern address or NOREPLY_DOCUPLUS(default address), NOREPLY_ASTIGA(domain specific address)"
          },
          "SENTTIME": {
            "type": "string",
            "description": "the send time (0 = immideately; after 10, 20, 60, 240 minutes; 8:00, 12:00, 18:00)",
            "enum": [
              "0",
              "10",
              "20",
              "60",
              "240",
              "8:00",
              "12:00",
              "18:00"
            ]
          },
          "ACTION": {
            "type": "integer",
            "description": "the action (right) that triggers the email",
            "enum": [
              114,
              129,
              223,
              228,
              304,
              402,
              403,
              404,
              421,
              423,
              436,
              503,
              519,
              1102,
              1103,
              1134,
              1203
            ]
          },
          "ACTIVE": {
            "type": "integer",
            "description": "activate or deactive the template"
          }
        },
        "example": {
          "EMAILNAME": "Hello email",
          "BODY": "Hello,<br><b>This is the email text with {placeholder}</b>",
          "SUBJECT": "Hello {placeholder}",
          "RECIEVER": -2,
          "SENDER": "NOREPLY_ASTIGA",
          "SENTTIME": 0,
          "ACTION": 402
        }
      },
