        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "description": "Name of the config"
                  },
                  "syscode": {
                    "type": "string",
                    "description": "syscode(name) of the config type"
                  },
                  "values": {
                    "type": "array",
                    "description": "the configurations values for the config",
                    "items": {
                      "type": "object",
                      "properties": {
                        "de": {
                          "type": "object",
                          "oneOf": [
                            {
                              "$ref": "#/components/schemas/Config_WATERMARK"
                            },
                            {
                              "$ref": "#/components/schemas/Config_EMAIL"
                            },
                            {
                              "$ref": "#/components/schemas/Config_THEMES"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DISCLAIMER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PWPOLICY"
                            },
                            {
                              "$ref": "#/components/schemas/Config_METATAG"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DOCTYPE"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AUTHENTICATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORT"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORTUSER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_VERSIONS"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PATHLIMITATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_NUMBERING"
                            },
                            {
                              "$ref": "#/components/schemas/Config_LDAP"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AZUREAD"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SPACE"
                            }
                          ]
                        },
                        "en": {
                          "type": "object",
                          "oneOf": [
                            {
                              "$ref": "#/components/schemas/Config_WATERMARK"
                            },
                            {
                              "$ref": "#/components/schemas/Config_EMAIL"
                            },
                            {
                              "$ref": "#/components/schemas/Config_THEMES"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DISCLAIMER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PWPOLICY"
                            },
                            {
                              "$ref": "#/components/schemas/Config_METATAG"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DOCTYPE"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AUTHENTICATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORT"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORTUSER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_VERSIONS"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PATHLIMITATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_NUMBERING"
                            },
                            {
                              "$ref": "#/components/schemas/Config_LDAP"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AZUREAD"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SPACE"
                            }
                          ]
                        },
                        "it": {
                          "type": "object",
                          "oneOf": [
                            {
                              "$ref": "#/components/schemas/Config_WATERMARK"
                            },
                            {
                              "$ref": "#/components/schemas/Config_EMAIL"
                            },
                            {
                              "$ref": "#/components/schemas/Config_THEMES"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DISCLAIMER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PWPOLICY"
                            },
                            {
                              "$ref": "#/components/schemas/Config_METATAG"
                            },
                            {
                              "$ref": "#/components/schemas/Config_DOCTYPE"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AUTHENTICATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORT"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SUPPORTUSER"
                            },
                            {
                              "$ref": "#/components/schemas/Config_VERSIONS"
                            },
                            {
                              "$ref": "#/components/schemas/Config_PATHLIMITATION"
                            },
                            {
                              "$ref": "#/components/schemas/Config_NUMBERING"
                            },
                            {
                              "$ref": "#/components/schemas/Config_LDAP"
                            },
                            {
                              "$ref": "#/components/schemas/Config_AZUREAD"
                            },
                            {
                              "$ref": "#/components/schemas/Config_SPACE"
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "example": {
                  "description": "Emailbechreibung",
                  "syscode": "EMAIL",
                  "values": [
                    {
                      "de": [
                        {
                          "BODY": "Hallo <b>Welt</b>"
                        },
                        {
                          "SUBJECT": "Hallo"
                        },
                        {
                          "RECIEVER": "-2"
                        },
                        {
                          "SENDER": "NOREPLY_ASTIGA"
                        },
                        {
                          "SENTTIME": "0"
                        },
                        {
                          "ACTION": "403"
                        }
                      ]
                    },
                    {
                      "en": [
                        {
                          "BODY": "Hello <b>world</b>"
                        },
                        {
                          "SUBJECT": "Hello"
                        },
                        {
                          "RECIEVER": "-2"
                        },
                        {
                          "SENDER": "NOREPLY_ASTIGA"
                        },
                        {
                          "SENTTIME": "0"
                        },
                        {
                          "ACTION": "403"
                        }
                      ]
                    },
                    {
                      "it": [
                        {
                          "BODY": "Cia <b>mondo</b>"
                        },
                        {
                          "SUBJECT": "Cia"
                        },
                        {
                          "RECIEVER": "-2"
                        },
                        {
                          "SENDER": "NOREPLY_ASTIGA"
                        },
                        {
                          "SENTTIME": "0"
                        },
                        {
                          "ACTION": "403"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
