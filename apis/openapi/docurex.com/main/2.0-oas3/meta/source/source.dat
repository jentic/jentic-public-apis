    "/folder": {
      "get": {
        "summary": "Get folder collection",
        "tags": [
          "Folder"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "description": "Sort Order (+ = Ascending; - = Descending) id, name, created_at, created_by, size, number_children, number_documents, parent_id",
            "example": "-created_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page Number",
            "example": 1,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "description": "Page Size",
            "example": 25,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "parent_id",
            "description": "filter by parent folder id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "name",
            "description": "filter by folder name, use * as placeholder and space for multi search words. Example:\\\nTest - search for the word 'test'\\\nT*st - search single words beginning with 'T' and ends with 'st\\\nHello world - Search the word 'test' or 'world'\\\n\"Hello world\" = search for the phrase 'Hello world'\\\nSome characters must be escaped:\n\n\\#  %23\\\n$   %24\\\n%   %25\\\n&   %26\\\n@   %40\\\n`   %60\\\n/   %2F\\\n:   %3A\\\n;   %3B\\\n\\<   %3C\\\n=   %3D\\\n\\>   %3E\\\n?   %3F\\\n[   %5B\\\n\\   %5C\\\n]   %5D\\\n^   %5E\\\n{   %7B\\\n|   %7C\\\n}   %7D\\\n~   %7E\\\n“   %22\\\n‘   %27\\\n\\+   %2B\\\n,   %2C\n",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "full_path",
            "description": "filter by parent (full path instead of id)",
            "example": "root/a/b/c",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "recursive",
            "description": "Includes all subfolders, defaults to 0 (no subfolders)",
            "example": 1,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Collection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_embedded": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "description": "the list of the folders",
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Folder"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/folder/{folder_id}": {
      "get": {
        "tags": [
          "Folder"
        ],
        "summary": "Find folder by ID",
        "parameters": [
          {
            "in": "path",
