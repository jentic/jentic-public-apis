    "/document/{document_id}/link": {
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Generates a one click download link and sends it to a reciever via email",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "description": "URL parameter document_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "integer",
                      "description": "the owner of the link"
                    },
                    "contact_id": {
                      "type": "string",
                      "description": "the reciever for the link"
                    },
                    "onetime": {
                      "type": "integer",
                      "description": "link can be used once(1) or multiple times(0)"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "date of creation"
                    },
                    "expiration_date": {
                      "type": "string",
                      "description": "date of expiration"
                    },
                    "link": {
                      "type": "string",
                      "description": "the download link"
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "document_id": {
                          "type": "string",
                          "description": "the document sent by the link"
                        },
                        "version": {
                          "type": "string",
                          "description": "specific version or newest version(empty)"
                        }
                      }
                    }
                  },
                  "required": [
                    "document_id"
                  ]
                },
                "example": {
                  "user_id": "ID50",
                  "contact_id": "ID30",
                  "created_at": "2023-11-30 10:14:58",
                  "onetime": 1,
                  "expiration_date": "2023-12-30 23:59:59",
                  "link": "https://app.docurex3.com/index.php/link/download/link/omrvcmViFW1pBNCee0VzVgSB0m3wFAv_w30spig9z6g",
