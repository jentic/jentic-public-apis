            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "post": {
        "tags": [
          "Document"
        ],
        "summary": "Generates a one click download link and sends it to a reciever via email",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "description": "the list of the download links",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/document_link"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_ids": {
                    "type": "array",
                    "description": "the list of documents to geneated a link for",
                    "items": {
                      "type": "string"
                    }
                  },
                  "contact_ids": {
                    "type": "array",
                    "description": "the list of contacts, the links should be send to",
                    "items": {
                      "type": "string"
                    }
                  },
                  "onetime": {
                    "type": "integer",
                    "description": "link can be used once(1) or multiple times(0)"
                  },
                  "expiration_date": {
                    "type": "integer",
                    "description": "date of expiration"
                  },
                  "email": {
                    "type": "string",
                    "description": "send link to this email and create a contact (optional to contact_ids)"
                  },
                  "zip": {
                    "type": "integer",
                    "description": "create a zip with all given documents(1) or create a seperated links for all given documents(0)"
                  }
                },
                "required": [
                  "expiration_date",
                  "onetime",
                  "document_ids"
                ]
              },
              "example": {
                "document_ids": [
                  "ID13219",
                  "ID13220"
                ],
                "contact_ids": [
                  "ID30"
                ],
                "onetime": 1,
                "expiration_date": "2023-12-30 23:59:59",
                "zip": 0
              }
            }
          }
        }
      }
    },
