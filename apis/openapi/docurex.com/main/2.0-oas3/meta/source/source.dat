    "/auth": {
      "post": {
        "summary": "Authenticate with a customer and an user for all further API requests",
        "tags": [
          "Authenticate"
        ],
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Auth"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "customer name"
                  },
                  "username": {
                    "type": "string",
                    "description": "user name"
                  },
                  "password": {
                    "type": "string",
                    "description": "password"
                  },
                  "authcode": {
                    "type": "integer",
                    "description": "6 char authcode, if user needs 2FA (GoogleAuth, E-Mail, SMS )"
                  }
                },
                "required": [
                  "customer",
                  "username",
                  "password"
                ],
                "example": {
                  "customer": "customer",
                  "username": "mustermann.max",
                  "password": "xxxxxxx",
                  "authcode": 12345
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Get config collection",
        "tags": [
          "Config"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "description": "Sort Order (+ = Ascending; - = Descending) id, syscode, description",
            "example": "-syscode",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "syscode",
            "description": "name of the config",
            "example": "WATERMARK",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "description",
            "description": "the description for the config setting",
            "example": "watermark",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Collection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_embedded": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "description": "the list of the customer configurations",
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Config"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "post": {
        "tags": [
          "Config"
        ],
        "summary": "Add a new config (EMAIL, DOCTYPE, METATAG)",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
