                "schema": {
                  "$ref": "#/components/schemas/Notify"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          }
        }
      },
      "post": {
        "tags": [
          "Folder"
        ],
        "summary": "Change folder notification settings",
        "parameters": [
          {
            "in": "path",
            "name": "folder_id",
            "description": "URL parameter folder_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Notify"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": {
                    "type": "integer",
                    "description": "activate or deactivate the notifications on this folder for logged in user",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "interval": {
                    "type": "integer",
                    "description": "the used interval for sending the notify emails\\\n10 - every 10 minutes\\\n1 - every hour\\\n2 - every 2 hours\\\n4 - every 4 hours\n24 - every day, use time property like 8 to define the time\\\n7 - every week, use day and time property\n",
                    "enum": [
                      10,
                      1,
                      2,
                      4,
                      24,
                      7
                    ],
                    "example": 7
                  },
                  "hour": {
                    "type": "integer",
                    "example": 8,
                    "description": "the time for dayly or weekly interval, use only full hours 0 - 23"
                  },
                  "day": {
                    "type": "string",
                    "description": "the day of the week (only for week interval)",
                    "enum": [
                      "MON",
                      "TUE",
                      "WED",
                      "THU",
                      "FRI",
                      "SAT",
                      "SUN"
                    ]
                  },
                  "subfolders": {
                    "type": "integer",
                    "description": "copy settings to all subfolders",
                    "enum": [
                      0,
                      1
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
