    "/report": {
      "post": {
        "tags": [
          "Report"
        ],
        "summary": "Get reports",
        "responses": {
          "201": {
            "description": "Created report",
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/ReportCSV"
                }
              },
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "$ref": "#/components/schemas/ReportXLSX"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "log(user actions), user(user list), document(document list) or qa(question and answers)",
                    "enum": [
                      "log",
                      "user",
                      "document",
                      "qa"
                    ]
                  },
                  "mime_type": {
                    "type": "string",
                    "description": "xlsx or csv",
                    "enum": [
                      "csv",
                      "xlsx"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "optional save_as_name, extension xlsx/csv will be added"
                  },
                  "lang": {
                    "type": "string",
                    "enum": [
                      "de",
                      "en"
                    ],
                    "description": "the language of the report. Must be de or en"
                  },
                  "abort": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "abort a running report creation (cancel request does not interupt report creation!)"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          }
        }
      }
    },
    "/orderExport": {
      "post": {
        "tags": [
          "OrderExport"
        ],
        "summary": "Orders an export of the dataroom",
        "responses": {
          "201": {
            "description": "Orders an export of the dataroom",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "406": {
            "$ref": "#/components/responses/Error406"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "full(full export with all folders and protocols), part(export only some folders (max. 3))",
                    "enum": [
                      "full",
                      "part"
                    ]
                  },
                  "folders": {
                    "type": "array",
                    "description": "name of the folder (and subfolders) to be exported. Muste be set, if type is set to part (max 3 folders)",
                    "items": {
                      "type": "string"
                    }
                  },
                  "customer_name": {
                    "type": "string",
                    "description": "name of your company"
                  },
                  "customer_address": {
                    "type": "string",
                    "description": "your companies address"
                  },
                  "customer_place": {
                    "type": "string",
                    "description": "your companies city and zip code"
                  },
                  "customer_person": {
                    "type": "string",
                    "description": "contact person"
                  },
                  "freeze_date": {
                    "type": "string",
                    "description": "Start date when the export should be done (freezes/locks the datroom)",
                    "example": "10.10.2020"
                  },
                  "medium": {
                    "type": "string",
                    "description": "The medium of the export. Muste be dvd or mac_usb/win_usb (win_usb needs the password_email to be set)",
                    "enum": [
                      "dvd",
                      "mac_usb",
                      "win_usb"
                    ]
                  },
                  "password_email": {
                    "type": "string",
                    "description": "The email address for the win_usb stick password (will be send after the export is done)"
                  },
                  "message": {
                    "type": "string",
                    "description": "An optional message with further informations"
                  },
                  "shipping": {
                    "type": "array",
                    "description": "Shipping addresses of the export (max 5)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "The shipping type with UPS. Muste be standard(UPS 2 days, 10€), express (UPS next day 12 am, 20€), express10(UPS next day 10.30 am, 25€) or expressplus(next day 9 am, 155€)",
                          "enum": [
                            "standard",
                            "express",
                            "express10",
                            "expressplus"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "example": "customer name"
                        },
                        "copies": {
                          "type": "integer",
                          "example": 1
                        },
                        "address": {
                          "type": "string",
                          "example": "customer address"
                        },
                        "place": {
                          "type": "string",
                          "example": "customer place"
                        },
                        "person": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string",
                          "description": "delivery date for this shipping address"
                        }
                      },
                      "required": [
                        "type",
                        "date",
                        "address",
                        "place",
                        "name",
                        "copies"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "customer_name",
                  "customer_address",
                  "customer_place",
                  "freeze_date",
                  "medium",
                  "shipping"
                ]
              }
            }
          }
        }
      }
    }
  },
