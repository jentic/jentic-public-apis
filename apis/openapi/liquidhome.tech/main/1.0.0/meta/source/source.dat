{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Liquid Retail ZW API",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/BEN_28/Liquid_Retail_ZW_API/1.0.0"
  },
  "servers": [
    {
      "description": "Production Environment",
      "url": "https://zw-app.liquidhome.tech/api/v1"
    }
  ],
  "paths": {
    "/banners": {
      "get": {
        "tags": [
          "Banners"
        ],
        "description": "Return all banners",
        "operationId": "getBanners",
        "responses": {
          "200": {
            "description": "Successfully fetched all banners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Banner"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": [
          "Auth"
        ],
        "description": "Sign in",
        "operationId": "signIn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "examples": [
                      "user@example.com"
                    ]
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "examples": [
                      "secret123"
                    ]
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "examples": [
                        "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "Get profile",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Successfully fetched profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileData"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "examples": [
                    "Invalid credentials"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Proxy error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "examples": [
                    "Proxy server error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/account/bills": {
      "get": {
        "tags": [
          "Bills"
        ],
        "description": "Return all bills",
        "operationId": "getBills",
        "responses": {
          "200": {
            "description": "Successfully fetched all bills",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bill"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/news": {
      "get": {
        "tags": [
          "News"
        ],
        "description": "Return all news",
        "operationId": "getNews",
        "responses": {
          "200": {
            "description": "Successfully fetched all news",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewsArticle"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "Usage"
        ],
        "description": "Get usage",
        "operationId": "getUsage",
        "responses": {
          "200": {
            "description": "Successfully fetched usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsageData"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "examples": [
                    "Invalid credentials"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "validationError": {
                    "value": {
                      "message": {
                        "serviceLogin": [
                          "The service login field is required."
                        ],
                        "days": [
                          "The days field is required."
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Proxy error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "examples": [
                    "Proxy server error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/legal": {
      "get": {
        "tags": [
          "Legal"
        ],
        "description": "Return all legal",
        "operationId": "getLegal",
        "responses": {
          "200": {
            "description": "Successfully fetched all legal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Legal"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Banner": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "examples": [
              "https://example.com"
            ]
          },
          "image": {
            "type": "string",
            "examples": [
              "banners/01KGMEHAX4BC6HAWAG5MBKHPSQ.jpg"
            ]
          },
          "imageUrl": {
            "type": "string",
            "examples": [
              "https://example.com/storage/banners/01KGMEHAX4BC6HAWAG5MBKHPSQ.jpg"
            ]
          }
        }
      },
      "ProfileData": {
        "type": "object",
        "required": [
          "litId",
          "customerKey",
          "isCompany",
          "username",
          "emailAddress",
          "mobileNumber",
          "firstName",
          "lastName",
          "fullName",
          "birthDate",
          "currentBalance",
          "services"
        ],
        "properties": {
          "litId": {
            "type": "string",
            "examples": [
              "LIT-170078"
            ]
          },
          "customerKey": {
            "type": "integer",
            "examples": [
              170078
            ]
          },
          "isCompany": {
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "username": {
            "type": "string",
            "examples": [
              "steven"
            ]
          },
          "emailAddress": {
            "type": "string",
            "format": "email",
            "examples": [
              "steven@example.com"
            ]
          },
          "mobileNumber": {
            "type": "string",
            "examples": [
              "0774524084"
            ]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date-time",
            "examples": [
              "1995-07-18T00:00:00+00:00"
            ]
          },
          "currentBalance": {
            "type": "number",
            "format": "float",
            "examples": [
              -48.6286
            ]
          },
          "billingCurrency": {
            "type": "string",
            "examples": [
              "ZWG"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "serviceKey": {
            "type": "integer"
          },
          "serviceType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "connectionType": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "quota": {
            "type": [
              "number",
              "null"
            ]
          },
          "quotaTotal": {
            "type": "number"
          },
          "quotaUsage": {
            "type": [
              "number",
              "null"
            ]
          },
          "topUp": {
            "type": [
              "number",
              "null"
            ]
          },
          "topUpExpiry": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "usage": {
            "type": "number"
          },
          "childServices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "Bill": {
        "type": "object",
        "required": [
          "billKey",
          "number",
          "total",
          "owing",
          "currency",
          "billDate"
        ],
        "properties": {
          "billKey": {
            "type": "integer",
            "examples": [
              12345
            ]
          },
          "number": {
            "type": "string",
            "examples": [
              "INV-2026-0001"
            ]
          },
          "total": {
            "type": "number",
            "format": "float",
            "examples": [
              100.5
            ]
          },
          "owing": {
            "type": "number",
            "format": "float",
            "examples": [
              25.25
            ]
          },
          "currency": {
            "type": "string",
            "examples": [
              "USD"
            ]
          },
          "billDate": {
            "type": "string",
            "format": "date-time",
            "examples": [
              "2026-02-26T10:30:00+00:00"
            ]
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "examples": [
              "2026-03-10T23:59:59+00:00",
              null
            ]
          },
          "paidDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "examples": [
              "2026-03-05T15:45:00+00:00",
              null
            ]
          },
          "pdfUrl": {
            "format": "url",
            "type": "string",
            "examples": [
              "https://zw.myliquidhome.tech/web/account/bills.aspx?download=34001212"
            ]
          }
        }
      },
      "NewsArticlePhoto": {
        "type": "object",
        "required": [
          "path",
          "ratio"
        ],
        "properties": {
          "path": {
            "type": "string",
            "format": "uri",
            "examples": [
              "https://example.com/image.png"
            ]
          },
          "ratio": {
            "type": "number",
            "examples": [
              2.73
            ]
          }
        }
      },
      "NewsArticle": {
        "type": "object",
        "required": [
          "id",
          "timeAgo",
          "title",
          "photo",
          "synopsis",
          "story"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "examples": [
              2594
            ]
          },
          "timeAgo": {
            "type": "string",
            "examples": [
              "4 years ago"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "Example title"
            ]
          },
          "photo": {
            "$ref": "#/components/schemas/NewsArticlePhoto"
          },
          "synopsis": {
            "type": "string",
            "examples": [
              "Short summary"
            ]
          },
          "story": {
            "type": "string",
            "examples": [
              "<p>How often do you access the Internet? Probably a bit too often, but how often do you do so using an insecure network?</p>\\r\\n \\r\\n <p>While we all know that the Internet is a dangerous place, accessing the World Wide Web opens us up to greater risks such as hackers, scams, and malware.</p>\\r\\n \\r\\n <p>Wherever you go online, ZOL Zimbabwe wants you to stay safe. By taking simple security measures, you can greatly reduce your exposure to threats.</p>\\r\\n \\r\\n <p><strong>Here are 5 online security basics to help you get started:</strong></p>\\r\\n \\r\\n <p>1. Hook up to a network that you know.</p>\\r\\n \\r\\n <p>Public Wi-Fi networks are often unsecured. Use trusted providers such as reputable secure networks whenever possible.</p>"
            ]
          }
        }
      },
      "UsageData": {
        "type": "object",
        "required": [
          "name",
          "received",
          "transmitted",
          "total"
        ],
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Service A"
            ]
          },
          "received": {
            "type": "integer",
            "examples": [
              1024
            ]
          },
          "transmitted": {
            "type": "integer",
            "examples": [
              2048
            ]
          },
          "total": {
            "type": "integer",
            "examples": [
              3072
            ]
          }
        }
      },
      "Legal": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "examples": [
              "Cookie Policy"
            ]
          },
          "link": {
            "type": "string",
            "examples": [
              "https://example.com/cookie-policy"
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
