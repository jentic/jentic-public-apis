            "description": "Scan/detection UUID",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/benchmarks": {
      "get": {
        "operationId": "getBenchmarks",
        "summary": "Read floored peer benchmarks",
        "description": "Floored peer benchmarks (median + IQR) for the dealer's stack metrics. Answers the moat questions: 'how do I compare to peers my size?', 'am I above or below median on this metric?', 'what's my percentile?'. Every cohort figure is k>=5-anonymized; thin cohorts return cohort_suppressed=true with only your_value.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        },
        "parameters": [
          {
            "name": "vendor_id",
            "in": "query",
            "required": false,
            "description": "Restrict to one vendor",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "metric_key",
            "in": "query",
            "required": false,
            "description": "Restrict to one metric",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohort",
            "in": "query",
            "required": false,
            "description": "Cohort axis",
            "schema": {
              "type": "string",
              "enum": [
                "size",
                "state",
                "national"
              ]
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "Reporting period",
            "schema": {
              "type": "string",
              "enum": [
                "monthly",
                "rolling-90d"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/renewals": {
      "get": {
        "operationId": "getRenewals",
        "summary": "List upcoming contract renewals + notice deadlines",
        "description": "The dealer's stack vendors with an upcoming contract renewal, each with the server-computed notice deadline (contract_end minus notice_period_days) and days remaining. Answers the moat question 'what auto-renews in N days and when is the notice deadline?'. Pass within_days to narrow to vendors whose notice deadline falls within that window. Own-stack read — no cohort.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        },
        "parameters": [
          {
            "name": "within_days",
            "in": "query",
            "required": false,
            "description": "Only return vendors whose notice deadline is within this many days",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/v1/alternatives": {
      "get": {
        "operationId": "getAlternatives",
        "summary": "Find better-fit, same-category vendor alternatives",
        "description": "Same-category catalog vendors the dealer is NOT already on, each optionally annotated with a peer benchmark for metric_key. Answers the moat question 'what could I switch to and how do peers do on it?'. Resolve the category by vendor_id (its catalog category) or an explicit category. EVERY cohort figure is k>=5-anonymized (thin cohorts return cohort_suppressed); cohort peers only — never any contact/PII.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        },
        "parameters": [
          {
            "name": "vendor_id",
            "in": "query",
            "required": false,
            "description": "Resolve the category from this vendor (the one being replaced)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Explicit category to search within",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "metric_key",
            "in": "query",
            "required": false,
            "description": "Annotate each alternative with this metric's floored cohort benchmark",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/performance/contract": {
      "get": {
        "operationId": "getPerformanceContract",
        "summary": "Get the reportable performance contract",
        "description": "The exact metrics the dealer's CURRENT stack may report — derived from the stack vendors' 042 metric schema. Read this before report_metric so reports are on-contract.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        }
      }
    },
    "/api/v1/performance": {
      "post": {
        "operationId": "reportPerformance",
        "summary": "Report performance values",
        "description": "Report performance values for stack vendors (partial-success batch). Off-contract / not-in-stack / period-mismatch rows are rejected individually; the batch still succeeds for valid rows.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "reports": [
                  {
                    "vendor_id": "00000000-0000-0000-0000-000000000000",
                    "metric_key": "avg_response_time_min",
                    "value": 4.2,
                    "period": "monthly",
                    "period_start": "2026-06-01"
                  }
                ]
              }
            }
          }
        },
        "x-openai-isConsequential": true
      },
      "get": {
        "operationId": "getOwnPerformance",
        "summary": "Read back the dealer's reported values",
        "description": "Read back the dealer's OWN reported performance values (un-floored self-read — distinct from /benchmarks, which is the k>=5 floored cohort read).",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
