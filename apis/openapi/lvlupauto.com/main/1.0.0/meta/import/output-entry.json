          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "name": "Rival Auto Group",
                "domain": "rivalauto.com"
              }
            }
          }
        },
        "x-openai-isConsequential": true
      }
    },
    "/api/v1/scan": {
      "post": {
        "operationId": "runScan",
        "summary": "Run a domain technology scan",
        "description": "Run (or cache-serve) a technology scan of a domain to detect its vendor stack. Cached results within 30 days are free; otherwise billable against the monthly cap (self scans exempt, verified server-side).",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "domain": "exampledealer.com"
              }
            }
          }
        },
        "x-openai-isConsequential": true
      }
    },
    "/api/v1/scan/{scan_id}": {
      "get": {
        "operationId": "getScanById",
        "summary": "Poll a scan by id",
        "description": "Poll a previously-started scan by id (tenant-scoped). 404 on a foreign or unknown id.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized — invalid or missing token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limited or cap exceeded"
