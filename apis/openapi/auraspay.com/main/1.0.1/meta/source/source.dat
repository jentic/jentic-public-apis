{
  "openapi": "3.1.0",
  "info": {
    "title": "AurasPay REST API",
    "version": "1.0.1",
    "description": "Official server-side merchant payment API. Platform fee: 1% per payment received; no monthly subscription or prepaid balance. Network fees are separate. Examples are illustrative. Supported assets depend on network and merchant configuration.",
    "contact": {
      "name": "AurasPay Support",
      "email": "support@auraspay.com",
      "url": "https://auraspay.com/contact"
    },
    "license": {
      "name": "AurasPay Service Agreement",
      "url": "https://auraspay.com/service-agreement"
    }
  },
  "servers": [
    {
      "url": "https://auraspay.com",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "AurasPay API documentation",
    "url": "https://auraspay.com/api-docs"
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/payment-links": {
      "post": {
        "operationId": "createPaymentLink",
        "summary": "Create a payment link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentLinkRequest"
              },
              "examples": {
                "fixedCryptoAmount": {
                  "value": {
                    "label": "Order 1042",
                    "amount": 25,
                    "currency": "USDC",
                    "network": "solana"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment link created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Creates a request, not a transfer. No creation idempotency key is documented: reconcile uncertain responses by merchant reference before retrying. testMode is metadata, not a sandbox."
      },
      "get": {
        "operationId": "listPaymentLinks",
        "summary": "List payment links",
        "responses": {
          "200": {
            "description": "Payment links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reference",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/payment-links/{id}": {
      "get": {
        "operationId": "getPaymentLink",
        "summary": "Get a payment link",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentLinkId"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/v1/payment-links/{id}/verify": {
      "post": {
        "operationId": "verifyPaymentLink",
        "summary": "Verify a payment link transaction",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentLinkId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current verification state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Triggers a blockchain check and can update status and send notifications. Use GET for read-only polling. No request body required."
      }
    },
    "/api/v1/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get the authenticated merchant account",
        "responses": {
          "200": {
            "description": "Merchant account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/v1/supported-tokens": {
      "get": {
        "operationId": "listSupportedTokens",
        "summary": "List currently supported assets and networks",
        "responses": {
          "200": {
            "description": "Supported assets and networks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportedTokensResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send the API key as a Bearer token."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "parameters": {
      "PaymentLinkId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Use data.id (UUID), not publicId or a merchant reference."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request; verify returns 400 when already completed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Payment missing; verify also uses 404 when a transaction is not yet found or verified.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Account is not active.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Transaction already attached to another payment.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Request limit reached. Back off; do not blindly retry creation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Server error. Reconcile an uncertain write before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "CreatePaymentLinkRequest": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "amount": {
            "type": [
              "string",
              "number"
            ],
            "description": "Positive crypto amount. Provide this or fiatAmount. If both are sent, amount takes precedence; prefer one."
          },
          "fiatAmount": {
            "type": [
              "string",
              "number"
            ],
            "description": "Positive fiat-denominated amount used for a crypto quote when amount is absent; not fiat settlement."
          },
          "fiatCurrency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "AED",
              "JPY",
              "CAD",
              "AUD",
              "SGD",
              "INR"
            ],
            "default": "USD"
          },
          "currency": {
            "type": "string",
            "enum": [
              "SOL",
              "USDC",
              "USDT",
              "EURC",
              "BTC",
              "ETH",
              "TRX",
              "BNB"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "solana",
              "bitcoin",
              "ethereum",
              "tron",
              "bnb"
            ]
          },
          "walletAddress": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 200
          },
          "reference": {
            "type": "string",
            "maxLength": 100
          },
          "webhookUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTP/HTTPS receiver; HTTPS strongly recommended. Configure the matching signing secret first."
          },
          "integrationPlatform": {
            "type": "string"
          },
          "storeUrl": {
            "type": "string",
            "format": "uri"
          },
          "pluginVersion": {
            "type": "string"
          },
          "testMode": {
            "type": "boolean",
            "default": false,
            "description": "Metadata only. Does not select a sandbox or testnet and does not make a payment risk-free."
          }
        },
        "anyOf": [
          {
            "required": [
              "amount"
            ]
          },
          {
            "required": [
              "fiatAmount"
            ]
          }
        ],
        "dependentRequired": {
          "integrationPlatform": [
            "storeUrl"
          ],
          "storeUrl": [
            "integrationPlatform"
          ]
        }
      },
      "PaymentLink": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string"
          },
          "publicUrl": {
            "type": "string",
            "format": "uri",
            "description": "Returned by create/get/list; use the returned URL."
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Examples: PENDING, COMPLETED, FAILED, EXPIRED."
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Merchant reference in create/get/list. Verify can return the on-chain reference instead; use GET to reconcile orders."
          },
          "recipientWallet": {
            "type": "string",
            "description": "Create response."
          },
          "recipientAddress": {
            "type": "string",
            "description": "Get response."
          },
          "transactionSignature": {
            "type": [
              "string",
              "null"
            ]
          },
          "transactionHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "PaymentResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentLink"
          }
        }
      },
      "PaymentList": {
        "type": "object",
        "required": [
          "payments",
          "pagination"
        ],
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentLink"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "currentPage",
              "totalPages",
              "totalPayments",
              "hasNextPage",
              "hasPreviousPage"
            ],
            "properties": {
              "currentPage": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              },
              "totalPayments": {
                "type": "integer"
              },
              "hasNextPage": {
                "type": "boolean"
              },
              "hasPreviousPage": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PaymentListResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentList"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "account",
          "usage"
        ],
        "properties": {
          "account": {
            "type": "object",
            "description": "Profile uses snake_case. Additional compatibility fields may be returned; do not use undocumented fields for pricing or access decisions.",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "wallet_address": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": true
          },
          "usage": {
            "type": "object",
            "properties": {
              "totalPayments": {
                "type": "integer"
              },
              "apiPayments": {
                "type": "integer"
              },
              "dashboardPayments": {
                "type": "integer"
              },
              "completedPayments": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "AccountResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Account"
          }
        }
      },
      "SupportedTokens": {
        "type": "object",
        "required": [
          "networks",
          "tokens"
        ],
        "properties": {
          "networks": {
            "type": "object",
            "additionalProperties": true
          },
          "tokens": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SupportedTokensResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/SupportedTokens"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
