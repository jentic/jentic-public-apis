    "/api/domains/add": {
      "post": {
        "tags": [
          "Domains"
        ],
        "operationId": "addDomain",
        "summary": "Add a custom domain",
        "description": "Creates a pending custom domain and returns the DNS records to publish. The domain is not attached for serving yet; POST /api/domains/{id}/verify does that once the TXT record is in place. Also reachable as POST /api/domains, with the same body, responses and rate-limit bucket.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED` before the body is read. At most 3 domains per workspace (400 `LIMIT_REACHED`, checked before body validation).\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DomainCreateRequest"
              },
              "example": {
                "domain": "go.brand.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created. Publish the TXT record, add the routing record, then call verify.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainCreateResponse"
                },
                "example": {
                  "domain": {
                    "id": "6d1f0b2a-9c3e-4f5a-8b7c-1e2d3f4a5b6c",
                    "user_id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                    "team_id": null,
                    "domain": "go.brand.com",
                    "slug": "go-brand-com",
                    "verified": false,
                    "status": "pending",
                    "txt_record": "flyn-verify=9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c",
                    "cname_target": "cname.flyn.to",
                    "last_checked_at": null,
                    "verified_at": null,
                    "placeholder": "Enter your destination URL",
                    "not_found_url": null,
                    "created_at": "2026-09-23T10:00:00.123456+00:00",
                    "updated_at": "2026-09-23T10:00:00.123456+00:00",
                    "pause_warned_at": null,
                    "pause_scheduled_at": null,
                    "paused_at": null
                  },
                  "vercel": {
                    "verified": false
                  },
                  "dnsInstructions": {
                    "txt": {
                      "type": "TXT",
                      "name": "_flyn.brand.com",
                      "value": "flyn-verify=9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c"
                    },
                    "routing": {
                      "type": "CNAME",
                      "name": "go",
                      "value": "cname.flyn.to"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "At the 3-domain cap (code `LIMIT_REACHED`, `limit` 3), or the domain is invalid or refused. Messages: \"Please enter a valid domain (e.g. links.yourbrand.com)\", \"Invalid domain format\", \"You cannot add a Flyn domain as a custom domain\", \"This domain cannot be added. Use a domain or subdomain you own, for example links.yourbrand.com.\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "You've reached the 3 custom domains limit. Remove an existing domain to add another.",
                  "code": "LIMIT_REACHED",
                  "limit": 3
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Custom domains requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "409": {
            "description": "The domain (or its hyphenated slug) is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This domain is already registered"
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests. Please try again later."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Invalid JSON, a non-string domain, or a database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to add domain"
                }
              }
            }
          }
        }
      }
    },
    "/api/domains/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainId"
        }
      ],
      "patch": {
        "tags": [
          "Domains"
        ],
        "operationId": "updateDomain",
        "summary": "Update domain settings",
        "description": "Updates `placeholder` and/or `notFoundUrl` on a domain in the caller's scope. Both values are stored, but nothing at runtime reads them yet.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan.\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.\n\nA missing, foreign or malformed id returns 500 \"Operation failed\", not 404.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DomainUpdateRequest"
              },
              "example": {
                "notFoundUrl": "https://brand.com/not-found"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated (an empty body only bumps updated_at).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainEnvelope"
                },
                "example": {
                  "domain": {
                    "id": "6d1f0b2a-9c3e-4f5a-8b7c-1e2d3f4a5b6c",
                    "user_id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                    "team_id": null,
                    "domain": "go.brand.com",
                    "slug": "go-brand-com",
                    "verified": true,
                    "status": "active",
                    "txt_record": "flyn-verify=9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c",
                    "cname_target": "cname.flyn.to",
                    "last_checked_at": "2026-09-23T10:20:00.123456+00:00",
                    "verified_at": "2026-09-23T10:20:00.123456+00:00",
                    "placeholder": "Enter your destination URL",
                    "not_found_url": "https://brand.com/not-found",
                    "created_at": "2026-09-23T10:00:00.123456+00:00",
                    "updated_at": "2026-09-23T10:20:00.123456+00:00",
                    "pause_warned_at": null,
                    "pause_scheduled_at": null,
                    "paused_at": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "Messages: \"Placeholder must be a string\", \"Placeholder must be under 500 characters\", \"Only HTTP/HTTPS URLs allowed\", \"Invalid not-found URL\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid not-found URL"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
