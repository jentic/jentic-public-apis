                  "error": "Operation failed"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Domains"
        ],
        "operationId": "deleteDomain",
        "summary": "Delete a custom domain",
        "description": "Deletes a domain in the caller's scope. First, links the caller created on it are moved back to the legacy www.flyn.to domain; teammates' links on a team domain are not moved.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan.\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "404": {
            "description": "Not found or not in scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Domain not found"
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Delete error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Operation failed"
                }
              }
            }
          }
        }
      }
    },
    "/api/domains/{id}/verify": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainId"
        }
      ],
      "post": {
        "tags": [
          "Domains"
        ],
        "operationId": "verifyDomain",
        "summary": "Verify a custom domain",
        "description": "Checks the `_flyn` TXT record; when it matches the stored token the domain is attached for serving, then routing and hosting ownership are checked and the domain row is updated. Returns 200 whether or not the domain is ready yet: read `verification`. Safe to call repeatedly, but each call rewrites status from the live checks.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED`.\n\n**Rate limit:** 5 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verification result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainVerifyResponse"
                },
                "example": {
                  "domain": {
                    "id": "6d1f0b2a-9c3e-4f5a-8b7c-1e2d3f4a5b6c",
                    "user_id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                    "team_id": null,
                    "domain": "go.brand.com",
                    "slug": "go-brand-com",
                    "verified": false,
                    "status": "pending",
                    "txt_record": "flyn-verify=9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c",
                    "cname_target": "cname.flyn.to",
                    "last_checked_at": "2026-09-23T10:05:00.123456+00:00",
                    "verified_at": null,
                    "placeholder": "Enter your destination URL",
                    "not_found_url": null,
                    "created_at": "2026-09-23T10:00:00.123456+00:00",
                    "updated_at": "2026-09-23T10:05:00.123456+00:00",
                    "pause_warned_at": null,
                    "pause_scheduled_at": null,
                    "paused_at": null
                  },
                  "verification": {
                    "verified": false,
                    "txtVerified": true,
                    "configured": false,
                    "ownershipVerified": false,
                    "ownershipChallenge": [],
                    "misconfigured": false,
                    "dnsInstructions": [
                      {
                        "type": "CNAME",
                        "name": "go",
                        "value": "cname.flyn.to"
                      }
                    ],
                    "message": "Ownership verified! Now add a CNAME record to route traffic."
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Custom domains requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not in scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Domain not found"
                }
              }
            }
          },
          "429": {
            "description": "More than 5 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many verification attempts. Please wait a moment."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Database update error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Verification failed. Please try again."
                }
              }
            }
          }
        }
      }
    },
    "/api/pixels": {
      "get": {
        "tags": [
          "Retargeting Pixels"
        ],
        "operationId": "listPixels",
        "summary": "List retargeting pixels",
        "description": "Lists saved pixels, newest first. In a team workspace: every pixel of the team, whoever created it. Otherwise: the caller's personal pixels. Each item carries `is_owner`.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan. Any team role.\n\n**Rate limit:** none.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The pixels.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PixelList"
                },
                "example": {
                  "pixels": [
                    {
                      "id": "c2d3e4f5-a6b7-4c8d-9e0f-1a2b3c4d5e6f",
                      "provider": "meta",
                      "value": "123456789012345",
                      "label": "Spring Sale",
                      "created_at": "2026-09-23T10:00:00.123456+00:00",
                      "is_owner": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "500": {
            "description": "Database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to load pixels"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Retargeting Pixels"
        ],
        "operationId": "createPixel",
        "summary": "Save a retargeting pixel",
        "description": "Saves a pixel owned by the caller and tagged with the current workspace. Attach it to links with `pixelIds`.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED`. At most 50 pixels per user.\n\n**Rate limit:** 20 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication. The bucket is shared with PATCH.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PixelCreateRequest"
              },
              "example": {
                "provider": "meta",
                "value": "123456789012345",
                "label": "Spring Sale"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PixelEnvelope"
                },
                "example": {
                  "pixel": {
                    "id": "c2d3e4f5-a6b7-4c8d-9e0f-1a2b3c4d5e6f",
                    "provider": "meta",
                    "value": "123456789012345",
                    "label": "Spring Sale",
                    "created_at": "2026-09-23T10:00:00.123456+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Messages: \"Invalid JSON\", \"Unknown pixel provider\", \"That pixel ID contains invalid characters. Use only letters, numbers, dots, dashes, underscores (and a comma for AdRoll).\", \"You've reached the 50 pixels limit.\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unknown pixel provider"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Retargeting pixels requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "429": {
            "description": "More than 20 writes in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests. Try again shortly."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Insert error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to save pixel"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Retargeting Pixels"
        ],
        "operationId": "updatePixel",
        "summary": "Edit a retargeting pixel",
        "description": "Changes the value and/or label of a pixel the caller created. The provider cannot be changed.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED`. Only the creator can edit.\n\n**Rate limit:** 20 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication. The bucket is shared with POST.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PixelIdQuery"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PixelUpdateRequest"
              },
              "example": {
                "label": "Autumn Sale"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PixelEnvelope"
                },
                "example": {
                  "pixel": {
                    "id": "c2d3e4f5-a6b7-4c8d-9e0f-1a2b3c4d5e6f",
                    "provider": "meta",
                    "value": "123456789012345",
                    "label": "Autumn Sale",
                    "created_at": "2026-09-23T10:00:00.123456+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Messages: \"Missing id\", \"Invalid JSON\", \"That pixel ID contains invalid characters. ...\", \"Nothing to update\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Nothing to update"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Retargeting pixels requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or created by a teammate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Pixel not found, or it belongs to a teammate, only its creator can edit it."
                }
              }
            }
          },
          "429": {
            "description": "More than 20 writes in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests. Try again shortly."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to update pixel"
                }
              }
            }
          }
        }
      },
