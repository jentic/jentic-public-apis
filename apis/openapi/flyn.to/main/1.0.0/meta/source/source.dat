    "/api/conversion": {
      "get": {
        "tags": [
          "Conversion Tracking"
        ],
        "operationId": "recordConversionGet",
        "summary": "Record a conversion (GET)",
        "description": "Records a conversion for a click from query parameters. Suited to image pixels and affiliate postback URLs.\n\n**Auth:** none. The click id is the credential; no cookie or API key is read. CORS is open to every origin.\n\n**Plan:** no caller plan check. The click's link must have conversion tracking on (a Pro link setting), and the click must be at most 30 days old.\n\n**Rate limit:** 60 requests per 60 s per client IP, shared by GET and POST on /api/conversion and /api/postback (fixed window, in memory per server instance). The 429 has no Retry-After.\n\nA HEAD request is answered by this same handler and also records a conversion.",
        "security": [],
        "parameters": [
          {
            "name": "click_id",
            "in": "query",
            "required": true,
            "description": "Per-click id Flyn appended to the destination as `flyn_id`. Also accepted as clickId, flyn_id, clickid or cid; the first one present wins, so an empty click_id hides a valid cid.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{10,32}$"
            }
          },
          {
            "name": "event",
            "in": "query",
            "description": "Goal name, trimmed and lower-cased; empty means conversion. Also accepted as type.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$",
              "default": "conversion"
            }
          },
          {
            "name": "value",
            "in": "query",
            "description": "Value in major units. Also accepted as payout, sum or amt. Characters other than digits, dot, comma and minus are stripped; a European decimal comma is understood; above 1,000,000 in size or unparseable becomes 0. Stored in cents; a negative value records a refund.",
            "schema": {
              "type": "string",
              "default": "0"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "ISO 4217 code, upper-cased; anything but three letters becomes USD.",
            "schema": {
              "type": "string",
              "default": "USD"
            }
          },
          {
            "name": "txid",
            "in": "query",
            "description": "Transaction id, first 64 characters kept. Also accepted as transaction_id. Part of the (click, event, txid) de-duplication key.",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded, or already recorded for this (click, event, txid) (`duplicate: true`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed click id (\"click_id missing or malformed\") or event (\"event must be 1-40 chars: a-z 0-9 _ -\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "click_id missing or malformed"
                }
              }
            }
          },
          "404": {
            "description": "Unknown click id (\"unknown click_id\"), or the link was deleted or does not have conversion tracking on (\"conversion tracking is not enabled for this link\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "unknown click_id"
                }
              }
            }
          },
          "410": {
            "description": "The click is older than the 30-day attribution window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "click is outside the 30-day attribution window"
                }
              }
            }
          },
          "429": {
            "description": "IP rate limit (\"Too many requests\", no Retry-After), or this click already has 25 conversion rows (\"conversion limit reached for this click\"). The per-click cap is permanent and is checked before de-duplication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "Too many requests"
                }
              }
            }
          },
          "503": {
            "description": "Temporary database failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "temporarily unavailable"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Conversion Tracking"
        ],
        "operationId": "recordConversion",
        "summary": "Record a conversion (POST)",
        "description": "Records a conversion for a click from a request body (JSON, form or a sendBeacon string).\n\n**Auth:** none. The click id is the credential; no cookie or API key is read. CORS is open to every origin.\n\n**Plan:** no caller plan check. The click's link must have conversion tracking on (a Pro link setting), and the click must be at most 30 days old.\n\n**Rate limit:** 60 requests per 60 s per client IP, shared by GET and POST on /api/conversion and /api/postback (fixed window, in memory per server instance). The 429 has no Retry-After.",
        "security": [],
        "parameters": [
          {
            "name": "click_id",
            "in": "query",
            "required": false,
            "description": "Per-click id Flyn appended to the destination as `flyn_id`. Also accepted as clickId, flyn_id, clickid or cid; the first one present wins, so an empty click_id hides a valid cid. On POST, body fields of the same name take precedence.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{10,32}$"
            }
          },
          {
            "name": "event",
            "in": "query",
            "description": "Goal name, trimmed and lower-cased; empty means conversion. Also accepted as type. On POST, body fields of the same name take precedence.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$",
              "default": "conversion"
            },
            "required": false
          },
          {
            "name": "value",
            "in": "query",
            "description": "Value in major units. Also accepted as payout, sum or amt. Characters other than digits, dot, comma and minus are stripped; a European decimal comma is understood; above 1,000,000 in size or unparseable becomes 0. Stored in cents; a negative value records a refund. On POST, body fields of the same name take precedence.",
            "schema": {
              "type": "string",
              "default": "0"
            },
            "required": false
          },
          {
            "name": "currency",
            "in": "query",
            "description": "ISO 4217 code, upper-cased; anything but three letters becomes USD. On POST, body fields of the same name take precedence.",
            "schema": {
              "type": "string",
              "default": "USD"
            },
            "required": false
          },
          {
            "name": "txid",
            "in": "query",
            "description": "Transaction id, first 64 characters kept. Also accepted as transaction_id. Part of the (click, event, txid) de-duplication key. On POST, body fields of the same name take precedence.",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": false,
          "description": "The body is read as text: JSON first, otherwise form-encoded. Query parameters are merged underneath, so a body field wins over the same query parameter.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversionRequest"
              },
              "example": {
                "click_id": "V1StGXR8_Z5jdHi6",
                "event": "sale",
                "value": 49,
                "currency": "USD",
                "txid": "ord_1001"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ConversionRequest"
              },
              "example": {
                "click_id": "V1StGXR8_Z5jdHi6",
                "event": "sale",
                "value": "49.00",
                "txid": "ord_1001"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "description": "A JSON or form-encoded string, as sent by navigator.sendBeacon."
              },
              "example": "{\"click_id\":\"V1StGXR8_Z5jdHi6\",\"event\":\"sale\",\"value\":49}"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded, or already recorded for this (click, event, txid) (`duplicate: true`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed click id (\"click_id missing or malformed\") or event (\"event must be 1-40 chars: a-z 0-9 _ -\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "click_id missing or malformed"
                }
              }
            }
          },
          "404": {
            "description": "Unknown click id (\"unknown click_id\"), or the link was deleted or does not have conversion tracking on (\"conversion tracking is not enabled for this link\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "unknown click_id"
                }
              }
            }
          },
          "410": {
            "description": "The click is older than the 30-day attribution window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "click is outside the 30-day attribution window"
                }
              }
            }
          },
          "429": {
            "description": "IP rate limit (\"Too many requests\", no Retry-After), or this click already has 25 conversion rows (\"conversion limit reached for this click\"). The per-click cap is permanent and is checked before de-duplication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "Too many requests"
                }
              }
            }
          },
          "503": {
            "description": "Temporary database failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResult"
                },
                "example": {
                  "ok": false,
                  "error": "temporarily unavailable"
                }
              }
            }
          }
        }
      }
    },
