    "/api/conversions": {
      "get": {
        "tags": [
          "Conversion Tracking"
        ],
        "operationId": "getConversionReport",
        "summary": "Get the conversion report",
        "description": "Summary, daily series, recent conversions and per-event totals for links in the caller's workspace.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED`. Any team role, including viewer.\n\n**Rate limit:** 60 requests per 60 s per client IP, fixed window, in memory per server instance, checked after authentication. The 429 has no Retry-After.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Window in days, clamped to 1..365; 0 or unparseable means 30.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many recent rows to return, clamped to 1..200; 0 or unparseable means 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "linkId",
            "in": "query",
            "description": "Restrict to one link in the workspace. A foreign id gives an empty report; a non-UUID gives 500.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The report. With no links in scope every list is empty; if the conversions store cannot be read the report is empty and carries `unavailable: true`. The example answers `days=2`, so the series has two entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionReport"
                },
                "example": {
                  "summary": {
                    "count": 2,
                    "valueCents": 9800,
                    "currency": "USD",
                    "days": 2,
                    "truncated": false
                  },
                  "series": [
                    {
                      "date": "2026-09-22",
                      "count": 1,
                      "valueCents": 4900
                    },
                    {
                      "date": "2026-09-23",
                      "count": 1,
                      "valueCents": 4900
                    }
                  ],
                  "recent": [
                    {
                      "id": "d4e5f6a7-b8c9-4d0e-9f1a-2b3c4d5e6f7a",
                      "linkId": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                      "slug": "summer-sale",
                      "domain": "flyn.co",
                      "title": "Summer sale",
                      "event": "sale",
                      "txid": "ord_1001",
                      "valueCents": 4900,
                      "currency": "USD",
                      "createdAt": "2026-09-23T10:00:00.123456+00:00"
                    },
                    {
                      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
                      "linkId": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                      "slug": "summer-sale",
                      "domain": "flyn.co",
                      "title": "Summer sale",
                      "event": "sale",
                      "txid": "ord_1000",
                      "valueCents": 4900,
                      "currency": "USD",
                      "createdAt": "2026-09-22T15:30:00.654321+00:00"
                    }
                  ],
                  "byEvent": [
                    {
                      "event": "sale",
                      "count": 2,
                      "valueCents": 9800
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Conversion tracking requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "429": {
            "description": "More than 60 requests in the window. Counted per client IP. This 429 carries no Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            }
          },
          "500": {
            "description": "The links lookup failed (for example a non-UUID linkId).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to load links"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "listWebhooks",
        "summary": "List webhooks",
        "description": "Lists every webhook tagged with the caller's current workspace (teammates' included) plus the caller's own untagged webhooks, newest first. Secrets are masked for API-key callers.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan. Any team role.\n\n**Rate limit:** 30 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The webhooks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookList"
                },
                "example": {
                  "webhooks": [
                    {
                      "id": "8b3c1f6e-2a4d-4f0b-9c1e-5d7a2b9e0c11",
                      "url": "https://api.example.com/hooks/flyn",
                      "events": [
                        "link.click",
                        "link.create"
                      ],
                      "secret": "whsec_3f••••••••••••••••••••••••",
                      "status": "active",
                      "createdAt": 1790157600000,
                      "lastTriggeredAt": null,
                      "failureCount": 0
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "429": {
            "description": "More than 30 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to fetch webhooks"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "createWebhook",
        "summary": "Create a webhook",
        "description": "Subscribes an endpoint to events and returns the signing secret in full. Store it now: API-key callers only ever see a masked secret afterwards. The webhook is tagged with the caller's current workspace.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** Pro, Lifetime or Team (a member of a paying owner's workspace has the effective plan `team`) only; Free gets 403 `UPGRADE_REQUIRED`. At most 10 webhooks per user (any status, any workspace).\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.\n\nAn invalid JSON body, a non-string url or a non-array events returns 500.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookCreateRequest"
              },
              "example": {
                "url": "https://api.example.com/hooks/flyn",
                "events": [
                  "link.click",
                  "link.create"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. `secret` is shown in full.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEnvelope"
                },
                "example": {
                  "webhook": {
                    "id": "8b3c1f6e-2a4d-4f0b-9c1e-5d7a2b9e0c11",
                    "url": "https://api.example.com/hooks/flyn",
                    "events": [
                      "link.click",
                      "link.create"
                    ],
                    "secret": "whsec_3f9a0c7d1e2b4a5c6d7e8f901a2b3c4d5e6f7a8b9c0d1e2f",
                    "status": "active",
                    "createdAt": 1790157600000,
                    "failureCount": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Messages: \"Webhook URL is required\", \"Only HTTP/HTTPS URLs allowed\", \"Webhook URL must be a public address\", \"Invalid URL\", \"Select at least one event\", \"Maximum 10 webhooks allowed\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Select at least one event"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "Free plan (code `UPGRADE_REQUIRED`) or a suspended account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhooks requires a paid plan. Upgrade at /pricing, Pro from $9/mo or $249 lifetime.",
                  "code": "UPGRADE_REQUIRED",
                  "upgradeUrl": "/pricing"
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Invalid JSON, a non-string url, a non-array events, or a database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to create webhook"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WebhookId"
        }
      ],
      "patch": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "updateWebhook",
        "summary": "Update a webhook",
        "description": "Changes the url, events and/or status of a webhook the caller created. Setting status `active` resets failureCount to 0, which is how a webhook disabled after 10 counted failures is switched back on.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan. Only the creator can edit, whatever their team role.\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.\n\nA webhook that does not exist, was created by someone else, or has a malformed id returns 500, not 404. An invalid JSON body also returns 500.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookUpdateRequest"
              },
              "example": {
                "status": "active"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated. API-key callers see the secret as its first 8 characters followed by \"...\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEnvelope"
                },
                "example": {
                  "webhook": {
                    "id": "8b3c1f6e-2a4d-4f0b-9c1e-5d7a2b9e0c11",
                    "url": "https://api.example.com/hooks/flyn",
                    "events": [
                      "link.click"
                    ],
                    "secret": "whsec_3f...",
                    "status": "active",
                    "createdAt": 1790157600000,
                    "lastTriggeredAt": 1790161200000,
                    "failureCount": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Messages: \"Only HTTP/HTTPS URLs allowed\", \"Webhook URL must be a public address\", \"Invalid URL\", \"Events must be a non-empty array\", \"Invalid events: <names>\", \"Status must be active or inactive\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Status must be active or inactive"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Not found, not created by the caller, malformed id, invalid JSON, or a database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to update webhook"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "testWebhook",
        "summary": "Send a test delivery",
        "description": "Sends a signed webhook.test delivery to a webhook the caller created, with the same headers and signature as real deliveries. Works on inactive webhooks and does not change failureCount or lastTriggeredAt. The outcome is reported in the 200 body, not in the HTTP status.\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan. Only the creator can test.\n\n**Rate limit:** 5 requests per 60 s per client IP, fixed window, in memory per server instance, checked after authentication. The 429 has no Retry-After.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery attempted. `success` says whether the endpoint answered 2xx.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookTestResult"
                },
                "example": {
                  "success": true,
                  "status": 200
                }
              }
            }
          },
          "400": {
            "description": "The stored URL now resolves to a private address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook URL must be a public address"
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "404": {
            "description": "No webhook with this id created by the caller, or a malformed id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "429": {
            "description": "More than 5 test deliveries in the window. Counted per client IP. This 429 carries no Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Rate limit exceeded"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "deleteWebhook",
        "summary": "Delete a webhook",
        "description": "Permanently deletes a webhook the caller created. Returns success even when no webhook matched (unknown id or someone else's).\n\n**Auth:** API key (`Bearer flyn_sk_live_...`), or the signed-in dashboard session cookie when no API key header is sent. MCP OAuth access tokens are not accepted here and get 401.\n\n**Plan:** every plan. Only the creator can delete.\n\n**Rate limit:** 10 requests per 60 s per client IP, fixed window, in memory per server instance, checked before authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Done (also when nothing matched).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "No valid API key and no dashboard session. Messages: \"Invalid or revoked API key\", \"API key has expired\", \"Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header.\", or \"Unauthorized\" when the session lookup itself fails. An MCP OAuth token lands here too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized. Sign in to the dashboard, or pass a Bearer API key in the Authorization header."
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been suspended."
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in the window. Counted per client IP. Retry-After gives the seconds until the window resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many requests"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "500": {
            "description": "Database error, for example a malformed id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to delete webhook"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "link.click": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "onLinkClick",
        "summary": "A human clicked a link",
        "description": "Sent for each human click (bots are filtered out) to the webhooks of the user who created the link. Also sent when a password-protected link is unlocked (that path does not filter bots) and for mailto:, tel: and sms: links. The payload has no os or browser field.\n\nEvery delivery is an HTTP POST with a JSON body `{event, timestamp, data}`. `X-Flyn-Signature` is `t=<timestamp>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with the full webhook secret (including the `whsec_` prefix) over `<t>.<raw request body>`. To verify: split the header on commas, recompute the HMAC over t, a dot and the raw body bytes (not a re-serialised body), compare in constant time, and reject a t (milliseconds) older than your tolerance. Flyn makes one delivery attempt per event with a 10 s timeout (redirects included). A 2xx answer counts as success; a non-2xx answer counts as a failure, and after 10 counted failures in a row the webhook is set inactive. A URL whose host resolves to a private address or fails DNS resolution is not sent to and counts as a failure. Timeouts, connection errors and redirects to a private host are not counted.",
        "security": [],
        "parameters": [
          {
            "name": "X-Flyn-Signature",
            "in": "header",
            "required": true,
            "description": "`t=<unix ms>,v1=<hex HMAC-SHA256>`.",
            "schema": {
              "type": "string",
              "pattern": "^t=\\d+,v1=[0-9a-f]{64}$"
            },
            "example": "t=1790157600000,v1=5d41402abc4b2a76b9719d911017c5925d41402abc4b2a76b9719d911017c592"
          },
          {
            "name": "X-Flyn-Event",
            "in": "header",
            "required": true,
            "description": "The event name, same as `event` in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "description": "Always `Flyn-Webhook/1.0`.",
            "schema": {
              "type": "string",
              "const": "Flyn-Webhook/1.0"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkClickEvent"
              },
              "example": {
                "event": "link.click",
                "timestamp": 1790157600000,
                "data": {
                  "linkId": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                  "slug": "summer-sale",
                  "destinationUrl": "https://shop.example.com/sale",
                  "country": "US",
                  "city": "Austin",
                  "device": "mobile",
                  "referrer": "https://www.instagram.com/",
                  "variant": "B"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return any 2xx to acknowledge the delivery."
          }
        }
      }
    },
    "link.create": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "onLinkCreate",
        "summary": "A link was created",
        "description": "Sent to the acting user's webhooks when a link is created with POST /api/links (data is the full Link) or in the Flyn dashboard (data is `{id, slug, destinationUrl, domain}`). Links created with POST /api/shorten or POST /api/links/bulk-create do not send it.\n\nEvery delivery is an HTTP POST with a JSON body `{event, timestamp, data}`. `X-Flyn-Signature` is `t=<timestamp>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with the full webhook secret (including the `whsec_` prefix) over `<t>.<raw request body>`. To verify: split the header on commas, recompute the HMAC over t, a dot and the raw body bytes (not a re-serialised body), compare in constant time, and reject a t (milliseconds) older than your tolerance. Flyn makes one delivery attempt per event with a 10 s timeout (redirects included). A 2xx answer counts as success; a non-2xx answer counts as a failure, and after 10 counted failures in a row the webhook is set inactive. A URL whose host resolves to a private address or fails DNS resolution is not sent to and counts as a failure. Timeouts, connection errors and redirects to a private host are not counted.",
        "security": [],
        "parameters": [
          {
            "name": "X-Flyn-Signature",
            "in": "header",
            "required": true,
            "description": "`t=<unix ms>,v1=<hex HMAC-SHA256>`.",
            "schema": {
              "type": "string",
              "pattern": "^t=\\d+,v1=[0-9a-f]{64}$"
            },
            "example": "t=1790157600000,v1=5d41402abc4b2a76b9719d911017c5925d41402abc4b2a76b9719d911017c592"
          },
          {
            "name": "X-Flyn-Event",
            "in": "header",
            "required": true,
            "description": "The event name, same as `event` in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "description": "Always `Flyn-Webhook/1.0`.",
            "schema": {
              "type": "string",
              "const": "Flyn-Webhook/1.0"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkCreateEvent"
              },
              "example": {
                "event": "link.create",
                "timestamp": 1790157600000,
                "data": {
                  "id": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                  "slug": "summer-sale",
                  "url": "https://shop.example.com/sale",
                  "shortUrl": "https://flyn.co/summer-sale",
                  "domain": "flyn.co",
                  "title": "shop.example.com",
                  "clicks": 0,
                  "botClicks": 0,
                  "qrScans": 0,
                  "totalClicks": 0,
                  "status": "active",
                  "tags": [
                    "q3"
                  ],
                  "createdAt": "2026-09-23T10:00:00.123456+00:00",
                  "expiresAt": null,
                  "folderId": null,
                  "password": false,
                  "ogTitle": null,
                  "ogDescription": null,
                  "ogImage": null,
                  "targeting": null,
                  "cloaking": false,
                  "noIndex": false,
                  "notes": null,
                  "abUrlB": null,
                  "abSplit": null,
                  "rotation": null,
                  "deepLink": false,
                  "pixelIds": [],
                  "forwardParams": true,
                  "clickLimit": null,
                  "fallbackUrl": null,
                  "conversionTracking": false,
                  "conversions": 0,
                  "conversionValueCents": 0,
                  "conversionCurrency": null
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return any 2xx to acknowledge the delivery."
          }
        }
      }
    },
    "link.update": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "onLinkUpdate",
        "summary": "A link was edited",
        "description": "Sent to the acting user's webhooks (not necessarily the link creator's) when a link is edited with PATCH /api/links/{id} (data is the full updated Link) or in the Flyn dashboard (data is the id plus the changed fields).\n\nEvery delivery is an HTTP POST with a JSON body `{event, timestamp, data}`. `X-Flyn-Signature` is `t=<timestamp>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with the full webhook secret (including the `whsec_` prefix) over `<t>.<raw request body>`. To verify: split the header on commas, recompute the HMAC over t, a dot and the raw body bytes (not a re-serialised body), compare in constant time, and reject a t (milliseconds) older than your tolerance. Flyn makes one delivery attempt per event with a 10 s timeout (redirects included). A 2xx answer counts as success; a non-2xx answer counts as a failure, and after 10 counted failures in a row the webhook is set inactive. A URL whose host resolves to a private address or fails DNS resolution is not sent to and counts as a failure. Timeouts, connection errors and redirects to a private host are not counted.",
        "security": [],
        "parameters": [
          {
            "name": "X-Flyn-Signature",
            "in": "header",
            "required": true,
            "description": "`t=<unix ms>,v1=<hex HMAC-SHA256>`.",
            "schema": {
              "type": "string",
              "pattern": "^t=\\d+,v1=[0-9a-f]{64}$"
            },
            "example": "t=1790157600000,v1=5d41402abc4b2a76b9719d911017c5925d41402abc4b2a76b9719d911017c592"
          },
          {
            "name": "X-Flyn-Event",
            "in": "header",
            "required": true,
            "description": "The event name, same as `event` in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "description": "Always `Flyn-Webhook/1.0`.",
            "schema": {
              "type": "string",
              "const": "Flyn-Webhook/1.0"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkUpdateEvent"
              },
              "example": {
                "event": "link.update",
                "timestamp": 1790161200000,
                "data": {
                  "id": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                  "slug": "summer-sale",
                  "url": "https://shop.example.com/sale-v2",
                  "shortUrl": "https://flyn.co/summer-sale",
                  "domain": "flyn.co",
                  "title": "Summer sale",
                  "clicks": 42,
                  "botClicks": 3,
                  "qrScans": 5,
                  "totalClicks": 45,
                  "status": "active",
                  "tags": [
                    "q3"
                  ],
                  "createdAt": "2026-09-23T10:00:00.123456+00:00",
                  "expiresAt": null,
                  "folderId": null,
                  "password": false,
                  "ogTitle": null,
                  "ogDescription": null,
                  "ogImage": null,
                  "targeting": null,
                  "cloaking": false,
                  "noIndex": false,
                  "notes": null,
                  "abUrlB": null,
                  "abSplit": null,
                  "rotation": null,
                  "deepLink": false,
                  "pixelIds": [],
                  "forwardParams": true,
                  "clickLimit": null,
                  "fallbackUrl": null,
                  "conversionTracking": false,
                  "conversions": 0,
                  "conversionValueCents": 0,
                  "conversionCurrency": null
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return any 2xx to acknowledge the delivery."
          }
        }
      }
    },
    "link.delete": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "onLinkDelete",
        "summary": "A link was deleted",
        "description": "Sent to the acting user's webhooks when a link is deleted (API or dashboard). data is the link as it was before deletion.\n\nEvery delivery is an HTTP POST with a JSON body `{event, timestamp, data}`. `X-Flyn-Signature` is `t=<timestamp>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with the full webhook secret (including the `whsec_` prefix) over `<t>.<raw request body>`. To verify: split the header on commas, recompute the HMAC over t, a dot and the raw body bytes (not a re-serialised body), compare in constant time, and reject a t (milliseconds) older than your tolerance. Flyn makes one delivery attempt per event with a 10 s timeout (redirects included). A 2xx answer counts as success; a non-2xx answer counts as a failure, and after 10 counted failures in a row the webhook is set inactive. A URL whose host resolves to a private address or fails DNS resolution is not sent to and counts as a failure. Timeouts, connection errors and redirects to a private host are not counted.",
        "security": [],
        "parameters": [
          {
            "name": "X-Flyn-Signature",
            "in": "header",
            "required": true,
            "description": "`t=<unix ms>,v1=<hex HMAC-SHA256>`.",
            "schema": {
              "type": "string",
              "pattern": "^t=\\d+,v1=[0-9a-f]{64}$"
            },
            "example": "t=1790157600000,v1=5d41402abc4b2a76b9719d911017c5925d41402abc4b2a76b9719d911017c592"
          },
          {
            "name": "X-Flyn-Event",
            "in": "header",
            "required": true,
            "description": "The event name, same as `event` in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "description": "Always `Flyn-Webhook/1.0`.",
            "schema": {
              "type": "string",
              "const": "Flyn-Webhook/1.0"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkDeleteEvent"
              },
              "example": {
                "event": "link.delete",
                "timestamp": 1790164800000,
                "data": {
                  "id": "3f0c2a9e-7b1d-4c55-9a0e-2d8f1b6c4e11",
                  "slug": "summer-sale",
                  "url": "https://shop.example.com/sale-v2",
                  "shortUrl": "https://flyn.co/summer-sale",
                  "domain": "flyn.co",
                  "title": "Summer sale",
                  "clicks": 42,
                  "botClicks": 3,
                  "qrScans": 5,
                  "totalClicks": 45,
                  "status": "active",
                  "tags": [
                    "q3"
                  ],
                  "createdAt": "2026-09-23T10:00:00.123456+00:00",
                  "expiresAt": null,
                  "folderId": null,
                  "password": false,
                  "ogTitle": null,
                  "ogDescription": null,
                  "ogImage": null,
                  "targeting": null,
                  "cloaking": false,
                  "noIndex": false,
                  "notes": null,
                  "abUrlB": null,
                  "abSplit": null,
                  "rotation": null,
                  "deepLink": false,
                  "pixelIds": [],
                  "forwardParams": true,
                  "clickLimit": null,
                  "fallbackUrl": null,
                  "conversionTracking": false,
                  "conversions": 0,
                  "conversionValueCents": 0,
                  "conversionCurrency": null
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return any 2xx to acknowledge the delivery."
          }
        }
      }
    },
    "webhook.test": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "onWebhookTest",
        "summary": "Test delivery",
        "description": "Sent only by POST /api/webhooks/{id}. It cannot be subscribed to.\n\nEvery delivery is an HTTP POST with a JSON body `{event, timestamp, data}`. `X-Flyn-Signature` is `t=<timestamp>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with the full webhook secret (including the `whsec_` prefix) over `<t>.<raw request body>`. To verify: split the header on commas, recompute the HMAC over t, a dot and the raw body bytes (not a re-serialised body), compare in constant time, and reject a t (milliseconds) older than your tolerance. Flyn makes one delivery attempt per event with a 10 s timeout (redirects included). A 2xx answer counts as success; a non-2xx answer counts as a failure, and after 10 counted failures in a row the webhook is set inactive. A URL whose host resolves to a private address or fails DNS resolution is not sent to and counts as a failure. Timeouts, connection errors and redirects to a private host are not counted.",
        "security": [],
        "parameters": [
          {
            "name": "X-Flyn-Signature",
            "in": "header",
            "required": true,
            "description": "`t=<unix ms>,v1=<hex HMAC-SHA256>`.",
            "schema": {
              "type": "string",
              "pattern": "^t=\\d+,v1=[0-9a-f]{64}$"
            },
            "example": "t=1790157600000,v1=5d41402abc4b2a76b9719d911017c5925d41402abc4b2a76b9719d911017c592"
          },
          {
            "name": "X-Flyn-Event",
            "in": "header",
            "required": true,
            "description": "The event name, same as `event` in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "description": "Always `Flyn-Webhook/1.0`.",
            "schema": {
              "type": "string",
              "const": "Flyn-Webhook/1.0"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookTestEvent"
              },
              "example": {
                "event": "webhook.test",
                "timestamp": 1790157600000,
                "data": {
                  "message": "This is a test webhook from Flyn"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return any 2xx to acknowledge the delivery."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "flyn_sk_live_<64 hex>",
        "description": "API key sent as `Authorization: Bearer flyn_sk_live_<64 hex>` (the prefix is case-sensitive). Create keys in Settings > API Keys on a Pro, Lifetime or Team plan. OAuth access tokens issued to MCP clients (`Bearer flyn_mcp_at_...`, every plan) are accepted only by GET and POST /api/links, GET /api/links/{id}/clicks, GET /api/links/{id}/qr, POST /api/qr and POST /api/shorten; every other authenticated endpoint answers 401 to them (the conversion ingest endpoints need no authentication and ignore the header)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Error envelope used by every endpoint except the conversion ingest (see ConversionResult). `error` is always present; the other fields appear only on some errors.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable message."
          },
          "code": {
            "type": "string",
            "description": "Machine-readable code, when one applies.",
            "enum": [
              "UPGRADE_REQUIRED",
              "DESTINATION_BLOCKED",
              "INVALID_TARGETING",
              "ROTATION_ACTIVE",
              "LIMIT_REACHED",
              "DAILY_LIMIT",
              "MONTHLY_LIMIT"
            ]
          },
          "upgradeUrl": {
            "type": "string",
            "description": "Where to upgrade. `/pricing` on most gates, `/settings/billing` on the POST /api/shorten monthly cap."
          },
          "limit": {
            "type": "integer",
            "description": "The limit that was hit (Free monthly link cap, custom domain cap)."
          },
          "used": {
            "type": "integer",
            "description": "How much of the limit is used (Free monthly link cap on POST /api/links)."
          },
          "premiumFields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paid-only request fields that were sent on a Free plan."
          },
          "category": {
            "type": "string",
            "description": "Why a destination was blocked (DESTINATION_BLOCKED only), for example `malware`."
          },
          "signupUrl": {
            "type": "string",
            "description": "Sign-up page (DAILY_LIMIT only)."
          }
        },
        "additionalProperties": true
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages",
          "hasMore"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "description": "Current page, starting at 1."
          },
          "limit": {
            "type": "integer",
            "description": "Items per page after clamping."
          },
          "total": {
            "type": "integer",
            "description": "Total matching items."
          },
          "totalPages": {
            "type": "integer",
            "description": "ceil(total / limit)."
          },
          "hasMore": {
            "type": "boolean",
            "description": "True when another page exists."
          }
        }
      },
      "RotationEntry": {
        "type": "object",
        "description": "One weighted destination of an N-way rotation.",
        "required": [
          "id",
          "url",
          "weight",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable destination id (8 characters when minted by Flyn). Reported as `variant` on link.click deliveries."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Destination URL."
          },
          "weight": {
            "type": "number",
            "description": "Relative weight, not a percentage. Weights are normalised when a visitor is routed."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional display label."
          }
        }
      },
      "RotationEntryInput": {
        "type": "object",
        "required": [
          "url",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Keep an existing destination id. Missing ids are minted (8 characters)."
          },
          "url": {
            "type": "string",
            "description": "Destination. `https://` is prepended when there is no scheme; must be http or https and resolve to a public IP (else 400); safety scanned (422). An entry with an empty or missing url is dropped silently, not rejected."
          },
          "weight": {
            "type": "number",
            "description": "Relative weight. Non-finite or <= 0 becomes 0 (never served). If every weight is 0, no rotation is stored."
          },
          "label": {
            "type": "string",
            "description": "Optional display label."
          }
        }
      },
      "Targeting": {
        "type": "object",
        "description": "Smart-routing rules as stored. `device.ios` and `device.android` apply only to iOS and Android visitors and take priority; `geo` maps ISO 3166-1 alpha-2 country codes (upper case) to a destination and applies to every visitor whose country is known, desktop included. A visitor matching no rule falls through to the rotation, or the legacy A/B split, when one is set, else goes to the link url.",
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ios": {
                "type": "string",
                "description": "Destination for iOS visitors."
              },
              "android": {
                "type": "string",
                "description": "Destination for Android visitors."
              }
            }
          },
          "geo": {
            "type": "object",
            "description": "Country code to destination, for example {\"US\": \"https://example.com/us\"}.",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Link": {
        "type": "object",
        "description": "A short link, as returned by every /api/links endpoint and sent in link.create, link.update and link.delete webhook deliveries. Every field is always present.",
        "required": [
          "id",
          "slug",
          "url",
          "shortUrl",
          "domain",
          "title",
          "clicks",
          "botClicks",
          "qrScans",
          "totalClicks",
          "status",
          "tags",
          "createdAt",
          "expiresAt",
          "folderId",
          "password",
          "ogTitle",
          "ogDescription",
          "ogImage",
          "targeting",
          "cloaking",
          "noIndex",
          "notes",
          "abUrlB",
          "abSplit",
          "rotation",
          "deepLink",
          "pixelIds",
          "forwardParams",
          "clickLimit",
          "fallbackUrl",
          "conversionTracking",
          "conversions",
          "conversionValueCents",
          "conversionCurrency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Link id."
          },
          "slug": {
            "type": "string",
            "description": "Back-half of the short URL."
          },
          "url": {
            "type": "string",
            "description": "Destination URL."
          },
          "shortUrl": {
            "type": "string",
            "format": "uri",
            "description": "Full short URL, `https://<domain>/<slug>`."
          },
          "domain": {
            "type": "string",
            "description": "Short domain the link lives on. New links default to the current Flyn short domain."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display title."
          },
          "clicks": {
            "type": "integer",
            "description": "Human clicks (bots and scanners excluded). This is the headline number."
          },
          "botClicks": {
            "type": "integer",
            "description": "Clicks filtered out as bots or scanners."
          },
          "qrScans": {
            "type": "integer",
            "description": "Clicks that arrived from a Flyn QR code; a subset of `clicks`."
          },
          "totalClicks": {
            "type": "integer",
            "description": "`clicks` + `botClicks`."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "archived"
            ],
            "description": "Stored status. A link past `expiresAt` keeps `active` here; the redirect checks the expiry itself."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Expiry as stored (ISO 8601), or null."
          },
          "folderId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "password": {
            "type": "boolean",
            "description": "True when the link is password protected. The password itself is never returned."
          },
          "ogTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "ogDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "ogImage": {
            "type": [
              "string",
              "null"
            ]
          },
          "targeting": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Targeting"
              },
              {
                "type": "null"
              }
            ],
            "description": "Smart-routing rules, or null when there are none."
          },
          "cloaking": {
            "type": "boolean"
          },
          "noIndex": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Private notes."
          },
          "abUrlB": {
            "type": [
              "string",
              "null"
            ],
            "description": "Legacy two-way A/B view of `rotation`, kept for older integrations."
          },
          "abSplit": {
            "type": [
              "number",
              "null"
            ],
            "description": "Legacy A/B split: percent kept on the primary url."
          },
          "rotation": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RotationEntry"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Weighted destinations, or null when the link does not rotate."
          },
          "deepLink": {
            "type": "boolean",
            "description": "Native-app handoff mode on mobile."
          },
          "pixelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Retargeting pixels fired on click."
          },
          "forwardParams": {
            "type": "boolean",
            "description": "Query-string passthrough to the destination."
          },
          "clickLimit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Maximum human clicks. Once reached, visitors go to `fallbackUrl`, or to the expired-link page when no http(s) `fallbackUrl` is set."
          },
          "fallbackUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Destination after the click limit is reached."
          },
          "conversionTracking": {
            "type": "boolean",
            "description": "When true, each human click gets a `flyn_id` click id for conversion pings."
          },
          "conversions": {
            "type": "integer",
            "description": "Recorded conversions, net of refunds (never below 0)."
          },
          "conversionValueCents": {
            "type": "integer",
            "description": "Summed conversion value in minor units."
          },
          "conversionCurrency": {
            "type": [
              "string",
              "null"
            ],
            "description": "Currency of the summed value."
          }
        }
      },
      "LinkList": {
        "type": "object",
        "required": [
          "links",
          "pagination"
        ],
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "LinkCreateRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "description": "Fields marked **Pro** return 403 `UPGRADE_REQUIRED` (with `premiumFields`) on a Free plan when sent with a real value. An empty string, false, 0, [] or {} does not count as a value; targeting and rotation count only when they normalise to real rules.",
        "properties": {
          "url": {
            "type": "string",
            "description": "Destination. Trimmed; `https://` is prepended unless it starts with http:, https:, mailto:, tel:, sms: or ftp:. ftp: is always refused. For http(s): the host must contain a dot, must not be a Flyn host, and must resolve in DNS to a public IP (else 400 \"Private/internal URLs are not allowed\"). mailto:, tel: and sms: skip host checks. Then a safety scan (422 when blocked); a deeper scan runs after the response and can disable the link later."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 100,
            "description": "Custom back-half. Not a reserved word (case-insensitive). Default: 6 random characters. Unique per domain (409 on clash)."
          },
          "domain": {
            "type": "string",
            "description": "Short domain. Default: the current Flyn short domain; the legacy value `www.flyn.to` is treated as a request for that default. Any other value must exactly match (case-sensitive) a custom domain owned by the workspace, else 403. **Pro** for any custom domain."
          },
          "title": {
            "type": "string",
            "description": "Display title. Default: the part of the URL after `//` up to the next `/` (usually the hostname, but it keeps any port or userinfo, and a query or fragment when there is no path), else \"Untitled\"."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "**Pro.** Tags. Default []."
          },
          "password": {
            "type": "string",
            "description": "**Pro.** Password gate (stored as a bcrypt hash). An empty string is ignored."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry (ISO 8601). Must parse as a date; past dates are accepted and stored as sent."
          },
          "folderId": {
            "type": "string",
            "format": "uuid",
            "description": "Folder in the workspace, else 404."
          },
          "ogTitle": {
            "type": "string",
            "description": "Social preview title."
          },
          "ogDescription": {
            "type": "string",
            "description": "Social preview description."
          },
          "ogImage": {
            "type": "string",
            "format": "uri",
            "description": "Social preview image. http or https; the host must resolve to a public IP."
          },
          "targeting": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Targeting"
              }
            ],
            "description": "**Pro.** Strict shape `{device?: {ios?, android?}, geo?: {<ISO alpha-2>: url}}`. Any other key, a non-object, a non-string value or a geo key that is not two letters returns 400 `INVALID_TARGETING`. Country codes are upper-cased, values trimmed, empty parts dropped. Values are safety scanned (422) but not validated as URLs, except that a value on a Flyn host returns 400 \"Cannot shorten Flyn URLs\"."
          },
          "cloaking": {
            "type": "boolean",
            "description": "**Pro.** Cloaking."
          },
          "noIndex": {
            "type": "boolean",
            "description": "**Pro.** No-index flag."
          },
          "notes": {
            "type": "string",
            "description": "Private notes."
          },
          "rotation": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "$ref": "#/components/schemas/RotationEntryInput"
            },
            "description": "**Pro.** Weighted rotation across up to 12 destinations (more returns 400). Each destination must be http or https, must not be a Flyn host (400 \"Cannot shorten Flyn URLs\"), must not resolve to a private address (400), and is safety scanned (422)."
          },
          "abUrlB": {
            "type": "string",
            "description": "**Pro.** Legacy A/B variant URL. http or https, not a Flyn host (400 \"Cannot shorten Flyn URLs\"), public IP, safety scanned (422)."
          },
          "abSplit": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "**Pro.** Legacy A/B split, percent kept on the primary url. Clamped to 0..100; a non-finite value becomes 50."
          },
          "deepLink": {
            "type": "boolean",
            "default": false,
            "description": "**Pro.** Serve the native-app handoff page on mobile. null returns 400."
          },
          "pixelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "**Pro.** Saved pixel ids to fire. Ids outside the workspace are dropped silently. If any id is not a valid UUID, every id is dropped (no error)."
          },
          "forwardParams": {
            "type": "boolean",
            "default": true,
            "description": "Pass the short link's query string through to the destination."
          },
          "clickLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "**Pro.** Maximum human clicks. null or \"\" is ignored."
          },
          "fallbackUrl": {
            "type": "string",
            "description": "**Pro.** Destination once the click limit is reached. `https://` is prepended; http or https, not a Flyn host, public IP, safety scanned (422)."
          },
          "conversionTracking": {
            "type": "boolean",
            "default": false,
            "description": "**Pro.** Only the literal `true` enables it."
          }
        }
      },
      "LinkUpdateRequest": {
        "type": "object",
        "minProperties": 1,
        "description": "Send only the fields to change. At least one recognised field is required (else 400 \"No fields to update\"). Fields marked **Pro** return 403 `UPGRADE_REQUIRED` on a Free plan when set to a real value; false, [], null and \"\" pass that plan check so a downgraded account can switch features off, but null is refused (400) for domain, deepLink, forwardParams and pixelIds: send the default short domain, false or [] instead.",
        "properties": {
          "url": {
            "type": "string",
            "description": "New destination. Same rules as create, except the host does not need a dot. On a rotating link the first rotation destination is re-pointed too. null or an empty string returns 400."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 100,
            "description": "New back-half; not reserved; 409 on clash. null or an empty string returns 400."
          },
          "domain": {
            "type": "string",
            "description": "Moves the link to another short domain. The current Flyn short domain, or the legacy value `www.flyn.to`, moves it back to the default. Any other value must exactly match (case-sensitive) a custom domain owned by the workspace (the team in a team workspace, otherwise your own), else 403 \"Domain not found or not owned by you\"; that includes `flyn.to` and other customers' domains. A pending or paused domain is accepted, but the link does not serve until the domain is active. Sending the link's current domain changes nothing. **Pro** for a custom domain. null or an empty string returns 400."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "archived"
            ],
            "description": "Any other value returns 400, including an empty string or null."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "**Pro** when non-empty. Replaces the array."
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "**Pro** when non-empty. A non-empty string is hashed and set; null or \"\" removes the password."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Must parse as a date; null clears it."
          },
          "folderId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Folder in the workspace (404 otherwise); null clears it."
          },
          "ogTitle": {
            "type": "string"
          },
          "ogDescription": {
            "type": "string"
          },
          "ogImage": {
            "type": "string",
            "description": "http or https, public IP."
          },
          "targeting": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Targeting"
              },
              {
                "type": "null"
              }
            ],
            "description": "**Pro** when it normalises to rules. Same strict shape as create (400 `INVALID_TARGETING`). null clears all rules. A value on a Flyn host returns 400 \"Cannot shorten Flyn URLs\"."
          },
          "cloaking": {
            "type": "boolean",
            "description": "**Pro** when true."
          },
          "noIndex": {
            "type": "boolean",
            "description": "**Pro** when true."
          },
          "notes": {
            "type": "string"
          },
          "rotation": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "$ref": "#/components/schemas/RotationEntryInput"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "**Pro** when it normalises to a rotation. Replaces the whole list (existing ids kept, missing ids minted). [], null or an all-invalid list clears the rotation and also clears abUrlB/abSplit unless abUrlB is sent in the same body. Destinations follow the create rules, including 400 \"Cannot shorten Flyn URLs\" for a Flyn host."
          },
          "abUrlB": {
            "type": [
              "string",
              "null"
            ],
            "description": "**Pro** when non-empty. Returns 409 `ROTATION_ACTIVE` when the link has a stored rotation other than the legacy two-destination A/B pair (ids A and B) and `rotation` is not sent in the same request; update `rotation` instead. Otherwise the create rules apply, including 400 \"Cannot shorten Flyn URLs\" for a Flyn host."
          },
          "abSplit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "**Pro** when non-zero. Clamped to 0..100; same 409 rule as abUrlB."
          },
          "deepLink": {
            "type": "boolean",
            "description": "**Pro** when true. Send a JSON boolean; null returns 400."
          },
          "pixelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "**Pro** when non-empty. Ids outside the workspace are dropped; [] clears; null returns 400. If any id is not a valid UUID the list is set to []."
          },
          "forwardParams": {
            "type": "boolean",
            "description": "null returns 400."
          },
          "clickLimit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 2147483647,
            "description": "**Pro** when set. null or \"\" clears it."
          },
          "fallbackUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "**Pro** when set. null or \"\" clears it; otherwise the same rules as create."
          },
          "conversionTracking": {
            "type": "boolean",
            "description": "**Pro** when true. Stored as `value === true`, so any other value (including the string \"true\") turns tracking off."
          }
        }
      },
      "LinkDeleted": {
        "type": "object",
        "required": [
          "deleted",
          "id"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "const": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "BulkCreateRequest": {
        "type": "object",
        "required": [
          "url",
          "quantity"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Shared destination. Same rules as POST /api/links (https:// prepended, mailto:, tel: and sms: accepted, ftp refused, host with a dot, not a Flyn host, public DNS). One safety scan covers the batch (422)."
          },
          "quantity": {
            "type": "integer",
            "minimum": 2,
            "maximum": 50,
            "description": "How many links. Floored first, so 2.9 becomes 2; numeric strings are accepted."
          },
          "tag": {
            "type": "string",
            "maxLength": 50,
            "description": "Batch tag. Trimmed and cut to 50 characters. Default `batch-<6 random characters>`."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "description": "Shared title. Trimmed and cut to 200 characters. Default: the part of the URL after `//` up to the next `/` (usually the hostname, but it keeps any port or userinfo, and a query or fragment when there is no path), else \"Untitled\"."
          },
          "domain": {
            "type": "string",
            "description": "Default: the current Flyn short domain; the legacy value `www.flyn.to` is treated as a request for that default. Any other value must be a custom domain owned by the workspace, else 403."
          }
        }
      },
      "BulkCreateResponse": {
        "type": "object",
        "required": [
          "created",
          "tag",
          "url",
          "links"
        ],
        "properties": {
          "created": {
            "type": "integer"
          },
          "tag": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slug",
                "shortUrl"
              ],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "shortUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "ShortenRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Destination (raw length at most 2048). Scheme rules as POST /api/links. For http(s): the host needs a dot, must not be a Flyn host, passes a category blocklist (422), must resolve publicly (else 400 \"Invalid URL\"), then a safety scan (422)."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 100,
            "description": "Custom back-half, allowed for anonymous callers too. Default: 6 random characters. 409 on clash."
          },
          "domain": {
            "type": "string",
            "description": "Anonymous callers always get the anonymous short domain; this field is ignored. Authenticated callers default to the current Flyn short domain (the legacy value `www.flyn.to` is treated as a request for that default); any other value must be a custom domain owned in scope, else 403."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stored as sent for every caller. Default []."
          }
        }
      },
      "ShortenResponse": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "shortUrl",
          "expiresAt",
          "authenticated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "shortUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Anonymous links expire 24 hours after creation; authenticated links have no expiry (null)."
          },
          "authenticated": {
            "type": "boolean",
            "description": "True when the link belongs to an account (API key or session)."
          }
        }
      },
      "QrApplied": {
        "type": "object",
        "description": "The render options actually applied. `size` is the real pixel width after snapping to whole modules.",
        "required": [
          "size",
          "margin",
          "level",
          "fg",
          "bg",
          "format",
          "moduleSize",
          "symbolModules"
        ],
        "properties": {
          "size": {
            "type": "integer"
          },
          "margin": {
            "type": "integer"
          },
          "level": {
            "type": "string",
            "enum": [
              "L",
              "M",
              "Q",
              "H"
            ]
          },
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "svg"
            ]
          },
          "moduleSize": {
            "type": "integer",
            "description": "Pixels per module."
          },
          "symbolModules": {
            "type": "integer",
            "description": "Modules per side of the QR symbol, quiet zone excluded."
          }
        }
      },
      "LinkQrResponse": {
        "type": "object",
        "required": [
          "shortUrl",
          "qrDataUrl",
          "qr"
        ],
        "properties": {
          "shortUrl": {
            "type": "string",
            "format": "uri",
            "description": "The clean short URL. The image itself encodes this URL plus `?flyn_qr=1`, the scan marker behind `qrScans`."
          },
          "qrDataUrl": {
            "type": "string",
            "description": "`data:image/png;base64,...`, or `data:image/svg+xml;base64,...` for SVG."
          },
          "svg": {
            "type": "string",
            "description": "SVG markup; present only when format=svg."
          },
          "qr": {
            "$ref": "#/components/schemas/QrApplied"
          }
        }
      },
      "QrRequest": {
        "type": "object",
        "description": "Set `type` and the fields that type needs. Non-string field values are ignored. Free plans may use url, text and wifi with PNG and the default colours; vcard, email, phone, sms, SVG and custom colours need Pro.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "url",
              "text",
              "wifi",
              "vcard",
              "email",
              "phone",
              "sms"
            ],
            "default": "url",
            "description": "Content type. vcard, email, phone and sms are **Pro** (checked before field validation)."
          },
          "url": {
            "type": "string",
            "description": "Required for type url. Trimmed and encoded as sent: no URL validation, no safety scan, no scan marker."
          },
          "text": {
            "type": "string",
            "description": "Required for type text. Not trimmed; whitespace only fails with \"Nothing to encode.\"."
          },
          "wifiSsid": {
            "type": "string",
            "description": "Required for type wifi."
          },
          "wifiPass": {
            "type": "string",
            "description": "Wi-Fi password; left out when wifiEnc is nopass."
          },
          "wifiEnc": {
            "type": "string",
            "enum": [
              "WPA",
              "WEP",
              "nopass"
            ],
            "default": "WPA",
            "description": "WPA3 networks use WPA."
          },
          "wifiHidden": {
            "type": "boolean",
            "description": "Only literal true marks the network hidden."
          },
          "vcName": {
            "type": "string",
            "description": "Required for type vcard."
          },
          "vcOrg": {
            "type": "string"
          },
          "vcPhone": {
            "type": "string",
            "description": "A number without a leading + adds a warning."
          },
          "vcEmail": {
            "type": "string"
          },
          "vcUrl": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Required for type email."
          },
          "emailSubject": {
            "type": "string"
          },
          "emailBody": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "Required for type phone. Characters other than digits and + are stripped; no leading + adds a warning."
          },
          "smsPhone": {
            "type": "string",
            "description": "Required for type sms. Characters other than digits and + are stripped."
          },
          "smsBody": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "svg"
            ],
            "default": "png",
            "description": "Case-sensitive. svg is **Pro**."
          },
          "size": {
            "type": [
              "number",
              "string"
            ],
            "default": 512,
            "minimum": 64,
            "maximum": 2048,
            "description": "Target width in px (number or numeric string). Clamped to 64..2048; the output snaps down to whole modules."
          },
          "margin": {
            "type": [
              "number",
              "string"
            ],
            "default": 4,
            "minimum": 4,
            "maximum": 32,
            "description": "Quiet zone in modules, clamped to 4..32."
          },
          "level": {
            "type": "string",
            "enum": [
              "L",
              "M",
              "Q",
              "H"
            ],
            "default": "M",
            "description": "Error correction; upper-cased first."
          },
          "fg": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#14532D",
            "description": "Foreground colour. Anything but the default is **Pro**; equal to bg is 400."
          },
          "bg": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#FFFFFF",
            "description": "Background colour. Anything but the default is **Pro**."
          }
        }
      },
      "QrResponse": {
        "type": "object",
        "required": [
          "type",
          "label",
          "payload",
          "qrDataUrl",
          "qr"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "url",
              "text",
              "wifi",
              "vcard",
              "email",
              "phone",
              "sms"
            ]
          },
          "label": {
            "type": "string",
            "description": "Short human label for the content."
          },
          "payload": {
            "type": "string",
            "description": "The exact string encoded in the QR code."
          },
          "qrDataUrl": {
            "type": "string"
          },
          "svg": {
            "type": "string",
            "description": "Present only when format=svg."
          },
          "qr": {
            "$ref": "#/components/schemas/QrApplied"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Present when a phone, sms or vcard number has no leading +."
          }
        }
      },
      "Click": {
        "type": "object",
        "description": "One human click. On a Free plan the six detail fields are always null.",
        "required": [
          "id",
          "timestamp",
          "country",
          "city",
          "device",
          "os",
          "browser",
          "referrer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO country code, or \"Unknown\" when no geo data was available."
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ],
            "description": "mobile, desktop or tablet."
          },
          "os": {
            "type": [
              "string",
              "null"
            ]
          },
          "browser": {
            "type": [
              "string",
              "null"
            ]
          },
          "referrer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Referring URL, or \"Direct\" when there was none."
          }
        }
      },
      "ClickList": {
        "type": "object",
        "required": [
          "clicks",
          "pagination",
          "planLimits"
        ],
        "properties": {
          "clicks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Click"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "planLimits": {
            "type": "object",
            "required": [
              "advancedAnalytics",
              "retentionDays"
            ],
            "properties": {
              "advancedAnalytics": {
                "type": "boolean",
                "description": "False on Free: detail fields are null."
              },
              "retentionDays": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "30 on Free (a rolling read window), null when history is unlimited."
              }
            }
          }
        }
      },
      "Domain": {
        "type": "object",
        "description": "A custom domain row, returned with its database column names.",
        "required": [
          "id",
          "user_id",
          "team_id",
          "domain",
          "slug",
          "verified",
          "status",
          "txt_record",
          "cname_target",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "Who added it."
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Workspace it belongs to, or null for a personal domain."
          },
          "domain": {
            "type": "string",
            "description": "Lower-case host, for example go.brand.com."
          },
          "slug": {
            "type": "string",
            "description": "The domain with dots replaced by hyphens. Unique, so a-b.com and a.b.com collide."
          },
          "verified": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "invalid",
              "expired"
            ]
          },
          "txt_record": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ownership token to publish as a TXT record, `flyn-verify=<32 hex>`."
          },
          "cname_target": {
            "type": [
              "string",
              "null"
            ],
            "description": "Routing target: an A record value for an apex domain, otherwise a CNAME target."
          },
          "last_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "placeholder": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stored placeholder text. Nothing at runtime reads it yet."
          },
          "not_found_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stored not-found URL. Nothing at runtime reads it yet: an unknown slug always gets the standard dead-link response."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "pause_warned_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pause_scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "paused_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set when the domain is paused; links on a paused domain stop redirecting."
          }
        }
      },
      "DnsRecord": {
        "type": "object",
        "required": [
          "type",
          "name",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TXT",
              "CNAME",
              "A"
            ]
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "DomainCreateRequest": {
        "type": "object",
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 253,
            "description": "Domain or subdomain you own. Lower-cased; a leading http(s):// and www. and trailing slashes are stripped. Must contain a dot and match `^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$`. Flyn domains and well-known public platforms are refused. A non-string value returns 500."
          }
        }
      },
      "DomainCreateResponse": {
        "type": "object",
        "required": [
          "domain",
          "vercel",
          "dnsInstructions"
        ],
        "properties": {
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "vercel": {
            "type": "object",
            "required": [
              "verified"
            ],
            "properties": {
              "verified": {
                "type": "boolean",
                "const": false,
                "description": "Always false here: the domain is attached for serving only by the verify step, after the TXT record matches."
              }
            }
          },
          "dnsInstructions": {
            "type": "object",
            "required": [
              "txt",
              "routing"
            ],
            "properties": {
              "txt": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/DnsRecord"
                  }
                ],
                "description": "TXT record at `_flyn.<registrable domain>`, found with the public suffix list, so links.example.com.br uses `_flyn.example.com.br`."
              },
              "routing": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/DnsRecord"
                  }
                ],
                "description": "A @ 76.76.21.21 when the custom domain is the registrable domain itself (for example example.com or example.com.br), otherwise a CNAME to cname.flyn.to whose name is the subdomain part."
              }
            }
          }
        }
      },
      "DomainVerifyResponse": {
        "type": "object",
        "required": [
          "domain",
          "verification"
        ],
        "properties": {
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "verification": {
            "type": "object",
            "required": [
              "verified",
              "txtVerified",
              "configured",
              "ownershipVerified",
              "ownershipChallenge",
              "misconfigured",
              "dnsInstructions",
              "message"
            ],
            "properties": {
              "verified": {
                "type": "boolean",
                "description": "True only when the TXT record matches, routing is configured and hosting ownership is confirmed."
              },
              "txtVerified": {
                "type": "boolean"
              },
              "configured": {
                "type": "boolean",
                "description": "DNS routing points at Flyn."
              },
              "ownershipVerified": {
                "type": "boolean"
              },
              "ownershipChallenge": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DnsRecord"
                },
                "description": "TXT record to add at your DNS provider when this domain, or the main domain it belongs to, is connected to another account at Flyn's hosting provider. `name` is the full host name (for example `_vercel.example.com`), not relative like `dnsInstructions`. Add it, then call this endpoint again. Once it verifies, this exact host name is served by Flyn straight away. Empty when no such record is outstanding."
              },
              "misconfigured": {
                "type": "boolean"
              },
              "dnsInstructions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DnsRecord"
                },
                "description": "Always exactly one routing record."
              },
              "message": {
                "type": "string",
                "description": "Next step, for example \"Domain is verified and active!\"."
              }
            }
          }
        }
      },
      "DomainList": {
        "type": "object",
        "required": [
          "domains"
        ],
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Domain"
            }
          }
        }
      },
      "DomainEnvelope": {
        "type": "object",
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "$ref": "#/components/schemas/Domain"
          }
        }
      },
      "DomainUpdateRequest": {
        "type": "object",
        "properties": {
          "placeholder": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "description": "Stored as sent (at most 500 characters). Not read at runtime yet."
          },
          "notFoundUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "null or \"\" clears it. Otherwise an http or https URL that does not resolve to a private address. Not read at runtime yet."
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "Ok": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "PixelProvider": {
        "type": "string",
        "enum": [
          "meta",
          "google_ads",
          "ga4",
          "gtm",
          "linkedin",
          "twitter",
          "tiktok",
          "pinterest",
          "quora",
          "reddit",
          "snapchat",
          "microsoft",
          "adroll"
        ]
      },
      "Pixel": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "value",
          "label",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "$ref": "#/components/schemas/PixelProvider"
          },
          "value": {
            "type": "string",
            "description": "Pixel or tag id."
          },
          "label": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_owner": {
            "type": "boolean",
            "description": "List responses only: true when the caller created the pixel. Only the creator can edit or delete it."
          }
        }
      },
      "PixelCreateRequest": {
        "type": "object",
        "required": [
          "provider",
          "value"
        ],
        "properties": {
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PixelProvider"
              }
            ],
            "description": "Ad platform (trimmed)."
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._,\\-]{2,128}$",
            "description": "Pixel or tag id (trimmed). The same pattern applies to every provider."
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "description": "Trimmed and cut to 80 characters. Empty or missing: the provider's display name, for example \"Meta (Facebook) Pixel\"."
          }
        }
      },
      "PixelUpdateRequest": {
        "type": "object",
        "minProperties": 1,
        "description": "provider cannot be changed. At least one of value or label is needed (else 400 \"Nothing to update\").",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._,\\-]{2,128}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "description": "Trimmed and cut to 80 characters. Empty is ignored, so a label cannot be cleared."
          }
        }
      },
      "PixelEnvelope": {
        "type": "object",
        "required": [
          "pixel"
        ],
        "properties": {
          "pixel": {
            "$ref": "#/components/schemas/Pixel"
          }
        }
      },
      "PixelList": {
        "type": "object",
        "required": [
          "pixels"
        ],
        "properties": {
          "pixels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pixel"
            }
          }
        }
      },
      "ConversionRequest": {
        "type": "object",
        "required": [
          "click_id"
        ],
        "description": "Body fields win over query parameters of the same name.",
        "properties": {
          "click_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{10,32}$",
            "description": "The per-click id Flyn appended to the destination as `flyn_id`. Also accepted as clickId, flyn_id, clickid or cid (first present wins)."
          },
          "event": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$",
            "default": "conversion",
            "description": "Goal name, lower-cased first. Also accepted as type."
          },
          "value": {
            "type": [
              "number",
              "string"
            ],
            "default": 0,
            "description": "Value in major units. Also accepted as payout, sum or amt. A European decimal comma is understood; |value| above 1,000,000 or unparseable becomes 0. Negative records a refund."
          },
          "currency": {
            "type": "string",
            "default": "USD",
            "description": "ISO 4217 code, upper-cased; anything but three letters becomes USD."
          },
          "txid": {
            "type": "string",
            "maxLength": 64,
            "description": "Transaction id (first 64 characters kept). Also accepted as transaction_id. Part of the (click, event, txid) de-duplication key."
          }
        }
      },
      "ConversionResult": {
        "type": "object",
        "description": "Envelope of the conversion ingest endpoints. `ok` is false on every error.",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean",
            "description": "Present and true when the same (click, event, txid) was already recorded."
          },
          "error": {
            "type": "string",
            "description": "Present when ok is false."
          }
        }
      },
      "ConversionReport": {
        "type": "object",
        "required": [
          "summary",
          "series",
          "recent",
          "byEvent"
        ],
        "properties": {
          "summary": {
            "type": "object",
            "required": [
              "count",
              "valueCents",
              "currency",
              "days"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "description": "Conversions net of refunds."
              },
              "valueCents": {
                "type": "integer",
                "description": "Summed value in minor units (refunds subtract)."
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The single currency seen, \"MIXED\" when there were several, or null."
              },
              "days": {
                "type": "integer"
              },
              "truncated": {
                "type": "boolean",
                "description": "True when the window hit the 5,000-row read cap, so the numbers are a floor."
              }
            }
          },
          "series": {
            "type": "array",
            "description": "One entry per day in the window, oldest first, including empty days.",
            "items": {
              "type": "object",
              "required": [
                "date",
                "count",
                "valueCents"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "count": {
                  "type": "integer"
                },
                "valueCents": {
                  "type": "integer"
                }
              }
            }
          },
          "recent": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "linkId",
                "slug",
                "domain",
                "title",
                "event",
                "txid",
                "valueCents",
                "currency",
                "createdAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "linkId": {
                  "type": "string",
                  "format": "uuid"
                },
                "slug": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "domain": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "event": {
                  "type": "string"
                },
                "txid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valueCents": {
                  "type": "integer"
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "byEvent": {
            "type": "array",
            "description": "Per-event totals, highest count first.",
            "items": {
              "type": "object",
              "required": [
                "event",
                "count",
                "valueCents"
              ],
              "properties": {
                "event": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "valueCents": {
                  "type": "integer"
                }
              }
            }
          },
          "unavailable": {
            "type": "boolean",
            "description": "Present and true when the conversions store could not be read; the numbers are then empty."
          }
        }
      },
      "WebhookEventName": {
        "type": "string",
        "enum": [
          "link.click",
          "link.create",
          "link.update",
          "link.delete"
        ],
        "description": "An event Flyn delivers. webhook.test is sent by the test endpoint and cannot be subscribed to."
      },
      "Webhook": {
        "type": "object",
        "required": [
          "id",
          "url",
          "events",
          "secret",
          "status",
          "createdAt",
          "failureCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "Delivery endpoint."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subscribed event names, as stored."
          },
          "secret": {
            "type": [
              "string",
              "null"
            ],
            "description": "Signing secret, `whsec_` + 48 hex. Always in full in the create response. Afterwards API-key callers see only a masked prefix (first 8 characters); the creator's own dashboard session sees it in full."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "A webhook becomes inactive after 10 counted delivery failures in a row."
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix time in milliseconds."
          },
          "lastTriggeredAt": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix time in milliseconds of the last successful delivery. Absent from the create response."
          },
          "failureCount": {
            "type": "integer",
            "description": "Counted failures since the last success (non-2xx answers, and skips of a URL whose host resolves to a private address or fails DNS resolution; timeouts and connection errors are not counted)."
          }
        }
      },
      "WebhookList": {
        "type": "object",
        "required": [
          "webhooks"
        ],
        "properties": {
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Webhook"
            }
          }
        }
      },
      "WebhookEnvelope": {
        "type": "object",
        "required": [
          "webhook"
        ],
        "properties": {
          "webhook": {
            "$ref": "#/components/schemas/Webhook"
          }
        }
      },
      "WebhookCreateRequest": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Endpoint that receives deliveries. Trimmed; http or https; must not resolve to a private address. A non-string value returns 500."
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/WebhookEventName"
            },
            "description": "Events to subscribe to. Unknown names are dropped silently; 400 only when none remain. A non-array value returns 500."
          }
        }
      },
      "WebhookUpdateRequest": {
        "type": "object",
        "description": "All fields optional. An empty body succeeds and changes nothing but the update time.",
        "properties": {
          "url": {
            "type": "string",
            "description": "http or https, not a private address."
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/WebhookEventName"
            },
            "description": "Replaces the subscription. Every name must be known, else 400 \"Invalid events: ...\"."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "`active` also resets failureCount to 0."
          }
        }
      },
      "WebhookTestResult": {
        "type": "object",
        "description": "The delivery outcome is reported in this body; the HTTP status is 200 either way.",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when the endpoint answered 2xx."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status your endpoint answered with."
          },
          "statusText": {
            "type": "string",
            "description": "Present when the endpoint answered non-2xx."
          },
          "error": {
            "type": "string",
            "description": "Present when no answer came back (network error, DNS failure, 10 s timeout, redirect to a private host, too many redirects)."
          }
        }
      },
      "LinkClickData": {
        "type": "object",
        "required": [
          "linkId",
          "slug",
          "destinationUrl",
          "country",
          "city",
          "device",
          "referrer"
        ],
        "properties": {
          "linkId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "destinationUrl": {
            "type": "string",
            "description": "The stored destination the visitor was sent to (the fallback URL once a click limit is reached), before query-string passthrough."
          },
          "country": {
            "type": "string",
            "description": "ISO country code, or \"Unknown\"."
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": "string",
            "enum": [
              "mobile",
              "desktop",
              "tablet"
            ]
          },
          "referrer": {
            "type": "string",
            "description": "Referring URL, or \"Direct\" when there was none (on the main redirect, also when it was malformed or a Flyn page)."
          },
          "variant": {
            "type": "string",
            "description": "The destination id when a rotation chose the destination. Otherwise, when the link still carries a legacy A/B pair (abUrlB with abSplit), \"B\" if the visitor was sent to abUrlB, else \"A\", which includes a destination chosen by device or geo targeting. Absent in every other case, and always absent on click-limit fallback, password-unlock and mailto:, tel: or sms: clicks."
          }
        }
      },
      "DashboardLinkCreateData": {
        "type": "object",
        "description": "data of a link.create delivery for a link created in the Flyn dashboard.",
        "required": [
          "id",
          "slug",
          "destinationUrl",
          "domain"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "destinationUrl": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          }
        }
      },
      "DashboardLinkUpdateData": {
        "type": "object",
        "description": "data of a link.update delivery for an edit made in the Flyn dashboard: the link id plus only the fields that changed.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "password": {
            "type": "boolean",
            "description": "Present only when the password was changed in that save: true when one was set or replaced, false when it was removed. The password itself is never sent."
          }
        },
        "additionalProperties": true
      },
      "LinkClickEvent": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "data"
        ],
        "properties": {
          "event": {
            "type": "string",
            "const": "link.click"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix time in milliseconds; the same value as t= in X-Flyn-Signature."
          },
          "data": {
            "$ref": "#/components/schemas/LinkClickData"
          }
        }
      },
      "LinkCreateEvent": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "data"
        ],
        "properties": {
          "event": {
            "type": "string",
            "const": "link.create"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix time in milliseconds."
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Link"
              },
              {
                "$ref": "#/components/schemas/DashboardLinkCreateData"
              }
            ],
            "description": "The full Link for links created with POST /api/links; a short object for links created in the dashboard."
          }
        }
      },
      "LinkUpdateEvent": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "data"
        ],
        "properties": {
          "event": {
            "type": "string",
            "const": "link.update"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix time in milliseconds."
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Link"
              },
              {
                "$ref": "#/components/schemas/DashboardLinkUpdateData"
              }
            ],
            "description": "The full updated Link for PATCH /api/links/{id}; the id plus the changed fields for dashboard edits."
          }
        }
      },
      "LinkDeleteEvent": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "data"
        ],
        "properties": {
          "event": {
            "type": "string",
            "const": "link.delete"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix time in milliseconds."
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Link"
              }
            ],
            "description": "The link as it was before deletion."
          }
        }
      },
      "WebhookTestEvent": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "data"
        ],
        "properties": {
          "event": {
            "type": "string",
            "const": "webhook.test"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix time in milliseconds."
          },
          "data": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "parameters": {
      "LinkId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Link id. Anything not found in the caller's workspace is a 404.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DomainId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Domain id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "WebhookId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Webhook id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "PixelIdQuery": {
        "name": "id",
        "in": "query",
        "required": true,
        "description": "Pixel id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "RetryAfter": {
        "description": "Seconds until the rate-limit window resets.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitLimit": {
        "description": "Requests allowed per minute for this caller type (5 anonymous, 30 authenticated).",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitRemaining": {
        "description": "Requests left in the current window.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitReset": {
        "description": "Seconds until the window resets.",
        "schema": {
          "type": "integer"
        }
      }
    }
  }
}