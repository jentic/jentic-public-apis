        '404':
          $ref: '#/components/responses/404'
        '409':
          description: Job name within the environment is already taken
    delete:
      summary: Delete job
      description: To delete the job you must have the admin permission
      operationId: deleteJob
      parameters:
        - $ref: '#/components/parameters/jobId'
        - in: query
          name: skipReconcile
          required: false
          schema:
            type: boolean
            default: false
          description: 'When true, skip the pre-destroy apply/reconcile and tear down best-effort, tolerating already-absent resources.'
      tags:
        - Job Main Calls
      responses:
        '204':
          $ref: '#/components/responses/204-deletion'
