            - mode
            - cluster_id
            - project
            - organization
          properties:
            name:
              type: string
              description: name is case insensitive
            organization:
              $ref: '#/components/schemas/ReferenceObject'
            project:
              $ref: '#/components/schemas/ReferenceObject'
