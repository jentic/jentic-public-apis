          enum:
            - WORKLOAD_IDENTITY_FEDERATION
            - WIF
        service_account_email:
          type: string
          description: GCP service account email to impersonate.
          example: qovery@customer-project.iam.gserviceaccount.com
        workload_identity_provider_resource:
          type: string
          description: Full Workload Identity Provider resource.
          example: projects/123456789/locations/global/workloadIdentityPools/qovery-pool/providers/qovery-aws
    GenericObjectCurrentCost:
