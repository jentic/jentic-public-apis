        - PROJECT
        - CONTAINER
        - JOB
        - HELM
        - TERRAFORM
        - AGENTIC_WORKFLOW
    APIVariableTypeEnum:
      type: string
      description: |
        type of the environment variable (VALUE, FILE, ALIAS, OVERRIDE, BUIT_IN, EXTERNAL_SECRET, FILE_EXTERNAL_SECRET)
      enum:
        - VALUE
        - ALIAS
        - OVERRIDE
        - BUILT_IN
        - FILE
        - EXTERNAL_SECRET
        - FILE_EXTERNAL_SECRET
    GcpCredentialsRequest:
      oneOf:
