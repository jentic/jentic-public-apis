              schema:
                $ref: '#/components/schemas/ClusterAnalysisResponse'
        '400':
          $ref: '#/components/responses/400'
        '401':
          $ref: '#/components/responses/401'
        '403':
          $ref: '#/components/responses/403'
        '404':
          $ref: '#/components/responses/404'
        '409':
          description: A cluster analysis is already in progress for this cluster
    get:
      summary: List cluster analyses
      description: Lists previous analysis executions for the cluster.
      operationId: listClusterAnalyses
      parameters:
        - $ref: '#/components/parameters/clusterId'
