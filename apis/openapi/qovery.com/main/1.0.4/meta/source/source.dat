  '/environment/{environmentId}/cleanFailedJobs':
    parameters:
      - schema:
          type: string
        name: environmentId
        in: path
        required: true
    post:
      summary: Clean failed jobs within an environment
      tags:
        - Environment Actions
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  clean_job_ids:
                    type: array
                    x-stoplight:
                      id: wfo0kfbtlr6uu
