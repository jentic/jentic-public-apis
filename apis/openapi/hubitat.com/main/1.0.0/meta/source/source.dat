{
  "openapi": "3.0.3",
  "info": {
    "title": "Hubitat Maker API",
    "description": "The Hubitat Maker API provides simple URL-based REST access to Hubitat Elevation smart home hub devices. Supports device listing, status queries, command execution, mode management, and HSM (Home Security Monitor) control via both local and cloud endpoints.",
    "version": "1.0.0",
    "contact": {
      "name": "Hubitat",
      "url": "https://hubitat.com"
    },
    "x-jentic-source-url": "https://docs2.hubitat.com/en/apps/maker-api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://cloud.hubitat.com/api/{hubId}/apps/{appId}",
      "description": "Hubitat Cloud endpoint",
      "variables": {
        "hubId": {
          "description": "Your Hubitat hub ID",
          "default": "your-hub-id"
        },
        "appId": {
          "description": "Your Maker API app ID",
          "default": "your-app-id"
        }
      }
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "paths": {
    "/devices": {
      "get": {
        "operationId": "listDevices",
        "summary": "List all devices",
        "description": "Returns a list of all devices that have been selected/authorized in the Maker API app configuration.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    },
    "/devices/all": {
      "get": {
        "operationId": "listAllDevicesDetailed",
        "summary": "List all devices with full details",
        "description": "Returns all devices with their full attribute details including current values.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of devices with full details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceDetail"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    },
    "/devices/{deviceId}": {
      "get": {
        "operationId": "getDevice",
        "summary": "Get device details",
        "description": "Returns the full details of a specific device including all attributes and their current values.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Device ID"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "Device details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Device not found"
          }
        }
      }
    },
    "/devices/{deviceId}/commands": {
      "get": {
        "operationId": "getDeviceCommands",
        "summary": "Get available commands for a device",
        "description": "Returns the list of commands supported by a specific device.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Device ID"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of available commands",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Command"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Device not found"
          }
        }
      }
    },
    "/devices/{deviceId}/events": {
      "get": {
        "operationId": "getDeviceEvents",
        "summary": "Get recent device events",
        "description": "Returns recent events for a specific device.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Device ID"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of recent events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceEvent"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Device not found"
          }
        }
      }
    },
    "/devices/{deviceId}/{command}": {
      "get": {
        "operationId": "sendDeviceCommand",
        "summary": "Send a command to a device",
        "description": "Sends a command to a device (e.g., on, off, toggle, setLevel, setColor). The Maker API uses GET requests for command execution.",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Device ID"
          },
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Command to send (e.g., on, off, toggle, setLevel, open, close, lock, unlock)"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "Command sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Device or command not found"
          }
        }
      }
    },
    "/devices/{deviceId}/{command}/{secondaryValue}": {
      "get": {
        "operationId": "sendDeviceCommandWithValue",
        "summary": "Send a command with a parameter value to a device",
        "description": "Sends a command with a secondary value to a device (e.g., setLevel/50, setColorTemperature/3500).",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Device ID"
          },
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Command to send (e.g., setLevel, setColorTemperature, setHue)"
          },
          {
            "name": "secondaryValue",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Value parameter for the command (e.g., brightness level 0-100, color temperature)"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "Command sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Device or command not found"
          }
        }
      }
    },
    "/modes": {
      "get": {
        "operationId": "listModes",
        "summary": "List all hub modes",
        "description": "Returns a list of all modes configured on the hub (e.g., Home, Away, Night).",
        "tags": [
          "Modes"
        ],
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "List of modes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Mode"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    },
    "/modes/{modeId}": {
      "get": {
        "operationId": "setMode",
        "summary": "Set the hub mode",
        "description": "Sets the hub to a specific mode by mode ID.",
        "tags": [
          "Modes"
        ],
        "parameters": [
          {
            "name": "modeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Mode ID to activate"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "Mode set successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Mode not found"
          }
        }
      }
    },
    "/hsm": {
      "get": {
        "operationId": "getHsmStatus",
        "summary": "Get HSM status",
        "description": "Returns the current Home Security Monitor (HSM) status.",
        "tags": [
          "HSM"
        ],
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "Current HSM status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HsmStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    },
    "/hsm/{command}": {
      "get": {
        "operationId": "setHsmState",
        "summary": "Set HSM state",
        "description": "Sets the HSM to a specific arm state (armAway, armHome, armNight, disarm, disarmAll, armAll, cancelAlerts).",
        "tags": [
          "HSM"
        ],
        "parameters": [
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "armAway",
                "armHome",
                "armNight",
                "disarm",
                "disarmAll",
                "armAll",
                "cancelAlerts"
              ]
            },
            "description": "HSM command"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Maker API access token"
          }
        ],
        "responses": {
          "200": {
            "description": "HSM state set successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "Maker API access token generated in the Hubitat Maker API app configuration"
      }
    },
    "schemas": {
      "DeviceSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Device ID"
          },
          "name": {
            "type": "string",
            "description": "Device name"
          },
          "label": {
            "type": "string",
            "description": "Device label"
          },
          "type": {
            "type": "string",
            "description": "Device type"
          }
        }
      },
      "DeviceDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Device ID"
          },
          "name": {
            "type": "string",
            "description": "Device name"
          },
          "label": {
            "type": "string",
            "description": "Device label"
          },
          "type": {
            "type": "string",
            "description": "Device type"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceAttribute"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of device capabilities"
          },
          "commands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Command"
            }
          }
        }
      },
      "DeviceAttribute": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "currentValue": {
            "description": "Current attribute value",
            "nullable": true
          },
          "dataType": {
            "type": "string"
          }
        }
      },
      "Command": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command name"
          }
        }
      },
      "DeviceEvent": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Mode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "HsmStatus": {
        "type": "object",
        "properties": {
          "hsm": {
            "type": "string",
            "description": "Current HSM state"
          }
        }
      }
    }
  }
}
