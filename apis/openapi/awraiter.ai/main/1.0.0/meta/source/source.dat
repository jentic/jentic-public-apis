Id":"import_channel_emoji_sets","summary":"Import emoji sets to many channels","description":"Connect Telegram premium emoji sets to many channels at once from one text, one line per channel: `@username Set1 t.me/addemoji/Set2`, `Channel name — Set1, Set2`, `-100… Set` (Telegram chat id), `#<channelId> Set`, or `* Set` for every channel you can access. Lines starting with `# ` are comments. Up to 300 lines, 20 distinct sets, 5 sets per channel. dryRun defaults to true and only reports what would happen; call again with dryRun:false to save. autoReplace, when given, is set on every channel in the import. Returns a summary (channels, added, refreshed, failed sets, lineErrors) and a per-line report: resolved channels (partial:true when matched by part of the name) and, per set, added / refreshed / failed with an error code (channel_not_found, ambiguous_channel, set_not_found, not_emoji_set, too_many_sets, …).","tags":["write"],"x-side-effect":true,"x-requires-channel-access":false,"x-costs-ai-quota":false,"x-idempotent":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImportChannelEmojiSetsOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImportChannelEmojiSetsInput"}}}}}},"/api/v1/list_channel_emoji_sets":{"get":{"operationId":"list_channel_emoji_sets","summary":"List channel emoji sets","description":"List a channel's connected premium emoji sets, emoji IDs and base emoji, auto-replacement setting and limits. Preview images are excluded. Choose explicit IDs from these sets for premium emoji.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListChannelEmojiSetsOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"channelId","in":"query","required":true,"schema":{"type":"integer","minimum":1}}]},"post":{"operationId":"list_channel_emoji_sets_body","summar