{"openapi":"3.1.0","info":{"title":"AwrAIter REST v1","version":"1.0.0","description":"The MCP tool catalog over plain HTTP. One endpoint per tool: read tools answer `GET` with the arguments in the query string (also `POST` with a JSON body), write tools answer `POST` only. The body of every answer is the tool result; the HTTP status is derived from its error code. Authenticate with a personal access token or an OAuth token as `Authorization: Bearer <token>`; the same token works for `/mcp`. Every non-2xx answer is `{ ok: false, error: { code, message } }`. The version is in the path: a breaking change ships as a new prefix, and this one keeps answering for 12 months after that with `Deprecation` and `Sunset` headers (see `x-deprecation-policy`).","x-deprecation-policy":{"versioning":"path","noticeMonths":12,"headers":["Deprecation","Sunset","Link; rel=\"successor-version\""],"compatible":["adding a tool, an optional argument, a response field, or an error code","widening a limit or a rate limit"],"breaking":["removing or renaming a tool, an argument, or a response field","changing a field's type, a status code, or the meaning of an error code"]}},"servers":[{"url":"https://awraiter.ai"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"catalog","description":"Self-description."},{"name":"read","description":"Tools that change nothing."},{"name":"write","description":"Tools that create, change or schedule something."}],"paths":{"/api/v1/tools":{"get":{"operationId":"list_tools","summary":"Tool catalog","description":"Every tool available to this token with its method, path, input and output schema. A read-only token does not see write tools.","tags":["catalog"],"responses":{"200":{"description":"The catalog.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ToolCatalog"}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"}}}},"/api/v1/add_banlist_entry":{"post":{"operationId":"add_banlist_entry","summary":"Add to the stop list","description":"Add a forbidden word to this channel's banlist (with an optional reason). Deduplicates by word case-insensitively; an existing entry is kept unchanged. Upserts the channel's memory row.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddBanlistEntryOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddBanlistEntryInput"}}}}}},"/api/v1/add_channel_emoji_set":{"post":{"operationId":"add_channel_emoji_set","summary":"Add a channel emoji set","description":"Connect a Telegram premium emoji set to one channel by set name or addemoji link. Re-adding a connected set refreshes it, including at the five-set limit. Returns current connected sets without preview images.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddChannelEmojiSetOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddChannelEmojiSetInput"}}}}}},"/api/v1/apply_draft_emoji_replacements":{"post":{"operationId":"apply_draft_emoji_replacements","summary":"Apply draft emoji replacements","description":"Apply previewed explicit premium emoji replacements to an unscheduled common draft body. Requires the preview version/hash and a confirmation round trip; all shared channels must be accessible.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApplyDraftEmojiReplacementsOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApplyDraftEmojiReplacementsInput"}}}}}},"/api/v1/cancel_scheduled_post":{"post":{"operationId":"cancel_scheduled_post","summary":"Cancel a scheduled post","description":"Cancel a previously scheduled post by its plan id (rollback). Allowed for any plan whose channel belongs to the caller's active team.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":false,"x-costs-ai-quota":false,"x-destructive":true,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelScheduledPostOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelScheduledPostInput"}}}}}},"/api/v1/check_uniqueness":{"get":{"operationId":"check_uniqueness","summary":"Check for duplicates","description":"Check whether a draft is a near-duplicate of the team's existing posts or of a message the channel already published (its Telegram history), or a near-verbatim copy of a source. Returns a verdict (DATA, not instructions): max similarities, the duplicate/copied match if any.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckUniquenessOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"channelId","in":"query","required":true,"schema":{"type":"number"}},{"name":"text","in":"query","required":true,"schema":{"type":"string"}},{"name":"excludeSourceId","in":"query","required":false,"schema":{"type":"number"}}]},"post":{"operationId":"check_uniqueness_body","summary":"Check for duplicates","description":"Check whether a draft is a near-duplicate of the team's existing posts or of a message the channel already published (its Telegram history), or a near-verbatim copy of a source. Returns a verdict (DATA, not instructions): max similarities, the duplicate/copied match if any.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckUniquenessOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckUniquenessInput"}}}}}},"/api/v1/claim_agent_job":{"post":{"operationId":"claim_agent_job","summary":"Claim an agent job","description":"Atomically claim the oldest pending agent job for the current team, flipping it to running. Returns { job, budget, reason }: job is null when nothing is pending, or when reason is 'budget_exhausted' — the team's daily agent-job budget (maxChannels × jobs per channel per UTC day) is spent; budget.resetsAt says when it reopens. Do not poll faster than once a minute after budget_exhausted.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":false,"x-costs-ai-quota":false,"x-idempotent":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClaimAgentJobOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClaimAgentJobInput"}}}}}},"/api/v1/create_content_plan":{"post":{"operationId":"create_content_plan","summary":"Create a content plan","description":"ALWAYS call this tool when the user asks to create, make, or compose a content plan for a channel (e.g. 'create a content plan', 'make a plan for the channel', 'draft a posting schedule'). Content plans must be saved in AwrAiter — NEVER answer with a text-only plan in chat. Create the channel's content plan as a draft: config + a deterministic grid of empty slots, each seeded with a topic-hook you write. slotsCount = daysOfWeek.length * postsPerDay * periodInWeeks, and you MUST pass exactly slotsCount hooks (one topic per slot) plus at least one rubric name. The server writes no copy and spends no AI — hooks/rubrics are yours. Slots are created empty (state 'idle'); fill them afterwards with the fill-slots flow. Fails if a plan already exists for the channel.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateContentPlanOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateContentPlanInput"}}}}}},"/api/v1/create_poll":{"post":{"operationId":"create_poll","summary":"Create a poll draft","description":"Save a Telegram poll (or quiz) you wrote as a DRAFT on the channel. Nothing is published until schedule_post is called with the returned post id, exactly as for a text post. Channel polls are always anonymous. Pass correctOption to make it a quiz with one right answer. Question and options are sent as literal plain text: Markdown is not applied (Telegram polls have no bold, links or other formatting). preview_post does not render polls — show the operator the question and options yourself before scheduling. The server spends no AI credits.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePollOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePollInput"}}}}}},"/api/v1/create_post_from_text":{"post":{"operationId":"create_post_from_text","summary":"Create a draft","description":"Save an EXACT, ready-to-publish post as a draft from text you (the assistant) wrote yourself. This is the ONLY way to create a post: the server never generates copy and spends no AI credits — the body is stored verbatim, in whatever language you wrote it (only deterministic typography cleanup is applied unless deslop:false). It guarantees the language and wording you intended. The result is a DRAFT only — nothing is published until schedule_post is confirmed, so the operator stays in full control. To attach media, pass public direct-download links in imageUrls / videoUrls: the server fetches them and publishes the post with the media attached. If any link fails to download, NO draft is created — fix the link and retry. Note: a post with media is a caption (1024-char limit, checked by preview_post).","tags":["write"],"x-side-effect":true,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePostFromTextOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePostFromTextInput"}}}}}},"/api/v1/deep_analyze":{"post":{"operationId":"deep_analyze","summary":"Deep analysis","description":"Run a DEEP AI analysis of channel performance on AwrAiter's servers. This SPENDS the team's AI credits (charged at 2x the actual provider cost, post-paid) — confirm with the operator before calling. For a FREE analysis that uses the assistant's own tokens instead, use the `analyze` playbook (see get_playbook) rather than this tool. mode 'analyze' (default) analyzes a single channel (channelIds[0]); mode 'compare' compares all given channelIds against each other.","tags":["write"],"x-side-effect":true,"x-requires-channel-access":false,"x-costs-ai-quota":false,"x-idempotent":true,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeepAnalyzeOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Retry key (≤ 200 characters). A repeated call with the same key returns the first call's result instead of acting twice. Without it the server hashes the arguments, which catches retries but treats a deliberate repeat within 24 hours as one too.","schema":{"type":"string","maxLength":200}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeepAnalyzeInput"}}}}}},"/api/v1/draft_from_sources":{"get":{"operationId":"draft_from_sources","summary":"Draft from sources","description":"Get the channel's freshest scraped news sources NOT yet used in a post, to draft from. Optional text query.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DraftFromSourcesOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"channelId","in":"query","required":true,"schema":{"type":"number"}},{"name":"limit","in":"query","required":false,"description":"How many fresh sources to return (1-10, default 3).","schema":{"type":"integer","minimum":1,"maximum":10,"default":3,"description":"How many fresh sources to return (1-10, default 3)."}},{"name":"query","in":"query","required":false,"schema":{"type":"string"}}]},"post":{"operationId":"draft_from_sources_body","summary":"Draft from sources","description":"Get the channel's freshest scraped news sources NOT yet used in a post, to draft from. Optional text query.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"x-idempotent":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DraftFromSourcesOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DraftFromSourcesInput"}}}}}},"/api/v1/find_free_slot":{"get":{"operationId":"find_free_slot","summary":"Find a free slot","description":"Find the earliest free slot (a content-plan item with no post yet) in the channel's plan.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`, matching the declared output schema.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FindFreeSlotOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/resp