selected occurrences use UTF-16 offsets.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreviewDraftEmojiReplacementsOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreviewDraftEmojiReplacementsInput"}}}}}},"/api/v1/preview_post":{"get":{"operationId":"preview_post","summary":"Post preview","description":"Pre-publish preview for a draft (by postId or raw text): returns the exact message that will be sent — title, body and the channel header and footer assembled as on publish, with typography normalized — its quality score, and a single list of warnings (empty draft, Telegram length limits, banlist hits, near-duplicates) plus a publishReady flag. Length is counted the way Telegram counts it and respects the 1024 caption limit when the post has a photo/video. Read-only — nothing is scheduled or published. Use this before schedule_post so the operator sees exactly what goes out and why.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's result in `data`.","headers":{"X-Request-Id":{"description":"Server-side id of the call, the same value as `tool_audit.request_id`.","schema":{"type":"string"}},"RateLimit-Remaining":{"description":"Calls left in the current window for this token.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreviewPostOutput"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"428":{"$ref":"#/components/responses/NeedsConfirmation"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"parameters":[{"name":"channelId","in":"query","required":true,"schema":{"type":"number"}},{"name":"postId","in":"query","required":false,"schema":{"type":"number"}},{"name":"text","in":"query","required":false,"schema":{"type":"string"}}]},"post":{"operationId":"preview_post_body","summary":"Post preview","description":"Pre-publish preview for a draft (by postId or raw text): returns the exact message that will be sent — title, body and the channel header and footer assembled as on publish, with typography normalized — its quality score, and a single list of warnings (empty draft, Telegram length limits, banlist hits, near-duplicates) plus a publishReady flag. Length is counted the way Telegram counts it and respects the 1024 caption limit when the post has a photo/video. Read-only — nothing is scheduled or published. Use this before schedule_post so the operator sees exactly what goes out and why.","tags":["read"],"x-side-effect":false,"x-requires-channel-access":true,"x-costs-ai-quota":false,"responses":{"200":{"description":"The tool's resul