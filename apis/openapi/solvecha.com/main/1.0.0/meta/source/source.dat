    "/v1/recognition/recaptcha": {
      "post": {
        "description": "Creates a job for a reCAPTCHA image challenge. For 3x3 and 4x4 grids send one picture of the whole grid. For 1x1 (the single tiles that appear after a click) send 1 to 9 tile pictures. The answer is not in this response: fetch it with the job id.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/create-recaptcha-job"
        },
        "operationId": "createRecaptchaJob",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "sync=1 (or \"sync\": true in the JSON body) is the same as wait=15.",
            "in": "query",
            "name": "sync",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "task": "Select all images with buses",
                "grid": "3x3",
                "image_data": [
                  "BASE64_IMAGE"
                ]
              },
              "schema": {
                "properties": {
                  "grid": {
                    "description": "The grid size of the challenge.",
                    "enum": [
                      "3x3",
                      "4x4",
                      "1x1"
                    ],
                    "type": "string"
                  },
                  "image_data": {
                    "description": "Base64 pictures without a data: prefix. One picture of the whole grid for 3x3 and 4x4. One to nine tile pictures for 1x1. In a form body use image_data[0], image_data[1] and so on.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text that the user reads, for example Select all images with buses. Send the full sentence. Up to 2,048 characters.",
                    "type": "string"
                  }
                },
                "required": [
                  "task",
                  "grid",
                  "image_data"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "grid": {
                    "description": "The grid size of the challenge.",
                    "enum": [
                      "3x3",
                      "4x4",
                      "1x1"
                    ],
                    "type": "string"
                  },
                  "image_data": {
                    "description": "Base64 pictures without a data: prefix. One picture of the whole grid for 3x3 and 4x4. One to nine tile pictures for 1x1. In a form body use image_data[0], image_data[1] and so on.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text that the user reads, for example Select all images with buses. Send the full sentence. Up to 2,048 characters.",
                    "type": "string"
                  }
                },
                "required": [
                  "task",
                  "grid",
                  "image_data"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": "1234567"
                },
                "schema": {
                  "properties": {
                    "data": {
                      "description": "The job id.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job was created. `data` is the job id."
          },
          "400": {
            "$ref": "#/components/responses/Error10"
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "403": {
            "$ref": "#/components/responses/Error16"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Create a reCAPTCHA job",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/v1/recognition/textcaptcha": {
      "post": {
        "description": "Creates a job for a text captcha: one picture with distorted letters and digits. The answer is the text.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/create-text-captcha-job"
        },
        "operationId": "createTextCaptchaJob",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "sync=1 (or \"sync\": true in the JSON body) is the same as wait=15.",
            "in": "query",
            "name": "sync",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "image_data": [
                  "BASE64_IMAGE"
                ]
              },
              "schema": {
                "properties": {
                  "image_data": {
                    "description": "Exactly one base64 picture. No task text is needed.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  }
                },
                "required": [
                  "image_data"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "image_data": {
                    "description": "Exactly one base64 picture. No task text is needed.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  }
                },
                "required": [
                  "image_data"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": "1234567"
                },
                "schema": {
                  "properties": {
                    "data": {
                      "description": "The job id.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job was created. `data` is the job id."
          },
          "400": {
            "$ref": "#/components/responses/Error10"
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "403": {
            "$ref": "#/components/responses/Error16"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Create a text captcha job",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/v1/recognition/{type}": {
      "get": {
        "description": "Returns the answer of a job that you created before. Use the same captcha type in the path as when you created the job. While the job is not ready, the response is error 14 (HTTP 409): wait one second and ask again.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/get-job-result"
        },
        "operationId": "getJobResult",
        "parameters": [
          {
            "description": "The captcha type of the job.",
            "in": "path",
            "name": "type",
            "required": true,
            "schema": {
              "enum": [
                "recaptcha",
                "textcaptcha",
                "geetest",
                "funcaptcha",
                "funcaptcha_match"
              ],
              "type": "string"
            }
          },
          {
            "description": "The job id from the create response. Up to 64 characters.",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Your API key, if you do not send it in the Authorization header.",
            "in": "query",
            "name": "key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    false,
                    true,
                    false,
                    true,
                    true,
                    false,
                    false,
                    false,
                    false
                  ]
                },
                "schema": {
                  "properties": {
                    "data": {
                      "description": "The answer. An array of booleans (reCAPTCHA, FunCAPTCHA), an array with one string (text captcha) or an object with `x` (GeeTest).",
                      "oneOf": [
                        {
                          "items": {
                            "type": "boolean"
                          },
                          "type": "array"
                        },
                        {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        {
                          "properties": {
                            "x": {
                              "type": "number"
                            }
                          },
                          "type": "object"
                        }
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job is ready. The shape of `data` depends on the captcha type. Each type page shows it."
          },
          "400": {
            "$ref": "#/components/responses/Error10"
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "409": {
            "$ref": "#/components/responses/Error14"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get the answer of a job",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/v1/status": {
      "get": {
        "description": "Returns the plan of your key, how much of today's quota is left, and your balance. The request costs no quota and no balance.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/get-status"
        },
        "operationId": "getStatus",
        "parameters": [
          {
            "description": "Your API key, if you do not send it in the Authorization header.",
            "in": "query",
            "name": "key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "plan": "Basic",
                  "status": "Active",
                  "credit": 44872,
                  "quota": 20000,
                  "duration": 86400,
                  "lastreset": 1760486400,
                  "ttl": 41200,
                  "subscribed": 0,
                  "current_period_start": 1760000000,
                  "current_period_end": 1762600000,
                  "balance_usd": "4.9998",
                  "free_remaining": 0,
                  "free_quota": 100
                },
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "The state of your key."
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get the status of your key",
        "tags": [
          "Account"
        ]
      }
    }
  },
  "components": {
    "responses": {
      "Error10": {
        "content": {
          "application/json": {
            "example": {
              "code": 10,
              "error": 10,
              "message": "Invalid request",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 10, Invalid request. The request cannot be used: the body is not JSON or url-encoded form data, it is larger than 4.5 MB, a field or the number of images is wrong, or the job id is unknown or belongs to another captcha type."
      },
      "Error11": {
        "content": {
          "application/json": {
            "example": {
              "code": 11,
              "error": 11,
              "message": "Rate limit reached",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 11, Rate limit reached. Your key sent more requests per minute than its plan allows, or too many requests with a wrong key came from your address."
      },
      "Error14": {
        "content": {
          "application/json": {
            "example": {
              "code": 14,
              "error": 14,
              "message": "Incomplete job",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 14, Incomplete job. The job exists, but the answer is not ready. Poll again in one second."
      },
      "Error15": {
        "content": {
          "application/json": {
            "example": {
              "code": 15,
              "error": 15,
              "message": "Invalid key",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 15, Invalid key. The key is missing, has the wrong shape, or is unknown."
      },
      "Error16": {
        "content": {
          "application/json": {
            "example": {
              "code": 16,
              "error": 16,
              "message": "Out of credit",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 16, Out of credit. Your key is out of credit: today's plan quota and free quota of successful solves are used (jobs that are still open count as well), and the balance is empty. Top up the balance, pick a plan, or wait for the daily reset at 00:00 UTC."
      },
      "Error9": {
        "content": {
          "application/json": {
            "example": {
              "code": 9,
              "error": 9,
              "message": "Unknown error",
              "type": null
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error 9, Unknown error. Something went wrong on our side, or the recognition engine could not be reached. Retry after a few seconds."
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "code": {
            "description": "The same code (on /v1 paths).",
            "type": "integer"
          },
          "error": {
            "description": "The error code.",
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "null"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "LegacyError": {
        "properties": {
          "error": {
            "description": "The error code.",
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "Status": {
        "properties": {
          "balance_usd": {
            "description": "Prepaid balance in US dollars, for example `4.9998`. Added to the NopeCHA format.",
            "type": "string"
          },
          "credit": {
            "description": "Successful solves left: the remaining daily quota (plan or free) plus the balance converted to solves ($0.0002 each).",
            "type": "integer"
          },
          "current_period_end": {
            "description": "Unix time when the plan ends. null without a plan, and for a plan that does not expire.",
            "type": [
              "integer",
              "null"
            ]
          },
          "current_period_start": {
            "description": "Unix time when the plan began. null without a plan.",
            "type": [
              "integer",
              "null"
            ]
          },
          "duration": {
            "description": "Length of the quota window in seconds.",
            "type": "integer"
          },
          "free_quota": {
            "description": "Free solves per UTC day: 20 before the e-mail address is confirmed, 100 after. Added to the NopeCHA format.",
            "type": "integer"
          },
          "free_remaining": {
            "description": "Free daily solves left today. Added to the NopeCHA format.",
            "type": "integer"
          },
          "lastreset": {
            "description": "Unix time of the last quota reset (00:00 UTC).",
            "type": "integer"
          },
          "plan": {
            "description": "Name of the plan, `Free` (free tier only), `Pay per use` (only a balance) or `No plan`.",
            "type": "string"
          },
          "quota": {
            "description": "Successful solves per day for the plan.",
            "type": "integer"
          },
          "status": {
            "enum": [
              "Active",
              "Expired",
              "Inactive"
            ],
            "type": "string"
          },
          "subscribed": {
            "description": "1 while you have an active plan, otherwise 0. Plans granted by us count too.",
            "type": "integer"
          },
          "ttl": {
            "description": "Seconds until the next reset.",
            "type": "integer"
          }
        },
        "required": [
          "plan",
          "status",
          "credit",
          "quota",
          "duration",
          "lastreset",
          "ttl",
          "subscribed",
          "current_period_start",
          "current_period_end",
          "balance_usd",
          "free_remaining",
          "free_quota"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyQuery": {
        "description": "Your API key as a query parameter.",
        "in": "query",
        "name": "key",
        "type": "apiKey"
      },
      "bearerAuth": {
        "description": "Your API key, for example `Authorization: Bearer slv_...`. `Authorization: Basic \u003ckey\u003e` is accepted as well. The key can also be sent as the `key` field of a body.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
