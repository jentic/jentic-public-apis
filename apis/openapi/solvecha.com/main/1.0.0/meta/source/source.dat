{
  "openapi": "3.1.0",
  "info": {
    "contact": {
      "name": "Solvecha",
      "url": "https://solvecha.com/contact"
    },
    "description": "Create a job with a picture of a captcha, then poll for the answer. Authenticate with your API key. Documentation: https://solvecha.com/docs",
    "summary": "Captcha recognition API, compatible with the NopeCHA recognition API.",
    "termsOfService": "https://solvecha.com/legal/terms",
    "title": "Solvecha API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.solvecha.com"
    }
  ],
  "tags": [
    {
      "description": "Create jobs and fetch answers.",
      "name": "Recognition"
    },
    {
      "description": "Status of your key.",
      "name": "Account"
    },
    {
      "description": "Optional verdicts that help improve the models.",
      "name": "Feedback"
    },
    {
      "description": "Paths of the first NopeCHA API. Errors are answered with HTTP 200.",
      "name": "Legacy"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "deprecated": true,
        "description": "The poll request of the first NopeCHA API. It returns the answer of a job that you created on the root path or on a /v1/recognition/... path. Errors are answered with HTTP status 200: while the job is not ready you get {\"error\": 14, \"message\": \"Incomplete job\"}.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/legacy-get-job-result"
        },
        "operationId": "legacyGetJobResult",
        "parameters": [
          {
            "description": "The job id.",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Your API key, if you do not send it in the Authorization header.",
            "in": "query",
            "name": "key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    false,
                    true,
                    false,
                    true,
                    true,
                    false,
                    false,
                    false,
                    false
                  ]
                },
                "schema": {
                  "properties": {
                    "data": {}
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job is ready. An error also has HTTP status 200: the body then has an `error` field (see the LegacyError schema)."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get the answer of a job (legacy path)",
        "tags": [
          "Legacy"
        ]
      },
      "post": {
        "deprecated": true,
        "description": "The root path from the first NopeCHA API. It exists so that older clients keep working. New code should use the /v1/recognition/... paths. On this path the captcha type is a field of the body, and errors are answered with HTTP status 200: look at the error field.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/legacy-create-job"
        },
        "operationId": "legacyCreateJob",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "sync=1 (or \"sync\": true in the JSON body) is the same as wait=15.",
            "in": "query",
            "name": "sync",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "type": "recaptcha",
                "task": "Select all images with buses",
                "grid": "3x3",
                "image_data": [
                  "BASE64_IMAGE"
                ]
              },
              "schema": {
                "properties": {
                  "grid": {
                    "description": "reCAPTCHA only.",
                    "enum": [
                      "3x3",
                      "4x4",
                      "1x1"
                    ],
                    "type": "string"
                  },
                  "image_data": {
                    "description": "Base64 pictures. See the page of the captcha type.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text. See the page of the captcha type.",
                    "type": "string"
                  },
                  "type": {
                    "description": "The captcha type.",
                    "enum": [
                      "recaptcha",
                      "textcaptcha",
                      "geetest",
                      "funcaptcha",
                      "funcaptcha_match"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "image_data"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "grid": {
                    "description": "reCAPTCHA only.",
                    "enum": [
                      "3x3",
                      "4x4",
                      "1x1"
                    ],
                    "type": "string"
                  },
                  "image_data": {
                    "description": "Base64 pictures. See the page of the captcha type.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text. See the page of the captcha type.",
                    "type": "string"
                  },
                  "type": {
                    "description": "The captcha type.",
                    "enum": [
                      "recaptcha",
                      "textcaptcha",
                      "geetest",
                      "funcaptcha",
                      "funcaptcha_match"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "image_data"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": "1234567"
                },
                "schema": {
                  "properties": {
                    "data": {
                      "description": "The job id.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job was created. `data` is the job id. An error also has HTTP status 200: the body then has an `error` field (see the LegacyError schema)."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Create a job (legacy path)",
        "tags": [
          "Legacy"
        ]
      }
    },
    "/createTask": {
      "post": {
        "description": "Takes the createTask format of CapSolver, CapMonster Cloud and 2Captcha for picture tasks: ReCaptchaV2Classification (CapSolver), ComplexImageTask with class recaptcha (CapMonster Cloud), GridTask (2Captcha) and ImageToTextTask (all three). The task type tells the forms apart, and the answer follows the form of the request. Other task types answer ERROR_TASK_NOT_SUPPORTED. See Migrating from CapSolver, Migrating from CapMonster Cloud and Migrating from 2Captcha. The call waits for the answer, up to 15 seconds, and returns it as solution. If it takes longer, the status is processing and you fetch the answer with getTaskResult. Keys, limits and billing are the same as on the other paths: a task is charged once, when its solution is returned.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/capsolver-create-task"
        },
        "operationId": "capsolverCreateTask",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "clientKey": "YOUR_API_KEY",
                "task": {
                  "type": "ReCaptchaV2Classification",
                  "image": "BASE64_IMAGE",
                  "question": "/m/04_sv"
                }
              },
              "schema": {
                "properties": {
                  "appId": {
                    "description": "Optional partner code of an integration, as CapSolver clients send their app id. Same as the X-Solvecha-Partner header. See [Partner integrations](/docs/partner-integrations).",
                    "type": "string"
                  },
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "softId": {
                    "description": "Optional partner code, as 2Captcha and Anti-Captcha clients send their software id. appId is read first.",
                    "type": "string"
                  },
                  "task": {
                    "description": "type is ReCaptchaV2Classification or ImageToTextTask. For ReCaptchaV2Classification send image (base64) and question: a reCAPTCHA object code such as /m/04_sv, or the instruction as words. A picture up to 160 px is one tile (single). Larger pictures are a 3x3 grid (up to 380 px) or a 4x4 grid. For ImageToTextTask send body (base64) and, if you like, module common. CapMonster Cloud: ComplexImageTask takes class recaptcha, imagesBase64 or imageUrls and metadata (Task or TaskDefinition, Grid); the solution is answer, one boolean per tile. 2Captcha: GridTask takes body, comment, rows and columns; the solution is click, tile numbers from 1.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey",
                  "task"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "appId": {
                    "description": "Optional partner code of an integration, as CapSolver clients send their app id. Same as the X-Solvecha-Partner header. See [Partner integrations](/docs/partner-integrations).",
                    "type": "string"
                  },
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "softId": {
                    "description": "Optional partner code, as 2Captcha and Anti-Captcha clients send their software id. appId is read first.",
                    "type": "string"
                  },
                  "task": {
                    "description": "type is ReCaptchaV2Classification or ImageToTextTask. For ReCaptchaV2Classification send image (base64) and question: a reCAPTCHA object code such as /m/04_sv, or the instruction as words. A picture up to 160 px is one tile (single). Larger pictures are a 3x3 grid (up to 380 px) or a 4x4 grid. For ImageToTextTask send body (base64) and, if you like, module common. CapMonster Cloud: ComplexImageTask takes class recaptcha, imagesBase64 or imageUrls and metadata (Task or TaskDefinition, Grid); the solution is answer, one boolean per tile. 2Captcha: GridTask takes body, comment, rows and columns; the solution is click, tile numbers from 1.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey",
                  "task"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "errorId": 0,
                  "errorCode": "",
                  "errorDescription": "",
                  "status": "ready",
                  "taskId": "1234567",
                  "solution": {
                    "type": "multi",
                    "objects": [
                      0,
                      2,
                      5
                    ],
                    "size": 3
                  }
                },
                "schema": {
                  "properties": {
                    "errorCode": {
                      "type": "string"
                    },
                    "errorDescription": {
                      "type": "string"
                    },
                    "errorId": {
                      "type": "integer"
                    },
                    "solution": {
                      "description": "`objects` (tile numbers from 0, left to right, top to bottom) for a grid, `hasObject` for a single tile, `text` for a text picture.",
                      "type": "object"
                    },
                    "status": {
                      "enum": [
                        "ready",
                        "processing"
                      ],
                      "type": "string"
                    },
                    "taskId": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The task was accepted. When `status` is `ready`, `solution` holds the answer."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Create a task (CapSolver, CapMonster, 2Captcha style)",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/getBalance": {
      "post": {
        "description": "Returns the prepaid balance. Plan quotas and the free quota are not part of it: see Get the status of your key for those.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/capsolver-get-balance"
        },
        "operationId": "capsolverGetBalance",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "clientKey": "YOUR_API_KEY"
              },
              "schema": {
                "properties": {
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "errorId": 0,
                  "errorCode": "",
                  "errorDescription": "",
                  "balance": 4.9998,
                  "packages": []
                },
                "schema": {
                  "properties": {
                    "balance": {
                      "type": "number"
                    },
                    "errorId": {
                      "type": "integer"
                    },
                    "packages": {
                      "items": {},
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The balance."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get the balance (CapSolver style)",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/getTaskResult": {
      "post": {
        "description": "Returns the state of a task from createTask. While it runs, status is processing. Fetching a finished task again is free.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/capsolver-get-task-result"
        },
        "operationId": "capsolverGetTaskResult",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "clientKey": "YOUR_API_KEY",
                "taskId": "1234567"
              },
              "schema": {
                "properties": {
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "taskId": {
                    "description": "The taskId from createTask.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey",
                  "taskId"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "clientKey": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "taskId": {
                    "description": "The taskId from createTask.",
                    "type": "string"
                  }
                },
                "required": [
                  "clientKey",
                  "taskId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "errorId": 0,
                  "errorCode": "",
                  "errorDescription": "",
                  "status": "ready",
                  "taskId": "1234567",
                  "solution": {
                    "type": "multi",
                    "objects": [
                      0,
                      2,
                      5
                    ],
                    "size": 3
                  }
                },
                "schema": {
                  "properties": {
                    "errorId": {
                      "type": "integer"
                    },
                    "solution": {
                      "type": "object"
                    },
                    "status": {
                      "type": "string"
                    },
                    "taskId": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The state of the task."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get a task result (CapSolver style)",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/in.php": {
      "post": {
        "description": "Takes the in.php request of 2Captcha for two kinds of picture: a normal captcha (method base64 or post) and a reCAPTCHA image grid (recaptcha 1). Send the fields as a form, as a JSON body (like the JavaScript packages) or in the query string. Other methods, such as userrecaptcha, hcaptcha or coordinatescaptcha, answer ERROR_NO_SUCH_METHOD. The call waits for the answer, up to 15 seconds, so the first res.php call has it. Keys, limits and billing are the same as on the other paths: a task is charged once, when its solution is returned. See Migrating from 2Captcha.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/twocaptcha-in"
        },
        "operationId": "twocaptchaIn",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "key": "YOUR_API_KEY",
                "method": "base64",
                "body": "BASE64_IMAGE",
                "json": 1
              },
              "schema": {
                "properties": {
                  "body": {
                    "description": "The picture as base64, for method base64.",
                    "type": "string"
                  },
                  "json": {
                    "description": "1 answers with JSON: {\"status\": 1, \"request\": \"\u003cid\u003e\"}.",
                    "type": "integer"
                  },
                  "key": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "method": {
                    "description": "base64 (picture in body) or post (picture as the multipart file file). Default: post.",
                    "type": "string"
                  },
                  "recaptcha": {
                    "description": "1 for a reCAPTCHA image grid. Then send textinstructions (up to 140 characters) and, if you like, recaptcharows and recaptchacols (3x3, 4x4 or 1x1). Without them the picture size decides.",
                    "type": "integer"
                  },
                  "soft_id": {
                    "description": "Optional partner code of an integration. A value that is not a known code is ignored. See [Partner integrations](/docs/partner-integrations).",
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "The picture as base64, for method base64.",
                    "type": "string"
                  },
                  "json": {
                    "description": "1 answers with JSON: {\"status\": 1, \"request\": \"\u003cid\u003e\"}.",
                    "type": "integer"
                  },
                  "key": {
                    "description": "Your Solvecha API key.",
                    "type": "string"
                  },
                  "method": {
                    "description": "base64 (picture in body) or post (picture as the multipart file file). Default: post.",
                    "type": "string"
                  },
                  "recaptcha": {
                    "description": "1 for a reCAPTCHA image grid. Then send textinstructions (up to 140 characters) and, if you like, recaptcharows and recaptchacols (3x3, 4x4 or 1x1). Without them the picture size decides.",
                    "type": "integer"
                  },
                  "soft_id": {
                    "description": "Optional partner code of an integration. A value that is not a known code is ignored. See [Partner integrations](/docs/partner-integrations).",
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": 1,
                  "request": "1234567"
                },
                "schema": {
                  "properties": {
                    "request": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The picture was accepted. `request` is the id for res.php."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Send a picture (2Captcha style)",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/res.php": {
      "get": {
        "description": "action=get returns the answer of a job from in.php: the text, or click:1/4/7 for a grid (tile numbers from 1, left to right, top to bottom, or No_matching_images). While the job runs, the answer is CAPCHA_NOT_READY. Fetching a finished job again is free. action=getbalance returns your prepaid balance in US dollars.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/twocaptcha-res"
        },
        "operationId": "twocaptchaRes",
        "parameters": [
          {
            "description": "Your Solvecha API key.",
            "in": "query",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "get or getbalance.",
            "in": "query",
            "name": "action",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The id from in.php, for action get.",
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1 answers with JSON: {\"status\": 1, \"request\": \"click:1/4/7\"}.",
            "in": "query",
            "name": "json",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": 1,
                  "request": "click:1/4/7"
                },
                "schema": {
                  "properties": {
                    "request": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The answer, in the text form of 2Captcha (`OK|click:1/4/7`) or as JSON."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get an answer (2Captcha style)",
        "tags": [
          "Recognition"
        ]
      }
    },
    "/status": {
      "get": {
        "deprecated": true,
        "description": "Same answer as Get the status of your key, on the path of the first NopeCHA API. Errors are answered with HTTP status 200.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/legacy-get-status"
        },
        "operationId": "legacyGetStatus",
        "parameters": [
          {
            "description": "Your API key, if you do not send it in the Authorization header.",
            "in": "query",
            "name": "key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "plan": "Basic",
                  "status": "Active",
                  "credit": 44872,
                  "quota": 20000,
                  "duration": 86400,
                  "lastreset": 1760486400,
                  "ttl": 41200,
                  "subscribed": 0,
                  "current_period_start": 1760000000,
                  "current_period_end": 1762600000,
                  "balance_usd": "4.9998",
                  "free_remaining": 0,
                  "free_quota": 100
                },
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "The state of your key. An error also has HTTP status 200: the body then has an `error` field (see the LegacyError schema)."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Get the status of your key (legacy path)",
        "tags": [
          "Legacy"
        ]
      }
    },
    "/v1/feedback": {
      "post": {
        "description": "After you submit our answer to Google, you can tell us whether Google accepted it. This helps us improve the models. It is optional and costs no quota. The browser extension does this for you.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/send-feedback"
        },
        "operationId": "sendFeedback",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "job_id": "1234567",
                "verdict": "accepted",
                "grid": "3x3",
                "round_index": 0
              },
              "schema": {
                "properties": {
                  "grid": {
                    "description": "The grid size of the challenge.",
                    "enum": [
                      "1x1",
                      "3x3",
                      "4x4"
                    ],
                    "type": "string"
                  },
                  "job_id": {
                    "description": "The job id from the create response. It must be a reCAPTCHA job of your key.",
                    "type": "string"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "round_index": {
                    "description": "The number of the round in the challenge, from 0 to 64.",
                    "maximum": 64,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "verdict": {
                    "description": "Whether Google accepted the answer.",
                    "enum": [
                      "accepted",
                      "rejected"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "job_id",
                  "verdict",
                  "grid"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "grid": {
                    "description": "The grid size of the challenge.",
                    "enum": [
                      "1x1",
                      "3x3",
                      "4x4"
                    ],
                    "type": "string"
                  },
                  "job_id": {
                    "description": "The job id from the create response. It must be a reCAPTCHA job of your key.",
                    "type": "string"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "round_index": {
                    "description": "The number of the round in the challenge, from 0 to 64.",
                    "maximum": 64,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "verdict": {
                    "description": "Whether Google accepted the answer.",
                    "enum": [
                      "accepted",
                      "rejected"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "job_id",
                  "verdict",
                  "grid"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": "ok"
                },
                "schema": {
                  "properties": {
                    "data": {
                      "enum": [
                        "ok"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The verdict is stored. The first verdict per job counts. A repeat changes nothing."
          },
          "400": {
            "$ref": "#/components/responses/Error10"
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Send feedback",
        "tags": [
          "Feedback"
        ]
      }
    },
    "/v1/recognition/funcaptcha": {
      "post": {
        "description": "Creates a job for a FunCAPTCHA puzzle where you pick the tile that shows the asked object. Send the task text and one picture with the 3x2 grid of tiles.",
        "externalDocs": {
          "description": "Documentation page",
          "url": "https://solvecha.com/docs/api/create-funcaptcha-job"
        },
        "operationId": "createFuncaptchaJob",
        "parameters": [
          {
            "description": "Optional partner code of an integration. It only counts for a customer who has no partner yet and has not paid yet. An unknown code is ignored. See [Partner integrations](/docs/partner-integrations).",
            "in": "header",
            "name": "X-Solvecha-Partner",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "sync=1 (or \"sync\": true in the JSON body) is the same as wait=15.",
            "in": "query",
            "name": "sync",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Seconds to wait for the answer, up to 20. On a create request the response is the answer, as on the GET path, and the job id is in the X-Task-Id header. If the job is not done in time, you get the job id as usual. On a GET request the server holds the connection until the job is done (long poll), then returns the answer or error 14.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "indices=1 adds indices next to data: the numbers of the selected tiles, counted from 0. Only for reCAPTCHA answers.",
            "in": "query",
            "name": "indices",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "task": "Pick the sheep",
                "image_data": [
                  "BASE64_GRID"
                ]
              },
              "schema": {
                "properties": {
                  "image_data": {
                    "description": "One base64 picture with the grid of six tiles (3x2).",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text, for example Pick the sheep.",
                    "type": "string"
                  }
                },
                "required": [
                  "task",
                  "image_data"
                ],
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "image_data": {
                    "description": "One base64 picture with the grid of six tiles (3x2).",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "key": {
                    "description": "Your API key, if you do not send it in the Authorization header or the query string.",
                    "type": "string"
                  },
                  "partner": {
                    "description": "Optional partner code, if you cannot set the X-Solvecha-Partner header. The header wins when both are present. Up to 128 characters.",
                    "type": "string"
                  },
                  "task": {
                    "description": "The instruction text, for example Pick the sheep.",
                    "type": "string"
                  }
                },
                "required": [
                  "task",
                  "image_data"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": "1234567"
                },
                "schema": {
                  "properties": {
                    "data": {
                      "description": "The job id.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The job was created. `data` is the job id."
          },
          "400": {
            "$ref": "#/components/responses/Error10"
          },
          "401": {
            "$ref": "#/components/responses/Error15"
          },
          "403": {
            "$ref": "#/components/responses/Error16"
          },
          "429": {
            "$ref": "#/components/responses/Error11"
          },
          "500": {
            "$ref": "#/components/responses/Error9"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyQuery": []
          }
        ],
        "summary": "Create a FunCAPTCHA tile job",
        "tags": [
          "Recognition"
        ]
      }
    },
