{
  "openapi": "3.0.3",
  "info": {
    "title": "Agartala Smart City - Beneficiary Payment Status APIs (UAT)",
    "version": "1.0.0",
    "description": "API documentation for Agartala Smart City Beneficiary Payment Status APIs (UAT). - First, obtain a token from `/api/security/oauth/token` - Then call `/amc-ext/api/plot/beneficiary_payment_status` with the `Authorization` header.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mapmyindia-000/agartala-smart-city-beneficiary-payment-status-apis-uat/1.0.0"
  },
  "servers": [
    {
      "url": "https://stg.mapmyindia.in"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/security/oauth/token": {
      "post": {
        "summary": "Get OAuth Token",
        "description": "Obtain access token using client credentials.",
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "client_credentials"
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "40d3b93a50212bb5fdee5d4c8be2d216"
          },
          {
            "name": "client_secret",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b7ead3cd24d8f9ad127da29e7d1e4217"
          }
        ],
        "responses": {
          "200": {
            "description": "Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Example successful response",
                    "value": {
                      "access_token": "e0a0f850-db21-44c3-ac2d-0c3b819c2a98",
                      "token_type": "Bearer",
                      "expires_in": 3600
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid": {
                    "summary": "Invalid request example",
                    "value": {
                      "code": 400,
                      "message": "Missing required parameters"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Unauthorized example",
                    "value": {
                      "code": 401,
                      "message": "Invalid client credentials"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "server_error": {
                    "summary": "Example server error",
                    "value": {
                      "code": 500,
                      "message": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/amc-ext/api/plot/beneficiary_payment_status": {
      "post": {
        "summary": "Beneficiary Payment Status",
        "description": "Fetch payment status for a specific plot using village code and plot number.",
        "parameters": [
          {
            "name": "lgdVillageCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "922851"
          },
          {
            "name": "plotNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1596"
          },
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "application/vnd.taxsaas.v1+json"
          },
          {
            "name": "X-Account-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ascl-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Beneficiary payment status fetched successfully",
            "content": {
              "application/vnd.taxsaas.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/BeneficiaryPaymentStatus"
                },
                "examples": {
                  "success": {
                    "summary": "Example successful response",
                    "value": {
                      "lgdVillageCode": "922851",
                      "plotNumber": "1596",
                      "paymentStatus": "PAID",
                      "transactionId": "AMC-1000253445",
                      "amount": 1250.0,
                      "paymentDate": "2025-10-15"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid": {
                    "summary": "Invalid parameters",
                    "value": {
                      "code": 400,
                      "message": "Invalid or missing lgdVillageCode/plotNumber"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid or missing API token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Example unauthorized response",
                    "value": {
                      "code": 401,
                      "message": "Invalid or expired token"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found (Invalid LGD code or plot number)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "not_found": {
                    "summary": "Example not found response",
                    "value": {
                      "code": 404,
                      "message": "Beneficiary not found for given details"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "server_error": {
                    "summary": "Example server error",
                    "value": {
                      "code": 500,
                      "message": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Provide the API token obtained from `/api/security/oauth/token`."
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "e0a0f850-db21-44c3-ac2d-0c3b819c2a98"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Unauthorized"
          }
        }
      },
      "BeneficiaryPaymentStatus": {
        "type": "object",
        "properties": {
          "lgdVillageCode": {
            "type": "string",
            "example": "922851"
          },
          "plotNumber": {
            "type": "string",
            "example": "1596"
          },
          "paymentStatus": {
            "type": "string",
            "example": "PAID"
          },
          "transactionId": {
            "type": "string",
            "example": "AMC-1000253445"
          },
          "amount": {
            "type": "number",
            "example": 1250.0
          },
          "paymentDate": {
            "type": "string",
            "format": "date",
            "example": "2025-10-15"
          }
        }
      }
    }
  }
}
