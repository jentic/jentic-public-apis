          },
          {
            "BuyerEmail": []
          }
        ]
      },
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postPolicyMulti",
        "summary": "Policy multi-document analysis",
        "description": "Audits multiple policy documents or consent graphs to surface gaps in relational permission.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "policy_documents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sector": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
