    "/v1/docs": {
      "get": {
        "tags": [
          "Utilities"
        ],
        "operationId": "getDocs",
        "summary": "API documentation overview",
        "description": "Returns links to full documentation and endpoint list.",
        "responses": {
          "200": {
            "description": "Documentation links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
