      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getPolicyMulti",
        "summary": "Policy compliance analysis (GET)",
        "description": "Retrieves aggregated policy compliance scores or analysis summaries.\n",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
