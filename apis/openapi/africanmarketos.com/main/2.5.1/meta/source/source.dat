{
  "openapi": "3.0.3",
  "info": {
    "title": "African Market OS \u2014 Minimum Viable Relationships (MVR) API",
    "version": "2.5.1",
    "description": "The MVR API measures trust, belonging, permission, and embeddedness to determine\nrelational readiness for ventures and initiatives entering high-context markets.\nPublic spec describes endpoints, request/response shapes, and integration guidance.\nBased on the MVR Framework v3.0.6 (DOI: 10.5281/zenodo.17310446).\n",
    "termsOfService": "https://africanmarketos.com/african-market-os-mvr-framework-commercial-referral-use-policy/",
    "contact": {
      "name": "African Market OS",
      "url": "https://africanmarketos.com",
      "email": "info@africanmarketos.com"
    },
    "license": {
      "name": "CC BY 4.0 (Academic/Research Use)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "x-commercialLicense": "https://africanmarketos.com/african-market-os-mvr-framework-commercial-referral-use-policy/",
    "x-api-id": "mvr-api-v2.5-enterprise",
    "x-framework-doi": "10.5281/zenodo.17310446",
    "x-author-orcid": "0009-0009-8191-2098",
    "x-logo": {
      "url": "https://africanmarketos.com/mvr-logo.png"
    },
    "x-jsonld": {
      "apiReference": "https://africanmarketos.com/docs.jsonld"
    },
    "x-schema": {
      "@context": "https://schema.org",
      "@type": "WebAPI",
      "name": "MVR API",
      "description": "Relational Readiness API for high-context markets",
      "documentation": "https://africanmarketos.com/docs",
      "provider": {
        "@type": "Organization",
        "name": "African Market OS"
      }
    },
    "x-keywords": [
      "trust scoring",
      "relational analytics",
      "emerging markets",
      "social license",
      "AI ethics",
      "high-context markets"
    ],
    "x-ai-capabilities": [
      "relationship-scoring",
      "trust-analytics",
      "market-readiness-assessment",
      "stakeholder-insights"
    ],
    "x-use-cases": [
      "Pre-market entry analysis",
      "Partnership viability scoring",
      "Cultural fit assessment",
      "Community engagement planning"
    ],
    "x-rateLimit": {
      "standard": "1000/hour",
      "pro": "5000/hour",
      "enterprise": "10000/hour"
    },
    "x-performance": {
      "typical_latency_ms": 100,
      "p95_latency_ms": 300,
      "p99_latency_ms": 500
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/africanmarketos/african-market-os-mvr-api/2.5.1"
  },
  "externalDocs": {
    "description": "MVR Framework (DOI)",
    "url": "https://doi.org/10.5281/zenodo.17310446"
  },
  "servers": [
    {
      "url": "https://africanmarketos.com/v1",
      "description": "Production API Gateway (Cloudflare Workers)"
    }
  ],
  "tags": [
    {
      "name": "Scores",
      "description": "Compute MVR Index and dimensional breakdowns"
    },
    {
      "name": "Diagnostics",
      "description": "Prioritized improvements and levers to increase relational readiness"
    },
    {
      "name": "Context",
      "description": "Region and sector-specific relational cues and etiquette"
    },
    {
      "name": "Intelligence",
      "description": "Trends, forecasts, comparisons, benchmarks, insights, policy, story, temperature"
    },
    {
      "name": "Webhooks",
      "description": "Event subscription and delivery"
    },
    {
      "name": "Utilities",
      "description": "Health, metadata, session, and auth utilities"
    },
    {
      "name": "Administration",
      "description": "(Admin ops are intentionally omitted from the public spec)"
    }
  ],
  "paths": {
    "/v1/scores": {
      "get": {
        "tags": [
          "Scores"
        ],
        "operationId": "getScores",
        "summary": "Compute the Minimum Viable Relationship (MVR) Index",
        "description": "Calculates the overall MVR Index (0.0 - 1.0) and a breakdown across the seven MVR dimensions. Use `sector` and `region` hints to apply sector/region weight calibrations.\n",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target sector for scoring (e.g., \"energy-transition\")"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Geographic region hint for context (e.g., \"east-africa\")"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful MVR Index calculation",
            "headers": {
              "Cite-As": {
                "$ref": "#/components/headers/Cite-As"
              },
              "Link-License": {
                "$ref": "#/components/headers/Link-License"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                },
                "examples": {
                  "basic": {
                    "summary": "Example score response",
                    "value": {
                      "ok": true,
                      "mvr_index": 0.725,
                      "confidence": 0.89,
                      "sector": "energy-transition",
                      "mvr_dimensions": [
                        {
                          "name": "Embeddedness",
                          "score": 0.75,
                          "confidence": 0.85,
                          "threshold_ok": true,
                          "binding": false
                        }
                      ],
                      "mvr_threshold": true,
                      "recommendations": [
                        "Validate with guardians; deploy reciprocity pilots."
                      ],
                      "version_info": {
                        "api": "2.5.1",
                        "model": "calibrated",
                        "mvr_proprietary": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/survey-aggregate": {
      "post": {
        "tags": [
          "Scores"
        ],
        "operationId": "postSurveyAggregate",
        "summary": "Aggregate stakeholder feedback into an MVR Index",
        "description": "Processes stakeholder responses to calculate a consolidated MVR Index and community insights. Use for survey or interview-based inputs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stakeholder_responses"
                ],
                "properties": {
                  "stakeholder_responses": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/StakeholderResponse"
                    },
                    "description": "Array of responses from stakeholders"
                  },
                  "sector": {
                    "type": "string",
                    "description": "Sector hint"
                  },
                  "region": {
                    "type": "string",
                    "description": "Region hint"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aggregated MVR Index and insights",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyAggregateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/diagnose": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "operationId": "postDiagnose",
        "summary": "Run relational diagnostic",
        "description": "Generates prioritized, actionable recommendations to improve the MVR Index, based on observed signals and contextual metadata.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostic report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticOutput"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/contexts": {
      "get": {
        "tags": [
          "Context"
        ],
        "operationId": "getContexts",
        "summary": "Retrieve cultural and relational context",
        "description": "Returns region and sector-specific etiquette, belonging cues, and trust signals.\n",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Contextual map",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/trends": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getTrends",
        "summary": "Analyze historical relationship trends",
        "description": "Retrieves temporal trends in MVR scores for an entity, sector, or region.\n",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Trends analysis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/forecast": {
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postForecast",
        "summary": "Forecast future relationship dynamics",
        "description": "Predicts future MVR index values using current index and velocity. Index is 0.0 - 1.0.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "current_index",
                  "velocity"
                ],
                "properties": {
                  "current_index": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "example": 0.68,
                    "description": "Current MVR Index (0.0 - 1.0)"
                  },
                  "velocity": {
                    "type": "number",
                    "format": "float",
                    "example": 0.02,
                    "description": "Rate of change per month (decimal points)"
                  },
                  "horizon": {
                    "type": "integer",
                    "default": 30,
                    "example": 90,
                    "description": "Forecast horizon in days"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forecast report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/compare": {
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postCompare",
        "summary": "Compare MVR indices of two entities",
        "description": "Compares readiness between two entities.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "a_index",
                  "b_index"
                ],
                "properties": {
                  "a_index": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0.0,
                    "maximum": 1.0
                  },
                  "b_index": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0.0,
                    "maximum": 1.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comparison result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/benchmark": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getBenchmark",
        "summary": "Get sector benchmark",
        "description": "Returns sector-specific benchmark data for MVR index comparison.\n",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Benchmark data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      },
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postBenchmark",
        "summary": "Benchmark MVR index against sector baselines",
        "description": "Returns percentile and sector benchmark comparisons for a provided MVR index or entity.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0.0,
                    "maximum": 1.0
                  },
                  "sector": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Benchmark response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/insights": {
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postInsights",
