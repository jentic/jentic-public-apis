                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blueprint generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "blueprint_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "Utilities"
        ],
        "operationId": "getHealth",
        "summary": "API Health Check",
        "description": "Returns basic health and public version information.",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "service": {
                      "type": "string",
                      "example": "mvr-api-v2.5-enterprise"
                    },
                    "version": {
                      "type": "string",
                      "example": "2.5.1"
                    },
                    "uptime_seconds": {
                      "type": "number",
                      "example": 123456
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "lru-cache",
                        "circuit-breakers",
                        "batched-kv"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/meta": {
      "get": {
        "tags": [
          "Utilities"
        ],
        "operationId": "getMeta",
        "summary": "API metadata and endpoints list",
        "description": "Public metadata describing endpoints and limits.",
        "responses": {
          "200": {
            "description": "API metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/session/new": {
      "post": {
        "tags": [
          "Utilities"
        ],
        "operationId": "postSessionNew",
        "summary": "Create a new API session (short-lived)",
        "description": "Exchanges a valid license key for a short-lived session token. Use session tokens only where header-based auth is infeasible.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "license",
                  "email"
                ],
                "properties": {
                  "license": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session token created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "session_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    },
                    "plan": {
                      "type": "string",
                      "example": "standard"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/auth/check": {
      "post": {
        "tags": [
          "Utilities"
        ],
        "operationId": "postAuthCheck",
        "summary": "Validate an API license key",
        "description": "Check license key and buyer email association.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "buyer_email"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "buyer_email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "plan": {
                      "type": "string",
                      "example": "pro"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    },
    "/v1/usage": {
      "get": {
        "tags": [
          "Utilities"
        ],
        "operationId": "getUsage",
        "summary": "Get current API usage for the license key",
        "description": "Returns usage count for the authenticated key (requires auth)",
        "responses": {
          "200": {
            "description": "Usage information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "plan": {
                      "type": "string",
                      "example": "pro"
                    },
                    "date": {
                      "type": "string",
                      "example": "2025-11-12"
                    },
                    "used_today": {
                      "type": "integer",
                      "example": 1250
                    },
                    "daily_limit": {
                      "type": "integer",
                      "example": 50000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BuyerEmail": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-mvr-license",
        "description": "Your MVR API License Key.\n\u26a0\ufe0f Keep this secret! Never commit to version control.\nObtain from: https://africanmarketos.com/get-access\n"
      },
      "BuyerEmail": {
        "type": "apiKey",
        "in": "header",
        "name": "x-buyer-email",
        "description": "Email associated with the license key.\n\u26a0\ufe0f Keep this secret! Never commit to version control.\n"
      },
      "SessionAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-mvr-session",
        "description": "Temporary session token obtained from /v1/session/new.\n\u26a0\ufe0f Keep this secret! Has limited lifetime.\n"
      }
    },
    "headers": {
      "Cite-As": {
        "description": "Preferred citation string for this response",
        "schema": {
          "type": "string"
        },
        "example": "Source: African Market OS - Farouk Mark Mukiibi"
      },
      "Link-License": {
        "description": "RFC5988 Link header containing license URL",
        "schema": {
          "type": "string"
        },
        "example": "<https://africanmarketos.com/.well-known/mvr-license.json>; rel=\"license\""
      },
      "X-RateLimit-Limit": {
        "description": "Request limit for the current plan",
        "schema": {
          "type": "integer"
        },
        "example": 5000
      },
      "X-RateLimit-Remaining": {
        "description": "Remaining requests in the current window",
        "schema": {
          "type": "integer"
        },
        "example": 4998
      },
      "X-RateLimit-Reset": {
        "description": "UTC epoch seconds until rate-limit reset",
        "schema": {
          "type": "integer"
        },
        "example": 1700000000
      }
    },
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "description": "Page number for paginated responses"
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 50,
          "maximum": 1000
        },
        "description": "Maximum items per page"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalid_license": {
                "summary": "Invalid license",
                "value": {
                  "ok": false,
                  "error": "invalid_license",
                  "message": "License key not found or expired"
                }
              },
              "rate_limited": {
                "summary": "Rate limit exceeded",
                "value": {
                  "ok": false,
                  "error": "rate_limit_exceeded",
                  "message": "Daily limit of 5000 requests exceeded"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden - insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded",
        "headers": {
          "Retry-After": {
            "description": "Seconds until next allowed request",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Service temporarily unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ScoreResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "mvr_index": {
            "type": "number",
            "format": "float",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.725,
            "description": "Overall MVR score (0.0 - 1.0)"
          },
          "confidence": {
            "type": "number",
            "format": "float",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.89
          },
          "sector": {
            "type": "string",
            "example": "energy-transition"
          },
          "mvr_dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "threshold_ok": {
                  "type": "boolean"
                },
                "binding": {
                  "type": "boolean"
                }
              }
            }
          },
          "mvr_threshold": {
            "type": "boolean",
            "example": true,
            "description": "True if mvr_index >= 0.68"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version_info": {
            "type": "object",
            "properties": {
              "api": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "mvr_proprietary": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "SurveyAggregateResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScoreResponse"
          }
        ],
        "properties": {
          "matrix_axes": {
            "type": "object",
            "properties": {
              "viability": {
                "type": "number",
                "format": "float",
                "example": 0.72
              },
              "embeddedness": {
                "type": "number",
                "format": "float",
                "example": 0.61
              }
            }
          },
          "insights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "DiagnosticInput": {
        "type": "object",
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "late-response",
              "community-event"
            ]
          },
          "sector": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "DiagnosticOutput": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "ranked_levers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projected_uplift": {
            "type": "number",
            "format": "float"
          },
          "reasoning": {
            "type": "string"
          },
          "policy_trace": {
            "type": "object"
          }
        }
      },
      "ContextResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "etiquette_notes": {
            "type": "string"
          },
          "belonging_cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TrendsResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "sector": {
            "type": "string"
          },
          "days": {
            "type": "integer"
          },
          "average_index": {
            "type": "number",
            "format": "float"
          },
          "slope": {
            "type": "number",
            "format": "float"
          },
          "interpretation": {
            "type": "string"
          }
        }
      },
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "current_index": {
            "type": "number",
            "format": "float",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "projected_index": {
            "type": "number",
            "format": "float",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "horizon_days": {
            "type": "integer"
          },
          "confidence": {
            "type": "number"
          },
          "pmf_projection": {
            "type": "string"
          }
        }
      },
      "CompareResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "delta": {
            "type": "number",
            "format": "float"
          },
          "verdict": {
            "type": "string"
          },
          "policy_trace": {
            "type": "object"
          }
        }
      },
      "BenchmarkResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "sector": {
            "type": "string"
          },
          "percentile": {
            "type": "number"
          },
          "benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string"
                },
                "your_score": {
                  "type": "number",
                  "format": "float"
                },
                "sector_average": {
                  "type": "number",
                  "format": "float"
                },
                "top_quartile": {
                  "type": "number",
                  "format": "float"
                }
              }
            }
          }
        }
      },
      "InsightsResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "insights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PolicyMultiResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "policies_analyzed": {
            "type": "integer"
          },
          "compliance_score": {
            "type": "number",
            "format": "float"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version_info": {
            "type": "object"
          }
        }
      },
      "StoryResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "story": {
            "type": "string"
          },
          "impact_metrics": {
            "type": "object",
            "properties": {
              "trust_growth": {
                "type": "number",
                "format": "float"
              },
              "relationship_longevity": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "version_info": {
            "type": "object"
          }
        }
      },
      "WhoAmIResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "api": {
            "type": "string",
            "example": "MVR API"
          },
          "version": {
            "type": "string",
            "example": "2.5.1"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "survey-aggregate",
              "scores",
              "trends"
            ]
          },
          "author": {
            "type": "string",
            "example": "African Market OS"
          },
          "region": {
            "type": "string",
            "example": "EA"
          }
        }
      },
      "DocsResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "documentation": {
            "type": "string",
            "example": "MVR API v2.5 - Complete documentation available"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version_info": {
            "type": "object"
          }
        }
      },
      "TemperatureResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "continent_score": {
            "type": "number",
            "format": "float",
            "example": 0.71
          },
          "hottest_sector": {
            "type": "string",
            "example": "fintech"
          },
          "coolest_sector": {
            "type": "string",
            "example": "policy"
          },
          "region": {
            "type": "string",
            "example": "EA"
          },
          "sample_size": {
            "type": "integer",
            "example": 1500
          },
          "version_info": {
            "type": "object"
          }
        }
      },
      "WebhookRegister": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mvr.update",
                "mvr.alert",
                "guardian.change"
              ]
            }
          },
          "secret": {
            "type": "string",
            "description": "Webhook signing secret (auto-generated on registration)"
          }
        }
      },
      "WebhookVerification": {
        "type": "object",
        "required": [
          "payload",
          "signature"
        ],
        "properties": {
          "payload": {
            "type": "string",
            "description": "Raw webhook payload string"
          },
          "signature": {
            "type": "string",
            "description": "HMAC signature to verify"
          },
          "algorithm": {
            "type": "string",
            "default": "sha256",
            "enum": [
              "sha256",
              "sha1"
            ]
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "mvr.update",
              "mvr.alert",
              "guardian.change"
            ]
          },
          "data": {
            "type": "object",
            "description": "Event payload data"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "api_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "standard": {
                "type": "integer"
              },
              "pro": {
                "type": "integer"
              },
              "enterprise": {
                "type": "integer"
              }
            }
          },
          "last_model_refresh": {
            "type": "string",
            "nullable": true
          },
          "model_fingerprint": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "StakeholderResponse": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BuyerEmail": []
    }
  ]
}