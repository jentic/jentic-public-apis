    "/v1/auto-learn": {
      "post": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "postAutoLearn",
        "summary": "Auto-learn to improve calibration (controlled)",
        "description": "Ingests labelled correction signals or curated datasets to propose model calibration updates. This endpoint should be used under controlled agreements and is rate-limited.\n",
        "requestBody": {
          "required": true,
          "content": {
