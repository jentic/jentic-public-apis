{
  "openapi": "3.0.3",
  "info": {
    "title": "NOAA ERDDAP API",
    "description": "Environmental Research Division Data Access Program (ERDDAP) provides a RESTful interface to access oceanographic, atmospheric, and environmental datasets. Supports griddap (gridded data), tabledap (tabular data), full-text search, and various output formats.",
    "version": "2.0.0",
    "contact": {
      "name": "NOAA CoastWatch",
      "url": "https://coastwatch.pfeg.noaa.gov/erddap/"
    },
    "x-jentic-source-url": "https://coastwatch.pfeg.noaa.gov/erddap/index.html",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://coastwatch.pfeg.noaa.gov/erddap",
      "description": "NOAA CoastWatch ERDDAP server"
    }
  ],
  "paths": {
    "/search/index.json": {
      "get": {
        "operationId": "searchDatasets",
        "summary": "Full-text search for datasets",
        "description": "Searches all dataset metadata for matching terms and returns a list of matching datasets.",
        "parameters": [
          {
            "name": "searchFor",
            "in": "query",
            "required": true,
            "description": "Search terms (percent-encoded)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-based)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "itemsPerPage",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results with dataset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "object",
                      "properties": {
                        "columnNames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search/advanced.json": {
      "get": {
        "operationId": "advancedSearchDatasets",
        "summary": "Advanced search for datasets",
        "description": "Advanced search with additional filtering options beyond full-text search.",
        "parameters": [
          {
            "name": "searchFor",
            "in": "query",
            "description": "Search terms",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "itemsPerPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          },
          {
            "name": "protocol",
            "in": "query",
            "description": "Data access protocol filter",
            "schema": {
              "type": "string",
              "enum": [
                "griddap",
                "tabledap",
                "wms"
              ]
            }
          },
          {
            "name": "cdm_data_type",
            "in": "query",
            "description": "Common data model type filter",
            "schema": {
              "type": "string",
              "enum": [
                "Grid",
                "TimeSeries",
                "Point",
                "Profile",
                "Trajectory",
                "Other"
              ]
            }
          },
          {
            "name": "minLon",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxLon",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minLat",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxLat",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minTime",
            "in": "query",
            "description": "ISO 8601 datetime string",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxTime",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Advanced search results"
          }
        }
      }
    },
    "/info/index.json": {
      "get": {
        "operationId": "listAllDatasets",
        "summary": "List all available datasets",
        "description": "Returns metadata for all datasets available on this ERDDAP server.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "itemsPerPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of all datasets with metadata"
          }
        }
      }
    },
    "/info/{datasetId}/index.json": {
      "get": {
        "operationId": "getDatasetInfo",
        "summary": "Get metadata for a specific dataset",
        "description": "Returns detailed metadata including variables, dimensions, and global attributes for a specific dataset.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "The dataset identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dataset metadata"
          },
          "404": {
            "description": "Dataset not found"
          }
        }
      }
    },
    "/tabledap/{datasetId}.json": {
      "get": {
        "operationId": "queryTabledapJson",
        "summary": "Query tabular dataset and return JSON",
        "description": "Queries a tabular dataset using OPeNDAP constraint expressions. Supports selection of variables and filtering conditions.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "The tabular dataset identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tabular data in JSON format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "object",
                      "properties": {
                        "columnNames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "columnTypes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tabledap/{datasetId}.csv": {
      "get": {
        "operationId": "queryTabledapCsv",
        "summary": "Query tabular dataset and return CSV",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tabular data in CSV format",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/griddap/{datasetId}.json": {
      "get": {
        "operationId": "queryGriddapJson",
        "summary": "Query gridded dataset and return JSON",
        "description": "Queries a gridded dataset using OPeNDAP hyperslab notation to request spatial/temporal subsets.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "The gridded dataset identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gridded data in JSON format"
          }
        }
      }
    },
    "/categorize/index.json": {
      "get": {
        "operationId": "listCategories",
        "summary": "List dataset categorization attributes",
        "description": "Returns available categorization attributes for browsing datasets.",
        "responses": {
          "200": {
            "description": "List of category types"
          }
        }
      }
    },
    "/categorize/{attribute}/index.json": {
      "get": {
        "operationId": "getCategoryValues",
        "summary": "List values for a categorization attribute",
        "parameters": [
          {
            "name": "attribute",
            "in": "path",
            "required": true,
            "description": "Category attribute name (e.g., institution, ioos_category)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of values for the category"
          }
        }
      }
    },
    "/convert/time.json": {
      "get": {
        "operationId": "convertTime",
        "summary": "Convert between time string and numeric formats",
        "description": "Converts between ISO 8601 date strings and numeric seconds-since-epoch.",
        "parameters": [
          {
            "name": "isoTime",
            "in": "query",
            "description": "ISO 8601 time string to convert to numeric",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "n",
            "in": "query",
            "description": "Numeric time (seconds since 1970-01-01) to convert to ISO string",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Converted time value"
          }
        }
      }
    }
  },
  "security": []
}
