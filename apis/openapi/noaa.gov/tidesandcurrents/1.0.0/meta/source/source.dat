{
  "openapi": "3.0.3",
  "info": {
    "title": "NOAA Tides and Currents CO-OPS Data Retrieval API",
    "description": "Provides access to NOAA tide predictions, water levels, meteorological data, and currents observations from CO-OPS stations. No authentication required.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.tidesandcurrents.noaa.gov/api/prod/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.tidesandcurrents.noaa.gov/api/prod"
    }
  ],
  "paths": {
    "/datagetter": {
      "get": {
        "operationId": "getData",
        "summary": "Retrieve tide, water level, meteorological, or current data for a station",
        "parameters": [
          {
            "name": "station",
            "in": "query",
            "required": true,
            "description": "Station ID (7-character ID for tide stations, or currents station ID)",
            "schema": {
              "type": "string",
              "example": "9414290"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": true,
            "description": "Data product type",
            "schema": {
              "type": "string",
              "enum": [
                "water_level",
                "hourly_height",
                "high_low",
                "daily_mean",
                "monthly_mean",
                "one_minute_water_level",
                "predictions",
                "datums",
                "currents",
                "currents_predictions",
                "air_gap",
                "wind",
                "air_pressure",
                "air_temperature",
                "water_temperature",
                "conductivity",
                "visibility",
                "humidity",
                "salinity"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Predefined date range (today, latest, recent). Mutually exclusive with begin_date/end_date.",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "latest",
                "recent"
              ]
            }
          },
          {
            "name": "begin_date",
            "in": "query",
            "description": "Start date in yyyyMMdd or yyyyMMdd HH:mm format",
            "schema": {
              "type": "string",
              "example": "20240101"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "End date in yyyyMMdd or yyyyMMdd HH:mm format",
            "schema": {
              "type": "string",
              "example": "20240102"
            }
          },
          {
            "name": "range",
            "in": "query",
            "description": "Number of hours (or years for monthly_mean) of data to retrieve",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "datum",
            "in": "query",
            "description": "Datum reference for water level products",
            "schema": {
              "type": "string",
              "enum": [
                "CRD",
                "IGLD",
                "LWD",
                "MHHW",
                "MHW",
                "MTL",
                "MSL",
                "MLW",
                "MLLW",
                "NAVD",
                "STND"
              ]
            }
          },
          {
            "name": "units",
            "in": "query",
            "description": "Units of measurement",
            "schema": {
              "type": "string",
              "enum": [
                "metric",
                "english"
              ]
            }
          },
          {
            "name": "time_zone",
            "in": "query",
            "description": "Time zone for timestamps",
            "schema": {
              "type": "string",
              "enum": [
                "gmt",
                "lst",
                "lst_ldt"
              ]
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Data interval (product-dependent)",
            "schema": {
              "type": "string",
              "enum": [
                "h",
                "1",
                "5",
                "6",
                "10",
                "15",
                "30",
                "60",
                "hilo",
                "max_slack"
              ]
            }
          },
          {
            "name": "bin",
            "in": "query",
            "description": "Bin number for currents data",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "vel_type",
            "in": "query",
            "description": "Velocity type for currents predictions",
            "schema": {
              "type": "string",
              "enum": [
                "speed_dir",
                "default"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "csv"
              ],
              "default": "json"
            }
          },
          {
            "name": "application",
            "in": "query",
            "description": "Application identifier for logging purposes",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "lat": {
                          "type": "string"
                        },
                        "lon": {
                          "type": "string"
                        }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "t": {
                            "type": "string",
                            "description": "Timestamp"
                          },
                          "v": {
                            "type": "string",
                            "description": "Value"
                          },
                          "s": {
                            "type": "string",
                            "description": "Standard deviation"
                          },
                          "f": {
                            "type": "string",
                            "description": "Data flags"
                          },
                          "q": {
                            "type": "string",
                            "description": "Quality flag"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          }
        }
      }
    }
  },
  "security": []
}
