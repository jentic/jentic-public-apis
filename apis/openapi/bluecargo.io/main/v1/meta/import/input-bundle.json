    "/shipments": {
      "parameters": [],
      "get": {
        "parameters": [
          {
            "description": "A page number within the paginated result set.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Number of results to return per page.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Bill of Ladings filter list in JSON format",
            "example": "[\"TEST2340\", \"TEST2341\"]",
            "in": "query",
            "name": "bill_of_ladings",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Tags filter list in JSON format - if multiple tag names are provided they are ANDed together,\n    and if multiple tag values are provided they are ORed together.  Using the example, the logic would be that a\n    shipment or container must be tagged with chassis = 'chz1' AND (PO # = 'po1' OR PO # = 'po2') to match the filter",
            "example": "[{\"name\": \"chassis\", \"value\": \"chz1\"}, {\"name\": \"PO #\", \"values\": [\"po1\", \"po2\"]}]",
            "in": "query",
            "name": "tags",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Order By created_at only",
            "example": "-created_at",
            "in": "query",
            "name": "ordering",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "Successful"
          },
          "429": {
            "description": "Rate Limited"
          }
        },
        "tags": [
          "shipments"
        ],
        "description": "\nList Shipments\n--\nOutput the list of your shipments\n",
        "operationId": "shipments_list"
      },
      "post": {
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentCreation"
                }
              }
            },
            "description": "Success"
          },
          "429": {
            "description": "Rate Limited"
          }
        },
        "tags": [
          "shipments"
        ],
        "description": "\nCreate Shipment\n--\nCreates shipment(s) based on post parameters\n[\n&nbsp;&nbsp;{\n&nbsp;&nbsp;&nbsp;&nbsp;bill_of_lading_num i.e. `1231231`\n&nbsp;&nbsp;&nbsp;&nbsp;carrier_scac i.e. `MAEU`\n&nbsp;&nbsp;}\n&nbsp;&nbsp;...\n]\n\n",
        "operationId": "shipments_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "properties": {
                    "tags": {
                      "description": "The 'tags' field can be either a dictionary of key/value pairs or a list of objects.<br>For a dictionary, each key is a tag name, and the tag value is either a string or a list of strings.<br>For a list, each object must have a 'name' field (string) and either a 'value' field (string) or a 'values' field (list of strings). <br><br>Examples:<br><br>Dictionary format:<br>{<br>&nbsp;&nbsp;&nbsp;&nbsp;\"chassis\":&nbsp;\"MyChassis\",<br>&nbsp;&nbsp;&nbsp;&nbsp;\"drayage&nbsp;carrier\":&nbsp;[<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"SCAC1\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"SCAC2\"<br>&nbsp;&nbsp;&nbsp;&nbsp;]<br>}<br><br>List format:<br>[<br>&nbsp;&nbsp;&nbsp;&nbsp;{<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"name\":&nbsp;\"PO&nbsp;#\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"value\":&nbsp;\"MyPurchase&nbsp;Order&nbsp;Number\"<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;{<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"name\":&nbsp;\"warehouse_lot_number\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"values\":&nbsp;[<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"ABC\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"XYZ\"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>]",
                      "items": {
                        "description": "Tag Value or Values",
                        "properties": {
                          "name": {
                            "description": "Tag Name",
                            "type": "string"
                          },
                          "value": {
                            "description": "Tag Value",
                            "nullable": true,
                            "type": "string"
                          },
                          "values": {
                            "description": "Tag Values as a List of Strings",
                            "items": {
                              "type": "string"
                            },
                            "nullable": true,
                            "type": "array"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "bill_of_lading_num": {
                      "description": "Bill of Lading Number",
                      "type": "string"
                    },
                    "carrier_scac": {
                      "description": "Carrier SCAC",
                      "type": "string"
                    },
                    "container_numbers": {
                      "description": "Container Numbers",
                      "items": {
                        "description": "Container Number",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "replace_tags": {
                      "description": "If true, any existing tags of the same name will be replaced with the new value(s).  If false, new values will be added to the existing tags.  Default value when not specified depends on the company's setting.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            }
          },
          "required": true
        }
      }
    },
    "/shipments/{bill_of_lading}": {
      "parameters": [
        {
          "in": "path",
          "name": "bill_of_lading",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "parameters": [
          {
            "description": "Bill of Lading",
            "in": "path",
            "name": "bill_of_lading",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "Successful"
          },
          "404": {
            "description": "Shipment not found"
          },
          "429": {
            "description": "Rate Limited"
          }
        },
        "tags": [
          "shipments"
        ],
        "description": "\nRetrieve Shipment\n--\nRetrieve a shipment based on bill of lading\nsupplied as a GET parameter `bill_of_lading`\n\n",
        "operationId": "shipments_read"
      }
    }
  },
