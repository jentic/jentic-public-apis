                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "format": "uri",
                      "nullable": true,
                      "type": "string"
                    },
                    "previous": {
                      "format": "uri",
                      "nullable": true,
                      "type": "string"
                    },
