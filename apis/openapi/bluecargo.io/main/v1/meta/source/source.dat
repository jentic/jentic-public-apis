{"swagger": "2.0", "info": {"title": "BlueCargo", "description": "Public API\n\n\n    Authentication:\n    \tSupply X-Api-Key as the api key as provided by BlueCargo in the header of the request\n\n", "termsOfService": "https://www.google.com/policies/terms/", "contact": {"email": "support@bluecargo.io"}, "version": "v1"}, "host": "api.bluecargo.io", "schemes": ["https"], "basePath": "/v1", "consumes": ["application/json"], "produces": ["application/json"], "securityDefinitions": {"API Key": {"type": "apiKey", "name": "X-Api-Key", "in": "header"}}, "security": [{"API Key": []}], "paths": {"/bookings": {"get": {"operationId": "bookings_list", "description": "", "parameters": [{"name": "page", "in": "query", "description": "A page number within the paginated result set.", "required": false, "type": "integer"}, {"name": "page_size", "in": "query", "description": "Number of results to return per page.", "required": false, "type": "integer"}], "responses": {"200": {"description": "", "schema": {"required": ["count", "results"], "type": "object", "properties": {"count": {"type": "integer"}, "next": {"type": "string", "format": "uri", "x-nullable": true}, "previous": {"type": "string", "format": "uri", "x-nullable": true}, "results": {"type": "array", "items": {"$ref": "#/definitions/BookingCreation"}}}}}}, "tags": ["bookings"]}, "post": {"operationId": "bookings_create", "description": "\nList Shipments\n--\nOutput the list of your shipments\n", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/BookingCreation"}}, {"name": "ordering", "in": "query", "description": "Order By created_at only", "required": false, "type": "string", "example": "-created_at"}], "responses": {"200": {"description": "Successful", "schema": {"$ref": "#/definitions/Booking"}}, "429": {"description": "Rate Limited"}}, "tags": ["bookings"]}, "parameters": []}, "/carriers": {"get": {"operationId": "carriers_list", "description": "\nList Carriers\n--\nOutput the current list of carriers\n", "parameters": [], "responses": {"200": {"description": "Successful", "schema": {"$ref": "#/definitions/Carrier"}}, "429": {"description": "Rate Limited"}}, "tags": ["carriers"]}, "parameters": []}, "/carriers/{name}": {"get": {"operationId": "carriers_read", "description": "\nRetrieve Carriers\n--\nRetrieve a carrier mapping based on an input key.\nSupply a path key with the key of the carrier.\n", "parameters": [{"name": "name", "in": "path", "description": "Shipping Line Name", "required": true, "type": "string"}], "responses": {"200": {"description": "Successful", "schema": {"$ref": "#/definitions/Carrier"}}, "429": {"description": "Rate Limited"}, "404": {"description": "Carrier Not Found"}}, "tags": ["carriers"]}, "parameters": [{"name": "name", "in": "path", "required": true, "type": "string"}]}, "/shipments": {"get": {"operationId": "shipments_list", "description": "\nList Shipments\n--\nOutput the list of your shipments\n", "parameters": [{"name": "page", "in": "query", "description": "A page number within the paginated result set.", "required": false, "type": "integer"}, {"name": "page_size", "in": "query", "description": "Number of results to return per page.", "required": false, "type": "integer"}, {"name": "bill_of_ladings", "in": "query", "description": "Bill of Ladings filter list in JSON format", "required": false, "type": "string", "example": "[\"TEST2340\", \"TEST2341\"]"}, {"name": "tags", "in": "query", "description": "Tags filter list in JSON format - if multiple tag names are provided they are ANDed together,\n    and if multiple tag values are provided they are ORed together.  Using the example, the logic would be that a\n    shipment or container must be tagged with chassis = 'chz1' AND (PO # = 'po1' OR PO # = 'po2') to match the filter", "required": false, "type": "string", "example": "[{\"name\": \"chassis\", \"value\": \"chz1\"}, {\"name\": \"PO #\", \"values\": [\"po1\", \"po2\"]}]"}, {"name": "ordering", "in": "query", "description": "Order By created_at only", "required": false, "type": "string", "example": "-created_at"}], "responses": {"200": {"description": "Successful", "schema": {"$ref": "#/definitions/Shipment"}}, "429": {"description": "Rate Limited"}}, "tags": ["shipments"]}, "post": {"operationId": "shipments_create", "description": "\nCreate Shipment\n--\nCreates shipment(s) based on post parameters\n[\n&nbsp;&nbsp;{\n&nbsp;&nbsp;&nbsp;&nbsp;bill_of_lading_num i.e. `1231231`\n&nbsp;&nbsp;&nbsp;&nbsp;carrier_scac i.e. `MAEU`\n&nbsp;&nbsp;}\n&nbsp;&nbsp;...\n]\n\n", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"type": "array", "items": {"type": "object", "properties": {"carrier_scac": {"description": "Carrier SCAC", "type": "string"}, "bill_of_lading_num": {"description": "Bill of Lading Number", "type": "string"}, "container_numbers": {"description": "Container Numbers", "type": "array", "items": {"description": "Container Number", "type": "string"}}, "tags": {"description": "The 'tags' field can be either a dictionary of key/value pairs or a list of objects.<br>For a dictionary, each key is a tag name, and the tag value is either a string or a list of strings.<br>For a list, each object must have a 'name' field (string) and either a 'value' field (string) or a 'values' field (list of strings). <br><br>Examples:<br><br>Dictionary format:<br>{<br>&nbsp;&nbsp;&nbsp;&nbsp;\"chassis\":&nbsp;\"MyChassis\",<br>&nbsp;&nbsp;&nbsp;&nbsp;\"drayage&nbsp;carrier\":&nbsp;[<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"SCAC1\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"SCAC2\"<br>&nbsp;&nbsp;&nbsp;&nbsp;]<br>}<br><br>List format:<br>[<br>&nbsp;&nbsp;&nbsp;&nbsp;{<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"name\":&nbsp;\"PO&nbsp;#\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"value\":&nbsp;\"MyPurchase&nbsp;Order&nbsp;Number\"<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;{<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"name\":&nbsp;\"warehouse_lot_number\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"values\":&nbsp;[<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"ABC\",<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"XYZ\"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>]", "type": "array", "items": {"description": "Tag Value or Values", "required": ["name"], "type": "object", "properties": {"name": {"description": "Tag Name", "type": "string"}, "value": {"description": "Tag Value", "type": "string", "nullable": true}, "values": {"description": "Tag Values as a List of Strings", "type": "array", "items": {"type": "string"}, "nullable": true}}}}, "replace_tags": {"description": "If true, any existing tags of the same name will be replaced with the new value(s).  If false, new values will be added to the existing tags.  Default value when not specified depends on the company's setting.", "type": "boolean"}}}}}], "responses": {"201": {"description": "Success", "schema": {"$ref": "#/definitions/ShipmentCreation"}}, "429": {"description": "Rate Limited"}}, "tags": ["shipments"]}, "parameters": []}, "/shipments/{bill_of_lading}": {"get": {"operationId": "shipments_read", "description": "\nRetrieve Shipment\n--\nRetrieve a shipment based on bill of lading\nsupplied as a GET parameter `bill_of_lading`\n\n", "parameters": [{"name": "bill_of_lading", "in": "path", "description": "Bill of Lading", "required": true, "type": "string"}], "responses": {"200": {"description": "Successful", "schema": {"$ref": "#/definitions/Shipment"}}, "429": {"description": "Rate Limited"}, "404": {"description": "Shipment not found"}}, "tags": ["shipments"]}, "parameters": [{"name": "bill_of_lading", "in": "path", "required": true, "type": "string"}]}}, "definitions": {"BookingCreation": {"required": ["booking_number", "carrier_scac"], "type": "object", "properties": {"booking_number": {"title": "Booking number", "type": "string"}, "carrier_scac": {"title": "Carrier SCAC", "type": "string"}}, "title": "BookingCreation", "description": "Information returned by the api on booking creation"}, "Booking": {"required": ["booking_number", "carrier_scac"], "type": "object", "properties": {"booking_number": {"title": "Booking number", "type": "string", "maxLength": 255, "minLength": 1}, "carrier_scac": {"title": "Carrier scac", "type": "string", "maxLength": 255, "minLength": 1}}, "title": "Booking", "description": "Information about a booking such as carrier_scac etc."}, "Carrier": {"type": "object", "properties": {"name": {"title": "Shipping Line Name", "type": "string"}, "scacs": {"title": "SCAC list", "type": "string"}}, "title": "Carrier", "description": "A shipping line carrier such as MSC", "required": ["name", "scacs"]}, "Port": {"required": ["name", "port_code"], "type": "object", "properties": {"name": {"title": "Name", "type": "string", "maxLength": 100, "minLength": 1}, "port_code": {"title": "Port code", "type": "string", "maxLength": 6, "minLength": 1}}, "x-nullable": true, "title": "Port", "description": "A port such as port of Long Beach"}, "Terminal": {"required": ["key", "name"], "type": "object", "properties": {"key": {"title": "Key", "type": "string", "maxLength": 50, "minLength": 1}, "name": {"title": "Name", "type": "string", "maxLength": 100, "minLength": 1}}, "x-nullable": true, "title": "Terminal", "description": "A terminal such as Everport"}, "Container": {"required": ["container_number"], "type": "object", "properties": {"container_number": {"title": "Container number", "type": "string", "maxLength": 11, "minLength": 1}, "container_type": {"title": "Container type", "type": "string", "readOnly": true, "x-nullable": true}}, "title": "Container", "description": "A specific container such as a 20st with container number"}, "ContainerEvent": {"required": ["observed", "type", "motive_type"], "type": "object", "properties": {"occurred": {"title": "Occurred", "type": "string", "readOnly": true, "x-nullable": true}, "occurred_date_is_approximate": {"title": "Occurred date is approximate", "type": "boolean", "default": false}, "observed": {"title": "Observed", "type": "string", "format": "date-time"}, "type": {"title": "Type", "type": "string", "minLength": 1}, "motive_type": {"title": "Motive type", "type": "string", "minLength": 1}, "terminal": {"$ref": "#/definitions/Terminal"}, "port": {"$ref": "#/definitions/Port"}, "raw_location": {"title": "Raw location", "type": "string", "x-nullable": true}, "event_location": {"title": "Event location", "type": "string", "x-nullable": true}, "chassis": {"title": "Chassis", "type": "string", "x-nullable": true}, "vessel_name": {"title": "Vessel name", "type": "string", "x-nullable": true}, "voyage": {"title": "Voyage", "type": "string", "x-nullable": true}, "bill_of_lading": {"title": "Bill of lading", "type": "string", "x-nullable": true}, "timezone": {"title": "Timezone", "type": "string", "readOnly": true, "x-nullable": true}}, "x-nullable": true, "title": "ContainerEvent", "description": "A container event which describes some event happinging for the container\n\n                            Such as gated in or gated out"}, "PickupAvailability": {"type": "object", "properties": {"is_available_for_pickup": {"title": "Is available for pickup", "type": "boolean", "readOnly": true}, "pickup_dates": {"title": "Pickup dates", "type": "string", "readOnly": true}, "customs_hold": {"title": "Customs hold", "type": "string", "readOnly": true}, "freight_hold": {"title": "Freight hold", "type": "string", "readOnly": true}, "line_hold": {"title": "Line hold", "type": "string", "readOnly": true}, "tmf_hold": {"title": "Tmf hold", "type": "string", "readOnly": true}, "ctf_hold": {"title": "Ctf hold", "type": "string", "readOnly": true}, "terminal_hold": {"title": "Terminal hold", "type": "string", "readOnly": true}, "other_hold": {"title": "Other hold", "type": "string", "readOnly": true}, "yard_location": {"title": "Yard location", "type": "string", "readOnly": true}, "pickup_appointment": {"title": "Pickup appointment", "type": "string", "readOnly": true}, "demurrage_period": {"title": "Demurrage period", "type": "string", "readOnly": true}}, "x-nullable": true, "title": "Pickup Availability", "description": "Information around the pickup availability of a container"}, "Tag": {"required": ["name", "values"], "type": "object", "properties": {"name": {"title": "Name", "type": "string", "minLength": 1}, "values": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "ContainerTransaction": {"required": ["container", "carrier"], "type": "object", "properties": {"container": {"$ref": "#/definitions/Container"}, "carrier": {"$ref": "#/definitions/Carrier"}, "gated_out_origin_port": {"$ref": "#/definitions/ContainerEvent"}, "gated_in_origin_port": {"$ref": "#/definitions/ContainerEvent"}, "loaded": {"$ref": "#/definitions/ContainerEvent"}, "vessel_departed": {"$ref": "#/definitions/ContainerEvent"}, "vessel_arrived": {"$ref": "#/definitions/ContainerEvent"}, "discharged": {"$ref": "#/definitions/ContainerEvent"}, "gated_out": {"$ref": "#/definitions/ContainerEvent"}, "rail_loaded": {"$ref": "#/definitions/ContainerEvent"}, "rail_departed": {"$ref": "#/definitions/ContainerEvent"}, "rail_unloaded": {"$ref": "#/definitions/ContainerEvent"}, "rail_arrived_at_facility": {"$ref": "#/definitions/ContainerEvent"}, "rail_outgated_full": {"$ref": "#/definitions/ContainerEvent"}, "rail_empty_return": {"$ref": "#/definitions/ContainerEvent"}, "gated_in": {"$ref": "#/definitions/ContainerEvent"}, "pickup_info": {"$ref": "#/definitions/PickupAvailability"}, "tags": {"type": "array", "items": {"$ref": "#/definitions/Tag"}, "readOnly": true}}, "title": "Container Transaction", "description": "Similar to container event for a specific event such as gated out."}, "Shipment": {"required": ["bill_of_lading_number", "carrier_scac", "carrier"], "type": "object", "properties": {"bill_of_lading_number": {"title": "Bill of lading number", "type": "string", "maxLength": 255, "minLength": 1}, "carrier_scac": {"title": "Carrier scac", "type": "string", "maxLength": 5, "minLength": 1}, "carrier": {"$ref": "#/definitions/Carrier"}, "port_of_loading": {"$ref": "#/definitions/Port"}, "port_of_loading_raw": {"title": "Port of loading raw", "type": "string", "x-nullable": true}, "terminal_of_loading": {"$ref": "#/definitions/Terminal"}, "terminal_of_loading_raw": {"title": "Terminal of loading raw", "type": "string", "x-nullable": true}, "terminal_of_loading_firm_code": {"title": "Terminal of loading firm code", "type": "string", "x-nullable": true}, "port_of_destination": {"$ref": "#/definitions/Port"}, "port_of_destination_raw": {"title": "Port of destination raw", "type": "string", "x-nullable": true}, "terminal_of_destination": {"$ref": "#/definitions/Terminal"}, "terminal_of_destination_raw": {"title": "Terminal of destination raw", "type": "string", "x-nullable": true}, "terminal_of_destination_firm_code": {"title": "Terminal of destination firm code", "type": "string", "x-nullable": true}, "estimated_departure_date": {"title": "Estimated departure date", "type": "string", "format": "date-time", "x-nullable": true}, "actual_departure_date": {"title": "Actual departure date", "type": "string", "format": "date-time", "x-nullable": true}, "estimated_arrival_date": {"title": "Estimated arrival date", "type": "string", "format": "date-time", "x-nullable": true}, "actual_arrival_date": {"title": "Actual arrival date", "type": "string", "format": "date-time", "x-nullable": true}, "origin_raw": {"title": "Origin raw", "type": "string", "x-nullable": true}, "final_destination_raw": {"title": "Final destination raw", "type": "string", "x-nullable": true}, "containers": {"type": "array", "items": {"$ref": "#/definitions/ContainerTransaction"}, "readOnly": true}}, "title": "Shipment", "description": "Information about a shipment such as carrier bill_of_lading_number etc."}, "ShipmentCreation": {"required": ["bill_of_lading_number", "no_capacity_bill_of_lading"], "type": "object", "properties": {"bill_of_lading_number": {"title": "Bill of lading", "type": "string"}, "no_capacity_bill_of_lading": {"title": "shipments not created", "type": "string"}}, "title": "ShipmentCreation", "description": "Information returned by the api on shipment creation"}}}