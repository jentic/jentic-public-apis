{
  "openapi": "3.1.0",
  "info": {
    "title": "FileRun API",
    "description": "FileRun file management API. Provides endpoints for file operations, user management, and sharing.\n\n## Authentication\nThe FileRun API uses OAuth 2.0 for authentication. Obtain an access token via the authorization code flow (web apps) or the resource owner credentials/password flow (installed apps), then include it as a Bearer token in the `Authorization` header.\n\n## Scopes\nAccess tokens are limited to the scopes requested during authorization:\n`profile`, `email`, `list`, `upload`, `download`, `delete`, `modify`, `metadata`, `share`, `weblink`, `admin`\n\n## Response Format\nSuccessful responses include `\"success\": true`. Failed responses include `\"success\": false` and a `\"msg\"` array with error details.\n\n## Demo Server\nUse the demo server with username `admin` and password `admin`.\n",
    "version": "2026.1.0",
    "contact": {
      "name": "FileRun",
      "url": "https://filerun.com"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/filerun/api/2026.1.0"
  },
  "servers": [
    {
      "url": "https://{host}",
      "description": "Your FileRun installation",
      "variables": {
        "host": {
          "default": "demo.filerun.com",
          "description": "Hostname of your FileRun installation"
        }
      }
    },
    {
      "url": "https://amsterdam.demo.filerun.com",
      "description": "FileRun Demo Installation"
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth2/authorize/",
            "tokenUrl": "/oauth2/token/",
            "scopes": {
              "profile": "Access user profile information",
              "email": "Access user email address",
              "list": "List files and folders",
              "upload": "Upload files and create folders",
              "download": "Download files and thumbnails",
              "delete": "Delete files and folders",
              "modify": "Rename, star, and extract files",
              "metadata": "Access file metadata",
              "share": "Share and unshare files with users",
              "weblink": "Create and remove web links",
              "admin": "Manage user accounts"
            }
          },
          "password": {
            "tokenUrl": "/oauth2/token/",
            "scopes": {
              "profile": "Access user profile information",
              "email": "Access user email address",
              "list": "List files and folders",
              "upload": "Upload files and create folders",
              "download": "Download files and thumbnails",
              "delete": "Delete files and folders",
              "modify": "Rename, star, and extract files",
              "metadata": "Access file metadata",
              "share": "Share and unshare files with users",
              "weblink": "Create and remove web links",
              "admin": "Manage user accounts"
            }
          }
        }
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "msg": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": "string"
          }
        }
      },
      "FileItem": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "is_dir": {
            "type": "boolean"
          },
          "uuid": {
            "type": "string"
          },
          "mdate": {
            "type": "string"
          },
          "mdateHuman": {
            "type": "string"
          },
          "cdate": {
            "type": "string"
          },
          "hasWebLink": {
            "type": "boolean"
          },
          "weblink": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ext": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "hasThumb": {
            "type": "boolean"
          },
          "fileSize": {
            "type": "integer"
          },
          "nicerFileSize": {
            "type": "string"
          },
          "commentsCount": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "isLocked": {
            "type": "boolean"
          },
          "version": {
            "type": "integer"
          },
          "isShared": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rating": {
            "type": "integer",
            "nullable": true
          },
          "metadataFileType": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "BrowseMeta": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "parentPath": {
            "type": "string"
          },
          "folderName": {
            "type": "string"
          }
        }
      },
      "BrowseResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "meta": {
                "$ref": "#/components/schemas/BrowseMeta"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FileItem"
                }
              }
            }
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "puid": {
            "type": "string"
          },
          "activated": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "name2": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "WeblinkResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "updated"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "UnweblinkResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "weblinkid": {
            "type": "string"
          }
        }
      },
      "AddUserResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "generated_password": {
                "type": "string"
              },
              "uid": {
                "type": "string"
              }
            }
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          },
          "refresh_token": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/oauth2/authorize/": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authorization endpoint (authorization code flow)",
        "description": "Redirect users here to authorize your application. After consent, the user is redirected back with an authorization code.",
        "security": [],
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Space-delimited set of scopes."
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Anti-CSRF state parameter, returned unchanged in the redirect."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to redirect_uri with authorization code or error."
          }
        }
      }
    },
    "/oauth2/token/": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Token endpoint",
        "description": "Exchange an authorization code, user credentials, or refresh token for an access token.\n- Authorization code flow: `grant_type=authorization_code`\n- Password flow: `grant_type=password`\n- Refresh token flow: `grant_type=refresh_token`\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code",
                      "password",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "code": {
                    "type": "string",
                    "description": "Required for authorization_code grant."
                  },
                  "username": {
                    "type": "string",
                    "description": "Required for password grant."
                  },
                  "password": {
                    "type": "string",
                    "description": "Required for password grant."
                  },
                  "scope": {
                    "type": "string",
                    "description": "Required for password grant. Space-delimited scopes."
                  },
                  "refresh_token": {
                    "type": "string",
                    "description": "Required for refresh_token grant."
                  }
                },
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or credentials."
          }
        }
      }
    },
    "/api.php/Core/account/info": {
      "get": {
        "tags": [
          "User Account"
        ],
        "summary": "Get current user account information",
        "description": "Returns profile information for the authenticated user. Include the `email` scope to receive the email address.",
        "security": [
          {
            "oauth2": [
              "profile"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User account information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/browse": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "List files and folders",
        "description": "Retrieve a listing of files and/or folders at the given path.\n\nSpecial paths:\n- `/ROOT` or `/` — top-level items (My Files, Shared, Starred, etc.)\n- `/ROOT/HOME` — user's home folder\n- `/ROOT/STARRED` — starred items\n- `/ROOT/Media/Photos/Latest` — latest photos\n- `/ROOT/Media/Audio/LatestUploads` — latest audio\n- `/ROOT/Shares/WithUsers` — items shared with users\n- `/ROOT/Shares/WithLinks` — items shared via web links\n",
        "security": [
          {
            "oauth2": [
              "list"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The FileRun path to browse."
          },
          {
            "name": "itemType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "files",
                "folders"
              ]
            },
            "description": "Type of items to list."
          },
          {
            "name": "recursive",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "List items from all subfolders."
          },
          {
            "name": "details[]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "uuid",
                  "mdate",
                  "mdateHuman",
                  "cdate",
                  "hasWebLink",
                  "weblink",
                  "weblink-full",
                  "description",
                  "ext",
                  "type",
                  "icon",
                  "hasThumb",
                  "fileSize",
                  "nicerFileSize",
                  "commentsCount",
                  "label",
                  "isLocked",
                  "version",
                  "isShared",
                  "color",
                  "tags",
                  "rating",
                  "metadataFileType"
                ]
              }
            },
            "description": "Detail fields to include for each item."
          }
        ],
        "responses": {
          "200": {
            "description": "List of files and folders.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/search": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Search files and folders",
        "description": "Search for files and folders by filename, metadata, or file contents.",
        "security": [
          {
            "oauth2": [
              "list"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The path to search within (e.g. `/ROOT/HOME`)."
                  },
                  "filename": {
                    "type": "string",
                    "description": "Filename keyword to search for."
                  },
                  "metatype": {
                    "type": "integer",
                    "description": "ID of metadata file type."
                  },
                  "contents": {
                    "type": "string",
                    "description": "Keyword to search file contents. Cannot be combined with other criteria."
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/upload": {
      "put": {
        "tags": [
          "Files"
        ],
        "summary": "Upload a file",
        "description": "Upload a file using HTTP PUT with the file content as the request body.\nSupports resumable uploads via `startByte` and `getOffset` parameters.\n",
        "security": [
          {
            "oauth2": [
              "upload"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The FileRun path of the target folder (must exist)."
          },
          {
            "name": "filePath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Subpath and file name (intermediate folders are created automatically)."
          },
          {
            "name": "totalSize",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Total size of the file in bytes."
          },
          {
            "name": "startByte",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Byte offset for resuming an interrupted upload."
          },
          {
            "name": "getOffset",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Set to get info about an existing partial upload. If response `offset` is non-zero, resume from that byte."
          },
          {
            "name": "lastModified",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Unix timestamp of the file's last modification date."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/download": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download a file",
        "description": "Download a file by its FileRun path.",
        "security": [
          {
            "oauth2": [
              "download"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The FileRun path of the file."
          }
        ],
        "responses": {
          "200": {
            "description": "File content.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/thumbnail": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download a file thumbnail",
        "description": "Download a thumbnail image for the specified file.",
        "security": [
          {
            "oauth2": [
              "download"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The FileRun path of the file."
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image.",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/createfolder": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Create a folder",
        "description": "Create a new folder at the specified path.",
        "security": [
          {
            "oauth2": [
              "upload"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "FileRun path of the new folder's parent."
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the new folder."
                  }
                },
                "required": [
                  "path",
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/delete": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Delete a file or folder",
        "description": "Delete a file or folder. By default moves to trash; set `permanent` to delete permanently.",
        "security": [
          {
            "oauth2": [
              "delete"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the target file or folder."
                  },
                  "permanent": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to permanently delete instead of moving to trash."
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deletion result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/rename": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Rename a file or folder",
        "security": [
          {
            "oauth2": [
              "modify"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the file or folder."
                  },
                  "newName": {
                    "type": "string",
                    "description": "The new name."
                  }
                },
                "required": [
                  "path",
                  "newName"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rename result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/move": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Move a file or folder",
        "security": [
          {
            "oauth2": [
              "download",
              "upload"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the file or folder to move."
                  },
                  "moveTo": {
                    "type": "string",
                    "description": "The FileRun path of the destination folder."
                  }
                },
                "required": [
                  "path",
                  "moveTo"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/extract": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Extract an archive",
        "description": "Extract a ZIP or other archive file to the specified destination.",
        "security": [
          {
            "oauth2": [
              "modify"
            ]
          },
          {
            "bearerAuth": []
