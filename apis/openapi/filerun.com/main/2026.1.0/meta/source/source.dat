                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the archive file."
                  },
                  "extractTo": {
                    "type": "string",
                    "description": "The FileRun path of the destination folder."
                  }
                },
                "required": [
                  "path",
                  "extractTo"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction result.",
