    "/api.php/Drive/files/share": {
      "post": {
        "tags": [
          "Sharing"
        ],
        "summary": "Share a file or folder",
        "description": "Share a file or folder with a user, group, or guest email. If already shared, the settings are updated.",
        "security": [
          {
            "oauth2": [
              "share"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the file or folder."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "viewer",
                      "commenter",
                      "uploader",
                      "editor",
                      "contributor",
                      "manager"
                    ],
                    "description": "Permission role to grant."
                  },
                  "puid": {
                    "type": "string",
                    "description": "Public ID of a FileRun user. Required if no `gid` or `email`."
                  },
                  "gid": {
                    "type": "integer",
                    "description": "ID of a FileRun group. Required if no `puid` or `email`."
                  },
                  "email": {
                    "type": "string",
                    "description": "Email address of a guest user. Required if no `puid` or `gid`."
                  },
                  "notify": {
                    "type": "boolean",
                    "description": "Send email notification."
                  },
                  "message": {
                    "type": "string",
                    "description": "Message to include in the notification email."
                  }
                },
                "required": [
                  "path",
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Share result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/unshare": {
      "post": {
        "tags": [
          "Sharing"
        ],
        "summary": "Unshare a file or folder",
        "description": "Remove a user or group from a file or folder share.",
        "security": [
          {
            "oauth2": [
              "share"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the file or folder."
                  },
                  "puid": {
                    "type": "string",
                    "description": "Public ID of the user to remove. Required if no `gid`."
                  },
                  "gid": {
                    "type": "integer",
                    "description": "ID of the group to remove. Required if no `puid`."
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unshare result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/weblink": {
      "post": {
        "tags": [
          "Sharing"
        ],
        "summary": "Create or update a web link",
        "description": "Create a public web link for a file or folder. If a link already exists, it is updated.",
        "security": [
          {
            "oauth2": [
              "weblink"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the target file or folder."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "viewer",
                      "commenter",
                      "editor",
                      "uploader"
                    ],
                    "description": "Permission role for the web link."
                  },
                  "password": {
                    "type": "string",
                    "description": "Password to protect the link."
                  },
                  "expiry": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Expiration date in MySQL datetime format (Y-m-d H:i:s)."
                  },
                  "download_limit": {
                    "type": "integer",
                    "description": "Maximum number of downloads."
                  },
                  "download_terms": {
                    "type": "string",
                    "description": "Terms that must be accepted before downloading."
                  },
                  "require_login": {
                    "type": "boolean",
                    "description": "Only logged-in FileRun users can access the link."
                  }
                },
                "required": [
                  "path",
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Web link created or updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeblinkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Drive/files/unweblink": {
      "post": {
        "tags": [
          "Sharing"
        ],
        "summary": "Remove a web link",
        "description": "Remove the public web link from a file or folder.",
        "security": [
          {
            "oauth2": [
              "weblink"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The FileRun path of the target file or folder."
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Web link removed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnweblinkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Core/!admin/users/info": {
      "post": {
        "tags": [
          "Admin - Users"
        ],
        "summary": "Get user account information",
        "description": "Retrieve details of a FileRun user account by ID or username.",
        "security": [
          {
            "oauth2": [
              "admin"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "UID": {
                    "type": "integer",
                    "description": "User ID. Required if `uname` not provided."
                  },
                  "uname": {
                    "type": "string",
                    "description": "Username. Required if `UID` not provided."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User account information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Core/!admin/users/add": {
      "post": {
        "tags": [
          "Admin - Users"
        ],
        "summary": "Add a user account",
        "description": "Create a new FileRun user account with the specified profile data, permissions, and group memberships.",
        "security": [
          {
            "oauth2": [
              "admin"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "data[username]": {
                    "type": "string",
                    "description": "Username. May contain underscores, dashes, @, dots, and spaces."
                  },
                  "data[name]": {
                    "type": "string",
                    "description": "First name."
                  },
                  "data[last_name]": {
                    "type": "string"
                  },
                  "data[password]": {
                    "type": "string"
                  },
                  "generate_password": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to auto-generate a password."
                  },
                  "data[two_step_enabled]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "data[owner]": {
                    "type": "integer",
                    "nullable": true,
                    "description": "ID of the parent independent admin user."
                  },
                  "data[activated]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "data[expiration_date]": {
                    "type": "string",
                    "description": "MySQL datetime (e.g. 2024-01-31 00:00:00)."
                  },
                  "data[require_password_change]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "data[email]": {
                    "type": "string"
                  },
                  "data[receive_notifications]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "data[phone]": {
                    "type": "string"
                  },
                  "data[company]": {
                    "type": "string"
                  },
                  "data[website]": {
                    "type": "string"
                  },
                  "data[description]": {
                    "type": "string"
                  },
                  "data[logo_url]": {
                    "type": "string"
                  },
                  "perms[role]": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Role ID. If set, homefolder is auto-configured."
                  },
                  "perms[admin_type]": {
                    "type": "string",
                    "enum": [
                      "simple",
                      "indep"
                    ],
                    "nullable": true
                  },
                  "perms[admin_users]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[admin_roles]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[admin_notifications]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[admin_logs]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[admin_metadata]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[admin_over]": {
                    "type": "string",
                    "description": "Set to \"-ALL-\" for admin over all users."
                  },
                  "perms[admin_max_users]": {
                    "type": "integer"
                  },
                  "perms[admin_homefolder_template]": {
                    "type": "string"
                  },
                  "perms[homefolder]": {
                    "type": "string",
                    "description": "Absolute server path to the user's home folder. Use forward slashes."
                  },
                  "create_home_folder": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to create the home folder if it doesn't exist."
                  },
                  "perms[space_quota_max]": {
                    "type": "integer"
                  },
                  "perms[readonly]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "perms[upload]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[upload_max_size]": {
                    "type": "integer"
                  },
                  "perms[upload_limit_types]": {
                    "type": "string",
                    "description": "Comma-delimited list of allowed file extensions."
                  },
                  "perms[download]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[download_folders]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[read_comments]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[write_comments]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[email]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[weblink]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[share]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[share_guests]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[metadata]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[file_history]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[users_may_see]": {
                    "type": "string",
                    "default": "-ALL-"
                  },
                  "perms[change_pass]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "perms[edit_profile]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of group names. Non-existing groups are created automatically."
                  }
                },
                "required": [
                  "data[username]",
                  "data[name]"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error (e.g. username already in use).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Core/!admin/users/edit": {
      "post": {
        "tags": [
          "Admin - Users"
        ],
        "summary": "Modify a user account",
        "description": "Update an existing FileRun user account. Accepts the same parameters as the add endpoint, plus `UID` to identify the user.\nSet `notify=1` to email the user their updated credentials.\n",
        "security": [
          {
            "oauth2": [
              "admin"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "UID": {
                    "type": "integer",
                    "description": "The user ID to modify."
                  },
                  "generate_password": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to generate a new random password."
                  },
                  "notify": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to email the user their new credentials."
                  },
                  "data[username]": {
                    "type": "string"
                  },
                  "data[name]": {
                    "type": "string"
                  },
                  "data[last_name]": {
                    "type": "string"
                  },
                  "data[password]": {
                    "type": "string"
                  },
                  "data[email]": {
                    "type": "string"
                  },
                  "data[activated]": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                },
                "required": [
                  "UID"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api.php/Core/!admin/users/delete": {
      "post": {
        "tags": [
          "Admin - Users"
        ],
        "summary": "Delete user accounts",
        "description": "Delete one or more FileRun user accounts. Optionally delete their home folders.",
        "security": [
          {
            "oauth2": [
              "admin"
            ]
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "UIDS": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Array of user IDs to delete."
                  },
                  "deleteHomeFolder": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Set to 1 to also delete the users' home folders."
                  }
                },
                "required": [
                  "UIDS"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Users deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "OAuth 2.0 authorization and token endpoints"
    },
    {
      "name": "User Account",
      "description": "Current user account information"
    },
    {
      "name": "Files",
      "description": "File and folder operations (browse, upload, download, manage)"
    },
    {
      "name": "Sharing",
      "description": "Share files with users, groups, and via public web links"
    },
    {
      "name": "Admin - Users",
      "description": "Administrative user account management (requires admin scope)"
    }
  ]
}
