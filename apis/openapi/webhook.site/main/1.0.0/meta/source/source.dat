{
  "openapi": "3.0.3",
  "info": {
    "title": "WoodWing Customer API",
    "version": "1.0.0",
    "description": "API for submitting XML documents to be processed asynchronously.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SWAGGER_166/woodwing-customer-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://webhook.site/eb4d5791-3e94-4712-8f2b-a342c6cd9d85/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/sitecore/xml": {
      "post": {
        "summary": "Submit XML document for processing",
        "description": "Accepts an XML payload, queues it for processing, and returns a job ID.\n",
        "operationId": "submitSitecoreXml",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "string",
                "description": "Raw XML document containing the Sitecore payload."
              },
              "example": "<SitecoreJob>\n  <Id>12345</Id>\n  <Action>Publish</Action>\n  <Item>\n    <Id>{110D559F-DEA5-42EA-9C1C-8A5DF7E70EF9}</Id>\n    <Path>/sitecore/content/Home</Path>\n    <Language>en</Language>\n    <Version>1</Version>\n  </Item>\n</SitecoreJob>\n"
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted and queued for processing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string",
                      "example": "xyzy"
                    }
                  }
                },
                "examples": {
                  "accepted": {
                    "summary": "Job accepted",
                    "value": {
                      "jobId": "xyzy"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized – API key missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    },
                    "code": {
                      "type": "string",
                      "example": "INVALID_API_KEY"
                    }
                  }
                },
                "examples": {
                  "missingApiKey": {
                    "summary": "Missing API key",
                    "value": {
                      "message": "Unauthorized",
                      "code": "MISSING_API_KEY"
                    }
                  },
                  "invalidApiKey": {
                    "summary": "Invalid API key",
                    "value": {
                      "message": "Unauthorized",
                      "code": "INVALID_API_KEY"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – authenticated, but not allowed to access this resource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Forbidden"
                    },
                    "code": {
                      "type": "string",
                      "example": "INSUFFICIENT_PERMISSIONS"
                    }
                  }
                },
                "examples": {
                  "forbidden": {
                    "summary": "Insufficient permissions",
                    "value": {
                      "message": "Forbidden",
                      "code": "INSUFFICIENT_PERMISSIONS"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests — throttled by API Gateway.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Too Many Requests"
                    },
                    "code": {
                      "type": "string",
                      "example": "THROTTLED"
                    }
                  }
                },
                "examples": {
                  "throttled": {
                    "summary": "Request throttled",
                    "value": {
                      "message": "Too Many Requests",
                      "code": "THROTTLED"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable due to throttling.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Service Unavailable"
                    },
                    "code": {
                      "type": "string",
                      "example": "SERVICE_UNAVAILABLE"
                    }
                  }
                },
                "examples": {
                  "unavailable": {
                    "summary": "Service unavailable",
                    "value": {
                      "message": "Service Unavailable",
                      "code": "SERVICE_UNAVAILABLE"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
