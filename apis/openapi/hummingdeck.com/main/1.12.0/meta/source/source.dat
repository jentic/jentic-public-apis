    "/rooms/{roomId}/action-plan/tasks": {
      "post": {
        "summary": "Add a task",
        "description": "Requires a workspace API token; Zapier OAuth credentials are rejected. assignee is null, a side on its own for the party that owns the task, or a side with an email for a named person. The party form is usually the right one: whoever drafts a task like signing an NDA rarely knows who signs on the other side. An internal task cannot be owned by the recipient side.",
        "operationId": "createRoomActionPlanTask",
        "x-required-api-key-scope": "plan:write",
        "security": [
          {
            "apiToken": []
          }
        ],
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "examples": {
                "company": {
                  "summary": "Owned by the recipient company",
                  "value": {
                    "title": "Sign the NDA",
                    "assignee": {
                      "side": "buyer"
                    },
                    "dueDate": "2026-10-02"
                  }
                },
                "person": {
                  "summary": "Owned by a named person",
                  "value": {
                    "title": "Security review",
                    "assignee": {
                      "side": "buyer",
                      "email": "sarah@acme.example",
                      "displayName": "Sarah Chen"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionPlanTask"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, task ownership/visibility combination, or an unknown field",
