    "/decks": {
      "get": {
        "summary": "Search documents",
        "description": "Search documents by title within the authenticated team.",
        "operationId": "searchDocuments",
        "x-required-api-key-scope": "documents:read",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Title to search for (case-insensitive, partial match)"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Upload a document",
        "description": "Upload a new document to the team's library.",
        "operationId": "uploadDocument",
        "x-required-api-key-scope": "documents:write",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Document file (PDF, PPTX, DOCX, HTML). Maximum 30 MB per API upload."
                  },
                  "title": {
                    "type": "string",
                    "description": "Document title"
                  }
                },
                "required": [
                  "file",
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedDocument"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or missing title"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "A required API-key scope is missing, or the plan limit is reached (PLAN_LIMIT_REACHED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/decks/{deckId}/replace": {
      "post": {
        "summary": "Replace a document file",
        "description": "Replace an existing document in the authenticated workspace. Only a manually issued workspace API key with documents:write is accepted; Zapier OAuth credentials are rejected. Send only a local file in multipart/form-data. The new file must have the same file type as the current document, and the document must not have an active Proposal link. Existing document ID, title, delivery mode, Share Links, Room placements, access settings and analytics history are retained. Previewable replacements return processingStatus=pending while processing continues; check processingStatus before relying on the new preview. Download-only PDF and ZIP replacements return processingStatus=completed. Previewable HTML ZIP bundles require the workspace's ZIP-preview entitlement. The file limit is 30 MiB (31,457,280 bytes); the complete multipart request limit is 31 MiB (32,505,856 bytes). A repeated POST starts a new replacement. If the response is lost, inspect the current document or share view, or contact support before retrying.",
        "operationId": "replaceDocument",
        "x-required-api-key-scope": "documents:write",
        "security": [
          {
            "apiToken": []
          }
        ],
        "parameters": [
          {
            "name": "deckId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the document to replace"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Local replacement file. Must have the same file type as the existing document and a matching filename extension (.pdf, .pptx, .docx, .xlsx, .xls, .html/.htm, or .zip); maximum 30 MiB."
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replacement published. Previewable files continue processing; download-only files are completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedDocument"
                }
              }
            }
          },
          "400": {
            "description": "Invalid document ID or multipart body (VALIDATION_ERROR), unsupported file or missing/mismatched filename extension (INVALID_FORMAT), unreadable file (FILE_READ_ERROR), or replacement file type differs from the current file (TYPE_MISMATCH).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Zapier OAuth is not accepted (CREDENTIAL_NOT_ALLOWED), the API key lacks documents:write (INSUFFICIENT_SCOPE), or the workspace cannot replace a previewable HTML ZIP bundle (PLAN_LIMIT_REACHED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document does not exist, is deleted, or does not belong to the authenticated workspace (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "An active Proposal link blocks replacement (PROPOSAL_LOCKED). A missing source, concurrent document change, or Proposal activated during publication returns REPLACEMENT_CONFLICT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/decisions": {
      "get": {
        "summary": "List recent proposal decisions",
        "description": "Returns the most recent accept/decline decisions on the authenticated workspace's documents. Polling fallback for the \"Decision Made\" trigger.",
        "operationId": "listDecisions",
        "x-required-api-key-scope": "analytics:read",
        "responses": {
          "200": {
            "description": "Recent decisions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Decision"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, revoked, or de-entitled credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/emails": {
      "get": {
        "summary": "List recent email captures",
        "description": "Returns the most recent email-gate captures on the authenticated workspace's content. Polling fallback for the \"Email Captured\" trigger.",
        "operationId": "listEmailCaptures",
        "x-required-api-key-scope": "analytics:read",
        "responses": {
          "200": {
            "description": "Recent email captures",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EmailCapture"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, revoked, or de-entitled credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/companies": {
      "get": {
        "summary": "Find companies",
        "description": "Find up to 10 companies by exact case-insensitive name, normalized domain, or both. At least one query parameter is required.",
        "operationId": "searchCompanies",
        "x-required-api-key-scope": "crm:read",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Exact company name (case-insensitive)"
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Exact company domain"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching companies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Company"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Neither name nor domain was supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Find or create a company",
        "description": "Returns an existing company matched only by exact case-insensitive name, or creates it. A supplied domain enriches the record but never selects a company. The created flag reports the outcome.",
        "operationId": "findOrCreateCompany",
        "x-required-api-key-scope": "crm:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "domain": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "Optional enrichment domain. Never used to match an existing company."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing company returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "company": {
                      "$ref": "#/components/schemas/Company"
                    },
                    "created": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "company",
                    "created"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Company created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "company": {
                      "$ref": "#/components/schemas/Company"
                    },
                    "created": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "company",
                    "created"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "summary": "Search contacts",
        "description": "Search contacts by email within the authenticated team.",
        "operationId": "searchContacts",
        "x-required-api-key-scope": "crm:read",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Email to search for (case-insensitive)"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Find or create a contact",
        "description": "Finds a contact by case-insensitive email or creates it. Supply either a full name or firstName/lastName. An optional companyId associates an existing company; companyName finds or creates the company first.",
        "operationId": "findOrCreateContact",
        "x-required-api-key-scope": "crm:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 201,
                    "description": "Full name. Mutually exclusive with firstName/lastName."
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "lastName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100
                  },
                  "companyId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid",
                    "description": "Existing company in this workspace. Mutually exclusive with companyName."
                  },
                  "companyName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "Company to find or create. Mutually exclusive with companyId."
                  },
                  "companyDomain": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "Optional enrichment domain when companyName is supplied. Never used to match an existing company."
                  }
                },
                "required": [
                  "email"
                ],
                "anyOf": [
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "firstName"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing contact returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contact": {
                      "$ref": "#/components/schemas/Contact"
                    },
                    "created": {
                      "type": "boolean",
                      "const": false
                    },
                    "company": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Company"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "companyCreated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "contact",
                    "created",
                    "company",
                    "companyCreated"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Contact created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contact": {
                      "$ref": "#/components/schemas/Contact"
                    },
                    "created": {
                      "type": "boolean",
                      "const": true
                    },
                    "company": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Company"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "companyCreated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "contact",
                    "created",
                    "company",
                    "companyCreated"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "404": {
            "description": "Supplied company ID was not found in the authenticated workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Existing contact belongs to a different company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  }
}
