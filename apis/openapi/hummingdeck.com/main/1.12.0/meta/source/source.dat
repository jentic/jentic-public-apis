            "type": "boolean"
          },
          "notifySlack": {
            "type": "boolean"
          },
          "allowedEmails": {
            "type": "array",
            "description": "verified-allowlist links only. Returned only when the API key has crm:read; empty otherwise. Sorted by email.",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "email",
                "name"
              ]
            }
          },
          "allowedDomains": {
            "type": "array",
            "description": "verified-allowlist links only. Returned only when the API key has crm:read; empty otherwise.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "url",
          "accessMode",
          "requireEmail",
          "label",
          "isActive",
          "expiresAt",
          "allowDownloads",
          "notifyOnView",
          "notifySlack",
          "allowedEmails",
          "allowedDomains"
        ]
      },
      "CreatedRoom": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "primaryLink": {
            "$ref": "#/components/schemas/PrimaryRoomLink"
          },
          "contactCreated": {
            "type": "boolean"
          },
          "companyCreated": {
            "type": "boolean"
          }
        },
        "required": [
          "room",
          "primaryLink",
          "contactCreated",
          "companyCreated"
        ]
      },
      "AllowedEmail": {
        "description": "An address, or an address with the person's name.",
        "oneOf": [
          {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 255
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 255
              }
            },
            "required": [
              "email"
            ],
            "additionalProperties": false
          }
        ]
      },
      "PrimaryLinkRequest": {
        "type": "object",
        "description": "Settings for the room's first audience link. Options that apply to one access mode only are refused with the others.",
        "properties": {
          "accessMode": {
            "type": "string",
            "enum": [
              "open",
              "verify-any",
              "verified-allowlist"
            ],
            "default": "open",
            "description": "open: anyone with the URL. verify-any: visitors confirm their email address with a one-time link before entering. verified-allowlist (Restricted): only allowedEmails and allowedDomains can enter, each confirming their address with a one-time link. verify-any and verified-allowlist need Pro or Business."
          },
          "requireEmail": {
            "type": "boolean",
            "description": "open links only: ask visitors for their email before they enter (Pro and Business)."
          },
          "allowedEmails": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/AllowedEmail"
            },
            "description": "verified-allowlist only. Each address becomes a contact. The API adds nobody on its own: include your own address if you want to preview the room."
          },
          "allowedDomains": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 253
            },
            "description": "verified-allowlist only. Anyone with an address at one of these domains can enter. \"@acme.com\", \"acme.com\", and \"https://acme.com\" all mean acme.com. Free email providers such as gmail.com are refused."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "description": "verified-allowlist only. Your internal name for the link."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the link stops working. Must be in the future (Starter and above)."
          },
          "allowDownloads": {
            "type": "boolean",
            "description": "Whether viewers can download the room's documents; also the room's default for later links. Omitted, downloads are off on plans with download control (Starter and above) and on otherwise. false on a plan without download control is refused."
          },
          "notifyOnView": {
            "type": "boolean",
            "default": true
          },
          "notifySlack": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "requireEmail"
              ],
              "properties": {
                "requireEmail": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "accessMode": {
                  "const": "open"
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "allowedEmails"
                  ],
                  "properties": {
                    "allowedEmails": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "allowedDomains"
                  ],
                  "properties": {
                    "allowedDomains": {
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            "then": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "then": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "allowedEmails"
                  ],
                  "properties": {
                    "allowedEmails": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "allowedDomains"
                  ],
                  "properties": {
                    "allowedDomains": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "CreateRoomLinkRequest": {
        "type": "object",
        "description": "A room's second and later audience links: the same access-mode fields as primaryLink on POST /rooms, plus the recipient/company fields POST /shares and POST /rooms already accept. Supply at least one of recipientName, recipientEmail, contactId, companyId, or companyName.",
        "properties": {
          "accessMode": {
            "type": "string",
            "enum": [
              "open",
              "verify-any",
              "verified-allowlist"
            ],
            "default": "open",
            "description": "open: anyone with the URL. verify-any: visitors confirm their email address with a one-time link before entering. verified-allowlist (Restricted): only allowedEmails and allowedDomains can enter, each confirming their address with a one-time link. verify-any and verified-allowlist need Pro or Business."
          },
          "requireEmail": {
            "type": "boolean",
            "description": "open links only: ask visitors for their email before they enter (Pro and Business)."
          },
          "allowedEmails": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/AllowedEmail"
            },
            "description": "verified-allowlist only. Each address becomes a contact. The API adds nobody on its own: include your own address if you want to preview the room. Required (with allowedDomains) on a verified-allowlist link — an empty allowlist would be a dead end no one could open."
          },
          "allowedDomains": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 253
            },
            "description": "verified-allowlist only. Anyone with an address at one of these domains can enter. \"@acme.com\", \"acme.com\", and \"https://acme.com\" all mean acme.com. Free email providers such as gmail.com are refused."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "description": "verified-allowlist only. Your internal name for the link."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the link stops working. Must be in the future (Starter and above)."
          },
          "allowDownloads": {
            "type": "boolean",
            "description": "Whether viewers can download the room's documents. Omitted, uses the room's own download default."
          },
          "notifyOnView": {
            "type": "boolean",
            "default": true
          },
          "notifySlack": {
            "type": "boolean",
            "default": true
          },
          "recipientName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 255
          },
          "recipientEmail": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 255,
            "description": "Finds the contact with this email or creates one."
          },
          "contactId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Existing contact in the authenticated workspace."
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Existing company. Mutually exclusive with companyName."
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 255,
            "description": "Company to find by name, ignoring case, or create."
          },
          "companyDomain": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Stored on a new company, or on a matched one that has no domain yet. Requires companyName.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "recipientName"
            ],
            "properties": {
              "recipientName": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "recipientEmail"
            ],
            "properties": {
              "recipientEmail": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "contactId"
            ],
            "properties": {
              "contactId": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "companyId"
            ],
            "properties": {
              "companyId": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "companyName"
            ],
            "properties": {
              "companyName": {
                "type": "string"
              }
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "requireEmail"
              ],
              "properties": {
                "requireEmail": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "accessMode": {
                  "const": "open"
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "allowedEmails"
                  ],
                  "properties": {
                    "allowedEmails": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "allowedDomains"
                  ],
                  "properties": {
                    "allowedDomains": {
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            "then": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "then": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "accessMode"
              ],
              "properties": {
                "accessMode": {
                  "const": "verified-allowlist"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "allowedEmails"
                  ],
                  "properties": {
                    "allowedEmails": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "allowedDomains"
                  ],
                  "properties": {
                    "allowedDomains": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "not": {
              "required": [
                "companyId",
                "companyName"
              ],
              "properties": {
                "companyId": {
                  "type": "string"
                },
                "companyName": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "companyDomain"
              ],
              "properties": {
                "companyDomain": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "then": {
              "required": [
                "companyName"
              ],
              "properties": {
                "companyName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "UpdateRoomLinkRequest": {
        "type": "object",
        "description": "Send only the fields to change. accessMode and the slug are immutable and not accepted here; create a replacement link instead.",
        "properties": {
          "isActive": {
            "type": "boolean",
            "description": "Turning a link off always succeeds. Turning one back on rechecks the plan's active-link limit (403 PLAN_LIMIT_REACHED) and requires the room to be active."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "A future date sets it (Starter and above); null clears it."
          },
          "allowedEmails": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/AllowedEmail"
            },
            "description": "verified-allowlist links only. Replaces the link's active invitees; addresses left out are revoked."
          },
          "allowedDomains": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 253
            },
            "description": "verified-allowlist links only. Replaces the link's active allowed domains."
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      },
      "RoomSenderRequest": {
        "type": "object",
        "description": "The point of contact shown in the room. null or an empty string clears a field.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 255
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "CreateRoomRequest": {
        "type": "object",
        "properties": {
          "labelIds": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Workspace labels to apply, from GET /room-labels."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "welcomeMessage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Existing company. Mutually exclusive with companyName."
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 255,
            "description": "Company to find by name, ignoring case, or create."
          },
          "companyDomain": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Stored on a new company, or on a matched one that has no domain yet. Requires companyName."
          },
          "contactId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Existing contact in the workspace."
          },
          "recipientName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 255
          },
          "recipientEmail": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 255,
            "description": "Finds the contact with this email or creates one."
          },
          "documentIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "Documents from your library, added in this order to the first tab. Documents still processing are accepted."
          },
          "tabLabels": {
            "type": "object",
            "properties": {
              "documents": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "default": "Documents"
              },
              "nextSteps": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "default": "Next Steps"
              }
            },
            "additionalProperties": false,
            "description": "Labels for the two default tabs. The API has no locale, so the defaults are English."
          },
          "sender": {
            "$ref": "#/components/schemas/RoomSenderRequest"
          },
          "primaryLink": {
            "$ref": "#/components/schemas/PrimaryLinkRequest"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "UpdateRoomRequest": {
        "type": "object",
        "description": "Send only the fields to change.",
        "properties": {
          "labelIds": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Replaces the room's whole set; an empty array clears every label. Omit to leave labels alone."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "welcomeMessage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "sender": {
            "$ref": "#/components/schemas/RoomSenderRequest"
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "contactId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      },
      "CreateRoomTabRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "content",
              "action_items"
            ],
            "default": "content"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "description": "0-based place among the room's tabs. Omitted, the tab goes last."
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "RenameRoomTabRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "ReorderRoomTabsRequest": {
        "type": "object",
        "properties": {
          "tabIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Every tab in the room, each exactly once, in the new order."
          }
        },
        "required": [
          "tabIds"
        ],
        "additionalProperties": false
      },
      "AddRoomItemRequest": {
        "description": "One item. type decides which fields apply; fields for another type are refused.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/AddRoomSectionRequest"
          },
          {
            "$ref": "#/components/schemas/AddRoomDocumentRequest"
          },
          {
            "$ref": "#/components/schemas/AddRoomUrlRequest"
          },
          {
            "$ref": "#/components/schemas/AddRoomEmbedRequest"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "section": "#/components/schemas/AddRoomSectionRequest",
            "document": "#/components/schemas/AddRoomDocumentRequest",
            "url": "#/components/schemas/AddRoomUrlRequest",
            "embed": "#/components/schemas/AddRoomEmbedRequest"
          }
        }
      },
      "AddRoomSectionRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "section"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "tabId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "type",
          "label"
        ],
        "additionalProperties": false
      },
      "AddRoomDocumentRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "document"
          },
          "documentId": {
            "type": "string",
            "description": "From GET /decks or POST /decks."
          },
          "tabId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "type",
          "documentId"
        ],
        "additionalProperties": false
      },
      "AddRoomUrlRequest": {
        "type": "object",
        "description": "urlId for a URL already in your library, or url and title to add a new one.",
        "properties": {
          "type": {
            "type": "string",
            "const": "url"
          },
          "urlId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "http or https only."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "tabId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "urlId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                },
                {
                  "required": [
                    "description"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "url",
              "title"
            ],
            "not": {
              "required": [
                "urlId"
              ]
            }
          }
        ]
      },
      "AddRoomEmbedRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "embed"
          },
          "embedUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "A page from a supported provider. Share links and embed links are both accepted, and the URL is normalized to the provider's embed form. The full set is: video (Loom, YouTube, Vimeo, Wistia, Vidyard); scheduling (Calendly, Cal.com, SavvyCal, Google Calendar); forms (Typeform, Tally, Google Forms, Jotform, Fillout); design (Figma, Miro, Canva, Whimsical); docs and tables (Google Docs, Google Sheets, Notion, Coda, Airtable); presentations (Google Slides, Pitch, Gamma, Guideflow, Flipsnack, Prezi); audio (Spotify, SoundCloud). Anything else returns 400 EMBED_PROVIDER_NOT_SUPPORTED."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "heightPx": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 80,
            "maximum": 4000
          },
          "tabId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "type",
          "embedUrl"
        ],
        "additionalProperties": false
      },
      "MoveRoomItemRequest": {
        "type": "object",
        "properties": {
          "tabId": {
            "type": "string",
            "format": "uuid",
            "description": "A content tab of the same room."
          }
        },
        "required": [
          "tabId"
        ],
        "additionalProperties": false
      },
      "ReorderRoomItemsRequest": {
        "type": "object",
        "properties": {
          "tabId": {
            "type": "string",
            "format": "uuid"
          },
          "itemIds": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Every item the tab shows, each exactly once, in the new order."
          }
        },
        "required": [
          "tabId",
          "itemIds"
        ],
        "additionalProperties": false
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the document"
          },
          "title": {
            "type": "string",
            "description": "Document title"
          },
          "fileType": {
            "type": "string",
            "description": "MIME type of the document",
            "example": "application/pdf"
          },
          "deliveryMode": {
            "type": "string",
            "enum": [
              "preview",
              "download_only"
            ],
            "description": "download_only files are never previewed; recipients download them and open them on their device."
          },
          "pageCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Number of pages when processing has determined it."
          },
          "thumbnailUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Thumbnail image URL when one is available."
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "description": "Processing continues after upload. The document can go into a room right away; poll until completed before sending a link to it."
          },
          "processingErrorCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why processing failed, when processingStatus is failed."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the document was created."
          }
        },
        "required": [
          "id",
          "title",
          "fileType",
          "deliveryMode",
          "pageCount",
          "thumbnailUrl",
          "processingStatus",
          "processingErrorCode",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "UploadedDocument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the document"
          },
          "title": {
            "type": "string",
            "description": "Document title"
          },
          "fileType": {
            "type": "string",
            "description": "MIME type of the document",
            "example": "application/pdf"
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "description": "Previewable uploads and replacements can return pending while processing continues. A download-only replacement returns completed. Check status before relying on the preview."
          },
          "processingErrorCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why processing failed, when processingStatus is failed."
          }
        },
        "required": [
          "id",
          "title",
          "fileType",
          "processingStatus",
          "processingErrorCode"
        ],
        "additionalProperties": false
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the contact"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Job title"
          },
          "leadId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deprecated alias for companyId",
            "deprecated": true
          },
          "leadName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deprecated alias for companyName",
            "deprecated": true
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Associated company ID, null when the contact has no company in this workspace"
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Associated company name"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "companyId",
          "companyName"
        ]
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the company"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "industry": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "domain",
          "logoUrl",
          "industry",
          "size",
          "createdAt",
          "updatedAt"
        ]
      },
      "Decision": {
        "type": "object",
        "properties": {
          "shareSlug": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "changes_requested",
              "declined"
            ],
            "description": "Mirrors shares.decision_status"
          },
          "deckTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "viewerEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "viewerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "decisionNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "decidedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "shareSlug",
          "decision"
        ]
      },
      "EmailCapture": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "shareSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "deckTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "viewId": {
            "type": "string"
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "viewId"
        ]
      },
      "WebhookSubscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Subscription ID (used to unsubscribe)"
          }
        },
        "required": [
          "id"
        ]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "team": {
            "type": "string",
            "description": "Team/workspace name"
          },
          "teamSlug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "team",
          "teamSlug"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable code, present on some errors",
            "enum": [
              "PLAN_LIMIT_REACHED",
              "VALIDATION_ERROR",
              "NOT_FOUND",
              "ROOM_NOT_ACTIVE",
              "ACCOUNT_CONFLICT",
              "CREDENTIAL_NOT_ALLOWED",
              "INSUFFICIENT_SCOPE",
              "RATE_LIMITED",
              "PAYLOAD_TOO_LARGE",
              "INVALID_FORMAT",
              "TYPE_MISMATCH",
              "FILE_READ_ERROR",
              "FILE_TOO_LARGE",
              "FEATURE_NOT_AVAILABLE",
              "PROPOSAL_LOCKED",
              "REPLACEMENT_CONFLICT",
              "TAB_TYPE_CONFLICT",
              "LAST_TAB",
              "TAB_NOT_EMPTY",
              "TASK_BLOCKED",
              "TASK_HIERARCHY_CYCLE",
              "LEGACY_MAPPING_UNSUPPORTED",
              "LABEL_NAME_CONFLICT",
              "EMBED_PROVIDER_NOT_SUPPORTED"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "room",
              "docPerRoom",
              "linksPerRoom",
              "htmlBundle"
            ],
            "description": "With PLAN_LIMIT_REACHED: the room limit or HTML bundle preview entitlement that blocked the request."
          },
          "limit": {
            "type": "integer",
            "description": "With PLAN_LIMIT_REACHED on room endpoints: the plan's limit."
          },
          "feature": {
            "type": "string",
            "enum": [
              "restrictedAccess",
              "emailCapture",
              "linkExpiration",
              "downloadControl",
              "roomDiscussions"
            ],
            "description": "With FEATURE_NOT_AVAILABLE: the plan feature the request needs."
          },
          "requiredScope": {
            "type": "string",
            "enum": [
              "rooms:read",
              "rooms:write",
              "plan:read",
              "plan:write",
              "analytics:read",
              "crm:read",
              "crm:write",
              "documents:read",
              "documents:write"
            ],
            "description": "With INSUFFICIENT_SCOPE: the capability the API key must be granted."
          }
        },
        "required": [
          "error"
        ]
      },
      "RoomCompanyReference": {
        "type": "object",
        "description": "The company fields embedded in a room or room-link response.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "domain"
        ],
        "additionalProperties": false
      },
      "RoomContactReference": {
        "type": "object",
        "description": "The contact fields embedded in a room or room-link response.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email"
        ],
        "additionalProperties": false
      },
      "RoomTabActivityEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tabId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Server-resolved tab title snapshot; null for a legacy default document tab."
          },
          "source": {
            "type": "string",
            "enum": [
              "initial",
              "click"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "activeDurationSeconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "tabId",
          "title",
          "source",
          "occurredAt",
          "activeDurationSeconds"
        ]
      },
      "RoomDocumentActivityEntry": {
        "type": "object",
        "description": "Document activity associated with an exact parent visit; no nested children.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "viewed",
              "entered_room",
              "task_created",
              "task_updated",
              "task_assigned",
              "task_completed",
              "task_reopened",
              "task_deleted",
              "discussion_message"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The visitor for a view or entry, the workspace member for a task event."
          },
          "actorEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "contactId": {
            "type": [
              "string",
              "null"
            ]
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentTitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for document events only."
          },
          "taskTitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for task events only."
          },
          "roomItemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "completionPercent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "roomViewId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Validated parent room visit ID. Null for events without an exact room visit association."
          },
          "fileCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Original files included in a room_export_requested download handoff; null for other events. The handoff does not prove that the ZIP was saved or read."
          }
        },
        "required": [
          "id",
          "type",
          "occurredAt",
          "actorName",
          "actorEmail",
          "contactId",
          "companyId",
          "documentId",
          "documentTitle",
          "taskTitle",
          "roomItemId",
          "device",
          "location",
          "durationSeconds",
          "completionPercent",
          "roomViewId",
          "fileCount"
        ]
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Test authentication",
        "description": "Returns the authenticated user's profile and connected team. Used by Zapier to verify credentials.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/hooks": {
      "post": {
        "summary": "Subscribe to webhook events",
        "description": "Register a callback URL to receive event notifications. Zapier calls this when a user turns on a Zap.",
        "operationId": "subscribeWebhook",
        "security": [
          {
            "oauth2": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hookUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Zapier's callback URL for receiving events"
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "view.created",
                      "decision.made",
                      "email_captured"
                    ],
                    "description": "Event type to subscribe to"
                  }
                },
                "required": [
                  "hookUrl",
                  "event"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (bad URL or unsupported event type)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: webhook subscriptions are available to the Zapier integration only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/hooks/{id}": {
      "delete": {
        "summary": "Unsubscribe from webhook events",
        "description": "Remove a webhook subscription. Zapier calls this when a user turns off a Zap.",
        "operationId": "unsubscribeWebhook",
        "security": [
          {
            "oauth2": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Subscription ID returned from POST /hooks"
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden: webhook subscriptions are available to the Zapier integration only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/views": {
      "get": {
        "summary": "List recent document views",
        "description": "Returns recent document views for the authenticated team. Used by Zapier as a polling fallback during Zap testing. Returns up to 100 results in reverse chronological order. Bot views are excluded.",
        "operationId": "listViews",
        "x-required-api-key-scope": "analytics:read",
        "responses": {
          "200": {
            "description": "List of recent views",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/shares": {
      "post": {
        "summary": "Create a share link",
        "description": "Generate a tracked share link. The returned URL uses the workspace's active custom domain when the workspace is entitled to use custom domains; otherwise it uses the HummingDeck domain. For personal links, HummingDeck resolves the contact by its email and the company by its name, creating records that are missing. The response reports which account records were created. Explicit anonymous links never create account records.\n\nWorkspace API keys always need `documents:write`. A personal link also needs `crm:write` when the request supplies recipient, contact, or company fields that HummingDeck resolves against CRM records.",
        "operationId": "createShare",
        "x-required-api-key-scope": "documents:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deckId": {
                    "type": "string",
                    "description": "ID of the document to share"
                  },
                  "recipientName": {
                    "type": "string",
                    "description": "Name of the recipient (optional)"
                  },
                  "recipientEmail": {
                    "type": "string",
                    "format": "email",
                    "description": "Email of the recipient (optional)"
                  },
                  "contactId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Existing contact in the authenticated workspace. When recipientEmail is also supplied, it must identify this contact."
                  },
                  "companyId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Existing company in the authenticated workspace. Mutually exclusive with companyName."
                  },
                  "companyName": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Company to find case-insensitively or create. Mutually exclusive with companyId."
                  },
                  "companyDomain": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Domain used when companyName creates or enriches a company. Requires companyName."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "personal",
                      "anonymous"
                    ],
                    "description": "Link type. Defaults to personal when any recipient/contact/company field is present, otherwise anonymous. Explicit anonymous links do not create account records."
                  }
