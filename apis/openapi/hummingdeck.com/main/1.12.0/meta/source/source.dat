      "PrimaryRoomLink": {
        "type": "object",
        "description": "The room's first audience link, as stored.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessMode": {
            "type": "string",
            "enum": [
              "open",
              "verify-any",
              "verified-allowlist"
            ]
          },
          "requireEmail": {
            "type": "boolean"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
