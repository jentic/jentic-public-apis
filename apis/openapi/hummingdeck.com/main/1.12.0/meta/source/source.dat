    "/room-views": {
      "get": {
        "summary": "Room entries across the workspace",
        "description": "Requires a workspace API token; Zapier OAuth credentials are rejected. Someone entering a room has no other home: /views covers document views only. This is the polling feed until room webhooks exist. Bots are excluded. It is a window rather than an archive: omitting since gives the last 30 days, and a since more than 90 days ago is refused rather than clamped. The window actually applied comes back as since, so a caller following nextCursor can send the same one back and keep paging one set. A cursor this API did not issue returns 400 rather than restarting from the top.",
        "operationId": "listRoomViews",
        "x-required-api-key-scope": "analytics:read",
        "security": [
          {
            "apiToken": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only entries at or after this moment. Defaults to 30 days ago; more than 90 days ago is refused."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "A nextCursor from a previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of room entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomViewList"
                }
              }
            }
