      "RoomActivityEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "viewed",
              "entered_room",
              "task_created",
              "task_updated",
              "task_assigned",
              "task_completed",
              "task_reopened",
              "task_deleted",
              "discussion_message",
              "download_requested",
              "room_export_requested"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The visitor for a view or entry, the workspace member for a task event."
          },
          "actorEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "contactId": {
            "type": [
              "string",
              "null"
            ]
          },
          "companyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentTitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for document events only."
          },
          "taskTitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for task events only."
          },
          "roomItemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "completionPercent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "roomViewId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Validated parent room visit ID. Null for events without an exact room visit association."
          },
          "roomActiveDurationSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Active room time for an entered_room event, including linked document activity without adding overlapping document durations. Null for older unmeasured visits and other event types."
          },
          "tabEntries": {
            "type": "array",
            "description": "Initial tab entry and subsequent explicit tab selections for this visit. Preloaded tabs do not create entries.",
            "items": {
              "$ref": "#/components/schemas/RoomTabActivityEntry"
            }
          },
          "documentViews": {
            "type": "array",
            "description": "Document activity linked to this exact visit. These documents can also occur as top-level activity entries; deduplicate by ID when counting events. Children do not include further nested activity.",
            "items": {
              "$ref": "#/components/schemas/RoomDocumentActivityEntry"
            }
          },
          "documentViewsTruncated": {
            "type": "boolean",
            "description": "True when a visit has more than 100 document children. The nested list includes the earliest 100; top-level paginated document events remain available."
          },
          "fileCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Original files included in a room_export_requested download handoff; null for other events. The handoff does not prove that the ZIP was saved or read."
          }
        },
        "required": [
          "id",
          "type",
          "occurredAt",
          "actorName",
          "actorEmail",
          "contactId",
          "companyId",
          "documentId",
          "documentTitle",
          "taskTitle",
          "roomItemId",
          "device",
          "location",
          "durationSeconds",
          "completionPercent",
          "roomViewId",
          "roomActiveDurationSeconds",
          "tabEntries",
          "documentViews",
          "documentViewsTruncated",
          "fileCount"
        ]
      },
