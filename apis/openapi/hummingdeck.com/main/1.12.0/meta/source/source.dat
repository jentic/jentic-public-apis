      "post": {
        "summary": "Create a room",
        "description": "Requires a workspace API token; Zapier OAuth credentials are rejected. Creates a room with its default tabs (Documents and Next Steps), the documents in documentIds in the first tab, and the room's first audience link, all in one transaction. A refused call leaves no room, link, company, or contact behind.\n\nTypical use: upload each file with POST /decks, then create the room for the recipient's company with a Restricted link for the people who should see it. Documents can be added while they are still processing; check processingStatus on the room's items and send the link once each reads completed.\n\nThe room's company and contact are found or created as in POST /shares. Each allowed email becomes a contact with no company. The point of contact shown in the room defaults to the token's issuer; send sender to change it.\n\nOptions the workspace's plan does not include return 403 FEATURE_NOT_AVAILABLE rather than being dropped. The plan's active-room and documents-per-room limits return 403 PLAN_LIMIT_REACHED.\n\nWorkspace API keys always need `rooms:write`. They also need `documents:write` when `documentIds` is non-empty, and `crm:write` when the request supplies account fields or a non-empty email allowlist.",
        "operationId": "createRoom",
        "x-required-api-key-scope": "rooms:write",
        "security": [
          {
            "apiToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              },
              "examples": {
                "restrictedRoomFromUploads": {
                  "summary": "Room for a buyer's company, with a Restricted link and two uploaded documents",
                  "value": {
                    "name": "Acme renewal",
                    "companyName": "Acme Inc",
                    "companyDomain": "acme.com",
                    "recipientName": "Pat Buyer",
                    "recipientEmail": "pat@acme.com",
                    "documentIds": [
                      "3f5c6a1e-8a47-4f2a-9a61-0f1e2d3c4b5a",
                      "9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d"
                    ],
                    "primaryLink": {
                      "accessMode": "verified-allowlist",
                      "allowedEmails": [
                        "pat@acme.com",
                        {
                          "email": "cfo@acme.com",
                          "name": "Sam Rivera"
                        }
                      ],
                      "allowedDomains": [
                        "acme.com"
                      ],
                      "allowDownloads": false
                    }
                  }
                },
                "openRoom": {
                  "summary": "Open room for a company",
                  "value": {
                    "name": "Acme evaluation",
                    "companyName": "Acme Inc"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Room created with its primary link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedRoom"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, an option that does not apply to the access mode, a Restricted link with no allowed emails or domains, or an unsupported domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Workspace API token or a required API-key scope is missing, the plan lacks a requested option (FEATURE_NOT_AVAILABLE), or a plan limit is reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "A document, company, or contact is missing from the workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Account identifiers conflict (ACCOUNT_CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "x-conditional-api-key-scopes": {
          "documents:write": "Required when documentIds contains one or more document IDs.",
          "crm:write": "Required when the request supplies contactId, recipientName, recipientEmail, companyId, companyName, or when either primaryLink.allowedEmails or primaryLink.allowedDomains is non-empty."
        }
      }
    },
