    "/rooms/{roomId}/items": {
      "post": {
        "summary": "Add an item",
        "description": "Requires a workspace API token; Zapier OAuth credentials are rejected. Adds a document, URL, embed, or section divider to a content tab (tabId, or the room's first content tab when omitted) at position (the end when omitted); the items after it move one place.\n\ndocument: a document from your library. Every audience link gets its own tracked copy, and on verify-any and Restricted links the copy follows the link's access check. Documents count toward the plan's documents-per-room limit.\n\nurl: a URL from your library (urlId), or a new one (url and title), which is added to your library too.\n\nembed: a page from a supported provider, shown inside the room. Other providers return 400 EMBED_PROVIDER_NOT_SUPPORTED.\n\nsection: a labeled divider for grouping items within a tab.\n\nTo propose and apply a structure, read the room with GET /rooms/{roomId}, add tabs and sections, then move and reorder items.\n\nWorkspace API keys always need `rooms:write`. Adding a document or either form of URL also needs `documents:write`; section and embed items do not.",
        "operationId": "addRoomItem",
        "x-required-api-key-scope": "rooms:write",
        "security": [
          {
            "apiToken": []
          }
        ],
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Room ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoomItemRequest"
              },
              "examples": {
                "document": {
                  "summary": "Document at the top of a tab",
                  "value": {
                    "type": "document",
                    "documentId": "3f5c6a1e-8a47-4f2a-9a61-0f1e2d3c4b5a",
                    "tabId": "7d9e8f1a-2b3c-4d5e-8f6a-7b8c9d0e1f2a",
                    "position": 0
                  }
                },
                "newUrl": {
                  "summary": "New URL",
                  "value": {
                    "type": "url",
                    "url": "https://acme.com/pricing",
                    "title": "Pricing"
                  }
                },
                "embed": {
                  "summary": "Loom walkthrough",
                  "value": {
                    "type": "embed",
                    "embedUrl": "https://www.loom.com/share/0123456789abcdef",
                    "label": "Product walkthrough"
                  }
                },
                "section": {
                  "summary": "Section divider",
                  "value": {
                    "type": "section",
                    "label": "Commercials"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new item, in the room's item shape",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, a tab that cannot hold items, a room with no content tab, or an unsupported embed provider (EMBED_PROVIDER_NOT_SUPPORTED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Workspace API token or a required API-key scope is missing, or the documents-per-room limit is reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Room, tab, document, or URL missing from the workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The room is archived (ROOM_NOT_ACTIVE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "x-conditional-api-key-scopes": {
          "documents:write": "Required when type is document or url."
        }
      }
    },
