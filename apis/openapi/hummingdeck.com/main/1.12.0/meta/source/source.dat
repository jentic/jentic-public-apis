    "/rooms/{roomId}/activity": {
      "get": {
        "summary": "What happened in the room",
        "description": "Requires a workspace API token; Zapier OAuth credentials are rejected. Newest first: room entries, document views, action-plan task events, and the fact that a discussion message was sent. Message bodies are never returned. Use since to narrow the window and follow nextCursor until it is null so bursts larger than one page are not skipped.",
        "operationId": "listRoomActivity",
        "x-required-api-key-scope": "analytics:read",
        "security": [
          {
            "apiToken": []
          }
