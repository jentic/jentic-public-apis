{
  "openapi": "3.0.3",
  "info": {
    "title": "Shelly Cloud Control API",
    "description": "Cloud REST API for controlling Shelly IoT devices remotely. Includes both the legacy v1 communication endpoints and the v2.0-beta endpoints for device state, switch, cover, and light control.",
    "version": "2.0-beta",
    "contact": {
      "name": "Shelly",
      "url": "https://shelly.cloud"
    },
    "x-jentic-source-url": "https://shelly-api-docs.shelly.cloud/cloud-control-api/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://shelly-eu-api.shelly.cloud",
      "description": "Shelly Cloud EU Server (server URI varies by account region)"
    },
    {
      "url": "https://shelly-us-api.shelly.cloud",
      "description": "Shelly Cloud US Server"
    }
  ],
  "security": [
    {
      "authKey": []
    }
  ],
  "paths": {
    "/device/status": {
      "post": {
        "operationId": "getDeviceStatus",
        "summary": "Get device status (v1, deprecated)",
        "description": "Retrieve the current status of a Shelly device. Deprecated in favor of v2 endpoints.",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "auth_key"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "auth_key": {
                    "type": "string",
                    "description": "Authorization cloud key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device/relay/control": {
      "post": {
        "operationId": "controlRelay",
        "summary": "Control relay switch (v1, deprecated)",
        "description": "Turn a relay on or off on a Shelly device. Deprecated in favor of v2 endpoints.",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "auth_key",
                  "turn"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "auth_key": {
                    "type": "string",
                    "description": "Authorization cloud key"
                  },
                  "channel": {
                    "type": "integer",
                    "description": "Relay channel number",
                    "default": 0
                  },
                  "turn": {
                    "type": "string",
                    "enum": [
                      "on",
                      "off",
                      "toggle"
                    ],
                    "description": "Desired relay state"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relay control command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device/relay/roller/control": {
      "post": {
        "operationId": "controlRoller",
        "summary": "Control roller/cover device (v1, deprecated)",
        "description": "Control a roller/cover Shelly device - open, close, stop, or set position. Deprecated.",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "auth_key"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "auth_key": {
                    "type": "string",
                    "description": "Authorization cloud key"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "open",
                      "close",
                      "stop"
                    ],
                    "description": "Roller direction command"
                  },
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Target position percentage (0-100)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Roller control command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device/light/control": {
      "post": {
        "operationId": "controlLight",
        "summary": "Control light/RGBW device (v1, deprecated)",
        "description": "Control RGB or white-mode lights on a Shelly device. Deprecated.",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "auth_key"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "auth_key": {
                    "type": "string",
                    "description": "Authorization cloud key"
                  },
                  "channel": {
                    "type": "integer",
                    "description": "Light channel"
                  },
                  "turn": {
                    "type": "string",
                    "enum": [
                      "on",
                      "off",
                      "toggle"
                    ],
                    "description": "On/off state"
                  },
                  "red": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "green": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "blue": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "white": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "gain": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "brightness": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Light control command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device/relay/bulk_control": {
      "post": {
        "operationId": "bulkControlRelays",
        "summary": "Bulk control multiple relays (v1, deprecated)",
        "description": "Control multiple relay devices in a single request. Deprecated.",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "auth_key",
                  "devices"
                ],
                "properties": {
                  "auth_key": {
                    "type": "string",
                    "description": "Authorization cloud key"
                  },
                  "devices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "channel": {
                          "type": "integer"
                        },
                        "turn": {
                          "type": "string",
                          "enum": [
                            "on",
                            "off",
                            "toggle"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk relay control executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/devices/api/get": {
      "post": {
        "operationId": "getDevicesState",
        "summary": "Get device(s) state (v2)",
        "description": "Retrieve the current state (status and/or settings) for up to 10 Shelly devices. Rate limited to 1 request per second.",
        "parameters": [
          {
            "name": "auth_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization cloud key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 10,
                    "description": "Array of device IDs (1-10)"
                  },
                  "select": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "status",
                        "settings"
                      ]
                    },
                    "description": "Select which data to return"
                  },
                  "pick": {
                    "type": "object",
                    "description": "Restrict specific properties to return"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device state returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "description": "Map of device IDs to their state objects"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized - invalid auth_key"
          }
        }
      }
    },
    "/v2/devices/api/set/switch": {
      "post": {
        "operationId": "controlSwitch",
        "summary": "Control a switch (v2)",
        "description": "Turn a switch on or off on a Shelly device with optional auto-toggle timer.",
        "parameters": [
          {
            "name": "auth_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization cloud key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "on"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "channel": {
                    "type": "integer",
                    "default": 0,
                    "description": "Switch channel (defaults to 0)"
                  },
                  "on": {
                    "type": "boolean",
                    "description": "Desired switch state"
                  },
                  "toggle_after": {
                    "type": "number",
                    "description": "Seconds before automatically toggling back"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Switch command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/devices/api/set/cover": {
      "post": {
        "operationId": "controlCover",
        "summary": "Control a cover/roller (v2)",
        "description": "Control a cover/roller device - open, close, stop, or set to a specific position.",
        "parameters": [
          {
            "name": "auth_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization cloud key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "position"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "channel": {
                    "type": "integer",
                    "default": 0,
                    "description": "Cover channel"
                  },
                  "position": {
                    "description": "Target position: 'open', 'close', 'stop', or number 0-100",
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "open",
                          "close",
                          "stop"
                        ]
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    ]
                  },
                  "duration": {
                    "type": "number",
                    "description": "Duration in seconds for timed movement"
                  },
                  "relative": {
                    "type": "integer",
                    "description": "Relative position change"
                  },
                  "slatPosition": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Slat tilt position"
                  },
                  "slatRelative": {
                    "type": "integer",
                    "description": "Relative slat position change"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cover command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/devices/api/set/light": {
      "post": {
        "operationId": "controlLightV2",
        "summary": "Control a light (v2)",
        "description": "Control a light device including on/off, brightness, color temperature, and RGB values.",
        "parameters": [
          {
            "name": "auth_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization cloud key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Device ID"
                  },
                  "on": {
                    "type": "boolean",
                    "description": "Desired light state"
                  },
                  "mode": {
                    "type": "string",
                    "description": "Light mode (color, white, etc.)"
                  },
                  "brightness": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "red": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "green": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "blue": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "white": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "temp": {
                    "type": "integer",
                    "description": "Color temperature in Kelvin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Light control command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/devices/api/set/groups": {
      "post": {
        "operationId": "controlDeviceGroups",
        "summary": "Control device groups (v2)",
        "description": "Control multiple devices of different types (switches, covers, lights) in a single group command.",
        "parameters": [
          {
            "name": "auth_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization cloud key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "switch": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "channel": {
                          "type": "integer"
                        },
                        "on": {
                          "type": "boolean"
                        }
                      }
                    },
                    "description": "Array of switch commands"
                  },
                  "cover": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "channel": {
                          "type": "integer"
                        },
                        "position": {}
                      }
                    },
                    "description": "Array of cover commands"
                  },
                  "light": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "on": {
                          "type": "boolean"
                        },
                        "brightness": {
                          "type": "integer"
                        }
                      }
                    },
                    "description": "Array of light commands"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group control commands executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authKey": {
        "type": "apiKey",
        "name": "auth_key",
        "in": "query",
        "description": "Authorization cloud key generated from User Settings in the Shelly app"
      }
    }
  }
}
