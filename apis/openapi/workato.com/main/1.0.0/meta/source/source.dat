{
  "openapi": "3.0.3",
  "info": {
    "title": "Workato Platform API",
    "description": "The Workato Platform API enables programmatic management of recipes, connections, folders, projects, jobs, and workspace details. Uses Bearer token authentication via API clients.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.workato.com/workato-api.html",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://www.workato.com/api",
      "description": "Workato US data center"
    },
    {
      "url": "https://app.eu.workato.com/api",
      "description": "Workato EU data center"
    },
    {
      "url": "https://app.jp.workato.com/api",
      "description": "Workato JP data center"
    },
    {
      "url": "https://app.sg.workato.com/api",
      "description": "Workato SG data center"
    },
    {
      "url": "https://app.au.workato.com/api",
      "description": "Workato AU data center"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/users/me": {
      "get": {
        "operationId": "getWorkspaceDetails",
        "summary": "Get current workspace details",
        "description": "Returns information about the authenticated workspace including plan, recipe counts, and user details.",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "Workspace details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "plan_id": { "type": "string" },
                    "trial": { "type": "boolean" },
                    "company_name": { "type": "string" },
                    "recipe_count": { "type": "integer" },
                    "active_recipe_count": { "type": "integer" },
                    "created_at": { "type": "string", "format": "date-time" },
                    "root_folder_id": { "type": "integer" },
                    "avatar_url": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/recipes": {
      "get": {
        "operationId": "listRecipes",
        "summary": "List recipes in the workspace",
        "description": "Returns a paginated list of recipes. Supports filtering by adapter, folder, status, and more.",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "adapter_names_all", "in": "query", "schema": { "type": "string" }, "description": "Filter by all adapter names (comma-separated)" },
          { "name": "adapter_names_any", "in": "query", "schema": { "type": "string" }, "description": "Filter by any adapter name (comma-separated)" },
          { "name": "folder_id", "in": "query", "schema": { "type": "string" }, "description": "Filter by folder ID" },
          { "name": "with_subfolders", "in": "query", "schema": { "type": "boolean" }, "description": "Include recipes from subfolders" },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["created_at", "updated_at", "activity_on"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100 } },
          { "name": "running", "in": "query", "schema": { "type": "boolean" }, "description": "Filter for running recipes" },
          { "name": "since_id", "in": "query", "schema": { "type": "string" } },
          { "name": "stopped_after", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "stop_cause", "in": "query", "schema": { "type": "string" } },
          { "name": "updated_after", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "includes[]", "in": "query", "schema": { "type": "string", "enum": ["tags"] } },
          { "name": "exclude_code", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "List of recipes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Recipe" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRecipe",
        "summary": "Create a new recipe",
        "description": "Creates a new recipe in the workspace.",
        "tags": ["Recipes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recipe"],
                "properties": {
                  "recipe": {
                    "type": "object",
                    "required": ["name", "code"],
                    "properties": {
                      "name": { "type": "string" },
                      "code": { "type": "string", "description": "Recipe code as JSON string" },
                      "config": { "type": "string" },
                      "folder_id": { "type": "integer" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recipe created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "id": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid recipe data" }
        }
      }
    },
    "/recipes/{recipeId}": {
      "get": {
        "operationId": "getRecipe",
        "summary": "Get recipe details",
        "description": "Returns details about a specific recipe.",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "includes[]", "in": "query", "schema": { "type": "string", "enum": ["tags"] } }
        ],
        "responses": {
          "200": {
            "description": "Recipe details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Recipe" }
              }
            }
          },
          "404": { "description": "Recipe not found" }
        }
      },
      "put": {
        "operationId": "updateRecipe",
        "summary": "Update a recipe",
        "description": "Updates an existing recipe. Cannot update running recipes.",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipe": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "code": { "type": "string" },
                      "config": { "type": "string" },
                      "folder_id": { "type": "integer" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Recipe updated" },
          "404": { "description": "Recipe not found" }
        }
      },
      "delete": {
        "operationId": "deleteRecipe",
        "summary": "Delete a recipe",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Recipe deleted" },
          "404": { "description": "Recipe not found" }
        }
      }
    },
    "/recipes/{recipeId}/copy": {
      "post": {
        "operationId": "copyRecipe",
        "summary": "Copy a recipe",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recipe copied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "id": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipeId}/start": {
      "put": {
        "operationId": "startRecipe",
        "summary": "Start a recipe",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Recipe started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipeId}/stop": {
      "put": {
        "operationId": "stopRecipe",
        "summary": "Stop a recipe",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Recipe stopped" }
        }
      }
    },
    "/recipes/{recipeId}/reset_trigger": {
      "post": {
        "operationId": "resetRecipeTrigger",
        "summary": "Reset a recipe's polling trigger",
        "description": "Resets the trigger so the recipe picks up events from the beginning. Only for polling and scheduled triggers.",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Trigger reset" }
        }
      }
    },
    "/recipes/{recipeId}/connect": {
      "put": {
        "operationId": "updateRecipeConnection",
        "summary": "Update a recipe's connection",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["adapter_name", "connection_id"],
                "properties": {
                  "adapter_name": { "type": "string" },
                  "connection_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Connection updated" }
        }
      }
    },
    "/recipes/{recipeId}/poll_now": {
      "post": {
        "operationId": "pollRecipeNow",
        "summary": "Activate polling trigger immediately",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Poll triggered" },
          "429": { "description": "Backoff - try again later" }
        }
      }
    },
    "/recipes/{recipeId}/versions": {
      "get": {
        "operationId": "listRecipeVersions",
        "summary": "List recipe versions",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of versions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RecipeVersion" }
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipeId}/versions/{versionId}": {
      "get": {
        "operationId": "getRecipeVersion",
        "summary": "Get a specific recipe version",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "versionId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Version details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecipeVersion" }
              }
            }
          },
          "404": { "description": "Version not found" }
        }
      },
      "patch": {
        "operationId": "updateRecipeVersionComment",
        "summary": "Update a recipe version's comment",
        "tags": ["Recipes"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "versionId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["comment"],
                "properties": {
                  "comment": { "type": "string", "maxLength": 255 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Comment updated" }
        }
      }
    },
    "/recipes/{recipeId}/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List jobs for a recipe",
        "description": "Returns job history for a recipe with optional filtering.",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "offset_job_id", "in": "query", "schema": { "type": "string" } },
          { "name": "prev", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["succeeded", "failed", "pending"] } },
          { "name": "rerun_only", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "List of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Job" }
                    },
                    "job_succeeded_count": { "type": "integer" },
                    "job_failed_count": { "type": "integer" },
                    "job_count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipeId}/jobs/{jobId}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get job details",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipeId}/repeat_jobs": {
      "post": {
        "operationId": "repeatJobs",
        "summary": "Repeat (re-run) jobs",
        "description": "Re-runs the specified jobs. Maximum 25 jobs per request.",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "recipeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["job_ids"],
                "properties": {
                  "job_ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "maxItems": 25
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jobs re-run results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "job_id": { "type": "string" },
                          "status": { "type": "string", "enum": ["enqueued", "failed"] }
                        }
                      }
                    },
                    "enqueued": { "type": "integer" },
                    "failed": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/job/resume": {
      "post": {
        "operationId": "resumeJob",
        "summary": "Resume a paused job",
        "description": "Resumes a job that is waiting for external input (SDK Wait for resume action).",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string", "description": "Resume token matching the job" },
                  "data": { "type": "object", "description": "Contextual data to pass back (max 50MB)" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Job resumed successfully" }
        }
      }
    },
    "/connections": {
      "get": {
        "operationId": "listConnections",
        "summary": "List all connections",
        "tags": ["Connections"],
        "parameters": [
          { "name": "folder_id", "in": "query", "schema": { "type": "string" } },
          { "name": "parent_id", "in": "query", "schema": { "type": "string" } },
          { "name": "project_id", "in": "query", "schema": { "type": "string" } },
          { "name": "external_id", "in": "query", "schema": { "type": "string" } },
          { "name": "include_runtime_connections", "in": "query", "schema": { "type": "string" } },
          { "name": "includes[]", "in": "query", "schema": { "type": "string", "enum": ["tags"] } },
          { "name": "updated_after", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "List of connections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Connection" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createConnection",
        "summary": "Create a new connection",
        "tags": ["Connections"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "provider": { "type": "string" },
                  "parent_id": { "type": "string" },
                  "folder_id": { "type": "string" },
                  "external_id": { "type": "string" },
                  "shell_connection": { "type": "boolean" },
                  "input": { "type": "object", "description": "Provider-specific credentials" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connection created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Connection" }
              }
            }
          }
        }
      }
    },
    "/connections/{connectionId}": {
      "put": {
        "operationId": "updateConnection",
        "summary": "Update a connection",
        "tags": ["Connections"],
        "parameters": [
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "provider": { "type": "string" },
                  "folder_id": { "type": "string" },
                  "input": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Connection updated" }
        }
      },
      "delete": {
        "operationId": "deleteConnection",
        "summary": "Delete a connection",
        "tags": ["Connections"],
        "parameters": [
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Connection deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/connections/{connectionId}/disconnect": {
      "post": {
        "operationId": "disconnectConnection",
        "summary": "Disconnect a connection",
        "tags": ["Connections"],
        "parameters": [
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "force", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "Connection disconnected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/folders": {
      "get": {
        "operationId": "listFolders",
        "summary": "List all folders",
        "tags": ["Folders"],
        "parameters": [
          { "name": "parent_id", "in": "query", "schema": { "type": "string" }, "description": "Filter by parent folder" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 100 } },
          { "name": "with_nested_folders", "in": "query", "schema": { "type": "boolean" } },
          { "name": "updated_after", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "List of folders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Folder" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createFolder",
        "summary": "Create a new folder",
        "tags": ["Folders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "parent_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/folders/{folderId}": {
      "put": {
        "operationId": "updateFolder",
        "summary": "Update a folder",
        "tags": ["Folders"],
        "parameters": [
          { "name": "folderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "parent_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Folder" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFolder",
        "summary": "Delete a folder",
        "tags": ["Folders"],
        "parameters": [
          { "name": "folderId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "force", "in": "query", "schema": { "type": "boolean" }, "description": "Force delete non-empty folder" }
        ],
        "responses": {
          "200": { "description": "Folder deleted" }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List all projects",
        "tags": ["Projects"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 100 } },
          { "name": "updated_after", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Project" }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}": {
      "put": {
        "operationId": "updateProject",
        "summary": "Update a project",
        "tags": ["Projects"],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete a project",
        "tags": ["Projects"],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Project deleted" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication. Generate API tokens through Workato API Clients with role-based access control."
      }
    },
    "schemas": {
      "Recipe": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "running": { "type": "boolean" },
          "folder_id": { "type": "integer" },
          "code": { "type": "string" },
          "config": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "job_succeeded_count": { "type": "integer" },
          "job_failed_count": { "type": "integer" },
          "last_run_at": { "type": "string", "format": "date-time" },
          "stop_cause": { "type": "string" },
          "version_no": { "type": "integer" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "RecipeVersion": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "version_no": { "type": "integer" },
          "comment": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "flow_run_id": { "type": "string" },
          "completed_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["succeeded", "failed", "pending"] },
          "error": { "type": "string" },
          "is_rerun": { "type": "boolean" },
          "title": { "type": "string" },
          "recipe_id": { "type": "integer" }
        }
      },
      "Connection": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "provider": { "type": "string" },
          "authorization_status": { "type": "string", "enum": ["success", "failed"] },
          "authorized_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "external_id": { "type": "string" },
          "folder_id": { "type": "integer" },
          "parent_id": { "type": "integer" }
        }
      },
      "Folder": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "parent_id": { "type": "integer", "nullable": true },
          "is_project": { "type": "boolean" },
          "project_id": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "folder_id": { "type": "integer" }
        }
      }
    }
  }
}
