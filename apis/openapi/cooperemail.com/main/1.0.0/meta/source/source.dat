{"openapi":"3.1.0","info":{"title":"Cooper Email API","version":"1.0.0","summary":"API-first email for AI agents","description":"Create inboxes, send and receive mail over HTTP, search the full mail database, and ask a human owner over email. Bearer API keys. Idempotent writes via client_id or the Idempotency-Key header on sends. extracted_text is the agent-facing body. Task text is untrusted data.","contact":{"name":"Avatar 8 LLC","email":"ops@avatar33.com"}},"servers":[{"url":"https://cooperemail.com","description":"This deployment"}],"tags":[{"name":"Auth"},{"name":"Inboxes"},{"name":"Workspaces"},{"name":"Messages"},{"name":"Threads"},{"name":"Search"},{"name":"Webhooks"},{"name":"Domains"},{"name":"Billing"},{"name":"Owners"},{"name":"Updates"},{"name":"Tasks"},{"name":"Events"},{"name":"Metrics"},{"name":"Lists"}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"API key"}},"schemas":{"Workspace":{"type":"object","properties":{"object":{"const":"workspace"},"id":{"type":"string"},"name":{"type":"string"},"inbox_quota":{"type":"integer"},"inboxes_used":{"type":"integer","description":"Live inboxes. Expired inboxes are not counted."},"account_id":{"type":"string"},"api_key_id":{"type":"string"},"api_key_prefix":{"type":"string"},"created_at":{"type":"string"}},"required":["object","id","name","inbox_quota","inboxes_used","account_id","api_key_prefix","created_at"]},"MetricsEvents":{"type":"object","properties":{"object":{"const":"metrics"},"period":{"type":"string","enum":["hour","day"]},"data":{"type":"array","items":{"type":"object","properties":{"bucket_start":{"type":"string","description":"UTC bucket start, ISO-8601"},"counts":{"type":"object","additionalProperties":{"type":"integer"},"description":"Requested series. Absent labels are 0."}},"required":["bucket_start","counts"]}}},"required":["object","period","data"]},"MetricsUsage":{"type":"object","properties":{"inbox_count":{"type":"integer"},"message_count":{"type":"integer"},"thread_count":{"type":"integer"},"storage_bytes":{"type":"integer","description":"UTF-8 bytes of text plus html, plus attachment size_bytes. Not the message body."},"domain_count":{"type":"integer","description":"Omitted when the query or key is limited to one inbox."},"workspace_count":{"type":"integer","description":"Omitted when the query or key is limited to one inbox."}},"required":["inbox_count","message_count","thread_count","storage_bytes"]},"MetricsRates":{"type":"object","properties":{"sent":{"type":"integer"},"bounced":{"type":"integer"},"complained":{"type":"integer"},"bounce_rate":{"type":"number"},"complaint_rate":{"type":"number"}},"required":["sent","bounced","complained","bounce_rate","complaint_rate"]},"Draft":{"type":"object","properties":{"object":{"type":"string","enum":["draft"]},"id":{"type":"string"},"inbox_id":{"type":"string"},"to":{"type":"array","items":{"type":"string"}},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"reply_to":{"type":"string","nullable":true},"subject":{"type":"string"},"text":{"type":"string"},"html":{"type":"string","nullable":true},"preview":{"type":"string"},"labels":{"type":"array","items":{"type":"string"}},"in_reply_to":{"type":"string","nullable":true},"forward_of":{"type":"string","nullable":true},"reply_all":{"type":"boolean"},"send_status":{"type":"string","nullable":true,"enum":["scheduled","sending","failed",null]},"send_at":{"type":"string","format":"date-time","nullable":true},"approval_status":{"type":"string","nullable":true,"enum":["pending","approved","rejected",null]},"client_id":{"type":"string","nullable":true},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"DraftWrite":{"type":"object","properties":{"to":{"type":"array","items":{"type":"string"}},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"reply_to":{"type":"string"},"subject":{"type":"string"},"text":{"type":"string"},"html":{"type":"string"},"in_reply_to":{"type":"string","description":"Reply to this message. Mutually exclusive with forward_of."},"forward_of":{"type":"string","description":"Forward this message. Mutually exclusive with in_reply_to."},"reply_all":{"type":"boolean"},"send_at":{"type":"string","format":"date-time","nullable":true},"client_id":{"type":"string"}}},"DomainRecord":{"type":"object","properties":{"role":{"type":"string","enum":["mx","spf","dkim","dmarc","verify"]},"type":{"type":"string","enum":["MX","TXT","CNAME"]},"host":{"type":"string"},"value":{"type":"string"},"priority":{"type":"integer"},"status":{"type":"string","enum":["valid","missing","invalid"]},"found":{"type":"array","items":{"type":"string"}}},"required":["role","type","host","value","status","found"]},"Domain":{"type":"object","properties":{"object":{"type":"string","const":"domain"},"id":{"type":"string"},"domain":{"type":"string"},"status":{"type":"string","enum":["pending","verified"]},"status_detail":{"type":"string"},"mail":{"type":"object","properties":{"receiving":{"type":"boolean"},"sending":{"type":"boolean"},"inboxes":{"type":"boolean"}},"required":["receiving","sending","inboxes"]},"records":{"type":"array","items":{"$ref":"#/components/schemas/DomainRecord"}},"created_at":{"type":"string","format":"date-time"},"verified_at":{"type":"string","format":"date-time","nullable":true},"last_checked_at":{"type":"string","format":"date-time","nullable":true}},"required":["id","domain","status","status_detail","mail","records"]},"DomainDelete":{"type":"object","properties":{"id":{"type":"string"},"deleted":{"type":"boolean","const":true},"dns_cleanup":{"type":"object","properties":{"removed":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"string"}}},"required":["removed","errors"]}},"required":["id","deleted","dns_cleanup"]},"ApiKey":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"prefix":{"type":"string"},"inbox_id":{"type":"string","nullable":true},"permissions":{"type":"array","nullable":true,"items":{"type":"string"},"description":"Null means full access."},"created_at":{"type":"string","format":"date-time"},"last_used_at":{"type":"string","format":"date-time","nullable":true},"expires_at":{"type":"string","format":"date-time","nullable":true},"revoked_at":{"type":"string","format":"date-time","nullable":true}},"required":["id","name","prefix","inbox_id","permissions","created_at"]},"ApiKeyCreate":{"type":"object","properties":{"name":{"type":"string"},"inbox_id":{"type":"string","nullable":true},"permissions":{"type":"array","nullable":true,"items":{"type":"string"},"description":"Null or omitted means full access. Unknown names return 400 invalid_permission."},"ttl_hours":{"type":"number"},"expires_at":{"type":"string","format":"date-time"}}},"Me":{"type":"object","properties":{"account_id":{"type":"string"},"parent_account_id":{"type":"string","nullable":true},"auth_type":{"type":"string","enum":["api_key","oauth"]},"key":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"name":{"type":"string"},"prefix":{"type":"string"},"inbox_id":{"type":"string","nullable":true},"permissions":{"type":"array","nullable":true,"items":{"type":"string"}},"expires_at":{"type":"string","format":"date-time","nullable":true}}},"workspace":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"inbox_quota":{"type":"integer"}},"required":["id","inbox_quota"]},"lifecycle_emails":{"type":"string","enum":["on","off"],"description":"on stores the weekly product note. off stops it. The default is on."},"notices":{"type":"array","description":"Present when usage is at 80 percent of inboxes, monthly sends, or custom domains. Empty when it is not.","items":{"$ref":"#/components/schemas/LimitNotice"}},"whats_new":{"type":"array","description":"Newest two or three user-facing changelog highlights.","items":{"type":"object","properties":{"date":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"}},"required":["date","title","url"]}},"owner_recommended":{"type":"string","description":"Present when the account has no verified owner. Suggests POST /api/v1/inboxes/{id}/owners or owner_email on onboard, and mentions the 50 percent Free send increase for a verified external owner."}},"required":["account_id","parent_account_id","auth_type","key","workspace"]},"NextSteps":{"type":"object","properties":{"instruction":{"type":"string"},"docs_url":{"type":"string"},"recommended":{"type":"string","description":"Suggests adding a human owner email. A recommendation, not a requirement."},"snippets":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"}},"required":["id","title","url"]}}},"required":["instruction","docs_url","recommended","snippets"]},"LimitNotice":{"type":"object","properties":{"type":{"type":"string","enum":["limit_warning"]},"resource":{"type":"string","enum":["inboxes","emails","custom_domains"]},"used":{"type":"integer"},"limit":{"type":"integer"},"upgrade_url":{"type":"string"}},"required":["type","resource","used","limit","upgrade_url"]},"Error":{"type":"object","properties":{"error":{"type":"object","properties":{"type":{"type":"string"},"code":{"type":"string"},"message":{"type":"string"},"param":{"type":"string"},"docs_url":{"type":"string"}},"required":["type","code","message"]}}},"Inbox":{"type":"object","properties":{"id":{"type":"string"},"username":{"type":"string"},"email":{"type":"string"},"display_name":{"type":"string","nullable":true},"created_at":{"type":"string","format":"date-time"},"require_sender_auth":{"type":"boolean","description":"Default true. A verified owner or allowlisted sender creates a task only when DMARC=pass or DKIM=pass aligns with the From domain. Set false to opt this inbox out."},"labels":{"type":"array","items":{"type":"string"},"description":"Labels set at create time. Filter with GET /api/v1/inboxes?label="},"expires_at":{"type":"string","format":"date-time","nullable":true,"description":"When set, the inbox is temporary. The daily cron deletes it at this time and it stops counting toward the inbox limit."},"status":{"type":"string","enum":["active","paused"],"description":"active sends and stores inbound mail. paused keeps the address and history. A paused inbox still counts toward the plan inbox limit."},"paused_at":{"type":"string","format":"date-time","nullable":true,"description":"When the inbox was paused. Null while active. Unchanged if you pause an inbox that is already paused."},"metadata":{"type":"object","additionalProperties":true,"description":"Caller data. At most 256 keys. Each key is at most 256 characters. Values are a string, number, or boolean. The JSON form is at most 16 KB. A null value in a PATCH removes that key. Anything else is 400 invalid_metadata."},"client_id":{"type":"string","nullable":true,"description":"Idempotency key from POST /api/v1/inboxes, or null. The same client_id on this account returns the original inbox."},"screening":{"type":"string","enum":["off","observe","hold"],"description":"Inbound prompt-injection screen. Default observe. off skips scoring and records why. observe adds the suspicious label. hold stores suspicious mail with the held label and fires message.held instead of message.received. The screen is a heuristic, not a guarantee. It does not drop mail."},"send_mode":{"type":"string","enum":["direct","approval"],"description":"direct sends immediately. approval turns POST /messages, reply, reply-all, and forward into a pending draft and emails verified owners Approve and Reject links. Leaving approval for direct waits for a verified owner. Default direct."},"idempotent":{"type":"boolean","description":"True when POST /api/v1/inboxes replayed an existing client_id and returned the original inbox."}}},"Message":{"type":"object","properties":{"id":{"type":"string"},"inbox_id":{"type":"string"},"thread_id":{"type":"string"},"direction":{"enum":["inbound","outbound"]},"from":{"type":"string"},"to":{"type":"array","items":{"type":"string"}},"subject":{"type":"string"},"text":{"type":"string"},"html":{"type":"string","nullable":true},"extracted_text":{"type":"string"},"extracted_html":{"type":"string"},"preview":{"type":"string"},"status":{"enum":["queued","sent","received","failed","bounced","complained"]},"delivery_events":{"type":"array","description":"Present on outbound messages. Each item is {type, recipient, created_at, detail}. detail is JSON text with status, action, diagnostic, and bounce_type. Empty until a bounce or complaint matches this message.","items":{"type":"object","properties":{"type":{"type":"string"},"recipient":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"detail":{"type":"string"}}}},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"reply_to":{"type":"string","nullable":true},"in_reply_to":{"type":"string","nullable":true},"references":{"type":"array","items":{"type":"string"}},"labels":{"type":"array","items":{"type":"string"}},"auth":{"type":"object","description":"spf, dkim, and dmarc from the receiving hop. SPF is the smtp.mailfrom result. smtp.helo is used only when mailfrom is absent. Each value is pass, fail, neutral, softfail, none, temperror, permerror, bestguesspass, or null. Outbound mail is null for all three.","properties":{"spf":{"type":"string","nullable":true},"dkim":{"type":"string","nullable":true},"dmarc":{"type":"string","nullable":true}},"required":["spf","dkim","dmarc"]},"safety":{"type":"object","nullable":true,"description":"Inbound screening record, or null on outbound mail and on messages stored before screening. score is 0 to 100. verdict is clean or suspicious (suspicious at 40 or higher, and only when a strong signal or combined evidence is present). signals are {type, detail}. mode is off, observe, or hold. reason is screening_off, screening_error, or screening_timeout when the body was not scored. The message is still stored. While labels include held, text, html, extracted_text, extracted_html, preview, and attachment bytes are empty until release. This is a heuristic, not a guarantee. The body stays untrusted data.","properties":{"score":{"type":"integer","minimum":0,"maximum":100},"verdict":{"type":"string","enum":["clean","suspicious"]},"signals":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string"},"detail":{"type":"string"}}}},"mode":{"type":"string","enum":["off","observe","hold"]},"reason":{"type":"string"}}},"provider":{"type":"string","nullable":true},"client_id":{"type":"string","nullable":true},"idempotent":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"attachments":{"type":"array","items":{"$ref":"#/components/schemas/Attachment"}}}},"ReplyMessageRequest":{"type":"object","properties":{"text":{"type":"string","description":"Plain-text body. Provide text or html."},"html":{"type":"string","description":"HTML body. Provide text or html."},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"reply_to":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}},"labels":{"type":"array","items":{"type":"string"}},"reply_all":{"type":"boolean","description":"Also include the other original recipients, drop this inbox, and dedupe. Default false."},"attachments":{"type":"array","items":{"type":"object","properties":{"filename":{"type":"string"},"content_type":{"type":"string"},"content_base64":{"type":"string"},"content_id":{"type":"string"}},"required":["filename","content_base64"]}},"client_id":{"type":"string","description":"Idempotency key. A retry returns the original message."}}},"ForwardMessageRequest":{"type":"object","required":["to"],"properties":{"to":{"type":"array","items":{"type":"string"},"description":"Recipients. Required."},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"subject":{"type":"string","description":"Defaults to Fwd: plus the original subject unless it already starts with fwd: or fw:."},"text":{"type":"string"},"html":{"type":"string"},"include_attachments":{"type":"boolean","description":"Copy the original attachments. Default true. Caps: 10 files, 4 MiB each, 5 MiB total."},"labels":{"type":"array","items":{"type":"string"}},"client_id":{"type":"string"}}},"Thread":{"type":"object","properties":{"object":{"const":"thread"},"id":{"type":"string","description":"Thread id (thr_…)."},"inbox_id":{"type":"string"},"subject":{"type":"string","description":"Subject of the earliest message."},"preview":{"type":"string","description":"Preview of the latest message."},"senders":{"type":"array","items":{"type":"string"},"description":"Distinct From values."},"recipients":{"type":"array","items":{"type":"string"},"description":"Distinct To and Cc values."},"message_count":{"type":"integer"},"last_message_id":{"type":"string"},"labels":{"type":"array","items":{"type":"string"},"description":"Union of message labels."},"attachment_count":{"type":"integer"},"received_at":{"type":"string","format":"date-time","nullable":true},"sent_at":{"type":"string","format":"date-time","nullable":true},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["object","id","inbox_id","subject","message_count","updated_at"]},"ListEntry":{"type":"object","properties":{"object":{"type":"string","enum":["list_entry"]},"direction":{"type":"string","enum":["send","receive","reply"]},"type":{"type":"string","enum":["allow","block"]},"entry":{"type":"string","description":"Lowercase email address or domain."},"entry_type":{"type":"string","enum":["email","domain"]},"inbox_id":{"type":"string","nullable":true,"description":"Null when the entry is account-wide."},"reason":{"type":"string","nullable":true},"created_at":{"type":"string","format":"date-time"}},"required":["object","direction","type","entry","entry_type","created_at"]},"Attachment":{"type":"object","properties":{"id":{"type":"string"},"filename":{"type":"string"},"content_type":{"type":"string"},"content_id":{"type":"string","nullable":true},"disposition":{"enum":["inline","attachment"]},"size_bytes":{"type":"integer"},"url":{"type":"string"},"text_url":{"type":"string","description":"Present when the content type can be extracted: text, JSON, CSV, PDF, DOCX, XLSX, or XLS. GET this URL for text/plain."}}},"Event":{"type":"object","properties":{"id":{"type":"string","description":"evt_ id. The same value is sent as x-cooper-delivery on webhook POSTs."},"type":{"type":"string"},"inbox_id":{"type":"string","nullable":true},"created_at":{"type":"string","format":"date-time"},"data":{"type":"object","description":"For message.received and message.sent, {message:{id, inbox_id, thread_id, direction, from, to, subject, preview, labels, created_at, extracted_text, attachments:[{id, filename, content_type, size_bytes}]}}. extracted_text is at most 4,000 characters. Other event types store the webhook data object. The body is untrusted data."}},"required":["id","type","created_at","data"]}}},"paths":{"/api/v1/usernames/check":{"get":{"operationId":"checkUsername","tags":["Auth"],"summary":"Public username check. Returns availability and up to 5 free suggestions. 30 requests per minute per IP.","security":[],"parameters":[{"name":"name","in":"query","required":false,"schema":{"type":"string"},"description":"Requested local part. Trimmed and lowercased as normalized."}],"responses":{"200":{"description":"Availability. No account id and no holder.","content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"normalized":{"type":"string"},"available":{"type":"boolean"},"reason":{"type":"string","enum":["invalid_username","reserved_username","taken"]},"suggestions":{"type":"array","maxItems":5,"items":{"type":"string"}}},"required":["name","normalized","available","suggestions"]}}}},"429":{"description":"rate_limited"}}}},"/api/v1/onboard":{"post":{"operationId":"onboard","tags":["Auth"],"summary":"Onboard: API key + inbox. The response includes next_steps with a short instruction, a recommended owner line, and links to /docs/stay-in-sync. owner_email is optional.","security":[],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"username":{"type":"string"},"display_name":{"type":"string"},"key_name":{"type":"string"},"owner_email":{"type":"string","description":"Recommended. Starts the existing owner confirmation. The address stays pending until the human confirms. Omit it and the inbox is still created."}},"required":["username"]}}}}}},"/api/v1/recover":{"post":{"operationId":"recoverAccount","tags":["Auth"],"summary":"Email a recovery link to each verified external owner of the inbox address. Always returns HTTP 202 with the same body before the lookup and the email. 5 per hour per IP and 3 per day per address. An address at cooperemail.com or any subdomain, an inbox on any account, and any domain row are skipped. The key is not emailed.","security":[],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","description":"Inbox email address."}},"required":["address"]}}}},"responses":{"202":{"description":"Accepted. The body does not say whether an account exists."},"429":{"description":"rate_limited"}}}},"/api/v1/recover/confirm":{"get":{"operationId":"previewAccountRecovery","tags":["Auth"],"summary":"Confirm page for a recovery link. Opening the link does not revoke keys. An API key cannot open it.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"HTML confirm page."}}},"post":{"operationId":"confirmAccountRecovery","tags":["Auth"],"summary":"Revoke the account API keys and OAuth access and refresh tokens, then show a new full-access key once in the HTML page. The POST needs the csrf nonce from the GET page. A POST without that nonce does not mint a key. The key is not emailed and is not stored. A second POST does not show the key. An expired link does not mint a key.","security":[],"requestBody":{"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"token":{"type":"string"},"csrf":{"type":"string","description":"Nonce from the GET confirm page. Required while the recovery token is still valid."}},"required":["token"]}}}},"responses":{"200":{"description":"HTML page. The new key is included once."}}}},"/api/v1/keys":{"get":{"operationId":"listKeys","tags":["Auth"],"summary":"List API keys on this account. The secret is never returned. Requires key_read. An inbox-scoped key lists only keys for that inbox.","responses":{"200":{"description":"Key list","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","const":"list"},"data":{"type":"array","items":{"$ref":"#/components/schemas/ApiKey"}}},"required":["object","data"]}}}}}},"post":{"operationId":"createKey","tags":["Auth"],"summary":"Create an API key. Without Bearer this creates an account and a full-access key. With Bearer, name, inbox_id, permissions, and ttl_hours or expires_at are accepted. The secret is returned once.","security":[],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyCreate"}}}},"responses":{"201":{"description":"Key created. key is the secret and is not stored in plaintext."}}}},"/api/v1/keys/{id}":{"get":{"operationId":"getKey","tags":["Auth"],"summary":"Fetch one API key. Another account's key is 404 key_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKey"}}}}}},"patch":{"operationId":"renameKey","tags":["Auth"],"summary":"Rename an API key. Requires key_write.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"]}}}}},"delete":{"operationId":"revokeKey","tags":["Auth"],"summary":"Revoke an API key. Sets revoked_at. The next request with that key is 401 api_key_revoked, including the calling key.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/keys":{"post":{"operationId":"createInboxKey","tags":["Auth"],"summary":"Mint an API key scoped to this inbox. Do not send inbox_id in the body.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"Inbox id, username, or email"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyCreate"}}}}}},"/api/v1/me":{"get":{"operationId":"whoami","tags":["Auth"],"summary":"Account, auth type, key limits, workspace quota, lifecycle_emails, notices, whats_new, and owner_recommended when no owner is verified. OAuth returns key null and has full access. notices is present when usage is at 80 percent of a plan limit.","responses":{"200":{"description":"Caller","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}}}},"patch":{"operationId":"updateMe","tags":["Auth"],"summary":"Set lifecycle_emails to on or off. Returns the same object as GET /api/v1/me. Any live key can call it.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"lifecycle_emails":{"type":"string","enum":["on","off"]}},"required":["lifecycle_emails"]}}}},"responses":{"200":{"description":"Caller","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}}}}},"/api/v1/inboxes":{"get":{"operationId":"listInboxes","tags":["Inboxes"],"summary":"List inboxes. q is a case-insensitive substring of email, username, or display_name, and prefix matches come first. label= returns only inboxes with that label. status=active or status=paused filters by pause state. limit defaults to 100 and cannot exceed 500. page_token continues the list. The response includes next_page_token.","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"},"description":"Case-insensitive substring of email, username, or display_name. Prefix matches are listed first. % and _ match those characters."},{"name":"label","in":"query","required":false,"schema":{"type":"string"}},{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["active","paused"]},"description":"Filter by pause state. Unknown values return 400 invalid_status."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":500,"default":100},"description":"Page size. Default 100. Maximum 500. Outside that range is 400 invalid_limit."},{"name":"page_token","in":"query","required":false,"schema":{"type":"string"},"description":"Cursor from next_page_token. A bad token is 400 invalid_page_token."}]},"post":{"operationId":"createInbox","tags":["Inboxes"],"summary":"Create an inbox. username is optional; omit it and Cooper picks box plus 8 hex characters. client_id retries return the original inbox with HTTP 200 and idempotent true. Optional ttl_hours or expires_at makes it temporary. Optional domain is ignored while custom-domain mail is off. When that flag is on, domain must be verified on this account with mail.receiving true (404 domain_not_found, 409 domain_not_verified, 409 domain_receiving_not_ready). Invalid metadata is 400 invalid_metadata. Optional notify_url registers a message.received webhook for the new inbox. The response includes next_steps, including recommended, which suggests adding a human owner email. When usage is at 80 percent of a plan limit, the response includes notices.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"username":{"type":"string","description":"Optional local part. Omit it and Cooper picks box plus 8 hex characters."},"domain":{"type":"string","description":"Optional customer hostname. Ignored while custom-domain mail is off."},"display_name":{"type":"string"},"metadata":{"type":"object","additionalProperties":true,"description":"Caller data. At most 256 keys, keys at most 256 characters, values string number or boolean, serialized at most 16 KB."},"client_id":{"type":"string","maxLength":128,"description":"Idempotency key. The same value on this account returns the original inbox."},"ttl_hours":{"type":"number"},"expires_at":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["active","paused"]},"notify_url":{"type":"string","description":"Optional public http(s) URL. Registers a message.received webhook for the new inbox. Localhost and private addresses are rejected."}}}}}}}},"/api/v1/inboxes/{id}/notify":{"post":{"operationId":"notifyInbox","tags":["Inboxes"],"summary":"Register a message.received webhook for this inbox. The URL must be public http or https. Localhost, a private IP, and a name that resolves to one are rejected. The default client_id is notify:{inbox id}. A second call updates the URL. The signing secret is returned on the first create and redacted after that. Deliveries send x-cooper-signature, x-cooper-signature-v2, x-cooper-timestamp, and x-cooper-delivery. A redirect is not followed.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string"},"client_id":{"type":"string","maxLength":128}},"required":["url"]}}}}}},"/api/v1/inboxes/{id}/wait":{"get":{"operationId":"waitForInbox","tags":["Inboxes"],"summary":"Hold until unread mail is stored. Returns immediately when unread mail is already there. wait is an integer from 0 to 55 and defaults to 25. The response is object inbox_wait with inbox_id, timed_out, and data. The server checks about once a second. A key can hold at most 5 waits at once, and the next returns HTTP 429 rate_limited. GET /api/v1/events wait still caps at 25 seconds.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"wait","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":55,"default":25},"description":"Seconds to hold. Default 25. Maximum 55."}]}},"/api/v1/workspaces":{"get":{"operationId":"listWorkspaces","tags":["Workspaces"],"summary":"List sub-accounts for this parent key. API keys are not returned."},"post":{"operationId":"createWorkspace","tags":["Workspaces"],"summary":"Create a sub-account with its own API key and an inbox quota set by the parent. Usage counts toward the parent plan.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"inbox_quota":{"type":"integer","minimum":1},"client_id":{"type":"string"}},"required":["name","inbox_quota"]}}}}}},"/api/v1/workspaces/{id}":{"get":{"operationId":"getWorkspace","tags":["Workspaces"],"summary":"One sub-account for this parent key. Returns id, name, inbox_quota, inboxes_used, account_id, api_key_prefix, and created_at. The API key secret is not returned. Another parent's workspace is 404 workspace_not_found. A sub-account key is 403 permission_denied. An inbox-scoped key is 403 permission_denied.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The workspace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}}}},"patch":{"operationId":"updateWorkspace","tags":["Workspaces"],"summary":"Change name and/or inbox_quota. An inbox_quota below the live inbox count is 409 quota_below_usage and changes nothing. Another parent's workspace is 404 workspace_not_found. A sub-account key is 403 permission_denied.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":64},"inbox_quota":{"type":"integer","minimum":1}}}}}},"responses":{"200":{"description":"The updated workspace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}}}},"delete":{"operationId":"deleteWorkspace","tags":["Workspaces"],"summary":"Remove a sub-account. With inboxes and without delete_inboxes=true, the call is 409 workspace_not_empty and deletes nothing. delete_inboxes=true deletes direct inboxes (messages, attachments, owners, and tasks), then the workspace API keys, OAuth tokens, webhooks, domains, and the child account. An approval inbox returns HTTP 409 owner_required and deletes nothing until its owner confirms. The child key then returns 401. Parent plan usage no longer counts that sub-account. Another parent's workspace is 404 workspace_not_found. A sub-account key is 403 permission_denied.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"delete_inboxes","in":"query","required":false,"schema":{"type":"boolean"},"description":"true deletes the workspace inboxes. Required when any inbox remains."}],"responses":{"200":{"description":"The workspace was deleted","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"workspace"},"id":{"type":"string"},"deleted":{"const":true},"inboxes_deleted":{"type":"integer"}},"required":["id","deleted","inboxes_deleted"]}}}}}}},"/api/v1/workspaces/{id}/inboxes":{"get":{"operationId":"listWorkspaceInboxes","tags":["Workspaces"],"summary":"List inboxes on this sub-account. Same shape as GET /api/v1/inboxes, including q, label, status, limit, page_token, and next_page_token. The parent key calls this. A sub-account key is 403 permission_denied. Another parent's workspace is 404 workspace_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"label","in":"query","required":false,"schema":{"type":"string"}},{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["active","paused"]}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":500}},{"name":"page_token","in":"query","required":false,"schema":{"type":"string"}}]}},"/api/v1/workspaces/{id}/inboxes/{inboxId}":{"delete":{"operationId":"deleteWorkspaceInbox","tags":["Workspaces"],"summary":"Delete one inbox on this sub-account. inboxId accepts an inbox id, username, or email on that workspace. Frees the plan slot and the workspace quota. An inbox on another workspace is 404 inbox_not_found. Another parent's workspace is 404 workspace_not_found. A sub-account key is 403 permission_denied.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"inboxId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/batch":{"post":{"operationId":"createInboxes","tags":["Inboxes"],"summary":"Create count inboxes. Optional prefix, labels, metadata (stored on every inbox), and ttl_hours or expires_at. count is capped per plan. Temporary inboxes count toward the plan inbox limit until the cron deletes them. Invalid metadata is 400 invalid_metadata.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"count":{"type":"integer","minimum":1},"prefix":{"type":"string"},"labels":{"type":"array","items":{"type":"string"}},"ttl_hours":{"type":"number"},"expires_at":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["active","paused"],"description":"Applied to every inbox in the batch. Default active."},"metadata":{"type":"object","additionalProperties":true,"description":"Stored on every inbox in the batch. Same limits as a single create. 400 invalid_metadata otherwise."}},"required":["count"]}}}}}},"/api/v1/inboxes/{id}":{"get":{"operationId":"getInbox","tags":["Inboxes"],"summary":"Get inbox by id, username, or email","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"deleteInbox","tags":["Inboxes"],"summary":"Delete an inbox owned by this key. Frees the plan inbox slot and a workspace inbox quota. An approval inbox returns HTTP 202 and stays until a verified owner confirms POST /api/v1/inboxes/delete/confirm. Recreating that username on the same account stays in approval mode.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"patch":{"operationId":"updateInbox","tags":["Inboxes"],"summary":"Pause or resume an inbox, set display_name, merge metadata, set require_sender_auth, set screening, and/or set send_mode. status paused stops sends (403 inbox_paused) and drops real inbound mail. status active resumes. display_name null clears the name. A metadata null value removes that key. screening is off, observe, or hold. Anything else is 400 invalid_screening. send_mode is direct or approval. Entering approval applies immediately when the inbox has a verified owner. An inbox already in approval can be set back to direct only when it has never had a verified owner. An unsubscribed owner, or a username pinned by an owner-confirmed delete, stays in approval. Leaving approval for direct returns HTTP 202 and emails verified owners, including PATCH /api/v1/inboxes/batch. The stored copy of that email omits the token. An API key cannot submit the owner link. Anything else is 400 invalid_send_mode. No verified owner is HTTP 409 owner_required. At least one field is required. Invalid metadata is 400 invalid_metadata.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"require_sender_auth":{"type":"boolean"},"status":{"type":"string","enum":["active","paused"]},"display_name":{"type":"string","nullable":true,"description":"From display name. Null clears it."},"metadata":{"type":"object","additionalProperties":true,"description":"Merged into the current metadata. A null value removes that key. At most 256 keys and 16 KB."},"screening":{"type":"string","enum":["off","observe","hold"],"description":"off skips scoring. observe labels suspicious mail. hold stores it for review. 400 invalid_screening otherwise."},"send_mode":{"type":"string","enum":["direct","approval"],"description":"Entering approval applies immediately when a verified owner exists. No verified owner is HTTP 409 owner_required. An inbox already in approval can return to direct only when it has never had a verified owner. An unsubscribed owner still blocks that switch. Leaving approval for direct returns HTTP 202 and emails verified owners. 400 invalid_send_mode otherwise."}}}}}}}},"/api/v1/inboxes/{id}/messages":{"get":{"operationId":"listMessages","tags":["Messages"],"summary":"List messages, newest first unless ascending=true. Filters and labels run before limit (max 200). The response includes next_page_token.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","maximum":200}},{"name":"labels","in":"query","schema":{"type":"string"},"description":"Comma-separated labels. The message must have each one. labels=unread lists unread mail."},{"name":"unread","in":"query","schema":{"type":"string","enum":["true","false"]},"description":"true keeps messages labeled unread. false omits them."},{"name":"before","in":"query","schema":{"type":"string"},"description":"ISO-8601 exclusive upper bound on created_at. A bad value is 400 invalid_date."},{"name":"after","in":"query","schema":{"type":"string"},"description":"ISO-8601 exclusive lower bound on created_at. A bad value is 400 invalid_date."},{"name":"from","in":"query","schema":{"type":"string"},"description":"Case-insensitive substring of From. % and _ are matched literally."},{"name":"to","in":"query","schema":{"type":"string"},"description":"Case-insensitive substring of To or Cc. % and _ are matched literally."},{"name":"subject","in":"query","schema":{"type":"string"},"description":"Case-insensitive substring of the subject. % and _ are matched literally."},{"name":"direction","in":"query","schema":{"type":"string","enum":["inbound","outbound"]},"description":"inbound or outbound. Anything else is 400 invalid_direction."},{"name":"thread_id","in":"query","schema":{"type":"string"},"description":"Only messages on this thread."},{"name":"ascending","in":"query","schema":{"type":"string","enum":["true","false"]},"description":"true lists oldest first. A value other than true or false is 400 invalid_ascending."},{"name":"page_token","in":"query","schema":{"type":"string"},"description":"Cursor from next_page_token (base64url of created_at and id). A bad token is 400 invalid_page_token."}]},"post":{"operationId":"sendMessage","tags":["Messages"],"summary":"Send a message (text, html, attachments). A paused inbox returns 403 inbox_paused and does not send or count usage. Allow and block lists are checked before the provider is called. HTTP 403 recipient_blocked means nothing is sent, stored, or counted. HTTP 403 recipient_suppressed means the address is on the suppression list and nothing is sent, stored, or counted. Progress email to a verified owner is exempt from allow and block lists. Outbound JSON includes delivery_events. Idempotency-Key replays the same request for 24 hours. When usage is at 80 percent of a plan limit, the response includes notices.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"to":{"type":"array","items":{"type":"string"}},"subject":{"type":"string"},"text":{"type":"string"},"html":{"type":"string"},"cc":{"type":"array","items":{"type":"string"}},"bcc":{"type":"array","items":{"type":"string"}},"reply_to":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}},"labels":{"type":"array","items":{"type":"string"}},"in_reply_to":{"type":"string","description":"A msg_ id in this inbox uses that message's Message-ID on the wire and its thread_id. Any other value is sent as In-Reply-To."},"attachments":{"type":"array","items":{"type":"object","properties":{"filename":{"type":"string"},"content_type":{"type":"string"},"content_base64":{"type":"string"},"content_id":{"type":"string"}},"required":["filename","content_base64"]}},"client_id":{"type":"string"}},"required":["to"]}}}}}},"/api/v1/inboxes/{id}/messages/search":{"get":{"operationId":"searchInboxMessages","tags":["Search"],"summary":"Full-text search in one inbox. limit is at most 100. before and after are exclusive ISO-8601 bounds on created_at. Each result includes highlights with matched words wrapped in ** and about 80 characters of context. Empty q is 400 missing_query. A bad date is 400 invalid_date.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"q","in":"query","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","maximum":100}},{"name":"before","in":"query","schema":{"type":"string"}},{"name":"after","in":"query","schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/messages/batch-get":{"post":{"operationId":"batchGetMessages","tags":["Messages"],"summary":"Fetch up to 500 messages by id. Duplicates are 400 duplicate_message_ids. More than 500 ids are 400 too_many_ids. Unknown ids are returned in not_found. Another account's inbox is 404 inbox_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"message_ids":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"string"}}},"required":["message_ids"]}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/reply":{"post":{"operationId":"replyToMessage","tags":["Messages"],"summary":"Reply on the same thread. text or html is required. reply_all includes the other recipients and drops this inbox. Allow and block lists are checked; 403 recipient_blocked sends nothing. client_id retries return the original message. Idempotency-Key replays the same request for 24 hours. The message id is part of the request.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReplyMessageRequest"}}}},"responses":{"200":{"description":"Idempotent client_id retry","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"201":{"description":"Sent reply","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/reply-all":{"post":{"operationId":"replyAllMessage","tags":["Messages"],"summary":"Reply-all. Same as reply with the other recipients included. Allow and block lists are checked; 403 recipient_blocked sends nothing. The body has no reply_all field. Idempotency-Key replays the same request for 24 hours.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReplyMessageRequest"}}}},"responses":{"201":{"description":"Sent reply-all","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/forward":{"post":{"operationId":"forwardMessage","tags":["Messages"],"summary":"Forward on a new thread. Copies original attachments unless include_attachments is false. 400 attachments_too_large when caps are exceeded. Allow and block lists are checked; 403 recipient_blocked sends nothing. Idempotency-Key replays the same request for 24 hours.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForwardMessageRequest"}}}},"responses":{"201":{"description":"Sent forward","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}}}}},"/api/v1/inboxes/{id}/drafts":{"get":{"operationId":"listInboxDrafts","tags":["Drafts"],"summary":"List drafts in one inbox. labels must all match. limit is 1 to 100 (default 50).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"labels","in":"query","schema":{"type":"string"},"description":"Comma-separated labels. Every label must match."},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"page_token","in":"query","schema":{"type":"string"}}]},"post":{"operationId":"createDraft","tags":["Drafts"],"summary":"Create a draft. in_reply_to or forward_of derives threading from that message. send_at schedules it and adds the scheduled label. Idempotency-Key and client_id replay the original draft.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DraftWrite"}}}},"responses":{"201":{"description":"Created draft","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Draft"}}}}}}},"/api/v1/inboxes/{id}/drafts/{draftId}":{"get":{"operationId":"getDraft","tags":["Drafts"],"summary":"Get one draft","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"draftId","in":"path","required":true,"schema":{"type":"string"}}]},"patch":{"operationId":"updateDraft","tags":["Drafts"],"summary":"Update a draft. Omit a field to leave it unchanged. Null clears it. send_at null unschedules. HTTP 409 draft_sending while a send is in progress.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"draftId","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"deleteDraft","tags":["Drafts"],"summary":"Delete a draft. This cancels a scheduled send. HTTP 409 draft_sending while a send is in progress.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"draftId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/drafts/{draftId}/send":{"post":{"operationId":"sendDraft","tags":["Drafts"],"summary":"Send a draft now. The draft is deleted and the response is the message. Approval mode returns HTTP 202 and the pending draft until an owner approves. Allow and block lists and the suppression list apply. Idempotency-Key replays the result.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"draftId","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}]}},"/api/v1/inboxes/{id}/drafts/{draftId}/attachments/{attId}":{"get":{"operationId":"getDraftAttachment","tags":["Drafts"],"summary":"Download one draft attachment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"draftId","in":"path","required":true,"schema":{"type":"string"}},{"name":"attId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/drafts":{"get":{"operationId":"listDrafts","tags":["Drafts"],"summary":"List drafts on this account. An inbox-scoped key sees only its inbox. Optional inbox_id filters further.","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string"}},{"name":"labels","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"page_token","in":"query","schema":{"type":"string"}}]}},"/api/v1/drafts/approve":{"get":{"operationId":"previewApproveDraft","tags":["Drafts"],"summary":"Confirm page for an owner approval link. Opening it does not approve the draft.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"approveDraft","tags":["Drafts"],"summary":"Approve the draft. The token and the csrf nonce from the GET page are read from the form or JSON body. A POST without that nonce does not approve. Sends when send_at is due or unset.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"},"csrf":{"type":"string","description":"Nonce from the GET page. Required while the token is still valid."}},"required":["token"]}}}}}},"/api/v1/drafts/reject":{"get":{"operationId":"previewRejectDraft","tags":["Drafts"],"summary":"Confirm page for an owner rejection link. Opening it does not reject the draft.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"rejectDraft","tags":["Drafts"],"summary":"Reject the draft. The token and the csrf nonce from the GET page are read from the form or JSON body. A POST without that nonce does not reject. Clears the schedule and keeps the draft.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"},"csrf":{"type":"string","description":"Nonce from the GET page. Required while the token is still valid."}},"required":["token"]}}}}}},"/api/v1/inboxes/send-mode/confirm":{"get":{"operationId":"previewLeaveApproval","tags":["Inboxes"],"summary":"Confirm page for leaving approval mode. Opening the link does not change send_mode.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"confirmLeaveApproval","tags":["Inboxes"],"summary":"Owner confirms direct send. The token is read from the form or JSON body. An Authorization header is rejected. The copy stored in the agent inbox omits the token.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}},"required":["token"]}}}}}},"/api/v1/inboxes/send-mode/cancel":{"get":{"operationId":"previewKeepApproval","tags":["Inboxes"],"summary":"Confirm page for keeping approval mode. Opening the link does not change send_mode.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"cancelLeaveApproval","tags":["Inboxes"],"summary":"Owner keeps approval mode. The token is read from the form or JSON body.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}},"required":["token"]}}}}}},"/api/v1/inboxes/delete/confirm":{"get":{"operationId":"previewDeleteInbox","tags":["Inboxes"],"summary":"Confirm page for deleting an approval inbox. Opening the link does not delete it.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"confirmDeleteInbox","tags":["Inboxes"],"summary":"Owner confirms deletion. The token is read from the form or JSON body. An Authorization header is rejected.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}},"required":["token"]}}}}}},"/api/v1/inboxes/delete/cancel":{"get":{"operationId":"previewKeepInbox","tags":["Inboxes"],"summary":"Confirm page for keeping an approval inbox. Opening the link does not decide.","security":[],"parameters":[{"name":"token","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"cancelDeleteInbox","tags":["Inboxes"],"summary":"Owner keeps the inbox. The token is read from the form or JSON body. An Authorization header is rejected.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}},"required":["token"]}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}":{"get":{"operationId":"getMessage","tags":["Messages"],"summary":"Get a message (includes attachment metadata)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"deleteMessage","tags":["Messages"],"summary":"Delete one message, its raw RFC822, cached attachment text, attachment bytes, and its search row. Owner tasks and updates stay. Returns {id, deleted:true}. Another account's message is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}]},"patch":{"operationId":"updateMessage","tags":["Messages"],"summary":"Add or remove labels. Mark read with remove_labels [\"unread\"]. read and unread can change. Other system labels cannot. Works on a paused inbox. Another account's message is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"add_labels":{"type":"array","items":{"type":"string"}},"remove_labels":{"type":"array","items":{"type":"string"}}}}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/release":{"post":{"operationId":"releaseMessage","tags":["Messages"],"summary":"Release a message that inbound screening held. Removes the held label, fires message.received, and creates a task when the sender is eligible. A message that is not held returns 409 message_not_held and fires nothing. Another account's message is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Released message","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/read":{"post":{"operationId":"markMessageRead","tags":["Messages"],"summary":"Mark a message read (remove unread, add read). Works on a paused inbox. Another account's message is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/messages/{msgId}/raw":{"get":{"operationId":"downloadMessageRaw","tags":["Messages"],"summary":"Download the message as message/rfc822 with Content-Disposition attachment and filename {msgId}.eml. Quotes, CR, LF, other control characters, and path separators are removed from the filename. A non-ASCII name also sets filename* (RFC 5987 UTF-8). Responses set X-Content-Type-Options: nosniff, Content-Security-Policy: default-src 'none'; sandbox; frame-ancestors 'none', X-Frame-Options: DENY, and Referrer-Policy: no-referrer. Cache-Control is private. There is no Cross-Origin-Resource-Policy header. ?download=1 also forces attachment. Inbound mail returns the stored raw body. A raw body of 200,000 characters or more is stored as the first 200,000 characters and sets x-cooper-raw-truncated: 1. Inbound mail with no stored raw returns 404 raw_not_available. Outbound mail is rebuilt from stored fields and sets X-Cooper-Reconstructed: 1. A held message returns HTTP 409 message_held until release. Another account's message is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"RFC822 bytes.","content":{"message/rfc822":{"schema":{"type":"string","format":"binary"}}}}}}},"/api/v1/inboxes/{id}/messages/{msgId}/attachments/{attId}":{"get":{"operationId":"downloadAttachment","tags":["Messages"],"summary":"Download attachment bytes. Inline only when the stored disposition is inline and the type is image/png, image/jpeg, image/gif, image/webp, image/avif, audio/*, or video/*. Every other type, including image/svg+xml, text/html, application/xhtml+xml, text/xml, application/xml, application/javascript, and unknown types, is attachment. HTML, XHTML, SVG, XML, and JavaScript are served as application/octet-stream. Message JSON still reports the stored content_type. ?download=1 forces attachment. Filenames drop quotes, CR, LF, other control characters, and path separators. A non-ASCII name also sets filename* (RFC 5987 UTF-8). Responses set X-Content-Type-Options: nosniff, Content-Security-Policy: default-src 'none'; sandbox; frame-ancestors 'none', X-Frame-Options: DENY, and Referrer-Policy: no-referrer. Cache-Control is private. There is no Cross-Origin-Resource-Policy header. A held message returns HTTP 409 message_held.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}},{"name":"attId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/messages/{msgId}/attachments/{attId}/text":{"get":{"operationId":"extractAttachmentText","tags":["Messages"],"summary":"Extract attachment text as text/plain; charset=utf-8 with Content-Disposition attachment. The filename drops quotes, CR, LF, other control characters, and path separators. A non-ASCII name also sets filename* (RFC 5987 UTF-8). Responses set X-Content-Type-Options: nosniff, Content-Security-Policy: default-src 'none'; sandbox; frame-ancestors 'none', X-Frame-Options: DENY, and Referrer-Policy: no-referrer. Cache-Control is private. There is no Cross-Origin-Resource-Policy header. Supports text, JSON, CSV, PDF text, DOCX, XLSX, and XLS. Input cap 10 MB. Inflated bytes past 50 MB, a lying central directory that hides that expansion, or a spreadsheet that declares more than 10,000 rows by 256 columns is HTTP 400 attachment_too_large. A zip is checked even when the declared type is the legacy spreadsheet type. A file that cannot be read is HTTP 400 text_extraction_failed. Extraction stops after 10 seconds. Output cap 200,000 characters (x-cooper-text-truncated: 1). An image-only PDF is HTTP 200 with an empty body and x-cooper-text-empty: 1. Unsupported types are HTTP 415 text_extraction_unsupported. Successful and failed extractions are cached. A held message returns HTTP 409 message_held until release. Another account's attachment is 404.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"msgId","in":"path","required":true,"schema":{"type":"string"}},{"name":"attId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Extracted plain text.","content":{"text/plain":{"schema":{"type":"string"}}}}}}},"/api/v1/inboxes/{id}/threads":{"get":{"operationId":"listInboxThreads","tags":["Threads"],"summary":"List threads in one inbox, newest activity first. limit 1–100 (default 20). page_token is base64url of updated_at|thread_id. Bad token is 400 invalid_page_token.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"page_token","in":"query","schema":{"type":"string"}},{"name":"before","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"after","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"ascending","in":"query","schema":{"type":"boolean"}}]}},"/api/v1/threads":{"get":{"operationId":"listThreads","tags":["Threads"],"summary":"List threads on the account. Optional inbox_id filters to one inbox.","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"page_token","in":"query","schema":{"type":"string"}},{"name":"before","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"after","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"ascending","in":"query","schema":{"type":"boolean"}}]}},"/api/v1/inboxes/{id}/threads/search":{"get":{"operationId":"searchThreads","tags":["Threads"],"summary":"Threads in this inbox with at least one matching message. limit 1–50 (default 20). Empty q is 400 missing_query.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"q","in":"query","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50}}]}},"/api/v1/inboxes/{id}/threads/{threadId}":{"get":{"operationId":"getInboxThread","tags":["Threads"],"summary":"Thread plus messages, oldest first, including extracted_text. limit 1–200 (default 100). Unknown thread is 404 thread_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"threadId","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":200}},{"name":"page_token","in":"query","schema":{"type":"string"}}]},"patch":{"operationId":"updateThread","tags":["Threads"],"summary":"Add or remove labels on every message in the thread. Same rules as message labels. Works on a paused inbox.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"threadId","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"add_labels":{"type":"array","items":{"type":"string"}},"remove_labels":{"type":"array","items":{"type":"string"}}}}}}}},"delete":{"operationId":"deleteThread","tags":["Threads"],"summary":"Delete every message in the thread, plus raw RFC822, cached attachment text, attachment bytes, and search rows. Owner tasks and updates stay. Returns {id, deleted:true, messages_deleted}.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"threadId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/threads/{threadId}":{"get":{"operationId":"getThread","tags":["Threads"],"summary":"Thread plus messages for this account. Unknown thread is 404 thread_not_found.","parameters":[{"name":"threadId","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":200}},{"name":"page_token","in":"query","schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/threads/{threadId}/attachments/{attId}":{"get":{"operationId":"downloadThreadAttachment","tags":["Threads"],"summary":"Download an attachment that belongs to this thread. Same bytes and headers as the message attachment route: inline only for image/png, image/jpeg, image/gif, image/webp, image/avif, audio/*, and video/* when disposition is inline; other types are attachment; html, xhtml, svg, xml, and javascript are application/octet-stream; ?download=1 forces attachment. Filenames drop quotes, CR, LF, other control characters, and path separators, and a non-ASCII name sets filename* (RFC 5987 UTF-8). X-Content-Type-Options is nosniff, Content-Security-Policy is default-src 'none'; sandbox; frame-ancestors 'none', X-Frame-Options is DENY, and Referrer-Policy is no-referrer. Cache-Control is private. There is no Cross-Origin-Resource-Policy header. Unknown thread is thread_not_found. An attachment outside the thread is attachment_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"threadId","in":"path","required":true,"schema":{"type":"string"}},{"name":"attId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/inbound":{"post":{"operationId":"injectInbound","tags":["Messages"],"summary":"Inject inbound mail for tests (Bearer). A paused inbox returns 403 inbox_paused. A sender blocked by an allow or block list returns 403 sender_blocked and is not stored. Production inbound drops paused inboxes with HTTP 200, and drops a blocked sender with HTTP 200 and reason sender_blocked.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/search":{"get":{"operationId":"searchMessages","tags":["Search"],"summary":"Full-text search across stored mail. Optional inbox_id limits the search to one inbox. before and after are exclusive ISO-8601 bounds on created_at. Each result includes highlights. limit is at most 100. Empty q is 400 missing_query. A bad date is 400 invalid_date. An unknown inbox_id is 404 inbox_not_found.","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","maximum":100}},{"name":"inbox_id","in":"query","schema":{"type":"string"},"description":"Inbox id, username, or email. Omit to search every inbox on the account."},{"name":"before","in":"query","schema":{"type":"string"}},{"name":"after","in":"query","schema":{"type":"string"}}]}},"/api/v1/domains":{"get":{"operationId":"listDomains","tags":["Domains"],"summary":"List custom domains and their DNS status"},"post":{"operationId":"createDomain","tags":["Domains"],"summary":"Add a custom domain and return SPF, DKIM, DMARC, and MX records. When usage is at 80 percent of a plan limit, the response includes notices.","description":"Starter and Pro (plan customDomains, plus extra domain quantity on the subscription). Returns the records to publish and a verify TXT. Each record has status valid, missing, or invalid and found from the last check. The domain includes mail and status_detail. Calling again with the same domain or client_id returns the original domain. Cooper writes DNS only when the hostname is already inside a Cloudflare zone on the operator account. It does not register a domain or create a zone. The daily digest cron checks DNS and sends domain.verified when the records match. Free returns HTTP 402 plan_limit_exceeded. Inboxes on your own domain are included on Starter (15 custom domains) and Pro (200 custom domains). Free includes 0 custom domains and returns HTTP 402 plan_limit_exceeded. When the hostname is already a zone on the operator Cloudflare account, Cooper writes the DNS records and dns.mode is automatic. Cooper does not register a domain or create a zone. Any other zone stays manual. Publish the routing MX hosts, TXT SPF v=spf1 include:_spf.mx.cloudflare.net ~all, the routing DKIM TXT, the cf-bounce MX, SPF, and DKIM records, a DMARC TXT (an existing DMARC record is left as it is), and the _cooper-verify TXT. mail.receiving stays false until the receiving records check out and the catch-all is live. Receiving goes live within a few minutes. status_detail says so while you wait. POST /api/v1/inboxes with domain then creates username@domain. DELETE /api/v1/domains/:id puts back the catch-all that was there before, deletes only the DNS records Cooper created, turns Email Routing off only if Cooper turned it on, and removes the sending domain only if Cooper created it. A cleanup that does not finish keeps the row with status cleanup_failed and deleted false so a later delete can finish it.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string","description":"Hostname, such as agents.example.com"},"client_id":{"type":"string","description":"Optional idempotency key"}},"required":["domain"]}}}}}},"/api/v1/domains/{id}":{"get":{"operationId":"getDomain","tags":["Domains"],"summary":"Get custom domain status","description":"status is pending until SPF, DKIM, DMARC, MX, and the verify record match, then verified. Includes mail, status_detail, and per-record status.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Domain","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Domain"}}}},"404":{"description":"domain_not_found"}}},"delete":{"operationId":"deleteDomain","tags":["Domains"],"summary":"Delete a custom domain","description":"Removes the domain. When dns.mode is automatic, deletes only the DNS records Cooper wrote. Returns dns_cleanup. Another account's id is 404 domain_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DomainDelete"}}}},"404":{"description":"domain_not_found"}}}},"/api/v1/domains/{id}/verify":{"post":{"operationId":"verifyDomain","tags":["Domains"],"summary":"Verify a custom domain now","description":"Runs the cron DNS check for this domain, stores per-record status, and fires domain.verified once on the pending to verified transition. At most once per 60 seconds. HTTP 429 rate_limited includes Retry-After. Another account's id is 404 domain_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Domain","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Domain"}}}},"404":{"description":"domain_not_found"},"429":{"description":"rate_limited"}}}},"/api/v1/domains/{id}/zone-file":{"get":{"operationId":"domainZoneFile","tags":["Domains"],"summary":"Download BIND zone lines for a custom domain","description":"text/plain BIND-style lines for every required record. Another account's id is 404 domain_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Zone file","content":{"text/plain":{"schema":{"type":"string"}}}},"404":{"description":"domain_not_found"}}}},"/api/v1/webhooks":{"get":{"operationId":"listWebhooks","tags":["Webhooks"],"summary":"List webhooks","description":"Includes inbox_id, inbox_ids, enabled, consecutive_failures, disabled_at, disabled_reason, header names with values redacted, last_delivery_status, and last_delivery_at. Secrets are truncated."},"post":{"operationId":"createWebhook","tags":["Webhooks"],"summary":"Register a webhook (message.received, message.held, message.sent, message.blocked, message.bounced, message.complained, task.received, owner.reply, domain.verified, draft.created, draft.approved, draft.rejected, draft.sent)","description":"Cooper signs the raw JSON body with HMAC-SHA256. x-cooper-signature is sha256=<hex> of the raw body. x-cooper-timestamp is unix seconds. x-cooper-signature-v2 is v1=<hex HMAC-SHA256 of timestamp + '.' + raw body>. Reject timestamps more than 5 minutes off and dedupe on x-cooper-delivery. Optional headers (max 5, Authorization or X-*) are stored encrypted, redacted on read, and sent on every delivery. inbox_id is stored into inbox_ids. inbox_ids accepts at most 10 ids (400 too_many_inboxes). An empty inbox_ids matches every inbox. The same client_id returns HTTP 200 and the original hook with the secret redacted. 5xx and network errors are retried. A final non-2xx increments consecutive_failures. At 20 the hook is disabled with disabled_reason consecutive_failures. Any 2xx resets the counter.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string"},"events":{"type":"array","items":{"type":"string","enum":["message.received","message.held","message.sent","message.blocked","message.bounced","message.complained","task.received","owner.reply","domain.verified","draft.created","draft.approved","draft.rejected","draft.sent"]}},"secret":{"type":"string"},"inbox_id":{"type":"string","nullable":true,"description":"Fire only for this inbox. Stored into inbox_ids. Omit to receive every inbox on the account."},"inbox_ids":{"type":"array","items":{"type":"string"},"description":"At most 10 inbox ids. Empty matches every inbox. More than 10 is 400 too_many_inboxes."},"client_id":{"type":"string","description":"Idempotency key. The same value returns the original hook with HTTP 200 and a redacted secret."},"headers":{"type":"object","description":"At most 5 headers. Names must be Authorization or X-* (not x-cooper-signature, x-cooper-signature-v2, x-cooper-timestamp, x-cooper-event, or x-cooper-delivery). Values max 1024 characters. GET returns the names with values redacted.","additionalProperties":{"type":"string"}}},"required":["url"]}}}}}},"/api/v1/webhooks/{id}":{"get":{"operationId":"getWebhook","tags":["Webhooks"],"summary":"Get a webhook","description":"Secret is redacted the same way as the list. Another account's id is 404 webhook_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Webhook"},"404":{"description":"webhook_not_found"}}},"patch":{"operationId":"updateWebhook","tags":["Webhooks"],"summary":"Update a webhook","description":"Partial update. Pass inbox_id null or inbox_ids [] to clear the inbox filter. Pass enabled true to re-enable and reset consecutive_failures. Pass enabled false to disable. Pass headers null to remove custom headers. Another account's id is 404 webhook_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string"},"events":{"type":"array","items":{"type":"string","enum":["message.received","message.held","message.sent","message.blocked","message.bounced","message.complained","task.received","owner.reply","domain.verified","draft.created","draft.approved","draft.rejected","draft.sent"]}},"secret":{"type":"string"},"inbox_id":{"type":"string","nullable":true},"inbox_ids":{"type":"array","items":{"type":"string"},"description":"At most 10 inbox ids. Empty matches every inbox."},"enabled":{"type":"boolean","description":"true re-enables and resets consecutive_failures. false disables deliveries."},"headers":{"type":"object","nullable":true,"additionalProperties":{"type":"string"}}}}}}}},"delete":{"operationId":"deleteWebhook","tags":["Webhooks"],"summary":"Delete a webhook","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"webhook_not_found"}}}},"/api/v1/webhooks/{id}/test":{"post":{"operationId":"testWebhook","tags":["Webhooks"],"summary":"Send a webhook.test event and wait","description":"Body is {type:\"webhook.test\", data:{webhook_id}}. Returns {delivery:{id, status, response_status, attempts, event_id}}. A disabled hook is 409 webhook_disabled. Another account's id is 404 webhook_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Delivery result"},"404":{"description":"webhook_not_found"},"409":{"description":"webhook_disabled"}}}},"/api/v1/webhooks/{id}/deliveries":{"get":{"operationId":"listWebhookDeliveries","tags":["Webhooks"],"summary":"List webhook deliveries","description":"Newest first. limit is 1 to 100 (default 50). status is delivered or failed. Payload is capped at 256 KB. Rows older than 7 days are deleted by the daily cron. 400 invalid_limit, 400 invalid_status, 404 webhook_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"status","in":"query","schema":{"type":"string","enum":["delivered","failed"]}}]}},"/api/v1/webhooks/{id}/deliveries/{deliveryId}/redeliver":{"post":{"operationId":"redeliverWebhook","tags":["Webhooks"],"summary":"Redeliver a stored webhook payload","description":"Same event id, new timestamp and signature. Sends the stored payload (at most 256 KB). Returns {delivery:{id, status, response_status, attempts, event_id}}. 404 delivery_not_found, 404 webhook_not_found, 409 webhook_disabled.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"deliveryId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/owners":{"get":{"operationId":"listOwners","tags":["Owners"],"summary":"List human owners","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"addOwner","tags":["Owners"],"summary":"Register a human owner and email a confirmation link","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string"},"digest":{"type":"string","enum":["immediate","daily"]}},"required":["email"]}}}}}},"/api/v1/inboxes/{id}/owners/{ownerId}":{"delete":{"operationId":"deleteOwner","tags":["Owners"],"summary":"Remove an owner","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"ownerId","in":"path","required":true,"schema":{"type":"string"}}]},"patch":{"operationId":"updateOwner","tags":["Owners"],"summary":"Set digest to immediate or daily","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"ownerId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/owners/{ownerId}/confirm":{"post":{"operationId":"confirmOwner","tags":["Owners"],"summary":"Confirm an owner with the emailed code","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"ownerId","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/owners/confirm":{"get":{"operationId":"ownerConfirmPage","tags":["Owners"],"summary":"Confirmation page for the link in the email","security":[]},"post":{"operationId":"confirmOwnerPublic","tags":["Owners"],"summary":"Confirm with a token plus the csrf nonce from the GET page, or with an email and a 6-digit code. The code path does not use the nonce.","security":[]}},"/api/v1/owners/unsubscribe":{"get":{"operationId":"ownerUnsubscribePage","tags":["Owners"],"summary":"Unsubscribe page","security":[]},"post":{"operationId":"unsubscribeOwner","tags":["Owners"],"summary":"One-click List-Unsubscribe","security":[]}},"/api/v1/lifecycle/unsubscribe":{"get":{"operationId":"lifecycleUnsubscribePage","tags":["Auth"],"summary":"Confirm page for the weekly product note. Opening this page does not turn the notes off.","security":[]},"post":{"operationId":"lifecycleUnsubscribe","tags":["Auth"],"summary":"Turn weekly product notes off. The token is in the query string or the form body. No API key. A GET of the same URL does not change the setting.","security":[]}},"/api/v1/inboxes/{id}/allowlist":{"get":{"operationId":"listAllowlist","tags":["Owners"],"summary":"List allowlisted senders. The per-inbox allowlist (POST /api/v1/inboxes/:id/allowlist) only marks senders who can open a task; allow and block lists decide which addresses may be sent to or accepted as mail.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"addAllowlistEntry","tags":["Owners"],"summary":"Allow a sender to create tasks","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/updates":{"get":{"operationId":"listUpdates","tags":["Updates"],"summary":"List owner updates for an inbox","parameters":[{"name":"inbox_id","in":"query","required":true,"schema":{"type":"string"}}]},"post":{"operationId":"notifyOwner","tags":["Updates"],"summary":"Send a progress, needs_input, done, or error update to verified owners. Progress email to a verified owner is exempt from send allow and block lists.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"inbox_id":{"type":"string"},"kind":{"type":"string","enum":["progress","needs_input","done","error"]},"text":{"type":"string"},"title":{"type":"string"},"status":{"type":"string"},"task_id":{"type":"string"},"links":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"]}},"client_id":{"type":"string"}},"required":["inbox_id","kind","text"]}}}}}},"/api/v1/digests/flush":{"post":{"operationId":"flushDigests","tags":["Updates"],"summary":"Flush queued daily digests for this account"}},"/api/v1/internal/drafts/flush":{"get":{"operationId":"flushDueDrafts","tags":["Drafts"],"summary":"Vercel Cron (every minute) and the inbound worker: send drafts whose send_at has passed. A row is claimed before send so a draft is sent once. Authorization: Bearer CRON_SECRET or X-Cooper-Inbound-Secret","security":[]},"post":{"operationId":"flushDueDraftsOperator","tags":["Drafts"],"summary":"Same as the cron flush. Bearer CRON_SECRET or X-Cooper-Inbound-Secret","security":[]}},"/api/v1/internal/digests/flush":{"get":{"operationId":"flushDigestsCron","tags":["Updates"],"summary":"Vercel Cron (13:00 UTC): flush due daily digests, delete expired inboxes, delete events older than 7 days, delete webhook deliveries older than 7 days, delete idempotency keys older than 24 hours, delete expired confirm-page nonces, and check pending domains. Authorization: Bearer CRON_SECRET","security":[]},"post":{"operationId":"flushDigestsOperator","tags":["Updates"],"summary":"Operator flush of due daily digests. Bearer CRON_SECRET or X-Cooper-Inbound-Secret","security":[]}},"/api/v1/tasks":{"get":{"operationId":"listTasks","tags":["Tasks"],"summary":"List or long-poll tasks from verified owners and allowlisted senders whose mail passed DMARC or aligned DKIM, unless the inbox opted out","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string"}},{"name":"status","in":"query","schema":{"type":"string","enum":["pending","in_progress","done","all"]}},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"wait","in":"query","schema":{"type":"integer","description":"Long-poll seconds, maximum 25"}}]}},"/api/v1/tasks/stream":{"get":{"operationId":"streamTasks","tags":["Tasks"],"summary":"Server-sent events for tasks (25 seconds)"}},"/api/v1/events":{"get":{"operationId":"listEvents","tags":["Events"],"summary":"List the event log, oldest first. after is a cursor or ISO timestamp (default: one hour ago). wait long-polls up to 25 seconds. Unknown types return 400 invalid_event_type. There is no WebSocket endpoint.","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string"}},{"name":"types","in":"query","schema":{"type":"string","description":"Comma-separated event types"}},{"name":"after","in":"query","schema":{"type":"string","description":"Opaque cursor or ISO-8601 timestamp"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"wait","in":"query","schema":{"type":"integer","minimum":0,"maximum":25,"description":"Long-poll seconds"}}],"responses":{"200":{"description":"Ascending event page","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"list"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Event"}},"next_cursor":{"type":"string"}},"required":["object","data","next_cursor"]}}}}}}},"/api/v1/inboxes/{id}/events":{"get":{"operationId":"listInboxEvents","tags":["Events"],"summary":"List the event log for one inbox. :id accepts inbox id, username, or email. Another account's inbox is inbox_not_found.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"types","in":"query","schema":{"type":"string"}},{"name":"after","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"wait","in":"query","schema":{"type":"integer","minimum":0,"maximum":25}}],"responses":{"200":{"description":"Ascending event page for one inbox","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"const":"list"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Event"}},"next_cursor":{"type":"string"}},"required":["object","data","next_cursor"]}}}}}}},"/api/v1/events/stream":{"get":{"operationId":"streamEvents","tags":["Events"],"summary":"Server-Sent Events for up to 25 seconds. Each frame is id: <cursor>, event: <type>, data: <json>. Honors Last-Event-ID. Ends with event: timeout so the client reconnects. There is no WebSocket endpoint.","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string"}},{"name":"types","in":"query","schema":{"type":"string"}},{"name":"after","in":"query","schema":{"type":"string"}},{"name":"Last-Event-ID","in":"header","schema":{"type":"string"},"description":"Resume after this cursor. Overrides after."}]}},"/api/v1/tasks/{id}":{"get":{"operationId":"getTask","tags":["Tasks"],"summary":"Get one task","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}]},"patch":{"operationId":"updateTask","tags":["Tasks"],"summary":"Set task status, including done","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["pending","in_progress","done"]}},"required":["status"]}}}}}},"/api/v1/tasks/{id}/reply":{"post":{"operationId":"replyTask","tags":["Tasks"],"summary":"Reply in-thread to the human and optionally set status. The recipient is checked against send allow and block lists; 403 recipient_blocked sends nothing. Idempotency-Key replays the same request for 24 hours. A replay returns the stored message.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},"description":"Optional. 1 to 256 characters: letters, digits, and - . _ ~. The same key and the same request within 24 hours returns the stored message with HTTP 200, idempotent true, and Idempotent-Replayed: true, and does not send again. A different request is 409 idempotency_key_conflict. A second call while the first is still running is 409 idempotency_request_in_progress. An empty or invalid value is 400 invalid_idempotency_key. A failed send removes the key. When client_id is also set, client_id is checked first. Keys expire after 24 hours."}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"text":{"type":"string"},"html":{"type":"string"},"status":{"type":"string","enum":["pending","in_progress","done"]}},"required":["text"]}}}}}},"/api/v1/lists/{direction}/{type}":{"get":{"operationId":"listAddressList","tags":["Lists"],"summary":"List account-wide allow or block entries","description":"direction is send, receive, or reply. type is allow or block. At most 1000 entries per list. Default limit is 100 and the maximum is 1000. next_page_token continues the list. The per-inbox allowlist only marks senders who can open a task; these lists decide which addresses may be sent to or accepted as mail.","parameters":[{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"page_token","in":"query","schema":{"type":"string"}}]},"post":{"operationId":"createAddressListEntry","tags":["Lists"],"summary":"Add an account-wide allow or block entry","description":"HTTP 201 when created. HTTP 200 when the entry already exists. HTTP 400 invalid_list, invalid_entry, or list_full.","parameters":[{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"entry":{"type":"string","description":"Email address or domain."},"reason":{"type":"string"}},"required":["entry"]}}}}}},"/api/v1/lists/{direction}/{type}/{entry}":{"get":{"operationId":"getAddressListEntry","tags":["Lists"],"summary":"Get one account-wide allow or block entry","parameters":[{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"entry","in":"path","required":true,"schema":{"type":"string","description":"URL-encoded email or domain."}}]},"delete":{"operationId":"deleteAddressListEntry","tags":["Lists"],"summary":"Remove one account-wide allow or block entry","parameters":[{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"entry","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/inboxes/{id}/lists/{direction}/{type}":{"get":{"operationId":"listInboxAddressList","tags":["Lists"],"summary":"List allow or block entries for one inbox","description":"When an inbox has any entries for a direction, only that inbox's lists apply. Otherwise the account lists apply. :id accepts inbox id, username, or email.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"page_token","in":"query","schema":{"type":"string"}}]},"post":{"operationId":"createInboxAddressListEntry","tags":["Lists"],"summary":"Add an allow or block entry for one inbox","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"entry":{"type":"string"},"reason":{"type":"string"}},"required":["entry"]}}}}}},"/api/v1/inboxes/{id}/lists/{direction}/{type}/{entry}":{"get":{"operationId":"getInboxAddressListEntry","tags":["Lists"],"summary":"Get one inbox allow or block entry","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"entry","in":"path","required":true,"schema":{"type":"string"}}]},"delete":{"operationId":"deleteInboxAddressListEntry","tags":["Lists"],"summary":"Remove one inbox allow or block entry","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"direction","in":"path","required":true,"schema":{"type":"string","enum":["send","receive","reply"]}},{"name":"type","in":"path","required":true,"schema":{"type":"string","enum":["allow","block"]}},{"name":"entry","in":"path","required":true,"schema":{"type":"string"}}]}},"/api/v1/suppressions":{"get":{"operationId":"listSuppressions","tags":["Suppressions"],"summary":"List suppressed addresses","description":"Account-wide. Each row is {object:suppression, address, reason, source_message_id, created_at}. reason is bounce, complaint, or manual. Requires list_read. An inbox-scoped key receives 403 permission_denied."},"post":{"operationId":"createSuppression","tags":["Suppressions"],"summary":"Suppress an address manually","description":"Body {address}. Returns 201, or 200 when that address is already listed. A bad address is 400 invalid_address. Requires list_write.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["address"],"properties":{"address":{"type":"string","description":"Email address to suppress."}}},"example":{"address":"ada@example.com"}}}}}},"/api/v1/suppressions/{address}":{"delete":{"operationId":"deleteSuppression","tags":["Suppressions"],"summary":"Remove a suppressed address","description":"Returns the row with deleted true. A missing address is 404 suppression_not_found. A bad address is 400 invalid_address.","parameters":[{"name":"address","in":"path","required":true,"schema":{"type":"string"},"description":"URL-encoded email address."}]}},"/api/v1/metrics/events":{"get":{"operationId":"getMetricsEvents","tags":["Metrics"],"summary":"UTC hour or day buckets of message.received, message.sent, message.bounced, and message.complained. received and sent follow direction. bounced and complained follow those labels and are zero when absent. start and end default to the last 30 days and cannot exceed 90 days (400 invalid_range). A bad timestamp is 400 invalid_date. A bad period is 400 invalid_period. An unknown type is 400 invalid_type. Counts only; message bodies are not returned. An inbox-scoped key sees only its inbox. Another account's inbox is 404 inbox_not_found.","parameters":[{"name":"types","in":"query","schema":{"type":"string","description":"Comma-separated: message.received, message.sent, message.bounced, message.complained. Default message.received,message.sent."}},{"name":"start","in":"query","schema":{"type":"string","description":"ISO-8601 inclusive start. Default is 30 days before end."}},{"name":"end","in":"query","schema":{"type":"string","description":"ISO-8601 exclusive end. Default is now."}},{"name":"period","in":"query","schema":{"type":"string","enum":["hour","day"],"default":"day"}},{"name":"inbox_id","in":"query","schema":{"type":"string","description":"Inbox id, username, or email on this account."}}],"responses":{"200":{"description":"Time buckets and counts","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetricsEvents"}}}}}}},"/api/v1/metrics/usage":{"get":{"operationId":"getMetricsUsage","tags":["Metrics"],"summary":"Current inbox_count, message_count, thread_count, and storage_bytes for this account. storage_bytes is the UTF-8 length of text plus html plus attachment size_bytes, and is not the message body. inbox_id, or an inbox-scoped key, omits domain_count and workspace_count. Otherwise those counts are for this account only. A sub-account does not see the parent. Another account's inbox is 404 inbox_not_found.","parameters":[{"name":"inbox_id","in":"query","schema":{"type":"string","description":"Inbox id, username, or email on this account."}}],"responses":{"200":{"description":"Usage counts","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetricsUsage"}}}}}}},"/api/v1/metrics/rates":{"get":{"operationId":"getMetricsRates","tags":["Metrics"],"summary":"sent, bounced, complained, bounce_rate, and complaint_rate for this account. sent counts outbound messages. bounced and complained count messages with those labels. Rates are 0 when sent is 0. start and end follow the same 90-day rules as events (400 invalid_range, 400 invalid_date). Counts only.","parameters":[{"name":"start","in":"query","schema":{"type":"string","description":"ISO-8601 inclusive start. Default is 30 days before end."}},{"name":"end","in":"query","schema":{"type":"string","description":"ISO-8601 exclusive end. Default is now."}},{"name":"inbox_id","in":"query","schema":{"type":"string","description":"Inbox id, username, or email on this account."}}],"responses":{"200":{"description":"Bounce and complaint rates","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetricsRates"}}}}}}},"/api/v1/stats":{"get":{"operationId":"getStats","tags":["Inboxes"],"summary":"Account analytics for the dashboard"}},"/api/v1/admin/lifecycle":{"get":{"operationId":"previewLifecycle","tags":["Account"],"summary":"Operator preview of this week's product note and the eligible account count. Nothing is sent. An empty operator list or any other account is HTTP 404."},"post":{"operationId":"deliverLifecyclePreview","tags":["Account"],"summary":"Operator delivery of one product note to an inbox listed in COOPER_LIFECYCLE_PREVIEW. Ignores COOPER_LIFECYCLE_EMAILS. The same campaign stores one note. An inbox that is not on that list is HTTP 404.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"inbox_id":{"type":"string"}},"required":["inbox_id"]}}}}}},"/api/v1/billing":{"get":{"tags":["Billing"],"summary":"Plan, usage, limits, and upgrade path. stripe.customer_id is the stored Stripe customer id. stripe.billing_email is read from Stripe on this request and is not stored. It is returned only to an unscoped full-access key of the account that owns the Stripe customer. verified_owner_send_bonus is the extra monthly sends on Free when a verified owner on an external domain exists."}},"/api/v1/billing/checkout":{"post":{"tags":["Billing"],"summary":"Create a Stripe Checkout session and return its URL. The session always sends the stored Stripe customer. customer_update email auto lets Checkout collect an email when that customer has none and save it on the Stripe customer.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"plan":{"enum":["starter","pro"]},"success_url":{"type":"string"},"cancel_url":{"type":"string"},"client_id":{"type":"string"},"email":{"type":"string"}},"required":["plan"]}}}}}},"/api/v1/billing/portal":{"post":{"tags":["Billing"],"summary":"Create a Stripe customer portal session and return its URL"}}},"security":[{"bearerAuth":[]}]}