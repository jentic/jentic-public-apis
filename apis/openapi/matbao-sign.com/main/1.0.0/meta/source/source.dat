{
  "openapi": "3.0.3",
  "info": {
    "title": "Mắt Bão Sign - Portal API (Auth, eKYC, Documents)",
    "description": "API specification cho các luồng đã final:\n- **Auth**: Đăng ký, đăng nhập, OTP, quản lý PIN, đổi thiết bị\n- **eKYC**: Xác thực CCCD (2 bước: Verify Document → Verify Face) và Confirm Update\n- **Documents**: Upload, danh sách, chi tiết, ký số, xóa tài liệu portal\n- **Signature Templates**: CRUD mẫu chữ ký (info/text/draw/upload), dùng khi ký để hiển thị appearance\n\nBase path: `/api` (ví dụ `{{base_url}}/portal/auth/login` = `http://host/api/portal/auth/login`)\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/theapp4ucom-2fe/mat-bao-sign-portal-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.matbao-sign.com/api",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Portal Authentication (final)"
    },
    {
      "name": "eKYC",
      "description": "eKYC Verification - 2 bước (final)"
    },
    {
      "name": "Documents",
      "description": "Portal Documents - upload, list, sign, delete (final)"
    },
    {
      "name": "Signature Templates",
      "description": "Mẫu chữ ký (CRUD) - info/text/draw/upload, dùng cho appearance khi ký"
    }
  ],
  "paths": {
    "/portal/auth/send-otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Send OTP",
        "description": "Generate OTP và gửi SMS. Dùng cho Register hoặc Forgot PIN (gửi OTP trước, sau đó gọi verify/register/forgot-pin).",
        "operationId": "sendOtp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "0901234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "transactionId": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Send OTP failed"
          }
        }
      }
    },
    "/portal/auth/verify-otp-status": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify OTP Status (Optional)",
        "description": "Kiểm tra trạng thái gửi SMS qua transaction_id từ send-otp.",
        "operationId": "verifyOtpStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "transaction_id"
                ],
                "properties": {
                  "transaction_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "transactionId": {
                          "type": "string"
                        },
                        "code": {
                          "type": "integer"
                        },
                        "message": {
                          "type": "string"
                        },
                        "deliveryStatus": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/portal/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register Account (Step 1)",
        "description": "Đăng ký tài khoản portal — bước 1. Chỉ tạo record user (status INACTIVE, chưa có PIN).\nLuồng tiếp theo: **send-otp** → user nhập OTP → **verify-otp** (device_id, device_public_key) → **create-pin**.\nSau create-pin mới có accessToken/refreshToken.\n",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "full_name",
                  "phone"
                ],
                "properties": {
                  "full_name": {
                    "type": "string",
                    "example": "Nguyễn Văn A"
                  },
                  "phone": {
                    "type": "string",
                    "example": "0901234567"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true
                  },
                  "user_type": {
                    "type": "string",
                    "enum": [
                      "INDIVIDUAL",
                      "ORGANIZATION",
                      "EMPLOYEE"
                    ],
                    "default": "INDIVIDUAL"
                  },
                  "organization_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "description": "For EMPLOYEE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created (chưa hoàn thành — cần verify OTP rồi create PIN)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Account created. Please verify OTP then create PIN."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/PortalUserBrief"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Phone hoặc email đã được đăng ký"
          }
        }
      }
    },
    "/portal/auth/verify-otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify OTP (Registration Step 2)",
        "description": "Xác thực OTP sau register. App gửi **otp** (1 field — App tích hợp key bảo vệ OTP), **device_id**, **device_public_key**.\nBackend verify với SMS, lưu device binding tại đây, trả **setup_token** dùng cho create-pin.\n",
        "operationId": "verifyOtp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "otp",
                  "device_id",
                  "device_public_key"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "0901234567"
                  },
                  "otp": {
                    "type": "string",
                    "description": "OTP đã bảo vệ (App tích hợp key)"
                  },
                  "device_id": {
                    "type": "string"
                  },
                  "device_public_key": {
                    "type": "string",
                    "description": "Public key thiết bị (PEM hoặc Base64)"
                  },
                  "device_info": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "device_name": {
                        "type": "string"
                      },
                      "os": {
                        "type": "string",
                        "example": "iOS"
                      },
                      "os_version": {
                        "type": "string"
                      },
                      "app_version": {
                        "type": "string"
                      },
                      "device_token": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified, setup_token returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "setup_token": {
                          "type": "string"
                        },
                        "expires_in_seconds": {
                          "type": "integer"
                        },
                        "expires_in_minutes": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid OTP"
          },
          "404": {
            "description": "Phone not registered"
          },
          "429": {
            "description": "OTP locked (quá nhiều lần sai)"
          }
        }
      }
    },
    "/portal/auth/create-pin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create PIN (Registration Step 3)",
        "description": "Tạo mã PIN sau verify-otp. Gửi **setup_token** từ verify-otp + pin + confirm_pin.\nDevice binding đã lưu tại verify-otp; không cần device_info ở đây.\nTrả accessToken + refreshToken — user đã hoàn thành đăng ký.\n",
        "operationId": "createPin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "setup_token",
                  "pin",
                  "confirm_pin"
                ],
                "properties": {
                  "setup_token": {
                    "type": "string"
                  },
                  "pin": {
                    "type": "string",
                    "minLength": 6
                  },
                  "confirm_pin": {
                    "type": "string",
                    "description": "Must match pin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PIN created, logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/PortalUserBrief"
                        },
                        "accessToken": {
                          "type": "string"
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed / setup_token invalid or expired"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/portal/auth/login/identify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login - Step 1 (Identify)",
        "description": "Bước 1 đăng nhập: xác định user bằng email hoặc SĐT.\nTrả **login_token** dùng cho bước 2 (login với PIN). TTL config (mặc định 5 phút).\n",
        "operationId": "loginIdentify",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login_id"
                ],
                "properties": {
                  "login_id": {
                    "type": "string",
                    "description": "Email hoặc số điện thoại"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "login_token returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "login_token": {
                      "type": "string"
                    },
                    "expires_in_seconds": {
                      "type": "integer"
                    },
                    "expires_in_minutes": {
                      "type": "integer"
                    },
                    "masked_identifier": {
                      "type": "string",
                      "description": "Masked email/phone cho màn PIN (vd: 09***99, a***@gmail.com)"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Tài khoản không tồn tại hoặc chưa xác thực"
          }
        }
      }
    },
    "/portal/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login - Step 2 (PIN)",
        "description": "Đăng nhập bằng **login_token** (từ login/identify) + **pin**, hoặc **login_id** + pin (legacy).\nGửi **device_info** (device_id) để kiểm tra thiết bị. Nếu thiết bị khác binding → 403 DEVICE_CHANGE_REQUIRED, kèm device_switch_token.\nNếu tài khoản chưa tạo PIN (status INACTIVE) → 403 ACCOUNT_INCOMPLETE, required_action create_pin.\n",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pin"
                ],
                "properties": {
                  "login_token": {
                    "type": "string",
                    "description": "Từ login/identify (bước 1)"
                  },
                  "login_id": {
                    "type": "string",
                    "description": "Email hoặc SĐT (legacy, dùng khi không có login_token)"
                  },
                  "pin": {
                    "type": "string"
                  },
                  "device_info": {
                    "type": "object",
                    "properties": {
                      "device_id": {
                        "type": "string"
                      },
                      "device_name": {
                        "type": "string"
                      },
                      "os": {
                        "type": "string"
                      },
                      "os_version": {
                        "type": "string"
                      },
                      "app_version": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "user": {
                      "$ref": "#/components/schemas/PortalUserBrief"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string"
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (sai PIN, token hết hạn, user không tồn tại)"
          },
          "403": {
            "description": "- **ACCOUNT_INCOMPLETE**: Tài khoản chưa hoàn thành đăng ký (chưa tạo PIN). App redirect user tới màn create-pin.\n- **DEVICE_CHANGE_REQUIRED**: Thiết bị khác đã binding → gọi device-switch flow (prepare → confirm → verify-otp).\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "ACCOUNT_INCOMPLETE",
                        "DEVICE_CHANGE_REQUIRED"
                      ]
                    },
                    "required_action": {
                      "type": "string",
                      "description": "Khi code=ACCOUNT_INCOMPLETE: 'create_pin' — App chuyển user tới màn tạo PIN",
                      "example": "create_pin"
                    },
                    "requires_device_switch": {
                      "type": "boolean",
                      "description": "Khi code=DEVICE_CHANGE_REQUIRED"
                    },
                    "device_switch_token": {
                      "type": "string",
                      "description": "Khi code=DEVICE_CHANGE_REQUIRED"
                    },
                    "expires_in_seconds": {
                      "type": "integer"
                    },
                    "expires_in_minutes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/portal/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh Token",
        "description": "Làm mới access token bằng refresh token. Không cần Bearer.",
        "operationId": "refresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/PortalUserBrief"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string"
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token"
          }
        }
      }
    },
    "/portal/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/portal/auth/forgot-pin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Forgot PIN - Step 1",
        "description": "Gửi phone + OTP (đã nhận từ send-otp). Trả về reset_token dùng cho reset-pin.",
        "operationId": "forgotPin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "otp"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified, reset token returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reset_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "400": {
            "description": "Invalid OTP"
          }
        }
      }
    },
    "/portal/auth/reset-pin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset PIN - Step 2",
        "description": "Đặt lại PIN mới bằng reset_token từ forgot-pin.",
        "operationId": "resetPin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reset_token",
                  "new_pin",
                  "confirm_pin"
                ],
                "properties": {
                  "reset_token": {
                    "type": "string"
                  },
                  "new_pin": {
                    "type": "string",
                    "minLength": 6
                  },
                  "confirm_pin": {
                    "type": "string",
                    "description": "Must match new_pin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PIN reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Invalid or expired reset token"
          }
        }
      }
    },
    "/portal/auth/change-pin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change PIN",
        "description": "Đổi PIN khi đã đăng nhập. Cần Bearer token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "changePin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "old_pin",
                  "new_pin",
                  "confirm_pin"
                ],
                "properties": {
                  "old_pin": {
                    "type": "string"
                  },
                  "new_pin": {
                    "type": "string",
                    "minLength": 6
                  },
                  "confirm_pin": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PIN changed successfully"
          },
          "400": {
            "description": "Old PIN incorrect or validation failed"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/portal/auth/device-switch/prepare": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Device Switch - Step 1 (Prepare)",
        "description": "Bước 1 đổi thiết bị. Gửi **device_switch_token** (từ login 403 DEVICE_CHANGE_REQUIRED) + **device_id** + **device_public_key**.\nBackend tạo challenge, lưu session, trả **challenge** cho App ký bằng private key.\n",
        "operationId": "deviceSwitchPrepare",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_switch_token",
                  "device_id",
                  "device_public_key"
                ],
                "properties": {
                  "device_switch_token": {
                    "type": "string"
                  },
                  "device_id": {
                    "type": "string"
                  },
                  "device_public_key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "challenge": {
                          "type": "string"
                        }
                      }
                    },
                    "expires_in_seconds": {
                      "type": "integer"
                    },
                    "expires_in_minutes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid or expired"
          }
        }
      }
    },
    "/portal/auth/device-switch/confirm": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Device Switch - Step 2 (Confirm)",
        "description": "Bước 2: Gửi **challenge** + **signature** (Base64 của chữ ký challenge bằng private key thiết bị).\nBackend verify chữ ký bằng device_public_key đã lưu, gửi OTP về SĐT user.\n",
        "operationId": "deviceSwitchConfirm",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_switch_token",
                  "device_id",
                  "challenge",
                  "signature"
                ],
                "properties": {
                  "device_switch_token": {
                    "type": "string"
                  },
                  "device_id": {
                    "type": "string"
                  },
                  "challenge": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string",
                    "description": "Base64(chữ ký challenge bằng private key thiết bị)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "otp_sent": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Challenge invalid"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Signature verification failed"
          }
        }
      }
    },
    "/portal/auth/device-switch/verify-otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Device Switch - Step 3 (Verify OTP)",
        "description": "Bước 3: Gửi **device_switch_token** + **otp** (1 field, App bảo vệ OTP).\nBackend verify OTP, revoke máy cũ, bind máy mới, trả accessToken + refreshToken.\n",
        "operationId": "deviceSwitchVerifyOtp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_switch_token",
                  "otp"
                ],
                "properties": {
                  "device_switch_token": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string"
                  },
                  "device_info": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "device_token": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device switched, tokens returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "user": {
                      "$ref": "#/components/schemas/PortalUserBrief"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string"
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid OTP"
          },
          "401": {
            "description": "Token invalid"
          },
          "429": {
            "description": "OTP locked"
          }
        }
      }
    },
    "/portal/ekyc/verify-document": {
      "post": {
        "tags": [
          "eKYC"
        ],
        "summary": "Verify Document (Step 1)",
        "description": "Bước 1 - Xác nhận thông tin CCCD. Chỉ gửi ảnh CCCD (mặt trước, mặt sau).\nBackend gọi OCR, so sánh với portal_user, lưu verification với status PENDING.\nTrả về verification_id để dùng cho Step 2 (Verify Face).\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "verifyDocument",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ocr_front_image"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "nullable": true,
                    "example": "req_ocr_123456789"
                  },
                  "ocr_front_image": {
                    "type": "string",
                    "description": "Base64 encoded CCCD front image"
                  },
                  "ocr_back_image": {
                    "type": "string",
                    "nullable": true,
                    "description": "Base64 encoded CCCD back image"
                  },
                  "confident_thr": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.8
                  },
                  "id_full_thr": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.9
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document verified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "verificationId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "requestId": {
                          "type": "string"
                        },
                        "comparison": {
                          "type": "object",
                          "properties": {
                            "hasMismatch": {
                              "type": "boolean"
                            },
                            "mismatchFields": {
                              "type": "object"
                            }
                          }
                        },
                        "requiresUserConfirmation": {
                          "type": "boolean"
                        },
                        "actionRequired": {
                          "type": "string",
                          "nullable": true
                        },
                        "updateEndpoint": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "OCR API failed"
          }
        }
      }
    },
    "/portal/ekyc/confirm-update": {
      "post": {
        "tags": [
          "eKYC"
        ],
        "summary": "Confirm Update from CCCD",
        "description": "Optional. Khi Verify Document trả về hasMismatch = true, user có thể gọi API này để xác nhận cập nhật tên từ CCCD.\nverification_id lấy từ response Step 1.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "confirmUpdate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "verification_id",
                  "update_from_cccd"
                ],
                "properties": {
                  "verification_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "update_from_cccd": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated or cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/PortalUserBrief"
                        },
                        "verification_status": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Verification not found"
          }
        }
      }
    },
    "/portal/ekyc/verify-face": {
      "post": {
        "tags": [
          "eKYC"
        ],
        "summary": "Verify Face (Step 2)",
        "description": "Bước 2 - Xác thực face. Gọi sau khi đã Verify Document (và Confirm Update nếu có mismatch).\nGửi verification_id từ Step 1 + ảnh face (card + live). Backend gọi FaceID, cập nhật status VERIFIED/FAILED.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "verifyFace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "verification_id",
                  "faceid_card_image",
                  "faceid_live_image"
                ],
                "properties": {
                  "verification_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "faceid_card_image": {
                    "type": "string",
                    "description": "Base64 - ảnh CCCD (face)"
                  },
                  "faceid_live_image": {
                    "type": "string",
                    "description": "Base64 - ảnh selfie"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Face verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "verificationId": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        },
                        "comparison": {
                          "type": "object"
                        },
                        "faceidVerification": {
                          "type": "object",
                          "properties": {
                            "isVerified": {
                              "type": "boolean"
                            },
                            "sim": {
                              "type": "number"
                            },
                            "verifyResultText": {
                              "type": "string"
                            },
                            "antiSpoofStatus": {
                              "type": "string"
                            }
                          }
                        },
                        "overallStatus": {
                          "type": "string",
                          "enum": [
                            "VERIFIED",
                            "FAILED"
                          ]
                        },
                        "requiresUserConfirmation": {
                          "type": "boolean"
                        },
                        "actionRequired": {
                          "type": "string",
                          "nullable": true
                        },
                        "updateEndpoint": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Verification not PENDING or validation failed"
          },
          "404": {
            "description": "Verification not found"
          },
          "500": {
            "description": "FaceID API failed"
          }
        }
      }
    },
    "/portal/documents/upload": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upload Document",
        "description": "Upload tài liệu cho portal user. Lưu vào bảng portal_documents. Max 80MB.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "uploadDocument",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "document_name"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "document_name": {
                    "type": "string",
                    "example": "HopDongLaoDong.pdf"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "location": {
                    "type": "string",
                    "enum": [
                      "local",
                      "s3"
                    ],
                    "default": "local"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "documentId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer"
                        },
                        "location": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "example": "PENDING"
                        },
                        "uploadedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation / file too large"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/portal/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get Document List",
        "description": "Danh sách tài liệu của user. Filter theo status, phân trang.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "SIGNED",
                "REJECTED",
                "ARCHIVED"
              ]
            },
            "description": "Filter by status"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "documentId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true
                          },
                          "url": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "fileSize": {
                            "type": "integer",
                            "nullable": true
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "totalPages": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/portal/documents/{document_id}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get Document Detail",
        "description": "Chi tiết một tài liệu. Chỉ document thuộc user hiện tại.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "getDocumentDetail",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "documentId": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true
                        },
                        "url": {
                          "type": "string"
                        },
                        "location": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "fileSize": {
                          "type": "integer",
                          "nullable": true
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Delete Document",
        "description": "Xóa tài liệu (hard delete). Chỉ document của user hiện tại.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "deleteDocument",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/portal/documents/{document_id}/sign": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Sign Document (PAdES)",
        "description": "Ký số tài liệu (Remote Signing) — một lần gọi. Backend: prepare (hash) + gọi CA sign + nhúng chữ ký PAdES.\n- **signature_template_id** (optional): UUID mẫu chữ ký — nếu có thì hiển thị appearance theo mẫu (info/text/draw/upload). PNG có alpha giữ nền trong suốt.\n- **signature_positions** (optional): Mảng [{ page, x, y, width, height }] — vị trí ô chữ ký (y từ trên xuống). Không gửi thì dùng vị trí mặc định.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "signDocument",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "certificate_id",
                  "pin"
                ],
                "properties": {
                  "certificate_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID CTS thuộc user (từ ca_api_logs)"
                  },
                  "pin": {
                    "type": "string",
                    "description": "PIN user"
                  },
                  "signature_template_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "description": "UUID mẫu chữ ký — appearance hiển thị theo mẫu (info/text/draw/upload)"
                  },
                  "signature_positions": {
                    "type": "array",
                    "nullable": true,
                    "items": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Trang (1-based)"
                        },
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Khoảng cách từ mép trên trang (pt)"
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document signed successfully (PAdES embedded)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Document signed successfully (PAdES embedded)"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "document_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "url": {
                          "type": "string",
                          "description": "Path to signed PDF (e.g. documents/signed_xxx.pdf)"
                        },
                        "status": {
                          "type": "string",
                          "example": "SIGNED"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed / invalid certificate or template"
          },
          "404": {
            "description": "Document or certificate or template not found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "CA sign or PDF embed failed"
          }
        }
      }
    },
    "/portal/signature-templates": {
      "get": {
        "tags": [
          "Signature Templates"
        ],
        "summary": "List Signature Templates",
        "description": "Danh sách mẫu chữ ký của user. Có thể lọc theo type (info | text | draw | upload).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "listSignatureTemplates",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "text",
                "draw",
                "upload"
              ]
            },
            "description": "Filter by template type"
          }
        ],
        "responses": {
          "200": {
            "description": "List of signature templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SignatureTemplate"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Signature Templates"
        ],
        "summary": "Create Signature Template",
        "description": "Tạo mẫu chữ ký. Có thể gửi **multipart/form-data** (name, type, certificate_id?, image file) hoặc **application/json** (name, type, data?).\n- **type**: info (thông tin CTS), text (chữ tùy chỉnh), draw | upload (ảnh chữ ký).\n- **data** (JSON): Với text — text, color, bold, italic. Với draw/upload — data.image_base64, data.image_mime (image/png | image/jpeg).\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "createSignatureTemplate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Chữ ký cá nhân"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "info",
                      "text",
                      "draw",
                      "upload"
                    ]
                  },
                  "certificate_id": {
                    "type": "string",
                    "maxLength": 64,
                    "nullable": true,
                    "description": "Optional, for type=info"
                  },
                  "data": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "color": {
                        "type": "string",
                        "maxLength": 20,
                        "example": "#000000"
                      },
                      "bold": {
                        "type": "boolean"
                      },
                      "italic": {
                        "type": "boolean"
                      },
                      "image_base64": {
                        "type": "string",
                        "description": "Base64 image for draw/upload"
                      },
                      "image_mime": {
                        "type": "string",
                        "enum": [
                          "image/png",
                          "image/jpeg"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "info",
                      "text",
                      "draw",
                      "upload"
                    ]
                  },
                  "certificate_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file for type draw/upload (PNG/JPEG, max 2MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signature template created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SignatureTemplate"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
