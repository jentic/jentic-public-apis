  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from login/register/refresh"
      }
    },
    "schemas": {
      "PortalUserBrief": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          }
        }
      },
      "SignatureTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "info",
              "text",
              "draw",
              "upload"
            ]
          },
          "certificateId": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "object",
            "nullable": true,
            "description": "Với text: text, color, bold, italic. Với draw/upload: imagePath.",
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "bold": {
                "type": "boolean"
              },
              "italic": {
                "type": "boolean"
              },
              "imagePath": {
                "type": "string",
                "description": "Storage path (e.g. signature_templates/{user_id}/{uuid}.png)"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to GET /portal/signature-templates/{id}/image"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
