          "400": {
            "description": "Returned only for a payment made against the unlock price band when the id query parameter is missing or is not a UUID. The payment was refused and not taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "pass the verify id as ?id=<uuid>"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequiredUnlock"
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
            "description": "Returned only for a payment made against the unlock price band when no chain has this id. The payment was refused and not taken."
          },
          "409": {
            "description": "The chain is not in a state that can be unlocked: the human has not answered yet, or the chain failed. No payment is requested.",
            "content": {
