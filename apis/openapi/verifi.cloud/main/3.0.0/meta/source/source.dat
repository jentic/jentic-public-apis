    "/verify/{verify_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/VerifyIdPath"
        }
      ],
      "get": {
        "tags": [
          "verify"
        ],
        "operationId": "getVerify",
        "summary": "Poll the state of a chain",
        "description": "Returns the current state. Polling never costs money and never reveals a locked result.\n\nWhile status is processing, honor retry_after_seconds. A processing response carries admitted_at, sla_deadline, and grace_deadline, so the agent can plan its polling; expires_at equals grace_deadline, the last deadline. Human work can take minutes or hours, up to 24 hours, so do not assume a short fixed deadline. Prefer callback_url and use polling as the recovery path.\n\nA ready response states exactly what the unlock costs and why: service_window.applied (sla or grace, decided by ready_at alone) and service_window.unlock_amount in the bound asset.",
        "responses": {
          "200": {
            "description": "Current state of the chain.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyState"
                },
                "examples": {
                  "processing": {
                    "summary": "A human is working. Poll again.",
                    "value": {
                      "verify_id": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "work_id": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "contract_version": 3,
                      "status": "processing",
                      "verdict": null,
                      "explanation": null,
                      "response": null,
                      "admitted_at": "2026-10-01T09:00:02+00:00",
                      "sla_deadline": "2026-10-01T10:00:02+00:00",
                      "grace_deadline": "2026-10-02T09:00:02+00:00",
                      "ready_at": null,
                      "expires_at": "2026-10-02T09:00:02+00:00",
                      "next_action": "poll",
                      "poll_url": "/verify/0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "retry_after_seconds": 15
                    }
                  },
                  "readySlaUsdc": {
                    "summary": "USDC chain. The human answered inside the SLA window, so the unlock costs the SLA amount.",
                    "value": {
                      "verify_id": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "work_id": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "contract_version": 3,
                      "status": "ready",
                      "verdict": null,
                      "explanation": null,
                      "response": null,
                      "admitted_at": "2026-10-01T09:00:02+00:00",
                      "sla_deadline": "2026-10-01T10:00:02+00:00",
                      "grace_deadline": "2026-10-02T09:00:02+00:00",
                      "ready_at": "2026-10-01T09:41:15+00:00",
                      "responded_at": "2026-10-01T09:41:15+00:00",
                      "next_action": "unlock",
                      "unlock_url": "https://verifi.cloud/verify-unlock?id=0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11",
                      "unlock": {
