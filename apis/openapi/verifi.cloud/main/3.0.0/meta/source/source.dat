    "/verify/{verify_id}/unlock": {
      "parameters": [
        {
          "$ref": "#/components/parameters/VerifyIdPath"
        }
      ],
      "post": {
        "tags": [
          "verify"
        ],
        "operationId": "unlockVerifyLegacy",
        "summary": "Legacy unlock path",
        "description": "Permanent redirect to POST /verify-unlock?id={verify_id}. The method and body are preserved.",
        "responses": {
          "308": {
            "description": "Permanent redirect to the canonical unlock endpoint.",
            "headers": {
              "Location": {
                "description": "The canonical unlock URL.",
                "schema": {
                  "type": "string",
                  "examples": [
                    "/verify-unlock?id=0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11"
                  ]
                }
              }
            }
          }
        },
        "deprecated": true,
        "security": []
      }
    },
    "/verify-api/health": {
      "get": {
        "tags": [
          "service"
        ],
        "operationId": "health",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The API is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "ok": true
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "parameters": {
      "VerifyIdPath": {
        "name": "verify_id",
        "in": "path",
        "required": true,
        "description": "The durable chain handle returned by POST /verify.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11"
      },
      "VerifyIdQuery": {
        "name": "id",
        "in": "query",
        "required": true,
        "description": "The durable chain handle returned by POST /verify.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11"
      },
      "PaymentSignature": {
        "name": "PAYMENT-SIGNATURE",
        "in": "header",
        "required": false,
        "description": "Base64 encoded x402 payment payload. x402 aware clients such as @x402/fetch add this automatically when they retry a 402. Never send a private key: this is a signed, single use authorization.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "RetryAfter": {
        "description": "Seconds to wait before the next call.",
        "schema": {
          "type": "integer"
        },
        "example": 15
      },
      "PaymentRequired": {
        "description": "Base64 encoded x402 v2 PaymentRequired object. Decode it to get the payment options in accepts and the terms in extensions[\"service-windows\"]. Over HTTP the JSON body of a 402 is empty: this header is the requirement.",
        "schema": {
          "type": "string",
          "contentEncoding": "base64",
          "contentMediaType": "application/json",
          "contentSchema": {
            "$ref": "#/components/schemas/PaymentRequired"
          }
        }
      },
      "PaymentResponse": {
        "description": "Base64 encoded x402 settlement receipt, present after a paid gate succeeds. Decode it to get the PaymentResponse object.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "wallet": {
                "value": {
                  "error": "agent_id must be the requester wallet address (0x + 40 hex characters)"
                }
              },
              "fields": {
                "value": {
                  "error": "intent and claim are required strings"
                }
              },
              "length": {
                "value": {
                  "error": "intent max 2000 chars, claim max 4000 chars"
                }
              },
              "callback": {
                "value": {
                  "error": "callback_url must be an https URL, max 2048 chars"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "No chain exists for that verify_id.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "verify not found"
            }
          }
        }
      },
      "BackendUnavailable": {
        "description": "The verification backend is temporarily unavailable. Nothing was charged. Retry.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "verification backend unavailable"
            }
          }
        }
      },
      "PaymentRequiredEntry": {
        "description": "Gate 1 requires payment: 0.10 EUR on Base mainnet, payable in USDC (converted at the ECB euro reference rate, rounded up to the cent) or EURC. The same answer, with fresh terms, follows a payment signed against an expired quote: sign the fresh terms. The PAYMENT-REQUIRED header decodes to a PaymentRequired object with two accepts options, USDC first and EURC second, and the terms of the chain in extensions[\"service-windows\"]. Sign one option with the requester wallet and repeat the same request before terms_valid_until.",
        "headers": {
          "PAYMENT-REQUIRED": {
            "$ref": "#/components/headers/PaymentRequired"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "maxProperties": 0,
              "description": "Empty over HTTP. The requirement is in the PAYMENT-REQUIRED header; decoded examples are in the PaymentRequired schema."
            },
            "example": {}
          }
        }
      },
      "PaymentRequiredUnlock": {
        "description": "The unlock requires payment: exactly one requirement, in the asset the admission was paid in, at the amount decided when the human answered (the SLA or the grace price). The PAYMENT-REQUIRED header decodes to a PaymentRequired object whose extensions[\"service-windows\"].info repeats terms_id, applied, admitted_at, ready_at, network, asset, and unlock_amount. Check them against the bound terms, sign with the requester wallet, and repeat the same request.",
        "headers": {
          "PAYMENT-REQUIRED": {
            "$ref": "#/components/headers/PaymentRequired"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "maxProperties": 0,
              "description": "Empty over HTTP. The requirement is in the PAYMENT-REQUIRED header; decoded examples are in the PaymentRequired schema."
            },
            "example": {}
          }
        }
      }
    },
    "schemas": {
      "VerifyRequest": {
        "type": "object",
        "required": [
          "intent",
          "claim",
          "agent_id"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What your agent is trying to do. Gives the human the context to judge the claim.",
            "examples": [
              "Publish a launch note to customers"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "The claim, draft, or question a human should judge.",
            "examples": [
              "The new pricing takes effect on 1 September."
            ]
          },
          "agent_id": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "The requester wallet address. It identifies free use and signs paid x402 authorizations. No account or API key exists beyond this address.",
            "examples": [
              "0x1111111111111111111111111111111111111111"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Optional HTTPS endpoint that receives verify.ready or verify.failed. Preferred over polling. It never carries the locked result, only the next action. Must be https on port 443 and must resolve to a public address.",
            "examples": [
              "https://agent.example.com/verifi-events"
            ]
          }
        }
      },
      "Funding": {
        "type": "object",
        "description": "Exactly what this chain costs and was charged, per gate. A contract 3 chain states the bound asset and every amount as a string in that asset's atomic units (6 decimals for USDC and EURC). The *_usdc fields keep their meaning, decimal USDC, on a USDC chain and are null on an EURC chain. A chain admitted before contract 3 has only the *_usdc fields, at the old fixed prices.",
        "properties": {
          "entry_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "initial_free",
              "failure_credit",
              "x402",
              null
            ],
            "description": "How gate 1 was funded. failure_credit: an earned admission credit, bound to the asset of the chain that earned it."
          },
          "free_use_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5,
            "description": "Legacy field: which historical free chain this was, when funded by initial_free. Null for new chains, since free human work is no longer granted."
          },
          "asset": {
            "type": "object",
            "description": "The asset the chain is bound to. The unlock is paid in it.",
            "properties": {
              "network": {
                "type": "string",
                "examples": [
                  "eip155:8453"
                ]
              },
              "address": {
                "type": "string",
                "examples": [
                  "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                  "0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42"
                ]
              },
              "symbol": {
                "type": "string",
                "enum": [
                  "USDC",
                  "EURC"
                ]
              },
              "decimals": {
                "type": "integer",
                "examples": [
                  6
                ]
              }
            }
          },
          "entry_amount_atomic": {
            "type": "string",
            "description": "The admission price in the bound asset.",
            "examples": [
              "120000",
              "100000"
            ]
          },
          "entry_charged_atomic": {
            "type": "string",
            "description": "What gate 1 actually charged. 0 when an admission credit paid it.",
            "examples": [
              "120000",
              "100000",
              "0"
            ]
          },
          "unlock_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "initial_free",
              "x402",
              null
            ],
            "description": "How the unlock was funded. Null until the result is unlocked."
          },
          "unlock_window": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "sla",
              "grace",
              null
            ],
            "description": "The window that priced the unlock. Null until the human answers."
          },
          "unlock_amount_atomic": {
            "type": "string",
            "description": "The unlock price in the bound asset. Until the human answers, the SLA amount: the most the unlock can cost.",
            "examples": [
              "3400000",
              "1700000",
              "2900000",
              "1450000"
            ]
          },
          "unlock_charged_atomic": {
            "type": "string",
            "examples": [
              "0",
              "3400000",
              "1450000"
            ]
          },
          "total_amount_atomic": {
            "type": "string",
            "examples": [
              "3520000",
              "1550000"
            ]
          },
          "total_charged_atomic": {
            "type": "string",
            "examples": [
              "120000",
              "3520000",
              "1550000"
            ]
          },
          "entry_list_price_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "0.12",
              null
            ]
          },
          "entry_charged_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "0.12",
              "0.00",
              null
            ]
          },
          "unlock_list_price_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "3.40",
              "1.70",
              null
            ]
          },
          "unlock_charged_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "3.40",
              "0.00",
              null
            ]
          },
          "total_list_price_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "3.52",
              null
            ]
          },
          "total_charged_usdc": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "3.52",
              "0.12",
              null
            ]
          }
        }
      },
      "UnlockAction": {
        "type": "object",
        "description": "How to pass the unlock gate. Present when status is ready.",
        "properties": {
          "method": {
            "type": "string",
            "examples": [
              "POST"
            ]
          },
          "url": {
            "type": "string",
            "examples": [
              "/verify-unlock?id=0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11"
            ]
          },
          "price_usdc": {
            "type": [
              "string",
              "null"
            ],
            "description": "The unlock price in decimal USDC on a USDC chain. Null on an EURC chain.",
            "examples": [
              "3.40",
              "1.70",
              null
            ]
          },
          "payment_required": {
            "type": "boolean",
            "description": "False only for a legacy chain whose unlock a free entitlement covers."
          },
          "funded_by": {
            "type": "string",
            "enum": [
              "initial_free",
              "x402"
            ]
          },
          "network": {
            "type": "string",
            "examples": [
              "eip155:8453"
            ]
          },
          "asset": {
            "type": "string",
            "description": "The bound asset.",
            "examples": [
              "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42"
            ]
          },
          "asset_symbol": {
            "type": "string",
            "enum": [
              "USDC",
              "EURC"
            ]
          },
          "amount_atomic": {
            "type": "string",
            "description": "The unlock amount in atomic units. Equals service_window.unlock_amount.",
            "examples": [
              "3400000",
              "1450000"
            ]
          },
          "amount_decimal": {
            "type": "string",
            "examples": [
              "3.40",
              "1.45"
            ]
          },
          "applied_window": {
            "type": "string",
            "enum": [
              "sla",
              "grace"
            ]
          }
        }
      },
      "FailureInfo": {
        "type": "object",
        "description": "Why the chain ended without a redeemable result. Present when status is failed.",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "human_timeout",
              "entry_not_settled",
              "processing_failed"
            ],
            "description": "human_timeout: no human answered within the last window, 24 hours after admitted_at (60 minutes for chains admitted before contract 3). entry_not_settled: the gate 1 settlement never arrived, so the chain never entered the queue."
          },
          "entry_credit_granted": {
            "type": "boolean",
            "description": "True when the wallet received one admission credit: its next admission is free, bound to the asset this chain was paid in. The credit never pays an unlock. Granted when gate 1 was actually paid with x402. When gate 1 was funded by an earned credit, that credit is returned to the wallet instead, so it is not lost."
          },
          "entry_credit_value_usdc": {
            "type": [
              "string",
              "null"
            ],
            "description": "The admission price as decimal USDC on a USDC chain, 0.00 when no credit was granted. Null on an EURC chain.",
            "examples": [
              "0.12",
              "0.00",
              null
            ]
          },
          "entry_credit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "next_admission",
              null
            ],
            "description": "What the credit covers. Null when no credit was granted. Contract 3 chains only."
          }
        }
      },
      "ServiceWindow": {
        "type": "object",
        "description": "Why the unlock costs what it costs. Present when status is ready on a contract 3 chain.",
        "properties": {
          "applied": {
            "type": "string",
            "enum": [
              "sla",
              "grace"
            ],
            "description": "sla if ready_at is at or before sla_deadline, otherwise grace. A boundary instant belongs to the earlier window."
          },
          "sla_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "grace_deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "network": {
            "type": "string",
            "examples": [
              "eip155:8453"
            ]
          },
          "asset": {
            "type": "string",
            "examples": [
              "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42"
            ]
          },
          "unlock_amount": {
            "type": "string",
            "description": "The one unlock amount, in the bound asset's atomic units.",
            "examples": [
              "3400000",
              "1700000",
              "2900000",
              "1450000"
            ]
          }
        }
      },
      "BoundTerms": {
        "type": "object",
        "description": "The terms bound to this chain at admission, for the asset it was paid in. They never change afterwards.",
        "properties": {
          "version": {
            "const": 1
          },
          "terms_id": {
            "type": "string",
            "examples": [
              "st_5f0c2a9e4b7d13a8c6e1f042"
            ]
          },
          "windows": {
            "type": "object",
            "required": [
              "sla"
            ],
            "properties": {
              "sla": {
                "type": "object",
                "required": [
                  "within_seconds"
                ],
                "properties": {
                  "within_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "grace": {
                "type": "object",
                "required": [
                  "within_seconds"
                ],
                "properties": {
                  "within_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "price_basis": {
            "type": "object",
            "required": [
              "currency",
              "admission",
              "sla"
            ],
            "properties": {
              "currency": {
                "type": "string"
              },
              "admission": {
                "type": "string"
              },
              "sla": {
                "type": "string"
              },
              "grace": {
                "type": "string"
              }
            }
          },
          "network": {
            "type": "string",
            "examples": [
              "eip155:8453"
            ]
          },
          "asset": {
            "type": "string",
            "examples": [
              "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42"
            ]
          },
          "asset_symbol": {
            "type": "string",
            "enum": [
              "USDC",
              "EURC"
            ]
          },
          "asset_decimals": {
            "type": "integer",
            "examples": [
              6
            ]
          },
          "asset_eip712": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "examples": [
                  "USD Coin",
                  "EURC"
                ]
              },
              "version": {
                "type": "string",
                "examples": [
                  "2"
                ]
              }
            }
          },
          "admission": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "examples": [
              "120000",
              "100000"
            ]
          },
          "sla": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "examples": [
              "3400000",
              "2900000"
            ]
          },
          "grace": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "examples": [
              "1700000",
              "1450000"
            ]
          },
          "asset_binding": {
            "enum": [
              "admission_asset"
            ]
          },
          "expiry": {
            "type": "object",
            "properties": {
              "admission_credit": {
                "enum": [
                  "next_admission",
                  "none"
                ]
              }
            }
          },
          "cancellation": {
            "enum": [
              "none"
            ]
          },
          "conversion": {
            "type": "object",
            "required": [
              "from",
              "rate",
              "source",
              "as_of"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "rate": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "as_of": {
                "type": "string"
              },
              "rounding": {
                "enum": [
                  "up_to_cent",
                  "none"
                ]
              }
            },
            "description": "Present on a USDC chain: how the euro prices were converted."
          }
        }
      },
      "ServiceWindowsInfo": {
        "type": "object",
        "required": [
          "version",
          "terms_id",
          "windows",
          "prices",
          "asset_binding",
          "expiry",
          "cancellation"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "terms_id": {
            "type": "string"
          },
          "terms_valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "windows": {
            "type": "object",
            "required": [
              "sla"
            ],
            "properties": {
              "sla": {
                "type": "object",
                "required": [
                  "within_seconds"
                ],
                "properties": {
                  "within_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "grace": {
                "type": "object",
                "required": [
                  "within_seconds"
                ],
                "properties": {
                  "within_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "price_basis": {
            "type": "object",
            "required": [
              "currency",
              "admission",
              "sla"
            ],
            "properties": {
              "currency": {
                "type": "string"
              },
              "admission": {
                "type": "string"
              },
              "sla": {
                "type": "string"
              },
              "grace": {
                "type": "string"
              }
            }
          },
          "prices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "network",
                "asset",
                "admission",
                "sla"
              ],
              "properties": {
                "network": {
                  "type": "string"
                },
                "asset": {
                  "type": "string"
                },
                "admission": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "sla": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "grace": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "conversion": {
                  "type": "object",
                  "required": [
                    "from",
                    "rate",
                    "source",
                    "as_of"
                  ],
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "rate": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string"
                    },
                    "rounding": {
                      "enum": [
                        "up_to_cent",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          },
          "asset_binding": {
            "enum": [
              "admission_asset"
            ]
          },
          "expiry": {
            "type": "object",
            "properties": {
              "admission_credit": {
                "enum": [
                  "next_admission",
                  "none"
                ]
              }
            }
          },
          "cancellation": {
            "enum": [
              "none",
              "after_sla_admission_credit"
            ]
          },
          "status_url_template": {
            "type": "string"
          },
          "unlock_url_template": {
            "type": "string"
          }
        },
        "description": "The terms in extensions[\"service-windows\"].info of the gate 1 402: the service-windows x402 extension, draft spec Appendix A. Amounts in prices are atomic units of each asset; amounts in price_basis are decimal euros. For each asset, prices[].admission equals the amount of its accepts option."
      },
      "ServiceWindowsUnlockInfo": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "terms_id": {
            "type": "string"
          },
          "applied": {
            "enum": [
              "sla",
              "grace"
            ]
          },
          "admitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "ready_at": {
            "type": "string",
            "format": "date-time"
          },
          "network": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "unlock_amount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "description": "extensions[\"service-windows\"].info of an unlock 402: the decided window and amount, and the timestamps that decided it."
      },
      "ServiceWindowsExtension": {
        "type": "object",
        "description": "The service-windows x402 extension: info, and the JSON Schema that describes info.",
        "properties": {
          "info": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServiceWindowsInfo"
              },
              {
                "$ref": "#/components/schemas/ServiceWindowsUnlockInfo"
              }
            ]
          },
          "schema": {
            "type": "object",
            "description": "JSON Schema for info."
          }
        }
      },
      "VerifyState": {
        "type": "object",
        "description": "The state of one chain. verdict, explanation, and response stay null until the unlock has been passed.",
        "properties": {
          "verify_id": {
            "type": "string",
            "format": "uuid",
            "description": "The durable handle for this chain. Persist it."
          },
          "work_id": {
            "type": "string",
            "format": "uuid",
            "description": "Alias of verify_id, as the service-windows extension names it."
          },
          "contract_version": {
            "type": "integer",
            "enum": [
              2,
              3
            ],
            "description": "3 for chains admitted under the three-gate contract. 2 for chains that finish under the old fixed USDC prices."
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "ready",
              "failed",
              "completed"
            ],
            "description": "processing: admission is settling or a human is working. ready: a human answered but the result is locked. failed: stop. completed: the unlock passed and the answer is available."
          },
          "human_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "accepted",
              "rejected",
              "refined",
              null
            ],
            "description": "The raw human action. Null until completed."
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "true",
              "false",
              "refined",
              null
            ],
            "description": "The parseable verdict. true: the claim holds. false: it does not. refined: the human supplied a better version in explanation. Null until completed."
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ],
            "description": "The human's free text when the verdict is refined. Null until completed."
          },
          "response": {
            "type": [
              "string",
              "null"
            ],
            "description": "The raw human response text. Null until completed."
          },
          "response_time_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How long the human took. Null until completed."
          },
          "wallet_address": {
            "type": [
              "string",
              "null"
            ],
            "description": "The requester wallet that owns this chain."
          },
          "funding": {
            "$ref": "#/components/schemas/Funding"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "admitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the admission settlement was recorded and the chain entered the human queue. The windows start here. Null on the 202 of a paid admission."
          },
          "sla_deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "admitted_at plus 60 minutes. An answer at or before it unlocks at the SLA price."
          },
          "grace_deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "admitted_at plus 24 hours. An answer after sla_deadline and at or before it unlocks at the grace price."
          },
          "ready_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the human answered. It alone decides the unlock price."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When unanswered work fails with human_timeout. On a contract 3 chain it equals grace_deadline, the last deadline, once the chain is admitted: 24 hours after admitted_at. Chains from before contract 3 expire 60 minutes after creation. It is null on the 202 of a paid admission, because the windows have not started yet; read it from the first poll."
          },
          "responded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "unlocked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the unlock passed. Null in the unlock response itself; set on later polls."
          },
          "terms": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoundTerms"
              },
              {
                "type": "null"
              }
            ],
            "description": "The terms bound at admission. Null on chains from before contract 3."
          },
          "next_action": {
            "type": "string",
            "enum": [
              "poll",
              "unlock",
              "stop",
              "done"
            ],
            "description": "What the agent should do next. Follow this instead of inferring from status."
          },
          "poll_url": {
            "type": "string",
            "description": "Present when next_action is poll."
          },
          "retry_after_seconds": {
            "type": "integer",
            "description": "Present when next_action is poll. Honor it.",
            "examples": [
              15
            ]
          },
          "unlock_url": {
            "type": "string",
            "description": "Absolute unlock URL. Present when next_action is unlock.",
            "examples": [
              "https://verifi.cloud/verify-unlock?id=0f3f7d0a-6a1c-4a1e-9d7a-2f6b5b0f9c11"
            ]
          },
          "unlock": {
            "$ref": "#/components/schemas/UnlockAction"
          },
          "service_window": {
            "$ref": "#/components/schemas/ServiceWindow"
          },
          "failure": {
            "$ref": "#/components/schemas/FailureInfo"
          }
        }
      },
      "VerifyAccepted": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VerifyState"
          },
          {
            "type": "object",
            "properties": {
              "response_timeout_ms": {
                "type": "integer",
                "description": "How long the human has to answer before the chain expires: the last window of the bound terms, 24 hours.",
                "examples": [
                  86400000
                ]
              },
              "message": {
                "type": "string",
                "examples": [
                  "Admission accepted. Poll until status is ready or failed."
                ]
              }
            }
          }
        ]
      },
      "PaymentRequired": {
        "type": "object",
        "description": "x402 version 2 PaymentRequired. Over HTTP it is delivered base64 encoded in the PAYMENT-REQUIRED header, and the 402 body is empty. Over MCP it is the structured tool result. See https://docs.x402.org for the canonical schema.",
        "properties": {
          "x402Version": {
            "type": "integer",
            "examples": [
              2
            ]
          },
          "error": {
            "type": "string",
            "description": "Human readable reason the request was not fulfilled."
          },
          "resource": {
            "type": "object",
            "description": "The resource being paid for.",
            "properties": {
              "url": {
                "type": "string",
                "examples": [
                  "https://verifi.cloud/verify"
                ]
              },
              "description": {
                "type": "string"
              },
              "mimeType": {
                "type": "string",
                "examples": [
                  "application/json"
                ]
              }
            }
          },
          "accepts": {
            "type": "array",
            "description": "The payment options the server accepts. Pick one, sign it, and retry the same request. Gate 1 lists USDC first and EURC second. An unlock lists exactly one option, in the bound asset.",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "examples": [
                    "exact"
                  ]
                },
                "network": {
                  "type": "string",
                  "description": "CAIP-2 chain id. Verifi settles on Base mainnet.",
                  "examples": [
                    "eip155:8453"
                  ]
                },
                "amount": {
                  "type": "string",
                  "description": "The required amount in the token's smallest unit. USDC and EURC both have 6 decimals, so 0.10 EURC is 100000.",
                  "examples": [
                    "120000",
                    "100000",
                    "3400000",
                    "1450000"
                  ]
                },
                "asset": {
                  "type": "string",
                  "description": "The token contract. USDC on Base is 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913, EURC on Base is 0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42.",
                  "examples": [
                    "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                    "0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42"
                  ]
                },
                "payTo": {
                  "type": "string",
                  "description": "The receiving address. Funds move from the buyer wallet straight to it."
                },
                "maxTimeoutSeconds": {
                  "type": "integer",
                  "examples": [
                    300
                  ]
                },
                "extra": {
                  "type": "object",
                  "description": "The token's EIP-712 domain name and version, and the id of the quote this option belongs to.",
                  "properties": {
                    "name": {
                      "type": "string",
                      "examples": [
                        "USD Coin",
                        "EURC"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "examples": [
                        "2"
                      ]
                    },
                    "terms_id": {
                      "type": "string",
                      "examples": [
                        "st_5f0c2a9e4b7d13a8c6e1f042"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "extensions": {
            "type": "object",
            "properties": {
              "service-windows": {
                "$ref": "#/components/schemas/ServiceWindowsExtension"
              },
              "bazaar": {
                "type": "object",
                "description": "Bazaar discovery metadata: how to call gate 1. Gate 1 only."
              }
            },
            "additionalProperties": true
          },
