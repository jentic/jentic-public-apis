{
  "openapi": "3.0.3",
  "info": {
    "title": "NexWall Wallpaper REST API",
    "description": "NexWall Wallpaper API by KodNex Technologies is a free wallpaper REST API (JSON) built for wallpaper apps on Android, Flutter, iOS, React Native, web and Python: phone-portrait HD wallpapers up to 4K across 49 categories, plus live (video) wallpapers on Ultra. Free plan: 100 requests/day, 60 requests/minute, 1 API key, no credit card, commercial use allowed; every plan, including Free, may be used in free or paid apps under the NexWall Developer API License. Try it with no API key and no signup: GET https://nexwall.kodnextech.com/api/developer/v1/demo/wallpapers (keyless demo, Free-plan content, limited to 10 requests/minute and 30 requests/day per IP). A free API key is issued immediately at https://nexwall.kodnextech.com/developers/register; send it as `Authorization: Bearer YOUR_API_KEY`. CORS is enabled (*) for browser apps. Free keys include non-premium image content. Pro keys (plan value `premium`): 10,000 requests/day, 180 requests/minute, 3 keys, premium image categories; ₹399/month or ₹3,999/year ($4.99/month or $49.99/year). Ultra keys: 50,000 requests/day, 300 requests/minute, 5 keys, premium and live (video) wallpaper content; ₹899/month or ₹8,999/year ($10.99/month or $109.99/year). Python client: `pip install nexwall`. Guides for Flutter, Android (Kotlin), React Native, iOS SwiftUI, Next.js and Python: https://nexwall.kodnextech.com/wallpaper-api/guides",
    "version": "1.0.1",
    "contact": {
      "name": "NexWall Developer Support",
      "url": "https://nexwall.kodnextech.com/wallpaper-api",
      "email": "support@kodnextech.com"
    },
    "license": {
      "name": "NexWall Developer API License",
      "url": "https://nexwall.kodnextech.com/wallpaper-api/license"
    }
  },
  "externalDocs": {
    "description": "NexWall API documentation and integration examples",
    "url": "https://nexwall.kodnextech.com/wallpaper-api/docs"
  },
  "servers": [
    {
      "url": "https://nexwall.kodnextech.com/api/developer/v1",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/demo/wallpapers": {
      "get": {
        "summary": "Try the API without a key",
        "description": "Keyless demo feed with up to 10 free-plan wallpapers per request. No pagination. Limited to 10 requests per minute and 30 requests per day per IP address. Use an API key for pagination and all other endpoints.",
        "operationId": "getDemoWallpapers",
        "security": [],
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of wallpapers (1-10)",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 }
          },
          { "$ref": "#/components/parameters/CategoryIdQuery" },
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "sort",
            "in": "query",
            "description": "Wallpaper sort order",
            "required": false,
            "schema": { "type": "string", "enum": ["newest", "popular", "random"], "default": "newest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Demo wallpaper list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WallpaperPaginatedResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/PlanUpgradeRequired" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": {
            "description": "Demo rate limit exceeded for this IP address (10 per minute, 30 per day)",
            "headers": {
              "Retry-After": {
                "description": "Seconds until retry is allowed",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List accessible wallpaper categories",
        "description": "Returns active categories allowed by the authenticated developer plan.",
        "operationId": "getCategories",
        "responses": {
          "200": {
            "description": "Category list",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "X-Developer-Api-Plan": { "$ref": "#/components/headers/DeveloperPlan" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/wallpapers": {
      "get": {
        "summary": "List accessible wallpapers",
        "description": "Returns paginated wallpapers allowed by the authenticated developer plan.",
        "operationId": "getWallpapers",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "$ref": "#/components/parameters/CategoryIdQuery" },
          { "$ref": "#/components/parameters/WallpaperType" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Resolution" },
          { "$ref": "#/components/parameters/UpdatedSince" }
        ],
        "responses": {
          "200": {
            "description": "Paginated wallpaper list",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "X-Developer-Api-Plan": { "$ref": "#/components/headers/DeveloperPlan" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WallpaperPaginatedResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PlanUpgradeRequired" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/categories/{categoryId}/wallpapers": {
      "get": {
        "summary": "List wallpapers in a category",
        "description": "Returns paginated wallpapers in the numeric category that are allowed by the authenticated developer plan.",
        "operationId": "getWallpapersByCategory",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "description": "Numeric category ID",
            "schema": { "type": "integer", "minimum": 1 }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "$ref": "#/components/parameters/WallpaperType" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Sort" }
        ],
        "responses": {
          "200": {
            "description": "Paginated wallpaper list",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "X-Developer-Api-Plan": { "$ref": "#/components/headers/DeveloperPlan" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WallpaperPaginatedResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PlanUpgradeRequired" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/wallpapers/{id}": {
      "get": {
        "summary": "Get a wallpaper",
        "description": "Returns one wallpaper when it exists and is allowed by the authenticated developer plan.",
        "operationId": "getWallpaperById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric wallpaper ID",
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallpaper details",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "X-Developer-Api-Plan": { "$ref": "#/components/headers/DeveloperPlan" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SingleWallpaperResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "NexWall API key",
        "description": "Create a developer account at https://nexwall.kodnextech.com/developers/register and send the generated key as Authorization: Bearer YOUR_API_KEY."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Items per page",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
      },
      "CategoryIdQuery": {
        "name": "category_id",
        "in": "query",
        "description": "Filter by numeric category ID",
        "required": false,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "WallpaperType": {
        "name": "type",
        "in": "query",
        "description": "Filter by static image or live wallpaper. Live content requires Ultra.",
        "required": false,
        "schema": { "type": "string", "enum": ["image", "live"] }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "description": "Search wallpaper tags",
        "required": false,
        "schema": { "type": "string", "minLength": 2, "maxLength": 100 }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "description": "Wallpaper sort order. 'random' returns one random sample of up to per_page wallpapers drawn from the newest 200 matching wallpapers: page is ignored and last_page is always 1, while total is the full number of matching wallpapers.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["newest", "oldest", "popular", "random"],
          "default": "newest"
        }
      },
      "Resolution": {
        "name": "resolution",
        "in": "query",
        "description": "Filter wallpapers by resolution (e.g. '4k' or '2160x3840')",
        "required": false,
        "schema": { "type": "string", "maxLength": 20, "example": "4k" }
      },
      "UpdatedSince": {
        "name": "updated_since",
        "in": "query",
        "description": "Catalog sync: returns only wallpapers updated at or after this ISO 8601 date or timestamp (e.g. 2026-01-01 or 2026-01-01T10:05:00Z). A timestamp without an offset is read as IST (Asia/Kolkata). The value is rounded down to the start of the hour, so a sync may return a few wallpapers you already have: de-duplicate by id.",
        "required": false,
        "schema": { "type": "string", "format": "date", "example": "2026-01-01" }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Daily request limit for the current plan",
        "schema": { "type": "integer" }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining today",
        "schema": { "type": "integer" }
      },
      "RateLimitReset": {
        "description": "Unix timestamp for the next daily quota reset",
        "schema": { "type": "integer", "format": "int64" }
      },
      "DeveloperPlan": {
        "description": "Current API plan",
        "schema": { "type": "string", "enum": ["free", "premium", "ultra"] }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Developer API key is missing or invalid",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Wallpaper does not exist or is not available to the current plan",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "PlanUpgradeRequired": {
        "description": "The request needs a higher plan: type=live requires Ultra, and a premium category_id requires Pro or Ultra",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PlanErrorResponse" }
          }
        }
      },
      "ValidationFailed": {
        "description": "Query validation failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
          }
        }
      },
      "RateLimited": {
        "description": "Per-minute or daily request limit exceeded",
        "headers": {
          "Retry-After": {
            "description": "Seconds until retry is allowed",
            "schema": { "type": "integer" }
          },
          "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
          "X-Developer-Api-Plan": { "$ref": "#/components/headers/DeveloperPlan" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RateLimitErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "Category": {
        "type": "object",
        "required": ["id", "name", "slug", "wallpaper_count", "is_premium"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "AMOLED Dark" },
          "slug": { "type": "string", "example": "amoled-dark" },
          "cover_image_url": { "type": "string", "nullable": true, "example": "https://nexwall.kodnextech.com/storage/categories/amoled.webp" },
          "wallpaper_count": { "type": "integer", "example": 24 },
          "is_premium": { "type": "boolean", "example": false }
        }
      },
      "WallpaperCategory": {
        "type": "object",
        "required": ["id", "name", "slug", "is_premium"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "AMOLED Dark" },
          "slug": { "type": "string", "example": "amoled-dark" },
          "is_premium": { "type": "boolean", "example": false }
        }
      },
      "Wallpaper": {
        "type": "object",
        "required": ["id", "category_id", "image_url", "thumbnail_url", "is_premium", "type", "categories"],
        "properties": {
          "id": { "type": "integer", "example": 1042 },
          "category_id": { "type": "integer", "nullable": true, "example": 1 },
          "image_url": { "type": "string", "example": "https://nexwall.kodnextech.com/storage/wallpapers/example.webp" },
          "thumbnail_url": { "type": "string", "nullable": true, "example": "https://nexwall.kodnextech.com/storage/thumbnails/example.webp" },
          "is_premium": { "type": "boolean", "example": false },
          "type": { "type": "string", "enum": ["image", "live"], "example": "image" },
          "video_url": { "type": "string", "nullable": true },
          "video_thumbnail_url": { "type": "string", "nullable": true },
          "duration_seconds": { "type": "integer", "nullable": true },
          "tags": { "type": "string", "nullable": true, "example": "dark, abstract, amoled" },
          "resolution": { "type": "string", "nullable": true, "example": "1440x2560" },
          "width": { "type": "integer", "nullable": true, "example": 1440 },
          "height": { "type": "integer", "nullable": true, "example": 2560 },
          "aspect_ratio": { "type": "string", "example": "9:16" },
          "file_size": { "type": "integer", "nullable": true, "example": 1800000 },
          "license": { "type": "string", "example": "NexWall Commercial Developer License" },
          "category": {
            "type": "object",
            "allOf": [{ "$ref": "#/components/schemas/WallpaperCategory" }],
            "nullable": true
          },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WallpaperCategory" }
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "required": ["data", "plan", "remaining_requests_today"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Category" }
          },
          "plan": { "type": "string", "enum": ["free", "premium", "ultra"], "example": "free" },
          "remaining_requests_today": { "type": "integer", "example": 99 }
        }
      },
      "WallpaperPaginatedResponse": {
        "type": "object",
        "required": ["data", "current_page", "last_page", "per_page", "total", "plan", "remaining_requests_today"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Wallpaper" }
          },
          "current_page": { "type": "integer", "example": 1 },
          "last_page": { "type": "integer", "example": 15 },
          "per_page": { "type": "integer", "example": 50 },
          "total": { "type": "integer", "example": 714 },
          "plan": { "type": "string", "enum": ["free", "premium", "ultra"], "example": "free" },
          "remaining_requests_today": { "type": "integer", "example": 99 }
        }
      },
      "SingleWallpaperResponse": {
        "type": "object",
        "required": ["data", "plan", "remaining_requests_today"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Wallpaper" },
          "plan": { "type": "string", "enum": ["free", "premium", "ultra"], "example": "free" },
          "remaining_requests_today": { "type": "integer", "example": 99 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "status": { "type": "integer", "example": 401 },
          "message": { "type": "string" },
          "data": { "type": "array", "items": {} }
        }
      },
      "PlanErrorResponse": {
        "type": "object",
        "required": ["success", "status", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "status": { "type": "integer", "example": 403 },
          "error": { "type": "string", "example": "Forbidden" },
          "message": { "type": "string" },
          "required_plan": { "type": "string", "enum": ["premium", "ultra"], "example": "ultra" },
          "current_plan": { "type": "string", "enum": ["free", "premium", "ultra"], "example": "free" },
          "upgrade_url": { "type": "string", "example": "https://nexwall.kodnextech.com/wallpaper-api#pricing-section" },
          "data": { "type": "array", "items": {} }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "The per page field must not be greater than 100." },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "RateLimitErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "status": { "type": "integer", "example": 429 },
          "error": { "type": "string", "enum": ["rate_limit_exceeded", "per_minute_limit_exceeded"], "description": "rate_limit_exceeded: daily quota used up (quota is included). per_minute_limit_exceeded: per-minute limit hit; honor Retry-After.", "example": "rate_limit_exceeded" },
          "message": { "type": "string" },
          "error_description": { "type": "string" },
          "data": { "type": "array", "items": {} },
          "remaining_requests_today": { "type": "integer", "example": 0 },
          "quota": {
            "type": "object",
            "properties": {
              "plan": { "type": "string", "example": "free" },
              "limit": { "type": "integer", "example": 100 },
              "used": { "type": "integer", "example": 100 },
              "remaining": { "type": "integer", "example": 0 },
              "resets_at": { "type": "string", "format": "date-time" },
              "retry_after_seconds": { "type": "integer" },
              "upgrade_url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
