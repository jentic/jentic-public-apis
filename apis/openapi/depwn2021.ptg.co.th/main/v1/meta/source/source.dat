              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeListResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v1/emp/GetEmpcodeSubordinate/{positionCode}": {
      "get": {
        "tags": [
          "Employee Data"
        ],
        "summary": "Get Employee Subordinate by Position Code",
        "description": "API สำหรับดึงข้อมูลพนักงานทั้งหมดในระบบ PTG ภายใต้รหัสพนักงานที่ระบุ",
        "operationId": "EMP002",
        "parameters": [
          {
            "name": "positionCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
