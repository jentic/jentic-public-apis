                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v1/emp/GetEmployeeByPersonCode/{personCode}": {
      "get": {
        "tags": [
          "Employee Data"
        ],
        "summary": "Get Employee by Person Code",
        "description": "API สำหรับดึงข้อมูลพนักงานตามรหัสพนักงานที่ระบุ",
        "operationId": "EMP003",
        "parameters": [
          {
            "name": "personCode",
            "in": "path",
            "description": "รหัสพนักงาน",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "002285"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
