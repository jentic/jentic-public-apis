{
  "openapi": "3.0.4",
  "info": {
    "title": "PTG PMS Connect API",
    "description": "API for PTG PMS Connect service that allows equipment management and authentication",
    "contact": {
      "name": "PTG Support Team",
      "url": "https://www.ptg.co.th/contact",
      "email": "cs@ptg.co.th"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://www.ptg.co.th/terms"
    },
    "version": "v1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/KONDESIGNTEAM/ptg-pms-connect-api/v1"
  },
  "servers": [
    {
      "url": "https://depwn2021.ptg.co.th/ptgpmsapi",
      "description": "UAT Server"
    }
  ],
  "paths": {
    "/v1/auth/createtoken": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create torken",
        "description": "Create token for outsours ",
        "operationId": "CreateToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StringResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v1/auth/validateLogin/{username}/{timestamp}": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Check employee login",
        "description": "API สำหรับดึงข้อมูล พนักงาน",
        "operationId": "AUTH001",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "Employee username",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timestamp",
            "in": "path",
            "description": "Unix timestamp (seconds since epoch) used for request validation, must be within 5 minutes of current time",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/auth/validateADLogin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create torken",
        "description": "Create token for outsours ",
        "operationId": "ValidateADLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v1/auth/validateADLoginDebug": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create torken",
        "description": "Create token for outsours ",
        "operationId": "ValidateADLoginDebug",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StringResponseData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v1/emp/employees": {
      "post": {
        "tags": [
          "Employee Data"
        ],
        "summary": "Get All Employee",
        "description": "API สำหรับดึงข้อมูลพนักงานทั้งหมดในระบบ PTG ที่มีการแก้ไขหรือ เพิ่ม update ล่าสุด",
        "operationId": "EMP001",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmpParam"
              }
            }
          },
          "required": true
