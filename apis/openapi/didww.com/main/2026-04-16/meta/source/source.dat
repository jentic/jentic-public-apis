          }
        ],
        "responses": {
          "200": {
            "description": "export updated",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDocument"
                }
              }
            }
          },
          "404": {
            "description": "no export with that id belongs to the customer",
            "content": {
              "application/vnd.api+json": {
                "schema": {
