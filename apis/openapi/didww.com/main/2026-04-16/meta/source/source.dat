                    "maxLength": 200,
                    "example": "10 Downing Street"
                  },
                  "city_name": {
                    "type": "string",
                    "example": "London"
                  },
                  "postal_code": {
                    "type": "string",
                    "example": "SW1A 2AA"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "Free-form customer note."
                  },
                  "external_reference_id": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's own identifier for the address.",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        }
