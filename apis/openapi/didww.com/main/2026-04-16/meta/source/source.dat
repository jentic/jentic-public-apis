                "minItems": 1,
                "uniqueItems": true,
                "maxItems": 60,
                "items": {
                  "type": "string",
                  "example": "203.0.113.10"
                }
              },
              "tech_prefix": {
                "type": "string",
                "nullable": true,
                "description": "Prefix stripped from the dialled number before routing. Digits and `#` only, and rejected when the authentication method is the Twilio one.",
                "maxLength": 8,
                "pattern": "^[0-9#]+$"
              }
            }
          }
        }
      },
