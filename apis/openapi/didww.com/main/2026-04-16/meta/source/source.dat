                    "example": "EU inbound"
                  },
                  "capacity_limit": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Maximum simultaneous calls across the whole group. Null means no limit.",
                    "minimum": 1,
                    "maximum": 32767
                  },
                  "external_reference_id": {
                    "type": "string",
                    "nullable": true,
                    "description": "Customer's own identifier for the group.",
                    "maxLength": 100
                  }
                }
              },
              "relationships": {
                "type": "object",
                "properties": {
                  "voice_in_trunks": {
                    "type": "object",
