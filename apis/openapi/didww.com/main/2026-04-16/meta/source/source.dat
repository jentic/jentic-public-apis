          "links"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmergencyRequirement"
            }
          },
          "included": {
            "type": "array",
            "description": "Compound document. Present only when `include` was sent.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Country"
                },
                {
