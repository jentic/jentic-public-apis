            },
            "terminated": {
              "type": "boolean",
              "description": "Matches DIDs that have been cancelled."
            },
            "trunk.id": {
              "type": "string",
              "description": "Matches DIDs routed to the voice_in_trunk. A legacy alias of `voice_in_trunk.id`. Accepts a comma-separated list, matching any of the values."
