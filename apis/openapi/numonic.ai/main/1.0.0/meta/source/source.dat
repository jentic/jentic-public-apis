vent_type":{"type":"string","description":"Event type (required for event triggers)"},"event_data":{"type":"object","additionalProperties":{},"description":"Event payload data"},"tenant_id":{"type":"string","format":"uuid","description":"Tenant UUID (required for event triggers)"}},"required":["trigger_type"]},"ModelSummary":{"type":"object","properties":{"model":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"SHA-1 hash identifying this model"},"model_id":{"type":["string","null"],"format":"uuid","description":"Optional UUID identifier"},"name":{"type":"string","description":"Canonical model name"},"display_name":{"type":["string","null"],"description":"Human-friendly display name"},"model_type":{"type":["string","null"],"description":"Model type (lora, checkpoint, unet, etc.)"},"base_model":{"type":["string","null"],"description":"Base model family (flux, sdxl, etc.)"},"recommended_weight":{"type":["number","null"],"description":"Recommended weight/strength"},"trigger_words":{"type":["array","null"],"items":{"type":"string"},"description":"Trigger words for prompt activation"},"external_url":{"type":["string","null"],"format":"uri","description":"Source page URL"},"created_at":{"type":["string","null"],"format":"date-time"},"updated_at":{"type":["string","null"],"format":"date-time"},"asset_usage_count":{"type":"integer","description":"Number of assets generated with this model"}},"required":["model","name","asset_usage_count"]},"ModelVersion":{"type":"object","properties":{"version_tag":{"type":"string","description":"Version identifier"},"version_notes":{"type":["string","null"]},"training_steps":{"type":["integer","null"]},"quality_score":{"type":["number","null"]},"is_recommended":{"type":"boolean"},"trained_at":{"type":["string","null"],"format":"date-time"},"load_date":{"type":"string","format":"date-time"}},"required":["version_tag","is_recommended","load_date"]},"ModelDetail":{"allOf":[{"$ref":"#/components/schemas/ModelSummary"},{"type":"object","properties":{"description":{"type":["string","null"],"description":"Freeform model description"},"is_active":{"type":"boolean"},"versions":{"type":"array","items":{"$ref":"#/components/schemas/ModelVersion"}},"preview_count":{"type":"integer","description":"Number of preview images available"}},"required":["is_active","versions","preview_count"]}],"description":"Full model record including version history"},"AssetSummary":{"type":"object","properties":{"asset_h":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset SHA-1 hash"},"title":{"type":["string","null"]},"filename":{"type":["string","null"]},"mime_type":{"type":["string","null"]},"status":{"type":["string","null"]},"created_at":{"type":["string","null"],"format":"date-time"},"similarity_score":{"type":["number","null"],"description":"Relevance score when returned from search"},"tags":{"type":["array","null"],"items":{"type":"string"}},"thumbnail_url":{"type":["string","null"],"format":"uri","description":"Pre-signed thumbnail URL"},"download_url":{"type":["string","null"],"format":"uri"},"thumbnails":{"type":["object","null"],"properties":{"square":{"type":"object","properties":{"small":{"type":"string","format":"uri"},"medium":{"type":"string","format":"uri"}}},"aspectRatio":{"type":"object","properties":{"small":{"type":"string","format":"uri"},"medium":{"type":"string","format":"uri"}}}},"description":"Signed thumbnail URLs by variant and size"},"aspect_ratio":{"type":["number","null"]},"original_width":{"type":["integer","null"]},"original_height":{"type":["integer","null"]}},"required":["asset_h"],"description":"Compact asset representation with signed thumbnail URLs"},"CreativeSession":{"type":"object","properties":{"session_id":{"type":"string","description":"Unique session identifier"},"session_start":{"type":"string","format":"date-time","description":"Timestamp of the earliest asset in the session"},"session_end":{"type":"string","format":"date-time","description":"Timestamp of the latest asset in the session"},"tool":{"type":["string","null"],"description":"Dominant tool used in this session (Midjourney, ComfyUI, Generic)"},"asset_count":{"type":"integer","description":"Total assets in the session"},"assets":{"type":"array","items":{"$ref":"#/components/schemas/SessionAsset"}}},"required":["session_id","session_start","session_end","asset_count","assets"],"description":"A time-bounded group of assets from a continuous creative workflow"},"ReviewSubmission":{"type":"object","properties":{"ref":{"type":"string","example":"native:a1b2…"},"projectRef":{"type":"string"},"workItemRef":{"type":"string"},"title":{"type":"string"},"media":{"type":"object","properties":{"versionNumber":{"type":"integer"},"media":{"type":"object","properties":{"kind":{"type":"string","enum":["numonic-asset"]},"assetH":{"type":"string"}},"required":["kind","assetH"]},"numonicAssetH":{"type":"string"}},"required":["versionNumber","media"]},"state":{"type":"string","enum":["pending","needs_changes","approved"]},"submittedBy":{"type":"object","properties":{"displayName":{"type":"string"},"numonicAgentId":{"type":"string"}},"required":["displayName"]},"submittedAt":{"type":"string"},"supersedes":{"type":"string"},"decisions":{"type":"array","items":{"type":"object","properties":{"outcome":{"type":"string","enum":["needs_changes","approved"]},"decidedBy":{"type":"object","properties":{"displayName":{"type":"string"},"numonicAgentId":{"type":"string"}},"required":["displayName"]},"decidedAt":{"type":"string"}},"required":["outcome","decidedBy","decidedAt"]}},"externalRefs":{"type":"array","items":{}}},"required":["ref","projectRef","title","media","state","submittedBy","submittedAt","decisions","externalRefs"],"description":"`state` is derived: the latest decision outcome, else `pending`. A resubmission is a new submission with `supersedes` and the next `versionNumber`."},"ReviewComment":{"type":"object","properties":{"ref":{"type":"string"},"submissionRef":{"type":"string"},"body":{"type":"string","description":"Markdown"},"author":{"type":"object","properties":{"displayName":{"type":"string"},"numonicAgentId":{"type":"string"}},"required":["displayName"]},"createdAt":{"type":"string"},"replyTo":{"type":"string"},"mentions":{"type":"array","items":{"type":"string"}}},"required":["ref","submissionRef","body","author","createdAt"]}},"parameters":{}},"paths":{"/api/v1/collections":{"get":{"summary":"List collections tree","description":"Retrieve the collection hierarchy for the current tenant. Supports depth limiting and pagination.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string"},"required":false,"name":"parentPath","in":"query"},{"schema":{"type":"number","minimum":1},"required":false,"name":"depth","in":"query"},{"schema":{"type":"string","default":"false"},"required":false,"name":"includeAssetCounts","in":"query"},{"schema":{"type":"number","minimum":1,"maximum":1000},"required":false,"name":"limit","in":"query"},{"schema":{"type":["number","null"],"minimum":0},"required":false,"name":"offset","in":"query"},{"schema":{"type":"string","format":"uuid","description":"Target tenant UUID. Required when API key has access to multiple tenants.","example":"fd32351e-ddfc-4800-9182-cb16e0bc5f5b"},"required":false,"name":"X-Tenant-ID","in":"header"}],"responses":{"200":{"description":"Collection tree retrieved successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CollectionListResponse"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Create a collection","description":"Create a new collection. Collections support nested paths up to 5 levels deep (e.g., Projects/Nike/Campaign1) with ordered asset membership.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl -X POST https://numonic.ai/api/v1/collections \\\n  -H \"x-api-key: napi_your_key\" \\\n  -H \"X-Tenant-ID: fd32351e-ddfc-4800-9182-cb16e0bc5f5b\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"name\": \"Client Deliverables\", \"parent_path\": \"/Projects\"}'"},{"lang":"javascript","label":"JavaScript","source":"const res = await fetch(\"https://numonic.ai/api/v1/collections\", {\n  method: \"POST\",\n  headers: {\n    \"x-api-key\": \"napi_your_key\",\n    \"X-Tenant-ID\": tenantId,\n    \"Content-Type\": \"application/json\",\n  },\n  body: JSON.stringify({\n    name: \"Client Deliverables\",\n    parent_path: \"/Projects\",\n  }),\n});"}],"parameters":[{"schema":{"type":"string","format":"uuid","description":"Target tenant UUID. Required when API key has access to multiple tenants.","example":"fd32351e-ddfc-4800-9182-cb16e0bc5f5b"},"required":true,"name":"X-Tenant-ID","in":"header"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCollectionRequest"}}}},"responses":{"201":{"description":"Collection created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"400":{"description":"Validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}":{"get":{"summary":"Get collection details","description":"Retrieve details for a specific collection including metadata and child counts.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"responses":{"200":{"description":"Collection details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CollectionDetailsResponse"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update a collection","description":"Update collection display name, description, icon, or color.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCollectionRequest"}}}},"responses":{"200":{"description":"Collection updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete a collection","description":"Delete a collection. Use cascade=true to also delete descendant collections.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"},{"schema":{"type":"string","default":"true"},"required":false,"name":"cascade","in":"query"}],"responses":{"200":{"description":"Collection deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}/assets":{"get":{"summary":"List assets in collection","description":"Retrieve all assets belonging to a specific collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"paramet