ction","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found in collection","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}/assets/reorder":{"patch":{"summary":"Reorder assets in collection","description":"Update the display order of assets within a collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderAssetsRequest"}}}},"responses":{"200":{"description":"Assets reordered","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}/publish":{"post":{"summary":"Publish a collection","description":"Publish a collection as a public gallery with privacy-aware metadata handling. Choose a disclosure preset to control what metadata is exposed: `share` (full), `portfolio` (creative only), `client` (minimal), or `archive` (original preserved). Creates stable public URLs for all collection assets.","tags":["Collections","Publishing"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublishCollectionRequest"}}}},"responses":{"200":{"description":"Collection published","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Unpublish collection","description":"Remove a collection from public access.","tags":["Collections","Publishing"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"responses":{"200":{"description":"Collection unpublished","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/annotations":{"post":{"summary":"Create an annotation","description":"Create a new annotation on a workflow node with content type, visibility, and audit trail.","tags":["Annotations"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","format":"uuid","description":"Target tenant UUID. Required when API key has access to multiple tenants.","example":"fd32351e-ddfc-4800-9182-cb16e0bc5f5b"},"required":true,"name":"X-Tenant-ID","in":"header"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAnnotationRequest"}}}},"responses":{"201":{"description":"Annotation created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"400":{"description":"Validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"get":{"summary":"Get annotations for a workflow node","description":"Retrieve all annotations for a specific workflow node. Supports filtering by resolved status.","tags":["Annotations"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","minLength":1,"description":"Workflow node ID to get annotations for"},"required":true,"description":"Workflow node ID to get annotations for","name":"workflow_node_id","in":"query"},{"schema":{"type":"string","description":"Include resolved annotations (default: false)"},"required":false,"description":"Include resolved annotations (default: false)","name":"include_resolved","in":"query"}],"responses":{"200":{"description":"Annotations retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnnotationsListResponse"}}}}}}},"/api/v1/annotations/{annotationH}":{"patch":{"summary":"Update an annotation","description":"Update annotation content or visibility. Creates a new immutable version (append-only edit pattern).","tags":["Annotations"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateAnnotationRequest"}}}},"responses":{"200":{"description":"Annotation updated (new version created)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Annotation not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete an annotation","description":"Soft-delete an annotation (sets status to deleted, preserving audit trail).","tags":["Annotations"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"responses":{"200":{"description":"Annotation deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Annotation not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets":{"post":{"summary":"Create an asset","description":"Register a new asset after uploading via signed URL. Triggers metadata extraction and embedding generation.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","format":"uuid","description":"Target tenant UUID. Required when API key has access to multiple tenants.","example":"fd32351e-ddfc-4800-9182-cb16e0bc5f5b"},"required":true,"name":"X-Tenant-ID","in":"header"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAssetRequest"}}}},"responses":{"201":{"description":"Asset created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssetCreatedResponse"}}}},"400":{"description":"Validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"get":{"summary":"List assets","description":"List or search assets for the current tenant with pagination.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Assets retrieved","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AssetDetailsResponse"}},"pagination":{"type":"object","properties":{"limit":{"type":"integer"},"offset":{"type":"integer"},"total":{"type":"integer"}},"required":["limit","offset"]}},"required":["data","pagination"]}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/cross-tool-lineage":{"get":{"summary":"Get cross-tool lineage","description":"Retrieve the lineage graph for an asset across creative tools. Each node reports the tool it came from (midjourney, comfyui or unknown). Returns empty node and edge lists when the asset has no lineage.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"},{"schema":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of hops to traverse (default 10)","example":10},"required":false,"name":"max_depth","in":"query"}],"responses":{"200":{"description":"Lineage retrieved","content":{"application/json":{"schema":{"type":"object","properties":{"asset_h":{"type":"string","description":"Requested asset hash"},"nodes":{"type":"array","items":{"type":"object","properties":{"depth":{"type":"integer"},"asset_h":{"type":"string"},"parent_asset_h":{"type":["string","null"]},"relationship_type":{"type":["string","null"]},"source_tool":{"type":"string","enum":["midjourney","comfyui","unknown"]},"title":{"type":["string","null"]},"filename":{"type":["string","null"]},"thumbnail_path":{"type":["string","null"]}},"required":["depth","asset_h","parent_asset_h","relationship_type","source_tool","title","filename","thumbnail_path"]}},"edges":{"type":"array","items":{"type":"object","properties":{"from":{"type":"string"},"to":{"type":"string"},"relationship_type":{"type":["string","null"]}},"required":["from","to","relationship_type"]}}},"required":["asset_h","nodes","edges"]}}}},"400":{"description":"Invalid asset hash or max_depth","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/provenance":{"post":{"summary":"Record a provenance assertion","description":"Record a user-asserted provenance statement for an asset: its prompt, a source asset, a workflow file, or a declaration that it is not AI-generated or has an unknown origin. The request body is selected by `assertion_type`. Requires the `write` scope.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"assertion_type":{"type":"string","enum":["prompt"]},"prompt_text":{"type":"string","minLength":1,"maxLength":20000},"negative_prompt":{"type":"string","maxLength":20000},"model_name":{"type":"string","maxLength":255},"seed":{"type":"integer"},"note":{"type":"string","maxLength":2000}},"required":["assertion_type","prompt_text"]},{"type":"object","properties":{"assertion_type":{"type":"string","enum":["source_link"]},"source_asset_h":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Hash of the source asset"},"note":{"type":"string","maxLength":2000}},"required":["assertion_type","source_asset_h"]},{"type":"object","properties":{"assertion_type":{"type":"string","enum":["workflow"]},"workflow_filename":{"type":"string","minLength":1,"maxLength":512},"workflow_json":{"type":"object","additionalProperties":{},"description":"Workflow JSON (up to about 2 MB)"},"note":{"type":"string","maxLength":2000}},"required":["assertion_type","workflow_json"]},{"type":"object","properties":{"assertion_type":{"type":"string","enum":["origin_declaration"]},"origin_declaration":{"type":"string","enum":["non_ai","unknown"]},"note":{"type":"string","maxLength":2000}},"required":["assertion_type","origin_declaration"]}]}}}},"responses":{"201":{"description":"Provenance assertion recorded","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string"},"assertion_type":{"type":"string"},"recorded_at":{"type":"string"},"lineage_link_h":{"type":["string","null"],"description":"Hash of the lineage link created by a source_link assertion, otherwise null"}},"required":["message","assertion_type","recorded_at","lineage_link_h"]}}}},"400":{"description":"Invalid asset hash or request body","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Permission denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Asset or source asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/comfy-lineage/asset/signed-url":{"post":{"summary":"Get a signed upload URL for a ComfyUI asset","description":"Mint a signed upload URL for a ComfyUI output. PUT the file bytes to `signedUrl`, then call POST /import/comfyui/confirm-upload with the returned `path`. The tenant is resolved from the API key. Requires the `write` or `comfy-ingest` scope.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"filename":{"type":"string","minLength":1,"maxLength":255,"description":"Original filename","example":"ComfyUI_00001_.png"},"contentType":{"type":"string","description":"MIME type","example":"image/png"}},"required":["filename","contentType"]}}}},"responses":{"200":{"description":"Signed upload URL created","content":{"application/json":{"schema":{"type":"object","properties":{"signedUrl":{"type":"string"},"token":{"type":"string"},"path":{"type":"string","description":"Storage path to pass to confirm-upload"}},"required":["signedUrl","token","path"]}}}},"400":{"description":"Invalid request body","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Signed URL could not be created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/import/comfyui":{"post":{"summary":"Import a ComfyUI file","description":"Upload a ComfyUI output (PNG, video or audio, up to 500 MB) as multipart form data and create an asset from it. Workflow metadata embedded in the file is extracted. Requires the `write` scope. For large files, use the signed-URL flow with POST /import/comfyui/confirm-upload instead.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","description":"The file to import","format":"binary"},"metadata":{"type":"string","description":"Optional JSON string of metadata for the file"}},"required":["file"]}}}},"responses":{"200":{"description":"Asset created","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"warning":{"type":["string","null"]},"asset":{"type":"object","properties":{"assetH":{"type":"string"},"filename":{"type":"string"},"fileSize":{"type":"integer"},"toolName":{"type":"string"},"storagePath":{"type":"string"}},"required":["assetH","filename","fileSize","toolName","storagePath"]},"metadata":{"type":["object","null"],"additionalProperties":{}},"isVideo":{"type":"boolean"}},"required":["success","warning","asset","metadata","isVideo"]}}}},"400":{"description":"Missing file, unsupported file type, malformed body, or invalid metadata JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"413":{"description":"File too large","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/import/comfyui/confirm-upload":{"post":{"summary":"Confirm a ComfyUI upload","description":"Finish an upload made to a signed URL: the file is read from storage, its metadata is extracted and an asset is created. The `path` must come from POST /comfy-lineage/asset/signed-url and belong to your tenant. Requires the `write` or `comfy-ingest` scope.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Storage path returned when the signed URL was issued"},"filename":{"type":"string","minLength":1,"maxLength":255},"fileSize":{"type":"integer","exclusiveMinimum":0,"maximum":524288000},"mimeType":{"type":"string","enum":["image/png","video/mp4","video/webm","video/quicktime","video/x-msvideo","video/x-matroska","audio/mpeg","audio/wav","audio/ogg","audio/flac","audio/mp4","audio/opus"]},"importBatchId":{"type":"string","format":"uuid"},"folderIdentity":{"type":"string","minLength":1,"maxLength":1024},"clientThumbnails":{"type":"object","properties":{"square":{"type":"object","additionalProperties":{"type":"string"}},"aspectRatio":{"type":"object","additionalProperties":{"type":"string"}}}}},"required":["path","filename","fileSize","mimeType"]}}}},"responses":{"200":{"description":"Asset created","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean","enum":[true]},"warning":{"type":["string","null"]},"url":{"type":"string","description":"Link to the asset in the Numonic app"},"asset":{"type":"object","properties":{"assetH":{"type":"string"},"filename":{"type":"string"},"fileSize":{"type":"integer"},"toolName":{"type":"string"},"storagePath":{"type":"string"},"thumbnailsGenerated":{"type":"boolean"}},"required":["assetH","filename","fileSize","toolName","storagePath","thumbnailsGenerated"]},"metadata":{"type":["object","null"],"additionalProperties":{}}},"required":["success","warning","url","asset","metadata"]}}}},"400":{"description":"Invalid request body or storage path not in your tenant","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"File not found in storage","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/export":{"post":{"summary":"Export a single asset","description":"Export an asset with optional format conversion and privacy-aware metadata handling. Apply a disclosure preset to control what metadata is included in the exported file, matching the same presets used for publishing.","tags":["Export"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SingleExportRequest"}}}},"responses":{"200":{"description":"Export completed, download URL returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignedUrlResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/webhooks":{"post":{"summary":"Register a webhook","description":"Subscribe to Numonic events (asset.created, collection.published, pipeline.completed, etc.) via HTTP callback. asset.created is delivered once an uploaded asset has finished processing. Works with a session or an API key with the write scope; an API key registers webhooks for its own workspace only. Returns an HMAC-SHA256 signing secret for payload verification — this secret is shown only once, so store it securely.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl -X POST https://numonic.ai/api/v1/webhooks \\\n  -H \"x-api-key: napi_your_key\" \\\n  -H \"X-Tenant-ID: fd32351e-ddfc-4800-9182-cb16e0bc5f5b\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"url\": \"https://your-app.com/webhooks/numonic\",\n    \"events\": [\"asset.created\", \"pipeline.completed\"]\n  }'"},{"lang":"python","label":"Python","source":"import requests\n\nres = requests.post(\n    \"https://numonic.ai/api/v1/webhooks\",\n    headers={\n        \"x-api-key\": \"napi_your_key\",\n        \"X-Tenant-ID\": tenant_id,\n    },\n    json={\n        \"url\": \"https://your-app.com/webhooks/numonic\",\n        \"events\": [\"asset.created\", \"pipeline.completed\"],\n    },\n)\n# Store the signing_secret securely — shown only once\nsecret = res.json()[\"signing_secret\"]"}],"parameters":[{"schema":{"type":"string","format":"uuid","description":"Target tenant UUID. Required when API key has access to multiple tenants.","example":"fd32351e-ddfc-4800-9182-cb16e0bc5f5b"},"required":true,"name":"X-Tenant-ID","in":"header"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateWebhookRequest"}}}},"responses":{"201":{"description":"Webhook registered. HMAC secret returned (store securely — shown once).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookCreatedResponse"}}}},"400":{"description":"Validation failed or invalid URL (SSRF protection)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Webhook subscription already exists","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"get":{"summary":"List webhook subscriptions","description":"List all webhook subscriptions for the current tenant. Supports filtering by enabled status.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","enum":["true","false"],"description":"Filter by enabled status"},"required":false,"name":"enabled","in":"query"}],"responses":{"200":{"description":"Webhook subscriptions listed","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/WebhookResponse"}}},"required":["data"]}}}}}}},"/api/v1/health":{"get":{"summary":"Health check","description":"Basic health check endpoint. Returns 200 if the API is running.","tags":["Health"],"security":[],"responses":{"200":{"description":"API is healthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthCheckResponse"}}}}}}},"/api/v1/health/database":{"get":{"summary":"Database health check","description":"Check database connectivity and query latency.","tags":["Health"],"security":[],"responses":{"200":{"description":"Database is healthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthCheckResponse"}}}},"503":{"description":"Database is unhealthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/health/services":{"get":{"summary":"External services health","description":"Check connectivity to external services (storage, AI, etc.).","tags":["Health"],"security":[],"responses":{"200":{"description":"All services healthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthCheckResponse"}}}},"503":{"description":"One or more services unhealthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/health/storage":{"get":{"summary":"Storage health check","description":"Check object storage connectivity and access.","tags":["Health"],"security":[],"responses":{"200":{"description":"Storage is healthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthCheckResponse"}}}},"503":{"description":"Storage is unhealthy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}":{"get":{"summary":"Get asset details","description":"Retrieve full details for a specific asset including metadata.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl https://numonic.ai/api/v1/assets/e3b0c44298fc1c149afbf4c8996fb92427ae41e4 \\\n  -H \"x-api-key: napi_your_key\""},{"lang":"javascript","label":"JavaScript","source":"const res = await fetch(\n  `https://numonic.ai/api/v1/assets/${assetH}`,\n  { headers: { \"x-api-key\": \"napi_your_key\" } }\n);\nconst asset = await res.json();\nconsole.log(asset.title, asset.status, asset.tags);"},{"lang":"python","label":"Python","source":"import requests\n\nres = requests.get(\n    f\"https://numonic.ai/api/v1/assets/{asset_h}\",\n    headers={\"x-api-key\": \"napi_your_key\"},\n)\nasset = res.json()\nprint(asset[\"title\"], asset[\"status\"])"}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Asset details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssetDetailsResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update asset metadata","description":"Update editable metadata fields for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateAssetRequest"}}}},"responses":{"200":{"description":"Asset updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssetUpdatedResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/c2pa":{"get":{"summary":"Get C2PA provenance manifest","description":"Retrieve the [C2PA](https://numonic.ai/glossary/c2pa) content provenance manifest for an asset, if available. C2PA (Coalition for Content Provenance and Authenticity) manifests are cryptographic records of content origin and edit history — used for AI transparency compliance and content authenticity verification. Returns the stored manifest data including signer, assertions, and claim details.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"C2PA manifest retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/C2PAStatusResponse"}}}},"404":{"description":"Asset not found or no manifest","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Generate C2PA manifest","description":"Request generation of a C2PA content provenance manifest for an asset. Numonic's schema is architected for C2PA compliance — manifests capture the asset's provenance chain including generation tool, parameters, and edit history.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/C2paDetectRequest"}}}},"responses":{"201":{"description":"C2PA manifest generated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/embedding-status":{"get":{"summary":"Get embedding generation status","description":"Check the status of vector embedding generation for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Embedding status retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmbeddingStatusResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/evolution-chain":{"get":{"summary":"Get Midjourney evolution chain","description":"Retrieve the Midjourney prompt evolution chain for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Evolution chain retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvolutionChainResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/lineage":{"get":{"summary":"Get asset lineage","description":"Retrieve the lineage graph for an asset (parents and children).","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Lineage retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LineageResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Add lineage relationship","description":"Add a parent-child lineage relationship to an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"201":{"description":"Lineage relationship created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/notes":{"get":{"summary":"Get asset notes","description":"Retrieve all notes (annotations) attached to an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Notes retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotesListResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Create asset note","description":"Create a new note on an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateNoteRequest"}}}},"responses":{"201":{"description":"Note created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/notes/{annotationH}":{"patch":{"summary":"Update asset note","description":"Update an existing note on an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"},{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateNoteRequest"}}}},"responses":{"200":{"description":"Note updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Note not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete asset note","description":"Soft-delete a note on an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"},{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"responses":{"200":{"description":"Note deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Note not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/parse-workflow":{"post":{"summary":"Parse ComfyUI workflow from asset","description":"Extract and parse a ComfyUI workflow embedded in asset metadata.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ParseWorkflowRequest"}}}},"responses":{"200":{"description":"Workflow parsed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/session":{"get":{"summary":"Get creative session for asset","description":"Retrieve the creative session context for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Session retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreativeSessionResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/technical-metadata":{"get":{"summary":"Get EXIF/technical metadata","description":"Retrieve EXIF and technical metadata for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Technical metadata retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TechnicalMetadataResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/{assetH}/workflow-metadata":{"get":{"summary":"Get workflow metadata","description":"Retrieve workflow metadata (ComfyUI, A1111, etc.) for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Workflow metadata retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowMetadataResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Set workflow metadata","description":"Store workflow metadata for an asset.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowMetadataRequest"}}}},"responses":{"200":{"description":"Workflow metadata stored","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/assets/bulk-delete":{"delete":{"summary":"Bulk soft-delete assets","description":"Move multiple assets to trash in a single operation.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkDeleteRequest"}}}},"responses":{"200":{"description":"Assets moved to trash","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}}}}},"/api/v1/assets/bulk-export":{"post":{"summary":"Bulk export assets","description":"Export multiple assets with format conversion and metadata stripping.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkExportRequest"}}}},"responses":{"200":{"description":"Bulk export started","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}}}}},"/api/v1/assets/bulk-restore":{"post":{"summary":"Bulk restore from trash","description":"Restore multiple assets from trash.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkRestoreRequest"}}}},"responses":{"200":{"description":"Assets restored","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}}}}},"/api/v1/assets/bulk-tag":{"patch":{"summary":"Bulk add/remove tags","description":"Add or remove tags from multiple assets at once.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkTagRequest"}}}},"responses":{"200":{"description":"Tags updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}}}}},"/api/v1/assets/export":{"post":{"summary":"Export single asset","description":"Export an asset with privacy-aware metadata stripping.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SingleExportRequest"}}}},"responses":{"200":{"description":"Export completed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}}}}},"/api/v1/assets/facets":{"post":{"summary":"Get search facet counts","description":"Retrieve facet counts for filtering (file types, tags, etc.).","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FacetsRequest"}}}},"responses":{"200":{"description":"Facets retrieved"}}}},"/api/v1/assets/search":{"post":{"summary":"Search assets","description":"Full-text search across asset metadata and content. Supports plain text queries and structured **grammar syntax** (`field:value`) with boolean operators.\n\n**Grammar syntax** — combine field filters with `AND`, `OR`, `NOT`:\n- `tool:midjourney AND tag:approved` — Midjourney assets tagged \"approved\"\n- `mime_type:image/png OR mime_type:image/webp` — PNG or WebP images\n- `created:>2025-01-01 AND width:>1920` — recent high-res assets\n- `prompt:\"cyberpunk city\" NOT status:Trashed` — prompt search excluding trash\n\nValue syntax: quoted strings for exact match (`title:\"hero banner\"`), wildcards (`filename:hero*`), ranges for numeric/date fields (`width:>1920`, `created:2025-01..2025-12`).\n\nSee the `SearchGrammarReference` schema for the full list of ~50 grammar fields across core metadata, dates, dimensions, AI generation, ComfyUI, and lineage domains.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl -X POST https://numonic.ai/api/v1/assets/search \\\n  -H \"x-api-key: napi_your_key\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"query\": \"tool:midjourney AND tag:approved\", \"limit\": 20}'"},{"lang":"javascript","label":"JavaScript","source":"const res = await fetch(\"https://numonic.ai/api/v1/assets/search\", {\n  method: \"POST\",\n  headers: {\n    \"x-api-key\": \"napi_your_key\",\n    \"Content-Type\": \"application/json\",\n  },\n  body: JSON.stringify({\n    query: \"tool:midjourney AND tag:approved\",\n    limit: 20,\n  }),\n});\nconst { results, total_matches } = await res.json();"},{"lang":"python","label":"Python","source":"import requests\n\nres = requests.post(\n    \"https://numonic.ai/api/v1/assets/search\",\n    headers={\"x-api-key\": \"napi_your_key\"},\n    json={\"query\": \"tool:midjourney AND tag:approved\", \"limit\": 20},\n)\ndata = res.json()\nprint(f\"Found {data['total_matches']} assets\")"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchAssetsRequest"}}}},"responses":{"200":{"description":"Search results returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}}}}},"/api/v1/assets/search-enhanced":{"post":{"summary":"Enhanced search with grammar","description":"Search using structured **grammar queries** with automatic query routing. The enhanced endpoint analyzes the query and routes it to the optimal search strategy:\n\n- **Grammar** (`tool:midjourney AND tag:hero`) — structured field:value filters, routed to SQL\n- **Semantic** (`a dreamy landscape at sunset`) — natural language, routed to vector similarity\n- **Hybrid** (`cyberpunk tool:midjourney`) — combines semantic + grammar filters\n- **Simple** (`hero banner`) — basic text matching\n\nThis endpoint is recommended for most use cases — it handles query classification automatically. Use `/assets/search` for explicit control or `/assets/search-semantic` for pure vector search.\n\nSee the `SearchGrammarReference` schema for all available grammar fields.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl -X POST https://numonic.ai/api/v1/assets/search-enhanced \\\n  -H \"x-api-key: napi_your_key\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"query\": \"cyberpunk city tool:midjourney\", \"limit\": 20}'"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnhancedSearchRequest"}}}},"responses":{"200":{"description":"Search results returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}}}}},"/api/v1/assets/search-semantic":{"post":{"summary":"Semantic/vector search","description":"Search using **vector similarity** for natural language queries. Converts the query text into an embedding and finds the most visually or semantically similar assets.\n\nBest for: \"a dreamy watercolor landscape\", \"product photo on white background\", \"dark moody portrait\". For structured filtering use `/assets/search` with grammar syntax, or `/assets/search-enhanced` for automatic routing.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SemanticSearchRequest"}}}},"responses":{"200":{"description":"Semantic search results returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}}}}},"/api/v1/assets/search-suggest":{"post":{"summary":"Search autocomplete suggestions","description":"Get autocomplete suggestions for a partial search query.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchSuggestRequest"}}}},"responses":{"200":{"description":"Suggestions returned"}}}},"/api/v1/assets/thumbnail-urls":{"post":{"summary":"Get thumbnail URLs for assets","description":"Retrieve signed thumbnail URLs for a batch of asset hashes.","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ThumbnailUrlsRequest"}}}},"responses":{"200":{"description":"Thumbnail URLs returned"}}}},"/api/v1/assets/trash":{"get":{"summary":"List trashed assets","description":"List assets that have been soft-deleted (in trash).","tags":["Assets"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Trashed assets retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TrashResponse"}}}}}}},"/api/v1/collections/{collectionH}/notes":{"get":{"summary":"Get collection notes","description":"Retrieve all notes attached to a collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"responses":{"200":{"description":"Notes retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotesListResponse"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Create collection note","description":"Create a new note on a collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateNoteRequest"}}}},"responses":{"201":{"description":"Note created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}/notes/{annotationH}":{"patch":{"summary":"Update collection note","description":"Update an existing note on a collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"},{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateNoteRequest"}}}},"responses":{"200":{"description":"Note updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Note not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete collection note","description":"Soft-delete a note on a collection.","tags":["Collections"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"},{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Annotation hash (40-char hex SHA-1)"},"required":true,"name":"annotationH","in":"path"}],"responses":{"200":{"description":"Note deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Note not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/collections/{collectionH}/publication":{"get":{"summary":"Get publication status","description":"Check whether a collection is published and its publication details.","tags":["Collections","Publishing"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"responses":{"200":{"description":"Publication status retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicationStatusResponse"}}}},"404":{"description":"Collection not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/webhooks/{id}":{"get":{"summary":"Get webhook details","description":"Retrieve details for a specific webhook subscription.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Webhook hash (40-char hex SHA-1)"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Webhook details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookResponse"}}}},"404":{"description":"Webhook not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update webhook","description":"Update a webhook subscription (URL, events, enabled status).","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Webhook hash (40-char hex SHA-1)"},"required":true,"name":"id","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateWebhookRequest"}}}},"responses":{"200":{"description":"Webhook updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookResponse"}}}},"404":{"description":"Webhook not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete webhook","description":"Soft-delete a webhook subscription.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Webhook hash (40-char hex SHA-1)"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Webhook deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Webhook not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/webhooks/{id}/rotate-secret":{"post":{"summary":"Rotate webhook HMAC secret","description":"Generate a new HMAC signing secret for a webhook.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Webhook hash (40-char hex SHA-1)"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"New secret generated (shown once)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookCreatedResponse"}}}},"404":{"description":"Webhook not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/webhooks/{id}/test":{"post":{"summary":"Send test webhook event","description":"Dispatch a test event to the webhook URL to verify connectivity.","tags":["Webhooks"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Webhook hash (40-char hex SHA-1)"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Test event sent","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Webhook not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/storage/details":{"get":{"summary":"Get tenant storage usage details","description":"Retrieve storage usage breakdown by file type and total quota.","tags":["Storage"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Storage details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StorageDetailsResponse"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/storage/signed-url/upload":{"get":{"summary":"Get signed URL for upload","description":"Generate a pre-signed URL for direct file upload to object storage. This is step 1 of the three-phase upload flow: (1) get signed URL, (2) upload file directly to storage, (3) confirm upload via the asset creation endpoint to trigger metadata extraction and indexing.","tags":["Storage"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Signed upload URL generated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignedUrlResponse"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/storage/signed-url/download/{assetH}":{"get":{"summary":"Get signed URL for download","description":"Generate a pre-signed URL for downloading an asset.","tags":["Storage"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Asset hash (40-char hex SHA-1)"},"required":true,"name":"assetH","in":"path"}],"responses":{"200":{"description":"Signed download URL generated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignedUrlResponse"}}}},"404":{"description":"Asset not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/public/galleries":{"get":{"summary":"List public galleries","description":"List all publicly published gallery collections.","tags":["Public Galleries"],"security":[],"responses":{"200":{"description":"Public galleries listed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GalleryListResponse"}}}}}}},"/api/v1/public/gallery/{collectionH}":{"get":{"summary":"Get public gallery details","description":"Retrieve a public gallery and its published assets.","tags":["Public Galleries"],"security":[],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Collection hash (40-char hex SHA-1)","example":"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"},"required":true,"name":"collectionH","in":"path"}],"responses":{"200":{"description":"Gallery details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GalleryDetailResponse"}}}},"404":{"description":"Gallery not found or not published","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/workflows/definitions":{"get":{"summary":"List workflow definitions","description":"List all workflow definitions for the current tenant.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Workflow definitions listed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowDefinitionListResponse"}}}}}},"post":{"summary":"Create workflow definition","description":"Store a reusable workflow definition — typically a ComfyUI or n8n execution graph captured from an imported asset. Workflow definitions are the templates; use workflow executions to track individual runs.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateWorkflowDefinitionRequest"}}}},"responses":{"201":{"description":"Workflow definition created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"400":{"description":"Validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/workflows/definitions/{id}":{"get":{"summary":"Get workflow definition","description":"Retrieve a specific workflow definition by ID.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","description":"Workflow definition ID"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Workflow definition retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowDefinitionDetailResponse"}}}},"404":{"description":"Workflow definition not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update workflow definition","description":"Update an existing workflow definition.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","description":"Workflow definition ID"},"required":true,"name":"id","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateWorkflowDefinitionRequest"}}}},"responses":{"200":{"description":"Workflow definition updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Workflow definition not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete workflow definition","description":"Delete a workflow definition.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","description":"Workflow definition ID"},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Workflow definition deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Workflow definition not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/workflows/executions":{"get":{"summary":"List workflow executions","description":"List workflow executions for the current tenant.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"responses":{"200":{"description":"Executions listed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowExecutionListResponse"}}}}}},"post":{"summary":"Start workflow execution","description":"Start a new execution of a stored workflow definition. Executions track the per-node state, inputs, and outputs of a single run.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartExecutionRequest"}}}},"responses":{"201":{"description":"Execution started","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"400":{"description":"Validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/workflows/{workflowExecutionH}":{"get":{"summary":"Get execution details","description":"Retrieve details and status of a workflow execution.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Workflow execution hash (40-char hex SHA-1)"},"required":true,"name":"workflowExecutionH","in":"path"}],"responses":{"200":{"description":"Execution details retrieved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowExecutionDetailResponse"}}}},"404":{"description":"Execution not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Add data to execution","description":"Add input or intermediate data to a running workflow execution.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Workflow execution hash (40-char hex SHA-1)"},"required":true,"name":"workflowExecutionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateExecutionRequest"}}}},"responses":{"200":{"description":"Data added","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Execution not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update execution status","description":"Update the status of a workflow execution.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Workflow execution hash (40-char hex SHA-1)"},"required":true,"name":"workflowExecutionH","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateExecutionRequest"}}}},"responses":{"200":{"description":"Execution status updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessMessage"}}}},"404":{"description":"Execution not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Cancel execution","description":"Cancel a running workflow execution.","tags":["Workflows"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Workflow execution hash (40-char hex SHA-1)"},"required":true,"name":"workflowExecutionH"