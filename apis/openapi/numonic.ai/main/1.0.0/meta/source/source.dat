":"updated"},"filters":{"type":"object","properties":{"category":{"type":"array","items":{"type":"string"}},"target_model":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"has_variables":{"type":"boolean"},"min_score":{"type":"number","minimum":0,"maximum":5},"max_score":{"type":"number","minimum":0,"maximum":5}}}}}}}},"responses":{"200":{"description":"Search results with pagination cursor","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{}},"description":"Matching prompts with signed thumbnail URLs"},"cursor":{"type":["string","null"],"description":"Cursor for next page (null if no more results)"},"total_estimate":{"type":"integer","description":"Estimated total matching prompts"}},"required":["items","cursor","total_estimate"]}}}},"401":{"description":"Unauthorized"}}}},"/api/v1/prompts/facets":{"get":{"summary":"Get prompt facets","description":"Retrieve context-aware facet counts for the prompt filter panel. Each facet dimension (categories, models, tags) is counted with all other active filters applied but not its own filter, enabling progressive Amazon/Etsy-style faceting.","tags":["Prompts"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","description":"Free-text search query"},"required":false,"name":"q","in":"query"},{"schema":{"type":"string","description":"Comma-separated category filter"},"required":false,"name":"category","in":"query"},{"schema":{"type":"string","description":"Comma-separated model filter"},"required":false,"name":"model","in":"query"},{"schema":{"type":"string","description":"Comma-separated tag filter"},"required":false,"name":"tags","in":"query"},{"schema":{"type":"string","enum":["true","false"]},"required":false,"name":"has_variables","in":"query"},{"schema":{"type":"number","minimum":0,"maximum":5},"required":false,"name":"min_score","in":"query"},{"schema":{"type":"number","