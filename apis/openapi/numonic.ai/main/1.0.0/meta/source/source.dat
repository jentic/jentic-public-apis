nauthorized"},"404":{"description":"Model not found or tenant mismatch"}}}},"/api/v1/models/{modelId}/assets":{"get":{"summary":"List model assets","description":"Retrieve assets that were generated using this model, with signed thumbnail URLs and pagination.","tags":["Models"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^[a-f0-9]{40}$","description":"Model SHA-1 hash identifier"},"required":true,"name":"modelId","in":"path"},{"schema":{"type":"integer","minimum":1,"maximum":200,"default":24,"description":"Maximum results to return"},"required":false,"name":"limit","in":"query"},{"schema":{"type":"integer","minimum":0,"default":0,"description":"Number of results to skip"},"required":false,"name":"offset","in":"query"}],"responses":{"200":{"description":"Asset list with pagination","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AssetSummary"}},"pagination":{"type":"object","properties":{"limit":{"type":"integer"},"offset":{"type":"integer"}},"required":["limit","offset"]}},"required":["data","pagination"]}}}},"400":{"description":"Invalid modelId or query parameters"},"401":{"description":"Unauthorized"},"404":{"description":"Tenant not found"}}}},"/api/v1/assets/sessions":{"get":{"summary":"List creative sessions","description":"Group assets into creative sessions based on temporal proximity and tool. A new session boundary is created when the gap between consecutive assets exceeds the `time_window` or when the generating tool changes. Sessions are returned newest-first.","tags":["Sessions"],"security":[{"NumonicApiKey":[]}],"parameters":[{"schema":{"type":"string","pattern":"^\\d+\\s+(hour|hours|minute|minutes|day|days)$","default":"2 hours","description":"Maximum gap between consecutive assets within a session (e.g., `2 hours`, `30 minutes`, `1 day`)"},"required":false,"name":"time_window","in":"query"},{"schema":{"type":"integer","minimum