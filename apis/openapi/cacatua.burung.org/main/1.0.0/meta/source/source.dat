{
  "openapi": "3.0.0",
  "info": {
    "title": "Blacs ERP",
    "version": "1.0.0",
    "description": "API integration ERP to BLACS <br> Please contact admin to get the Authorization Key",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/RANGGAANGGARA8/blacs-erp/1.0.0"
  },
  "servers": [
    {
      "url": "https://cacatua.burung.org/erp/public/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/blacs/list": {
      "get": {
        "tags": [
          "Get List"
        ],
        "summary": "list",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "2026"
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "2"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Paid/Unpaid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "message": "data found",
                  "data": [
                    {
                      "id": 1,
                      "type": "RFP",
                      "title": "001/BRG/WO/II/26",
                      "description": "[D] TICKET PESAWAT TUJUAN - - - 13-02-2026 (09:00) A/N : Rangga Anggara [test data maskapai]",
                      "amount": "500000.00",
                      "project_id": "ID0014_05",
                      "activity_id": "0000",
                      "no_account": "10",
                      "voucherId": null,
                      "posting_date": null,
                      "payment_date": "2026-03-06",
                      "status": "Unpaid"
                    },
                    {
                      "id": 2,
                      "type": "RFP",
                      "title": "001/PO/BIA/III/26",
                      "description": "Pembelian Kamera",
                      "amount": "500000.00",
                      "project_id": "ID0008_05",
                      "activity_id": "0000",
                      "no_account": "10",
                      "voucherId": null,
                      "posting_date": null,
                      "payment_date": "2026-03-06",
                      "status": "Unpaid"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "message": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "message": "Data not found"
                }
              }
            }
          }
        }
      }
    },
    "/blacs/update": {
      "post": {
        "tags": [
          "Update"
        ],
        "summary": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "paper_type": "RFP",
                  "paper_id": 1,
                  "year": 2026,
                  "month": 3,
                  "status": 1,
                  "voucherId": "58085",
                  "posting_date": "2026-02-26"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "success": true,
                  "message": "success",
                  "data": {
                    "id": 2,
                    "paper": "001/BRG/WO/II/26",
                    "voucherId": "58085",
                    "posting_date": "2026-02-26"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "message": {
                    "status": [
                      "The status field is required."
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "message": "Data not found"
                }
              }
            }
          }
        }
      }
    }
  }
}
