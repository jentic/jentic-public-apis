                      "contact": {
                        "$ref": "#/components/schemas/PublicContact"
                      },
                      "load_balancer": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "weight_based"
                                ]
                              },
