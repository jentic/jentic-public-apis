                                              "anyOf": [
                                                {
                                                  "type": "object",
                                                  "properties": {
                                                    "eq": {
                                                      "anyOf": [
                                                        {
                                                          "type": "string",
                                                          "title": "string",
                                                          "description": "String"
                                                        },
                                                        {
                                                          "type": "number",
                                                          "title": "number",
                                                          "description": "Number"
                                                        },
                                                        {
