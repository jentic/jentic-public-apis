    "/v2/models/azure-foundry/deployments": {
      "post": {
        "description": "Lists Azure Foundry deployments under the given base_url and joins each entry with the Orq master-data row. Only OpenAI-developed deployments in succeeded state with chat/completion/embedding/vision model types are returned.",
        "operationId": "ModelAzureFoundryDeployments",
        "requestBody": {
          "content": {
