                                                      "type": "number"
                                                    }
                                                  },
                                                  "required": [
                                                    "gt"
                                                  ],
                                                  "title": "gt",
                                                  "description": "Greater than"
                                                },
                                                {
                                                  "type": "object",
                                                  "properties": {
