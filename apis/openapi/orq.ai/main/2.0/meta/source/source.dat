      "PublicContact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the contact",
            "example": "contact_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          },
          "display_name": {
            "type": "string",
            "description": "Display name of the contact",
            "example": "Jane Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the contact",
            "example": "jane.doe@example.com"
          },
          "metadata": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "description": "A hash of key/value pairs containing any other data about the contact",
            "example": [
              {
                "department": "Engineering",
                "role": "Senior Developer"
              }
            ]
          },
          "logo_url": {
            "type": "string",
            "description": "URL to the contact's avatar or logo",
            "example": "https://example.com/avatars/jane-doe.jpg"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of tags associated with the contact",
            "example": [
              "hr",
              "engineering"
            ]
          }
        },
        "required": [
          "id"
        ],
        "description": "@deprecated Use identity instead. Information about the contact making the request.",
        "deprecated": true
      },
      "ParseResponse": {
        "required": [
          "chunks"
        ],
        "type": "object",
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          }
        }
      },
      "Chunk": {
        "required": [
          "id",
          "text",
          "index"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "metadata": {
            "$ref": "#/components/schemas/ChunkMetadata"
          }
        }
      },
      "ChunkMetadata": {
        "required": [
          "start_index",
          "end_index",
          "token_count"
        ],
        "type": "object",
        "properties": {
          "start_index": {
            "type": "integer",
            "format": "int32"
          },
          "end_index": {
            "type": "integer",
            "format": "int32"
          },
          "token_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ListFileSystemsResponse": {
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object",
        "properties": {
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileSystem"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "CreateFileSystemRequest": {
        "required": [
          "key",
          "path"
        ],
        "type": "object",
        "properties": {
          "key": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z]([A-Za-z0-9]*([._][A-Za-z0-9]+)*)?$",
            "type": "string",
            "description": "The unique key of the file system. The key is unique and immutable and cannot be repeated within the same workspace."
          },
          "path": {
            "minLength": 1,
            "type": "string",
            "description": "Entity storage path. With workspace-level API keys, the first element identifies the project. With project-level API keys, the path is relative to that project."
          },
          "display_name": {
            "maxLength": 255,
            "type": "string",
            "description": "Human readable name shown in the UI. Defaults to the key."
          },
          "description": {
            "maxLength": 4096,
            "type": "string"
          },
          "external_access": {
            "enum": [
              "disabled",
              "read_only",
              "read_write"
            ],
            "type": "string",
            "description": "Whether external MCP clients may reach this file system. Defaults to disabled."
          },
          "sharing": {
            "$ref": "#/components/schemas/Sharing"
          }
        }
      },
      "FileSystem": {
        "required": [
          "_id",
          "key",
          "display_name",
          "description",
          "project_id",
          "external_access",
          "created",
          "updated"
        ],
        "type": "object",
        "properties": {
          "key": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z]([A-Za-z0-9]*([._][A-Za-z0-9]+)*)?$",
            "type": "string",
            "description": "The unique key of the file system. The key is unique and immutable and cannot be repeated within the same workspace."
          },
          "display_name": {
            "type": "string",
            "description": "Human readable name shown in the UI"
          },
          "description": {
            "type": "string",
            "description": "The description of the file system. Be as precise as possible to help the AI understand what the file system is for."
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the file system belongs to"
          },
          "external_access": {
            "description": "Whether external MCP clients may reach this file system, and with which access",
            "$ref": "#/components/schemas/FileSystemExternalAccess"
          },
          "created_by_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The user ID of the creator"
          },
          "updated_by_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The user ID of the last updater"
          },
          "created": {
            "type": "string",
            "description": "The creation date of the file system"
          },
          "updated": {
            "type": "string",
            "description": "The last update date of the file system"
          },
          "sharing": {
            "$ref": "#/components/schemas/Sharing"
          },
          "used_bytes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Apparent size of the file system in bytes at the last metering. Absent until first metered."
          },
          "used_inodes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Number of files and directories in the file system at the last metering. Absent until first metered."
          },
          "last_metered_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When usage was last measured. Absent until first metered."
          },
          "_id": {
            "type": "string",
            "description": "The unique identifier of the file system"
          }
        }
      },
      "DeleteFileSystemResponse": {
        "type": "object",
        "properties": {}
      },
      "UpdateFileSystemRequest": {
        "required": [],
        "type": "object",
        "properties": {
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
            "description": "Update has no key to fall back on, so an explicitly supplied display_name\n may not be empty; Create defaults an omitted one to the key."
          },
          "description": {
            "maxLength": 4096,
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "external_access": {
            "enum": [
              "disabled",
              "read_only",
