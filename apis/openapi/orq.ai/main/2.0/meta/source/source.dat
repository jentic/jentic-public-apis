                            "on_codes": {
                              "type": "array",
                              "items": {
                                "type": "number",
                                "minimum": 100,
                                "maximum": 599
                              },
                              "minItems": 1,
                              "description": "HTTP status codes that trigger retry logic",
                              "example": [
