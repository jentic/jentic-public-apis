                                                {
                                                  "type": "object",
                                                  "properties": {
                                                    "ne": {
                                                      "anyOf": [
                                                        {
                                                          "type": "string",
                                                          "title": "string",
                                                          "description": "String"
                                                        },
                                                        {
                                                          "type": "number",
                                                          "title": "number",
