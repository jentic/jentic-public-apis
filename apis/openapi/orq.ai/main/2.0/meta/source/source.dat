      "DuplicateEvaluatorRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Presence-sensitive: an explicit \"\" overrides the copied description,\n an absent field keeps the source evaluator's own."
          }
        },
        "description": "Keys are validated by the service; the schema does not constrain the\n key format."
      },
      "ListEvaluatorVersionsResponse": {
