                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "deployments": {
                      "items": {
                        "$ref": "#/components/schemas/AzureFoundryDeployment"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "region": {
                      "type": "string"
                    }
                  },
                  "required": [
