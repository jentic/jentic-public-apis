      "ClassifyChoiceAnswer": {
        "additionalProperties": false,
        "properties": {
          "choice": {
            "description": "The selected option. Present for choice answers.",
            "type": "string"
          },
          "confidence": {
            "description": "How sure the model is of the answer it selected: on emulated chat models the largest value in probabilities, so it adds nothing the distribution does not; native providers return their own confidence value, which can sit below the largest probability. Present for choice and score answers.",
            "format": "double",
            "type": "number"
          },
          "probabilities": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "Probability distribution over the options or levels. Present for choice and score answers.",
            "type": "object"
