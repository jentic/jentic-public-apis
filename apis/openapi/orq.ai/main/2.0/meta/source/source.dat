                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "none",
                                      "auto",
                                      "required"
                                    ]
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
