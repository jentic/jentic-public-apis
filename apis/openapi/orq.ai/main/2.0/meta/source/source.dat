    "/v2/model-catalog/{id}": {
      "get": {
        "tags": [
          "Model Catalog"
        ],
        "summary": "Retrieve a model catalog entry",
        "description": "Retrieves a single catalog entry by its id, `<provider>/<model>` (for example `openai/gpt-4o`). Unlike the list endpoints this also resolves deprecated models; check `deprecated` and `deprecation` on the response.",
