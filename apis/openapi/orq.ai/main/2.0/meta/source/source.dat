      "GuardrailRulePlugin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Plugin discriminator."
          },
          "language": {
            "type": "string",
            "description": "Languages, regions and entity types are checked against the live\n pii-detection capabilities catalog when the rule is saved, not pinned\n here, so a language or region the detector gains becomes writable without\n a proto change."
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Entity types to redact. On their own a strict allowlist; alongside regions they add to the region coverage."
          },
          "on_failure": {
            "type": "string"
          },
          "threshold": {
            "type": "number",
            "format": "double"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Regions of coverage by ISO 3166-1 alpha-2 code, or [\"all\"]. Combines with entities: the two selections are unioned."
          },
          "entity_thresholds": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Per-entity-type confidence cutoff. Every key must also appear in entities."
          }
        }
      },
