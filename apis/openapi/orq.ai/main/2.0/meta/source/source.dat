    "/v3/router/responses/{response_id}": {
      "get": {
        "description": "Retrieves a previously created response by its ID.",
        "operationId": "retrieve-response",
        "parameters": [
          {
            "description": "The ID of the response to retrieve",
            "in": "path",
            "name": "response_id",
