            "lang": "python",
            "label": "Python - Retrieve an MCP server",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\nresult = client.mcp_servers.retrieve(id=\"01JQ0K5R8N2ZC7X4M9T3V6HWBD\")\n\nfor tool in result.mcp_server.tools:\n    print(tool.name, tool.status)\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - Retrieve an MCP server",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\nconst result = await client.mcpServers.retrieve({\n  id: '01JQ0K5R8N2ZC7X4M9T3V6HWBD',\n});\n\nfor (const tool of result.mcpServer.tools) {\n  console.log(tool.name, tool.status);\n}\n"
          }
        ]
      },
      "delete": {
        "tags": [
          "MCP Gateway"
        ],
        "summary": "Delete an MCP server",
        "description": "Deletes an MCP server from the workspace. The response body is empty when the delete succeeds.",
        "operationId": "McpServerDelete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier of the MCP server.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteMcpServerResponse"
                }
              }
            }
          }
        },
        "x-speakeasy-group": "mcpServers",
        "x-speakeasy-name-override": "delete",
        "x-cli-group": "mcpServers",
        "x-cli-name": "delete",
        "x-code-samples": [
          {
            "lang": "curl",
            "label": "Core - Delete an MCP server",
            "source": "curl --request DELETE \\\n  --url 'https://my.orq.ai/v2/mcp-servers/01JQ0K5R8N2ZC7X4M9T3V6HWBD' \\\n  --header \"Authorization: Bearer $ORQ_API_KEY\"\n"
          },
          {
            "lang": "python",
            "label": "Python - Delete an MCP server",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\n# Fails while any gateway still links this server.\nclient.mcp_servers.delete(id=\"01JQ0K5R8N2ZC7X4M9T3V6HWBD\")\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - Delete an MCP server",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\n// Fails while any gateway still links this server.\nawait client.mcpServers.delete({ id: '01JQ0K5R8N2ZC7X4M9T3V6HWBD' });\n"
          }
        ]
      },
      "patch": {
        "tags": [
          "MCP Gateway"
        ],
        "summary": "Update an MCP server",
        "description": "Updates mutable fields of an existing MCP server. Omitted optional fields keep their current values.",
        "operationId": "McpServerUpdate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier of the MCP server.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMcpServerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateMcpServerResponse"
                }
              }
            }
          }
        },
        "x-speakeasy-group": "mcpServers",
        "x-speakeasy-name-override": "update",
        "x-cli-group": "mcpServers",
        "x-cli-name": "update",
        "x-code-samples": [
          {
            "lang": "curl",
            "label": "Core - Update an MCP server",
            "source": "curl --request PATCH \\\n  --url 'https://my.orq.ai/v2/mcp-servers/01JQ0K5R8N2ZC7X4M9T3V6HWBD' \\\n  --header \"Authorization: Bearer $ORQ_API_KEY\" \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n    \"display_name\": \"GitHub (read only)\",\n    \"default_tool_exposure\": {\n      \"mode\": \"MCP_TOOL_EXPOSURE_MODE_ALL\",\n      \"read_only\": true\n    }\n  }'\n"
          },
          {
            "lang": "python",
            "label": "Python - Update an MCP server",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\n# The key is immutable; sending a different one is rejected.\nresult = client.mcp_servers.update(\n    id=\"01JQ0K5R8N2ZC7X4M9T3V6HWBD\",\n    display_name=\"GitHub (read only)\",\n    default_tool_exposure={\n        \"mode\": \"MCP_TOOL_EXPOSURE_MODE_ALL\",\n        \"read_only\": True,\n    },\n)\n\nprint(result.mcp_server.display_name)\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - Update an MCP server",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\n// The key is immutable; sending a different one is rejected.\nconst result = await client.mcpServers.update({\n  id: '01JQ0K5R8N2ZC7X4M9T3V6HWBD',\n  displayName: 'GitHub (read only)',\n  defaultToolExposure: {\n    mode: 'MCP_TOOL_EXPOSURE_MODE_ALL',\n    readOnly: true,\n  },\n});\n\nconsole.log(result.mcpServer.displayName);\n"
          }
        ]
      }
    },
    "/v2/mcp-servers/{id}/tools:test": {
      "post": {
        "tags": [
          "MCP Gateway"
        ],
        "summary": "Test an MCP server tool",
        "description": "Executes a single tool on an upstream MCP server for testing. Connects to the server, invokes the tool with the provided arguments, and returns the result.",
        "operationId": "McpServerTestTool",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier of the MCP server.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestMcpServerToolRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestMcpServerToolResponse"
                }
              }
            }
          }
        },
        "x-speakeasy-group": "mcpServers",
        "x-speakeasy-name-override": "testTool",
        "x-cli-group": "mcpServers",
        "x-cli-name": "testTool",
        "x-code-samples": [
          {
            "lang": "curl",
            "label": "Core - Test a single tool",
            "source": "curl --request POST \\\n  --url 'https://my.orq.ai/v2/mcp-servers/01JQ0K5R8N2ZC7X4M9T3V6HWBD/tools:test' \\\n  --header \"Authorization: Bearer $ORQ_API_KEY\" \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n    \"tool_name\": \"search_issues\",\n    \"arguments\": { \"query\": \"repo:orq-ai/orq-cli is:open label:bug\" }\n  }'\n"
          },
          {
            "lang": "python",
            "label": "Python - Test a single tool",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\n# tool_name is the upstream name, not a gateway's namespaced exposed_name.\nresult = client.mcp_servers.test_tool(\n    id=\"01JQ0K5R8N2ZC7X4M9T3V6HWBD\",\n    tool_name=\"search_issues\",\n    arguments={\"query\": \"repo:orq-ai/orq-cli is:open label:bug\"},\n)\n\nprint(result.result.ok, result.result.latency_ms)\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - Test a single tool",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\n// toolName is the upstream name, not a gateway's namespaced exposedName.\nconst { result } = await client.mcpServers.testTool({\n  id: '01JQ0K5R8N2ZC7X4M9T3V6HWBD',\n  toolName: 'search_issues',\n  arguments: { query: 'repo:orq-ai/orq-cli is:open label:bug' },\n});\n\nconsole.log(result.ok, result.latencyMs);\n"
          }
        ]
      }
    },
    "/v2/mcp-servers/{id}:sync": {
      "post": {
        "tags": [
          "MCP Gateway"
        ],
        "summary": "Sync an MCP server",
        "description": "Connects to an upstream MCP server, discovers tools, and persists the tool list and sync state on the server record.",
        "operationId": "McpServerSync",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier of the MCP server.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncMcpServerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncMcpServerResponse"
                }
              }
            }
          }
        },
        "x-speakeasy-group": "mcpServers",
        "x-speakeasy-name-override": "sync",
        "x-cli-group": "mcpServers",
        "x-cli-name": "sync",
        "x-code-samples": [
          {
            "lang": "curl",
            "label": "Core - Sync the tool catalog",
            "source": "curl --request POST \\\n  --url 'https://my.orq.ai/v2/mcp-servers/01JQ0K5R8N2ZC7X4M9T3V6HWBD:sync' \\\n  --header \"Authorization: Bearer $ORQ_API_KEY\" \\\n  --header 'Content-Type: application/json' \\\n  --data '{}'\n"
          },
          {
            "lang": "curl",
            "label": "Core - Sync a server that uses template variables",
            "source": "curl --request POST \\\n  --url 'https://my.orq.ai/v2/mcp-servers/01JQ0K5R8N2ZC7X4M9T3V6HWBD:sync' \\\n  --header \"Authorization: Bearer $ORQ_API_KEY\" \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n    \"discovery_variables\": { \"github_token\": \"ghp_example_token\" }\n  }'\n"
          },
          {
            "lang": "python",
            "label": "Python - Sync the tool catalog",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\nresult = client.mcp_servers.sync(id=\"01JQ0K5R8N2ZC7X4M9T3V6HWBD\")\n\nstate = result.mcp_server.sync_state\n# A sync that discovers nothing still reports SYNCED with tools_total 0.\nprint(state.status, state.tools_added, state.tools_removed)\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - Sync the tool catalog",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\nconst result = await client.mcpServers.sync({\n  id: '01JQ0K5R8N2ZC7X4M9T3V6HWBD',\n});\n\nconst state = result.mcpServer.syncState;\n// A sync that discovers nothing still reports SYNCED with toolsTotal 0.\nconsole.log(state.status, state.toolsAdded, state.toolsRemoved);\n"
          }
        ]
      }
    },
    "/v2/model-catalog": {
      "get": {
        "tags": [
          "Model Catalog"
        ],
        "summary": "List the model catalog",
        "description": "Returns every model orq offers, optionally filtered, searched and sorted. Deprecated models are never listed; fetch one directly by id to inspect it. Unset `limit` returns the whole catalog. Use `starting_after` or `ending_before` to page through the collection.",
        "operationId": "ModelCatalogList",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1\u20131000. Unset returns every non-deprecated model in one response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "description": "Cursor for forward pagination. Set to the `id` of the last item from\n the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ending_before",
            "in": "query",
            "description": "Cursor for backward pagination. Set to the `id` of the first item\n from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "description": "Filter by catalog provider key. Repeat to match any of several\n providers.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "endpoint",
            "in": "query",
            "description": "Filter by API endpoint. Repeat to match any of several endpoints.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "input_modality",
            "in": "query",
            "description": "Filter by input modality. Repeat to match any of several modalities.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "output_modality",
            "in": "query",
            "description": "Filter by output modality. Repeat to match any of several modalities.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Filter by region. Repeat to match any of several regions.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "feature",
            "in": "query",
            "description": "Filter by normalized feature name. Repeat to match any of several\n features.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "supported_parameter",
            "in": "query",
            "description": "Filter by supported parameter key. Repeat to match any of several\n parameters.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "tier",
            "in": "query",
            "description": "Filter by supported service tier. Repeat to match any of several\n tiers.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "offering_of",
            "in": "query",
            "description": "Filter to offerings of one base model reference, `<developer>/<stem>`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive substring search over `id`, `name` and `description`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Field to sort by.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order. Defaults to ascending.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListModelCatalogResponse"
                }
              }
            }
          }
        },
        "x-speakeasy-group": "modelCatalog",
        "x-speakeasy-name-override": "list",
        "x-mint": {
          "metadata": {
            "sidebarTitle": "List catalog models"
          }
        },
        "security": [],
        "x-code-samples": [
          {
            "lang": "curl",
            "label": "Core - List the model catalog",
            "source": "curl --get 'https://my.orq.ai/v2/model-catalog' \\\n  --data-urlencode 'provider=openai' \\\n  --data-urlencode 'limit=10'\n"
          },
          {
            "lang": "python",
            "label": "Python - List the model catalog",
            "source": "import os\nfrom orq_ai_sdk import Orq\n\nclient = Orq(api_key=os.environ[\"ORQ_API_KEY\"])\n\npage = client.model_catalog.list(\n    provider=\"openai\",\n    limit=10,\n)\n\nfor model in page.data:\n    print(model.id, model.name)\n"
          },
          {
            "lang": "typescript",
            "label": "Node.js - List the model catalog",
            "source": "import { Orq } from '@orq-ai/node';\n\nconst client = new Orq({\n  apiKey: process.env.ORQ_API_KEY,\n});\n\nconst page = await client.modelCatalog.list({\n  provider: 'openai',\n  limit: 10,\n});\n\nfor (const model of page.data) {\n  console.log(model.id, model.name);\n}\n"
          }
        ]
      }
    },
