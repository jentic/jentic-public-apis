    "/v2/workspace-models": {
      "post": {
        "description": "Adds the model to the workspace's enabled set. Idempotent \u2014 re-enabling an already-enabled model returns 204 with no state change.",
        "operationId": "ModelEnable",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "model_id": {
