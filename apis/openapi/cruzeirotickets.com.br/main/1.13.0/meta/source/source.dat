{
  "openapi": "3.0.3",
  "info": {
    "title": "BaladAPP - API de Cliente para APP de Parceiros",
    "description": "Prove acesso a anuncios, ingressos e pedidos na visão do cliente autenticado.",
    "version": "1.13.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/baladapp/baladapp-api-de-cliente-para-app-de-parceiros/1.13.0"
  },
  "servers": [
    {
      "url": "https://cruzeirotickets.com.br/api/partner/v1/",
      "description": "Servidor de Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth": {
      "get": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Esta rota serve apenas para realizar a autenticação das rotas de webview, para isso, é necessário enviar um JWT contendo integracao_id, um identificador do cliente (email OU documento_tipo + documento_numero), session_duration e redirect_to. A rota responde com set_cookie e faz um redirect para a URL definida em redirect_to. Por questões de segurança token recebido não pode ter uma validade superior a 5 minutos.",
        "parameters": [
          {
            "name": "jwt",
            "in": "query",
            "required": true,
            "description": "Token JWT contendo os dados de autenticação",
            "schema": {
              "type": "string",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpbnRlZ3JhY2FvX2lkIjo3LCJlbWFpbCI6IndhZ25lci5jYWl4ZXRhQGdtYWlsLmNvbSIsInJlZGlyZWN0X3RvIjoiL21pbmhhLWNvbnRhIiwic2Vzc2lvbl9kdXJhdGlvbiI6NjAwLCJpYXQiOjE3Mzk4MDg2MjksImV4cCI6MTc1NTM2MDYyOX0.mwh2wsvInmaFK5rWh-LgVpTb6ABLfanbv1TARl8JVX4"
            }
          }
        ],
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "description": "Cliente não encontrado e não foi possível criar automaticamente"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError",
            "description": "Token inválido, expirado ou integração não autorizada"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError",
            "description": "Possíveis causas:\n- session_duration fora do intervalo permitido (30 a 86400 segundos)\n- Token JWT com duração superior ao permitido\n- JWT não contém email nem (documento_tipo + documento_numero)\n"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "302": {
            "description": "Sucesso"
          }
        }
      }
    },
    "/cliente": {
      "get": {
        "tags": [
          "Dados"
        ],
        "summary": "Retorna objeto cliente que está autenticado.",
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cliente"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/anuncios": {
      "get": {
        "tags": [
          "Dados"
        ],
        "summary": "Lista todos os anuncios que o cliente possui pedidos.",
        "parameters": [
          {
            "name": "somente_futuros",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "somente_passados",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AnuncioDetalhado"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/anuncios/{anuncio_id}/ingressos": {
      "get": {
        "tags": [
          "Dados"
        ],
        "summary": "Lista ingressos do cliente em um anuncio específico",
        "parameters": [
          {
            "name": "anuncio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 123
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/IngressoDetalhado"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/anuncios/{anuncio_id}/ingressos/{ingresso_id}": {
      "get": {
        "tags": [
          "Dados"
        ],
        "summary": "Retorna informações de um ingresso específico",
        "parameters": [
          {
            "name": "anuncio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 5643
            }
          },
          {
            "name": "ingresso_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 5678
            }
          }
        ],
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "$ref": "#/components/schemas/IngressoDetalhado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pedidos": {
      "get": {
        "tags": [
          "Dados"
        ],
        "summary": "Lista pedidos do cliente",
        "description": "Retorna a lista de pedidos do cliente",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Lista de pedidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pedido"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transferencias-recebidas": {
      "get": {
        "tags": [
          "Retorna a lista de transferencias de ingressos recebidas"
        ],
        "summary": "Retorna a lista de transferencias de ingressos recebidas do cliente autenticado.",
        "responses": {
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidError"
          },
          "499": {
            "$ref": "#/components/responses/CustomError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Solicitação recebida com sucesso."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "existem_transferencias_recebidas": {
                          "type": "boolean",
                          "example": true
                        },
                        "transferencias_url": {
                          "type": "string",
                          "format": "uri",
                          "nullable": true,
                          "example": "http://assinaturas.cruzeiro.local:4021/ingressos/receber"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Número da página",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "PerPageParam": {
        "name": "per_page",
        "in": "query",
        "description": "Tamanho das páginas",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 10
        }
      }
    },
    "schemas": {
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "Cliente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": false,
            "example": 12345
          },
          "nome": {
            "type": "string",
            "nullable": false,
            "example": "João da Silva"
          },
          "primeiro_nome": {
            "type": "string",
            "nullable": false,
            "example": "João"
          },
          "sobrenome": {
            "type": "string",
            "nullable": false,
            "example": "da Silva"
          },
          "primeira_assinatura_ativa_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2023-01-01T10:00:00-03:00"
          },
          "socio_torcedor_nivel": {
            "type": "integer",
            "nullable": false,
            "example": 1
          },
          "socio_torcedor_nivel_atualizado_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2023-01-01T10:00:00-03:00"
          },
          "qtd_jogos_recentes_comprados": {
            "type": "integer",
            "nullable": false,
            "example": 0
          },
          "qtd_jogos_recentes_participados": {
            "type": "integer",
            "nullable": false,
            "example": 0
          },
          "escolaridade": {
            "type": "string",
            "nullable": false,
            "enum": [
              "nao_informada",
              "nenhuma",
              "ensino_fundamental",
              "ensino_medio",
              "ensino_superior_incompleto",
              "ensino_superior_completo",
              "pos_graduacao",
              "mestrado",
              "doutorado",
              "pos_doutorado"
            ],
            "example": "nao_informada"
          },
          "documento_numero": {
            "type": "string",
            "nullable": false,
            "example": "12345678900"
          },
          "documento_tipo": {
            "type": "string",
            "nullable": false,
            "example": "CPF"
          },
          "email": {
            "type": "string",
            "nullable": false,
            "example": "joao.silva@gmail.com"
          },
          "telefone_ddi": {
            "type": "string",
            "nullable": true,
            "example": "+55"
          },
          "telefone": {
            "type": "string",
            "nullable": true,
            "example": "61987654321"
          },
          "genero": {
            "type": "string",
            "enum": [
              "masculino",
              "feminino",
              "nao_informado"
            ],
            "nullable": false,
            "example": "masculino"
          },
          "idioma": {
            "type": "string",
            "nullable": false,
            "example": "pt-BR"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "1983-11-11"
          },
          "estado_civil": {
            "type": "string",
            "enum": [
              "solteiro",
              "casado",
              "divorciado",
              "viuvo",
              "nao_informado"
            ],
            "nullable": true,
            "example": "solteiro"
          },
          "cep": {
            "type": "string",
            "nullable": true,
            "example": "75240000"
          },
          "endereco_logradouro": {
            "type": "string",
            "nullable": true,
            "example": "Rua das Flores"
          },
          "endereco_bairro": {
            "type": "string",
            "nullable": true,
            "example": "Jardim Primavera"
          },
          "endereco_complemento": {
            "type": "string",
            "nullable": true,
            "example": "Apto 101"
          },
          "endereco_numero": {
            "type": "string",
            "nullable": true,
            "example": "123"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": false,
            "example": "2023-01-01T10:00:00-03:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": false,
            "example": "2023-01-02T12:00:00-03:00"
          }
        }
      },
      "Ingresso": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": false,
            "example": 5678
          },
          "numero": {
            "type": "string",
            "nullable": false,
            "example": "12345678"
          },
          "cliente_id": {
            "type": "integer",
            "nullable": true,
            "example": 12345,
            "description": "Indica qual o id do cliente comprador do ingresso."
          },
          "portador_id": {
            "type": "integer",
            "nullable": true,
            "example": 12346,
            "description": "Indica qual o id do cliente que tem a posse do ingresso, ele é preenchido de forma asincrona baseado no email informado nos dados de utilizador."
          },
          "pertence_ao_titular": {
            "type": "boolean",
            "nullable": false,
            "example": true,
            "description": "Quando o utilizador é também o comprador do ingresso o campo pertence_ao_titular é true, caso contrário é false."
          },
          "dados_utilizador": {
            "$ref": "#/components/schemas/DadosUtilizador"
          },
          "controle": {
            "$ref": "#/components/schemas/IngressoControle"
          },
          "status": {
            "type": "string",
            "nullable": false,
            "enum": [
              "vendido",
              "cancelado"
            ],
            "example": "vendido"
          },
          "pedido_id": {
            "type": "integer",
            "nullable": true,
            "example": 7890
          },
          "cortesia": {
            "type": "boolean",
            "nullable": false,
            "example": false
          },
          "utilizado": {
            "type": "boolean",
            "nullable": false,
            "example": false
          },
          "utilizado_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          },
          "lote_texto_exibicao": {
            "type": "string",
            "nullable": true,
            "example": "GRATUIDADE | CABULOSO MAX | DIAMANTE"
          },
          "portao_nome": {
            "type": "string",
            "nullable": true,
            "example": "Portões A e B | Portão A"
          },
          "setor_nome": {
            "type": "string",
            "nullable": false,
            "example": "ARQUIBANCADA"
          },
          "subsetor_nome": {
            "type": "string",
            "nullable": true,
            "example": "NORTE"
          },
          "assento": {
            "type": "string",
            "nullable": true,
            "example": "A23"
          },
          "fileira": {
            "type": "string",
            "nullable": true,
            "example": "A"
          },
          "cadeira": {
            "type": "string",
            "nullable": true,
            "example": "23"
          },
          "moeda": {
            "type": "string",
            "nullable": false,
            "example": "BRL"
          },
          "valor": {
            "type": "number",
            "format": "float",
            "nullable": false,
            "example": 150.99
          },
          "qrcode_secret": {
            "type": "string",
            "example": "2AX1bh0q97"
          },
          "anuncio_id": {
            "type": "integer",
            "nullable": false,
            "example": 5678
          },
          "sessao_id": {
            "type": "integer",
            "nullable": false,
            "example": 5678
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T10:00:00-03:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00-03:00"
          }
        }
      },
      "IngressoDetalhado": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Ingresso"
          },
          {
            "type": "object",
            "properties": {
              "anuncio": {
                "$ref": "#/components/schemas/Anuncio"
              },
              "sessao": {
                "$ref": "#/components/schemas/Sessao"
              },
              "descricao": {
                "type": "string",
                "format": "date-time",
                "example": "VERMELHO SUPERIOR - MEIA ENTRADA"
              }
            }
          }
        ]
      },
      "Anuncio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": false,
            "example": 4321
          },
          "nome": {
            "type": "string",
            "nullable": false,
            "example": "Cruzeiro x Atlético"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T10:00:00-03:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00-03:00"
          }
        }
      },
      "AnuncioDetalhado": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Anuncio"
          },
          {
            "type": "object",
            "properties": {
              "sessoes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Sessao"
                }
              },
              "jogo": {
                "$ref": "#/components/schemas/Jogo"
              },
              "qtd_ingressos": {
                "type": "integer",
                "nullable": false,
                "example": 1
              }
            }
          }
        ]
      },
      "Sessao": {
