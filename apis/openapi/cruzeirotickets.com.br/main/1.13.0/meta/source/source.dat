    "responses": {
      "UnauthorizedError": {
        "description": "Não autorizado",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Acesso negado, credenciais inválidas."
                }
              }
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Proibido",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Permissão insuficiente para acessar este recurso."
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Erro interno do servidor",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Ocorreu um erro inesperado, tente novamente mais tarde."
                }
              }
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Recurso não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Não foi possível encontrar o recurso solicitado."
                }
              }
            }
          }
        }
      },
      "InvalidError": {
        "description": "A requisição não pode ser concluída com sucesso.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "A requisição não pode ser concluída com sucesso."
                }
              }
            }
          }
        }
      },
      "CustomError": {
        "description": "Erro personalizado do sistema",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Uma regra/validação do sistema foi violada e solicitação não foi concluída."
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
