            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://socio.cruzeiro.com.br/minha-conta/ingressos/5678/edit"
          },
          "cancelar_transferencia": {
            "type": "boolean",
            "nullable": false,
            "example": true
          },
          "cancelar_transferencia_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://socio.cruzeiro.com.br/minha-conta/ingressos/5678/edit"
          },
          "cadastrar_facial": {
            "type": "boolean",
            "nullable": false,
            "example": false
          },
          "facial_status": {
            "type": "string",
            "nullable": false,
            "enum": [
              "indisponivel",
              "dispensada",
              "pendente",
              "concluida"
            ],
            "example": "pendente",
            "description": "O status \"indisponivel\" deve ser tradado como \"Reconhecimento Facial Indisponível\", não como algo definitivo pois o facial pode passar a ser exigido posteriormente."
          },
          "cadastrar_facial_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://socio.cruzeiro.com.br/biometria-facial/cadastrar?documento_numero=006.125.151-84&documento_tipo=CPF&facial_gateway_id=1&modo_embeded=true"
          }
        }
