{
  "openapi": "3.0.0",
  "info": {
    "title": "JuJu API",
    "description": "Public and partner-facing endpoints for the JuJu jobs platform. Covers job search, click attribution, publisher API integration, and the consumer/admin/sponsor/publisher portals.",
    "contact": {
      "name": "JuJu Engineering",
      "email": "engineering@juju.com"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.juju.com",
      "description": "Publisher B2B API (external partners, api_auth Bearer keys)"
    },
    {
      "url": "https://webapi.juju.com",
      "description": "Consumer Web API (SPA backend, hmac:webapi)"
    },
    {
      "url": "https://adminapi.juju.com",
      "description": "Admin API (hmac:admin + session)"
    },
    {
      "url": "https://sponsorapi.juju.com",
      "description": "Sponsor Portal API (hmac:sponsor + session)"
    },
    {
      "url": "https://publisherapi.juju.com",
      "description": "Publisher Portal API (hmac:publisher + session)"
    }
  ],
  "security": [
    {
      "publisherApiKey": []
    }
  ],
  "paths": {
    "/admin/v1/admin-users": {
      "get": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - List",
        "operationId": "058ac7fc1836de4220c52d11f0b9824f",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Substring against username or email.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "username",
                "first_name",
                "last_name",
                "email",
                "role",
                "date_created",
                "date_last_login",
                "active"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated admin-user list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AdminUser"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - Create",
        "description": "Body: username*, password*, email*, first_name, last_name, phone (optional; E.164-normalized), role (default 'admin'). Password minimum 12 chars.",
        "operationId": "cd0a8e85ac03b7081c568d18da71625b",
        "responses": {
          "201": {
            "description": "Created admin user.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AdminUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Username or email already taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/admin-users/{id}": {
      "get": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - Detail",
        "operationId": "6ea6771df6f0edcbf9c4ac594088aa1c",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin-user detail.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AdminUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - Deactivate",
        "description": "Sets active=false. Row survives for audit continuity; user's next login attempt returns 401 (partial-unique-on-username-active lets a fresh admin re-register the username if needed).",
        "operationId": "b04621206492319c53da37757ac32988",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivated admin user.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AdminUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - Update",
        "description": "Partial update (non-secret fields). Mutable: first_name, last_name, role, phone (E.164 normalized), email (resolves to juju.email artifact). Username is immutable (audit-log continuity). Password uses /reset-password.",
        "operationId": "84cafd5831e8d859e1bd7f2068e0223e",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated admin user.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AdminUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/admin-users/{id}/reset-password": {
      "post": {
        "tags": [
          "Admin User"
        ],
        "summary": "Admin User - Reset Password",
        "description": "Admin sets the password out-of-band and communicates it to the user directly (until email-based reset flows land). Body: password* (min 12 chars). Returns 200 with {reset: true} — envelope-consistent rather than the RFC-canonical 204 No Content.",
        "operationId": "60341963e8c5cd5ab957ef71f181a457",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Password reset succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "reset": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Password too short.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Login",
        "description": "Body: {username, password}. Success mints an admin-audience JWT (8h TTL default), sets it as an httpOnly + SameSite=Lax cookie, stamps date_last_login on the admin_user row, and returns the admin's public profile. Failures return 401 with a generic \"Invalid credentials.\" message — same response for unknown username and wrong password to avoid user enumeration.",
        "operationId": "7ee1413dc042ab5c693f52fa5f4bf3ea",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "brooke",
                    "maxLength": 64
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded. Session cookie set on response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "role": {
                              "type": "string",
                              "example": "admin"
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials. Same body for unknown username and wrong password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limited (admin `login` bucket: 10/min/IP).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Logout",
        "description": "Sets the session cookie to empty with immediate expiry. Stateless JWTs — no server-side session row to destroy; if the client presents the old cookie value on a subsequent request the SessionAuth filter rejects it once the JWT expiry passes. Idempotent — always returns 200.",
        "operationId": "0563d69f53a314b132442bb24375e65f",
        "responses": {
          "200": {
            "description": "Cookie cleared (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "logged_out": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/adjustments": {
      "get": {
        "tags": [
          "Adjustment"
        ],
        "summary": "Adjustment - List",
        "operationId": "e978b3b5950e73cc0d177679ef8d0ae1",
        "parameters": [
          {
            "name": "account_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "sponsor",
                "publisher"
              ]
            }
          },
          {
            "name": "account_ref",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "applied",
                "void"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated adjustment list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Adjustment"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Adjustment"
        ],
        "summary": "Adjustment - Issue",
        "description": "Issue a pending credit/debit. Body: account_type* (sponsor|publisher), account_ref* (job_partner_id or publisher_id), direction* (credit|debit), amount* (>0), reason*. Applied to the next invoice/payout for that account.",
        "operationId": "281438f12b350d14e7c8c36566d78022",
        "responses": {
          "201": {
            "description": "Issued adjustment.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Adjustment"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/invoices": {
      "get": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - List",
        "operationId": "5b2384e870a9cb2c0b12e4dccdc02578",
        "parameters": [
          {
            "name": "job_partner_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "open",
                "paid",
                "partially_paid",
                "void",
                "uncollectible"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "date_created",
                "issued_at",
                "due_at",
                "total",
                "status"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated invoice list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Invoice"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/invoices/{id}": {
      "get": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - Detail",
        "operationId": "a901c3c6ae52e73c9dbb4a32686b9a08",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice + line items + payments applied.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/Invoice"
                            },
                            {
                              "properties": {
                                "line_items": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                },
                                "payments": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/Payment"
                                  }
                                }
                              },
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/invoices/{id}/issue": {
      "post": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - Issue",
        "description": "Draft → open: stamps issued_at/due_at and posts the sponsor ledger debit.",
        "operationId": "d588b5aa740801c89a7365127a96a71b",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issued invoice.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Invoice"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Not a draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/invoices/{id}/void": {
      "post": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - Void",
        "description": "Voids an unpaid invoice. A draft voids cleanly; an issued (open) invoice also posts a compensating sponsor ledger credit to reverse its debit. Invoices with any payment applied cannot be voided (refund first).",
        "operationId": "a5667481fccdedb0abf5aff98fe3d1ea",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Voided invoice.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Invoice"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Not voidable (paid / already void).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/sponsors/{partner}/balance": {
      "get": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - Sponsor Balance",
        "description": "Sponsor AR balance from the ledger: Σ invoiced − Σ paid − Σ credits. Positive = owes us; negative = on-account credit.",
        "operationId": "656b20cbcb4892e1e6076a8d15f93ccd",
        "parameters": [
          {
            "name": "partner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Balance.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "job_partner_id": {
                              "type": "integer"
                            },
                            "balance": {
                              "type": "string",
                              "example": "4211.5500"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
