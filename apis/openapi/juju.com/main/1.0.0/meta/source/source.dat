    "/admin/v1/reports/clicks": {
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "Reports - Clicks",
        "description": "Daily click aggregates. Admin sees system-wide; narrow with any subset of publisher_id, publisher_account_id, sponsor_id, job_provider_id. Sourced from click_publisher_daily_rollup; refreshed every ~5 minutes by clicks:refresh-rollups. Group by date, account, publisher, provider.",
        "operationId": "bab3312aa93ed8f86be313d5e53b1de5",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "publisher_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "publisher_account_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sponsor_id",
            "in": "query",
            "schema": {
              "description": "aka job_partner_id",
              "type": "integer"
            }
          },
          {
            "name": "job_provider_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "Group-by dimensions (repeat or CSV). Allowed set is per report (see the reports changelog); default date. Id filters accept a single value or a CSV/repeat list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Date bucket: day|week|month (default day).",
            "schema": {
              "type": "string",
              "default": "day",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily rows, ordered by report_date DESC.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReportClicksDailyRow"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "from/to missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
