        ],
        "summary": "Offer List - Add Sponsor",
        "description": "Body: sponsor_id* (aka job_partner_id), is_blocklist (default false). A single sponsor can appear at most once per list — POSTing twice for the same sponsor returns 409. Use PATCH to flip is_blocklist on an existing row.",
        "operationId": "502f766b372ceb6ea8b538b4d32987f3",
        "parameters": [
          {
            "name": "list_id",
            "in": "path",
