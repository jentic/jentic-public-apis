    "/admin/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health - Admin Liveness",
        "description": "Unauthenticated. Returns ok=true if the admin module is loaded and the response pipeline is healthy. Wire into LB health checks. Does NOT exercise downstream dependencies (DB, Solr, Memcached) — keep those out so a failing dependency doesn't cycle the LB target.",
        "operationId": "5186a3cfe237fb5e6f51a135ec9135de",
        "responses": {
          "200": {
            "description": "Module is up.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "required": [
                            "ok"
                          ],
                          "properties": {
                            "ok": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/lookups": {
      "get": {
        "tags": [
          "Lookup"
        ],
        "summary": "Lookup - Aggregate",
        "description": "Admin form-population lookups (single aggregate). One call returns campaign_budget_types, job_partners, work_types, and job_groups. Cached ~5min in Memcached. Use for admin SPA form dropdowns.",
        "operationId": "ccc1a5900eb7dcb0e9576e022724d257",
        "responses": {
          "200": {
            "description": "Lookups payload — full aggregate.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Lookups"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Me - Get Profile",
        "description": "Returns the profile fields for the admin identified by the session cookie. Same shape as the login response. The admin_user_id comes from the session, NOT the URL — an admin can never read another admin's profile via this endpoint.",
        "operationId": "efe617a0ea26d2f8127787fab7bac6c5",
        "responses": {
          "200": {
            "description": "Current admin profile.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "role": {
                              "type": "string",
                              "example": "admin"
                            },
                            "date_created": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie, OR session's admin_user_id no longer maps to an active admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/notifications": {
      "get": {
        "tags": [
          "Notification"
        ],
        "summary": "Notification - List",
        "description": "Filters: status, severity, type. Defaults to actionable (open + acknowledged) newest-activity-first when no status is given.",
        "operationId": "72aad34ebe702cb8ad9e1bfe19efe8d3",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "acknowledged",
                "resolved",
                "dismissed",
                "actionable"
              ]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated notifications.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Notification"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
