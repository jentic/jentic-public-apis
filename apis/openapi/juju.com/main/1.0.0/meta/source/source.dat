              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "phone": {
                              "type": "string",
                              "nullable": true
                            },
                            "date_created": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            },
                            "job_partner_id": {
                              "type": "integer"
                            },
                            "job_partner_name": {
                              "type": "string"
                            },
                            "job_partner_website": {
                              "type": "string",
                              "nullable": true
                            },
                            "job_partner_documentation": {
                              "type": "string",
                              "nullable": true
                            },
                            "job_provider_id": {
                              "description": "Null when the login has org-wide access.",
                              "type": "integer",
                              "nullable": true
                            },
                            "job_provider_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "job_provider_feed_url": {
                              "type": "string",
                              "nullable": true
