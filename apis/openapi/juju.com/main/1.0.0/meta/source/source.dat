          },
          "404": {
            "description": "Offer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Offer Schedule"
        ],
        "summary": "Offer Schedule - Clear All",
        "description": "Removes every schedule window for the offer. Leaves the offer with no schedule = inactive on all days until new windows are POSTed. Use to reset before re-populating from a template.",
        "operationId": "f32b75d818b95a76a7f35fb4b3fac508",
