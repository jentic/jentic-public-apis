    "/admin/v1/segments/{segment_id}/observations": {
      "get": {
        "tags": [
          "Segment"
        ],
        "summary": "Segment - Conversion Observations",
        "description": "Per-day CPA conversion time series for a segment (sponsor.segment_conversion_observation) — the source for the CPA performance graph. Returns clicks, confirmed conversions, the (capped) daily observed rate, and confirmed revenue per day, newest first. Defaults to the last 30 days; bound with from/to (YYYY-MM-DD).",
        "operationId": "208d25acd79f2f51564c8dee9e154707",
        "parameters": [
          {
            "name": "segment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observation rows (money + rate as exact DB strings).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "properties": {
                              "report_date": {
                                "type": "string",
                                "format": "date"
                              },
                              "clicks": {
                                "type": "integer"
                              },
                              "conversions": {
                                "type": "integer"
                              },
                              "observed_rate": {
                                "type": "string",
                                "example": "0.037500",
                                "nullable": true
                              },
                              "revenue_confirmed": {
                                "type": "string",
                                "example": "1875.00"
                              }
                            },
                            "type": "object"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Segment not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/sponsor-logins": {
      "get": {
        "tags": [
          "Sponsor Login"
        ],
        "summary": "Sponsor Login - List",
        "operationId": "28019d97d9cc891c667b4a6033f622ce",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "job_partner_id",
            "in": "query",
            "description": "Parent sponsor org.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "job_provider_id",
            "in": "query",
            "description": "Sub-account provider scope; nullable in the underlying row.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "username",
                "first_name",
                "last_name",
                "email",
                "date_created",
                "date_last_login",
                "active"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
