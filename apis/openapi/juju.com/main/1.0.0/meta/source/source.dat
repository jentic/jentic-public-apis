    "/sponsor/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Login",
        "description": "Body: {username, password}. Success mints a sponsor-audience JWT (12h TTL default), sets it as an httpOnly + SameSite=Lax + Secure cookie, stamps date_last_login on the sponsor_login row, and returns the sponsor's public profile — including the parent job_partner and optional job_provider sub-account scoping. Failures return 401 with a generic \"Invalid credentials.\" message — same response for unknown username and wrong password to avoid user enumeration.",
        "operationId": "02637b5cc21272332750d412712f145e",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "jane.doe",
                    "maxLength": 64
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded. Session cookie set on response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "description": "sponsor_login_id",
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "job_partner_id": {
                              "description": "Parent sponsor org — session scope for reports.",
                              "type": "integer"
                            },
                            "job_partner_name": {
                              "type": "string"
                            },
                            "job_provider_id": {
                              "description": "Optional sub-account scoping. Null = access across all providers under the partner.",
                              "type": "integer",
                              "nullable": true
                            },
                            "job_provider_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limited (sponsor `login` bucket).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Logout",
        "description": "Clears the session cookie. Stateless JWT — no server-side session row to destroy; if the client presents the old cookie value on a subsequent request the SessionAuth filter rejects it once the JWT expiry passes. Idempotent — always returns 200.",
        "operationId": "70f783d1ae8c4c2e03dc3392b251f311",
        "responses": {
          "200": {
            "description": "Cookie cleared (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "logged_out": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/billing/invoices": {
      "get": {
        "tags": [
