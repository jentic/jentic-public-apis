    "/admin/v1/offers/{id}/reactivate": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Reactivate",
        "description": "Flips active=true on a previously-deactivated offer. Mirror of the DELETE endpoint. Also happens implicitly when an inactive offer is added to any offer_list via POST or PUT — this endpoint is for the case where ops wants to reactivate without touching list membership.",
        "operationId": "18639c81ff92ba750cec4a5465214153",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Offer"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/offers/{id}/lists": {
      "get": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - List Memberships",
        "description": "Every offer_list this offer belongs to, with the junction row's weight/position/active plus the parent list's name for display. Powers the \"this offer appears in\" section on the offer detail page.",
        "operationId": "469c1ff7c86f86bcf6b230992a8f4671",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Memberships.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "properties": {
                              "offer_list_id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "weight": {
                                "type": "integer"
                              },
                              "position": {
                                "type": "integer",
                                "nullable": true
                              },
                              "active": {
                                "description": "Junction row active flag.",
                                "type": "boolean"
                              },
                              "list_active": {
                                "description": "Parent list active flag.",
                                "type": "boolean"
                              }
                            },
                            "type": "object"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Offer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Set List Memberships (multi-select)",
        "description": "Sets exactly the given lists as this offer's memberships — additions and removals computed server-side. Supports the multi-select dropdown on the offer create/edit page: SPA sends {list_ids: [...]}, server diffs against current state and applies the deltas in one transaction. IMPLICIT REACTIVATION: if the offer is currently inactive AND the resulting membership set is non-empty, offer.active flips back to true.",
        "operationId": "0614546dd3d9511e5e416f598f56cb0c",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "list_ids": {
                    "description": "Exact target set of offer_list_ids. Existing memberships not in this array are removed; new ones are added with weight=10, position=null.",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Set applied. Response includes the reconciliation summary.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "added": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            },
                            "removed": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            },
                            "unchanged": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            },
                            "reactivated": {
                              "description": "True iff this call flipped offer.active from false to true.",
                              "type": "boolean"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Offer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/providers": {
      "get": {
        "tags": [
          "Provider"
        ],
        "summary": "Provider - List",
        "description": "Paginated. Filters: q (name substring), active, paused, job_partner_id.",
        "operationId": "cd1f3ee495c95cd6a6b8b1fe802176f7",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "paused",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "job_partner_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "date_created",
                "last_run_completed",
                "active",
                "paused",
                "refresh_minutes"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated provider list. Each row carries `last_run_completed` — MAX(time_processing_finished) — for the providers-list badge.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Provider"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Provider"
        ],
        "summary": "Provider - Create",
        "description": "Body: job_partner_id*, name*, feed_url, capture_node, username (write-only), password (write-only), refresh_minutes, schema_mapping (JSONB), click_id_param, fetch_method, fetch_config (JSONB), fetch_credentials (write-only).\n\n─── Fetch transport ────────────────────────────────────────\n`fetch_method` selects how the feed is acquired: `url` (default — HTTP(S)/FTP via feed_url, using username/password when set) or `s3` (S3 + STS AssumeRole).\n\nFor `s3`, `fetch_config` is REQUIRED and holds NON-SECRET config: `bucket`*, `key` or `prefix`, `region`, `role_arn`, `external_id`, `credential_source` (`instance` | `ssm` | `static`), `credentials_ref` (SSM path when source=ssm), `object_selection` (`key` | `newest_in_prefix`). It is returned in full on GET — none of it is a secret.\n\n`fetch_credentials` is a WRITE-ONLY object for the last-resort `static` path (`{\"access_key_id\": \"...\", \"secret_access_key\": \"...\"}`). It is AES-256-GCM encrypted at rest and NEVER returned by any GET — reads expose only the boolean `has_stored_credentials`. Prefer `credential_source: \"instance\"` so no credential exists at all.",
        "operationId": "cb99a5e79fc0ca2737ee4c495848d12e",
        "responses": {
          "201": {
            "description": "Created provider (detail shape — includes schema_mapping, campaign_count, latest_run, credential presence booleans; credential values never returned).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/Provider"
                            },
                            {
                              "properties": {
                                "schema_mapping": {
                                  "type": "object",
                                  "nullable": true
                                },
                                "campaign_count": {
                                  "type": "integer"
                                },
                                "username_set": {
                                  "type": "boolean"
                                },
                                "password_set": {
                                  "type": "boolean"
                                },
                                "latest_run": {
                                  "oneOf": [
                                    {
                                      "$ref": "#/components/schemas/RunInfo"
                                    }
                                  ],
                                  "nullable": true
                                }
                              },
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failure (includes fetch_config shape errors).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
