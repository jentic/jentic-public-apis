      "post": {
        "tags": [
          "Offer Schedule"
        ],
        "summary": "Offer Schedule - Add Window",
        "description": "Body: day_of_week* (0-6, Sun-Sat), start_time* (HH:MM or HH:MM:SS), end_time* (HH:MM or HH:MM:SS). start_time must be strictly less than end_time (CHECK constraint mirrored here for a clean 422). Multiple windows per day are allowed — no uniqueness constraint on (offer_id, day_of_week).",
        "operationId": "bcf7320ffc14cbd1f80458e60cca21a5",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created window.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/OfferSchedule"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
