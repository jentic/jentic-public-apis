    "/admin/v1/sponsors/{id}/callback-key": {
      "post": {
        "tags": [
          "Sponsor"
        ],
        "summary": "Sponsor - Generate Callback Key",
        "description": "Generates (or REGENERATES, invalidating the old one) this sponsor's conversion-callback key — the Bearer credential the sponsor presents on POST api.juju.com/api/v1/conversions. ONE key covers every provider/feed the sponsor runs (the click_id in the postback resolves the specific provider on its own). The plaintext is returned ONCE here and never again (only a hash is stored); relay it to the sponsor securely. Regenerating immediately breaks any callback still using the previous key.",
        "operationId": "6ccbbea96fb4bd3efd67168b6dce5e32",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "New callback key. `plaintext` is shown only in this response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "plaintext": {
                              "description": "Full key — shown once, store securely.",
                              "type": "string",
                              "example": "juju_cb_Xy7...q2"
                            },
                            "hint": {
                              "description": "Last 4 chars, echoed in future GETs to identify the key.",
                              "type": "string",
                              "example": "q2Rk"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Sponsor not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/sponsors": {
      "get": {
