            "description": "Revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PublisherAccount"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account not found or not owned by this publisher.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/api-keys/{id}/rotations": {
      "get": {
        "tags": [
          "Publisher Account"
        ],
        "summary": "Publisher Account - Rotation History",
        "description": "Paginated audit log for this account — every rotate/revoke/reactivate/expire event, newest first. Scope-checked: publisher sees only their own accounts' history. `actor_display` is the human-readable name of whoever initiated each event (admin, one of the publisher's own logins, or \"system\").",
        "operationId": "38abc399212f7f2e99a8626356e2feb7",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated rotation history for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PublisherKeyRotation"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account not found or not owned by this publisher.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Login",
        "description": "Body: {username, password}. Success mints a publisher-audience JWT (12h TTL default), sets it as an httpOnly + SameSite=Lax + Secure cookie, stamps date_last_login on the publisher_login row, and returns the publisher's public profile — including the linked publisher org id + name. Failures return 401 with a generic \"Invalid credentials.\" message — same response for unknown username and wrong password to avoid user enumeration.",
        "operationId": "15503a4abc8af48b645ea7c4fa236261",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "lisa.smith",
                    "maxLength": 64
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded. Session cookie set on response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "description": "publisher_login_id",
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "publisher_id": {
                              "description": "Publisher org — session scope for reports and account management.",
                              "type": "integer"
                            },
                            "publisher_name": {
                              "type": "string"
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate-limited (publisher `login` bucket).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Auth - Logout",
        "description": "Clears the session cookie. Stateless JWT — no server-side session row to destroy. Idempotent.",
        "operationId": "00dbc91b3ebaaf2f0eaf268b41244f91",
        "responses": {
          "200": {
            "description": "Cookie cleared (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "logged_out": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
