    "/admin/v1/offers/{id}/pause": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Pause",
        "description": "Sets paused=true. Immediate effect on next matcher run — the `WHERE active AND NOT paused` predicate on the matcher's primary index excludes paused offers from every serve.",
        "operationId": "8352fdf38e525e570292dbf7bd559eb6",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
