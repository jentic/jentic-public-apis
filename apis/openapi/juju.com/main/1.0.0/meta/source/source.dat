    "/publisher/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Publisher module liveness probe",
        "description": "Unauthenticated. Returns ok=true if the publisher module is loaded and the response pipeline is healthy. Wire into LB health checks. Does NOT exercise downstream dependencies.",
        "operationId": "4db78c34c5ea7acb0df2a1ed26bb18b3",
        "responses": {
          "200": {
            "description": "Module is up.",
