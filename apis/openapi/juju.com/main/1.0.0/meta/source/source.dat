    "/admin/v1/system/budget-status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "System - Budget Status",
        "description": "Campaign-cache health probe (admin-scoped mirror of the public endpoint). Same body shape as GET /api/v1/jobs/budget-status. Provided on the admin surface so admin dashboards don't have to reach across into the public tier. Alert-worthy fields: stale_warning=true (refresh task stopped firing) and live_providers=false (/jobs/search is currently returning empty).",
        "operationId": "77a12e689edb9b50e77fc6db080fe864",
        "responses": {
          "200": {
            "description": "Read the body fields to determine cache health.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/system/provider-status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "System - Provider Status",
        "description": "Per-provider serving + budget + inventory report for the admin dashboard. Shows which providers are currently serving (paid / organic), each active campaign's remaining budget, and how many jobs the provider has in the Solr index. Serving state + spend are free reads of the sponsor:refresh-budgets cache (money is NOT recomputed here); job counts come fresh from Solr. `meta.refresh_stale=true` means sponsor:refresh-budgets has stopped firing and the serving/spend numbers are stale. Optional `provider` query param limits to one job_provider_id. Money as strings.",
        "operationId": "986b0f471e18ac5e7bd3c2b1b0c66d23",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "description": "Limit to a single job_provider_id.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider status report.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ProviderStatus"
                          }
                        },
                        "meta": {
                          "properties": {
                            "refresh_age_seconds": {
                              "description": "Seconds since the last sponsor:refresh-budgets tick, or null if never.",
                              "type": "integer",
                              "nullable": true
                            },
                            "refresh_stale": {
                              "description": "True when the refresh is older than 300s (or absent) — serving/spend numbers are stale.",
                              "type": "boolean"
                            },
                            "solr_error": {
                              "description": "Non-null when the Solr job-count query failed; job counts then read 0.",
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/system/health-summary": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "System - Health Summary",
        "description": "One-screen platform health report. Aggregates individual health probes across the platform's core dependencies. Every field is best-effort — a failed probe yields {up: false} for that block rather than 500ing the whole endpoint. Use for the admin dashboard's \"is the platform healthy?\" widget and for external monitoring integration.",
        "operationId": "8f11785e7ef15ebbd4fb77105a6068a2",
        "responses": {
          "200": {
            "description": "Health summary.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "solr": {
                              "properties": {
                                "up": {
                                  "type": "boolean"
                                },
                                "document_count": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "type": "object"
                            },
                            "memcached": {
                              "properties": {
                                "up": {
                                  "type": "boolean"
                                }
                              },
                              "type": "object"
                            },
                            "postgres": {
                              "properties": {
                                "up": {
                                  "type": "boolean"
                                }
                              },
                              "type": "object"
                            },
                            "feed_worker": {
                              "properties": {
                                "last_run_completed": {
                                  "type": "string",
                                  "format": "date-time",
                                  "nullable": true
                                },
                                "runs_active": {
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "budget_refresh": {
                              "properties": {
                                "last_run": {
                                  "type": "string",
                                  "format": "date-time",
                                  "nullable": true
                                },
                                "stale_warning": {
                                  "type": "boolean"
                                },
                                "refresh_age_seconds": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "type": "object"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "User - List",
        "description": "Paginated. Filters: q (substring on email/first_name/last_name), active, verified (based on date_verified on the email artifact), created_since (ISO date).",
        "operationId": "ec4df2da880a6498ea2c2085dd7b3f6d",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "description": "true = e.date_verified IS NOT NULL; false = IS NULL",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "created_since",
            "in": "query",
            "description": "ISO 8601 lower bound on juju.user.date_created.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "email",
                "first_name",
                "last_name",
                "date_created",
                "date_verified",
                "date_last_login",
                "active"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated user list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ConsumerUser"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users/{id}": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "User - Detail",
        "description": "Enriched view for support / ops drill-down. Includes extended PII (juju.user_info) and activity counts (saved_jobs, saved_searches, recent search history, recent clicks). Click count is bounded to the last 90 days — jobs.click is time-partitioned and an unbounded COUNT would scan every partition.",
        "operationId": "ccce052a88673d24ebd43c78e6299764",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User detail — list-row fields + `info` (nullable UserInfo) + `activity`.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/ConsumerUser"
                            },
                            {
                              "properties": {
                                "info": {
                                  "oneOf": [
                                    {
                                      "$ref": "#/components/schemas/UserInfo"
                                    }
                                  ],
                                  "nullable": true
                                },
                                "activity": {
                                  "$ref": "#/components/schemas/UserActivity"
                                }
                              },
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users/{id}/deactivate": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "User - Deactivate",
        "description": "Immediate effect on next request: session_auth finds the JWT valid but Profile's row lookup filters WHERE active=true and returns null → 401. Row is preserved for billing / audit continuity.",
        "operationId": "35b1ba05a6d67c47354cc06119af2277",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivated user (list-row shape).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ConsumerUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users/{id}/reactivate": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "User - Reactivate",
        "operationId": "0fc421669b8ca12a3d53536dd6bafeb9",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reactivated user (list-row shape).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ConsumerUser"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users/purge-stale": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "User - Purge Stale Data",
        "description": "Runs the same retention DELETEs the `users:purge-stale-data` spark command runs. Synchronous — the endpoint waits for the DELETEs to complete and returns row counts. Body: `{\"dry_run\": bool, \"target\": \"all|saved-jobs|search-history\"}`. Retention policy: saved_job 3y unapplied / 7y applied, search_history 90d.",
        "operationId": "b2631ad173291fa419478c7b9b6cb524",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "dry_run": {
                    "type": "boolean",
                    "default": false
                  },
                  "target": {
                    "type": "string",
                    "default": "all",
                    "enum": [
                      "all",
                      "saved-jobs",
                      "search-history"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purge complete. `data` reports what was (or would have been) deleted per target.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "dry_run": {
                              "type": "boolean"
                            },
                            "target": {
                              "type": "string",
                              "enum": [
                                "all",
                                "saved-jobs",
                                "search-history"
                              ]
                            },
                            "saved_jobs_deleted": {
                              "description": "Null when target excludes this bucket.",
                              "type": "integer",
                              "nullable": true
                            },
                            "search_history_deleted": {
                              "type": "integer",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/jobs/click/{token}": {
      "get": {
        "tags": [
          "Clicks"
        ],
        "summary": "Click-through redirector for job applications",
        "description": "Decodes an AES-CTR token (produced by JobDocumentFormatter as the `click_url` field on every search/show response), records an attribution row in jobs.click, snapshots the job's display fields for forensics, and 302-redirects the user to the underlying provider URL. NOT under /api/v1 — these URLs end up in emails, shared links, and search-engine caches, so they stay short and stable across API version bumps. ALWAYS hit this URL to send a user to a job — direct provider URLs are intentionally not exposed.",
        "operationId": "6643e4109ffee94bb735997bc6206210",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "AES-256-CTR-encrypted base64url token from a Job document's `click_url` field. Opaque to consumers — never construct this client-side, only pass through verbatim.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful click. `Location` header carries the underlying provider URL (with any provider-configured tracking parameters appended). The browser follows it automatically.",
            "headers": {
              "Location": {
                "description": "The provider URL to redirect to.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Missing token path parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Token decryption failed, the underlying job has expired / been deleted, or its joburl is unavailable. The link is permanently dead — do NOT retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Solr lookup failed — the underlying job document could not be fetched, so there is no destination to send the user to. Retry with backoff is OK. NOTE: a failed click-INSERT no longer 503s; the user is 302-redirected to the job anyway and the billing miss is logged (see the 302 response).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversions/college-recruiter": {
      "post": {
        "tags": [
          "Conversions"
        ],
        "summary": "College Recruiter conversion webhook (HMAC-signed)",
        "description": "Partner-specific conversion callback for College Recruiter, who authenticates by HMAC signature rather than our Bearer callback key. Send `X-Webhook-Signature: sha256=<hex>` and `X-Webhook-Timestamp: <epoch>`, where the HMAC-SHA256 is over \"{timestamp}.{raw body}\" with the shared secret. POST (JSON body) only. Our click id must be echoed under data.publisherParams.click_id; data.conversionId is the idempotency key. conversion.paid + data.paid=true books data.priceInUsd as revenue.",
        "operationId": "353e22db50bf19cc23d94c7a18f419a9",
        "responses": {
          "200": {
            "description": "Booked, recorded-as-rejected (unpaid), or an idempotent replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Body is not a JSON object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid signature / stale timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Valid body but unbookable — missing/unknown click_id, click not owned by this partner, or a paid event with no price.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Transient write failure — retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversions": {
      "post": {
        "tags": [
          "Conversions"
        ],
        "summary": "Post back a CPA job-application conversion",
        "description": "Sponsors call this when a click on their CPA job becomes an application. Authenticate with `Authorization: Bearer <callback key>` (your sponsor callback key, issued in the admin console — distinct from a publisher API key). ONE key covers every feed you run with us. Reference the click via the `click_id` we appended to your job URL on redirect. Idempotent: retrying the same (click_id, reference) returns the original conversion rather than double-booking. Revenue is computed from our recorded value, not any amount you send.",
        "operationId": "7240fd43aaffb72bf58acac2e678d1f6",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "click_id"
                ],
                "properties": {
                  "click_id": {
                    "description": "The opaque click id we appended to your job URL (via your configured click_id_param) on the outbound redirect.",
                    "type": "string",
                    "format": "uuid",
                    "example": "a1b2c3d4-e5f6-1234-9abc-0123456789ab"
                  },
                  "reference": {
                    "description": "Your own application/lead id. Optional but recommended — it is the idempotency key for retries. Omit it and we dedupe one conversion per click_id.",
                    "type": "string",
                    "example": "ZR-APP-99817",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversion recorded. `status` is `confirmed` when the click was billable, or `rejected` when it was not (a bot or duplicate click) — still stored for your dispute/audit trail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay — a conversion for this (click_id, reference) already existed; the original is returned and nothing was double-booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Body is not a JSON object, or click_id is missing / malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown Bearer callback key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "click_id is unknown, or its provider does not belong to the authenticated sponsor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Transient failure writing the conversion. Retry with backoff — the endpoint is idempotent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sponsorCallbackKey": []
          }
        ]
      }
    },
    "/api/v1/feeds/{slug}": {
      "get": {
        "tags": [
          "Feeds"
        ],
        "summary": "Download a publisher syndication feed file",
        "description": "Returns the caller's pre-generated, gzipped XML job feed as a file download (`Content-Type: application/gzip`, `Content-Disposition: attachment`). The feed is regenerated server-side on its own schedule; this endpoint serves the latest build. A publisher may only pull feeds owned by their own account. The bucket is private — bytes are proxied through the API, never a presigned/public S3 URL.\n\nAuthenticate with EITHER `Authorization: Bearer <api key>` OR a `?token=<api key>` query parameter — the same publisher key in both cases. This is the only endpoint that accepts the query-parameter form (for feed readers that can't set an Authorization header); the header takes precedence when both are supplied. NOTE: a key in the URL can be captured by intermediary/access logs, so prefer the header where you can, and use a dedicated, independently revocable key for URL pulls.\n\nThe header-less `?token=` path is additionally gated (a Bearer pull is not): the account must be allow-listed for header-less pulls (a key not allow-listed is rejected as 401, indistinguishable from a bad key), such pulls may optionally be restricted to a whitelist of source IPs (403 on a miss), and each feed may be pulled without a header only once per hour (429 with `Retry-After` when exceeded). Contact your account manager to be enabled for header-less pulls.",
        "operationId": "cc5692c9720bfd23f45f2c641898e1de",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Feed slug (as configured for your account).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "acme-nursing"
          },
          {
            "name": "token",
            "in": "query",
            "description": "Publisher API key, as an alternative to the `Authorization: Bearer` header (header wins if both are sent). Header-less auth for feed readers that can't set headers. Prefer the header where possible — a URL-borne key can leak into access logs.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "juju_pub_XXXXXXXXXXXXXXXXXXXXXXXX"
          }
        ],
        "responses": {
          "200": {
            "description": "The gzipped XML feed file. Decompress to get `<jobs><job>…</job></jobs>`.",
            "content": {
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "No valid credential — neither a `Authorization: Bearer <api key>` header nor a `?token=<api key>` query parameter resolved to an active key. As of 2026-09-03 api.publisher_auth_required is enabled, so an absent credential is a 401 rather than anonymous access. A `?token=` key whose account is not allow-listed for header-less pulls also 401s here, deliberately indistinguishable from an invalid key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Header-less (`?token=`) pull from a source IP that is not on this account's IP whitelist. Only applies to `?token=` pulls; use the `Authorization: Bearer` header, or pull from a whitelisted IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such feed for this account, the feed is inactive, or it has not been generated yet. (Ownership misses return 404, not 403, so a caller can't probe other publishers' slugs.)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Header-less (`?token=`) pull rate limit exceeded — a feed may be pulled once per hour (configurable per account) without an `Authorization` header. Includes a `Retry-After` header. Bearer-header pulls are not subject to this cap.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "The feed store is temporarily unreachable. Retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/search": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Search active job postings",
        "description": "Paginated keyword + faceted search across all active job postings. Filters compose with AND semantics. Returns up to per_page Job documents per call. Filter values are escaped against Solr injection before query construction. Empty `q` matches everything (subject to the active campaign filter — only jobs with live sponsor budget are eligible). Results are DEDUPLICATED: the same job appearing across multiple feeds is collapsed to a single result (the highest-paying instance), so `total` and the rows reflect distinct jobs, not raw postings. NOTE: on API-key (publisher) responses the Job `id` is an opaque, stable token and `jobid` / `job_provider_id` are omitted (internal identifiers are not exposed); signed first-party responses carry the raw `id` + those fields.",
        "operationId": "57ac47a4e928a86c97e3ac597fb0490f",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Keyword. Escaped before Solr — special characters are safe.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "City to search near. By default this runs as a RADIUS around the city (api.default_radius_miles, >= 25 mi) — returning the surrounding metro, case-insensitively — not an exact city-name match. Pass an explicit `radius` to override.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Exact-match state filter (full name or 2-letter code, depending on indexed data).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "postal",
            "in": "query",
            "description": "Postal code to search near. Like `city`, defaults to a radius search (api.default_radius_miles, >= 25 mi) unless an explicit `radius` is given.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Exact-match country filter (e.g. `US`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "description": "true|false. Filters by the is_remote field. Omit for no filter.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Category filter (exact match on indexed category).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobgroup",
            "in": "query",
            "description": "Job group filter (exact match).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "work_type",
            "in": "query",
            "description": "Work-type filter (exact match).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobgroupid",
            "in": "query",
            "description": "Numeric detailed O*NET occupation id (jobgroupid). Granular — prefer major_group_id for a category filter.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "major_group_id",
            "in": "query",
            "description": "O*NET major-group id (the 23-value taxonomy from /lookups `job_groups`). The canonical, controlled category filter — prefer this over the free-text `category`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "provider_id",
            "in": "query",
            "description": "Numeric job provider id. Scopes results to one sponsor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "description": "Lower bound on salary_avg (inclusive).",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "salary_max",
            "in": "query",
            "description": "Upper bound on salary_avg (inclusive).",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "cpc_min",
            "in": "query",
            "description": "Lower bound on cpc.",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "cpc_max",
            "in": "query",
            "description": "Upper bound on cpc.",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field + direction, e.g. `date_posted desc`. Allowed fields: date_posted, date_indexed, cpc, salary_avg. Anything else is silently ignored (relevance scoring is the default).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "description": "Recency filter (days). Only jobs posted within the last N days (clamped 1-365).",
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1
            }
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Radius (miles) around a resolved anchor named by `postal` OR (`city` + optionally `state`). OPTIONAL — a city/postal search already runs at the default radius (api.default_radius_miles, >= 25 mi); pass this to override it. When a radius is in effect, `city` / `postal` act as the anchor rather than exact-match filters. An unresolvable anchor falls back to an exact filter (search still runs).",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-indexed page number (clamped to >= 1). Results past api.search_max_window — i.e. (page-1)*per_page at or beyond that window — are rejected with 400; page through the first N matches only. Use the syndication feed for bulk retrieval.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Results per page. Clamped server-side to api.per_page_max (50).",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response serialization. `json` (default) or `xml`. XML returns the SAME envelope with Content-Type `application/xml`: `<response><data><job>…</job></data><meta>…</meta><errors/></response>`. HTML-bearing fields (e.g. description) are CDATA-wrapped; facet-bucket values that are not valid XML tag names are emitted as `<entry key=\"…\">`. This XML option exists only on the public publisher endpoints (api.juju.com).",
            "schema": {
              "type": "string",
              "default": "json",
              "enum": [
                "json",
                "xml"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search. `data` is an array of Job documents (possibly empty); `meta` carries pagination and facet rollups.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Job"
                          }
                        },
                        "meta": {
                          "required": [
                            "total",
                            "page",
                            "per_page",
                            "total_pages",
                            "facets"
                          ],
                          "properties": {
                            "total": {
                              "type": "integer",
                              "example": 64
                            },
                            "page": {
                              "type": "integer",
                              "example": 1
                            },
                            "per_page": {
                              "type": "integer",
                              "example": 10
                            },
                            "total_pages": {
                              "type": "integer",
                              "example": 7
                            },
                            "facets": {
                              "description": "Map of facet field → (map of value → count). Empty object if Solr returned no facet rollups for this query.",
                              "type": "object",
                              "example": {
                                "state": {
                                  "California": 17,
                                  "Idaho": 14
                                }
                              },
                              "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "integer"
                                }
                              }
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Result window exceeded — the requested page is past api.search_max_window; the app rejects fetches beyond the first N matches to stop inventory scraping and expensive deep Solr offsets. Narrow the search with filters, or use the syndication feed for bulk pulls.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Credential missing or rejected. On api.juju.com (partner tier) a valid `Authorization: Bearer <key>` is REQUIRED as of 2026-09-03 — an absent header is a 401, not anonymous access. On webapi.juju.com (first-party tier) this instead means a missing or invalid HMAC signature.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Solr backend is temporarily unavailable. Retry with exponential backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Retrieve a single job by compound id",
        "description": "Returns a single Job document keyed by the raw compound id `{job_provider_id}_{jobid}`. This is the `id` that SIGNED first-party (webapi) search returns. API-key (publisher) search returns an OPAQUE, non-resolvable `id` instead, so publishers CANNOT use this endpoint — they consume search + `click_url`; detail-by-id is a first-party path only. No campaign-budget filter is applied — if a sponsor depletes their budget mid-session, jobs returned by an earlier search can still be looked up via this endpoint (the click-time matcher handles eligibility).",
        "operationId": "3b618931dad8aabd3e8b4342a461b53d",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Compound id `{job_provider_id}_{jobid}`.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2_141096464"
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response serialization: `json` (default) or `xml`. XML returns the same envelope with Content-Type application/xml; the single job is rendered as `<response><data>…fields…</data></response>`.",
            "schema": {
              "type": "string",
              "default": "json",
              "enum": [
                "json",
                "xml"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single Job document in `data`.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Job"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing id path parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Credential missing or rejected. On api.juju.com (partner tier) a valid `Authorization: Bearer <key>` is REQUIRED as of 2026-09-03 — an absent header is a 401, not anonymous access. On webapi.juju.com (first-party tier) this instead means a missing or invalid HMAC signature.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No job with that id (expired, deleted, or never indexed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Solr backend is temporarily unavailable. Retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/count": {
      "get": {
        "tags": [
          "Jobs",
          "Monitoring"
        ],
        "summary": "Total indexed job count",
        "description": "Returns the raw count of job documents currently in the Solr index. Not filtered by campaign budget — represents inventory volume, not what would be served by /search. Useful for operator dashboards and \"are feeds importing?\" monitoring.",
        "operationId": "849b5861e211bc7d16fee5bd8c1f3738",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Response serialization: `json` (default) or `xml`. XML returns `<response><data>78335</data></response>` with Content-Type application/xml.",
            "schema": {
              "type": "string",
              "default": "json",
              "enum": [
                "json",
                "xml"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw integer in `data`.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "integer",
                          "example": 78335
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credential missing or rejected. On api.juju.com (partner tier) a valid `Authorization: Bearer <key>` is REQUIRED as of 2026-09-03 — an absent header is a 401, not anonymous access. On webapi.juju.com (first-party tier) this instead means a missing or invalid HMAC signature.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/budget-status": {
      "get": {
        "tags": [
          "Jobs",
          "Monitoring"
        ],
        "summary": "Campaign cache health probe",
        "description": "Reports whether the sponsor-budget cache that Jobs::search depends on is warm AND whether the refresh job is firing on schedule. Designed as a polling target for uptime monitors (Pingdom / CloudWatch synthetics / Datadog). Read-only, no business data leaks. AUTH CHANGED 2026-09-03: this endpoint carries api_auth, and api.publisher_auth_required is now enabled in production — so on api.juju.com a monitor MUST send `Authorization: Bearer <api key>` or it will receive 401 instead of the health body. Alert on stale_warning=true (refresh stopped firing — ~8min before customer impact) or live_providers=false (search already returning empty).",
        "operationId": "ae39f1257e3158496c202f530f990322",
        "responses": {
          "200": {
            "description": "Always 200. Read the body fields, not the status, to determine cache health.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "required": [
                            "live_providers",
                            "fq_clause",
                            "stale_warning",
                            "refresh_age_seconds",
                            "remaining_ttl_seconds"
                          ],
                          "properties": {
                            "live_providers": {
                              "description": "True iff campaign_live_providers key holds a non-empty array. False means /api/v1/jobs/search is currently returning empty results.",
                              "type": "boolean",
                              "example": true
                            },
                            "fq_clause": {
                              "description": "True iff campaign_fq_clause key holds a non-empty string. Same effect on search as live_providers.",
                              "type": "boolean",
                              "example": true
                            },
                            "stale_warning": {
                              "description": "True if the last successful refresh wrote longer than one tick (120s) ago. Fires before the cache expires; early signal that the refresh task has stopped.",
                              "type": "boolean",
                              "example": false
                            },
                            "refresh_age_seconds": {
                              "description": "Seconds since the most recent successful refresh wrote to the cache. Null if no refresh has been recorded (cache fully expired or first boot).",
                              "type": "integer",
                              "example": 45,
                              "nullable": true
                            },
                            "remaining_ttl_seconds": {
                              "description": "Seconds until the cache evicts if no further refresh occurs. Computed as CACHE_TTL (600) minus refresh_age.",
                              "type": "integer",
                              "example": 555
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credential missing or rejected. As of 2026-09-03 a valid `Authorization: Bearer <key>` is REQUIRED on api.juju.com — an absent header is a 401, not anonymous access. Uptime monitors configured before that date will see this instead of the health body until a key is added to the probe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/account": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Account - Get",
        "description": "Returns the logged-in publisher login's profile joined with their publisher org. Earnings numbers are NOT included — request /earnings for the summary or /reports/earnings for the daily breakdown.",
        "operationId": "fce02a2feda8c3afa6e9c23c0fbbee6e",
        "responses": {
          "200": {
            "description": "Current publisher account profile.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "username": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "phone": {
                              "type": "string",
                              "nullable": true
                            },
                            "date_created": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            },
                            "publisher_id": {
                              "type": "integer"
                            },
                            "publisher_name": {
                              "type": "string"
                            },
                            "publisher_website": {
                              "type": "string",
                              "nullable": true
                            },
                            "publisher_primary_contact": {
                              "type": "string",
                              "nullable": true
                            },
                            "publisher_primary_email": {
                              "type": "string",
                              "nullable": true
                            },
                            "publisher_primary_phone": {
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid session or the login is deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/api-keys": {
      "get": {
        "tags": [
          "Publisher Account"
        ],
        "summary": "Publisher Account - List",
        "description": "Lists API-key accounts under the logged-in publisher. Returns prefix + last-4 hint + cpc_share + tier + date_created + date_last_used. NEVER returns plaintext or hash (we don't have the plaintext; we only stored the SHA-256 hash at issuance / regenerate time).",
        "operationId": "fc404538f24fe0cac2d5ad64a9183036",
        "responses": {
          "200": {
            "description": "Accounts list (unpaginated — small per publisher).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PublisherAccount"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/api-keys/{id}": {
      "patch": {
        "tags": [
          "Publisher Account"
        ],
        "summary": "Publisher Account - Update Name",
        "description": "Rename an API-key account. Only `account_name` is mutable from this surface — cpc_share and rate_limit_tier are contract terms and must go through admin. Scope-checked: 404 for another org's account.",
        "operationId": "6d6e50999edb4d60e0b3510a5afce570",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "account_name": {
                    "type": "string",
                    "maxLength": 255
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated account.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PublisherAccount"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account not found or not owned by this publisher.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/api-keys/{id}/regenerate": {
      "post": {
        "tags": [
          "Publisher Account"
        ],
        "summary": "Publisher Account - Regenerate Key",
        "description": "Rotates key material IN PLACE on the same publisher_account row. The account (name, cpc_share, rate_limit_tier, historical click attribution) is preserved; only the key's prefix / hash / hint change. Old key stops authenticating IMMEDIATELY. Plaintext returned EXACTLY ONCE — unrecoverable after this response, same policy as admin issuance.",
        "operationId": "feaab4ad7bf5b533dfacc94b11df1d16",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rotated. `data.api_key_plaintext` is returned exactly once.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PublisherAccount"
                            },
                            {
                              "properties": {
                                "api_key_plaintext": {
                                  "description": "The full new plaintext key. Store immediately.",
                                  "type": "string"
                                },
                                "warning": {
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account not found or not owned by this publisher.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Prefix collision on generation (pathologically rare).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/api-keys/{id}/revoke": {
      "post": {
        "tags": [
          "Publisher Account"
        ],
        "summary": "Publisher Account - Revoke",
        "description": "Deactivates an API-key account (active=false). PublisherAuth denies the key on the next request — no cache warmup delay because the auth check is a per-request DB lookup. Historical click attribution keeps its FK to this row for billing continuity.",
        "operationId": "c23fbc5fa91a9bbbf67eb9df781eff4c",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
