    "/admin/v1/offer-lists/{id}/duplicate": {
      "post": {
        "tags": [
          "Offer List"
        ],
        "summary": "Offer List - Duplicate",
        "description": "Clones the list row + every offer / sponsor / publisher junction row into a new list_id, in one transaction. Body: {name?} — defaults to `\"{original name} (copy)\"` when not supplied. New list starts `active=true`. All junction rows carry over their weights / positions / is_blocklist / priority values unchanged.",
        "operationId": "14c62d41c4e8bd7683b1f51e11f788d5",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Duplicated list detail.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/OfferList"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Source list not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Duplicate transaction failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
