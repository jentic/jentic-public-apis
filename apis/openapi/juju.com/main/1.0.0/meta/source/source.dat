    "/admin/v1/offer-lists/{list_id}/offers": {
      "get": {
        "tags": [
          "Offer List"
        ],
        "summary": "Offer List - List Members",
        "description": "Paginated members of the list, each joined to a summary of the parent offer. By default excludes rows where offer.active = false (matches the matcher's view); pass `include_inactive=true` to see all junction rows including those with deactivated parent offers.",
        "operationId": "fe907e92a170accd1d2aaa929d53eedb",
        "parameters": [
          {
            "name": "list_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "include_inactive",
            "in": "query",
            "description": "Include rows where offer.active = false. Default false.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated members.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/OfferListMember"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "List not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Offer List"
        ],
        "summary": "Offer List - Add Offer",
        "description": "Body: offer_id* (required), weight (1..100, default 10), position (nullable). If the offer's active flag is false, this call ALSO flips it back to true — \"re-adding to a list reinstates the offer\" per the ops workflow. Duplicate membership returns 409.",
        "operationId": "094157a4bca506edc5866c4dd1a51936",
        "parameters": [
          {
            "name": "list_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created member row.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/OfferListMember"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "List or offer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Offer already in this list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/offer-lists/{list_id}/offers/{offer_id}": {
      "delete": {
        "tags": [
          "Offer List"
        ],
        "summary": "Offer List - Remove Offer",
        "description": "Hard-deletes the junction row. The parent offer is untouched; other list memberships remain. Idempotent — deleting a non-existent row returns 200 with removed=false.",
