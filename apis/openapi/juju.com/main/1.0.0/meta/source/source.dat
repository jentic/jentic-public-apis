                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Offer List"
        ],
        "summary": "Offer List - Create",
        "description": "Body: name*, description, active (defaults true). Creates the empty bundle — add members via nested endpoints, or use POST /duplicate on an existing list to clone it.",
