      "get": {
        "tags": [
          "Offer Schedule"
        ],
        "summary": "Offer Schedule - List",
        "description": "All active windows for one offer, ordered by day_of_week then start_time. Unpaginated — typically 7-14 rows per offer.",
        "operationId": "c70dede3a59193bf2051110b223a85d4",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
