                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Offer Zipcode"
        ],
        "summary": "Offer Zipcode - Bulk Add",
        "description": "Body: {\"zipcode_ids\": [12345, 67890, ...]} — up to 10,000 per request. Ignored duplicates (ON CONFLICT DO NOTHING). Response reports how many were NEWLY added vs already-present.",
        "operationId": "da4a1125f1e7ccb0cfebceab1b6344c0",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
