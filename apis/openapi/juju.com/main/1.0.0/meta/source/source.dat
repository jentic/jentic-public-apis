    "/admin/v1/campaigns": {
      "get": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - List",
        "operationId": "6e689f52604f2f180a0acc1aa53ca779",
        "parameters": [
          {
            "name": "provider_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "paused",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "budget_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "daily",
                "monthly",
                "flight",
                "unlimited"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "date_created",
                "date_updated",
                "active",
                "paused",
                "budget",
                "default_cpc",
                "budget_type",
                "start_date",
                "end_date"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated campaign list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Campaign"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - Create",
        "description": "Required: job_provider_id, name, budget_type. Conditional: budget (required unless budget_type=unlimited); start_date + end_date (required when budget_type=flight, forbidden otherwise). API-level validation runs first so callers get clean error messages instead of raw DB constraint violations.",
        "operationId": "2a6b97bffc8cb4db68a954b8c8d2def4",
        "responses": {
          "201": {
            "description": "Created campaign (detail shape).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/Campaign"
                            },
                            {
                              "properties": {
                                "segments": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/Segment"
                                  }
                                },
                                "spend_to_date": {
                                  "description": "Money as string — cumulative spend from click_sponsor_daily_rollup, ~5min stale.",
                                  "type": "string",
                                  "example": "0.00"
                                }
                              },
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
