    "/admin/v1/segments/{segment_id}": {
      "delete": {
        "tags": [
          "Segment"
        ],
        "summary": "Segment - Deactivate",
        "description": "Sets active=false. Segments retain their row for audit continuity — historical clicks that matched a segment need the FK target to survive.",
        "operationId": "7c4fb2bc31007008770ecc34da4be26f",
        "parameters": [
          {
            "name": "segment_id",
            "in": "path",
