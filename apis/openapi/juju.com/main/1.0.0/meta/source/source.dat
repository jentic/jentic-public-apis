    "/admin/v1/providers/{id}/sample-job": {
      "get": {
        "tags": [
          "Provider"
        ],
        "summary": "Provider - Sample Job (Solr preview)",
        "description": "Pulls ONE currently-indexed job for this provider straight from Solr, for a live preview of what the provider's ingested jobs look like — the FULL document (description HTML, cpc, joburl, hashes, etc.), not the consumer-facing projection, since this is an operator tool. Also returns `total_indexed` so the operator sees how many jobs the provider has in the index.\n\n─── Which job ──────────────────────────────────────────────\nDefault: the most recently posted job (`date_posted desc, id asc`). Pass `solr_id` to preview one specific document, or `q` to preview the top job matching a keyword (full-text within this provider only). `solr_id` and `q` are mutually exclusive — `solr_id` wins if both are sent.\n\nReturns `job: null` (still 200) when the provider has nothing indexed yet, or when a supplied `solr_id` doesn't exist / belongs to a different provider.",
        "operationId": "77e5834b0032edec7795d69605d97faa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "solr_id",
            "in": "query",
            "description": "Preview this exact Solr document id (\"{provider}_{jobid}\"). Must belong to this provider.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Preview the top job matching this keyword (scoped to this provider). Ignored when solr_id is present.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The sampled job (or job=null when none matched). `job` is the raw Solr document minus Solr-internal fields (_version_, _root_, score).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "job": {
                              "description": "Full Solr document (all stored fields), or null when nothing matched.",
                              "type": "object",
                              "nullable": true,
                              "additionalProperties": true
                            },
                            "total_indexed": {
                              "description": "Count of documents this provider currently has in Solr.",
                              "type": "integer"
                            },
                            "query": {
                              "description": "The effective full-text query used (\"*:*\" for the default newest-job pull); null when solr_id targeting was used.",
                              "type": "string",
                              "nullable": true
                            },
                            "solr_id": {
                              "description": "Echo of the requested solr_id, when one was supplied.",
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Provider not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Solr query failed (index down / unreachable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
