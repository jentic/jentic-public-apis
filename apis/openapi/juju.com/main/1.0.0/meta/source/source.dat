              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Offer Zipcode"
        ],
        "summary": "Offer Zipcode - Clear All",
        "description": "Removes all zipcode restrictions for the offer. After this, the offer becomes \"all US eligible\" (no rows in offer_zipcode = no gate).",
        "operationId": "d263f22c23ea68ab803af8ee9cc41c80",
