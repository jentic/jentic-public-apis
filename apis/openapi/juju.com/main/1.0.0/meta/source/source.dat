    "/admin/v1/campaigns/{id}/segments": {
      "get": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - List Segments",
        "description": "Paginated. Realistic sets are small (a handful per campaign), but the meta block is included for shape consistency with every other list endpoint on this surface.",
        "operationId": "4551d9ad0da47d2306919281b3e9126c",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "date_created",
                "bid_low",
                "bid_high",
                "active"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated segment list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Segment"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - Create Segment",
        "description": "Body: name*, criteria* (JSONB), bid_low*, bid_high*, prefer_high_bid. CPA campaigns also accept conversion_rate_assumed, effective_cpc_override, observation_tuning_enabled; conversion_rate_working is seeded from the assumed rate. On a CPA campaign, bid_low/bid_high are denominated in CPA dollars.",
        "operationId": "a66b0c7e2a6465c5b49fa44c36ddab66",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created segment.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Segment"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/consent-documents": {
      "get": {
        "tags": [
          "Consent"
        ],
        "summary": "Consent - List",
        "description": "Paginated list of consent documents (newest first). Optional `consent_type` filter. body_html is omitted here (it can be large) — fetch a single document for the full body.",
        "operationId": "5184951937c5fcd4aee6f8856015a205",
        "parameters": [
          {
            "name": "consent_type",
            "in": "query",
            "description": "Filter to one type, e.g. terms_of_service.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "date_created",
                "consent_type",
                "version",
                "active"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list (body_html omitted).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ConsentDocument"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Consent"
        ],
        "summary": "Consent - Publish Version",
        "description": "Publishes a NEW consent-document version (the table is immutable; this is how you \"edit\"). When active=true (default), the prior active document of the same consent_type + offer_id is deactivated so exactly one stays live. body_html holds plain text or HTML. partners is an optional JSON snapshot of disclosed partners (TCPA).",
        "operationId": "95f269cf291c559af4e38fd8acc2d839",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "consent_type",
                  "version",
                  "body_html"
                ],
                "properties": {
                  "consent_type": {
                    "type": "string",
                    "example": "terms_of_service",
                    "maxLength": 32
                  },
                  "version": {
                    "type": "string",
                    "example": "2026-08-18",
                    "maxLength": 32
                  },
                  "body_html": {
                    "type": "string"
                  },
                  "offer_id": {
                    "description": "Only for offer-specific consents; null for site-level.",
                    "type": "integer",
                    "nullable": true
                  },
                  "sms_disclosure": {
                    "type": "string",
                    "nullable": true
                  },
                  "partners": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "nullable": true
                  },
                  "active": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New version published.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ConsentDocument"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/consent-documents/{id}": {
      "get": {
        "tags": [
          "Consent"
        ],
        "summary": "Consent - Display",
        "description": "Full document including body_html, partners snapshot, and sms_disclosure.",
        "operationId": "76832ef5f0afd1016f4408c92b9c76bd",
