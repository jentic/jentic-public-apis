                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/consent-documents/{id}/deactivate": {
      "post": {
        "tags": [
          "Consent"
        ],
        "summary": "Consent - Deactivate",
        "description": "Sets active=false on a consent document (e.g. retiring a type without publishing a replacement). Idempotent.",
        "operationId": "afa2c345fb989c29d1ddb40150a198c0",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivated document.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ConsentDocument"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Dashboard - Get",
        "description": "Aggregate for the admin landing screen. Single call — one HTTP request per dashboard render. Cached 60s. Blocks degrade individually on source failure (Solr down → jobs.indexed_total = 0; PG hiccup on one query → that block's counts drop to 0). Endpoint never 500s.",
        "operationId": "43d1f2bb6e777c83f0b89bfeeba0f112",
        "responses": {
          "200": {
            "description": "Dashboard payload.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "jobs": {
                              "properties": {
                                "indexed_total": {
                                  "type": "integer"
                                },
                                "providers_active": {
                                  "type": "integer"
                                },
                                "providers_paused": {
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "campaigns": {
                              "properties": {
                                "live": {
                                  "type": "integer"
                                },
                                "paused": {
                                  "type": "integer"
                                },
                                "budget_cache": {
                                  "type": "object"
                                }
                              },
                              "type": "object"
                            },
                            "clicks_today": {
                              "properties": {
                                "total": {
                                  "type": "integer"
                                },
                                "billable": {
                                  "type": "integer"
                                },
                                "bot": {
                                  "type": "integer"
                                },
                                "duplicate": {
                                  "type": "integer"
                                },
                                "spend": {
                                  "type": "string",
                                  "example": "4211.55"
                                }
                              },
                              "type": "object"
                            },
                            "leads_today": {
                              "properties": {
                                "submitted": {
                                  "type": "integer"
                                },
                                "delivered": {
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "feeds": {
                              "properties": {
                                "last_run_completed": {
                                  "type": "string",
                                  "format": "date-time",
                                  "nullable": true
                                },
                                "runs_active": {
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "notifications": {
                              "description": "Shared inbox summary for the login badge (~60s cached; the /notifications endpoint is real-time).",
                              "properties": {
                                "open_count": {
                                  "type": "integer"
                                },
                                "actionable_count": {
                                  "description": "open + acknowledged",
                                  "type": "integer"
                                },
                                "critical_count": {
                                  "type": "integer"
                                },
                                "recent": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/Notification"
                                  }
                                }
                              },
                              "type": "object"
                            }
                          },
                          "type": "object"
                        },
                        "meta": {
                          "properties": {
                            "generated_at": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/feed-runs": {
      "get": {
        "tags": [
          "Feed Run"
        ],
        "summary": "Feed Run - List",
        "description": "Paginated. Filters: provider_id, since (ISO date). Ordered by time_started DESC.",
