                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "required": [
                            "ok"
                          ],
                          "properties": {
                            "ok": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/publisher/v1/reports/clicks": {
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "Reports - Clicks",
        "description": "Daily click aggregates scoped to the logged-in publisher's org. Optional publisher_account_id narrows to one API-key account. Sourced from click_publisher_daily_rollup (refreshed every ~5 min). Group by date, account, publisher, provider. The money column is net (share-adjusted) `earnings` — what the publisher keeps; the unshared gross is deliberately NOT exposed here.",
        "operationId": "36b7b053f57174bb60e548020e20f589",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "publisher_account_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "Group-by dimensions (repeat or CSV). Allowed set is per report (see the reports changelog); default date. publisher_account_id accepts a single value or a CSV/repeat list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Date bucket: day|week|month (default day).",
            "schema": {
              "type": "string",
              "default": "day",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily rows, ordered by report_date DESC.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReportPublisherClicksDailyRow"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "from/to missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
