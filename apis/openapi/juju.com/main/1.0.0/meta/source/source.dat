                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/campaigns": {
      "get": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - List",
        "description": "Paginated list of campaigns owned by the logged-in sponsor. Scoped by resolve_scope() to the login's job_partner_id (+ optional sub-account job_provider_id filter for sub-account logins). Money as strings.",
        "operationId": "169a0a8e83c74546bbc94f762352d729",
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "paused",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated campaign list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Campaign"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/campaigns/{id}/pause": {
      "post": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - Pause",
        "description": "Pauses a campaign owned by the logged-in sponsor. Scope-checked — campaigns belonging to another org return 404 (not 403 — don't leak existence). Takes ~2 minutes to affect live search via the sponsor budget refresh cache.",
        "operationId": "27aafddae8a47c45d4e47841bd2c81fc",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paused.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Campaign"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Campaign not found or not owned by this sponsor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/campaigns/{id}/resume": {
      "post": {
        "tags": [
          "Campaign"
        ],
        "summary": "Campaign - Resume",
        "description": "Resumes a paused campaign owned by the logged-in sponsor. Scope-checked; same 2-minute cache propagation as pause.",
        "operationId": "f31ccc579120d2a4287589624ffde2e6",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumed.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Campaign"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Campaign not found or not owned by this sponsor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Sponsor module liveness probe",
        "description": "Unauthenticated. Returns ok=true if the sponsor module is loaded and the response pipeline is healthy. Wire into LB health checks. Does NOT exercise downstream dependencies.",
        "operationId": "8b7ef0e4a7860f835e2c2523e273f511",
        "responses": {
          "200": {
            "description": "Module is up.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "required": [
                            "ok"
                          ],
                          "properties": {
                            "ok": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/providers": {
      "get": {
        "tags": [
          "Provider"
        ],
        "summary": "Provider - List",
        "description": "Read-only list of providers under the logged-in sponsor's org. Sub-account logins see only their one assigned provider. Same row shape as the admin providers list minus internal fields (schema_mapping, credential presence booleans, latest_run — those are ops-facing).",
        "operationId": "d90bef4773cd94aeb69a1744c8848803",
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "paused",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated provider list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Provider"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/reports/clicks": {
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "Reports - Clicks",
        "description": "Daily click aggregates for the logged-in sponsor's own inventory, from the sponsor click rollup. Group by date, campaign, provider, segment. Always scoped to the sponsor's org (job_partner); sub-account logins (job_provider_id set on sponsor_login) are further scoped to that provider. Optional campaign_id narrows to one campaign. Does NOT expose publisher accounts or other sponsors' feeds — those dimensions do not exist on this report.",
        "operationId": "fe1dcfc64a05fd2e71079646e296d127",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "campaign_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "Group-by dimensions (repeat or CSV). Allowed set is per report (see the reports changelog); default date. campaign_id accepts a single value or a CSV/repeat list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Date bucket: day|week|month (default day).",
            "schema": {
              "type": "string",
              "default": "day",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily rows, ordered by report_date DESC.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReportSponsorClicksDailyRow"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "from/to missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sponsor/v1/reports/spend": {
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "Reports - Spend",
        "description": "Daily spend aggregates scoped to the logged-in sponsor's org. Same scoping rules as clicks. Money returned as string DECIMAL — see the money-as-strings convention on the admin surface. Group by date, campaign, provider, segment.",
        "operationId": "80b4f1d17753950350b6af1c4823208e",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "campaign_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "Group-by dimensions (repeat or CSV). Allowed set is per report (see the reports changelog); default date. campaign_id accepts a single value or a CSV/repeat list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Date bucket: day|week|month (default day).",
            "schema": {
              "type": "string",
              "default": "day",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily rows, ordered by report_date DESC.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReportSpendDailyRow"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "from/to missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compliance/contact": {
      "post": {
        "tags": [
          "Compliance"
        ],
        "summary": "Submit the contact form",
        "description": "Stores a contact-form submission. Public (no login). Returns `{status:\"received\"}` on success.",
        "operationId": "c20e4630bea130245dd23a0483217eab",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "first_name",
                  "last_name",
                  "email",
                  "message"
                ],
                "properties": {
                  "first_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "last_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "phone": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 32
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 5000
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compliance/privacy-request": {
      "post": {
        "tags": [
          "Compliance"
        ],
        "summary": "Submit a state privacy request",
        "description": "Records a privacy request (store-only, admin-reviewed; no automatic action). Public (no login). One endpoint for all five `request_type` values; `options` are validated against the type. `message` is required only when `request_type=privacy_rights`. Returns `{status:\"received\"}`.",
        "operationId": "890a91ddf38133738560c5e29441a515",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "request_type",
                  "first_name",
                  "last_name",
                  "email",
                  "phone",
                  "address1",
                  "city",
                  "state",
                  "zip",
                  "options"
                ],
                "properties": {
                  "request_type": {
                    "type": "string",
                    "enum": [
                      "do_not_sell_or_share",
                      "privacy_rights",
                      "opt_out_profiling",
                      "opt_out_targeted_advertising",
                      "limit_sensitive_information"
                    ]
                  },
                  "first_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "last_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "address1": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "address2": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "state": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "zip": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "options": {
                    "description": "Valid values depend on request_type; see the guide.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "message": {
                    "description": "Required only when request_type=privacy_rights.",
                    "type": "string",
                    "nullable": true,
                    "maxLength": 5000
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (missing field, bad request_type, or options invalid for the type).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compliance/unsubscribe": {
      "post": {
        "tags": [
          "Compliance"
        ],
        "summary": "Request opt-out of email and/or SMS",
        "description": "At least one of `email` / `phone`. If a valid `token` (from the email link) is present AND `email` is unchanged from the token's address, the marketing opt-out is processed immediately and `status` is `\"unsubscribed\"`. Otherwise it's recorded for admin review and `status` is `\"received\"`. Public (no login).",
        "operationId": "f80f00a8995c1b84dce545789ea0dc0f",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "At least one of email / phone. `token` is the opaque value from the email link.",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "phone": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 32
                  },
                  "token": {
                    "description": "From the email unsubscribe link; enables the verified auto-process.",
                    "type": "string",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{status:\"unsubscribed\"}` (verified) or `{status:\"received\"}` (queued for review).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Neither email nor phone supplied, or an invalid email.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compliance/unsubscribe/resolve": {
      "get": {
        "tags": [
          "Compliance"
        ],
        "summary": "Resolve an unsubscribe token to its email (to pre-fill the page)",
        "description": "Given the `token` from an email unsubscribe link, returns the address it was issued to so the page can pre-fill it. Returns `{email:null}` for a missing/invalid token (page shows a blank form). Public (no login).",
        "operationId": "0ae30012300127c8891bc832432a1abb",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{email: <address>|null}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compliance/unsubscribe/one-click": {
      "post": {
        "tags": [
          "Compliance"
        ],
        "summary": "RFC 8058 one-click unsubscribe",
        "description": "Target of the `List-Unsubscribe` header with `List-Unsubscribe-Post: List-Unsubscribe=One-Click`. A mail client POSTs here (no page, no body fields — `token` is in the query string) and the marketing opt-out is processed. PUBLIC + unauthenticated by design (mail providers cannot sign) — the token is the credential; rate-limited.",
        "operationId": "571f016d866370959fa5fca668ed68fd",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Opt-out processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lookups": {
      "get": {
        "tags": [
          "Site"
        ],
        "summary": "Consumer search taxonomy (filter values)",
        "description": "The value sets for the SPA's search filters — categories (live Solr facet with counts), work types (canonical list), and curated locations — so filter dropdowns render without a search round-trip. Heavily cached. Every `key` round-trips to the matching /jobs/search filter param. Solr failure degrades categories to an empty array; the endpoint never 500s.",
        "operationId": "94fddd69282b6edce69ad847363cf9b9",
        "responses": {
          "200": {
            "description": "Consumer taxonomy payload.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "job_groups": {
                              "description": "Canonical O*NET major-group taxonomy (preferred category filter). key = major_group_id.",
                              "type": "array",
                              "items": {
                                "properties": {
                                  "key": {
                                    "description": "major_group_id — pass back as the `major_group_id` search param.",
                                    "type": "integer"
                                  },
                                  "label": {
                                    "type": "string"
                                  },
                                  "job_count": {
                                    "type": "integer"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "categories": {
                              "description": "Legacy free-text provider categories (numeric ids filtered out). Prefer job_groups.",
                              "type": "array",
                              "items": {
                                "properties": {
                                  "key": {
                                    "description": "Pass back as the `category` search param.",
                                    "type": "string"
                                  },
                                  "label": {
                                    "type": "string"
                                  },
                                  "job_count": {
                                    "type": "integer"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "work_types": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "key": {
                                    "description": "Pass back as the `work_type` search param.",
                                    "type": "string"
                                  },
                                  "label": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "locations": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "label": {
                                    "type": "string"
                                  },
                                  "city": {
                                    "type": "string"
                                  },
                                  "state_code": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "education_levels": {
                              "description": "Signup dropdown. Pass `id` back as register education_level_id.",
                              "type": "array",
                              "items": {
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "label": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "future_education": {
                              "description": "Signup dropdown. Pass `id` back as register future_education_id.",
                              "type": "array",
                              "items": {
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "label": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              }
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/next": {
      "get": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Serve (matcher)",
        "description": "Runs the serving-layer OfferMatcher for the current context and returns the single offer it would serve (highest tier, weighted-random within tier, hourly-floor aware), plus a match_id correlation token to thread through the funnel (pass it to /submit). Pass offer_list_id to serve from a specific list; omit it (and publisher_id) for native / search traffic, which draws from every active list. Context is built from an optional consumer session (age + zipcode from profile, lockout gating) and optional query params. Returns offer=null when nothing is eligible (a normal outcome, still 200). Does not pre-ping or log an impression.",
        "operationId": "1a3e1e5cd33a268ca813e471aad1c3be",
        "parameters": [
          {
            "name": "offer_list_id",
            "in": "query",
            "description": "The offer list to serve from. Optional — omit to draw from every list eligible for the context. When set, only that (active) list is considered.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "publisher_id",
            "in": "query",
            "description": "Publisher context. When set, narrows eligible lists to that publisher's assigned lists. Optional (omit for native / search traffic).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sponsor_id",
            "in": "query",
            "description": "Adjacent job's sponsor. Reserved — not gated on today (future offer-level blocklist).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "zipcode_id",
            "in": "query",
            "description": "Overrides the profile zipcode for the zipcode-allowlist gate.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "age",
            "in": "query",
            "description": "Overrides the profile-derived age for age gating.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matched offer (or offer=null when none is eligible).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "offer": {
                              "oneOf": [
                                {
                                  "$ref": "#/components/schemas/OfferDisplay"
                                }
                              ],
                              "nullable": true
                            },
                            "match_id": {
                              "description": "Serve-correlation token; pass to /submit as match_id. Null when no offer.",
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{id}": {
      "get": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Display by id",
        "description": "Returns a single active offer's consumer-facing display fields by id — for a direct render when the caller already knows the offer (deep link, or a second render of a matched offer). No eligibility gating (schedule / zipcode / caps / lockout) is applied here, mirroring /jobs/{id}; the matcher endpoint is where eligibility is enforced. 404 if the offer is missing, inactive, or paused.",
        "operationId": "26efc78d34f0203aa2e8d61c084f5a93",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Offer display fields.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/OfferDisplay"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No active offer with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{offer_id}/submit": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Submit",
        "description": "Consumer submits their answers to an offer. Server validates disqualifying_answers, conditionally pre-pings the partner (when offer.requires_preping = true), and writes offer_conversion on success. Pass offer_click_id (from /click) to link the funnel; for single-action forms use /click-submit instead.",
        "operationId": "81ee499abfc7c888984035a74348c1d5",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "answers"
                ],
                "properties": {
                  "answers": {
                    "description": "Keyed by offer.questions[].key. Values are the user's selections. Any answer matching that question's disqualifying_answers array rejects the submission.",
                    "type": "object"
                  },
                  "source_solr_id": {
                    "description": "Optional — the solr_id of the job displayed in context when the offer was surfaced/clicked. Attribution only; never required.",
                    "type": "string",
                    "nullable": true
                  },
                  "match_id": {
                    "description": "Optional serve-correlation token (from /offers/next).",
                    "type": "string",
                    "nullable": true
                  },
                  "offer_click_id": {
                    "description": "Optional — the offer_click_id returned by /offers/{id}/click, linking this conversion back through click → impression.",
                    "type": "integer",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversion accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "offer_conversion_id": {
                              "type": "integer"
                            },
                            "status": {
                              "type": "string",
                              "example": "accepted"
                            },
                            "offer_preping_id": {
                              "description": "Present when pre-ping fired.",
                              "type": "integer",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Offer not found or not currently servable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Consumer already converted on this offer within the lockout window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Disqualifying answer, pre-ping decline, or unavailable partner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{offer_id}/click-submit": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Click + Submit",
        "description": "One call for single-action offer forms: records the offer_click and then runs the full submission (disqualify check, conditional pre-ping, offer_conversion) against that click. The click persists even if the submission is disqualified or pre-ping-rejected (it is a real funnel event). Pass offer_impression_id to chain from an earlier impression. Same session + gating semantics as /submit; the response additionally returns offer_click_id.",
        "operationId": "7b65083df445ef955d679de64093b61b",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "answers"
                ],
                "properties": {
                  "answers": {
                    "description": "Keyed by offer.questions[].key. Disqualifying answers reject the submission.",
                    "type": "object"
                  },
                  "offer_impression_id": {
                    "description": "The impression that led to this click (from /impression).",
                    "type": "integer",
                    "nullable": true
                  },
                  "source_solr_id": {
                    "description": "Optional — solr_id of the job displayed in context. Attribution only.",
                    "type": "string",
                    "nullable": true
                  },
                  "match_id": {
                    "description": "Optional serve-correlation token (from /offers/next).",
                    "type": "string",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Click recorded and conversion accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "offer_conversion_id": {
                              "type": "integer"
                            },
                            "offer_click_id": {
                              "description": "The click recorded for this action (null if the click write failed).",
                              "type": "integer",
                              "nullable": true
                            },
                            "status": {
                              "type": "string",
                              "example": "accepted"
                            },
                            "offer_preping_id": {
                              "type": "integer",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Offer not found or not currently servable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Consumer already converted on this offer within the lockout window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Disqualifying answer, pre-ping decline, or unavailable partner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{offer_id}/click-through": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Click-through (redirect offer)",
        "description": "For REDIRECT offers (action_type=redirect): records the click, opens a PENDING conversion, builds the vendor tracking URL from the offer's redirect_template (substituting {click_id}=the new conversion id, {keyword}, {source}, and profile tokens from `lead`), and returns it as `redirect_url` for the SPA to open in a new tab. No answers, no disqualify check, no server-side delivery — the vendor confirms the conversion later via their postback (POST /api/v1/offers/postback/{partner}), which flips the row to delivered and records the reported revenue. Same session + lockout semantics as /submit. The exact substituted URL is retained on the lead snapshot as the \"what we posted\" audit record, then time-scrubbed per offer.outbound_url_retention_days.",
        "operationId": "fe227b5b5d715ba2695e5b0beeb1223d",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "keyword": {
                    "description": "User's job-search keyword → sub2 in the outbound URL.",
                    "type": "string",
                    "nullable": true
                  },
                  "source": {
                    "description": "Traffic-source / page id → sub1. Optional; blank is fine.",
                    "type": "string",
                    "nullable": true
                  },
                  "lead": {
                    "description": "Profile fields for URL prefill (first_name, last_name, email, phone, zip, city, state, address, gender, dob). Also snapshotted for compliance.",
                    "type": "object",
                    "nullable": true
                  },
                  "offer_impression_id": {
                    "description": "The impression that led to this click.",
                    "type": "integer",
                    "nullable": true
                  },
                  "source_solr_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "match_id": {
                    "type": "string",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Click recorded, pending conversion opened, redirect URL returned.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "redirect_url": {
                              "description": "Open in a new tab (offer action.target=_blank).",
                              "type": "string"
                            },
                            "offer_conversion_id": {
                              "type": "integer"
                            },
                            "offer_click_id": {
                              "type": "integer",
                              "nullable": true
                            },
                            "status": {
                              "type": "string",
                              "example": "accepted"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Offer not found or not currently servable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Consumer already responded within the lockout window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Offer is not a redirect offer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Redirect offer is misconfigured (no redirect_template).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{offer_id}/impression": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Record Impression",
        "description": "Called by the SPA when an offer clears its viewport / render threshold. Records one offer.offer_impression row and returns its id so the SPA can thread it into the subsequent click call. HMAC-only + session-optional; best-effort (always 200 unless the body is malformed).",
        "operationId": "2ad9f3b6dfe5b13c55f7e332ac80e6f7",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "display_context"
                ],
                "properties": {
                  "display_context": {
                    "description": "Where/how the offer rendered. Unknown values coerce to \"other\".",
                    "type": "string",
                    "enum": [
                      "modal_solo",
                      "modal_list",
                      "sidebar",
                      "inline_list",
                      "banner",
                      "interstitial",
                      "footer",
                      "other"
                    ]
                  },
                  "page_url": {
                    "description": "URL the offer appeared on. May carry search terms — treated as PII-adjacent.",
                    "type": "string",
                    "nullable": true
                  },
                  "position": {
                    "description": "Position within the container (1..N).",
                    "type": "integer",
                    "nullable": true
                  },
                  "offer_preping_id": {
                    "description": "Set only if a display-time pre-ping already ran for this render.",
                    "type": "integer",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Impression recorded (or silently skipped).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "type": "boolean"
                            },
                            "offer_impression_id": {
                              "description": "Pass to the click call to link the funnel.",
                              "type": "integer",
                              "format": "int64",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "display_context missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/offers/{offer_id}/click": {
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Record Click",
        "description": "Called by the SPA when the user interacts with an offer's CTA. Records one offer.offer_click row and returns its id for threading into /submit. HMAC-only + session-optional; best-effort (always 200 unless the body is malformed).",
        "operationId": "59e2460bfbf74a4a8acd90e7ed8ef57a",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "offer_impression_id": {
                    "description": "The impression that led to this click (from the impression call).",
                    "type": "integer",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Click recorded (or silently skipped).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "type": "boolean"
                            },
                            "offer_click_id": {
                              "description": "Pass to /submit as offer_click_id to link the funnel.",
                              "type": "integer",
                              "format": "int64",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/site/home": {
      "get": {
        "tags": [
          "Site"
        ],
        "summary": "Homepage aggregate — stats, facets, curated content",
        "description": "Single call that populates every content block on the consumer homepage. Heavily cached (default 15 min) so a homepage SSR render is one request. Blocks: stats (Solr document count + marketing values), popular_searches (curated), trending_searches (curated fallback), categories (top N Solr facet on `category`), top_companies (curated pending Solr schema addition), locations (curated). Solr failures degrade to zero counts / curated fallbacks — endpoint never 500s.",
        "operationId": "a1d434409a9d9e112ba6924f6b9cfe00",
        "responses": {
          "200": {
            "description": "Homepage aggregate payload.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "stats": {
                              "properties": {
                                "total_jobs": {
                                  "type": "integer",
                                  "example": 2241847
                                },
                                "jobs_updated_today": {
                                  "type": "integer",
                                  "example": 2241847
                                },
                                "partner_sites": {
                                  "type": "integer",
                                  "example": 50000
                                },
                                "update_interval_minutes": {
                                  "type": "integer",
                                  "example": 15
                                }
                              },
                              "type": "object"
                            },
                            "popular_searches": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "trending_searches": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "job_groups": {
                              "description": "Canonical O*NET major-group taxonomy (preferred category filter). key = major_group_id.",
                              "type": "array",
                              "items": {
                                "properties": {
                                  "key": {
                                    "description": "major_group_id — pass back as the `major_group_id` search param.",
                                    "type": "integer"
                                  },
                                  "label": {
                                    "type": "string"
                                  },
                                  "job_count": {
                                    "type": "integer"
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "top_companies": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "job_count": {
                                    "description": "Null on curated rows; a real count once the Solr `company_str` field lands.",
                                    "type": "integer",
                                    "nullable": true
                                  },
                                  "logo": {
                                    "type": "string",
                                    "nullable": true
                                  }
                                },
                                "type": "object"
                              }
                            },
                            "locations": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "label": {
                                    "type": "string"
                                  },
                                  "city": {
                                    "type": "string"
                                  },
                                  "state_code": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              }
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/site/landing": {
      "get": {
        "tags": [
          "Site"
        ],
        "summary": "SEO landing aggregate for a category/location slice",
        "description": "Aggregate for a browse/SEO landing page — \"N jobs in {slice}\" plus a teaser list and related-refinement links. Accepts the same filter params as /jobs/search (q, category, jobgroup, work_type, city, state, postal, country, remote) and returns the count, a small sample of Job cards (link them to /jobs/{id} — the full apply flow lives on the detail page), and related category/location/work-type facets for internal linking. Inventory matches /jobs/search exactly (same live-budget gate). Short-cached; the FE owns the pretty-URL → param mapping.",
        "operationId": "6a0cc340cb3c1c6208965c5935c82822",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobgroup",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "work_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "postal",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Landing aggregate. Never 500s from Solr issues — degrades to zero-count.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "filters": {
                              "description": "Echoed resolved filters (only the params that were provided).",
                              "type": "object"
                            },
                            "total_jobs": {
                              "type": "integer",
                              "example": 1234
                            },
                            "sample_jobs": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Job"
                              }
                            },
                            "related": {
                              "properties": {
                                "categories": {
                                  "type": "array",
                                  "items": {
                                    "properties": {
                                      "key": {
                                        "type": "string"
                                      },
                                      "label": {
                                        "type": "string"
                                      },
                                      "job_count": {
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "locations": {
                                  "type": "array",
                                  "items": {
                                    "properties": {
                                      "key": {
                                        "type": "string"
                                      },
                                      "label": {
                                        "type": "string"
                                      },
                                      "job_count": {
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "work_types": {
                                  "type": "array",
                                  "items": {
                                    "properties": {
                                      "key": {
                                        "type": "string"
                                      },
                                      "label": {
                                        "type": "string"
                                      },
                                      "job_count": {
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                }
                              },
                              "type": "object"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracking/session": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "summary": "Tracking - Start Session",
        "description": "Called by the SPA on FIRST page load per visit. Records a site_session row with landing + attribution + parsed device + geo, upserts the site_visitor row by cookie token, and sets two httpOnly cookies on the response so subsequent /page-view calls work without the SPA managing tokens explicitly.\n\nIdempotent-ish: a repeat call within the same visit generates a NEW site_session (that's the definition of \"new visit\"), reusing the visitor cookie if present.\n\n─── Cookies set on response ────────────────────────────\n  juju_tracking_visitor  httpOnly, 1-year, SameSite=Lax\n  juju_tracking_session  httpOnly, session, SameSite=Lax\n\n─── Failure semantics ──────────────────────────────────\nAlways 200 unless the request itself is unparseable. Tracking is best-effort; page rendering must never be gated on this endpoint.",
        "operationId": "69a66a142c15d60dff1ff949c54054d0",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "landing_path": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "landing_query": {
                    "type": "string",
                    "nullable": true
                  },
                  "referrer": {
                    "type": "string",
                    "nullable": true
                  },
                  "utm_source": {
                    "type": "string",
                    "nullable": true
                  },
                  "utm_medium": {
                    "type": "string",
                    "nullable": true
                  },
                  "utm_campaign": {
                    "type": "string",
                    "nullable": true
                  },
                  "utm_term": {
                    "type": "string",
                    "nullable": true
                  },
                  "utm_content": {
                    "type": "string",
                    "nullable": true
                  },
                  "gclid": {
                    "description": "Google Ads click id",
                    "type": "string",
                    "nullable": true
                  },
                  "fbclid": {
                    "description": "Meta click id",
                    "type": "string",
                    "nullable": true
                  },
                  "msclkid": {
                    "description": "Microsoft Ads click id",
                    "type": "string",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session recorded (or silently skipped). Cookies set on response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "description": "False on DB failure; SPA should proceed regardless.",
                              "type": "boolean"
                            },
                            "is_new_visitor": {
                              "type": "boolean"
                            },
                            "is_bot": {
                              "description": "The recorded UA classified as a bot. Advisory only.",
                              "type": "boolean"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracking/page-view": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "summary": "Tracking - Record Page View",
        "description": "Called by the SPA on EVERY navigation. Reads session_token from the juju_tracking_session cookie set by /tracking/session, writes one juju.page_tracking row, increments the session's page_count.\n\n─── prev_duration_ms — the exit-beacon substitute ─────────\nWhen the SPA records page N+1 it reports how long the user spent on page N via prev_duration_ms. That avoids the beforeunload beacon (unreliable, doubles the request volume). The last page of each session is unmeasured — acceptable.\n\n─── page_type + entity_id ─────────────────────────────────\npage_type is a stable enum-ish string the SPA sends explicitly (home|search|job_detail|register|offer|saved-jobs|profile|...). entity_id is what the page is ABOUT (solr_id for a job page, category slug for a category page, offer_id for an offer). Together they make funnel + engagement queries trivial without regex-parsing url_path.\n\nBots: the endpoint silently 200-with-recorded=false when the session is bot-flagged and tracking.store_bot_page_views is false (default). No 4xx — bots would fill the SPA console with errors we don't want.",
        "operationId": "e57b531244078018761828da9eec267a",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "url_path"
                ],
                "properties": {
                  "url_path": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "query_string": {
                    "type": "string",
                    "nullable": true
                  },
                  "page_type": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 32
                  },
                  "entity_id": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "prev_duration_ms": {
                    "description": "Milliseconds spent on the PREVIOUS page. Omitted on the first page of a session.",
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Page view recorded, or silently skipped (bot session / missing session cookie / DB failure). SPA MUST proceed regardless.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "type": "boolean"
                            },
                            "sequence": {
                              "description": "Which page-in-session this write occupied (1 = first).",
                              "type": "integer",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "url_path missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracking/impression": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "summary": "Tracking - Record Impression",
        "description": "Called by the SPA when a job card CLEARS THE VIEWPORT THRESHOLD (IAB standard: 50% pixels visible for ≥1s). Distinct from /tracking/page-view — one impression per JOB seen on a page.\n\n─── The click_token is the identifier ────────────────────\nSend the exact token from the job's `click_url` field (the string after `/jobs/click/`). The server decodes it to recover solr_id, publisher_account_id, and served_id in one step — the SPA does not need to plumb those separately.\n\n─── Response ─────────────────────────────────────────────\nReturns `impression_id` when the row was written. Attach it as `?imp={impression_id}` on the click_url when rendering the <a href>, e.g.:\n\n  `<a href=\"{click_url}?imp={impression_id}\">Apply</a>`\n\nA click that lands on the server WITH the ?imp parameter will attribute back to this specific impression row, closing the served → impression → click chain.\n\n─── Failure semantics ────────────────────────────────────\nAlways 200 unless the request body is malformed. `recorded: false` means the token was bad, referred to a served row we no longer have, or the write failed — SPA should proceed with an un-attributed click URL. Never gate rendering on this endpoint.",
        "operationId": "06f7761fd2e0961d140233459535ab58",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "click_token"
                ],
                "properties": {
                  "click_token": {
                    "description": "The opaque token from the job's `click_url`.",
                    "type": "string"
                  },
                  "viewport_duration_ms": {
                    "description": "How long the card was in the viewport before this call. Optional.",
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Impression recorded (or silently skipped on bad token / missing served row / DB failure).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "type": "boolean"
                            },
                            "impression_id": {
                              "description": "Attach as `?imp=` on the click URL to close the attribution chain.",
                              "type": "integer",
                              "format": "int64",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "click_token missing or empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracking/list-impression": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "summary": "Tracking - Record List Impression",
        "description": "Called by the SPA when job TITLE(S) in the scrollable results list clear the viewport — the left-rail list, NOT the expanded full job display. Distinct from /tracking/impression (which is the full display, one job with all fields + the apply button). Keeping the two surfaces in separate tables makes the funnel legible: served → list-seen → full-viewed → clicked.\n\n─── Batch shape ──────────────────────────────────────────\nA list scroll surfaces many titles, so this endpoint is batch-first: send `click_tokens` — an array of the exact tokens from each list item's `click_url` (the string after `/jobs/click/`). A single `click_token` is also accepted. Duplicate tokens within one call are collapsed (a title scrolling in/out shouldn't double-count); at most 100 tokens are processed per call (excess dropped). Fire once per title per search to keep the list-seen ratio meaningful.\n\n─── Failure semantics ────────────────────────────────────\nAlways 200 unless the body carries no usable token. `recorded` is how many rows were written (tokens that were bad, referred to a served row we no longer have, or failed to write are simply not counted). Never gate rendering on this endpoint.",
        "operationId": "297a3e8753fdb14729c66be957b8bb93",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "click_tokens": {
                    "description": "Preferred. The click_url tokens of the list items that cleared the viewport.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "click_token": {
                    "description": "Single-item convenience form; use click_tokens for a list.",
                    "type": "string",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List impressions recorded (or silently skipped per token).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "recorded": {
                              "description": "How many list_impression rows were written.",
                              "type": "integer"
                            },
                            "total": {
                              "description": "How many distinct tokens were processed (after de-dupe + cap).",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "No usable click_tokens / click_token in the body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/register": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Create a new consumer account (passwordless)",
        "description": "Passwordless signup. Accepts email (required) + optional name / phone plus the signup-form fields (education_level_id, future_education_id, gig_work_interest) and a REQUIRED terms_of_service consent. No password is collected: the account is created without one, the caller is logged in immediately (session cookie set on the response), and a magic-link \"set your password\" token is issued. Email delivery of that link is pending SES; until then the token is logged and — outside production only — returned as set_password_token so the flow is testable. Email + phone resolve to shared identity-artifact rows; phone is E.164-normalized. Terms consent is recorded (append-only) against the active terms_of_service document with the request IP hash + user agent. An optional trusted_form_url (TrustedForm consent certificate captured on the signup page) is stored as a consent_certificate row and linked to that consent event.",
        "operationId": "e4c3efd1916ed8d6356cf8e9a9fdfe4d",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "email",
                  "terms_consented"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jed@example.com",
                    "maxLength": 255
                  },
                  "first_name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "last_name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "phone": {
                    "description": "Any format; server normalizes to E.164.",
                    "type": "string",
                    "nullable": true,
                    "maxLength": 30
                  },
                  "education_level_id": {
                    "description": "FK to juju.education_level (options via GET /lookups).",
                    "type": "integer",
                    "nullable": true
                  },
                  "future_education_id": {
                    "description": "FK to juju.future_education (options via GET /lookups).",
                    "type": "integer",
                    "nullable": true
                  },
                  "gig_work_interest": {
                    "type": "boolean",
                    "nullable": true
                  },
                  "trusted_form_url": {
                    "description": "TrustedForm consent-certificate URL captured on the signup page. Stored against the user (juju.consent_certificate) as proof of TCPA consent and linked to the terms consent event.",
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "terms_consented": {
                    "description": "Must be true — the user accepted the Terms of Service.",
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and logged in. Session cookie set on the response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64",
                              "example": 1234
                            },
                            "email": {
                              "type": "string",
                              "format": "email",
                              "example": "jed@example.com"
                            },
                            "logged_in": {
                              "type": "boolean",
                              "example": true
                            },
                            "verification_sent": {
                              "description": "False until email infrastructure (SES) lands.",
                              "type": "boolean",
                              "example": false
                            },
                            "set_password_token": {
                              "description": "DEV ONLY (non-production): the magic-link token, so the set-password flow is testable before SES. Never present in production.",
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "An active account with this email already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure: email malformed, phone unparseable, unknown lookup id, or terms not accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/set-password": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Set a password via magic-link token",
        "description": "Consumes a single-use set_password token (from the magic-link email issued at signup) and sets the account password. On success the session cookie is set, so the browser that opened the link is logged in. The token is single-use and expiring; a used / expired / unknown token 400s. Because the token was delivered by email, a successful consume also marks the email verified (stamps juju.email.date_verified).",
        "operationId": "0cc2f8436daf93948344fd503216b9d9",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "description": "The set_password token from the magic link.",
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple",
                    "minLength": 12
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password set; session cookie issued.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "logged_in": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Token invalid, expired, or already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Password too short / missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/reset-password": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Set a new password via a password-reset token",
        "description": "Consumes a single-use password_reset token (from the reset email) and sets a new account password. On success the session cookie is issued, logging the browser in. Single-use + expiring; a used / expired / unknown token 400s. Identical mechanics to set-password; the two differ only in which token purpose they accept. Because the token was delivered by email, a successful consume also marks the email verified (stamps juju.email.date_verified).",
        "operationId": "4eb43880a7a2cc08e14508ae4c0bc9e9",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "description": "The password_reset token from the reset link.",
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple",
                    "minLength": 12
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password set; session cookie issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Token invalid, expired, or already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Password too short / missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/request-password-reset": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Request a password-reset email",
        "description": "Issues a single-use password_reset token and emails the reset link (queued via mail_queue). ALWAYS returns 200 with the same generic message whether or not an account exists for the address — this is deliberate, to prevent account enumeration.",
        "operationId": "8380ceb67016b802d922429ff9fdd1b3",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jed@example.com"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic acknowledgement (sent if the account exists).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Email missing / malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/send-verification": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Send (or resend) the email-verification link",
        "description": "For the authenticated consumer, issues a single-use email_verify token and queues the verification email to their address. No-op (still 200) if the email is already verified. Requires the session cookie.",
        "operationId": "5f07ae1aac95887e55f03fc1d48c650c",
        "responses": {
          "200": {
            "description": "Verification email queued (or already verified).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/verify-email": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Verify an email address via token",
        "description": "Consumes a single-use email_verify token and stamps date_verified on the email artifact (juju.email). Session-less — the token is the proof. A used / expired / unknown token 400s.",
        "operationId": "b95d8ea17e8f1e050a5e7b78a877ebf0",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "description": "The email_verify token from the link.",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Token invalid, expired, or already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/terms": {
      "get": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Fetch the active Terms of Service document",
        "description": "Returns the current active terms_of_service consent document so the SPA can render it before the signup consent checkbox. Anonymous — no session required. body_html holds the disclosure as stored (plain text or HTML). 404 if no active terms document is published.",
        "operationId": "484fd2d486c750c14485061b4c11e648",
        "responses": {
          "200": {
            "description": "Active terms document.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "consent_document_id": {
                              "type": "integer"
                            },
                            "consent_type": {
                              "type": "string",
                              "example": "terms_of_service"
                            },
                            "version": {
                              "type": "string",
                              "example": "1.0-placeholder"
                            },
                            "body_html": {
                              "type": "string"
                            },
                            "date_created": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No active terms document published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/login": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Authenticate and issue a session cookie",
        "description": "Accepts email + password. On success, mints a session JWT and sets it as an httpOnly + SameSite=Lax cookie. Returns the user profile. Login does NOT require verified email (soft-lock). Suppressed emails (hard-bounced / complained / manually blocked) are rejected with the same generic 401 as wrong credentials — no enumeration signal. Failures use a generic \"Invalid credentials\" message regardless of whether the email exists or the password was wrong.",
        "operationId": "46771a5de53ffbb58403e859b03a80e5",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jed@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "correct-horse-battery-staple"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded. Session cookie set on the response.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "date_verified": {
                              "description": "Null = email not yet verified. Lives on the email artifact, not the user.",
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            },
                            "mfa_method": {
                              "type": "string",
                              "nullable": true,
                              "enum": [
                                "totp",
                                "email"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials. Same response for \"email not found\", \"wrong password\", and \"suppressed email\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/auth/logout": {
      "post": {
        "tags": [
          "Users",
          "Auth"
        ],
        "summary": "Clear the consumer session cookie",
        "description": "Sets the session cookie to empty with immediate expiry. No DB write — stateless JWTs don't have a server-side \"session row\" to destroy. Always returns 200 — idempotent.",
        "operationId": "2e04efae9c823f6de35715f375e53f57",
        "responses": {
          "200": {
            "description": "Cookie cleared (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "logged_out": {
                              "type": "boolean",
                              "example": true
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/profile": {
      "get": {
        "tags": [
          "Users",
          "Profile"
        ],
        "summary": "Fetch the logged-in consumer's profile",
        "description": "Returns the profile fields for the consumer identified by the session cookie. Joins juju.email + juju.phone for display fields. Omits sensitive fields (password_hash, MFA secrets). user_id comes from the session, NOT the URL, so a consumer can never read another consumer's profile via this endpoint.",
        "operationId": "7d719057beb6aa581e69fd2dec672101",
        "responses": {
          "200": {
            "description": "Current profile.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "first_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "last_name": {
                              "type": "string",
                              "nullable": true
                            },
                            "phone": {
                              "description": "E.164-normalized.",
                              "type": "string",
                              "nullable": true
                            },
                            "country": {
                              "description": "ISO 3166-1 alpha-2.",
                              "type": "string",
                              "nullable": true
                            },
                            "date_created": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "date_verified": {
                              "description": "When the email artifact was verified — lives on juju.email, not the user.",
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            },
                            "date_last_login": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true
                            },
                            "mfa_method": {
                              "type": "string",
                              "nullable": true,
                              "enum": [
                                "totp",
                                "email"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie, OR the session's user_id no longer corresponds to an active account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users",
          "Profile"
        ],
        "summary": "Update mutable profile fields",
        "description": "Accepts first_name, last_name, phone, country. Email changes go through a separate verification flow. Password and MFA settings go through dedicated flows. Phone is E.164-normalized via libphonenumber and resolves to a juju.phone artifact row (reusing the existing one if the number already exists). Unknown fields in the request body are silently ignored. Empty PATCH body returns the current profile unchanged.",
        "operationId": "60393c2d6f577709776dff6349844400",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "first_name": {
                    "description": "Set to null or empty string to clear.",
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "last_name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "phone": {
                    "description": "Any format; server normalizes to E.164. Null clears.",
                    "type": "string",
                    "nullable": true,
                    "maxLength": 30
                  },
                  "country": {
                    "description": "ISO 3166-1 alpha-2 ('US', 'CA', 'GB'). Null clears.",
                    "type": "string",
                    "nullable": true,
                    "maxLength": 2
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile (or unchanged profile if PATCH had no mutable fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure (e.g., unparseable phone, country not 2 chars).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-jobs": {
      "get": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "List the logged-in consumer's saved jobs",
        "description": "Paginated. Each item includes the cached display fields (title, company, city/state/postal/country) captured at save time plus user state (date_saved, date_applied, notes). The `active` field flags whether the underlying job is still live in Solr — currently always `null` (Solr merge is future work); the SPA can render an \"expired\" badge once `active === false` starts appearing.",
        "operationId": "d373d5f7a7a6acd168c4a6b24950a52e",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated saved-job list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "Save a job to the user's watchlist",
        "description": "Body `{solr_id, job_title?, job_company?, job_city?, job_state?, job_postal?, job_country?, notes?}`. Idempotent on `(user_id, solr_id)` — re-saving the same job returns 200 with the existing row (not 409). Display fields are optional but STRONGLY encouraged — they're what the list surfaces after the job expires from Solr.",
        "operationId": "646bb7bcb5b9457fa52e83ca26fa5066",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "solr_id"
                ],
                "properties": {
                  "solr_id": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "job_title": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "job_company": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "job_city": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "job_state": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "job_postal": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 20
                  },
                  "job_country": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 50
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 5000
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Newly saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "200": {
            "description": "Already saved; existing row returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-jobs/ids": {
      "get": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "Unpaginated list of the user's saved (saved_job_id, solr_id) pairs",
        "description": "Cheap two-column query used by the SPA to render bookmark-toggle state on search results without fetching the full paginated list. Capped at 1000 items (well above any realistic saved-list size); if a caller hits the cap they get the 1000 most-recent — practical edge case, not a hard limit on the underlying data.",
        "operationId": "f2e7b32c3e63019a5bcf745031d50e51",
        "responses": {
          "200": {
            "description": "Array of {saved_job_id, solr_id}.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-jobs/{saved_job_id}": {
      "delete": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "Remove a saved job",
        "description": "Idempotent — returns 200 whether the row existed or not. Ownership enforced by user_id scoping; a saved_job_id owned by another user is treated as \"already deleted\" (silent 200).",
        "operationId": "665361706cfa92a174f09a67772b6ec8",
        "parameters": [
          {
            "name": "saved_job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "Update notes and/or applied-at on a saved job",
        "description": "Body accepts `notes` (string or null) and/or `date_applied` (ISO-8601 timestamp or null). \"Mark as applied\" = set date_applied to the current timestamp; \"unmark\" = set to null. Empty PATCH is a no-op that returns the current row. Ownership enforced by user_id scoping — attempting to PATCH another user's row returns 404.",
        "operationId": "73fa094963e100aaa0691b4144d48463",
        "parameters": [
          {
            "name": "saved_job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "notes": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 5000
                  },
                  "date_applied": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Saved job not found or not owned by caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-jobs/export": {
      "get": {
        "tags": [
          "Users",
          "SavedJobs"
        ],
        "summary": "Export the user's saved jobs as CSV",
        "description": "Returns text/csv (NOT the JSON envelope) so the browser downloads it as a file. All saved jobs, all fields — useful for users who need historical records before the retention purge (3y unapplied / 7y applied) removes them. Streams via setBody(); large lists still fit in one response since each user is naturally bounded.",
        "operationId": "46c0a13124e2c6a46e611cbd7d8217b8",
        "responses": {
          "200": {
            "description": "CSV download.",
            "content": {
              "text/csv": {}
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-searches": {
      "get": {
        "tags": [
          "Users",
          "SavedSearches"
        ],
        "summary": "List the user's saved searches",
        "description": "Paginated. Each row includes the notifications sub-array. By default returns active + paused (snoozed) searches; the SPA can filter client-side.",
        "operationId": "9f33d92c8548b48e53785928695a6ae7",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated saved-search list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users",
          "SavedSearches"
        ],
        "summary": "Create a new saved search",
        "description": "Body: label (required), query_text, filters_json, notifications (optional array of {channel, frequency, enabled}). Enforces a cap of 25 active saved searches per user — over-cap returns 422.",
        "operationId": "66828f26941cac67806a32a777898ee6",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "query_text": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "filters_json": {
                    "type": "object",
                    "nullable": true
                  },
                  "notifications": {
                    "type": "array",
                    "items": {
                      "properties": {
                        "channel": {
                          "type": "string",
                          "maxLength": 50
                        },
                        "frequency": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created saved-search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure or cap reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-searches/{saved_search_id}": {
      "delete": {
        "tags": [
          "Users",
          "SavedSearches"
        ],
        "summary": "Hard-delete a saved search (and its notifications)",
        "description": "Hard delete — the schema's CASCADE FK removes all notification rows automatically. If you want to keep the search but stop it from firing, PATCH `active: false` instead (snooze).",
        "operationId": "3c026fdae78008959ec375762ca6ca92",
        "parameters": [
          {
            "name": "saved_search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users",
          "SavedSearches"
        ],
        "summary": "Update a saved search",
        "description": "Mutable: label, query_text, filters_json, active (snooze toggle). If `notifications` is present in the body, it REPLACES the entire notification set (delete existing, insert new). To keep an existing notification unchanged, echo it back in the array.",
        "operationId": "e961fafd2075fcf1d01f827f9e10c99c",
        "parameters": [
          {
            "name": "saved_search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "label": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 100
                  },
                  "query_text": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "filters_json": {
                    "type": "object",
                    "nullable": true
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "notifications": {
                    "description": "Full replacement set — each item is a notification-preference row {channel, enabled, throttle_minutes, ...}. Shape validated at the controller layer; kept as a free object here so the FE can evolve the preference model without a spec change.",
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated saved-search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Saved search not found or not owned by caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/saved-searches/{saved_search_id}/run": {
      "post": {
        "tags": [
          "Users",
          "SavedSearches"
        ],
        "summary": "Re-execute a saved search and return results",
        "description": "Runs the stored query + filters through the same PostingStore pipeline as /api/v1/jobs/search — honoring the campaign_live_providers + campaign_fq_clause cache guards, so /run only surfaces billable inventory (identical semantics to a fresh search). Updates last_result_count on the saved search. Returns the same shape as /jobs/search.",
        "operationId": "4a2f1e68c143f134a7d114425986bcc8",
        "parameters": [
          {
            "name": "saved_search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results (same shape as /jobs/search).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Saved search not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Search temporarily unavailable (Solr).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/search-history": {
      "get": {
        "tags": [
          "Users",
          "SearchHistory"
        ],
        "summary": "List the logged-in consumer's recent searches",
        "description": "Paginated, newest first. Rows outside the 90-day rolling retention window may be missing (the purge command drops them nightly). Each row includes the query text, filters JSON, and the result count at search time.",
        "operationId": "0f9d15576c0b48d0ca451de5c0c267f2",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated history list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users",
          "SearchHistory"
        ],
        "summary": "Hard-clear the user's entire search history",
        "description": "Immediate hard delete — no soft flag, no retention grace. Privacy-sensitive by design: the user asked for their history to go away, so it goes away. Idempotent — a repeat call on an already-empty history still returns 200.",
        "operationId": "3300e99421bd489689583c62f27b868a",
        "responses": {
          "200": {
            "description": "Cleared (idempotent).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminUser": {
        "title": "Admin User",
        "description": "Internal staff login. Distinct from juju.user (consumer) and sponsor_login / publisher_login (portal humans).",
        "required": [
          "user_id",
          "username",
          "email",
          "role",
          "active"
        ],
        "properties": {
          "user_id": {
            "description": "admin.admin_user.admin_user_id renamed to user_id on the wire.",
            "type": "integer"
          },
          "username": {
            "description": "Immutable after creation — audit-log continuity.",
            "type": "string"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "description": "E.164 normalized.",
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "example": "admin"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_last_login": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ConsentDocument": {
        "title": "Consent Document",
        "description": "A versioned consent disclosure (Terms of Service, marketing/SMS opt-in, offer-specific consent). Immutable — a new version is published rather than edited in place.",
        "required": [
          "consent_document_id",
          "consent_type",
          "version",
          "active",
          "date_created"
        ],
        "properties": {
          "consent_document_id": {
            "description": "juju.consent_document — a versioned, immutable legal disclosure.\n\nList responses omit body_html / partners / sms_disclosure (they can be\nlarge); a single-document GET includes them. Declared nullable here so the\none schema serves both shapes.",
            "type": "integer"
          },
          "consent_type": {
            "type": "string",
            "example": "terms_of_service"
          },
          "version": {
            "type": "string",
            "example": "2026-08-18"
          },
          "offer_id": {
            "description": "Set only for offer-specific consents; null for site-level.",
            "type": "integer",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "body_html": {
            "description": "Full disclosure (single-document GET only). Plain text or HTML.",
            "type": "string",
            "nullable": true
          },
          "partners": {
            "description": "TCPA partner snapshot (single-document GET only).",
            "type": "array",
            "items": {
              "type": "object"
            },
            "nullable": true
          },
          "sms_disclosure": {
            "description": "Mandatory SMS copy (single-document GET only).",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object"
      },
      "ConsumerUser": {
        "title": "Consumer User",
        "description": "One row of juju.user — a consumer / jobseeker account. On the admin surface (support / ops). Detail adds info + activity blocks.",
        "required": [
          "user_id",
          "email",
          "active"
        ],
        "properties": {
          "user_id": {
            "description": "Consumer user row — juju.user (jobseeker accounts, viewed on the admin\nsurface for support / ops). Detail view layers `info` (juju.user_info)\nand `activity` blocks on top.\n\nNamed ConsumerUser to distinguish from AdminUser / SponsorLogin /\nPublisherLogin. All four are distinct login tables.\n\nSee JuJu\\Admin\\Controllers\\V1\\Users::shape_list_row().",
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_verified": {
            "description": "Non-null when the email artifact has completed verification.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "date_last_login": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "mfa_method": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Lookups": {
        "title": "Admin Lookups",
        "description": "Form-population data for the admin SPA — one call returns every dropdown/enum the surface needs. Cached ~5min. Every block uses `label` as the display field for SPA-side dropdown consistency (as of 2026-08-03).",
        "required": [
          "campaign_budget_types",
          "job_partners",
          "work_types",
          "job_groups",
          "offer_priority_tiers"
        ],
        "properties": {
          "campaign_budget_types": {
            "description": "Hardcoded — mirrors the CHECK enum on sponsor.job_provider_campaign.budget_type.",
            "type": "array",
            "items": {
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "description": "Aggregate lookups response — GET /admin/v1/lookups.\n\nSee JuJu\\Admin\\Controllers\\V1\\Lookups::all() for the source of truth.\nCached ~5min in Memcached.",
                  "type": "string",
                  "enum": [
                    "daily",
                    "monthly",
                    "flight",
                    "unlimited"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "job_partners": {
            "description": "Rows from sponsor.job_partner (WHERE active=true). Uses `label` for consistency with other lookup blocks (2026-08-03).",
            "type": "array",
            "items": {
              "required": [
                "job_partner_id",
                "label"
              ],
              "properties": {
                "job_partner_id": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "website": {
                  "type": "string",
                  "nullable": true
                },
                "documentation": {
                  "type": "string",
                  "nullable": true
                }
              },
              "type": "object"
            }
          },
          "work_types": {
            "type": "array",
            "items": {
              "required": [
                "work_type_id",
                "label"
              ],
              "properties": {
                "work_type_id": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "job_groups": {
            "description": "jobs.job_group rows with SOC codes for occupational-taxonomy targeting.",
            "type": "array",
            "items": {
              "required": [
                "job_group_id",
                "label"
              ],
              "properties": {
                "job_group_id": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "soc_code": {
                  "type": "string",
                  "nullable": true
                }
              },
              "type": "object"
            }
          },
          "offer_priority_tiers": {
            "description": "offer.offer_priority_tier rows (WHERE active=true), Diamond → Dust. Populates the offer-create tier dropdown.",
            "type": "array",
            "items": {
              "required": [
                "priority_tier_id",
                "label",
                "display_rank"
              ],
              "properties": {
                "priority_tier_id": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "display_rank": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        },
        "type": "object"
      },
      "Notification": {
        "title": "Notification",
        "description": "A shared admin alert with an open → acknowledged → resolved/dismissed lifecycle.",
        "required": [
          "notification_id",
          "type",
          "severity",
          "title",
          "status"
        ],
        "properties": {
          "notification_id": {
            "description": "Notification row — admin.notification. The shared team inbox item.",
            "type": "integer"
          },
          "type": {
            "type": "string",
            "example": "feed_failed"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "context": {
            "description": "Structured payload for deep-linking, e.g. {\"provider_id\": 5}.",
            "type": "object",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "acknowledged",
              "resolved",
              "dismissed"
            ]
          },
          "occurrence_count": {
            "description": "How many times this (deduped) event fired while open.",
            "type": "integer"
          },
          "last_occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledged_by": {
            "type": "integer",
            "nullable": true
          },
          "acknowledged_by_username": {
            "type": "string",
            "nullable": true
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "resolved_by": {
            "type": "integer",
            "nullable": true
          },
          "resolved_by_username": {
            "type": "string",
            "nullable": true
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "resolution_note": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "Offer": {
        "title": "Offer",
        "description": "Main offer entity. Targeting scalars, priority tier + weight, compliance flags, timezone, and lockout window live on the row itself; schedule windows and zipcode allowlist live under /offers/{id}/schedules and /offers/{id}/zipcodes respectively.",
        "required": [
          "offer_id",
          "offer_partner_id",
          "name",
          "priority_tier_id",
          "tier_weight",
          "timezone",
          "active",
          "paused"
        ],
        "properties": {
          "offer_id": {
            "description": "Offer row — offer.offer. The main entity of Wave 3.\n\nMoney fields (payout) return as string. Ages / age-array return as\ninteger / integer[]. Schedule rows and zipcode allowlist live on\nseparate nested endpoints (they're 1:N children).",
            "type": "integer"
          },
          "offer_partner_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "offer_logo": {
            "description": "Logo image URL for the offer creative (was offer_url; repurposed 2026-08-28).",
            "type": "string",
            "nullable": true
          },
          "call_now_number": {
            "description": "Phone-based CTA when set.",
            "type": "string",
            "nullable": true
          },
          "questions": {
            "description": "Array of question definitions. Each item: {key, label, type, required, answer_options, disqualifying_answers}.",
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "criteria": {
            "description": "Free-form JSONB targeting rules.",
            "type": "object"
          },
          "min_age": {
            "type": "integer",
            "nullable": true
          },
          "max_age": {
            "type": "integer",
            "nullable": true
          },
          "excluded_ages": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "nullable": true
          },
          "priority_tier_id": {
            "type": "integer"
          },
          "tier_weight": {
            "description": "1..100 — weighted-random share within the tier.",
            "type": "integer"
          },
          "min_impressions_per_hour": {
            "description": "Floor guarantee — offer catches up if under this in the current hour.",
            "type": "integer",
            "nullable": true
          },
          "payout": {
            "description": "Money as string (exact DB DECIMAL).",
            "type": "string",
            "example": "12.50",
            "nullable": true
          },
          "daily_cap": {
            "type": "integer",
            "nullable": true
          },
          "lockout_days": {
            "description": "Post-conversion suppression window. Null = no lockout.",
            "type": "integer",
            "nullable": true
          },
          "requires_trusted_form": {
            "type": "boolean"
          },
          "requires_jornaya": {
            "type": "boolean"
          },
          "requires_preping": {
            "description": "When true, controller pre-pings partner at submit time before writing the conversion.",
            "type": "boolean"
          },
          "timezone": {
            "description": "IANA name; DST-correct schedule matching.",
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "test_mode": {
            "type": "boolean"
          },
          "paused": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_updated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "OfferList": {
        "title": "Offer List",
        "description": "Named bundle of offers. Assigned to sponsors (as allow/block) and to publishers (with priority) so the matcher routes traffic to the right offers based on the serving context. See docs/wave3-schema-plan.md §\"Offer lists\" for the matcher rules.",
        "required": [
          "offer_list_id",
          "name",
          "active"
        ],
        "properties": {
          "offer_list_id": {
            "description": "OfferList row — offer.offer_list. Named bundle of offers, assigned\nto sponsor and publisher contexts for serving-layer routing.\n\nDetail responses layer a `counts` object on top of the base row with\nthe four junction cardinalities (active offers, allowlisted sponsors,\nblocklisted sponsors, publishers).",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "counts": {
            "description": "Membership tallies — only present on the detail response, not list rows. `offers` counts junction rows where BOTH the junction and the parent offer are active (matches what the matcher would consider); use `include_inactive` on the nested /offers endpoint to see the full set.",
            "properties": {
              "offers": {
                "type": "integer"
              },
              "sponsors_allow": {
                "type": "integer"
              },
              "sponsors_block": {
                "type": "integer"
              },
              "publishers": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "OfferListMember": {
        "title": "Offer List Member",
        "description": "Junction row from offer.offer_list_offer joined to a summary of the parent offer — enough for the admin members-panel display.",
        "required": [
          "offer_id",
          "offer_list_id",
          "weight",
          "active",
          "offer_active"
        ],
        "properties": {
          "offer_list_id": {
            "description": "One row of an offer-list membership view (the offer-in-list junction).\nCombines the junction row (weight, position, active) with a small\nsummary of the parent offer so the admin UI can render the members\npanel without a second fetch.",
            "type": "integer"
          },
          "offer_id": {
            "type": "integer"
          },
          "weight": {
            "description": "1..100 — weighted-random share within the containing list.",
            "type": "integer"
          },
          "position": {
            "type": "integer",
            "nullable": true
          },
          "active": {
            "description": "Junction row active flag.",
            "type": "boolean"
          },
          "offer_name": {
            "type": "string"
          },
          "offer_headline": {
            "type": "string",
            "nullable": true
          },
          "offer_active": {
            "description": "Parent offer.active — inactive offers are hidden from members lists by default (use include_inactive=true to see them).",
            "type": "boolean"
          },
          "offer_paused": {
            "type": "boolean"
          },
          "offer_payout": {
            "type": "string",
            "example": "12.50",
            "nullable": true
          },
          "offer_tier_id": {
            "type": "integer"
          },
          "offer_partner_id": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "OfferPartner": {
        "title": "Offer Partner",
        "description": "Partner org that owns offers. Contains contact info + per-partner defaults that pre-fill new offers.",
        "required": [
          "offer_partner_id",
          "name",
          "active"
        ],
        "properties": {
          "offer_partner_id": {
            "description": "OfferPartner row — offer.offer_partner. Contact info + create-only\noffer_defaults.\n\nSee JuJu\\Admin\\Controllers\\V1\\OfferPartners::shape().",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "logo_url": {
            "type": "string",
            "nullable": true
          },
          "contact_name": {
            "type": "string",
            "nullable": true
          },
          "contact_email": {
            "description": "Denormalized from juju.email artifact.",
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "contact_phone": {
            "description": "Denormalized from juju.phone artifact (E.164).",
            "type": "string",
            "nullable": true
          },
          "offer_defaults": {
            "description": "Free-form JSONB used to pre-fill new offers under this partner. Create-only — admin form deep-merges this into a new-offer form; editing an existing offer does not re-apply defaults.",
            "type": "object",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "OfferSchedule": {
        "title": "Offer Schedule Window",
        "description": "One active window for an offer on a given day of week. Multiple rows per day OK (split shifts). Times interpreted in offer.timezone; NO row for a day = offer inactive that day.",
        "required": [
          "offer_schedule_id",
          "offer_id",
          "day_of_week",
          "start_time",
          "end_time"
        ],
        "properties": {
          "offer_schedule_id": {
            "description": "OfferSchedule row — offer.offer_schedule. Per-day time-of-day\nwindow. Times are wall-clock in the parent offer's timezone.",
            "type": "integer"
          },
          "offer_id": {
            "type": "integer"
          },
          "day_of_week": {
            "description": "0=Sun … 6=Sat (PG EXTRACT(DOW) convention).",
            "type": "integer"
          },
          "start_time": {
            "description": "HH:MM:SS wall-clock in offer.timezone.",
            "type": "string"
          },
          "end_time": {
            "description": "HH:MM:SS wall-clock in offer.timezone.",
            "type": "string"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "ProviderStatus": {
        "title": "Provider Status",
        "description": "A job provider with its serving state, active-campaign budgets, and current indexed job count.",
        "required": [
          "provider_id",
          "provider_name",
          "serving_paid",
          "serving_organic",
          "jobs_in_index",
          "campaigns"
        ],
        "properties": {
          "provider_id": {
            "description": "Per-provider row of GET /admin/v1/system/provider-status — mirrors the\nprovider structure JuJu\\Common\\Libraries\\ProviderStatusReport::build()\nemits. Serving flags + campaign budgets come from the sponsor:refresh-budgets\ncache; jobs_in_index comes fresh from Solr.",
            "type": "integer"
          },
          "provider_name": {
            "type": "string"
          },
          "serving_paid": {
            "description": "Provider has at least one live, in-budget paid campaign (campaign_live_providers).",
            "type": "boolean"
          },
          "serving_organic": {
            "description": "Provider runs an active organic campaign (campaign_organic_providers).",
            "type": "boolean"
          },
          "jobs_in_index": {
            "description": "Live document count for this provider in Solr — the served inventory, independent of campaign eligibility. 0 when the Solr count failed (see meta.solr_error).",
            "type": "integer"
          },
          "campaigns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStatusCampaign"
            }
          }
        },
        "type": "object"
      },
      "ProviderStatusCampaign": {
        "title": "Provider Status Campaign",
        "description": "Budget snapshot for one active campaign. Spend + budget are the sponsor:refresh-budgets cache values (not recomputed); remaining = budget − spent. Money as strings.",
        "required": [
          "campaign_id",
          "campaign_name",
          "budget_type",
          "pricing_model",
          "state"
        ],
        "properties": {
          "campaign_id": {
            "description": "One active campaign's budget line within a ProviderStatus row — mirrors\nJuJu\\Common\\Libraries\\ProviderStatusReport::campaign_row() after the admin\ncontroller renders money as strings.",
            "type": "integer",
            "format": "int64"
          },
          "campaign_name": {
            "type": "string"
          },
          "budget_type": {
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "flight",
              "unlimited"
            ]
          },
          "pricing_model": {
            "type": "string",
            "enum": [
              "cpc",
              "cpa"
            ]
          },
          "organic": {
            "type": "boolean"
          },
          "paused": {
            "description": "Manually paused by an operator (distinct from over-budget).",
            "type": "boolean"
          },
          "budget": {
            "description": "Money as string. Null when budget_type=unlimited.",
            "type": "string",
            "example": "500.00",
            "nullable": true
          },
          "spent": {
            "description": "Spend this budget period (money as string). Null when there is no fresh spend snapshot — a manually-paused campaign, or the refresh has not run.",
            "type": "string",
            "example": "318.24",
            "nullable": true
          },
          "remaining": {
            "description": "budget − spent (money as string). Null for unlimited or when spend is unknown.",
            "type": "string",
            "example": "181.76",
            "nullable": true
          },
          "state": {
            "description": "unknown = active + non-paused but no fresh spend snapshot yet.",
            "type": "string",
            "enum": [
              "in-budget",
              "over-budget",
              "paused",
              "unlimited",
              "unknown"
            ]
          }
        },
        "type": "object"
      },
      "Publisher": {
        "title": "Publisher",
        "description": "A publisher company. Detail view adds accounts[] and earnings_summary.",
        "required": [
          "publisher_id",
          "name",
          "active"
        ],
        "properties": {
          "publisher_id": {
            "description": "Publisher row — publisher.publisher (the org table). Detail responses\nlayer `accounts` (array of PublisherAccount) and `earnings_summary`\non top of this base.\n\nSee JuJu\\Admin\\Controllers\\V1\\Publishers::shape() and ::fetch_detail().",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "address1": {
            "type": "string",
            "nullable": true
          },
          "address2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "postal": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "primary_contact": {
            "type": "string",
            "nullable": true
          },
          "primary_email": {
            "type": "string",
            "nullable": true
          },
          "primary_phone": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PublisherLogin": {
        "title": "Publisher Login",
        "description": "One human login for the publisher self-service portal. Distinct from PublisherAccount (API-key credentials for server-to-server) — this is the humans who log in via the portal.",
        "required": [
          "user_id",
          "username",
          "email",
          "publisher_id",
          "active"
        ],
        "properties": {
          "user_id": {
            "description": "publisher_login_id renamed to user_id on the wire.",
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "publisher_id": {
            "type": "integer"
          },
          "publisher_name": {
            "description": "Denormalized from publisher.publisher for display.",
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_last_login": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "RunInfo": {
        "title": "Feed Run",
        "description": "One row of jobs.run_info — per-feed-run telemetry produced by feed:process + feed:worker. A run is in-progress when time_processing_finished is null; stuck when workers_last_heartbeat is stale (>5 min) against a null time_processing_finished.",
        "required": [
          "run_id",
          "job_provider_id",
          "workers_active"
        ],
        "properties": {
          "run_id": {
            "description": "Feed-run row shape — mirrors JuJu\\Admin\\Controllers\\V1\\FeedRuns::shape()\nand JuJu\\Admin\\Controllers\\V1\\Providers::shape_run_info(). One wire\nform regardless of whether the row is embedded in a provider detail\nor listed on the /feed-runs endpoint.",
            "type": "integer",
            "format": "int64"
          },
          "job_provider_id": {
            "type": "integer"
          },
          "job_provider": {
            "description": "Provider display name (sponsor.job_provider.job_provider).",
            "type": "string"
          },
          "total_jobs_in_file": {
            "description": "Count of <capture_node> elements the feed contained. Null until parse completes.",
            "type": "integer",
            "nullable": true
          },
          "new_jobs_in_file": {
            "type": "integer",
            "nullable": true
          },
          "updated_jobs_in_file": {
            "type": "integer",
            "nullable": true
          },
          "time_started": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "time_parse_finished": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "time_processing_finished": {
            "description": "Null while the run is in progress; timestamped on completion.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "workers_active": {
            "type": "integer",
            "example": 0
          },
          "workers_last_heartbeat": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "type": "object"
      },
      "Segment": {
        "title": "Campaign Segment",
        "description": "One segment under a campaign — a targeting criteria + bid-range pair.",
        "required": [
          "segment_id",
          "campaign_id",
          "name",
          "bid_low",
          "bid_high",
          "active"
        ],
        "properties": {
          "segment_id": {
            "description": "Campaign segment row — sponsor.job_provider_campaign_segment.\nUsed by JuJu\\Admin\\Controllers\\V1\\Campaigns (nested list/create) and\nJuJu\\Admin\\Controllers\\V1\\Segments (flat CRUD).",
            "type": "integer"
          },
          "campaign_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "criteria": {
            "description": "JSONB targeting criteria (e.g. {\"job_group_id\": [123], \"state\": [\"CA\"]}). Shape is caller-defined and evolves with the matcher; treat as opaque object.",
            "type": "object",
            "nullable": true
          },
          "bid_low": {
            "description": "Money as string (exact DB DECIMAL). On a CPA campaign these bounds are denominated in CPA dollars (the feed payout), not per-click.",
            "type": "string",
            "example": "0.12"
          },
          "bid_high": {
            "type": "string",
            "example": "0.42"
          },
          "prefer_high_bid": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "conversion_rate_assumed": {
            "description": "CPA only. Admin-seeded conversion rate (fraction 0–1) used to back out the CPC and as the working rate when tuning is off.",
            "type": "string",
            "example": "0.040000",
            "nullable": true
          },
          "conversion_rate_working": {
            "description": "CPA only. The rate currently in force at serve time — observation-tuned when tuning is on, else mirrors the assumed rate. Read-only (maintained by the reconcile worker / rate-config writes).",
            "type": "string",
            "example": "0.037500",
            "nullable": true
          },
          "effective_cpc_override": {
            "description": "CPA only. Admin manual CPC that wins outright over the backout when set. Money as string.",
            "type": "string",
            "example": "1.20",
            "nullable": true
          },
          "observation_tuning_enabled": {
            "description": "CPA only. When true, observed conversions drive conversion_rate_working; when false it stays pinned to the assumed rate.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Sponsor": {
        "title": "Sponsor",
        "description": "Top-level sponsor / job-partner org. Detail view adds provider_count.",
        "required": [
          "job_partner_id",
          "name",
          "active"
        ],
        "properties": {
          "job_partner_id": {
            "description": "DB FK column name preserved for alignment with sponsor.* — the resource itself is a Sponsor.",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "documentation": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "SponsorLogin": {
        "title": "Sponsor Login",
        "description": "One human login for the sponsor self-service portal. Scoped to a parent sponsor org (job_partner_id, required). Optionally further scoped to a single provider (job_provider_id, nullable — omit for org-wide access across every provider under the partner). Distinct from AdminUser (staff) and from the API-key accounts used for server-to-server integration.",
        "required": [
          "user_id",
          "username",
          "email",
          "job_partner_id",
          "active"
        ],
        "properties": {
          "user_id": {
            "description": "sponsor_login_id renamed to user_id on the wire.",
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "job_partner_id": {
            "description": "Parent sponsor org. Required — every login belongs to one partner.",
            "type": "integer"
          },
          "job_partner_name": {
            "description": "Denormalized from sponsor.job_partner for display.",
            "type": "string"
          },
          "job_provider_id": {
            "description": "Optional sub-account restriction. Null = org-wide access.",
            "type": "integer",
            "nullable": true
          },
          "job_provider_name": {
            "description": "Denormalized from sponsor.job_provider for display.",
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_last_login": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "UserActivity": {
        "title": "Consumer User Activity",
        "description": "Activity summary for the support / ops drill-down. clicks_last_90d is bounded to keep partition scans reasonable; leads is a placeholder until Wave 3 ships the leads.lead table.",
        "required": [
          "saved_jobs",
          "saved_searches",
          "search_history_in_window",
          "clicks_last_90d",
          "leads"
        ],
        "properties": {
          "saved_jobs": {
            "description": "Consumer user activity counts — nested block on the consumer user\ndetail response.\n\nSee JuJu\\Admin\\Controllers\\V1\\Users::fetch_activity() + display().",
            "type": "integer"
          },
          "saved_searches": {
            "type": "integer"
          },
          "search_history_in_window": {
            "description": "90-day retention — surviving rows are all in-window.",
            "type": "integer"
          },
          "clicks_last_90d": {
            "type": "integer"
          },
          "leads": {
            "description": "Placeholder — always 0 until Wave 3 leads schema lands.",
            "type": "integer"
          },
          "last_login": {
            "description": "Mirror of the top-level date_last_login, surfaced here for SPA convenience.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "type": "object"
      },
      "UserInfo": {
        "title": "Consumer User Info",
        "description": "Extended profile data (juju.user_info) — demographics, address, gender lookup. Null on the parent response when no user_info row exists.",
        "properties": {
          "date_of_birth": {
            "description": "Extended consumer PII — juju.user_info. Nested block on the consumer\nuser detail response. Null when the user has never filled out an\ninfo-requiring form flow.\n\nSee JuJu\\Admin\\Controllers\\V1\\Users::fetch_user_info().",
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender_id": {
            "type": "integer",
            "nullable": true
          },
          "gender_code": {
            "type": "string",
            "nullable": true
          },
          "gender_name": {
            "type": "string",
            "nullable": true
          },
          "gender_other": {
            "type": "string",
            "nullable": true
          },
          "address_1": {
            "type": "string",
            "nullable": true
          },
          "address_2": {
            "type": "string",
            "nullable": true
          },
          "city_id": {
            "type": "integer",
            "nullable": true
          },
          "state_id": {
            "type": "integer",
            "nullable": true
          },
          "zipcode_id": {
            "type": "integer",
            "nullable": true
          },
          "raw_city": {
            "type": "string",
            "nullable": true
          },
          "raw_state": {
            "type": "string",
            "nullable": true
          },
          "raw_postal": {
            "type": "string",
            "nullable": true
          },
          "extra_attributes": {
            "description": "JSONB — form-specific fields captured outside the fixed schema.",
            "type": "object",
            "nullable": true
          },
          "date_updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "type": "object"
      },
      "JsonEnvelope": {
        "title": "JSON Envelope",
        "description": "Standard response wrapper used by every JuJu API surface. Endpoints override the `data` property with their specific payload shape via allOf composition; `meta` and `errors` are uniform.",
        "required": [
          "data",
          "meta",
          "errors"
        ],
        "properties": {
          "data": {
            "description": "Endpoint-specific payload. Overridden per endpoint with the actual shape; this base schema leaves it untyped so each endpoint can supply object / array / scalar / null.",
            "nullable": true
          },
          "meta": {
            "description": "Pagination and context metadata. Always present, empty object ({}) when no metadata applies to the response.",
            "type": "object"
          },
          "errors": {
            "description": "Empty array on success. On failure, human-readable error strings suitable for surfacing to end users.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": []
          }
        },
        "type": "object"
      },
      "Adjustment": {
        "title": "Adjustment",
        "description": "A manual credit or debit against a sponsor or publisher account.",
        "required": [
          "adjustment_id",
          "account_type",
          "account_ref",
          "direction",
          "amount",
          "reason",
          "status"
        ],
        "properties": {
          "adjustment_id": {
            "description": "Adjustment row — billing.adjustment. An operator-issued credit/debit against\na sponsor or publisher account (e.g. a bot-click reconciliation credit).",
            "type": "integer"
          },
          "account_type": {
            "type": "string",
            "enum": [
              "sponsor",
              "publisher"
            ]
          },
          "account_ref": {
            "description": "job_partner_id (sponsor) or publisher_id (publisher).",
            "type": "integer"
          },
          "direction": {
            "type": "string",
            "enum": [
              "credit",
              "debit"
            ]
          },
          "amount": {
            "type": "string",
            "example": "125.0000"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "applied",
              "void"
            ]
          },
          "applied_invoice_id": {
            "type": "integer",
            "nullable": true
          },
          "applied_payout_id": {
            "type": "integer",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "Campaign": {
        "title": "Campaign",
        "description": "Sponsor-side targeting + budget config driving what /jobs/search serves.",
        "required": [
          "campaign_id",
          "job_provider_id",
          "name",
          "budget_type",
          "active",
          "paused"
        ],
        "properties": {
          "campaign_id": {
            "description": "Campaign row — sponsor.job_provider_campaign. Detail responses layer\n`segments` (array of Segment) and `spend_to_date` on top of this base.\n\nUsed by both /admin/v1/campaigns and /sponsor/v1/campaigns so lives\nin common — per-scope openapi generation only scans juju/common +\njuju/{scope}, and sponsor's scope doesn't see admin/Schemas.",
            "type": "integer"
          },
          "job_provider_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "paused": {
            "type": "boolean"
          },
          "test_mode": {
            "type": "boolean"
          },
          "promotional": {
            "type": "boolean"
          },
          "organic": {
            "type": "boolean"
          },
          "budget_type": {
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "flight",
              "unlimited"
            ]
          },
          "pricing_model": {
            "description": "How the per-job feed value is interpreted. cpc = cost-per-click (default). cpa = cost-per-application: the value is a CPA payout, backed out to an estimated CPC per segment for pacing.",
            "type": "string",
            "enum": [
              "cpc",
              "cpa"
            ]
          },
          "budget": {
            "description": "Money as string (exact DB DECIMAL). Null when budget_type=unlimited.",
            "type": "string",
            "example": "500.00",
            "nullable": true
          },
          "default_cpc": {
            "type": "string",
            "example": "0.12",
            "nullable": true
          },
          "start_date": {
            "description": "Required + non-null iff budget_type=flight; null otherwise.",
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_updated": {
            "type": "string",
            "format": "date-time"
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "EarningsSummary": {
        "title": "Publisher Earnings Summary",
        "description": "Publisher-wide earnings aggregated across every account, banded by month for dashboard display. All amounts are money-as-string; pending_payout is null until payout tracking lands (its shape is stable so the FE never has to move the field).",
        "required": [
          "to_date",
          "this_month",
          "last_month"
        ],
        "properties": {
          "to_date": {
            "description": "All-time cumulative earnings.",
            "type": "string",
            "example": "12345.67"
          },
          "this_month": {
            "description": "Earnings from date_trunc('month', CURRENT_DATE) onward.",
            "type": "string",
            "example": "452.19"
          },
          "last_month": {
            "description": "Earnings across the previous calendar month.",
            "type": "string",
            "example": "1210.55"
          },
          "pending_payout": {
            "description": "Null placeholder until payout tracking lands.",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object"
      },
      "Invoice": {
        "title": "Invoice",
        "description": "A sponsor invoice for a billing period.",
        "required": [
          "invoice_id",
          "public_id",
          "invoice_number",
          "job_partner_id",
          "status",
          "total"
        ],
        "properties": {
          "invoice_id": {
            "description": "Invoice row — billing.invoice. Shared by /admin/v1/billing and the sponsor\nportal. Detail responses layer `line_items` (and admin adds `payments`) on\ntop of this base. Money fields are exact-decimal strings.",
            "type": "integer"
          },
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "invoice_number": {
            "type": "string",
            "example": "INV-2026-000123"
          },
          "job_partner_id": {
            "type": "integer"
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "open",
              "paid",
              "partially_paid",
              "void",
              "uncollectible"
            ]
          },
          "subtotal": {
            "type": "string",
            "example": "4211.5500"
          },
          "tax_amount": {
            "type": "string",
            "example": "0.0000"
          },
          "total": {
            "type": "string",
            "example": "4211.5500"
          },
          "amount_paid": {
            "type": "string",
            "example": "0.0000"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "due_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "Job": {
        "title": "Job",
        "description": "A single job posting as returned by the public search and show endpoints. Most fields are optional — feeds vary widely in what they populate. The `click_url` field is server-generated and is the ONLY URL consumers should send users to (it routes through click tracking before redirecting to the underlying provider). PUBLISHER (Bearer-authenticated) responses match the syndication feed: `id` is an opaque, stable hash (not the raw compound id); `jobid`, `job_provider_id`, and `jobgroupid` are OMITTED; and a `payout` field is added. Internal / frontend responses use the raw compound `id` and include `jobid` / `job_provider_id` / `jobgroupid` (no `payout`).",
        "required": [
          "id",
          "title",
          "click_url"
        ],
        "properties": {
          "id": {
            "description": "PUBLISHER (Bearer) responses: an opaque, stable, non-reversible hash of the job — the same value in search, show, and the feed files. Safe to dedup / update-by-id on; it is NOT the raw compound id and can not be used to fetch a job. INTERNAL / frontend responses: the raw compound Solr id `{job_provider_id}_{jobid}`, usable as the path parameter on /api/v1/jobs/{id}.",
            "type": "string",
            "example": "2LKlPuMKB6P6-mivzB8Cuw"
          },
          "jobid": {
            "description": "INTERNAL / frontend only — OMITTED from publisher (Bearer) responses. Provider-supplied job identifier; not globally unique across providers. Typed as a string (feeds use numeric ids, GUIDs, and slugs interchangeably).",
            "type": "string",
            "example": "141096464"
          },
          "reference": {
            "description": "Provider-supplied reference / requisition number.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "INTERNAL / frontend only — OMITTED from publisher (Bearer) responses. Internal id of the sponsor that supplied this job.",
            "type": "integer",
            "example": 2
          },
          "title": {
            "type": "string",
            "example": "CDL-A Truck Drivers - Earn $1,400 Weekly"
          },
          "title_display": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "type": "string",
            "example": "Hogan Transportation",
            "nullable": true
          },
          "logo": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "click_url": {
            "description": "Server-generated URL to route the user through. ALWAYS use this to send users to a job — the underlying joburl is intentionally not exposed. Hitting click_url records the click (attribution / billing) before 302-redirecting to the provider.",
            "type": "string",
            "format": "uri",
            "example": "https://jobs.juju.com/jobs/click/abc123def456..."
          },
          "payout": {
            "description": "PUBLISHER (Bearer) responses only. Indicative per-click earnings for your account (effective_cpc × your cpc_share), as an exact decimal string. A ranking signal — the actual amount is settled at click time. Absent on internal / frontend responses.",
            "type": "string",
            "example": "0.4200",
            "nullable": true
          },
          "city": {
            "type": "string",
            "example": "Rueter",
            "nullable": true
          },
          "state": {
            "type": "string",
            "example": "Missouri",
            "nullable": true
          },
          "state_code": {
            "type": "string",
            "example": "MO",
            "nullable": true,
            "maxLength": 2
          },
          "province": {
            "type": "string",
            "nullable": true
          },
          "postal": {
            "type": "string",
            "example": "65744",
            "nullable": true
          },
          "country": {
            "type": "string",
            "example": "US",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "example": 36.6,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "example": -92.86,
            "nullable": true
          },
          "geo_location": {
            "description": "Compound \"lat,lon\" string used server-side for Solr radius filtering ({!geofilt}). Auto-derived from latitude + longitude at index time, so it may be absent on jobs whose feed didn't supply coordinates. Clients that need coordinates for map rendering / distance math should read the discrete `latitude` and `longitude` fields — this one is provided for transparency, not as the primary API surface.",
            "type": "string",
            "example": "36.600000,-92.860000",
            "nullable": true
          },
          "work_location": {
            "type": "string",
            "nullable": true
          },
          "is_remote": {
            "type": "boolean",
            "nullable": true
          },
          "date_posted": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "date_updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "date_expires": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "salary_low": {
            "type": "number",
            "format": "double",
            "example": 1400,
            "nullable": true
          },
          "salary_high": {
            "type": "number",
            "format": "double",
            "example": 1400,
            "nullable": true
          },
          "salary_avg": {
            "type": "number",
            "format": "double",
            "example": 1400,
            "nullable": true
          },
          "salary_type": {
            "type": "string",
            "example": "week",
            "nullable": true,
            "enum": [
              "hour",
              "day",
              "week",
              "month",
              "year"
            ]
          },
          "salary_str": {
            "description": "Human-readable salary range string from the feed if provided.",
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "example": "USD",
            "nullable": true,
            "maxLength": 3
          },
          "work_type": {
            "description": "Human label (e.g. \"Full Time\"), resolved from the stored work-type id.",
            "type": "string",
            "example": "Full Time",
            "nullable": true
          },
          "experience_level": {
            "type": "string",
            "nullable": true
          },
          "education_level": {
            "type": "string",
            "nullable": true
          },
          "industry": {
            "type": "string",
            "nullable": true
          },
          "jobgroup": {
            "type": "string",
            "nullable": true
          },
          "jobgroupid": {
            "description": "INTERNAL / frontend only — OMITTED from publisher (Bearer) responses.",
            "type": "integer",
            "nullable": true
          },
          "major_group_id": {
            "description": "O*NET major-group id (the canonical category taxonomy; labels + counts via /lookups job_groups). Returned to all consumers.",
            "type": "integer",
            "nullable": true
          },
          "category": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Driving and Transport"
            ],
            "nullable": true
          },
          "subcategory": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Truck Driver"
            ],
            "nullable": true
          },
          "job_summary": {
            "type": "string",
            "nullable": true
          },
          "job_requirement": {
            "type": "string",
            "nullable": true
          },
          "job_experience": {
            "type": "string",
            "nullable": true
          }
        },
        "type": "object"
      },
      "OfferDisplay": {
        "title": "Offer (display)",
        "description": "Consumer-facing offer fields for rendering an offer unit + its form. No payout / cap / tier data.",
        "required": [
          "offer_id"
        ],
        "properties": {
          "offer_id": {
            "description": "OfferDisplay — the consumer-safe projection of offer.offer returned by the\noffer-serve endpoints (GET /api/v1/offers/next and /offers/{id}).\n\nDeliberately excludes serving internals (payout, caps, tier weights,\npartner ids). See JuJu\\Webapi\\Controllers\\V1\\Offers\\Serve::shape_display —\nthat allowlist is the source of truth this schema mirrors.",
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "description": "Internal-ish label; usually the headline is what renders.",
            "type": "string",
            "nullable": true
          },
          "headline": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "description": "Offer copy (plain text or HTML per the offer).",
            "type": "string",
            "nullable": true
          },
          "offer_logo": {
            "description": "Logo image URL for the offer creative.",
            "type": "string",
            "nullable": true
          },
          "call_now_number": {
            "description": "Click-to-call number for call offers.",
            "type": "string",
            "nullable": true
          },
          "questions": {
            "description": "Form questions to render (offer.questions JSONB). Shape is offer-defined.",
            "type": "array",
            "items": {
              "type": "object"
            },
            "nullable": true
          },
          "requires_trusted_form": {
            "description": "SPA must inject the TrustedForm script before submit.",
            "type": "boolean"
          },
          "requires_jornaya": {
            "description": "SPA must inject the Jornaya (LeadiD) script before submit.",
            "type": "boolean"
          },
          "action": {
            "description": "How the SPA acts on this offer — server-driven so the SPA never hardcodes where/how to post. `kind` is lead_form | redirect | call. For lead_form and redirect, POST to `url` (a JuJu endpoint) using `method`; for redirect, open the returned `redirect_url` with `target`. For call, dial `call_now_number`.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "lead_form",
                  "redirect",
                  "call"
                ]
              },
              "method": {
                "type": "string",
                "example": "POST",
                "nullable": true
              },
              "url": {
                "description": "Relative JuJu endpoint to POST to (null for call).",
                "type": "string",
                "nullable": true
              },
              "target": {
                "description": "_self for in-page form flows, _blank for redirect offers.",
                "type": "string",
                "example": "_blank"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "PaginationMeta": {
        "title": "Pagination Meta",
        "description": "Standard pagination meta block emitted by every list endpoint. Populated on responses that return an array of items; empty object `{}` on non-list endpoints.",
        "required": [
          "total",
          "page",
          "per_page",
          "total_pages"
        ],
        "properties": {
          "total": {
            "description": "Total matching rows across all pages.",
            "type": "integer",
            "example": 137
          },
          "page": {
            "description": "1-indexed current page number.",
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "description": "Rows per page; clamped to the endpoint's max.",
            "type": "integer",
            "example": 50
          },
          "total_pages": {
            "description": "ceil(total / per_page). Zero when per_page is zero.",
            "type": "integer",
            "example": 3
          }
        },
        "type": "object"
      },
      "Payment": {
        "title": "Payment",
        "description": "A payment received from a sponsor.",
        "required": [
          "payment_id",
          "public_id",
          "job_partner_id",
          "amount",
          "method",
          "status"
        ],
        "properties": {
          "payment_id": {
            "description": "Payment row — billing.payment. Money received from a sponsor (card charge or\nrecorded remittance). Detail responses add `applications` (how it split\nacross invoices).",
            "type": "integer"
          },
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "job_partner_id": {
            "type": "integer"
          },
          "amount": {
            "type": "string",
            "example": "4211.5500"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "ach",
              "check",
              "wire",
              "manual"
            ]
          },
          "processor_txn_ref": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "refunded"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "Payout": {
        "title": "Payout",
        "description": "A payout to a publisher for accrued earnings.",
        "required": [
          "payout_id",
          "public_id",
          "publisher_id",
          "amount",
          "status"
        ],
        "properties": {
          "payout_id": {
            "description": "Payout row — billing.payout. A publisher payout for a period. Shared by\n/admin/v1/billing and the publisher portal. Detail responses add\n`line_items`. Money fields are exact-decimal strings.",
            "type": "integer"
          },
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "publisher_id": {
            "type": "integer"
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "string",
            "example": "1875.0000"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "in_transit",
              "paid",
              "failed",
              "returned",
              "on_hold"
            ]
          },
          "processor_transfer_ref": {
            "type": "string",
            "nullable": true
          },
          "initiated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "paid_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "Provider": {
        "title": "Provider",
        "description": "One feed source under a sponsor (sponsor.job_provider). Admin detail view additionally exposes schema_mapping, campaign_count, latest_run, and credential-presence booleans.",
        "required": [
          "job_provider_id",
          "job_partner_id",
          "name",
          "active",
          "paused",
          "fetch_method"
        ],
        "properties": {
          "job_provider_id": {
            "description": "Provider row (sponsor.job_provider) — the shape returned by both the\n/providers list and as the base of the /providers/{id} detail. Used\nby admin and sponsor portals.\n\nDetail responses on admin add schema_mapping, campaign_count,\nlatest_run, username_set, password_set. Sponsor exposes only the base\nfields (read-only surface).\n\nNote: `username` / `password` values are NEVER returned — presence\nbooleans on admin detail only.",
            "type": "integer"
          },
          "job_partner_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "feed_url": {
            "type": "string",
            "nullable": true
          },
          "capture_node": {
            "description": "XML element name to iterate on when parsing the feed.",
            "type": "string",
            "nullable": true
          },
          "refresh_minutes": {
            "type": "integer",
            "nullable": true
          },
          "click_id_param": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "last_run_completed": {
            "description": "Most recent completed run (MAX time_processing_finished). Null when the provider has never had a completed run. Can look stale for a feed whose file rarely changes — see last_checked.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_checked": {
            "description": "Last time the feed file was CHECKED (job_provider_file_hash.date_checked), stamped on every run attempt before the no-change skip. Stays fresh even when the file is unchanged and processing is skipped; last_run_completed does not. Null until first checked.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "paused": {
            "type": "boolean"
          },
          "force_run": {
            "type": "boolean"
          },
          "fetch_method": {
            "type": "string",
            "enum": [
              "url",
              "s3",
              "index"
            ]
          },
          "fetch_config": {
            "description": "Non-secret transport config. For fetch_method=s3: bucket*, region, role_arn, external_id, credential_source (instance|ssm|static), credentials_ref, object_selection (key|newest_in_prefix), plus key or prefix per selection.",
            "type": "object",
            "nullable": true
          },
          "has_stored_credentials": {
            "description": "True if fetch_credentials_encrypted is populated. The credential values themselves are never returned.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PublisherAccount": {
        "title": "Publisher Account",
        "description": "One API-key credential under a publisher. Plaintext keys are returned EXACTLY ONCE on the create + regenerate responses; subsequent GETs return only prefix + hint.",
        "required": [
          "publisher_account_id",
          "publisher_id",
          "account_name",
          "api_key_prefix",
          "active"
        ],
        "properties": {
          "publisher_account_id": {
            "description": "Publisher API-key account — publisher.publisher_account.\nUsed by both /admin/v1/accounts and /publisher/v1/api-keys endpoints\nso lives in common.\n\nExposes prefix + hint (never plaintext / hash).",
            "type": "integer"
          },
          "publisher_id": {
            "type": "integer"
          },
          "account_name": {
            "type": "string"
          },
          "api_key_prefix": {
            "type": "string",
            "example": "juju_pub_XY"
          },
          "api_key_hint": {
            "description": "Last 4 chars of the plaintext key, for UI display (\"…abcd\").",
            "type": "string",
            "example": "abcd"
          },
          "cpc_share": {
            "description": "Revenue-share fraction, 0..1, as an exact DECIMAL(5,4) string (NOT a money amount, NOT a percentage). Publisher keeps cpc_share × click cpc; e.g. 0.7000 = 70%. Display as a percentage.",
            "type": "string",
            "example": "0.7000"
          },
          "rate_limit_tier": {
            "type": "string",
            "example": "default"
          },
          "organic": {
            "description": "When true, this publisher's search calls get unpaid / organic inventory mixed in below paid results. Default false (paid-only).",
            "type": "boolean",
            "example": false
          },
          "min_payout": {
            "description": "Net payout floor for LIVE serving, as an exact DECIMAL(10,4) string or null. A paid job serves to this account only when its net earning (effective_cpc x cpc_share) is >= this. null = no floor. Distinct from the syndication feed min_cpc, which floors the GROSS effective CPC.",
            "type": "string",
            "example": "0.1000",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "date_last_used": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PublisherKeyRotation": {
        "title": "Publisher Key Rotation Event",
        "description": "One lifecycle event on a publisher.publisher_account row — rotate, revoke, reactivate, or expire. Audit-trail granularity: who did it, when, and (for rotate) which prefix was replaced.",
        "required": [
          "rotation_id",
          "publisher_account_id",
          "action",
          "actor_type",
          "date_created"
        ],
        "properties": {
          "rotation_id": {
            "description": "One row of publisher.publisher_key_rotation — a single API-key\nlifecycle event. Shared between the admin and publisher rotation-\nhistory endpoints.",
            "type": "integer",
            "format": "int64"
          },
          "publisher_account_id": {
            "type": "integer"
          },
          "action": {
            "type": "string",
            "enum": [
              "rotate",
              "revoke",
              "reactivate",
              "expire"
            ]
          },
          "actor_type": {
            "type": "string",
            "enum": [
              "admin",
              "publisher",
              "system"
            ]
          },
          "actor_admin_user_id": {
            "description": "Present when actor_type='admin'.",
            "type": "integer",
            "nullable": true
          },
          "actor_publisher_login_id": {
            "description": "Present when actor_type='publisher'.",
            "type": "integer",
            "nullable": true
          },
          "actor_display": {
            "description": "Denormalized \"First Last (username)\" or \"system\" for UI display.",
            "type": "string",
            "nullable": true
          },
          "old_prefix": {
            "description": "Populated on rotate — the prefix that was replaced.",
            "type": "string",
            "nullable": true
          },
          "new_prefix": {
            "description": "Populated on rotate — the prefix now in effect.",
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object"
      },
      "ReportApiUsageDailyRow": {
        "title": "Daily API Usage Report Row",
        "description": "One day's API request aggregates for a publisher scope.",
        "required": [
          "report_date",
          "requests_total"
        ],
        "properties": {
          "report_date": {
            "description": "One row of a daily-API-usage report. Backed by\nJuJu\\Common\\Libraries\\Reports\\ApiUsageReport::fetch_daily against\n`publisher.api_request_log`.",
            "type": "string",
            "format": "date"
          },
          "publisher_account_id": {
            "description": "Present only when group_by includes account.",
            "type": "integer"
          },
          "publisher_account_name": {
            "description": "Present only when group_by includes account.",
            "type": "string",
            "nullable": true
          },
          "publisher_id": {
            "description": "Present only when group_by includes publisher.",
            "type": "integer"
          },
          "publisher_name": {
            "description": "Present only when group_by includes publisher.",
            "type": "string",
            "nullable": true
          },
          "requests_total": {
            "type": "integer"
          },
          "requests_2xx": {
            "type": "integer"
          },
          "requests_4xx": {
            "type": "integer"
          },
          "requests_5xx": {
            "type": "integer"
          },
          "avg_response_time_ms": {
            "description": "Null when no rows in range.",
            "type": "integer",
            "nullable": true
          },
          "results_returned_total": {
            "description": "Sum of result_count across all requests.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ReportClicksDailyRow": {
        "title": "Daily Clicks Report Row",
        "description": "One day's click aggregates. All money as string DECIMAL.",
        "required": [
          "report_date",
          "clicks_total"
        ],
        "properties": {
          "report_date": {
            "description": "One row of the ADMIN daily-clicks report (GET /admin/v1/reports/clicks).\nCarries `publisher_cpc_sum` (the unshared gross the sponsor paid) — admin-only.\nThe sponsor and publisher clicks reports have their own row shapes that omit it\n(ReportSponsorClicksDailyRow / ReportPublisherClicksDailyRow).\n\nBacked by JuJu\\Common\\Libraries\\Reports\\ClicksReport.",
            "type": "string",
            "format": "date"
          },
          "publisher_account_id": {
            "description": "Present only when group_by includes account.",
            "type": "integer"
          },
          "publisher_account_name": {
            "description": "Present only when group_by includes account.",
            "type": "string",
            "nullable": true
          },
          "publisher_id": {
            "description": "Present only when group_by includes publisher.",
            "type": "integer"
          },
          "publisher_name": {
            "description": "Present only when group_by includes publisher.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "Present only when group_by includes provider.",
            "type": "integer"
          },
          "job_provider_name": {
            "description": "Present only when group_by includes provider.",
            "type": "string",
            "nullable": true
          },
          "clicks_total": {
            "description": "Every click, including bot + duplicate.",
            "type": "integer"
          },
          "clicks_billable": {
            "description": "Excludes bot + duplicate.",
            "type": "integer"
          },
          "clicks_bot": {
            "type": "integer"
          },
          "clicks_duplicate": {
            "type": "integer"
          },
          "serves_total": {
            "description": "Server-side \"we sent this job\" count.",
            "type": "integer"
          },
          "impressions_total": {
            "description": "Client-confirmed viewport count.",
            "type": "integer"
          },
          "publisher_cpc_sum": {
            "description": "Sum of cpc_at_click for billable clicks. Publisher earnings = this × cpc_share.",
            "type": "string",
            "example": "4211.5500"
          }
        },
        "type": "object"
      },
      "ReportEarningsDailyRow": {
        "title": "Daily Earnings Report Row",
        "description": "One day's share-adjusted earnings for a publisher scope. Money as string DECIMAL.",
        "required": [
          "report_date",
          "clicks_total",
          "earnings"
        ],
        "properties": {
          "report_date": {
            "description": "One row of a daily-earnings report. Publisher-oriented — earnings\nreflect cpc_share × publisher_cpc_sum, computed at query time using\neach account's CURRENT cpc_share.\n\nBacked by JuJu\\Common\\Libraries\\Reports\\EarningsReport::fetch_daily.",
            "type": "string",
            "format": "date"
          },
          "publisher_account_id": {
            "description": "Present only when group_by includes account.",
            "type": "integer"
          },
          "publisher_account_name": {
            "description": "Present only when group_by includes account.",
            "type": "string",
            "nullable": true
          },
          "publisher_id": {
            "description": "Present only when group_by includes publisher.",
            "type": "integer"
          },
          "publisher_name": {
            "description": "Present only when group_by includes publisher.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "Present only when group_by includes provider.",
            "type": "integer"
          },
          "job_provider_name": {
            "description": "Present only when group_by includes provider.",
            "type": "string",
            "nullable": true
          },
          "clicks_total": {
            "type": "integer"
          },
          "clicks_billable": {
            "type": "integer"
          },
          "earnings": {
            "description": "publisher_cpc_sum × cpc_share.",
            "type": "string",
            "example": "2948.09"
          }
        },
        "type": "object"
      },
      "ReportOffersDailyRow": {
        "title": "Daily Offer Report Row",
        "description": "One day's offer-funnel aggregates. Money as string DECIMAL. offer_id / offer_partner_id appear when grouped by offer / partner.",
        "required": [
          "report_date",
          "impressions_total",
          "clicks_total",
          "conversions_total",
          "payout_sum"
        ],
        "properties": {
          "report_date": {
            "description": "One row of a daily offer-funnel report — impressions → clicks → conversions\n→ payout, aggregated from offer.offer_daily_rollup.\n\nBacked by JuJu\\Common\\Libraries\\Reports\\OffersReport. When grouped by offer or\npartner, the row also carries `offer_id` / `offer_partner_id`.",
            "type": "string",
            "format": "date"
          },
          "offer_id": {
            "description": "Present when grouped by offer.",
            "type": "integer"
          },
          "offer_name": {
            "description": "Present when grouped by offer; null if the offer was deleted.",
            "type": "string",
            "nullable": true
          },
          "offer_partner_id": {
            "description": "Present when grouped by partner.",
            "type": "integer"
          },
          "offer_partner_name": {
            "description": "Present when grouped by partner; null if the partner was deleted.",
            "type": "string",
            "nullable": true
          },
          "impressions_total": {
            "type": "integer"
          },
          "clicks_total": {
            "type": "integer"
          },
          "conversions_total": {
            "type": "integer"
          },
          "payout_sum": {
            "description": "SUM(payout_at_submit) for accepted + delivered conversions.",
            "type": "string",
            "example": "1183.4400"
          }
        },
        "type": "object"
      },
      "ReportPublisherClicksDailyRow": {
        "title": "Publisher Daily Clicks Report Row",
        "description": "One day's click aggregates for the publisher's own clicks, with net (share-adjusted) earnings. All money as string DECIMAL.",
        "required": [
          "report_date",
          "clicks_total"
        ],
        "properties": {
          "report_date": {
            "description": "One row of the PUBLISHER clicks report (GET /publisher/v1/reports/clicks),\nbacked by JuJu\\Common\\Libraries\\Reports\\PublisherClicksReport.\n\nDistinct from ReportClicksDailyRow (the admin shape) on purpose: a publisher\nmust NEVER see `publisher_cpc_sum` (the unshared gross the sponsor paid — it\nreveals JuJu's margin). This row carries `earnings` instead: the snapshotted,\nshare-adjusted amount the publisher actually keeps. id + name columns appear\nonly when the matching group_by dimension is requested.",
            "type": "string",
            "format": "date"
          },
          "publisher_account_id": {
            "description": "Present only when group_by includes account.",
            "type": "integer"
          },
          "publisher_account_name": {
            "description": "Present only when group_by includes account.",
            "type": "string",
            "nullable": true
          },
          "publisher_id": {
            "description": "Present only when group_by includes publisher.",
            "type": "integer"
          },
          "publisher_name": {
            "description": "Present only when group_by includes publisher.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "Present only when group_by includes provider.",
            "type": "integer"
          },
          "job_provider_name": {
            "description": "Present only when group_by includes provider.",
            "type": "string",
            "nullable": true
          },
          "clicks_total": {
            "description": "Every click, including bot + duplicate.",
            "type": "integer"
          },
          "clicks_billable": {
            "description": "Excludes bot + duplicate.",
            "type": "integer"
          },
          "clicks_bot": {
            "type": "integer"
          },
          "clicks_duplicate": {
            "type": "integer"
          },
          "serves_total": {
            "description": "Server-side \"we sent this job\" count.",
            "type": "integer"
          },
          "impressions_total": {
            "description": "Client-confirmed viewport count.",
            "type": "integer"
          },
          "earnings": {
            "description": "Net earnings the publisher keeps for billable clicks — snapshotted cpc_at_click × cpc_share at roll time. (The unshared gross is deliberately not exposed to publishers.)",
            "type": "string",
            "example": "1473.9000"
          }
        },
        "type": "object"
      },
      "ReportSpendDailyRow": {
        "title": "Daily Spend Report Row",
        "description": "One day's spend aggregates for a sponsor scope. Money as string DECIMAL.",
        "required": [
          "report_date",
          "clicks_total",
          "spend"
        ],
        "properties": {
          "report_date": {
            "description": "One row of a daily-spend report. Sponsor-oriented — spend is what the\nsponsor paid, aggregated from click_sponsor_daily_rollup.\n\nBacked by JuJu\\Common\\Libraries\\Reports\\SpendReport::fetch_daily.",
            "type": "string",
            "format": "date"
          },
          "campaign_id": {
            "description": "Present only when group_by includes campaign.",
            "type": "integer"
          },
          "campaign_name": {
            "description": "Present only when group_by includes campaign.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "Present only when group_by includes provider.",
            "type": "integer"
          },
          "job_provider_name": {
            "description": "Present only when group_by includes provider.",
            "type": "string",
            "nullable": true
          },
          "segment_id": {
            "description": "Present only when group_by includes segment.",
            "type": "integer"
          },
          "segment_name": {
            "description": "Present only when group_by includes segment.",
            "type": "string",
            "nullable": true
          },
          "job_partner_id": {
            "description": "Present only when group_by includes sponsor.",
            "type": "integer"
          },
          "job_partner_name": {
            "description": "Present only when group_by includes sponsor.",
            "type": "string",
            "nullable": true
          },
          "clicks_total": {
            "type": "integer"
          },
          "spend": {
            "description": "Sum of cpc_at_click for billable clicks (bot + duplicate excluded).",
            "type": "string",
            "example": "4211.5500"
          },
          "serves_total": {
            "type": "integer"
          },
          "impressions_total": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ReportSponsorClicksDailyRow": {
        "title": "Sponsor Daily Clicks Report Row",
        "description": "One day's click aggregates for the sponsor's own inventory. campaign_id / job_provider_id / segment_id are present only when the matching group_by dimension is requested.",
        "required": [
          "report_date",
          "clicks_total"
        ],
        "properties": {
          "report_date": {
            "description": "One row of the SPONSOR clicks report (GET /sponsor/v1/reports/clicks),\nbacked by JuJu\\Common\\Libraries\\Reports\\SponsorClicksReport on the sponsor\nclick rollup.\n\nDistinct from ReportClicksDailyRow (the admin/publisher shape) on purpose:\nthe sponsor report is sourced from the sponsor rollup, which has no publisher\ncolumns — so there is deliberately NO publisher_cpc_sum, publisher_account_id,\nor publisher_id here. Dimension columns (campaign_id, job_provider_id,\nsegment_id) appear only when requested via group_by.",
            "type": "string",
            "format": "date"
          },
          "campaign_id": {
            "description": "Present only when group_by includes campaign.",
            "type": "integer"
          },
          "campaign_name": {
            "description": "Present only when group_by includes campaign.",
            "type": "string",
            "nullable": true
          },
          "job_provider_id": {
            "description": "Present only when group_by includes provider.",
            "type": "integer"
          },
          "job_provider_name": {
            "description": "Present only when group_by includes provider.",
            "type": "string",
            "nullable": true
          },
          "segment_id": {
            "description": "Present only when group_by includes segment.",
            "type": "integer"
          },
          "segment_name": {
            "description": "Present only when group_by includes segment.",
            "type": "string",
            "nullable": true
          },
          "clicks_total": {
            "description": "Every click, including bot + duplicate.",
            "type": "integer"
          },
          "clicks_billable": {
            "description": "Excludes bot + duplicate.",
            "type": "integer"
          },
          "clicks_bot": {
            "type": "integer"
          },
          "clicks_duplicate": {
            "type": "integer"
          },
          "serves_total": {
            "description": "Server-side \"we sent this job\" count.",
            "type": "integer"
          },
          "impressions_total": {
            "description": "Client-confirmed viewport count.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "sponsorCallbackKey": {
        "type": "http",
        "description": "Per-sponsor conversion-callback key (Bearer). Issued in the admin console per sponsor; one key covers all that sponsor's providers; used ONLY on POST /api/v1/conversions.",
        "scheme": "bearer"
      },
      "publisherApiKey": {
        "type": "http",
        "description": "Publisher API key (Bearer), issued per publisher.publisher_account in the admin console. Required on the api.juju.com job + feed endpoints. Presented as `Authorization: Bearer <key>`; `X-API-Key` is NOT accepted. A missing OR invalid key both return 401.",
        "scheme": "bearer"
      }
    }
  },
