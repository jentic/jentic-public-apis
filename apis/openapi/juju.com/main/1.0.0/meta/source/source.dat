              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "List or sponsor not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Sponsor already assigned to this list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
