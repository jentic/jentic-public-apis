                                "type": "boolean"
                              },
                              "date_created": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "type": "object"
                          }
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "List not found.",
