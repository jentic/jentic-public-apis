    "/sponsor/v1/billing/balance": {
      "get": {
        "tags": [
          "Invoice"
        ],
        "summary": "Invoice - My Balance",
        "description": "AR balance for the logged-in sponsor. Positive = owed; negative = on-account credit.",
        "operationId": "79ee97b051e85398cf88d8c99acf2994",
