    "/admin/v1/offers/{offer_id}/zipcodes": {
      "get": {
        "tags": [
          "Offer Zipcode"
        ],
        "summary": "Offer Zipcode - List",
        "description": "Paginated list of zipcodes allowlisted for this offer. NO rows = \"all US eligible\"; empty response is meaningful.",
        "operationId": "d0085578d545a96f7c8b620006dffdee",
