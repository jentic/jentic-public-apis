    "/admin/v1/offers": {
      "get": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - List",
        "description": "Paginated. Filters: q (substring on name), active, paused, offer_partner_id, priority_tier_id, test_mode.",
        "operationId": "8aa3eebacb992a6d6f5c48afa1035616",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "paused",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "test_mode",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "offer_partner_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "priority_tier_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "date_created",
                "date_updated",
                "priority_tier_id",
                "tier_weight",
                "payout",
                "active",
                "paused"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated offer list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Offer"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMeta"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Offer"
        ],
        "summary": "Offer - Create",
        "description": "Body: offer_partner_id*, name*, priority_tier_id*. All other fields optional with sensible defaults. offer_partner_id is IMMUTABLE post-create — pick carefully. FE pre-fills from offer_partner.offer_defaults before the POST (server does not auto-merge). All money as string.",
        "operationId": "99386a8df1e29ebb05dfbb8ed4ba5b78",
        "responses": {
          "201": {
            "description": "Created offer.",
            "content": {
              "application/json": {
