    "/admin/v1/billing/payouts/{id}/issue": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "Payout - Issue",
        "description": "Draft → pending: queues the transfer and posts the publisher ledger credit (earnings recognized). The actual bank transfer runs through the gateway once wired.",
        "operationId": "ff28e27d1ad2aeb9062706bd11fe5a53",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issued payout.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Payout"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Not a draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/payouts/{id}/hold": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "Payout - Hold",
        "description": "Pause a draft/pending payout so the transfer worker skips it. Does not change the ledger (we still owe it) — just delays sending.",
        "operationId": "ad27e896f637fedf8b697b64d78c6bd7",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Held payout.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Payout"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Not holdable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/billing/payouts/{id}/release": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "Payout - Release",
        "description": "Un-hold a payout. Returns to pending if it was already issued (a ledger credit exists), else back to draft for re-issue.",
        "operationId": "afe5e54a57803efff9c4f63ea848600c",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Released payout.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/JsonEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Payout"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Not on hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonEnvelope"
                }
              }
            }
          }
        }
      }
    },
