{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio management and tracker API",
    "version": "1.0.0",
    "description": "API for managing financial portfolios, bank/demat linking, assets, liabilities, and computing net worth and profit and loss (pnl).\n",
    "license": {
      "name": "MIT"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/abc-63d-321/GeneratedAPI_2026-02-28-0936/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.wealthapp.com/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "examples": [
              "Invalid input",
              "Unauthorized",
              "Not found"
            ]
          },
          "code": {
            "type": "integer",
            "examples": [
              400,
              401,
              404,
              500
            ]
          },
          "details": {
            "type": "string",
            "examples": [
              "Asset value must be positive",
              "Bearer token is missing or expired"
            ]
          }
        }
      },
      "UserRegister": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          }
        }
      },
      "UserLogin": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "DematAccount": {
        "type": "object",
        "required": [
          "broker_name",
          "account_number"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "broker_name": {
            "type": "string"
          },
          "account_number": {
            "type": "string"
          },
          "linked_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "BankAccount": {
        "type": "object",
        "required": [
          "bank_name",
          "account_number"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "bank_name": {
            "type": "string"
          },
          "account_number": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "minimum": 0
          },
          "linked_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "name",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "STOCK",
              "MUTUAL_FUND",
              "CRYPTO",
              "REAL_ESTATE",
              "GOLD",
              "OTHER"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "MANUAL",
              "DEMAT_LINKED",
              "BANK_LINKED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "Liability": {
        "type": "object",
        "required": [
          "name",
          "amount"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "LOAN",
              "CREDIT_CARD",
              "MORTGAGE",
              "OTHER"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "MANUAL",
              "BANK_LINKED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "NetWorthSummary": {
        "type": "object",
        "properties": {
          "total_assets": {
            "type": "number"
          },
          "total_liabilities": {
            "type": "number"
          },
          "net_worth": {
            "type": "number"
          },
          "total_financial_pnl": {
            "type": "number"
          }
        }
      },
      "PnLSummary": {
        "type": "object",
        "properties": {
          "total_pnl": {
            "type": "number"
          },
          "realized_pnl": {
            "type": "number"
          },
          "unrealized_pnl": {
            "type": "number"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — invalid or missing input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "badRequest": {
                "value": {
                  "message": "Invalid input",
                  "code": 400,
                  "details": "Required field is missing or malformed"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized — missing or invalid JWT token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unauthorized": {
                "value": {
                  "message": "Unauthorized",
                  "code": 401,
                  "details": "Bearer token is missing or expired"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden — insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "forbidden": {
                "value": {
                  "message": "Forbidden",
                  "code": 403,
                  "details": "You do not have access to this resource"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "notFound": {
                "value": {
                  "message": "Not found",
                  "code": 404,
                  "details": "The requested resource does not exist"
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict — resource already exists",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "conflict": {
                "value": {
                  "message": "Conflict",
                  "code": 409,
                  "details": "An account with this number is already linked"
                }
              }
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Unprocessable entity — business rule violation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unprocessable": {
                "value": {
                  "message": "Unprocessable entity",
                  "code": 422,
                  "details": "Asset value must be a positive number"
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "serverError": {
                "value": {
                  "message": "Internal server error",
                  "code": 500,
                  "details": "An unexpected error occurred. Please try again later."
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegister"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Signed JWT access token"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/accounts/demat": {
      "post": {
        "summary": "Link demat account",
        "tags": [
          "Demat Accounts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DematAccount"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Demat account linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DematAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Get all linked demat accounts",
        "tags": [
          "Demat Accounts"
        ],
        "responses": {
          "200": {
            "description": "List of demat accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DematAccount"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/accounts/bank": {
      "post": {
        "summary": "Link bank account",
        "tags": [
          "Bank Accounts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankAccount"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bank account linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Get all linked bank accounts",
        "tags": [
          "Bank Accounts"
        ],
        "responses": {
          "200": {
            "description": "List of bank accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BankAccount"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/assets": {
      "post": {
        "summary": "Add new asset",
        "tags": [
          "Assets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Asset"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Asset created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Get all assets",
        "tags": [
          "Assets"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of assets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Asset"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/liabilities": {
      "post": {
        "summary": "Add new liability",
        "tags": [
          "Liabilities"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Liability"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Liability created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liability"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Get all liabilities",
        "tags": [
          "Liabilities"
        ],
        "responses": {
          "200": {
            "description": "List of liabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Liability"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/networth": {
      "get": {
        "summary": "Get net worth summary",
        "tags": [
          "Net Worth"
        ],
        "description": "Calculates total assets minus total liabilities",
        "responses": {
          "200": {
            "description": "Net worth details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetWorthSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/portfolio/pnl": {
      "get": {
        "summary": "Get financial portfolio PnL",
        "tags": [
          "Portfolio"
        ],
        "responses": {
          "200": {
            "description": "PnL breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PnLSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  }
}
