      "patch": {
        "tags": [
          "Franquias"
        ],
        "summary": "Atualizar franquia",
        "description": "Atualiza informações de uma franquia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFranquia"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Franquia atualizada com sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Franquias"
        ],
        "summary": "Excluir franquia",
        "description": "Remove uma franquia do sistema",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Franquia excluída com sucesso"
          }
        }
      }
    }
  },
