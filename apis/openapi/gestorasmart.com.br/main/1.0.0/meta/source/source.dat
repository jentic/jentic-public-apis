{
  "openapi": "3.0.0",
  "info": {
    "title": "CRM Smart API",
    "description": "Documentação completa da API do CRM Smart - Sistema de gerenciamento de vendas, clientes, contratos, pedidos e estoque",
    "version": "1.0.0",
    "contact": {
      "name": "Gestora Smart",
      "url": "https://crm.gestorasmart.com.br"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VICTORPAES_1/crm-smart-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://crm.gestorasmart.com.br",
      "description": "Servidor de Produção"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Endpoints para autenticação e gerenciamento de sessão"
    },
    {
      "name": "Usuários",
      "description": "Gerenciamento de usuários do sistema"
    },
    {
      "name": "Clientes",
      "description": "Gerenciamento de clientes"
    },
    {
      "name": "Vendedores",
      "description": "Gerenciamento de vendedores e indicadores"
    },
    {
      "name": "Contratos",
      "description": "Gerenciamento de contratos"
    },
    {
      "name": "Pedidos",
      "description": "Gerenciamento de pedidos"
    },
    {
      "name": "Produtos",
      "description": "Gerenciamento de produtos"
    },
    {
      "name": "Simcards",
      "description": "Gerenciamento de simcards"
    },
    {
      "name": "IMEIs",
      "description": "Gerenciamento de IMEIs"
    },
    {
      "name": "Endereços",
      "description": "Gerenciamento de endereços"
    },
    {
      "name": "Representantes",
      "description": "Gerenciamento de representantes"
    },
    {
      "name": "Promoções",
      "description": "Gerenciamento de promoções"
    },
    {
      "name": "Regras de Aprovação",
      "description": "Gerenciamento de regras de aprovação de contratos"
    },
    {
      "name": "Franquias",
      "description": "Gerenciamento de franquias"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Realizar login no sistema",
        "description": "Autentica o usuário e retorna informações básicas. Um código de verificação será enviado por email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@gestorasmart.com.br",
                    "description": "Email do usuário"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 6,
                    "example": "admin123",
                    "description": "Senha do usuário (mínimo 6 caracteres)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login bem-sucedido - Código de verificação enviado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "ID do usuário para verificação"
                    },
                    "message": {
                      "type": "string",
                      "example": "Código de verificação enviado"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/auth/verify-code": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Verificar código de autenticação",
        "description": "Valida o código enviado por email e retorna o token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "code"
                ],
                "properties": {
                  "userId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "ID do usuário retornado no login"
                  },
                  "code": {
                    "type": "string",
                    "example": "123456",
                    "description": "Código de 6 dígitos enviado por email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código verificado com sucesso",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...; HttpOnly; Path=/; Max-Age=604800"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "Token JWT para autenticação"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Código inválido ou expirado"
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Obter perfil do usuário autenticado",
        "description": "Retorna informações do usuário logado",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Realizar logout",
        "description": "Remove o cookie de autenticação",
        "responses": {
          "200": {
            "description": "Logout realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Logout realizado com sucesso"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/create": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Criar novo usuário (Admin apenas)",
        "description": "Cria um novo usuário no sistema. Requer permissão de ADMIN.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Usuário cadastrado com sucesso."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permissão negada - Apenas administradores"
          }
        }
      }
    },
    "/users/list": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Listar usuários (Admin apenas)",
        "description": "Lista todos os usuários com paginação e filtro por nome",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtrar por nome do usuário"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Número da página"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Quantidade de itens por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "example": 50
                    },
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/user": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Obter dados do usuário autenticado",
        "description": "Retorna informações completas do usuário logado",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Buscar usuário por ID",
        "description": "Retorna informações de um usuário específico",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID do usuário"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Atualizar usuário",
        "description": "Atualiza informações de um usuário",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID do usuário"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Usuário atualizado com sucesso."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/image": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Obter URL da imagem do usuário",
        "description": "Retorna a URL da foto de perfil do usuário autenticado",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "URL da imagem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "image_url": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://cdn.gestorasmart.com.br/users/photo.jpg"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Upload de imagem de perfil",
        "description": "Faz upload de uma imagem de perfil para o usuário",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Arquivo de imagem (JPG, PNG, etc)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imagem enviada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://cdn.gestorasmart.com.br/users/photo.jpg"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cliente": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Listar clientes",
        "description": "Lista todos os clientes com paginação e filtros",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Buscar por nome, email, CPF ou CNPJ"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Cliente"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Criar novo cliente",
        "description": "Cadastra um novo cliente no sistema",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCliente"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          }
        }
      }
    },
    "/cliente/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Buscar cliente por ID",
        "description": "Retorna informações detalhadas de um cliente",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do cliente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Atualizar cliente",
        "description": "Atualiza informações de um cliente",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCliente"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente atualizado com sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Excluir cliente",
        "description": "Remove um cliente do sistema",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente excluído com sucesso"
          }
        }
      }
    },
    "/cliente/importar-massa": {
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Importar clientes em massa",
        "description": "Importa múltiplos clientes de uma vez",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clientes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CreateCliente"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Clientes importados com sucesso"
          }
        }
      }
    },
    "/cliente/indicador/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Listar clientes de um indicador",
        "description": "Retorna clientes vinculados a um indicador específico",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes do indicador"
          }
        }
      }
    },
    "/contratos/list": {
      "get": {
        "tags": [
          "Contratos"
        ],
        "summary": "Listar contratos",
        "description": "Lista contratos com filtros avançados e paginação",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "cliente_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filtrar por ID do cliente"
          },
          {
            "name": "tipo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "simcard",
                "hardware"
              ]
            },
            "description": "Filtrar por tipo de contrato"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Buscar em múltiplos campos"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtrar por status"
          },
          {
            "name": "dateFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data inicial"
          },
          {
            "name": "dateTo",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data final"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contratos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Contrato"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contratos": {
      "post": {
        "tags": [
          "Contratos"
        ],
        "summary": "Criar novo contrato",
        "description": "Cadastra um novo contrato no sistema",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContrato"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contrato criado com sucesso"
          }
        }
      }
    },
    "/contratos/list-one": {
      "get": {
        "tags": [
          "Contratos"
        ],
        "summary": "Buscar contrato por ID",
        "description": "Retorna detalhes de um contrato específico",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do contrato"
          }
        }
      }
    },
    "/contratos/{id}/status": {
      "put": {
        "tags": [
