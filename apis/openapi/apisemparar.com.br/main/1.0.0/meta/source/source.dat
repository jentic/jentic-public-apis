{
  "openapi": "3.1.0",
  "info": {
    "title": "Pedido Varejo Digital",
    "version": "1.0.0",
    "description": "API para operações de pedido no varejo digital Sem Parar.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VALDENISOUSA/pedido-varejo-digital/1.0.0"
  },
  "servers": [
    {
      "url": "https://homolog.apisemparar.com.br",
      "description": "QA"
    },
    {
      "url": "https://prod.apisemparar.com.br",
      "description": "Produção"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "ObterDispositivoRequest": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "numeroIdentificadorTid": {
                "type": "string"
              }
            }
          },
          {
            "properties": {
              "numeroIdentificador": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ValidarClienteRequest": {
        "type": "object",
        "properties": {
          "codigoEmpresa": {
            "type": "string"
          },
          "nrCpfCnpj": {
            "type": "string"
          },
          "canalVendaMotor": {
            "type": "string"
          }
        },
        "required": [
          "codigoEmpresa",
          "nrCpfCnpj",
          "canalVendaMotor"
        ]
      },
      "ValidarPlacaRequest": {
        "type": "object",
        "properties": {
          "codigoEmpresa": {
            "type": "string"
          },
          "nrCpfCnpj": {
            "type": "string"
          },
          "placaVeiculo": {
            "type": "string"
          },
          "numeroDispositivo": {
            "type": "string"
          }
        },
        "required": [
          "codigoEmpresa",
          "nrCpfCnpj",
          "placaVeiculo"
        ]
      },
      "CadastrarClienteRequest": {
        "type": "object",
        "properties": {
          "codigoEmpresa": {
            "type": "string"
          },
          "nrCpfCnpj": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "rg": {
            "type": "string"
          },
          "genero": {
            "type": "integer"
          },
          "usuario": {
            "type": "string"
          },
          "endereco": {
            "type": "object",
            "properties": {
              "cep": {
                "type": "string"
              },
              "logradouro": {
                "type": "string"
              },
              "numero": {
                "type": "string"
              },
              "complemento": {
                "type": "string"
              },
              "bairro": {
                "type": "string"
              },
              "cidade": {
                "type": "string"
              },
              "estado": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "codigoEmpresa",
          "nrCpfCnpj",
          "nome",
          "email",
          "telefone"
        ]
      },
      "CadastrarPedidoRequest": {
        "type": "object",
        "properties": {
          "codigoEmpresa": {
            "type": "string"
          },
          "pedido": {
            "type": "object",
            "properties": {
              "canalEntrada": {
                "type": "integer"
              },
              "tipo": {
                "type": "integer"
              },
              "codigoCliente": {
                "type": "string"
              },
              "dadosVendedor": {
                "type": "object",
                "properties": {
                  "canal": {
                    "type": "integer"
                  },
                  "loja": {
                    "type": "integer"
                  },
                  "vendedor": {
                    "type": "integer"
                  },
                  "vendedorLoja": {
                    "type": "integer"
                  },
                  "usuario": {
                    "type": "string"
                  },
                  "numeroTelefone": {
                    "type": "string"
                  }
                }
              },
              "listaItem": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ofertaComercial": {
                      "type": "string"
                    },
                    "dadosVeiculo": {
                      "type": "object",
                      "properties": {
                        "idMarca": {
                          "type": "integer"
                        },
                        "idModelo": {
                          "type": "integer"
                        },
                        "placa": {
                          "type": "string"
                        },
                        "anoFabricacao": {
                          "type": "string"
                        },
                        "categoria": {
                          "type": "integer"
                        }
                      }
                    },
                    "promocao": {
                      "type": "string"
                    },
                    "valorDisparo": {
                      "type": "number"
                    },
                    "emailConta": {
                      "type": "string"
                    },
                    "modalidadePagamento": {
                      "type": "integer"
                    },
                    "tipoEntrega": {
                      "type": "integer"
                    },
                    "formaPagamento": {
                      "type": "integer"
                    },
                    "dadosPagamento": {
                      "type": "object",
                      "properties": {
                        "codigoBandeira": {
                          "type": "string"
                        },
                        "numeroCartao": {
                          "type": "string",
                          "enum": [
                            "100001 AMEX",
                            "100003 MASTER",
                            "100004 VISA",
                            "100001000 ELO"
                          ]
                        },
                        "mesVencimento": {
                          "type": "string"
                        },
                        "anoVencimento": {
                          "type": "string"
                        },
                        "nomeCliente": {
                          "type": "string"
                        }
                      }
                    },
                    "enderecoEntrega": {
                      "type": "object",
                      "properties": {
                        "cep": {
                          "type": "string"
                        },
                        "logradouro": {
                          "type": "string"
                        },
                        "numero": {
                          "type": "string"
                        },
                        "complemento": {
                          "type": "string"
                        },
                        "bairro": {
                          "type": "string"
                        },
                        "cidade": {
                          "type": "string"
                        },
                        "estado": {
                          "type": "integer"
                        },
                        "descricaoEstado": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "observacao": {
                "type": "string"
              }
            }
          }
        }
      },
      "FinalizarPedidoRequest": {
        "type": "object",
        "properties": {
          "idTransacao": {
            "type": "string"
          },
          "deviceFingerprintID": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "canalVendaMotor": {
            "type": "string"
          },
          "deviceIP": {
            "type": "string"
          }
        },
        "required": [
          "idTransacao",
          "usuario"
        ]
      },
      "StatusPedidoRequest": {
        "type": "object",
        "properties": {
          "numeroDocumento": {
            "type": "string"
          }
        },
        "required": [
          "numeroDocumento"
        ]
      },
      "ValidarPagamentoRequest": {
        "type": "object",
        "properties": {
          "numeroCartao": {
            "type": "string"
          },
          "mesVencimento": {
            "type": "string"
          },
          "anoVencimento": {
            "type": "string"
          },
          "nomeCliente": {
            "type": "string"
          },
          "codigoCliente": {
            "type": "string"
          },
          "bandeiraCartao": {
            "type": "string"
          },
          "descricaoSistema": {
            "type": "string"
          },
          "empresa": {
            "type": "string"
          },
          "tipoDocumentoCliente": {
            "type": "string"
          },
          "documentoCliente": {
            "type": "string"
          }
        },
        "required": [
          "numeroCartao",
          "mesVencimento",
          "anoVencimento",
          "nomeCliente"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "codigoRetorno": {
            "type": "integer"
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "ValidarClienteResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object",
            "properties": {
              "PREPAGO": {
                "type": "string"
              },
              "POSPAGO": {
                "type": "string"
              },
              "formasPagamentos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "ValidarPlacaResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object",
            "properties": {
              "dispositivo": {
                "type": "object",
                "properties": {
                  "codigoEmpresa": {
                    "type": "string"
                  },
                  "codigoLoja": {
                    "type": "string"
                  },
                  "codigoVendedor": {
                    "type": "string"
                  },
                  "codigoVendedorPontoVenda": {
                    "type": "string"
                  },
                  "codigoCanalVenda": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "CadastrarClienteResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object",
            "properties": {
              "codigoCliente": {
                "type": "string"
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "CadastrarPedidoResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object",
            "properties": {
              "idTransacao": {
                "type": "string"
              },
              "numeroPedido": {
                "type": "string"
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "FinalizarPedidoResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "StatusPedidoResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "numeroPedido": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "descricaoStatus": {
                  "type": "string"
                },
                "motivoStatus": {
                  "type": "string"
                },
                "descricaoMotivoStatus": {
                  "type": "string"
                },
                "classeMotivo": {
                  "type": "string"
                },
                "dataPedido": {
                  "type": "string",
                  "format": "date-time"
                },
                "tipoEntrega": {
                  "type": "string"
                },
                "descricaoTipoEntrega": {
                  "type": "string"
                },
                "pdvAtribuicao": {
                  "type": "string"
                },
                "qtdeVeiculosAutorizados": {
                  "type": "string"
                },
                "qtdeVeiculosPedido": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "LogisticaResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "object",
            "properties": {
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "delivery": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "integer"
                        },
                        "time": {
                          "type": "integer"
                        }
                      }
                    },
                    "carrier": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ObterDispositivoResponse": {
        "type": "object",
        "properties": {
          "dados": {
            "type": "object",
            "properties": {
              "dispositivo": {
                "type": "object",
                "properties": {
                  "numeroIdentificador": {
                    "type": "string"
                  },
                  "codigoLoja": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/site/v1/dispositivo/obter": {
      "post": {
        "summary": "Obter dispositivo",
        "tags": [
          "Dispositivo"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObterDispositivoRequest"
              },
              "examples": {
                "exemplo1": {
                  "summary": "Exemplo com numeroIdentificadorTid",
                  "value": {
                    "numeroIdentificadorTid": "104900038895344"
                  }
                },
                "exemplo2": {
                  "summary": "Exemplo com numeroIdentificador",
                  "value": {
                    "numeroIdentificador": "0726998876"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispositivo obtido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObterDispositivoResponse"
                },
                "examples": {
                  "sucesso": {
                    "summary": "Exemplo de resposta sucesso",
                    "value": {
                      "dados": {
                        "dispositivo": {
                          "numeroIdentificador": "07269988763",
                          "codigoLoja": "17002"
                        }
                      },
                      "status": {
                        "codigoRetorno": 0,
                        "mensagem": "Sucesso"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/varejo/v1/cliente/validar": {
      "post": {
        "summary": "Validar cliente",
        "tags": [
          "Cliente"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidarClienteRequest"
              },
              "examples": {
                "exemplo1": {
                  "summary": "Exemplo de validação",
                  "value": {
                    "codigoEmpresa": "CGMP",
                    "nrCpfCnpj": "32686587091",
                    "canalVendaMotor": "10005"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente validado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidarClienteResponse"
                },
                "examples": {
                  "sucesso": {
                    "summary": "Exemplo de resposta sucesso",
                    "value": {
                      "dados": {
                        "PREPAGO": "SIM",
                        "POSPAGO": "NÃO",
                        "formasPagamentos": []
                      },
                      "status": {
                        "codigoRetorno": 0,
                        "mensagem": "Sucesso"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/varejo/v1/placa/validar": {
      "post": {
        "summary": "Validar placa",
        "tags": [
          "Placa"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidarPlacaRequest"
              },
              "examples": {
                "exemplo1": {
                  "summary": "Exemplo de validação de placa",
                  "value": {
                    "codigoEmpresa": "CGMP",
                    "nrCpfCnpj": "32686587091",
                    "placaVeiculo": "RRR0099",
                    "numeroDispositivo": "0735037731"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Placa validada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidarPlacaResponse"
                },
                "examples": {
                  "sucesso": {
                    "summary": "Exemplo de resposta sucesso",
                    "value": {
                      "dados": {
                        "dispositivo": {
                          "codigoEmpresa": "CGMP",
                          "codigoLoja": "7043",
                          "codigoVendedor": "89891",
                          "codigoVendedorPontoVenda": "167371",
                          "codigoCanalVenda": "38"
                        }
                      },
                      "status": {
                        "codigoRetorno": 0,
                        "mensagem": "Sucesso"
                      }
                    }
                  },
                  "invalida": {
                    "summary": "Exemplo de placa invalida",
                    "value": {
                      "dados": {
                        "dispositivo": {
                          "codigoEmpresa": "CGMP",
                          "codigoLoja": "7043",
                          "codigoVendedor": "89891",
                          "codigoVendedorPontoVenda": "167371",
                          "codigoCanalVenda": "38"
                        }
                      },
                      "status": {
                        "codigoRetorno": "-1004",
                        "mensagem": "Placa cadastrada em um contrato de outro cliente."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
