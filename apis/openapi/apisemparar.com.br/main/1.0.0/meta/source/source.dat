    "/varejo/v1/pedido/finalizar": {
      "post": {
        "summary": "Finalizar pedido",
        "tags": [
          "Pedido"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalizarPedidoRequest"
              },
              "examples": {
                "exemplo1": {
