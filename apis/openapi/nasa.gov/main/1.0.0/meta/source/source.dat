{
  "openapi": "3.0.3",
  "info": {
    "title": "NASA Image and Video Library API",
    "description": "Access NASA's large media archive of images, video, and audio. Search, browse, and retrieve assets and metadata. No authentication required.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://images.nasa.gov/docs/images.nasa.gov%20API.pdf",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://images-api.nasa.gov"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "operationId": "searchMedia",
        "summary": "Search the NASA Image and Video Library",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Free text search terms",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "center",
            "in": "query",
            "description": "NASA center that published the media",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "description": "Terms to search for in the description field",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description_508",
            "in": "query",
            "description": "Terms to search for in the 508 description field",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keywords",
            "in": "query",
            "description": "Comma-separated keywords to search for",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Terms to search for in the location field",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "media_type",
            "in": "query",
            "description": "Media type filter",
            "schema": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ]
            }
          },
          {
            "name": "nasa_id",
            "in": "query",
            "description": "The NASA ID to search for",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "photographer",
            "in": "query",
            "description": "The primary photographer's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secondary_creator",
            "in": "query",
            "description": "A secondary photographer or videographer's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "Terms to search for in the title field",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_start",
            "in": "query",
            "description": "Start year for results (YYYY format)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_end",
            "in": "query",
            "description": "End year for results (YYYY format)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for results",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "href": {
                          "type": "string"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "href": {
                                "type": "string"
                              },
                              "data": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "center": {
                                      "type": "string"
                                    },
                                    "title": {
                                      "type": "string"
                                    },
                                    "nasa_id": {
                                      "type": "string"
                                    },
                                    "date_created": {
                                      "type": "string"
                                    },
                                    "keywords": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      }
                                    },
                                    "media_type": {
                                      "type": "string"
                                    },
                                    "description_508": {
                                      "type": "string"
                                    },
                                    "secondary_creator": {
                                      "type": "string"
                                    },
                                    "description": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "links": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "href": {
                                      "type": "string"
                                    },
                                    "rel": {
                                      "type": "string"
                                    },
                                    "render": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "metadata": {
                          "type": "object",
                          "properties": {
                            "total_hits": {
                              "type": "integer"
                            }
                          }
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "rel": {
                                "type": "string"
                              },
                              "prompt": {
                                "type": "string"
                              },
                              "href": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/asset/{nasa_id}": {
      "get": {
        "operationId": "getAsset",
        "summary": "Get media asset manifest for a NASA ID",
        "parameters": [
          {
            "name": "nasa_id",
            "in": "path",
            "required": true,
            "description": "The NASA ID of the asset",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Asset manifest with links to media files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "href": {
                          "type": "string"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "href": {
                                "type": "string",
                                "format": "uri"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Asset not found"
          }
        }
      }
    },
    "/metadata/{nasa_id}": {
      "get": {
        "operationId": "getMetadata",
        "summary": "Get metadata location for a NASA ID",
        "parameters": [
          {
            "name": "nasa_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata location",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Metadata not found"
          }
        }
      }
    },
    "/captions/{nasa_id}": {
      "get": {
        "operationId": "getCaptions",
        "summary": "Get video captions location for a NASA ID",
        "parameters": [
          {
            "name": "nasa_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Captions file location",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Captions not found"
          }
        }
      }
    },
    "/album/{album_name}": {
      "get": {
        "operationId": "getAlbum",
        "summary": "Get assets in a specific album",
        "parameters": [
          {
            "name": "album_name",
            "in": "path",
            "required": true,
            "description": "Album name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Album contents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
