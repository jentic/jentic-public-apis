{
  "openapi": "3.0.4",
  "info": {
    "title": "Food Info",
    "description": "Nutrition data for millions of foods, merged from five national food-composition datasets: USDA FoodData Central (US), McCance & Widdowson's CoFID (UK), ANSES Ciqual (France), the Danish Food Composition Database, and FSANZ AUSNUT (Australia/NZ), plus Open Food Facts for branded products.\n\nAuthenticate with an API key in the `X-Api-Key` header. A free account gets a key with 10 requests/minute and 100/day; the Practitioner plan raises that to 60/minute and 10,000/day. Quotas are counted per account, not per key. Every response carries `X-RateLimit-Limit-Minute`, `X-RateLimit-Limit-Day` and `X-RateLimit-Tier`.\n\nServer-to-server only: CORS is not enabled, so keys stay off the browser.",
    "contact": {
      "name": "Food Info",
      "url": "https://food-info.org/developer",
      "email": "info@food-info.org"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.food-info.org"
    }
  ],
  "paths": {
    "/api/v1/nutrients": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "List the nutrient catalogue (id, name, unit, category) so callers can discover the\n            `nutrientId` values used by the reverse-search endpoints.",
        "operationId": "listNutrients",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NutrientDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/foods/search": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "Search foods by name (case-insensitive substring).",
        "operationId": "searchFoods",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "home_nation",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FoodSearchResultDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/foods/{id}": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "Look up a single food by FoodData Central id.",
        "operationId": "getFood",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodSummaryDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/foods/{id}/panel": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "Full nutrient panel for a food: grouped per-100 g + per-serving amounts and\n            % reference-intake values. `source` selects the RI basis (\"UK RI\" / \"FDA 2016\").",
        "operationId": "getFoodNutrientPanel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "portionId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodPanelDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nutrients/{nutrientId}/top-foods": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "Reverse nutrient search: reference foods richest in a nutrient, per 100 g, highest first.",
        "operationId": "listTopFoodsByNutrient",
        "parameters": [
          {
            "name": "nutrientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "home_nation",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopByNutrientDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nutrients/{nutrientId}/bottom-foods": {
      "get": {
        "tags": [
          "ApiV1"
        ],
        "summary": "Inverse of top-foods: reference foods with the LEAST of a nutrient, per 100 g.",
        "operationId": "listBottomFoodsByNutrient",
        "parameters": [
          {
            "name": "nutrientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "home_nation",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopByNutrientDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/parse": {
      "post": {
        "tags": [
          "RecipesApi"
        ],
        "summary": "Parse raw ingredient lines into structured {quantity, unit, food, …}. No DB, no food match.",
        "operationId": "parseRecipeIngredients",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeParseRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeParseRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeParseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ParsedIngredient"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/analyze": {
      "post": {
        "tags": [
          "RecipesApi"
        ],
        "summary": "Analyze a recipe → per-line resolution + per-serving/per-100 g nutrition + source attribution + review flags.",
        "operationId": "analyzeRecipeNutrition",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeAnalysisRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeAnalysisRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeAnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeAnalysis"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataType": {
        "enum": [
          "SrLegacy",
          "Foundation",
          "Branded",
          "SurveyFndds",
          "Sample",
          "AgriculturalAcquisition",
          "MarketAcquisition",
          "SubSample",
          "Experimental",
          "Other",
          "CofidUk",
          "Ciqual",
          "Frida",
          "Ausnut",
          "OpenFoodFacts",
          "Cnf",
          "Fineli"
        ],
        "type": "string"
      },
      "FoodPanelDto": {
        "type": "object",
        "properties": {
          "foodId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "foodCategory": {
            "type": "string",
            "nullable": true
          },
          "foodCategoryId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ndbNumber": {
            "type": "string",
            "nullable": true
          },
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          },
          "source": {
            "$ref": "#/components/schemas/FoodSource"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "nameLanguage": {
            "type": "string",
            "nullable": true
          },
          "inflammation": {
            "$ref": "#/components/schemas/InflammationDto"
          },
          "dailyValueSource": {
            "type": "string",
            "nullable": true
          },
          "serving": {
            "$ref": "#/components/schemas/PanelServingDto"
          },
          "availableServings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PanelServingDto"
            },
            "nullable": true
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NutrientGroupDto"
            },
            "nullable": true
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "relatedFoods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelatedFoodDto"
            },
            "nullable": true
          },
          "nutrientCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "canonicalFoodId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Self.com-style food page: assembled view with portions and grouped nutrient panel."
      },
      "FoodSearchResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "ndbNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Single search hit (`GET /foods/search`). Lean by design — clients pull the full panel via the id."
      },
      "FoodSource": {
        "enum": [
          "Fdc",
          "CofidUk",
          "Ciqual",
          "Frida",
          "Ausnut",
          "OpenFoodFacts",
          "Cnf",
          "Fineli"
        ],
        "type": "string"
      },
      "FoodSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "ndbNumber": {
            "type": "string",
            "nullable": true
          },
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Compact food record for single-food lookup (`GET /foods/{id}`)."
      },
      "InflammationDto": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "format": "double"
          },
          "paramCount": {
            "type": "integer",
            "format": "int32"
          },
          "band": {
            "type": "string",
            "nullable": true
          },
          "isWholeFood": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Inflammatory-potential summary for a food. FoodInfo.Api.Dtos.InflammationDto.Band is \"anti\" / \"neutral\" / \"pro\".\nFoodInfo.Api.Dtos.InflammationDto.ParamCount (of 29) drives the UI confidence radial. FoodInfo.Api.Dtos.InflammationDto.IsWholeFood is true\nonly for verified whole foods whose score may read anti-inflammatory; for everything else the score\nis floored at neutral and the UI shows \"not rated for anti-inflammatory effect\" instead of the radial."
      },
      "IngredientPin": {
        "type": "object",
        "properties": {
          "lineIndex": {
            "type": "integer",
            "format": "int32"
          },
          "foodId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "\"Line LineIndex is food FoodId, because the user said so.\"\n            \n\n★ THIS EXISTS BECAUSE THE RESOLVER WILL NOT AGREE WITH AN EXACT NAME. Measured on 150 foods spread\nacross the six reference databases, feeding a food's own exact description back through the\nresolver returned that same food only 19% of the time (see ExactDescriptionRoundTripHarness). The\nother 81% is not a bug: the resolver strips qualifiers and weights by region on purpose, so\n\"Pork, loin, blade (chops), bone-in, cooked, braised\" becomes the UK's \"Pork, leg joint, raw,\nlean\". That is right for a cook's vague \"some pork\" and wrong for a food someone picked off a\nlist. Without pinning, four out of five explicit picks would silently become a different food."
      },
      "IngredientResult": {
        "required": [
          "raw"
        ],
        "type": "object",
        "properties": {
          "raw": {
            "type": "string",
            "nullable": true
          },
          "foodPhrase": {
            "type": "string",
            "nullable": true
          },
          "foodId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "matchedDescription": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "description": "Attribution display name of the matched food's source DB (e.g. \"The Danish Food Composition Database\").",
            "nullable": true
          },
          "grams": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "massMethod": {
            "$ref": "#/components/schemas/MassMethod"
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "needsReview": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "description": "Why it needs review / could not resolve, when applicable.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "The resolution of one ingredient line: what it parsed to, the food it matched, and the grams."
      },
      "MassMethod": {
        "enum": [
          "ParentheticalGrams",
          "MassUnit",
          "MeasuredPortion",
          "VolumeDensity",
          "CountWeight",
          "Unresolved"
        ],
        "type": "string",
        "description": "How a gram weight was arrived at (recipe-engine Stage 4), in descending trustworthiness."
      },
      "NutrientDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "rank": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "hasRda": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "A nutrient in the picker catalogue (GET /nutrients). FoodInfo.Api.Dtos.NutrientDto.HasRda is true when an\nestablished reference intake (RDA/DV) exists for it; the reverse-search picker defaults to\nthese and hides the rest behind an opt-in. Optional positional default so other callers\n(e.g. the developer API) don't have to supply it."
      },
      "NutrientGroupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NutrientRowDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NutrientRankingDto": {
        "type": "object",
        "properties": {
          "foodId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false,
        "description": "One food in a \"best sources of X\" ranking — Amount is per 100 g, in the nutrient's unit."
      },
      "NutrientRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "The nutrient a reverse-search was run for."
      },
      "NutrientRowDto": {
        "type": "object",
        "properties": {
          "nutrientId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "amountPer100g": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "amountPerServing": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "percentDailyValue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "referenceAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NutritionFacts": {
        "type": "object",
        "properties": {
          "energyKcal": {
            "type": "number",
            "format": "double"
          },
          "proteinG": {
            "type": "number",
            "format": "double"
          },
          "fatG": {
            "type": "number",
            "format": "double"
          },
          "saturatedFatG": {
            "type": "number",
            "format": "double"
          },
          "carbohydrateG": {
            "type": "number",
            "format": "double"
          },
          "sugarsG": {
            "type": "number",
            "format": "double"
          },
          "fibreG": {
            "type": "number",
            "format": "double"
          },
          "sodiumMg": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false,
        "description": "The WPRM-shaped nutrition label (per serving or per 100 g). Sodium in mg; the rest in g / kcal."
      },
      "PanelServingDto": {
        "type": "object",
        "properties": {
          "portionId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "gramWeight": {
            "type": "number",
            "format": "double"
          },
          "milliliters": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "massEstimated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ParsedIngredient": {
        "required": [
          "raw"
        ],
        "type": "object",
        "properties": {
          "raw": {
            "type": "string",
            "description": "The original line, verbatim.",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Resolved amount (the midpoint for a range); null when the line states no quantity.",
            "format": "double",
            "nullable": true
          },
          "quantityIsApproximate": {
            "type": "boolean",
            "description": "True when the quantity is a range (\"2-3\"), a word (\"a\"), or otherwise inexact."
          },
          "unit": {
            "type": "string",
            "description": "Canonical unit token (e.g. \"tbsp\", \"g\", \"clove\"); null when there is no unit.",
            "nullable": true
          },
          "unitKind": {
            "$ref": "#/components/schemas/UnitKind"
          },
          "parenGrams": {
            "type": "number",
            "description": "Authoritative gram weight lifted from a parenthetical (\"(120 g)\"); null if absent.",
            "format": "double",
            "nullable": true
          },
          "foodPhrase": {
            "type": "string",
            "description": "The food name text, cleaned of quantity/unit/parenthetical/leading \"of\".",
            "nullable": true
          },
          "prep": {
            "type": "string",
            "description": "Preparation/qualifier after the first comma (\"sifted\", \"finely chopped\"); null if none.",
            "nullable": true
          },
          "confidence": {
            "type": "number",
            "description": "Parse confidence in [0,1]. Calibrated later against the golden set.",
            "format": "double"
          },
          "needsReview": {
            "type": "boolean",
            "description": "True when the line should be flagged for human confirmation (and logged as a miss)."
          },
          "fullnessIsImprecise": {
            "type": "boolean",
            "description": "The line described how full the spoon was in a way that changes the amount — \"heaped\",\n\"rounded\", \"scant\", \"generous\". A level spoon is the standard assumption and does NOT set\nthis."
          }
        },
        "additionalProperties": false,
        "description": "The structured result of parsing one raw recipe ingredient line (recipe-engine P0 slice 2). Every\nfield the later stages need to resolve a food + a gram weight, plus a confidence and a\nFoodInfo.App.Recipes.ParsedIngredient.NeedsReview flag. When the parser can't confidently structure a line it still returns\na best-effort result with `NeedsReview = true` — the caller logs it to the resolution-miss\nbacklog and asks the blogger to confirm; there is no model fallback."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RecipeAnalysis": {
        "type": "object",
        "properties": {
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientResult"
            },
            "nullable": true
          },
          "perServing": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "per100g": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "totalGrams": {
            "type": "number",
            "format": "double"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "reviewFlags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "nutrientGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeNutrientGroup"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Full recipe analysis: per-line results, per-serving + per-100 g nutrition, the source DBs used\n            (for attribution — required on every page), and any lines flagged for human confirmation."
      },
      "RecipeAnalysisRequest": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "pins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientPin"
            },
            "description": "Lines whose food the caller has already chosen, and which must NOT be re-resolved. Optional; a null\nor empty list is the original behaviour.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Analyze a recipe: raw ingredient lines + the blog's home nation (region-weighting) + servings."
      },
      "RecipeNutrientGroup": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "nullable": true
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeNutrientRow"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "A category of nutrients (Proximates, Vitamins, Minerals…) for the full breakdown modal, ordered."
      },
      "RecipeNutrientRow": {
        "type": "object",
        "properties": {
          "nutrientId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "perServing": {
            "type": "number",
            "format": "double"
          },
          "per100g": {
            "type": "number",
            "format": "double"
          },
          "percentDailyValue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "referenceAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One nutrient in the full breakdown: per-serving + per-100 g amounts in the nutrient's own unit,\n            plus the per-serving %DV + daily reference (drives the coloured bars, same as the food pages)."
      },
      "RecipeParseRequest": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Body for `POST /api/v1/recipes/parse`."
      },
      "RelatedFoodDto": {
        "type": "object",
        "properties": {
          "foodId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TopByNutrientDto": {
        "type": "object",
        "properties": {
          "nutrient": {
            "$ref": "#/components/schemas/NutrientRefDto"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NutrientRankingDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Result of GET /foods/top-by-nutrient."
      },
      "UnitKind": {
        "enum": [
          "None",
          "Mass",
          "Volume",
          "Count",
          "Vague"
        ],
        "type": "string",
        "description": "How a parsed unit converts to grams downstream (recipe-engine Stage 4, mass-resolve)."
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "Developer API key. Create one at https://food-info.org/developer",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    { }
  ],
  "tags": [
    {
      "name": "ApiV1"
    },
    {
      "name": "RecipesApi"
    }
  ]
}