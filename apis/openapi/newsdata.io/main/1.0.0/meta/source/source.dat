        }
      },

      "MarketArticleListEnvelope": {
        "type": "object",
        "description": "Successful market article list response.",
        "required": ["status", "totalResults", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalResults": { "type": "integer", "description": "Total number of articles matching the query (not just this page)." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/MarketArticle" } },
          "nextPage": {
            "type": ["string", "null"],
            "description": "Pass this value as the `page` parameter to get the next page. `null` when there are no more results."
          }
        }
      },

      "Source": {
        "type": "object",
        "description": "A news source.",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Source id. Use it with the `domain` parameter on the news endpoints." },
          "name": { "type": ["string", "null"], "description": "Source display name." },
          "url": { "type": ["string", "null"], "format": "uri", "description": "Source website URL." },
          "icon": { "type": ["string", "null"], "format": "uri", "description": "Source icon URL." },
          "priority": { "type": ["integer", "null"], "description": "Source ranking (lower = higher-ranked)." },
          "description": { "type": ["string", "null"], "description": "Short description of the source." },
          "category": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Categories the source covers." },
          "language": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Languages the source publishes in." },
          "country": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Countries the source covers." },
          "total_article": { "type": ["integer", "null"], "description": "Number of articles collected from this source." },
          "last_fetch": { "type": ["string", "null"], "description": "When the source was last fetched, `YYYY-MM-DD HH:MM:SS`." }
        }
      },

      "SourceListEnvelope": {
        "type": "object",
        "description": "Successful source list response.",
        "required": ["status", "totalResults", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalResults": { "type": "integer", "description": "Number of sources returned (maximum 100)." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } },
          "nextPage": { "type": "null", "description": "Always `null` for this endpoint." }
        }
      },

      "CountSummaryEnvelope": {
        "type": "object",
        "description": "Count response when `interval=all` (default).",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "results": {
            "type": "object",
            "required": ["count"],
            "properties": {
              "count": { "type": "integer", "description": "Total number of articles matching the filters." }
            }
          }
        }
      },

      "CountHistogramEnvelope": {
        "type": "object",
        "description": "Count response when `interval=hour` or `interval=day`.",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dateTime", "count"],
              "properties": {
                "dateTime": { "type": "string", "description": "Start of the hour/day, `YYYY-MM-DD HH:MM:SS`." },
                "count": { "type": "integer", "description": "Number of articles in that hour/day." }
              }
            }
          },
          "nextPage": {
            "type": ["string", "null"],
            "description": "Pass this value as the `page` parameter to get the next page. `null` when there are no more results."
          }
        }
      },

      "WebsocketRegisterEnvelope": {
        "type": "object",
        "description": "Successful WebSocket query registration.",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "results": {
            "type": "object",
            "required": ["message", "registration_id"],
            "properties": {
              "message": { "type": "string", "description": "Human-readable confirmation." },
              "registration_id": { "type": "string", "description": "Identifier of the registered query (32 characters). Use it to connect to the WebSocket stream and to delete the registration." }
            }
          }
        }
      },

      "WebsocketQueryListEnvelope": {
        "type": "object",
        "description": "The API key's active WebSocket query registrations.",
        "required": ["status", "totalQueries", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalQueries": { "type": "integer", "description": "Number of active registrations for this API key." },
          "results": {
            "type": "object",
            "required": ["queries"],
            "properties": {
              "queries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["registration_id", "active_clients", "query"],
                  "properties": {
                    "registration_id": { "type": "string", "description": "Identifier of the registered query (32 characters)." },
                    "active_clients": { "type": "integer", "description": "Number of devices currently connected to the stream for this registration." },
                    "query": {
                      "type": "object",
                      "description": "The query parameters the registration was created with, as name/value pairs (parameter names in lowercase; comma-separated filters appear as arrays).",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      },

      "WebsocketDeleteEnvelope": {
        "type": "object",
        "description": "Successful WebSocket registration deletion.",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "results": {
            "type": "object",
            "required": ["message", "registration_id"],
            "properties": {
              "message": { "type": "string", "description": "Human-readable confirmation." },
              "registration_id": { "type": "string", "description": "Identifier of the deleted registration." }
            }
          }
        }
      },

      "WebsocketConflictEnvelope": {
        "type": "object",
        "description": "Returned when an identical query is already registered for this API key. `registration_id` is the id of the existing registration.",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "error" },
          "results": {
            "type": "object",
            "required": ["message", "code", "registration_id"],
            "properties": {
              "message": { "type": "string" },
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "registration_id": { "type": "string" }
            }
          }
        }
      },

      "WebsocketNewsMessage": {
        "type": "object",
        "description": "A message pushed over the WebSocket connection when newly collected articles match the registered query. `results` uses the same article shape as `/1/latest` results, minus any fields in the registration's `excludefield`; `pubDate`/`fetched_at` follow the registration's `timezone` (UTC otherwise).",
        "required": ["status", "totalResults", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalResults": { "type": "integer", "description": "Number of articles in this message." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Article" } }
        }
      }
    },

    "examples": {
      "ArticleListExample": {
        "summary": "Response shape (field names and data types)",
        "value": {
          "status": "success",
          "totalResults": "integer",
          "results": [
            {
              "article_id": "string",
              "link": "string (URL)",
              "title": "string",
              "description": "string",
              "content": "string",
