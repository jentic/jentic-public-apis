              "sentiment": "string (positive | neutral | negative)",
              "sentiment_stats": { "positive": "number", "neutral": "number", "negative": "number" },
              "ai_tag": ["string"],
              "ai_region": ["string"],
              "ai_org": ["string"],
              "ai_summary": "string",
              "duplicate": "boolean"
            }
          ],
          "nextPage": "string | null"
        }
      },
      "CryptoArticleListExample": {
        "summary": "Response shape (field names and data types)",
