          "market_id": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Unique market identifiers for the tickers in `symbol` — the values accepted by the `market_id` filter." },
          "language": { "type": ["string", "null"], "description": "Language name, e.g. 'english'." },
          "country": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Country names, e.g. 'india'." },
          "datatype": { "type": "string", "description": "Content type, e.g. 'news', 'blog', 'podcast'." },
