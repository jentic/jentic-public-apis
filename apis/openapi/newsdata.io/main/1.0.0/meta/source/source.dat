        }
      }
    },

    "/1/market": {
      "get": {
        "tags": ["Market"],
        "operationId": "getMarket",
        "summary": "Financial-market news articles",
        "description": "Returns financial-market news articles tagged with stock ticker symbols. Available on plans with market access. On the free plan, articles cover the last 7 days with a 12-hour delay, and `from_date`, `to_date`, and `timeframe` cannot be used. On paid plans, use either `from_date`/`to_date` or `timeframe` (not both); when no dates are given, articles from the last 48 hours are returned.\n\nConsumes **1** API credit per call.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/QInTitle" },
          { "$ref": "#/components/parameters/QInMeta" },
          { "$ref": "#/components/parameters/MarketId" },
          { "$ref": "#/components/parameters/Country" },
          { "$ref": "#/components/parameters/ExcludeCountry" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/ExcludeLanguage" },
          { "$ref": "#/components/parameters/Domain" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/ExcludeDomain" },
          { "$ref": "#/components/parameters/PriorityDomain" },
          { "$ref": "#/components/parameters/Id" },
          { "$ref": "#/components/parameters/Url" },
          { "$ref": "#/components/parameters/FromDate" },
          { "$ref": "#/components/parameters/ToDate" },
          { "$ref": "#/components/parameters/Timeframe" },
          { "$ref": "#/components/parameters/Timezone" },
          { "$ref": "#/components/parameters/Image" },
          { "$ref": "#/components/parameters/Video" },
          { "$ref": "#/components/parameters/FullContent" },
          { "$ref": "#/components/parameters/RemoveDuplicate" },
          { "$ref": "#/components/parameters/Sentiment" },
          { "$ref": "#/components/parameters/SentimentScore" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Organization" },
          { "$ref": "#/components/parameters/Creator" },
          { "$ref": "#/components/parameters/Datatype" },
          { "$ref": "#/components/parameters/Size" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/ExcludeField" }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" },
              "X-RateLimit-Remaining":  { "$ref": "#/components/headers/XRateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MarketArticleListEnvelope" },
                "examples": { "responseShape": { "$ref": "#/components/examples/MarketArticleListExample" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/sources": {
      "get": {
        "tags": ["Sources"],
        "operationId": "getSources",
        "summary": "News sources",
        "description": "Returns up to 100 news sources matching the filters. Use the returned `id` with the `domain` parameter on the news endpoints.\n\nConsumes **1** API credit per call.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Country" },
          { "$ref": "#/components/parameters/Category" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/PriorityDomain" }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" },
              "X-RateLimit-Remaining":  { "$ref": "#/components/headers/XRateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourceListEnvelope" },
                "examples": { "responseShape": { "$ref": "#/components/examples/SourceListExample" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/count": {
      "get": {
        "tags": ["Count"],
        "operationId": "getCount",
        "summary": "News article count",
        "description": "Returns the number of news articles matching the filters. With `interval=all` (default) a single total is returned; with `interval=hour` or `interval=day` a count-per-hour/day breakdown is returned. `from_date` and `to_date` are required, and at least one of the following parameters as well: `q`, `qInTitle`, `qInMeta`, `country`, `category`, `language`, `domain`, `domainurl`, `prioritydomain`, `image`, `video`, `full_content`. Available on plans with count access.\n\nConsumes **50** API credits per call.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/QInTitle" },
          { "$ref": "#/components/parameters/QInMeta" },
          { "$ref": "#/components/parameters/Country" },
          { "$ref": "#/components/parameters/ExcludeCountry" },
          { "$ref": "#/components/parameters/Category" },
          { "$ref": "#/components/parameters/ExcludeCategory" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/ExcludeLanguage" },
          { "$ref": "#/components/parameters/Domain" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/ExcludeDomain" },
          { "$ref": "#/components/parameters/PriorityDomain" },
          { "$ref": "#/components/parameters/FromDateCount" },
          { "$ref": "#/components/parameters/ToDateCount" },
          { "$ref": "#/components/parameters/Image" },
          { "$ref": "#/components/parameters/Video" },
          { "$ref": "#/components/parameters/FullContent" },
          { "$ref": "#/components/parameters/RemoveDuplicate" },
          { "$ref": "#/components/parameters/Sentiment" },
          { "$ref": "#/components/parameters/SentimentScore" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Region" },
          { "$ref": "#/components/parameters/Organization" },
          { "$ref": "#/components/parameters/Creator" },
          { "$ref": "#/components/parameters/Datatype" },
          { "$ref": "#/components/parameters/Interval" },
          { "$ref": "#/components/parameters/SizeCount" },
          { "$ref": "#/components/parameters/PageCount" },
          { "$ref": "#/components/parameters/SortCount" }
        ],
        "responses": {
          "200": {
            "description": "Success. The shape depends on the `interval` parameter.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" },
              "X-RateLimit-Remaining":  { "$ref": "#/components/headers/XRateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/CountSummaryEnvelope" },
                    { "$ref": "#/components/schemas/CountHistogramEnvelope" }
                  ]
                },
                "examples": {
                  "intervalAll": { "$ref": "#/components/examples/CountSummaryExample" },
                  "intervalHourOrDay": { "$ref": "#/components/examples/CountHistogramExample" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/crypto/count": {
      "get": {
        "tags": ["Count"],
        "operationId": "getCryptoCount",
        "summary": "Cryptocurrency article count",
        "description": "Returns the number of cryptocurrency news articles matching the filters. With `interval=all` (default) a single total is returned; with `interval=hour` or `interval=day` a count-per-hour/day breakdown is returned. `from_date` and `to_date` are required. Available on plans with count access.\n\nConsumes **50** API credits per call.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/QInTitle" },
          { "$ref": "#/components/parameters/QInMeta" },
          { "$ref": "#/components/parameters/Coin" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/ExcludeLanguage" },
          { "$ref": "#/components/parameters/Domain" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/ExcludeDomain" },
          { "$ref": "#/components/parameters/PriorityDomain" },
          { "$ref": "#/components/parameters/FromDateCount" },
          { "$ref": "#/components/parameters/ToDateCount" },
          { "$ref": "#/components/parameters/Image" },
          { "$ref": "#/components/parameters/Video" },
          { "$ref": "#/components/parameters/FullContent" },
          { "$ref": "#/components/parameters/RemoveDuplicate" },
          { "$ref": "#/components/parameters/Sentiment" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Interval" },
          { "$ref": "#/components/parameters/SizeCount" },
          { "$ref": "#/components/parameters/PageCount" },
          { "$ref": "#/components/parameters/SortCount" }
        ],
        "responses": {
          "200": {
            "description": "Success. The shape depends on the `interval` parameter.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" },
              "X-RateLimit-Remaining":  { "$ref": "#/components/headers/XRateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/CountSummaryEnvelope" },
                    { "$ref": "#/components/schemas/CountHistogramEnvelope" }
                  ]
                },
                "examples": {
                  "intervalAll": { "$ref": "#/components/examples/CountSummaryExample" },
                  "intervalHourOrDay": { "$ref": "#/components/examples/CountHistogramExample" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/market/count": {
      "get": {
        "tags": ["Count"],
        "operationId": "getMarketCount",
        "summary": "Financial-market article count",
        "description": "Returns the number of financial-market news articles matching the filters. With `interval=all` (default) a single total is returned; with `interval=hour` or `interval=day` a count-per-hour/day breakdown is returned. `from_date` and `to_date` are required. Available on plans with count access.\n\nConsumes **50** API credits per call.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/QInTitle" },
          { "$ref": "#/components/parameters/QInMeta" },
          { "$ref": "#/components/parameters/MarketId" },
          { "$ref": "#/components/parameters/Country" },
          { "$ref": "#/components/parameters/ExcludeCountry" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/ExcludeLanguage" },
          { "$ref": "#/components/parameters/Domain" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/ExcludeDomain" },
          { "$ref": "#/components/parameters/PriorityDomain" },
          { "$ref": "#/components/parameters/FromDateCount" },
          { "$ref": "#/components/parameters/ToDateCount" },
          { "$ref": "#/components/parameters/Image" },
          { "$ref": "#/components/parameters/Video" },
          { "$ref": "#/components/parameters/FullContent" },
          { "$ref": "#/components/parameters/RemoveDuplicate" },
          { "$ref": "#/components/parameters/Sentiment" },
          { "$ref": "#/components/parameters/SentimentScore" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Organization" },
          { "$ref": "#/components/parameters/Creator" },
          { "$ref": "#/components/parameters/Datatype" },
          { "$ref": "#/components/parameters/Interval" },
          { "$ref": "#/components/parameters/SizeCount" },
          { "$ref": "#/components/parameters/PageCount" },
          { "$ref": "#/components/parameters/SortCount" }
        ],
        "responses": {
          "200": {
            "description": "Success. The shape depends on the `interval` parameter.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" },
              "X-RateLimit-Remaining":  { "$ref": "#/components/headers/XRateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/CountSummaryEnvelope" },
                    { "$ref": "#/components/schemas/CountHistogramEnvelope" }
                  ]
                },
                "examples": {
                  "intervalAll": { "$ref": "#/components/examples/CountSummaryExample" },
                  "intervalHourOrDay": { "$ref": "#/components/examples/CountHistogramExample" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/websocket/register": {
      "post": {
        "tags": ["Websocket"],
        "operationId": "registerWebsocketQuery",
        "summary": "Register a real-time query",
        "description": "Registers a standing query for the real-time WebSocket stream and returns its `registration_id`. Use that id to connect to the stream at `wss://ws.newsdata.io/ws/event` and to manage the registration with `/1/websocket/fetch` and `/1/websocket/delete`. Available on plans with WebSocket access.\n\nAt least one of the following parameters is required: `q`, `qInTitle`, `qInMeta`, `country`, `category`, `language`, `domain`, `domainurl`, `prioritydomain`, `image`, `video`, `full_content`. Registering the exact same set of parameters again returns **409** with the existing `registration_id`. Each account can keep a limited number of active registrations at a time (set by your plan); requests beyond the limit return **429**.\n\nRegistering consumes no API credits, but requires at least 1 API credit remaining. Each article later delivered over the WebSocket stream consumes **1** API credit per connected device.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiKey" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/QInTitle" },
          { "$ref": "#/components/parameters/QInMeta" },
          { "$ref": "#/components/parameters/Country" },
          { "$ref": "#/components/parameters/ExcludeCountry" },
          { "$ref": "#/components/parameters/Category" },
          { "$ref": "#/components/parameters/ExcludeCategory" },
          { "$ref": "#/components/parameters/Language" },
          { "$ref": "#/components/parameters/ExcludeLanguage" },
          { "$ref": "#/components/parameters/Domain" },
          { "$ref": "#/components/parameters/DomainUrl" },
          { "$ref": "#/components/parameters/ExcludeDomain" },
          { "$ref": "#/components/parameters/PriorityDomain" },
          { "$ref": "#/components/parameters/Timezone" },
          { "$ref": "#/components/parameters/Image" },
          { "$ref": "#/components/parameters/Video" },
          { "$ref": "#/components/parameters/FullContent" },
          { "$ref": "#/components/parameters/RemoveDuplicate" },
          { "$ref": "#/components/parameters/Sentiment" },
          { "$ref": "#/components/parameters/SentimentScore" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Region" },
          { "$ref": "#/components/parameters/Organization" },
          { "$ref": "#/components/parameters/Creator" },
          { "$ref": "#/components/parameters/Datatype" },
          { "$ref": "#/components/parameters/ExcludeField" }
        ],
        "responses": {
          "200": {
            "description": "Query registered.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebsocketRegisterEnvelope" },
                "examples": { "responseShape": { "$ref": "#/components/examples/WebsocketRegisterExample" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/websocket/fetch": {
      "get": {
        "tags": ["Websocket"],
        "operationId": "getWebsocketQueries",
        "summary": "List registered real-time queries",
        "description": "Returns every active WebSocket query registration of the API key (`totalQueries` carries the count), each with its `registration_id`, the query parameters it was registered with (parameter names in lowercase), and `active_clients` — the number of devices currently connected to the stream for it. Available on plans with WebSocket access.\n\nThe API key must be sent as the `apikey` query parameter — the `X-ACCESS-KEY` header is not supported on this endpoint. Consumes no API credits.",
        "security": [ { "ApiKeyQuery": [] } ],
        "parameters": [
          { "$ref": "#/components/parameters/ApiKeyQueryOnly" }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebsocketQueryListEnvelope" },
                "examples": { "responseShape": { "$ref": "#/components/examples/WebsocketQueryListExample" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/1/websocket/delete": {
      "delete": {
        "tags": ["Websocket"],
        "operationId": "deleteWebsocketQuery",
        "summary": "Delete a registered real-time query",
        "description": "Deletes one WebSocket query registration by its `registration_id`; articles stop being delivered for it. Available on plans with WebSocket access.\n\nThe API key must be sent as the `apikey` query parameter — the `X-ACCESS-KEY` header is not supported on this endpoint. Consumes no API credits.",
        "security": [ { "ApiKeyQuery": [] } ],
        "parameters": [
          { "$ref": "#/components/parameters/ApiKeyQueryOnly" },
          { "$ref": "#/components/parameters/RegistrationId" }
        ],
        "responses": {
          "200": {
            "description": "Registration deleted.",
            "headers": {
              "X-API-Limit-Remaining":  { "$ref": "#/components/headers/XApiLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebsocketDeleteEnvelope" },
                "examples": { "responseShape": { "$ref": "#/components/examples/WebsocketDeleteExample" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },

    "/ws/event": {
      "servers": [
        { "url": "wss://ws.newsdata.io", "description": "Production WebSocket server" }
      ],
      "get": {
        "tags": ["Websocket"],
        "operationId": "connectWebsocketStream",
        "summary": "Real-time news stream (WebSocket)",
        "description": "WebSocket endpoint — described here as its HTTP handshake because OpenAPI cannot model WebSocket traffic. Connect with a WebSocket client:\n\n`wss://ws.newsdata.io/ws/event?apikey=YOUR_API_KEY&registration_id=YOUR_REGISTRATION_ID`\n\nWhenever newly collected articles match the registered query, the server pushes one JSON message per batch: `{\"status\": \"success\", \"totalResults\": N, \"results\": [ ... ]}`, where each result is an article in the same shape as `/1/latest` results. Fields listed in the registration's `excludefield` are left out, and `pubDate`/`fetched_at` are rendered in the registration's `timezone` (UTC otherwise; `pubDateTZ` names the zone). Client-to-server messages are ignored — the socket is receive-only.\n\nThe handshake itself is always accepted; on failure the socket is then immediately closed with WebSocket close code `1008` and a reason: `invalid credentials or registration not found` (bad `apikey`/`registration_id`, or the plan lacks WebSocket access), `api limit reached` (no API credits remaining), or `device limit reached` (more than the allowed simultaneous devices per `registration_id` — default 5). Each delivered article consumes **1** API credit per connected device; when the credits run out, open connections are closed with code `1008` (`api limit reached`). A client that reads too slowly is disconnected with code `1013` (`send timeout`).",
        "security": [ { "ApiKeyQuery": [] } ],
        "parameters": [
          { "$ref": "#/components/parameters/ApiKeyQueryOnly" },
          { "$ref": "#/components/parameters/RegistrationId" }
        ],
        "responses": {
          "101": {
            "description": "WebSocket connection established. The schema below describes the JSON messages subsequently pushed over the socket (a `101` response itself has no body).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebsocketNewsMessage" },
                "examples": { "messageShape": { "$ref": "#/components/examples/WebsocketNewsMessageExample" } }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apikey",
        "description": "API key passed as a query-string parameter."
      },
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ACCESS-KEY",
        "description": "API key passed as an HTTP header. Used when `apikey` is not supplied in the query string."
      }
    },

    "parameters": {
      "ApiKey": {
        "name": "apikey",
        "in": "query",
        "required": false,
        "description": "Your API key. Alternatively send it in the `X-ACCESS-KEY` HTTP header. One of the two MUST be present.",
        "schema": { "type": "string" },
        "examples": { "default": { "value": "pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } }
      },
      "Q": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Search articles by keywords or phrases (matches title, description, content, keywords, and URL). Supports `AND` / `OR` operators and quoted phrases. Maximum length depends on your plan (default 100 characters). Use only one of `q`, `qInTitle`, `qInMeta`.",
        "schema": { "type": "string", "maxLength": 100 },
        "examples": {
          "keyword": { "value": "elections" },
          "operator": { "value": "elections AND results" }
        }
      },
      "QInTitle": {
        "name": "qInTitle",
        "in": "query",
        "required": false,
        "description": "Search articles by keywords in the title only. Maximum length depends on your plan (default 100 characters). Use only one of `q`, `qInTitle`, `qInMeta`.",
        "schema": { "type": "string", "maxLength": 100 }
      },
      "QInMeta": {
        "name": "qInMeta",
        "in": "query",
        "required": false,
        "description": "Search articles by keywords in the title, description, keywords, and URL. Maximum length depends on your plan (default 100 characters). Use only one of `q`, `qInTitle`, `qInMeta`.",
        "schema": { "type": "string", "maxLength": 100 }
      },
      "Country": {
        "name": "country",
        "in": "query",
        "required": false,
        "description": "Filter by country. Comma-separated ISO 3166-1 alpha-2 country codes, up to your plan's filter limit (default 5). Cannot be combined with `excludecountry`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": {
          "single": { "value": "us" },
          "multiple": { "value": "us,gb,in" }
        }
      },
      "ExcludeCountry": {
        "name": "excludecountry",
        "in": "query",
        "required": false,
        "description": "Exclude countries. Comma-separated ISO country codes, up to your plan's filter limit (default 5). Cannot be combined with `country`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Category": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Filter by category. Comma-separated category names, up to your plan's filter limit (default 5). Cannot be combined with `excludecategory`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "business,technology" } }
      },
      "ExcludeCategory": {
        "name": "excludecategory",
        "in": "query",
        "required": false,
        "description": "Exclude categories. Comma-separated category names, up to your plan's filter limit (default 5). Cannot be combined with `category`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Language": {
        "name": "language",
        "in": "query",
        "required": false,
        "description": "Filter by language. Comma-separated ISO 639-1 language codes, up to your plan's filter limit (default 5). Cannot be combined with `excludelanguage`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "en,hi" } }
      },
      "ExcludeLanguage": {
        "name": "excludelanguage",
        "in": "query",
        "required": false,
        "description": "Exclude languages. Comma-separated language codes, up to your plan's filter limit (default 5). Cannot be combined with `language`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Domain": {
        "name": "domain",
        "in": "query",
        "required": false,
        "description": "Filter by news source. Comma-separated source ids (the `id` value returned by `/1/sources`), up to your plan's filter limit (default 5). Cannot be combined with `domainurl` or `excludedomain`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "bbc,cnn" } }
      },
      "DomainUrl": {
        "name": "domainurl",
        "in": "query",
        "required": false,
        "description": "Filter by news source domain, e.g. `bbc.com`. Comma-separated, up to your plan's filter limit (default 5). Cannot be combined with `domain` or `excludedomain`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "bbc.com,cnn.com" } }
      },
      "ExcludeDomain": {
        "name": "excludedomain",
        "in": "query",
        "required": false,
        "description": "Exclude news source domains, e.g. `bbc.com`. Comma-separated, up to your plan's filter limit (default 5). Cannot be combined with `domain` or `domainurl`.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "PriorityDomain": {
        "name": "prioritydomain",
        "in": "query",
        "required": false,
        "description": "Restrict results to a tier of news sources ranked by quality and popularity: `top`, `medium`, or `low`.",
        "schema": { "type": "string", "enum": ["top", "medium", "low"] }
      },
      "Id": {
        "name": "id",
        "in": "query",
        "required": false,
        "description": "Fetch specific articles by their `article_id`. Comma-separated, up to your plan's page-size limit (default 50 paid, 10 free). Must be used alone — cannot be combined with any other filter.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string", "minLength": 32, "maxLength": 32 }, "maxItems": 50 }
      },
      "Url": {
        "name": "url",
        "in": "query",
        "required": false,
        "description": "Fetch a single article by its URL (tracking parameters such as `utm_*` are ignored). Maximum length 512. Must be used alone — cannot be combined with any other filter.",
        "schema": { "type": "string", "format": "uri", "maxLength": 512 }
      },
      "FromDate": {
        "name": "from_date",
        "in": "query",
        "required": false,
        "description": "Get articles published on or after this date. Format `YYYY-MM-DD` or `YYYY-MM-DD HH:MM:SS` (UTC). Cannot be a future date. How far back you can search depends on your plan. Cannot be combined with `timeframe`.",
        "schema": { "type": "string" },
        "examples": {
          "date": { "value": "2026-05-01" },
          "dateTime": { "value": "2026-05-01 06:00:00" }
        }
      },
      "ToDate": {
        "name": "to_date",
        "in": "query",
        "required": false,
        "description": "Get articles published on or before this date. Format `YYYY-MM-DD` or `YYYY-MM-DD HH:MM:SS` (UTC). Cannot be a future date. Cannot be combined with `timeframe`.",
        "schema": { "type": "string" },
        "examples": {
          "date": { "value": "2026-05-31" },
          "dateTime": { "value": "2026-05-31 18:00:00" }
        }
      },
      "Timeframe": {
        "name": "timeframe",
        "in": "query",
        "required": false,
        "description": "Get articles from the last N hours or minutes. A plain number means hours (1-48); add an `m` suffix for minutes (1-2880), e.g. `15m`. Paid plans only. Cannot be combined with `from_date`/`to_date`.",
        "schema": { "type": "string", "pattern": "^[0-9]+m?$" },
        "examples": {
          "hours": { "value": "24" },
          "minutes": { "value": "15m" }
        }
      },
      "Timezone": {
        "name": "timezone",
        "in": "query",
        "required": false,
        "description": "Display article dates in a specific timezone (IANA name, e.g. `Asia/Kolkata`). Defaults to `UTC`.",
        "schema": { "type": "string", "default": "UTC" },
        "examples": { "default": { "value": "Asia/Kolkata" } }
      },
      "Image": {
        "name": "image",
        "in": "query",
        "required": false,
        "description": "Set to `1` to return only articles that include an image, or `0` to return the `image_url` field as `null`.",
        "schema": { "type": "string", "enum": ["0", "1"] }
      },
      "Video": {
        "name": "video",
        "in": "query",
        "required": false,
        "description": "Set to `1` to return only articles that include a video, or `0` to return the `video_url` field as `null`.",
        "schema": { "type": "string", "enum": ["0", "1"] }
      },
      "FullContent": {
        "name": "full_content",
        "in": "query",
        "required": false,
        "description": "Set to `1` to return only articles that include full content, or `0` to return the `content` field as `null`. Available on plans with full-content access.",
        "schema": { "type": "string", "enum": ["0", "1"] }
      },
      "RemoveDuplicate": {
        "name": "removeduplicate",
        "in": "query",
        "required": false,
        "description": "Set to `1` to exclude duplicate articles. Available for dates from 2024-07-24 onward.",
        "schema": { "type": "string", "enum": ["0", "1"] }
      },
      "Sentiment": {
        "name": "sentiment",
        "in": "query",
        "required": false,
        "description": "Filter articles by sentiment. Available on Professional and Corporate plans, for dates from 2024-01-12 onward.",
        "schema": { "type": "string", "enum": ["positive", "neutral", "negative"] }
      },
      "SentimentScore": {
        "name": "sentiment_score",
        "in": "query",
        "required": false,
        "description": "Minimum sentiment confidence (1-100) for the chosen `sentiment`. Requires the `sentiment` parameter.",
        "schema": { "type": "number", "minimum": 1, "maximum": 100 }
      },
      "Tag": {
        "name": "tag",
        "in": "query",
        "required": false,
        "description": "Filter by AI-classified topic tags (e.g. `politics,technology`). Comma-separated, up to your plan's filter limit (default 5). Available on Professional and Corporate plans, for dates from 2024-01-12 onward.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Region": {
        "name": "region",
        "in": "query",
        "required": false,
        "description": "Filter by AI-extracted geographic region. Join sub-regions with `-` to require them together (e.g. `paris-france`). Comma-separated, up to your plan's filter limit (default 5). Available on Corporate plans, for dates from 2024-01-29 onward.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Organization": {
        "name": "organization",
        "in": "query",
        "required": false,
        "description": "Filter by AI-extracted organization names. Comma-separated, up to your plan's filter limit (default 5). Available on Corporate plans, for dates from 2024-05-24 onward.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Creator": {
        "name": "creator",
        "in": "query",
        "required": false,
        "description": "Filter by article author / byline. Comma-separated, up to your plan's filter limit (default 5).",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Datatype": {
        "name": "datatype",
        "in": "query",
        "required": false,
        "description": "Filter by content type, e.g. `news`, `blog`, `podcast`. Comma-separated, up to your plan's filter limit (default 5). Available for dates from 2025-11-28 onward.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      },
      "Size": {
        "name": "size",
        "in": "query",
        "required": false,
        "description": "Number of articles per page: 1 to 50 on paid plans, 1 to 10 on the free plan. Defaults to your plan's maximum.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Pagination. With the default sort, pass the `nextPage` value from the previous response. With `sort=relevancy|source|fetched_at`, pass a page number instead.",
        "schema": { "type": "string" },
        "examples": {
          "cursor": { "value": "1749547200000000000" },
          "pageNumber": { "value": "2" }
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "Result ordering: `pubdatedesc` (default, newest first), `pubdateasc`, `relevancy` (requires `q`/`qInTitle`/`qInMeta`), `source`, or `fetched_at`. `relevancy`, `source`, and `fetched_at` are limited to the first 10,000 results. `fetched_at` is available on `/latest`, `/news`, `/archive`, and `/market` only.",
        "schema": {
          "type": "string",
          "enum": ["pubdatedesc", "pubdateasc", "relevancy", "source", "fetched_at"],
          "default": "pubdatedesc"
        }
      },
      "ExcludeField": {
        "name": "excludefield",
        "in": "query",
        "required": false,
        "description": "Comma-separated list of response fields to leave out of each article. `article_id` cannot be excluded.",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" } },
        "examples": { "default": { "value": "content,keywords" } }
      },
      "Coin": {
        "name": "coin",
        "in": "query",
        "required": false,
        "description": "Filter by cryptocurrency. Comma-separated coin ticker symbols, up to your plan's filter limit (default 5).",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "btc,eth" } }
      },
      "SortCrypto": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "Result ordering: `pubdatedesc` (default, newest first), `pubdateasc`, `relevancy` (requires `q`/`qInTitle`/`qInMeta`), or `source`. `relevancy` and `source` are limited to the first 10,000 results.",
        "schema": {
          "type": "string",
          "enum": ["pubdatedesc", "pubdateasc", "relevancy", "source"],
          "default": "pubdatedesc"
        }
      },
      "MarketId": {
        "name": "market_id",
        "in": "query",
        "required": false,
        "description": "Filter by market identifier (`market_id`, the unique symbol id). Comma-separated, up to your plan's filter limit (default 5).",
        "explode": false,
        "style": "form",
        "schema": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "examples": { "default": { "value": "aapl-us-vy,msft-us-vy" } }
      },
      "FromDateCount": {
        "name": "from_date",
        "in": "query",
        "required": true,
        "description": "Count articles published on or after this date. Format `YYYY-MM-DD` or `YYYY-MM-DD HH:MM:SS` (UTC). Cannot be a future date. How far back you can go depends on your plan.",
        "schema": { "type": "string" },
        "examples": {
          "date": { "value": "2026-05-01" },
          "dateTime": { "value": "2026-05-01 06:00:00" }
        }
      },
      "ToDateCount": {
        "name": "to_date",
        "in": "query",
        "required": true,
        "description": "Count articles published on or before this date. Format `YYYY-MM-DD` or `YYYY-MM-DD HH:MM:SS` (UTC). Cannot be a future date.",
        "schema": { "type": "string" },
        "examples": {
          "date": { "value": "2026-05-31" },
          "dateTime": { "value": "2026-05-31 18:00:00" }
        }
      },
      "Interval": {
        "name": "interval",
        "in": "query",
        "required": false,
        "description": "How to count: `all` (default) returns a single total; `hour` or `day` returns a count-per-hour or count-per-day breakdown.",
        "schema": { "type": "string", "enum": ["all", "hour", "day"], "default": "all" }
      },
      "SizeCount": {
        "name": "size",
        "in": "query",
        "required": false,
        "description": "Number of histogram entries per page when `interval=hour` or `day`: 1 to 50 on paid plans, 1 to 10 on the free plan.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "PageCount": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Pagination for the histogram. Pass the `nextPage` value from the previous response.",
        "schema": { "type": "string" }
      },
      "SortCount": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "Ordering of the histogram: `pubdatedesc` (default, newest first) or `pubdateasc`.",
        "schema": { "type": "string", "enum": ["pubdatedesc", "pubdateasc"], "default": "pubdatedesc" }
      },
      "ApiKeyQueryOnly": {
        "name": "apikey",
        "in": "query",
        "required": true,
        "description": "Your API key, passed as a query-string parameter. This endpoint does not accept the `X-ACCESS-KEY` header.",
        "schema": { "type": "string" },
        "examples": { "default": { "value": "pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } }
      },
      "RegistrationId": {
        "name": "registration_id",
        "in": "query",
        "required": true,
        "description": "The `registration_id` returned by `/1/websocket/register` (32-character identifier).",
        "schema": { "type": "string", "minLength": 32, "maxLength": 32 },
        "examples": { "default": { "value": "9b2d1e8a7c4f4b6e9d3a5c7e1f2a4b6c" } }
      }
    },

    "headers": {
      "XApiLimitRemaining": {
        "description": "API credits remaining on your plan.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "XRateLimitRemaining": {
        "description": "Requests remaining in the current 15-minute rate-limit window.",
        "schema": { "type": "integer", "minimum": 0 }
      }
    },

    "schemas": {
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable error code. Note: `ServiceUnavailable ` includes a trailing space.",
        "enum": [
          "Unauthorized",
          "ServerError",
          "TooManyRequests",
          "InvalidRequest",
          "AccessDenied",
          "ServiceUnavailable ",
          "NotFound",
          "UnsupportedFilter",
          "FilterLimitExceed",
          "UnsupportedParameter",
          "TooManyQueryFilter",
          "TooManyFilter",
          "TooManyLogicalOperator",
          "UnsupportedDateFormat",
          "UnsupportedQueryLength",
          "UnsupportedQInTitleLength",
          "UnsupportedQInMetaLength",
          "RateLimitExceeded",
          "ApiLimitExceeded",
          "MalformedUrl",
          "MaxPageLimitExceeded",
          "MalformedQuery",
          "Conflict"
        ]
      },

      "ErrorDetail": {
        "type": "object",
        "description": "Error details.",
        "required": ["message", "code"],
        "properties": {
          "message": { "type": "string", "description": "Human-readable error description." },
          "code": { "$ref": "#/components/schemas/ErrorCode" }
        }
      },

      "InvalidFilterDetail": {
        "type": "object",
        "description": "Error details returned when a filter value is not supported. The matching `invalid_*` key lists the rejected value(s); `suggestion` or `recommendations` may offer close matches.",
        "properties": {
          "message": { "type": "string" },
          "code": { "$ref": "#/components/schemas/ErrorCode" },
          "invalid_domain": { "type": "string" },
          "invalid_country": { "type": "string" },
          "invalid_category": { "type": "string" },
          "invalid_language": { "type": "string" },
          "invalid_datatype": { "type": "string" },
          "invalid_field": { "type": "string" },
          "invalid_id": { "type": "string" },
          "invalid_tag": { "type": "string" },
          "invalid_region": { "type": "string" },
          "invalid_coin": { "type": "string" },
          "invalid_ticker": { "type": "string" },
          "suggestion": { "type": "array", "items": { "type": "string" } },
          "recommendations": {
            "type": "object",
            "description": "For an invalid `market_id`, close matches keyed by the rejected value.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ticker": { "type": "string" },
                  "country": { "type": "string" },
                  "exchangeName": { "type": "string" },
                  "id": { "type": "string", "description": "The unique identifier to use as `market_id`." }
                }
              }
            }
          }
        }
      },

      "ErrorEnvelope": {
        "type": "object",
        "description": "Standard error response. `results` contains the error message and code; for unsupported filter values it also lists the rejected value(s).",
        "required": ["status", "results"],
        "properties": {
          "status": { "type": "string", "const": "error" },
          "results": {
            "oneOf": [
              { "$ref": "#/components/schemas/ErrorDetail" },
              { "$ref": "#/components/schemas/InvalidFilterDetail" },
              { "type": "array", "items": { "$ref": "#/components/schemas/InvalidFilterDetail" } }
            ]
          }
        }
      },

      "SentimentStats": {
        "type": "object",
        "description": "Sentiment percentage breakdown. The three values sum to 100.",
        "required": ["positive", "neutral", "negative"],
        "properties": {
          "positive": { "type": "number", "minimum": 0, "maximum": 100 },
          "neutral": { "type": "number", "minimum": 0, "maximum": 100 },
          "negative": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      },

      "Article": {
        "type": "object",
        "description": "A news article. Fields marked as plan-specific return a short notice string instead of their value on plans that do not include them. Any field except `article_id` may be `null`.",
        "required": ["article_id"],
        "properties": {
          "article_id": { "type": "string", "description": "Unique article identifier (32 characters)." },
          "link": { "type": ["string", "null"], "format": "uri", "description": "Article URL." },
          "title": { "type": ["string", "null"], "description": "Article title." },
          "description": { "type": ["string", "null"], "description": "Short article description." },
          "content": {
            "type": ["string", "null"],
            "description": "Full article text. Plan-specific (full-content access). Returned as `null` when `full_content=0`."
          },
          "keywords": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Article keywords." },
          "creator": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Article author(s)." },
          "language": { "type": ["string", "null"], "description": "Language name, e.g. 'english'." },
          "country": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Country names, e.g. 'india'." },
          "category": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Article categories." },
          "datatype": { "type": "string", "description": "Content type, e.g. 'news', 'blog', 'podcast'." },
          "pubDate": { "type": ["string", "null"], "description": "Publish date, `YYYY-MM-DD HH:MM:SS`, in the requested `timezone`." },
          "pubDateTZ": { "type": "string", "description": "Timezone of the dates in this article. 'UTC' unless `timezone` was supplied." },
          "fetched_at": { "type": ["string", "null"], "description": "When the article was collected, `YYYY-MM-DD HH:MM:SS`." },
          "image_url": { "type": ["string", "null"], "format": "uri", "description": "Article image URL." },
          "video_url": { "type": ["string", "null"], "format": "uri", "description": "Article video URL." },
          "source_id": { "type": ["string", "null"], "description": "Source id (usable with the `domain` filter)." },
          "source_name": { "type": ["string", "null"], "description": "Source display name." },
          "source_priority": { "type": ["integer", "null"], "description": "Source ranking (lower = higher-ranked)." },
          "source_url": { "type": ["string", "null"], "format": "uri", "description": "Source website URL." },
          "source_icon": { "type": ["string", "null"], "format": "uri", "description": "Source icon URL." },
          "sentiment": {
            "description": "Overall sentiment: positive, neutral, or negative. Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "type": "string", "enum": ["positive", "neutral", "negative"] },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "sentiment_stats": {
            "description": "Sentiment percentage breakdown. Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "$ref": "#/components/schemas/SentimentStats" },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "ai_tag": {
            "description": "AI-classified topic tags. Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "ai_region": {
            "description": "AI-extracted regions, e.g. 'paris,france'. Plan-specific (Corporate).",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "ai_org": {
            "description": "AI-extracted organization names. Plan-specific (Corporate).",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "ai_summary": {
            "type": ["string", "null"],
            "description": "AI-generated article summary. Plan-specific."
          },
          "duplicate": { "type": "boolean", "description": "Whether the article is a duplicate of another article." }
        }
      },

      "ArticleListEnvelope": {
        "type": "object",
        "description": "Successful article list response.",
        "required": ["status", "totalResults", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalResults": { "type": "integer", "description": "Total number of articles matching the query (not just this page)." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Article" } },
          "nextPage": {
            "type": ["string", "null"],
            "description": "Pass this value as the `page` parameter to get the next page. `null` when there are no more results."
          }
        }
      },

      "CryptoArticle": {
        "type": "object",
        "description": "A cryptocurrency news article. Fields marked as plan-specific return a short notice string instead of their value on plans that do not include them. Any field except `article_id` may be `null`.",
        "required": ["article_id"],
        "properties": {
          "article_id": { "type": "string", "description": "Unique article identifier (32 characters)." },
          "link": { "type": ["string", "null"], "format": "uri", "description": "Article URL." },
          "title": { "type": ["string", "null"], "description": "Article title." },
          "description": { "type": ["string", "null"], "description": "Short article description." },
          "content": {
            "type": ["string", "null"],
            "description": "Full article text. Plan-specific (full-content access). Returned as `null` when `full_content=0`."
          },
          "keywords": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Article keywords." },
          "creator": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Article author(s)." },
          "coin": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Cryptocurrencies the article mentions, by ticker symbol." },
          "language": { "type": ["string", "null"], "description": "Language name, e.g. 'english'." },
          "pubDate": { "type": ["string", "null"], "description": "Publish date, `YYYY-MM-DD HH:MM:SS`, in the requested `timezone`." },
          "pubDateTZ": { "type": "string", "description": "Timezone of the dates in this article. 'UTC' unless `timezone` was supplied." },
          "fetched_at": { "type": ["string", "null"], "description": "When the article was collected, `YYYY-MM-DD HH:MM:SS`." },
          "image_url": { "type": ["string", "null"], "format": "uri", "description": "Article image URL." },
          "video_url": { "type": ["string", "null"], "format": "uri", "description": "Article video URL." },
          "source_id": { "type": ["string", "null"], "description": "Source id (usable with the `domain` filter)." },
          "source_name": { "type": ["string", "null"], "description": "Source display name." },
          "source_priority": { "type": ["integer", "null"], "description": "Source ranking (lower = higher-ranked)." },
          "source_url": { "type": ["string", "null"], "format": "uri", "description": "Source website URL." },
          "source_icon": { "type": ["string", "null"], "format": "uri", "description": "Source icon URL." },
          "sentiment": {
            "description": "Overall sentiment: positive, neutral, or negative. Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "type": "string", "enum": ["positive", "neutral", "negative"] },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "sentiment_stats": {
            "description": "Sentiment percentage breakdown. Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "$ref": "#/components/schemas/SentimentStats" },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "ai_tag": {
            "description": "AI-classified topic tags (crypto-specific tag set). Plan-specific (Professional/Corporate).",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "duplicate": { "type": "boolean", "description": "Whether the article is a duplicate of another article." }
        }
      },

      "CryptoArticleListEnvelope": {
        "type": "object",
        "description": "Successful crypto article list response.",
        "required": ["status", "totalResults", "results"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "totalResults": { "type": "integer", "description": "Total number of articles matching the query (not just this page)." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/CryptoArticle" } },
          "nextPage": {
            "type": ["string", "null"],
            "description": "Pass this value as the `page` parameter to get the next page. `null` when there are no more results."
          }
        }
      },

      "MarketArticle": {
        "type": "object",
        "description": "A financial-market news article. Fields marked as plan-specific return a short notice string instead of their value on plans that do not include them. Any field except `article_id` may be `null`.",
