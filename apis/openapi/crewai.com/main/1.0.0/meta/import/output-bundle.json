{
  "openapi": "3.1.0",
  "info": {
    "title": "CrewAI Marketing Site Public API",
    "version": "1.0.0",
    "description": "Read-oriented REST API for the CrewAI marketing site. Scoped OAuth and API key roles documented in components.securitySchemes. Full docs: https://crewai.com/developers",
    "x-jentic-source-url": "https://crewai.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://crewai.com/api",
      "description": "Public JSON API"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "security": [
          {},
          {
            "OAuth2": [
              "api.read"
            ]
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/blog-posts": {
      "get": {
        "operationId": "listBlogPosts",
        "summary": "Paginated blog posts",
        "security": [
          {},
          {
            "OAuth2": [
              "content.blog.read"
            ]
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "excludeFeatured",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blog posts payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/case-studies": {
      "get": {
        "operationId": "listCaseStudies",
        "summary": "Paginated case studies",
        "security": [
          {},
          {
            "OAuth2": [
              "content.case-studies.read"
            ]
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "excludeFeatured",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Case studies payload"
          }
        }
      }
    },
    "/webinars": {
      "get": {
        "operationId": "listWebinars",
        "summary": "Paginated webinars",
        "security": [
          {},
          {
            "OAuth2": [
              "content.webinars.read"
            ]
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webinars payload"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Paginated events",
        "security": [
          {},
          {
            "OAuth2": [
              "content.events.read"
            ]
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events payload"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 authorization code flow with scoped access",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://crewai.com/api/oauth/authorize",
            "tokenUrl": "https://crewai.com/api/oauth/token",
            "scopes": {
              "openid": "OpenID Connect identity",
              "profile": "User profile claims",
              "email": "Email address",
              "api.read": "Read all public marketing JSON APIs",
              "content.blog.read": "Read blog posts via GET /api/blog-posts",
              "content.case-studies.read": "Read case studies via GET /api/case-studies",
              "content.webinars.read": "Read webinars via GET /api/webinars",
              "content.events.read": "Read events via GET /api/events",
              "mcp.tools.invoke": "Invoke CrewAI MCP tools at POST /mcp"
            }
          }
        }
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer API key. Roles: sandbox.read, agent.mcp. Example: Bearer crewai_site_sandbox_read"
      }
    }
  },
  "security": [
    {},
    {
      "OAuth2": [
        "api.read"
      ]
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "externalDocs": {
    "description": "CrewAI developer portal",
    "url": "https://crewai.com/developers"
  }
}