{
  "openapi": "3.0.0",
  "info": {
    "title": "Peionio API",
    "version": "v0",
    "description": "Peionio Team API generated from Postman collection.\nBase URL is `https://api.peionio.com/v0`.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/oratox/peionio-api/v0"
  },
  "servers": [
    {
      "url": "https://api.peionio.com/v0",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Account"
    },
    {
      "name": "Transactions"
    },
    {
      "name": "Receiving Accounts"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TwoFAHeader": {
        "name": "2FA",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "2-factor authentication code."
      },
      "MemberIdParam": {
        "name": "memberID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ReceivingAccountIdParam": {
        "name": "receivingAccountID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TokenParam": {
        "name": "token",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "email",
          "password"
        ],
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "middle_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "EmailOnlyRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": [
          "new_password",
          "confirm_password"
        ],
        "properties": {
          "new_password": {
            "type": "string"
          },
          "confirm_password": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "old_password",
          "new_password",
          "confirm_password"
        ],
        "properties": {
          "old_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          },
          "confirm_password": {
            "type": "string"
          }
        }
      },
      "RegisterMemberRequest": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "email"
        ],
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "middle_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "BuyCreditsRequest": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "example": 50
          }
        }
      },
      "ReceivingAccountCreateRequest": {
        "type": "object",
        "required": [
          "member_id",
          "payment_rail",
          "destination_address"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "payment_rail": {
            "type": "string",
            "description": "Payment rail identifier (e.g. blockchain / network)."
          },
          "destination_address": {
            "type": "string",
            "description": "Destination address for payments."
          }
        }
      },
      "ReceivingAccountUpdateRequest": {
        "type": "object",
        "required": [
          "receiving_account_id",
          "payment_rail",
          "destination_address"
        ],
        "properties": {
          "receiving_account_id": {
            "type": "string"
          },
          "payment_rail": {
            "type": "string"
          },
          "destination_address": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/team/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Authenticate a team member and obtain an access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Typically includes a token in `data.token`."
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/team/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "description": "Register a new team member account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/team/auth/verify-email/{token}": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify Email",
        "description": "Verify email address with provided token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Email verified"
          },
          "400": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/team/auth/resend-verification": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Resend Verification Email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailOnlyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification email resent"
          }
        }
      }
    },
    "/team/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Forgot Password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailOnlyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email sent"
          }
        }
      }
    },
    "/team/auth/reset-password/{token}": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset Password",
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "400": {
            "description": "Invalid token or validation error"
          }
        }
      }
    },
    "/team/auth/refresh-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh Token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "New token issued"
          }
        }
      }
    },
    "/team/auth/revoke-token": {
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout / Revoke Token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Token revoked / logged out"
          }
        }
      }
    },
    "/team/account/members/register": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Register Member",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member registered"
          }
        }
      }
    },
    "/team/account/members/add": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Add Member",
        "description": "Invite or add an existing user as a member by email.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member added / invitation sent"
          }
        }
      }
    },
    "/team/account/members/verify/{token}": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Verify Member",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Member verified"
          }
        }
      }
    },
    "/team/account/members/{memberID}": {
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Remove Member",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          },
          {
            "$ref": "#/components/parameters/MemberIdParam"
          }
        ],
        "responses": {
          "204": {
            "description": "Member removed"
          }
        }
      }
    },
    "/team/account/2fa": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Setup 2FA",
        "description": "Get 2FA provisioning details (e.g., QR code, secret).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "2FA setup details returned"
          }
        }
      },
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Reset 2FA",
        "description": "Reset the 2FA configuration for the account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "2FA reset successfully"
          }
        }
      }
    },
    "/team/account/credits": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get Credits",
        "description": "Get current credits/balance for the team.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credits information"
          }
        }
      },
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Buy Credits",
        "description": "Purchase credits for the team account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuyCreditsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credits purchased"
          }
        }
      }
    },
    "/team/account/members": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get All Members",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of members"
          }
        }
      }
    },
    "/team/account/change-password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Change Password",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed"
          }
        }
      }
    },
    "/team/transactions/recent": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get Recent Transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recent transactions list"
          }
        }
      }
    },
    "/team/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get All Transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "member_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2024-01-01"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2024-01-31"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transaction list"
          }
        }
      }
    },
    "/team/receiving-accounts": {
      "post": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Create Receiving Account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceivingAccountCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receiving account created"
          }
        }
      },
      "put": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Update Receiving Account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceivingAccountUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receiving account updated"
          }
        }
      },
      "get": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Get All Receiving Accounts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of receiving accounts"
          }
        }
      }
    },
    "/team/receiving-accounts/{receivingAccountID}": {
      "get": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Get Receiving Account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReceivingAccountIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Receiving account details"
          }
        }
      }
    },
    "/team/receiving-accounts/reactivate/{receivingAccountID}": {
      "post": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Reactivate Receiving Account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          },
          {
            "$ref": "#/components/parameters/ReceivingAccountIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Receiving account reactivated"
          }
        }
      }
    },
    "/team/receiving-accounts/extend/{receivingAccountID}": {
      "post": {
        "tags": [
          "Receiving Accounts"
        ],
        "summary": "Extend Receiving Account",
        "description": "Extend expiration or duration for a receiving account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TwoFAHeader"
          },
          {
            "$ref": "#/components/parameters/ReceivingAccountIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Receiving account extended"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
