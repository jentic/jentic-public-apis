{
  "openapi": "3.0.0",
  "info": {
    "contact": {
      "email": "hello@mailfloss.com"
    },
    "description": "The mailfloss single-email verification API is ideal for integrating email address verification during your signup or onboarding process with just a single request from your back-end application.",
    "termsOfService": "http://mailfloss.com/terms/",
    "title": "mailfloss API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.mailfloss.com/swagger.json"
  },
  "servers": [
    {
      "url": "https://api.mailfloss.com/"
    }
  ],
  "paths": {
    "/batch-verify": {
      "post": {
        "parameters": [
          {
            "description": "Your API key ",
            "in": "query",
            "name": "api_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchVerify"
                }
              }
            },
            "description": "successful operation"
          },
          "400": {
            "description": "No email address supplied"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "No API key provided"
          },
          "413": {
            "description": "Payload too large. Too many emails addresses"
          },
          "415": {
            "description": "Invalid Content Type. Must be application/json"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "Failed to create job"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "batch verify"
        ],
        "description": "",
        "operationId": "batchVerifyEmailsWithArrayInput",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "emails": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "webhookUrl": {
                    "description": "optional - enter webhook url to post to when job completed",
                    "type": "string"
                  }
                },
                "required": [
                  "emails"
                ],
                "type": "object"
              }
            }
          },
          "description": "Batch verify array of email addresses. Maximum 1000000 email addresses.",
          "required": true
        },
        "summary": "Batch verifies emails from given input array. Maximum 1000000 emails per call. Maximum 10 running batch verification sessions at a time. Add a webhook url to receive results once completed (optional and recommended)."
      }
    },
    "/batch-verify/{id}": {
      "get": {
        "parameters": [
          {
            "description": "The id that needs to be fetched. ",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Your API key ",
            "in": "query",
            "name": "api_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page to be fetched ",
            "in": "query",
            "name": "page",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "The number of items returned in a single response. Max 1000. Defaults to 100 ",
            "in": "query",
            "name": "per_page",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultsArray"
                }
              }
            },
            "description": "successful operation"
          },
          "400": {
            "description": "No id supplied"
          },
          "401": {
            "description": "Invalid API key"
          },
          "403": {
            "description": "No API key provided"
          },
          "404": {
            "description": "Job not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "batch verify"
        ],
        "description": "",
        "operationId": "batchVerifyEmailAddressesResults",
        "summary": "Get batch verification results"
      }
    },
    "/batch-verify/{id}/cancel": {
      "post": {
        "parameters": [
          {
            "description": "Your API key ",
            "in": "query",
            "name": "api_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The id that needs to be canceled. ",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCancel"
                }
              }
            },
            "description": "successful operation"
          },
          "400": {
            "description": "No id supplied"
          },
          "401": {
            "description": "Invalid API key"
          },
          "403": {
            "description": "No API key provided"
          },
          "404": {
            "description": "Job not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "batch verify"
        ],
        "description": "",
        "operationId": "batchVerifyEmailAddressesCancel",
        "summary": "Cancel batch verification job"
      }
    },
    "/batch-verify/{id}/status": {
      "get": {
        "parameters": [
          {
            "description": "Your API key ",
            "in": "query",
            "name": "api_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The id that needs to be fetched. ",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "successful operation"
          },
          "400": {
            "description": "No id supplied"
          },
          "401": {
            "description": "Invalid API key"
          },
          "403": {
            "description": "No API key provided"
          },
          "404": {
            "description": "Job not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "batch verify"
        ],
        "description": "",
        "operationId": "batchVerifyEmailAddressesStatus",
        "summary": "Get batch verification status"
      }
    },
    "/verify": {
      "get": {
        "parameters": [
          {
            "description": "Your API key ",
            "in": "query",
            "name": "api_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The email address that needs to be verified ",
            "in": "query",
            "name": "email",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Timeout value in ms. Max 60000. Defaults to 30000 ",
            "in": "query",
            "name": "timeout",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verify"
                }
              }
            },
            "description": "successful operation"
          },
          "400": {
            "description": "No email address supplied"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "No API key provided"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Timeout"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "verify"
        ],
        "description": "",
        "operationId": "verifyEmailAddress",
        "summary": "Verify email address"
      }
    }
  },
  "components": {
    "schemas": {
      "BatchVerify": {
        "properties": {
          "id": {
            "description": "The returned job Id",
            "type": "string"
          }
        },
        "type": "object",
        "xml": {
          "name": "Batch Verify"
        }
      },
      "Job": {
        "properties": {
          "emailsProcessed": {
            "description": "Number of email addresses processed",
            "type": "integer"
          },
          "id": {
            "description": "The job Id",
            "type": "string"
          },
          "numFailed": {
            "description": "Number of email addresses that failed to pass all tests",
            "type": "integer"
          },
          "numImported": {
            "description": "Number of email addresses imported",
            "type": "integer"
          },
          "numPassed": {
            "description": "Number of valid email addresses",
            "type": "integer"
          },
          "numRisky": {
            "description": "Number of risky email addresses",
            "type": "integer"
          },
          "numUndeliverable": {
            "description": "Number of undeliverable email addresses",
            "type": "integer"
          },
          "numUnknown": {
            "description": "Number of unknown email addresses",
            "type": "integer"
          },
          "processed": {
            "description": "If the job has finished processing",
            "type": "boolean"
          },
          "status": {
            "description": "The status of the job",
            "type": "string"
          }
        },
        "type": "object",
        "xml": {
          "name": "Job"
        }
      },
      "JobCancel": {
        "properties": {
          "status": {
            "description": "Success if job canceled successful",
            "type": "string"
          }
        },
        "type": "object",
        "xml": {
          "name": "JobCancel"
        }
      },
      "ResultsArray": {
        "items": {
          "properties": {
            "completed_at": {
              "description": "The date the check was completed",
              "type": "string"
            },
            "domain": {
              "description": "The domain of the email address",
              "type": "string"
            },
            "email": {
              "description": "The checked email addresses",
              "type": "string"
            },
            "passed": {
              "description": "If the email address passed all verification tests",
              "type": "boolean"
            },
            "processed": {
              "description": "If the email address was processed",
              "type": "boolean"
            },
            "reason": {
              "description": "The category of the email address",
              "type": "string"
            },
            "status": {
              "description": "The status of the email address",
              "type": "string"
            },
            "suggestion": {
              "description": "An email address suggestion, if one exists",
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array",
        "xml": {
          "name": "ResultsArray"
        }
      },
      "Verify": {
        "properties": {
          "disposable": {
            "description": "True if email address is from a disposable domain service",
            "type": "boolean"
          },
          "domain": {
            "description": "The domain of the email address",
            "type": "string"
          },
          "email": {
            "description": "The checked email address",
            "type": "string"
          },
          "free": {
            "description": "True if email address is from a free email service provider",
            "type": "boolean"
          },
          "meta": {
            "description": "Additional meta information",
            "type": "string"
          },
          "passed": {
            "description": "If the email address passed all verification tests",
            "type": "boolean"
          },
          "reason": {
            "description": "The category of the email address",
            "type": "string"
          },
          "role": {
            "description": "True if email address is role-based",
            "type": "boolean"
          },
          "status": {
            "description": "The status of the email address",
            "type": "string"
          },
          "suggestion": {
            "description": "An email address suggestion, if one exists",
            "type": "string"
          }
        },
        "type": "object",
        "xml": {
          "name": "Check"
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "in": "query",
        "name": "api_key",
        "type": "apiKey"
      }
    }
  },
  "tags": [
    {
      "description": "mailfloss email verification API",
      "name": "verify"
    },
    {
      "description": "mailfloss email batch verification API",
      "name": "batch verify"
    }
  ],
  "externalDocs": {
    "description": "Find out more about mailfloss",
    "url": "https://mailfloss.com"
  }
}