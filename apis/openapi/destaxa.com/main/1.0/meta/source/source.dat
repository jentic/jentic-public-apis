              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConsolidatedSalesReportDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/receivables/calendar/summary": {
      "post": {
        "tags": [
          "Receivables"
        ],
