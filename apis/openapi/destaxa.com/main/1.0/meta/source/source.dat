              "schema": {
                "$ref": "#/components/schemas/MultiDocumentFiltersRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedSalesDTO"
                }
              }
            }
          }
        }
      }
    },
    "/receivables/calendar/details": {
      "post": {
        "tags": [
          "Receivables"
        ],
        "operationId": "receivablesDetailsMulti",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultiDocumentFiltersRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved transactions",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageReceivablesDetailsDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Invalid or missing authorization"
          },
          "403": {
            "description": "Access denied"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/receivables/calendar/details/summary": {
      "post": {
        "tags": [
          "Receivables"
        ],
        "operationId": "receivablesDetailsSummaryMulti",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultiDocumentFiltersRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved transactions",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailsSummaryDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Invalid or missing authorization"
          },
          "403": {
            "description": "Access denied"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
