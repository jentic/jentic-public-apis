  "components": {
    "schemas": {
      "CollectorDataLog": {
        "required": [
          "acquirer",
          "client_document",
          "collector",
          "external_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_document": {
            "type": "string"
          },
          "acquirer": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "last_collection_date": {
            "type": "string",
            "format": "date-time"
          },
          "last_processor_date": {
            "type": "string",
            "format": "date-time"
          },
          "last_transanctions_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "external_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "edi_consent": {
            "$ref": "#/components/schemas/EdiRequestConsent"
          },
          "collect_now": {
            "type": "boolean"
          },
          "first_collect": {
            "type": "boolean"
          },
          "last_collect_ext_transaction_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "last_collect_ext_receivable_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "authorization_code": {
            "type": "string"
          },
          "connected_tef": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EdiRequestConsent": {
        "required": [
          "acquirer",
          "collector_data_log",
          "document",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "collector_data_log": {
            "$ref": "#/components/schemas/CollectorDataLog"
          },
          "acquirer": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "APROVADO",
              "CANCELADO",
              "EXPIRADO",
              "PENDENTE",
              "REPROVADO"
            ]
          },
          "request_external_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_modification_date": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MultiDocumentFiltersRequestDTO": {
        "required": [
          "documents",
          "since",
          "until"
        ],
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "since": {
            "type": "string",
            "format": "date"
          },
          "until": {
            "type": "string",
            "format": "date"
          },
          "acquirers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Filter request with documents, dates and filters"
      },
      "PageSalesDetailsDTO": {
        "type": "object",
        "properties": {
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "last": {
            "type": "boolean"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesDetailsDTO"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "PageableObject": {
        "type": "object",
        "properties": {
          "unpaged": {
            "type": "boolean"
          },
          "paged": {
            "type": "boolean"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          }
        }
      },
      "SalesDetailsDTO": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string",
            "format": "uuid"
          },
          "transaction_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "acquirer": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "card_funding": {
            "type": "string"
          },
          "installments": {
            "type": "integer",
            "format": "int32"
          },
          "gross_amount": {
            "type": "number"
          },
          "net_amount": {
            "type": "number"
          },
          "actual_fee": {
            "type": "number",
            "format": "float"
          },
          "usn": {
            "type": "integer",
            "format": "int64"
          },
          "auth_code": {
            "type": "string"
          },
          "dtx_status": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "has_divergence": {
            "type": "boolean"
          }
        }
      },
      "SortObject": {
        "type": "object",
        "properties": {
          "unsorted": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "SummarySalesDTO": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "total_divergence": {
            "type": "number"
          },
          "total_debit": {
            "type": "number"
          },
          "total_credit_one_installment": {
            "type": "number"
          },
          "total_credit_more_than_one_installment": {
            "type": "number"
          }
        }
      },
      "ConsolidatedSalesReportDTO": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "at_date": {
            "type": "string",
            "format": "date"
          },
          "count_sales": {
            "type": "integer",
            "format": "int64"
          },
          "total_gross_value": {
            "type": "number"
          },
          "total_net_value": {
            "type": "number"
          }
        }
      },
      "TransactionSummaryDTO": {
        "type": "object",
        "properties": {
          "vendas": {
            "type": "number"
          },
          "antecipacao": {
            "type": "number"
          },
          "outros_recebimentos": {
            "type": "number"
          },
          "estorno": {
            "type": "number"
          },
          "aluguel_maquina": {
            "type": "number"
          },
          "outros_debitos": {
            "type": "number"
          },
          "total_receber": {
            "type": "number"
          }
        }
      },
      "DetailedSalesDTO": {
        "type": "object",
        "properties": {
          "debito": {
            "type": "number"
          },
          "credito_avista": {
            "type": "number"
          },
          "credito_parcelado": {
            "type": "number"
          },
          "pix": {
            "type": "number"
          },
          "outros": {
            "type": "number"
          }
        }
      },
      "PageReceivablesDetailsDTO": {
        "type": "object",
        "properties": {
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "last": {
            "type": "boolean"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceivablesDetailsDTO"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "ReceivablesDetailsDTO": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          },
          "settlement_date": {
            "type": "string",
            "format": "date-time"
          },
          "acquirer": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "card_funding": {
            "type": "string"
          },
          "installment": {
            "type": "integer",
            "format": "int32"
          },
          "total_installments": {
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "type": "string"
          },
          "category_description": {
            "type": "string"
          },
          "lot_status": {
            "type": "string"
          },
          "gross_value_total": {
            "type": "number"
          },
          "expected_fee": {
            "type": "number",
            "format": "float"
          },
          "actual_fee": {
            "type": "number",
            "format": "float"
          },
          "gross_value_installment": {
            "type": "number"
          },
          "net_value_installment": {
            "type": "number"
          },
          "divergence": {
            "type": "boolean"
          },
          "transaction_date": {
            "type": "string",
            "format": "date-time"
          },
          "auth_code": {
            "type": "string"
          },
          "usn": {
            "type": "string"
