{
  "openapi": "3.0.1",
  "info": {
    "title": "DTX Pro - API",
    "description": "Backoffice conciliation API's",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Destaxa/destaxa-conciliation_clients/1.0"
  },
  "servers": [
    {
      "url": "https://conciliation.destaxa.com",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "JWT": []
    }
  ],
  "tags": [
    {
      "name": "Filters",
      "description": "API for managing filter metadata"
    },
    {
      "name": "Sales",
      "description": "API for managing sales"
    },
    {
      "name": "Receivables",
      "description": "API for managing receivables"
    }
  ],
  "paths": {
    "/sales/details": {
      "post": {
        "tags": [
          "Sales"
        ],
        "operationId": "salesDetailsMulti",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultiDocumentFiltersRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageSalesDetailsDTO"
                }
              }
            }
          }
        }
      }
    },
    "/sales/details/summary": {
      "post": {
        "tags": [
          "Sales"
        ],
        "operationId": "summarySalesDetailsMulti",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultiDocumentFiltersRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
