                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ip": {
                            "type": "string"
                          },
                          "domain_from": {
                            "type": "string"
                          },
                          "email_from_header": {
                            "type": "string"
                          },
                          "email_subject": {
                            "type": "string"
                          },
                          "smtp_mail_from_domain": {
                            "type": "string"
                          },
                          "data_colorcode": {
                            "type": "string"
                          },
                          "count": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
