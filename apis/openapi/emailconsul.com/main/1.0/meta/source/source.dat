            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
    },
    "/checkers/spf": {
      "get": {
        "tags": [
          "Checkers"
        ],
        "summary": "Check SPF record for a domain",
        "description": "Verifies the SPF record for the given domain.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The domain to check."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with SPF check result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "dns_queries_to_resolve": {
                          "type": "integer",
                          "description": "The number of DNS queries to resolve.",
                          "example": 3
                        },
                        "result": {
                          "type": "boolean",
                          "description": "The result of the SPF check.",
                          "example": true
                        },
                        "record": {
                          "type": "string",
                          "description": "The SPF record.",
                          "example": "v=spf1 include:_spf.google.com ~all"
                        },
                        "multiple_spf_records": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Any multiple SPF records encountered during the check.",
                          "example": [
                            "v=spf1 include:_spf1.example.com -all",
                            "v=spf1 include:_spf2.example.com ~all"
                          ]
                        },
                        "domain": {
                          "type": "string",
                          "description": "The domain that was checked.",
                          "example": "example.com"
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Any warnings encountered during the SPF check.",
                          "example": [
                            "No records found for example.com"
                          ]
                        },
                        "mechanisms": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "mechanism": {
                                "type": "string",
                                "description": "The SPF mechanism.",
                                "example": "a"
                              },
                              "modifier": {
                                "type": "string",
                                "description": "The SPF modifier.",
                                "example": "redirect"
                              },
                              "data": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object"
                                  }
                                ],
                                "description": "The data associated with the mechanism.",
                                "example": "string or object for include  mechanisms redirect modifier"
                              },
                              "warning": {
                                "type": "string",
                                "description": "Any warning associated with the mechanism.",
                                "example": "No records found"
                              },
                              "is_dns_query_to_resolve": {
                                "type": "boolean",
                                "description": "Indicates if a DNS query is required to resolve the mechanism.",
                                "example": true
                              },
                              "domain": {
                                "type": "string",
                                "description": "The domain associated with the mechanism.",
                                "example": "example.com"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
    },
    "/checkers/dkim/validate_textual_representation": {
      "post": {
        "tags": [
          "Checkers"
        ],
        "summary": "Validate DKIM textual representation",
