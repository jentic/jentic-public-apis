          },
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "text/csv"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "added": {
                          "type": "integer"
                        },
                        "not_added": {
                          "type": "integer"
                        },
                        "not_valid": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
