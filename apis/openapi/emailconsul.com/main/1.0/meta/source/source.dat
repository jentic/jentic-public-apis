                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "ip": {
                              "type": "string",
                              "description": "The related A record."
                            }
                          }
                        }
                      },
                      "rbl_result": {
                        "type": "object",
                        "properties": {
                          "host": {
                            "type": "string"
                          },
                          "blocklisted": {
                            "type": "boolean"
                          }
                        }
                      },
                      "domain": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
