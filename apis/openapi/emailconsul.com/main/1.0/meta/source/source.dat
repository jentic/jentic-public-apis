          },
          "ipReputations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reputation": {
                  "type": "string",
                  "enum": [
                    "REPUTATION_CATEGORY_UNSPECIFIED",
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                    "BAD"
                  ]
                },
                "ipCount": {
                  "type": "string"
                },
                "sampleIps": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "ip"
                  }
                }
              }
            }
          },
          "domainReputation": {
            "type": "string",
            "enum": [
              "REPUTATION_CATEGORY_UNSPECIFIED",
              "HIGH",
              "MEDIUM",
              "LOW",
              "BAD"
            ]
          },
          "spammyFeedbackLoops": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "spamRatio": {
                  "type": "number"
                }
              }
            }
          },
          "userReportedSpamRatio": {
            "type": "number"
          },
          "userReportedSpamRatioLowerBound": {
            "type": "number"
          },
          "userReportedSpamRatioUpperBound": {
            "type": "number"
          },
          "spfSuccessRatio": {
            "type": "number"
          },
          "dkimSuccessRatio": {
            "type": "number"
          },
          "dmarcSuccessRatio": {
            "type": "number"
          },
          "outboundEncryptionRatio": {
            "type": "number"
          },
          "inboundEncryptionRatio": {
            "type": "number"
          },
          "deliveryErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "errorClass": {
                  "type": "string",
                  "enum": [
                    "DELIVERY_ERROR_CLASS_UNSPECIFIED",
                    "PERMANENT_ERROR",
                    "TEMPORARY_ERROR"
                  ]
                },
                "errorType": {
                  "type": "string",
                  "enum": [
                    "DELIVERY_ERROR_TYPE_UNSPECIFIED",
                    "RATE_LIMIT_EXCEEDED",
                    "SUSPECTED_SPAM",
                    "CONTENT_SPAMMY",
                    "BAD_ATTACHMENT",
                    "BAD_DMARC_POLICY",
                    "LOW_IP_REPUTATION",
                    "LOW_DOMAIN_REPUTATION",
                    "IP_IN_RBL",
                    "DOMAIN_IN_RBL",
                    "BAD_PTR_RECORD"
                  ]
                },
                "errorRatio": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
