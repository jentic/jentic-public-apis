        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PaginationOffset"
          },
          {
            "$ref": "#/components/parameters/PaginationLimit"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "title",
                "created_at"
              ]
            },
            "description": "example -created_at (desc) or created_at (asc)"
          },
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "filter by title (partial match)"
          },
          {
            "name": "profile_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "filter by profile_id"
          },
          {
            "name": "show_all",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "only for an ADMIN, will return user_email as well in the body"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
