    "/alerts/stats/aggregated/{user_alert_id}/{rule_type}": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Get aggregated stats by user_alert_id and rule_type",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PeriodFromParam"
          },
          {
            "$ref": "#/components/parameters/PeriodToParam"
          },
          {
            "$ref": "#/components/parameters/UserAlertId"
          },
          {
            "$ref": "#/components/parameters/AlertRuleType"
          },
          {
            "$ref": "#/components/parameters/AlertProfileIdFilter"
          },
          {
            "$ref": "#/components/parameters/AlertIpFilter"
          },
          {
            "$ref": "#/components/parameters/AlertDomainFilter"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns aggregated stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "number"
                          },
                          "ip": {
                            "type": "string"
                          },
                          "domain": {
                            "type": "string"
                          },
                          "rbl": {
                            "type": "string"
                          },
                          "gp_domain_reputation": {
                            "type": "string"
                          },
                          "gp_ip_reputation": {
                            "type": "string"
                          },
                          "gp_delivery_error_class": {
                            "type": "string"
                          },
                          "gp_delivery_error_type": {
                            "type": "string"
                          },
                          "snds_filter_result": {
                            "type": "string"
                          },
                          "lookalike": {
                            "type": "string"
                          },
                          "time_range": {
                            "type": "string",
                            "enum": [
                              "ONE_DAY",
                              "ONE_WEEK",
                              "ONE_MONTH"
                            ]
                          },
                          "traps_ip": {
                            "type": "string"
                          },
                          "traps_domain_from": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
    },
