    "/checkers/dmarc/analyze_xml": {
      "post": {
        "tags": [
          "Checkers"
        ],
        "summary": "Analyze DMARC XML report",
        "description": "Analyzes the provided DMARC XML report.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "application/xml"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "integer"
                          },
                          "spf_pass": {
                            "type": "integer"
                          },
                          "dkim_pass": {
                            "type": "integer"
                          },
                          "dmarc_pass": {
                            "type": "integer"
                          },
                          "servers": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "count": {
                                  "type": "integer"
                                },
                                "spf_pass": {
                                  "type": "integer"
                                },
                                "dkim_pass": {
                                  "type": "integer"
                                },
                                "dmarc_pass": {
                                  "type": "integer"
                                },
                                "records": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "rdns": {
                                        "type": "string"
                                      },
                                      "ip_country": {
                                        "type": "string"
                                      },
                                      "ip": {
                                        "type": "string"
                                      },
                                      "count": {
                                        "type": "integer"
                                      },
                                      "p": {
                                        "type": "string"
                                      },
                                      "p_evaluated": {
                                        "type": "string"
                                      },
                                      "policy_evaluated_reasons": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "type": {
                                              "type": "string"
                                            },
                                            "comment": {
                                              "type": "string"
                                            },
                                            "error_code": {
                                              "type": "string"
                                            },
                                            "status_code": {
                                              "type": "string"
                                            }
                                          }
                                        }
                                      },
                                      "spf": {
                                        "type": "string"
                                      },
                                      "dkim": {
                                        "type": "string"
                                      },
                                      "dmarc": {
                                        "type": "string"
                                      },
                                      "spf_aligned": {
                                        "type": "boolean"
                                      },
                                      "dkim_aligned": {
                                        "type": "boolean"
                                      },
                                      "org_name": {
                                        "type": "string"
                                      },
                                      "auth_results": {
                                        "type": "object",
                                        "properties": {
                                          "dkim": {
                                            "type": "array",
                                            "items": {
                                              "type": "object",
                                              "properties": {
                                                "result": {
                                                  "type": "string"
                                                },
                                                "domain": {
                                                  "type": "string"
                                                },
                                                "selector": {
                                                  "type": "string"
                                                }
                                              }
                                            }
                                          },
                                          "spf": {
                                            "type": "array",
                                            "items": {
                                              "type": "object",
                                              "properties": {
                                                "result": {
                                                  "type": "string"
                                                },
                                                "domain": {
                                                  "type": "string"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponseBase"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
    },
