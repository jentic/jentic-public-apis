          }
        }
      }
    },
    "/slack_integration/callback": {
      "get": {
        "tags": [
          "Slack Integration"
        ],
        "summary": "Handle Slack OAuth callback",
        "description": "Processes the OAuth callback from Slack after user authorization. Saves the integration and redirects to the frontend.",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "schema": {
              "type": "string"
            },
            "description": "Authorization code from Slack OAuth"
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID passed as state parameter"
          },
          {
            "in": "query",
            "name": "error",
            "schema": {
              "type": "string"
            },
            "description": "Error code if user denied authorization"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the frontend with integration status",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Redirect URL (e.g., /alerts?slack_connected=true)"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponseBase"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorResponseBase"
          }
        }
      }
    },
    "/slack_integration/{id}": {
      "delete": {
        "tags": [
          "Slack Integration"
        ],
        "summary": "Disconnect Slack integration",
        "description": "Removes a Slack integration by ID. Sends a notification message to the channel and leaves it before deleting the integration.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
