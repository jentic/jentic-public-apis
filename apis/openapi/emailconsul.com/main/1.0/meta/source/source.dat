      "UpsertAlertBodyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rules"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          "profile_id": {
            "type": "string"
          },
          "is_active": {
            "type": "array",
            "default": true
          },
          "is_on_dashboards": {
            "type": "array",
            "default": true
          },
          "is_in_daily_report": {
            "type": "array",
            "default": true
          },
          "is_instant_alert": {
            "type": "array",
            "default": false
          },
          "instant_alert_email": {
            "type": "string",
            "maxLength": 320,
            "description": "send only if is_instant_alert is true"
          },
          "webhook_url": {
            "type": "string",
            "description": "for POST request only"
          },
          "slack_integration_id": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "required": [
              "type"
            ],
            "items": {
              "$ref": "#/components/schemas/UserAlertRuleBaseModel"
            }
          },
          "formula": {
            "type": "string",
            "description": "sends only if there are multiple rules sent"
          }
        }
      },
