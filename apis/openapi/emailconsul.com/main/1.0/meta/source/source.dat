            "type": "string",
            "description": "Sender domain for email delivery"
          },
          "tracking_pixel": {
            "type": "boolean",
            "description": "Whether tracking pixel is enabled"
          },
          "tracking_link": {
            "type": "boolean",
            "description": "Whether link tracking is enabled"
          },
          "tracking_unsubscribe": {
            "type": "boolean",
            "description": "Whether unsubscribe tracking is enabled"
          },
