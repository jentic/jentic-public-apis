{"openapi":"3.1.0","info":{"title":"JustBacked API","version":"1.0.0","description":"Jobs at venture-backed startups that raised in the last six months, plus the member's application tracker, company lists and saved searches. Members only: create a key at https://justbacked.com/account#api. 1,000 requests per day per member (UTC). JustBacked never submits job applications; the application-form endpoint is read-only.","contact":{"email":"support@justbacked.com","url":"https://justbacked.com/developers"}},"servers":[{"url":"https://justbacked.com/api/v1"}],"security":[{"bearer":[]}],"paths":{"/me":{"get":{"summary":"Membership, API usage and counts","operationId":"getAccount","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Object"}}}},"400":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed or revoked key (WWW-Authenticate challenge included)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a member","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/jobs":{"get":{"summary":"Search open roles (same query string as justbacked.com/jobs)","operationId":"searchJobs","parameters":[{"name":"q","in":"query","required":false,"description":"Keywords in title, company, department","schema":{"type":"string"}},{"name":"desc","in":"query","required":false,"description":"1 = also search descriptions","schema":{"type":"string"}},{"name":"metro","in":"query","required":false,"description":"Comma-separated metro ids: sf,nyc,la,bos,sea,aus,den,chi,dc,mia,atl,sd,lon,par,ber,muc,tor,sgp,blr,tlv,sto,ams","schema":{"type":"string"}},{"name":"loc","in":"query","required":false,"description":"Free-text location","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Comma-separated country codes (us,gb,de...)","schema":{"type":"string"}},{"name":"mode","in":"query","required":false,"description":"remote,hybrid,onsite","schema":{"type":"string"}},{"name":"fn","in":"query","required":false,"description":"Functions: engineering,product,design,data,sales,marketing,customer,operations,finance,people,legal,hardware,science,clinical","schema":{"type":"string"}},{"name":"lvl","in":"query","required":false,"description":"Seniority: intern,entry,mid,senior,staff,manager,director,exec","schema":{"type":"string"}},{"name":"stage","in":"query","required":false,"description":"preseed,seed,a,b,c,growth,venture","schema":{"type":"string"}},{"name":"raised","in":"query","required":false,"description":"Latest round within N days","schema":{"type":"integer"}},{"name":"min","in":"query","required":false,"description":"Latest round at least N USD","schema":{"type":"integer"}},{"name":"minpay","in":"query","required":false,"description":"Published annual pay at least N USD","schema":{"type":"integer"}},{"name":"pay","in":"query","required":false,"description":"1 = only roles with published pay","schema":{"type":"string"}},{"name":"size","in":"query","required":false,"description":"1-10,11-50,51-250,251-1000,1000+","schema":{"type":"string"}},{"name":"ind","in":"query","required":false,"description":"Industry keywords","schema":{"type":"string"}},{"name":"inv","in":"query","required":false,"description":"Investor names","schema":{"type":"string"}},{"name":"posted","in":"query","required":false,"description":"Posted within N hours","schema":{"type":"integer"}},{"name":"fast","in":"query","required":false,"description":"1 = companies adding 10+ roles in 30 days","schema":{"type":"string"}},{"name":"emp","in":"query","required":false,"description":"fulltime,parttime,contract,intern","schema":{"type":"string"}},{"name":"not","in":"query","required":false,"description":"Exclude title words","schema":{"type":"string"}},{"name":"list","in":"query","required":false,"description":"One of your list ids","schema":{"type":"string"}},{"name":"all","in":"query","required":false,"description":"1 = include non-venture rounds","schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"description":"new | relevance | raised | amount","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"1-50 (default 20)","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Paging offset","schema":{"type":"integer"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobSearch"}}}},"400":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed or revoked key (WWW-Authenticate challenge included)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a member","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/jobs/{slug}":{"get":{"summary":"One role in full","operationId":"getJob","parameters":[{"name":"slug","in":"path","required":true,"description":"Job slug from /jobs","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Object"}}}},"400":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing, malformed or revoked key (WWW-Authenticate challenge included)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a member","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"descript