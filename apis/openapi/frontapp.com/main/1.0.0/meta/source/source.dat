      "TagResponse": {
        "type": "object",
        "description": "A tag is a label that can be used to classify conversations.",
        "required": [
          "_links",
          "id",
          "name",
          "description",
          "highlight",
          "is_private",
          "is_visible_in_conversation_lists"
        ],
        "properties": {
          "_links": {
            "type": "object",
            "properties": {
