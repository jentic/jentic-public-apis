                "example": "https://yourCompany.api.frontapp.com/views/lns_abc123"
              },
              "related": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string",
                    "nullable": true,
                    "description": "Link to the team that owns the view",
