          "name": {
            "type": "string",
            "description": "Name of the list",
            "example": "Party Planning Committee"
          },
          "is_private": {
            "type": "boolean",
            "description": "Whether or not the contact is individual",
            "example": false
          }
        }
      },
      "ContactNoteResponses": {
        "type": "object",
        "required": [
          "_links",
