                  },
                  "owner": {
                    "type": "string",
                    "description": "Link to list owner",
                    "example": "https://yourCompany.api.frontapp.com/teammates/tea_e35u"
                  }
                }
              }
            }
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the list",
