{
  "openapi": "3.1.0",
  "info": {
    "title": "WatchCron API",
    "description": "REST API for managing cron job checks, viewing ping history, and querying notification channels. Monitor your scheduled tasks programmatically.",
    "version": "1.0.0",
    "contact": {
      "email": "support@watchcron.com",
      "url": "https://watchcron.com/docs/api"
    }
  },
  "servers": [
    {
      "url": "https://watchcron.com/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/checks": {
      "get": {
        "summary": "List checks",
        "description": "Returns a paginated list of all checks in the project associated with your API key.",
        "tags": ["Checks"],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter checks by tag (exact match)"
          },
          { "$ref": "#/components/parameters/perPage" },
          { "$ref": "#/components/parameters/page" }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of checks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Check" }
                    },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a check",
        "description": "Creates a new cron job check. The response includes a `ping_url` that your cron job should call on completion.",
        "tags": ["Checks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "schedule_type"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Display name for the check"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000,
                    "nullable": true,
                    "description": "Optional description"
                  },
                  "schedule_type": {
                    "type": "string",
                    "enum": ["simple", "cron"],
                    "description": "'simple' for fixed intervals, 'cron' for cron expressions"
                  },
                  "period_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "nullable": true,
                    "description": "Interval in seconds (required if schedule_type is 'simple')"
                  },
                  "cron_expression": {
                    "type": "string",
                    "maxLength": 100,
                    "nullable": true,
                    "description": "Standard 5-field cron expression (required if schedule_type is 'cron')"
                  },
                  "timezone": {
                    "type": "string",
                    "maxLength": 64,
                    "default": "UTC",
                    "description": "IANA timezone for cron schedule evaluation"
                  },
                  "grace_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Seconds to wait after expected ping before alerting"
                  },
                  "tags": {
                    "type": "array",
                    "items": { "type": "string", "maxLength": 50 },
                    "nullable": true,
                    "description": "List of tag strings for organizing checks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Check created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Check" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/checks/{uuid}": {
      "get": {
        "summary": "Get a check",
        "description": "Returns full details for a single check.",
        "tags": ["Checks"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" }
        ],
        "responses": {
          "200": {
            "description": "Check details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Check" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found or belongs to another project" }
        }
      },
      "put": {
        "summary": "Update a check",
        "description": "Updates one or more fields on an existing check. Only include fields you want to change.",
        "tags": ["Checks"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "maxLength": 255 },
                  "description": { "type": "string", "maxLength": 1000, "nullable": true },
                  "schedule_type": { "type": "string", "enum": ["simple", "cron"] },
                  "period_seconds": { "type": "integer", "minimum": 60, "nullable": true },
                  "cron_expression": { "type": "string", "maxLength": 100, "nullable": true },
                  "timezone": { "type": "string", "maxLength": 64, "nullable": true },
                  "grace_seconds": { "type": "integer", "minimum": 0, "nullable": true },
                  "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Check" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "summary": "Delete a check",
        "description": "Permanently deletes a check and all associated ping data.",
        "tags": ["Checks"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" }
        ],
        "responses": {
          "204": { "description": "Check deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found" }
        }
      }
    },
    "/checks/{uuid}/pause": {
      "patch": {
        "summary": "Pause or unpause a check",
        "description": "Pauses or resumes monitoring. While paused, missed pings do not trigger alerts.",
        "tags": ["Checks"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paused": {
                    "type": "boolean",
                    "default": true,
                    "description": "true to pause, false to resume"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Check" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found" }
        }
      }
    },
    "/checks/{uuid}/pings": {
      "get": {
        "summary": "List pings",
        "description": "Returns the ping history for a check, ordered newest first.",
        "tags": ["Pings"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" },
          { "$ref": "#/components/parameters/perPage" },
          { "$ref": "#/components/parameters/page" }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of pings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Ping" }
                    },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found" }
        }
      }
    },
    "/checks/{uuid}/flips": {
      "get": {
        "summary": "List status flips",
        "description": "Returns the history of status transitions for a check (e.g. up → down → up).",
        "tags": ["Flips"],
        "parameters": [
          { "$ref": "#/components/parameters/checkUuid" },
          { "$ref": "#/components/parameters/perPage" },
          { "$ref": "#/components/parameters/page" }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of flips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Flip" }
                    },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Check not found" }
        }
      }
    },
    "/channels": {
      "get": {
        "summary": "List notification channels",
        "description": "Returns all notification channels in the project associated with your API key.",
        "tags": ["Channels"],
        "responses": {
          "200": {
            "description": "List of channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Channel" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key from Dashboard → Project Settings → API Keys"
      }
    },
    "parameters": {
      "checkUuid": {
        "name": "uuid",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Check UUID"
      },
      "perPage": {
        "name": "per_page",
        "in": "query",
        "schema": { "type": "integer", "default": 25 },
        "description": "Results per page"
      },
      "page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "default": 1 },
        "description": "Page number"
      }
    },
    "schemas": {
      "Check": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid", "description": "Unique identifier" },
          "name": { "type": "string", "description": "Display name" },
          "description": { "type": "string", "nullable": true, "description": "Optional description" },
          "status": {
            "type": "string",
            "enum": ["new", "up", "grace", "down", "paused"],
            "description": "Current monitoring status"
          },
          "schedule_type": {
            "type": "string",
            "enum": ["simple", "cron"],
            "description": "Schedule type"
          },
          "period_seconds": { "type": "integer", "nullable": true, "description": "Interval in seconds (simple schedule)" },
          "cron_expression": { "type": "string", "nullable": true, "description": "Cron expression (cron schedule)" },
          "timezone": { "type": "string", "description": "IANA timezone" },
          "grace_seconds": { "type": "integer", "description": "Grace period in seconds" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "nullable": true,
            "description": "Tag strings"
          },
          "is_paused": { "type": "boolean", "description": "Whether monitoring is paused" },
          "ping_url": { "type": "string", "format": "uri", "description": "URL your cron job should ping" },
          "last_ping_at": { "type": "string", "format": "date-time", "nullable": true, "description": "Most recent ping timestamp" },
          "next_expected_at": { "type": "string", "format": "date-time", "nullable": true, "description": "Next expected ping timestamp" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Ping": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["success", "start", "fail", "log"],
            "description": "Ping signal type"
          },
          "remote_ip": { "type": "string", "description": "IP address that sent the ping" },
          "duration_ms": { "type": "integer", "nullable": true, "description": "Job duration in milliseconds" },
          "created_at": { "type": "string", "format": "date-time", "description": "When the ping was received" }
        }
      },
      "Flip": {
        "type": "object",
        "properties": {
          "old_status": {
            "type": "string",
            "enum": ["new", "up", "grace", "down", "paused"],
            "description": "Previous status"
          },
          "new_status": {
            "type": "string",
            "enum": ["new", "up", "grace", "down", "paused"],
            "description": "New status"
          },
          "created_at": { "type": "string", "format": "date-time", "description": "When the status changed" }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "Channel identifier" },
          "name": { "type": "string", "description": "Display name" },
          "type": {
            "type": "string",
            "enum": ["email", "webhook", "slack", "telegram", "discord", "ms_teams", "sms", "voice", "pagerduty", "opsgenie"],
            "description": "Notification channel type"
          },
          "is_active": { "type": "boolean", "description": "Whether the channel is enabled" },
          "checks_count": { "type": "integer", "description": "Number of checks using this channel" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "pagination": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "description": "Total number of items" },
              "per_page": { "type": "integer", "description": "Items per page" },
              "current_page": { "type": "integer", "description": "Current page number" },
              "last_page": { "type": "integer", "description": "Last page number" }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Invalid API key" }
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid request body",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Invalid cron expression" }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Checks", "description": "Create, list, update, and delete cron job checks" },
    { "name": "Pings", "description": "View ping history for a check" },
    { "name": "Flips", "description": "View status change history" },
    { "name": "Channels", "description": "List notification channels" }
  ]
}
