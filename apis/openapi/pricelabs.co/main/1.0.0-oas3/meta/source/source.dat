{
  "openapi": "3.0.3",
  "info": {
    "title": "PriceLabs Customer API",
    "description": "\nUsing PriceLabs Customer API, users will be able to import PriceLabs' Dynamic prices per listing in any system. These prices are updated every 24 hours. \n\n [Click here](https://help.pricelabs.co/portal/en/kb/articles/pricelabs-api) to know more about Customer API and to know how you can enable it for your PriceLabs account.\n  \n  Please reach out to support@pricelabs.co if you have any queries on the Customer API.\n  \n  Once the Customer API is enabled for your PL account, please use copy the API key from Settings => API Details in your PriceLabs account and send it as X-API-Key in the header for each of the below endpoints.\n  \n  \n  ## Rate limiting & Timeout configuration\n  Each Customer API Key accessing the API has a limit of 60 requests per min capped at 1000 requests per hour. Reaching the rate limit will return a 429 Too Many Requests status code.\n  \n  Please be aware that the processing time for your request may vary depending on the current server load. We recommend setting the client timeout to 300 seconds to allow for any potential delays, even though our aim is to respond to all requests within that timeframe.\n\n",
    "version": "1.0.0-oas3",
    "contact": {
      "name": "PriceLabs Support",
      "email": "support@pricelabs.co",
      "url": "http://pricelabs.co"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Customer_API/customer_api/1.0.0-oas3"
  },
  "tags": [
    {
      "name": "Customer APIs",
      "description": "Here are all the endpoints available in our Customer API"
    }
  ],
  "servers": [
    {
      "url": "https://api.pricelabs.co"
    }
  ],
  "paths": {
    "/v1/listings": {
      "get": {
        "summary": "Get all listings in an account",
        "description": "This API call will return all the listings in a customer's account across all PMSs, with their minimum price, base price, recommended base price and maximum price along with other Performance Metrics available on the Pricing Dashboard and Multi-Calendar pages. You can find performance metrics after clicking \"Add Metrics\" button on the Pricing Dashboard or Multi Calendar.",
        "tags": [
          "Listings"
        ],
        "operationId": "allListings",
        "parameters": [
          {
            "in": "query",
            "name": "skip_hidden",
            "description": "This param can be used to filter hidden listings. Default is false which will return all listings including hidden listing. If set to true then hidden listings will not be returned in the response.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "example": true
            }
          },
          {
            "in": "query",
            "name": "only_syncing_listings",
            "description": "This param can be used to filter listings based on their sync status. Default is false which will return all listings in the PriceLabs user account. If set to true then return only those listings will be returned whose sync is turned ON.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "example": true
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{API_KEY}}"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "listings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique listing ID"
                          },
                          "pms": {
                            "type": "string",
                            "description": "PMS that this listing belongs to."
                          },
                          "name": {
                            "type": "string",
                            "description": "Name of the listing"
                          },
                          "latitude": {
                            "type": "string",
                            "example": 41.8781136
                          },
                          "longitude": {
                            "type": "string",
                            "example": -87.6297982
                          },
                          "country": {
                            "type": "string",
                            "example": "United States"
                          },
                          "city_name": {
                            "type": "string",
                            "example": "Chicago"
                          },
                          "state": {
                            "type": "string",
                            "example": "Illinois"
                          },
                          "no_of_bedrooms": {
                            "type": "number",
                            "description": "Number of bedrooms in the listing. For Studio/Hotel room, it will be 0. If null, then bedroom count is not provided by the PMS via API. In such cases, bedroom count must be updated via PriceLabs account."
                          },
                          "min": {
                            "type": "object",
                            "description": "minimum price for the listing"
                          },
                          "base": {
                            "type": "number",
                            "description": "base price for the listing"
                          },
                          "max": {
                            "type": "object",
                            "description": "maximum price for the listing"
                          },
                          "group": {
                            "type": "string",
                            "description": "Listing Group"
                          },
                          "subgroup": {
                            "type": "string",
                            "description": "Listing Sub group"
                          },
                          "tags": {
                            "type": "string",
                            "description": "PL tags for the listing"
                          },
                          "notes": {
                            "type": "string",
                            "description": "Notes added for the listing"
                          },
                          "isHidden": {
                            "type": "boolean",
                            "description": "If the listing is hidden or not on PL Pricing dashboard"
                          },
                          "push_enabled": {
                            "type": "boolean",
                            "description": "If Sync is turned ON for the listing or not"
                          },
                          "occupancy_next_7": {
                            "type": "number",
                            "description": "Listing Occupancy in the next 7 days"
                          },
                          "market_occupancy_next_7": {
                            "type": "number",
                            "description": "Market Occupancy in the next 7 days"
                          },
                          "occupancy_next_30": {
                            "type": "number",
                            "description": "Listing Occupancy in the next 30 days"
                          },
                          "market_occupancy_next_30": {
                            "type": "number",
                            "description": "Market Occupancy in the next 30 days"
                          },
                          "occupancy_next_60": {
                            "type": "number",
                            "description": "Listing Occupancy in the next 60 days"
                          },
                          "market_occupancy_next_60": {
                            "type": "number",
                            "description": "Market Occupancy in the next 30 days"
                          },
                          "occupancy_next_90": {
                            "type": "number",
                            "description": "Listing Occupancy in the next 90 days"
                          },
                          "market_occupancy_next_90": {
                            "type": "number",
                            "description": "Market Occupancy in the next 90 days"
                          },
                          "revenue_past_7": {
                            "type": "number",
                            "description": "Revenue in past 7 days"
                          },
                          "stly_revenue_past_7": {
                            "type": "number",
                            "description": "Past 7 days revenue same time last year"
                          },
                          "recommended_base_price": {
                            "type": "string",
                            "description": "PL recommended base price"
                          },
                          "last_date_pushed": {
                            "type": "string",
                            "description": "Last synced time"
                          },
                          "last_refreshed_at": {
                            "type": "string",
                            "description": "Last time the prices were refreshed"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "listings": [
                      {
                        "id": "834874",
                        "pms": "rentalsunited",
                        "name": "Rentals United - PriceLabs1New",
                        "latitude": 41.8781136,
                        "longitude": -87.6297982,
                        "country": "United States",
                        "city_name": "Chicago",
                        "state": "Illinois",
                        "no_of_bedrooms": 3,
                        "cleaning_fees": 70,
                        "min": 90,
                        "base": 145,
                        "max": 200,
                        "group": "testgroup",
                        "subgroup": "testsubgroup",
                        "tags": "testtag",
                        "notes": "testnotes",
                        "isHidden": false,
                        "push_enabled": false,
                        "occupancy_next_7": 100,
                        "market_occupancy_next_7": 75,
                        "occupancy_next_30": 90,
                        "market_occupancy_next_30": 85,
                        "occupancy_next_60": 87,
                        "market_occupancy_next_60": 67,
                        "occupancy_past_90": 78,
                        "market_occupancy_past_90": 87,
                        "revenue_past_7": "76,",
                        "stly_revenue_past_7": 67,
                        "recommended_base_price": 120,
                        "last_date_pushed": "2023-03-15T11:23:21.000Z",
                        "last_refreshed_at": "2023-04-10T14:06:29+00:00"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update one or more listings in an account",
        "tags": [
          "Listings"
        ],
        "description": "You can either update a listing or a group of listings.\n\n#### Required parameters: \n(In case of `min`, `base` and `max` you can send all three, or any two or any one among the three)\n \n'tags' is an optional feature that can be sent to update the tags in the UI. A maximum of 10 tags can be sent in the array.\n* `id`: Listing ID\n* `pms`: PMS name of the listing\n* `min`: Min price of the listing\n* `base`: Base price of the listing\n* `max`: Max price of the listing\n \n* `tags`: [\"NY\",\"Bucket\",\"Big\"]\n\n#### Response Codes:\n* 200: Parameters were updated\n* 400: Invalid listing `id` or `pms` name; please check your request",
        "operationId": "updateListings",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{API_KEY}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "listings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "2854562"
                        },
                        "min": {
                          "type": "number",
                          "example": 899
                        },
                        "pms": {
                          "type": "string",
                          "example": "airbnb"
                        }
                      }
                    },
                    "example": [
                      {
                        "id": "2854562",
                        "min": 899,
                        "pms": "airbnb"
                      }
                    ]
                  }
                }
              },
              "example": {
                "listings": [
                  {
                    "id": "2854562",
                    "min": 899,
                    "pms": "airbnb"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Age": {
                "schema": {
                  "type": "string",
                  "example": "1"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "max-age=0, private, must-revalidate"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Sat, 10 Nov 2018 03:27:04 GMT"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string",
                  "example": "W/\"7b50ffc2feb4b141dd5fa9ab4d1da33e\""
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "nginx/1.10.3 (Ubuntu)"
                }
              },
              "Status": {
                "schema": {
                  "type": "string",
                  "example": "200 OK"
                }
              },
              "Strict-Transport-Security": {
                "schema": {
                  "type": "string",
                  "example": "max-age=31536000;"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "example": "Accept-Encoding"
                }
              },
              "Via": {
                "schema": {
                  "type": "string",
                  "example": "http/1.1 api-umbrella (ApacheTrafficServer [cMsSf ])"
                }
              },
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "example": "MISS"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "example": "nosniff"
                }
              },
              "X-Frame-Options": {
                "schema": {
                  "type": "string",
                  "example": "SAMEORIGIN"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "example": "321b0732-466f-413f-b23a-067f7e787719"
                }
              },
              "X-Runtime": {
                "schema": {
                  "type": "string",
                  "example": "0.048499"
                }
              },
              "X-XSS-Protection": {
                "schema": {
                  "type": "string",
                  "example": "1; mode=block"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "listings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "base": {
                            "type": "number",
                            "example": 1200
                          },
                          "id": {
                            "type": "string",
                            "example": "2854562"
                          },
                          "max": {
                            "type": "number",
                            "example": 1500
                          },
                          "min": {
                            "type": "number",
                            "example": 900
                          }
                        }
                      },
                      "example": [
                        {
                          "base": 1200,
                          "id": "2854562",
                          "max": 1500,
                          "min": 900
                        },
                        {
                          "base": 1300,
                          "id": "2590637",
                          "max": 1800,
                          "min": 800
                        }
                      ]
                    }
                  }
                },
                "examples": {
                  "update listings": {
                    "value": {
                      "listings": [
                        {
                          "base": 1200,
                          "id": "2854562",
                          "max": 1500,
                          "min": 900
                        },
                        {
                          "base": 1300,
                          "id": "2590637",
                          "max": 1800,
                          "min": 800
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings/{listing_id}": {
      "get": {
        "summary": "Get a specific listing in an account",
        "description": "This API call will return a specific listing in a customer's account, with their minimum price, base price, recommended base price and maximum price along with other Performance Metrics available on the Pricing Dashboard and Multi-Calendar pages. You can find performance metrics after clicking \"Add Metrics\" button on the Pricing Dashboard or Multi Calendar.",
        "tags": [
          "Listings"
        ],
        "operationId": "singleListing",
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": 834874
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "listings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "pms": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "latitude": {
                            "type": "string",
                            "example": 41.8781136
                          },
                          "longitude": {
                            "type": "string",
                            "example": -87.6297982
                          },
                          "country": {
                            "type": "string",
                            "example": "United States"
                          },
                          "city_name": {
                            "type": "string",
                            "example": "Chicago"
                          },
                          "state": {
                            "type": "string",
                            "example": "Illinois"
                          },
                          "no_of_bedrooms": {
                            "type": "number"
                          },
                          "min": {
                            "type": "object"
                          },
                          "base": {
                            "type": "number"
                          },
