      "delete": {
        "summary": "Delete a listing's date specific override",
        "description": "Use this API to delete a Date Specific Override(DSO). If you send `update_children` as true, then the DSO for child listing will also be deleted. If you send `update_children` as false, then DSO will only be deleted for the parent listing and not for the child listings.",
        "operationId": "listingDateLevelOverrides2",
        "tags": [
          "Date Specific Overrides (DSO)"
        ],
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{API_KEY}}"
            }
          },
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": ""
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "overrides": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "example": "2023-07-17"
                        }
                      }
                    },
                    "example": [
                      {
                        "date": "2023-07-17"
                      },
                      {
                        "date": "2023-07-19"
                      },
                      {
                        "date": "2023-07-20"
                      },
                      {
                        "date": "2023-07-25"
                      }
                    ]
                  },
                  "pms": {
                    "type": "string",
                    "example": "airbnb"
                  },
                  "update_children": {
                    "type": "boolean",
                    "example": true,
                    "description": "Sending this flag as true will also delete the DSO for child listings"
                  }
                }
              },
              "example": {
                "overrides": [
                  {
                    "date": "2023-07-17"
                  },
                  {
                    "date": "2023-07-19"
                  },
                  {
                    "date": "2023-07-20"
                  },
                  {
                    "date": "2023-07-25"
                  }
                ],
                "pms": "airbnb",
                "update_children": true
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "A successful response with status 204. The response body will be empty",
            "headers": {
              "Age": {
                "schema": {
                  "type": "string",
                  "example": "0"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Sat, 10 Nov 2018 18:52:57 GMT"
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "nginx/1.10.3 (Ubuntu)"
                }
              },
              "Status": {
                "schema": {
                  "type": "string",
                  "example": "204 No Content"
                }
              },
              "Strict-Transport-Security": {
                "schema": {
                  "type": "string",
                  "example": "max-age=31536000;"
                }
              },
              "Via": {
                "schema": {
                  "type": "string",
                  "example": "http/1.1 api-umbrella (ApacheTrafficServer [cMs f ])"
                }
              },
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "example": "MISS"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "example": "nosniff"
                }
              },
              "X-Frame-Options": {
                "schema": {
                  "type": "string",
                  "example": "SAMEORIGIN"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "example": "b84864c3-118c-4014-acb4-1508c9db4fd0"
                }
              },
              "X-Runtime": {
                "schema": {
                  "type": "string",
                  "example": "0.160643"
                }
              },
              "X-XSS-Protection": {
                "schema": {
                  "type": "string",
                  "example": "1; mode=block"
                }
              }
            },
            "content": {
              "text/plain": {
                "examples": {
                  "listing date level overrides": {
                    "value": ""
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/listing_prices": {
      "post": {
        "summary": "prices for listings",
        "description": "Use this API to get prices for your listings that exist in your PriceLabs account. Following conditions are to be **followed strictly**:\n\n#### Rules:\n1. Listing and their PMS have to exist in your PriceLabs account.\n\n\n2. You may provide a date range using the \"dateFrom\" and \"dateTo\" fields in the request body, if you want to fetch prices for a specific date range. Kindly note that both \"dateFrom\" and \"dateTo\" should be valid current OR future dates. If any past dates are sent, then we will return prices for the entire calendar.\n\n#### Response:\nResponse will contain price information that was last refreshed for each listing. \n\n#### Error Statuses:\n1. **`LISTING_NOT_PRESENT`**: This particular listing does not exist in PriceLabs, either it was deleted or was never added. Please re-connect this listing's PMS on PriceLabs and try again.\n2. **`LISTING_NO_DATA`**: Prices were not fetched on PriceLabs. Please head over to PriceLabs and review prices and once you see recommendations then you can retry the API request to get prices for this listing.\n\n3. **`LISTING_TOGGLE_OFF`**: Sync is turned OFF for the listing. Hence, the prices cannot be returned. Please head over to PriceLabs and turn the sync ON if you want to pull prices from API for this listing.",
        "operationId": "pricesForListings",
        "tags": [
          "Prices"
        ],
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{API_KEY}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "listings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique listing ID",
                          "example": "ABCDEF"
                        },
                        "pms": {
                          "type": "string",
                          "description": "PMS Name",
                          "example": "pms"
                        },
                        "dateFrom": {
                          "type": "string",
                          "example": "2023-01-01",
                          "description": "should be valid current OR future date. If any past dates are sent, then we will return prices for the entire calendar."
                        },
                        "dateTo": {
                          "type": "string",
                          "example": "2023-12-31",
                          "description": "should be valid current OR future date. If any past dates are sent, then we will return prices for the entire calendar."
                        },
                        "reason": {
                          "type": "boolean",
                          "example": true,
                          "description": "If set true, then we will return the pricing information in response"
                        }
                      }
                    },
                    "example": [
                      {
                        "id": "ABCDEF",
                        "pms": "pms",
                        "dateFrom": "2023-01-01",
                        "dateTo": "2023-12-31"
                      },
                      {
                        "id": "12345",
                        "pms": "airbnb"
                      },
                      {
                        "id": "11051___123121",
                        "pms": "lodgify"
                      },
                      {
                        "id": "bcd32262-eb0d-4192-b2eb-3da30f380346",
                        "pms": "orbirental"
                      }
                    ]
                  }
                }
              },
              "example": {
                "listings": [
                  {
                    "id": "ABCDEF",
                    "pms": "pms",
                    "dateFrom": "2023-01-01",
                    "dateTo": "2023-12-31",
                    "reason": true
                  },
                  {
                    "id": "12345",
                    "pms": "airbnb"
                  },
                  {
                    "id": "11051___123121",
                    "pms": "lodgify"
                  },
                  {
                    "id": "bcd32262-eb0d-4192-b2eb-3da30f380346",
                    "pms": "orbirental"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "ID for the listing"
                      },
                      "pms": {
                        "type": "string",
                        "description": "PMS Name"
                      },
                      "group": {
                        "type": "string",
                        "description": "Listing group"
                      },
                      "currency": {
                        "type": "string",
                        "description": "Currency for the listing"
                      },
                      "last_refreshed_at": {
                        "type": "string",
                        "description": "DateTime when the listing was last refreshed in PL like when \"Save & Refresh\" is done. Also updated when sync happens as prices are refreshed before sync."
                      },
                      "los_pricing": {
                        "type": "object",
                        "description": "LOS pricing as defined in PL for the listing",
                        "properties": {
                          "los_night": {
                            "type": "object",
                            "description": "This is the \"Stay Length\" in LOS pricing model",
                            "properties": {
                              "los_night": {
                                "type": "string",
                                "description": "This is the \"Stay Length\" in LOS pricing model"
                              },
                              "max_price": {
                                "type": "string",
                                "description": "Max Price for the LOS"
                              },
                              "min_price": {
                                "type": "string",
                                "description": "Minimum Price for the LOS"
                              },
                              "los_adjustment": {
                                "type": "string",
                                "description": "Percentage Premium or Discount"
                              }
                            }
                          }
                        }
                      },
                      "data": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "date": {
                              "type": "string",
                              "description": "Applicable date for the mentioned prices"
                            },
                            "price": {
                              "type": "number",
                              "description": "This is the price recommended by PriceLabs"
                            },
                            "user_price": {
                              "type": "number",
                              "description": "Last Seen Price on the PMS. If \"-1\" it means day is unavailable"
                            },
                            "uncustomized_price": {
                              "type": "number",
                              "description": "Uncustomized Price"
                            },
                            "min_stay": {
                              "type": "number",
                              "description": "minimum stay"
                            },
                            "booking_status": {
                              "type": "string",
                              "description": "Booking Status"
                            },
                            "booking_status_STLY": {
                              "type": "string",
                              "description": "Booking Status same time last year"
                            },
                            "ADR": {
                              "type": "string",
                              "description": "Average Daily Rate"
                            },
                            "ADR_STLY": {
                              "type": "string",
                              "description": "Average Daily Rate same time last year"
                            },
                            "unbookable": {
                              "type": "number",
                              "description": "If 0, date is bookable, if 1, date is not bookable due to a minimum stay/check-in/check-out restriction set on PriceLabs"
                            },
                            "booked_date": {
                              "type": "string"
                            },
                            "booked_date_STLY": {
                              "type": "string"
                            },
                            "weekly_discount": {
                              "type": "number",
                              "description": "Weekly discount applied, if any"
                            },
                            "monthly_discount": {
                              "type": "number",
                              "description": "monthly discount applied, if any"
                            },
                            "extra_person_fee": {
                              "type": "number",
                              "description": "Extra guest fees, if applicable"
                            },
                            "extra_person_fee_trigger": {
                              "type": "number",
                              "description": "No. of guests after which extra guest fees is applicable"
                            },
                            "check_in": {
                              "type": "boolean",
                              "description": "Whether check-in is allowed(true) or not(false)"
                            },
                            "check_out": {
                              "type": "boolean",
                              "description": "Whether check-out is allowed(true) or not(false)"
                            },
                            "demand_color": {
                              "type": "string",
                              "description": "Color code of the demand color"
                            },
                            "demand_desc": {
                              "type": "string",
                              "description": "Demand description like Low Demand, Normal Demand, Good Demand, High Demand"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Listing Prices": {
                    "value": [
                      {
                        "id": "PL111",
                        "pms": "test_pms",
                        "group": "",
