    "/v1/reservation_data": {
      "get": {
        "summary": "Get Reservations received from your PMS along with rental revenue information.",
        "description": "This API will return all the reservations received from the PMS connected to the PriceLabs account. If a PMS does not provide reservations, this API will not return any reservations for that PMS.Kindly note that rental_revenue is available for only those PMSs that share this information. booking_status can have only two values - booked or cancelled.\nThe response is paginated, with limit as 100 results per page. This API call should be called to fetch more page results, until next_page = false.",
        "operationId": "getReservations",
        "tags": [
          "Reservations"
        ],
        "parameters": [
          {
            "name": "pms",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "igms"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2020-01-01"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2020-01-10"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "example": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "string",
              "example": 0
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{API_KEY}}"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pms_name": {
                      "type": "string"
                    },
                    "next_page": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "listing_id": {
                            "type": "string"
                          },
                          "listing_name": {
                            "type": "string"
                          },
                          "reservation_id": {
                            "type": "string"
                          },
                          "check_in": {
                            "type": "string"
                          },
                          "check_out": {
                            "type": "string"
                          },
                          "booking_status": {
                            "type": "string",
                            "example": "booked"
                          },
                          "booked_date": {
                            "type": "string"
                          },
                          "rental_revenue": {
                            "type": "string"
                          },
                          "total_cost": {
                            "type": "string"
                          },
                          "no_of_days": {
                            "type": "number"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "cancelled_on": {
                            "type": "string"
                          },
                          "min_price_type": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
