                            "type": "boolean"
                          },
                          "push_enabled": {
                            "type": "boolean"
                          },
                          "occupancy_next_7": {
                            "type": "number"
                          },
                          "market_occupancy_next_7": {
                            "type": "number"
                          },
                          "occupancy_next_30": {
                            "type": "number"
                          },
                          "market_occupancy_next_30": {
                            "type": "number"
                          },
                          "occupancy_next_60": {
                            "type": "number"
                          },
