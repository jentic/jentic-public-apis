{
  "openapi": "3.0.0",
  "info": {
    "title": "Nirvartech Patient API",
    "version": "1.0.0",
    "description": "API documentation for the patient-facing features of the Nirvartech application.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/srj-b0f/nirvartech-patient-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://admin.nirvartech.com/api",
      "description": "Production API server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User registration, login, logout, and password reset operations."
    },
    {
      "name": "Patient Profile",
      "description": "Managing patient personal information, profile updates, and search."
    },
    {
      "name": "Folders",
      "description": "Operations related to managing patient's health record folders."
    },
    {
      "name": "Files",
      "description": "Operations related to managing files (prescriptions, test reports) within folders."
    },
    {
      "name": "Health Data",
      "description": "Managing blood pressure and diabetes readings."
    },
    {
      "name": "Notifications",
      "description": "Managing user notifications."
    },
    {
      "name": "File Sharing",
      "description": "Generating and accessing signed URLs for folders and files."
    },
    {
      "name": "Utilities",
      "description": "General utility endpoints."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Passport"
      }
    },
    "schemas": {
      "ApiResponseSuccess": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ],
            "description": "Status code (1 for success)"
          },
          "message": {
            "type": "string",
            "description": "A human-readable message indicating success"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "description": "The main data payload for a successful response"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "ApiResponseError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              0
            ],
            "description": "Status code (0 for error)"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "description": "A human-readable error message or an object containing validation errors"
              }
            ],
            "description": "A human-readable error message or an object containing validation errors"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Additional specific error message (e.g., submission limits)"
          },
          "user_id": {
            "type": "integer",
            "nullable": true,
            "description": "User ID, sometimes returned with error messages for next steps"
          },
          "attempt": {
            "type": "integer",
            "nullable": true,
            "description": "OTP attempt count"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "ValidationErrors": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A list of error messages for a specific field."
          }
        }
      },
      "AuthenticatedUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "User ID"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "User's full name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "User's email address"
          },
          "number": {
            "type": "string",
            "description": "User's phone number"
          },
          "register_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when the user completed registration"
          },
          "photo": {
            "type": "string",
            "format": "url",
            "nullable": true,
            "description": "URL to the user's profile photo"
          },
          "role": {
            "type": "string",
            "description": "User's role (e.g., 'patient')"
          },
          "email_verified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when the user's email was verified"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user record was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user record was last updated"
          }
        },
        "required": [
          "id",
          "number",
          "role"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthenticatedUser"
          },
          "token": {
            "type": "string",
            "description": "JWT Bearer token for authenticated requests"
          }
        },
        "required": [
          "status",
          "message",
          "data",
          "token"
        ]
      },
      "FolderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Folder ID"
          },
          "name": {
            "type": "string",
            "description": "Name of the folder"
          },
          "user_id": {
            "type": "integer",
            "description": "ID of the user who owns the folder"
          },
          "file_count": {
            "type": "integer",
            "description": "Number of files in the folder"
          },
          "created_at": {
            "type": "string",
            "format": "date",
            "description": "Date when the folder was created (e.g., 20-Mar-23)"
          }
        },
        "required": [
          "id",
          "name",
          "user_id",
          "file_count",
          "created_at"
        ]
      },
      "FileDetails": {
        "type": "object",
        "properties": {
          "folder_id": {
            "type": "integer",
            "description": "ID of the parent folder"
          },
          "folder_name": {
            "type": "string",
            "description": "Name of the parent folder"
          },
          "id": {
            "type": "integer",
            "description": "File ID"
          },
          "name": {
            "type": "string",
            "description": "Original file name"
          },
          "rename": {
            "type": "string",
            "nullable": true,
            "description": "Renamed part of the file (before the unique code and extension)"
          },
          "type": {
            "type": "string",
            "enum": [
              "prescription",
              "test_report"
            ],
            "description": "Type of the file (prescription or test_report)"
          },
          "path": {
            "type": "string",
            "format": "url",
            "description": "URL to access the file (e.g., S3 pre-signed URL)"
          },
          "created_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date",
                "description": "Date when the file was uploaded (e.g., 20-Mar-23)"
              },
              {
                "type": "string",
                "description": "Relative time when the file was uploaded (e.g., 2 days ago)"
              }
            ]
          }
        },
        "required": [
          "folder_id",
          "folder_name",
          "id",
          "name",
          "type",
          "path",
          "created_at"
        ]
      },
      "BloodPressureRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "systolic": {
            "type": "integer"
          },
          "diastolic": {
            "type": "integer"
          },
          "category": {
            "type": "string",
            "enum": [
              "Low",
              "Normal",
              "High",
              "NA"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BloodPressureDailyAvg": {
        "type": "object",
        "properties": {
          "systolic_avg": {
            "type": "number",
            "format": "float"
          },
          "diastolic_avg": {
            "type": "number",
            "format": "float"
          },
          "category": {
            "type": "string",
            "enum": [
              "Low",
              "Normal",
              "High",
              "NA"
            ]
          }
        }
      },
      "BloodPressureAvgResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BloodPressureRecord"
            },
            "description": "List of blood pressure records for today"
          },
          "avg_systolic": {
            "type": "number",
            "format": "float",
            "description": "Average systolic pressure"
          },
          "avg_diastolic": {
            "type": "number",
            "format": "float",
            "description": "Average diastolic pressure"
          }
        }
      },
      "BloodPressureSevenDaysResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/BloodPressureDailyAvg"
            },
            "description": "Daily average systolic, diastolic, and category for the last seven days (keyed by date)"
          },
          "avg_systolic": {
            "type": "number",
            "format": "float",
            "description": "Overall average systolic pressure for the seven days"
          },
          "avg_diastolic": {
            "type": "number",
            "format": "float",
            "description": "Overall average diastolic pressure for the seven days"
          }
        }
      },
      "BloodPressureWeeklyMonthlyEntry": {
        "type": "object",
        "properties": {
          "avg_systolic": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "avg_diastolic": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "category": {
            "type": "string",
            "enum": [
              "Low",
              "Normal",
              "High",
              "NA"
            ]
          }
        }
      },
      "BloodPressureWeeklyMonthlyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/BloodPressureWeeklyMonthlyEntry"
            },
            "description": "Weekly/Monthly average blood pressure data (keyed by Week/Month)"
          }
        }
      },
      "DiabetesRecordAvg": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "avg_level": {
            "type": "string",
            "description": "Average blood sugar level for today"
          }
        },
        "required": [
          "status",
          "message",
          "avg_level"
        ]
      },
      "DiabetesDailyValues": {
        "type": "object",
        "properties": {
          "value_one": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "value_two": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "DiabetesSevenDaysResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DiabetesDailyValues"
            },
            "description": "Daily blood sugar levels (up to two readings) for the last seven days (keyed by date)"
          },
          "avg_level": {
            "type": "number",
            "format": "float",
            "description": "Overall average blood sugar level for the seven days"
          }
        }
      },
      "DiabetesWeeklyMonthlyEntry": {
        "type": "object",
        "properties": {
          "avg_level": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "category": {
            "type": "string",
            "enum": [
              "Low",
              "Normal",
              "High",
              "NA"
            ]
          }
        }
      },
      "DiabetesWeeklyMonthlyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DiabetesWeeklyMonthlyEntry"
            },
            "description": "Weekly/Monthly average diabetes data (keyed by Week/Month)"
          }
        }
      },
      "NotificationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "notifiable_type": {
            "type": "string"
          },
          "notifiable_id": {
            "type": "integer"
          },
          "data": {
            "type": "object"
          },
          "read_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PatientProfileData": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "number": {
            "type": "string"
          },
          "photo": {
            "type": "string",
            "format": "url",
            "nullable": true
          },
          "blood_gorup": {
            "type": "string",
            "nullable": true
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "nullable": true
          },
          "weight": {
            "type": "string",
            "nullable": true
          },
          "height": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/patient/register": {
      "post": {
        "summary": "Register a new patient",
        "description": "Registers a new patient with a phone number and sends an OTP for verification.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "description": "Patient's phone number (international format, e.g., +8801712345678)",
                    "example": "+8801712345678"
                  }
                },
                "required": [
                  "number"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "OTP sent successfully, Expire in 3 minutes"
                        },
                        "data": {
                          "$ref": "#/components/schemas/AuthenticatedUser"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User already registerd, Please login"
                            },
                            {
                              "type": "object",
                              "$ref": "#/components/schemas/ValidationErrors"
                            },
                            {
                              "type": "string",
                              "example": "Number not verified, Please verify your account via OTP"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error (less likely with 200 responses for validation messages)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseError"
                }
              }
            }
          }
        }
      }
    },
    "/patient/register/otp": {
      "post": {
        "summary": "Verify OTP for patient registration",
        "description": "Verifies the OTP sent during patient registration to complete the process.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user for whom OTP was sent",
                    "example": 123
                  },
                  "otp": {
                    "type": "string",
                    "description": "The 4-digit OTP received by the user",
                    "example": "1234"
                  }
                },
                "required": [
                  "user_id",
                  "otp"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User not found!"
                            },
                            {
                              "type": "string",
                              "example": "OTP max count reached"
                            },
                            {
                              "type": "string",
                              "example": "OTP not matched!"
                            },
                            {
                              "type": "string",
                              "example": "OTP expired!"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        },
                        "attempt": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Number of attempts made for OTP verification"
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/resend/otp": {
      "post": {
        "summary": "Resend OTP for registration",
        "description": "Resends the OTP to the patient's registered phone number for verification.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user to resend OTP to",
                    "example": 123
                  }
                },
                "required": [
                  "user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "OTP sent successfully, Expire in 3 minutes"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User not found!"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/password/reset/otp": {
      "post": {
        "summary": "Request OTP for password reset",
        "description": "Sends an OTP to the patient's registered phone number to initiate password reset.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "description": "Patient's phone number",
                    "example": "+8801712345678"
                  }
                },
                "required": [
                  "number"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "OTP sent successfully"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "user_id": {
                              "type": "integer",
                              "example": 123
                            }
                          }
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "data"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User not found"
                            },
                            {
                              "type": "string",
                              "example": "User not verified"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/password/reset/confirm": {
      "post": {
        "summary": "Confirm OTP for password reset",
        "description": "Confirms the OTP to verify the user for password reset.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user who requested password reset",
                    "example": 123
                  },
                  "otp": {
                    "type": "string",
                    "description": "The 4-digit OTP received by the user",
                    "example": "1234"
                  }
                },
                "required": [
                  "user_id",
                  "otp"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "OTP verified successfully"
                        },
                        "user_id": {
                          "type": "integer",
                          "example": 123
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "user_id"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User not found"
                            },
                            {
                              "type": "string",
                              "example": "OTP max count reached"
                            },
                            {
                              "type": "string",
                              "example": "OTP not matched!"
                            },
                            {
                              "type": "string",
                              "example": "OTP expired!"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        },
                        "attempt": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Number of attempts made for OTP verification"
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/password/reset": {
      "post": {
        "summary": "Reset patient password",
        "description": "Resets the patient's password after OTP verification.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user whose password is being reset",
                    "example": 123
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "New password for the user",
                    "example": "newpassword123"
                  }
                },
                "required": [
                  "user_id",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "Password reset successfully"
                        },
                        "number": {
                          "type": "string",
                          "example": "+8801712345678"
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "number"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "User not found"
                            },
                            {
                              "type": "string",
                              "example": "OTP not verified"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/login": {
      "post": {
        "summary": "Patient login",
        "description": "Authenticates a patient using their phone number and password.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "description": "Patient's phone number",
                    "example": "+8801712345678"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Patient's password",
                    "example": "password123"
                  }
                },
                "required": [
                  "number",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login or various error conditions.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "Please verify your account via OTP"
                            },
                            {
                              "type": "string",
                              "example": "Please verify and update your profile"
                            },
                            {
                              "type": "string",
                              "example": "Invalid Credentials"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        },
                        "user_id": {
                          "type": "integer",
                          "nullable": true,
                          "description": "User ID (if profile update is pending)"
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/fcm-token": {
      "post": {
        "summary": "Store FCM (Firebase Cloud Messaging) token",
        "description": "Stores the device's FCM token, device ID, and type for push notifications.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user associated with the device",
                    "example": 123
                  },
                  "device_token": {
                    "type": "string",
                    "description": "The FCM token for the device",
                    "example": "fcm_device_token_string"
                  },
                  "device_id": {
                    "type": "string",
                    "description": "Unique identifier for the device",
                    "example": "some_unique_device_id"
                  },
                  "device_type": {
                    "type": "string",
                    "enum": [
                      "android",
                      "ios",
                      "web"
                    ],
                    "description": "Type of the device",
                    "example": "android"
                  }
                },
                "required": [
                  "user_id",
                  "device_token",
                  "device_id",
                  "device_type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "token added success"
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            0
                          ]
                        },
                        "message": {
                          "oneOf": [
                            {
                              "type": "string",
                              "example": "user not found"
                            },
                            {
                              "$ref": "#/components/schemas/ValidationErrors"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patient/folders/{folder}/share": {
      "get": {
        "summary": "Generate a signed URL to share a folder",
        "description": "Generates a temporary signed URL that allows external access to a specific folder for a limited time.",
        "tags": [
          "File Sharing"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "folder",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "The ID of the folder to share.",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "Folder shared successfully"
                        },
                        "url": {
                          "type": "string",
                          "format": "url",
                          "description": "The temporary signed URL for accessing the folder."
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "url"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          },
          "404": {
            "description": "Folder not found (though code returns 200 with status 0)"
          }
        }
      }
    },
    "/patient/file/{fileId}": {
      "get": {
        "summary": "Generate a signed URL to view a specific file",
        "description": "Generates a temporary signed URL that allows external access to a specific file for a limited time.",
        "tags": [
          "File Sharing"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "fileId",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "The ID of the file to generate a signed URL for. (Note: The route path variable is technically `filename` but the controller method expects `fileId`.)",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "url",
                      "description": "The temporary signed URL for accessing the image content."
                    }
                  },
                  "required": [
                    "url"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/image/{fileId}": {
      "get": {
        "summary": "Access file content via signed URL",
        "description": "Directly accesses and serves the content of a file using a valid signed URL.",
        "tags": [
          "File Sharing"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "fileId",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "The ID of the file to access.",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "File content (e.g., image/jpeg, application/pdf)",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (invalid or expired signed URL)"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/file/{filename}": {
      "get": {
        "summary": "Access generic file content via signed URL",
        "description": "Directly accesses and serves the content of a file using a valid signed URL, given its filename.",
        "tags": [
          "File Sharing"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "filename",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The filename to access.",
            "example": "document_TR-1234.pdf"
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (invalid or expired signed URL)"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/patient/logout": {
      "post": {
        "summary": "Patient logout",
        "description": "Revokes the current access token, logging out the patient.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/profile/{id}": {
      "get": {
        "summary": "Get patient profile details",
        "description": "Retrieves the detailed profile information for a specific patient.",
        "tags": [
          "Patient Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "The ID of the patient user.",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Success or user not found.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "User found"
                        },
                        "data": {
                          "$ref": "#/components/schemas/PatientProfileData"
                        }
                      }
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/profile/register": {
      "post": {
        "summary": "Complete patient profile registration",
        "description": "Allows a newly registered patient (after OTP verification) to set their name, email, password, and other profile details.",
        "tags": [
          "Patient Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer",
                    "description": "ID of the user whose profile is being completed.",
                    "example": 123
                  },
                  "name": {
                    "type": "string",
                    "description": "Patient's full name.",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true,
                    "description": "Patient's email address (optional, must be unique if provided).",
                    "example": "john.doe@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password for the patient's account.",
                    "example": "securepassword"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "nullable": true,
                    "description": "Patient's profile photo (optional, max 2MB, mimes: jpg,jpeg,png,webp,heif)."
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "Male",
                      "Female",
                      "Other"
                    ],
                    "nullable": true,
                    "description": "Patient's gender.",
                    "example": "Male"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "Patient's date of birth (YYYY-MM-DD).",
                    "example": "1990-01-15"
                  },
                  "blood_group": {
                    "type": "string",
                    "enum": [
                      "A+",
                      "A-",
                      "B+",
                      "B-",
                      "AB+",
                      "AB-",
                      "O+",
                      "O-"
                    ],
                    "nullable": true,
                    "description": "Patient's blood group.",
                    "example": "O+"
                  },
                  "address": {
                    "type": "string",
                    "nullable": true,
                    "description": "Patient's address.",
                    "example": "123 Main St, City"
                  },
                  "weight": {
                    "type": "number",
                    "format": "float",
                    "nullable": true,
                    "description": "Patient's weight in KG.",
                    "example": 70.5
                  },
                  "height_ft": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Patient's height in feet.",
                    "example": 5
                  },
                  "height_in": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Patient's height in inches.",
                    "example": 10
                  }
                },
                "required": [
                  "user_id",
                  "name",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully or error",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/profile/update": {
      "post": {
        "summary": "Update patient profile details",
        "description": "Allows an authenticated patient to update their profile information.",
        "tags": [
          "Patient Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Patient's full name.",
                    "example": "Jane Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Patient's email address (must be unique).",
                    "example": "jane.doe@example.com"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "nullable": true,
                    "description": "Patient's profile photo (optional, max 2MB, mimes: jpg,jpeg,png,webp,heif)."
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "Male",
                      "Female",
                      "Other"
                    ],
                    "nullable": true,
                    "description": "Patient's gender.",
                    "example": "Female"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "Patient's date of birth (YYYY-MM-DD).",
                    "example": "1992-05-20"
                  },
                  "blood_group": {
                    "type": "string",
                    "enum": [
                      "A+",
                      "A-",
                      "B+",
                      "B-",
                      "AB+",
                      "AB-",
                      "O+",
                      "O-"
                    ],
                    "nullable": true,
                    "description": "Patient's blood group.",
                    "example": "A+"
                  },
                  "address": {
                    "type": "string",
                    "nullable": true,
                    "description": "Patient's address.",
                    "example": "456 Oak Ave, Town"
                  },
                  "weight": {
                    "type": "number",
                    "format": "float",
                    "nullable": true,
                    "description": "Patient's weight in KG.",
                    "example": 65.2
                  },
                  "height_ft": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Patient's height in feet.",
                    "example": 5
                  },
                  "height_in": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Patient's height in inches.",
                    "example": 7
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully or error",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/search": {
      "post": {
        "summary": "Search patient folders and files",
        "description": "Searches for folders and files belonging to the authenticated user based on a search term.",
        "tags": [
          "Patient Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "search_data": {
                    "type": "string",
                    "description": "The search term to find folders or files.",
                    "example": "report"
                  }
                },
                "required": [
                  "search_data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "success"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "folders": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/FolderSummary"
                              }
                            },
                            "files": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/FileDetails"
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "data"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/password/change": {
      "post": {
        "summary": "Change patient password",
        "description": "Allows an authenticated patient to change their password by providing the old and new passwords.",
        "tags": [
          "Patient Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "old_password": {
                    "type": "string",
                    "format": "password",
                    "description": "The current password of the user.",
                    "example": "currentpassword"
