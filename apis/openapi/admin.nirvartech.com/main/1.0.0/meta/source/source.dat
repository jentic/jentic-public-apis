      "get": {
        "summary": "Get blood sugar levels for the past seven days",
        "description": "Retrieves daily blood sugar levels (up to two readings) and overall average for the authenticated user over the last seven days.",
        "tags": [
          "Health Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success with 7-day diabetes data or no data.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DiabetesSevenDaysResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/diabetes/weekly": {
      "get": {
        "summary": "Get weekly blood sugar averages",
        "description": "Retrieves average blood sugar levels and categories for the last four weeks for the authenticated user.",
        "tags": [
          "Health Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success with weekly average diabetes data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiabetesWeeklyMonthlyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/diabetes/monthly": {
      "get": {
        "summary": "Get monthly blood sugar averages",
        "description": "Retrieves average blood sugar levels and categories for the last four months for the authenticated user.",
        "tags": [
          "Health Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success with monthly average diabetes data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiabetesWeeklyMonthlyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/diabetes/store": {
      "post": {
        "summary": "Store a new blood sugar reading",
        "description": "Records a new blood sugar level for the authenticated user. Limited to two submissions per 24-hour period.",
        "tags": [
          "Health Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "blood_sugar_level": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0,
                    "description": "Blood sugar level reading.",
                    "example": 5.5
                  }
                },
                "required": [
                  "blood_sugar_level"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blood sugar data stored successfully or error.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/notifications": {
      "get": {
        "summary": "Get all notifications for the patient",
        "description": "Retrieves a list of all notifications for the authenticated patient.",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success with notification list or patient not found.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "success"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/NotificationItem"
                          }
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "data"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/patient/read/notification": {
      "post": {
        "summary": "Mark a notification as read",
        "description": "Marks a specific notification as read for the authenticated patient.",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notification_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The ID of the notification to mark as read.",
                    "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
                  }
                },
                "required": [
                  "notification_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification marked as read successfully or error.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
    "/user": {
      "get": {
        "summary": "Get authenticated user details (Sanctum)",
        "description": "Retrieves details of the authenticated user using Laravel Sanctum. This is a default Laravel route.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Successful response with user data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUser"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated. (e.g., missing or invalid Sanctum token)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Unauthenticated."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
