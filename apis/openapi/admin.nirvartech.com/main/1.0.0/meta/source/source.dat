    "/patient/file/upload": {
      "post": {
        "summary": "Upload a file to a folder",
        "description": "Uploads a new file (prescription or test report) to a specified folder for the authenticated user.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder_id": {
                    "type": "integer",
                    "description": "The ID of the folder to upload the file to.",
                    "example": 1
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload (PDF, JPEG, PNG, JPG, GIF, HEIC, max 111MB)."
                  },
                  "file_name": {
                    "type": "string",
                    "description": "The desired base name for the file (e.g., \"My Prescription\").",
                    "example": "My Prescription"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "prescription",
                      "test_report"
                    ],
                    "description": "The type of the file.",
                    "example": "prescription"
                  }
                },
                "required": [
                  "folder_id",
                  "file",
                  "file_name",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully or error.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer",
                          "enum": [
                            1
                          ]
                        },
                        "message": {
                          "type": "string",
                          "example": "File uploaded successfully"
                        },
                        "data": {
                          "type": "object"
                        },
                        "file_url": {
                          "type": "string",
                          "format": "url",
                          "description": "The S3 URL of the uploaded file."
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "data",
                        "file_url"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/ApiResponseError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid access token)"
          }
        }
      }
    },
