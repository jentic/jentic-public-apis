{
  "openapi": "3.1.0",
  "info": {
    "title": "1C–Bitrix24 Exchange API",
    "version": "1.0.0",
    "description": "REST API для обмена данными между 1С и Битрикс24: объекты ASUP, контрагенты-плательщики и счета.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/techdirector/B24-1C/1.0.0"
  },
  "servers": [
    {
      "url": "https://b24platform.ru/agpipe.internal/1",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "XAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "Пользователь Битрикс24",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Внутренний ID сотрудника Битрикс24"
          },
          "name": {
            "type": "string",
            "description": "ФИО пользователя"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Company": {
        "type": "object",
        "description": "Компания из 1С",
        "properties": {
          "guid": {
            "type": "string",
            "description": "GUID компании из 1С"
          },
          "title": {
            "type": "string",
            "description": "Наименование компании"
          },
          "inn": {
            "type": "string",
            "description": "ИНН компании"
          },
          "kpp": {
            "type": "string",
            "description": "КПП компании"
          }
        },
        "required": [
          "guid",
          "title",
          "inn"
        ]
      },
      "CompanyProcessResult": {
        "type": "object",
        "description": "Результат обработки одной компании из входного массива",
        "properties": {
          "guid": {
            "type": "string",
            "description": "GUID компании из 1С (как в запросе)"
          },
          "bitrix24_id": {
            "type": "integer",
            "nullable": true,
            "description": "ID компании в Битрикс24 (заполнен, если статус success)"
          },
          "status": {
            "type": "string",
            "description": "Статус обработки компании",
            "enum": [
              "success",
              "error"
            ]
          },
          "error": {
            "description": "Детали ошибки обработки данной компании (если статус error)",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Error"
              }
            ]
          }
        },
        "required": [
          "guid",
          "status"
        ]
      },
      "AsupObject": {
        "type": "object",
        "description": "Объект ASUP в Битрикс24",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Внутренний ID объекта в Битрикс24"
          },
          "title": {
            "type": "string",
            "description": "Название объекта"
          },
          "address": {
            "type": "string",
            "description": "Адрес объекта (город + адрес объекта)"
          },
          "assigned_by": {
            "$ref": "#/components/schemas/User"
          },
          "supports": {
            "type": "array",
            "description": "Массив данных про суппортов",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "payers": {
            "type": "array",
            "description": "Массив информации о компаниях-плательщиках по данному объекту",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          }
        },
        "required": [
          "id",
          "title",
          "assigned_by"
        ]
      },
      "Bill": {
        "type": "object",
        "description": "Счет из 1С",
        "properties": {
          "guid": {
            "type": "string",
            "description": "GUID счёта из 1С"
          },
          "company": {
            "type": "string",
            "description": "GUID компании-плательщика"
          },
          "asup_object_id": {
            "type": "integer",
            "description": "ID объекта в Битрикс24"
          },
          "number": {
            "type": "string",
            "description": "Номер счёта"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Дата счёта, формат ГГГГ-ММ-ДД"
          },
          "is_shipped": {
            "type": "boolean",
            "description": "Отгружен ли счёт"
          },
          "shipment_sum": {
            "type": "number",
            "format": "float",
            "description": "Сумма отгрузки"
          },
          "paid_sum": {
            "type": "number",
            "format": "float",
            "description": "Сумма оплаты"
          },
          "unpaid_sum": {
            "type": "number",
            "format": "float",
            "description": "Сумма неоплаты"
          },
          "pay_date_1": {
            "type": "string",
            "format": "date",
            "description": "Дата оплаты первичная, формат ГГГГ-ММ-ДД"
          },
          "pay_date_2": {
            "type": "string",
            "format": "date",
            "description": "Дата оплаты вторичная, формат ГГГГ-ММ-ДД"
          }
        },
        "required": [
          "guid",
          "company",
          "asup_object_id",
          "number",
          "date",
          "is_shipped"
        ]
      },
      "BillProcessResult": {
        "type": "object",
        "description": "Результат обработки одного счёта из входного массива",
        "properties": {
          "guid": {
            "type": "string",
            "description": "GUID счёта из 1С (как в запросе)"
          },
          "bitrix24_id": {
            "type": "integer",
            "nullable": true,
            "description": "ID счёта в Битрикс24 (заполнен, если статус success)"
          },
          "status": {
            "type": "string",
            "description": "Статус обработки счёта",
            "enum": [
              "success",
              "error"
            ]
          },
          "error": {
            "description": "Детали ошибки обработки данного счёта (если статус error)",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Error"
              }
            ]
          }
        },
        "required": [
          "guid",
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "description": "Структура ошибки при обработке запроса",
        "properties": {
          "code": {
            "type": "string",
            "description": "Машиночитаемый код ошибки (например, INVALID_PAYLOAD)"
          },
          "message": {
            "type": "string",
            "description": "Человекочитаемое описание ошибки"
          },
          "errors": {
            "type": "array",
            "description": "Детализация ошибок по полям (опционально)",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Имя поля или путь до поля"
                },
                "message": {
                  "type": "string",
                  "description": "Описание проблемы с данным полем"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/exchange1c/asup/full": {
      "get": {
        "summary": "Полная выгрузка объектов ASUP",
        "description": "Возвращает полный список всех объектов ASUP.  Выдаёт по 1000 объектов за запрос. Постраничность реализуется через параметр fromId: возвращаются объекты с id > fromId.\n",
        "security": [
          {
            "XAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fromId",
            "in": "query",
            "required": false,
            "description": "Нижняя граница ID объектов (не включительно).  Возвращаются объекты с id больше указанного значения.\n",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AsupObject"
                  }
                },
                "example": [
                  {
                    "id": 12345,
                    "title": "БЦ «Олимп»",
                    "address": "Москва, ул. Ленина, д. 10",
                    "assigned_by": {
                      "id": 17,
                      "name": "Иванов Иван Иванович"
                    },
                    "supports": [
                      {
                        "id": 23,
                        "name": "Петров Пётр Петрович"
                      },
                      {
                        "id": 24,
                        "name": "Сидоров Сидор Сидорович"
                      }
                    ],
                    "payers": [
                      {
                        "guid": "f5c96c5a-2617-4f9b-a517-0c6b3e7f96af",
                        "title": "ООО «Ромашка»",
                        "inn": "7701234567",
                        "kpp": "770101001"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса.\nВозможные причины: - параметр fromId не является числом; - параметр fromId имеет недопустимое значение (например, отрицательное).\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidType": {
                    "summary": "fromId передан в виде строки",
                    "value": {
                      "code": "INVALID_QUERY",
                      "message": "Параметр fromId должен быть целым числом",
                      "errors": [
                        {
                          "field": "fromId",
                          "message": "Ожидалось целочисленное значение"
                        }
                      ]
                    }
                  },
                  "negativeValue": {
                    "summary": "fromId меньше нуля",
                    "value": {
                      "code": "INVALID_QUERY",
                      "message": "Параметр fromId не может быть отрицательным",
                      "errors": [
                        {
                          "field": "fromId",
                          "message": "Значение должно быть больше или равно 0"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ошибка авторизации. Не передан или некорректен заголовок X-Auth.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Отсутствует токен",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Отсутствует или некорректен заголовок X-Auth"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса при обработке запроса.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "internalError": {
                    "summary": "Неожиданная ошибка",
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "Произошла непредвиденная ошибка при обработке запроса"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exchange1c/asup/updates": {
      "get": {
        "summary": "Выгрузка изменений объектов ASUP",
        "description": "Возвращает список объектов ASUP, изменённых с указанного момента времени. Выдаёт по 1000 объектов за запрос.\n",
        "security": [
          {
            "XAuth": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Момент времени в формате ISO 8601 (например, 2025-10-31T10:00:00+08:00), начиная с которого нужно вернуть изменения.\n",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-10-31T10:00:00+08:00"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AsupObject"
                  }
                },
                "example": [
                  {
                    "id": 12345,
                    "title": "БЦ «Олимп»",
                    "address": "Москва, ул. Ленина, д. 10",
                    "assigned_by": {
                      "id": 17,
                      "name": "Иванов Иван Иванович"
                    },
                    "supports": [
                      {
                        "id": 23,
                        "name": "Петров Пётр Петрович"
                      }
                    ],
                    "payers": [
                      {
                        "guid": "f5c96c5a-2617-4f9b-a517-0c6b3e7f96af",
                        "title": "ООО «Ромашка»",
                        "inn": "7701234567",
                        "kpp": "770101001"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Неверные параметры запроса.\nВозможные причины: - обязательный параметр from не передан; - параметр from не соответствует формату date-time (ISO 8601).\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFrom": {
                    "summary": "Не указан параметр from",
                    "value": {
                      "code": "INVALID_QUERY",
                      "message": "Обязательный параметр from не передан",
                      "errors": [
                        {
                          "field": "from",
                          "message": "Параметр является обязательным"
                        }
                      ]
                    }
                  },
                  "invalidFromFormat": {
                    "summary": "Некорректный формат даты-времени",
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Параметр from должен быть в формате ISO 8601 (date-time)",
                      "errors": [
                        {
                          "field": "from",
                          "message": "Ожидался формат 2025-10-31T10:00:00+08:00"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ошибка авторизации. Не передан или некорректен заголовок X-Auth.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Отсутствует токен",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Отсутствует или некорректен заголовок X-Auth"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса при обработке запроса.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "internalError": {
                    "summary": "Неожиданная ошибка",
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "Произошла непредвиденная ошибка при обработке запроса"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exchange1c/company": {
      "post": {
        "summary": "Выгрузка информации по контрагентам-плательщикам",
        "description": "Принимает информацию о контрагентах-плательщиках из 1С. Для каждой компании Битрикс24 ищет существующую запись и обновляет её, либо создаёт новую, а также привязывает GUID из 1С.\nВ ответе по каждой компании из входного массива возвращается результат обработки: успешный (создана/обновлена компания) или с ошибкой.\n",
        "security": [
          {
            "XAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Company"
                }
              },
              "example": [
                {
                  "guid": "f5c96c5a-2617-4f9b-a517-0c6b3e7f96af",
                  "title": "ООО «Ромашка»",
                  "inn": "7701234567",
                  "kpp": "770101001"
                },
                {
                  "guid": "3a0f2c1b-9c58-4d2a-8b1e-2a4efc9e1b23",
                  "title": "АО «Василёк»",
                  "inn": "7809876543",
                  "kpp": "780901001"
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результаты обработки всех переданных компаний.\nДля каждого GUID компании возвращается статус: - success — компания создана/обновлена, указан bitrix24_id; - error — компания не обработана, указаны детали ошибки.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanyProcessResult"
                  }
                },
                "example": [
                  {
                    "guid": "f5c96c5a-2617-4f9b-a517-0c6b3e7f96af",
                    "bitrix24_id": 5012,
                    "status": "success",
                    "error": null
                  },
                  {
                    "guid": "3a0f2c1b-9c58-4d2a-8b1e-2a4efc9e1b23",
                    "bitrix24_id": null,
                    "status": "error",
                    "error": {
                      "code": "VALIDATION_ERROR",
                      "message": "Некоторые поля компании заполнены некорректно",
                      "errors": [
                        {
                          "field": "inn",
                          "message": "ИНН должен содержать 10 или 12 цифр"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Неверный формат запроса или данных в целом.\nВозможные причины: - тело запроса не является валидным JSON; - тело запроса не является массивом; - структура объекта не соответствует схеме Company.\nВ этом случае ни одна компания не считается обработанной, массив результатов не возвращается.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidJson": {
                    "summary": "Некорректный JSON",
                    "value": {
                      "code": "INVALID_JSON",
                      "message": "Тело запроса не является валидным JSON"
                    }
                  },
                  "invalidPayload": {
                    "summary": "Неверная структура данных",
                    "value": {
                      "code": "INVALID_PAYLOAD",
                      "message": "Тело запроса должно быть массивом компаний",
                      "errors": [
                        {
                          "field": "",
                          "message": "Ожидался массив объектов Company"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ошибка авторизации. Не передан или некорректен заголовок X-Auth.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Отсутствует токен",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Отсутствует или некорректен заголовок X-Auth"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса при обработке запроса.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "internalError": {
                    "summary": "Неожиданная ошибка",
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "Произошла непредвиденная ошибка при обработке запроса"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exchange1c/bill": {
      "post": {
        "summary": "Создание и обновление счетов из 1С в Битрикс24",
        "description": "Принимает информацию по счетам из 1С. По переданному GUID счёта  Битрикс24 обновляет существующий счёт либо создаёт новый.  Также по данным счёта находятся компания и объект ASUP.\nВ ответе по каждому счёту из входного массива возвращается результат обработки: успешный (создан/обновлён счёт) или с ошибкой.\n",
        "security": [
          {
            "XAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Bill"
                }
              },
              "example": [
                {
                  "guid": "c3d4e5f6-7890-1234-5678-90abcdef1234",
                  "company": "f5c96c5a-2617-4f9b-a517-0c6b3e7f96af",
                  "asup_object_id": 12345,
                  "number": "СЧ-001234",
                  "date": "2025-10-01",
                  "is_shipped": true,
                  "shipment_sum": 150000.0,
                  "paid_sum": 100000.0,
                  "unpaid_sum": 50000.0,
                  "pay_date_1": "2025-10-10",
                  "pay_date_2": "2025-10-20"
                },
                {
                  "guid": "d4e5f6a7-8901-2345-6789-0abcdef123456",
                  "company": "00000000-0000-0000-0000-000000000000",
                  "asup_object_id": 99999,
                  "number": "СЧ-001235",
                  "date": "2025-10-05",
                  "is_shipped": false,
                  "shipment_sum": 50000.0,
                  "paid_sum": 0.0,
                  "unpaid_sum": 50000.0
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результаты обработки всех переданных счетов.\nДля каждого GUID счёта возвращается статус: - success — счёт создан/обновлён, указан bitrix24_id; - error — счёт не обработан, указаны детали ошибки.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BillProcessResult"
                  }
                },
                "example": [
                  {
                    "guid": "c3d4e5f6-7890-1234-5678-90abcdef1234",
                    "bitrix24_id": 9001,
                    "status": "success",
                    "error": null
                  },
                  {
                    "guid": "d4e5f6a7-8901-2345-6789-0abcdef123456",
                    "bitrix24_id": null,
                    "status": "error",
                    "error": {
                      "code": "REFERENCE_ERROR",
                      "message": "Компания или объект ASUP не найдены",
                      "errors": [
                        {
                          "field": "company",
                          "message": "Компания с указанным GUID не найдена в Битрикс24"
                        },
                        {
                          "field": "asup_object_id",
                          "message": "Объект ASUP с указанным ID не найден"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Неверный формат запроса или данных в целом. Возможные причины: - тело запроса не является валидным JSON; - тело запроса не является массивом; - отсутствуют обязательные поля (guid, company, asup_object_id, number, date, is_shipped); - поля имеют некорректный формат (дата, числовые суммы и т.п.).\nВ этом случае ни один счёт не считается обработанным, массив результатов не возвращается.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidJson": {
                    "summary": "Некорректный JSON",
                    "value": {
                      "code": "INVALID_JSON",
                      "message": "Тело запроса не является валидным JSON"
                    }
                  },
                  "invalidPayload": {
                    "summary": "Неверная структура данных",
                    "value": {
                      "code": "INVALID_PAYLOAD",
                      "message": "Тело запроса должно быть массивом счетов",
                      "errors": [
                        {
                          "field": "",
                          "message": "Ожидался массив объектов Bill"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ошибка авторизации. Не передан или некорректен заголовок X-Auth.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Отсутствует токен",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Отсутствует или некорректен заголовок X-Auth"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса при обработке запроса. В этом случае часть счетов могла быть обработана до возникновения ошибки — это уже на твоё усмотрение (можно описать дополнительно).\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "internalError": {
                    "summary": "Неожиданная ошибка",
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "Произошла непредвиденная ошибка при обработке запроса"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
