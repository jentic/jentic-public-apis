{
  "openapi": "3.0.3",
  "info": {
    "title": "Mx.Web.WebAPIs",
    "version": "1.0.0",
    "description": "REST APIs hosted in Macromatix",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/fourth-91e/Mx.Web.WebAPIs/1.0.0"
  },
  "servers": [
    {
      "url": "https://m-pret.macromatix.net/",
      "description": "Pret's Production"
    }
  ],
  "paths": {
    "/External/Inventory/Webhook/": {
      "post": {
        "summary": "[External Inventory] WebHook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Event"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "data": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ProductionBOM"
                          },
                          {
                            "$ref": "#/components/schemas/Transfer"
                          },
                          {
                            "$ref": "#/components/schemas/Waste"
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "examples": {
                "[External Inventory] WebHook - Production BOM": {
                  "value": {
                    "Data": {
                      "BOMMakeDetail": [
                        {
                          "ExternalReference": "Batch123",
                          "ItemCode": "PBMSANDWICH01",
                          "Quantity": 20,
                          "TransactionTime": "2025-06-10T09:00:00Z",
                          "UOM": "Each"
                        },
                        {
                          "ExternalReference": "Batch345",
                          "ItemCode": "ABC12345",
                          "Quantity": 5,
                          "TransactionTime": "2025-06-10T10:00:00Z",
                          "UOM": "Bag"
                        }
                      ],
                      "StoreNumber": "251"
                    },
                    "datacontenttype": "application/json",
                    "id": "e92f57d4-81a5-4b9f-9801-0e8d6bfa239c",
                    "source": "Edify",
                    "specverson": "1.0.0",
                    "timestamp": "2025-06-11T22:01:00Z",
                    "type": "pret.kitchen.ProductionBOMMake.published"
                  }
                },
                "[External Inventory] WebHook - Transfer": {
                  "value": {
                    "Data": {
                      "Comment": "Midday replenishment",
                      "ExternalReference": "TRF-20250612-001",
                      "FromStoreFreshTemperature": 10,
                      "FromStoreNumber": "HUB001",
                      "Items": [
                        {
                          "BoxQty": 2,
                          "InnerQty": 0,
                          "InventoryUnitQty": 0,
                          "ItemCode": "BREAD-001"
                        },
                        {
                          "BoxQty": 0,
                          "InnerQty": 3,
                          "InventoryUnitQty": 5,
                          "ItemCode": "CHICKEN-002"
                        }
                      ],
                      "ToStoreNumber": "SPOKE015",
                      "TransferDate": "2025-06-12T12:00:00Z",
                      "TransferType": "Sent"
                    },
                    "datacontenttype": "application/json",
                    "id": "e92f57d4-81a5-4b9f-9801-0e8d6bfa239c",
                    "source": "Edify",
                    "specverson": "1.0.0",
                    "timestamp": "2025-06-13T22:01:00Z",
                    "type": "pret.kitchen.transfer.published"
                  }
                },
                "[External Inventory] WebHook - Waste": {
                  "value": {
                    "Data": {
                      "StoreNumber": "251",
                      "WasteDetail": [
                        {
                          "ExternalReference": "WASTE-20250612-001",
                          "ItemCode": "ITEM-00123",
                          "ProductionBOMWasteMethod": "MakeAndWaste",
                          "Quantity": 4,
                          "TransactionTime": "2025-06-12T09:30:00Z",
                          "UOM": "Each",
                          "WasteReason": "Expired",
                          "WasteType": "InventoryWaste"
                        },
                        {
                          "ExternalReference": "WASTE-20250612-002",
                          "ItemCode": "SANDWICH-00567",
                          "Quantity": 2,
                          "TransactionTime": "2025-06-12T10:00:00Z",
                          "UOM": "Each",
                          "WasteReason": "Damaged",
                          "WasteType": "FinishedWaste"
                        }
                      ]
                    },
                    "datacontenttype": "application/json",
                    "id": "e92f57d4-81a5-4b9f-9801-0e8d6bfa239c",
                    "source": "Edify",
                    "specverson": "1.0.0",
                    "timestamp": "2025-06-13T22:01:00Z",
                    "type": "pret.kitchen.waste.published"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Incorrect input such as store number not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                },
                "example": {
                  "Message": "Invalid Store Number"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                }
              }
            }
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/External/QuBeyond/WebhookAnonymous": {
