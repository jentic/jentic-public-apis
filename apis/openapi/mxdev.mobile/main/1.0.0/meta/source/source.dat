        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Incorrect input such as store number not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                },
                "example": {
                  "Message": "Invalid Store Number"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_WebHook"
                }
              }
            }
          }
        },
        "tags": [
          "Inventory Movement"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Data invalid."
      },
      "Unauthorized": {
        "description": "Client failed to authenticate the server.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InvalidCredentialsException"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Client authenticated but does not have permission to access the requested resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InvalidCredentialsException"
            },
            "example": {
              "Message": "Does not have permission to access the requested resource"
            }
          }
        }
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "datacontenttype": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "specversion": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "Data": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ProductionBOM"
                },
                {
                  "$ref": "#/components/schemas/Transfer"
                },
                {
                  "$ref": "#/components/schemas/Waste"
                }
              ]
            }
          }
        }
      },
      "ProductionBOM": {
        "type": "object",
        "properties": {
          "StoreNumber": {
            "type": "string"
          },
          "BOMMakeDetail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ItemCode": {
                  "type": "string"
                },
                "Quantity": {
                  "type": "integer",
                  "format": "Decimal"
                },
                "UOM": {
                  "type": "string"
                },
                "TransactionTime": {
                  "type": "string",
                  "format": "datetime"
                },
                "ExternalReference": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "ExternalReference": {
            "type": "string"
          },
          "TransferType": {
            "type": "string",
            "enum": [
              "Sent",
              "Request"
            ]
          },
          "FromStoreNumber": {
            "type": "string"
          },
          "ToStoreNumber": {
            "type": "string"
          },
          "TransferDate": {
            "type": "string",
            "format": "datetime"
          },
          "FromStoreFreshTemperature": {
            "type": "integer",
            "format": "decimal"
          },
          "FromStoreFrozenTemperature": {
            "type": "integer",
            "format": "decimal"
          },
          "Comment": {
            "type": "string"
          },
          "Items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ItemCode": {
                  "type": "string"
                },
                "BoxQty": {
                  "type": "integer",
                  "format": "float"
                },
                "InnerQty": {
                  "type": "integer",
                  "format": "float"
                },
                "InventoryUniQty": {
                  "type": "integer",
                  "format": "float"
                }
              }
            }
          }
        }
      },
      "Waste": {
        "type": "object",
        "properties": {
          "StoreNumber": {
            "type": "string"
          },
          "WasteDetail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ItemCode": {
