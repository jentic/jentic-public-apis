{"openapi":"3.1.0","info":{"title":"Creatica Backgrounds API","version":"0.1.0","description":"Generate deterministic, procedural SVG/PNG backgrounds on demand. 59 generators, curated palettes, machine-readable parameter schemas. Same structure + options + seed always yields the same image.","termsOfService":"https://creatica.app/terms-and-conditions","contact":{"url":"https://creatica.app/support"}},"servers":[{"url":"https://api.creatica.app"}],"security":[{"bearer":[]},{}],"components":{"securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"API key. Optional for low-volume anonymous use."}},"schemas":{"GenerateRequest":{"type":"object","required":["structure"],"properties":{"structure":{"type":"string","description":"Structure name from /v1/backgrounds."},"seed":{"type":"string"},"width":{"type":"integer","minimum":1,"maximum":8192},"height":{"type":"integer","minimum":1,"maximum":8192},"palette":{"type":"object","properties":{"colors":{"type":"array","items":{"type":"string","pattern":"^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},"description":"Explicit hex colours; overrides palette/scheme."},"palette":{"type":"string","description":"Built-in palette id from /v1/palettes."},"primaryColor":{"type":"string","pattern":"^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},"secondaryColor":{"type":"string","pattern":"^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},"backgroundColor":{"type":"string","pattern":"^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},"gradientColor":{"type":"boolean"},"useMultiColor":{"type":"boolean"},"colorSchemeType":{"type":"string","enum":["Mono","Tetrade","Analogic"]},"opaqueColors":{"type":"boolean"}}},"shape":{"type":"object","additionalProperties":true,"description":"Structure-specific; see /v1/backgrounds/{name}/schema."},"format":{"type":"string","enum":["svg","png","url"],"default":"svg"},"pngWidth":{"type":"integer","description":"Raster width when format=png."}}},"GenerateResponse":{"type":"object","properties":{"structure":{"type":"string"},"seed":{"type":"string"},"width":{"type":"integer"},"height":{"type":"integer"},"url":{"type":"string","format":"uri","description":"Permanent, cacheable image URL."},"svgUrl":{"type":"string","format":"uri"},"svg":{"type":"string","description":"Present when format=svg."},"png":{"type":"string","description":"Base64 PNG when format=png."},"warnings":{"type":"array","items":{"type":"string"}},"renderMs":{"type":"number"}}},"Error":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}}}}},"paths":{"/v1/backgrounds":{"get":{"summary":"List structures","parameters":[{"name":"query","in":"query","schema":{"type":"string"}},{"name":"mood","in":"query","schema":{"type":"string"}},{"name":"tag","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Catalog"}}}},"/v1/backgrounds/{name}":{"get":{"summary":"Describe a structure (JSON)","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Description"},"404":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/backgrounds/{name}/card":{"get":{"summary":"Style card (Markdown) for LLM context","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"text/markdown"}}}},"/v1/backgrounds/{name}/schema":{"get":{"summary":"JSON Schema of a generate request for this structure","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"JSON Schema"}}}},"/v1/palettes":{"get":{"summary":"Built-in palettes with mood tags","parameters":[{"name":"mood","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Palettes"}}}},"/v1/suggest":{"get":{"summary":"Rank structures for a natural-language brief","parameters":[{"name":"brief","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer"}}],"responses":{"200":{"description":"Suggestions"}}}},"/v1/generate":{"post":{"summary":"Render a background","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateRequest"}}}},"responses":{"200":{"description":"Render","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateResponse"}}}},"400":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Quota exceeded"},"429":{"description":"Rate limited"}}}},"/v1/render/{file}":{"get":{"summary":"Image endpoint: /v1/render/{structure}.{svg|png}?seed=…&width=…&colors=… — cacheable, embeddable in <img>. Without a seed it redirects to a seeded URL.","parameters":[{"name":"file","in":"path","required":true,"schema":{"type":"string"}},{"name":"seed","in":"query","schema":{"type":"string"}},{"name":"width","in":"query","schema":{"type":"string"}},{"name":"height","in":"query","schema":{"type":"string"}},{"name":"palette","in":"query","schema":{"type":"string"}},{"name":"colors","in":"query","schema":{"type":"string"}},{"name":"primaryColor","in":"query","schema":{"type":"string"}},{"name":"backgroundColor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"image/svg+xml or image/png"},"302":{"description":"Redirect to the seeded, canonical URL"},"404":{"description":"Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/mcp":{"post":{"summary":"Model Context Protocol endpoint (Streamable HTTP)","responses":{"200":{"description":"MCP"}}}}}}