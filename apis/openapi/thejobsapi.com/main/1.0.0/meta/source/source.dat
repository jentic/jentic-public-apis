{"openapi":"3.1.0","info":{"title":"The Jobs API","version":"1.0.0","description":"Verified active jobs collected directly from employers' career sites and applicant tracking systems in Canada and the United States."},"servers":[{"url":"https://api.thejobsapi.com"}],"security":[{"bearer":[]}],"tags":[{"name":"Feeds","description":"Polling feeds for keeping your own copy of the catalogue: new, modified and expired jobs."},{"name":"Search","description":"Query the live catalogue and follow its change log."},{"name":"Organizations","description":"Employers in the catalogue."}],"paths":{"/v1/active-ats":{"get":{"tags":["Feeds"],"operationId":"activeAts","summary":"New jobs","description":"Active jobs first collected within `time_frame`, newest posting first (or by `id` with `cursor`). Poll `1h` every hour or `24h` once a day in the same hour to receive every job once.","parameters":[{"name":"time_frame","in":"query","required":false,"description":"`1h`: the last full UTC hour. `24h`: the 24 hours up to the last full hour. `7d` and `6m`: rolling windows for backfills.","schema":{"type":"string","enum":["1h","24h","7d","6m"],"default":"24h"}},{"name":"limit","in":"query","required":false,"description":"Jobs per page, 1–1000.","schema":{"type":"integer","minimum":1,"maximum":1000,"default":100}},{"name":"offset","in":"query","required":false,"description":"Jobs to skip (offset pagination, ordered by `date_posted` descending).","schema":{"type":"integer","minimum":0}},{"name":"cursor","in":"query","required":false,"description":"Cursor pagination: pass the last `id` of the previous page. Orders by `id` ascending and overrides `offset`. Use it for `6m` backfills.","schema":{"type":"integer","format":"int64"}},{"name":"description_format","in":"query","required":false,"description":"Adds `description_text` or `description_html`. Omit it to leave descriptions out.","schema":{"type":"string","enum":["text","html"]}},{"name":"include_source_fields","in":"query","required":false,"description":"Adds `source_fields`: employer-published structured facts (department, pay tiers, qualifications…) with the path where each was found.","schema":{"type":"boolean"}},{"name":"include_derived","in":"query","required":false,"description":"Adds `derived`: values read by rules from the posting text (skills, work arrangement, experience, education, hours, benefits...), kept apart from employer-published fields.","schema":{"type":"boolean"}},{"name":"id","in":"query","required":false,"description":"Only these job ids, comma-separated.","schema":{"type":"array","items":{"type":"integer","format":"int64"}},"style":"form","explode":false},{"name":"include_basic_organization_details","in":"query","required":false,"description":"Fills `organization_url`, `organization_logo` and `domain_derived` from the employer's verified official website, and adds `organization_id`.","schema":{"type":"boolean"}},{"name":"title","in":"query","required":false,"description":"Search the job title. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"title_advanced","in":"query","required":false,"description":"Boolean search on the job title. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"description","in":"query","required":false,"description":"Search title, employer and description together. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"description_advanced","in":"query","required":false,"description":"Boolean search on title, employer and description. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"location","in":"query","required":false,"description":"Full place names as `City, Region, Country`: `Canada`, `Ontario, Canada`, `\"Toronto, Ontario, Canada\" OR \"Vancouver, British Columbia, Canada\"`, `California, United States`. A single name matches a region or city of that name. Countries must be written out (`United States`, not `US`).","schema":{"type":"string"}},{"name":"location_advanced","in":"query","required":false,"description":"Boolean search on the derived location text (\"City Region Country\"). Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Country views to include, comma-separated: `CA`, `US` or both (default both). A posting with locations in both countries appears once in each view, with a different `id`.","schema":{"type":"array","items":{"type":"string","enum":["CA","US"]}},"style":"form","explode":false},{"name":"organization","in":"query","required":false,"description":"Exact, case-sensitive employer names, comma-separated. Wrap a name containing a comma in double quotes: `\"Acme, Inc.\"`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_organization","in":"query","required":false,"description":"Employer names to exclude; same rules as `organization`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"organization_advanced","in":"query","required":false,"description":"Boolean search on the employer name. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"source","in":"query","required":false,"description":"Source systems to include, comma-separated, e.g. `workday,greenhouse,icims`. `lever.co`, `phenompeople` and `taleo` are accepted as aliases.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_source","in":"query","required":false,"description":"Source systems to exclude.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"date_posted_gte","in":"query","required":false,"description":"Posted at or after this time (ISO 8601, UTC when no zone is given).","schema":{"type":"string","format":"date-time"}},{"name":"date_posted_lt","in":"query","required":false,"description":"Posted before this time.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_gte","in":"query","required":false,"description":"First collected at or after this time. Use it to replay a missed window exactly.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_lt","in":"query","required":false,"description":"First collected before this time.","schema":{"type":"string","format":"date-time"}},{"name":"has_salary","in":"query","required":false,"description":"`true` for jobs whose employer published pay, `false` for jobs without.","schema":{"type":"boolean"}},{"name":"remote","in":"query","required":false,"description":"`true` for jobs the employer marks remote, `false` to exclude them.","schema":{"type":"boolean"}},{"name":"has_no_location","in":"query","required":false,"description":"`true` for jobs without a resolved location.","schema":{"type":"boolean"}},{"name":"skill","in":"query","required":false,"description":"Jobs whose text names any of these skills, comma-separated: names or spellings (`Excel`, `Auto CAD`, `forklift`) or dictionary ids (`microsoft-excel`). Matched by rules against our skills dictionary (O*NET, ESCO and curated Canadian licences); see `derived.skills`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false}],"responses":{"200":{"description":"Jobs","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Job"}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/active-ats-count":{"get":{"tags":["Feeds"],"operationId":"activeAtsCount","summary":"Count new jobs","description":"How many jobs match the filters in `time_frame`, without returning them. `1m` counts jobs first collected in the last 31 days including those since expired; other windows count active jobs only.","parameters":[{"name":"time_frame","in":"query","required":false,"description":"Window to count.","schema":{"type":"string","enum":["1h","24h","7d","1m","6m"],"default":"1m"}},{"name":"title","in":"query","required":false,"description":"Search the job title. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"title_advanced","in":"query","required":false,"description":"Boolean search on the job title. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"description","in":"query","required":false,"description":"Search title, employer and description together. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"description_advanced","in":"query","required":false,"description":"Boolean search on title, employer and description. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"location","in":"query","required":false,"description":"Full place names as `City, Region, Country`: `Canada`, `Ontario, Canada`, `\"Toronto, Ontario, Canada\" OR \"Vancouver, British Columbia, Canada\"`, `California, United States`. A single name matches a region or city of that name. Countries must be written out (`United States`, not `US`).","schema":{"type":"string"}},{"name":"location_advanced","in":"query","required":false,"description":"Boolean search on the derived location text (\"City Region Country\"). Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Country views to include, comma-separated: `CA`, `US` or both (default both). A posting with locations in both countries appears once in each view, with a different `id`.","schema":{"type":"array","items":{"type":"string","enum":["CA","US"]}},"style":"form","explode":false},{"name":"organization","in":"query","required":false,"description":"Exact, case-sensitive employer names, comma-separated. Wrap a name containing a comma in double quotes: `\"Acme, Inc.\"`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_organization","in":"query","required":false,"description":"Employer names to exclude; same rules as `organization`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"organization_advanced","in":"query","required":false,"description":"Boolean search on the employer name. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"source","in":"query","required":false,"description":"Source systems to include, comma-separated, e.g. `workday,greenhouse,icims`. `lever.co`, `phenompeople` and `taleo` are accepted as aliases.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_source","in":"query","required":false,"description":"Source systems to exclude.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"date_posted_gte","in":"query","required":false,"description":"Posted at or after this time (ISO 8601, UTC when no zone is given).","schema":{"type":"string","format":"date-time"}},{"name":"date_posted_lt","in":"query","required":false,"description":"Posted before this time.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_gte","in":"query","required":false,"description":"First collected at or after this time. Use it to replay a missed window exactly.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_lt","in":"query","required":false,"description":"First collected before this time.","schema":{"type":"string","format":"date-time"}},{"name":"has_salary","in":"query","required":false,"description":"`true` for jobs whose employer published pay, `false` for jobs without.","schema":{"type":"boolean"}},{"name":"remote","in":"query","required":false,"description":"`true` for jobs the employer marks remote, `false` to exclude them.","schema":{"type":"boolean"}},{"name":"has_no_location","in":"query","required":false,"description":"`true` for jobs without a resolved location.","schema":{"type":"boolean"}},{"name":"skill","in":"query","required":false,"description":"Jobs whose text names any of these skills, comma-separated: names or spellings (`Excel`, `Auto CAD`, `forklift`) or dictionary ids (`microsoft-excel`). Matched by rules against our skills dictionary (O*NET, ESCO and curated Canadian licences); see `derived.skills`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false}],"responses":{"200":{"description":"Count","content":{"application/json":{"schema":{"type":"object","required":["count"],"properties":{"count":{"type":"integer"}}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/modified-ats":{"get":{"tags":["Feeds"],"operationId":"modifiedAts","summary":"Modified jobs","description":"Active jobs whose published content changed in the 24 hours up to the last full UTC hour (or the `date_modified_*` window, at most 31 days). `date_modified` is the job's latest change, so a job changed again after the window appears in the later window. Ordered by `date_modified` descending.","parameters":[{"name":"date_modified_gte","in":"query","required":false,"description":"Changed at or after this time.","schema":{"type":"string","format":"date-time"}},{"name":"date_modified_lt","in":"query","required":false,"description":"Changed before this time.","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"description":"Jobs per page, 1–1000.","schema":{"type":"integer","minimum":1,"maximum":1000,"default":100}},{"name":"offset","in":"query","required":false,"description":"Jobs to skip (offset pagination, ordered by `date_posted` descending).","schema":{"type":"integer","minimum":0}},{"name":"cursor","in":"query","required":false,"description":"Cursor pagination: pass the last `id` of the previous page. Orders by `id` ascending and overrides `offset`. Use it for `6m` backfills.","schema":{"type":"integer","format":"int64"}},{"name":"description_format","in":"query","required":false,"description":"Adds `description_text` or `description_html`. Omit it to leave descriptions out.","schema":{"type":"string","enum":["text","html"]}},{"name":"include_source_fields","in":"query","required":false,"description":"Adds `source_fields`: employer-published structured facts (department, pay tiers, qualifications…) with the path where each was found.","schema":{"type":"boolean"}},{"name":"include_derived","in":"query","required":false,"description":"Adds `derived`: values read by rules from the posting text (skills, work arrangement, experience, education, hours, benefits...), kept apart from employer-published fields.","schema":{"type":"boolean"}},{"name":"id","in":"query","required":false,"description":"Only these job ids, comma-separated.","schema":{"type":"array","items":{"type":"integer","format":"int64"}},"style":"form","explode":false},{"name":"include_basic_organization_details","in":"query","required":false,"description":"Fills `organization_url`, `organization_logo` and `domain_derived` from the employer's verified official website, and adds `organization_id`.","schema":{"type":"boolean"}},{"name":"title","in":"query","required":false,"description":"Search the job title. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"title_advanced","in":"query","required":false,"description":"Boolean search on the job title. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"description","in":"query","required":false,"description":"Search title, employer and description together. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"description_advanced","in":"query","required":false,"description":"Boolean search on title, employer and description. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"location","in":"query","required":false,"description":"Full place names as `City, Region, Country`: `Canada`, `Ontario, Canada`, `\"Toronto, Ontario, Canada\" OR \"Vancouver, British Columbia, Canada\"`, `California, United States`. A single name matches a region or city of that name. Countries must be written out (`United States`, not `US`).","schema":{"type":"string"}},{"name":"location_advanced","in":"query","required":false,"description":"Boolean search on the derived location text (\"City Region Country\"). Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Country views to include, comma-separated: `CA`, `US` or both (default both). A posting with locations in both countries appears once in each view, with a different `id`.","schema":{"type":"array","items":{"type":"string","enum":["CA","US"]}},"style":"form","explode":false},{"name":"organization","in":"query","required":false,"description":"Exact, case-sensitive employer names, comma-separated. Wrap a name containing a comma in double quotes: `\"Acme, Inc.\"`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_organization","in":"query","required":false,"description":"Employer names to exclude; same rules as `organization`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"organization_advanced","in":"query","required":false,"description":"Boolean search on the employer name. Boolean expression: `&` AND, `|` OR, `!` NOT, `<->` followed by, `<N>` within N words, `'quoted phrase'`, `( )` grouping and `:*` prefix. Takes precedence over the plain parameter.","schema":{"type":"string"}},{"name":"source","in":"query","required":false,"description":"Source systems to include, comma-separated, e.g. `workday,greenhouse,icims`. `lever.co`, `phenompeople` and `taleo` are accepted as aliases.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"exclude_source","in":"query","required":false,"description":"Source systems to exclude.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"date_posted_gte","in":"query","required":false,"description":"Posted at or after this time (ISO 8601, UTC when no zone is given).","schema":{"type":"string","format":"date-time"}},{"name":"date_posted_lt","in":"query","required":false,"description":"Posted before this time.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_gte","in":"query","required":false,"description":"First collected at or after this time. Use it to replay a missed window exactly.","schema":{"type":"string","format":"date-time"}},{"name":"date_created_lt","in":"query","required":false,"description":"First collected before this time.","schema":{"type":"string","format":"date-time"}},{"name":"has_salary","in":"query","required":false,"description":"`true` for jobs whose employer published pay, `false` for jobs without.","schema":{"type":"boolean"}},{"name":"remote","in":"query","required":false,"description":"`true` for jobs the employer marks remote, `false` to exclude them.","schema":{"type":"boolean"}},{"name":"has_no_location","in":"query","required":false,"description":"`true` for jobs without a resolved location.","schema":{"type":"boolean"}},{"name":"skill","in":"query","required":false,"description":"Jobs whose text names any of these skills, comma-separated: names or spellings (`Excel`, `Auto CAD`, `forklift`) or dictionary ids (`microsoft-excel`). Matched by rules against our skills dictionary (O*NET, ESCO and curated Canadian licences); see `derived.skills`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false}],"responses":{"200":{"description":"Jobs","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ModifiedJob"}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/expired-ats":{"get":{"tags":["Feeds"],"operationId":"expiredAts","summary":"Expired jobs","description":"Ids of jobs that left the feed in the window: removed by the employer, or found not to be in the country after all. Delete them from your copy.","parameters":[{"name":"time_frame","in":"query","required":false,"description":"`1h`: the last hour (rolling). `1d`: the previous UTC day. `1m`: 31 days. `6m`: 183 days.","schema":{"type":"string","enum":["1h","1d","1m","6m"],"default":"1d"}},{"name":"country","in":"query","required":false,"description":"Country views, comma-separated (default both).","schema":{"type":"array","items":{"type":"string","enum":["CA","US"]}},"style":"form","explode":false}],"responses":{"200":{"description":"Job ids","content":{"application/json":{"schema":{"type":"array","items":{"type":"integer","format":"int64"}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/ats-organizations":{"get":{"tags":["Organizations"],"operationId":"organizations","summary":"Organization list","description":"Every employer with active jobs, with its source systems, countries and active job count. Refreshed hourly. Use the names with `organization`.","parameters":[{"name":"format","in":"query","required":false,"description":"Response format.","schema":{"type":"string","enum":["json","csv"],"default":"json"}},{"name":"country","in":"query","required":false,"description":"Only employers with jobs in these countries.","schema":{"type":"array","items":{"type":"string","enum":["CA","US"]}},"style":"form","explode":false},{"name":"apiKey","in":"query","required":false,"description":"Your API key, for downloading in a browser. Prefer the Authorization header.","schema":{"type":"string"}}],"responses":{"200":{"description":"Organizations","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Organization"}}},"text/csv":{"schema":{"type":"string"}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/jobs":{"get":{"tags":["Search"],"operationId":"searchJobs","summary":"Search jobs","description":"Active jobs in one country, newest first, with `next_cursor` pagination. A text or place search answers within about 5 seconds: when matches are sparse among the newest jobs, a page can hold fewer than `limit` jobs (even none) while `next_cursor` is set. Keep passing `next_cursor` back until it is null.","parameters":[{"name":"country","in":"query","required":false,"description":"Country view.","schema":{"type":"string","enum":["CA","US"],"default":"CA"}},{"name":"q","in":"query","required":false,"description":"Search title, employer and description. Google-style: `software engineer` needs both words, `\"software engineer\"` is a phrase, `software OR engineer` either word, `-intern` excludes, `engineer*` matches a prefix. Accents and case are ignored.","schema":{"type":"string"}},{"name":"title","in":"query","required":false,"description":"Search the title only.","schema":{"type":"string"}},{"name":"province","in":"query","required":false,"description":"Canadian provinces, codes or names: `ON,BC` or `Ontario`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"state","in":"query","required":false,"description":"US states, codes or names: `NY,CA` or `Texas` (with `country=US`).","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"city","in":"query","required":false,"description":"A city, optionally with its region and country: `Toronto`, `Toronto, ON`, `Montréal, Québec`, `Houston, Texas, United States`. A place we cannot find, or one in the other country, is a 400.","schema":{"type":"string"}},{"name":"source","in":"query","required":false,"description":"Source systems.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"employment_type","in":"query","required":false,"description":"`FULL_TIME`, `PART_TIME`, `CONTRACTOR`, `TEMPORARY`, `INTERN`, `VOLUNTEER`, `PER_DIEM`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"remote","in":"query","required":false,"description":"Remote only, or exclude remote.","schema":{"type":"boolean"}},{"name":"has_salary","in":"query","required":false,"description":"With or without published pay.","schema":{"type":"boolean"}},{"name":"skill","in":"query","required":false,"description":"Jobs whose text names any of these skills, comma-separated: names or spellings (`Excel`, `Auto CAD`, `forklift`) or dictionary ids (`microsoft-excel`). Matched by rules against our skills dictionary (O*NET, ESCO and curated Canadian licences); see `derived.skills`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"derived","in":"query","required":false,"description":"Include the `derived` object (values read by rules from the text).","schema":{"type":"boolean","default":true}},{"name":"window","in":"query","required":false,"description":"First collected within this window.","schema":{"type":"string","enum":["1h","24h","7d","30d","6m"]}},{"name":"description","in":"query","required":false,"description":"Description fields to add.","schema":{"type":"string","enum":["none","text","html","both"]}},{"name":"source_fields","in":"query","required":false,"description":"Add `source_fields`.","schema":{"type":"boolean"}},{"name":"include_organization","in":"query","required":false,"description":"Adds `organization_id` and `organization_profile` (a short employer profile; the full one is at `/v1/organizations/{id}`).","schema":{"type":"boolean"}},{"name":"limit","in":"query","required":false,"description":"Jobs per page.","schema":{"type":"integer","minimum":1,"maximum":1000,"default":100}},{"name":"cursor","in":"query","required":false,"description":"`next_cursor` from the previous page.","schema":{"type":"string"}}],"responses":{"200":{"description":"A page of jobs","content":{"application/json":{"schema":{"type":"object","properties":{"jobs":{"type":"array","items":{"type":"object"}},"next_cursor":{"type":["string","null"]}}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/jobs/{id}":{"get":{"tags":["Search"],"operationId":"getJob","summary":"Get a job","description":"One job with both descriptions, `source_fields` and `derived`, whatever its status.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"},"description":"Job id."},{"name":"derived_evidence","in":"query","required":false,"description":"Adds `derived_evidence`: the passage each derived value was read from.","schema":{"type":"boolean"}},{"name":"include_organization","in":"query","required":false,"description":"Adds `organization_id` and `organization_profile`.","schema":{"type":"boolean"}}],"responses":{"200":{"description":"The job","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"404":{"description":"No such job.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/changes":{"get":{"tags":["Search"],"operationId":"changes","summary":"Changes feed","description":"Every created, updated, expired and excluded event for one country, in order. Store `next_since` and pass it back; `more` is true while events remain.","parameters":[{"name":"country","in":"query","required":false,"description":"Country view.","schema":{"type":"string","enum":["CA","US"],"default":"CA"}},{"name":"since","in":"query","required":false,"description":"Last sequence number you processed.","schema":{"type":"integer","minimum":0,"default":0}},{"name":"limit","in":"query","required":false,"description":"Events per page.","schema":{"type":"integer","minimum":1,"maximum":1000,"default":500}},{"name":"description","in":"query","required":false,"description":"Description fields to add.","schema":{"type":"string","enum":["none","text","html","both"]}},{"name":"source_fields","in":"query","required":false,"description":"Include `source_fields`.","schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"Change events","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/organizations":{"get":{"tags":["Organizations"],"operationId":"listOrganizations","summary":"Find organizations","description":"Employer profiles, most active jobs first, with `next_cursor` pagination. Each item is the short profile; get the full one with `/v1/organizations/{id}`.","parameters":[{"name":"name","in":"query","required":false,"description":"Name starts with (case, accents and legal endings like Inc. are ignored).","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Employers with jobs in this country.","schema":{"type":"string","enum":["CA","US"]}},{"name":"industry","in":"query","required":false,"description":"Industries, comma-separated, as the profile's `about.industries` names them (Wikidata industry or SEC SIC description), e.g. `retail`.","schema":{"type":"array","items":{"type":"string"}},"style":"form","explode":false},{"name":"size","in":"query","required":false,"description":"Employee size bands, from a count the employer, the SEC or Wikidata states.","schema":{"type":"array","items":{"type":"string","enum":["1-10","11-50","51-200","201-500","501-1000","1001-5000","5001-10000","10001+"]}},"style":"form","explode":false},{"name":"hiring_trend","in":"query","required":false,"description":"New jobs in the last 30 days against the 30 days before.","schema":{"type":"string","enum":["growing","steady","slowing","new"]}},{"name":"has_lmia","in":"query","required":false,"description":"Canada: named on ESDC's list of employers approved to hire temporary foreign workers (positive LMIA) in the last two years.","schema":{"type":"boolean"}},{"name":"states_visa_sponsorship","in":"query","required":false,"description":"At least one active posting says it offers visa sponsorship.","schema":{"type":"boolean"}},{"name":"has_website","in":"query","required":false,"description":"A verified or likely official website is known.","schema":{"type":"boolean"}},{"name":"limit","in":"query","required":false,"description":"Organizations per page.","schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},{"name":"cursor","in":"query","required":false,"description":"`next_cursor` from the previous page.","schema":{"type":"string"}}],"responses":{"200":{"description":"A page of organizations","content":{"application/json":{"schema":{"type":"object","properties":{"organizations":{"type":"array","items":{"$ref":"#/components/schemas/OrganizationSummary"}},"next_cursor":{"type":["string","null"]}}}}}},"400":{"description":"Invalid request (unknown parameter, bad value, unknown place or search syntax).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"429":{"description":"Rate limit or plan allowance reached. Honour `Retry-After`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"504":{"description":"The query exceeded the time limit; narrow it.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/organizations/{id}":{"get":{"tags":["Organizations"],"operationId":"getOrganization","summary":"Get an organization","description":"The full employer profile. Every value is a fact object that says who stated it: `stated` (the employer's own website, quoted with its address), `registry` (Wikidata, SEC EDGAR, GLEIF, ESDC) or `derived` (computed by us from our jobs, with method and version). Values from different sources are listed side by side.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"},"description":"Organization id (`organization_id` on jobs)."}],"responses":{"200":{"description":"The profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrganizationProfile"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"404":{"description":"No such organization.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}},"/v1/stats":{"get":{"tags":["Search"],"operationId":"stats","summary":"Stats","description":"Active jobs per source and region, and board counts, for one country. Recomputed every 30 minutes; `generated_at` says when.","parameters":[{"name":"country","in":"query","required":false,"description":"Country view.","schema":{"type":"string","enum":["CA","US"],"default":"CA"}}],"responses":{"200":{"description":"Statistics","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"A result is still being computed (for a few minutes after a restart). Retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}}}},"components":{"securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"`Authorization: Bearer YOUR_API_KEY`"}},"schemas":{"Job":{"type":"object","required":["id","title","url","source","source_type","date_created","country"],"properties":{"id":{"type":"integer","format":"int64","description":"Job id. Stable; match it against `/v1/expired-ats`."},"title":{"type":"string","description":"Job title as published."},"organization":{"type":["string","null"],"description":"Hiring employer."},"organization_url":{"type":["string","null"],"description":"With `include_basic_organization_details=true`: the employer's official website, when we verified it (the site names the employer and links its careers site, or the careers site lives on its domain). Otherwise null."},"organization_logo":{"type":["string","null"],"description":"With `include_basic_organization_details=true`: the logo the employer's own site publishes, when its website is verified. Otherwise null."},"organization_id":{"type":"integer","description":"With `include_basic_organization_details=true`, when the employer has a verified website: its id for `/v1/organizations/{id}`."},"date_posted":{"type":["string","null"],"description":"The posting date the source publishes (UTC), however long ago. When the source gives none, the source's last-updated date or the day we first collected the job, as `date_posted_source` says.","format":"date-time"},"date_posted_source":{"type":"string","description":"`posted` (the source's posting date), `source_updated` (no posting date: the source's last-updated date) or `first_seen` (neither: equal to `date_created`).","enum":["posted","source_updated","first_seen"]},"date_posted_original":{"type":["string","null"],"description":"The source's posting value whenever it has one, also when it could not be used (a date in the future).","format":"date-time"},"date_created":{"type":"string","description":"When we first collected the job (UTC). Use it for incremental syncs.","format":"date-time"},"date_valid_through":{"type":["string","null"],"description":"Closing date published by the employer.","format":"date-time"},"locations":{"type":["array","null"],"items":{"type":"object"},"description":"Each location as a schema.org `Place` with a `PostalAddress` (`addressLocality`, `addressRegion` code, `addressCountry`, `postalCode`) and coordinates when known."},"locations_alt":{"type":["array","null"],"items":{"type":"string"},"description":"Location labels, e.g. `Toronto, ON`."},"locations_derived":{"type":["array","null"],"items":{"type":"string"},"description":"Normalized `City, Region, Country` strings, e.g. `Toronto, Ontario, Canada`. This is what `location` searches."},"location_type":{"type":["string","null"],"description":"`TELECOMMUTE` when the employer marks the job remote."},"location_requirements":{"type":"null","description":"Not provided."},"salary":{"type":["object","null"],"description":"Employer-published pay as a schema.org `MonetaryAmount`: `currency` and a `QuantitativeValue` with `minValue`/`maxValue` (or `value`) and `unitText` (`HOUR`, `DAY`, `WEEK`, `MONTH`, `YEAR`). A bound is null when the employer states only the other (\"starting at\", \"up to\"). Never estimated or converted."},"salary_provenance":{"type":["string","null"],"description":"Where the employer stated the pay: `source_field` (the source's own pay fields) or `description` (written in the job description; read only when the amount, currency and period are explicit).","enum":["source_field","description",null]},"salary_text":{"type":["string","null"],"description":"For `description` pay: the original sentence(s) the amounts come from."},"employment_type":{"type":["array","null"],"items":{"type":"string","enum":["FULL_TIME","PART_TIME","CONTRACTOR","TEMPORARY","INTERN","VOLUNTEER","PER_DIEM"]},"description":"Employment types the employer states."},"url":{"type":"string","description":"The original job posting."},"source":{"type":"string","description":"Source system, e.g. `workday`, `greenhouse`, `icims`, `careerpage` (an employer's own career site)."},"source_type":{"type":"string","description":"`ats` or `career_site`."},"source_domain":{"type":["string","null"],"description":"Host of the posting URL."},"source_slug":{"type":["string","null"],"description":"The employer's board on the source system, e.g. `acme` or `acme.wd3.myworkdayjobs.com/External`."},"domain_derived":{"type":"null","description":"Not provided."},"description_text":{"type":["string","null"],"description":"Plain-text description (with `description_format=text`)."},"description_html":{"type":["string","null"],"description":"Original HTML description (with `description_format=html`). Not sanitized."},"cities_derived":{"type":["array","null"],"items":{"type":"string"}},"counties_derived":{"type":"null","description":"Not provided."},"regions_derived":{"type":["array","null"],"items":{"type":"string"},"description":"Province, territory or state names."},"countries_derived":{"type":["array","null"],"items":{"type":"string"}},"timezones_derived":{"type":"null","description":"Not provided."},"lats_derived":{"type":["array","null"],"items":{"type":"number"}},"lngs_derived":{"type":["array","null"],"items":{"type":"number"}},"country":{"type":"string","description":"Country view: `CA` or `US`.","enum":["CA","US"]},"apply_url":{"type":["string","null"],"description":"Separate application link, when the employer publishes one."},"work_arrangement":{"type":["string","null"],"description":"Employer-stated arrangement.","enum":["remote","hybrid","onsite",null]},"source_fields":{"type":["object","null"],"description":"With `include_source_fields=true`: `{version, fields: {name: {value, source_path}}}`, values exactly as the employer published them."},"derived":{"type":["object","null"],"description":"With `include_derived=true` (feeds) or by default (search). Derived by rules from the posting's title and description, never by an AI model and never mixed into employer-published fields. Null until the job is processed (usually within minutes). Missing facts stay null; nothing is defaulted. Skills come from the O*NET 31.0 database (USDOL/ETA, CC BY 4.0) and the ESCO classification (European Commission).","properties":{"method":{"type":"string","description":"Always `rules`.","enum":["rules"]},"version":{"type":"string","description":"Rules and dictionary version; values may change when it does."},"skills":{"type":"array","description":"Every dictionary skill the posting names in its requirements or duties (not in benefits, company or legal text). No cap.","items":{"type":"object","properties":{"id":{"type":"string","description":"Stable skill id, usable with `skill=`."},"name":{"type":"string","description":"Display name."},"kind":{"type":"string","description":"`software`, `skill` or `certification`.","enum":["software","skill","certification"]}}}},"work_arrangement":{"type":["string","null"],"description":"Only when the posting states it.","enum":["remote","hybrid","on_site",null]},"office_days_per_week":{"type":["integer","null"],"description":"In-office days per week, when a hybrid posting states them."},"ad_language":{"type":["string","null"],"description":"Language the posting is written in (`en` or `fr`); `bilingual` is true when both versions are present.","enum":["en","fr",null]},"bilingual":{"type":["boolean","null"]},"experience_years_min":{"type":["number","null"],"description":"Minimum years of experience the posting asks for."},"experience_band":{"type":["string","null"],"description":"`0-2`, `2-5`, `5-10` or `10+` from `experience_years_min`."},"education_levels":{"type":"array","items":{"type":"string","enum":["high_school","bachelor","postgraduate"]},"description":"Education levels the posting mentions."},"weekly_hours":{"type":["object","null"],"properties":{"min":{"type":"number"},"max":{"type":"number"}},"description":"Weekly hours, only when stated."},"visa_sponsorship":{"type":["boolean","null"],"description":"`true` when sponsorship is offered, `false` when refused, null when not mentioned."},"benefits":{"type":"array","items":{"type":"string"},"description":"Benefits named in the posting: `health_insurance`, `dental_insurance`, `vision_insurance`, `life_insurance`, `disability_insurance`, `retirement_plan`, `employee_assistance_program`, `paid_time_off`, `parental_leave`, `tuition_reimbursement`, `health_spending_account`, `employee_discount`, `stock_options`, `wellness_program`."},"salary":{"type":["object","null"],"description":"Pay read from the text when the employer published no structured salary: `min`, `max`, `currency`, `period` and `currency_inferred` (a bare `$` read as the country's currency)."},"employment_types":{"type":["array","null"],"items":{"type":"string"},"description":"Employment types read from the text when the employer published none."}}}}},"ModifiedJob":{"allOf":[{"$ref":"#/components/schemas/Job"},{"type":"object","properties":{"date_modified":{"type":"string","description":"When the job last changed (UTC).","format":"date-time"},"modified_fields":{"type":"null","description":"Not provided yet; compare with your stored copy."}}}]},"Problem":{"type":"object","required":["type","title","status","detail"],"properties":{"type":{"type":"string","description":"URI of the error type."},"title":{"type":"string","description":"Short summary."},"status":{"type":"integer"},"detail":{"type":"string","description":"What went wrong, safe to show."},"instance":{"type":"string","description":"Request path."}}},"Derived":{"type":["object","null"],"description":"Derived by rules from the posting's title and description, never by an AI model and never mixed into employer-published fields. Null until the job is processed (usually within minutes). Missing facts stay null; nothing is defaulted. Skills come from the O*NET 31.0 database (USDOL/ETA, CC BY 4.0) and the ESCO classification (European Commission).","properties":{"method":{"type":"string","description":"Always `rules`.","enum":["rules"]},"version":{"type":"string","description":"Rules and dictionary version; values may change when it does."},"skills":{"type":"array","description":"Every dictionary skill the posting names in its requirements or duties (not in benefits, company or legal text). No cap.","items":{"type":"object","properties":{"id":{"type":"string","description":"Stable skill id, usable with `skill=`."},"name":{"type":"string","description":"Display name."},"kind":{"type":"string","description":"`software`, `skill` or `certification`.","enum":["software","skill","certification"]}}}},"work_arrangement":{"type":["string","null"],"description":"Only when the posting states it.","enum":["remote","hybrid","on_site",null]},"office_days_per_week":{"type":["integer","null"],"description":"In-office days per week, when a hybrid posting states them."},"ad_language":{"type":["string","null"],"description":"Language the posting is written in (`en` or `fr`); `bilingual` is true when both versions are present.","enum":["en","fr",null]},"bilingual":{"type":["boolean","null"]},"experience_years_min":{"type":["number","null"],"description":"Minimum years of experience the posting asks for."},"experience_band":{"type":["string","null"],"description":"`0-2`, `2-5`, `5-10` or `10+` from `experience_years_min`."},"education_levels":{"type":"array","items":{"type":"string","enum":["high_school","bachelor","postgraduate"]},"description":"Education levels the posting mentions."},"weekly_hours":{"type":["object","null"],"properties":{"min":{"type":"number"},"max":{"type":"number"}},"description":"Weekly hours, only when stated."},"visa_sponsorship":{"type":["boolean","null"],"description":"`true` when sponsorship is offered, `false` when refused, null when not mentioned."},"benefits":{"type":"array","items":{"type":"string"},"description":"Benefits named in the posting: `health_insurance`, `dental_insurance`, `vision_insurance`, `life_insurance`, `disability_insurance`, `retirement_plan`, `employee_assistance_program`, `paid_time_off`, `parental_leave`, `tuition_reimbursement`, `health_spending_account`, `employee_discount`, `stock_options`, `wellness_program`."},"salary":{"type":["object","null"],"description":"Pay read from the text when the employer published no structured salary: `min`, `max`, `currency`, `period` and `currency_inferred` (a bare `$` read as the country's currency)."},"employment_types":{"type":["array","null"],"items":{"type":"string"},"description":"Employment types read from the text when the employer published none."}}},"Fact":{"type":"object","required":["value","kind"],"description":"One value and where it came from.","properties":{"value":{"description":"The value, exactly as the source states it (quotes are the employer's own words)."},"kind":{"type":"string","description":"`stated`: the employer's own website. `registry`: an official or open registry. `derived`: computed by us.","enum":["stated","registry","derived"]},"source":{"type":"string","description":"`homepage`, `about`, `careers`, `wikidata`, `sec`, `gleif`, `esdc`, `catalog` or `verification`."},"source_url":{"type":["string","null"],"description":"Where the value was read."},"fetched_at":{"type":"string","description":"When we read it.","format":"date-time"},"licence":{"type":"string","description":"The source's licence, for registry data."},"method":{"type":"string","description":"How a derived value was computed."},"version":{"type":"string","description":"Method version."},"confidence":{"type":"string","description":"For the website: `verified` or `likely`."}}},"OrganizationSummary":{"type":"object","properties":{"id":{"type":"integer"},"name":{"type":"string","description":"Display name."},"website":{"type":["string","null"],"description":"Official website (verified or likely)."},"website_confidence":{"type":["string","null"],"description":"`verified` or `likely`."},"logo":{"type":["string","null"],"description":"Logo URL from the employer's site."},"industries":{"type":["array","null"],"items":{"type":"string"}},"size_band":{"type":["string","null"],"description":"Employee size band."},"headquarters":{"description":"First stated headquarters."},"links":{"type":"object","description":"Main official links by type (linkedin, x, facebook, instagram, youtube, careers, wikipedia_en). Links only: we never read these sites."},"hiring_trend":{"type":["string","null"],"description":"`growing`, `steady`, `slowing` or `new`."},"has_lmia":{"type":"boolean"},"profile_url":{"type":"string","description":"Path of the full profile."}}},"OrganizationProfile":{"type":"object","description":"The full profile. Sections hold facts (`Fact`) or lists of facts.","properties":{"id":{"type":"integer"},"name":{"type":"string","description":"Display name."},"slug":{"type":"string","description":"Readable name key."},"names":{"type":"array","items":{"type":"string"},"description":"Employer names on our jobs."},"active_jobs":{"type":"integer"},"countries":{"type":"array","items":{"type":"string"}},"job_sources":{"type":"array","items":{"type":"string"}},"identity":{"type":"object","description":"website, website_confidence, legal_names, site_name, logo, wikidata_logo, favicon, languages, wikidata_id, lei, sec_cik, tickers."},"about":{"type":"object","description":"descriptions (quotes from the employer's site), short_description (Wikidata), slogan, industries, sic, products, brands."},"size_and_structure":{"type":"object","description":"employees (each stated count with its source), size_band (derived), founded, revenue, parents, subsidiaries, legal_form, state_of_incorporation."},"locations":{"type":"object","description":"headquarters (each source), legal_address (GLEIF), addresses (employer site), job_locations (derived)."},"links":{"type":"object","description":"Every official link by type (linkedin, x, facebook, instagram, youtube, tiktok, github, glassdoor, indeed, app_store, google_play, wikipedia_en, wikipedia_fr, wikidata, careers, newsroom, investors, blog, status, accessibility), each with who published it. Links only."},"people_and_culture":{"type":["object","null"],"description":"From the employer's careers page: careers_page, ats, quotes (mission, values, remote_policy, parental_leave, learning, diversity, accessibility, footprint), benefits (derived labels with the quoted sentence), accommodation_contact."},"hiring":{"type":["object","null"],"description":"Derived from our jobs: open_jobs (by country and region), new_jobs (7, 30, previous 30, 90 days), trend, velocity_per_week, hiring_now, top_titles, top_locations, remote_share, pay (share_with_pay, transparency, bands), top_skills, top_software, languages, visa_sponsorship, median_days_open, repost_rate, ats, career_sites."},"signals":{"type":"object","description":"lmia (ESDC positive LMIA list), visa_sponsorship_in_postings, pay_transparency."},"certifications":{"type":"array","items":{"$ref":"#/components/schemas/Fact"}},"sources":{"type":"array","items":{"type":"object"},"description":"Each source used and its licence."}}},"Organization":{"type":"object","properties":{"organization":{"type":"string","description":"Employer name, as used by `organization`."},"sources":{"type":"array","items":{"type":"string"}},"countries":{"type":"array","items":{"type":"string"}},"active_jobs":{"type":"integer"}}}}}}