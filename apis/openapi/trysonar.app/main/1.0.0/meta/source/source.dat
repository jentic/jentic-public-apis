    "/api/v1/apps/{id}/sales": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "App Store Connect sales for one of your iOS apps (Agency plan)",
        "description": "Daily first-time downloads, redownloads, in-app purchase units and approximate USD proceeds (static FX table, hence `proceeds_usd_approx`), window totals, and a per-country breakdown for one of your own iOS apps — same numbers as the Performance page. Needs an App Store Connect connection. Every response carries `status` (ready | not_connected | not_ios | app_not_in_account | pending | key_lacks_analytics) and a human-readable `message` when not ready, instead of an empty series; days Apple hasn't reported have `reported: false` and null metrics. Requires the Agency plan — 403 on other plans.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sonar app UUID or store id (bundle id) of one of your own tracked iOS apps",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "First day of the window, YYYY-MM-DD (inclusive). Defaults to `days` back from `end`.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "Last day of the window, YYYY-MM-DD (inclusive). Defaults to yesterday (UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Window length in days when `start` is omitted (1-366, default 30)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 366,
              "default": 30
            }
          },
          {
            "name": "store",
            "in": "query",
            "required": false,
            "description": "Disambiguates a store id tracked in both stores",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ app_id, app_name, store, status, connected, message, apple_app_id, last_synced_at, range: { start, end }, reported_days, totals: { downloads, redownloads, iap_units, proceeds_usd_approx } | null, days: [{ date, reported, downloads, redownloads, iap_units, proceeds_usd_approx }], countries: [{ country, downloads, redownloads, iap_units, proceeds_usd_approx }] }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "forbidden — App Store Connect data via the API requires the Agency plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsByIdSales"
      }
    },
    "/api/v1/apps/{id}/engagement": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "App Store Connect engagement for one of your iOS apps (Agency plan)",
        "description": "App Analytics for one of your own iOS apps — same numbers as the Engagement page: impressions → product page views → downloads with conversion rates (page_view_rate, download_rate) and App Store search share, impressions by source, and installs, deletions and sessions by day. Impressions follow App Store Connect's definition and INCLUDE product page views, so totals reconcile with App Store Connect; downloads come from the Sales report. Needs an App Store Connect connection with an Admin-role key. Every response carries `status` (ready | not_connected | not_ios | app_not_in_account | pending | key_lacks_analytics) and a human-readable `message` when not ready, instead of an empty series; days Apple hasn't reported have `reported: false` and null metrics. Requires the Agency plan — 403 on other plans.",
