      "post": {
        "tags": [
          "Write"
        ],
        "summary": "Track keywords for an app (bulk, idempotent)",
        "description": "Requires the Indie plan and a write-scope API key. Re-posting the same terms reports them as already_tracked.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sonar app UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "keywords"
                ],
                "properties": {
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "minItems": 1,
                    "maxItems": 200
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$",
                    "description": "Optional — defaults to the linked product's country"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Per-keyword outcomes: { added, already_tracked, failed, results }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
