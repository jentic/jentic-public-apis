    "/api/v1/screenshots/sets/{id}/translations/{locale}": {
      "put": {
        "tags": [
          "Write"
        ],
        "summary": "Replace one locale's translation overrides",
        "description": "Overrides are sparse (keyed by layer id) and replace the screen's stored overrides for that locale wholesale; geometry/styling always come from the source layout. The locale is auto-enabled on the set. Requires the Indie plan and a write-scope API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entries"
                ],
                "properties": {
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "screenshot_id",
                        "overrides"
                      ],
                      "properties": {
                        "screenshot_id": {
                          "type": "string"
                        },
                        "overrides": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The locale's stored overrides",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
