{
  "openapi": "3.1.0",
  "info": {
    "title": "Sonar API",
    "description": "App Store Optimization data for AI agents, MCP tools, and automation. Keyword research, rank tracking, ASO scoring, reviews, and revenue estimates for the iOS App Store and Google Play.\n\nVersioning & deprecation policy: the API is URL-versioned (`/api/v1`). Breaking changes only ever ship under a new version path — existing `/api/v1` shapes are additive-only. If an endpoint is ever deprecated it keeps working for at least 6 months, signals the timeline with `Deprecation` and `Sunset` response headers, and is announced at https://trysonar.app/changelog.",
    "version": "1.0.0",
    "termsOfService": "https://trysonar.app/terms",
    "contact": {
      "url": "https://trysonar.app/support"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://trysonar.app/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.trysonar.app",
      "description": "Production"
    },
    {
      "url": "https://trysonar.app",
      "description": "Production (legacy, proxied)"
    }
  ],
  "externalDocs": {
    "description": "API reference",
    "url": "https://trysonar.app/docs/api"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "aso_xxx",
        "description": "API key with the `aso_` prefix. Get one at /developers (50 free credits on signup). OAuth access tokens from the hosted MCP flow (RFC 9728 discovery at /.well-known/oauth-protected-resource/mcp; Clerk authorization server) are also accepted as the bearer. A few stateless endpoints also work with NO auth at all (anonymous free tier, per-IP daily limits): /apps/search, /apps/lookup, /apps/aso-score, /apps/extract-keywords, /keywords/suggestions, /charts/top (shared 30 req/day) and /keywords/metrics (5 keywords/day)."
      }
    },
    "parameters": {
      "Store": {
        "name": "store",
        "in": "query",
        "required": true,
        "description": "App store",
        "schema": {
          "type": "string",
          "enum": [
            "ios",
            "android"
          ]
        },
        "example": "ios"
      },
      "Country": {
        "name": "country",
        "in": "query",
        "required": false,
        "description": "ISO 3166-1 alpha-2 country code. Store reads accept every App Store storefront (175) and Google Play market (145); a code that isn't a storefront returns 400 with `error.reason: \"unsupported_market\"`.",
        "schema": {
          "type": "string",
          "default": "us",
          "pattern": "^[a-z]{2}$"
        },
        "example": "us"
      },
      "StorefrontCountry": {
        "name": "country",
        "in": "query",
        "required": false,
        "description": "ISO 3166-1 alpha-2 country code. Every Google Play market and every App Store storefront except 58 small ones that have no numeric storefront id (Apple would silently answer with the US store, so they return 400 with `error.reason: \"unsupported_market\"`; app lookup, search and reviews still work there).",
        "schema": {
          "type": "string",
          "default": "us",
          "pattern": "^[a-z]{2}$"
        },
        "example": "us"
      },
      "ResearchCountry": {
        "name": "country",
        "in": "query",
        "required": false,
        "description": "ISO 3166-1 alpha-2 country code — one of Sonar's 72 keyword-research markets (keyword data is persisted per country). Other codes return 400 with `error.reason: \"unsupported_market\"` and the list of supported codes.",
        "schema": {
          "type": "string",
          "default": "us",
          "pattern": "^[a-z]{2}$"
        },
        "example": "us"
      },
      "TimeBudget": {
        "name": "X-Sonar-Time-Budget-Ms",
        "in": "header",
        "required": false,
        "description": "Optional: total milliseconds the caller will wait for the response. The server stops starting store work before it ends and answers with what it has — cached, `stale`, or `pending` keywords (queued on the scrape fleet, not billed); charts serve the newest stored snapshot. Can only shorten the server default (API_REQUEST_DEADLINE_MS, 40s on the API box); values under 3000 are treated as 3000. The MCP tools send it.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 27000
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Pagination cursor from a previous response's next_cursor",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size (1–200)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "Days": {
        "name": "days",
        "in": "query",
        "required": false,
        "description": "History window in days (1–365)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "default": 30
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "description": "Every error carries `code` + `message`. The remaining fields are optional and additive — branch on `reason` when present, else on `code`.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "description": "Stable sub-code. daily_limit (402/429: included daily quota used up, resets 00:00 UTC), no_credits (402: credit balance below the call's cost), anonymous_daily_limit (429: keyless per-IP allowance used up), batch_too_large (429: keyless call asks for more keywords than the daily allowance — the only case where a smaller batch helps), store_rate_limited (429: store throttling or scraper queue saturated, transient), concurrency_limit (429: per-caller in-flight cap, ~8 concurrent scrapes), store_unavailable (503: store failed or timed out), refresh_in_progress (503: a chart is still being fetched), plan_required (403, see required_plan), scope_required (403, see required_scope), payment_past_due (403: writes paused after the 3-day past-due grace), no_workspace (403: OAuth user owns no Sonar workspace), unsupported_market (400: country not served by this endpoint for that store).",
                "enum": [
                  "daily_limit",
                  "no_credits",
                  "anonymous_daily_limit",
                  "batch_too_large",
                  "store_rate_limited",
                  "concurrency_limit",
                  "store_unavailable",
                  "refresh_in_progress",
                  "plan_required",
                  "scope_required",
                  "payment_past_due",
                  "no_workspace",
                  "unsupported_market"
                ]
              },
              "retry_after_seconds": {
                "type": "integer",
                "description": "On retryable 429/503 errors: seconds to wait before retrying (mirrors the Retry-After header, which some proxies drop)."
              },
              "reset_at": {
                "type": "string",
                "format": "date-time",
                "description": "When an exhausted daily allowance resets (always the next 00:00 UTC)"
              },
              "limit": {
                "type": "integer",
                "description": "The exhausted daily allowance, in limit_unit per day"
              },
              "limit_unit": {
                "type": "string",
                "enum": [
                  "requests",
                  "keywords"
                ]
              },
              "required_plan": {
                "type": "string",
                "enum": [
                  "indie",
                  "agency"
                ],
                "description": "Plan that unlocks the endpoint"
              },
              "required_scope": {
                "type": "string",
                "description": "API-key scope the call needs (e.g. write)"
              },
              "credits_balance": {
                "type": "number",
                "description": "Current API credit balance"
              },
              "credits_cost": {
                "type": "number",
                "description": "Credits this call costs"
              }
            }
          }
        }
      },
      "StaleMeta": {
        "type": "object",
        "description": "Envelope `meta`, present only when the store was throttling and the endpoint answered from Sonar's stored copy instead of failing (apps/lookup, apps/search, apps/reviews, keywords/suggestions). Live answers carry no `meta`. A stored copy is billed like any 200.",
        "required": [
          "stale",
          "stale_as_of",
          "partial",
          "retry_after_seconds",
          "note"
        ],
        "properties": {
          "stale": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "stale_as_of": {
            "type": "string",
            "nullable": true,
            "description": "When the stored copy was captured: ISO 8601 timestamp or YYYY-MM-DD date; null when unknown."
          },
          "partial": {
            "type": "boolean",
            "description": "The copy holds less than a live call would: fewer results or fields (stored search results stop at the top 10, name/developer/icon only), or a different order (stored suggestions are ranked by popularity)."
          },
          "stale_country": {
            "type": "string",
            "nullable": true,
            "description": "App lookup only: the storefront the stored copy came from, when it differs from the request."
          },
          "retry_after_seconds": {
            "type": "integer",
            "description": "When live data is expected again."
          },
          "note": {
            "type": "string",
            "description": "One sentence explaining what was served — safe to show to a user."
          }
        }
      },
      "App": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "developer": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "description": "Official storefront rating; null when unavailable."
          },
          "reviews": {
            "type": "integer",
            "nullable": true,
            "description": "Official rating count, not written review count; null when unavailable."
          },
          "category": {
            "type": "string"
          },
          "iconUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Keyword": {
        "type": "object",
        "description": "One keyword row from /keywords/metrics or /keywords/search. Freshness: `stale` is false only when `measured_at` and `popularity_measured_at` (when present) are both under 7 days old. Rows measured 7–30 days ago are served with `stale: true` and re-measured in the background; older ones are re-measured during the request. iOS Apple popularity older than 7 days is re-fetched from Apple during the request; if Apple doesn't answer in time the stored value is served with its original `popularity_measured_at` and `stale: true`. Android popularity checked against Play autocomplete and older than 7 days is served with `stale: true` and re-checked in the background. When the store cannot be reached, a stored measurement of any age is served instead of an error, always with `stale: true`.",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "store": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "country": {
            "type": "string",
            "description": "Two-letter storefront code"
          },
          "popularity": {
            "type": "number",
            "nullable": true,
            "description": "0–100 popularity score. Null when unknown and on pending/error rows."
          },
          "popularity_proxy": {
            "type": "number",
            "nullable": true,
            "description": "Sonar's in-house estimate, present only when Apple censors an iOS keyword's real Search Popularity to its floor (5). Disambiguates keywords inside the censored band (rendered as '5 (58)'). Null otherwise."
          },
          "popularity_source": {
            "type": "string",
            "enum": [
              "apple",
              "proxy"
            ],
            "nullable": true,
            "description": "Provenance of `popularity`: 'apple' = real Apple Search Popularity reported by Apple Search Ads (not an estimate), 'proxy' = Sonar's in-house estimate. Null when unknown or when popularity is null."
          },
          "difficulty": {
            "type": "number",
            "description": "0–100 proprietary difficulty score"
          },
          "est_downloads_at_1": {
            "type": "number",
            "nullable": true,
            "description": "Estimated downloads/day for the app ranking #1 on this keyword (rough order of magnitude from the Apple-calibrated popularity curve, 2 significant figures). iOS only — null on Android or when popularity is unknown."
          },
          "difficulty_breakdown": {
            "type": "object",
            "nullable": true,
            "description": "Explainable difficulty ingredients. `beatable: true` = a top-3 slot looks winnable (an app holds it with ≥10x less strength than the SERP median, or the term is under-targeted in titles with a weak top-3 app). Null for rows cached before the field existed or SERPs with <3 results.",
            "properties": {
              "titleMatches": {
                "type": "integer",
                "description": "Top-10 apps whose title contains the keyword"
              },
              "appsAnalyzed": {
                "type": "integer"
              },
              "top3Strength": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Ratings count (iOS) / installs (Android) of the top 3 apps, in rank order"
              },
              "medianStrength": {
                "type": "number"
              },
              "weakSpotRank": {
                "type": "integer",
                "nullable": true
              },
              "beatable": {
                "type": "boolean"
              }
            }
          },
          "results_count": {
            "type": "integer",
            "description": "Number of apps the store returned for the term (0 on pending/error rows)."
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When difficulty, difficulty_breakdown and results_count were measured (ISO 8601, UTC); the compute time for a keyword computed during the request. Null on pending/error rows."
          },
          "popularity_measured_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the returned `popularity` value was measured (ISO 8601, UTC) — can be older than `measured_at`. Apple Search Popularity: when Sonar last fetched it from Apple. Sonar's estimates: same as `measured_at`. Android values checked against Play autocomplete: the start of the UTC day they were checked (a lower bound, never later than the real time). Null when `popularity` is null."
          },
          "stale": {
            "type": "boolean",
            "description": "False only when `measured_at` and `popularity_measured_at` (when present) are both under 7 days old; true otherwise, including stored measurements served because the store could not be reached. Stale rows are real data and are billed like cache hits. To enforce a maximum age, compare both timestamps."
          },
          "error": {
            "description": "Present only on rows that carry no data. /keywords/metrics: an object `{ code, message, retry_after_seconds? }` (`code` is `pending`, `rate_limited`, `unavailable` or `internal_error`). /keywords/search: the string `pending` or `scrape_failed`, with `retry_after_seconds` alongside on pending rows.",
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "scrape_failed"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "retry_after_seconds": {
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "retry_after_seconds": {
            "type": "integer",
            "description": "/keywords/search pending rows only: seconds to wait before re-requesting the term."
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Plan or scope insufficient (workspace endpoints need the Indie plan; writes also need a write-scope key)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found or not tracked by your organization",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limited — see `error.reason`: daily_limit (Indie plan: 1,000 requests/day, resets 00:00 UTC; see `reset_at`), anonymous_daily_limit / batch_too_large (keyless free tier), store_rate_limited or concurrency_limit (transient, honor `retry_after_seconds`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Missing or invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/apps/lookup": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Look up an app by store ID",
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "App store ID (numeric for iOS, package for Android)",
            "schema": {
              "type": "string"
            },
            "example": "310633997"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Store reads accept every App Store storefront (175) and Google Play market (145); a code that isn't a storefront returns 400 with `error.reason: \"unsupported_market\"`.",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          }
        ],
        "responses": {
          "200": {
            "description": "App metadata. When the store is throttling, Sonar's stored copy of the app with `meta.stale` (a throttle is never reported as 404).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/App"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StaleMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsLookup",
        "description": "Look up an app by store ID",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/apps/search": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Search apps in a store",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query",
            "schema": {
              "type": "string"
            },
            "example": "meditation"
          },
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Store reads accept every App Store storefront (175) and Google Play market (145); a code that isn't a storefront returns 400 with `error.reason: \"unsupported_market\"`.",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "num",
            "in": "query",
            "description": "Max results (1–50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results in store order. When the store is throttling, the newest stored top 10 for this exact term and storefront with `meta.stale` + `meta.partial` (entries carry rank, store, storeId, name, developer, iconUrl only).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/App"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StaleMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsSearch",
        "description": "Search apps in a store",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/apps/aso-score": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Calculate an ASO optimization score (0–100)",
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "App store ID (numeric for iOS, package for Android)",
            "schema": {
              "type": "string"
            },
            "example": "310633997"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Store reads accept every App Store storefront (175) and Google Play market (145); a code that isn't a storefront returns 400 with `error.reason: \"unsupported_market\"`.",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          }
        ],
        "responses": {
          "200": {
            "description": "ASO score breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsAsoScore",
        "description": "Calculate an ASO optimization score (0–100)",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/apps/extract-keywords": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Extract keywords from an app's metadata",
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "App store ID (numeric for iOS, package for Android)",
            "schema": {
              "type": "string"
            },
            "example": "310633997"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Store reads accept every App Store storefront (175) and Google Play market (145); a code that isn't a storefront returns 400 with `error.reason: \"unsupported_market\"`.",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "max",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Extracted keywords",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsExtractKeywords",
        "description": "Extract keywords from an app's metadata",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/apps/reviews": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Fetch app reviews",
        "description": "Android defaults to merged market-language, English, Spanish, French, and Arabic feeds, deduplicated and sorted before limiting. Coverage is bounded, not exhaustive. Use lang for another specific feed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Store"
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Android only: two-letter language code to fetch a single feed instead of the default merged feeds.",
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z]{2}$"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "App store ID (numeric for iOS, package for Android)",
            "schema": {
              "type": "string"
            },
            "example": "310633997"
          },
          {
            "$ref": "#/components/parameters/Country"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "helpful"
              ],
              "default": "recent"
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          {
            "name": "max_rating",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "App reviews. When the store is throttling, Sonar's stored reviews for the storefront with `meta.stale` (rating filters and limit still apply; not for single-`lang` Android requests).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "userName": {
                            "type": "string"
                          },
                          "score": {
                            "type": "integer"
                          },
                          "title": {
                            "type": "string",
                            "nullable": true
                          },
                          "text": {
                            "type": "string"
                          },
                          "date": {
                            "type": "string",
                            "nullable": true
                          },
                          "version": {
                            "type": "string",
                            "nullable": true
                          },
                          "url": {
                            "type": "string",
                            "nullable": true
                          },
                          "thumbsUp": {
                            "type": "integer",
                            "nullable": true
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StaleMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsReviews"
      }
    },
    "/api/v1/apps/revenue": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Estimate monthly revenue for an app (single or bulk)",
        "description": "Pass `id` for a single app or `ids` (comma-separated, up to 25) for bulk lookup. Bulk counts as one request. Each estimate includes a `confidence` grade (high/medium/low) and `confidence_factors` explaining it. Apps Sonar synced on the same storefront within the last day are estimated from the stored listing. When the store can't answer, an estimate from an older stored listing is returned flagged `stale: true` (bulk: per item; single: `meta.stale` + `meta.stale_as_of`); with nothing stored, a bulk item carries `error.code` `rate_limited` or `unavailable` with `retry_after_seconds` (not billed), and the request is 429/503 only when every id failed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Store"
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated store IDs (max 25)",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Country"
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly revenue estimate(s). Bulk items may carry `stale: true` or a per-id `error` (`not_found`, `rate_limited`, `unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "description": "rate_limited — Sonar's store lanes are busy and nothing is stored for the app (single id), or every bulk id was shed; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "unavailable — the store throttled or failed and nothing is stored for the app (single id), or every bulk id failed; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getAppsRevenue"
      }
    },
    "/api/v1/keywords/search": {
      "get": {
        "tags": [
          "Keywords"
        ],
        "summary": "Keyword research with difficulty + popularity",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Store"
          },
          {
            "$ref": "#/components/parameters/ResearchCountry"
          },
          {
            "$ref": "#/components/parameters/TimeBudget"
          }
        ],
        "responses": {
          "200": {
            "description": "Keyword data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Keyword"
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Every row is `pending`: nothing could be computed inside the request, so each term was queued on the scrape fleet (`error: \"pending\"` + `retry_after_seconds` per row). Not billed, and doesn't count against the daily quota — re-request after the hint. When only some rows are pending the status is 200.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "unavailable (`reason: store_unavailable`) — the store couldn't be reached and nothing is stored for the requested terms; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getKeywordsSearch",
        "description": "Keyword research with difficulty + popularity"
      }
    },
    "/api/v1/keywords/suggestions": {
      "get": {
        "tags": [
          "Keywords"
        ],
        "summary": "Autocomplete-driven keyword suggestions",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Seed keyword to expand",
            "schema": {
              "type": "string"
            },
            "example": "meditation"
          },
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Every Google Play market and every App Store storefront except 58 small ones that have no numeric storefront id (Apple would silently answer with the US store, so they return 400 with `error.reason: \"unsupported_market\"`; app lookup, search and reviews still work there).",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          }
        ],
        "responses": {
          "200": {
            "description": "Autocomplete suggestions. When the store is throttling, stored terms starting with the seed (3+ characters) that Sonar has seen in autocomplete within 90 days, ranked by popularity, with `meta.stale` + `meta.partial`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "term": {
                            "type": "string"
                          },
                          "priority": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StaleMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getKeywordsSuggestions",
        "description": "Autocomplete-driven keyword suggestions",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/charts/top": {
      "get": {
        "tags": [
          "Charts"
        ],
        "summary": "Top free/paid/grossing chart with day-over-day movement",
        "description": "Market-wide store chart (no tracked apps needed). 1 credit. The first request for a (store, country, chart, category) combo on a given day fetches it live and snapshots it; later requests that day are served from the snapshot. `summary`, `movers` and `droppedApps` always describe the whole top 200 — `limit` truncates `entries` only. A combo requested for the first time has no previous snapshot, so `previousMeasuredAt` is null and every `delta` is null. A live fetch is awaited only until the request deadline (API_REQUEST_DEADLINE_MS, or `X-Sonar-Time-Budget-Ms` minus 2s); past it the newest stored snapshot (≤7 days old) is served with `stale: true` and its `measuredAt` date while the fetch finishes in the background, so the next request is fresh. With nothing stored the endpoint returns 503 `refresh_in_progress` (Retry-After 20).",
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": false,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ],
              "default": "ios"
            },
            "example": "ios"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code. Every Google Play market and every App Store storefront except 58 small ones that have no numeric storefront id (Apple would silently answer with the US store, so they return 400 with `error.reason: \"unsupported_market\"`; app lookup, search and reviews still work there).",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "X-Sonar-Time-Budget-Ms",
            "in": "header",
            "required": false,
            "description": "Optional: total milliseconds the caller will wait for the response. The server stops starting store work before it ends and answers with what it has — cached, `stale`, or `pending` keywords (queued on the scrape fleet, not billed); charts serve the newest stored snapshot. Can only shorten the server default (API_REQUEST_DEADLINE_MS, 40s on the API box); values under 3000 are treated as 3000. The MCP tools send it.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 27000
          },
          {
            "name": "chart",
            "in": "query",
            "required": false,
            "description": "Chart type",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "paid",
                "grossing"
              ],
              "default": "free"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Normalized category key (e.g. HEALTH_AND_FITNESS on iOS, GAME on Android), or `overall` for the store-wide chart",
            "schema": {
              "type": "string",
              "default": "overall"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Chart entries to return",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chart entries with movement, summary, movers and dropped apps",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "store": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "chart": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string"
                        },
                        "measuredAt": {
                          "type": "string",
                          "format": "date"
                        },
                        "previousMeasuredAt": {
                          "type": "string",
                          "format": "date",
                          "nullable": true,
                          "description": "Date movement is computed against"
                        },
                        "stale": {
                          "type": "boolean",
                          "description": "True when an older snapshot (≤7 days) was served instead of today's — the live fetch failed or didn't finish before the request deadline. `measuredAt` is the served snapshot's date."
                        },
                        "summary": {
                          "type": "object",
                          "properties": {
                            "total": {
                              "type": "integer"
                            },
                            "newToday": {
                              "type": "integer"
                            },
                            "dropped": {
                              "type": "integer"
                            }
                          }
                        },
                        "entries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "rank": {
                                "type": "integer"
                              },
                              "storeId": {
                                "type": "string"
                              },
                              "numericId": {
                                "type": "integer",
                                "nullable": true,
                                "description": "iOS only — numeric Apple id (storeId is the bundle id)"
                              },
                              "name": {
                                "type": "string"
                              },
                              "iconUrl": {
                                "type": "string",
                                "nullable": true
                              },
                              "developer": {
                                "type": "string",
                                "nullable": true
                              },
                              "rating": {
                                "type": "number",
                                "nullable": true
                              },
                              "delta": {
                                "type": "integer",
                                "nullable": true,
                                "description": "previousRank - rank (positive = moved up); null when new or no previous snapshot"
                              },
                              "isNew": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "movers": {
                          "type": "array",
                          "description": "Up to 10 biggest movers (|delta| >= 3) across the whole chart",
                          "items": {
                            "type": "object",
                            "properties": {
                              "storeId": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "iconUrl": {
                                "type": "string",
                                "nullable": true
                              },
                              "rank": {
                                "type": "integer"
                              },
                              "delta": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "droppedApps": {
                          "type": "array",
                          "description": "Apps in the previous snapshot but not in this one",
                          "items": {
                            "type": "object",
                            "properties": {
                              "storeId": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "iconUrl": {
                                "type": "string",
                                "nullable": true
                              },
                              "previousRank": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "No snapshot ≤7 days old is stored and today's can't be served yet. `reason: refresh_in_progress` (code unavailable, Retry-After 20): the first fetch for this combo is still running in the background — retry and it's a cache hit. `reason: store_unavailable` (Retry-After 30): the store fetch failed. Both are refunded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getChartsTop",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/keywords/metrics": {
      "get": {
        "tags": [
          "Keywords"
        ],
        "summary": "Difficulty + popularity for a specific keyword (or bulk)",
        "description": "Pass `q` for a single keyword or `qs` (comma-separated, max 25) for bulk. 1 credit per keyword. Use this when you already have a keyword list — `/keywords/search` is the heavier endpoint that also fans out into related terms.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Single keyword (use this OR qs)",
            "example": "meditation timer"
          },
          {
            "name": "qs",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated bulk keywords, up to 25"
          },
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "App store",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            },
            "example": "ios"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code — one of Sonar's 72 keyword-research markets (keyword data is persisted per country). Other codes return 400 with `error.reason: \"unsupported_market\"` and the list of supported codes.",
            "schema": {
              "type": "string",
              "default": "us",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "X-Sonar-Time-Budget-Ms",
            "in": "header",
            "required": false,
            "description": "Optional: total milliseconds the caller will wait for the response. The server stops starting store work before it ends and answers with what it has — cached, `stale`, or `pending` keywords (queued on the scrape fleet, not billed); charts serve the newest stored snapshot. Can only shorten the server default (API_REQUEST_DEADLINE_MS, 40s on the API box); values under 3000 are treated as 3000. The MCP tools send it.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 27000
          }
        ],
        "responses": {
          "200": {
            "description": "Single keyword data (when `q`) or array of keyword data (when `qs`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Keyword"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Keyword"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "pending — nothing could be computed inside the request (store allowance spent, throttling, per-caller cap, or the time budget/deadline ran out), so every term was queued on the scrape fleet. Single `q`: the keyword object with `error.code: \"pending\"` + `error.retry_after_seconds`; bulk: every item pending. Not billed and doesn't count against the daily quota — re-request after the hint (a cache hit).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid params (incl. `reason: unsupported_market` for a country outside the 72 keyword-research markets)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "description": "rate_limited (`reason: store_rate_limited`, or `concurrency_limit` when the per-caller cap refused every term) — every requested term was shed (scraper queue congested or too many concurrent lookups for this caller); honor Retry-After. When only SOME bulk terms are shed the response is a 200 whose affected items carry `error.code: \"rate_limited\"` plus `error.retry_after_seconds` (the same hint as the Retry-After header, which is nonstandard on a 200 and may be stripped by proxies — prefer the body field) — completed terms are returned and cached, and no unserved term is billed. Keep bulk requests sequential (per-caller budget ~8 concurrently resolving keywords).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "unavailable (`reason: store_unavailable`) — the store data source is temporarily throttling; check Retry-After and retry. Bulk (`qs`) requests report this per-item inside the 200 array instead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getKeywordsMetrics",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
