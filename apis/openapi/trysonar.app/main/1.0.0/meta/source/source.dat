            "description": "{ app_id, app_name, store, status, connected, message, apple_app_id, last_synced_at, range: { start, end }, reported_days, totals: { impressions, product_page_views, downloads, installs, deletions, sessions } | null, rates: { page_view_rate, download_rate, search_share } | null, sources: [{ source_type, impressions, product_page_views, share_of_impressions }], days: [{ date, reported, impressions, product_page_views, installs, deletions, sessions, downloads }] }",
