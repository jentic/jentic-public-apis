                    "type": "string"
                  },
                  "locales": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Replaces the extra-locale list; removed locales lose their translations"
                  },
                  "screen_order": {
                    "type": "array",
                    "items": {
