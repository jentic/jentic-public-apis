              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ app_id, country, insight: { generated_at, reviews_analyzed, avg_score, window_start, window_end, model, overview, sentiment, praises[], complaints[], feature_requests[], changes_since_last } | null, cooldown: { in_cooldown, next_available_at } }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsByIdReviewInsights"
      },
      "post": {
        "tags": [
          "Write"
        ],
        "summary": "Generate an AI review insight (90-day cooldown)",
        "description": "Analyzes the app's recent reviews into a fresh insight. At most one analysis per app+country every 90 days — 429 `cooldown` with the next available time. 403 `trial_locked` on trial plans (AI-cost feature, paid plans only; GET stays available), 422 `too_few_reviews` (fewer than 5 recent reviews), 502 `ai_failed`. Requires the Indie plan (paid, non-trial) and a write-scope API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sonar app UUID or store id of a tracked app",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Reviews market (ISO country code, default us)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Same shape as the GET endpoint (insight + cooldown)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "trial_locked — generation is reserved for paid (non-trial) plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "too_few_reviews — fewer than 5 recent reviews to analyze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "cooldown — an insight was generated within the last 90 days; the message carries the next available time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "description": "ai_failed — the AI analysis failed, retry shortly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "postAppsByIdReviewInsights"
      }
    },
