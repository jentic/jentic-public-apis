    "/api/v1/screenshots/sets/{id}/export": {
      "get": {
        "tags": [
          "Screenshots"
        ],
        "summary": "Server-rendered store-ready PNG export",
        "description": "Renders through the same engine as the Screenshot Studio editor — no browser needed. Default response is application/zip with 01.png…NN.png at native device resolution in store upload order. Call once per locale. Read scope.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Render that locale's overrides (default: source locale)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "screen",
            "in": "query",
            "description": "A screen id — returns that single slice as image/png",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meta",
            "in": "query",
            "description": "meta=1 returns lightweight JSON (source_locale, locales, screen ids) instead of rendering",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "application/zip (default), image/png (screen=), or JSON (meta=1)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getScreenshotsSetsByIdExport"
      }
    },
