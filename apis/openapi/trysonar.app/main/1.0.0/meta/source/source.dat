    "/api/v1/apps/{id}/competitor-landscape": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Competitive landscape for one of your own apps",
        "description": "The live competitive keyword picture vs every tracked competitor: gap/winnable/threat/lead stats, the top gap (25), threat (10), and lead (10) rows with metrics, and the latest AI insight (or null). Empty landscape (zeroed stats, insight null) when no competitors are tracked. Requires the Indie plan.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Your own app's Sonar UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Landscape: { app_id, stats: { competitors, keywords_compared, gaps, winnable, threats, leads }, gaps[], threats[], leads[], competitors[], insight, insight_cooldown: { in_cooldown, next_available_at } }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsByIdCompetitorLandscape"
      },
      "post": {
        "tags": [
          "Write"
        ],
        "summary": "Generate an AI competitive insight (7-day cooldown)",
        "description": "Runs an AI analysis over the landscape: clusters keyword gaps into named opportunity themes with per-keyword metrics, writes threat narratives for climbing competitors, and diffs against the previous analysis. At most one analysis per app per 7 days — 429 with code `cooldown` and the next available time while in cooldown. 403 `trial_locked` on trial plans (AI-cost feature, paid plans only; GET stays available), 422 `no_competitors` / `too_little_data` (fewer than 5 compared keywords), 502 `ai_failed`. Requires a paid (non-trial) Indie plan and a write-scope API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Your own app's Sonar UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ app_id, insight } — same insight shape as the GET endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "no_competitors (track a competitor first) or too_little_data (fewer than 5 compared keywords)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "cooldown — an analysis was generated within the last 7 days; the message carries the next available time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "description": "ai_failed — the AI analysis failed, retry shortly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "postAppsByIdCompetitorLandscape"
      }
    },
    "/api/v1/apps/{id}/discovered-keywords": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Discovered keywords for an app (what to track next)",
        "description": "Keywords Sonar's discovery engine surfaced for the app but that aren't tracked yet — ranked finds (bucket `ranked`), competitor gaps (`gap`), and idea suggestions (`idea`) — each with latest metrics, AI relevance (0-100), and an opportunity score (0-100). Sorted by opportunity, best first; `total` is the filtered count before `limit`. Track the winners via POST /api/v1/apps/{id}/keywords. Requires the Indie plan.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sonar app UUID or store id of a tracked app",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Filter to one market (ISO country code)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Filter by discovery source",
            "schema": {
              "type": "string",
              "enum": [
                "autocomplete",
                "metadata",
                "serp_scan",
                "competitor",
                "apple_ads",
                "ai"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Row status filter; default `new` (still-actionable)",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "tracked",
                "hidden",
                "all"
              ]
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Classification filter",
            "schema": {
              "type": "string",
              "enum": [
                "ranked",
                "gap",
                "idea"
              ]
            }
          },
          {
            "name": "min_relevance",
            "in": "query",
            "description": "Only rows with AI relevance ≥ this value (0-100)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_opportunity",
            "in": "query",
            "description": "Only rows with opportunity ≥ this value (0-100)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max rows (1-500, default 200)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ app_id, total, keywords: [{ id, keyword_id, keyword, store, country, rank, source, status, bucket, popularity, popularity_proxy, popularity_source, difficulty, ai_relevance, opportunity, discovered_at, ranks_checked_at }] }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "getAppsByIdDiscoveredKeywords"
      }
    },
    "/api/v1/apps/{id}/review-insights": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Latest AI review insight for a tracked app",
        "description": "The latest AI review analysis for a tracked app (your own or a competitor), per country: praise/complaint themes with verbatim quotes and trend movement (new/persisting/growing/improving/resolved), overall sentiment, feature requests, and the regeneration cooldown. `insight` is null when none has been generated. Requires the Indie plan.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sonar app UUID or store id of a tracked app",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Reviews market (ISO country code, default us)",
