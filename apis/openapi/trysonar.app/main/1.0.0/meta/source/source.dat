        "description": "Create a set from explicit layouts, a built-in template, or blank. Every set response carries a studio_url — humans can review/edit the same set in the dashboard. Requires the Indie plan and a write-scope API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id",
                  "store",
                  "device_size"
                ],
                "properties": {
                  "product_id": {
                    "type": "string"
                  },
                  "store": {
                    "type": "string",
                    "enum": [
                      "ios",
                      "android"
                    ]
                  },
                  "device_size": {
                    "type": "string",
                    "description": "Device id from GET /screenshots/devices"
                  },
                  "name": {
                    "type": "string"
                  },
                  "template_id": {
                    "type": "string",
                    "description": "Seed from a built-in template (mutually exclusive with screens)"
                  },
                  "screens": {
                    "type": "array",
                    "description": "1-10 layout documents, in order",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The full set incl. screens[] with ids",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Result payload — full field reference at https://trysonar.app/docs/api",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "validation_error — field-level layout validation messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "operationId": "postScreenshotsSets"
      }
    },
    "/api/v1/screenshots/sets/{id}": {
