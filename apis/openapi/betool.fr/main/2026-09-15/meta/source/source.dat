{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM Golden Gate API",
    "version": "2026-09-15",
    "description": "Unified, REST-style entrypoint of the CRM public API. See doc/specifications/api_datatable_golden_gate.md for the design rationale.",
    "contact": {
      "name": "betool"
    }
  },
  "servers": [
    {
      "url": "https://api.betool.fr",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/process/{id}/datatable": {
      "get": {
        "summary": "Retrieve datatable data and structure for a process",
        "operationId": "getProcessDatatable",
        "tags": [
          "Process"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProcessId"
          },
          {
            "$ref": "#/components/parameters/Archived"
          },
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenHeader"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Datatable structure and rows",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatatableResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/process/{id}/datatable/schema": {
      "get": {
        "summary": "Retrieve datatable structure only (no rows)",
        "operationId": "getProcessDatatableSchema",
        "tags": [
          "Process"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProcessId"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenHeader"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Datatable structure (without rows)",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatatableResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/process/{id}/records/{registerToken}": {
      "get": {
        "summary": "Retrieve a single process record",
        "description": "Returns the data of a single record (identified by `registerToken`) of a process.\n\nThe **response format depends on the profile configuration** carried by the `profileToken`:\n\n- **Flat format (default)** — `RecordResponse`: a `tags` map (`tag → string value`), filtered and optionally renamed according to the profile's customized tags.\n- **Hierarchical format** — `RecordHierarchicalResponse`: a structured payload (`data[]` widgets/tags grouped by application + `linkedData[]` related datatables), enabled when the profile has its \"hierarchical response\" option turned on. Same structure as the scenario POST hierarchical payload.\n\nThe format is chosen by the CRM administrator on the profile itself (it is **not** a request parameter). The `profileToken` is **mandatory** for this endpoint, unlike `/datatable` where it is optional.",
        "operationId": "getProcessRecord",
        "tags": [
          "Process"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProcessId"
          },
          {
            "$ref": "#/components/parameters/RegisterToken"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenHeader"
          },
          {
            "$ref": "#/components/parameters/ProfileTokenQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Record data. Either a flat tag map (RecordResponse) or a hierarchical payload (RecordHierarchicalResponse), depending on the profile's configured response format.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RecordResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RecordHierarchicalResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "`register_token_not_found`: the record does not exist, belongs to another process, or is outside the business-unit perimeter of the profile (a profile restricted to business units only serves records whose business unit is in its list; a record without business unit is not served). The same answer is returned in every case, so a record of another business unit cannot be told apart from a non-existent one.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`profile_configuration_inconsistent`: the profile restricts business units but the process no longer has a business-unit widget. The request itself is valid: the profile configuration must be updated in the CRM (remove the business-unit restriction or add the widget back).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/companies": {
      "get": {
        "summary": "List the companies of the organization",
        "description": "Paginated, filterable read of the companies belonging to the organization of the Bearer token. Filters combine as AND. A `companyName` match is partial and insensitive to case and accents; `email` is an exact match insensitive to case; `phone` compares after stripping spaces, dots, dashes and parentheses on both sides. An unknown `categoryId` yields an empty list (200), never 404 — no signal on category existence. There is NO `groupId` alias: it designates another concept in the CRM.\n\nX-Profile-Token is not used on this resource (organization-level, not process-level): the header is silently ignored.",
        "operationId": "listCompanies",
        "tags": [
          "Company"
        ],
        "parameters": [
          {
            "name": "companyName",
            "in": "query",
            "required": false,
            "description": "Partial match on the company name, case- and accent-insensitive. 2 to 100 characters, otherwise 400.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          },
          {
            "name": "companyCode",
            "in": "query",
            "required": false,
            "description": "Exact match on the company code (SIRET). At most 60 characters.",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Exact match on the company email, case-insensitive. At most 60 characters.",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "phone",
            "in": "query",
            "required": false,
            "description": "Match on the company phone after normalization (spaces, dots, dashes and parentheses stripped on both sides). At most 30 characters.",
            "schema": {
              "type": "string",
              "maxLength": 30
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "Focus category id. Positive integer; unknown id => 200 with an empty list.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size. Defaults to 100, capped at 500.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque pagination cursor from a previous response. Malformed => 400.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of companies.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Create a company",
        "description": "It is the ABSENCE of id in the path that makes this a creation (the update verb lives at POST /companies/{id}) — no verb in the URL, no PATCH, no upsert. The endpoint ALWAYS creates: there is no uniqueness constraint on companyCode nor email, and deduplication is the caller's job (documented integrator pattern: GET /companies?companyCode=X first, then POST /companies or POST /companies/{id}).\n\nValidation happens BEFORE the business logic: an over-wide field answers 400 invalid_parameter instead of the silent truncation the interactive front accepts. The phone is reformatted to E164 (Helper.getFormattedPhoneNumber) exactly like the front does. categories omitted or empty => the organization DEFAULT category is applied; categories ids must belong to the organization. creatorUserId: absent => the creation is carried by the organization MAIN ADMIN, with no warning (same default as [:TUSERCREAID] on /api/V1); unknown or foreign id => 201 with the main admin as creator and a warning (never a failure); organization with no active main admin => the technical user as a last resort, still 201.\n\nX-Profile-Token is not used on this resource: the header is silently ignored.",
        "operationId": "createCompany",
        "tags": [
          "Company"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Company created. The body carries the company RE-READ from the database (normalized phone, applied default category, retained creator), plus warnings.",
            "headers": {
              "Location": {
                "description": "URL of the created company: absolute when the public gateway host is configured, relative (/companies/{id}) otherwise.",
                "schema": {
                  "type": "string",
                  "example": "/companies/48213"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/companies/{id}": {
      "get": {
        "summary": "Retrieve one company",
        "description": "Unitary read of one company, enriched with its linked contacts. A company of another organization answers 404 (never 403): no cross-organization enumeration signal.\n\nX-Profile-Token is not used on this resource: the header is silently ignored.",
        "operationId": "getCompany",
        "tags": [
          "Company"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyId"
          }
        ],
        "responses": {
          "200": {
            "description": "The company, with its contactList.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyDetailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Partially update a company",
        "description": "The id in the PATH is the only thing that makes this an update (no verb in the URL, no PATCH). MERGE semantics: a field present in the body overwrites the stored value, an ABSENT field is left UNCHANGED, an explicitly NULL field ERASES it — except categories, where null is refused with 400 (the storage layer cannot erase categories).\n\ncategories, when present, replaces the whole set and every id must belong to the organization; when absent, the existing categories are kept untouched. creatorUserId is NOT modifiable on update and is silently ignored (changing the creator changes who SEES the company in the UI — that is a data-takeover, not a company update).\n\nA company of another organization answers 404 (never 403): no cross-organization enumeration signal. A company carried by a LOCKED process (read-only record) answers 423 company_locked.\n\nX-Profile-Token is not used on this resource: the header is silently ignored.",
        "operationId": "updateCompany",
        "tags": [
          "Company"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Company updated. The body carries the company RE-READ from the database, plus warnings (always empty on update).",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "423": {
            "$ref": "#/components/responses/Locked"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/operations/{operationId}": {
      "get": {
        "summary": "Read the progress of an async create/update operation",
        "description": "Async mode (SPEC section 5.9.3): when a create or update call was made with async=1 (or a callbackUrl, which implies it), the 202 answer hands back an operationId; this endpoint tells the integrator when the deferred document downloads landed and whether the automations fired.\n\nThe document URLs are never part of the payload (they can carry signed tokens): each entry exposes the tag it targets, its state, and either the written documentId or the error. An operation of another organization answers 404 (never 403), and so does an operation past its retention (7 days after completion).\n\nRecommended polling cadence: every 5 seconds, at most every 2 minutes; a callbackUrl saves the polling altogether. The signed callback pushes the very same payload.",
        "operationId": "getOperationStatus",
        "tags": [
          "Operations"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OperationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current state of the operation (pending while the tasker works, terminal afterwards).",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Response-Time": {
                "$ref": "#/components/headers/XResponseTime"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "orgApiToken issued for the organization. See organization.api_key."
      }
    },
    "parameters": {
      "ProcessId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Internal id of the process resource.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "RegisterToken": {
        "name": "registerToken",
        "in": "path",
        "required": true,
        "description": "Internal identifier of the record (process_filled row).",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "CompanyId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Internal id of the company (corporation).",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "OperationId": {
        "name": "operationId",
        "in": "path",
        "required": true,
        "description": "Identifier given back by the 202 answer of an async create/update call.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Archived": {
        "name": "archived",
        "in": "query",
        "required": false,
        "description": "false (default) returns active rows; true returns only archived rows.",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "Filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "Reserved. v1 validates the JSON syntax and ignores it semantically. Forwarded shape (flattened): { \"filters\": [Filter, ...] }. The internal CRM contract uses a nested filterSelectedArray wrapper — flattening is performed server-side.",
        "schema": {
          "type": "string"
        }
      },
      "ProfileTokenHeader": {
        "name": "X-Profile-Token",
        "in": "header",
        "required": false,
        "description": "Primary way to send the profile token. Identifies a profile configured on the process (customized tag map, optional renaming). Takes precedence over the `profileToken` query parameter when both are provided. Mandatory on endpoints that require a profile (e.g. `/process/{id}/records/{registerToken}`), optional on endpoints where the profile only customizes tags (e.g. `/process/{id}/datatable`).",
        "schema": {
          "type": "string"
        }
      },
      "ProfileTokenQuery": {
        "name": "profileToken",
        "in": "query",
        "required": false,
        "description": "Fallback for integration tools that cannot send custom headers. The `X-Profile-Token` header takes precedence if both are provided. Same semantics and requirements as the header version.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Unique identifier of the request, also returned in the response body. Use it when contacting support.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "XResponseTime": {
        "description": "Server-side processing duration in milliseconds.",
        "schema": {
          "type": "string",
          "example": "142ms"
        }
      },
      "XRateLimitLimit": {
        "description": "Maximum number of requests per minute for this endpoint and IP.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitRemaining": {
        "description": "Number of requests remaining in the current window.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitReset": {
        "description": "Unix epoch second (UTC) at which the bucket is expected to be fully refilled.",
        "schema": {
          "type": "integer"
        }
      },
      "XProfileToken": {
        "description": "Optional. Identifies a profile token (tag customization, future granular permissions).",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Company": {
        "type": "object",
        "description": "Public representation of a company. The same schema serves the list, the detail, and (later) the create/update responses. Internal fields (orgid, creatorUserId, sourceClientId, buid, bannerid, geocode, tag, comment, leadCreationTime) are never part of the payload.",
        "required": [
          "id",
          "categories"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 48213
          },
          "companyName": {
            "type": "string",
            "example": "DUPONT ET FILS"
          },
          "companyCode": {
            "type": "string",
            "example": "81234567800019",
            "description": "SIRET."
          },
          "activity": {
            "type": "string",
            "example": "Travaux de menuiserie"
          },
          "activityCode": {
            "type": "string",
            "example": "4332A",
            "description": "APE code."
          },
          "email": {
            "type": "string",
            "example": "contact@dupont.fr"
          },
          "phone": {
            "type": "string",
            "example": "0142000000"
          },
          "phoneCountry": {
            "type": "string",
            "example": "FR"
          },
          "address": {
            "type": "string",
            "example": "12 rue des Lilas"
          },
          "zip": {
            "type": "string",
            "example": "75011"
          },
          "city": {
            "type": "string",
            "example": "Paris"
          },
          "country": {
            "type": "string",
            "example": "FR"
          },
          "additionalInformation": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "example": [
              12
            ],
            "description": "Focus category ids of the company (empty array when none)."
          },
          "creationTime": {
            "type": "string",
            "format": "date-time",
            "example": "2025-03-14T09:12:00Z"
          },
          "contactList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "description": "Contacts linked to the company. Present in detail responses only — never in list responses."
          }
        }
      },
      "Contact": {
        "type": "object",
        "description": "Public representation of a contact linked to a company (detail responses).",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "firstname": {
            "type": "string",
            "example": "Jean"
          },
          "lastname": {
            "type": "string",
            "example": "Dupont"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "phoneCountry": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "mobileCountry": {
            "type": "string"
          },
          "roleIdInCorporation": {
            "type": "integer",
            "format": "int32"
          },
          "manager": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "CompanyListResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "companies",
          "pagination"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "companies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "limit",
          "returned",
          "nextCursor"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32",
            "example": 100
          },
          "returned": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque cursor of the NEXT page; non-null exactly when returned == limit. Null means the end is proven — ask once more on a full page to obtain an empty page."
          }
        }
      },
      "CompanyDetailResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "company"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          }
        }
      },
      "CompanyWriteRequest": {
        "type": "object",
        "description": "Body of POST /companies (creation) and POST /companies/{id} (partial update). Widths are the REAL corporation column widths — an over-wide field answers 400 invalid_parameter, the API never truncates silently. Field-by-field semantics differ per verb: on CREATE every present field is written and absent fields stay empty; on UPDATE a present field overwrites, an absent field is left unchanged, an explicit null ERASES. Unknown fields are ignored in silence.",
        "properties": {
          "companyName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "description": "REQUIRED and non-blank on create (1-128 chars). On update: absent = unchanged, a blank value = 400."
          },
          "companyCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60,
            "description": "SIRET. No uniqueness constraint: two creates with the same code yield two companies."
          },
          "activity": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 250
          },
          "activityCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 70,
            "description": "APE code."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60,
            "description": "Syntax-checked on both verbs."
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 45,
            "description": "Reformatted to E164 from phoneCountry (default FR) by the storage layer on EVERY write (create and update), like the front does. Consequence: on an update that omits the phone, the previously stored raw value comes back normalized in the response."
          },
          "phoneCountry": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2,
            "maxLength": 2,
            "description": "ISO-2 code. Default FR."
          },
          "address": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "zip": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 3
          },
          "additionalInformation": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "description": "Focus category ids, replacing the whole set when present; every id must belong to the organization (400 otherwise). null is REFUSED (400): the storage layer cannot erase categories. Absent on create => organization default category; absent on update => existing categories kept."
          },
          "creatorUserId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 1,
            "description": "CREATE only. Absent => creation carried by the organization MAIN ADMIN, no warning; unknown or foreign id => 201 with the org main admin as creator and a warning; no active main admin => technical user as a last resort. IGNORED on update."
          }
        }
      },
      "CompanyWriteResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "company",
          "warnings"
        ],
        "description": "Body of the 201 (create) and 200 (update) answers. The company is the object RE-READ from the database after the write — that is what makes visible the phone normalization, the default category and the creator actually retained.",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Structured warnings (e.g. \"creatorUserId : Data Error\" when the supplied creator could not be resolved). Always empty on update.",
            "example": [
              "creatorUserId : Data Error"
            ]
          }
        }
      },
      "DatatableResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generatedAt",
          "processId",
          "datatable",
          "requestId"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0",
            "description": "Serialization version of the payload itself (distinct from API contract version)."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-26T10:42:18Z"
          },
          "processId": {
            "type": "integer",
            "example": 4421
          },
          "datatable": {
            "$ref": "#/components/schemas/DatatableSection"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DatatableSection": {
        "type": "object",
        "required": [
          "id",
          "name",
          "structure"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 187
          },
          "name": {
            "type": "string",
            "example": "Devis ENR — Datatable"
          },
          "structure": {
            "type": "array",
            "description": "Column descriptors. Always begins with 4 reserved technical columns (creatorRegisterToken, processFilledId, processId, isLocked).",
            "items": {
              "$ref": "#/components/schemas/DatatableColumn"
            }
          },
          "rows": {
            "type": "array",
            "description": "Present on /datatable, absent on /datatable/schema. Each row is an object keyed by structure[].field. String cells are HTML-stripped before exposure.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "rowCount": {
            "type": "integer",
            "description": "Number of rows returned. Absent on /datatable/schema."
          }
        }
      },
      "OperationStatus": {
        "type": "object",
        "description": "Progress of an async create/update operation (SPEC section 5.9.3). This is the very payload the signed callback pushes — one format to analyze. completedAt is ABSENT while status is pending; callbackState appears only when a callbackUrl was given. The document URLs are never exposed.",
        "required": [
          "schemaVersion",
          "operationId",
          "operation",
          "status",
          "registerToken",
          "processId",
          "documents",
          "warning",
          "scenariosDispatched",
          "createdAt"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "example": "b1e7c4f0-9c2d-4b1e-8a5f-3d9a2f14e77a"
          },
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "update"
            ],
            "description": "Which API action produced the operation."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "success",
              "partial",
              "failed"
            ],
            "description": "partial = the record exists, at least one document failed."
          },
          "registerToken": {
            "type": "integer",
            "format": "int32",
            "example": 3145927
          },
          "processId": {
            "type": "integer",
            "format": "int32",
            "example": 4421
          },
          "documents": {
            "type": "array",
            "description": "One entry per deferred document URL, in download order.",
            "items": {
              "$ref": "#/components/schemas/OperationDocument"
            }
          },
          "warning": {
            "type": "string",
            "description": "Exactly the same format as the synchronous response's warning field."
          },
          "scenariosDispatched": {
            "type": "boolean",
            "description": "Whether the automations fired — they fire even when every document failed."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-10T09:12:00Z"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Set once the operation reached a terminal status; absent while pending.",
            "example": "2026-09-10T09:12:41Z"
          },
          "callbackState": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "failed"
            ],
            "description": "Delivery state of the signed callback. Present ONLY when a callbackUrl was given."
          }
        }
      },
      "OperationDocument": {
        "type": "object",
        "description": "One deferred document of the operation: the tag it targets, its state, and either the written document id or the error. The URL itself is never exposed (it can carry a signed token).",
        "properties": {
          "tag": {
            "type": "string",
            "description": "The question tag the URL answers.",
            "example": "[:Tf204901]"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "failed"
            ]
          },
          "documentId": {
            "type": "integer",
            "nullable": true,
            "description": "Written document id. Set when state is done, absent otherwise.",
            "example": 88213
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Short failure label. Set when state is failed, absent otherwise.",
            "example": "Download failed"
          }
        }
      },
      "RecordResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generatedAt",
          "processId",
          "registerToken",
          "tags",
          "requestId"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0",
            "description": "Serialization version of the payload itself (distinct from API contract version)."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-27T15:32:18Z"
          },
          "processId": {
            "type": "integer",
            "example": 4421
          },
          "registerToken": {
            "type": "integer",
            "example": 1346043
          },
          "tags": {
            "type": "object",
            "description": "Customized tag map. Keys are CRM tag identifiers (e.g. `[:TFOCUSNAME]`) — renamed via the profileToken's whitelist when configured. Values are always strings (the CRM-formatted value of the tag for this record).",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "[:TFOCUSNAME]": "BeTool Audits Energies",
              "[:TTRANSACTTOTTCLASTINV]": "250"
            }
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RecordHierarchicalResponse": {
        "type": "object",
        "description": "Hierarchical record payload, returned when the profile's response format is set to hierarchical. Same structure as the scenario POST hierarchical payload (HierarchicalJsonData).",
        "required": [
          "schemaVersion",
          "processId",
          "registerToken",
          "generatedAt",
          "data"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "processId": {
            "type": "integer",
            "example": 4421
          },
          "registerToken": {
            "type": "integer",
            "example": 1346043
          },
          "locale": {
            "type": "string",
            "example": "fr",
            "description": "Locale used to translate labels."
          },
          "deliveryId": {
            "type": "string",
            "description": "Unique trace id of this delivery (api-scoped for this endpoint)."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-27T15:32:18Z"
          },
          "data": {
            "type": "array",
            "description": "Application buckets, each holding widgets and their tags.",
            "items": {
              "$ref": "#/components/schemas/DataNode"
            }
          },
          "linkedData": {
            "type": "array",
            "description": "Related datatables (one entry per PROCESSINTEGRATED / PROCESSASSOCIATED widget). Omitted when the process has no linked widget.",
            "items": {
              "$ref": "#/components/schemas/LinkedDataNode"
            }
          },
          "documents": {
            "type": "array",
            "description": "Documents attached to this record. AT MOST ONE entry: the document widget is single-instance per process. Key ABSENT when the process has no document widget; present with count 0 and an empty items[] when the widget exists but holds no document. Scope is this record alone.",
            "items": {
              "$ref": "#/components/schemas/DocumentSection"
            }
          }
        }
      },
      "DataNode": {
        "type": "object",
        "description": "Application-level bucket (spec hierarchical §2.1).",
        "properties": {
          "appId": {
            "type": "integer",
            "description": "application.id (0 = virtual OTHER_SERVICE)."
          },
          "appTypeId": {
            "type": "integer",
            "description": "ApplicationTypeEnum.typeId (0=APPLICATION, 1=PLUGIN, 2=SERVICE)."
          },
          "appTypeLabel": {
            "type": "string",
            "description": "application / plugin / service — NOT translated (stable)."
          },
          "appKeyLabel": {
            "type": "string",
            "description": "application.keyLabel — stable technical identifier."
          },
          "appLabel": {
            "type": "string",
            "description": "Localized application name."
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WidgetNode"
            }
          }
        }
      },
      "WidgetNode": {
        "type": "object",
        "description": "Widget-level node (process_object_type instance, spec hierarchical §2.2).",
        "properties": {
          "typeId": {
            "type": "integer",
            "description": "process_object_type.id (0 = virtual NO_WIDGET)."
          },
          "typeKey": {
            "type": "string",
            "description": "Stable technical identifier (e.g. calendar, form, NO_WIDGET). Use for type-based logic."
          },
          "typeLabel": {
            "type": "string",
            "description": "Translated label for display (e.g. Calendrier, Formulaire)."
          },
          "groupId": {
            "type": "integer",
            "description": "Widget instance id (0 = virtual NO_WIDGET)."
          },
          "label": {
            "type": "string",
            "description": "Multi-instance discriminant, translated when relevant."
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagNode"
            }
          }
        }
      },
      "TagNode": {
        "type": "object",
        "description": "Single-value tag (spec hierarchical §2.3).",
        "properties": {
          "tag": {
            "type": "string",
            "description": "Canonical tag form, with groupId in the standard case.",
            "example": "[:T7TRANSACTQ]"
          },
          "tagShort": {
            "type": "string",
            "nullable": true,
            "description": "Form without groupId, or null when not applicable."
          },
          "label": {
            "type": "string",
            "description": "Localized label (or admin-typed free text)."
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int",
              "number",
              "date",
              "datetime",
              "timestamp",
              "title",
              "tokenOrder"
            ]
          },
          "value": {
            "type": "string",
            "description": "CRM-formatted string value (bit-identical to the flat format)."
          },
          "valueParsed": {
            "description": "Typed JSON value (string / number / boolean / null depending on type)."
          }
        }
      },
      "DocumentSection": {
        "type": "object",
        "description": "Documents of one document widget (typeId=24). Mirrors linkedData: the widget appears in data[].widgets[] with an empty tags[], its payload lives here, typeId/groupId are the back-links.",
        "properties": {
          "typeId": {
            "type": "integer",
            "description": "Back-link to the widget typeId. Always 24."
          },
          "groupId": {
            "type": "integer",
            "description": "Back-link to the widget groupId."
          },
          "label": {
            "type": "string",
            "description": "Label of the document widget."
          },
          "count": {
            "type": "integer",
            "description": "Number of entries in items[]."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentItem"
            }
          }
        }
      },
      "DocumentItem": {
        "type": "object",
        "description": "One document attached to the record. Carries NO storage coordinate: physical path, physical file name and bucket are never exposed; the token travels only inside downloadUrl.",
        "properties": {
          "documentId": {
            "type": "integer",
            "description": "Internal document id."
          },
          "name": {
            "type": "string",
            "description": "Display name, e.g. \"Attestation fin de travaux.pdf\"."
          },
          "mimeType": {
            "type": "string",
            "description": "e.g. application/pdf."
          },
          "extension": {
            "type": "string",
            "description": "e.g. pdf."
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size in bytes."
          },
          "pageCount": {
            "type": "integer",
            "description": "0 when unknown."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC."
          },
          "templateId": {
            "type": "integer",
            "description": "Template the document originates from. 0 = free upload."
          },
          "storage": {
            "type": "string",
            "enum": [
              "server",
              "googleDrive"
            ],
            "description": "server = downloadable through downloadUrl. googleDrive = the file lives on the customer Google Drive; downloadUrl carries the Drive link as is and needs the customer Google credentials."
          },
          "signature": {
            "description": "E-sign state, or null when the document is in no signing circuit.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/DocumentSignature"
              },
              {
                "type": "null"
              }
            ]
          },
          "downloadUrl": {
            "type": "string",
            "description": "Absolute download URL. For storage=server: our permanent, non-revocable link, token only, no storage path, no authentication header needed. For storage=googleDrive: the customer Drive link as is, which requires their Google credentials. MAY BE AN EMPTY STRING on a Drive document that carries no link — such documents are published anyway rather than hidden."
          }
        }
      },
      "DocumentSignature": {
        "type": "object",
        "description": "E-sign state of a document. Signer identity (name, email, phone) is deliberately NOT exposed.",
        "properties": {
          "status": {
            "type": "integer",
            "description": "E-sign status code."
          },
          "signType": {
            "type": "integer",
            "description": "Signature type code."
          },
          "planName": {
            "type": "string",
            "description": "Name of the signing plan."
          },
          "planStatus": {
            "type": "integer",
            "description": "Signing plan status code."
          },
          "signedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "ISO 8601 UTC, null while not signed."
          }
        }
      },
      "LinkedDataNode": {
        "type": "object",
        "description": "One linked datatable (PROCESSINTEGRATED typeId=23 / PROCESSASSOCIATED typeId=38).",
        "properties": {
          "typeId": {
            "type": "integer",
            "description": "Back-link to the widget typeId (23 or 38)."
          },
          "groupId": {
            "type": "integer",
            "description": "Back-link to the widget groupId."
          },
          "linkedProcessId": {
            "type": "integer",
            "description": "Id of the process pointed to by this widget."
          },
          "linkedProcessName": {
            "type": "string",
            "description": "Name of the pointed process."
          },
          "rowCount": {
            "type": "integer",
            "description": "Number of linked rows."
          },
          "structure": {
            "type": "array",
            "description": "Column descriptors (same shape as the datatable structure).",
            "items": {
              "$ref": "#/components/schemas/DatatableColumn"
            }
          },
          "rows": {
            "type": "array",
            "description": "Each row is an object keyed by structure[].field. String cells are HTML-stripped.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "DatatableColumn": {
        "type": "object",
        "required": [
          "field",
          "name",
          "type"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Stable identifier (colOrder string) used as the key in rows[].",
            "example": "1"
          },
          "name": {
            "type": "string",
            "description": "Display name. Raw column name in v1 (not translated).",
            "example": "Client name"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int",
              "number",
              "date",
              "datetime",
              "timestamp",
              "title",
              "tokenOrder"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "invalid_request",
              "authentication_error",
              "permission_error",
              "rate_limit_error",
              "not_found",
              "server_error"
            ]
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code, see GatewayErrorCodes."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          },
          "param": {
            "type": "string",
            "description": "When applicable, the parameter that caused the error."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional structured context (e.g., rowCount / limit / overflow for row_limit_exceeded)."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request (invalid filter, invalid path...).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid orgApiToken / profileToken.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not allowed (profile/process mismatch...).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Datatable exceeds the authorized row limit (25 000).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BodyTooLarge": {
        "description": "Request body exceeds 256 KiB (code payload_too_large).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type is not application/json (code unsupported_media_type).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Locked": {
        "description": "The company is carried by a locked (read-only) process (code company_locked).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}