          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Select A/B Test Winner",
        "tags": [
          "Sequences"
        ],
        "description": "Selects the winning variant of the A/B test. The winning template is then sent to all remaining leads going through the campaign. Requires the Email Pro plan.",
        "parameters": [],
