            "description": "Possible errors: An identifier (email, linkedinUrl or salesnavUrl) already belongs to another contact [duplicate-forbidden] / Lead already in the campaign [already-in]",
            "content": {
              "application/json": {
                "example": {
                  "error": "An identifier (email, linkedinUrl or salesnavUrl) already belongs to another contact [duplicate-forbidden]"
                }
              }
            }
          }
        }
      }
    },
    "/leads/audio": {
      "post": {
