                    "teamId": "tea_Sh11ph1qHfjSpLKGT",
                    "campaignId": "cam_R9mwDo0iZRwNEHUcW",
                    "leadId": "lea_jZKIJ1Jn1SaMsP83s",
                    "fileName": "file2"
