                      "type": "boolean"
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "teamId": {
                          "type": "string"
                        },
                        "campaignId": {
                          "type": "string"
                        },
                        "leadId": {
                          "type": "string"
                        },
                        "fileName": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "status": {
