                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_ERROR` - a filter cap or a bad `page` / `limit` or a malformed `snippetId` (`WRONG_PARAM_ID`) (JSON body), or no API key was supplied (plain text).",
            "content": {
              "application/json": {
                "example": {
                  "error": "Validation error",
                  "code": "VALIDATION_ERROR"
                }
              },
              "text/plain": {
                "example": "no api key provided"
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key (plain text), or an API key with no linked user (JSON body carrying `ROUTE_UNAUTHORIZED`).",
            "content": {
              "text/plain": {
                "example": "The authentication you supplied is incorrect"
              },
              "application/json": {
                "example": {
                  "error": "Route unauthorized",
                  "code": "ROUTE_UNAUTHORIZED"
                }
              }
            }
          },
          "404": {
            "description": "`SNIPPET_NOT_FOUND` - the snippet does not exist in this workspace. A deleted snippet and another workspace's snippet both answer this.",
            "content": {
              "application/json": {
                "example": {
                  "error": "Snippet not found",
                  "code": "SNIPPET_NOT_FOUND"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed - this endpoint only accepts GET"
          },
          "429": {
            "description": "Rate limit exceeded - 20 requests per 2 seconds per API key"
          }
        }
      }
    },
