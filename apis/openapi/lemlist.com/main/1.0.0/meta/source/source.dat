    "/campaigns/{campaignId}/leads/{leadId}": {
      "parameters": [
        {
          "name": "campaignId",
          "in": "path",
          "required": true,
          "description": "The unique identifier of the campaign",
          "example": "cam_A1B2C3D4E5F6G7H8I9",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "leadId",
          "in": "path",
          "required": true,
          "description": "The unique identifier of the lead",
          "example": "lea_8xJSc7sV7ggpiVnXe",
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Update Lead in a Campaign",
        "tags": [
          "Leads"
        ],
        "description": "Updates an existing lead and, through it, the contact and the company the lead is linked to: contact fields such as `firstName` or `jobTitle` are written on the contact, company fields such as `companyName` on the company. Only the fields in the body change. `companyName` alone renames the company the lead is linked to. When the lead has no company yet, it gets linked to a company with that name, created when needed.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "companyName": {
                    "type": "string",
                    "description": "New name of the company the lead is linked to, renamed in place. When the lead has no company yet, it gets linked to a company with that name, created when needed."
                  },
                  "jobTitle": {
                    "type": "string"
                  },
                  "preferredContactMethod": {
                    "type": "string",
                    "description": "Preferred contact method (email, linkedIn)"
                  }
                }
              },
              "example": {
                "preferredContactMethod": "email"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaignId": {
                      "type": "string"
                    },
                    "campaignName": {
                      "type": "string"
                    },
                    "leadUrl": {
                      "type": "string",
                      "description": "URL to access the lead"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "firstName": {
                      "type": "string"
                    },
                    "lastName": {
                      "type": "string"
                    },
                    "companyName": {
                      "type": "string"
                    },
                    "jobTitle": {
                      "type": "string"
                    },
                    "companyDomain": {
                      "type": "string"
                    },
                    "preferredContactMethod": {
                      "type": "string"
                    },
                    "_id": {
                      "type": "string"
                    },
                    "isPaused": {
                      "type": "boolean",
                      "description": "Whether the lead is paused in the campaign"
                    },
                    "contactId": {
                      "type": "string",
                      "description": "Associated contact ID"
                    },
                    "emailStatus": {
                      "type": "string",
                      "description": "Email verification status"
                    },
                    "warnings": {
                      "type": "array",
                      "description": "Non-blocking notices: the company part was skipped, or `FIELDS_KEPT` when the update strategy kept values you sent (`params.fields` names them, company fields prefixed with `company`).",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "`invalid-company-domain`, `invalid-company-linkedin-url`, `company-linkedin-url-not-company` (the company part was skipped: malformed identifier, or a personal profile URL), `company-duplicate-forbidden` (an identifier already belongs to another company), `company-update-failed` (the company write failed); `FIELDS_KEPT` (values the update strategy kept, see `params.fields`)."
                          },
                          "message": {
                            "type": "string"
                          },
                          "params": {
                            "type": "object",
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "description": "Details: the input echoed back, or `fields` for `FIELDS_KEPT`."
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "campaignId": "cam_bSn8EORHQxbWPjHvu",
                  "campaignName": "NEW TO DELETE",
                  "leadUrl": "https://api.lemlist.com/api/leads/alex.doe%40example.com",
                  "firstName": "John",
                  "lastName": "Doe",
                  "companyName": "Acme Inc",
                  "jobTitle": "Growth Engineer",
                  "companyDomain": "example.com",
                  "email": "support@lemlist.com",
                  "preferredContactMethod": "email",
                  "_id": "lea_fiDpiGV585wy3Oii2",
                  "isPaused": false,
                  "contactId": "ctc_xW8Ou6C03Csv8vatp",
                  "emailStatus": "deliverable"
                }
              }
            }
          },
          "400": {
            "description": "Possible errors: Bad team / Body of your request must be an object / Invalid email address / Invalid LinkedIn URL / LinkedIn URL is not a personal profile / Lead could not be updated / Invalid updateStrategy value",
            "content": {
              "text/plain": {
                "example": "Bad team"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Possible errors: Lead not found / Campaign not found / Campaign deleted / Contact owner not found: neither a valid email nor a valid user id.",
            "content": {
              "text/plain": {
                "example": "Lead not found"
              }
            }
          },
          "409": {
            "description": "Possible errors: An identifier (email, linkedinUrl or salesnavUrl) already belongs to another contact / Lead already in the campaign",
            "content": {
              "text/plain": {
                "example": "An identifier (email, linkedinUrl or salesnavUrl) already belongs to another contact"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "updateStrategy",
            "in": "query",
            "required": false,
            "description": "What the lead, its contact and its company keep. `overwrite` (default): sent values replace stored ones, an empty string clears. `overwriteIgnoreEmpty`: empty values ignored. `fillEmptyOnly`: only empty fields filled, identifiers, links, owner and status kept. Other values: 400.",
            "example": "fillEmptyOnly",
            "schema": {
              "type": "string",
              "enum": [
                "overwrite",
                "overwriteIgnoreEmpty",
                "fillEmptyOnly"
              ],
              "default": "overwrite"
            }
          }
        ]
      },
