      "get": {
        "summary": "Get A/B Test Variant",
        "tags": [
          "Sequences"
        ],
        "description": "Returns variant B (subject, message, config) of the A/B test on a step. Requires the Email Pro plan.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stepId": {
                      "type": "string"
                    },
                    "abTest": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "A",
                            "B"
                          ]
                        }
                      ]
                    },
                    "emailTemplateBId": {
                      "type": "string",
                      "description": "Email template ID of variant B"
                    },
                    "subject": {
                      "type": "string",
                      "description": "Variant B subject"
                    },
                    "message": {
                      "type": "string",
                      "description": "Variant B body (HTML)"
                    },
                    "altMessage": {
                      "type": "string",
                      "description": "Variant B's LinkedIn note, same meaning as the step-level `altMessage`: the premium invitation note on a `linkedinInvite` step, the out-of-network note on a `linkedinSend` one"
                    },
                    "altMessagePremium": {
                      "type": "string",
                      "description": "Variant B's premium variant of the out-of-network note, on `linkedinSend` steps only"
