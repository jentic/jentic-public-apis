    "/enrich": {
      "post": {
        "summary": "Enrich Data",
        "tags": [
          "Enrich"
        ],
        "parameters": [
          {
            "name": "findEmail",
            "in": "query",
            "required": false,
            "description": "Find verified email",
            "example": "true",
