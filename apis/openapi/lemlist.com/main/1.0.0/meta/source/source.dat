                  "code": "SEQUENCE_STEP_NOT_FOUND"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "example": {
                  "error": "Bad method"
                }
              }
            }
          }
        }
