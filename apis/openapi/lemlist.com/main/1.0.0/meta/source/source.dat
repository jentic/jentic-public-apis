      "patch": {
        "summary": "Update A/B Test Variant",
        "tags": [
          "Sequences"
        ],
        "description": "Edits variant B content/config of the A/B test on a step. Only the provided fields are updated; unknown fields are rejected. Allowed while the campaign is running. Requires the Email Pro plan.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "Variant B subject"
                  },
                  "message": {
                    "type": "string",
                    "description": "Variant B body (HTML). An empty string is rejected, except on LinkedIn invite steps where it means \"invite without a note\""
                  },
                  "altMessage": {
                    "type": "string",
                    "description": "Variant B's LinkedIn note, same meaning as the step-level `altMessage`: the premium invitation note on a `linkedinInvite` step, the out-of-network note on a `linkedinSend` one. On a `linkedinInvite` step, over 300 characters is rejected with `400`"
                  },
                  "altMessagePremium": {
                    "type": "string",
                    "description": "Variant B's premium variant of the out-of-network note, on `linkedinSend` steps only: any other step type is rejected with `400`. Over 300 characters is rejected with `400` too"
                  },
                  "cc": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "plainText": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "subject": "New subject B",
                "message": "<div>New body B</div>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Variant B updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stepId": {
                      "type": "string"
                    },
                    "abTest": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "A",
                            "B"
                          ]
                        }
                      ]
                    },
                    "emailTemplateBId": {
                      "type": "string",
                      "description": "Email template ID of variant B"
                    },
                    "subject": {
                      "type": "string",
                      "description": "Variant B subject"
                    },
                    "message": {
                      "type": "string",
                      "description": "Variant B body (HTML)"
                    },
                    "altMessage": {
                      "type": "string",
                      "description": "Variant B's LinkedIn note, same meaning as the step-level `altMessage`: the premium invitation note on a `linkedinInvite` step, the out-of-network note on a `linkedinSend` one"
                    },
                    "altMessagePremium": {
                      "type": "string",
                      "description": "Variant B's premium variant of the out-of-network note, on `linkedinSend` steps only"
                    },
                    "cc": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "plainText": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "stepId": "stp_V0JHmSpWiO0rxHUkz",
                  "abTest": true,
                  "emailTemplateBId": "etp_9aZ2k1QwErTyUiOp3",
                  "subject": "Quick question, {{firstName}}",
                  "message": "<div>Hi {{firstName}}, ...</div>"
                }
              }
            }
          },
          "400": {
            "description": "Bad request: invalid or unknown body field, empty message on a step other than a LinkedIn invite, an `altMessage` over 300 characters on a LinkedIn invite step, an `altMessagePremium` on a step other than a LinkedIn message, or an `altMessagePremium` over 300 characters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Human-readable error message"
                    },
                    "code": {
                      "type": "string",
                      "description": "Machine-readable error code"
                    }
                  }
                },
                "example": {
                  "error": "The premium invitation note must not exceed 300 characters",
                  "code": "SEQUENCE_AB_ALT_MESSAGE_TOO_LONG"
                }
              }
            }
          },
          "401": {
            "description": "The authentication you supplied is incorrect",
            "content": {
              "text/plain": {
                "example": "The authentication you supplied is incorrect"
              }
            }
          },
          "402": {
            "description": "A/B testing requires at least the Email Pro plan",
            "content": {
              "text/plain": {
                "example": "route is available starting emailPro plan"
              }
            }
          },
          "404": {
            "description": "Sequence, step, or A/B test variant not found",
