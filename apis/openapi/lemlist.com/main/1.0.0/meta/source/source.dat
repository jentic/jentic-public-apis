                      "type": "string",
                      "description": "The unique identifier of the export"
                    },
                    "id": {
                      "type": "string",
                      "description": "The unique identifier of the export (same as _id)"
                    },
                    "teamId": {
                      "type": "string",
                      "description": "The team identifier"
                    },
                    "campaignId": {
                      "type": "string",
                      "description": "The campaign identifier"
                    },
