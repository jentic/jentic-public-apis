                      "description": "Type of current progress step"
                    },
                    "progress": {
                      "type": "integer",
                      "description": "Number of items processed"
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of items to process"
                    }
                  }
                },
                "example": {
                  "_id": "axp_Vv6lJOc8NlVVmDud5",
                  "id": "axp_Vv6lJOc8NlVVmDud5",
                  "teamId": "tea_c123fg5h8ijKL9noP",
