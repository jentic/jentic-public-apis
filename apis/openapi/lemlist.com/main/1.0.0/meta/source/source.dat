            },
            "example": "1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of records to retrieve. Maximum value: 100",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "example": "50"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
