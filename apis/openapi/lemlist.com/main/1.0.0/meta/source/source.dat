                      "type": "string",
                      "format": "date-time",
                      "description": "When the export was started"
                    },
                    "progressIndex": {
                      "type": "integer",
                      "description": "Current progress index"
                    },
                    "progressTime": {
                      "type": "integer",
                      "description": "Timestamp of progress"
                    },
                    "progressLastStepDuration": {
                      "type": "integer",
                      "description": "Duration of last step in milliseconds"
                    },
