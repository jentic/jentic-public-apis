                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      },
      "patch": {
        "summary": "Update an agent",
        "description": "Update any subset of the agent's attributes. Accepts the same fields as create; omitted fields are left unchanged.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "cadence": {
                    "type": "string",
                    "enum": ["manual", "hourly", "daily", "weekdays", "weekly"]
                  },
                  "hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "minute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 59
                  },
                  "day_of_week": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "handles_file_drops": {
                    "type": "boolean"
                  },
                  "delivery_enabled": {
                    "type": "boolean"
                  },
                  "delivery_recipients": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "delivery_file_pattern": {
                    "type": "string"
                  },
                  "mentions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["type", "id", "label"],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["reconciliation", "data_stream", "user", "agent"]
                        },
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent not found"
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "delete": {
        "summary": "Delete an agent",
        "description": "Deletes the agent and all of its runs, including their transcripts and files.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          }
        ],
        "responses": {
          "204": {
            "description": "Agent deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    },
    "/agents/{id}/runs": {
      "get": {
        "summary": "List an agent's runs",
        "description": "Returns a paginated list of the agent's runs, newest first. Transcripts are omitted — fetch a single run to get its transcript.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from a previous response's `next_cursor`. Omit for the first page."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AgentRun"
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true,
                      "description": "Opaque cursor for the next page. Null when no more pages."
                    },
                    "limit": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      },
      "post": {
        "summary": "Run an agent",
        "description": "Triggers a run of the agent immediately, regardless of its cadence or active flag. The run is created `pending` and executed asynchronously — poll `GET /agents/{id}/runs/{run_id}` for status, summary, and output files. Unlike the rest of the agent-management surface, this endpoint also accepts a run's session key, letting one agent kick off another (`triggered_by: agent`); those requests are refused with 422 when they would loop — the target agent already ran in the trigger chain — or chain more than 5 runs deep.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          }
        ],
        "responses": {
          "201": {
            "description": "Run created and queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent not found"
          },
          "422": {
            "description": "Refused agent-to-agent trigger — the run would create a loop or chain more than 5 runs deep"
          }
        }
      }
    },
    "/agents/{id}/runs/{run_id}": {
      "get": {
        "summary": "Retrieve a run",
        "description": "Returns one run including its full event transcript.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          },
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the run"
          }
        ],
        "responses": {
          "200": {
            "description": "Run retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Agent or run not found"
          }
        }
      }
    },
    "/agents/{id}/files": {
      "post": {
        "summary": "Attach an input file",
        "description": "Attaches one file to the agent's input files — the same files the app's agent form manages under \"Files\". Every run lists the agent's input files in its prompt and can download them, so this is how to hand an agent a mapping table, a prior statement, or any reference material. Send `multipart/form-data` with a single `file` part; call once per file. Limits match the app: 50 MB per file, 20 files per agent, any content type (JSON is fine as an input). A file whose name matches an existing input file is added as a second file, not a replacement — delete the old one first to replace it.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to attach (at most 50 MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File attached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentFile"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden — agent management requires a standard API key"
          },
          "404": {
            "description": "Agent not found"
          },
          "422": {
            "description": "No `file` part, file over 50 MB, or the agent already has 20 input files"
          }
        }
      }
    },
    "/agents/{id}/files/{file_id}": {
      "get": {
        "summary": "Download an input file",
        "description": "Redirects (302) to a short-lived signed URL for the file's bytes; follow the redirect to download. This is the API-key-authenticated way to fetch an input file. The `url` on the file object reaches the same bytes through a signed link that needs no credentials.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          },
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The `id` of the file from the agent's `input_files`"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the signed download URL"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden — agent management requires a standard API key"
          },
          "404": {
            "description": "Agent not found, or the file is not one of this agent's input files"
          }
        }
      },
      "delete": {
        "summary": "Remove an input file",
        "description": "Detaches and deletes one of the agent's input files. Runs already in progress keep the copy they downloaded; later runs no longer see the file.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the agent"
          },
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The `id` of the file from the agent's `input_files`"
          }
        ],
        "responses": {
          "204": {
            "description": "File removed"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden — agent management requires a standard API key"
          },
          "404": {
            "description": "Agent not found, or the file is not one of this agent's input files"
          }
        }
      }
    }
  }
}
