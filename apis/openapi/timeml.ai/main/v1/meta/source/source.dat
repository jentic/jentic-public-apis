{"openapi":"3.1.0","info":{"title":"Time Machine External API","description":"Public REST API for tenant admin integrations","version":"v1"},"servers":[{"url":"https://api.timeml.ai","description":"Generated server url"}],"security":[{"ApiKeyAuth":[]}],"tags":[{"name":"Exercises","description":"Create, edit and delete topic exercises (ILE_TEXT / RPE_VOICE / RPE_VIDEO)"},{"name":"Course Modules","description":"Create, edit, reorder and delete modules inside a course"},{"name":"Intros","description":"Module/topic introduction text — short narrative shown before content"},{"name":"Course Topics","description":"Create, edit, reorder, move and delete topics inside a module"},{"name":"Demo Trainings","description":"Manage demo and application training videos and assignments via the public REST API"},{"name":"Documents","description":"Manage company documents via the public REST API"},{"name":"Certificates","description":"Read certificates earned by students and download their PDF files"},{"name":"Insights","description":"Read-only company learning insights via the public REST API"},{"name":"Departments","description":"Manage company departments and role assignments via the public REST API"},{"name":"Users","description":"Manage company users (team members) via the public REST API"},{"name":"Quiz Questions","description":"Quiz questions attached to a module or topic (separate from in-lesson questions)"},{"name":"Learning Bytes","description":"Create, edit and delete learning bytes (groupings of lessons) inside a topic"},{"name":"Course Versions","description":"Read published course versions and their content snapshots via the public REST API"},{"name":"Lesson Questions","description":"In-lesson knowledge-check questions (MULTIPLE_CHOICE, OPEN_ENDED, FILL_IN_THE_BLANKS or MATCH_THE_BLOCKS). Quiz questions on modules/topics are exposed separately"},{"name":"Courses","description":"Manage company courses lifecycle via the public REST API"},{"name":"Experts","description":"Manage company AI experts and ask synchronous questions via the public REST API"},{"name":"Topic Documents","description":"Link and unlink company documents to/from a topic"},{"name":"Lessons","description":"Create, edit and delete lessons inside a learning byte"},{"name":"Company exercises","description":"Exercises that live on the Exercises page rather than inside a course topic"},{"name":"Media","description":"Manage company media (images, videos) via the public REST API"},{"name":"Exercise catalogues","description":"The values accepted by avatarName, salesPhase and scenarioKey when creating an exercise"}],"paths":{"/api/v1/topics/{topicId}/quiz-settings":{"put":{"tags":["Course Topics"],"summary":"Set topic quiz count for one question type","description":"Replaces the count for the given questionType. Other types' counts are preserved","operationId":"setTopicQuizSettings","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQuizSettingsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicDto"}}}}}}},"/api/v1/topics/{topicId}/knowledge-base":{"get":{"tags":["topic-knowledge-base-rest-controller"],"summary":"Get topic knowledge base","description":"Returns the aggregated knowledge base for a topic (content, sources, verification state).","operationId":"getTopicKnowledgeBase","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicKnowledgeBaseDetailDto"}}}}}},"put":{"tags":["topic-knowledge-base-rest-controller"],"summary":"Update topic knowledge base content","description":"Replace the manually-edited content of the topic knowledge base. Sets isManuallyEdited=true.","operationId":"updateTopicKnowledgeBase","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTopicKnowledgeBaseRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicKnowledgeBaseDetailDto"}}}}}}},"/api/v1/topics/{topicId}/intro":{"get":{"tags":["Intros"],"summary":"Get a topic intro","description":"Returns the intro text set on the given topic.","operationId":"getTopicIntro","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntroDto"}}}}}},"put":{"tags":["Intros"],"summary":"Set or replace a topic intro","description":"Upsert — creates if missing, replaces if present","operationId":"setTopicIntro","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateIntroRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntroDto"}}}}}},"delete":{"tags":["Intros"],"summary":"Remove a topic intro","description":"Idempotent — 204 even if no intro is set","operationId":"removeTopicIntro","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}}},"/api/v1/modules/{moduleId}/quiz-settings":{"put":{"tags":["Course Modules"],"summary":"Set module quiz count for one question type","description":"Replaces the count for the given questionType. Other types' counts are preserved","operationId":"setModuleQuizSettings","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQuizSettingsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ModuleDetailDto"}}}}}}},"/api/v1/modules/{moduleId}/intro":{"get":{"tags":["Intros"],"summary":"Get a module intro","description":"Returns the intro text set on the given module.","operationId":"getModuleIntro","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntroDto"}}}}}},"put":{"tags":["Intros"],"summary":"Set or replace a module intro","description":"Upsert — creates if missing, replaces if present","operationId":"setModuleIntro","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateIntroRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntroDto"}}}}}},"delete":{"tags":["Intros"],"summary":"Remove a module intro","description":"Idempotent — 204 even if no intro is set","operationId":"removeModuleIntro","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}}},"/api/v1/media/{id}":{"get":{"tags":["Media"],"summary":"Get a media item","description":"Returns media metadata and a download URL","operationId":"getMediaItem","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediaDetailDto"}}}}}},"put":{"tags":["Media"],"summary":"Replace media binary","description":"Replaces the file binary of an existing media item in place; metadata is preserved","operationId":"replaceMediaFile","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediaDetailDto"}}}}}},"delete":{"tags":["Media"],"summary":"Delete (deactivate) a media item","description":"Idempotent — returns 204 even if the item is already deleted or missing","operationId":"deleteMedia","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}},"patch":{"tags":["Media"],"summary":"Update media metadata","description":"Update name and/or description","operationId":"updateMediaMetadata","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MediaPatchRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediaDetailDto"}}}}}}},"/api/v1/exercises/{id}/roles":{"put":{"tags":["Company exercises"],"summary":"Set the roles a company exercise is assigned to","operationId":"setCompanyExerciseRoles","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetExerciseRolesRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/documents/{id}":{"get":{"tags":["Documents"],"summary":"Get a document","description":"Returns document metadata and a download URL","operationId":"getDocument","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentDetailDto"}}}}}},"put":{"tags":["Documents"],"summary":"Replace document binary","description":"Replaces the file binary of an existing document; metadata is preserved","operationId":"replaceDocumentFile","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentDetailDto"}}}}}},"delete":{"tags":["Documents"],"summary":"Delete (deactivate) a document","description":"Idempotent — returns 204 even if the document is already deleted or missing","operationId":"deleteDocument","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}},"patch":{"tags":["Documents"],"summary":"Update document metadata","description":"Update name and/or description","operationId":"updateDocumentMetadata","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentPatchRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentDetailDto"}}}}}}},"/api/v1/users":{"get":{"tags":["Users"],"summary":"List users","description":"Paginated list of users in the caller's company. Without a status filter the list holds active members and invitations that have not been accepted yet, matching what the admin UI shows. Deactivated members are returned only on request.","operationId":"listUsers","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"search","in":"query","required":false,"schema":{"type":"string"}},{"name":"status","in":"query","description":"Narrows the list to one population. Omit for active members plus not-yet-accepted invitations.","required":false,"schema":{"type":"string","enum":["active","invited","deactivated","all"]}},{"name":"departmentIds","in":"query","required":false,"schema":{"type":"string"}},{"name":"roleIds","in":"query","required":false,"schema":{"type":"string"}},{"name":"kind","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserListResponse"}}}}}},"post":{"tags":["Users"],"summary":"Create a user","description":"Creates a user and triggers the magic-link invitation flow","operationId":"createUser","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserCreateRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserDto"}}}}}}},"/api/v1/users/{id}/reactivate":{"post":{"tags":["Users"],"summary":"Reactivate a user","description":"Idempotent — returns the user even if already active","operationId":"reactivateUser","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserDto"}}}}}}},"/api/v1/users/{id}/deactivate":{"post":{"tags":["Users"],"summary":"Deactivate a user","description":"Idempotent — returns the user even if already deactivated","operationId":"deactivateUser","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserDto"}}}}}}},"/api/v1/topics/{topicId}/quiz-questions":{"get":{"tags":["Quiz Questions"],"summary":"List quiz questions on a topic","description":"Returns quiz questions attached to the given topic.","operationId":"listTopicQuizQuestions","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}},"post":{"tags":["Quiz Questions"],"summary":"Add a quiz question to a topic","description":"Creates a new quiz question inside the given topic.","operationId":"addTopicQuizQuestion","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQuestionRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionDto"}}}}}}},"/api/v1/topics/{topicId}/quiz-questions/reorder":{"post":{"tags":["Quiz Questions"],"summary":"Reorder quiz questions on a topic","description":"questionIds must include every active quiz question for the topic, in the new order.","operationId":"reorderTopicQuizQuestions","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderQuestionsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}}},"/api/v1/topics/{topicId}/move":{"post":{"tags":["Course Topics"],"summary":"Move a topic to another module","description":"targetOrdinalNumber is optional; if omitted the topic is appended to the target module","operationId":"moveTopic","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MoveTopicRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicDto"}}}}}}},"/api/v1/topics/{topicId}/linked-documents":{"get":{"tags":["Topic Documents"],"summary":"List documents linked to a topic","description":"Paginated; optional search by document name","operationId":"listTopicLinkedDocuments","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"search","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicLinkedDocumentListResponse"}}}}}},"post":{"tags":["Topic Documents"],"summary":"Link documents to a topic","description":"Additive — already-linked documents are skipped","operationId":"linkDocumentsToTopic","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LinkDocumentsRequest"}}},"required":true},"responses":{"204":{"description":"No Content"}}}},"/api/v1/topics/{topicId}/learning-bytes":{"get":{"tags":["Learning Bytes"],"summary":"List learning bytes in a topic","description":"Returns learning bytes that belong to the given topic.","operationId":"listLearningBytesInTopic","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LearningByteListResponse"}}}}}},"post":{"tags":["Learning Bytes"],"summary":"Add a learning byte to a topic","description":"Creates a new learning byte inside the given topic.","operationId":"addLearningByteToTopic","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateLearningByteRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LearningByteDetailDto"}}}}}}},"/api/v1/topics/{topicId}/knowledge-base/regenerate":{"post":{"tags":["topic-knowledge-base-rest-controller"],"summary":"Regenerate topic knowledge base","description":"Enqueues an AI regeneration of the topic knowledge base from its current sources. Returns the request id and initial status.","operationId":"regenerateTopicKnowledgeBase","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicKbRequestResponseDto"}}}}}}},"/api/v1/topics/{topicId}/exercises/rpe-voice":{"post":{"tags":["Exercises"],"summary":"Add an RPE_VOICE exercise to a topic","description":"Creates a new RPE_VOICE role-play exercise inside the given topic.","operationId":"addRpeVoiceExercise","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRpeExerciseRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/topics/{topicId}/exercises/rpe-video":{"post":{"tags":["Exercises"],"summary":"Add an RPE_VIDEO exercise to a topic","description":"Creates a new RPE_VIDEO role-play exercise inside the given topic.","operationId":"addRpeVideoExercise","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRpeExerciseRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/topics/{topicId}/exercises/ile-text":{"post":{"tags":["Exercises"],"summary":"Add an ILE_TEXT exercise to a topic","description":"Creates a new ILE_TEXT exercise inside the given topic.","operationId":"addIleTextExercise","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateIleTextExerciseRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/modules/{moduleId}/topics":{"get":{"tags":["Course Topics"],"summary":"List topics in a module","description":"Returns active topics ordered by ordinalNumber","operationId":"listTopicsInModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicListResponse"}}}}}},"post":{"tags":["Course Topics"],"summary":"Add a topic to a module","description":"Creates a new topic inside the given module.","operationId":"addTopicToModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTopicRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicDto"}}}}}}},"/api/v1/modules/{moduleId}/topics/reorder":{"post":{"tags":["Course Topics"],"summary":"Reorder topics inside a module","description":"topicIds must include every active topic exactly once, in the new order","operationId":"reorderTopicsInModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderTopicsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TopicListResponse"}}}}}}},"/api/v1/modules/{moduleId}/quiz-questions":{"get":{"tags":["Quiz Questions"],"summary":"List quiz questions on a module","description":"Returns quiz questions attached to the given module.","operationId":"listModuleQuizQuestions","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}},"post":{"tags":["Quiz Questions"],"summary":"Add a quiz question to a module","description":"Creates a new quiz question inside the given module.","operationId":"addModuleQuizQuestion","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQuestionRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionDto"}}}}}}},"/api/v1/modules/{moduleId}/quiz-questions/reorder":{"post":{"tags":["Quiz Questions"],"summary":"Reorder quiz questions on a module","description":"questionIds must include every active quiz question for the module, in the new order.","operationId":"reorderModuleQuizQuestions","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderQuestionsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}}},"/api/v1/media":{"get":{"tags":["Media"],"summary":"List media","description":"Paginated list of media items in the caller's company","operationId":"listMedia","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"search","in":"query","required":false,"schema":{"type":"string"}},{"name":"kind","in":"query","required":false,"schema":{"type":"string"}},{"name":"status","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediaListResponse"}}}}}},"post":{"tags":["Media"],"summary":"Upload a media item","description":"Multipart upload (file + optional description). Max 50MB for images, 500MB for videos.","operationId":"uploadMedia","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"},"description":{"type":"string"}},"required":["file"]}}}},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediaDetailDto"}}}}}}},"/api/v1/lessons/{lessonId}/questions":{"get":{"tags":["Lesson Questions"],"summary":"List in-lesson questions","description":"Returns knowledge-check questions attached to the given lesson.","operationId":"listLessonQuestions","parameters":[{"name":"lessonId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}},"post":{"tags":["Lesson Questions"],"summary":"Add an in-lesson question","description":"type must be MULTIPLE_CHOICE (requires options), OPEN_ENDED, FILL_IN_THE_BLANKS (requires fillInTheBlanks payload) or MATCH_THE_BLOCKS (requires matchTheBlocks payload)","operationId":"addLessonQuestion","parameters":[{"name":"lessonId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQuestionRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionDto"}}}}}}},"/api/v1/lessons/{lessonId}/questions/reorder":{"post":{"tags":["Lesson Questions"],"summary":"Reorder in-lesson questions","description":"questionIds must include every active question for the lesson, in the new order","operationId":"reorderLessonQuestions","parameters":[{"name":"lessonId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderQuestionsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionListResponse"}}}}}}},"/api/v1/learning-bytes/{lbId}/lessons":{"get":{"tags":["Lessons"],"summary":"List lessons in a learning byte","description":"Returns lessons that belong to the given learning byte.","operationId":"listLessonsInLearningByte","parameters":[{"name":"lbId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LessonListResponse"}}}}}},"post":{"tags":["Lessons"],"summary":"Add a lesson to a learning byte","description":"Creates a new lesson inside the given learning byte.","operationId":"addLessonToLearningByte","parameters":[{"name":"lbId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateLessonRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LessonDetailDto"}}}}}}},"/api/v1/experts/{id}/roles":{"post":{"tags":["Experts"],"summary":"Assign roles to an expert","description":"Additive — already-assigned roles are kept; new ones appended. Returns updated expert","operationId":"assignRolesToExpert","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignRolesRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExpertDetailDto"}}}}}},"delete":{"tags":["Experts"],"summary":"Remove all role assignments from an expert","description":"Idempotent","operationId":"removeAllRolesFromExpert","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}}},"/api/v1/experts/{id}/documents":{"post":{"tags":["Experts"],"summary":"Assign documents to an expert","description":"Bulk link documents to the expert. Idempotent.","operationId":"assignDocumentsToExpert","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignDocumentsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExpertDetailDto"}}}}}}},"/api/v1/experts/{id}/ask":{"post":{"tags":["Experts"],"summary":"Ask an expert a question","description":"Synchronous wrapper around the streaming AI chat. Returns the assembled answer. Pass the returned conversationId (or a client-generated UUID reused across calls) to continue the same conversation with full history; omit it for a one-shot question. A conversation is permanently bound to the expert it started with — asking a different expert with the same conversationId returns 409 CONVERSATION_EXPERT_MISMATCH with the boundExpertId. Optional askerName personalizes the answer for the actual end user. Optional askerEmail enforces per-user access: the email must belong to an ACTIVE member of the company, and non-admin members can only ask experts assigned to one of their roles — otherwise 403 EXPERT_ACCESS_DENIED.","operationId":"askExpert","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AskRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AskResponse"}}}}}}},"/api/v1/exercises/{id}/regenerate":{"post":{"tags":["Company exercises"],"summary":"Regenerate a company exercise","description":"Starts generation and moves generationStatus to PENDING.","operationId":"regenerateCompanyExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/exercises/{id}/duplicate":{"post":{"tags":["Company exercises"],"summary":"Duplicate a company exercise","operationId":"duplicateCompanyExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/exercises/{id}/deactivate":{"post":{"tags":["Company exercises"],"summary":"Hide a company exercise from learners","description":"Idempotent — returns the exercise even if already inactive","operationId":"deactivateCompanyExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/exercises/{id}/activate":{"post":{"tags":["Company exercises"],"summary":"Make a company exercise available to learners","description":"Idempotent — returns the exercise even if already active","operationId":"activateCompanyExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"strin