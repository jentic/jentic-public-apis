Demo Trainings"],"summary":"Re-run video processing","description":"Re-submits the video for AI segmentation. Optionally override the processing prompt.","operationId":"reprocessDemoTraining","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReprocessRequest"}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoTrainingDto"}}}}}}},"/api/v1/demo-trainings/{id}/availability":{"post":{"tags":["Demo Trainings"],"summary":"Toggle availability to students","description":"Set whether the demo training is published to students. Idempotent.","operationId":"updateDemoTrainingAvailability","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ToggleAvailabilityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DemoTrainingDto"}}}}}}},"/api/v1/courses":{"get":{"tags":["Courses"],"summary":"List courses","description":"Paginated list of courses in the caller's company","operationId":"listCourses","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"search","in":"query","required":false,"schema":{"type":"string"}},{"name":"status","in":"query","required":false,"schema":{"type":"string"}},{"name":"departmentRoleIds","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CourseListResponse"}}}}}},"post":{"tags":["Courses"],"summary":"Create an empty course","description":"Creates a new course shell with the given name","operationId":"createCourse","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCourseRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CourseDetailDto"}}}}}}},"/api/v1/courses/{id}/roles":{"post":{"tags":["Courses"],"summary":"Assign roles to a course","description":"Additive — roles already assigned are skipped. Returns the updated course detail","operationId":"assignRolesToCourse","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignRolesRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CourseDetailDto"}}}}}},"delete":{"tags":["Courses"],"summary":"Remove all role assignments from a course","description":"Idempotent","operationId":"removeAllRolesFromCourse","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}}},"/api/v1/courses/{id}/publish":{"post":{"tags":["Courses"],"summary":"Publish a course","description":"Publishes the course; fails with 400 if it has no publishable content","operationId":"publishCourse","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CourseDetailDto"}}}}}}},"/api/v1/courses/{id}/generate-content":{"post":{"tags":["Courses"],"summary":"Trigger AI content generation for topics","description":"Enqueues AI content generation for the specified topics within the course","operationId":"generateCourseContent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateContentReques