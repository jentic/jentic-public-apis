ercises"],"summary":"Delete an exercise","description":"Idempotent — 204 even if already removed","operationId":"deleteExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}},"patch":{"tags":["Exercises"],"summary":"Update an exercise","description":"Type-aware: ILE_TEXT only uses prompt + generatedContent.scenario; RPE_* uses all RPE fields. Omitted fields preserve current values.","operationId":"updateExercise","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateExerciseRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ExerciseDto"}}}}}}},"/api/v1/departments/{id}":{"delete":{"tags":["Departments"],"summary":"Delete (deactivate) a department","description":"Idempotent — returns 204 even if already deactivated. Cascades to role assignments.","operationId":"deleteDepartment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}},"patch":{"tags":["Departments"],"summary":"Update a department","description":"Update name and/or description","operationId":"updateDepartment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DepartmentPatchRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DepartmentDto"}}}}}}},"/api/v1/demo-trainings/{id}":{"get":{"tags":["Demo Trainings"],"summary":"Get a demo training","description":"Returns the full demo training with segments","operationId":"getDemoTraining","parameters":[{"name":"id","in":"path","required":true,"schema":{"