 are ignored.","operationId":"updateTopicQuizQuestion","parameters":[{"name":"topicId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"questionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQuestionRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QuestionDto"}}}}}}},"/api/v1/modules/{moduleId}":{"get":{"tags":["Course Modules"],"summary":"Get a module","description":"Returns module details for the given ID.","operationId":"getModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ModuleDetailDto"}}}}}},"delete":{"tags":["Course Modules"],"summary":"Delete a module (soft)","description":"Idempotent — returns 204 even if the module is already removed","operationId":"deleteModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"No Content"}}},"patch":{"tags":["Course Modules"],"summary":"Update module metadata","description":"Updates name and/or description. Omitted fields preserve current values","operationId":"updateModule","parameters":[{"name":"moduleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateModuleRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ModuleDetailDto"}}}}}}},"/api/v1/modules/{moduleId}/quiz-questions/{questionId}":{"get":{"tags":["Quiz Questions"],"summary":"Get one quiz question on a module","description":"Returns a single quiz question attached to the given module.","operationId":"getM