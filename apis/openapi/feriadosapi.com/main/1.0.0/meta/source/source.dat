openapi: 3.0.3
info:
  title: Feriados API
  description: |
    A API mais completa de feriados brasileiros cobrindo todos os 5.571 municípios, feriados bancários FEBRABAN e notificações via Webhooks em tempo real com assinatura HMAC-SHA256 (X-Feriados-Signature).
    
    Todas as requisições requerem uma API key válida passada via header `Authorization: Bearer <token>` ou `X-API-Key: <token>`.
  version: 1.0.0
  contact:
    name: Suporte Feriados API
    email: contato@feriadosapi.com
    url: https://feriadosapi.com/dashboard
servers:
  - url: https://feriadosapi.com/api/v1
    description: Servidor de Produção

components:
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key
    BearerAuth:
      type: http
      scheme: bearer

  schemas:
    Feriado:
      type: object
      properties:
        id:
          type: string
          format: uuid
          example: "123e4567-e89b-12d3-a456-426614174000"
        data:
          type: string
          example: "01/01/2026"
        nome:
          type: string
          example: "Ano Novo"
        tipo:
          type: string
          enum: [NACIONAL, ESTADUAL, MUNICIPAL, FACULTATIVO]
          example: "NACIONAL"
        descricao:
          type: string
          nullable: true
        uf:
          type: string
          nullable: true
          example: "SP"
        codigo_ibge:
          type: integer
          nullable: true
          example: 3550308
        bancario:
          type: boolean
          description: Indica se é feriado bancário (calendário FEBRABAN)
          example: true

    WebhookPayload:
      type: object
      description: Payload JSON enviado nas notificações de Webhooks em tempo real (POST)
      properties:
        event:
          type: string
          enum: [feriado.created, feriado.updated, feriado.deleted]
          example: "feriado.created"
        created_at:
          type: string
          format: date-time
          example: "2026-09-11T12:00:00.000Z"
        data:
          $ref: '#/components/schemas/Feriado'

    Meta:
      type: object
      properties:
        total:
          type: integer
        page:
          type: integer
        per_page:
          type: integer
        total_pages:
          type: integer

    Estado:
      type: object
      properties:
        uf:
          type: string
          example: "SP"
        nome:
          type: string
          example: "São Paulo"

    Municipio:
      type: object
      properties:
        ibge:
          type: integer
          example: 3550308
        nome:
          type: string
          example: "São Paulo"
        uf:
          type: string
          example: "SP"

    Error:
      type: object
      properties:
        error:
          type: string
        details:
          type: string

security:
  - ApiKeyAuth: []
  - BearerAuth: []

paths:
  /feriados/nacionais:
    get:
      tags: [Feriados]
      summary: Listar Feriados Nacionais
      description: Retorna todos os feriados nacionais de um determinado ano. Este endpoint é gratuito e não consome cota.
      parameters:
        - name: ano
          in: query
          schema:
            type: string
          example: "2026"
        - name: facultativos
          in: query
          schema:
            type: boolean
          description: Se true, inclui feriados facultativos.
        - name: bancarios
          in: query
          schema:
            type: boolean
          description: Se true, retorna apenas feriados bancários (FEBRABAN).
        - name: page
          in: query
          schema:
            type: integer
            default: 1
        - name: limit
          in: query
          schema:
            type: integer
            default: 50
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  tipo:
                    type: string
                  ano:
                    type: string
                  feriados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Feriado'
                  meta:
                    $ref: '#/components/schemas/Meta'

  /feriados/data/{data}:
    get:
      tags: [Feriados]
      summary: Buscar Feriados por Data
      description: Verifica se uma data específica é feriado. Consome 1 unidade de cota.
      parameters:
        - name: data
          in: path
          required: true
          schema:
            type: string
          example: "2026-12-25"
          description: Data no formato YYYY-MM-DD
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: string
                  feriados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Feriado'
                  total:
                    type: integer

  /feriados/estado/{uf}:
    get:
      tags: [Feriados]
      summary: Feriados por Estado
      description: Retorna feriados estaduais e nacionais de uma UF específica. Gratuito para feriados estaduais padrão.
      parameters:
        - name: uf
          in: path
          required: true
          schema:
            type: string
          example: "SP"
        - name: ano
          in: query
          schema:
            type: string
        - name: facultativos
          in: query
          schema:
            type: boolean
        - name: bancarios
          in: query
          schema:
            type: boolean
          description: Se true, retorna apenas feriados bancários (FEBRABAN).
        - name: page
          in: query
          schema:
            type: integer
        - name: limit
          in: query
          schema:
            type: integer
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  uf:
                    type: string
                  ano:
                    type: string
                  feriados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Feriado'
                  meta:
                    $ref: '#/components/schemas/Meta'

  /feriados/cidade/{ibge}:
    get:
      tags: [Feriados]
      summary: Feriados por Cidade (IBGE)
      description: Retorna todos os feriados de uma cidade pelo código IBGE. Gratuito para capitais; consome cota para outros municípios.
      parameters:
        - name: ibge
          in: path
          required: true
          schema:
            type: integer
          example: 3550308
        - name: ano
          in: query
          schema:
            type: string
        - name: facultativos
          in: query
          schema:
            type: boolean
        - name: bancarios
          in: query
          schema:
            type: boolean
          description: Se true, retorna apenas feriados bancários (FEBRABAN).
        - name: page
          in: query
          schema:
            type: integer
        - name: limit
          in: query
          schema:
            type: integer
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  cidade:
                    type: object
                    properties:
                      ibge:
                        type: integer
                      nome:
                        type: string
                      uf:
                        type: string
                  ano:
                    type: string
                  feriados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Feriado'
                  meta:
                    $ref: '#/components/schemas/Meta'

  /feriados/bancarios:
    get:
      tags: [Feriados Bancários]
      summary: Listar Feriados Bancários
      description: Retorna todos os feriados bancários (calendário FEBRABAN) para um determinado ano. Este endpoint é gratuito e não consome cota.
      parameters:
        - name: ano
          in: query
          schema:
            type: string
          example: "2026"
        - name: uf
          in: query
          schema:
            type: string
          description: Filtrar por estado para incluir feriados estaduais bancários.
        - name: ibge
          in: query
          schema:
            type: string
          description: Filtrar por município (código IBGE) para incluir feriados municipais bancários.
        - name: facultativos
          in: query
          schema:
            type: boolean
        - name: page
          in: query
          schema:
            type: integer
            default: 1
        - name: limit
          in: query
          schema:
            type: integer
            default: 50
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  tipo:
                    type: string
                    example: "BANCARIO"
                  ano:
                    type: string
                  feriados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Feriado'
                  meta:
                    $ref: '#/components/schemas/Meta'

  /feriados/dia-util-bancario/{data}:
    get:
      tags: [Feriados Bancários]
      summary: Verificar Dia Útil Bancário
      description: Verifica se uma data é dia útil bancário. Se não for, retorna o motivo e o próximo dia útil. Este endpoint é gratuito e não consome cota.
      parameters:
        - name: data
          in: path
          required: true
          schema:
            type: string
          example: "2026-02-16"
          description: Data no formato YYYY-MM-DD
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: string
                    example: "2026-02-16"
                  dia_util_bancario:
                    type: boolean
                    example: false
                  motivo:
                    type: string
                    example: "Carnaval (Segunda-feira)"
                    description: Presente apenas quando dia_util_bancario é false.
                  proximo_dia_util:
                    type: string
                    example: "2026-02-18"
                    description: Presente apenas quando dia_util_bancario é false.
        '400':
          description: Data inválida
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /estados:
    get:
      tags: [Localidades]
      summary: Listar Estados
      description: Retorna a lista de todas as Unidades Federativas (UFs). Endpoint gratuito.
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  estados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Estado'
                  total:
                    type: integer

  /municipios:
    get:
      tags: [Localidades]
      summary: Listar Municípios
      description: Retorna a lista completa de todos os 5.571 municípios brasileiros. Endpoint gratuito.
      parameters:
        - name: uf
          in: query
          schema:
            type: string
          description: Opcional para filtrar por estado.
        - name: page
          in: query
          schema:
            type: integer
        - name: limit
          in: query
          schema:
            type: integer
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  municipios:
                    type: array
                    items:
                      $ref: '#/components/schemas/Municipio'
                  meta:
                    $ref: '#/components/schemas/Meta'

  /municipio/{ibge}:
    get:
      tags: [Localidades]
      summary: Buscar Município por IBGE
      description: Retorna os dados de um município específico. Endpoint gratuito.
      parameters:
        - name: ibge
          in: path
          required: true
          schema:
            type: integer
          example: 3550308
      responses:
        '200':
          description: Sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Municipio'
