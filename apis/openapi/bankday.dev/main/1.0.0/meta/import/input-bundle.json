                      "level": "federal",
                      "rate": 7.25,
                      "tipped_cash_wage": 2.13,
                      "effective": "2009-07-24",
                      "source": "https://www.dol.gov/agencies/whd/minimum-wage",
                      "verified": "2026-10-26"
                    },
                    {
                      "jurisdiction": "us-wa",
                      "name": "Washington",
                      "level": "state",
                      "rate": 17.73,
                      "tipped_cash_wage": 17.73,
                      "effective": "2027-01-01",
                      "source": "https://lni.wa.gov/...",
                      "verified": "2026-10-26"
                    },
                    {
                      "jurisdiction": "us-wa-seattle",
                      "name": "Seattle",
                      "level": "city",
                      "rate": 22.14,
                      "tipped_cash_wage": 22.14,
                      "effective": "2027-01-01",
                      "source": "https://www.seattle.gov/...",
                      "verified": "2026-10-26"
                    }
                  ],
                  "may_apply": [],
