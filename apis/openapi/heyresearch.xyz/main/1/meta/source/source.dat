"shipsLast30Days","activityMeasured","tokenVerification","activityAppliesToToken","badgeUrl"],"properties":{"slug":{"type":"string"},"name":{"type":"string"},"symbol":{"type":"string"},"url":{"type":"string"},"activityStatus":{"type":"string"},"activityLabel":{"type":"string","description":"The project page's own words for the status. Print this."},"activityHelp":{"type":"string"},"researchLevel":{"type":"string"},"shipsLast30Days":{"type":"integer","description":"Ship records in 30 days — a legacy count, 0 where HEY measured nothing. Read it only beside `activityMeasured: true`."},"activityMeasured":{"type":"boolean"},"meaningfulShipsLast30Days":{"type":"integer","description":"Meaningful ships in 30 days by the rule behind the status; absent, never 0, when not measured and none."},"asOf":{"type":"string","format":"date-time"},"lastShipAt":{"type":"string","format":"date-time"},"lastShip":{"type":"object","additionalProperties":true,"description":"The newest ship: `title` (a running code week names absolute days), `publishedAt`, `sourceUrl`."},"deployedAt":{"type":"string","format":"date-time"},"tokenVerification":{"type":"object","additionalProperties":true,"description":"`status` (VERIFIED, UNVERIFIED, MISMATCH) and its `reason`."},"activityAppliesToToken":{"type":"boolean"},"badgeUrl":{"type":"string"}}},"scanUrl":{"type":"string"},"issuer":{"type":"object","additionalProperties":true,"description":"An issuer's own token (a Robinhood stock token), never a project's; with `status: unknown` only."},"publishedNamesakes":{"type":"object","additionalProperties":true,"description":"Additive (2026-10-18), with `status: unknown` only: published projects carrying this token’s name or ticker on another contract — `total`, `items` (slug, name, symbol, contractAddress, shares, sharesAddressEnding, url) and `line`, the one sentence HEY prints. Facts, never which token is real."},"disclaimer":{"type":"string"}}},"ScanCard":{"description":"The scan card: `found` says which shape. See https://heyresearch.xyz/docs/public-api for every field. Absent means unknown, never zero.","oneOf":[{"type":"object","additionalProperties":true,"description":"No published project answers this token.","required":["found","chainId","disclaimer"],"properties":{"found":{"type":"boolean","const":false},"chainId":{"type":"integer"},"contractAddress":{"type":"string"},"reason":{"type":"string","enum":["chain","not_a_token","issuer_token"]},"message":{"type":"string"},"scan_url":{"type":"string"},"indexed":{"type":"boolean"},"research_state":{"type":"string","enum":["not_researched","not_published","not_indexed"]},"launched_via":{"type":"string"},"publishedNamesakes":{"type":"object","additionalProperties":true,"description":"Additive (2026-10-18), beside `scan_url`: published projects carrying this token’s name or ticker on another contract — `total`, `items` (slug, name, symbol, contractAddress, shares, sharesAddressEnding, url) and `line`, the one sentence HEY prints. Present only when HEY holds a name or a ticker for the token; facts, never which token is real."},"disclaimer":{"type":"string"}}},{"type":"object","additionalProperties":true,"description":"The published project behind this token.","required":["found","chainId","contractAddress","status","status_label","status_help","verified_builder","token_verification","activity_applies_to_token","research_level","activity_measured","coverage","activity","project","project_url","project_link","badge_url","disclaimer"],"properties":{"found":{"type":"boolean","const":true},"chainId":{"type":"integer"},"contractAddress":{"type":"string"},"status":{"type":"string"},"status_label":{"type":"string"},"status_help":{"type":"string"},"verified_builder":{"type":"boolean"},"token_verification":{"type":"string","enum":["VERIFIED","UNVERIFIED","MISMATCH"]},"activity_applies_to_token":{"type":"boolean"},"research_level":{"type":"string"},"activity_measured":{"type":"boolean"},"coverage":{"type":"string","enum":["measured","no_source","not_researched"]},"as_of":{"type":"string","format":"date-time"},"activity":{"type":"object","additionalProperties":true,"description":"Counts over 30 days; `commits_30d` is absent, never 0, without a readable repository. `releases_measured` (2026-10-22, additive) is false when HEY reads no source releases come from, or building is not measured: `releases_30d: 0` is then legacy, not a finding."},"project":{"type":"object","additionalProperties":true},"project_url":{"type":"string"},"project_link":{"type":"string"},"logo_url":{"type":"string"},"badge_url":{"type":"string"},"cta":{"type":"object","additionalProperties":true},"disclaimer":{"type":"string"}}}]},"Token":{"type":"object","additionalProperties":true,"description":"Canonical token identity: `(chainId, contractAddress)`, never a ticker alone.","required":["chainId","contractAddress"],"properties":{"chainId":{"type":"integer"},"contractAddress":{"type":"string","description":"The token contract, lower-case hex."}}},"Project":{"type":"object","additionalProperties":true,"description":"A project card, as the listings send it. See https://heyresearch.xyz/docs/public-api for the reference. Absent means unknown, never zero.","required":["slug","name","projectKind","activityStatus","researchLevel","catalogStatus","stillBuilding","stillBuildingState","url"],"properties":{"slug":{"type":"string","description":"The project's slug on HEY."},"name":{"type":"string"},"symbol":{"type":"string","description":"The tracked token's ticker, as shown. Never the identity: that is `token`."},"shortDescription":{"type":"string"},"projectKind":{"type":"string","description":"What kind of project it is (utility, meme, infrastructure, …)."},"activityStatus":{"type":"string","description":"What HEY claims about the project's activity: `SHIPPING`, `ACTIVE`, `QUIET`, `DORMANT`, `RESUMED` or `UNKNOWN` (HEY cannot read the building — never \"abandoned\"). From meaningful builder activity, never the token price. The list may grow; an unknown value is a status HEY added."},"researchLevel":{"type":"string","description":"How far HEY's research went. Kept for machines; public pages draw only the Verified Builder badge."},"catalogStatus":{"type":"string","description":"The record's catalogue state (e.g. `VERIFIED_BUILDER`, `QUALIFIED`)."},"stillBuilding":{"type":"boolean","description":"v1 meaning, unchanged: the Still Building badge is held — counted ships during a market drawdown HEY tracked; not a buy signal. A false is \"not held\"; read `stillBuildingState` to tell \"not met\" from \"not measured\"."},"stillBuildingState":{"$ref":"#/components/schemas/StillBuildingState"},"heysOwnToken":{"$ref":"#/components/schemas/HeysOwnToken"},"lastShippedAt":{"type":"string","format":"date-time","description":"The newest meaningful ship HEY counted."},"primaryNarrative":{"type":"object","additionalProperties":true,"description":"The project's primary narrative.","required":["slug","name"],"properties":{"slug":{"type":"string"},"name":{"type":"string"}}},"token":{"$ref":"#/components/schemas/Token"},"launchedVia":{"type":"object","additionalProperties":true,"description":"Where the token launched, when HEY observed the launch. Absent when unknown or independent — never a launchpad called \"Unknown\".","required":["name"],"properties":{"name":{"type":"string","description":"The launchpad, by name."},"url":{"type":"string"}}},"venue":{"type":"string","description":"The pool the current market reading came from, in words (\"Uniswap v4\"): where the token trades, not where it launched."},"trades24h":{"type":"object","additionalProperties":true,"description":"Trades in the reading's last day, from the same provider as `marketCap`. Counts of trades, never of accounts.","required":["buys","sells"],"properties":{"buys":{"type":"integer","minimum":0,"description":"Buy trades in the reading's last day."},"sells":{"type":"integer","minimum":0,"description":"Sell trades in the reading's last day."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}},"tokenLock":{"$ref":"#/components/schemas/TokenLock"},"priceChange24hPct":{"type":"number","description":"The reading's 24-hour price change, in percent. Market context only."},"hasBuilderSource":{"type":"boolean","description":"Whether HEY holds a repository, org, changelog or feed to read building from; false explains an UNKNOWN status."},"websiteUrl":{"type":"string"},"officialX":{"$ref":"#/components/schemas/OfficialX"},"logoUrl":{"type":"string","description":"The artwork the project chose. Absent where HEY does not know it; draw a monogram."},"stillBuildingEvidence":{"type":"object","additionalProperties":true,"description":"The drawdown behind a `stillBuilding: true`. Absent when the claim is not being made.","required":["drawdownPercent"],"properties":{"drawdownPercent":{"type":"number","description":"The decline HEY tracked, in percent."},"shipsSinceDecline":{"type":"integer","minimum":0,"description":"Counted ships since the decline began."}}},"marketCap":{"type":"object","additionalProperties":true,"description":"Market context only, with the provider that reported it. Never a ranking input; absent is unknown, never zero.","required":["usd","source"],"properties":{"usd":{"type":"number","description":"The valuation in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."},"kind":{"type":"string","enum":["marketCap","fdv"],"description":"`fdv` when the provider reported no circulating figure and the fully diluted valuation stands in."}}},"valuationWithheld":{"type":"string","description":"Why `marketCap` is absent when HEY holds a reading it will not publish: the market's reason code or status (`launch_pool_no_trades`, `readings_implausible`, `NO_LIQUIDITY`, …), or the valuation gate's reason (`valuation_over_liquidity`, `unlisted_over_ceiling`, `chain_evidence_contradicts`, `sources_disagree`). Absent when HEY holds no reading at all."},"liquidity":{"type":"object","additionalProperties":true,"description":"The liquidity the project page prints. When the current reading carries none, the token's last recorded depth, dated by its own `observedAt` and with no `source`. Absent is unknown, never zero.","required":["usd","kind"],"properties":{"usd":{"type":"number","description":"Liquidity in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."},"kind":{"type":"string","enum":["market","launch_inventory"],"description":"`market` is depth a trader could use; `launch_inventory` is a launch pool's own supply at its last price (\"Not a market reading\")."}}},"volume24h":{"type":"object","additionalProperties":true,"description":"The reading's 24-hour volume. Absent is unknown, never zero.","required":["usd"],"properties":{"usd":{"type":"number","description":"Volume in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}},"launchStage":{"type":"string","enum":["CURVE","GRADUATED","DEX"],"description":"Where the launch stands: on its curve, graduated, or trading in a DEX pool. Absent when HEY does not know."},"tokenMarket":{"$ref":"#/components/schemas/TokenMarketState"},"tokenVerification":{"$ref":"#/components/schemas/TokenVerification"},"url":{"type":"string","description":"The project's page on HEY."}}},"ProjectDetail":{"type":"object","additionalProperties":true,"description":"One project's dossier: the card, plus the long description, the newest ships, every registered source with how it was established, the market reading, the score and the on-chain activity. `score` is present only when HEY ran the pipeline: a zero there is \"measured, nothing found\", absent is \"not measured\". See https://heyresearch.xyz/docs/public-api for the reference. Absent means unknown, never zero.","required":["slug","name","projectKind","activityStatus","researchLevel","catalogStatus","stillBuilding","stillBuildingState","url","ships","firstSeenAt","firstRecordedByHeyAt","isClaimed","submitted","narratives","sources","disclaimer"],"properties":{"slug":{"type":"string","description":"The project's slug on HEY."},"name":{"type":"string"},"symbol":{"type":"string","description":"The tracked token's ticker, as shown. Never the identity: that is `token`."},"shortDescription":{"type":"string"},"projectKind":{"type":"string","description":"What kind of project it is (utility, meme, infrastructure, …)."},"activityStatus":{"type":"string","description":"What HEY claims about the project's activity: `SHIPPING`, `ACTIVE`, `QUIET`, `DORMANT`, `RESUMED` or `UNKNOWN` (HEY cannot read the building — never \"abandoned\"). From meaningful builder activity, never the token price. The list may grow; an unknown value is a status HEY added."},"researchLevel":{"type":"string","description":"How far HEY's research went. Kept for machines; public pages draw only the Verified Builder badge."},"catalogStatus":{"type":"string","description":"The record's catalogue state (e.g. `VERIFIED_BUILDER`, `QUALIFIED`)."},"stillBuilding":{"type":"boolean","description":"v1 meaning, unchanged: the Still Building badge is held — counted ships during a market drawdown HEY tracked; not a buy signal. A false is \"not held\"; read `stillBuildingState` to tell \"not met\" from \"not measured\"."},"stillBuildingState":{"$ref":"#/components/schemas/StillBuildingState"},"heysOwnToken":{"$ref":"#/components/schemas/HeysOwnToken"},"lastShippedAt":{"type":"string","format":"date-time","description":"The newest meaningful ship HEY counted."},"primaryNarrative":{"type":"object","additionalProperties":true,"description":"The project's primary narrative.","required":["slug","name"],"properties":{"slug":{"type":"string"},"name":{"type":"string"}}},"token":{"$ref":"#/components/schemas/Token"},"launchedVia":{"type":"object","additionalProperties":true,"description":"Where the token launched, when HEY observed the launch. Absent when unknown or independent — never a launchpad called \"Unknown\".","required":["name"],"properties":{"name":{"type":"string","description":"The launchpad, by name."},"url":{"type":"string"}}},"venue":{"type":"string","description":"The pool the current market reading came from, in words (\"Uniswap v4\"): where the token trades, not where it launched."},"trades24h":{"type":"object","additionalProperties":true,"description":"Trades in the reading's last day, from the same provider as `marketCap`. Counts of trades, never of accounts.","required":["buys","sells"],"properties":{"buys":{"type":"integer","minimum":0,"description":"Buy trades in the reading's last day."},"sells":{"type":"integer","minimum":0,"description":"Sell trades in the reading's last day."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}},"tokenLock":{"$ref":"#/components/schemas/TokenLock"},"priceChange24hPct":{"type":"number","description":"The reading's 24-hour price change, in percent. Market context only."},"hasBuilderSource":{"type":"boolean","description":"Whether HEY holds a repository, org, changelog or feed to read building from; false explains an UNKNOWN status."},"websiteUrl":{"type":"string"},"officialX":{"$ref":"#/components/schemas/OfficialX"},"logoUrl":{"type":"string","description":"The artwork the project chose. Absent where HEY does not know it; draw a monogram."},"stillBuildingEvidence":{"type":"object","additionalProperties":true,"description":"The drawdown behind a `stillBuilding: true`. Absent when the claim is not being made.","required":["drawdownPercent"],"properties":{"drawdownPercent":{"type":"number","description":"The decline HEY tracked, in percent."},"shipsSinceDecline":{"type":"integer","minimum":0,"description":"Counted ships since the decline began."}}},"marketCap":{"type":"object","additionalProperties":true,"description":"Market context only, with the provider that reported it. Never a ranking input; absent is unknown, never zero.","required":["usd","source"],"properties":{"usd":{"type":"number","description":"The valuation in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."},"kind":{"type":"string","enum":["marketCap","fdv"],"description":"`fdv` when the provider reported no circulating figure and the fully diluted valuation stands in."}}},"valuationWithheld":{"type":"string","description":"Why `marketCap` is absent when HEY holds a reading it will not publish: the market's reason code or status (`launch_pool_no_trades`, `readings_implausible`, `NO_LIQUIDITY`, …), or the valuation gate's reason (`valuation_over_liquidity`, `unlisted_over_ceiling`, `chain_evidence_contradicts`, `sources_disagree`). Absent when HEY holds no reading at all."},"liquidity":{"type":"object","additionalProperties":true,"description":"The liquidity the project page prints. When the current reading carries none, the token's last recorded depth, dated by its own `observedAt` and with no `source`. Absent is unknown, never zero.","required":["usd","kind"],"properties":{"usd":{"type":"number","description":"Liquidity in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."},"kind":{"type":"string","enum":["market","launch_inventory"],"description":"`market` is depth a trader could use; `launch_inventory` is a launch pool's own supply at its last price (\"Not a market reading\")."}}},"volume24h":{"type":"object","additionalProperties":true,"description":"The reading's 24-hour volume. Absent is unknown, never zero.","required":["usd"],"properties":{"usd":{"type":"number","description":"Volume in USD."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}},"launchStage":{"type":"string","enum":["CURVE","GRADUATED","DEX"],"description":"Where the launch stands: on its curve, graduated, or trading in a DEX pool. Absent when HEY does not know."},"tokenMarket":{"$ref":"#/components/schemas/TokenMarketDetail"},"tokenVerification":{"$ref":"#/components/schemas/TokenVerification"},"url":{"type":"string","description":"The project's page on HEY."},"longDescription":{"type":"string"},"ships":{"type":"array","items":{"$ref":"#/components/schemas/Ship"},"description":"The newest ships, as `/api/ships?project=` would list them."},"firstSeenAt":{"type":"string","format":"date-time","description":"Deprecated alias kept for callers: on registry and launchpad pages it held the outside listing date. Read `firstRecordedByHeyAt`."},"firstRecordedByHeyAt":{"type":"string","format":"date-time","description":"When HEY first recorded the project: HEY's knowledge time, never an outside date."},"externalListedAt":{"type":"string","format":"date-time","description":"The date an outside registry or launchpad gives the project. Absent when HEY holds none."},"externalListedSource":{"type":"string","description":"Which outside registry or launchpad gave `externalListedAt` (`defillama`, `virtuals`, …)."},"isClaimed":{"type":"boolean","description":"A builder proved control of the page. Proving ownership changes no status, score or order on its own."},"submitted":{"type":"boolean","description":"The page was submitted by its builder (self-reported)."},"narratives":{"type":"array","items":{"type":"object","additionalProperties":true,"description":"A narrative the project sits in.","required":["slug","name","isPrimary"],"properties":{"slug":{"type":"string"},"name":{"type":"string"},"isPrimary":{"type":"boolean"}}}},"sources":{"type":"array","items":{"type":"object","additionalProperties":true,"description":"A registered source and how it was established.","required":["id","url","sourceType","isVerified","confidence","contextOnly"],"properties":{"id":{"type":"string","description":"The source's typed evidence id, `source:<uuid>`, which `/api/evidence/{id}` resolves."},"url":{"type":"string"},"sourceType":{"type":"string","description":"`GITHUB_REPO`, `WEBSITE`, `X`, `CHANGELOG`, …"},"isVerified":{"type":"boolean","description":"Stored value: HEY checked the source (pages say \"Checked by HEY\")."},"confidence":{"type":"string","description":"How the source was established (`OFFICIAL`, `AUTHORITATIVE_LINK`, `DISCOVERED`, …)."},"contextOnly":{"type":"boolean","description":"The source is shown as context and counts toward nothing."},"contextReason":{"type":"string","description":"The quality gate's stored reason the source is context only."},"contextWords":{"type":"string","description":"On a context-only source, why it is held and what would make it count, in one sentence."}}}},"market":{"$ref":"#/components/schemas/ProjectMarketReading"},"score":{"$ref":"#/components/schemas/ProjectScore"},"onchainActivity":{"$ref":"#/components/schemas/OnchainActivity"},"defiTvl":{"type":"object","additionalProperties":true,"description":"TVL DefiLlama reports for the project's protocol on this chain. Context; never a ranking input.","required":["tvlUsd","protocol","protocolName","matchedBy","source","observedAt"],"properties":{"tvlUsd":{"type":"number","description":"Value locked in USD, as DefiLlama reports it on this chain."},"protocol":{"type":"string","description":"DefiLlama's protocol slug."},"protocolName":{"type":"string"},"matchedBy":{"type":"string","description":"How HEY matched the protocol to the project."},"source":{"type":"string","const":"defillama"},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}},"disclaimer":{"type":"string"}}},"OfficialX":{"type":"object","additionalProperties":true,"description":"The project’s official X account (additive fields 2026-10-18). The state is read through twitterapi.io, an independent provider not affiliated with X — an account last read active daily by its stable id (since 2026-10-18), any other about weekly by handle: identity context only, never an input to the activity status or a score. Since the founder’s 2026-10-18 rulings an account read as SUSPENDED or NOT_FOUND no longer counts toward `has=x` or a card’s completeness; UNAVAILABLE and unread accounts still do.","required":["handle","url","status","checkedAt","linkHeld","corroboration","corroborationCheckedAt","foundByHey"],"properties":{"handle":{"type":"string","description":"v1 meaning, unchanged: the X account the project’s own sources vouch for."},"url":{"type":"string","description":"v1 meaning, unchanged: that account’s address on x.com."},"status":{"type":["string","null"],"enum":["ACTIVE","SUSPENDED","UNAVAILABLE","NOT_FOUND",null],"description":"Additive (2026-10-18): what HEY’s last read of the account found. Null when HEY holds no read of this handle — `statusReason` says why — never a default. Do not link an account whose status is SUSPENDED or NOT_FOUND."},"statusReason":{"type":"string","enum":["not_read","read_failed"],"description":"Sent only with `status: null`."},"checkedAt":{"type":["string","null"],"format":"date-time","description":"When that read was made (ISO 8601); null when no read answered."},"linkHeld":{"type":["string","null"],"enum":["handle_reassigned","links_other_project","not_the_project",null],"description":"Additive (2026-10-18, founder ruling): `handle_reassigned` when the handle now answers for a different X account than the one HEY first read. HEY holds the link — its pages print a dated line instead — until a moderator confirms the new account. `links_other_project` (additive, 2026-10-18) when the account’s own profile links another published project’s site and not this project’s: the handle is that project’s account. `not_the_project` (additive, 2026-10-19) when a moderator held the account as not the project’s. Do not link any of them. Null otherwise."},"corroboration":{"type":["string","null"],"enum":["mutual_site_link",null],"description":"Additive (2026-10-18, founder ruling): `mutual_site_link` when the account’s own profile links the project’s own site (`websiteUrl`), the site that links the account — trust in the X account itself as the project’s own, and nothing else: no source confidence, indexing, status, score, order or publication reads it. Null when it does not hold or HEY cannot say."},"corroborationCheckedAt":{"type":["string","null"],"format":"date-time","description":"Additive (2026-10-18): the read that found the mutual link (ISO 8601); null when `corroboration` is null."},"foundByHey":{"type":"boolean","description":"Additive (2026-10-19): true when HEY found the account by the project’s name — its profile links the project’s site, but the project’s own pages do not name it — and no person has verified it yet. Such an account is never a mutual link, its posts are not shown and it is never tagged."}}},"TokenLock":{"type":"object","additionalProperties":true,"description":"A lock HEY found at HoodLock. Absent when HEY found none — never a false that reads like a checked \"not locked\".","required":["pairLocked","pairLockScope"],"properties":{"supplyPct":{"type":"number","description":"Share of total supply locked at HoodLock."},"until":{"type":"string","description":"When the last of the locked supply opens."},"nextUnlockAt":{"type":"string","description":"The nearest unlock date."},"nextUnlockPct":{"type":"number","description":"Share of total supply that opens that UTC day."},"pairLocked":{"type":"boolean","description":"v1 meaning, unchanged: HEY found a pair holding this token locked at the lockers `pairLockScope` names."},"pairLockScope":{"type":"string","enum":["hoodlock_only"],"description":"Which lockers HEY reads (2026-09-30, additive). `hoodlock_only`: a `pairLocked: false` is a reading of HoodLock, not of every locker."}}},"TokenVerification":{"type":"object","additionalProperties":true,"description":"Whether the project itself names the tracked contract. Absent for a project without a token.","required":["status"],"properties":{"status":{"type":"string","enum":["VERIFIED","UNVERIFIED","MISMATCH"],"description":"Stored values (machine rule 10): `VERIFIED` — the project names this contract; `UNVERIFIED` — HEY found the token through a launch record or a market listing and nothing the project published names it; `MISMATCH` — the project’s own site names a different contract. Pages print \"Project names this contract\", \"Not named by the project\" and \"Project names another contract\"."},"reason":{"type":"string","description":"The reason code behind the status (e.g. `site_disclaims_contract`)."},"verifiedAt":{"type":"string","format":"date-time","description":"When the project was found to name the contract."}}},"TokenMarketState":{"type":"object","additionalProperties":true,"description":"The tracked token’s market state, as the card shows it. It is why a listing sometimes carries no `marketCap`: a dead market’s valuation is withheld. Absent for a project without a token. A statement about the market, never about the team.","required":["status","label"],"properties":{"status":{"type":"string","description":"`ACTIVE_MARKET`, `LOW_LIQUIDITY`, `NO_LIQUIDITY`, `TRADING_INACTIVE`, `LIQUIDITY_REMOVED`, `MARKET_ABANDONED` or `INSUFFICIENT_DATA`. The list may grow."},"reason":{"type":"string","description":"The reason code HEY recorded (`launch_pool_no_trades`, `no_volume_24h`, `volume_unknown`, `liquidity_not_current`, …)."},"label":{"type":"string","description":"The status in HEY’s own words (2026-10-16, additive), from the one label rule every page reads: \"Launch pool only\", \"Not a fungible token\", \"No current reading\" where the reason says so. Quote it rather than re-deriving words from the code."}}},"TokenMarketDetail":{"type":"object","additionalProperties":true,"description":"The tracked token’s market state on the dossier, from HEY’s own snapshots, kept apart from activity. Context, never a ranking input; never a verdict on the team.","required":["status","label"],"properties":{"status":{"type":"string","description":"The market status, as on `TokenMarketState`."},"reason":{"type":"string","description":"The reason code HEY recorded."},"label":{"type":"string","description":"The status in HEY’s own words (2026-10-16, additive): the same `label` as the listing’s `tokenMarket`."},"evaluatedAt":{"type":"string","format":"date-time","description":"When HEY last ran the status rule — which may be days after the reading it read; see `readingObservedAt`."},"liquidityUsd":{"type":"number","description":"The reading pool’s liquidity in USD (see `figuresScope`)."},"liquidityKind":{"type":"string","enum":["market","launch_inventory"],"description":"What `liquidityUsd` is, by the same rule as `liquidity.kind`."},"volume24hUsd":{"type":"number","description":"The reading pool’s 24-hour volume in USD (see `figuresScope`)."},"peakLiquidityUsd":{"type":"number","description":"The token’s own liquidity high: the highest level held on two consecutive daily closes of HEY’s index (2026-10-16), not this pool’s figure. Absent, never 0, when no two closes held one."},"pairCreatedAt":{"type":"string","format":"date-time","description":"When the reading’s pool was created."},"readingObservedAt":{"type":"string","format":"date-time","description":"Additive (2026-10-03): when the reading behind `liquidityUsd` and `volume24hUsd` was observed. `evaluatedAt` is when HEY last ran the status rule."},"figuresScope":{"type":"string","const":"reading_pool","description":"Additive (2026-10-03): what `liquidityUsd` and `volume24hUsd` measure — always the pool the market-status reading follows, never the token across every pool. The project’s own `volume24h` is the card reading’s figure, which may count every pool: different measures, not a contradiction. For a rescued market (`liquidity_in_another_pool`) this pool is the thin one, not the market. Present when either figure is."}}},"ProjectMarketReading":{"type":"object","additionalProperties":true,"description":"The market reading behind the dossier, with its provider and `observedAt`. Market context only, never a ranking input.","required":["observedAt","source"],"properties":{"marketCapUsd":{"type":"number","description":"The reading’s valuation. The name is historical: `valuationKind` says which measure it is."},"valuationKind":{"type":"string","enum":["marketCap","fdv"],"description":"Which measure `marketCapUsd` is; `fdv` for a fully diluted valuation."},"fdvUsd":{"type":"number","description":"The fully diluted valuation, when the reading carries one and it is not withheld."},"valuationWithheld":{"type":"string","description":"Present when the valuation is withheld: the market’s reason code when it is not live, or the valuation gate’s reason (`valuation_over_liquidity`, `unlisted_over_ceiling`, `chain_evidence_contradicts`, `sources_disagree`); `fdvUsd` is then absent too."},"liquidityUsd":{"type":"number","description":"The reading’s liquidity in USD."},"liquidityKind":{"type":"string","enum":["market","launch_inventory"],"description":"`launch_inventory` when `liquidityUsd` is a launch pool’s own supply (\"Not a market reading\")."},"volume24hUsd":{"type":"number","description":"The reading’s 24-hour volume in USD."},"priceUsd":{"type":"number","description":"The reading’s price in USD."},"buys24h":{"type":"integer","minimum":0,"description":"Buy trades in the reading’s last day."},"sells24h":{"type":"integer","minimum":0,"description":"Sell trades in the reading’s last day."},"priceChange1hPct":{"type":"number","description":"Price change over 1 hour, in percent."},"priceChange6hPct":{"type":"number","description":"Price change over 6 hours, in percent."},"priceChange24hPct":{"type":"number","description":"Price change over 24 hours, in percent."},"venue":{"type":"string","description":"The pool, in words."},"pairAddress":{"type":"string","description":"The pool’s address."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."},"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"sourcesDisagree":{"type":"object","additionalProperties":true,"description":"Additive (2026-10-09): another source’s reading within a day whose price is more than 2× away from this one’s — \"sources disagree\", so the figures above are the shown reading’s as read, not a settled fact. Absent when none disagrees or none was read.","required":["source","priceUsd","observedAt"],"properties":{"source":{"type":"string","description":"The provider that reported the figure, under its public name."},"priceUsd":{"type":"number","description":"That source’s price in USD."},"observedAt":{"type":"string","format":"date-time","description":"When that provider's reading was taken."}}}}},"ProjectScore":{"type":"object","additionalProperties":true,"description":"HEY’s scores for the project. Present only when HEY ran the pipeline. Never a ranking by price, never a prediction.","required":["stillBuilding","stillBuildingState","calculatedAt","scoringVersion"],"properties":{"buildMomentum":{"type":"number","description":"Build Momentum. Absent when not measured (a project HEY never scanned), never a zero; a present 0 is \"measured, nothing found\"."},"discoveryGap":{"type":"number","description":"The Discovery Gap. Absent when not measured — `discoveryGapWithheld` says why — never a zero."},"discoveryGapWithheld":{"$ref":"#/components/schemas/DiscoveryGapWithheld"},"stillBuilding":{"type":"boolean","description":"v1 meaning, unchanged: false whenever the badge is not held. Beside `stillBuildingWithheld`, the false is \"not measured\", never \"not met\"."},"stillBuildingState":{"$ref":"#/components/schemas/StillBuildingState"},"stillBuildingWithheld":{"$ref":"#/components/schemas/StillBuildingWithheld"},"underTheRadar":{"$ref":"#/components/schemas/UnderTheRadar"},"calculatedAt":{"type":"string","format":"date-time","description":"When the per-project score — the status and Build Momentum — was computed."},"cohortEvaluatedAt":{"type":"string","format":"date-time","description":"Additive (2026-10-16): when the cohort rebuild last wrote `discoveryGap`, Under the Radar and `stillBuilding`, which it rewrites in place without touching `calculatedAt`. Absent on a score no rebuild has written since the field existed."},"scoringVersion":{"type":"string","description":"The algorithm version the figures were produced by (e.g. `hbm-v32`)."}}},"UnderTheRadar":{"type":"object","additionalProperties":true,"description":"Under the Radar as the project page states it (2026-10-17, additive), read from the explain engine. Absent when it could not be read.","required":["state","explainUrl"],"properties":{"state":{"type":"string","enum":["HELD","NOT_HELD","NOT_MEASURED"],"description":"`HELD` — the rule holds it today; `NOT_HELD` — measured, not held; `NOT_MEASURED` — the gap is withheld."},"reason":{"type":"string","description":"With `NOT_MEASURED`: the reason the gap is withheld (`market_too_thin`, `no_token`, …) or `not_in_cohort`."},"explainUrl":{"type":"string","description":"The explain engine’s answer for the Discovery Gap fact."}}},"OnchainActivity":{"type":"object","additionalProperties":true,"description":"Events the token contract emitted, as HEY last read them from the chain. Counts, never accounts. Context; never a ranking input.","required":["daysCovered","daysMeasured","truncated","observedAt"],"properties":{"events24h":{"type":"integer","minimum":0,"description":"Events the token contract emitted on `eventsDay`. Absent when HEY could not read the contract’s events on any day in the window — a gap in what HEY can read, not a quiet contract. A present 0 is a day HEY read and found none."},"eventsDay":{"type":"string","format":"date","description":"The UTC day `events24h` counts (2026-10-22, additive): the newest day HEY read, never a rolling 24 hours, and not current when `observedAt` is old. Absent with `events24h`."},"partialDay":{"type":"object","additionalProperties":true,"description":"Present when `events24h` was read before `eventsDay` closed (2026-10-31, additive): it counts the 24 hours to `readAt`, not that UTC day. A measured count all the same, never unknown. Absent when it counts a whole day.","required":["readAt"],"properties":{"readAt":{"type":"string","format":"date-time","description":"When the count was read."}}},"events7d":{"type":"integer","minimum":0,"description":"Events over the days read in the last 7 days. Absent for the same reason as `events24h`."},"daysCovered":{"type":"integer","minimum":0,"description":"Days HEY holds a row for."},"daysMeasured":{"type":"integer","minimum":0,"description":"Days HEY could read events from; below `daysCovered` when the decoder is blind."},"truncated":{"type":"boolean","description":"A day’s read hit its cap: the counts are floors."},"observedAt":{"type":"string","format":"date-time","description":"When HEY last read the contract’s activity."},"calls24h":{"type":"integer","minimum":0,"description":"Calls into the contract on the latest day, on days a decoding source filled."},"transactions24h":{"type":"integer","minimum":0,"description":"Transactions on the latest day, on days a decoding source filled."},"methods":{"type":"integer","minimum":0,"description":"Distinct method names over the days read."},"eventKinds":{"type":"integer","minimum":0,"description":"Distinct event names over the days read."}}},"Ship":{"type":"object","additionalProperties":true,"description":"A ship with its public source. See https://heyresearch.xyz/docs/public-api for the reference. Absent means unknown, never zero.","required":["id","title","eventType","publishedAt","detectedAt","precision","evidenceId","verification","project","url"],"properties":{"id":{"type":"string"},"title":{"type":"string","description":"The stored, clock-independent title."},"displayTitle":{"type":"string","description":"The title as of the response, only when it differs from `title` (2026-10-16): a running code week reads \"Code changes, week starting 2026-10-12 (to 2026-10-16)\"."},"summary":{"type":"string"},"eventType":{"type":"string","description":"The kind of ship (`RELEASE`, `CODE_ACTIVITY`, `CONTRACT_DEPLOY_FOLLOWUP`, …)."},"publishedAt":{"type":"string","format":"date-time","description":"When the source dates the ship; read with `precision`."},"detectedAt":{"type":"string","format":"date-time","description":"When HEY observed it, which is not when the project shipped it. Mirror along this and `sort=detected`, never along `publishedAt`."},"precision":{"type":"string","enum":["EXACT","DATE","WEEK","OBSERVED"],"description":"How much of `publishedAt` HEY knows: `EXACT` an instant, `DATE` a date-only publication, `WEEK` a week of code activity, `OBSERVED` HEY’s scan clock."},"evidenceId":{"type":"string","description":"The typed evidence id, `ship:<uuid>`, that resolves at `/api/evidence/{id}`."},"verification":{"type":"string","description":"How the claim is backed; self-reported and source-backed are different states. `verification` is the stored value: `PUBLICLY_VERIFIED` or `SOURCE_LINKED` (a public source; a page says \"Source-backed\"), `ADMIN_VERIFIED` (a HEY moderator's check; \"Checked by HEY\") or `SELF_REPORTED` (the builder's own word; \"Self-reported\")."},"sourceUrl":{"type":"string","description":"The public source HEY recorded it from, when there is one."},"codeSubstance":{"$ref":"#/components/schemas/CodeSubstance"},"codeWeek":{"$ref":"#/components/schemas/CodeWeek"},"project":{"$ref":"#/components/schemas/Project"},"url":{"type":"string","description":"The ship on HEY’s own page."}}},"CodeSubstance":{"type":"object","additionalProperties":true,"description":"What a week of code activity changed. The counts are FACTs about the commits HEY read. Absent on every other ship and on a week HEY never evaluated — never a zero.","required":["verdict","classifierVersion","countsAsBuilding","commitsListed","commitsRead","changedCode","documentationOrMaintenance","substanceUnknown","notRead","files","weekFullyListed","automatedCommits","sampled","basis","summary"],"properties":{"verdict":{"type":"string","enum":["SUBSTANTIVE","LOW_INFORMATION","UNKNOWN"],"description":"DERIVED by `classifierVersion`. `LOW_INFORMATION` (documentation or maintenance only) is kept on the record and does not count as building; `UNKNOWN` (not read in full yet) counts as before."},"classifierVersion":{"type":"string"},"countsAsBuilding":{"type":"boolean"},"commitsListed":{"type":"integer","minimum":0,"description":"Human, non-merge commits of the week HEY holds."},"commitsRead":{"type":"integer","minimum":0,"description":"Of those, read and classified."},"changedCode":{"type":"integer","minimum":0,"description":"Commits read as changing code."},"documentationOrMaintenance":{"type":"integer","minimum":0,"description":"Commits read as documentation or maintenance only."},"substanceUnknown":{"type":"integer","minimum":0,"description":"Commits read whose changes could not be placed."},"notRead":{"type":"integer","minimum":0,"description":"Not read: waiting, or not needed once one commit had changed code."},"files":{"type":"object","additionalProperties":true,"description":"Changed files by class, over the commits read.","required":["source","test","docs","readme","dependency","config","ci","generated","asset","whitespace","rename","data","unknown"],"properties":{"source":{"type":"integer"},"test":{"type":"integer"},"docs":{"type":"integer"},"readme":{"type":"integer"},"dependency":{"type":"integer"},"config":{"type":"integer"},"ci":{"type":"integer"},"generated":{"type":"integer"},"asset":{"type":"integer"},"whitespace":{"type":"integer"},"rename":{"type":"integer"},"data":{"type":"integer"},"unknown":{"type":"integer"}}},"weekFullyListed":{"type":"boolean","description":"Every commit of the week was on a page HEY read."},"automatedCommits":{"type":"integer","minimum":0,"description":"Bot or automated-stream commits HEY holds for the week, never counted."},"sampled":{"type":"boolean","description":"The verdict rests on a sample of a burst week."},"basis":{"type":["string","null"],"enum":["all_read","burst_sample","automated_only",null],"description":"What a LOW_INFORMATION verdict rests on; null otherwise."},"summary":{"type":"string","description":"One plain sentence, as the page says it."}}},"CodeWeek":{"type":"object","additionalProperties":true,"description":"A code week by its fixed Monday–Sunday UTC window. Absent on every other ship.","required":["isoWeek","start","end","repository","commits","commitsAtLeast","highlights","title","complete"],"properties":{"isoWeek":{"type":"string","description":"The ISO week key, `2026-w40`."},"start":{"type":"string","format":"date-time","description":"Monday 00:00 UTC, inclusive."},"end":{"type":"string","format":"date-time","description":"The next Monday 00:00 UTC, exclusive."},"repository":{"type":"string","description":"`owner/repo`."},"commits":{"type":["integer","null"],"minimum":0,"description":"Human, non-merge commits HEY counted in the week; null when it holds no count."},"commitsAtLeast":{"type":"boolean","description":"The count is a floor: the page HEY read stopped inside the week."},"commitsUrl":{"type":"string","description":"The week’s commits on GitHub."},"highlights":{"type":"array","items":{"type":"object","additionalProperties":true,"description":"A commit of the week.","required":["subject","sha","committedAt","readAsCode"],"properties":{"subject":{"type":"string"},"sha":{"type":"string"},"committedAt":{"type":"string","format":"date-time","description":"When the commit was made."},"readAsCode":{"type":"boolean","description":"HEY read the commit as changing code; false = not read yet."},"url":{"type":"string"}}},"description":"Up to three commits, those HEY read as changing code first; never a bot’s, a merge’s or a documentation-only one."},"title":{"type":"string","description":"The one display title every HEY surface prints for the week."},"complete":{"type":"boolean","description":"Whether the week had ended when the response was made: false while `end` is still ahead."}}},"CatalogueCounts":{"type":"object","additionalProperties":true,"description":"The denominators behind the strict states: three of 3,600 reads as broken without the 3,600.","required":["verifiedBuilders","stillBuilding","underTheRadar"],"properties":{"verifiedBuilders":{"type":"integer","minimum":0,"description":"Published projects with the Verified Builder badge, on every chain HEY tracks."},"verifiedBuildersOnChain":{"type":"integer","minimum":0,"description":"The part of `verifiedBuilders` with evidence on `chainId`: the site’s \"verified builders on Robinhood Chain\"."},"published":{"type":"integer","minimum":0,"description":"Every published project."},"listedTokenOnly":{"type":"integer","minimum":0,"description":"The part of `published` that is a listed token with no builder evidence and no live market. Counted in `published`, never subtracted."},"chainId":{"type":"integer"},"asOf":{"type":"string","format":"date-time","description":"When these figures were counted."},"listScope":{"type":"string","enum":["published","robinhood_chain_verified_builders"],"description":"Which population the page’s `total` is over: a builder tab counts only the Robinhood Chain builders."},"definitions":{"type":"string","description":"Where each figure is defined."},"stillBuilding":{"type":"integer","minimum":0,"description":"Projects holding Still Building now."},"underTheRadar":{"type":"integer","minimum":0,"description":"Projects holding Under the Radar now."},"marketCoverage":{"$ref":"#/components/schemas/MarketCoverage"}}},"MarketCoverage":{"type":"object","additionalProperties":true,"description":"Present when the request named a market field: how many matching rows carry each figure.","required":["base","marketCap","liquidity","volume24h","liveMarket","activeMarket","verifiedToken","github","stage"],"properties":{"base":{"type":"integer","minimum":0,"description":"Rows under every non-market filter of the request."},"marketCap":{"type":"integer","minimum":0,"description":"Rows carrying a valuation."},"liquidity":{"type":"integer","minimum":0,"description":"Rows carrying liquidity."},"volume24h":{"type":"integer","minimum":0,"description":"Rows carrying a 24-hour volume."},"liveMarket":{"type":"integer","minimum":0,"description":"Tokens whose market is not gone."},"activeMarket":{"type":"integer","minimum":0,"description":"Tokens that actually traded in the last day."},"verifiedToken":{"type":"integer","minimum":0,"description":"Tokens the project names."},"github":{"type":"integer","minimum":0,"description":"Projects with a public repository HEY reads commits from."},"stage":{"type":"object","additionalProperties":true,"description":"Rows by launch stage.","required":["curve","graduated","dex"],"properties":{"curve":{"type":"integer"},"graduated":{"type":"integer"},"dex":{"type":"integer"}}}}},"DiscoveryGapWithheld":{"type":"string","enum":["no_token","market_not_live","token_not_the_projects","market_too_thin","active_pool_not_read","no_market_reading","no_build_momentum","activity_unknown"],"description":"Why a project has no Discovery Gap (hbm-v18): it is not measured, and this says why — never a zero. `market_too_thin`: the tracked token's market is not ACTIVE_MARKET (low liquidity, no trades in a day, insufficient data), is only a launch curve, or is ACTIVE_MARKET only as a launch pool (`launch_pool_trading`, \"Launch pool only\", hbm-v22), or (hbm-v31, 2026-10-18) its reading carries less than $1,000 of 24-hour volume, so a gap would measure the thin market, not the building. `activity_unknown` (hbm-v27, 2026-10-12): HEY cannot read the project's building (activity status UNKNOWN), so there is no building to set against the market. `active_pool_not_read` (hbm-v21): the market is active only because another pool of the same token holds the liquidity, and HEY holds no current reading of that pool — a rescued market is measured on that pool's reading, never on the token's own thin pool. Absent beside a gap, and on a score written before hbm-v18. The list may grow; an unknown value means not measured."},"StillBuildingWithheld":{"type":"string","enum":["market_not_live","token_not_the_projects","market_too_thin","valuation_not_plausible","no_token","active_pool_not_read","no_market_reading","activity_unknown","not_scored","no_tracked_high","builder_sources_unavailable"],"description":"Why Still Building was not measured (hbm-v19), sent beside `stillBuilding: false` — which keeps its meaning — so that a false is read as \"not measured\", never \"not met\". `market_too_thin`: the tracked token's market is not ACTIVE_MARKET, is only a launch curve, is ACTIVE_MARKET only as a launch pool (hbm-v22), or (hbm-v31) its reading carries less than $1,000 of 24-hour volume, so there is no drawdown HEY measures. `valuation_not_plausible` (hbm-v20): the valuation gate withheld the current valuation, so there is no current value to measure a drawdown against. `market_not_live`, `token_not_the_projects`: no live market, or none tied to the project. hbm-v21 (2026-10-01): `no_token` (no tracked token), `active_pool_not_read` (the market is active only in another pool of the token, and HEY holds no current reading of that pool), `no_market_reading` (no market reading from the last day), `activity_unknown` (no builder source HEY can read), and `not_scored` (no score under the current rules yet). 2026-10-16: `no_tracked_high` (a measured market with no plausible reading at least 7 days old to be the high). hbm-v31 (2026-10-18): `builder_sources_unavailable` (every repository, changelog and feed HEY reads the project's building from is unavailable, such as a repository answering 404), and `token_not_the_projects` also when the tracked token is unverified and another published project's token carries its ticker (the Discovery Gap's hbm-v30 withholding). Absent when it was measured. The list may grow; an unknown value means not measured."},"StillBuildingState":{"type":"string","enum":["HELD","NOT_HELD","NOT_MEASURED"],"description":"Still Building as three states (2026-09-30, additive), sent beside `stillBuilding` — which keeps its v1 meaning — wherever it appears. `HELD`: the badge is held. `NOT_HELD`: HEY measured it and the badge is not held. `NOT_MEASURED`: no score under the current rules yet, or the scorer withheld it (`stillBuildingWithheld` says why) — since hbm-v21 (2026-10-01) that includes a project with no tracked token, no current market reading, or building HEY cannot read, which read `NOT_HELD` for one day. A nullable `stillBuilding` waits for `/api/v2`."},"HeysOwnToken":{"type":"boolean","enum":[true],"description":"`true` on `$HEY`, HEY's own token, and absent on every other project (2026-09-30, additive). Show \"HEY’s own token — researched by the same rules\" beside it. HEY researches it by the same rules as every project: no ranking bonus and no demotion, and the flag is set after a page is ordered."},"Error":{"type":"object","required":["error","message","retryable"],"properties":{"error":{"type":"string","description":"A stable machine code."},"message":{"type":"string","description":"A sentence for a person."},"requestId":{"type":"string"},"retryable":{"type":"boolean"},"retryAfterSeconds":{"type":"integer"}}}},"responses":{"BadRequest":{"description":"The request was malformed.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"No published record answers this. A hidden project looks identical to one that never existed.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"RateLimited":{"description":"Too many requests; wait `retry-after` seconds. A spent monthly allowance is `quota`, retryable when the month resets.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"},"retry-after":{"description":"Seconds to wait before the next request.","schema":{"type":"integer","minimum":1}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"InternalError":{"description":"HEY failed; retryable.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unauthorized":{"description":"The API key is not valid (`unauthorized`), or a keyed-only form was called without one (`key_required`). Every read also answers without a key.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"The key or its account is held, or a partner key is not granted this route group (`forbidden`); `reason` says which.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"ServiceUnavailable":{"description":"The database was busy for a moment (`service_unavailable`); ask again after `retry-after` seconds.","headers":{"x-request-id":{"$ref":"#/components/headers/RequestId"},"x-hey-api-version":{"$ref":"#/components/headers/ApiVersion"},"ratelimit-limit":{"$ref":"#/components/headers/RateLimitLimit"},"ratelimit-policy":{"$ref":"#/components/headers/RateLimitPolicy"},"ratelimit-remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"x-hey-monthly-remaining":{"$ref":"#/components/headers/MonthlyRemaining"},"retry-after":{"description":"Seconds to wait before asking again.","schema":{"type":"integer","minimum":1}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"security":[{},{"bearerKey":[]},{"headerKey":[]}]}