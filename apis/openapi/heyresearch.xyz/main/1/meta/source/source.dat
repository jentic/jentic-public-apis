ing"}}},"ProjectSnapshot":{"type":"object","additionalProperties":true,"description":"One project in one call. See https://heyresearch.xyz/docs/public-api for every field. Absent means unknown, never zero.","required":["summary","identity","build","contracts","verification","locks","integrity","latestChanges","freshness","evidenceSummary","links","asOf","disclaimer"],"properties":{"summary":{"type":"object","additionalProperties":true,"description":"The Project Research Summary: the answer first; the sections below are its evidence."},"identity":{"type":"object","additionalProperties":true},"build":{"type":"object","additionalProperties":true},"market":{"type":"object","additionalProperties":true,"description":"Market context only. Market figures (price, valuation, liquidity, volume) never feed activity status, Build Momentum or the Radar. The Discovery Gap is the one place market attention enters: it compares Build Momentum against market attention, measured on an active market only (elsewhere it is withheld, never 0)."},"protocolEconomics":{"type":"object","additionalProperties":true},"developerFootprint":{"type":"object","additionalProperties":true},"onchain":{"type":"object","additionalProperties":true},"usage":{"type":"object","additionalProperties":true},"security":{"type":"object","additionalProperties":true,"description":"Context, never a safety verdict."},"peerContext":{"type":"object","additionalProperties":true},"contracts":{"type":"object","additionalProperties":true},"verification":{"type":"object","additionalProperties":true},"locks":{"type":"object","additionalProperties":true},"integrity":{"type":"object","additionalProperties":true},"latestChanges":{"type":"object","additionalProperties":true},"freshness":{"type":"array","items":{"type":"object","additionalProperties":true}},"coverage":{"type":"object","additionalProperties":true,"description":"Per dimension, a state, never a score."},"evidenceSummary":{"type":"object","additionalProperties":true},"