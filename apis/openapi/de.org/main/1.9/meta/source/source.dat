{
  "openapi": "3.0.3",
  "info": {
    "title": "DE App | Authflow",
    "version": "1.9",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Miragent/de-app-authflow/1.9"
  },
  "servers": [
    {
      "url": "https://api.de.org/"
    }
  ],
  "tags": [
    {
      "name": "PSP-Authentication-Flow",
      "description": "Groups all services governing the authentication and onboarding state machine executed between the PSP and the DE App. These endpoints orchestrate the start, progression, and completion of the authentication flow, including credential submission, challenge–response verification, OTP validation, redirect‑based authorization, and Terms & Conditions acceptance. The services ensure consistent multi‑step authentication, supporting both login and onboarding scenarios across embedded and redirect flows.\n"
    },
    {
      "name": "PSP-Devices-Management",
      "description": "Provides services for securely registering devices to PSP user accounts. The device binding process validates hardware identifiers and cryptographic attributes, establishing the device as a trusted instrument for authenticated operations.\n"
    },
    {
      "name": "PSP-Token-Management",
      "description": "Groups services handling the revocation of user tokens issued during the authentication and session lifecycle. These endpoints support both standard logout flows—revoking session tokens only—and full unsubscription flows requiring revocation of both session and long‑lived authentication tokens. The services ensure proper token invalidation and enforce secure termination of user sessions.\n"
    }
  ],
  "paths": {
    "/de-psp/v1.0/psps/{pspId}/auth/start": {
      "post": {
        "tags": [
          "PSP-Authentication-Flow"
        ],
        "summary": "Initiates the authentication state machine.",
        "description": "Starts a new authentication flow for the end user. The endpoint initializes the state machine and returns the first required step.\n",
        "operationId": "initiateAuthentication",
        "security": [
          {
            "AuthToken": []
          },
          {}
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-ID"
          },
          {
            "$ref": "#/components/parameters/pspId"
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AuthFlowStartLoginRequestModel"
                  },
                  {
                    "$ref": "#/components/schemas/AuthFlowStartOnboardRequestModel"
                  }
                ]
              },
              "examples": {
                "StartLoginRequestExample": {
                  "$ref": "#/components/examples/StartLoginRequestExample"
                },
                "StartOnboardingRequestExample": {
                  "$ref": "#/components/examples/StartOnboardingRequestExample"
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthFlowStartResponseModel"
                },
                "examples": {
                  "StartChallengeResponseExample": {
                    "$ref": "#/components/examples/StepChallengeResponseExample"
                  },
                  "StartLoginResponseExample": {
                    "$ref": "#/components/examples/StartLoginResponseExample"
                  },
                  "StartOnboardingResponseExample": {
                    "$ref": "#/components/examples/StartOnboardingResponseExample"
                  },
                  "StartRedirectResponseExample": {
                    "$ref": "#/components/examples/StartRedirectResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic400Error": {
                    "$ref": "#/components/examples/Generic400Error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic401Error": {
                    "$ref": "#/components/examples/Generic401Error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic500Error": {
                    "$ref": "#/components/examples/Generic500Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/de-psp/v1.0/psps/{pspId}/auth/step": {
      "post": {
        "tags": [
          "PSP-Authentication-Flow"
        ],
        "summary": "Executes the next step in the authentication state machine.",
        "description": "Advances the authentication flow by submitting the data required for the current state. The endpoint evaluates the provided input and returns the next step,  until the authentication process is successfully completed or terminated.\n",
        "operationId": "executeAuthenticationStep",
        "security": [
          {
            "AuthToken": []
          },
          {}
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/pspId"
          },
          {
            "$ref": "#/components/parameters/X-Request-ID"
          },
          {
            "$ref": "#/components/parameters/X-Flow-ID"
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/AuthFlowStepRequestModel"
              },
              "examples": {
                "StepChallengeRequestExample": {
                  "$ref": "#/components/examples/StepChallengeRequestExample"
                },
                "StepLoginRequestExample": {
                  "$ref": "#/components/examples/StepLoginRequestExample"
                },
                "StepOnbordingRequestExample": {
                  "$ref": "#/components/examples/StepOnbordingRequestExample"
                },
                "StepOtpRequestExample": {
                  "$ref": "#/components/examples/StepOtpRequestExample"
                },
                "StepRedirectRequestExample": {
                  "$ref": "#/components/examples/StepRedirectRequestExample"
                },
                "StepTermsAndConditionsRequestExample": {
                  "$ref": "#/components/examples/StepTermsAndConditionsRequestExample"
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthFlowStepResponseModel"
                },
                "examples": {
                  "StepCompletedResponseExample": {
                    "$ref": "#/components/examples/StepCompletedResponseExample"
                  },
                  "StepOtpResponseExample": {
                    "$ref": "#/components/examples/StepOtpResponseExample"
                  },
                  "StepTermsAndConditionsResponseExample": {
                    "$ref": "#/components/examples/StepTermsAndConditionsResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic400Error": {
                    "$ref": "#/components/examples/Generic400Error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic401Error": {
                    "$ref": "#/components/examples/Generic401Error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic500Error": {
                    "$ref": "#/components/examples/Generic500Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/de-psp/v1.0/psps/{pspId}/users/{userId}/devices": {
      "post": {
        "tags": [
          "PSP-Devices-Management"
        ],
        "summary": "Registers a device to a user account.",
        "description": "Binds a device to the user by registering its identifiers and cryptographic attributes. Once the binding is completed, the device is recognized as trusted and can be used for subsequent authenticated operations,  including offline‑enabled wallet functionalities.\n",
        "operationId": "registerDevice",
        "security": [
          {
            "SessionToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/pspId"
          },
          {
            "$ref": "#/components/parameters/userId"
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/DeviceBindingRequestModel"
              },
              "examples": {
                "DeviceBindingRequestExample": {
                  "$ref": "#/components/examples/DeviceBindingRequestExample"
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic400Error": {
                    "$ref": "#/components/examples/Generic400Error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic401Error": {
                    "$ref": "#/components/examples/Generic401Error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic500Error": {
                    "$ref": "#/components/examples/Generic500Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/de-app/v1.0/psps/{pspId}/users/{userId}/tokens/revoke": {
      "post": {
        "tags": [
          "PSP-Token-Management"
        ],
        "summary": "Revokes an active session or authentication token.",
        "description": "Revokes user tokens depending on the specified token type. The endpoint supports both simple logout operations (session token only) and service unsubscription flows (session token plus authentication token). The authentication token must be included only when performing a full unsubscription.\n",
        "operationId": "revokeToken",
        "security": [
          {
            "SessionToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-ID"
          },
          {
            "$ref": "#/components/parameters/pspId"
          },
          {
            "$ref": "#/components/parameters/userId"
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/TokenRevokeRequestModel"
              },
              "examples": {
                "TokenRevokeLogoutRequestExample": {
                  "$ref": "#/components/examples/TokenRevokeLogoutRequestExample"
                },
                "TokenRevokeUnsubscribeRequestExample": {
                  "$ref": "#/components/examples/TokenRevokeUnsubscribeRequestExample"
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic400Error": {
                    "$ref": "#/components/examples/Generic400Error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic401Error": {
                    "$ref": "#/components/examples/Generic401Error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorList"
                },
                "examples": {
                  "Generic500Error": {
                    "$ref": "#/components/examples/Generic500Error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "X-Flow-ID": {
        "name": "X-Flow-ID",
        "in": "header",
        "description": "Unique ID of the authentication process, generated by the PSP, to be referred in all steps of the process.",
        "required": true,
        "example": "d1d479b2-0e05-4f0e-843d-47a869e84304",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "X-Request-ID": {
        "name": "X-Request-ID",
        "in": "header",
        "description": "ID of the request, unique to the call, as determined by the initiating party.",
        "required": true,
        "example": "99391c7e-ad88-49ec-a2ad-99ddcb1f7721",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "pspId": {
        "name": "pspId",
        "in": "path",
        "description": "BICFI",
        "required": true,
        "example": "AAAADEBBXXX",
        "schema": {
          "type": "string",
          "pattern": "[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}"
        }
      },
      "userId": {
        "name": "userId",
        "in": "path",
        "description": "User identification in the DE ecosystem.",
        "required": true,
        "example": "dac9e98e-5f2f-469b-8fd7-5147ad06b5a3",
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "AuthToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication token, once obtained, it has a validity of six months as per alignment  with the PSD2 regulations. To be used in state CHALLENGE.  It can also be used in the start endpoint in scenarios where user is already onboarded.\n"
      },
      "SessionToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token provided upon successful authentication.  To be used during device binding and revoke endpoints.\n"
      }
    },
    "examples": {
      "DeviceBindingRequestExample": {
        "value": {
          "deviceId": "a1b2c3d4e5f6",
          "publicKey": "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...IDAQAB",
          "pushToken": "fcm_eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
          "deviceInfo": {
            "deviceResolution": "1080x2340",
            "appVersion": "3.4.1",
            "build": "20260211",
            "secureHardware": true,
            "deviceModel": "Pixel 8",
            "deviceBrand": "Google",
            "osName": "Android",
            "osVersion": "14"
          }
        }
      },
      "StartLoginRequestExample": {
        "value": {
          "deUserId": "0000000000000001",
          "termsAndConditionsLastAcceptedVersion": 1
        }
      },
      "StartLoginResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "LOGIN",
            "loginOutput": {
              "pspUserId": "PSP00000001"
            }
          }
        }
      },
      "StartOnboardingRequestExample": {
        "value": {
          "deAccountExists": false,
          "accountType": "ONLINE"
        }
      },
      "StartOnboardingResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "ONBOARD"
          }
        }
      },
      "StartRedirectResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "REDIRECT",
            "redirectOutput": {
              "pspRedirectUri": "https://example-psp.com"
            }
          }
        }
      },
      "StepChallengeRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "CHALLENGE",
            "challengeInput": {
              "deviceId": "a1b2c3d4e5f6",
              "encryptedChallenge": "QmY5d2tLT2tNVHBZb0l3R0NKTUdYUzloS3ZkUUtPb0N2Z0E9PQ"
            }
          }
        }
      },
      "StepChallengeResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "CHALLENGE",
            "challengeOutput": {
              "challenge": "dGhpcy1pcy1hLWNoYWxsZW5nZS1zdHJpbm"
            }
          }
        }
      },
      "StepCompletedResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "FINISHED",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "COMPLETED",
            "authenticationData": {
              "authToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
              "deUserId": "dac9e98e-5f2f-469b-8fd7-5147ad06b5a3",
              "sessionToken": "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI..."
            }
          }
        }
      },
      "StepLoginRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "LOGIN",
            "loginInput": {
              "pspUserId": "PSP00000001",
              "password": "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8",
              "deUserId": "dac9e98e-5f2f-469b-8fd7-5147ad06b5a3"
            }
          }
        }
      },
      "StepOnbordingRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "ONBOARD",
            "onboardInput": {
              "pspUserId": "PSP00000001",
              "password": "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"
            }
          }
        }
      },
      "StepOtpRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "OTP",
            "otpInput": {
              "otpCode": "123456"
            }
          }
        }
      },
      "StepOtpResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "OTP",
            "otpOutput": {
              "otpLabel": "You will receive an OTP code via SMS."
            }
          }
        }
      },
      "StepRedirectRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "AUTHORIZATION_CODE",
            "redirectAuthZCodeInput": {
              "authorizationCode": "Yzk5ZDczMzRlNDEwY",
              "codeVerifier": "pqSbZInhxUEfC94tx-paEpjyTf-FDMNZDj2TuAil0lY"
            }
          }
        }
      },
      "StepTermsAndConditionsRequestExample": {
        "value": {
          "nodeInput": {
            "status": "IN_PROGRESS",
            "state": "TERMSANDCONDITIONS",
            "termsAndConditionsInput": {
              "consents": [
                {
                  "consentId": "C1",
                  "accepted": true
                }
              ]
            }
          }
        }
      },
      "StepTermsAndConditionsResponseExample": {
        "value": {
          "status": "OK",
          "payload": {
            "status": "IN_PROGRESS",
            "flowId": "d1d479b2-0e05-4f0e-843d-47a869e84304",
            "state": "TERMSANDCONDITIONS",
            "termsAndConditionsOutput": {
              "termsAndConditionsContent": "Lorem ipsum dolor sit amet",
              "termsAndConditionsVersion": 1,
              "consents": [
                {
                  "consentId": "C1",
                  "label": "Lorem ipsum dolor sit amet",
                  "required": true
                }
              ]
            }
          }
        }
      },
      "TokenRevokeLogoutRequestExample": {
        "value": {
          "tokenType": "SESSION_TOKEN"
        }
      },
      "TokenRevokeUnsubscribeRequestExample": {
        "value": {
          "tokenType": "SESSION_TOKEN",
          "authToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        }
      },
      "GenericError": {
        "value": {
          "status": "KO",
          "errors": [
            {
              "reasonClass": "GENERIC_ERROR",
              "description": "An error has occurred"
            }
          ]
        }
      },
      "Generic400Error": {
        "value": {
          "status": "KO",
          "errors": [
            {
              "reasonClass": "INVALID_URL",
