              "description": "An internal error occurred"
            }
          ]
        }
      }
    },
    "schemas": {
      "AccountType": {
        "type": "string",
        "description": "Specifies the type of account the user intends to create during the onboarding process. The value determines the capabilities and operational mode associated with the resulting DE account.\n",
        "enum": [
          "ONLINE",
          "OFFLINE",
          "BOTH"
        ]
      },
      "AuthenticationDataModel": {
        "required": [
          "authToken",
          "deUserId",
          "sessionToken"
        ],
        "type": "object",
        "description": "Contains the authentication credentials issued upon successful completion of the authentication flow. The model aggregates identifiers and tokens required to perform subsequent authorized operations.\n",
        "properties": {
          "authToken": {
            "type": "string",
            "description": "Long-lived authentication token issued by the PSP. It is valid for six months in accordance with PSD2 security policies.\n"
          },
          "deUserId": {
            "type": "string",
            "description": "Unique identifier of the user within the DE system.\n"
          },
          "sessionToken": {
            "type": "string",
            "description": "Short-lived session token generated after authentication. It must be supplied during device binding and selected authenticated interactions.\n"
          }
        }
      },
      "AuthFlowStartLoginRequestModel": {
        "required": [
          "deUserId",
          "termsAndConditionsLastAcceptedVersion"
        ],
        "type": "object",
        "description": "Request model used to initiate the authentication flow in login scenarios. The PSP provides the DE user identifier and the last accepted Terms and Conditions version.\n",
        "properties": {
          "deUserId": {
            "type": "string",
            "description": "Identifier of the user within the DE ecosystem.\n"
          },
          "termsAndConditionsLastAcceptedVersion": {
            "type": "number",
            "description": "Version number of the Terms and Conditions previously accepted by the user. The value is used to determine whether a new consent presentation is required.\n"
          }
        }
      },
      "AuthFlowStartOnboardRequestModel": {
        "required": [
          "deAccountExists",
          "accountType"
        ],
        "type": "object",
        "description": "Request model used to initiate the authentication flow in onboarding scenarios.  It indicates whether a DE account already exists and specifies the type of  account being created based on the info provided by the user.\n",
        "properties": {
          "deAccountExists": {
            "type": "boolean",
            "description": "Indicates whether the user has already created a DE account prior to this onboarding attempt.\n"
          },
          "accountType": {
            "$ref": "#/components/schemas/AccountType"
          }
        }
      },
      "AuthFlowStartResponseModel": {
        "required": [
          "status",
          "payload"
        ],
        "type": "object",
        "description": "Response model returned when the authentication flow is initiated. Depending on PSP evaluation, the response indicates the next required step through a step-specific payload structure.\n",
        "properties": {
          "links": {
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "warnings": {
            "type": "array",
            "description": "Optional warnings providing additional context without blocking processing.\n",
            "items": {
              "$ref": "#/components/schemas/ResponseWarningModel"
            }
          },
          "payload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AuthStartChallengeResponseModel"
              },
              {
                "$ref": "#/components/schemas/AuthStartLoginResponseModel"
              },
              {
                "$ref": "#/components/schemas/AuthStartOnboardResponseModel"
              },
              {
                "$ref": "#/components/schemas/AuthStartRedirectResponseModel"
              }
            ],
            "description": "Payload describing the next state in the authentication procedure         \n"
          }
        }
      },
      "AuthFlowStepRequestModel": {
        "type": "object",
        "required": [
          "nodeInput"
        ],
        "description": "Generic wrapper model used to submit the input for the current step of the authentication flow. The structure of the input varies based on the specific state being executed.\n",
        "properties": {
          "nodeInput": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AuthStepChallengeRequestModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepLoginRequestModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepOnboardRequestModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepOtpRequestModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepRedirectRequestModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepTermsAndConditionsRequestModel"
              }
            ],
            "description": "Contains the input parameters applicable to the current state of the state machine.\n"
          }
        }
      },
      "AuthFlowStepResponseModel": {
        "type": "object",
        "required": [
          "status",
          "payload"
        ],
        "description": "Generic wrapper model returned after processing a step in the authentication flow. Depending on the evaluated state, the payload describes the next action required from the user or the terminal state of the procedure.\n",
        "properties": {
          "links": {
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "warnings": {
            "type": "array",
            "description": "Optional warnings providing non-blocking advisory information.\n",
            "items": {
              "$ref": "#/components/schemas/ResponseWarningModel"
            }
          },
          "payload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AuthStepCompletedResponseModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepOtpResponseModel"
              },
              {
                "$ref": "#/components/schemas/AuthStepTermsAndConditionsResponseModel"
              }
            ],
            "description": "Payload describing the next actionable state of the flow.\n"
          }
        }
      },
      "AuthStepChallengeRequestModel": {
        "type": "object",
        "required": [
          "state",
          "challengeInput"
        ],
        "description": "Input model used when the current authentication step requires the execution of a challenge–response validation. The client must provide the encrypted challenge generated using the device's private key.  *state* must be set to CHALLENGE when submitting this request type.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "challengeInput": {
            "$ref": "#/components/schemas/ChallengeRequestModel"
          }
        }
      },
      "AuthStartChallengeResponseModel": {
        "type": "object",
        "required": [
          "flowId",
          "state",
          "challengeOutput"
        ],
        "description": "Response model used when the authentication flow transitions to a CHALLENGE step. The server provides a new challenge to be processed by the client. *state* shall always be set to CHALLENGE for this response type.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier assigned to the user's authentication flow.\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "challengeOutput": {
            "$ref": "#/components/schemas/ChallengeResponseModel"
          }
        }
      },
      "AuthStepCompletedResponseModel": {
        "required": [
          "flowId",
          "state",
          "authenticationData"
        ],
        "type": "object",
        "description": "Terminal response model indicating that the authentication process has been successfully completed. The response includes the credentials needed to authorize subsequent operations. *state* shall always be set to COMPLETED for this response type.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier assigned to the user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "authenticationData": {
            "$ref": "#/components/schemas/AuthenticationDataModel"
          }
        }
      },
      "AuthStepLoginRequestModel": {
        "required": [
          "state",
          "loginInput"
        ],
        "type": "object",
        "description": "Input model used when the authentication step requires login credentials. *state* must be set to LOGIN when submitting this request type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "loginInput": {
            "$ref": "#/components/schemas/LoginRequestModel"
          }
        }
      },
      "AuthStartLoginResponseModel": {
        "required": [
          "flowId",
          "state",
          "loginOutput"
        ],
        "type": "object",
        "description": "Response model used when the authentication flow requires explicit login credentials due to an expired or invalid authentication token. *state* shall always be set to LOGIN for this response type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier for each user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "loginOutput": {
            "$ref": "#/components/schemas/LoginResponseModel"
          }
        }
      },
      "AuthStepOnboardRequestModel": {
        "required": [
          "state",
          "onboardInput"
        ],
        "type": "object",
        "description": "Input model used when the user must provide onboarding credentials, typically in first‑time embedded registration scenarios. *state* must be set to ONBOARD when submitting this request type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "onboardInput": {
            "$ref": "#/components/schemas/OnboardRequestModel"
          }
        }
      },
      "AuthStartOnboardResponseModel": {
        "required": [
          "flowId",
          "state"
        ],
        "type": "object",
        "description": "Response model used when the flow transitions to an ONBOARD step,  typically this applies to an embedded scenario. *state* shall always be set to ONBOARD for this response type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier for each user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          }
        }
      },
      "AuthStepOtpRequestModel": {
        "required": [
          "state",
          "otpInput"
        ],
        "type": "object",
        "description": "Input model used when the authentication step requires submission of a one‑time password (OTP). *state* must be set to OTP when submitting this request type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "otpInput": {
            "$ref": "#/components/schemas/OtpRequestModel"
          }
        }
      },
      "AuthStepOtpResponseModel": {
        "required": [
          "flowId",
          "state",
          "otpOutput"
        ],
        "type": "object",
        "description": "Response model issued when the flow requires OTP verification. *state* shall always be set to OTP for this response type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier for each user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "otpOutput": {
            "$ref": "#/components/schemas/OtpResponseModel"
          }
        }
      },
      "AuthStepRedirectRequestModel": {
        "required": [
          "state",
          "redirectAuthZCodeInput"
        ],
        "type": "object",
        "description": "Input model used when the authentication flow requires submission of an authorization code obtained through a PSP redirect authentication step. *state* must be set to REDIRECT when submitting this request type. Only for redirect scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "redirectAuthZCodeInput": {
            "$ref": "#/components/schemas/RedirectRequestModel"
          }
        }
      },
      "AuthStartRedirectResponseModel": {
        "required": [
          "flowId",
          "state",
          "redirectOutput"
        ],
        "type": "object",
        "description": "Response model used when the authentication flow redirects the user to the PSP to complete authentication. It provides the redirection URI or related metadata. *state* shall always be set to REDIRECT for this response type. Only for redirect scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier for each user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "redirectOutput": {
            "$ref": "#/components/schemas/RedirectResponseModel"
          }
        }
      },
      "AuthStepTermsAndConditionsRequestModel": {
        "required": [
          "state",
          "termsAndConditionsInput"
        ],
        "type": "object",
        "description": "Input model used when the authentication flow requires acceptance of the PSP's Terms and Conditions. *state* must be set to TERMSANDCONDITIONS when submitting this request type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "termsAndConditionsInput": {
            "$ref": "#/components/schemas/TermsAndConditionsRequestModel"
          }
        }
      },
      "AuthStepTermsAndConditionsResponseModel": {
        "required": [
          "flowId",
          "state",
          "termsAndConditionsOutput"
        ],
        "type": "object",
        "description": "Response model used when the Terms and Conditions must be displayed to or reviewed by the user. Depending on the PSP logic, authentication data may be returned once the step is successfully completed. *state* shall always be set to TERMSANDCONDITIONS for this response type. Only for embedded scenarios.\n",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the current execution status of the flow (e.g., IN_PROGRESS, CANCELED).\n"
          },
          "flowId": {
            "type": "string",
            "description": "Unique identifier for each user's authentication flow."
          },
          "state": {
            "$ref": "#/components/schemas/StateValues"
          },
          "termsAndConditionsOutput": {
            "$ref": "#/components/schemas/TermsAndConditionsResponseModel"
          }
        }
      },
      "ChallengeRequestModel": {
        "required": [
          "deviceId",
          "encryptedChallenge"
        ],
        "type": "object",
        "description": "Model containing the client-side data required to execute the challenge–response procedure.  The client must encrypt the server-provided challenge together with device identification parameters.\n",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Unique identifier of the user's application instance on the device."
          },
          "encryptedChallenge": {
            "type": "string",
            "description": "String made of server supplied challenge, deviceId and authToken. This string must be encrypted with client's private key and returned to the server as additional safety measure during the authentication process to verify device posession."
          }
        }
      },
      "ChallengeResponseModel": {
        "required": [
          "challenge"
        ],
        "type": "object",
        "description": "Model returned by the server containing the challenge that must be processed by  the client for device and possession‑factor verification.\n",
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Challenge issued by the server. The client must encrypt it using its private key along with the deviceId and the authToken."
          }
        }
      },
      "DeviceBindingRequestModel": {
        "required": [
          "deviceId",
          "publicKey"
        ],
        "type": "object",
        "description": "Model used to register or bind a device to a user account.  The binding operation establishes cryptographic trust between the device and the PSP  by exchanging a long-term public key and device identifiers.\n",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Unique identifier of the user's application instance on the device."
          },
          "publicKey": {
            "type": "string",
            "description": "Public key associated with the device. It is used for cryptographic verification during challenge–response procedures."
          },
          "pushToken": {
            "type": "string",
            "description": "Token used to deliver push notifications to the device."
          },
          "deviceInfo": {
            "$ref": "#/components/schemas/DeviceExtraInfo"
          }
        }
      },
      "DeviceExtraInfo": {
        "description": "Collection of device attributes used for security posture checks and to ensure  compliance with PSP technical requirements.\n",
        "type": "object",
        "properties": {
          "deviceResolution": {
            "type": "string",
            "description": "Resolution of device screen."
          },
          "appVersion": {
            "type": "string",
            "description": "App version currently installed on device."
          },
          "build": {
            "type": "string",
            "description": "Progressive number of app build, related to app version."
          },
          "secureHardware": {
            "type": "boolean",
            "description": "Indicates whether the device provides hardware-backed security features."
          },
          "deviceModel": {
            "type": "string",
            "description": "Commercial model name of the device."
          },
          "deviceBrand": {
            "type": "string",
            "description": "Manufacturer or brand name of the device."
          },
          "osName": {
            "type": "string",
            "description": "Name of the OS running on the device."
          },
          "osVersion": {
            "type": "string",
            "description": "Version of OS currently installed on device."
          }
        }
      },
      "LoginRequestModel": {
        "required": [
          "pspUserId",
          "password"
        ],
        "type": "object",
        "description": "Credentials required to authenticate the user during the LOGIN step.\n",
        "properties": {
          "pspUserId": {
            "type": "string",
            "description": "User identifier in PSP system."
          },
          "password": {
            "type": "string",
            "description": "User password in PSP system."
          },
          "deUserId": {
            "type": "string",
            "description": "User identifier in DE system."
          }
        }
      },
      "LoginResponseModel": {
        "required": [
          "pspUserId"
        ],
        "type": "object",
        "description": "Model returned following a login step containing user identification details relevant  to subsequent steps of the authentication procedure.\n",
        "properties": {
          "pspUserId": {
            "type": "string",
            "description": "PSP-specific identifier of the authenticated user."
          }
        }
      },
      "OnboardRequestModel": {
        "required": [
          "pspUserId",
          "password"
        ],
        "type": "object",
        "description": "Credentials provided by a user who is onboarding into the DE ecosystem.",
        "properties": {
          "pspUserId": {
            "type": "string",
            "description": "User identifier in PSP system."
          },
          "password": {
            "type": "string",
            "description": "User password in PSP system."
          }
        }
      },
      "OtpRequestModel": {
        "required": [
          "otpCode"
        ],
        "type": "object",
        "description": "Contains the one-time password issued to the user via the PSP's secure OTP delivery mechanism.\n",
        "properties": {
          "otpCode": {
            "type": "string",
            "description": "One-time password supplied by the user for verification."
          }
        }
      },
      "OtpResponseModel": {
        "required": [
          "otpLabel"
        ],
        "type": "object",
        "description": "Model providing PSP-specific information or messaging related to OTP validation.",
        "properties": {
          "otpLabel": {
            "type": "string",
            "description": "PSP information on its own OTP procedure."
          }
        }
      },
      "RedirectRequestModel": {
        "required": [
          "authorizationCode",
          "codeVerifier"
        ],
        "type": "object",
        "description": "Model containing the parameters required to exchange a PSP-provided authorization code for  an authentication token, typically obtained following a redirect-based scenario.\n",
        "properties": {
          "authorizationCode": {
            "type": "string",
            "description": "Authorization code issued by the PSP to be exchanged for an authentication token."
          },
          "codeVerifier": {
            "type": "string",
            "description": "A cryptographically random string that is used to correlate the login step to the token request.  The PSP can match the *codeChallenge* received during the login with the string derived from the  *codeChallengeMethod* applied to the *codeVerifier*.\n"
          }
        }
      },
      "RedirectResponseModel": {
        "required": [
          "pspRedirectUri"
        ],
        "type": "object",
        "description": "Model containing the redirection endpoint provided by the PSP. The client must redirect  the user-agent to this URI to continue the authentication process.\n",
        "properties": {
          "pspRedirectUri": {
            "type": "string",
            "description": "PSP URI on which user should be redirected to complete the authentication process."
          }
        }
      },
      "ResponseErrorList": {
        "required": [
          "status",
          "errors"
        ],
        "type": "object",
        "description": "Standardized error container returned when a request cannot be successfully processed. The structure conforms to a multi‑error reporting model where each entry describes a specific failure reason.\n",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseErrorModel"
            }
          }
        }
      },
      "ResponseErrorModel": {
        "required": [
          "reasonClass",
          "description"
        ],
        "type": "object",
        "description": "Provides detailed information about a single error occurrence encountered during request evaluation.\n",
        "properties": {
          "reasonClass": {
            "type": "string",
            "description": "Machine‑readable error identifier categorizing the nature of the failure.\n"
          },
          "reasonCode": {
            "type": "string",
            "description": "Machine‑readable error identifier that classifies the nature of the failure within the PSP's system.  Used when the PSP opts to provide a customized reason code.\n"
          },
          "description": {
            "type": "string",
            "description": "Human‑readable explanation of the error condition.\n"
          },
          "param": {
            "type": "string",
            "description": "Optional parameter providing context or additional information related to the error (e.g., field names, limits, identifiers).\n"
          }
        }
      },
      "ResponseStatus": {
        "type": "string",
        "description": "Indicates the overall result of a request. The value is OK for successful operations and KO for requests that produced errors.\n",
        "enum": [
          "OK",
          "KO"
        ]
      },
      "ResponseWarningModel": {
        "required": [
          "reasonClass",
          "description"
        ],
        "type": "object",
        "description": "Defines the details of a single warning raised during evaluation of the request. Each warning provides a machine-readable identifier and a human-readable explanation describing the condition encountered.\n",
        "properties": {
          "reasonClass": {
            "type": "string",
            "description": "Machine-readable warning identifier categorizing the specific condition detected  during processing.\n"
          },
          "reasonCode": {
            "type": "string",
            "description": "Machine‑readable error identifier that classifies the specific condition detected  during processing within the PSP's system.  Used when the PSP opts to provide a customized reason code.\n"
          },
          "description": {
            "type": "string",
            "description": "Human-readable explanation describing the nature and implications of the warning.\n"
          },
          "param": {
            "type": "string",
            "description": "Optional contextual information associated with the warning, such as affected fields, constraint values, or related identifiers.\n"
          }
        }
      },
      "StateValues": {
        "type": "string",
        "description": "Enumerates the possible states in the authentication state machine. Each value represents a distinct step in the user authentication or onboarding process.\n",
        "enum": [
          "LOGIN",
          "ONBOARD",
          "REDIRECT",
          "OTP",
          "TERMSANDCONDITIONS",
          "CHALLENGE",
          "COMPLETED",
          "AUTHORIZATION_CODE"
        ]
      },
      "TermsAndConditionsRequestModel": {
        "required": [
          "accepted"
        ],
        "type": "object",
        "description": "Request model used to submit the user's acceptance of the PSP's terms and conditions, along with the consent details associated with them.",
        "properties": {
          "consents": {
            "type": "array",
            "description": "List of consents related to the terms and conditions that the user is accepting or declining.",
            "items": {
              "$ref": "#/components/schemas/TermsAndConditionsConsentsRequestModel"
            }
          }
        }
      },
      "TermsAndConditionsResponseModel": {
        "required": [
          "termsAndConditionsContent",
          "termsAndConditionsVersion"
        ],
        "type": "object",
        "description": "Response model providing the PSP's terms and conditions information, including the content, version, and the list of associated consents.",
        "properties": {
          "termsAndConditionsContent": {
            "type": "string",
            "description": "Full content of the PSP's terms and conditions"
          },
          "termsAndConditionsVersion": {
            "type": "number",
            "description": "Current version number of the PSP's terms and conditions."
          },
          "consents": {
            "type": "array",
            "description": "List of consents associated with the terms and conditions, including information such as labels and whether each consent is mandatory.",
            "items": {
              "$ref": "#/components/schemas/TermsAndConditionsConsentsResponseModel"
            }
          }
        }
      },
      "TermsAndConditionsConsentsRequestModel": {
        "type": "object",
        "description": "Model describing a consent provided by the user as part of the terms and conditions acceptance process.",
        "properties": {
          "consentId": {
            "type": "string",
            "description": "Identifier of the specific consent."
          },
          "accepted": {
            "type": "boolean",
            "description": "Indicates whether the user has accepted (true) or declined (false) the consent."
          }
        }
      },
      "TermsAndConditionsConsentsResponseModel": {
        "type": "object",
        "description": "Model representing the details of a consent returned as part of the terms and conditions information.",
        "properties": {
          "consentId": {
            "type": "string",
            "description": "Identifier of the specific consent."
          },
          "label": {
            "type": "string",
            "description": "Display label or description of the consent."
          },
          "required": {
            "type": "boolean",
            "description": "Indicates whether the consent must be accepted in order to proceed."
          }
        }
      },
      "TokenRevokeRequestModel": {
        "required": [
          "tokenType"
        ],
        "type": "object",
        "description": "Request model used to revoke an existing token. The revocation may refer to either a session token or an authentication token, depending on the value specified in *tokenType*. When the revocation is related to unsubscription processes, the *authToken* field must also be provided.",
        "properties": {
          "tokenType": {
            "$ref": "#/components/schemas/TokenTypes"
          },
          "authToken": {
            "type": "string",
            "description": "Authentication token associated with the user. It must be provided only when the revocation is related to unsubscription processes."
          }
        }
      },
      "TokenTypes": {
        "type": "string",
        "description": "Enumeration that identifies the type of token that can be revoked through the dedicated endpoint.",
        "enum": [
          "SESSION_TOKEN",
          "AUTH_TOKEN"
        ]
      }
    }
  }
}
