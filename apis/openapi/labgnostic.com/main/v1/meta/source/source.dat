          "analyteCodes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the analyte.",
            "maxLength": 100,
            "minLength": 1,
            "nullable": false
          },
          "type": {
            "description": "Indicates whether the analyte produces quantitative or qualitative results.",
            "nullable": false,
            "oneOf": [
              {
                "$ref": "#/components/schemas/AnalyteType"
              }
            ]
          },
          "analyteCodes": {
            "type": "array",
            "minLength": 1,
            "nullable": false,
            "items": {
              "$ref": "#/components/schemas/ProgrammeAnalyteCodeRequestContract"
            }
          },
          "isDefault": {
            "type": "boolean",
            "description": "Whether this programme analyte will be used on future assessment events by default."
          },
          "resultCodes": {
            "type": "array",
            "description": "Result codes to associate with this programme analyte.",
            "items": {
              "$ref": "#/components/schemas/ProgrammeAnalyteResultCodesContract"
            }
          }
        }
      },
      "ProgrammeAnalyteCodeRequestContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Code to uniquely identify the analyte within a provider.",
            "maxLength": 100,
            "minLength": 1,
            "nullable": false
          },
          "codingSystem": {
            "type": "string",
            "description": "Coding system for the analyte.",
            "maxLength": 20,
            "minLength": 0,
            "nullable": true
          },
          "unit": {
            "type": "string",
            "description": "Units accepted for results received from labs.\nThis can be either ID ('10000'), or alias ('umol/L').\nThe available global list of units of measure can be retrieved via the `/globals/units-of-measure` endpoint.",
            "nullable": true
          }
        }
      },
      "UnitOfMeasureVm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UnitOfMeasureId"
          },
          "code": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UnitOfMeasureId": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AssessmentEventResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assessmentEventCode": {
            "type": "string",
            "description": "Code to uniquely identify the assessment event within a programme."
          },
          "startDateTime": {
            "type": "string",
            "description": "Date time the assessment event starts.",
            "format": "date-time"
          },
          "endDateTime": {
            "type": "string",
            "description": "Date time the assessment event ends.",
            "format": "date-time"
          },
          "challenges": {
            "type": "array",
            "description": "Challenges on the assessment event.",
            "items": {
              "$ref": "#/components/schemas/ChallengeContract"
            }
          }
        }
      },
      "ChallengeContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "specimens"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Code used to label the specimens on the challenge.\nAll challenges on an assessment event must have unique codes.\nA programme analyte can only be configured once on a challenge.",
            "maxLength": 50,
            "minLength": 1,
            "nullable": false
          },
          "specimens": {
            "type": "array",
            "description": "Specimens that are part of the challenge.",
            "minLength": 1,
            "nullable": false,
            "items": {
              "$ref": "#/components/schemas/SpecimenContract"
            }
          }
        }
      },
      "SpecimenContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "typeCode",
          "analytes"
        ],
        "properties": {
          "typeCode": {
            "type": "string",
            "description": "Providers' code to uniquely identify the type of specimen material.\nThe codes allowed here must be configured within the UI against the global list of specimen type codes.\nIn future these codes may be configurable by the API.",
            "minLength": 1,
            "nullable": false
          },
          "analytes": {
            "type": "array",
            "description": "Analytes that are being tested for on this specimen.\nIf no analytes are provided all active programme analytes will be associated with this specimen.",
            "minLength": 1,
            "nullable": false,
            "items": {
              "$ref": "#/components/schemas/AnalyteContract"
            }
          },
          "demographic": {
            "description": "The demographic data associated with this specimen.",
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/DemographicContract"
              }
            ]
          }
        }
      },
      "AnalyteContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Code to uniquely identify the analyte within a provider.\nAn analyte must reference an active analyte on the programme.\nAn analyte can only be referenced once within a challenge.",
            "minLength": 1,
            "nullable": false
          }
        }
      },
      "DemographicContract": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "description": "The date of birth associated with this specimen.",
            "format": "date",
            "nullable": true
          },
          "genderId": {
            "type": "integer",
            "description": "The ID of the gender associated with this specimen.",
            "format": "int32",
            "nullable": true
          },
          "forenames": {
            "type": "string",
            "description": "Forenames associated with this specimen.",
            "maxLength": 50,
            "minLength": 0,
            "nullable": true
          },
          "surname": {
            "type": "string",
            "description": "Surname associated with this specimen.",
            "maxLength": 50,
            "minLength": 0,
            "nullable": true
          },
          "id": {
            "type": "string",
            "description": "The patient ID associated with this specimen.",
            "maxLength": 64,
            "minLength": 0,
            "nullable": true
          },
          "idType": {
            "type": "string",
            "description": "The type of patient ID associated with this specimen.\nCurrently, the following values are supported:\n1. 'Local' or '0'\n2. 'NHS Number' or '1'\n3. 'CHI Number' or '2'",
            "nullable": true
          },
          "specimenCollectionTime": {
            "type": "string",
            "description": "The date time the specimen was collected.",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ListAssessmentEventsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListQueryResponse"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assessmentEvents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AssessmentEventResponse"
                }
              }
            }
          }
        ]
      },
      "ListQueryResponse": {
        "type": "object",
        "x-abstract": true,
        "additionalProperties": false,
        "properties": {
          "pagination": {
            "description": "Metadata related to how the response has been paginated.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/OffsetPaginatedResponse"
              }
            ]
          }
        }
      },
      "OffsetPaginatedResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageIndex": {
            "type": "integer",
            "description": "The index of the page returned in the paginated result set.\nThis can be used in the subsequent request to fetch the next page using the 'pageIndex' query parameter.",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "The maximum number of items that could have been returned in the paginated result set.\nIf the number of items returned is less than this number there are no more items remaining in the result set.",
            "format": "int32"
          },
          "totalPageCount": {
            "type": "integer",
            "description": "The number of pages with results.",
            "format": "int32"
          }
        }
      },
      "ListAssessmentEventsRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OffsetPaginatedRequest"
          },
          {
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "OffsetPaginatedRequest": {
        "type": "object",
        "additionalProperties": false
      },
      "UpsertAssessmentEventsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assessmentEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentEventResponse"
            }
          }
        }
      },
      "AssessmentEventRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenges"
        ],
        "properties": {
          "startDate": {
            "type": "string",
            "description": "Date on which the assessment event starts (by default at 06:00AM).",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "Date on which the assessment event ends (by default at 11:59PM).",
            "format": "date"
          },
          "challenges": {
            "type": "array",
            "description": "Challenges on the assessment event.",
            "minLength": 1,
            "nullable": false,
            "items": {
              "$ref": "#/components/schemas/ChallengeContract"
            }
          }
        }
      },
      "AssessmentEventsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assessmentEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentEventRequestContract"
            }
          }
        }
      },
      "AssessmentEventRequestContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessmentEventCode",
          "challenges"
        ],
        "properties": {
          "assessmentEventCode": {
            "type": "string",
            "description": "Code to uniquely identify the assessment event within a programme.",
            "maxLength": 100,
            "minLength": 1,
            "nullable": false
          },
          "startDate": {
            "type": "string",
            "description": "Date when the assessment event starts.",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "Date when the assessment event ends.",
            "format": "date"
          },
          "challenges": {
            "type": "array",
            "description": "Challenges on the assessment event.",
            "minLength": 1,
            "nullable": false,
            "items": {
              "$ref": "#/components/schemas/ChallengeContract"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "JWTBearerAuth": {
        "type": "http",
        "description": "Enter a JWT token to authorize the requests...",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
