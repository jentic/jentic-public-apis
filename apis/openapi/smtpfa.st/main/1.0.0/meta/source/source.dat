            "description": "The updated property",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "contact_property"
                  ],
                  "properties": {
                    "contact_property": {
                      "$ref": "#/components/schemas/ContactProperty"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid default, or an attempt to change key or type"
          },
          "404": {
            "description": "Not found"
          }
        },
        "x-sdk-group": [
          "contactProperties"
        ],
        "x-sdk-method": "update"
      },
      "delete": {
        "operationId": "deleteContactProperty",
        "summary": "Delete a contact property",
        "description": "Removes the declaration only. Contact values stay where they are, so re-declaring the key finds them again.",
