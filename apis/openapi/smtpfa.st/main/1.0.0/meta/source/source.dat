    "/v1/forms/{id}/pending/{pendingId}/approve": {
      "post": {
        "operationId": "approvePendingSignup",
        "summary": "Approve a pending signup",
        "description": "Confirm one pending signup without waiting for the link click. It becomes a contact, fires contact.subscribed and gets the welcome email if enabled. Approving one that is already confirmed returns 200 with already_confirmed. Returns 409 when the form is no longer active. Requires the form:write scope.",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The signup form ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pendingId",
            "in": "path",
            "required": true,
            "description": "The pending signup ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "approved",
                    "email"
                  ],
                  "properties": {
                    "approved": {
                      "type": "boolean",
                      "example": true
                    },
                    "contact_id": {
                      "type": "string",
                      "example": "clx_contact123"
                    },
                    "email": {
                      "type": "string",
                      "example": "jane@example.com"
                    },
                    "already_confirmed": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - domain not verified or insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - the resource already exists or changed meanwhile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - retry after the period indicated in the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
