    "/v1/me": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "What this API key can do",
        "description": "The key's scopes, the user who created it, its team, the plan tier, the rate limit, and which send-time safety checks apply to the account. Requires no scope: it exists so a client can plan its calls instead of discovering scopes through 403s.",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Key and account capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_key_id",
                    "user_id",
                    "scopes",
                    "team_id",
                    "team_sending_status",
                    "account",
                    "send_checks",
                    "rate_limit"
                  ],
                  "properties": {
                    "api_key_id": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string",
                      "description": "The user who created the key. Matches user_id on GET /v1/team/members."
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "email:send",
                        "domain:read"
                      ]
                    },
                    "team_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "team_sending_status": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": "active"
                    },
                    "account": {
                      "type": "object",
                      "properties": {
                        "tier": {
