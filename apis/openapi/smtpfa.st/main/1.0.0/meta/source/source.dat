          "inboxes",
          "drafts"
        ],
        "x-sdk-method": "send"
      }
    },
    "/v1/contact-properties": {
      "get": {
        "operationId": "listContactProperties",
        "summary": "List contact properties",
        "description": "The custom fields this team has declared, with their types and defaults.",
        "tags": [
          "Contacts"
        ],
        "responses": {
          "200": {
            "description": "The declared properties",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContactProperty"
                      }
                    }
                  }
