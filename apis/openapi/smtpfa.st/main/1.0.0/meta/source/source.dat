      "get": {
        "operationId": "listContacts",
        "summary": "List contacts",
        "description": "Return contacts for the current account. Optional query parameters q, status, and limit support filtering.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search by email, first name, or last name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by subscription status",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "subscribed",
                "unsubscribed"
              ],
              "default": "all"
            }
          },
          {
            "name": "disposable",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Only contacts on throwaway-mailbox domains (true) or only the rest (false)"
          },
          {
            "name": "segment_id",
            "in": "query",
            "description": "Filter contacts by manual segment",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of contacts to return",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
