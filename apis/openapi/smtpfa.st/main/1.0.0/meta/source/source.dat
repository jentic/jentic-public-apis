    "/v1/inboxes/{inbox_id}/threads": {
      "get": {
        "operationId": "listInboxThreads",
        "summary": "List threads",
        "description": "Threads in one folder, most recently active first. query matches the subject and label names (case-insensitive, up to 256 characters); label filters to threads carrying any of the given label ids. read is true only when every message is read; it follows the same read state as the received email API. folder, unread_count and snippet are not in Resend. Requires the inbound:read scope.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "description": "The inbox id or its email address",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "folder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "inbox",
                "archive",
                "spam",
                "sent",
                "trash"
              ],
              "default": "inbox"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "description": "Label ids; repeat the parameter or separate with commas"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
