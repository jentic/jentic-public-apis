    "/v1/broadcasts/{id}/recipients": {
      "get": {
        "operationId": "listBroadcastRecipients",
        "summary": "List broadcast recipients",
        "description": "Resend-compatible: recipients of a broadcast for one event type (sent, delivered, opened, clicked, bounced, complained, unsubscribed, suppressed), newest first, with after/before cursors. Each has contact_id; opened and clicked add count, clicked adds clicked_links, bounced adds bounce_type. Without type, every recipient (not in Resend). Requires the email:read scope.",
        "tags": [
          "Broadcasts"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The broadcast ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "sent",
                "delivered",
                "opened",
                "clicked",
                "bounced",
                "complained",
                "unsubscribed",
                "suppressed"
              ]
            }
          },
          {
            "name": "bounce_type",
            "in": "query",
            "description": "With type=bounced only",
            "schema": {
              "type": "string",
              "enum": [
                "permanent",
                "transient",
                "undetermined"
              ]
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Recipients whose address contains this text",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Return recipients after this recipient ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Return recipients before this recipient ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recipients",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
