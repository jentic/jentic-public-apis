    "/v1/emails/receiving": {
      "get": {
        "operationId": "listReceivedEmails",
        "summary": "List received emails",
        "description": "Received emails for the team, newest first, with keyset pagination (after walks older, before walks newer, exclusive). List items carry metadata only; fetch one email for the body. Requires the inbound:read scope.",
        "tags": [
          "Receiving"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return emails older than this id"
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return emails newer than this id"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only mail received for this address (not in Resend)"
          },
          {
            "name": "domain_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only mail received on this domain (not in Resend)"
          },
          {
            "name": "unread",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "true for unread mail only (not in Resend)"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "description": "Search subject, sender and recipient (not in Resend)"
          }
        ],
        "responses": {
          "200": {
            "description": "Received emails",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReceivedEmailSummary"
                      }
                    },
                    "unread_count": {
                      "type": "integer",
                      "description": "Unread emails matching the same to, domain_id and q filters (not in Resend)"
                    }
