        },
        "x-sdk-group": [
          "contactProperties"
        ],
        "x-sdk-method": "list"
      },
      "post": {
        "operationId": "createContactProperty",
        "summary": "Declare a contact property",
        "description": "Declare a custom field. Declaring is optional: contacts may carry undeclared properties, and those keep working. Declaring gives the field a default used when a contact has no value, and opts writes to it into type checking.",
        "tags": [
          "Contacts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "type"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                    "example": "plan"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number"
                    ]
                  },
                  "fallback_value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Used when a contact has no value"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The declared property",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "contact_property"
                  ],
                  "properties": {
                    "contact_property": {
                      "$ref": "#/components/schemas/ContactProperty"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid key, type or default"
          },
          "409": {
            "description": "Already declared"
          }
        },
        "x-sdk-group": [
          "contactProperties"
        ],
        "x-sdk-method": "create"
      }
    },
    "/v1/contact-properties/{id}": {
      "get": {
