    "/v1/templates/{id}/publish": {
      "post": {
        "operationId": "publishTemplate",
        "summary": "Publish a template",
        "description": "Publish the current draft. From then on, sends that name this template render this version; later edits change only the draft until the next publish. Pass the updated_at you loaded as expected_updated_at to publish only that version: if the template changed since, it answers 409 revision_conflict. Requires the email:send scope.",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The template id or alias",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expected_updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Not in Resend. The updated_at you loaded."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateRef"
                }
              }
            }
