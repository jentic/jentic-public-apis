      "patch": {
        "operationId": "updateInboxThread",
        "summary": "Update a thread",
        "description": "Mark every message read or unread (the same read state the mailbox and GET /v1/emails/receiving show), move the thread to inbox, archive, spam or trash (sent is assigned automatically), apply a label, or remove one with remove_label_id (not in Resend). At least one of read, folder, label_id or remove_label_id. Requires the inbound:read scope; moving to trash is a delete and needs the inbound:delete scope on a key created by a team owner or admin.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "description": "The inbox id or its email address",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "description": "The thread id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "read": {
                    "type": "boolean"
                  },
                  "folder": {
                    "type": "string",
                    "enum": [
                      "inbox",
                      "archive",
                      "spam",
                      "trash"
                    ]
                  },
                  "label_id": {
                    "type": "string",
                    "description": "Apply this label of the same inbox"
                  },
                  "remove_label_id": {
                    "type": "string",
                    "description": "Remove this label. Not in Resend."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
