      "TemplateList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateSummary"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "TemplateRef": {
        "type": "object",
        "description": "Resend's { id, object }. Create, update and publish also return the fields below (not in Resend): updated_at is the revision that write set, to pass as expected_updated_at next time.",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx_tpl123"
          },
          "object": {
            "type": "string",
            "example": "template"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Not in Resend. The revision this write created."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "description": "Not in Resend."
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Not in Resend."
          },
          "has_unpublished_versions": {
            "type": "boolean",
            "description": "Not in Resend."
          }
        }
      },
      "TemplateDeleted": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "template"
          },
          "id": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "TemplateError": {
        "type": "object",
        "description": "Resend's error shape, plus error with the same text as message.",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "name": {
            "type": "string",
            "example": "not_found",
            "description": "validation_error, not_found or conflict"
          },
          "message": {
            "type": "string",
            "example": "Template not found"
          },
          "error": {
            "type": "string",
            "example": "Template not found"
          }
        }
      },
      "DeletedObject": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "broadcast.deleted"
          },
          "id": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "SignupForm": {
        "type": "object",
        "required": [
          "object",
          "id",
          "name",
          "fields",
          "button_text",
          "button_color",
          "success_message",
          "double_opt_in",
          "captcha_enabled",
          "captcha_provider",
          "turnstile_secret_configured",
          "block_disposable_emails",
          "active",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "signup_form"
          },
          "id": {
            "type": "string",
            "example": "clx_form123"
          },
          "name": {
            "type": "string",
            "example": "Newsletter signup"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "first_name",
                "last_name"
              ]
            },
            "example": [
              "email",
              "first_name"
            ]
          },
          "button_text": {
            "type": "string",
            "example": "Subscribe"
          },
          "button_color": {
            "type": "string",
            "example": "#10b981"
          },
          "success_message": {
            "type": "string",
            "example": "Thanks for subscribing!"
          },
          "double_opt_in": {
            "type": "boolean",
            "example": true
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ],
            "example": null
          },
          "captcha_enabled": {
            "type": "boolean",
            "example": false
          },
          "captcha_provider": {
            "type": "string",
            "enum": [
              "turnstile"
            ],
            "example": "turnstile"
          },
          "turnstile_site_key": {
            "type": [
              "string",
              "null"
            ],
            "example": null
          },
          "turnstile_secret_configured": {
            "type": "boolean",
            "example": false
          },
          "block_disposable_emails": {
            "type": "boolean",
            "example": true
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "confirmation_email_from": {
            "type": [
              "string",
              "null"
            ],
            "example": "Acme <hello@acme.com>",
            "description": "Sender of the double opt-in confirmation email. Create, retrieve and update return it; list items leave it out."
          },
          "welcome_email_enabled": {
            "type": "boolean",
            "example": false,
            "description": "Create, retrieve and update return it; list items leave it out."
          },
          "welcome_email_from": {
            "type": [
              "string",
              "null"
            ],
            "example": null,
            "description": "Create, retrieve and update return it; list items leave it out."
          },
          "welcome_email_subject": {
            "type": [
              "string",
              "null"
            ],
            "example": null,
            "description": "Create, retrieve and update return it; list items leave it out."
          },
          "welcome_email_markdown": {
            "type": [
              "string",
              "null"
            ],
            "example": null,
            "description": "Create, retrieve and update return it; list items leave it out."
          },
          "welcome_stats": {
            "type": "object",
            "description": "Welcome emails sent and skipped for this form, and how many were delivered, opened and clicked. List items leave it out.",
            "properties": {
              "sent": {
                "type": "integer",
                "example": 0
              },
              "skipped": {
                "type": "integer",
                "example": 0
              },
              "delivered": {
                "type": "integer",
                "example": 0
              },
              "opened": {
                "type": "integer",
                "example": 0
              },
              "clicked": {
                "type": "integer",
                "example": 0
              }
            }
          },
          "pending_confirmations_count": {
            "type": "integer",
            "example": 0,
            "description": "Signups waiting on their confirmation click. List items leave it out."
          },
          "recent_pending_confirmations": {
            "type": "array",
            "description": "Up to 5 of the newest pending signups. List items leave it out.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignupFormList": {
        "type": "object",
        "required": [
          "object",
          "has_more",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "has_more": {
            "type": "boolean",
            "example": false
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignupForm"
            }
          }
        }
      },
      "PendingSignupList": {
        "type": "object",
        "required": [
          "data",
          "total",
          "undeliverable_total",
          "tor_total",
          "approvable_total",
          "page",
          "per_page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingSignup"
            }
          },
          "total": {
            "type": "integer",
            "example": 9
          },
          "undeliverable_total": {
            "type": "integer",
            "example": 1,
            "description": "How many of the matching signups have an undeliverable confirmation email. Approve all leaves these out."
          },
          "tor_total": {
            "type": "integer",
            "example": 2,
            "description": "How many of the matching signups were submitted through Tor. Approve all leaves these out."
          },
          "approvable_total": {
            "type": "integer",
            "example": 6,
            "description": "How many of the matching signups Approve all would confirm."
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "PendingSignup": {
        "type": "object",
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "created_at",
          "expires_at",
          "country",
          "source_url",
          "confirmation_email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "clx_pending123"
          },
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "example": "US",
            "description": "Two-letter country code, or T1 when the signup came through Tor. The IP address is not stored."
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://example.com/blog/launch?utm_source=newsletter",
            "description": "The page the form was submitted on: address plus utm_* parameters only."
          },
          "confirmation_email": {
            "type": [
              "object",
              "null"
            ],
            "description": "The confirmation email and its current status. Null when no email was queued for this signup, or for signups recorded before this was tracked.",
            "properties": {
              "id": {
                "type": "string",
                "example": "clx_email123"
              },
              "status": {
                "type": "string",
                "example": "delivered"
              }
            }
          }
        }
      },
      "SignupFormDeleted": {
        "type": "object",
        "required": [
          "object",
          "id",
          "deleted"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "signup_form"
          },
          "id": {
            "type": "string",
            "example": "clx_form123"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreateSignupFormRequest": {
        "type": "object",
        "description": "Keys are snake_case, as in the form object. The older camelCase spelling of each key (buttonText, doubleOptIn, welcomeEmailEnabled and so on) is still accepted; sending both spellings of one field is a 400.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Newsletter signup"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "first_name",
                "last_name"
              ]
            },
            "example": [
              "email",
              "first_name"
            ],
            "description": "email is always included."
          },
          "button_text": {
            "type": "string",
            "maxLength": 50,
            "example": "Subscribe"
          },
          "button_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
            "example": "#10b981"
          },
          "success_message": {
            "type": "string",
            "maxLength": 200,
            "example": "Thanks for subscribing!"
          },
          "double_opt_in": {
            "type": "boolean",
            "example": true
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ],
            "example": null,
            "description": "Must start with http:// or https://."
          },
          "captcha_enabled": {
            "type": "boolean",
            "example": false,
            "description": "Needs turnstile_site_key and turnstile_secret_key."
          },
          "captcha_provider": {
            "type": "string",
            "enum": [
              "turnstile"
            ],
            "example": "turnstile"
          },
          "turnstile_site_key": {
            "type": [
              "string",
              "null"
            ],
            "example": null
          },
          "turnstile_secret_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only. Returned forms expose turnstile_secret_configured instead."
          },
          "block_disposable_emails": {
            "type": "boolean",
            "example": true
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "confirmation_email_from": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "example": "Acme <hello@acme.com>",
            "description": "Sender of the double opt-in confirmation email. The platform address is used when this is unset or its domain is not verified."
          },
          "welcome_email_enabled": {
            "type": "boolean",
            "description": "Send a welcome email to each new contact from this form."
          },
          "welcome_email_from": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "Sender of the welcome email. Its domain must be verified, or the welcome email is skipped."
          },
          "welcome_email_subject": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "welcome_email_markdown": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50000,
            "description": "Welcome email body as Markdown."
          }
        }
      },
      "UpdateSignupFormRequest": {
        "type": "object",
        "description": "Only the fields sent change. Keys are snake_case, as in the form object. The older camelCase spelling of each key (buttonText, doubleOptIn, welcomeEmailEnabled and so on) is still accepted; sending both spellings of one field is a 400.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "first_name",
                "last_name"
              ]
            }
          },
          "button_text": {
            "type": "string",
            "maxLength": 50
          },
          "button_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "success_message": {
            "type": "string",
            "maxLength": 200
          },
          "double_opt_in": {
            "type": "boolean"
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "captcha_enabled": {
            "type": "boolean"
          },
          "captcha_provider": {
            "type": "string",
            "enum": [
              "turnstile"
            ]
          },
          "turnstile_site_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "turnstile_secret_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only. Omit to keep the existing secret."
          },
          "block_disposable_emails": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "confirmation_email_from": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "example": "Acme <hello@acme.com>",
            "description": "Sender of the double opt-in confirmation email. The platform address is used when this is unset or its domain is not verified."
          },
          "welcome_email_enabled": {
            "type": "boolean",
            "description": "Send a welcome email to each new contact from this form."
          },
          "welcome_email_from": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "Sender of the welcome email. Its domain must be verified, or the welcome email is skipped."
          },
          "welcome_email_subject": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "welcome_email_markdown": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50000,
            "description": "Welcome email body as Markdown."
          }
        }
      },
      "AddDomainRequest": {
        "type": "object",
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "The domain name to register for sending",
            "example": "yourapp.com"
          }
        }
      },
      "DomainListItem": {
        "type": "object",
        "description": "A domain as the list returns it. The field names are camelCase here, unlike the rest of the API.",
        "required": [
          "id",
          "domain",
          "status",
          "dkimStatus",
          "spfStatus",
          "dmarcStatus",
          "verifiedAt",
          "createdAt",
          "receivingEnabled",
          "receivingStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "dom_xyz789"
          },
          "domain": {
            "type": "string",
            "example": "yourapp.com"
          },
          "status": {
            "type": "string",
            "example": "verified",
            "description": "pending, verifying, verified or failed"
          },
          "dkimStatus": {
            "type": "string",
            "example": "verified"
          },
          "spfStatus": {
            "type": "string",
            "example": "verified"
          },
          "dmarcStatus": {
            "type": "string",
            "example": "pending"
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivingEnabled": {
            "type": "boolean"
          },
          "receivingStatus": {
            "type": "string",
            "example": "disabled",
            "description": "disabled, pending, active or failed"
          }
        }
      },
      "Domain": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "status",
          "dns_records"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "dom_xyz789"
          },
          "domain": {
            "type": "string",
            "example": "yourapp.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "failed"
            ],
            "example": "pending"
          },
          "receivingEnabled": {
            "type": "boolean",
            "description": "Whether inbound email is turned on for the domain (list responses)."
          },
          "receivingStatus": {
            "type": "string",
            "enum": [
              "disabled",
              "pending",
              "active",
              "failed"
            ],
            "description": "Inbound status (list responses)."
          },
          "dns_records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DnsRecord"
            }
          }
        }
      },
      "DnsRecord": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CNAME",
              "TXT",
              "MX"
            ],
            "example": "CNAME"
          },
          "name": {
            "type": "string",
            "example": "smtp1._domainkey.yourapp.com"
          },
          "value": {
            "type": "string",
            "example": "smtp1.dkim.smtpfa.st"
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "A human-readable name for the key",
            "example": "Production"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of scopes to restrict the key. Available: email:send, email:read, domain:read, domain:write, contact:read, contact:write, form:read, form:write, webhook:read, webhook:write, logs:read, inbound:read, inbound:delete, team:read, team:manage, apikey:manage. If omitted the key gets the default set: everything except logs:read, inbound:read, inbound:delete, team:read, team:manage and apikey:manage. Listing, creating or revoking keys through the API requires apikey:manage.",
            "example": [
              "email:send",
              "domain:read"
            ]
          }
        }
      },
      "ApiKeyCreated": {
        "type": "object",
        "description": "Returned when a new API key is created. The key field contains the full secret and is only shown once.",
        "properties": {
          "id": {
            "type": "string",
            "example": "key_abc123"
          },
          "name": {
            "type": "string",
            "example": "Production"
          },
          "key": {
            "type": "string",
            "example": "sf_live_abc123def456..."
          },
          "prefix": {
            "type": "string",
            "example": "sf_live_a"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "emails:send",
              "domains:read"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-05T12:00:00Z"
          }
        }
      },
      "TeamMember": {
        "type": "object",
        "required": [
          "object",
          "id",
          "user_id",
          "email",
          "role",
          "can_manage_billing",
          "created_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "team_member"
            ]
          },
          "id": {
            "type": "string",
            "description": "The membership ID"
          },
          "user_id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          },
          "can_manage_billing": {
            "type": "boolean",
            "description": "Always true for owners"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When they joined"
          }
        }
      },
      "TeamInvite": {
        "type": "object",
        "required": [
          "object",
          "id",
          "email",
          "role",
          "expires_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "team_invite"
            ]
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "description": "List and update responses also carry the same values in camelCase (keyPrefix, createdAt, lastUsedAt, revokedAt, expiresAt, grantExpiresAt) for older clients.",
        "required": [
          "id",
          "name",
          "prefix",
          "scopes",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "key_abc123"
          },
          "name": {
            "type": "string",
            "example": "Production"
          },
          "prefix": {
            "type": "string",
            "example": "sf_live_a"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "email:send",
              "domain:read"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-05T12:00:00Z"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set for connected-app keys, which rotate."
          },
          "grant_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a connected app's grant ends."
          }
        }
      },
      "CreateWebhookRequest": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The URL that will receive webhook POST requests",
            "example": "https://yourapp.com/webhooks/smtpfast"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email.scheduled",
                "email.sent",
                "email.delivered",
                "email.delivery_delayed",
                "email.bounced",
                "email.complained",
                "email.opened",
                "email.clicked",
                "email.failed",
                "email.suppressed",
                "email.unsubscribed",
                "email.received",
                "domain.created",
                "domain.updated",
                "domain.deleted",
                "contact.created",
                "contact.updated",
                "contact.deleted",
                "contact.subscribed"
              ]
            },
            "description": "List of event types to subscribe to. Legacy unprefixed email aliases are accepted and normalized to Resend-style email.* event names.",
            "example": [
              "email.delivered",
              "email.bounced"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "standard",
              "discord",
              "slack"
            ],
            "description": "Payload format. standard is the signed JSON envelope; discord and slack post readable messages to a chat webhook URL. Detected from the URL when left out."
          }
        }
      },
      "UpdateWebhookRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://yourapp.com/webhooks/smtpfast"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email.scheduled",
                "email.sent",
                "email.delivered",
                "email.delivery_delayed",
                "email.bounced",
                "email.complained",
                "email.opened",
                "email.clicked",
                "email.failed",
                "email.suppressed",
                "email.unsubscribed",
                "email.received",
                "domain.created",
                "domain.updated",
                "domain.deleted",
                "contact.created",
                "contact.updated",
                "contact.deleted",
                "contact.subscribed"
              ]
            },
            "description": "List of event types to subscribe to. Legacy unprefixed email aliases are accepted and normalized to Resend-style email.* event names.",
            "example": [
              "email.delivered",
              "email.bounced"
            ]
          },
          "active": {
            "type": "boolean",
            "description": "Set to false to pause delivery without deleting the webhook",
            "example": true
          },
          "format": {
            "type": "string",
            "enum": [
              "standard",
              "discord",
              "slack"
            ]
          }
        }
      },
      "WebhookEventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
