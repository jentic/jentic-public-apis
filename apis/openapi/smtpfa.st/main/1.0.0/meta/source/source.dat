      },
      "patch": {
        "operationId": "updateContactProperty",
        "summary": "Update a contact property default",
        "description": "Changes fallback_value only. Key and type are immutable: renaming would orphan the values already stored under the old key.",
        "tags": [
          "Contacts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fallback_value"
                ],
                "properties": {
                  "fallback_value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The new fallback; null clears it. key and type cannot change."
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The contact property ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
