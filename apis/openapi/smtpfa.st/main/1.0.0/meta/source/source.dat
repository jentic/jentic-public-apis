    "/v1/domains/claim": {
      "get": {
        "operationId": "getDomainClaimRecord",
        "summary": "Get the claim record for a domain",
        "description": "The TXT record a team publishes to prove DNS control before claiming a domain another account added but never verified. 404 when nobody holds the domain, 409 with code already_yours or verified_elsewhere when it cannot be claimed. Requires the domain:read scope.",
        "tags": [
          "Domains"
        ],
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record to publish",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "domain": {
                      "type": "string"
                    },
                    "record": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "example": "TXT"
                        },
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "ttl": {
