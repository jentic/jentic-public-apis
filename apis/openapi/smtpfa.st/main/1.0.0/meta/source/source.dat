    "/v1/contacts/export": {
      "get": {
        "operationId": "exportContacts",
        "summary": "Export contacts",
        "description": "Export up to 10,000 contacts for the current account as CSV or JSON. Optional status and disposable filtering match the list endpoint.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Export format",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "json"
              ],
              "default": "csv"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by subscription status",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "subscribed",
                "unsubscribed"
              ],
              "default": "all"
            }
          },
          {
            "name": "disposable",
            "in": "query",
            "description": "Only contacts on throwaway-mailbox domains (true) or only the rest (false)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
