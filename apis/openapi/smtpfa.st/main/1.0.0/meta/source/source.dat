      "post": {
        "operationId": "createTemplate",
        "summary": "Create a template",
        "description": "Create a template as a draft. Publish it with POST /v1/templates/{id}/publish before sending with it. Same body as Resend's create template; markdown, preview_text and category are SMTPfast additions. Requires the email:send scope.",
        "tags": [
          "Templates"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateRequest"
              },
              "example": {
                "name": "order-confirmation",
                "alias": "order-confirmation",
                "subject": "Your order {{{ORDER_ID}}}",
                "from": "Acme <orders@acme.com>",
                "html": "<p>Name: {{{PRODUCT}}}</p><p>Total: {{{PRICE}}}</p>",
                "variables": [
                  {
                    "key": "PRODUCT",
                    "type": "string",
                    "fallback_value": "item"
                  },
                  {
                    "key": "PRICE",
                    "type": "number",
                    "fallback_value": 25
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template created as a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateRef"
                }
              }
            }
