    "/v1/forms/{id}/pending/approve-all": {
      "post": {
        "operationId": "approveAllPendingSignups",
        "summary": "Approve all pending signups",
        "description": "Confirm pending signups without waiting for the link click, up to 200 per call; call again while `remaining` is above zero. Each one becomes a contact, fires contact.subscribed and gets the welcome email if enabled. Signups whose confirmation email bounced, was marked as spam or failed are left pending and counted in `skipped_undeliverable`. Signups submitted through Tor are left pending and counted in `skipped_tor`. Requires the form:write scope.",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The signup form ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Only approve signups matching this search"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approval result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "approved",
                    "skipped",
                    "remaining",
                    "skipped_undeliverable",
                    "skipped_tor"
                  ],
                  "properties": {
                    "approved": {
                      "type": "integer",
                      "example": 8
                    },
                    "skipped": {
                      "type": "integer",
                      "example": 0
                    },
                    "remaining": {
                      "type": "integer",
                      "example": 0
                    },
                    "skipped_undeliverable": {
                      "type": "integer",
                      "example": 1
                    },
                    "skipped_tor": {
                      "type": "integer",
                      "example": 2
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
