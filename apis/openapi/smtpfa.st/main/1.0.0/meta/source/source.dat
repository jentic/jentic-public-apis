    "/v1/broadcasts/{id}/clicked-links": {
      "get": {
        "operationId": "listBroadcastClickedLinks",
        "summary": "List clicked links",
        "description": "Every link clicked in this broadcast, with total clicks and the number of distinct recipients who clicked it. Ordered by total clicks.",
        "tags": [
          "Broadcasts"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The broadcast ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The links clicked in this broadcast",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "broadcast_id",
                    "links",
                    "total_clicks"
                  ],
                  "properties": {
                    "broadcast_id": {
                      "type": "string"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "url",
                          "clicks",
                          "unique_clicks"
                        ],
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "clicks": {
                            "type": "integer",
                            "example": 12
                          },
                          "unique_clicks": {
                            "type": "integer",
                            "example": 9,
                            "description": "Distinct recipients who clicked"
                          }
                        }
                      }
                    },
                    "total_clicks": {
                      "type": "integer",
                      "example": 30
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Broadcast not found"
          }
        },
        "x-sdk-group": [
          "broadcasts"
        ],
        "x-sdk-method": "listClickedLinks"
      }
    },
