    "/v1/inboxes/{inbox_id}/drafts/{draft_id}/send": {
      "post": {
        "operationId": "sendInboxDraft",
        "summary": "Send a draft",
        "description": "Sends real email: the approval step for a draft. It goes out from the inbox address through the normal send path; a reply draft joins its thread with threading headers, a new conversation starts a thread in sent. The draft needs a recipient and a body (and a subject when it is not a reply). The send claims the draft on the version it read, so an edit cannot slip in while it runs. Not in Resend: pass the revision a person reviewed; if the draft changed since, nothing is sent and the answer is 409 with code draft_changed. Without a body this is Resend's call. Sending the same draft twice queues one email; a draft that was already sent returns 409. Requires the inbound:read and email:send scopes.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "description": "The inbox id or its email address",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "description": "The draft id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Send only if the draft is still at this revision, the one that was reviewed. Not in Resend."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "inbox_draft"
                    },
                    "id": {
                      "type": "string"
                    },
                    "thread_id": {
                      "type": "string"
                    },
                    "email_id": {
                      "type": "string"
                    },
                    "sent_revision": {
                      "type": "integer",
                      "description": "Present with warning: the revision that went out. Not in Resend."
                    },
                    "warning": {
                      "type": "string",
                      "description": "Present when the email went out but the draft changed or was claimed again while the send ran, so it was not marked sent. Not in Resend."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - domain not verified or insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - the resource already exists or changed meanwhile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The request is well formed but cannot be carried out in the current state, for example an unpublished template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - retry after the period indicated in the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
