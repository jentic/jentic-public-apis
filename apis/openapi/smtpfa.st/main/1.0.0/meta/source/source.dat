    "/v1/webhooks/{id}/signing-secret/rotate": {
      "post": {
        "operationId": "rotateWebhookSigningSecret",
        "summary": "Rotate a webhook signing secret",
        "description": "Replace the signing secret. The new secret is in this response only, and every event sent after this call, retries included, is signed with it, so update your endpoint at once. Requires the webhook:write scope and an owner or admin.",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "name": "id",
