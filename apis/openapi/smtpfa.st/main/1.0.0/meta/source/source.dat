    "/v1/inboxes": {
      "get": {
        "operationId": "listInboxes",
        "summary": "List inboxes",
        "description": "The team's inboxes, newest first, with cursor paging (after walks older, before walks newer). unread counts threads in the inbox folder with at least one unread message. domain_id, drafts and created_at on list items are not in Resend's list item. Requires the inbound:read scope.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The id of the last inbox on the page; returns the next, older page"
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The id of the first inbox on the page; returns the previous, newer page. Not with after."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of inboxes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
