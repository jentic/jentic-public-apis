    "/v1/forms/{id}/pending/{pendingId}": {
      "delete": {
        "operationId": "removePendingSignup",
        "summary": "Remove a pending signup",
        "description": "Remove a pending signup without adding it as a contact. Its confirmation link stops working. Requires the form:write scope.",
