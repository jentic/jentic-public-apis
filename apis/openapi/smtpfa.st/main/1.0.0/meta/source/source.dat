    "/v1/inboxes/{inbox_id}/threads/{thread_id}/emails/{email_id}/forward": {
      "post": {
        "operationId": "forwardInboxThreadEmail",
        "summary": "Forward a thread email",
        "description": "Sends real email: a forward from the inbox address with the original quoted under a forwarded-message banner, through the normal send path. to is required; 50 recipients at most with cc and bcc. html or text is a note above the original. subject defaults to Fwd: plus the thread subject. Attachments of the original are not included. The forward joins the thread. Supports Idempotency-Key. Requires the inbound:read and email:send scopes.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "inbox_id",
