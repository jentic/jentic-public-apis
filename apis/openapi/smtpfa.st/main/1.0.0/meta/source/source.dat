          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "attempting",
              "pending"
            ]
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "webhook_event"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "example": "email.delivered"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "attempting",
              "pending"
            ]
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "payload": {
            "description": "The body that was sent, parsed as JSON"
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "webhook_delivery"
          },
          "id": {
            "type": "string"
          },
          "webhook_id": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "example": "email.bounced"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "succeeded",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "max_attempts": {
            "type": "integer"
          },
          "status_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "response": {
            "type": [
              "string",
              "null"
            ],
            "description": "First 500 characters of the last response body"
          },
          "attempt_log": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "duration_ms": {
                  "type": "integer"
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Webhook": {
        "type": "object",
        "required": [
          "id",
          "url",
          "events",
          "active",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "wh_abc123"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://yourapp.com/webhooks/smtpfast"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email.scheduled",
                "email.sent",
                "email.delivered",
                "email.delivery_delayed",
                "email.bounced",
                "email.complained",
                "email.opened",
                "email.clicked",
                "email.failed",
                "email.suppressed",
                "email.unsubscribed",
                "email.received",
                "domain.created",
                "domain.updated",
                "domain.deleted",
                "contact.created",
                "contact.updated",
                "contact.deleted",
                "contact.subscribed"
              ]
            },
            "example": [
              "email.delivered",
              "email.bounced"
            ]
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "format": {
            "type": "string",
            "enum": [
              "standard",
              "discord",
              "slack"
            ]
          },
          "secret": {
            "type": "string",
            "description": "The signing secret. Returned once, in the create response."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-05T12:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "List and read responses also carry createdAt and updatedAt in camelCase for older clients."
      },
      "WebhookUpdated": {
        "type": "object",
        "required": [
          "id",
          "url",
          "events",
          "format",
          "active"
        ],
        "description": "The update response has no timestamps; fetch the webhook for those.",
        "properties": {
          "id": {
            "type": "string",
            "example": "wh_abc123"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://yourapp.com/webhooks/smtpfast"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email.scheduled",
                "email.sent",
                "email.delivered",
                "email.delivery_delayed",
                "email.bounced",
                "email.complained",
                "email.opened",
                "email.clicked",
                "email.failed",
                "email.suppressed",
                "email.unsubscribed",
                "email.received",
                "domain.created",
                "domain.updated",
                "domain.deleted",
                "contact.created",
                "contact.updated",
                "contact.deleted",
                "contact.subscribed"
              ]
            },
            "example": [
              "email.delivered",
              "email.bounced"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "standard",
              "discord",
              "slack"
            ]
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "object",
          "emails",
          "contacts",
          "segments",
          "broadcasts",
          "ai_credits",
          "automation_runs",
          "domains",
          "rate_limit"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "usage"
          },
          "emails": {
            "type": "object",
            "required": [
              "daily",
              "monthly",
              "credits",
              "effective_remaining"
            ],
            "properties": {
              "daily": {
                "type": "object",
                "required": [
                  "used",
                  "limit",
                  "sent",
                  "received",
                  "resets_at"
                ],
                "description": "The last 24 hours. There is no daily cap, so limit and resets_at are null.",
                "properties": {
                  "used": {
                    "type": "integer",
                    "example": 312
                  },
                  "limit": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "sent": {
                    "type": "integer",
                    "example": 312
                  },
                  "received": {
                    "type": "integer",
                    "example": 4
                  },
                  "resets_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              },
              "monthly": {
                "type": "object",
                "required": [
                  "used",
                  "limit",
                  "sent",
                  "received",
                  "resets_at"
                ],
                "description": "This month. Received mail does not count, so used equals sent.",
                "properties": {
                  "used": {
                    "type": "integer",
                    "example": 8420
                  },
                  "limit": {
                    "type": "integer",
                    "example": 50000
                  },
                  "sent": {
                    "type": "integer",
                    "example": 8420
                  },
                  "received": {
                    "type": "integer",
                    "example": 96
                  },
                  "resets_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "credits": {
                "type": "object",
                "required": [
                  "balance"
                ],
                "properties": {
                  "balance": {
                    "type": "integer",
                    "example": 0,
                    "description": "Prepaid credits"
                  }
                }
              },
              "effective_remaining": {
                "type": "integer",
                "example": 41580,
                "description": "What can still be sent before a send is refused: the monthly allowance left plus credits"
              }
            }
          },
          "contacts": {
            "type": "object",
            "required": [
              "used",
              "limit"
            ],
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": "integer",
                "example": 25000
              }
            }
          },
          "segments": {
            "type": "object",
            "required": [
              "used",
              "limit"
            ],
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": "integer",
                "example": 50
              }
            }
          },
          "broadcasts": {
            "type": "object",
            "required": [
              "used",
              "limit"
            ],
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": "integer",
                "example": 50
              }
            },
            "description": "Broadcasts queued, scheduled or sent this month"
          },
          "ai_credits": {
            "type": "object",
            "required": [
              "used",
              "limit",
              "next_increase_at"
            ],
            "description": "Not offered: always 0, with a null next_increase_at",
            "properties": {
              "used": {
                "type": "integer",
                "example": 0
              },
              "limit": {
                "type": "integer",
                "example": 0
              },
              "next_increase_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "automation_runs": {
            "type": "object",
            "required": [
              "used",
              "limit",
              "resets_at"
            ],
            "description": "Not offered: always 0",
            "properties": {
              "used": {
                "type": "integer",
                "example": 0
              },
              "limit": {
                "type": "integer",
                "example": 0
              },
              "resets_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "domains": {
            "type": "object",
            "required": [
              "used",
              "limit"
            ],
            "properties": {
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "description": "A null limit means no cap"
          },
          "rate_limit": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "limit",
              "duration"
            ],
            "description": "Per API key; null for a dashboard session",
            "properties": {
              "limit": {
                "type": "integer",
                "example": 100,
                "description": "Requests allowed per duration"
              },
              "duration": {
                "type": "string",
                "example": "1000ms"
              }
            }
          }
        }
      },
      "Analytics": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Every email on the account, whatever its status",
            "example": 24707
          },
          "sent": {
            "type": "integer",
            "description": "Emails that went out (sent, delivered, opened, clicked, bounced or complained). The rates are worked out against this.",
            "example": 24190
          },
          "today": {
            "type": "integer",
            "description": "Emails sent in the last 24 hours",
            "example": 312
          },
          "thisWeek": {
            "type": "integer",
            "description": "Emails sent in the last 7 days",
            "example": 2190
          },
          "delivered": {
            "type": "integer",
            "description": "Accepted by the receiving server, including those later opened or clicked",
            "example": 23610
          },
          "bounced": {
            "type": "integer",
            "example": 402
          },
          "complained": {
            "type": "integer",
            "example": 11
          },
          "failed": {
            "type": "integer",
            "description": "Never sent because of an error",
            "example": 157
          },
          "pending": {
            "type": "integer",
            "description": "Scheduled, queued or sending; not counted in any rate yet",
            "example": 320
          },
          "canceled": {
            "type": "integer",
            "example": 40
          },
          "awaitingReport": {
            "type": "integer",
            "description": "Sent, with no delivery or bounce report yet; not counted in the rates",
            "example": 167
          },
          "deliveryRate": {
            "type": "number",
            "format": "float",
            "description": "(delivered + complained) / (sent - awaitingReport), as a percentage",
            "example": 98.3
          },
          "bounceRate": {
            "type": "number",
            "format": "float",
            "description": "bounced / (sent - awaitingReport), as a percentage",
            "example": 1.7
          },
          "daily": {
            "type": "array",
            "description": "Last 30 days, bucketed by the UTC day each email was sent",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "example": "2026-08-22"
                },
                "sent": {
                  "type": "integer",
                  "example": 780
                },
                "delivered": {
                  "type": "integer",
                  "example": 761
                },
                "bounced": {
                  "type": "integer",
                  "example": 12
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "example": "2026-09"
              },
              "sent": {
                "type": "integer",
                "example": 8420
              },
              "delivered": {
                "type": "integer",
                "example": 8201
              },
              "bounced": {
                "type": "integer",
                "example": 140
              },
              "limit": {
                "type": "integer",
                "example": 50000
              },
              "tier": {
                "type": "string",
                "example": "pro"
              }
            }
          },
          "window": {
            "type": "object",
            "description": "Present when days or domain is passed",
            "properties": {
              "days": {
                "type": "integer",
                "example": 7
              },
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              },
              "domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "counts": {
                "type": "object",
                "properties": {
                  "sent": {
                    "type": "integer"
                  },
                  "delivered": {
                    "type": "integer"
                  },
                  "hard_bounced": {
                    "type": "integer"
                  },
                  "soft_bounced": {
                    "type": "integer"
                  },
                  "complained": {
                    "type": "integer"
                  },
                  "failed": {
                    "type": "integer"
                  }
                }
              },
              "rates_percent": {
                "type": "object",
                "properties": {
                  "delivered": {
                    "type": "number"
                  },
                  "hard_bounced": {
                    "type": "number"
                  },
                  "soft_bounced": {
                    "type": "number"
                  },
                  "complained": {
                    "type": "number"
                  }
                }
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A human-readable error message",
            "example": "Invalid API key"
          }
        }
      },
      "AudienceMeta": {
        "type": "object",
        "additionalProperties": true,
        "description": "Details of the audience, such as the segment_id",
        "example": {
          "segment_id": "clx_segment123"
        }
      }
    }
  },
