          "id",
          "reason",
          "source",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "clx_suppression123"
          },
          "reason": {
            "type": "string",
            "example": "hard_bounce"
          },
          "source": {
            "type": "string",
            "example": "ses"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateSuppressionRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "blocked@example.com"
          },
          "reason": {
            "type": "string",
            "enum": [
              "manual"
            ],
            "default": "manual"
          },
          "diagnostic_code": {
            "type": "string",
            "description": "Optional internal note for manual suppressions",
            "example": "Requested by customer support"
          }
        }
      },
      "SuppressionList": {
        "type": "object",
        "required": [
          "object",
          "has_more",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "has_more": {
            "type": "boolean",
            "example": false
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Suppression"
            }
          }
        }
      },
      "Suppression": {
        "type": "object",
        "required": [
          "id",
          "email",
          "reason",
          "source",
          "created_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "suppression"
          },
          "id": {
            "type": "string",
            "example": "clx_suppression123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "blocked@example.com"
          },
          "reason": {
            "type": "string",
            "enum": [
              "hard_bounce",
              "complaint",
              "manual",
              "unsubscribe"
            ],
            "example": "hard_bounce"
          },
          "source": {
            "type": "string",
            "example": "ses"
          },
          "bounce_type": {
            "type": [
              "string",
              "null"
            ],
            "example": "permanent"
          },
          "diagnostic_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "feedback_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "related_email": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "related_event": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "SuppressionDeleted": {
        "type": "object",
        "required": [
          "object",
          "suppression",
          "email",
          "deleted",
          "account_list"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "suppression"
          },
          "suppression": {
            "type": "string",
            "example": "clx_suppression123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "blocked@example.com"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          },
          "account_list": {
            "type": "string",
            "enum": [
              "removed",
              "absent",
              "skipped",
              "failed"
            ],
            "example": "removed",
            "description": "What happened at Amazon SES's account-level suppression list. Hard-bounce and complaint suppressions are released there too (removed, or absent when SES no longer had it); manual and unsubscribe suppressions are team-specific and skipped. failed means the local suppression is gone but SES could not be updated; a later send to the address may still bounce as OnAccountSuppressionList."
          }
        }
      },
      "CreateBroadcastRequest": {
        "type": "object",
        "description": "name is required unless template_id is given.",
        "properties": {
          "name": {
            "type": "string",
            "example": "May product update"
          },
          "audience": {
            "type": "string",
            "enum": [
              "all_contacts",
              "segment"
            ],
            "default": "all_contacts"
          },
          "segment_id": {
            "type": "string",
            "description": "Required when audience is segment",
            "example": "clx_segment123"
          },
          "audience_meta": {
            "$ref": "#/components/schemas/AudienceMeta"
          },
          "template_id": {
            "type": "string",
            "description": "Not in Resend, and only on create (PATCH ignores it). Start from a template (id or alias): its current content, as the template editor shows it, is copied into the new draft, with declared fallbacks written inline. Fields sent alongside win. name defaults to the template's name.",
            "example": "product-update"
          },
          "from": {
            "type": "string",
            "format": "email",
            "example": "updates@example.com"
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "subject": {
            "type": "string",
            "example": "New features for {{contact.first_name|there}}"
          },
          "preview_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown": {
            "type": "string",
            "description": "Markdown body. Must include {{unsubscribe_url}} or {{{RESEND_UNSUBSCRIBE_URL}}} before sending."
          },
          "html": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "track_opens": {
            "type": "boolean",
            "default": true
          },
          "track_clicks": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "UpdateBroadcastRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CreateBroadcastRequest"
          }
        ]
      },
      "BroadcastList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Broadcast"
            }
          },
          "has_more": {
            "type": "boolean",
            "example": false
          },
          "status_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "Broadcast": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "broadcast"
          },
          "id": {
            "type": "string",
            "example": "clx_broadcast123"
          },
          "name": {
            "type": "string",
            "example": "May product update"
          },
          "audience": {
            "type": "string",
            "example": "all_contacts"
          },
          "audience_meta": {
            "$ref": "#/components/schemas/AudienceMeta"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "example": "updates@example.com"
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "html": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "queued",
              "sending",
              "sent",
              "paused",
              "canceled",
              "failed"
            ],
            "example": "draft"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "queued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "canceled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "paused_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set when the campaign was stopped mid-send by the deliverability guard"
          },
          "pause_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the campaign was paused, for example the complaint rate that tripped the guard"
          },
          "fanout_completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When every recipient of the send had been created"
          },
          "expected_recipients": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Eligible recipients counted when the send was accepted"
          },
          "track_opens": {
            "type": "boolean",
            "example": true
          },
          "track_clicks": {
            "type": "boolean",
            "example": true
          },
          "recipient_count": {
            "type": "integer",
            "example": 1250
          },
          "metrics": {
            "$ref": "#/components/schemas/BroadcastMetrics"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BroadcastMetrics": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 1250
          },
          "skipped": {
            "type": "integer",
            "example": 12
          },
          "queued": {
            "type": "integer",
            "example": 0
          },
          "sending": {
            "type": "integer",
            "example": 0
          },
          "sent": {
            "type": "integer",
            "example": 1238
          },
          "delivered": {
            "type": "integer",
            "example": 1202
          },
          "opened": {
            "type": "integer",
            "example": 714
          },
          "clicked": {
            "type": "integer",
            "example": 208
          },
          "unsubscribed": {
            "type": "integer",
            "example": 3
          },
          "bounced": {
            "type": "integer",
            "example": 9
          },
          "complained": {
            "type": "integer",
            "example": 1
          },
          "failed": {
            "type": "integer",
            "example": 0
          },
          "canceled": {
            "type": "integer",
            "example": 0
          },
          "delivery_rate": {
            "type": "number",
            "example": 97.1
          },
          "open_rate": {
            "type": "number",
            "example": 59.4
          },
          "click_rate": {
            "type": "number",
            "example": 17.3
          },
          "unsubscribe_rate": {
            "type": "number",
            "example": 0.2
          },
          "bounce_rate": {
            "type": "number",
            "example": 0.7
          }
        }
      },
      "TemplateVariable": {
        "type": "object",
        "required": [
          "key",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "e169aa45-1ecf-4183-9955-b1499d5701d3"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,50}$",
            "description": "Use it in the content as {{{KEY}}}. Letters, digits and underscores. FIRST_NAME, LAST_NAME, EMAIL, UNSUBSCRIBE_URL, RESEND_UNSUBSCRIBE_URL, contact and this are reserved.",
            "example": "PRODUCT"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number"
            ]
          },
          "fallback_value": {
            "description": "Used when a send gives no value. Must match the type. Without one, every send must pass a value for this variable or it answers 422.",
            "example": "item",
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "CreateTemplateRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "description": "Requires html, or markdown (an SMTPfast addition).",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "order-confirmation"
          },
          "alias": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "description": "A second handle, unique in the team, that works wherever the id does.",
            "example": "order-confirmation"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default sender, e.g. \"Acme <orders@acme.com>\". A send can override it.",
            "example": "Acme <orders@acme.com>"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default subject. Can use variables. A send can override it.",
            "example": "Your order {{{ORDER_ID}}}"
          },
          "reply_to": {
            "description": "Default Reply-To address or addresses. A send can override it.",
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 10
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "html": {
            "type": "string",
            "maxLength": 100000,
            "description": "The HTML body. Variables are written {{{KEY}}}, optionally with an inline fallback: {{{KEY|default}}}."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plain-text body. When left out, the text part is generated from the HTML at send time. Exactly \"\" stops that, as in Resend; the email then carries an empty plain-text alternative."
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ],
            "description": "Not in Resend. A Markdown body, rendered into SMTPfast's email layout. Used when html is empty."
          },
          "preview_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Not in Resend. The inbox preview line, put into the email as a hidden first line."
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50,
            "description": "Not in Resend. A label for grouping templates in the dashboard."
          },
          "variables": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/TemplateVariable"
            }
          }
        }
      },
      "UpdateTemplateRequest": {
        "type": "object",
        "description": "Any field of CreateTemplateRequest. Only the fields sent change; variables, when sent, replace the whole list.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "order-confirmation"
          },
          "alias": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "description": "A second handle, unique in the team, that works wherever the id does.",
            "example": "order-confirmation"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default sender, e.g. \"Acme <orders@acme.com>\". A send can override it.",
            "example": "Acme <orders@acme.com>"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default subject. Can use variables. A send can override it.",
            "example": "Your order {{{ORDER_ID}}}"
          },
          "reply_to": {
            "description": "Default Reply-To address or addresses. A send can override it.",
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 10
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "html": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100000,
            "description": "The HTML body. Variables are written {{{KEY}}}, optionally with an inline fallback: {{{KEY|default}}}."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plain-text body. When left out, the text part is generated from the HTML at send time. Exactly \"\" stops that, as in Resend; the email then carries an empty plain-text alternative."
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ],
            "description": "Not in Resend. A Markdown body, rendered into SMTPfast's email layout. Used when html is empty."
          },
          "preview_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Not in Resend. The inbox preview line, put into the email as a hidden first line."
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50,
            "description": "Not in Resend. A label for grouping templates in the dashboard."
          },
          "variables": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/TemplateVariable"
            }
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Not in Resend. The updated_at you loaded. If the template changed since, the update is refused with 409 revision_conflict instead of overwriting the newer version."
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "template"
          },
          "id": {
            "type": "string",
            "example": "clx_tpl123"
          },
          "current_version_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Id of the published version; null until the first publish."
          },
          "alias": {
            "type": [
              "string",
              "null"
            ],
            "example": "order-confirmation"
          },
          "name": {
            "type": "string",
            "example": "order-confirmation"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "published_at": {
            "type": [
