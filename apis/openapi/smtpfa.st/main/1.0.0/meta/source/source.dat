            ],
            "format": "date-time",
            "description": "Not in Resend"
          },
          "revision": {
            "type": "integer",
            "description": "Goes up with every edit. Pass it to send or update to act only on this version. Not in Resend."
          },
          "thread_subject": {
            "type": [
              "string",
              "null"
            ],
            "description": "The subject of the thread a reply draft answers. Not in Resend."
          }
        }
      },
