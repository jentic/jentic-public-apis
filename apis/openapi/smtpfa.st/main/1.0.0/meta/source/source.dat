    "/v1/templates": {
      "get": {
        "operationId": "listTemplates",
        "summary": "List templates",
        "description": "List the team's templates, newest first, in Resend's list shape. Page with limit and an after or before id (not both). Rows carry no content; get one template for that. Requires the email:read scope.",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Number of templates to return."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return templates created before this template id (older). Not included in the result. Cannot be used with before."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return templates created after this template id (newer). Cannot be used with after."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Not in Resend. Search name, alias and subject."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of templates",
            "content": {
              "application/json": {
                "schema": {
