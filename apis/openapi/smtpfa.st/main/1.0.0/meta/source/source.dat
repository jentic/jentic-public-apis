    "/v1/inboxes/{inbox_id}/threads/{thread_id}/emails/{email_id}/reply": {
      "post": {
        "operationId": "replyToInboxThreadEmail",
        "summary": "Reply to a thread email",
        "description": "Sends real email: a reply from the inbox address, threaded with In-Reply-To and References, through the normal send path (verified domain, suppression, plan limits, credits, safety checks). to is taken from the message: a received message's Reply-To or From, or a sent message's recipients. Passing to or from is refused. Add cc and bcc; 50 recipients at most. subject defaults to Re: plus the thread subject (900 characters at most, the send path's limit). Supports Idempotency-Key. To have a person approve the text first, create a reply draft instead. Requires the inbound:read and email:send scopes.",
        "tags": [
          "Inboxes"
        ],
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "description": "The inbox id or its email address",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "description": "The thread id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "description": "The message to reply to",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cc": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "bcc": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "html": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string",
                    "maxLength": 900
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The queued reply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboxSentEmail"
                }
              }
            }
          },
          "400": {
