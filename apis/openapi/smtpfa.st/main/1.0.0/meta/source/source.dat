          "markdown": {
            "type": [
              "string",
              "null"
            ],
            "description": "Not in Resend."
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Not in Resend."
          }
        }
      },
      "TemplateSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
