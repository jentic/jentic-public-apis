            }
          },
          "competing_mx": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SendEmailRequest": {
        "type": "object",
        "required": [
          "to"
        ],
        "description": "from and subject are required, unless a template supplies them. Give a body as html and/or text, or name a published template; not both.",
        "properties": {
          "template": {
            "type": "object",
            "required": [
              "id"
            ],
            "description": "Send a published template instead of html and text, as in Resend. The published version is rendered with the variables, then every normal send rule applies. from, subject and reply_to in the request win over the template's defaults; a subject in the request is rendered with the same variables.",
            "properties": {
              "id": {
                "type": "string",
                "description": "The template id or alias.",
                "example": "order-confirmation"
              },
              "variables": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "description": "Values by variable key. A missing value uses the inline fallback ({{{KEY|default}}}), then the variable's fallback_value. A declared variable with neither must be given a value: otherwise the send answers 422 and lists the keys in missing_variables, before anything is charged or queued. Values are inserted as text: HTML-escaped, and never parsed as Markdown. FIRST_NAME, LAST_NAME and EMAIL fill the contact tags of the same name.",
                "example": {
                  "PRODUCT": "Desk lamp",
                  "PRICE": 49
                }
              }
            }
          },
          "attachments": {
            "type": "array",
            "maxItems": 10,
            "description": "Up to 10 files, base64 encoded, 25 MB per message in total. A content_id makes the part inline: reference it from the HTML as cid:<content_id>.",
            "items": {
              "type": "object",
              "required": [
                "filename",
                "content"
              ],
              "properties": {
                "filename": {
                  "type": "string",
                  "maxLength": 200
                },
                "content": {
                  "type": "string",
                  "description": "Base64-encoded file content"
                },
                "content_type": {
                  "type": "string",
                  "example": "image/png"
                },
                "content_id": {
                  "type": "string",
                  "description": "Letters, digits, . _ - with an optional @domain; sent inline as multipart/related"
                },
                "inline": {
                  "type": "boolean",
                  "description": "Send inline even without a content_id (a Content-ID is derived from the filename)"
                }
              }
            }
          },
          "from": {
            "type": "string",
            "format": "email",
            "description": "Sender email address (must belong to a verified domain)",
            "example": "hello@yourapp.com"
          },
          "to": {
            "oneOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                },
                "maxItems": 50
              }
            ],
            "description": "One recipient address, or a list of them",
            "example": [
              "user@example.com"
            ]
          },
          "cc": {
            "oneOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                }
              }
            ],
            "description": "Cc recipients"
          },
          "bcc": {
            "oneOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                }
              }
            ],
            "description": "Bcc recipients"
          },
          "reply_to": {
            "oneOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                }
              }
            ],
            "description": "Reply-To address or addresses"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line",
            "example": "Welcome!"
          },
          "tags": {
            "type": "array",
            "maxItems": 50,
            "description": "Up to 50 name/value pairs, returned on events and webhooks and filterable in logs",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "example": [
              {
                "name": "category",
                "value": "welcome"
              }
            ]
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom headers, e.g. X-Entity-Ref-ID",
            "example": {
              "X-Entity-Ref-ID": "abc-123"
            }
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Send later, up to 30 days ahead (ISO 8601)",
            "example": "2026-04-10T14:00:00Z"
          },
          "html": {
            "type": "string",
            "description": "HTML body of the email. Include `{{unsubscribe_url}}` (or the Resend-compatible `{{{RESEND_UNSUBSCRIBE_URL}}}`) anywhere in the body and SMTPfast substitutes the per-recipient unsubscribe link at send time. The same URL is set on the RFC 8058 `List-Unsubscribe` header automatically.",
            "example": "<h1>Hello!</h1><p><a href=\"{{unsubscribe_url}}\">Unsubscribe</a></p>"
          },
          "text": {
            "type": "string",
            "description": "Plain text fallback body. Supports the same `{{unsubscribe_url}}` placeholder as the HTML body.",
            "example": "Hello! (plain text fallback)"
          }
        }
      },
      "Email": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "subject",
          "status",
          "source",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "email_abc123"
          },
          "from": {
            "type": "string",
            "description": "As sent, so it can include a display name: Name <hello@yourapp.com>",
            "example": "hello@yourapp.com"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "example": [
              "user@example.com"
            ]
          },
          "subject": {
            "type": "string",
            "example": "Welcome!"
          },
          "html": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "scheduled",
              "sending",
              "sent",
              "delivered",
              "opened",
              "clicked",
              "bounced",
              "complained",
              "failed",
              "canceled"
            ],
            "example": "queued"
          },
          "source": {
            "type": "string",
            "example": "api",
            "description": "api, smtp, dashboard, broadcast or broadcast_test"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-05T12:00:00Z"
          }
        }
      },
      "EmailSummary": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "subject",
          "status",
          "source",
          "created_at",
          "sent_at",
          "delivered_at",
          "opened_at",
          "clicked_at",
          "bounced_at",
          "error_message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "email_abc123"
          },
          "from": {
            "type": "string",
            "example": "hello@yourapp.com"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "user@example.com"
            ]
          },
          "subject": {
            "type": "string",
            "example": "Welcome!"
          },
          "status": {
            "type": "string",
            "example": "delivered",
            "description": "queued, scheduled, sending, sent, delivered, opened, clicked, bounced, complained, failed or canceled"
          },
          "source": {
            "type": "string",
            "example": "api",
            "description": "api, smtp, dashboard, broadcast or broadcast_test"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "opened_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "clicked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "bounced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EmailList": {
        "type": "object",
        "required": [
          "data",
          "limit",
          "total",
          "has_more"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailSummary"
            }
          },
          "page": {
            "type": "integer",
            "example": 1,
            "description": "Absent when paging with after or before"
          },
          "limit": {
            "type": "integer",
            "example": 50
          },
          "total": {
            "type": "integer",
            "example": 1204,
            "description": "Emails matching the filters; with after or before, only those past that email"
          },
          "has_more": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "BatchSendRequest": {
        "type": "array",
        "description": "JSON array of email objects (1 to 100). Each item accepts the same fields as POST /v1/emails.",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "$ref": "#/components/schemas/SendEmailRequest"
        },
        "example": [
          {
            "from": "hello@yourapp.com",
            "to": "user1@example.com",
            "subject": "Welcome!",
            "html": "<h1>Hello User 1!</h1>"
          },
          {
            "from": "hello@yourapp.com",
            "to": [
              "user2@example.com",
              "user3@example.com"
            ],
            "subject": "Weekly digest",
            "html": "<h1>Your week</h1>",
            "scheduled_at": "2026-04-10T14:00:00Z"
          }
        ]
      },
      "BatchSendResponse": {
        "type": "object",
        "required": [
          "batch_id",
          "count",
          "emails",
          "data"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "description": "Identifier for the batch as a whole",
            "example": "batch_abc123"
          },
          "count": {
            "type": "integer",
            "description": "Number of emails created (matches input length)",
            "example": 2
          },
          "emails": {
            "type": "array",
            "description": "Per-row result. status is \"queued\" for normal sends, \"scheduled\" if scheduled_at is in the future, or \"failed\" if the row has no deliverable To recipient left after suppression (cc and bcc alone do not send).",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "email_abc123"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "scheduled",
                    "failed"
                  ],
                  "example": "queued"
                }
              }
            }
          },
          "data": {
            "type": "array",
            "description": "The same ids in Resend's batch response shape: one { id } per item, in request order.",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "email_abc123"
                }
              }
            }
          }
        }
      },
      "CreateContactRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The contact email address",
            "example": "steve@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Steve"
          },
          "lastName": {
            "type": "string",
            "example": "Wozniak"
          },
          "first_name": {
            "type": "string",
            "example": "Steve"
          },
          "last_name": {
            "type": "string",
            "example": "Wozniak"
          },
          "unsubscribed": {
            "type": "boolean",
            "description": "Global broadcast subscription status",
            "example": false
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "example": {
              "company": "Acme",
              "plan": "pro"
            }
          },
          "segment_ids": {
            "type": "array",
            "description": "Manual segment IDs to assign this contact to",
            "items": {
              "type": "string"
            },
            "example": [
              "clx_segment123"
            ]
          }
        }
      },
      "UpdateContactRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Steve"
          },
          "lastName": {
            "type": "string",
            "example": "Wozniak"
          },
          "first_name": {
            "type": "string",
            "example": "Steve"
          },
          "last_name": {
            "type": "string",
            "example": "Wozniak"
          },
          "unsubscribed": {
            "type": "boolean",
            "example": true
          },
          "properties": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "company": "Acme"
            }
          },
          "segment_ids": {
            "type": "array",
            "description": "Replace this contact's manual segment assignments",
            "items": {
              "type": "string"
            },
            "example": [
              "clx_segment123"
            ]
          }
        }
      },
      "ContactProperty": {
        "type": "object",
        "required": [
          "id",
          "key",
          "type",
          "fallback_value",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "example": "plan"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number"
            ]
          },
          "fallback_value": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Used when a contact has no value. A number for a number property; null when unset."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ContactCreated": {
        "type": "object",
        "required": [
          "object",
          "id"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "contact"
          },
          "id": {
            "type": "string",
            "example": "clx_contact123"
          }
        }
      },
      "ContactDeleted": {
        "type": "object",
        "required": [
          "object",
          "contact",
          "deleted"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "contact"
          },
          "contact": {
            "type": "string",
            "example": "clx_contact123"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ContactList": {
        "type": "object",
        "required": [
          "object",
          "has_more",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "has_more": {
            "type": "boolean",
            "example": false
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactSummary"
            }
          },
          "disposable": {
            "type": "integer",
            "example": 3,
            "description": "Subscribed contacts on throwaway-mailbox domains"
          }
        }
      },
      "ContactSummary": {
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at",
          "unsubscribed",
          "disposable",
          "suppressed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "clx_contact123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "steve@example.com"
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "Steve"
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "Wozniak"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "unsubscribed": {
            "type": "boolean",
            "example": false
          },
          "disposable": {
            "type": "boolean",
            "example": false,
            "description": "The address is on a known throwaway-mailbox domain (set when the contact is created)."
          },
          "suppressed": {
            "type": "boolean",
            "example": false
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SegmentSummary"
            }
          }
        }
      },
      "SegmentSummary": {
