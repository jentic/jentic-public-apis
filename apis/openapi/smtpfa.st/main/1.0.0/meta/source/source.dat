    "/v1/emails/{id}/share": {
      "post": {
        "operationId": "shareEmail",
        "summary": "Create a share link for a sent email",
        "description": "Mint a public, expiring link to the rendered view of one sent email (the stored HTML or text body, in a sandboxed frame). Nothing is stored; the link stops working when it expires. Default lifetime 7 days, maximum 30. Requires the email:read scope.",
        "tags": [
          "Emails"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The email ID (e.g. email_abc123)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expires_in": {
                    "type": "integer",
                    "description": "Lifetime in seconds (60 to 2592000)",
                    "default": 604800
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Share link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "share"
                    },
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - domain not verified or insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - retry after the period indicated in the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-sdk-group": [
          "emails"
        ],
        "x-sdk-method": "share"
      }
    },
    "/v1/emails/metrics": {
      "get": {
        "operationId": "getEmailMetrics",
        "summary": "Retrieve email metrics",
        "description": "Resend-compatible counts and rates over a date range, for transactional and broadcast email together. Leave dimensions out for one totals row; add period, domain, email or broadcast (email and broadcast cannot be combined) to break the numbers down. Each lifecycle timestamp counts in its own period. Sends where every recipient is the SES mailbox simulator are left out. Rates are percentages with one decimal. Open and click metrics need tracking on. Requires the email:read scope.",
        "tags": [
          "Emails"
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "description": "ISO 8601 date or datetime. A date means midnight in timezone. Defaults to 6 days before end_date.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "ISO 8601 date (the whole day is included) or datetime. Future values are clamped to now. Defaults to now.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "description": "IANA time zone for dates and periods, e.g. America/New_York. Default UTC.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "description": "Period size when period is a dimension. Default daily.",
            "schema": {
              "type": "string",
              "enum": [
                "hourly",
                "daily",
                "weekly",
                "monthly"
              ]
            }
          },
          {
            "name": "metrics",
            "in": "query",
            "description": "Comma-separated metrics to include. Omit for all.",
            "schema": {
              "type": "string",
              "example": "sent,delivered,open_rate"
            }
          },
          {
            "name": "dimensions",
            "in": "query",
            "description": "Comma-separated: period, domain, email, broadcast.",
            "schema": {
              "type": "string",
              "example": "period,domain"
            }
          },
          {
            "name": "domain_id",
            "in": "query",
            "description": "Comma-separated domain ids, up to 100.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email_id",
            "in": "query",
            "description": "Comma-separated email ids, up to 100. Not with broadcast.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "broadcast_id",
            "in": "query",
            "description": "Comma-separated broadcast ids, up to 100. Not with email.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "metrics"
                    },
                    "start_date": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end_date": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timezone": {
                      "type": "string"
                    },
                    "metrics": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "dimensions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "granularity": {
                      "type": "string"
                    },
                    "totals": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "example": {
                        "sent": 1204,
                        "delivered": 1180,
                        "open_rate": 50
                      }
                    },
                    "data": {
                      "type": "array",
                      "description": "One row per combination of the requested dimensions. Absent when no dimensions are requested.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "example": {
                          "period": "2026-07-01",
                          "domain_id": "dom_1",
                          "domain_name": "example.com",
                          "sent": 172,
                          "delivered": 169,
                          "open_rate": 49.7
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - check your payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - domain not verified or insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - retry after the period indicated in the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-sdk-group": [
          "emails"
        ],
        "x-sdk-method": "getMetrics"
      }
    },
