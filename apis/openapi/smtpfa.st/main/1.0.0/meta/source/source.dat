      },
      "post": {
        "operationId": "createInbox",
        "summary": "Create an inbox",
        "description": "Organise one address on your own domain as an inbox with threads, labels, folders and drafts. The domain must have receiving turned on and be able to send (mail from the inbox is sent from its address): verified for sending, or a receiving subdomain of a verified domain. SMTPfast never provisions addresses on a shared domain, so forwarding: true is refused and receiving_address is always null. Mail the address already received in the last 30 days is filed into threads. Requires the domain:write scope on a key created by a team owner or admin.",
        "tags": [
          "Inboxes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email_address"
                ],
                "properties": {
                  "email_address": {
                    "type": "string",
                    "format": "email",
                    "description": "A plain address on one of your domains, such as support@example.com"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Internal name. Defaults to email_address."
                  },
                  "from_name": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "The name recipients see. A plain name, not a Name <email> address."
                  },
                  "forwarding": {
                    "type": "boolean",
                    "description": "Not available: must be false or omitted. Inboxes receive through your domain's MX record."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new inbox",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inbox"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - check your payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
