    "/v1/emails/receiving/{id}/reply": {
      "post": {
        "operationId": "replyToReceivedEmail",
        "summary": "Reply to a received email",
        "description": "Send a reply to a received message through the normal send pipeline (credits, suppression, safety checks, webhooks). The reply is threaded with In-Reply-To and References and linked to the received message. From defaults to the receiving address when it can send (its domain is verified, or it is a receiving subdomain of a verified domain), otherwise to the same local part on the nearest verified parent domain with Reply-To set to the receiving address; pass from to pick another verified reply address. To defaults to the sender's Reply-To, then From. Requires the inbound:read and email:send scopes.",
        "tags": [
          "Receiving"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The received email id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Repeat the same key on a retry and the reply is sent once; the first email id is returned for 24 hours."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "One of the team's reply addresses for this message; see the dashboard detail's reply_from"
                  },
                  "to": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "cc": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "description": "Defaults to Re: plus the original subject"
                  },
                  "text": {
                    "type": "string"
                  },
                  "html": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reply accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
