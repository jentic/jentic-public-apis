    "/v1/database/preprints/biorxiv/rss": {
      "get": {
        "tags": [
          "Database",
          "preprints",
          "biorxiv",
          "rss"
        ],
        "summary": "Preprints",
        "description": "![GET](https://img.shields.io/badge/GET-success?style=plastic)`/v1/database/preprints/biorxiv/rss`  \n        **bioRxiv Preprints**  \nPreprint manuscripts posted to bioRxiv prior to peer review.  \nDisciplines include genomics, molecular biology, neuroscience, and immunology.  \nMaintained by Cold Spring Harbor Laboratory. Updated hourly.",
        "operationId": "_v1_database_preprints_biorxiv_rss_v1_database_preprints_biorxiv_rss_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "about",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true,
            "style": "form"
          },
          {
            "name": "creator",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "extra": {}
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "explode": true,
            "style": "form"
          },
          {
            "name": "description",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true,
            "style": "form"
          },
          {
            "name": "identifier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true,
            "style": "form"
          },
          {
            "name": "link",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true,
            "style": "form"
          },
