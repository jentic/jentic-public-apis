  "tags": [
    {
      "name": "database",
      "description": "**Database**\n<br/>\nEndpoints backed by ingested, normalized datasets. All endpoints share consistent\nfiltering operators, pagination via `limit` + `next_token`, and predictable JSON\nresponse envelopes.\n",
      "x-displayName": "Database",
      "x-short-description": "Normalized Dataset Endpoints"
    },
    {
      "name": "drug-applications",
      "description": "**Drug Applications** \n<br/>\nData and coverage related to FDA drug applications, including Drugs@FDA\nApplications, Submissions, and Application Documents (via openFDA), and editorial\nreporting of new applications and approvals.\n",
      "x-displayName": "Drug Applications",
      "x-short-description": "FDA Drug Application Data"
    },
    {
      "name": "clinical-trials",
      "description": "**Clinical Trials**\n<br/>\nRegistered study records from ClinicalTrials.gov alongside curated clinical trial\ncoverage. Includes study metadata, recruitment status, phases, and milestone dates.\nUse to identify active programs, monitor protocol changes, and summarize readouts.\n",
      "x-displayName": "Clinical Trials",
      "x-short-description": "ClinicalTrials.gov Study Records"
    },
    {
      "name": "drug-safety",
      "description": "**Drug Safety**\n<br/>\nOfficial FDA safety communications and enforcement, plus editorial safety alerts.\nIncludes MedWatch alerts, drug/device enforcement reports (openFDA), and news\ncoverage of recalls, boxed warnings, and risk notices.\n",
      "x-displayName": "Drug Safety",
      "x-short-description": "FDA Safety Communications & Enforcement"
    },
    {
      "name": "press-releases",
      "description": "**Press Releases**\n<br/>\nOfficial FDA press releases covering regulatory decisions, policy updates, and\nagency initiatives.\n",
      "x-displayName": "Press Releases",
      "x-short-description": "Official FDA Press Releases"
    },
    {
      "name": "advisory-committee",
      "description": "**Advisory Committee**\n<br/>\nFDA advisory committee calendars and Federal Register notices. Use to track meeting\nschedules, agendas, and related documents for drug and device reviews.\n",
      "x-displayName": "Advisory Committee",
      "x-short-description": "FDA Advisory Calendars & Notices"
    },
    {
      "name": "devices",
      "description": "**Devices**\n<br/>\nMedical device pathways and actions including 510(k) clearances and PMA approvals\n(openFDA), with associated metadata such as decision codes, dates, and product\nidentifiers.\n",
      "x-displayName": "Devices",
      "x-short-description": "Device Clearances and Approvals"
    },
    {
      "name": "recalls",
      "description": "**Recalls**\n<br/>\nEnforcement reports for drugs and devices, including classification, reason for\nrecall, recalling firm, and report dates (openFDA). Useful for pharmacovigilance\nworkflows and compliance monitoring.\n",
      "x-displayName": "Recalls",
      "x-short-description": "Drug and Device Recalls"
    },
    {
      "name": "drug-labels",
      "description": "**Drug Labels**\n<br/>\nStructured Product Labeling (SPL) documents and label update feeds from DailyMed.\nCovers label versions, metadata, and recent changes.\n",
      "x-displayName": "Drug Labels",
      "x-short-description": "Structured Drug Labeling (SPL)"
    },
    {
      "name": "news",
      "description": "**News**\n<br/>\nGeneral pharma/biotech coverage from industry outlets. Use to monitor commercial\nupdates, deal flow, and macro trends.\n",
      "x-displayName": "News",
      "x-short-description": "Industry News and Coverage"
    },
    {
      "name": "preprints",
      "description": "**Preprints**\n<br/>\nPre-publication research feeds spanning biological and medical sciences. Includes\nbioRxiv/medRxiv with authorship, titles, and publication timestamps.\n",
      "x-displayName": "Preprints",
      "x-short-description": "Life Sciences Preprints"
    },
    {
      "name": "purple-book",
      "description": "**Purple Book**\n<br/>\nFDA Purple Book datasets for licensed biological products (and related reference\ndata). Includes products, proper/proprietary names, strength, presentation, routes\nof administration, applicants, and reference names.\n",
      "x-displayName": "Purple Book",
      "x-short-description": "Licensed Biological Products"
    },
    {
      "name": "orange-book",
      "description": "**Orange Book**\n<br/>\nFDA Orange Book datasets for approved drug products and related patent/exclusivity\ninformation. Includes monthly product files, patent and exclusivity tables, and code\ndefinitions, plus newly added and delisted patents.\n",
      "x-displayName": "Orange Book",
      "x-short-description": "Approved Drug Products and Patents"
    },
    {
      "name": "puda",
      "description": "**PDUFA**\n<br/>\nPrescription Drug User Fee Act calendars and target action dates for drug\napplication reviews and related milestones.\n",
      "x-displayName": "PDUFA",
      "x-short-description": "PDUFA Target Action Dates"
    },
    {
      "name": "market-intelligence",
      "description": "**Market Intelligence**\n<br/>\nFeeds focused on commercialization, launches, executive moves, and broader industry\ndevelopments to support competitive insights.\n",
      "x-displayName": "Market Intelligence",
      "x-short-description": "Commercialization and Market Updates"
    },
    {
      "name": "open-fda",
      "description": "**Open FDA**\n<br/>\nOfficial FDA APIs exposing Drugs@FDA (applications, submissions, documents), device\n510(k)/PMA pathways, and drug/device enforcement datasets.\n",
      "x-displayName": "Open FDA",
      "x-short-description": "Official FDA Data APIs"
    },
    {
      "name": "fda-rss",
      "description": "**FDA RSS Feeds**\n<br/>\nOfficial RSS feeds from FDA including press releases, MedWatch safety alerts, and\nother communications.\n",
      "x-displayName": "FDA RSS Feeds",
      "x-short-description": "Official FDA RSS Feeds"
    },
    {
      "name": "fda-podcast",
      "description": "**FDA Podcast**\n<br/>\nFDA Drug Safety Podcast audio feed covering medication safety topics and guidance.\n",
      "x-displayName": "FDA Podcast",
      "x-short-description": "FDA Drug Safety Podcast"
    },
    {
      "name": "fda-advisory",
      "description": "**FDA Advisory**\n<br/>\nAdvisory committee calendars and materials for upcoming FDA meetings.\n",
      "x-displayName": "FDA Advisory",
      "x-short-description": "FDA Advisory Calendars & Materials"
    },
    {
      "name": "drugs-com",
      "description": "**Drugs.com**\n<br/>\nEditorial news and reporting covering new applications/approvals, clinical trials,\nmedical news, and FDA alerts.\n",
      "x-displayName": "Drugs.com",
      "x-short-description": "Drugs.com Editorial News"
    },
    {
      "name": "sec",
      "description": "**SEC**\n<br/>\nCompany tickers mapped to CIK identifiers and registrant names; useful for joining\nmarket entities to biomedical datasets.\n",
      "x-displayName": "SEC",
      "x-short-description": "SEC Tickers and CIK Mapping"
    },
    {
      "name": "clinicaltrials-gov",
      "description": "**ClinicalTrials.gov**\n<br/>\nPublic registry of clinical studies with structured protocol and status metadata.\n",
      "x-displayName": "ClinicalTrials.gov",
      "x-short-description": "ClinicalTrials.gov Registry Data"
    },
    {
      "name": "federal-register",
      "description": "**Federal Register**\n<br/>\nGovernment notices and regulatory announcements including FDA advisory committee\nmeeting notices and related documents.\n",
      "x-displayName": "Federal Register",
      "x-short-description": "Federal Register Notices"
    },
    {
      "name": "dailymed",
      "description": "**DailyMed**\n<br/>\nStructured Product Labeling (SPL) documents and label update feeds for drug\nproducts.\n",
      "x-displayName": "DailyMed",
      "x-short-description": "DailyMed Drug Label Updates"
    },
    {
      "name": "biorxiv",
      "description": "**bioRxiv**\n<br/>\nBiological sciences preprint server maintained by Cold Spring Harbor Laboratory.\n",
      "x-displayName": "bioRxiv",
      "x-short-description": "bioRxiv Preprint Server"
    },
    {
