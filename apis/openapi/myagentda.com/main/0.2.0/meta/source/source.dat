{"openapi":"3.0.3","info":{"title":"agentda","version":"0.2.0","description":"Agent-native task management plus a shared team knowledge base (topics). The agenda endpoint returns rendered Markdown; the topics endpoints expose knowledge topics, documents, hybrid search, and topic history as JSON."},"servers":[{"url":"https://myagentda.com","description":"agentda deployment serving this specification."}],"security":[{"agentdaToken":[]}],"paths":{"/api/v1/agenda":{"get":{"operationId":"getMyAgenda","summary":"Get the user's prioritized task agenda","description":"Returns the user's prioritized task overview as Markdown: follow-ups due today, overdue tasks, tasks due today, tasks delegated to others (waiting), and remaining open tasks. Snoozed tasks are hidden. Use this whenever the user asks what is on their plate or what they should work on next. Render or summarize the returned Markdown for the user.","x-amzn-operation-type":"read","parameters":[{"name":"scope","in":"query","required":false,"description":"Optional filter. Use mine for the user's own work only, delegated_by_me for tasks the user delegated to others, cc for tasks the user is only watching. Omit for the full agenda.","schema":{"type":"string","enum":["mine","delegated_by_me","cc"]}}],"responses":{"200":{"description":"The agenda was rendered successfully.","content":{"application/json":{"schema":{"type":"object","description":"The rendered agenda.","properties":{"markdown":{"type":"string","description":"The full agenda as Markdown, grouped into sections such as Overdue, Due today and Open. Empty agendas return a short notice instead."},"snoozed_count":{"type":"integer","description":"Number of snoozed tasks hidden from the agenda."}}}}}},"401":{"description":"The access token is missing or invalid.","content":{"application/json":{"schema":{"type":"object","description":"Error details.","properties":{"error":{"type":"string","description":"Machine-readable error code."},"message":{"type":"string","description":"Human-readable error message."}}}}}}}}},"/api/v1/topics":{"get":{"operationId":"listTopics","summary":"List knowledge topics","description":"Lists all knowledge topics visible to the user with role, counts, and last activity. Topics are shared knowledge scopes referenced as T-1, T-2, …","parameters":[{"name":"include_archived","in":"query","required":false,"description":"Set to true to include archived (read-only) topics.","schema":{"type":"boolean"}}],"responses":{"200":{"description":"Visible topics.","content":{"application/json":{"schema":{"type":"object","description":"Topic list.","properties":{"topics":{"type":"array","description":"Topics visible to the caller, most recently active first.","items":{"$ref":"#/components/schemas/TopicListEntry"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}},"post":{"operationId":"createTopic","summary":"Create a knowledge topic","description":"Creates a topic. Private by default (only creator + named people); visibility 'workspace' makes it readable for the whole workspace while write access stays with the admin + named writers. Added people are notified by email.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"Topic to create.","required":["name"],"properties":{"name":{"type":"string","description":"Unique topic name (per workspace, case-insensitive)."},"description":{"type":"string","description":"What belongs in this topic."},"visibility":{"type":"string","enum":["private","workspace"],"description":"Default private. workspace = everyone can read; writing stays limited."},"writers":{"type":"array","description":"User IDs or member emails granted read + write access.","items":{"type":"string","description":"User ID or member email."}},"readers":{"type":"array","description":"User IDs or member emails granted read-only access.","items":{"type":"string","description":"User ID or member email."}}}}}}},"responses":{"201":{"description":"The topic was created.","content":{"application/json":{"schema":{"type":"object","description":"Created topic.","properties":{"topic":{"$ref":"#/components/schemas/Topic"}}}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},"/api/v1/topics/{ref}":{"get":{"operationId":"getTopicDetails","summary":"Topic details","description":"Returns a topic with members (roles), document metadata, and linked tasks. Unknown or invisible topics return 404 — visibility requires membership or a workspace-visible topic.","parameters":[{"$ref":"#/components/parameters/TopicRef"}],"responses":{"200":{"description":"Topic details.","content":{"application/json":{"schema":{"type":"object","description":"Topic with access, documents, and linked tasks.","properties":{"topic":{"$ref":"#/components/schemas/Topic"},"my_role":{"type":"string","enum":["admin","writer","reader"],"description":"The caller's effective role."},"members":{"type":"array","description":"People with explicit access.","items":{"type":"object","description":"Topic member.","properties":{"user_id":{"type":"string","description":"User ID."},"role":{"type":"string","enum":["admin","writer","reader"],"description":"Member role."},"display_name":{"type":"string","description":"Display name."}}}},"documents":{"type":"array","description":"Document metadata (content via the document endpoint).","items":{"$ref":"#/components/schemas/DocumentMeta"}},"linked_tasks":{"type":"array","description":"Tasks linked to this topic (visible to everyone with topic access).","items":{"type":"object","description":"Linked task.","properties":{"number":{"type":"string","description":"Task number, e.g. A-17."},"title":{"type":"string","description":"Task title."},"status":{"type":"string","description":"Task status."}}}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}},"patch":{"operationId":"manageTopic","summary":"Manage a topic","description":"Topic admin: add writers/readers (notified by email), remove members, switch visibility, rename, change description, archive/reactivate, delete a document.","parameters":[{"$ref":"#/components/parameters/TopicRef"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"Changes to apply; all fields optional.","properties":{"add_writers":{"type":"array","description":"Grant read + write.","items":{"type":"string","description":"User ID or member email."}},"add_readers":{"type":"array","description":"Grant read-only.","items":{"type":"string","description":"User ID or member email."}},"remove_members":{"type":"array","description":"Revoke access.","items":{"type":"string","description":"User ID or member email."}},"visibility":{"type":"string","enum":["private","workspace"],"description":"New visibility."},"rename":{"type":"string","description":"New topic name."},"description":{"type":"string","nullable":true,"description":"New description (null clears it)."},"archive":{"type":"boolean","description":"true = archive (read-only), false = reactivate."},"delete_document":{"type":"string","description":"Document ID to delete (admin only)."}}}}}},"responses":{"200":{"description":"Applied changes.","content":{"application/json":{"schema":{"type":"object","description":"Result of the management call.","properties":{"topic":{"$ref":"#/components/schemas/Topic"},"applied":{"type":"array","description":"Changes applied.","items":{"type":"string","description":"Human-readable change."}},"skipped":{"type":"array","description":"No-ops that were skipped.","items":{"type":"string","description":"Reason."}}}}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/topics/{ref}/documents":{"post":{"operationId":"createTopicDocument","summary":"Save a knowledge document","description":"Saves a new markdown document into the topic (max 4 MB). Requires write access (topic admin or writer). Rate limit: 120 documents/hour per user.","parameters":[{"$ref":"#/components/parameters/TopicRef"}],"requestBody":{"$ref":"#/components/requestBodies/DocumentBody"},"responses":{"201":{"$ref":"#/components/responses/DocumentSaved"},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/topics/{ref}/documents/{id}":{"get":{"operationId":"getTopicDocument","summary":"Read a knowledge document","description":"Returns the full markdown content, optionally an older version.","parameters":[{"$ref":"#/components/parameters/TopicRef"},{"name":"id","in":"path","required":true,"description":"Document ID (UUID).","schema":{"type":"string"}},{"name":"version","in":"query","required":false,"description":"Older version number; omit for the current version.","schema":{"type":"integer"}}],"responses":{"200":{"description":"The document.","content":{"application/json":{"schema":{"type":"object","description":"Document with content.","properties":{"document":{"$ref":"#/components/schemas/DocumentContent"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}},"put":{"operationId":"updateTopicDocument","summary":"Update a knowledge document","description":"Saves a new version of the document (previous versions stay recoverable via the version query parameter). Requires write access.","parameters":[{"$ref":"#/components/parameters/TopicRef"},{"name":"id","in":"path","required":true,"description":"Document ID (UUID).","schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/DocumentBody"},"responses":{"200":{"$ref":"#/components/responses/DocumentSaved"},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}},"delete":{"operationId":"deleteTopicDocument","summary":"Delete a knowledge document","description":"Deletes a document. Topic admin (creator) only; the deletion stays in the topic history.","parameters":[{"$ref":"#/components/parameters/TopicRef"},{"name":"id","in":"path","required":true,"description":"Document ID (UUID).","schema":{"type":"string"}}],"responses":{"200":{"description":"The document was deleted.","content":{"application/json":{"schema":{"type":"object","description":"Deletion result.","properties":{"deleted":{"type":"string","description":"Title of the deleted document."}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/topics/{ref}/updates":{"get":{"operationId":"getTopicUpdates","summary":"What's new in a topic","description":"Chronological events since a given time: new/changed documents, new members, newly linked tasks. Topics never push — this is the pull channel.","parameters":[{"$ref":"#/components/parameters/TopicRef"},{"name":"since","in":"query","required":false,"description":"ISO 8601 timestamp; omit for the most recent events.","schema":{"type":"string"}}],"responses":{"200":{"$ref":"#/components/responses/TopicTimeline"},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/topics/{ref}/history":{"get":{"operationId":"getTopicHistory","summary":"Topic history","description":"The complete, append-only history of a topic with human-readable descriptions.","parameters":[{"$ref":"#/components/parameters/TopicRef"}],"responses":{"200":{"$ref":"#/components/responses/TopicTimeline"},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/knowledge/search":{"get":{"operationId":"searchKnowledge","summary":"Search the knowledge base","description":"Hybrid full-text + semantic search across all topics visible to the user (semantic degrades gracefully to full-text when unavailable). Returns snippets; fetch full documents via the document endpoint.","parameters":[{"name":"q","in":"query","required":true,"description":"Search query (min 2 characters).","schema":{"type":"string"}},{"name":"topic","in":"query","required":false,"description":"Limit to one topic (T-3, name, or UUID).","schema":{"type":"string"}}],"responses":{"200":{"description":"Search results.","content":{"application/json":{"schema":{"type":"object","description":"Ranked hits.","properties":{"semantic":{"type":"boolean","description":"Whether the semantic leg contributed."},"hits":{"type":"array","description":"Ranked results, best first.","items":{"type":"object","description":"Search hit.","properties":{"document_id":{"type":"string","description":"Document ID."},"topic":{"type":"string","description":"Topic number, e.g. T-3."},"topic_name":{"type":"string","description":"Topic name."},"title":{"type":"string","description":"Document title."},"snippet":{"type":"string","description":"Matching excerpt."},"source":{"type":"string","nullable":true,"description":"Document source."},"author":{"type":"string","description":"Last author."},"updated_at":{"type":"string","description":"Last update (ISO 8601)."},"matched_by":{"type":"string","enum":["text","semantic","both"],"description":"Which search leg matched."}}}}}}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthorized"}}}}},"components":{"parameters":{"TopicRef":{"name":"ref","in":"path","required":true,"description":"Topic reference: number (T-3), unique name, or UUID.","schema":{"type":"string"}}},"requestBodies":{"DocumentBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"Markdown document.","required":["title","content_md"],"properties":{"title":{"type":"string","description":"Document title."},"content_md":{"type":"string","description":"Markdown content (max 4 MB)."},"source":{"type":"string","description":"Where this came from (meeting, URL, research session)."}}}}}}},"responses":{"Unauthorized":{"description":"The access token is missing or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"Not found — or not visible to the caller (no existence leak).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"The caller's role does not allow this action.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"ValidationFailed":{"description":"The request was invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"DocumentSaved":{"description":"The document was saved.","content":{"application/json":{"schema":{"type":"object","description":"Saved document reference.","properties":{"document":{"type":"object","description":"Saved document.","properties":{"id":{"type":"string","description":"Document ID."},"title":{"type":"string","description":"Title."},"version":{"type":"integer","description":"Version after this save."},"topic":{"type":"string","description":"Topic number, e.g. T-3."}}}}}}}},"TopicTimeline":{"description":"Chronological topic events.","content":{"application/json":{"schema":{"type":"object","description":"Topic with event entries.","properties":{"topic":{"$ref":"#/components/schemas/Topic"},"entries":{"type":"array","description":"Events in chronological order.","items":{"type":"object","description":"Topic event.","properties":{"seq":{"type":"integer","description":"Sequence number."},"at":{"type":"string","description":"Timestamp (ISO 8601)."},"type":{"type":"string","description":"Event type."},"description":{"type":"string","description":"Human-readable description."}}}}}}}}}},"schemas":{"Error":{"type":"object","description":"Error details.","properties":{"error":{"type":"string","description":"Machine-readable error code."},"message":{"type":"string","description":"Human-readable error message."}}},"Topic":{"type":"object","description":"A knowledge topic.","properties":{"id":{"type":"string","description":"Topic UUID."},"number":{"type":"string","description":"Short reference, e.g. T-3."},"name":{"type":"string","description":"Unique name."},"description":{"type":"string","nullable":true,"description":"What belongs in this topic."},"visibility":{"type":"string","enum":["private","workspace"],"description":"private: only named people. workspace: everyone reads."},"status":{"type":"string","enum":["active","archived"],"description":"Archived topics are read-only."},"created_at":{"type":"string","description":"Creation time (ISO 8601)."},"updated_at":{"type":"string","description":"Last change (ISO 8601)."}}},"TopicListEntry":{"type":"object","description":"Topic with activity overview.","properties":{"id":{"type":"string","description":"Topic UUID."},"number":{"type":"string","description":"Short reference, e.g. T-3."},"name":{"type":"string","description":"Unique name."},"description":{"type":"string","nullable":true,"description":"Description."},"visibility":{"type":"string","enum":["private","workspace"],"description":"Visibility."},"status":{"type":"string","enum":["active","archived"],"description":"Status."},"my_role":{"type":"string","enum":["admin","writer","reader"],"description":"The caller's effective role."},"member_count":{"type":"integer","description":"People with explicit access."},"document_count":{"type":"integer","description":"Number of documents."},"linked_task_count":{"type":"integer","description":"Number of linked tasks."},"last_activity_at":{"type":"string","description":"Last event (ISO 8601)."},"created_at":{"type":"string","description":"Creation time (ISO 8601)."},"updated_at":{"type":"string","description":"Last change (ISO 8601)."}}},"DocumentMeta":{"type":"object","description":"Document metadata (no content).","properties":{"id":{"type":"string","description":"Document ID."},"title":{"type":"string","description":"Title."},"source":{"type":"string","nullable":true,"description":"Source."},"version":{"type":"integer","description":"Current version."},"size_chars":{"type":"integer","description":"Content length in characters."},"updated_by":{"type":"string","description":"Last author."},"updated_at":{"type":"string","description":"Last update (ISO 8601)."}}},"DocumentContent":{"type":"object","description":"Document with full markdown content.","properties":{"id":{"type":"string","description":"Document ID."},"topic":{"type":"string","description":"Topic number, e.g. T-3."},"title":{"type":"string","description":"Title of the returned version."},"content_md":{"type":"string","description":"Full markdown content."},"source":{"type":"string","nullable":true,"description":"Source."},"version":{"type":"integer","description":"Returned version."},"current_version":{"type":"integer","description":"Latest version."},"updated_at":{"type":"string","description":"Last update (ISO 8601)."}}}},"securitySchemes":{"agentdaToken":{"type":"apiKey","in":"header","name":"Authorization","description":"agentda access token sent in the Authorization header. Provide the value as 'Bearer <token>'; the raw token without the Bearer prefix is also accepted."}}}}