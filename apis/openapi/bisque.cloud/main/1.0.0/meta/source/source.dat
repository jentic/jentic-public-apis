                }
              }
            }
          },
          "400": {
            "description": "The body was not one of the three accepted shapes, was empty, or named more than 20 presentations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A credential was sent and is unusable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The window had no room for even the first item. Wait `Retry-After` seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presentations": {
      "get": {
        "tags": [
          "Publish"
        ],
        "operationId": "listPresentationsV1",
        "summary": "Your presentations, newest first, cursor-paginated",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The `nextCursor` from the previous page. Opaque."
          },
          {
            "name": "visibility",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "public",
                "unlisted",
                "private",
                "org"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad `visibility` or a cursor this endpoint did not issue.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Versioned address of `/api/presentations` — the same endpoint and contract."
      }
    },
    "/api/v1/presentations/create": {
      "post": {
        "tags": [
          "Publish"
        ],
        "operationId": "createPresentationV1",
        "summary": "Publish a presentation from HTML",
        "description": "Versioned address of `/api/presentations/create` — the same endpoint and contract. Send the `html-presentation/v1` file. Bisque parses it, narrates each slide server-side, and publishes to `webUrl`. The reply is immediate (202); narration finishes in the background — poll `statusUrl`. Re-send with the same `slug` to republish. With `dryRun: true` the same checks run and nothing is written: the reply is a 200 with status `validated` (the sandbox).",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePresentationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dry run passed (`dryRun: true`): every check succeeded and nothing was published. `webUrl` is where a real create would publish.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePresentationResult"
                }
              }
            }
          },
          "202": {
            "description": "Accepted; narration queued.",
            "headers": {
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePresentationResult"
                }
              }
            }
          },
          "400": {
            "description": "The HTML or a field failed validation; `error.message` names the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A create for the same presentation is still running (`CREATE_IN_PROGRESS`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presentations/status": {
      "get": {
        "tags": [
          "Publish"
        ],
        "operationId": "getPresentationStatusV1",
        "summary": "Narration and publish progress",
        "parameters": [
          {
            "name": "presentationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationStatus"
                }
              }
            }
          },
          "400": {
            "description": "`presentationId` missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not one of your presentations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Versioned address of `/api/presentations/status` — the same endpoint and contract."
      }
    },
    "/api/v1/presentations/publish-narrated": {
      "post": {
        "tags": [
          "Publish"
        ],
        "operationId": "publishNarratedPresentationV1",
        "deprecated": true,
        "summary": "Publish with audio you synthesized locally (deprecated)",
        "description": "Versioned address of `/api/presentations/publish-narrated` — the same endpoint and contract. Superseded by `POST /v1/presentations`, which puts the slides up before narrating them. This one publishes nothing until every slide is narrated, so the watch URL does not work until the whole run finishes. It keeps working. Narrate each slide with the `bisque-voice` CLI, then post the HTML plus per-slide MP3s and word timings; slides you omit from `audio` carry their audio forward when their narration text is unchanged. API-key callers only.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishNarratedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted; upload the bytes to `uploadUrls`, then POST `completeUrl`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishNarratedResult"
                }
              }
            }
          },
          "400": {
            "description": "Audio or HTML failed validation; the message names the slide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/oembed": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getOEmbedV1",
        "summary": "oEmbed for a watch URL",
        "security": [],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "oEmbed `video` payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Not a Bisque watch URL.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No public presentation there.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Versioned address of `/api/oembed` — the same endpoint and contract."
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        },
        "description": "A unique key per logical request (a UUID). A retry with the same key and body replays the first response with `Idempotent-Replayed: true` instead of publishing again; the same key with a different body is a 422 `IDEMPOTENCY_KEY_REUSED`. Keys last 24 hours."
      }
    },
    "headers": {
      "RateLimit-Limit": {
        "schema": {
          "type": "integer"
        },
        "description": "Requests allowed in the window."
      },
      "RateLimit-Remaining": {
        "schema": {
          "type": "integer"
        },
        "description": "Requests left in the window."
      },
      "RateLimit-Reset": {
        "schema": {
          "type": "integer"
        },
        "description": "Seconds until the window resets."
      },
      "RateLimit-Policy": {
        "schema": {
          "type": "string"
        },
        "description": "`<limit>;w=<window seconds>`."
      },
      "Deprecation": {
        "schema": {
          "type": "string"
        },
        "description": "Present on a deprecated endpoint: the date it was deprecated (RFC 9745)."
      },
      "Sunset": {
        "schema": {
          "type": "string"
        },
        "description": "Present on a deprecated endpoint: the date it stops serving (RFC 8594), at least 90 days out."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Bisque API key (`bisque_live_…`, from https://bisque.cloud/setup/keys or the `bisque login` device flow) or an OAuth access token (`bisque_oat_…`). Send as `Authorization: Bearer <credential>`. Walkthrough: /auth.md."
      },
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 with PKCE (S256) and dynamic client registration. Issuer https://bisque.cloud.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://bisque.cloud/oauth/authorize",
            "tokenUrl": "https://bisque.cloud/oauth/token",
            "refreshUrl": "https://bisque.cloud/oauth/token",
            "scopes": {
              "presentations": "Publish, list, and read presentations as the user.",
              "openid": "Read the user's subject identifier.",
              "email": "Read the user's email address."
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every error is JSON. `error.code` is stable and upper-snake-case; `error.message` is for people; `requestId` is what to quote in a bug report.",
        "required": [
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "UNAUTHORIZED",
                  "INVALID_ACCESS_TOKEN",
                  "INVALID_PRESENTATION_ID",
                  "CONTEXT_RATE_LIMITED",
                  "METHOD_NOT_ALLOWED",
                  "NOT_FOUND"
                ]
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string",
                "description": "Where to look next, when there is one."
              }
            }
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "description": "RFC 6749 §5.2 error body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "examples": [
              "invalid_request",
              "invalid_client",
              "invalid_grant",
              "unsupported_grant_type"
            ]
          },
          "error_description": {
            "type": "string"
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {},
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "data": {}
            }
          }
        }
      },
      "CreatePresentationRequest": {
        "type": "object",
        "required": [
          "indexHtml"
        ],
        "properties": {
          "indexHtml": {
            "type": "string",
            "description": "The whole `html-presentation/v1` file."
          },
          "title": {
            "type": "string",
            "description": "Overrides the title parsed from the HTML."
          },
          "slug": {
            "type": "string",
            "description": "URL slug under your channel. Reuse it to republish."
          },
          "presentationId": {
            "type": "string",
            "description": "Republish an existing presentation by id instead of slug."
          },
          "handle": {
            "type": "string",
            "description": "Which of your channels to publish on; defaults to your account's."
          },
          "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "Sandbox: run every check a real create runs (format, slug and org conflicts, tier cap, credit preflight) and write nothing. The reply is a 200 with status `validated`."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "unlisted",
              "private",
              "org"
            ],
            "default": "unlisted"
          },
          "org": {
            "type": "string",
            "description": "bisque.team organization slug; publishes into the company space."
          },
          "contextMd": {
            "type": "string",
            "description": "Agent-facing background shipped with the bundle as `context.md`."
          },
          "designMd": {
            "type": "string",
            "description": "Design notes shipped with the bundle."
          },
          "voiceId": {
            "type": "string",
            "description": "Narration voice tag; defaults to the account's saved voice."
          },
          "madeWith": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "description": "Models credited with making this presentation — e.g. [\"Claude Opus 5\", \"Kokoro af_heart\"]. Free text, shown to viewers in the watch page's ⋯ menu. Omit to keep what a previous publish recorded; send `[]` to clear it."
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "description": "Plain-text description shown under the player on the watch page, with web URLs linked — a summary, then the sources. Omit to keep what a previous publish sent; send an empty string to clear it."
          },
          "speechSpeed": {
            "type": "number"
          },
          "voiceStability": {
            "type": "number"
          },
          "assets": {
            "type": "object",
            "additionalProperties": true,
            "description": "Page assets (fonts, images) keyed by bundle path."
          }
        }
      },
      "PresentationPage": {
        "type": "object",
        "required": [
          "requestId",
          "items",
          "nextCursor",
          "hasMore"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresentationSummary"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` for the next page; null on the last page."
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "PresentationSummary": {
        "type": "object",
        "required": [
          "presentationId",
          "title",
          "slug",
          "visibility",
          "publishStatus",
          "webUrl"
        ],
        "properties": {
          "presentationId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "unlisted",
              "private",
              "org"
            ]
          },
          "publishStatus": {
            "type": "string"
          },
          "webUrl": {
            "type": "string",
            "format": "uri"
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CreatePresentationResult": {
        "type": "object",
        "required": [
          "requestId",
          "presentationId",
          "webUrl",
          "status",
          "statusUrl"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "presentationId": {
            "type": "string"
          },
          "webUrl": {
            "type": "string",
            "format": "uri",
            "description": "The watch link, e.g. https://bisque.today/p/{handle}/{slug}."
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "queued",
              "validated"
            ],
            "description": "`queued`: narration running, poll `statusUrl`. `ready`: live now. `validated`: a dry run passed and nothing was written."
          },
          "statusUrl": {
            "type": "string",
            "format": "uri"
          },
          "narration": {
            "type": "object",
            "additionalProperties": true
          },
          "dryRun": {
            "type": "boolean",
            "description": "Present and true only on a dry-run reply."
          }
        }
      },
      "PresentationContextBatchRequest": {
        "description": "Up to 20 presentations to read. Any of the three shapes.",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "urls"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      },
      "PresentationContextBatchResult": {
        "type": "object",
        "required": [
          "requestId",
          "items"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "description": "One row per requested item, in request order.",
            "items": {
              "type": "object",
              "required": [
                "ok",
                "input"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "input": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "The item as sent, normalized to an object."
                },
                "presentation": {
                  "$ref": "#/components/schemas/PresentationContext"
                },
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PresentationStatus": {
        "type": "object",
        "required": [
          "requestId",
          "presentationId",
          "publishStatus",
          "ready"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "presentationId": {
            "type": "string"
          },
          "webUrl": {
            "type": "string",
            "format": "uri"
          },
          "publishStatus": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "visibility": {
            "type": "string"
          },
          "narration": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PublishNarratedRequest": {
        "type": "object",
        "required": [
          "indexHtml"
        ],
        "description": "`CreatePresentationRequest` plus per-slide narration metadata. The MP3 bytes are NOT in this body: the reply returns one signed `uploadUrls[]` entry per file, you PUT the bytes there, then POST `completeUrl` with the echoed `files`.",
        "allOf": [
          {
            "$ref": "#/components/schemas/CreatePresentationRequest"
          }
        ],
        "properties": {
          "audio": {
            "type": "array",
            "description": "One entry per narrated slide you synthesized. Omit a slide to carry its last-published audio forward when its narration text is unchanged; omit the array to carry every slide forward.",
            "items": {
              "type": "object",
              "required": [
                "words",
                "durationMs",
                "size",
                "hash"
              ],
              "properties": {
                "slideKey": {
                  "type": "string",
                  "description": "The slide's key from the narration plan (the MP3 filename stem). Either this or `slideIndex`."
                },
                "slideIndex": {
                  "type": "integer",
                  "description": "0-based index of the slide in the HTML."
                },
                "words": {
                  "type": "array",
                  "description": "Word timings from the synthesizer, in narration order; must match the slide's narration word for word.",
                  "items": {
                    "type": "object",
                    "required": [
                      "word",
                      "start",
                      "end"
                    ],
                    "properties": {
                      "word": {
                        "type": "string"
                      },
                      "start": {
                        "type": "number",
                        "description": "Seconds."
                      },
                      "end": {
                        "type": "number",
                        "description": "Seconds."
                      }
                    }
                  }
                },
                "durationMs": {
                  "type": "integer",
                  "description": "Length of the MP3."
                },
                "size": {
                  "type": "integer",
                  "description": "Encoded MP3 bytes."
                },
                "hash": {
                  "type": "string",
                  "description": "sha256 of the MP3 bytes; verified after upload."
                },
                "contentType": {
                  "type": "string",
                  "const": "audio/mpeg",
                  "description": "Optional; anything but MP3 is refused."
                }
              }
            }
          },
          "assets": {
            "type": "array",
            "description": "Page assets (fonts, images) as file descriptors; bytes go through `uploadUrls` like the audio.",
            "items": {
              "type": "object",
              "required": [
                "path",
                "size",
                "hash"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Bundle path under assets/."
                },
                "size": {
                  "type": "integer"
                },
                "hash": {
                  "type": "string",
                  "description": "sha256 of the bytes."
                }
              }
            }
          }
        }
      },
      "PublishNarratedResult": {
        "type": "object",
        "required": [
          "requestId",
          "presentationId",
          "uploadUrls",
          "completeUrl",
          "files"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "presentationId": {
            "type": "string"
          },
          "webUrl": {
            "type": "string",
            "format": "uri"
          },
          "uploadUrls": {
            "type": "array",
            "description": "One signed PUT target per file whose bytes the server does not already have.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "completeUrl": {
            "type": "string",
            "format": "uri",
            "description": "POST here with `files` once every upload succeeded."
          },
          "files": {
            "type": "array",
            "description": "Echo back verbatim as the `files` of the complete call.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "AskRequest": {
        "type": "object",
        "description": "Either the flat form (`query` is a string) or the NLWeb 0.55 structured form (`query` is an object).",
        "properties": {
          "query": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "site": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "site": {
            "type": "string"
          },
          "prev": {
            "type": "string",
            "description": "Comma-separated previous queries."
          },
          "streaming": {
            "type": "boolean",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "list",
              "summarize",
              "generate"
            ],
            "default": "list"
          },
          "query_id": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "properties": {
              "prev": {
                "type": "string"
              }
            }
          },
          "prefer": {
            "type": "object",
            "properties": {
              "streaming": {
                "type": "boolean"
              },
              "mode": {
                "type": "string"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "const": "0.55"
              }
            }
          }
        }
      },
      "AskItem": {
        "type": "object",
        "required": [
          "url",
          "name",
          "site",
          "score",
          "description",
          "schema_object"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "schema_object": {
            "type": "object",
            "additionalProperties": true,
            "description": "A schema.org object: TechArticle for a docs page, VideoObject for a presentation."
          }
        }
      },
      "AskResponse": {
        "type": "object",
        "required": [
          "_meta",
          "query_id",
          "query",
          "results"
        ],
        "properties": {
          "_meta": {
            "type": "object",
            "required": [
              "version",
              "response_type"
            ],
            "properties": {
              "version": {
                "type": "string",
                "const": "0.55"
              },
              "response_type": {
                "type": "string",
                "const": "answer"
              },
              "mode": {
                "type": "string"
              },
              "site": {
                "type": "string"
              }
            }
          },
          "query_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AskItem"
            }
          }
        }
      },
      "AskError": {
        "type": "object",
        "required": [
          "_meta",
          "error"
        ],
        "properties": {
          "_meta": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "error": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "PresentationContext": {
        "type": "object",
        "required": [
          "requestId",
          "presentationId",
          "title",
