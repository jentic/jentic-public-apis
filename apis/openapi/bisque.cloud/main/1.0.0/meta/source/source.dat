    },
    "/api/v1/presentations/spec": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getPresentationSpecV1",
        "summary": "The html-presentation/v1 authoring format",
        "description": "Versioned address of `/api/presentations/spec` — the same endpoint and contract. Markdown. Fetch this before writing a presentation; never write the format from memory. Modules are addressable at `/api/presentations/spec/{part}`.",
        "security": [],
        "responses": {
          "200": {
            "description": "The format contract.",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presentations/spec/{part}": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getPresentationSpecPartV1",
        "summary": "One module of the authoring format",
        "security": [],
        "parameters": [
          {
            "name": "part",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Module name, with or without `.md`. The index lists the modules."
          }
        ],
        "responses": {
          "200": {
            "description": "The module.",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown module.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "part": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Versioned address of `/api/presentations/spec/{part}` — the same endpoint and contract."
      }
    },
    "/api/v1/presentations/context": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getPresentationContextV1",
        "summary": "Read a presentation as text",
        "description": "Versioned address of `/api/presentations/context` — the same endpoint and contract. Metadata, the per-slide narration transcript with timestamps, and the bundle's `context.md`. Public and unlisted presentations resolve without credentials; send a bearer credential to read your own private ones. Anonymous callers get 60 requests per 10 minutes per IP, authenticated callers 300.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "A watch URL, `https://bisque.today/p/{handle}/{slug}`. Either this or `handle` + `slug`.",
            "example": "https://bisque.today/p/siderakis/claude-system-card"
          },
          {
            "name": "handle",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Channel handle (leading @ tolerated)."
          },
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The presentation.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationContext"
                }
              }
            }
          },
          "400": {
            "description": "Neither `url` nor `handle` + `slug` identified a presentation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A credential was sent and is unusable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No presentation you can see at that address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`CONTEXT_RATE_LIMITED`). Wait `Retry-After` seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the window frees up."
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Read"
        ],
        "operationId": "getPresentationContextBatchV1",
        "summary": "Read up to 20 presentations in one request",
        "description": "Versioned address of `/api/presentations/context` — the same endpoint and contract. The batch form of the GET. Send `{\"urls\": [...]}`, `{\"items\": [{\"url\"} | {\"handle\",\"slug\"}, ...]}`, or a bare JSON array of watch URLs; each item resolves on its own, so one bad address fails its row and not the batch. Every item costs one slot of the same per-IP window as a GET (60 per 10 minutes anonymous, 300 with a credential); items past the window come back as `CONTEXT_RATE_LIMITED` rows rather than failing the request.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "x-batch": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresentationContextBatchRequest"
              },
              "examples": {
                "urls": {
                  "value": {
                    "urls": [
                      "https://bisque.today/p/siderakis/claude-system-card",
                      "https://bisque.today/p/siderakis/bun-1-3"
                    ]
                  }
                },
                "items": {
                  "value": {
                    "items": [
                      {
                        "url": "https://bisque.today/p/siderakis/claude-system-card"
                      },
                      {
                        "handle": "siderakis",
                        "slug": "bun-1-3"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One row per item, in request order.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationContextBatchResult"
                }
              }
            }
          },
          "400": {
            "description": "The body was not one of the three accepted shapes, was empty, or named more than 20 presentations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A credential was sent and is unusable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The window had no room for even the first item. Wait `Retry-After` seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presentations/context/batch": {
      "post": {
        "tags": [
          "Read"
        ],
        "operationId": "getPresentationContextBatchAliasV1",
        "summary": "Read up to 20 presentations in one request",
        "description": "Versioned address of `/api/presentations/context/batch` — the same endpoint and contract. The batch form of the GET. Send `{\"urls\": [...]}`, `{\"items\": [{\"url\"} | {\"handle\",\"slug\"}, ...]}`, or a bare JSON array of watch URLs; each item resolves on its own, so one bad address fails its row and not the batch. Every item costs one slot of the same per-IP window as a GET (60 per 10 minutes anonymous, 300 with a credential); items past the window come back as `CONTEXT_RATE_LIMITED` rows rather than failing the request.",
        "security": [
