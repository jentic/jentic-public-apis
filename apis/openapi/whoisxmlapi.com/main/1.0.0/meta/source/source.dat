{
  "openapi": "3.0.3",
  "info": {
    "title": "WhoisXML WHOIS API",
    "description": "WhoisXML API provides parsed and raw WHOIS domain registration data for any domain name, IP address, or email. Supports WHOIS and RDAP protocols with domain availability checking and IP geolocation.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://whois.whoisxmlapi.com/documentation/making-requests",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://www.whoisxmlapi.com"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/whoisserver/WhoisService": {
      "get": {
        "operationId": "whoisLookupGet",
        "summary": "WHOIS lookup via GET",
        "description": "Performs a WHOIS lookup for a domain name, IP address, or email address. Returns parsed registration data including registrant, registrar, dates, and name servers.",
        "parameters": [
          {
            "name": "domainName",
            "in": "query",
            "required": true,
            "description": "The domain name, IPv4/IPv6 address, or email address to look up",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apiKey",
            "in": "query",
            "required": true,
            "description": "Your API key for authentication",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outputFormat",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["JSON", "XML"],
              "default": "XML"
            }
          },
          {
            "name": "rdap",
            "in": "query",
            "description": "Protocol selection: 0 = Auto, 1 = RDAP only, 2 = WHOIS only",
            "schema": {
              "type": "integer",
              "enum": [0, 1, 2],
              "default": 0
            }
          },
          {
            "name": "preferFresh",
            "in": "query",
            "description": "Set to 1 to retrieve the latest record even if incomplete",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "da",
            "in": "query",
            "description": "Domain availability check: 0 = disabled, 1 = quick check, 2 = thorough check",
            "schema": {
              "type": "integer",
              "enum": [0, 1, 2],
              "default": 0
            }
          },
          {
            "name": "ip",
            "in": "query",
            "description": "Set to 1 to return resolved IP addresses for the domain",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "ipWhois",
            "in": "query",
            "description": "Set to 1 to return WHOIS data for the hosting IP (fallback for thin WHOIS)",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 1
            }
          },
          {
            "name": "checkProxyData",
            "in": "query",
            "description": "Set to 1 to check and fetch proxy/privacy guard data",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "thinWhois",
            "in": "query",
            "description": "Set to 1 to return registry-only (thin) WHOIS data",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "ignoreRawTexts",
            "in": "query",
            "description": "Set to 1 to strip raw WHOIS text from the response",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "callback",
            "in": "query",
            "description": "JSONP callback function name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_hardRefresh",
            "in": "query",
            "description": "Set to 1 to force a real-time WHOIS query (costs 5 DRS credits instead of 1)",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          },
          {
            "name": "_dbOnly",
            "in": "query",
            "description": "Set to 1 to return only cached data (no live query)",
            "schema": {
              "type": "integer",
              "enum": [0, 1],
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "WHOIS lookup result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoisRecord"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/WhoisRecord"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded or quota exhausted"
          }
        }
      },
      "post": {
        "operationId": "whoisLookupPost",
        "summary": "WHOIS lookup via POST",
        "description": "Performs a WHOIS lookup using a POST request. Accepts the same parameters as the GET endpoint in the request body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["domainName"],
                "properties": {
                  "domainName": {
                    "type": "string",
                    "description": "The domain name, IPv4/IPv6 address, or email to look up"
                  },
                  "outputFormat": {
                    "type": "string",
                    "enum": ["JSON", "XML"],
                    "default": "JSON"
                  },
                  "rdap": {
                    "type": "integer",
                    "enum": [0, 1, 2],
                    "default": 0
                  },
                  "preferFresh": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 0
                  },
                  "da": {
                    "type": "integer",
                    "enum": [0, 1, 2],
                    "default": 0
                  },
                  "ip": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 0
                  },
                  "ipWhois": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 1
                  },
                  "checkProxyData": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 0
                  },
                  "thinWhois": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 0
                  },
                  "ignoreRawTexts": {
                    "type": "integer",
                    "enum": [0, 1],
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "apiKey",
            "in": "query",
            "required": true,
            "description": "Your API key for authentication",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "WHOIS lookup result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoisRecord"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/whoisserver/DNSService": {
      "get": {
        "operationId": "dnsLookup",
        "summary": "DNS lookup",
        "description": "Performs a DNS lookup for the given domain name, returning DNS records of the specified type.",
        "parameters": [
          {
            "name": "domainName",
            "in": "query",
            "required": true,
            "description": "The domain name to look up",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apiKey",
            "in": "query",
            "required": true,
            "description": "Your API key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "DNS record type to query",
            "schema": {
              "type": "string",
              "enum": ["A", "AAAA", "MX", "NS", "SOA", "TXT", "CNAME", "SRV", "PTR", "_all"],
              "default": "_all"
            }
          },
          {
            "name": "outputFormat",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["JSON", "XML"],
              "default": "XML"
            }
          },
          {
            "name": "callback",
            "in": "query",
            "description": "JSONP callback function name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DNS lookup result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "DNSData": {
                      "type": "object",
                      "properties": {
                        "domainName": {
                          "type": "string"
                        },
                        "dnsTypes": {
                          "type": "string"
                        },
                        "dnsRecords": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "dnsType": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "ttl": {
                                "type": "integer"
                              },
                              "rawText": {
                                "type": "string"
                              },
                              "address": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/whoisserver/DomainAvailabilityService": {
      "get": {
        "operationId": "checkDomainAvailability",
        "summary": "Check domain availability",
        "description": "Checks whether a domain name is available for registration.",
        "parameters": [
          {
            "name": "domainName",
            "in": "query",
            "required": true,
            "description": "The domain name to check",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apiKey",
            "in": "query",
            "required": true,
            "description": "Your API key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outputFormat",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["JSON", "XML"],
              "default": "XML"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Check mode: DNS_ONLY is fast, WHOIS_ONLY uses WHOIS, DNS_AND_WHOIS uses both",
            "schema": {
              "type": "string",
              "enum": ["DNS_ONLY", "WHOIS_ONLY", "DNS_AND_WHOIS"],
              "default": "DNS_AND_WHOIS"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain availability result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "DomainInfo": {
                      "type": "object",
                      "properties": {
                        "domainName": {
                          "type": "string"
                        },
                        "domainAvailability": {
                          "type": "string",
                          "enum": ["AVAILABLE", "UNAVAILABLE", "UNDETERMINED"]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "apiKey",
        "in": "query",
        "description": "API key passed as a query parameter"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication using API key or OAuth access token"
      }
    },
    "schemas": {
      "WhoisRecord": {
        "type": "object",
        "properties": {
          "WhoisRecord": {
            "type": "object",
            "properties": {
              "domainName": {
                "type": "string"
              },
              "registryDomainId": {
                "type": "string"
              },
              "registrarName": {
                "type": "string"
              },
              "registrarIANAID": {
                "type": "string"
              },
              "registrarWhoisServer": {
                "type": "string"
              },
              "createdDate": {
                "type": "string",
                "format": "date-time"
              },
              "updatedDate": {
                "type": "string",
                "format": "date-time"
              },
              "expiresDate": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "nameServers": {
                "type": "object",
                "properties": {
                  "rawText": {
                    "type": "string"
                  },
                  "hostNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "registrant": {
                "$ref": "#/components/schemas/Contact"
              },
              "administrativeContact": {
                "$ref": "#/components/schemas/Contact"
              },
              "technicalContact": {
                "$ref": "#/components/schemas/Contact"
              },
              "domainAvailability": {
                "type": "string"
              },
              "contactEmail": {
                "type": "string"
              },
              "rawText": {
                "type": "string"
              },
              "parseCode": {
                "type": "integer"
              },
              "audit": {
                "type": "object",
                "properties": {
                  "createdDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedDate": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "rawText": {
            "type": "string"
          }
        }
      }
    }
  }
}