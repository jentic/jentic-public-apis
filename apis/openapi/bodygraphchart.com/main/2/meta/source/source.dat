{
  "openapi": "3.0.4",
  "info": {
    "title": "Bodygraph API",
    "description": "Allow your customers to design and create their own charts on your website or mobile app.",
    "version": 2
  },
  "servers": [
    {
      "url": "https://api.bodygraphchart.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v210502/locations": {
      "get": {
        "summary": "Returns a list of locations with their timezones.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Place name (town) to search for, e.g., London",
            "schema": {
              "type": "string",
              "example": "London"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of location objects matching the query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "asciiname": {
                        "type": "string",
                        "example": "London"
                      },
                      "timezone": {
                        "type": "string",
                        "example": "Europe/London"
                      },
                      "geo": {
                        "type": "string",
                        "example": "geoname"
                      },
                      "admin1": {
                        "type": "string",
                        "example": "England"
                      },
                      "country": {
                        "type": "string",
                        "example": "United Kingdom"
                      },
                      "value": {
                        "type": "string",
                        "example": "London, England, United Kingdom"
                      },
                      "tokens": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "example": [
                          "London",
                          "England",
                          "United",
                          "Kingdom"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v221006/hd-data": {
      "get": {
        "summary": "Generate HD Data (Traditional Single Chart)",
        "description": "Retrieve complete Human Design chart metrics for a single individual based on their birth date and timezone.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Local date of birth. Format Y-M-D H:I",
            "schema": {
              "type": "string",
              "example": "2019-05-05 10:10"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "required": true,
            "description": "Timezone of place of birth.",
            "schema": {
              "type": "string",
              "example": "Europe/London"
            }
          },
          {
            "name": "zodiac_system",
            "in": "query",
            "required": false,
            "description": "Zodiac system to use for calculations.",
            "schema": {
              "type": "string",
              "enum": [
                "tropical",
                "sidereal",
                "true-sidereal"
              ],
              "example": "tropical"
            }
          },
          {
            "name": "design",
            "in": "query",
            "required": false,
            "description": "Design Name. If included, the response will contain an SVG property.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing individual HD chart properties, planetary positions, and centers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v221006/hd-relationship-data": {
      "get": {
        "summary": "Generate HD Relationship Data",
        "description": "Retrieve combined Human Design relationship data and individual profiles for two people.",
        "parameters": [
          {
            "name": "date[0]",
            "in": "query",
            "required": true,
            "description": "Local date of birth of the first person. Format Y-M-D H:I",
            "schema": {
              "type": "string",
              "example": "2019-05-05 10:10"
            }
          },
          {
            "name": "timezone[0]",
            "in": "query",
            "required": true,
            "description": "Timezone of place of birth of the first person.",
            "schema": {
              "type": "string",
              "example": "Europe/London"
            }
          },
          {
            "name": "date[1]",
            "in": "query",
            "required": true,
            "description": "Local date of birth of the second person. Format Y-M-D H:I",
            "schema": {
              "type": "string",
              "example": "2009-01-15 15:15"
            }
          },
          {
            "name": "timezone[1]",
            "in": "query",
            "required": true,
            "description": "Timezone of place of birth of the second person.",
            "schema": {
              "type": "string",
              "example": "Europe/London"
            }
          },
          {
            "name": "zodiac_system",
            "in": "query",
            "required": false,
            "description": "Zodiac system to use for calculations.",
            "schema": {
              "type": "string",
              "enum": [
                "tropical",
                "sidereal",
                "true-sidereal"
              ],
              "example": "tropical"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful relationship response containing indexed person profiles and a Combined analysis object.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v240815/astro-data": {
      "get": {
        "summary": "Generate Astrology Data",
        "description": "Retrieve astrological chart calculations based on birth details and specified house systems.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Local date of birth. Format Y-M-D H:I",
            "schema": {
              "type": "string",
              "example": "2019-05-05 10:10"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "required": true,
            "description": "Timezone of place of birth.",
            "schema": {
              "type": "string",
              "example": "Europe/London"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "description": "Latitude of place of birth.",
            "schema": {
              "type": "string",
              "example": "51.509865"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "description": "Longitude of place of birth.",
            "schema": {
              "type": "string",
              "example": "-0.118092"
            }
          },
          {
            "name": "house_system",
            "in": "query",
            "required": true,
            "description": "Supported house system identifier.",
            "schema": {
              "type": "string",
              "enum": [
                "W",
                "D",
                "P",
                "A",
                "B",
                "C",
                "F",
                "H",
                "I",
                "i",
                "K",
                "L",
                "M",
                "N",
                "O",
                "Q",
                "R",
                "S",
                "T",
                "U",
                "V",
                "X",
                "Y"
              ],
              "example": "W"
            }
          },
          {
            "name": "zodiac_system",
            "in": "query",
            "required": false,
            "description": "Zodiac system to use for calculations.",
            "schema": {
              "type": "string",
              "enum": [
                "tropical",
                "sidereal",
                "true-sidereal"
              ],
              "example": "tropical"
            }
          },
          {
            "name": "design",
            "in": "query",
            "required": false,
            "description": "Design Name. If included, the response will contain an SVG property with the generated chart image.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning calculated astrology data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}