  "components": {
    "schemas": {
      "UserLoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "ExamplePass123!"
          }
        },
        "type": "object"
      },
      "UserSuccessLoginResponse": {
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30"
          }
        },
        "type": "object"
      },
      "UserErrorLoginResponse": {
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "properties": {
              "auth": {
                "type": "string",
                "example": "No such user exists"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "UserRegisterRequest": {
        "required": [
          "product",
          "name",
          "second_name",
          "customer",
          "email",
          "phone",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "product": {
            "type": "string",
            "example": "expert"
          },
          "name": {
            "type": "string",
            "example": "John"
          },
          "second_name": {
            "type": "string",
            "example": "Doe"
          },
          "customer": {
            "type": "string",
            "example": "Organization Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+447911123456"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "ExamplePass123!"
          },
          "password_confirmation": {
            "type": "string",
            "example": "ExamplePass123!"
          }
        },
        "type": "object"
      },
      "UserSuccessRegisterResponse": {
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "required": [
              "name",
              "second_name",
              "phone",
              "email",
              "customer",
              "plan",
              "id",
              "updated_at",
              "created_at"
            ],
            "properties": {
              "name": {
                "type": "string",
                "example": "John"
              },
              "second_name": {
                "type": "string",
                "example": "Doe"
              },
              "phone": {
                "type": "string",
                "example": "+447911123456"
              },
              "email": {
                "type": "string",
                "format": "email",
                "example": "user@example.com"
              },
              "customer": {
                "type": "string",
                "example": "Organization Name"
              },
              "plan": {
                "type": "integer",
                "example": 4
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "example": "b7770de0-67b3-11f0-bc93-31be34b0000f"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "example": "2025-05-23T10:00:33.000000Z"
              },
              "created_at": {
