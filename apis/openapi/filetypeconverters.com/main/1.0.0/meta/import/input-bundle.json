  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ftc"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "BAD_URL",
          "UNKNOWN_FORMAT",
          "UNAUTHORIZED",
          "VISION_CREDITS_REQUIRED",
          "FORBIDDEN",
          "API_ACCESS_REQUIRED",
          "MCP_ACCESS_REQUIRED",
          "NOT_FOUND",
          "PAYLOAD_TOO_LARGE",
          "TOO_LARGE",
          "BATCH_TOO_LARGE",
          "INVALID_FILE",
          "UNSUPPORTED_MEDIA_TYPE",
          "UNSUPPORTED_PAIR",
          "LIMIT_EXCEEDED",
          "DAILY_LIMIT_EXCEEDED",
          "MONTHLY_LIMIT_EXCEEDED",
          "RATE_LIMITED",
          "FETCH_FAILED",
          "ENGINE_URL_MISSING",
          "ENGINE_ERROR",
          "CONVERSION_FAILED",
          "MAX_SIZE_EXCEEDED",
          "TIMEOUT"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "OptionSpec": {
        "type": "object",
        "required": [
          "key",
          "type",
          "default",
          "appliesTo"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "select",
              "boolean",
              "string",
              "number"
            ]
          },
          "default": {},
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appliesTo": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        }
      },
      "PairDescriptor": {
        "type": "object",
        "required": [
          "from",
          "to",
          "slug",
          "page",
          "engine",
          "engineLabel",
          "mode",
          "options"
        ],
        "properties": {
          "from": {
            "type": "string",
            "example": "csv"
          },
          "to": {
            "type": "string",
            "example": "json"
          },
          "slug": {
            "type": "string",
            "example": "csv-to-json"
          },
          "page": {
            "type": "string",
            "format": "uri"
          },
          "engine": {
            "type": "string",
            "example": "table"
          },
          "engineLabel": {
            "type": "string",
            "example": "Table engine"
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "ai_deep_read",
              "either"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionSpec"
            }
          }
        }
      },
      "PairsList": {
        "type": "object",
        "required": [
          "count",
          "pairs"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "example": 490
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PairDescriptor"
            }
          }
        }
      },
      "PairSupported": {
        "type": "object",
        "required": [
          "supported",
          "pair"
        ],
        "properties": {
          "supported": {
            "type": "boolean",
            "const": true
          },
          "pair": {
            "$ref": "#/components/schemas/PairDescriptor"
          }
        }
      },
      "PairUnsupported": {
        "type": "object",
        "required": [
          "supported",
          "from",
          "to",
          "reason",
          "alternatives"
        ],
        "properties": {
          "supported": {
            "type": "boolean",
            "const": false
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "to",
                "name",
                "slug"
              ],
              "properties": {
                "to": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Format": {
        "type": "object",
        "required": [
          "id",
          "name",
          "extensions",
          "mimeTypes",
          "hub",
          "browserCapable",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "extensions": {
