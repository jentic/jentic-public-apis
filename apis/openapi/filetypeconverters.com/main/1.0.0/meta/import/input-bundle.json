{
  "openapi": "3.1.0",
  "info": {
    "title": "FileType Converters API",
    "version": "1.0.0",
    "description": "HTTP API for checking file conversion pairs, converting files, polling jobs, creating batches, downloading outputs, and reading usage.",
    "x-jentic-source-url": "https://filetypeconverters.com/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://filetypeconverters.com"
    }
  ],
  "paths": {
    "/api/v1/convert": {
      "post": {
        "summary": "Convert a file",
        "description": "Accepts multipart file uploads or JSON URL inputs. Use async=1 to queue a job. URL requests may omit from when the fetched filename or content type can be detected.",
        "parameters": [
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Return 202 and queue the job."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "from",
                  "to"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "from": {
                    "type": "string",
                    "example": "csv"
                  },
                  "to": {
                    "type": "string",
                    "example": "json"
                  },
                  "vision": {
                    "type": "boolean",
                    "default": false
                  },
                  "options": {
                    "type": "string",
                    "description": "JSON object string."
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "to"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "from": {
                    "type": "string",
                    "description": "Optional when the URL can be detected."
                  },
                  "to": {
                    "type": "string"
                  },
                  "vision": {
                    "type": "boolean",
                    "default": false
                  },
                  "options": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Converted file stream",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename for the converted output.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Conversion-Id": {
                "description": "Conversion id recorded for the request.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "X-Conversion-Ms": {
                "description": "Server conversion duration in milliseconds.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Warnings": {
                "description": "Percent-encoded JSON array of warning strings.",
                "schema": {
                  "type": "string",
                  "example": "%5B%5D"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "202": {
            "description": "Queued conversion job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuedJob"
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pairs": {
      "get": {
        "summary": "Check conversion pairs",
        "security": [],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Format id, extension, or common name."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Format id, extension, or common name."
          }
        ],
        "responses": {
          "200": {
            "description": "Pair list, supported pair, or unsupported pair with alternatives.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PairsList"
                    },
                    {
                      "$ref": "#/components/schemas/PairSupported"
                    },
                    {
                      "$ref": "#/components/schemas/PairUnsupported"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
