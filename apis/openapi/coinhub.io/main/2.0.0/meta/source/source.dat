                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          }
        }
      }
    },
    "/management/transfers/new": {
      "post": {
        "tags": [
          "Management"
        ],
        "summary": "Create transfer",
        "operationId": "createTransfer",
        "security": [
          {
            "Bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "category",
                  "operations"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "currency",
                        "amount",
                        "account_src",
                        "account_dst"
                      ],
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number",
                          "format": "decimal"
                        },
                        "account_src": {
                          "type": "object",
                          "required": [
                            "code"
                          ],
                          "properties": {
                            "code": {
                              "type": "integer"
                            },
                            "uid": {
                              "type": "string"
                            }
                          }
                        },
                        "account_dst": {
                          "type": "object",
                          "required": [
                            "code"
                          ],
                          "properties": {
                            "code": {
                              "type": "integer"
                            },
                            "uid": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Transfer result"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/management/timestamp": {
      "post": {
        "tags": [
          "Management"
        ],
        "summary": "Get server timestamp",
        "operationId": "getManagementTimestamp",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from authentication endpoint"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Number of items per page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "OrderBy": {
        "name": "order_by",
        "in": "query",
        "description": "Field to order by",
        "schema": {
          "type": "string"
        }
      },
      "Ordering": {
        "name": "ordering",
        "in": "query",
        "description": "Sort order",
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc"
        }
      }
    },
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Currency code"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "coin",
              "fiat"
            ]
          },
          "precision": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "icon_url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "swap_enabled": {
            "type": "boolean"
          },
          "swap_fees": {
            "type": "number",
            "format": "decimal"
          },
          "p2p_fees": {
            "type": "number",
            "format": "decimal"
          }
        },
        "example": {
          "id": "btc",
          "name": "Bitcoin",
          "type": "coin",
          "precision": 8,
          "price": 45000.0,
          "icon_url": "https://example.com/btc.png"
        }
      },
      "Market": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Market identifier (e.g., btcusdt)"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "future"
          },
          "base_unit": {
            "type": "string"
          },
          "quote_unit": {
            "type": "string"
          },
          "amount_precision": {
            "type": "integer"
          },
          "price_precision": {
            "type": "integer"
          },
          "min_price": {
            "type": "number",
            "format": "decimal"
          },
          "max_price": {
            "type": "number",
            "format": "decimal"
          },
          "min_amount": {
            "type": "number",
            "format": "decimal"
          },
          "state": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "position": {
            "type": "integer"
          },
          "binance_engine": {
            "type": "boolean"
          },
          "upstream": {
            "type": "boolean"
          },
          "trading_enabled": {
            "type": "boolean"
          }
        },
        "example": {
          "id": "btcusdt",
          "name": "BTC/USDT",
          "type": "future",
          "base_unit": "btc",
          "quote_unit": "usdt",
          "amount_precision": 8,
          "price_precision": 2
        }
      },
      "MarketName": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "ord_type": {
            "type": "string",
            "enum": [
              "market",
              "limit",
              "stop_loss_limit",
              "take_profit_limit",
              "take_profit_market",
              "stop_loss_market"
            ]
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "avg_price": {
            "type": "number",
            "format": "decimal"
          },
          "state": {
            "type": "string",
            "enum": [
              "wait",
              "done",
              "cancel",
              "reject",
              "expired"
            ]
          },
          "market": {
            "type": "string"
          },
          "volume": {
            "type": "number",
            "format": "decimal"
          },
          "remaining_volume": {
            "type": "number",
            "format": "decimal"
          },
          "executed_volume": {
            "type": "number",
            "format": "decimal"
          },
          "trades_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "id": 12345,
          "side": "buy",
          "ord_type": "limit",
          "price": 45000.0,
          "state": "wait",
          "market": "btcusdt",
          "volume": 0.1,
          "remaining_volume": 0.1,
          "executed_volume": 0.0
        }
      },
      "Trade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "total": {
            "type": "number",
            "format": "decimal"
          },
          "market": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "taker_type": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          }
        },
        "example": {
          "id": 67890,
          "price": 45000.0,
          "amount": 0.1,
          "total": 4500.0,
          "market": "btcusdt",
          "side": "buy"
        }
      },
      "OrderBook": {
        "type": "object",
        "properties": {
          "asks": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "description": "Array of [price, volume] pairs for sell orders"
          },
          "bids": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "description": "Array of [price, volume] pairs for buy orders"
          }
        },
        "example": {
          "asks": [
            [
              45100.0,
              0.5
            ],
            [
              45150.0,
              0.3
            ]
          ],
          "bids": [
            [
              44900.0,
              0.8
            ],
            [
              44850.0,
              0.6
            ]
          ]
        }
      },
      "Ticker": {
        "type": "object",
        "properties": {
          "buy": {
            "type": "number",
            "format": "decimal"
          },
          "sell": {
            "type": "number",
            "format": "decimal"
          },
          "low": {
            "type": "number",
            "format": "decimal"
          },
          "high": {
            "type": "number",
            "format": "decimal"
          },
          "open": {
            "type": "number",
            "format": "decimal"
          },
          "last": {
            "type": "number",
            "format": "decimal"
          },
          "volume": {
            "type": "number",
            "format": "decimal"
          },
          "avg_price": {
            "type": "number",
            "format": "decimal"
          },
          "price_change_percent": {
            "type": "string"
          },
          "total_volume": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "format": "decimal"
          },
          "locked": {
            "type": "number",
            "format": "decimal"
          },
          "p2p_balance": {
            "type": "number",
            "format": "decimal"
          },
          "escrow_balance": {
            "type": "number",
            "format": "decimal"
          },
          "type": {
            "type": "string",
            "enum": [
              "future",
              "spot"
            ]
          }
        },
        "example": {
          "currency": "usdt",
          "balance": 10000.0,
          "locked": 500.0,
          "p2p_balance": 0.0,
          "escrow_balance": 0.0,
          "type": "future"
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "level": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PositionHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "market_id": {
            "type": "string"
          },
          "aasm_state": {
            "type": "string",
            "enum": [
              "active",
              "completed"
            ]
          },
          "margin_type": {
            "type": "string",
            "enum": [
              "isolated",
              "cross"
            ]
          },
          "position_amount": {
            "type": "number",
            "format": "decimal"
          },
          "entry_price": {
            "type": "number",
            "format": "decimal"
          },
          "liquidation_price": {
            "type": "number",
            "format": "decimal"
          },
          "leverage": {
            "type": "integer"
          },
          "unrealized_pnl": {
            "type": "number",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TransactionHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "market_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TradingFee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "group": {
            "type": "string"
          },
          "market_id": {
            "type": "string"
          },
          "maker": {
            "type": "number",
            "format": "decimal"
          },
          "taker": {
            "type": "number",
            "format": "decimal"
          },
          "markup_open_fee": {
            "type": "number",
            "format": "decimal"
          },
          "markup_close_fee": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Reward": {
        "type": "object",
        "properties": {
          "reward_type": {
            "type": "string"
          },
          "referee_amount": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Version": {
        "type": "object",
        "properties": {
          "git_tag": {
            "type": "string"
          },
          "git_sha": {
            "type": "string"
          },
          "build_date": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "reference_type": {
            "type": "string"
          },
          "reference_kind": {
            "type": "string"
          },
          "debit": {
            "type": "number",
            "format": "decimal"
          },
          "credit": {
            "type": "number",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FutureSettings": {
        "type": "object",
        "properties": {
          "market_id": {
            "type": "string"
          },
          "leverage": {
            "type": "integer"
          },
          "marginType": {
            "type": "string",
            "enum": [
              "isolated",
              "cross"
            ]
          }
        }
      },
      "ThirdParty": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "platform": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FilledPositionData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "binance_order_id": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "qty": {
            "type": "number",
            "format": "decimal"
          },
          "realized_pnl": {
            "type": "number",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TransferMarkUpFee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "market_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
