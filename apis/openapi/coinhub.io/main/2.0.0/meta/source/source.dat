{
  "openapi": "3.0.3",
  "info": {
    "title": "CoinHub Futures Trading API",
    "description": "API for CoinHub Futures Trading Platform. This API provides endpoints for:\n- Public market data (currencies, markets, order books, trades, tickers)\n- User account management (balances, settings, members)\n- Trading operations (orders, positions, trades)\n- Administrative functions (members, markets, currencies, operations)\n- Management operations (deposits, withdraws, transfers)\n",
    "version": "2.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/antiersolutionspvtlt/coinhub-futures-trading-api/2.0.0"
  },
  "servers": [
    {
      "url": "https://api.coinhub.io/api/v2",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Public",
      "description": "Public endpoints (no authentication required)"
    },
    {
      "name": "Account",
      "description": "User account endpoints (authentication required)"
    },
    {
      "name": "Market",
      "description": "Trading market endpoints (authentication required)"
    },
    {
      "name": "Admin",
      "description": "Administrative endpoints (admin role required)"
    },
    {
      "name": "Management",
      "description": "Management API endpoints (server-to-server, high privileges)"
    }
  ],
  "paths": {
    "/public/currencies": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get list of currencies",
        "description": "Returns a paginated list of available currencies",
        "operationId": "getCurrencies",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Currency type filter",
            "schema": {
              "type": "string",
              "enum": [
                "fiat",
                "coin",
                "trading"
              ],
              "default": "trading"
            }
          },
          {
            "name": "swap_enabled",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Currency code filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Currency name filter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Currency"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/public/currencies/{id}": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get a currency",
        "description": "Returns details for a specific currency",
        "operationId": "getCurrency",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Currency code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/public/reward_settings": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get reward settings",
        "operationId": "getRewardSettings",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reward"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/tobtc": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get equivalent to BTC",
        "operationId": "getToBtc",
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "decimal"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number",
                      "format": "decimal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/currency/conversation": {
      "post": {
        "tags": [
          "Public"
        ],
        "summary": "Get currency conversion",
        "operationId": "currencyConversation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "currency_from",
                  "currency_to"
                ],
                "properties": {
                  "currency_from": {
                    "type": "string"
                  },
                  "currency_to": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currency_from": {
                      "type": "string"
                    },
                    "currency_to": {
                      "type": "string"
                    },
                    "rate": {
                      "type": "number",
                      "format": "decimal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/markets": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get all available markets",
        "operationId": "getMarkets",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Market"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/{market}/order-book": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get order book",
        "operationId": "getOrderBook",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asks_limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          },
          {
            "name": "bids_limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderBook"
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/{market}/trades": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get recent trades",
        "operationId": "getMarketTrades",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "name": "timestamp",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Trade"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/{market}/depth": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get market depth",
        "operationId": "getMarketDepth",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 300
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Market depth data"
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/{market}/k-line": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get OHLC (K-line) data",
        "operationId": "getKLine",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "time_from",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "time_to",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 6,
                    "maxItems": 6,
                    "description": [
                      "timestamp",
                      "open",
                      "high",
                      "low",
                      "close",
                      "volume"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/tickers": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get tickers for all markets",
        "operationId": "getAllTickers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/Ticker"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/markets/{market}/tickers": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get ticker for specific market",
        "operationId": "getMarketTicker",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticker"
                }
              }
            }
          }
        }
      }
    },
    "/public/member-levels": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get member levels",
        "operationId": "getMemberLevels",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deposit": {
                      "type": "object",
                      "properties": {
                        "minimum_level": {
                          "type": "integer"
                        }
                      }
                    },
                    "withdraw": {
                      "type": "object",
                      "properties": {
                        "minimum_level": {
                          "type": "integer"
                        }
                      }
                    },
                    "trading": {
                      "type": "object",
                      "properties": {
                        "minimum_level": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/trading_fees": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get trading fees",
        "operationId": "getTradingFees",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "market_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uuid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/OrderBy"
          },
          {
            "$ref": "#/components/parameters/Ordering"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TradingFee"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/trading_rules": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get Binance trading rules",
        "operationId": "getTradingRules",
        "parameters": [
          {
            "name": "market_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Trading rules data"
                }
              }
            }
          }
        }
      }
    },
    "/public/config": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get platform configuration",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currencies": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Currency"
                      }
                    },
                    "trading_fees": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TradingFee"
                      }
                    },
                    "markets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Market"
                      }
                    },
                    "withdraw_limits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "currency": {
                            "type": "string"
                          },
                          "limit": {
                            "type": "number",
                            "format": "decimal"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/timestamp": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get server timestamp",
        "operationId": "getTimestamp",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "/public/version": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get API version",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/public/health/alive": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Health check - alive",
        "operationId": "healthAlive",
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service is not alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/health/ready": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Health check - ready",
        "operationId": "healthReady",
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/status": {
      "post": {
        "tags": [
          "Public"
        ],
        "summary": "Binance KYC status callback",
        "operationId": "binanceKycStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Binance KYC status callback response"
                }
              }
            }
          }
        }
      }
    },
    "/public/market/list": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get market list",
        "operationId": "getMarketList",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MarketName"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/account/balances": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get user account balances",
        "operationId": "getAccountBalances",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "name": "account_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonzero",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "currency_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "coin",
                "fiat"
              ],
              "default": "coin"
            }
          },
          {
            "name": "currency_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/account/balances/{currency}": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get user account by currency",
        "operationId": "getAccountBalance",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/account/{currency}/balance": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get user account balance by currency",
        "operationId": "getCurrencyBalance",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "number",
                  "format": "decimal"
                }
              }
            }
          }
        }
      }
    },
    "/account/portfolio": {
      "get": {
        "tags": [
