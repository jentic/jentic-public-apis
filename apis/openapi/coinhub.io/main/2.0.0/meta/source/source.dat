            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "example": {
              "errors": [
                "Invalid parameter"
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - Authentication required",
