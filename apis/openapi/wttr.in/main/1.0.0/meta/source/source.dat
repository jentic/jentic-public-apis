{
  "openapi": "3.0.3",
  "info": {
    "title": "wttr.in Weather API",
    "description": "Curl-friendly weather service providing current conditions and forecasts in text, ANSI, PNG, and JSON formats. Supports city names, airport codes, coordinates, landmarks, and domain-based location lookups. No authentication required.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://github.com/chubin/wttr.in",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://wttr.in",
      "description": "wttr.in weather service"
    }
  ],
  "paths": {
    "/{location}": {
      "get": {
        "operationId": "getWeather",
        "summary": "Get weather for a location",
        "description": "Returns weather data for the specified location. Supports city names (Paris), airport codes (muc), coordinates (-78.46,106.79), landmarks (~Eiffel+tower), domain names (@stackoverflow.com), and area/zip codes (94107). Use format=j1 for JSON output.",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Location identifier: city name, ~landmark, @domain, airport code, zip/area code, or lat,lon coordinates",
            "examples": {
              "city": {
                "value": "London",
                "summary": "City name"
              },
              "airport": {
                "value": "muc",
                "summary": "Airport code"
              },
              "coordinates": {
                "value": "-78.46,106.79",
                "summary": "GPS coordinates"
              },
              "landmark": {
                "value": "~Eiffel+tower",
                "summary": "Landmark with ~ prefix"
              }
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "j1",
                "j2"
              ]
            },
            "description": "Output format: j1 for JSON (current + 3 day forecast), j2 for JSON v2"
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language code for localized output (e.g., fr, de, ru, zh)"
          },
          {
            "name": "u",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Use US customary units (Fahrenheit, mph)"
          },
          {
            "name": "m",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Use metric units (Celsius, km/h) - default"
          },
          {
            "name": "M",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Use m/s for wind speed"
          },
          {
            "name": "0",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Show only current weather"
          },
          {
            "name": "1",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Show current weather + 1 day forecast"
          },
          {
            "name": "2",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Show current weather + 2 day forecast"
          },
          {
            "name": "n",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Narrow view (day and night only)"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Quiet version (no weather text)"
          },
          {
            "name": "Q",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Super quiet (no city name)"
          },
          {
            "name": "T",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                ""
              ]
            },
            "description": "Disable terminal sequences (for piping)"
          }
        ],
        "responses": {
          "200": {
            "description": "Weather data in text or JSON format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current_condition": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "temp_C": {
                            "type": "string"
                          },
                          "temp_F": {
                            "type": "string"
                          },
                          "FeelsLikeC": {
                            "type": "string"
                          },
                          "FeelsLikeF": {
                            "type": "string"
                          },
                          "humidity": {
                            "type": "string"
                          },
                          "pressure": {
                            "type": "string"
                          },
                          "visibility": {
                            "type": "string"
                          },
                          "windspeedKmph": {
                            "type": "string"
                          },
                          "winddir16Point": {
                            "type": "string"
                          },
                          "weatherDesc": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "uvIndex": {
                            "type": "string"
                          },
                          "cloudcover": {
                            "type": "string"
                          },
                          "precipMM": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nearest_area": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "string"
                          },
                          "longitude": {
                            "type": "string"
                          },
                          "areaName": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "country": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "population": {
                            "type": "string"
                          },
                          "region": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "request": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "query": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "weather": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string"
                          },
                          "maxtempC": {
                            "type": "string"
                          },
                          "maxtempF": {
                            "type": "string"
                          },
                          "mintempC": {
                            "type": "string"
                          },
                          "mintempF": {
                            "type": "string"
                          },
                          "avgtempC": {
                            "type": "string"
                          },
                          "avgtempF": {
                            "type": "string"
                          },
                          "astronomy": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "hourly": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "ASCII art weather report"
                }
              }
            }
          },
          "404": {
            "description": "Location not found"
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "getWeatherForCallerLocation",
        "summary": "Get weather for the caller's location",
        "description": "Returns weather data based on the IP geolocation of the requesting client.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "j1",
                "j2"
              ]
            },
            "description": "Output format: j1 for JSON, j2 for JSON v2"
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language code"
          }
        ],
        "responses": {
          "200": {
            "description": "Weather data for caller's location",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/moon": {
      "get": {
        "operationId": "getMoonPhase",
        "summary": "Get current moon phase",
        "description": "Returns ASCII art visualization of the current moon phase.",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language code"
          }
        ],
        "responses": {
          "200": {
            "description": "Moon phase visualization",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/moon@{date}": {
      "get": {
        "operationId": "getMoonPhaseByDate",
        "summary": "Get moon phase for a specific date",
        "description": "Returns ASCII art visualization of the moon phase for a given date.",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Date in YYYY-MM-DD format"
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language code"
          }
        ],
        "responses": {
          "200": {
            "description": "Moon phase visualization for the specified date",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "Weather",
      "description": "Weather forecasts and current conditions"
    },
    {
      "name": "Moon",
      "description": "Moon phase information"
    }
  ]
}
