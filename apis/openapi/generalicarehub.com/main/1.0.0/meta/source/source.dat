                    "$ref": "#/components/schemas/Users-Permissions-User"
                  }
                },
                "example": [
                  {
                    "id": 9,
                    "username": "foao@strapi.io",
                    "email": "foao@strapi.io",
                    "provider": "local",
                    "confirmed": false,
                    "blocked": false,
                    "createdAt": "2022-06-01T18:32:35.211Z",
                    "updatedAt": "2022-06-01T18:32:35.217Z"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users-Permissions - Users & Roles"
        ],
        "summary": "Create a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "foo",
                "email": "foo@strapi.io",
                "password": "foo-password"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Returns created user info",
