                            "enabled": false,
                            "policy": ""
                          },
                          "create": {
                            "enabled": false,
                            "policy": ""
                          }
                        },
                        "controllerB": {
                          "find": {
                            "enabled": false,
                            "policy": ""
                          },
                          "findOne": {
                            "enabled": false,
                            "policy": ""
                          },
                          "create": {
                            "enabled": false,
                            "policy": ""
                          }
                        }
                      }
                    }
