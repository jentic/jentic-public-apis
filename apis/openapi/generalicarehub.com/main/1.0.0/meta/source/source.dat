                }
              }
            },
            "example": {
              "name": "foo",
              "description": "role foo",
              "permissions": {
                "api::content-type.content-type": {
                  "controllers": {
                    "controllerA": {
                      "find": {
                        "enabled": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
