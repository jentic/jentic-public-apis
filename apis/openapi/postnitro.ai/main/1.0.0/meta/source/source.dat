{
  "openapi": "3.1.0",
  "info": {
    "title": "PostNitro Embed API",
    "description": "REST API for programmatically generating social media carousels with PostNitro. Generation is asynchronous: initiate a post (AI generation or content import), poll its status until COMPLETED, then fetch the output files. Human-readable documentation: https://postnitro.ai/docs/embed/api (markdown: https://postnitro.ai/docs/embed/api.md, full docs index: https://postnitro.ai/docs/llms.txt). AI assistants can alternatively connect to the PostNitro MCP server at https://mcp.postnitro.ai/mcp (same API key as Bearer token) — see https://postnitro.ai/docs/embed/mcp.md",
    "version": "1.0.0",
    "contact": {
      "name": "PostNitro Support",
      "email": "support@postnitro.ai",
      "url": "https://postnitro.ai"
    }
  },
  "servers": [
    {
      "url": "https://embed-api.postnitro.ai",
      "description": "Production"
    }
  ],
  "security": [
    {
      "embedApiKey": []
    }
  ],
  "paths": {
    "/post/initiate/generate": {
      "post": {
        "operationId": "initiateGenerate",
        "summary": "Initiate AI carousel generation",
        "description": "Generates a carousel post using AI. Returns immediately with an embedPostId while generation runs in the background; poll GET /post/status/{embedPostId} until status is COMPLETED, then call GET /post/output/{embedPostId}. AI generation costs 2 credits per slide. Docs: https://postnitro.ai/docs/embed/api/initiate/generate.md",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["postType", "templateId", "brandId", "presetId", "aiGeneration"],
                "properties": {
                  "postType": {
                    "type": "string",
                    "enum": ["CAROUSEL", "IMAGE", "VIDEO"],
                    "description": "Type of post to generate. Must be uppercase. CAROUSEL generates a multi-slide carousel; IMAGE generates a single image post; VIDEO generates a video whose slides are its scenes"
                  },
                  "requestorId": {
                    "type": "string",
                    "description": "Optional custom identifier for tracking which automation or user generated this post"
                  },
                  "templateId": {
                    "type": "string",
                    "description": "ID of the design template to use (from your PostNitro dashboard)"
                  },
                  "brandId": {
                    "type": "string",
                    "description": "ID of the brand configuration to apply (from your PostNitro dashboard)"
                  },
                  "presetId": {
                    "type": "string",
                    "description": "ID of the AI configuration preset (from your PostNitro dashboard)"
                  },
                  "responseType": {
                    "type": "string",
                    "enum": ["DESIGN", "PDF", "PNG", "MP4"],
                    "default": "DESIGN",
                    "description": "Output format. DESIGN (default) creates and saves the design without rendering a file. PNG produces one image per slide. PDF produces a single document. MP4 produces a single video and is valid only for postType VIDEO, which in turn accepts only MP4 or DESIGN. Send a rendering format explicitly if you need a file"
                  },
                  "aiGeneration": {
                    "$ref": "#/components/schemas/AiGeneration"
                  },
                  "generateImages": {
                    "$ref": "#/components/schemas/GenerateImages"
                  },
                  "videoSettings": {
                    "$ref": "#/components/schemas/VideoSettings"
                  }
                }
              },
              "example": {
                "postType": "CAROUSEL",
                "templateId": "your-template-id",
                "brandId": "your-brand-id",
                "presetId": "your-ai-preset-id",
                "responseType": "PNG",
                "aiGeneration": {
                  "type": "text",
                  "context": "Create a LinkedIn carousel about digital marketing tips",
                  "instructions": "Focus on actionable tips for small businesses"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generation initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/post/initiate/import": {
      "post": {
        "operationId": "initiateImport",
        "summary": "Initiate carousel creation from your own slide content",
        "description": "Creates a carousel post from caller-provided slide content. Slide order rules: exactly one starting_slide first, at least one body_slide in the middle, exactly one ending_slide last. Returns immediately with an embedPostId; poll GET /post/status/{embedPostId} until COMPLETED, then call GET /post/output/{embedPostId}. Content import costs 1 credit per slide. Docs: https://postnitro.ai/docs/embed/api/initiate/import.md",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["postType", "templateId", "brandId", "slides"],
                "properties": {
                  "postType": {
                    "type": "string",
                    "enum": ["CAROUSEL", "IMAGE", "VIDEO"],
                    "description": "Type of post to create. Must be uppercase. CAROUSEL and VIDEO take an array of slides (for VIDEO each slide is a scene); IMAGE takes a single slide object"
                  },
                  "requestorId": {
                    "type": "string",
                    "description": "Optional custom identifier for tracking"
                  },
                  "templateId": {
                    "type": "string",
                    "description": "ID of the design template to use"
                  },
                  "brandId": {
                    "type": "string",
                    "description": "ID of the brand configuration to apply"
                  },
                  "responseType": {
                    "type": "string",
                    "enum": ["DESIGN", "PDF", "PNG", "MP4"],
                    "default": "DESIGN",
                    "description": "Output format. DESIGN (default) creates and saves the design without rendering a file. PNG produces one image per slide. PDF produces a single document. MP4 produces a single video and is valid only for postType VIDEO, which in turn accepts only MP4 or DESIGN. Send a rendering format explicitly if you need a file"
                  },
                  "slides": {
                    "description": "For CAROUSEL and VIDEO: an array of slides in display order (exactly 1 starting_slide first, 1+ body_slide, exactly 1 ending_slide last). For IMAGE: a single slide object (no array, no type field). The shape is strictly enforced per postType — sending the wrong one returns a 422",
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Slide"
                        }
                      },
                      {
                        "$ref": "#/components/schemas/Slide"
                      }
                    ]
                  },
                  "generateImages": {
                    "$ref": "#/components/schemas/GenerateImages"
                  },
                  "videoSettings": {
                    "$ref": "#/components/schemas/VideoSettings"
                  }
                }
              },
              "example": {
                "postType": "CAROUSEL",
                "templateId": "your-template-id",
                "brandId": "your-brand-id",
                "responseType": "PNG",
                "slides": [
                  {
                    "type": "starting_slide",
                    "heading": "Welcome to the Carousel!",
                    "sub_heading": "My Awesome Subtitle",
                    "description": "This is how you start with a bang.",
                    "cta_button": "Swipe to learn more"
                  },
                  {
                    "type": "body_slide",
                    "heading": "Section 1: The Core Idea",
                    "description": "Explain your first key point here.",
                    "image": "https://example.com/image1.jpg"
                  },
                  {
                    "type": "ending_slide",
                    "heading": "Get Started Today!",
                    "description": "A final encouraging message.",
                    "cta_button": "Visit Our Website"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generation initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/post/status/{embedPostId}": {
      "get": {
        "operationId": "getPostStatus",
        "summary": "Check post generation status",
        "description": "Returns the current status (PENDING, COMPLETED, or FAILED) and processing logs for a post. Poll this after initiating until status is COMPLETED, then fetch the output. On FAILED, inspect the logs array for the failing step. Docs: https://postnitro.ai/docs/embed/api/request-status.md",
        "parameters": [
          {
            "name": "embedPostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID returned by an initiate endpoint"
          }
        ],
        "responses": {
          "200": {
            "description": "Current status and logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "embedPostId": {
                          "type": "string"
                        },
                        "embedPost": {
                          "$ref": "#/components/schemas/EmbedPost"
                        },
                        "logs": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PostLog"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/post/output/{embedPostId}": {
      "get": {
        "operationId": "getPostOutput",
        "summary": "Retrieve generated carousel files",
        "description": "Returns the output of a completed post. Call only after status is COMPLETED. For responseType PNG, result.data is an array of image URLs (one per slide); for PDF, result.data is a single document URL; for MP4, result.data is a single video URL. Docs: https://postnitro.ai/docs/embed/api/post-output.md",
        "parameters": [
          {
            "name": "embedPostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID returned by an initiate endpoint"
          }
        ],
        "responses": {
          "200": {
            "description": "Generated output files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "embedPost": {
                          "$ref": "#/components/schemas/EmbedPost"
                        },
                        "result": {
                          "$ref": "#/components/schemas/PostResult"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/audio": {
      "get": {
        "operationId": "listAudio",
        "summary": "List workspace audio files",
        "description": "Lists the audio files in the API key's workspace, newest first. Use an entry's id as videoSettings.audioId (video posts) or postSettings.audioId (scheduled reels) — both take an id, never a URL. Uploading is done in the PostNitro app; this API only lists and deletes. An empty library returns 200 with an empty array. Docs: https://postnitro.ai/docs/embed/api/audio.md",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Results per page"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace's audio files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "audios": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AudioItem"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/audio/{id}": {
      "delete": {
        "operationId": "deleteAudio",
        "summary": "Delete an audio file",
        "description": "Permanently deletes the audio record and its stored file. Refused with a 400 while a scheduled post's postSettings.audioId still references it — a reel resolves its audio at publish time, so deleting first would leave it silent. Videos already rendered to MP4 are unaffected: their audio is baked into the file. Docs: https://postnitro.ai/docs/embed/api/audio.md",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Audio id, from GET /audio"
          }
        ],
        "responses": {
          "200": {
            "description": "Audio deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "example": "Audio deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The audio is still used by a scheduled post"
          },
          "404": {
            "description": "No such audio in this workspace, or the id is not an audio file"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "embedApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "embed-api-key",
        "description": "Embed API key generated from your PostNitro dashboard. See https://postnitro.ai/docs/embed/obtaining-an-api-key.md"
      }
    },
    "schemas": {
      "AiGeneration": {
        "type": "object",
        "required": ["type", "context"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "article", "x"],
            "description": "Source type: 'text' = context is a plain-text topic/prompt, 'article' = context is an article URL, 'x' = context is an X (Twitter) post URL"
          },
          "context": {
            "type": "string",
            "description": "The prompt, article URL, or X post URL depending on type"
          },
          "instructions": {
            "type": "string",
            "description": "Optional additional instructions for the AI"
          }
        }
      },
      "GenerateImages": {
        "type": "object",
        "additionalProperties": false,
        "description": "Opt-in AI image generation. Presence of this object enables it; omit it entirely for no images. Images are generated after the design is created and before rendering, and baked into the design (observable in the rendered file or via editorUrl) — the output shape is unchanged. Best-effort: if generation fails or isn't permitted (e.g. free plan or over the org's AI-image quota) the post still completes without images, and a GENERATE_IMAGES step is recorded in the status logs. Post credits are unchanged; AI images bill against the org's separate AI-image quota. editorType, image model, and copy config are resolved server-side and must not be sent",
        "properties": {
          "context": {
            "type": "string",
            "description": "Topic/brief that guides the image prompts. On generate, defaults to aiGeneration.context; on import, defaults to an empty string"
          },
          "imagePlacement": {
            "type": "string",
            "enum": ["auto", "background", "in-line"],
            "default": "auto",
            "description": "'auto' lets the AI decide per slide, 'background' generates slide backgrounds, 'in-line' generates images placed inside the slide content"
          },
          "imageStrategy": {
            "type": "string",
            "enum": ["strategic", "all"],
            "default": "strategic",
            "description": "'strategic' lets the AI pick which slides get images (capped at ~50% of slides), 'all' gives every eligible slide an image (capped by credits)"
          }
        }
      },
      "AudioItem": {
        "type": "object",
        "description": "An audio file in the workspace. `id` is what videoSettings.audioId and postSettings.audioId expect",
        "properties": {
          "id": {
            "type": "string",
            "description": "Pass this as videoSettings.audioId / postSettings.audioId"
          },
          "name": {
            "type": "string",
            "description": "Track title, falling back to the original filename"
          },
          "url": {
            "type": "string",
            "description": "Public URL of the file — useful for previewing; the API still expects the id"
          },
          "duration": {
            "type": "number",
            "nullable": true,
            "description": "Track length in seconds, or null when the uploader recorded none. Independent of videoSettings.videoDuration — a longer track is cut off at the video's length"
          },
          "artistName": {
            "type": "string",
            "nullable": true,
            "description": "Artist, when the source provided one"
          },
          "source": {
            "type": "string",
            "description": "Where the file came from, e.g. 'upload'"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VideoSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["videoDuration"],
        "description": "Render settings for VIDEO posts. Required when postType is VIDEO and responseType is MP4; optional (and omittable) for a DESIGN response; rejected with a 422 for any other postType. If the object is sent at all, videoDuration must be present and valid. Identical in shape to the postSettings object on the scheduling API, so settings carry over from creating a video to scheduling it as a reel",
        "properties": {
          "videoDuration": {
            "type": "number",
            "minimum": 5,
            "exclusiveMaximum": 60,
            "description": "Length of the rendered video in seconds — at least 5 and under 60"
          },
          "audioId": {
            "type": "string",
            "description": "Media id (not a URL) of an audio track to lay over the video — list them with GET /audio. Verified at request time: the media must exist, belong to the API key's workspace, and be an audio file, otherwise the request is rejected with a 422. Omit for a silent video"
          }
        }
      },
      "Slide": {
        "type": "object",
        "required": ["type", "heading"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["starting_slide", "body_slide", "ending_slide"],
            "description": "Slide role. Exactly 1 starting_slide (must be first), at least 1 body_slide, exactly 1 ending_slide (must be last)"
          },
          "heading": {
            "type": "string",
            "description": "Main heading text"
          },
          "sub_heading": {
            "type": "string",
            "description": "Subtitle text"
          },
          "description": {
            "type": "string",
            "description": "Description / body text"
          },
          "image": {
            "type": "string",
            "format": "uri",
            "description": "Image URL. Ignored when layoutType is 'infographic'"
          },
          "background_image": {
            "type": "string",
            "format": "uri",
            "description": "Background image URL"
          },
          "cta_button": {
            "type": "string",
            "description": "Call-to-action button text"
          },
          "layoutType": {
            "type": "string",
            "enum": ["default", "infographic"],
            "description": "'infographic' renders structured column data instead of the image. Available on both CAROUSEL and IMAGE slides"
          },
          "layoutConfig": {
            "$ref": "#/components/schemas/LayoutConfig"
          }
        }
      },
      "LayoutConfig": {
        "type": "object",
        "description": "Infographic configuration, used when layoutType is 'infographic'. All fields are optional; any omitted field uses its default. If layoutType is 'infographic' but layoutConfig is missing, the slide falls back to the default layout",
        "properties": {
          "hasHeader": {
            "type": "boolean",
            "default": true,
            "description": "Whether to show a header for each column"
          },
          "columnCount": {
            "type": "integer",
            "enum": [1, 2, 3],
            "default": 1,
            "description": "Number of columns (max 3)"
          },
          "displayCounterAs": {
            "type": "string",
            "enum": ["none", "counter"],
            "default": "counter",
            "description": "Whether to show numbered counters"
          },
          "columnDisplay": {
            "type": "string",
            "enum": ["cycle", "grid"],
            "default": "grid",
            "description": "'cycle' for sequential/step-by-step, 'grid' for comparative layout. With 'cycle', put ALL data in the first columnData entry only"
          },
          "columnData": {
            "type": "array",
            "default": [],
            "description": "The columns to render",
            "items": {
              "type": "object",
              "required": ["id", "content"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique id for the column. Caller-provided — stored as-is, not auto-generated"
                },
                "header": {
                  "type": "string",
                  "description": "Column header text (shown when hasHeader is true)"
                },
                "content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "description"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique id for the item. Caller-provided — stored as-is, not auto-generated"
                      },
                      "icon": {
                        "type": "string",
                        "nullable": true,
                        "description": "Optional icon"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string",
                        "description": "Description as an HTML string, e.g. '<p dir=\"ltr\">Description</p>'"
                      },
                      "titleEnabled": {
                        "type": "boolean",
                        "description": "Whether to show the title"
                      },
                      "descriptionEnabled": {
                        "type": "boolean",
                        "description": "Whether to show the description"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "InitiateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "example": "CAROUSEL generation initiated"
          },
          "data": {
            "type": "object",
            "properties": {
              "embedPostId": {
                "type": "string",
                "description": "Use this ID to poll status and fetch output"
              },
              "status": {
                "$ref": "#/components/schemas/PostStatus"
              }
            }
          }
        }
      },
      "EmbedPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "postType": {
            "type": "string",
            "enum": ["CAROUSEL", "IMAGE", "VIDEO"]
          },
          "responseType": {
            "type": "string",
            "enum": ["DESIGN", "PDF", "PNG", "MP4"]
          },
          "status": {
            "$ref": "#/components/schemas/PostStatus"
          },
          "credits": {
            "type": "integer",
            "description": "Credits consumed by this post"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostStatus": {
        "type": "string",
        "enum": ["PENDING", "COMPLETED", "FAILED"],
        "description": "PENDING = queued or generating (keep polling), COMPLETED = fetch output, FAILED = inspect status logs"
      },
      "PostLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "embedPostId": {
            "type": "string"
          },
          "step": {
            "type": "string",
            "description": "Processing step, e.g. INITIATED, PROCESSING, COMPLETED"
          },
          "status": {
            "type": "string",
            "description": "Step result, e.g. SUCCESS"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostResult": {
        "type": "object",
        "description": "designId, name, size, and editorUrl are always present. type, mimeType, and data are present only for PNG, PDF, and MP4; a DESIGN response omits them (nothing is rendered)",
        "properties": {
          "designId": {
            "type": "string",
            "description": "Durable design ID, used as the designId when scheduling a post"
          },
          "name": {
            "type": "string",
            "description": "Design name (from template, or 'Untitled')"
          },
          "size": {
            "type": "object",
            "description": "Design aspect ratio and pixel dimensions, e.g. { id: '4:5', dimensions: { width: 1080, height: 1350 } }"
          },
          "editorUrl": {
            "type": "string",
            "nullable": true,
            "description": "Deep link to open the design in the web editor, structured as <domain>/app/<editor-type>/<workspace-identifier>/<designId> where editor-type is image-maker for IMAGE, carousel-maker for CAROUSEL, and video-maker for VIDEO. Present for all response types. null if the workspace or postType can't be resolved"
          },
          "type": {
            "type": "string",
            "enum": ["png", "pdf", "mp4"],
            "description": "Rendered file type. Absent for DESIGN"
          },
          "mimeType": {
            "type": "string",
            "enum": ["image/png", "application/pdf", "video/mp4"],
            "description": "Rendered file MIME type. Absent for DESIGN"
          },
          "data": {
