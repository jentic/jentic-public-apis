    "/api/accounts/{account_id}/failoverTestResults": {
      "get": {
        "summary": "List failover test results",
        "parameters": [
          {
            "name": "timestampStart",
            "in": "query",
            "description": "The earliest timestamp to constrain results by, in ISO 8601 format. This timestamp is inclusive.\n",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "2021-11-24T12:21:16.123Z"
          },
          {
            "name": "timestampEnd",
            "in": "query",
            "description": "The latest timestamp to constrain results by, in ISO 8601 format. This timestamp is inclusive.\n",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "2021-11-25T12:21:16.123Z"
          },
          {
            "name": "reverse",
            "in": "query",
            "description": "If `true`, returns results starting with the newest timestamp first; if `false`, returns results starting with the oldest timestamp first (default is `false`)\n",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Return no more than this many results",
