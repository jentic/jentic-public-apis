          "200": {
            "description": "An OpenAPI document",
            "content": {
              "application/vnd.oai.openapi+json": {}
            }
          },
          "default": {
            "$ref": "#/components/responses/error-response"
          }
        }
      }
    },
    "/api/openapi.yml": {
      "get": {
        "security": [],
        "summary": "Get an OpenAPI document that describes the Arpio API in YAML format",
