          },
          {
            "name": "redirectUrl",
            "in": "query",
            "description": "A URL to redirect the user agent to after app consent succeeds. If not specified, the user agent is redirected to a default location in the Arpio console application.\n",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
