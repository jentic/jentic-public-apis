            "schema": {
              "type": "string"
            }
          },
          {
            "name": "success",
            "in": "query",
            "description": "If `true`, only successful failover test results are returned; if `false`, only unsuccessful failover test results are returned; if not specified, all failover test results are returned\n",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An array of failover test result representations",
            "content": {
              "application/json": {}
            }
