            "example": "aws:123456789012:us-east-1"
          },
          {
            "name": "aws_account_id",
            "in": "path",
            "description": "The primary (source) AWS account ID",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 123456789012
          },
          {
            "name": "region",
            "in": "path",
            "description": "The primary (source) AWS region",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "us-east-1"
          },
          {
            "name": "arn",
            "in": "path",
            "description": "The ARN of the resource whose configuration is to be deleted",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "arn:aws:ec2:us-east-1:123456789012:instance/i-1234567890abcdef0"
          }
        ],
        "responses": {
          "204": {
            "description": "An empty response indicating success"
          },
          "default": {
            "$ref": "#/components/responses/error-response"
          }
        }
      },
      "parameters": [
        {
          "name": "account_id",
          "in": "path",
          "description": "An Arpio account ID",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "endpoint_uri",
          "in": "path",
          "description": "The endpoint URI of the primary environment",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "aws:123456789012:us-east-1"
        },
        {
          "name": "arn",
          "in": "path",
          "description": "The ARN of the resource whose configuration is to be updated",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "arn:aws:ec2:us-east-1:123456789012:instance/i-1234567890abcdef0"
        }
      ]
    },
