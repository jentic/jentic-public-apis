          "schema": {
            "type": "string"
          },
          "example": "us-east-1"
        },
        {
          "name": "tgt_aws_account_id",
          "in": "path",
          "description": "The recovery (target) endpoint's AWS account ID",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "012345678901"
        },
        {
          "name": "tgt_region",
          "in": "path",
          "description": "The recovery (target) endpoint's AWS region",
