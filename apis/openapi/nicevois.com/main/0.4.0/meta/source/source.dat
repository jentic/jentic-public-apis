      "CreateConversion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "fileName",
          "durationSeconds"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "A private id returned by listVoiceModels."
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Original WAV, MP3, FLAC, M4A, or OGG source-vocal filename."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "description": "Exact source-audio byte size used to verify and resume private uploads."
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 86400,
            "description": "Measured duration used to verify that the account can retrieve the result before cloud work."
          },
          "transpose": {
            "type": "integer",
            "minimum": -24,
            "maximum": 24,
            "default": 0
          }
        }
