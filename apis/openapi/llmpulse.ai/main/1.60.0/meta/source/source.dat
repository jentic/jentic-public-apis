            "type": "integer"
          },
          "competitor_id": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "nullable": true,
            "description": "Bare (scheme-less) domain. Null for the project actor when the project has no URL."
          }
        }
      },
      "TimeseriesPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Calendar day in Europe/Madrid (YYYY-MM-DD). With granularity week or month it is the first day of the bucket (the Monday, or the 1st of the month)."
          },
          "value": {
            "type": "number",
            "nullable": true,
            "description": "Null when the metric has no value for the bucket, e.g. a rate, position or sentiment metric on a day without answers."
          }
        }
      },
      "TimeseriesSeries": {
        "type": "object",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/Actor"
