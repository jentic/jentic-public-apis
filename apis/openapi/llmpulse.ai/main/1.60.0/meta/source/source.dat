      "RecommendationSummary": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "recommendation_type",
          "status",
          "error_message",
          "generated_at",
          "created_at",
          "updated_at",
          "total_recommendations",
          "high_priority_count",
          "summary",
          "context"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer"
          },
          "recommendation_type": {
            "type": "string",
            "enum": [
              "ai_visibility",
              "social_community",
              "brand_building",
              "sentiment_reputation"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "error_message": {
            "type": "string",
            "nullable": true,
            "description": "Set only when status is failed"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Null until the generation completes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "total_recommendations": {
            "type": "integer"
          },
          "high_priority_count": {
            "type": "integer"
          },
          "summary": {
            "type": "object",
            "description": "Empty until the generation completes",
            "properties": {
              "total_recommendations": {
                "type": "integer"
              },
              "high_priority_count": {
                "type": "integer"
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "context": {
            "type": "object",
            "description": "Generation context and run diagnostics as stored; empty until the generation completes. Its keys are not a stable contract"
          }
        }
      },
      "RecommendationsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedEnvelope"
          },
          {
