      "AnswerDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "prompt_id": {
            "type": "integer"
          },
          "prompt_text": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "response": {
            "type": "string",
            "nullable": true
          },
          "response_truncated": {
            "type": "boolean"
          },
