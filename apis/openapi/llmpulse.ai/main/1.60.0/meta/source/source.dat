    "/search_console/summary": {
      "get": {
        "tags": [
          "Search Console"
        ],
        "summary": "Search Console summary (Growth+)",
        "x-llms-description": "Google Search Console headline totals (impressions, clicks, CTR, average position) for a date range, with an optional country, device, page, query or searchAppearance breakdown. With filters and no dimension the totals are the complete filtered figure; breakdown rows are capped and can differ from the totals. Requires a connected GSC property (Growth+).",
        "description": "Google Search Console headline totals (impressions, clicks, ctr as a 0..1 fraction, average position) for the project over a date range. Pass dimension=country, device, page, query or searchAppearance to also receive the breakdown aggregated over the range, capped by limit. With filters and no dimension, totals are the complete figure Google reports for that filter. Breakdown rows are capped by limit and by Google's 25,000-row maximum; breakdown_truncated: true means rows were left out. Query rows exclude anonymized queries, and page and searchAppearance rows are counted per page rather than per property, so breakdown rows can differ from the totals. Requires the project to have a connected Search Console property and the Growth plan or above; otherwise returns ERR_SEARCH_CONSOLE_NOT_CONNECTED or ERR_PLAN_REQUIRED. X-Search-Console-Backend identifies stored or live reads. Stored reads use synced data without contacting Google. Live reads return ERR_SEARCH_CONSOLE_ACCESS_REVOKED (403) for revoked Google access; reconnect the property in Preferences > Project Settings > Data Connections. They return ERR_SEARCH_CONSOLE_UPSTREAM (503) when Google Search Console is unavailable or over quota; wait for the number of seconds in Retry-After before retrying.",
        "operationId": "getSearchConsoleSummary",
        "x-mcp-tool": "get_search_console_summary",
        "x-plan": "growth",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/GscRange"
          },
          {
            "$ref": "#/components/parameters/GscFrom"
          },
          {
            "$ref": "#/components/parameters/GscTo"
          },
          {
            "name": "dimension",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "country",
                "device",
                "page",
                "query",
                "searchAppearance"
              ]
            },
            "description": "Optional breakdown aggregated over the range. country and device are lowercased; page and query keep the casing Google returns, because a page URL is case sensitive."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "description": "Maximum breakdown rows, sorted by impressions descending. Default and maximum 1000. Use /search_console/queries or /search_console/pages to page through up to 25,000 rows."
          },
          {
            "$ref": "#/components/parameters/GscSearchType"
          },
          {
            "$ref": "#/components/parameters/GscFilters"
          },
          {
            "$ref": "#/components/parameters/GscDataState"
          },
          {
            "$ref": "#/components/parameters/GscAggregationType"
          }
        ],
        "responses": {
          "200": {
            "description": "Search Console summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchConsoleSummaryResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/SearchConsoleForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/search_console/timeseries": {
      "get": {
        "tags": [
