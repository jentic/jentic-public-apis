            "type": "number",
            "nullable": true
          },
          "metric_deltas": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_key": {
                  "type": "string"
                },
                "check_title": {
                  "type": "string",
                  "nullable": true
                },
                "subject_key": {
                  "type": "string"
                },
                "subject": {
                  "type": "string",
                  "nullable": true
                },
                "severity": {
                  "type": "string"
                },
                "from_status": {
                  "type": "string",
                  "nullable": true
                },
                "to_status": {
                  "type": "string",
                  "nullable": true
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "new",
                    "fixed",
                    "changed",
                    "appeared",
                    "disappeared",
                    "unchanged"
                  ]
                }
