            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "IntelligenceTaskProduct": {
        "type": "object",
        "required": [
          "title"
        ],
        "description": "The store product a product_listing task rewrites",
        "properties": {
          "external_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description_html": {
            "type": "string",
            "maxLength": 20000
          },
          "seo_title": {
            "type": "string"
          },
          "seo_description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "product_type": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IntelligenceTaskCreateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "task_type"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "brief",
              "create",
              "update",
              "pr_insights",
              "custom",
              "product_listing"
            ],
            "description": "product_listing is API-only: it needs product and returns ready-to-apply product page copy"
          },
          "prompt_id": {
            "type": "integer",
            "nullable": true,
            "description": "Not used by product_listing; send null or omit it"
          },
          "custom_topic": {
            "type": "string"
          },
          "user_instructions": {
            "type": "string"
          },
          "output_language_code": {
            "type": "string"
          },
          "existing_content": {
            "type": "string"
          },
          "existing_content_url": {
            "type": "string",
            "format": "uri"
          },
          "product": {
            "$ref": "#/components/schemas/IntelligenceTaskProduct"
          },
          "prompt_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "integer"
            },
            "description": "product_listing only: up to 20 project prompts the copy should answer"
          }
        }
      },
      "IntelligenceTaskUpdateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "edits"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "edits": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Dotted result_data paths (title, sections.0.content, key_points.2) mapped to their replacement text. Only string fields that already exist are editable; sections cannot be added or removed.",
            "example": {
              "title": "How to measure AI visibility in 2026",
              "sections.0.content": "AI visibility is the share of AI answers that mention your brand."
            }
          },
          "result_version": {
            "type": "string",
            "nullable": true,
            "description": "Optional. The result_version of the task as last read. When sent, the edit is refused with ERR_STALE_CONTENT (409) and nothing is written if the task was regenerated since. Omitted, null or empty, the edits apply to whatever the task holds now",
            "example": "1775642580"
          }
        }
      },
      "IntelligenceTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "public_id": {
            "type": "string"
          },
          "project_id": {
            "type": "integer"
          },
          "task_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "prompt_id": {
            "type": "integer",
            "nullable": true
          },
          "prompt_text": {
            "type": "string",
            "nullable": true
          },
          "agentic_mode": {
            "type": "boolean"
          },
          "custom_topic": {
            "type": "string",
            "nullable": true
          },
          "user_instructions": {
            "type": "string",
            "nullable": true
          },
          "output_language_code": {
            "type": "string",
            "nullable": true
          },
          "word_count": {
            "type": "integer",
            "nullable": true
          },
          "result_data": {
            "type": "object",
            "nullable": true,
            "description": "The generated content once status is completed; null before that. A product_listing task returns title, summary, description_html (p, ul, ol, li, strong, em, h3 and br only), faq (question and answer pairs), seo_title, seo_description, image_alts (image_id and alt), changes (field and reason) and labels"
          },
          "error_message": {
            "type": "string",
            "nullable": true
          },
          "estimated_time": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "processed_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "manually_edited_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "When the content was last edited by hand; null while the output is as generated"
          },
          "edited_by_user_id": {
            "type": "integer",
            "nullable": true,
            "description": "User behind the last manual edit; null for an unedited task or an edit made from an embedded portal"
          },
          "result_version": {
            "type": "string",
            "description": "Concurrency token for content edits: send it back as result_version on PATCH /intelligence_tasks/{id} so an edit composed before a regeneration is refused with ERR_STALE_CONTENT (409). It is \"0\" until the task first completes, then changes each time a generation or regeneration replaces result_data, never on a manual edit or a revert. Treat it as opaque text",
            "example": "1775642580"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "IntelligenceTaskUpdateResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IntelligenceTask"
          },
          {
            "type": "object",
            "properties": {
              "changed_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Paths whose text actually changed; empty when every value matched the stored text"
              }
            }
          }
        ]
      },
      "TechnicalGeoReportContentUpdateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "report_type",
          "content_version",
          "edits"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "report_type": {
            "type": "string",
            "enum": [
              "llms_txt"
            ],
            "description": "Only llms_txt reports have editable content"
          },
          "content_version": {
            "type": "string",
            "description": "result_data.content_version of the report as last read. It changes on every save; a value that no longer matches is refused as stale",
            "example": "1790683200123456"
          },
          "edits": {
            "type": "object",
            "additionalProperties": false,
            "description": "The files to replace, each mapped to its full replacement text: never blank, at most 200,000 characters. Send one file or both; a file identical to the stored one is ignored.",
            "properties": {
              "llms_txt": {
                "type": "string",
                "description": "Full text of llms.txt"
              },
              "llms_full_txt": {
                "type": "string",
                "description": "Full text of llms-full.txt"
              }
            },
            "example": {
              "llms_txt": "# example.com\n\n> What example.com does, in one paragraph.\n"
            }
          }
        }
      },
      "TechnicalGeoReportContentRevertRequest": {
        "type": "object",
        "required": [
          "project_id",
          "report_type"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "report_type": {
            "type": "string",
            "enum": [
              "llms_txt"
            ],
            "description": "Only llms_txt reports have editable content"
          }
        }
      },
      "LlmsTxtTechnicalGeoReport": {
        "type": "object",
        "description": "An llms_txt technical GEO report with its files, in the shape GET /technical_geo_reports/{id} returns",
        "properties": {
          "id": {
            "type": "integer"
          },
          "report_type": {
            "type": "string",
            "description": "Always llms_txt"
          },
          "project_id": {
            "type": "integer"
          },
          "batch_id": {
            "type": "integer",
            "nullable": true,
            "description": "Bundle the report was created in; null for a report created on its own"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "Always null for llms_txt reports; domain names the website"
          },
          "domain": {
            "type": "string"
          },
          "country_code": {
            "type": "string",
            "nullable": true
          },
          "output_language_code": {
            "type": "string",
            "nullable": true,
            "description": "ISO 639-1 code the files were requested in; null when they are written in the website's own language"
          },
          "status": {
            "type": "string"
          },
          "result_available": {
            "type": "boolean"
          },
          "overall_score": {
            "type": "number",
            "nullable": true,
            "description": "Always null for llms_txt reports"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "result_data": {
            "type": "object",
            "nullable": true,
            "description": "The files and generation details once the report has completed; null before that",
            "properties": {
              "llms_txt_content": {
                "type": "string",
                "description": "Current llms.txt, manual edits included"
              },
              "llms_full_txt_content": {
                "type": "string",
                "nullable": true,
                "description": "Current llms-full.txt, manual edits included"
              },
              "manually_edited_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "When the files were last edited by hand in the app, the API or MCP; null while they are as generated"
              },
              "content_version": {
                "type": "string",
                "description": "Send it back as content_version when editing the files. It changes on every save"
              },
              "original_llms_txt_content": {
                "type": "string",
                "nullable": true,
                "description": "The generated llms.txt, kept from the first manual edit; null while the files are as generated"
              },
              "original_llms_full_txt_content": {
                "type": "string",
                "nullable": true,
                "description": "The generated llms-full.txt, kept from the first manual edit; null while the files are as generated"
              },
              "crawl_data": {
                "type": "object",
                "nullable": true
              },
              "metadata": {
                "type": "object",
                "nullable": true,
                "description": "Generation details, including output_language_code, the language the files were written in"
              },
              "pages_crawled": {
                "type": "integer",
                "nullable": true
              },
              "generation_time_ms": {
                "type": "integer",
                "nullable": true
              },
              "openai_tokens_used": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "error_message": {
            "type": "string",
            "nullable": true
          },
          "poll_after_seconds": {
            "type": "integer",
            "nullable": true,
            "description": "Seconds to wait before polling again while the report runs; null once it has finished"
          },
          "app_url": {
            "type": "string",
            "format": "uri",
            "description": "Opens this report in the app"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "TechnicalGeoReportContentUpdateResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LlmsTxtTechnicalGeoReport"
          },
          {
            "type": "object",
            "properties": {
              "changed_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "llms_txt",
                    "llms_full_txt"
                  ]
                },
                "description": "Files whose text actually changed; empty when every file matched the stored text"
              }
            }
          }
        ]
      },
