      "GeoAuditCreateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "target",
          "audit_types"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "target": {
            "type": "string",
            "description": "The domain (site-wide types) or page URL to audit"
          },
          "audit_types": {
            "type": "array",
            "description": "One or more audit types; each becomes its own audit and starts its first run",
            "items": {
              "type": "string",
              "enum": [
                "agent_readiness",
                "robots_txt",
                "crawlability",
                "schema",
                "content_readiness",
                "discoverability",
                "site_structure"
              ]
            }
          },
          "cadence": {
            "type": "string",
            "enum": [
              "once",
              "weekly",
              "monthly"
            ],
            "description": "once (default), weekly or monthly. Weekly and monthly need a type whose checks are tracked and count against the plan limit of recurring audits"
          }
        }
      },
      "GeoAuditCreateResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoAudit"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "GeoAuditUpdateRequest": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "cadence": {
            "type": "string",
            "enum": [
              "once",
              "weekly",
              "monthly"
            ]
          },
          "schedule_day": {
            "type": "integer",
            "description": "Weekly: 0 (Sunday) to 6. Monthly: 1 to 28."
          },
          "schedule_hour": {
            "type": "integer",
            "description": "Hour of the day, 0 to 23, in the audit time zone"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "archived"
            ],
            "description": "paused stops scheduled runs, active resumes them, archived is the same as DELETE"
          },
          "email_alerts": {
            "type": "boolean"
          }
        }
      },
