          }
        }
      }
    },
    "/metrics/prompt_summary": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "summary": "Per-prompt metrics summary",
        "x-llms-description": "Paginated per-prompt metrics (responses, mentions, citations, mention_rate, citation_rate, avg position, brand sentiment) with each prompt's country, language, type, brand focus and tags.",
        "description": "Paginated per-prompt aggregated metrics. Returns responses, mentions, citations, mention_rate, citation_rate, avg_mention_position and avg_position per prompt, plus the brand sentiment of its responses (sentiment_responses, the five sentiment percentages and net_sentiment, computed like the sentiment timeseries) and the prompt's classification (country_code, language_code, prompt_type, brand_kind and tags, as in /dimensions/prompts). Citations and citation rate include visible citations and background source references; avg_position uses visible citations only. Pass `breakdown=model` to split each prompt by model.",
        "operationId": "getPromptSummary",
        "x-mcp-tool": "get_prompt_summary",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
