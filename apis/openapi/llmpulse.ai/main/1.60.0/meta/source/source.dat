            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CitationMatchMode": {
        "type": "string",
        "description": "How citations are attributed: domain (the domain and its subdomains), host (that exact host) or path_prefix (URLs under citation_match_path)",
        "enum": [
          "domain",
          "host",
          "path_prefix"
        ]
      },
      "Actor": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "project",
              "competitor"
            ]
          },
