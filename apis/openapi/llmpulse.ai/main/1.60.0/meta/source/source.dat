    "/search_console/rows": {
      "get": {
        "tags": [
          "Search Console"
        ],
        "summary": "Search Console rows by several dimensions (Growth+)",
        "x-llms-description": "Google Search Console rows grouped by up to 3 dimensions (e.g. page and query, or date and page), ranked by impressions/clicks/CTR/position, paginated; at most 25,000 rows per request, start_row reads the next block (Growth+).",
        "description": "Google Search Console rows grouped by 1 to 3 dimensions (date, country, device, page, query, searchAppearance) over a date range, each row carrying its dimension values as fields plus impressions, clicks, ctr (0..1) and position, ranked by impressions, clicks, ctr or position, paginated. Google ranks rows by clicks and returns at most 25,000 per request (truncated: true when reached); start_row moves that window. Query rows exclude anonymized queries, so rows add up to less than the summary totals. Requires a connected Search Console property (Growth+) and live reads: stored reads return ERR_INVALID_PARAM. Live reads return ERR_SEARCH_CONSOLE_ACCESS_REVOKED (403) for revoked Google access and ERR_SEARCH_CONSOLE_UPSTREAM (503) when Google Search Console is unavailable or over quota; wait for the number of seconds in Retry-After before retrying. A combination Google refuses comes back as ERR_INVALID_PARAM with its reason.",
        "operationId": "getSearchConsoleRows",
        "x-mcp-tool": "get_search_console_rows",
        "x-plan": "growth",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "dimensions",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "page,query",
            "description": "Comma-separated dimensions to group by, 1 to 3 of date, country, device, page, query, searchAppearance. Each becomes a field of every row; country and device values are lowercase."
          },
          {
            "$ref": "#/components/parameters/GscRange"
          },
          {
            "$ref": "#/components/parameters/GscFrom"
          },
          {
            "$ref": "#/components/parameters/GscTo"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "impressions",
                "clicks",
                "ctr",
                "position"
              ],
              "default": "impressions"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/GscStartRow"
          },
          {
            "$ref": "#/components/parameters/Output"
          },
          {
            "$ref": "#/components/parameters/GscSearchType"
          },
          {
            "$ref": "#/components/parameters/GscFilters"
          },
          {
            "$ref": "#/components/parameters/GscDataState"
          },
          {
            "$ref": "#/components/parameters/GscAggregationType"
          }
        ],
        "responses": {
          "200": {
            "description": "Search Console rows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchConsoleRowsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/SearchConsoleForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
