            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagRef"
            }
          },
          "country_code": {
            "type": "string",
            "nullable": true
          },
          "language_code": {
            "type": "string",
            "nullable": true
          },
          "prompt_type": {
            "type": "string",
            "nullable": true,
            "description": "Search intent: informational, navigational, commercial or transactional. Null until the prompt is classified"
          },
          "brand_kind": {
            "type": "string",
            "nullable": true,
            "description": "Brand focus: brand, brand_other or non_brand. Null until the prompt is classified"
          },
          "last_executed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Null until the prompt has run"
          },
          "app_url": {
            "type": "string",
            "format": "uri",
            "description": "Opens this prompt in the app. The link names its project, so it opens there for any user with access to that project"
          }
        }
      },
      "PromptsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedEnvelope"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
