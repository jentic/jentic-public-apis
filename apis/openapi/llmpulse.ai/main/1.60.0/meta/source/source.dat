    "/dimensions/prompts": {
      "get": {
        "tags": [
          "Prompts"
        ],
        "summary": "List prompts",
        "x-llms-description": "Paginated list of prompts with their primary tag, all tags, locale, and last_executed_at.",
        "operationId": "listPrompts",
        "x-mcp-tool": "list_prompts",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "chatgpt",
                "perplexity",
                "ai_mode",
                "ai_overview",
                "gemini",
                "copilot",
                "amazon_rufus",
                "claude",
                "grok",
                "deepseek",
                "naver_ai",
                "baidu_ai",
                "meta_ai"
              ]
            },
            "description": "Keep only the prompts with at least one execution on this AI model, of any outcome and date (the prompts /dimensions/prompt_executions lists for the same model). Prompts have no model of their own, so a prompt with no execution on this model yet (a newly enabled model, or a locale the model does not cover) is left out. An unknown value, or a model the API key's user has not enabled, returns 422 ERR_INVALID_PARAM. from and to still filter prompt creation."
          },
          {
            "$ref": "#/components/parameters/CollectionId"
          },
          {
            "$ref": "#/components/parameters/CountryCode"
          },
          {
            "$ref": "#/components/parameters/LanguageCode"
          },
          {
            "$ref": "#/components/parameters/Prompt"
          },
          {
            "$ref": "#/components/parameters/PromptType"
          },
          {
            "$ref": "#/components/parameters/BrandKind"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Output"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated prompts. Every row carries app_url, the link that opens the prompt in the app",
