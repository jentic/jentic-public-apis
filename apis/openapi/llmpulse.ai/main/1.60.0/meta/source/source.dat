    "/dimensions/owned_media": {
      "get": {
        "tags": [
          "Owned Media & Communities"
        ],
        "summary": "List owned-media citations",
        "x-llms-description": "Owned-media citations by platform (provider=youtube, instagram, facebook, tiktok, linkedin, mobile_apps): cited videos, posts, profiles, channels and app-store listings, each flagged as yours or not (Growth+).",
        "operationId": "listOwnedMedia",
        "x-mcp-tool": "list_owned_media",
        "x-plan": "growth",
        "description": "Which owned-media content AI answers cite, by platform. `provider` is required. Each row carries a `yours` flag so you can compare your own presence against everyone else cited on the same platform. view=own_citations returns the raw citations of the connected profile only and stays empty until a profile is connected. For Reddit use /dimensions/reddit. Requires the Growth plan or above.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "youtube",
                "instagram",
                "facebook",
                "tiktok",
                "linkedin",
                "mobile_apps"
              ]
            },
            "description": "The platform to report on"
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "videos",
                "channels",
                "posts",
                "profiles",
                "own_citations",
                "apps"
              ]
            },
            "description": "Row shape; the allowed set depends on provider"
          },
          {
            "name": "store",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "google_play",
                "app_store"
              ],
              "default": "google_play"
            },
            "description": "provider=mobile_apps only"
          },
