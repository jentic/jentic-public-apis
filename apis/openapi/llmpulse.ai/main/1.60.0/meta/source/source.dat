    "/sentiments": {
      "get": {
        "tags": [
          "Sentiments"
        ],
        "summary": "List sentiment records (Growth plan or above)",
        "x-llms-description": "Paginated sentiment analysis records with comments, topics, scores; filterable by analysis level and brand_only.",
        "operationId": "listSentimentRecords",
        "x-mcp-tool": "list_detailed_sentiments",
        "x-plan": "growth",
        "description": "Requires the Growth plan; lower tiers receive ERR_PLAN_REQUIRED.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "competitor_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "brand_only",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "analysis",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One sentiment level or a comma-separated list: very_positive, positive, neutral, negative, very_negative"
          },
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "chatgpt",
                "perplexity",
                "ai_mode",
                "ai_overview",
                "gemini",
                "copilot",
                "amazon_rufus",
                "claude",
                "grok",
                "deepseek",
                "naver_ai",
                "baidu_ai",
                "meta_ai"
              ]
            },
            "description": "Filter by one AI model. Here an unknown value, or a model the API key's user has not enabled, is ignored rather than rejected: the request succeeds and returns the records of every enabled model, as if model were omitted."
          },
          {
            "$ref": "#/components/parameters/CollectionId"
          },
          {
            "$ref": "#/components/parameters/CountryCode"
          },
          {
            "$ref": "#/components/parameters/LanguageCode"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated sentiments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentimentsResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/GrowthPlanRequired"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
