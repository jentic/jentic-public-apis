                ],
                "properties": {
                  "project_id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "annotation_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "color": {
                    "type": "string"
                  },
                  "annotation_category_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientPermission"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "delete": {
        "tags": [
          "Annotations"
        ],
        "summary": "Delete a timeline annotation",
        "x-llms-description": "Delete an own-user annotation. Available on every plan.",
        "operationId": "deleteAnnotation",
        "x-mcp-tool": "delete_annotation",
        "x-write": true,
        "description": "Deletes an annotation. Same ownership rule as PATCH. Available on every plan and requires a `read_write` scope API key.",
        "parameters": [
