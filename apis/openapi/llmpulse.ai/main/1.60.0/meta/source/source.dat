      "SearchConsoleSummaryResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "property": {
            "$ref": "#/components/schemas/SearchConsoleProperty"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "data_through": {
            "type": "string",
            "format": "date",
