            "type": "integer"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "granularity": {
            "type": "string",
            "description": "day, week or month"
          },
          "filters": {
