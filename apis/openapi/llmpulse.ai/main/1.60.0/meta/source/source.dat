          },
          "brand_name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "industry": {
            "description": "Industry as stored: one key as a string (e.g. SAAS), or an array of key strings. Deliberately untyped so generated clients decode either shape"
          },
          "business_model": {
            "type": "string",
            "nullable": true
          },
          "business_model_other": {
            "type": "string",
            "nullable": true,
            "description": "Set only when business_model is OTHER"
          },
          "target_audience": {
            "type": "string",
            "nullable": true
          },
          "primary_products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brand_voice": {
            "type": "string",
            "nullable": true
          },
          "goals": {
            "type": "string",
            "nullable": true
          },
          "matching_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "additional_owned_domains": {
            "$ref": "#/components/schemas/AdditionalOwnedDomains"
          }
        }
      },
      "ProjectUpdateResponse": {
        "type": "object",
        "required": [
          "project",
          "updated_fields",
          "rematching",
          "note",
          "request_id"
        ],
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectProfile"
          },
          "updated_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The fields the request sent"
          },
          "rematching": {
            "type": "boolean",
            "description": "True when a matching_names or additional_owned_domains change started a background recalculation of past answers; further edits are rejected until it finishes"
          },
          "note": {
            "type": "string",
            "description": "What the change does to mention detection, citation ownership and historical numbers"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Competitor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "nullable": true,
            "description": "Bare (scheme-less) domain. Null only on the own-brand row (include_project_brand=true) when the project has no URL."
          },
          "matching_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Alternative names matched as this competitor. Absent on the own-brand row"
          },
          "citation_match_mode": {
            "$ref": "#/components/schemas/CitationMatchMode"
          },
          "citation_match_path": {
            "type": "string",
            "nullable": true,
            "description": "Set only when citation_match_mode is path_prefix"
          },
          "actor_type": {
            "type": "string",
            "enum": [
              "project",
              "competitor"
            ],
            "description": "Only present when include_project_brand=true"
          },
          "is_own": {
            "type": "boolean",
            "description": "Only present when include_project_brand=true"
          }
        }
      },
      "CompetitorDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer"
          },
          "brand_name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "matching_names": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "google_play_id": {
            "type": "string",
            "nullable": true
          },
          "app_store_id": {
            "type": "string",
            "nullable": true
          },
          "citation_match_mode": {
            "$ref": "#/components/schemas/CitationMatchMode"
          },
          "citation_match_path": {
            "type": "string",
            "nullable": true,
            "description": "Set only when citation_match_mode is path_prefix"
          },
          "google_play_name": {
            "type": "string",
            "nullable": true,
            "description": "English app name on Google Play, when the competitor has an Android app"
          },
          "app_store_name": {
            "type": "string",
            "nullable": true,
            "description": "English app name on the App Store, when the competitor has an iOS app"
          },
          "google_play_icon_url": {
            "type": "string",
            "nullable": true
          },
          "app_store_icon_url": {
            "type": "string",
            "nullable": true
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "processing": {
