        }
      },
      "McpRequest": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "method": {
            "type": "string",
            "description": "MCP method (initialize, tools/list, tools/call, etc.)"
          },
          "params": {
            "type": "object"
          }
        }
      },
      "McpResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "result": {
            "type": "object"
          },
          "error": {
            "type": "object"
          }
        }
      },
      "GeoAuditSchedule": {
        "type": "object",
        "nullable": true,
        "description": "Present for weekly and monthly audits. day is 0 (Sunday) to 6 for weekly audits and 1 to 28 for monthly ones; hour is in timezone.",
        "properties": {
          "day": {
            "type": "integer"
          },
          "hour": {
            "type": "integer"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "GeoAuditRun": {
        "type": "object",
        "nullable": true,
        "description": "One run of an audit. Null where an audit has no run yet (latest_run) or a comparison has no earlier run (from_run).",
        "properties": {
          "sequence": {
            "type": "integer",
            "description": "Run number within the audit, starting at 1"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "unreachable"
            ]
          },
          "trigger": {
            "type": "string",
            "enum": [
              "scheduled",
              "manual",
              "api",
              "mcp",
              "legacy_import"
            ]
          },
          "score": {
            "type": "number",
            "nullable": true
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "score_delta": {
            "type": "number",
            "nullable": true,
            "description": "Score change against the previous completed run"
          },
          "comparable_to_previous": {
            "type": "boolean",
            "description": "False when the checks or the audit settings changed since the previous run, so a diff may reflect that change"
          },
          "new_issues": {
            "type": "integer"
          },
          "fixed_issues": {
            "type": "integer"
          },
          "regressed_issues": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "engine_version": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "app_url": {
            "type": "string"
          }
        }
      },
      "GeoAuditRunDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GeoAuditRun"
          },
          {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "integer"
              },
              "metrics": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "result_data": {
                "type": "object",
                "nullable": true,
                "description": "The full report of the run, in the shape of the matching technical GEO report type"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "GeoAudit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable audit id"
          },
          "audit_type": {
            "type": "string",
            "enum": [
              "agent_readiness",
              "robots_txt",
              "crawlability",
              "schema",
              "content_readiness",
              "discoverability",
              "site_structure"
            ]
          },
          "target": {
            "type": "string",
            "description": "The audited domain (site-wide types) or page URL, normalized"
          },
          "country_code": {
            "type": "string",
            "nullable": true
          },
          "cadence": {
            "type": "string",
            "enum": [
              "once",
              "weekly",
              "monthly"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "archived"
            ]
          },
          "paused_reason": {
            "type": "string",
            "nullable": true,
            "description": "user, or unreachable when three runs in a row could not reach the site"
          },
          "schedule": {
            "$ref": "#/components/schemas/GeoAuditSchedule"
          },
          "next_run_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "email_alerts": {
            "type": "boolean"
          },
          "recurring_available": {
            "type": "boolean",
            "description": "Whether this audit type can run weekly or monthly"
          },
          "checks_tracked": {
            "type": "boolean",
            "description": "Whether runs of this type produce findings and issues, or a score only"
          },
          "latest_run": {
            "$ref": "#/components/schemas/GeoAuditRun"
          },
          "open_issues": {
            "type": "integer"
          },
          "open_critical_issues": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "app_url": {
            "type": "string"
          }
        }
      },
      "GeoAuditResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GeoAudit"
          },
          {
            "type": "object",
