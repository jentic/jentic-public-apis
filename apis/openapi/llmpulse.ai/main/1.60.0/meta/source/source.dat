              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntelligenceTasksResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "GEO Writer"
        ],
        "summary": "Create a GEO Writer task",
        "x-llms-description": "Create a GEO Writer (formerly Content Intelligence) task (brief, create, update, pr_insights, custom, or product_listing with a product object); processed async.",
        "operationId": "createIntelligenceTask",
        "x-mcp-tool": "create_intelligence_task",
        "x-write": true,
        "description": "Creates a GEO Writer task, processed asynchronously: poll GET /intelligence_tasks/{id} until status is completed. Prompt-based mode takes prompt_id; agentic mode takes custom_topic and/or user_instructions. task_type product_listing is API-only and serves store apps: send a product object (title required) and optionally prompt_ids, and the completed result_data holds ready-to-apply product page copy. Edit and revert it with PATCH /intelligence_tasks/{id} and POST /intelligence_tasks/{id}/revert. Requires a `read_write` scope API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntelligenceTaskCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntelligenceTask"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/intelligence_tasks/{id}": {
      "get": {
        "tags": [
          "GEO Writer"
        ],
        "summary": "Get a GEO Writer task",
        "x-llms-description": "Get one GEO Writer (formerly Content Intelligence) task with full result_data when completed (accepts numeric id or public_id).",
        "operationId": "getIntelligenceTask",
        "x-mcp-tool": "get_intelligence_task",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Numeric task ID or public_id string token"
          }
        ],
        "responses": {
          "200": {
            "description": "Task with result_data when completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntelligenceTask"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "GEO Writer"
        ],
        "summary": "Edit GEO Writer task content",
        "x-llms-description": "Edit the text of a completed GEO Writer task in place: edits maps dotted result_data paths (title, sections.0.content) to replacement text; the generated version is kept for revert.",
        "operationId": "updateIntelligenceTaskContent",
        "x-mcp-tool": "update_intelligence_task_content",
        "x-write": true,
        "description": "Edits the text of a completed task in place. `edits` maps dotted paths into result_data (for example `title` or `sections.0.content`) to replacement text. Only string fields that already exist can change: a path that does not resolve to text, a blank `title`, a value over 20,000 characters or an empty `edits` object is rejected with ERR_INVALID_PARAM and nothing is written. Send the `result_version` you last read with the edits: when the task was regenerated since, the request is refused with ERR_STALE_CONTENT (409), nothing is written and `error.meta.result_version` holds the current token. Without `result_version` the edits apply to whatever the task holds now. Values identical to the stored text are ignored, and the response lists the paths that actually changed. The first edit keeps a copy of the generated output so POST /intelligence_tasks/{id}/revert can restore it; regenerating the task replaces the edited content. Requires a `read_write` scope API key and, for team members, update permission on GEO Writer.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Numeric task ID or public_id string token"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntelligenceTaskUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task with the paths that changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntelligenceTaskUpdateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "The task was regenerated since the result_version in the request was read (ERR_STALE_CONTENT). Nothing was written; error.meta.result_version holds the current token. Read the task again and resend the edits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "ERR_STALE_CONTENT",
                    "message": "The task was regenerated since it was read; its current result_version is 1775642580. Read it again and resend your edits.",
                    "meta": {
                      "message": "The task was regenerated since it was read; its current result_version is 1775642580. Read it again and resend your edits.",
                      "result_version": "1775642580"
                    }
                  },
                  "request_id": "abc-123"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/intelligence_tasks/{id}/revert": {
      "post": {
        "tags": [
          "GEO Writer"
        ],
        "summary": "Revert GEO Writer task content",
        "x-llms-description": "Discard every manual edit on a GEO Writer task and restore the generated output.",
        "operationId": "revertIntelligenceTaskContent",
        "x-mcp-tool": "revert_intelligence_task_content",
        "x-write": true,
        "description": "Discards every manual edit on the task and restores the output exactly as it was generated. Returns ERR_INVALID_PARAM when the task has no manual edits. Requires a `read_write` scope API key and, for team members, update permission on GEO Writer.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Numeric task ID or public_id string token"
          }
        ],
        "responses": {
          "200": {
            "description": "Task restored to its generated output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntelligenceTask"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
