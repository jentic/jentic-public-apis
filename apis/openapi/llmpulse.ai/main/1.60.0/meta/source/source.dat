      "ProjectCreateRequest": {
        "type": "object",
        "required": [
          "website_url",
          "name",
          "main_country",
          "main_language"
        ],
        "properties": {
          "website_url": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTP(S) URL with a DNS hostname or public IP address. Credentials, private and special IP addresses, localhost and internal hostnames are rejected.",
            "example": "https://acme.com"
          },
          "name": {
            "type": "string",
            "description": "Project name, as plain text. It can be changed later with PATCH /projects/{id}",
            "example": "Acme"
          },
          "main_country": {
            "type": "string",
            "example": "US"
          },
          "main_language": {
            "type": "string",
            "example": "en"
          },
          "brand_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "industry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Industry keys, case-insensitive; a single key string is also accepted. An unknown key returns ERR_INVALID_PARAM listing the valid keys (the same list as the in-app industry picker, e.g. TECHNOLOGY, SAAS, ECOMMERCE)",
            "example": [
              "SAAS"
            ]
          },
          "business_model": {
            "type": "string",
            "description": "Business model key (e.g. B2B_SAAS, MARKETPLACE); unknown keys are rejected",
            "example": "B2B_SAAS"
          },
          "business_model_other": {
            "type": "string",
            "description": "Free-text business model, only accepted when business_model is OTHER; rejected against any other key"
          },
          "target_audience": {
            "type": "string",
            "description": "Who the brand sells to. Context for Recommendations and GEO Writer (Brand Book)"
          },
          "brand_voice": {
            "type": "string",
            "description": "Tone of voice guidance for generated content (Brand Book)"
          },
          "goals": {
            "type": "string",
            "description": "What the brand wants to achieve. Context for GEO Writer and prompt suggestions"
          },
          "primary_products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Main products or services"
          },
          "matching_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "collections": {
            "type": "array",
            "maxItems": 50,
            "description": "Collections (prompt tags) created with the project, each tagging prompts of this request by their exact text, so no separate tagging calls are needed. A text that is not in prompts returns ERR_INVALID_PARAM. A team member also needs Tags: Create permission.",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100,
                  "example": "Comparisons"
                },
                "prompts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "top crm tools 2026"
                  ]
                }
              }
            }
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "domain"
              ],
              "properties": {
                "domain": {
                  "type": "string"
                },
                "brand_name": {
                  "type": "string"
                },
                "matching_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "owned_media": {
            "type": "object",
            "description": "Requires Growth plan or above",
            "properties": {
              "youtube_channel_url": {
                "type": "string"
              },
              "instagram_profile_url": {
                "type": "string"
              },
              "facebook_page_url": {
                "type": "string"
              },
              "tiktok_profile_url": {
                "type": "string"
              },
              "app_store_url": {
                "type": "string"
              },
              "google_play_url": {
                "type": "string"
              }
            }
          },
          "use_subdomain": {
            "type": "boolean",
            "default": false
          },
          "weekly_email_subscribed": {
            "type": "boolean",
            "default": false
          },
          "external_identifier": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$",
            "description": "Embed-enabled (Enterprise) accounts only; other accounts receive ERR_PLAN_REQUIRED. Idempotency key and embed-session join key, unique per account"
          },
          "execute_prompts_immediately": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ProjectCreateResponse": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "description": "The finalized draft; only present on POST /project_drafts/{id}/finalize"
          },
          "project": {
            "type": "object",
            "description": "Same shape as GET /dimensions/projects/{id}"
          },
          "prompts": {
            "type": "object",
            "properties": {
              "created": {
                "type": "integer"
              },
              "skipped": {
                "type": "integer"
              },
              "execution": {
                "type": "string",
                "enum": [
                  "immediate",
                  "deferred_to_next_scheduled_run"
                ]
              }
            }
          },
          "competitors": {
            "type": "object",
            "properties": {
              "created": {
                "type": "integer"
              },
              "processing": {
                "type": "boolean",
                "description": "Always false; competitors are ready when the project transaction commits.",
                "example": false
              }
            }
          },
          "collections": {
            "type": "array",
            "description": "Collections created from the request's collections field (empty when none were sent; absent on an idempotent replay)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "prompts_attached": {
                  "type": "integer"
                }
              }
            }
          },
          "same_domain_projects": {
            "type": "array",
            "description": "Projects the caller can already see on the same domain (absent on an idempotent replay). Informational only: the create is never blocked, since one domain tracked per market is a normal setup.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "country_code": {
                  "type": "string"
                },
                "language_code": {
                  "type": "string"
                }
              }
            }
          },
          "email_subscription": {
            "type": "object",
            "properties": {
              "weekly_email_subscribed": {
                "type": "boolean"
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "projects_remaining": {
                "type": "integer",
                "nullable": true
              },
              "prompts_available": {
                "type": "integer",
                "nullable": true
              },
              "competitors_remaining": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "idempotent": {
            "type": "boolean",
            "description": "Present and true only on external_identifier replays"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "PromptsCreateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "prompts",
          "country_code",
          "language_code"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "country_code": {
            "type": "string"
          },
          "language_code": {
            "type": "string"
          }
        }
      },
      "PromptsCreateResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "created": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "total_after": {
            "type": "integer"
          },
          "prompts_available": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "raw_input": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "created",
                    "exists"
                  ]
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "StoreConnectionResponse": {
        "type": "object",
        "required": [
          "platform",
          "domain",
          "project",
          "ambiguous",
          "candidates",
          "account",
          "request_id"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "description": "The store platform, e.g. shopify"
          },
          "domain": {
            "type": "string",
            "description": "The store domain as compared: lowercase, without scheme, www or path"
          },
          "project": {
            "type": "object",
            "nullable": true,
            "description": "The live project the store maps to: its domain equals the store's, or is a parent or subdomain of it. Null when no project matches",
            "required": [
              "id",
              "name",
              "domain"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "country_code": {
                "type": "string",
                "nullable": true
              },
              "language_code": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "ambiguous": {
            "type": "boolean",
            "description": "True when several live projects match the store domain (for example one project per market). project is then null and the app asks the key holder to pick from candidates."
          },
          "candidates": {
            "type": "array",
            "description": "Every live project of the account, for a project picker",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "domain"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "domain": {
                  "type": "string",
                  "description": "Empty when the project has no website URL"
                }
              }
            }
          },
          "account": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "nullable": true,
                "description": "Internal plan key of the account, e.g. scale or scaleplus; null for a key limited to some projects"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "AiOrdersResponse": {
        "type": "object",
        "required": [
          "project_id",
          "platform",
          "currency",
          "from",
          "to",
          "totals",
          "by_source",
          "series",
          "request_id"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "platform": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "ISO 4217 code of the most recent stored day; null when the window holds no stored order"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "totals": {
            "type": "object",
            "required": [
              "orders",
              "revenue"
            ],
            "properties": {
              "orders": {
                "type": "integer"
              },
              "revenue": {
                "type": "string",
                "description": "Decimal amount with two decimals, e.g. 1834.20"
              }
            }
          },
          "by_source": {
            "type": "array",
            "description": "One row per AI assistant, highest revenue first",
            "items": {
              "type": "object",
              "required": [
                "source",
                "name",
                "orders",
                "revenue"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "AI assistant slug, e.g. chatgpt or perplexity"
                },
                "name": {
                  "type": "string",
                  "description": "Display name, e.g. ChatGPT"
                },
                "orders": {
                  "type": "integer"
                },
                "revenue": {
                  "type": "string"
                }
              }
            }
          },
          "series": {
            "type": "array",
            "description": "Days that have stored orders, oldest first",
            "items": {
              "type": "object",
              "required": [
                "day",
                "orders",
                "revenue"
              ],
              "properties": {
                "day": {
                  "type": "string",
                  "format": "date"
                },
                "orders": {
                  "type": "integer"
                },
                "revenue": {
                  "type": "string"
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "AiOrdersUpdateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "platform",
          "currency",
          "from",
          "to",
          "days"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "platform": {
            "type": "string",
            "enum": [
              "shopify"
            ]
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code, e.g. EUR"
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "First day of the window this push replaces"
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Last day of the window; at most 400 days after from"
          },
          "days": {
            "type": "array",
            "maxItems": 400,
            "items": {
              "type": "object",
              "required": [
                "day",
                "referrer",
                "orders",
                "revenue"
              ],
              "properties": {
                "day": {
                  "type": "string",
                  "format": "date",
                  "description": "Must fall inside from..to"
                },
                "referrer": {
                  "type": "string",
                  "description": "Raw referring host or utm_source of the order's first visit, e.g. chatgpt.com. Entries that are not an AI assistant are ignored"
                },
                "orders": {
                  "type": "integer",
                  "minimum": 0
                },
                "revenue": {
                  "type": "string",
                  "description": "Non-negative decimal amount in currency, e.g. 120.50. A JSON number is accepted too"
                }
              }
            }
          }
        }
      },
      "AiOrdersUpdateResponse": {
        "type": "object",
        "required": [
          "project_id",
          "platform",
          "stored",
          "ignored",
          "request_id"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "platform": {
            "type": "string"
          },
          "stored": {
            "type": "integer",
            "description": "Rows stored, one per day and AI assistant"
          },
          "ignored": {
            "type": "integer",
            "description": "Entries whose referrer is not an AI assistant"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CatalogPromptSuggestion": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "status",
          "source",
          "country_code",
          "language_code",
          "product",
          "prompt_id",
          "accepted_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "pending, accepted or rejected"
          },
          "source": {
            "type": "string",
            "description": "Always catalog"
          },
          "country_code": {
            "type": "string",
            "nullable": true
          },
          "language_code": {
            "type": "string",
            "nullable": true
          },
          "product": {
            "type": "object",
            "description": "The catalog product the suggestion was written for",
            "properties": {
              "external_id": {
                "type": "string",
                "nullable": true,
                "description": "The store's product id, e.g. gid://shopify/Product/1"
              },
              "handle": {
                "type": "string",
                "nullable": true
              },
              "title": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "prompt_id": {
            "type": "integer",
            "nullable": true,
            "description": "The tracked prompt an accepted suggestion became; null until accepted"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the suggestion was accepted; null until then"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CatalogPromptSuggestionsResponse": {
        "type": "object",
        "required": [
          "project_id",
          "page",
          "per_page",
          "total",
          "data",
          "request_id"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogPromptSuggestion"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CatalogProduct": {
        "type": "object",
        "required": [
          "external_id",
          "title"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "description": "The store's product id, e.g. gid://shopify/Product/1"
          },
          "title": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "product_type": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "collections": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          }
        }
      },
      "CatalogPromptSuggestionsCreateRequest": {
        "type": "object",
        "required": [
          "project_id",
          "platform",
          "products"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "platform": {
            "type": "string",
            "enum": [
              "shopify"
            ]
          },
          "country_code": {
            "type": "string",
            "description": "Defaults to the project country"
          },
          "language_code": {
            "type": "string",
            "description": "Defaults to the project language"
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/CatalogProduct"
            }
          }
        }
      },
      "CatalogPromptSuggestionsCreateResponse": {
        "type": "object",
        "required": [
          "project_id",
          "created",
          "skipped",
          "data",
          "request_id"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "created": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer",
            "description": "Generated prompts not saved because the project already holds them as a suggestion (from any source or product, in any status)."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogPromptSuggestion"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CatalogPromptSuggestionIdsRequest": {
        "type": "object",
        "required": [
          "project_id",
          "ids"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "CatalogPromptSuggestionsAcceptResponse": {
        "type": "object",
        "required": [
          "project_id",
          "accepted",
          "skipped",
          "prompts_available",
          "request_id"
        ],
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "suggestion_id",
                "prompt_id",
                "collection_id"
              ],
              "properties": {
                "suggestion_id": {
                  "type": "integer"
                },
                "prompt_id": {
                  "type": "integer"
                },
                "collection_id": {
                  "type": "integer",
                  "nullable": true,
                  "description": "The collection named after the product; null when the product has no title or the team member cannot create tags"
                }
              }
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "suggestion_id",
                "reason"
              ],
              "properties": {
                "suggestion_id": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "description": "accepted or rejected (the suggestion was no longer pending), or pending_deletion"
                }
              }
            }
          },
          "prompts_available": {
            "type": "integer",
            "nullable": true,
            "description": "Prompt slots left on the plan; null when unlimited"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CatalogPromptSuggestionsRejectResponse": {
        "type": "object",
        "required": [
