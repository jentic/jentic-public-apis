          "citations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "competitor_mentions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "competitor_citations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sentiments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sources": {
            "type": "array",
