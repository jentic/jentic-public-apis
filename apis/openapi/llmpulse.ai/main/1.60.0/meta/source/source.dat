      "post": {
        "tags": [
          "Technical GEO Reports"
        ],
        "summary": "Run technical GEO analysis",
        "x-llms-description": "Run the full nine-report technical GEO analysis bundle for a URL + country. The bundle starts only when nine daily units remain; each successfully created report uses one unit, and reports that are not created use none. Optional output_language_code (ISO 639-1, or auto to keep the language of the website) sets the language of the llms.txt files.",
        "operationId": "createTechnicalGeoReports",
        "x-mcp-tool": "create_technical_geo_report",
        "x-write": true,
        "description": "Launches the full nine-report technical GEO analysis bundle for a URL + country. The bundle starts only when at least nine daily units remain. Each successfully created report uses one unit; a report that is not created uses none. Daily allocations vary by account. Each report runs in a background job. Requires a `read_write` scope API key.",
        "requestBody": {
          "required": true,
