          "breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "impressions": {
                  "type": "integer"
                },
                "clicks": {
                  "type": "integer"
                },
                "ctr": {
                  "type": "number",
                  "description": "0..1 fraction"
                },
                "position": {
                  "type": "number",
                  "description": "Impression-weighted average position"
                }
              }
            },
            "description": "Present when a breakdown was requested, sorted by impressions descending"
          },
          "breakdown_truncated": {
            "type": "boolean",
            "description": "Present (true) when limit or Google's 25,000-row maximum left breakdown rows out, so they add up to less than totals"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
