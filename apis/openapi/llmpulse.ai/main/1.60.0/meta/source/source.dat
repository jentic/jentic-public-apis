    "/dimensions/reddit": {
      "get": {
        "tags": [
          "Owned Media & Communities"
        ],
        "summary": "List cited Reddit content",
        "x-llms-description": "Reddit content cited by AI answers, per subreddit (view=subreddits), per author (view=authors) or per thread (view=threads), with sentiment split and engagement (Growth+).",
        "operationId": "listRedditCitations",
        "x-mcp-tool": "list_reddit_citations",
        "x-plan": "growth",
        "description": "Which Reddit content AI answers cite for your tracked prompts. view=subreddits (default) returns one row per subreddit with its citation count, unique authors and positive/negative sentiment split; view=authors returns one row per author; view=threads returns the individual cited threads with upvotes, comments, average position and dominant sentiment. Requires the Growth plan or above.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "subreddits",
                "authors",
                "threads"
              ],
              "default": "subreddits"
            }
          },
          {
            "name": "subreddit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter to one subreddit (name without the r/ prefix)"
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter to one Reddit author"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "archived"
              ]
            },
            "description": "view=threads only"
          },
          {
            "name": "owned",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Return only subreddits/authors the account has claimed as its own"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter to citations whose scraped Reddit content mentions a brand: 'brand' for the tracked brand, or a competitor id. Reads the page content, not the AI answer."
          },
          {
            "name": "order",
