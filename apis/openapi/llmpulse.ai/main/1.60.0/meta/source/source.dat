      "IntelligenceTaskSummary": {
        "type": "object",
        "required": [
          "id",
          "public_id",
          "task_type",
          "title",
          "status",
          "prompt_id",
          "prompt_text",
          "word_count",
          "manually_edited_at",
          "created_at",
          "processed_at",
          "result_version"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "public_id": {
            "type": "string"
          },
          "task_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "prompt_id": {
            "type": "integer",
            "nullable": true
          },
          "prompt_text": {
            "type": "string",
            "nullable": true
          },
          "word_count": {
            "type": "integer",
            "nullable": true
          },
          "manually_edited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the content was last edited by hand; null while the output is as generated"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "result_version": {
            "type": "string",
            "description": "Concurrency token for content edits: send it back as result_version on PATCH /intelligence_tasks/{id} so an edit composed before a regeneration is refused with ERR_STALE_CONTENT (409). It is \"0\" until the task first completes, then changes each time a generation or regeneration replaces result_data, never on a manual edit or a revert. Treat it as opaque text",
            "example": "1775642580"
          }
        }
      },
      "IntelligenceTasksResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedEnvelope"
          },
