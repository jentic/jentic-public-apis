          },
          {
            "$ref": "#/components/parameters/Output"
          },
          {
            "$ref": "#/components/parameters/GscSearchType"
          },
          {
            "$ref": "#/components/parameters/GscFilters"
          },
          {
            "$ref": "#/components/parameters/GscDataState"
          },
          {
            "$ref": "#/components/parameters/GscAggregationType"
          }
        ],
        "responses": {
