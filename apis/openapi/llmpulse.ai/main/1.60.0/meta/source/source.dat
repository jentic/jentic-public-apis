    "/geo_audits": {
      "get": {
        "tags": [
          "GEO Audits"
        ],
        "summary": "List GEO audits",
        "x-llms-description": "List a project's GEO audits (one technical GEO check type on one domain or URL, run once or weekly/monthly) with their latest run score, open issues and next run.",
        "operationId": "listGeoAudits",
        "x-mcp-tool": "list_geo_audits",
        "description": "Lists the project's audits, most recently updated first. Archived audits are left out unless status=archived.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "audit_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "agent_readiness",
                "robots_txt",
                "crawlability",
                "schema",
                "content_readiness",
                "discoverability",
                "site_structure"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "paused",
                "archived"
              ]
            }
          },
          {
            "name": "cadence",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "once",
                "weekly",
                "monthly"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated audits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoAuditList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "GEO Audits"
        ],
        "summary": "Create GEO audits",
        "x-llms-description": "Create one GEO audit per audit type for a domain or URL, once or weekly/monthly; each starts its first run at once.",
        "operationId": "createGeoAudits",
        "x-mcp-tool": "create_geo_audit",
        "x-write": true,
        "description": "Creates one audit per entry of audit_types and starts the first run of each (it counts against the manual run limits: 6 per audit per hour, 200 per account per day). cadence weekly or monthly is accepted only for types whose checks are tracked run to run, and counts against the plan limit of active recurring audits (ERR_LIMIT_REACHED). Creating an audit that was archived restores it with its history. Requires a `read_write` scope API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeoAuditCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created audits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoAuditCreateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InsufficientScope"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
