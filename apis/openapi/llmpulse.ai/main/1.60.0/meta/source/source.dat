                }
              }
            }
          }
        ]
      },
      "PromptExecutionRecord": {
        "type": "object",
        "required": [
          "id",
          "prompt_id",
          "executed_at",
          "duration_ms",
          "success",
          "model",
          "fan_out_queries",
          "has_mention",
          "has_citation",
          "mentions_count",
          "citations_count",
          "app_url"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "prompt_id": {
            "type": "integer"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Null while the answer is still pending"
          },
          "duration_ms": {
            "type": "number",
            "nullable": true
          },
          "success": {
            "type": "boolean",
            "nullable": true,
            "description": "Null while the answer is still pending"
          },
          "model": {
            "type": "string",
            "enum": [
              "chatgpt",
              "perplexity",
              "ai_mode",
              "ai_overview",
              "gemini",
              "copilot",
              "amazon_rufus",
              "claude",
              "grok",
              "deepseek",
              "naver_ai",
              "baidu_ai",
              "meta_ai"
            ]
          },
          "fan_out_queries": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            },
            "description": "Sub-queries the model issued while answering; null when the model reports none"
          },
          "has_mention": {
            "type": "boolean"
          },
          "has_citation": {
            "type": "boolean"
          },
          "mentions_count": {
            "type": "integer",
            "description": "1 when the answer mentions the brand, otherwise 0"
          },
          "citations_count": {
            "type": "integer",
            "description": "1 when the answer cites the brand, otherwise 0"
          },
          "app_url": {
            "type": "string",
            "format": "uri",
            "description": "Opens this answer in the app. The link names its project, so it opens there for any user with access to that project"
          }
        }
      },
      "PromptExecutionsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedEnvelope"
