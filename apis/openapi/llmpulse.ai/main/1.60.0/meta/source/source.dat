          },
          "series": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TimeseriesSeries"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "SummaryResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TimeseriesResponse"
          },
          {
            "type": "object",
            "properties": {
              "summary": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "actor": {
                        "$ref": "#/components/schemas/Actor"
                      },
                      "metric": {
                        "type": "string"
                      },
                      "total": {
                        "type": "number"
                      },
                      "aggregation": {
                        "type": "string",
                        "enum": [
                          "sum",
                          "average"
                        ],
                        "description": "How total combines the buckets"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "last": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "position_distribution": {
                "type": "object",
                "properties": {
                  "position_1_count": {
                    "type": "integer"
                  },
                  "position_2_count": {
                    "type": "integer"
                  },
                  "position_3_plus_count": {
                    "type": "integer"
                  },
                  "total_mentions": {
                    "type": "integer"
                  },
                  "percentages": {
                    "type": "object"
                  }
                }
              }
            }
          }
        ]
      },
      "PromptSummaryRow": {
        "type": "object",
        "properties": {
          "prompt_id": {
            "type": "integer"
          },
          "prompt_text": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Only present when breakdown=model"
          },
          "responses": {
            "type": "integer"
          },
          "mentions": {
            "type": "integer"
          },
          "citations": {
            "type": "integer"
          },
          "visibility": {
            "type": "number"
          },
          "mention_rate": {
            "type": "number"
          },
          "citation_rate": {
            "type": "number"
          },
          "avg_mention_position": {
            "type": "number",
            "nullable": true
          },
          "avg_position": {
            "type": "number",
            "nullable": true
          },
          "app_url": {
            "type": "string",
            "format": "uri",
            "description": "Opens this prompt in the app. The link names its project, so it opens there for any user with access to that project"
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "Country of the prompt, as in /dimensions/prompts"
          },
          "language_code": {
            "type": "string",
            "nullable": true,
            "description": "Language of the prompt, as in /dimensions/prompts"
          },
          "prompt_type": {
            "type": "string",
            "nullable": true,
            "description": "Search intent: informational, navigational, commercial or transactional. Null until the prompt is classified"
          },
          "brand_kind": {
            "type": "string",
            "nullable": true,
            "description": "Brand focus: brand, brand_other or non_brand. Null until the prompt is classified"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagRef"
            },
            "description": "Every tag the prompt belongs to"
          },
          "sentiment_responses": {
            "type": "integer",
            "description": "Responses in the window with a sentiment verdict for the brand, the base of the sentiment percentages (deduplicated like the sentiment timeseries)"
          },
          "sentiment_very_positive": {
            "type": "number",
            "nullable": true,
            "description": "Percentage (0-100) of sentiment_responses whose brand verdict is very positive; null when sentiment_responses is 0"
          },
          "sentiment_positive": {
            "type": "number",
            "nullable": true,
            "description": "Percentage (0-100) of sentiment_responses whose brand verdict is positive; null when sentiment_responses is 0"
          },
          "sentiment_neutral": {
            "type": "number",
            "nullable": true,
            "description": "Percentage (0-100) of sentiment_responses whose brand verdict is neutral; null when sentiment_responses is 0"
          },
          "sentiment_negative": {
            "type": "number",
            "nullable": true,
            "description": "Percentage (0-100) of sentiment_responses whose brand verdict is negative; null when sentiment_responses is 0"
          },
          "sentiment_very_negative": {
            "type": "number",
            "nullable": true,
            "description": "Percentage (0-100) of sentiment_responses whose brand verdict is very negative; null when sentiment_responses is 0"
          },
          "net_sentiment": {
            "type": "number",
            "nullable": true,
            "description": "Positive minus negative percentages (-100 to 100), neutral counted in the base; null when sentiment_responses is 0"
          }
        }
      },
      "PromptSummaryResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "filters": {
            "$ref": "#/components/schemas/MetricsFiltersEcho"
          },
          "breakdown": {
            "type": "string",
            "nullable": true
          },
          "sort": {
            "type": "string"
          },
          "sort_dir": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptSummaryRow"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "SovResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "granularity": {
            "type": "string",
            "description": "day, week or month"
          },
          "filters": {
            "$ref": "#/components/schemas/MetricsFiltersEcho"
          },
          "periods": {
            "type": "array",
            "description": "Per-bucket sample size and completeness: mentions is the total the shares were computed on (1-3 mentions produce the 100/50/33.33 low-sample patterns); partial marks buckets still collecting data or clipped by the requested window; confidence and margin_of_error read the sample size.",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "mentions": {
                  "type": "integer"
                },
                "partial": {
                  "type": "boolean"
                },
                "confidence": {
                  "type": "string",
                  "description": "How far the shares of this period can be trusted, from its mentions: none (0), low (under 30), medium (under 100) or high (100 or more).",
                  "example": "low"
                },
                "margin_of_error": {
                  "type": "number",
                  "nullable": true,
                  "description": "Worst-case 95% margin of a share in percentage points, 98 / sqrt(mentions); mentions within one answer are not independent, so the real margin is at least this wide. null with no mentions.",
                  "example": 21.9
                }
              }
            }
          },
          "sample": {
            "type": "object",
            "nullable": true,
            "description": "The period the current shares were computed on (the last one with mentions), same shape as a periods item; null when the window has no mentions.",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "mentions": {
                "type": "integer"
              },
              "partial": {
                "type": "boolean"
              },
              "confidence": {
                "type": "string"
              },
              "margin_of_error": {
                "type": "number",
                "nullable": true
              }
            }
          },
          "over_time": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor": {
                  "$ref": "#/components/schemas/Actor"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TimeseriesPoint"
                  }
                }
              }
            }
          },
          "current": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor": {
                  "$ref": "#/components/schemas/Actor"
                },
                "share": {
                  "type": "number"
                },
                "previous_share": {
                  "type": "number",
                  "nullable": true,
                  "description": "The actor's share in the last complete bucket before the current one; null without complete history."
                },
                "avg_share": {
                  "type": "number",
                  "nullable": true,
                  "description": "Mean share across complete buckets with data (partial buckets excluded); null without complete history."
                }
              }
            }
          },
          "breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer"
                },
                "actor": {
                  "$ref": "#/components/schemas/Actor"
                },
                "share": {
                  "type": "number"
                },
                "others": {
                  "type": "boolean"
                }
              }
            }
          },
          "others": {
            "type": "array",
            "description": "Actors ranked fifth and below, folded into the Others share of breakdown",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer"
                },
                "actor": {
                  "$ref": "#/components/schemas/Actor"
                },
                "share": {
                  "type": "number"
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "TopSourcesResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "filters": {
            "$ref": "#/components/schemas/MetricsFiltersEcho"
          },
          "sort": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "total_responses": {
                  "type": "integer"
                },
                "avg_visibility": {
                  "type": "number"
                },
                "avg_mention_rate": {
                  "type": "number"
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "MetricsFiltersEcho": {
        "type": "object",
        "description": "The filters the response was computed with, as the server resolved them. Each endpoint echoes only the keys it reads; a filter that was not given comes back null (or an empty list).",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Requested metrics after alias resolution (mention_rate is echoed as visibility)"
          },
          "granularity": {
            "type": "string",
            "description": "day, week or month"
          },
          "model": {
            "type": "string",
            "nullable": true,
            "description": "The model filter, or null when absent or not enabled for the account"
          },
          "collection_id": {
            "type": "string",
            "nullable": true,
            "description": "The collection_id parameter as sent (one id or a comma-separated list)"
          },
          "collection_ids": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "integer"
            }
          },
          "domains": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "description": "Comma-separated country codes"
          },
          "language_code": {
            "type": "string",
            "nullable": true,
            "description": "Comma-separated language codes"
          },
          "prompt": {
            "type": "integer",
            "nullable": true,
            "description": "The prompt id filter"
          },
          "prompt_type": {
            "type": "string",
            "nullable": true,
            "description": "Comma-separated prompt types"
          },
          "brand_kind": {
            "type": "string",
            "nullable": true
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Competitor ids from the competitors parameter; empty when it was not given"
          },
          "include_project": {
            "type": "boolean"
          },
          "query": {
            "type": "string",
            "description": "Only present when a query filter was given"
          }
        }
      },
      "WebAnalyticsSchemaResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "provider": {
            "type": "string",
            "enum": [
              "google_analytics",
              "adobe_analytics",
              "matomo",
              "posthog",
              "plausible",
              "piano"
            ],
            "description": "The connected web analytics provider."
          },
          "property": {
            "type": "string",
            "description": "The property, site, report suite (rsid:...), data view (dataview:...) or project every query runs on."
          },
          "query_language": {
            "type": "string",
            "description": "The native query format the provider accepts."
          },
          "docs_url": {
            "type": "string",
            "description": "The provider's reference for that format."
          },
          "allowed_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Top-level query fields that are forwarded."
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What the bridge enforces and the provider's main constraints."
          },
          "example": {
            "type": "object",
            "additionalProperties": true,
            "description": "A worked query to adapt."
          },
          "fields": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "The provider's live field list where it offers one: GA4 dimensions and metrics with custom definitions, Adobe ids, Matomo report methods, PostHog event names, the Plausible catalog. Null when the provider did not return it."
          },
          "fields_unavailable": {
            "type": "string",
            "description": "Present when the field list could not be read; the format and example still apply."
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "WebAnalyticsQueryResponse": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "provider": {
            "type": "string",
            "enum": [
              "google_analytics",
              "adobe_analytics",
              "matomo",
              "posthog",
              "plausible",
              "piano"
            ]
          },
          "property": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "description": "dimension or metric, when the provider says."
                },
                "type": {
                  "type": "string",
                  "description": "The provider's column type, when it says (PostHog)."
                },
                "label": {
                  "type": "string",
                  "description": "The provider's display label, when it sends one (Piano)."
                }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            },
            "description": "One array per row, values in column order: strings, numbers or null."
          },
          "row_count": {
            "type": "integer",
            "description": "Rows in this response (at most 5,000)."
          },
          "total_rows": {
            "type": "integer",
            "description": "Rows the provider has for the query, when it reports it."
          },
          "truncated": {
            "type": "boolean",
            "description": "True when the provider has more rows than returned; page with its own offset or page field."
          },
          "totals": {
            "type": "object",
            "additionalProperties": true,
            "description": "Metric totals by metric name, when the query asked for them."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Provider caveats: sampling, thresholds, more rows available."
          },
          "meta": {
            "type": "object",
            "additionalProperties": true,
            "description": "Provider metadata such as GA4 time zone, currency and remaining property quota."
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the provider answered."
          },
          "cached": {
            "type": "boolean",
            "description": "True when the answer came from the 10-minute cache instead of the provider."
          },
          "query": {
            "type": "object",
            "additionalProperties": true,
            "description": "The request as sent to the provider, with the connected property forced and limits applied."
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "AgentTrafficResponse": {
