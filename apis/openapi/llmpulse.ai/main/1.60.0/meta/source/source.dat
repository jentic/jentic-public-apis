            "format": "date",
            "nullable": true,
            "description": "Latest date Google has published for the property (it lags 2-3 days). Later days are missing, not zero."
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "Rows in this window (one Google request, at most 25,000)"
          },
          "sort": {
            "type": "string"
          },
          "start_row": {
            "type": "integer",
            "description": "Present when start_row was set"
          },
          "truncated": {
            "type": "boolean",
            "description": "Present (true) when Google returned 25,000 rows, so more rows exist past this window"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "country": {
                  "type": "string"
                },
                "device": {
                  "type": "string"
                },
                "page": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "searchAppearance": {
                  "type": "string"
                },
                "impressions": {
                  "type": "integer"
                },
                "clicks": {
                  "type": "integer"
                },
                "ctr": {
                  "type": "number",
                  "description": "0..1 fraction"
                },
                "position": {
                  "type": "number",
                  "description": "Impression-weighted average position"
                }
              }
            },
            "description": "One row per combination; only the requested dimensions are present"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "TeamPermissions": {
        "type": "object",
        "description": "What the person can do, feature key to the verbs granted (read, create, update, delete), resolved from their role. Null for the account owner, who can do everything.",
        "nullable": true,
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "TeamAccountRole": {
        "type": "object",
        "description": "The account role the person follows, when permission_role is account_role; null otherwise.",
        "nullable": true,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TeamMember": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "status",
          "permission_role",
          "account_role",
          "permissions",
          "account_admin",
          "billing_access",
          "all_projects",
          "project_ids"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "description": "The account owner is listed first; everyone else who joined is a member."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked"
            ],
            "description": "A blocked member cannot sign in or use the API until unblocked in the app."
          },
          "permission_role": {
            "type": "string",
            "nullable": true,
            "description": "Access level of a member: full_access, view_only, custom or account_role. Null for the owner."
          },
          "account_role": {
            "$ref": "#/components/schemas/TeamAccountRole"
          },
          "permissions": {
            "$ref": "#/components/schemas/TeamPermissions"
          },
          "account_admin": {
            "type": "boolean",
            "description": "A co-owner, who can manage the team."
          },
          "billing_access": {
            "type": "boolean",
            "description": "Can open Billing and Plans (always true for the owner)."
          },
          "all_projects": {
            "type": "boolean",
            "description": "Has access to every project of the account, including future ones."
          },
          "project_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The projects a member is limited to; empty when all_projects is true."
          },
          "last_sign_in_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "joined_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the member accepted the invitation; null for the owner and for members added without one."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TeamInvitation": {
        "type": "object",
        "required": [
          "id",
          "email",
          "permission_role",
          "account_role",
          "permissions",
          "account_admin",
          "billing_access",
          "all_projects",
          "project_ids"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Kept by the member once they accept, when they move to GET /team_members."
          },
          "email": {
            "type": "string"
          },
          "permission_role": {
            "type": "string",
            "enum": [
              "full_access",
              "view_only",
              "custom",
              "account_role"
            ]
          },
          "account_role": {
            "$ref": "#/components/schemas/TeamAccountRole"
          },
          "permissions": {
            "$ref": "#/components/schemas/TeamPermissions"
          },
          "account_admin": {
            "type": "boolean"
          },
          "billing_access": {
            "type": "boolean"
          },
          "all_projects": {
            "type": "boolean"
          },
          "project_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "invited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the invitation email was last sent."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the invitation link stops working."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
