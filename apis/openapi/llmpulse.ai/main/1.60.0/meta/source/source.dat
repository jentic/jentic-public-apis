  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key authentication. Keys are managed at https://llmpulse.ai/app/api_keys (Scale plan or above). Used for the REST API and as a headless option for /mcp. A key can be limited to one or several projects when it is created; the set cannot be changed later."
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 with PKCE-S256 and Dynamic Client Registration. Accepted on /mcp only, available on every plan and during eligible trials. Discovery metadata at /.well-known/oauth-authorization-server.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.llmpulse.ai/oauth/authorize",
            "tokenUrl": "https://api.llmpulse.ai/oauth/token",
            "scopes": {
              "mcp:read": "Read data via MCP tools",
              "mcp:write": "Create resources via MCP write tools"
            }
          }
        }
      }
    },
    "parameters": {
      "Output": {
        "name": "output",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "flat",
            "csv"
          ]
        },
        "description": "Rectangular output for BI tools (Tableau, Excel, Sheets, ELT). Omit for the default nested JSON. 'flat' returns the same metadata plus 'columns' and 'rows'; 'csv' returns those rows as text/csv. Errors are always returned as JSON."
      },
      "SovView": {
        "name": "view",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "over_time",
            "current",
            "breakdown"
          ],
          "default": "over_time"
        },
        "description": "Which Share of Voice projection to flatten. Only valid together with 'output'. 'over_time' (default) is one row per date and actor, 'current' the ranked snapshot, 'breakdown' the Top 4 plus Others."
      },
      "ProjectId": {
        "name": "project_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Project ID"
      },
      "Competitors": {
        "name": "competitors",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated competitor IDs (unknown IDs return ERR_INVALID_PARAM)"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 20,
          "maximum": 100,
          "minimum": 1
        }
      },
      "Metrics": {
        "name": "metrics",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated list of metrics: mentions, citations, responses, mention_rate, visibility (alias for mention_rate), weighted_visibility, ai_visibility_score (alias for weighted_visibility), citation_rate, avg_position, avg_mention_position, net_sentiment, sentiment_very_positive, sentiment_positive, sentiment_neutral, sentiment_negative, sentiment_very_negative. Citations and citation_rate include visible citations and background source references; avg_position uses visible citations only."
      },
      "Granularity": {
        "name": "granularity",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        }
      },
      "GscSearchType": {
        "name": "search_type",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "web",
            "image",
            "video",
            "news",
            "discover",
            "googleNews"
          ],
          "default": "web"
        },
        "description": "Which search surface to measure. Defaults to web. discover and googleNews carry no query dimension, so Google rejects /search_console/queries for them."
      },
      "GscFilters": {
        "name": "filters",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "example": "[{\"dimension\":\"page\",\"operator\":\"contains\",\"expression\":\"/blog/\"}]",
        "description": "Narrow the query; every entry must match (AND). Send the whole list as one JSON value: filters=[{\"dimension\":\"page\",\"operator\":\"contains\",\"expression\":\"/blog/\"}] (URL-encoded). An array of objects has no query-parameter form a generated client can produce, so the string is what the official SDKs send; see the SearchConsoleFilters schema for the shape it encodes. includingRegex and excludingRegex take RE2 syntax. At most 10 entries, expression at most 500 characters. The bracket form filters[][dimension]=page&filters[][operator]=contains&filters[][expression]=/blog/ is also accepted."
      },
      "GscFrom": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago."
      },
      "GscTo": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "End date (YYYY-MM-DD), inclusive. Defaults to today. Google publishes data with a 2-3 day lag, so data_through in the response says how far it reaches."
      },
      "GscRange": {
        "name": "range",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 487
        },
        "description": "Number of days to look back, today included (alternative to from/to). At most 487, Google's retention."
      },
      "GscAggregationType": {
        "name": "aggregation_type",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "auto",
            "byPage",
            "byProperty"
          ],
          "default": "auto"
        },
        "description": "How Google counts impressions. auto (default) is what Search Console shows (by page when page is grouped or filtered, else by property). Google rejects byProperty with a page dimension or filter."
      },
      "GscStartRow": {
        "name": "start_row",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "description": "Google ranks rows by clicks and returns at most 25,000 per request. start_row moves that window down the ranking (e.g. 25000 for the next block); sort and pagination apply within the window."
      },
      "GscDataState": {
        "name": "data_state",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "final",
            "all"
          ],
          "default": "final"
        },
        "description": "final (default) counts only rows Google has finalized. all also counts the most recent days, which are still being filled in and will change."
      },
      "Range": {
        "name": "range",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "description": "Number of days to look back (alternative to from/to)"
      },
      "From": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "To": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "End of the window. A date-only value such as 2026-09-01 covers that whole day. Pass a full timestamp to end the window earlier."
      },
      "Model": {
        "name": "model",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "chatgpt",
            "perplexity",
            "ai_mode",
            "ai_overview",
            "gemini",
            "copilot",
            "amazon_rufus",
            "claude",
            "grok",
            "deepseek",
            "naver_ai",
            "baidu_ai",
            "meta_ai"
          ]
        },
        "description": "Filter by one AI model. It must be a model enabled for the API key's user: an unknown value, or a model the user has not enabled, returns 422 ERR_INVALID_PARAM with the valid values in the message."
      },
      "MetricsModel": {
        "name": "model",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "chatgpt",
            "perplexity",
            "ai_mode",
            "ai_overview",
            "gemini",
            "copilot",
            "amazon_rufus",
            "claude",
            "grok",
            "deepseek",
            "naver_ai",
            "baidu_ai",
            "meta_ai"
          ]
        },
        "description": "Filter by one AI model. It must be a model enabled for the API key's user: an unknown value, or a model the user has not enabled, returns 422 ERR_INVALID_PARAM with the valid values in the message. The legacy values google-ai-mode and google-ai-overview are also accepted, as ai_mode and ai_overview."
      },
      "CitationModel": {
        "name": "model",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "chatgpt",
            "perplexity",
            "ai_mode",
            "ai_overview",
            "gemini",
            "copilot",
            "amazon_rufus",
            "claude",
            "grok",
            "deepseek",
            "naver_ai",
            "baidu_ai",
            "meta_ai"
          ]
        },
        "description": "Filter by one AI model. Only chatgpt, ai_overview, ai_mode, perplexity, gemini, naver_ai and baidu_ai are accepted: any other value, including another model enabled for the API key's user, returns 422 ERR_INVALID_PARAM (invalid model). One of those seven that the user has not enabled also returns 422 ERR_INVALID_PARAM, with the valid values in the message."
      },
      "CollectionId": {
        "name": "collection_id",
        "in": "query",
        "schema": {
          "type": "string",
          "pattern": "^\\d+(,\\d+)*$"
        },
        "example": "12,34",
        "description": "One collection/tag ID or a comma-separated list of IDs. A query value is always a string on the wire, so it is typed as one: the previous integer-or-string union made generators emit a wrapper type they could not serialize."
      },
      "CountryCode": {
        "name": "country_code",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "One ISO country code or a comma-separated list (e.g. US,GB,DE)"
      },
      "LanguageCode": {
        "name": "language_code",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "One ISO language code or a comma-separated list (e.g. en,es,de)"
      },
      "Prompt": {
        "name": "prompt",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "description": "Filter by prompt ID"
      },
      "PromptType": {
        "name": "prompt_type",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "One prompt type or a comma-separated list: informational, navigational, commercial, transactional"
      },
      "BrandKind": {
        "name": "brand_kind",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "brand",
            "brand_other",
            "non_brand"
          ]
        },
        "description": "Filter by brand kind: brand (own brand/products), brand_other (competitors/other brands), non_brand (generic, no brand named). For fair 1:1 brand-vs-competitor comparisons (visibility, share of voice), use non_brand: brand-focused prompts skew results toward the brand they name. The in-app Overview page applies non_brand by default."
      },
      "MentionFilter": {
        "name": "mention_filter",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "mentions_you",
            "not_mentions_you",
            "mentions_competitor",
            "not_mentions_competitor",
            "you_and_competitor",
            "competitor_not_you",
            "you_not_competitor",
            "no_brands"
          ]
        },
        "description": "Filter by which brands are mentioned, as a two-axis matrix (your brand x competitors): mentions_you / not_mentions_you, mentions_competitor / not_mentions_competitor, and the four combined cells you_and_competitor, competitor_not_you (a rival wins and you are absent), you_not_competitor, no_brands (no tracked brand appears, i.e. open space). Combine with 'competitors' to narrow the competitor side to specific rivals; on a negative cell that reads 'none of these'. On /dimensions/sources it applies to the crawled content of each cited page instead of the answer text. The legacy value 'competitors_only' is still accepted as an alias of competitor_not_you."
      },
      "CitationFilter": {
        "name": "citation_filter",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "cites_you",
            "not_cites_you",
            "cites_competitor",
            "not_cites_competitor",
            "you_and_competitor",
            "competitor_not_you",
            "you_not_competitor",
            "cites_no_brands"
          ]
        },
        "description": "Same two-axis matrix applied to the domains cited in the answer instead of the brands named in it. Independent of mention_filter; pass both to intersect them (e.g. mentions_you + not_cites_you finds answers that talk about you without linking to you)."
      },
      "IncludeProject": {
        "name": "include_project",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": true
        }
      },
      "UrlSha256": {
        "name": "url_sha256",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": "64-character hex SHA-256 of the cited URL"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_MISSING_AUTH",
                "message": "missing_authorization"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_PROJECT_NOT_FOUND",
                "message": "project_not_found"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Access forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_REVOKED_API_KEY",
                "message": "revoked_api_key"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "PlanRequired": {
        "description": "Endpoint requires a higher plan tier",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_PLAN_REQUIRED",
                "message": "Scale plan or above required"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "GrowthPlanRequired": {
        "description": "Endpoint requires the Growth plan or above",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_PLAN_REQUIRED",
                "message": "Growth plan or above required"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "SearchConsoleForbidden": {
        "description": "Plan below Growth (ERR_PLAN_REQUIRED), or Google revoked the project's Search Console access (ERR_SEARCH_CONSOLE_ACCESS_REVOKED): reconnect the property",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_SEARCH_CONSOLE_ACCESS_REVOKED",
                "message": "Google Search Console access was revoked. Reconnect the property in Preferences > Project Settings > Data Connections."
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "InsufficientScope": {
        "description": "API key lacks write permission",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_INSUFFICIENT_SCOPE",
                "message": "insufficient_scope_write_required"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "KeyProjectScoped": {
        "description": "Writes with a read-only key answer ERR_INSUFFICIENT_SCOPE, and a key limited to some projects ERR_KEY_PROJECT_SCOPED, with the same status: this operation acts on the whole account",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_KEY_PROJECT_SCOPED",
                "message": "api_key_limited_to_projects"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "InsufficientPermission": {
        "description": "API key belongs to a team member whose permission matrix does not grant this feature",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_INSUFFICIENT_PERMISSION",
                "message": "insufficient_team_member_permission"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "TeamForbidden": {
        "description": "A key limited to some projects answers ERR_KEY_PROJECT_SCOPED, since the team belongs to the whole account. A team member without the Team Members permission, or asking for something only the owner or a co-owner can do, answers ERR_INSUFFICIENT_PERMISSION, and a write with a read-only key ERR_INSUFFICIENT_SCOPE, with the same status",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_INSUFFICIENT_PERMISSION",
                "message": "insufficient_team_member_permission"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "IntegrationUnavailable": {
        "description": "The account has a white-label portal or an embed, so store integrations are not available (ERR_INTEGRATION_UNAVAILABLE). Writes with a read-only key answer ERR_INSUFFICIENT_SCOPE, and a team member without the permission ERR_INSUFFICIENT_PERMISSION, with the same status",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_INTEGRATION_UNAVAILABLE",
                "message": "Store integrations are not available for white-label or embed accounts"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "GenerationFailed": {
        "description": "The AI generation failed; retry the request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_GENERATION_FAILED",
                "message": "suggestions could not be generated, try again"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Invalid parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_INVALID_PARAM",
                "message": "invalid metrics"
              },
              "request_id": "abc-123"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Upstream provider unavailable, retry after the number of seconds in the Retry-After header",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying: Google's own value when it sent one, otherwise 900 after a quota error and 60 after an outage",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ERR_SEARCH_CONSOLE_UPSTREAM",
                "message": "Google Search Console is temporarily unavailable. Retry in a few minutes."
              },
              "request_id": "abc-123"
            }
          }
        }
      }
    },
    "schemas": {
      "SearchConsoleFilters": {
        "type": "array",
        "maxItems": 10,
        "description": "The value of the filters query parameter, JSON-encoded into a single string.",
        "items": {
          "type": "object",
          "required": [
            "dimension",
            "expression"
          ],
          "properties": {
            "dimension": {
              "type": "string",
              "enum": [
                "country",
                "device",
                "page",
                "query",
                "searchAppearance"
              ]
            },
            "operator": {
              "type": "string",
              "enum": [
                "contains",
                "equals",
                "notContains",
                "notEquals",
                "includingRegex",
                "excludingRegex"
              ],
              "default": "contains"
            },
            "expression": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      },
      "AccountQuota": {
        "type": "object",
        "description": "A consumable quota. limit and remaining are null when unlimited is true. For a key limited to some projects, prompts and intelligence_tasks carry no limit (and intelligence_tasks no used): only the capacity left.",
        "properties": {
          "limit": {
            "type": "integer",
            "nullable": true
          },
          "used": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer",
            "nullable": true
          },
          "unlimited": {
            "type": "boolean"
          },
          "period": {
            "type": "string",
            "description": "Reset window for quotas that reset (e.g. month)"
          }
        }
      },
      "AccountCapacity": {
        "type": "object",
        "description": "A ceiling with no usage counter attached. limit is null when unlimited is true.",
        "properties": {
          "limit": {
            "type": "integer",
            "nullable": true
          },
          "unlimited": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "ERR_MISSING_AUTH",
                  "ERR_INVALID_API_KEY",
                  "ERR_REVOKED_API_KEY",
                  "ERR_INSUFFICIENT_SCOPE",
                  "ERR_INSUFFICIENT_PERMISSION",
                  "ERR_KEY_PROJECT_SCOPED",
                  "ERR_PLAN_REQUIRED",
                  "ERR_INTEGRATION_UNAVAILABLE",
                  "ERR_GENERATION_FAILED",
                  "ERR_ACCOUNT_INACTIVE",
                  "ERR_DRAFT_NOT_FOUND",
                  "ERR_DRAFT_STATE",
                  "ERR_PROJECT_NOT_FOUND",
                  "ERR_NOT_FOUND",
                  "ERR_SEARCH_CONSOLE_NOT_CONNECTED",
                  "ERR_SEARCH_CONSOLE_ACCESS_REVOKED",
                  "ERR_SEARCH_CONSOLE_UPSTREAM",
                  "ERR_AI_TRAFFIC_NOT_CONNECTED",
                  "ERR_WEB_ANALYTICS_NOT_CONNECTED",
                  "ERR_WEB_ANALYTICS_INVALID_QUERY",
                  "ERR_WEB_ANALYTICS_ACCESS_REVOKED",
                  "ERR_WEB_ANALYTICS_UPSTREAM",
                  "ERR_AGENT_TRAFFIC_NOT_CONNECTED",
                  "ERR_INVALID_PARAM",
                  "ERR_INVALID_RANGE",
                  "ERR_LIMIT_REACHED",
                  "ERR_QUOTA_EXCEEDED",
                  "ERR_STALE_CONTENT",
                  "ERR_RATE_LIMITED"
                ]
              },
              "message": {
                "type": "string"
              },
              "meta": {
                "type": "object"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "description": "Internal project label (sidebar, settings, admin)"
          },
          "brand_name": {
            "type": "string",
            "nullable": true,
            "description": "LLM-facing brand label (used in prompts and customer-facing charts). Null when not set, in which case prompts and charts use `name`."
          }
        }
      },
      "ProjectDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Project"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "nullable": true
              },
              "description": {
                "type": "string",
                "nullable": true
              },
              "matching_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "additional_owned_domains": {
                "$ref": "#/components/schemas/AdditionalOwnedDomains"
              },
              "industry": {
                "description": "Industry as stored: one key as a string (e.g. SAAS), or an array of key strings when the project was created with a list or the in-app multi-select. Deliberately untyped so generated clients decode either shape"
              },
              "business_model": {
                "type": "string",
                "nullable": true
              },
              "business_model_other": {
                "type": "string",
                "nullable": true,
                "description": "Set only when business_model is OTHER"
              },
              "primary_products": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "target_audience": {
                "type": "string",
                "nullable": true
              },
              "brand_voice": {
                "type": "string",
                "nullable": true
              },
              "goals": {
                "type": "string",
                "nullable": true
              },
              "country_code": {
                "type": "string"
              },
              "language_code": {
                "type": "string"
              },
              "paused": {
                "type": "boolean"
              },
              "google_play_id": {
                "type": "string",
                "nullable": true
              },
              "app_store_id": {
                "type": "string",
                "nullable": true
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "stats": {
                "type": "object",
                "properties": {
                  "prompts_count": {
                    "type": "integer"
                  },
                  "prompts_by_brand_kind": {
                    "type": "object",
                    "description": "Prompt counts per brand focus",
                    "properties": {
                      "brand": {
                        "type": "integer"
                      },
                      "brand_other": {
                        "type": "integer"
                      },
                      "non_brand": {
                        "type": "integer"
                      }
                    }
                  },
                  "competitors_count": {
                    "type": "integer"
                  },
                  "collections_count": {
                    "type": "integer"
                  }
                }
              },
              "data_coverage": {
                "type": "object",
                "description": "AI models, countries and languages the project has data for",
                "properties": {
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "chatgpt",
                        "perplexity",
                        "ai_mode",
                        "ai_overview",
                        "gemini",
                        "copilot",
                        "amazon_rufus",
                        "claude",
                        "grok",
                        "deepseek",
                        "naver_ai",
                        "baidu_ai",
                        "meta_ai"
                      ]
                    }
                  },
                  "countries": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "search_console": {
                "type": "object",
                "description": "Google Search Console connection of the project. connected means the Search Console endpoints can answer; reconnect_required means Google refused the stored access and the property must be reconnected in Preferences > Project Settings > Data Connections.",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "connected",
                      "reconnect_required",
                      "not_connected"
                    ]
                  },
                  "property": {
                    "type": "string",
                    "nullable": true,
                    "description": "The connected property (e.g. sc-domain:example.com), null when not connected"
                  }
                }
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "AdditionalOwnedDomains": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Other domains the brand owns (at most 10, each a website's own domain covering its subdomains), whose citations count as owned like the project website. Empty when none"
      },
      "ProjectProfile": {
        "type": "object",
        "description": "The project name and profile, as PATCH /projects/{id} and the update_project MCP tool return them",
        "required": [
          "id",
          "name",
          "matching_names",
          "additional_owned_domains"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
