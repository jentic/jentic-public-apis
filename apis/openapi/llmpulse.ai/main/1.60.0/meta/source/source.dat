    "/team_members": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "List team members",
        "x-llms-description": "The account team, owner first, with each member's access level, project access, status and last sign-in.",
        "operationId": "listTeamMembers",
        "x-mcp-tool": "list_team_members",
        "description": "Lists the account owner first, then every team member who joined, with their access level (permission_role, account role and the resulting permissions), co-owner and billing flags, project access, status (active or blocked) and last sign-in. Pending invitations are listed by GET /team_invitations; GET /account limits.team_members.used counts both. Available to the account owner, co-owners and team members with the Team Members permission. A key limited to some projects answers ERR_KEY_PROJECT_SCOPED: the team belongs to the whole account.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Default 20, max 100"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TeamMember"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/TeamForbidden"
          }
        }
      }
    },
    "/team_invitations": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "List pending team invitations",
        "x-llms-description": "Pending team invitations with the access they grant, when they were sent and when they expire.",
        "operationId": "listTeamInvitations",
        "x-mcp-tool": "list_team_invitations",
        "description": "Lists invitations that have not been accepted yet: the address, the access and projects the person will get, when the invitation was sent and when its link expires. An accepted invitation keeps its id and moves to GET /team_members. Same access rules as GET /team_members.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Default 20, max 100"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TeamInvitation"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/TeamForbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Team"
        ],
        "summary": "Invite a team member",
        "x-llms-description": "Invite someone to the team by email, choosing their projects and access; they receive the invitation email.",
        "operationId": "createTeamInvitation",
        "x-mcp-tool": "invite_team_member",
        "x-write": true,
        "description": "Invites someone to the account team with the same rules as the Team Members settings page, and sends them the invitation email (email_sent is false when the email provider refused it; the invitation still exists, so revoke it and invite again once the address is fixed). Send project_ids, or all_projects: true for every project (for a team member inviting, every project they can access). The account owner and co-owners choose the access with permission_role: full_access (default), view_only, custom (with permissions, feature key to verbs) or account_role (with account_role_id). A team member with permission to invite cannot choose access: leave those fields out and the invitation copies their own permissions. Only the account owner can set account_admin (co-owner) or billing_access. An address already registered on the platform, or with an invitation pending, is refused with ERR_INVALID_PARAM (revoke the pending one first). An account that cannot add more team members, or that reached its daily limit of invitations sent through the API and MCP (revoked ones count), answers ERR_LIMIT_REACHED; the message says which. Requires a `read_write` scope API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "project_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Projects the member can access. Send this or all_projects true."
                  },
                  "all_projects": {
                    "type": "boolean",
                    "description": "Access to every project, including future ones"
                  },
                  "permission_role": {
                    "type": "string",
                    "enum": [
                      "full_access",
                      "view_only",
                      "custom",
                      "account_role"
                    ],
                    "description": "Default full_access. Owner and co-owners only."
                  },
                  "account_role_id": {
                    "type": "integer",
                    "description": "One of the account's roles, with permission_role account_role"
                  },
                  "permissions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "description": "With permission_role custom: feature key to the verbs granted (read, create, update, delete), for example {\"overview\": [\"read\"], \"prompts\": [\"read\", \"create\"]}"
                  },
                  "account_admin": {
                    "type": "boolean",
                    "description": "Make the member a co-owner. Account owner only."
                  },
                  "billing_access": {
                    "type": "boolean",
                    "description": "Access to Billing and Plans. Account owner only."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. The invitation, as GET /team_invitations lists it, and whether the email went out.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TeamInvitation"
                    },
                    {
                      "type": "object",
                      "required": [
                        "email_sent"
                      ],
                      "properties": {
                        "email_sent": {
                          "type": "boolean",
                          "description": "False when the email provider refused the invitation email"
                        },
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/TeamForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/team_invitations/{id}": {
      "delete": {
        "tags": [
          "Team"
        ],
        "summary": "Revoke a pending team invitation",
        "x-llms-description": "Revoke a pending team invitation; its link stops working immediately.",
        "operationId": "revokeTeamInvitation",
        "x-mcp-tool": "revoke_team_invitation",
        "x-write": true,
        "description": "Revokes a pending invitation: its link stops working immediately. Account owner or co-owner only, and a co-owner cannot revoke an invitation that makes someone a co-owner. Members who already joined are removed with DELETE /team_members/{id}; an id that is not a pending invitation of the account answers ERR_NOT_FOUND. Requires a `read_write` scope API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The invitation id from GET /team_invitations"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "integer"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/TeamForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/team_members/{id}": {
      "delete": {
        "tags": [
          "Team"
        ],
        "summary": "Remove a team member",
        "x-llms-description": "Remove a team member; their sessions and API keys stop working at once and the account is deleted shortly after.",
        "operationId": "removeTeamMember",
        "x-mcp-tool": "remove_team_member",
        "x-write": true,
        "description": "Removes a member from the team, as the settings page does: their sessions and API keys stop working at once and their user account is deleted in the background shortly after. Account owner or co-owner only; a co-owner cannot remove the owner, another co-owner or themselves. The owner cannot be removed. Pending invitations are revoked with DELETE /team_invitations/{id}; an id that is not a member of the account answers ERR_NOT_FOUND. Requires a `read_write` scope API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The member id from GET /team_members"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "removed": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "integer"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/TeamForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/store_connection": {
      "get": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Match a store to a project",
        "x-llms-description": "Store app setup: whether the account may use a store integration and which project a store domain maps to, plus candidate projects. Not available to white-label or embed accounts.",
        "operationId": "getStoreConnection",
        "x-rest-only": "Called by the store app (Shopify) to read its own connection, not by agents.",
        "description": "Tells a store app whether the API key's account can use it and which project the store belongs to: the live project whose domain equals the store domain, else one whose domain is a parent or a subdomain of it, else null. candidates lists every live project of the account so the app can offer a picker. Takes no project_id. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "shopify"
              ]
            },
            "description": "Store platform"
          },
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Store domain, with or without scheme, e.g. acme-store.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Eligibility, the matching project and the candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreConnectionResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/ai_orders": {
      "get": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Read AI-referred store orders",
        "x-llms-description": "AI-referred store orders and revenue for a project: totals, per AI assistant and a daily series (default last 90 days).",
        "operationId": "listAiOrders",
        "x-mcp-tool": "get_ai_orders",
        "x-mcp-plan": "growth",
        "description": "Reads back the AI-referred orders a store app pushed for a project: totals, one row per AI assistant and a daily series of the days with orders. Revenue values are decimal strings in currency. Team members need read access to AI Traffic. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "shopify"
              ],
              "default": "shopify"
            },
            "description": "Store platform"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "First day (YYYY-MM-DD). Defaults to 89 days before to"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Last day (YYYY-MM-DD). Defaults to today; the window is at most 400 days"
          }
        ],
        "responses": {
          "200": {
            "description": "Totals, per-assistant rows and the daily series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiOrdersResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "put": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Replace AI-referred store orders for a window",
        "x-llms-description": "Replace the daily AI-referred orders and revenue a store app reports for a window; raw referrers are classified and non-AI ones ignored.",
        "operationId": "replaceAiOrders",
        "x-rest-only": "Called by the store app (Shopify) to push AI-referred orders; agents read them with get_ai_orders.",
        "x-write": true,
        "description": "Replaces the daily AI-referred orders and revenue of the from..to window. Send the raw referring host or utm_source of each order's first visit as referrer: LLM Pulse classifies it and ignores anything that is not an AI assistant. Entries for the same day and assistant are summed. Every stored row of that project and platform inside the window is replaced, so pushing the same window again converges instead of counting twice. Rows are kept per project and platform, not per store, so one store reports per project. Requires a `read_write` scope API key and, for team members, update access to AI Traffic. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiOrdersUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rows stored and entries ignored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiOrdersUpdateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/catalog_prompt_suggestions": {
      "get": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "List catalog prompt suggestions",
        "x-llms-description": "List buyer prompts suggested from a store catalog, filterable by status and product.",
        "operationId": "listCatalogPromptSuggestions",
        "x-rest-only": "Store app (Shopify) catalog flow, not exposed to agents.",
        "description": "Lists the buyer prompts suggested from a store catalog, oldest first, with their status and the product each one came from. Team members need read access to Prompts. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "description": "Only suggestions in this status"
          },
          {
            "name": "product_external_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only suggestions for this store product id"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPromptSuggestionsResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Suggest buyer prompts from catalog products",
        "x-llms-description": "Generate buyer prompt suggestions for up to 20 store catalog products (shares the hourly suggestion allowance).",
        "operationId": "createCatalogPromptSuggestions",
        "x-rest-only": "Store app (Shopify) catalog flow, not exposed to agents.",
        "x-write": true,
        "description": "Writes buyer prompts for up to 20 catalog products and saves them as pending suggestions in the project's Suggested prompts queue, with the product recorded on each. Generation draws on the hourly prompt-suggestion allowance the app also uses (ERR_QUOTA_EXCEEDED once it is used up); a failed generation returns ERR_GENERATION_FAILED (502) and can be retried. Requires a `read_write` scope API key and, for team members, create access to Prompts. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogPromptSuggestionsCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The suggestions saved for these products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPromptSuggestionsCreateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "502": {
            "$ref": "#/components/responses/GenerationFailed"
          }
        }
      }
    },
    "/catalog_prompt_suggestions/accept": {
      "post": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Accept catalog prompt suggestions",
        "x-llms-description": "Track pending catalog suggestions as prompts, each tagged with a collection named after its product.",
        "operationId": "acceptCatalogPromptSuggestions",
        "x-rest-only": "Store app (Shopify) catalog flow, not exposed to agents.",
        "x-write": true,
        "description": "Starts tracking pending suggestions: each one becomes a prompt, tagged with a collection named after its product. Suggestions that are no longer pending come back in skipped. All accepted suggestions must share one country and language. When the new prompts would exceed the plan, the call returns ERR_LIMIT_REACHED and accepts nothing. Requires a `read_write` scope API key and, for team members, create access to Prompts. Not available to accounts with a white-label portal or an embed (ERR_INTEGRATION_UNAVAILABLE).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogPromptSuggestionIdsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted and skipped suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPromptSuggestionsAcceptResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/catalog_prompt_suggestions/reject": {
      "post": {
        "tags": [
          "Store Integrations"
        ],
        "summary": "Reject catalog prompt suggestions",
        "x-llms-description": "Mark pending catalog suggestions as rejected.",
        "operationId": "rejectCatalogPromptSuggestions",
        "x-rest-only": "Store app (Shopify) catalog flow, not exposed to agents.",
        "x-write": true,
