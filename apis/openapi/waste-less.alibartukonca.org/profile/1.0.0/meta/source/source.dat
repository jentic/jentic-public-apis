{
  "openapi": "3.0.3",
  "info": {
    "title": "Profile",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/Profile/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server (Deployed)"
    }
  ],
  "paths": {
    "/api/users/{username}/profile": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "CuriousBartu"
        }
      ],
      "get": {
        "summary": "getProfileInfo",
        "description": "Returns the profile details for a specific user.",
        "operationId": "getProfileInfo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile information retrieved successfully.",
            "content": {
              "application/json": {
                "example": {
                  "username": "CuriousBartu",
                  "biography": "I am curious",
                  "photoUrl": "https://waste-less-photo-storage-2.sfo3.digitaloceanspaces.com/profile/6cebd281-8c7f-4d07-bb71-327f9fcdfd1a.png",
                  "followerCount": 35,
                  "followingCount": 3
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: CuriousBa"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "editProfile",
        "description": "Updates the biography of the user.",
        "operationId": "editProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "biography": {
                    "type": "string",
                    "example": "Software engineer who loves open source and coffee."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully.",
            "content": {
              "application/json": {
                "example": {
                  "username": "Alice",
                  "biography": "ASoftware engineer who loves open source and coffee.",
                  "photoUrl": "https://waste-less-photo-storage-2.sfo3.digitaloceanspaces.com/profile/77056efb-1113-4735-adaf-cccf9f5ca09b.png",
                  "followerCount": 2,
                  "followingCount": 4
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: Alisdfsdg"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{username}/profile/picture": {
      "post": {
        "summary": "uploadProfilePhoto",
        "description": "Uploads and changes the profile picture for the user.",
        "operationId": "uploadProfilePhoto",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CuriousBartu"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Photo uploaded successfully.",
            "content": {
              "application/json": {
                "example": {
                  "username": "CuriousBartu",
                  "biography": "I am curious",
                  "photoUrl": "https://waste-less-photo-storage-2.sfo3.digitaloceanspaces.com/profile/e1ca672e-41c5-4e33-b2d1-4d65418706e1.jpg",
                  "followerCount": 35,
                  "followingCount": 3
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: CuriousBar"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large (Nginx error).",
            "content": {
              "text/html": {
                "example": "<html><body><h1>413 Request Entity Too Large</h1></body></html>"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
