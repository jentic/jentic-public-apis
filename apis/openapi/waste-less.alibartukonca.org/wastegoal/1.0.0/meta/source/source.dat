{
  "openapi": "3.0.3",
  "info": {
    "title": "WasteGoal",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/Wastegoal/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server (Deployed)"
    }
  ],
  "paths": {
    "/api/users/{username}/waste-goals": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "CuriousBartu"
        }
      ],
      "get": {
        "summary": "getGoals",
        "description": "Returns a list of waste goals for the specified user.",
        "operationId": "getGoals",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "A list of waste goals.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "goalId": 73,
                    "wasteType": "ORGANIC",
                    "restrictionAmountGrams": 100000.0,
                    "duration": 7,
                    "progress": 68.0,
                    "createdAt": "2025-12-16T12:46:44.125163",
                    "creatorUsername": "CuriousBartu"
                  },
                  {
                    "goalId": 30,
                    "wasteType": "PLASTIC",
                    "restrictionAmountGrams": 4000.0,
                    "duration": 180,
                    "progress": 68.875
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "createWasteGoal",
        "description": "Creates a new waste goal (e.g., Plastic, Glass, Organic).",
        "operationId": "createWasteGoal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "duration": {
                    "type": "string",
                    "example": "1000"
                  },
                  "restrictionAmountGrams": {
                    "type": "string",
                    "example": "10000"
                  },
                  "type": {
                    "type": "string",
                    "example": "Plastic"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waste goal created.",
            "content": {
              "application/json": {
                "example": {
                  "username": "cengizbilalsari2",
                  "goalId": 78
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: sdfsdf"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/waste-goals/{goalId}": {
      "parameters": [
        {
          "name": "goalId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "78"
        }
      ],
      "put": {
        "summary": "editWasteGoal",
        "description": "Updates the duration, amount, or type of an existing waste goal.",
        "operationId": "editWasteGoal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "duration": {
                    "type": "string",
                    "example": "15"
                  },
                  "restrictionAmountGrams": {
                    "type": "string",
                    "example": "500"
                  },
                  "type": {
                    "type": "string",
                    "example": "Plastic"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waste goal updated.",
            "content": {
              "application/json": {
                "example": {
                  "username": "cengizbilalsari2",
                  "goalId": 78
                }
              }
            }
          },
          "404": {
            "description": "Goal not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Goal not found: 100"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "deleteWasteGoal",
        "description": "Removes a waste goal from the system.",
        "operationId": "deleteWasteGoal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Waste goal deleted.",
            "content": {
              "application/json": {
                "example": {
                  "goalId": 78
                }
              }
            }
          },
          "404": {
            "description": "Goal not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Goal not found: 78"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/waste-goals/{goalId}/items": {
      "get": {
        "summary": "getWasteItemsForGoalType",
        "description": "Returns valid waste items (like PET bottles or Straws) that match the type of the specified goal.",
        "operationId": "getWasteItemsForGoalType",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "goalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of items relevant to the goal type.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "name": "PET_BOTTLE_0_5_L",
                    "displayName": "PET bottle 0.5 L",
                    "weightInGrams": 18.0,
                    "type": {
                      "id": 1,
                      "name": "PLASTIC"
                    }
                  },
                  {
                    "id": 7,
                    "name": "STRAW",
                    "displayName": "Straw",
                    "weightInGrams": 0.5,
                    "type": {
                      "id": 1,
                      "name": "PLASTIC"
                    }
                  },
                  {
                    "id": 11,
                    "name": "BOTTLE_CAP",
                    "displayName": "Bottle cap",
                    "weightInGrams": 1.5
                  }
                ]
              }
            }
          },
          "404": {
            "description": "Goal ID not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteGoal not found with ID: 78"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
