{
  "openapi": "3.0.3",
  "info": {
    "title": "WasteLog",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/Wastelog/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server (Deployed)"
    }
  ],
  "paths": {
    "/api/waste-goals/{goalId}/logs": {
      "parameters": [
        {
          "name": "goalId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "example": 69
        }
      ],
      "get": {
        "summary": "getLogs",
        "description": "Returns the history of waste logs for a specific goal.",
        "operationId": "getLogs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of waste logs.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "logId": 114,
                    "date": "2025-12-16T10:51:00.435135",
                    "goalId": 69,
                    "username": "CuriousBartu",
                    "wasteItem": {
                      "id": 48,
                      "name": "GRAM_METAL",
                      "displayName": "Custom (grams)",
                      "weightInGrams": 1.0,
                      "type": {
                        "id": 2,
                        "name": "METAL"
                      }
                    }
                  }
                ]
              }
            }
          },
          "404": {
            "description": "Waste goal not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteGoal not found: 68"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "createWasteLog",
        "description": "Adds a new waste entry (log) to a goal.",
        "operationId": "createWasteLog",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "CuriousBartu"
                  },
                  "itemId": {
                    "type": "string",
                    "example": "20"
                  },
                  "quantity": {
                    "type": "string",
                    "example": "25"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waste log created successfully.",
            "content": {
              "application/json": {
                "example": {
                  "logId": 149,
                  "displayName": "Aerosol can (empty)",
                  "quantity": 25,
                  "date": "2025-12-20T14:04:13.400706498"
                }
              }
            }
          },
          "401": {
            "description": "Validation failed (e.g., type mismatch between item and goal).",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Validation failed: The logged item's type ('PLASTIC') does not match the goal's type ('METAL')."
                }
              }
            }
          },
          "404": {
            "description": "Waste goal not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteGoal not found: 68"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/{logId}": {
      "parameters": [
        {
          "name": "logId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "example": 149
        }
      ],
      "put": {
        "summary": "updateWasteLog",
        "description": "Updates the quantity of an existing waste log.",
        "operationId": "updateWasteLog",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waste log updated.",
            "content": {
              "application/json": {
                "example": {
                  "logId": 149,
                  "displayName": "Aerosol can (empty)",
                  "quantity": 1,
                  "date": "2025-12-20T14:04:13.400706"
                }
              }
            }
          },
          "404": {
            "description": "Log not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteLog not found: 150"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "deleteWasteLog",
        "description": "Deletes a specific waste log.",
        "operationId": "deleteWasteLog",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Log deleted.",
            "content": {
              "application/json": {
                "example": {
                  "logId": 149
                }
              }
            }
          },
          "404": {
            "description": "Log not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteLog not found: 149"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/summary": {
      "get": {
        "summary": "totalLogAmountForInterval",
        "description": "Returns the total weight logged for a specific waste type within a date range.",
        "operationId": "totalLogAmountForInterval",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2025-10-01T00:00:00"
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2025-10-20T00:00:00"
          },
          {
            "name": "wasteType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Plastic"
          }
        ],
        "responses": {
          "200": {
            "description": "Summary retrieved.",
            "content": {
              "application/json": {
                "example": {
                  "wasteType": {
                    "id": 1,
                    "name": "PLASTIC"
                  },
                  "totalAmount": 16758.0
                }
              }
            }
          },
          "404": {
            "description": "Waste type not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "WasteType not found: Plast"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/{username}/monthly": {
      "get": {
        "summary": "logsForUserPerMonth",
        "description": "Returns a 12-month breakdown of waste logged by a user for a specific category.",
        "operationId": "logsForUserPerMonth",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CuriousBartu"
          },
          {
            "name": "wasteType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Plastic"
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly summary retrieved.",
            "content": {
              "application/json": {
                "example": {
                  "username": "CuriousBartu",
                  "wasteType": "Plastic",
                  "monthlyData": [
                    {
                      "year": 2025,
                      "month": 7,
                      "totalWeight": 720.0
                    },
                    {
                      "year": 2025,
                      "month": 8,
                      "totalWeight": 630.0
                    },
                    {
                      "year": 2025,
                      "month": 9,
                      "totalWeight": 540.0
                    },
                    {
                      "year": 2025,
                      "month": 10,
                      "totalWeight": 450.0
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "User or logs not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: fsdgds"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
