{
  "openapi": "3.0.3",
  "info": {
    "title": "Post",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/post/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "getPosts",
        "description": "Gets posts for a specific user with pagination (size).",
        "operationId": "getPosts",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "kerim"
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 60
          }
        ],
        "responses": {
          "200": {
            "description": "A list of posts returned successfully.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "postId": 98,
                    "content": "Train stations are full of hidden metal waste...",
                    "createdAt": "2025-12-16T11:39:47.000+00:00",
                    "likes": 1,
                    "creatorUsername": "emrekilic",
                    "liked": false,
                    "saved": false
                  },
                  {
                    "postId": 97,
                    "content": "I started working at WasteLess and became a Moderator <3",
                    "creatorUsername": "CuriousBartu",
                    "liked": true
                  }
                ]
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: sd"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "createPost",
        "description": "Create a new post. Content and username are required, photo is optional.",
        "operationId": "createPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Today, we went to the forest and put some effort for the World!"
                  },
                  "photoFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "username": {
                    "type": "string",
                    "example": "Alice"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post created successfully.",
            "content": {
              "application/json": {
                "example": {
                  "postId": 99,
                  "content": "Today, we went to the forest...",
                  "createdAt": "2025-12-20T12:06:13.998+00:00",
                  "creatorUsername": "Alice"
                }
              }
            }
          },
          "404": {
            "description": "User not found during creation.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: Sd"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}": {
      "parameters": [
        {
          "name": "postId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "example": 98
        }
      ],
      "get": {
        "summary": "getPost",
        "description": "Gets a specific post from the viewpoint of a specific user.",
        "operationId": "getPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CuriousBartu"
          }
        ],
        "responses": {
          "200": {
            "description": "Post details retrieved.",
            "content": {
              "application/json": {
                "example": {
                  "postId": 98,
                  "content": "Train stations are full of hidden metal waste...",
                  "creatorUsername": "emrekilic",
                  "liked": false,
                  "saved": false
                }
              }
            }
          },
          "404": {
            "description": "Post not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Post not found: 100"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "editPost",
        "description": "Updates an existing post's content or photo.",
        "operationId": "editPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "This is an updated post"
                  },
                  "photoFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "username": {
                    "type": "string",
                    "example": "CuriousBartu"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post edited successfully.",
            "content": {
              "application/json": {
                "example": {
                  "postId": 99,
                  "content": "This is a post",
                  "creatorUsername": "Alice"
                }
              }
            }
          },
          "404": {
            "description": "Post ID not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Post not found: 500"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "deletePost",
        "description": "Deletes the specified post.",
        "operationId": "deletePost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Post deleted.",
            "content": {
              "application/json": {
                "example": {
                  "postId": 99
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/mostLiked": {
      "get": {
        "summary": "getMostLikedPosts",
        "description": "Returns the top posts ordered by likes.",
        "operationId": "getMostLikedPosts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "List of most liked posts.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "postId": 76,
                    "likes": 31,
                    "content": "Saw this at the park today..."
                  },
                  {
                    "postId": 75,
                    "likes": 27,
                    "content": "I am at a school..."
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}/save": {
      "post": {
        "summary": "savePost",
        "description": "User saves a post to their profile.",
        "operationId": "savePost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "Alice"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post saved successfully.",
            "content": {
              "application/json": {
                "example": {
                  "username": "Alice",
                  "postId": 98
                }
              }
            }
          },
          "404": {
            "description": "Post not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Post not found: 100"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - already saved.",
            "content": {
              "application/json": {
                "example": {
                  "status": 409,
                  "message": "This post is already saved by userAlice"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}/saves/{username}": {
      "delete": {
        "summary": "deleteSavedPost",
        "description": "Un-saves a post for a specific user.",
        "operationId": "deleteSavedPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post un-saved.",
            "content": {
              "application/json": {
                "example": {
                  "deleted": true
                }
              }
            }
          },
          "404": {
            "description": "Save entry not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Saved‐post entry not found for userId=84, postId=98"
                }
              }
            }
          }
        }
      }
    },
    "/api/forum/search/semantic": {
      "get": {
        "summary": "searchPostsSemantic",
        "description": "Semantic search for posts based on content similarity.",
        "operationId": "searchPostsSemantic",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Alice"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Plastic"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results found.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "postId": 4,
                    "content": "No more paper or plastic cups...",
                    "creatorUsername": "alcala.kelsy"
                  },
                  {
                    "postId": 12,
                    "content": "Our beach cleanup collected 200kg of plastic...",
                    "creatorUsername": "CuriousBartu"
                  }
                ]
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: Aasfsaf"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
