{
  "openapi": "3.0.3",
  "info": {
    "title": "Search",
    "version": "1.0.0",
    "description": "API for semantic post searching within the Zero Waste forum.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/Search/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server (Deployed)"
    }
  ],
  "paths": {
    "/api/forum/search/semantic": {
      "get": {
        "summary": "searchPostsSemantic",
        "description": "Returns a list of posts that have captions resembling the query, tailored to the specific user's interaction status.",
        "operationId": "searchPostsSemantic",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Alice"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Plastic"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of semantically relevant posts.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "postId": 4,
                    "content": "No more paper or plastic cups. From now on, refill and reuse.",
                    "createdAt": "2025-10-20T16:51:07.000+00:00",
                    "likes": 17,
                    "creatorUsername": "alcala.kelsy",
                    "photoUrl": "https://waste-less-photo-storage-2.sfo3.digitaloceanspaces.com/post/no_more_plastic.png",
                    "comments": 2,
                    "liked": false,
                    "saved": false,
                    "profile_picture": "https://waste-less-photo-storage-2.sfo3.digitaloceanspaces.com/profile/d3ddf72e-3afd-4ae3-99e3-addd077b9063.jpeg"
                  },
                  {
                    "postId": 6,
                    "content": "Last week our little coffee shop retired plastic straws...",
                    "createdAt": "2025-10-20T17:18:10.000+00:00",
                    "likes": 13,
                    "creatorUsername": "ziya.okatan",
                    "photoUrl": null,
                    "comments": 3,
                    "liked": false,
                    "saved": false
                  }
                ]
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "User not found: Aasfsaf"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
