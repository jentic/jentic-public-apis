              "X-XSS-Protection": {
                "schema": {
                  "type": "string",
                  "example": "0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "number",
                      "example": 100
                    },
                    "challengeId": {
                      "type": "number",
                      "example": 15
                    },
                    "description": {
                      "type": "string",
                      "example": "A challenge to reduce glass waste in our community."
                    },
                    "endDate": {
                      "type": "string",
                      "example": "2026-01-25"
                    },
                    "name": {
                      "type": "string",
                      "example": "2"
                    },
                    "startDate": {
                      "type": "string",
                      "example": "2025-12-17"
                    },
                    "status": {
                      "type": "string",
                      "example": "Active"
                    },
                    "type": {
                      "type": "string",
                      "example": "PLASTIC"
