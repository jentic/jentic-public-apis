{
  "openapi": "3.0.3",
  "info": {
    "title": "PostLike",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cbs-e28/Postlike/1.0.0"
  },
  "servers": [
    {
      "url": "https://waste-less.alibartukonca.org",
      "description": "Production Server (Deployed)"
    }
  ],
  "paths": {
    "/api/posts/like": {
      "post": {
        "summary": "addLike",
        "description": "Adds a like to a specific post.",
        "operationId": "addLike",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "CuriousBartu"
                  },
                  "postId": {
                    "type": "string",
                    "example": "98"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully liked the post",
            "content": {
              "application/json": {
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Post not found with id: 123"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Post already liked",
            "content": {
              "application/json": {
                "example": {
                  "status": 409,
                  "message": "This post is already liked by CuriousBartu"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "removeLike",
        "description": "Removes a like from a specific post.",
        "operationId": "removeLike",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "CuriousBartu"
                  },
                  "postId": {
                    "type": "integer",
                    "example": 98
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully removed the like",
            "content": {
              "application/json": {
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "Like not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Like not found for this post by user : CuriousBartu"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}/likes": {
      "get": {
        "summary": "getPostLikes",
        "description": "Returns a list of users who liked the post.",
        "operationId": "getPostLikes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "example": {
                  "postId": 98,
                  "totalLikes": 1,
                  "likedByUsers": [
                    {
                      "userId": 19,
                      "username": "emrekilic"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Post not found with id: 123"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
