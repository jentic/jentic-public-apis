{
  "openapi": "3.0.1",
  "info": {
    "title": "AGM",
    "description": "",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/LRUSNT/agm/1.0.0"
  },
  "tags": [],
  "paths": {
    "/sonet/api/v1/kverkom/registerPayment": {
      "post": {
        "summary": "registerPayment",
        "deprecated": false,
        "description": "Registers the payment and returns QR code content with related metadata.",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/registerPaymentReq"
              },
              "examples": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/registerPaymentResp"
                },
                "example": {
                  "content": "https://payme.sk/2/m/PME?IBAN=SK6807200002891987426353&AM=200.30&CC=EUR&PI=QR-VUB1234567890ABCDEFGHIJKLMMNOPQR&CN=The+Best+Cafes+ltd&MSG=Cafe+on+the+corner+Zilina",
                  "QRtype": "payme2",
                  "e2e": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR",
                  "errId": "0195f3c0-8b7a-7c2f-9a3e-3b5f6c7d8e9a"
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Access denied: the selected client certificate does not have permission to use this service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "NOACCESS",
                    "msgSK": "Pripojenie odmietnute",
                    "msgEN": "Access denied"
                  }
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "Terminal configuration not found. The specified MID and TID combination does not exist or is not authorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "ConfigurationException",
                    "msgSK": "Terminal nie je na configurovany",
                    "msgEN": "Terminal is not configured"
                  }
                }
              }
            },
            "headers": {}
          },
          "418": {
            "description": "Request blocked by security platform due to security policy restrictions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "WAFException",
                    "incidentId": "10485203183275696580"
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/sonet/api/v1/kverkom/paymentStatus": {
      "post": {
        "summary": "paymentStatus",
        "deprecated": false,
        "description": "Returns the current status of the payment processing.",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/paymentStatusReq"
              },
              "example": {
                "pos": {
                  "mid": "ABCDE1234567890",
                  "tid": "ABCD1234"
                },
                "e2e": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Final status of payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "examples": {
                  "1": {
                    "summary": "OK",
                    "value": {
                      "status": {
                        "code": "OK",
                        "processedAt": "2026-02-06T22:03:47+02:00",
                        "amt": "12.25",
                        "ccy": "EUR",
                        "payId": "asdji34231242145"
                      }
                    }
                  },
                  "2": {
                    "summary": "REJECTED",
                    "value": "{\r\n    \"status\": {\r\n        \"code\": \"REJECTED\",\r\n    }\r\n}"
                  }
                }
              }
            },
            "headers": {}
          },
          "202": {
            "description": "Temporary status need to query again for final status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "example": {
                  "status": {
                    "code": "NOINFO"
                  }
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Access denied: the selected client certificate does not have permission to use this service. Final status of payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "NOACCESS",
                    "msgSK": "Pripojenie odmietnute",
                    "msgEN": "Access denied"
                  }
                }
              }
            },
            "headers": {}
          },
          "404": {
            "description": "Ensure the payment registration was called before this request and that E2E, MID, and TID match the registered values. Final status of payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "example": {
                  "status": {
                    "code": "NODATA"
                  }
                }
              }
            },
            "headers": {}
          },
          "410": {
            "description": "Final status of payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "example": {
                  "status": {
                    "code": "EXP"
                  }
                }
              }
            },
            "headers": {}
          },
          "418": {
            "description": "Request blocked by security platform due to security policy restrictions. Final status of payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "WAFException",
                    "incidentId": "10485203183275696580"
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/sonet/api/v1/kverkom/cancelPayment": {
      "post": {
        "summary": "cancelPayment",
        "deprecated": false,
        "description": "Requests cancellation of a payment. The cancellation may fail if the payment has already progressed beyond a reversible processing stage.",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/cancelPaymentReq"
              },
              "example": {
                "pos": {
                  "mid": "ABCDE1234567890",
                  "tid": "ABCD1234"
                },
                "e2e": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR",
                "reason": "TIMEOUT"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Final state of cancel request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "example": {
                  "status": {
                    "code": "CANCELED"
                  }
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Access denied: the selected client certificate does not have permission to use this service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "NOACCESS",
                    "msgSK": "Pripojenie odmietnute",
                    "msgEN": "Access denied"
                  }
                }
              }
            },
            "headers": {}
          },
          "404": {
            "description": "Ensure the payment registration was called before this request and that E2E, MID, and TID match the registered values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "example": {
                  "status": {
                    "code": "NODATA"
                  }
                }
              }
            },
            "headers": {}
          },
          "406": {
            "description": "Cancel operation rejected. Payment is either completed or currently being processed. The response status code indicates the result, matching the paymentStatus call.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentStatusResp"
                },
                "examples": {
                  "2": {
                    "summary": "Example 1",
                    "value": {
                      "status": {
                        "code": "OK",
                        "processedAt": "2026-02-06T22:03:47+02:00",
                        "amt": "12.25",
                        "ccy": "EUR",
                        "payId": "asdji34231242145"
                      }
                    }
                  },
                  "3": {
                    "summary": "Example 2",
                    "value": "{\r\n    \"status\": {\r\n        \"code\": \"PROC\",\r\n    }\r\n}"
                  }
                }
              }
            },
            "headers": {}
          },
          "418": {
            "description": "Request blocked by security platform due to security policy restrictions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResp"
                },
                "example": {
                  "error": {
                    "code": "WAFException",
                    "incidentId": "10485203183275696580"
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "registerPaymentReq": {
        "type": "object",
        "properties": {
          "pos": {
            "type": "object",
            "properties": {
              "mid": {
                "type": "string",
                "title": "POS terminal Merchant ID",
                "pattern": "^[A-Z0-9]{8,15}$",
                "maxLength": 15,
                "minLength": 8,
                "description": "POS terminal Merchant ID",
                "example": "ABCDE1234567890"
              },
              "tid": {
                "type": "string",
                "title": "POS Terminal ID",
                "minLength": 6,
                "maxLength": 8,
                "pattern": "^[A-Z0-9]{6,8}$",
                "description": "POS Terminal ID",
                "example": "ABCD1234"
              }
            },
            "required": [
              "mid",
              "tid"
            ]
          },
          "qrPayment": {
            "type": "object",
            "properties": {
              "amt": {
                "type": "number",
                "title": "Amount of payment",
                "maximum": 9999999999.99,
                "minimum": 0,
                "description": "Amount",
                "example": 123.45
              },
              "ccy": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "maxLength": 3,
                "minLength": 3,
                "title": "ISO 4217 currency code",
                "description": "ISO 4217 Currency code"
              }
            },
            "required": [
              "amt",
              "ccy"
            ]
          }
        },
        "required": [
          "pos",
          "qrPayment"
        ]
      },
      "registerPaymentResp": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "QR codeny content",
            "example": "https://payme.sk/2/m/PME?IBAN=SK6807200002891987426353&AM=200.30&CC=EUR&PI=QR-VUB1234567890ABCDEFGHIJKLMMNOPQR&CN=The+Best+Cafes+ltd&MSG=Cafe+on+the+corner+Zilina"
          },
          "QRtype": {
            "type": "string",
            "default": "payme2",
            "description": "QR code type",
            "example": "payme2"
          },
          "e2e": {
            "type": "string",
            "description": "EndToEndReference  - primary identification for payment",
            "maxLength": 35,
            "example": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR"
          },
          "errId": {
            "type": "string",
            "title": "",
            "description": "Reference code if error/timeout happend during processing",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
            "example": "0195f3c0-8b7a-7c2f-9a3e-3b5f6c7d8e9a"
          },
          "notAfter": {
            "type": "string",
            "description": "Payment expiration time (format 8601). After this time payment is revoked/timedout.",
            "format": "date-time",
            "example": "2026-02-06T14:30:00+02:00"
          }
        },
        "required": [
          "content",
          "QRtype",
          "errId",
          "e2e",
          "notAfter"
        ]
      },
      "errorResp": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code"
              },
              "incidentId": {
                "type": "string",
                "description": "incident code"
              },
              "msgSK": {
                "type": "string",
                "description": "human readable message - language SK"
              },
              "msgEN": {
                "type": "string",
                "description": "human readable message - language EN"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "paymentStatusReq": {
        "type": "object",
        "properties": {
          "pos": {
            "type": "object",
            "properties": {
              "mid": {
                "type": "string",
                "title": "POS terminal Merchant ID",
                "pattern": "^[A-Z0-9]{8,15}$",
                "maxLength": 15,
                "minLength": 8,
                "description": "POS terminal Merchant ID",
                "example": "ABCDE1234567890"
              },
              "tid": {
                "type": "string",
                "title": "POS Terminal ID",
                "minLength": 6,
                "maxLength": 8,
                "pattern": "^[A-Z0-9]{6,8}$",
                "description": "POS Terminal ID",
                "example": "ABCD1234"
              }
            },
            "required": [
              "mid",
              "tid"
            ]
          },
          "e2e": {
            "type": "string",
            "pattern": "35",
            "description": "EndToEndReference  - primary identification for payment",
            "example": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR"
          }
        },
        "required": [
          "pos",
          "e2e"
        ]
      },
      "paymentStatusResp": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "respose code",
                "enum": [
                  "OK",
                  "NOINFO",
                  "EXP",
                  "NODATA",
                  "CANCELED",
                  "PROC",
                  "REJECTED"
                ]
              },
              "processedAt": {
                "type": "string",
                "description": "ISO8401 - Timestamp indicating when the payment was successfully processed",
                "format": "date-time",
                "example": "2026-02-06T22:03:47+02:00"
              },
              "amt": {
                "type": "string",
                "description": "Amount",
                "example": "12.25"
              },
              "ccy": {
                "type": "string",
                "description": "currency code",
                "example": "EUR"
              },
              "payId": {
                "type": "string",
                "description": "Recorded PaymentID"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "cancelPaymentReq": {
        "type": "object",
        "properties": {
          "pos": {
            "type": "object",
            "properties": {
              "mid": {
                "type": "string",
                "title": "POS terminal Merchant ID",
                "pattern": "^[A-Z0-9]{8,15}$",
                "maxLength": 15,
                "minLength": 8,
                "description": "POS terminal Merchant ID",
                "example": "ABCDE1234567890"
              },
              "tid": {
                "type": "string",
                "title": "POS Terminal ID",
                "minLength": 6,
                "maxLength": 8,
                "pattern": "^[A-Z0-9]{6,8}$",
                "description": "POS Terminal ID",
                "example": "ABCD1234"
              }
            },
            "required": [
              "mid",
              "tid"
            ]
          },
          "e2e": {
            "type": "string",
            "pattern": "35",
            "description": "EndToEndReference  - primary identification for payment",
            "example": "QR-VUB1234567890ABCDEFGHIJKLMMNOPQR"
          },
          "reason": {
            "type": "string",
            "enum": [
              "CANCEL",
              "TIMEOUT"
            ],
            "description": "Reason code",
            "example": "CANCEL"
          }
        },
        "required": [
          "pos",
          "e2e",
          "reason"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {}
  },
  "servers": [
    {
      "url": "https://vubservices-o.vub.sk",
      "description": "Testing Env"
    },
    {
      "url": "https://vubservices.vub.sk",
      "description": "Prod Env"
    }
  ],
  "security": []
}
