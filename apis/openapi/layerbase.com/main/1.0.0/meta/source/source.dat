      "post": {
        "tags": [
          "API keys"
        ],
        "operationId": "createApiKey",
        "summary": "Create an API key",
        "description": "Creates a key. Body is optional: name (defaults to default; anything past 80 characters is truncated rather than rejected, and the reserved name web-app returns 400), scopeType (account or database), and scopeId (required when scopeType is database, naming a database you own; one you cannot reach returns 404). Returns 201 with { \"key\": { ..., \"secret\": \"sk_...\" } }. The secret appears only in this response. Key names are unique per scope while the key is active: creating a second key with a name you are already using returns 409 with code: \"api_key_name_exists\" and the existing key, so retrying a request that timed out cannot silently leave you with two keys under one name. Since the secret is only ever shown once, rotate the existing key to get a new secret, or pick a different name. Revoking a key frees its name. Pass ttlSeconds to mint a key that expires on its own, in whole seconds from now, between 600 (10 minutes) and 2592000 (30 days). This is what a CI job wants: mint a credential at the start of the run and let it die by itself, whether or not the job reaches its cleanup step. The absolute expiry comes back as expiresAt, and a request past it fails 401 with code: \"api_key_expired\". Omit ttlSeconds and the key never expires, which is how every key behaved before this option existed; a value outside the bounds returns 400 with code: \"invalid_ttl\" rather than being clamped.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "The new key. The secret appears only in this response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "prefix": {
                          "type": "string"
                        },
                        "scopeType": {
                          "type": "string",
                          "enum": [
                            "account",
                            "database"
                          ]
                        },
                        "scopeId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "lastUsedAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "revokedAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "Always null in a list response, which omits revoked keys."
                        },
                        "expiresAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "When the key stops working, as an absolute UTC instant. null for a key that never expires, which is what omitting ttlSeconds at creation gives you."
                        },
                        "secret": {
                          "type": "string",
                          "description": "The raw sk_ secret. Returned exactly once."
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "prefix",
                        "scopeType",
                        "scopeId",
                        "createdAt",
                        "lastUsedAt",
                        "revokedAt",
                        "expiresAt",
                        "secret"
                      ]
                    },
                    "keyHash": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "keyHash"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "A reserved key name, scopeType 'database' with no scopeId, or a ttlSeconds outside 600 to 2592000 (code 'invalid_ttl', with minTtlSeconds and maxTtlSeconds in the body).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "The account is suspended for a failed payment, so mutating calls are blocked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key cannot reach this endpoint; it may only call /v1/databases/<its own id> and sub-paths, where the id is the database UUID, not its hostname (code: 'scoped_key_out_of_scope').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The scoped database is not accessible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "You already have an active key with this name and scope. Body carries code `api_key_name_exists` and the existing key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "default": "default",
                    "description": "Optional. Defaults to 'default'. Trimmed and truncated to 80 characters rather than rejected. 'web-app' is reserved and returns 400."
                  },
                  "scopeType": {
                    "type": "string",
                    "enum": [
                      "account",
                      "database"
                    ],
                    "default": "account",
                    "description": "Optional. 'account' (default) or 'database'."
                  },
                  "scopeId": {
                    "type": "string",
                    "description": "Required when scopeType is 'database', naming a database you own. Ignored otherwise."
                  },
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 600,
                    "maximum": 2592000,
                    "description": "Optional. How long the key lives, in whole seconds from now: 600 (10 minutes) to 2592000 (30 days). Omit it for a key that never expires, which is the default. Out of range returns 400 with code invalid_ttl, never a silent clamp."
                  }
                }
              }
            }
          }
        }
      }
