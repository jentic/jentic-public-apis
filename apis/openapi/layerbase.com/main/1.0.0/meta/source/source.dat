{
  "openapi": "3.1.0",
  "info": {
    "title": "Layerbase Cloud API",
    "version": "1.0.0",
    "summary": "Create, list, and query managed cloud databases, and manage the API keys that authenticate every request.",
    "description": "The Layerbase Cloud API lets you create, list, and query databases over HTTPS, and manage the personal API keys that authenticate every request. Human-readable reference: https://layerbase.com/docs/api.",
    "termsOfService": "https://layerbase.com/terms",
    "contact": {
      "name": "Layerbase support",
      "url": "https://layerbase.com/support"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://layerbase.com/terms"
    }
  },
  "servers": [
    {
      "url": "https://cloud.layerbase.dev",
      "description": "Original shared server. Override with the API URL from the target database Connect panel; API keys and database UUIDs must be used on their hosting server."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Health and engines"
    },
    {
      "name": "Databases"
    },
    {
      "name": "Identity and usage"
    },
    {
      "name": "API keys"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal API key, sent as `Authorization: Bearer sk_<your-key>`. An account-scoped key reaches every endpoint; a database-scoped key may only call its own database."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health and engines"
        ],
        "operationId": "getHealth",
        "summary": "Liveness probe",
        "description": "Unauthenticated liveness probe. Returns { \"status\": \"ok\", \"service\": \"layerbase-cloud\" }, always alongside the reconcile and bootReconcile fields that report reconciler progress. Returns 503 with draining or overloaded when the server is shutting down or under memory pressure.",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is accepting traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "example": "layerbase-cloud"
                    },
                    "reconcile": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "ready",
                        "failed"
                      ]
                    },
                    "bootReconcile": {
                      "type": "string",
                      "enum": [
                        "idle",
                        "running",
                        "complete",
                        "failed"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "reconcile",
                    "bootReconcile"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The server is draining (shutting down) or overloaded (under memory pressure). The overloaded body adds memoryPercent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "draining",
                        "overloaded"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "memoryPercent": {
                      "type": "number"
                    },
                    "reconcile": {
                      "type": "string"
                    },
                    "bootReconcile": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/engines": {
      "get": {
        "tags": [
          "Health and engines"
        ],
        "operationId": "listEngines",
        "summary": "List the public engine registry",
        "description": "The public engine registry: every engine, its display name, versions, and defaults. No auth required, and the response is a bare JSON array rather than an object wrapper. This is the same data the dashboard create flow reads, so you can use it to build a valid engine and version for a create call.",
        "security": [],
        "responses": {
          "200": {
            "description": "Every engine, its display name, versions, and defaults: the same data the dashboard create flow reads. This response is a bare array, not an object wrapper.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "statusReason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "category": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "queryLanguage": {
                        "type": "string"
                      },
                      "isFileBased": {
                        "type": "boolean"
                      },
                      "runtime": {
                        "type": "string"
                      },
                      "connectionScheme": {
                        "type": "string"
                      },
                      "defaultPort": {
                        "type": "integer"
                      },
                      "license": {
                        "type": "string"
                      },
                      "hostedServiceAllowed": {
                        "type": "boolean"
                      },
                      "dependsOn": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "defaultVersion": {
                        "type": "string"
                      },
                      "supportedVersions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "prereleaseVersions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "defaultVersion",
                      "supportedVersions"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/databases": {
      "get": {
        "tags": [
          "Databases"
        ],
        "operationId": "listDatabases",
        "summary": "List your databases",
        "description": "Lists the databases you own plus any shared with you through a team. Returns { \"limits\": { ... }, \"counts\": { ... }, \"databases\": [ ... ] }: counts splits primaries from branches, and limits reports your branch allowances. Each entry carries more fields than an ordinary client needs; the stable core is id, name, engine, version, status, host, port, connectionString, an access field of owner or member, the placement fields server / serverPool (the canonical server slug and either shared or dedicated; both null when placement is not reported), and the transient fields expiresAt / transient (see transient databases). App workloads are not databases and never appear here.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The databases you own plus any shared with you through a team. Branch rows appear in the same flat list, split out by counts. App workloads never appear here.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "limits": {
                      "type": "object",
                      "properties": {
                        "branchLimitPerDatabase": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "branchAccountMax": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "branchesUsedByAccount": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "branchesUsedByAccount"
                      ]
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "primaries": {
                          "type": "integer"
                        },
                        "branches": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "total",
                        "primaries",
                        "branches"
                      ]
                    },
                    "databases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "access": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "member"
                            ]
                          },
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "label": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "engine": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "host": {
                            "type": "string"
                          },
                          "port": {
                            "type": "integer"
                          },
                          "internalPort": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "poolerPort": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "hostname": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "database": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "keepAlive": {
                            "type": "boolean"
                          },
                          "clientCertRequired": {
                            "type": "boolean"
                          },
                          "backupPolicy": {
                            "type": "string"
                          },
                          "pitr": {
                            "type": "boolean"
                          },
                          "storageClass": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "storageBlocks": {
                            "type": "integer"
                          },
                          "lastActivityAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "lastWakeAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "preset": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "authSystem": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "stackId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "parentId": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Set on a branch row; parentName names its parent."
                          },
                          "parentName": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "branchedAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "branchMethod": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "branchingEnabled": {
                            "type": "boolean"
                          },
                          "backupsOptIn": {
                            "type": "boolean"
                          },
                          "backupIntervalHours": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "environment": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "persistent": {
                            "type": "boolean"
                          },
                          "locked": {
                            "type": "integer",
                            "description": "0 or 1, not a boolean."
                          },
                          "lockedAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "tierGraceUntil": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "convertedFromDatabaseId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "connectionString": {
                            "type": "string"
                          },
                          "directConnectionString": {
                            "type": "string"
                          },
                          "restUrl": {
                            "type": "string",
                            "description": "Redis and Valkey only."
                          },
                          "restToken": {
                            "type": "string",
                            "description": "Redis and Valkey only."
                          },
                          "psUrl": {
                            "type": "string",
                            "description": "MySQL and MariaDB only."
                          },
                          "psUsername": {
                            "type": "string",
                            "description": "MySQL and MariaDB only."
                          },
                          "psPassword": {
                            "type": "string",
                            "description": "MySQL and MariaDB only."
                          },
                          "ilpUrl": {
                            "type": "string",
                            "description": "QuestDB only. InfluxDB Line Protocol over HTTP ingest endpoint. Omitted until its DNS record is live."
                          },
                          "ilpConfigString": {
                            "type": "string",
                            "description": "QuestDB only. Ready-to-paste config string for the official QuestDB clients. Contains the password."
                          },
                          "serverlessHttpEndpoint": {
                            "type": "string",
                            "description": "PostgreSQL family only."
                          },
                          "server": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Canonical server slug, or null when placement is unreported."
                          },
                          "serverPool": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "enum": [
                              "shared",
                              "dedicated"
                            ]
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "expiresAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time",
                            "description": "Expiry deadline for a transient database, else null."
                          },
                          "transient": {
                            "type": "boolean"
                          },
                          "branchCount": {
                            "type": "integer",
                            "description": "List responses only; the single-database read omits it."
                          }
                        },
                        "required": [
                          "access",
                          "id",
                          "name",
                          "engine",
                          "version",
                          "status",
                          "host",
                          "port",
                          "connectionString",
                          "server",
                          "serverPool",
                          "created_at",
                          "expiresAt",
                          "transient"
                        ]
                      }
                    }
                  },
                  "required": [
                    "limits",
                    "counts",
                    "databases"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key cannot reach this endpoint; it may only call /v1/databases/<its own id> and sub-paths, where the id is the database UUID, not its hostname (code: 'scoped_key_out_of_scope').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Databases"
        ],
        "operationId": "createDatabase",
        "summary": "Provision a database",
        "description": "Provisions a new database. Only engine is required; the rest have defaults.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "The new database, with its connection details and a status. Fast engines come back running; slow-start engines come back provisioning and finish in the background.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "engine": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer"
                    },
                    "internalPort": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "poolerPort": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "hostname": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    },
                    "database": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "connectionString": {
                      "type": "string"
                    },
                    "directConnectionString": {
                      "type": "string"
                    },
                    "restUrl": {
                      "type": "string",
                      "description": "Redis and Valkey only."
                    },
                    "restToken": {
                      "type": "string",
                      "description": "Redis and Valkey only."
                    },
                    "psUrl": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "psUsername": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "psPassword": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "ilpUrl": {
                      "type": "string",
                      "description": "QuestDB only. InfluxDB Line Protocol over HTTP ingest endpoint. Omitted until its DNS record is live."
                    },
                    "ilpConfigString": {
                      "type": "string",
                      "description": "QuestDB only. Ready-to-paste config string for the official QuestDB clients. Contains the password."
                    },
                    "spindbVersion": {
                      "type": "string"
                    },
                    "server": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "serverPool": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "shared",
                        "dedicated"
                      ]
                    },
                    "expiresAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "transient": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "running",
                        "provisioning"
                      ],
                      "description": "provisioning for the slow-start engines (MySQL, MariaDB, ClickHouse, QuestDB, libSQL), else running."
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "engine",
                    "version",
                    "host",
                    "port",
                    "connectionString",
                    "status",
                    "transient"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid engine, version, name, database name, backupPolicy, or storageBlocks. An out-of-range ttlHours returns code invalid_ttl.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "The account is suspended for a failed payment, so mutating calls are blocked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "An engine your plan cannot create (engine_license_restricted, engine_requires_upgrade), keepAlive on Free, or a database-scoped key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "name_taken, pool_exhausted, pool_block_required, insufficient_host_capacity, or no_primary_team.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "423": {
            "description": "Lock contention on the target resources.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "database_limit_reached (your plan's database limit), programmatic_create_limit_reached (the monthly API-key create quota), or the per-IP create rate limit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header. engine_unavailable, provisioning_paused, port_block_capacity, or port allocation not yet reconciled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "engine": {
                    "type": "string",
                    "description": "Required. e.g. postgresql, mysql, redis, valkey, mariadb, mongodb, clickhouse."
                  },
                  "version": {
                    "type": "string",
                    "description": "Optional. Defaults to the engine default from /v1/engines."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 63,
                    "description": "Optional. Lowercase letter first, then letters/numbers/hyphens/underscores, up to 63 chars. Auto-generated if omitted."
                  },
                  "database": {
                    "type": "string",
                    "description": "Optional. Initial database/schema name. Defaults per engine."
                  },
                  "backupPolicy": {
                    "type": "string",
                    "enum": [
                      "none",
                      "7d",
                      "30d"
                    ],
                    "default": "none",
                    "description": "Optional. 'none' (default), '7d', or '30d'."
                  },
                  "keepAlive": {
                    "type": "boolean",
                    "default": false,
                    "description": "Optional boolean. Always-on (skip hibernation). Paid plans only."
                  },
                  "storageBlocks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20,
                    "default": 0,
                    "description": "Optional integer 0-20. Extra storage blocks."
                  },
                  "ttlHours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 72,
                    "description": "Optional integer 1-72. Makes the database transient: an expires_at is stamped and the database is destroyed outright at expiry with no final backup. Ideal for CI. See Transient databases below."
                  },
                  "teamId": {
                    "type": "string",
                    "description": "Optional. Owning team. Defaults to your primary team."
                  }
                },
                "required": [
                  "engine"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/databases/{id}": {
      "get": {
        "tags": [
          "Databases"
        ],
        "operationId": "getDatabase",
        "summary": "Fetch one database",
        "description": "Returns one database with the same fields as the list entry plus teamName and stopped_at. Returns 404 if the database does not exist or is not yours. Poll this after a create to watch status settle.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "One database. Same fields as a list entry except branchCount, plus teamName, credentials, and stopped_at.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "access": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "member"
                      ]
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "engine": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer"
                    },
                    "internalPort": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "poolerPort": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "hostname": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "database": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "keepAlive": {
                      "type": "boolean"
                    },
                    "clientCertRequired": {
                      "type": "boolean"
                    },
                    "backupPolicy": {
                      "type": "string"
                    },
                    "pitr": {
                      "type": "boolean"
                    },
                    "storageClass": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "storageBlocks": {
                      "type": "integer"
                    },
                    "lastActivityAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "lastWakeAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "preset": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "authSystem": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stackId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "parentId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Set on a branch row; parentName names its parent."
                    },
                    "parentName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "branchedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "branchMethod": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "branchingEnabled": {
                      "type": "boolean"
                    },
                    "backupsOptIn": {
                      "type": "boolean"
                    },
                    "backupIntervalHours": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "environment": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "persistent": {
                      "type": "boolean"
                    },
                    "locked": {
                      "type": "integer",
                      "description": "0 or 1, not a boolean."
                    },
                    "lockedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "tierGraceUntil": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "convertedFromDatabaseId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "connectionString": {
                      "type": "string"
                    },
                    "directConnectionString": {
                      "type": "string"
                    },
                    "restUrl": {
                      "type": "string",
                      "description": "Redis and Valkey only."
                    },
                    "restToken": {
                      "type": "string",
                      "description": "Redis and Valkey only."
                    },
                    "psUrl": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "psUsername": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "psPassword": {
                      "type": "string",
                      "description": "MySQL and MariaDB only."
                    },
                    "ilpUrl": {
                      "type": "string",
                      "description": "QuestDB only. InfluxDB Line Protocol over HTTP ingest endpoint. Omitted until its DNS record is live."
                    },
                    "ilpConfigString": {
                      "type": "string",
                      "description": "QuestDB only. Ready-to-paste config string for the official QuestDB clients. Contains the password."
                    },
                    "serverlessHttpEndpoint": {
                      "type": "string",
                      "description": "PostgreSQL family only."
                    },
                    "server": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Canonical server slug, or null when placement is unreported."
                    },
                    "serverPool": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "shared",
                        "dedicated"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expiresAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "Expiry deadline for a transient database, else null."
                    },
                    "transient": {
                      "type": "boolean"
                    },
                    "teamName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string",
                      "description": "Blank when credentials are withheld from an admin viewer with no support grant."
                    },
                    "credentialsWithheld": {
                      "type": "boolean"
                    },
                    "viewerIsAdminNonOwner": {
                      "type": "boolean"
                    },
                    "supportGrant": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "grantedByYou": {
                          "type": "boolean"
                        },
                        "breakGlass": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "stopped_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "access",
                    "id",
                    "name",
                    "engine",
                    "version",
                    "status",
                    "host",
                    "port",
                    "connectionString",
                    "server",
                    "serverPool",
                    "created_at",
                    "expiresAt",
                    "transient"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key pinned to another database.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The database does not exist or is not yours.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The database id: the UUID returned as `id` by GET /v1/databases and shown in the dashboard, not the database's hostname.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/databases/{id}/query": {
      "post": {
        "tags": [
          "Databases"
        ],
        "operationId": "queryDatabase",
        "summary": "Run a query over HTTP",
        "description": "Runs a query over HTTP against the database, no driver or open socket required, which makes it the easiest path from serverless and edge runtimes. Send { \"query\": \"SELECT 1\" } for SQL engines; the query is capped at 10240 characters. A hibernated database wakes automatically (you may get a 503 with retry_after while it does); an archived one returns 503 with a restore path, and a locked one returns 423. The full request shapes for non-SQL engines and edge examples are in serverless and edge access.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The query result. The exec path returns columns, rows, and rowCount; proxied HTTP and native paths return the engine result verbatim.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "rowCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing, empty, oversized, or control-character-bearing query; an engine that does not accept this request shape; a database that is not running; or an engine-reported query error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "The account is suspended for a failed payment, so mutating calls are blocked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key pinned to another database, or an admin viewer without a support grant (reason support_grant_required).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The database is not found, or not yours.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "423": {
            "description": "The database is locked (reason locked, with lockedAt).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "The HTTP forward to the engine failed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header. The database is waking (retry_after, cold_start_estimate_ms) or archived (reason archived, with restorePath).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The database id: the UUID returned as `id` by GET /v1/databases and shown in the dashboard, not the database's hostname.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 10240,
                    "description": "A statement for SQL engines. Capped at 10240 characters, non-empty after trimming, and free of control characters other than tab, newline, and carriage return."
                  },
                  "http": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "For engines with an HTTP API. method and path are both required.",
                    "properties": {
                      "method": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "method",
                      "path"
                    ]
                  },
                  "native": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "For engines with a native (non-textual) protocol, such as TigerBeetle."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Identity and usage"
        ],
        "operationId": "getMe",
        "summary": "Identify the key and report usage",
        "description": "Returns who the key belongs to and your current programmatic-create usage, with no side effects. Use it for a whoami check or to let an agent report your standing before it provisions anything. The apiKey block describes the calling key itself, including its expiresAt (null when it never expires), so a CI job can fail early on a credential that is about to age out.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Who the key belongs to and the current programmatic-create usage. No side effects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "plan": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "plan"
                      ]
                    },
                    "apiKey": {
                      "type": "object",
                      "description": "The key that made this call, so a job can check what it is holding before it starts work.",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "prefix": {
                          "type": "string"
                        },
                        "scopeType": {
                          "type": "string",
                          "enum": [
                            "account",
                            "database"
                          ]
                        },
                        "scopeId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "expiresAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "null for a key that never expires."
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "prefix",
                        "scopeType",
                        "scopeId",
                        "expiresAt"
                      ]
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "programmaticCreates": {
                          "type": "object",
                          "properties": {
                            "used": {
                              "type": "integer"
                            },
                            "limit": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "description": "null when the plan is unmetered."
                            },
                            "resetsAt": {
                              "type": "string",
                              "format": "date-time",
                              "description": "The first instant of next month, in UTC."
                            }
                          },
                          "required": [
                            "used",
                            "limit",
                            "resetsAt"
                          ]
                        }
                      },
                      "required": [
                        "programmaticCreates"
                      ]
                    }
                  },
                  "required": [
                    "user",
                    "apiKey",
                    "usage"
                  ]
                }
              }
            }
          },
          "401": {
