    "/v1/api-keys/{id}/rotate": {
      "post": {
        "tags": [
          "API keys"
        ],
        "operationId": "rotateApiKey",
        "summary": "Rotate an API key",
        "description": "Mints a replacement key with the same name and scope and revokes the old one after a 24-hour grace window, so long-running callers can pick up the new secret without an outage. The old secret keeps authenticating for that full window, reported as graceSeconds in the response. Returns 201 with the new key and its one-time secret. Returns 404 if the key is not yours and 410 if it is already revoked. Expiry carries forward: the replacement inherits the old key's expiresAt unchanged, so rotating a short-lived key is not a way to extend it and rotating a key that never expires still gives one that never expires. Send ttlSeconds in the body to set a fresh expiry measured from now. Rotating a key that has ALREADY expired, with no ttlSeconds, returns 410 with code: \"api_key_expired\" rather than minting a replacement that is dead on arrival.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "The replacement key and its one-time secret. The old key keeps working for graceSeconds (86400) before it is revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "prefix": {
                          "type": "string"
                        },
                        "scopeType": {
                          "type": "string",
                          "enum": [
                            "account",
                            "database"
                          ]
                        },
                        "scopeId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "lastUsedAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "revokedAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "Always null in a list response, which omits revoked keys."
                        },
                        "expiresAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "When the key stops working, as an absolute UTC instant. null for a key that never expires, which is what omitting ttlSeconds at creation gives you."
                        },
                        "secret": {
                          "type": "string",
                          "description": "The raw sk_ secret. Returned exactly once."
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "prefix",
                        "scopeType",
                        "scopeId",
                        "createdAt",
                        "lastUsedAt",
                        "revokedAt",
                        "expiresAt",
                        "secret"
                      ]
                    },
                    "keyHash": {
                      "type": "string"
                    },
                    "revokedKeyHash": {
                      "type": "string"
                    },
                    "graceSeconds": {
                      "type": "integer",
                      "example": 86400
                    }
                  },
                  "required": [
                    "key",
                    "keyHash",
                    "revokedKeyHash",
                    "graceSeconds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "ttlSeconds outside 600 to 2592000 (code 'invalid_ttl').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "The account is suspended for a failed payment, so mutating calls are blocked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key cannot reach this endpoint; it may only call /v1/databases/<its own id> and sub-paths, where the id is the database UUID, not its hostname (code: 'scoped_key_out_of_scope').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
