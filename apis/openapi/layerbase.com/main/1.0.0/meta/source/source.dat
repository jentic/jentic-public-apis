            "description": "The API key id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 600,
                    "maximum": 2592000,
                    "description": "Optional. Gives the replacement key a fresh expiry measured from now, within the same 600 to 2592000 bounds. Omit it and the replacement inherits the old key's expiry unchanged, so rotating is not a way to extend a short-lived key."
