          "API keys"
        ],
        "operationId": "revokeApiKey",
        "summary": "Revoke an API key",
        "description": "Revokes a key immediately. Returns { \"ok\": true } alongside the revokedKeyHash of the key it retired, and is idempotent (revoking an already-revoked key still returns 200). Any request using that key fails 401 afterward.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The key is revoked. Idempotent: revoking an already-revoked key returns the same body.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "revokedKeyHash": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unknown API key. A key that has passed its expiry answers 401 with code 'api_key_expired' and the expiry instant, so an aged-out key is distinguishable from a wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "The account is suspended for a failed payment, so mutating calls are blocked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A database-scoped key cannot reach this endpoint; it may only call /v1/databases/<its own id> and sub-paths, where the id is the database UUID, not its hostname (code: 'scoped_key_out_of_scope').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The key is not yours.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The API key id.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}