                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "410": {
            "description": "The key is already revoked, or it has expired and the request sent no ttlSeconds to replace that expiry (code 'api_key_expired').",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The account is migrating between servers. Sent with a Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Error envelope. Some errors add a machine-readable `code` (or a `reason`) alongside the message.",
                  "additionalProperties": true,
