          type: string
          default: Survey
        attributes:
          $ref: '#/components/schemas/SurveyClient'
    SurveyGenerator:
      type: object
      properties:
        customerId:
          type: integer
        surveyId:
          type: integer
        url:
          type: string
    PersonData:
      readOnly: true
      type: object
      properties:
        id:
          type: integer
        firstName:
          type: string
        lastName:
          type: string
        name:
          type: string
        active:
          type: boolean
        phoneNumber:
          type: string
        email:
          type: string
        jobPosition:
          type: string
        pesel:
          type: string
        nip:
          type: string
        additionalPhone:
          type: string
        additionalEmail:
          type: string
    FieldData:
      readOnly: true
      type: object
      properties:
        id:
          type: integer
        label:
          type: string
        key:
          type: string
        fieldType:
          type: string
          enum:
            - "-"
            - TEXT
            - CHECKBOX
            - DATE
            - NUMBER
            - TEXTAREA
            - SELECT
            - CASH
            - CHECKBOX_IDD
            - USER_DATA_EMPLOYEE
            - USER_DATA_CLIENT_COMPANY
        fieldKind:
          type: string
          enum:
            - standard
            - extra
        active:
          type: boolean
        required:
          type: boolean
        activeCreateForm:
          type: boolean
        fields:
          type: array
          items:
            type: object
            properties:
              key:
                type: [string, integer]
              value:
                type: string
        bookmarkId:
          type: integer
        bookmarkName:
          type: string
        bookmarkGroup:
          type: string
        isCompany:
          type: boolean
        categoryId:
          type: integer
    ProductObjectData:
      type: object
      readOnly: true
      properties:
        id:
          type: integer
        name:
          type: string
        producer:
          type: object
          properties:
            id:
              type: integer
            name:
              type: string
        category:
          type: object
          properties:
            id:
              type: integer
            name:
              type: string
    EventDtoData:
      type: object
      readOnly: true
      properties:
        id:
          type: integer
        name:
          type: string
        description:
          type: string
        isAttachment:
          type: boolean
        dateStart:
          type: string
          format: date
          nullable: true
        newestComment:
          $ref: '#/components/schemas/PersonData'
    ContractData:
      type: object
      readOnly: true
      properties:
        id:
          type: integer
        title:
          type: string
        contractType:
          type: string
          enum:
            - SALES
            - SALES_OPPORTUNITY
        client:
          $ref: '#/components/schemas/PersonData'
        company:
          $ref: '#/components/schemas/PersonData'
    Tags:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 1
        name:
          type: string
          example: Simple name
        type:
          type: integer
          enum: [1, 2, 3, 4]
          example: 1
          description: Tag type. 1 = default, 2 = segment, 3 = data tag, 4 = intranet tag.
        bgColor:
          type: string
    TagsData:
      type: object
      properties:
        id:
          type: string
          example: /api/tags/1
        type:
          type: string
          default: Tags
        attributes:
          $ref: '#/components/schemas/Tags'
    UserType:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 1
        name:
          type: string
          example: Simple name
        description:
          type: string
          example: Simple description
        active:
          type: boolean
          example: true
        userDataType:
          type: object
        points:
          type: string
        rank:
          type: integer
        nextPoints:
          type: integer
        userTypeNext:
          type: object
        bgColor:
          type: string
        isSection:
          type: boolean
          example: false
        groups:
          type: object
        isCandidate:
          type: boolean
        idOldSystem:
          type: string
    UserTypeData:
      type: object
      properties:
        id:
          type: string
          example: /api/usertypes/1
        type:
          type: string
          default: UserType
        attributes:
          $ref: '#/components/schemas/UserType'
    ItemType:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
        description:
          type: string
        active:
          type: boolean
        apiName:
          type: string

  securitySchemes:
    OAuth2:
      type: oauth2
      description: >
        For Cloud version API ```X-Tenant``` header is required for every
        request.

        The only exception is authorization URL in authorization code flow -
        ```X-Tenant``` should be passed as query parameter, for example:
        ```https://app.bergsystem.pl/api/authorize?client_id=your_client&respone_type=code&redirect_uri=https://encoded_redirec_url&scope=all&X-Tenant=tenant_name```
      flows:
        password:
          tokenUrl: 'https://app.bergsystem.pl/api/token'
          refreshUrl: 'https://app.bergsystem.pl/api/token'
          scopes: {}
        authorizationCode:
          authorizationUrl: 'https://app.bergsystem.pl/api/authorize'
          tokenUrl: 'https://app.bergsystem.pl/api/token'
          refreshUrl: 'https://app.bergsystem.pl/api/token'
          scopes: {}
  parameters:
    tenant:
      name: X-Tenant
      in: header
      description: >-
        "Tenant" field value from GET /token response. Required only for cloud
        version API.
      schema:
        type: string
    page_number:
      name: page[page]
      in: query
      description: Page number.
      required: false
      schema:
        type: integer
        format: int32
        minimum: 1
        default: 1
    itemsPerPage:
      name: itemsPerPage
      in: query
      description: Items per Page.
      required: false
      schema:
        type: integer
        format: int32
        maximum: 100
        default: 10
    sort:
      name: sort
      in: query
      description: >
        Sort data by field. Default sorting order is ascending. To reverse it
        use "-" before field name.

        For sorting by extra fields use prefix "extraField_" before field name.


        Supported sorting fields:
          * lastname
          * parentUser
          * state
          * city
          * phone
          * email
          * pesel
          * origins
          * createdDate
          * crmStatus
          * personalDataProcessingAgreement
          * marketingContentAgreement
          * commercialContentAgreement
          * mailSmsMessagesAgreement
          * id
          * ... and extra fields.
      required: false
      schema:
        type: string
        example: '-lastname'
    sort_companies:
      name: sort
      in: query
      description: >
        Sort data by field. Default sorting order is ascending. To reverse it
        use "-" before field name.
        
        For sorting by extra fields use prefix "extraField_" before field name.
        
        Supported sorting fields:
          * name
          * parentUser
          * state
          * city
          * phone
          * email
          * nip
          * origins
          * crmStatus
          * id
          * ... and extra fields.
      required: false
      schema:
        type: string
        example: '-lastname'
    sort_selling_process:
      name: sort
      in: query
      description: >
        Sort data by field. Default sorting order is ascending. To reverse it
        use "-" before field name.

        Supported sorting fields:
          * id
          * name
      required: false
      schema:
        type: string
        example: '-name'
    sort_selling_process_step:
      name: sort
      in: query
      description: >
        Sort data by field. Default sorting order is ascending. To reverse it
        use "-" before field name.

        Supported sorting fields:
          * id
          * name
          * orders
          * color
      required: false
      schema:
        type: string
        example: '-name'
    sort_event:
      name: sortBy
      in: query
      description: >
        Sort data by field. Default sorting order is ascending. To reverse it
        use "-" before field name.

        Supported sorting fields:
          * id
          * start
      required: false
      schema:
        type: string
        example: '-start'
  requestBodies:
    CustomerSave:
      required: true
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  attributes:
                    allOf:
                      - $ref: '#/components/schemas/BaseUserData'
                      - type: object
                        properties:
                          firstname:
                            type: string
                            description: |
                              Field "Imię".
                            example: James
                          lastname:
                            type: string
                            description: |
                              Field "Lastname".
                            example: Smith
                          gender:
                            type: string
                            enum:
                              - MEN
                              - WOMEN
                            example: MEN
                          pesel:
                            type: string
                            example: '33072308033'
                          birthday:
                            type: string
                            description: |
                              Field "data urodzenia" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
                            format: date
                            example: '2000-01-30'
                          driveLicenceDate:
                            type: string
                            description: |
                              Field "data wydania prawa jazdy" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
                            format: date
                            example: '2000-01-30'
                      - $ref: '#/components/schemas/BaseUserDataCommonInputFields'
    CompanySave:
      required: true
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  attributes:
                    allOf:
                      - $ref: '#/components/schemas/BaseUserData'
                      - $ref: '#/components/schemas/BaseUserDataCommonInputFields'
                      - type: object
                        properties:
                          contactPerson:
                            type: string
                            nullable: true
                            description: |
                              Field "osoba kontaktowa" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
                            example: 'Jan Kowalski'
                          startDate:
                            type: string
                            format: date
                            nullable: true
                            description: |
                              Field "Data rozpoczęcia działalności" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
                            example: '2020-02-01'
                          pkd:
                            type: string
                            nullable: true
                            description: |
                              Field "PKD" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
                            example: '6201Z DZIAŁALNOŚĆ ZWIĄZANA Z OPROGRAMOWANIEM'
                          pkdSecondary:
                            type: string
                            nullable: true
                            description: |
                              Field "PKD dodatkowe" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
                            example: '6201Z DZIAŁALNOŚĆ ZWIĄZANA Z MARKETINGIEM'
                          krs:
                            type: string
                            nullable: true
                            description: |
                              Field "KRS" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
    EmployeeSave:
      required: true
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  attributes:
                    allOf:
                      - $ref: '#/components/schemas/BaseUserData'
                      - type: object
                        properties:
                          firstname:
                            type: string
                            description: |
                              Field "Imię".
                            example: James
                          lastname:
                            type: string
                            description: |
                              Field "Lastname".
                            example: Smith
                          gender:
                            type: string
                            enum:
                              - MEN
                              - WOMEN
                            example: MEN
                          pesel:
                            type: string
                            example: '33072308033'
                          birthday:
                            type: string
                            description: |
                              Field "data urodzenia" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
                            format: date
                            example: '2000-01-30'
                          userType:
                            type: integer
                            description: |
                              "Stanowisko" (it's id) can be found at [Stnowisko](https://app.bergsystem.pl/usertype/).
                            example: 1
                          driveLicenceDate:
                            type: string
                            description: |
                              Field "data wydania prawa jazdy" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
                            format: date
                            example: '2000-01-30'
                      - $ref: '#/components/schemas/BaseUserDataCommonInputFields'
  responses:
    400BadRequest:
      description: Error.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
        application/vnd.api+json:
          schema:
            $ref: '#/components/schemas/Error'
    401Unauthorized:
      description: Unauthorized.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
        application/vnd.api+json:
          schema:
            $ref: '#/components/schemas/Error'
    403Forbidden:
      description: Not enough privellages for this resource.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
        application/vnd.api+json:
          schema:
            $ref: '#/components/schemas/Error'
    404NotFound:
      description: Resource not found.
      content:
        application/vnd.api+json:
          schema:
            $ref: '#/components/schemas/Error'
    SalesOpportunity:
      description: Sales opportunity data.
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                $ref: '#/components/schemas/SalesOpportunityData'
    SalesOpportunityChecklist:
      description: Sales opportunity data.
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                    example: /api/sales_opportunities/136/checklist
                  type:
                    type: string
                    default: SalesOpportunityCheckList
                  attributes:
                    type: object
                    required:
                      - saleOpportunityId
                      - checkListStep
                    properties:
                      saleOpportunityId:
                        type: integer
                        readOnly: true
                        example: 1243
                      saleId:
                        type: integer
                      sale:
                        type: string
                      checkListStep:
                        type: array
                        items:
                          type: object
                          properties:
                            stepId:
                              type: integer
                            step:
                              type: string
                            activeStep:
                              type: boolean
                            checkList:
                              type: array
                              items:
                                type: object
                                properties:
                                  id:
                                    type: integer
                                  name:
                                    type: string
                                  type:
                                    type: string
                                    enum:
                                      - user_data
                                      - user_data_extra_field
                                      - sale
                                      - sale_extra_field
                                      - question
                                  alias:
                                    type: string
                                  require:
                                    type: boolean
                                  checked:
                                    type: boolean
                                  questionFieldType:
                                    type: integer
                                    nullable: true
                                    enum:
                                      - 1
                                      - 2
                                      - 3
                                      - 4
                                      - 5
                                      - 6
                                      - 7
                                    description: 1 - CALENDAR_EVENT, 2 - CALENDAR_NOTE, 3 - FILE, 4 - MAIL, 5 - DONATION, 6 - SMS, 7 - FILE_CLIENT
    SalesProduct:
      description: Sales opportunity data.
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                  type:
                    type: string
                  attributes:
                    type: object
                    required:
                      - id
                      - products
                    properties:
                      id:
                        type: integer
                        readOnly: true
                        example: 1243
                      products:
                        type: array
                        items:
                          type: object
                          properties:
                            amount:
                              type: number
                              format: float
                            grossAmount:
                              type: number
                              format: float
                            instancePower:
                              type: number
                              format: float
                            quantity:
                              type: integer
                            productData:
                              $ref: '#/components/schemas/ProductObjectData'
    SalesCommission:
      description: Sales commissions.
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                  type:
                    type: string
                  attributes:
                    type: object
                    required:
                      - id
                      - commissions
                    properties:
                      commissions:
                        type: array
                        items:
                          type: object
                          properties:
                            commission:
                              type: number
                              format: float
                            plannedCommission:
                              type: number
                              format: float
                            points:
                              type: number
                              format: float
                            plannedPoints:
                              type: number
                              format: float
                            personData:
                              $ref: '#/components/schemas/PersonData'
    ContractPersonFields:
      description: Sales opportunity data.
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                  type:
                    type: string
                  attributes:
                    type: object
                    required:
                      - id
                      - fields
                    properties:
                      id:
                        type: integer
                        readOnly: true
                        example: 1
                      fields:
                        type: array
                        items:
                          type: object
                          $ref: '#/components/schemas/FieldData'
    ContractPersonOneField:
      description: Field data
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                  type:
                    type: string
                  attributes:
                    type: object
                    $ref: '#/components/schemas/FieldData'
    ExternalCompanyData:
      description: Company data
      content:
        application/vnd.api+json:
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  id:
                    type: string
                  type:
                    type: string
                  attributes:
                    type: object
                    readOnly: true
                    properties:
                      nationalNumber:
                        type: string
                      nip:
                        type: string
                        nullable: true
                      regon:
                        type: string
                        nullable: true
                      name:
                        type: string
                        nullable: true
                      krs:
                        type: string
                        nullable: true
                      street:
                        type: string
                        nullable: true
                      city:
                        type: string
                        nullable: true
                      houseNumber:
                        type: string
                        nullable: true
                      premisesNumber:
                        type: string
                        nullable: true
                      postCode:
                        type: string
                        nullable: true
                      message:
                        type: string
                        nullable: true
                      pkd:
                        type: string
                        nullable: true
                      pkdOther:
                        type: string
                        nullable: true
                      prefix:
                        type: string
                        nullable: true
                      startDate:
                        type: string
                        format: date
                        nullable: true
                      closeDate:
                        type: string
                        format: date
                        nullable: true
                      suspendDate:
                        type: string
                        format: date
                        nullable: true
                      resumptionDate:
                        type: string
                        format: date
                        nullable: true
                      companyStatus:
                        type: integer
                        enum:
                          - 1
                          - 2
                          - 3
                        description: 1 - active, 2 suspender, 3 - close
    SalesOpportunitiesList:
      description: List of sales opportunities
