        relatedUserIds:
          type: array
          items:
            type: integer
        representative:
          type: string
          nullable: true
        bankName:
          type: string
          nullable: true
        secondExternalId:
          type: string
          nullable: true
        iddInfo:
          type: string
          nullable: true
        bdoNumber:
          type: string
          nullable: true
        additionalStateId:
          type: integer
          nullable: true
        additionalState:
          type: string
          readOnly: true
          nullable: true
        officeStateId:
          type: integer
          nullable: true
        officeState:
          type: string
          readOnly: true
          nullable: true
        provinceId:
          type: integer
          nullable: true
        province:
          type: string
          readOnly: true
          nullable: true
        additionalProvinceId:
          type: integer
          nullable: true
        additionalProvince:
          type: string
          readOnly: true
          nullable: true
        officeProvinceId:
          type: integer
          nullable: true
        officeProvince:
          type: string
          readOnly: true
          nullable: true
        legalCity:
          type: string
          example: Wroclaw
        legalStreet:
          type: string
          example: Jaworowa
        legalHouseNumber:
          type: string
          example: 20A/77
        legalPremisesNumber:
          type: string
          example: '18'
        legalPostcode:
          type: string
          example: 00-930
        legalPostOffice:
          type: string
        legalStateId:
          type: integer
          nullable: true
        legalState:
          type: string
          readOnly: true
          nullable: true
        legalProvinceId:
          type: integer
          nullable: true
        legalProvince:
          type: string
          readOnly: true
          nullable: true
        legalCountryId:
          type: integer
          nullable: true
        legalCountry:
          type: string
          readOnly: true
          nullable: true
        forceAdd:
          type: boolean
          writeOnly: true
    BaseUserDataCommonOutputFields:
      type: object
      properties:
        state:
          type: string
          description: |
            Powiat - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          example: Krakow
        region:
          type: string
          description: |
            Region - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          example: Malopolskie
        country:
          type: string
          example: Polska
        invoiceCountry:
          type: string
          example: Polska
        additionalCountry:
          type: string
          example: Polska
        officeCountry:
          type: string
          example: Polska
        origins:
          type: string
          example: Lead
          description: |
            "Pochodzenie" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
        crmStatus:
          type: string
        channel:
          type: string
        structureName:
          type: string
        personType:
          type: string
    BaseUserDataCommonInputFields:
      type: object
      properties:
        originsId:
          type: integer
          example: 1
          description: |
            IDs and its meaning can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) (click on "Pochodzenie").
        stateId:
          type: integer
          description: |
            ID  can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - click "Powiat"
          example: 11
        regionId:
          type: integer
          description: |
            ID can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - click "Region"
          example: 12
        countryId:
          type: integer
          description: "Poland - '135', Germany - '122', United Kingdom - '184'"
          example: 135
        invoiceCountryId:
          type: integer
          description: "Poland - '135', Germany - '122', United Kingdom - '184'"
          example: 135
        additionalCountryId:
          type: integer
          description: "Poland - '135', Germany - '122', United Kingdom - '184'"
          example: 135
        officeCountryId:
          type: integer
          description: "Poland - '135', Germany - '122', United Kingdom - '184'"
          example: 135
        crmStatusId:
          type: integer
        channelId:
          type: integer
        structureNameId:
          type: integer
        personTypeId:
          type: integer
    ContractStatusData:
      type: object
      properties:
        id:
          type: string
          example: /api/contracts/statuses/1
        type:
          type: string
          default: ContractStatus
        attributes:
          $ref: '#/components/schemas/ContractStatus'
    ContractStatus:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 12
        name:
          type: string
          example: Wygrana
        active:
          type: boolean
    CalendarEventType:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 12
        name:
          type: string
          example: Simple calendar type
        bgColor:
          type: string
          maxLength: 7
          minLength: 7
          nullable: true
          example: #ffffff
        fontAwesome:
          type: string
          example: phone
    CalendarEventTypeData:
      type: object
      properties:
        id:
          type: string
          example: /api/events/types/1
        type:
          type: string
          default: CalendarType
        attributes:
          $ref: '#/components/schemas/CalendarEventType'
    Category:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 6
        name:
          type: string
          example: Simple category
        type:
          type: string
    CategoryData:
      type: object
      properties:
        id:
          type: string
          example: /api/products/categories/1
        type:
          type: string
          default: Category
        attributes:
          $ref: '#/components/schemas/Category'
    Customer:
      allOf:
        - $ref: '#/components/schemas/BaseUserData'
        - type: object
          properties:
            firstname:
              type: string
              description: |
                Field "Imię".
              example: James
            lastname:
              type: string
              description: |
                Field "Lastname".
              example: Smith
            gender:
              type: string
              enum:
                - MEN
                - WOMEN
              example: MEN
            pesel:
              type: string
              example: '33072308033'
            birthday:
              type: string
              description: |
                Field "data urodzenia" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
              format: date
              example: '2000-01-30'
            driveLicenceDate:
              type: string
              description: |
                Field "data wydania prawa jazdy" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2)
              format: date
              example: '2000-01-30'
            clientAge:
              type: integer
              nullable: true
            sourceOfMoney:
              type: integer
              nullable: true
              description: 1 - Umowa o pracę, 2 - Umowa zlecenie, 3 - Umowa o dzieło, 4 - Emerytura/Renta, 5 - Działalność gospodarcza, 6 - Spółka kapitałowa (akcyjna, z o.o.), 7 - Spółka osobowa (cywilna, jawna, komandytowa, partnerska), 8 - Inne, 9 - Brak dochodu
              enum:
                - 1
                - 2
                - 3
                - 4
                - 5
                - 6
                - 7
                - 8
                - 9
            familySituation:
              type: integer
              nullable: true
              description: 1 - Kawaler / Panna, 2 - Żonaty / Zamężna, 3 - Wdowiec / Wdowa, 4 - Rozwodnik / Rozwódka
              enum:
                - 1
                - 2
                - 3
                - 4
            numberOfDependents:
              type: integer
              nullable: true
            krkDate:
              type: string
              format: date
            krkPaymentDate:
              type: string
              format: date
            krkCheckDate:
              type: string
              format: date
            krkStatus:
              type: integer
              nullable: true
              description: 1 - IMPORTANT, 2 - TO_THE_GO_AWAY, 3 - INVALID, 4 - NO_STATUS, 5 - PAYED, 6 - PERFORMED
              enum:
                - 1
                - 2
                - 3
                - 4
                - 5
                - 6
            krkAdditionalInformation:
              type: string
              nullable: true
            licenseOneHundred:
              type: integer
              nullable: true
              description: 1 - yes, 0 - no
              enum:
                - 0
                - 1
            schoolLeavingCertificate:
              type: integer
              nullable: true
              description: 1 - yes, 0 - no
              enum:
                - 0
                - 1
            secondName:
              type: string
              nullable: true
        - $ref: '#/components/schemas/BaseUserDataCommonOutputFields'
    CustomerData:
      type: object
      properties:
        id:
          type: string
          example: /api/customers/15
        type:
          type: string
          default: Customer
        attributes:
          $ref: '#/components/schemas/Customer'
    CustomerExtraFieldData:
      type: object
      properties:
        id:
          type: string
          example: /api/customer_extra_fields/1243
        type:
          type: string
