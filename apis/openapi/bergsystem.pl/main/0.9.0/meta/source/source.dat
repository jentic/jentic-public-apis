  /events:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get all events
      tags:
        - Events
      parameters:
        - in: query
          name: page
          schema:
            type: integer
          required: false
        - in: query
          name: start
          schema:
            type: string
          required: false
          example: '2020-02-01'
        - in: query
          name: end
          schema:
            type: string
          required: false
          example: '2020-02-01'
        - in: query
          name: contractId
          schema:
            type: integer
          required: false
        - in: query
          name: userDataId
          schema:
            type: integer
          required: false
        - in: query
          name: parentEventId
          schema:
            type: integer
          required: false
        - in: query
          name: won
          schema:
            type: integer
            enum:
              - 0
              - 1
            description: 0 for not won, 1 for won
          required: false
        - in: query
          name: status
          required: false
          schema:
            type: integer
            enum:
              - 0
              - 1
            description: 0 for not important, 1 for important
        - in: query
          name: timeLineView
          required: false
          schema:
            type: integer
            enum:
              - 0
              - 1
            description: 0 for not important, 1 for important
        - in: query
          name: createdByUser
          schema:
            type: integer
            enum:
              - 0
              - 1
            description: 0 for all, 1 for only created by user
          required: false
        - in: query
          name: calendarTypeId
          schema:
            type: integer
            description: get data from /events/event_types
          required: false
        - in: query
          name: calendarTypeIds[]
          schema:
            type: integer
            description: get data from /events/event_types
          required: false
        - in: query
          name: userIds[]
          schema:
            type: array
            items:
              type: string
          required: false
        - in: query
          name: sortBy
          description: >
            Sort data by field. Default sorting order is ascending. To reverse it
            use "-" before field name.

            Supported sorting fields:
              * id
              * start
          required: false
          schema:
            type: string
            example: '-start'
        - in: query
          name: type[]
          schema:
            type: array
            description: Filter types of events to retrieve.
            items:
              type: string
              enum:
                - all
                - events
                - notes
                - mails
                - smsLogs
          required: false
      responses:
        '200':
          $ref: '#/components/responses/EventList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      summary: Create event
      tags:
        - Events
      requestBody:
        required: true
        content:
          application/vnd.api+json:
            schema:
              type: object
              properties:
                data:
                  $ref: '#/components/schemas/Event'
      responses:
        '201':
          $ref: '#/components/responses/Event'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
