    Company:
      allOf:
        - $ref: '#/components/schemas/BaseUserData'
        - $ref: '#/components/schemas/BaseUserDataCommonOutputFields'
        - type: object
          properties:
            contactPerson:
              type: string
              nullable: true
              description: |
                Field "osoba kontaktowa" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
              example: 'Jan Kowalski'
            startDate:
              type: string
              format: date
              nullable: true
              description: |
                Field "Data rozpoczęcia działalności" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
              example: '2020-02-01'
            pkd:
              type: string
              nullable: true
              description: |
                Field "PKD" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
              example: '6201Z DZIAŁALNOŚĆ ZWIĄZANA Z OPROGRAMOWANIEM'
            pkdSecondary:
              type: string
              nullable: true
              description: |
                Field "PKD dodatkowe" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
              example: '6201Z DZIAŁALNOŚĆ ZWIĄZANA Z MARKETINGIEM'
            krs:
              type: string
              nullable: true
              description: |
                Field "KRS" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/3)
            closeCompanyDate:
              type: string
              format: date
              nullable: true
            suspendCompanyDate:
              type: string
              format: date
              nullable: true
            companyStatus:
              type: integer
              description: 1 - active, 2 - suspended, 3 - closed
              enum:
                - 1
                - 2
                - 3
